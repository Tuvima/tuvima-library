<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MediaEngine.Domain</RootNamespace>
    <AssemblyName>MediaEngine.Domain</AssemblyName>
  </PropertyGroup>

  <!--
    The Domain project has NO external dependencies by design.
    Spec: "Domain Core MUST NOT be coupled to specific SQLite implementation
    details" and "MUST NOT contain logic specific to any metadata provider."
  -->

  <ItemGroup>
    <!-- The file-name cleaning rules (universal editor v5 D33). The config folder's copy wins; this one is used when that folder predates it. -->
    <EmbeddedResource Include="..\..\config\filename_cleaning.json" LogicalName="MediaEngine.Domain.filename_cleaning.json" />
  </ItemGroup>

</Project>
