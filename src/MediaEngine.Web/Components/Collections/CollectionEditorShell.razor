@namespace MediaEngine.Web.Components.Collections
@implements IAsyncDisposable
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Routing
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Components.MediaTiles
@using MediaEngine.Web.Components.Artwork
@using MediaEngine.Contracts.Artwork
@using MediaEngine.Contracts.Details
@using MediaEngine.Contracts.Metadata
@using DayMonth = MediaEngine.Domain.Models.DayMonth
@using MediaEngine.Web.Components.Details
@using MediaEngine.Web.Components.Rules
@using MediaEngine.Web.Components.Import

@inject IEngineApiClient ApiClient
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JS
@inject UIOrchestratorService Orchestrator
@inject IAppDialogService Dialogs
@inject ILogger<CollectionEditorShell> Logger
@inject IStringLocalizer<SharedStrings> L

<NavigationLock ConfirmExternalNavigation="@_hasUnsavedChanges"
                OnBeforeInternalNavigation="ConfirmNavigationWithUnsavedChanges" />

<MediaEditorSurface Inline="@Inline" Phone="@Phone">
    <div class="@WorkspaceClass" data-phone="@(Phone ? "true" : null)">
        @if (Phone)
        {
            @* The phone arrangement (universal editor v6 section 4a): one line, the title (and the step while creating) then "..." and Close. *@
            <header class="sme-header collection-editor-header collection-editor-header--phone" data-testid="phone-header">
                <div class="sme-header-copy">
                    <h2 class="sme-title" tabindex="-1">@EditorIdentityTitle</h2>
                    @if (IsCreateFlow)
                    {
                        <div class="collection-flow__step-line" data-testid="phone-step" aria-live="polite">@L["CollectionFlow_StepOf3", _step, StepLabel(_step)]</div>
                    }
                </div>
                <div class="collection-editor-header-actions">
                    @if (PhoneMenuItems is { Count: > 0 })
                    {
                        <AppRowMenu AriaLabel="@L["Common_MoreActions"].Value" Items="PhoneMenuItems" Class="collection-editor-header__more" />
                    }
                    <AppIconButton Icon="@AppMaterialIcons.Outlined.Close"
                                   Size="AppControlSize.Large"
                                   Tone="AppUiTone.Neutral"
                                   Class="sme-close"
                                   Tooltip="@L["Common_CloseEditor"].Value"
                                   AriaLabel="@L["Common_CloseEditor"].Value"
                                   OnClick="Cancel" />
                </div>
            </header>
        }
        else
        {
        <header class="sme-header collection-editor-header">
            <div class="collection-editor-header-icon" aria-hidden="true">
                <AppMaterialIcon Icon="@CollectionTypeIcon" />
            </div>
            <div class="sme-header-copy">
                <div class="sme-kicker">@DialogEyebrow</div>
                <h2 class="sme-title" tabindex="-1">@EditorIdentityTitle</h2>
                @if (IsCreateFlow)
                {
                    <ol class="collection-flow__steps" aria-label="@L["Universe_PathSteps"].Value">
                        @for (var number = 1; number <= 3; number++)
                        {
                            <li class="@(number == _step ? "is-current" : null)" aria-current="@(number == _step ? "step" : null)">@number · @StepLabel(number)</li>
                        }
                    </ol>
                }
                else
                {
                    <div class="sme-subtitle">@HeaderSubtitle</div>
                }
            </div>
            <div class="collection-editor-header-actions">
                <AppIconButton Icon="@AppMaterialIcons.Outlined.Close"
                               Size="AppControlSize.Compact"
                               Tone="AppUiTone.Neutral"
                               Class="sme-close"
                               Tooltip="@L["Common_CloseEditor"].Value"
                               AriaLabel="@L["Common_CloseEditor"].Value"
                               OnClick="Cancel" />
            </div>
        </header>
        }

        @if (IsCreateFlow)
        {
            @RenderFlow()
        }
        else
        {
        @* One layout and one main in both arrangements, so the body keeps its place in the render tree when the device turns (a tablet rotated) and nothing the person
           has staged in it is lost; only the rail or the tab row, and a class, change. *@
        <div class="@(Phone ? "sme-workspace collection-editor-layout collection-editor-layout--phone" : "sme-workspace collection-editor-layout")">
            @if (!Phone)
            {
            <nav class="sme-section-nav collection-editor-rail" aria-label="@L["CollectionEditorShell_CollectionEditorSections"].Value">
                @for (var index = 0; index < VisibleTabs.Length; index++)
                {
                    var tabIndex = index;
                    var tab = VisibleTabs[index];
                    <AppButton ButtonStyle="AppButtonStyle.Text"
                               Tone="AppUiTone.Neutral"
                               Class="@TabClass(tab.Id)"
                               aria-current="@(IsTabSelected(tab.Id) ? "page" : null)"
                               OnClick="@(() => OnTabChanged(tabIndex))">
                        <AppMaterialIcon Icon="@tab.Icon" Size="AppIconSize.Control20" />
                        <span>@tab.Label</span>
                    </AppButton>

                }

                @if (EditingCollection is not null)
                {
                    <div class="collection-editor-rail-footer">
                        @if (CanDeleteCollection)
                        {
                            <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Error"
                                       Class="collection-editor-delete-button"
                                       StartIcon="@AppMaterialIcons.Outlined.DeleteOutline"
                                       OnClick="DeleteCollectionAsync" Disabled="@_saving">@L["CollectionEditorShell_DeleteCollection"]</AppButton>
                            <small>@L["CollectionEditorShell_MediaRemainsInYourLibrary"]</small>
                        }
                    </div>
                }
            </nav>
            }

            <main class="sme-main-pane collection-editor-main">
                @if (Phone)
                {
                    @* The rail becomes the shared tab row; its panels are not drawn because the body below is the one panel and is drawn once, not again on every tab. *@
                    <AppTabs Class="collection-editor-tabs"
                             Label="@L["CollectionEditorShell_CollectionEditorSections"].Value"
                             Rounded="false"
                             Border="false"
                             Elevation="0"
                             ControlsId="@TabPanelId"
                             ActivePanelIndex="@ActiveTabIndex"
                             ActivePanelIndexChanged="OnTabChanged">
                        @foreach (var tab in VisibleTabs)
                        {
                            <AppTabPanel Id="@TabId(tab.Id)" Text="@tab.Label" Icon="@tab.Icon" Class="@($"collection-editor-tab collection-editor-tab--{tab.Id}")" />
                        }
                    </AppTabs>
                }
                @RenderEditBody()
                @RenderEditFooter()
            </main>
        </div>
        }
    </div>
</MediaEditorSurface>

@code {

    private RenderFragment RenderNotice() => @<text>
        @if (_summaryReasons is { } summaryReasons)
        {
            <AppAlert Tone="AppUiTone.Warning" Dense="true" data-editor-notice data-save-summary>
                <div>@(_summaryNotMade > 0 ? L["CollectionFlow_SaveSummaryHeadline", _summaryMade, _summaryNotMade].Value : L["CollectionFlow_SaveSummaryHeadlineArtwork", _summaryMade].Value)</div>
                <ul>
                    @foreach (var reason in summaryReasons)
                    {
                        <li>@reason</li>
                    }
                </ul>
                <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="DismissSaveSummaryAsync" data-save-summary-done>@L["Common_Done"]</AppButton>
            </AppAlert>
        }
        @if (_noticeText is { } notice)
        {
            <AppAlert Tone="@_noticeTone" Dense="true" ShowCloseIcon="true" CloseIconClicked="ClearNotice" data-editor-notice>@notice</AppAlert>
        }
    </text>;

    private RenderFragment RenderEditBody() => @<text>
        <div class="sme-body collection-editor-body" id="@(Phone ? TabPanelId : null)" role="@(Phone ? "tabpanel" : null)" aria-labelledby="@(Phone ? TabId(VisibleTabs[ActiveTabIndex].Id) : null)">
            @RenderNotice()
            @switch (_activeTab)
            {
                case "details":
                    @RenderDetailsTab()
                    break;
                case "artwork":
                    @RenderArtworkTab()
                    break;
                case "membership":
                    @RenderMembershipTab()
                    break;
                case "companions":
                    break;
                case "history":
                    @RenderHistoryTab()
                    break;
                default:
                    @RenderDetailsTab()
                    break;
            }

            @if (!IsPlaylistDialog)
            {
                <div hidden="@(!string.Equals(_activeTab, "companions", StringComparison.OrdinalIgnoreCase))">
                    <CollectionPersonalMediaSection @ref="_personalMediaSection"
                                                    CollectionId="@(EditingCollection?.Id ?? _createdCollectionId)"
                                                    Changed="MarkDirtyAsync"
                                                    Loaded="OnPersonalMediaLoadedAsync" />
                </div>
            }
        </div>
    </text>;

    private RenderFragment RenderEditFooter() => @<text>
        <footer class="sme-footer collection-editor-footer">
            <div class="collection-editor-footer-copy" aria-live="polite">@FooterSummary</div>
            <div class="collection-editor-footer-actions">
                <AppButton ButtonStyle="AppButtonStyle.Text"
                           Tone="AppUiTone.Neutral"
                           OnClick="Cancel"
                           Disabled="@_saving">
                    @L["Search_Cancel"]
                </AppButton>
                <AppButton ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary"
                           StartIcon="@AppMaterialIcons.Outlined.Save"
                           OnClick="SaveCollection"
                           Disabled="@(_saving || IsEmptyCuratedCollection)">
                    @if (_saving)
                    {
                        <AppSpinner Indeterminate="true" Size="AppSize.Small" Class="tl-u-color-inherit tl-u-width-14px tl-u-height-14px" />
                    }
                    @SaveButtonText
                </AppButton>
            </div>
        </footer>
    </text>;

    private RenderFragment RenderFlow() => @<main class="sme-main-pane collection-editor-main">
        <div class="sme-body collection-editor-body collection-flow" data-flow-step="@_step">
            @RenderNotice()
            @switch (_step)
            {
                case 1:
                    @RenderStartStep()
                    break;
                case 2:
                    @RenderBuildStep()
                    break;
                default:
                    @RenderNameStep()
                    break;
            }
        </div>

        <footer class="sme-footer collection-editor-footer collection-editor-footer--flow" data-flow-footer>
            <div class="collection-editor-footer-actions">
                @if (_step == 1)
                {
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" OnClick="Cancel" Disabled="@_saving">@L["Search_Cancel"]</AppButton>
                }
                else
                {
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" StartIcon="@AppMaterialIcons.Outlined.ArrowBack"
                               OnClick="Back" Disabled="@(_saving || SummaryShown)">@L["CollectionFlow_Back"]</AppButton>
                }
                @if (_step < 3)
                {
                    <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="NextAsync" Disabled="@(_saving || SummaryShown || NextBlocked)">@L["CollectionFlow_Next"]</AppButton>
                }
                else
                {
                    <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" StartIcon="@AppMaterialIcons.Outlined.Save"
                               OnClick="SaveCollection" Disabled="@(_saving || SummaryShown || IsEmptyCuratedCollection)">
                        @if (_saving)
                        {
                            <AppSpinner Indeterminate="true" Size="AppSize.Small" Class="tl-u-color-inherit tl-u-width-14px tl-u-height-14px" />
                        }
                        @SaveButtonText
                    </AppButton>
                }
            </div>
        </footer>
    </main>;

    private RenderFragment RenderWayCards() => @<div class="collection-flow__ways" role="radiogroup" aria-label="@L["CollectionFlow_HowShouldItFill"].Value">
        @foreach (var card in WayCards)
        {
            <AppChoiceCard Title="@L[card.TitleKey].Value"
                           Description="@L[card.TextKey].Value"
                           Icon="@card.Icon"
                           Selected="@(card.Way == _way)"
                           Disabled="@(!card.Available || (!IsCreateFlow && card.Way is FillWay.FromList or FillWay.Pack))"
                           Badge="@(!card.Available ? L["CollectionFlow_ComingSoon"].Value : !IsCreateFlow && card.Way == FillWay.FromList ? L["CollectionFlow_NewCollectionsOnly"].Value : null)"
                           OnClick="@(() => IsCreateFlow ? ChooseWayAsync(card.Way) : ChangeWayAsync(card.Way))" />
        }
    </div>;

    private RenderFragment RenderStartStep() => @<div class="collection-flow__start">
        <div class="collection-flow__field">
            <span class="collection-flow__label">@L["CollectionFlow_WhatGoesIn"]</span>
            <CollectionMediaChips Types="@MediaChoices"
                                  Selected="@CollectionRuleSentence.MediaTypes(_ruleDefinition)"
                                  SelectedChanged="OnMediaTypesChosenAsync" />
        </div>
        <div class="collection-flow__field">
            <span class="collection-flow__label">@L["CollectionFlow_HowShouldItFill"]</span>
            @RenderWayCards()
        </div>
    </div>;

    private RenderFragment RenderBuildStep() => @<div class="collection-flow__build">
        @if (_way == FillWay.Pack)
        {
            <CollectionPackStep Packs="@_packs" Selected="@_selectedPacks" Loading="@_packsLoading" Error="@_packsError"
                                SelectionChanged="OnPackToggledAsync" />
            <p class="collection-editor-note" data-step-hint aria-live="polite">@BuildStepHint</p>
        }
        else if (_way == FillWay.SetRules)
        {
            @RenderRulesWithPreview()
        }
        else if (_way == FillWay.FromList)
        {
            <CollectionListImportStep Draft="_listDraft" OnChanged="OnListDraftChanged" />
        }
        else
        {
            @RenderItemsTab()
            <p class="collection-editor-note" data-step-hint aria-live="polite">@BuildStepHint</p>
        }
    </div>;

    private RenderFragment RenderRulesWithPreview() => @<div class="collection-flow__cols">
        <div class="collection-flow__rules">
            <CollectionRuleBuilder @ref="_ruleBuilder"
                                   Definition="@_ruleDefinition"
                                   DefinitionChanged="OnRuleDefinitionChanged"
                                   SortField="@_sortField"
                                   SortFieldChanged="@(value => { _sortField = value ?? "title"; MarkDirty(); })"
                                   SortDirection="@_sortDirection"
                                   SortDirectionChanged="@(value => { _sortDirection = value; MarkDirty(); })"
                                   SecondarySortField="@_secondarySortField"
                                   SecondarySortFieldChanged="@(value => { _secondarySortField = value; MarkDirty(); })"
                                   SecondarySortDirection="@_secondarySortDirection"
                                   SecondarySortDirectionChanged="@(value => { _secondarySortDirection = value; MarkDirty(); })"
                                   Preview="@_previewResult"
                                   PreviewChanged="OnRuleBuilderPreviewChanged"
                                   Changed="OnRuleBuilderChanged"
                                   Advanced="@_advanced"
                                   AdvancedChanged="OnAdvancedChangedAsync"
                                   RandomOrder="@_randomOrder"
                                   RandomOrderChanged="OnOrderRandomChangedAsync"
                                   MaxItems="@_maxItems"
                                   MaxItemsChanged="OnMaxItemsChosenAsync"
                                   MediaTypeChoices="@MediaChoices"
                                   StrictestRuleChanged="OnStrictestRuleChangedAsync"
                                   Density="editor" />
        </div>
        @RenderPreviewPanel()
    </div>;

    // The preview shows one row of covers (as the mock); "Show all N" lists the rest whenever there are more results than covers.
    private const int PreviewCoverCount = 6;

    private RenderFragment RenderPreviewPanel() => @<aside class="collection-flow__preview" aria-label="@L["CollectionFlow_Preview"].Value" aria-live="polite">
        @if (_previewResult is null)
        {
            <div>
                <div class="collection-flow__preview-big">@L["CollectionFlow_NoPreviewYet"]</div>
                <div class="collection-flow__preview-sub">@L["CollectionFlow_NoPreviewHelp"]</div>
            </div>
        }
        else if (_previewResult.Count == 0)
        {
            <div>
                <div class="collection-flow__preview-big">@L["CollectionFlow_NothingMatchesYet"]</div>
                <div class="collection-flow__preview-sub">
                    @(string.IsNullOrWhiteSpace(_strictestRule)
                        ? L["CollectionFlow_LoosenARule"].Value
                        : L["CollectionFlow_LoosenTheStrictest", _strictestRule].Value)
                </div>
            </div>
            <p class="collection-flow__preview-note">@L["CollectionFlow_YouCanStillSave"]</p>
        }
        else
        {
            <div>
                <div class="collection-flow__preview-big">@(_previewResult.Count == 1 ? L["CollectionFlow_OneTitle"].Value : L["CollectionFlow_ManyTitles", _previewResult.Count].Value)</div>
                <div class="collection-flow__preview-sub">@(_previewResult.UsesPerProfileFields && !string.IsNullOrWhiteSpace(_previewResult.EvaluatedForProfileName) ? L["CollectionFlow_MatchNowCountedFor", _previewResult.EvaluatedForProfileName].Value : L["CollectionFlow_MatchNow"].Value)</div>
            </div>
            <div class="collection-flow__pills">
                @foreach (var group in PreviewTypeCounts(_previewResult))
                {
                    <span class="collection-flow__pill" data-media="@group.Label">@FormatMediaCount(group.Label, group.Count)</span>
                }
            </div>
            <div class="collection-flow__covers">
                @foreach (var item in _previewResult.Items.Take(PreviewCoverCount))
                {
                    <div class="collection-flow__cover">
                        @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                        {
                            <img src="@MediaTileArtworkUrl.ForDrawnSize(item.CoverUrl, 120)"
                                 srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(item.CoverUrl, 120)"
                                 alt="@item.Title" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <small>@item.Title</small>
                        }
                    </div>
                }
            </div>
            @if (_previewResult.Count > PreviewCoverCount)
            {
                <div class="collection-flow__show-all">
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary"
                               OnClick="@(() => _showAllPreview = !_showAllPreview)">@(_showAllPreview ? L["CollectionFlow_ShowFewer"].Value : L["CollectionFlow_ShowAll", _previewResult.Count].Value)</AppButton>
                </div>
            }
            @if (_showAllPreview)
            {
                <div class="collection-flow__all" role="list">
                    @foreach (var item in _previewResult.Items)
                    {
                        <div class="collection-flow__all-row" role="listitem">
                            <span class="collection-flow__all-title">@item.Title</span>
                            <span class="collection-flow__all-meta">@FormatPreviewMeta(item)</span>
                        </div>
                    }
                    @if (_previewResult.Count > _previewResult.Items.Count)
                    {
                        <small class="collection-flow__preview-note">@L["CollectionFlow_ShowingFirst", _previewResult.Items.Count, _previewResult.Count]</small>
                    }
                </div>
            }
            @if (_previewResult.UsesPerProfileFields)
            {
                <p class="collection-flow__preview-note">@L["CollectionFlow_EachProfileOwnSet"]</p>
            }
        }
    </aside>;

    private RenderFragment RenderNameStep() => @<div class="collection-flow__name">
        @if (_way == FillWay.Pack)
        {
            @RenderPackCreateStep()
        }
        else
        {
        @if (_way == FillWay.FromList && _listDraft.Shelves.Count > 1)
        {
            <p class="collection-editor-note">@L["CollectionFlow_ManyShelvesNote", _listDraft.Shelves.Count, string.IsNullOrWhiteSpace(_name) ? L["CollectionFlow_ShelfExampleName"].Value : _name.Trim(), _listDraft.Shelves.First()]</p>
        }
        <div class="collection-editor-details-grid" data-name-step>
            <div class="collection-editor-panel-stack">
                @RenderBasicInformationPanel()
                <div class="collection-flow__options" data-name-options>
                    @if (!IsPlaylistDialog)
                    {
                        @RenderShowOnPanel()
                        @RenderOwnershipPanel()
                    }
                    @RenderDisplayOptionsPanel(includeOrderAndLimit: _way != FillWay.SetRules)
                </div>
            </div>
            <div class="collection-editor-panel-stack" data-name-artwork>
                @RenderFlowArtworkPanel()
            </div>
        </div>
        }
    </div>;

    private RenderFragment RenderPackCreateStep() => @<div class="collection-editor-details-grid">
        <div class="collection-editor-panel-stack">
            <MediaEditorPanel Title="@L["CollectionFlow_WhatWillBeCreated"].Value" Description="@L["CollectionFlow_WhatWillBeCreatedHelp"].Value">
                <ul class="collection-flow__pack-summary">
                    @foreach (var pack in _packs.Where(pack => _selectedPacks.Contains(pack.Id)))
                    {
                        <li><strong>@pack.Name</strong> <span>@(pack.WouldCreateCount == 1 ? L["CollectionFlow_OneCollection"].Value : L["CollectionFlow_ManyCollections", pack.WouldCreateCount].Value)</span></li>
                    }
                </ul>
            </MediaEditorPanel>
            <MediaEditorPanel Title="@L["CollectionFlow_ShowOn"].Value" Description="@L["CollectionFlow_ShowOnPackHelp"].Value">
                @foreach (var (placeKey, placeLabel) in ShowOnPlaces)
                {
                    var key = placeKey;
                    <AppCheckbox Value="@_showOn.Contains(key)"
                                 ValueChanged="@(selected => OnShowOnChanged(key, selected))"
                                 Label="@placeLabel" />
                }
            </MediaEditorPanel>
        </div>
        <div class="collection-editor-panel-stack">
            @if (!IsPlaylistDialog)
            {
                @RenderOwnershipPanel()
            }
        </div>
    </div>;

    private RenderFragment RenderFlowArtworkPanel() => @<MediaEditorPanel Title="@L["CollectionFlow_Artwork"].Value" Description="@L["CollectionFlow_ArtworkHelp"].Value">
        @if (_artworkPreviewUrls.TryGetValue("poster", out var chosenArtwork))
        {
            <div class="collection-flow__stack"><img src="@chosenArtwork" alt="@L["CollectionFlow_SelectedArtwork"].Value" /></div>
        }
        else if (AutomaticArtworkItems.Count > 0)
        {
            <div class="collection-flow__stack">
                <MediaArtworkGroupPreview Items="@AutomaticArtworkItems" TotalCount="@AutomaticArtworkItems.Count"
                                          Layout="MediaArtworkGroupPreviewLayout.Cluster" ShowOverflowCount="false"
                                          AriaLabel="@L["CollectionFlow_AutomaticStack"].Value" />
            </div>
        }
        else
        {
            <p class="collection-editor-note">@L["CollectionFlow_CoversStackUp"]</p>
        }
        <AppFileUpload T="IBrowserFile" Accept=".jpg,.jpeg,.png" FilesChanged="OnArtworkChosenAsync">
            <CustomContent Context="upload">
                <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" StartIcon="@AppMaterialIcons.Outlined.CloudUpload"
                           OnClick="upload.OpenFilePickerAsync">@L["CollectionFlow_UploadYourOwn"]</AppButton>
            </CustomContent>
        </AppFileUpload>
        <p class="collection-editor-note">@L["CollectionFlow_ArtworkLimits"]</p>
    </MediaEditorPanel>;

    private RenderFragment RenderBasicInformationPanel() => @<text>
        <MediaEditorPanel Title="@L["CollectionFlow_BasicInformation"].Value" Description="@L["CollectionFlow_BasicInformationHelp"].Value">
            @if (IsPlaylistDialog && EditingCollection is not null)
            {
                <label class="app-artwork-picker collection-editor-artwork-picker">
                    @if (_artworkPreviewUrls.TryGetValue("poster", out var playlistPreview))
                    {
                        <img src="@playlistPreview" alt="Selected playlist artwork" />
                    }
                    else if (!string.IsNullOrWhiteSpace(EditingCollection?.CoverUrl))
                    {
                        <img src="@MediaTileArtworkUrl.ForDrawnSize(EditingCollection.CoverUrl, 112)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(EditingCollection.CoverUrl, 112)" alt="Current playlist artwork" />
                    }
                    else
                    {
                        <span class="app-artwork-picker__placeholder"><AppMaterialIcon Icon="@CollectionTypeIcon" /></span>
                    }
                    <span class="app-artwork-picker__edit"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PhotoCamera" /></span>
                    <InputFile class="app-artwork-picker__input" aria-label="Edit artwork" OnChange="OnArtworkSelected" accept=".jpg,.jpeg,.png" />
                </label>
            }
            <AppTextField T="string"
                          Value="@_name"
                          ValueChanged="OnNameChanged"
                          Label="@L["CollectionFlow_Name"].Value"
                          Placeholder="@L["CollectionFlow_NamePlaceholder"].Value"
                          Variant="AppVariant.Outlined"
                          Error="@_nameMissing"
                          ErrorText="@(_nameMissing ? L["CollectionEditorShell_PleaseEnterANameFor"].Value : null)"
                          Immediate="true"
                          Class="collection-editor-field" />

            <AppTextarea Value="@_description"
                             ValueChanged="OnDescriptionChanged"
                             Label="@L["CollectionFlow_Description"].Value"
                             Placeholder="@L["CollectionFlow_DescriptionPlaceholder"].Value"
                             Lines="5"
                             Immediate="true"
                             Class="collection-editor-field collection-editor-field--multiline" />
        </MediaEditorPanel>
    </text>;

    private RenderFragment RenderOwnershipPanel() => OwnerOnlyPanel ? @<text>
        <MediaEditorPanel Title="@L["CollectionFlow_WhoCanSee"].Value" Description="@L["CollectionFlow_StaysYours"].Value">
            <p class="collection-editor-owner-note"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Lock" /> @L["CollectionFlow_OnlyYou"]</p>
        </MediaEditorPanel>
    </text> : @<text>
        <MediaEditorPanel Title="@L["CollectionFlow_WhoCanSee"].Value" Description="@L["CollectionFlow_OwnershipHelp"].Value">
            <AppSelect T="string" @bind-Value="_ownerKind" Label="@L["CollectionFlow_Owner"].Value" Variant="AppVariant.Outlined">
                <AppSelectItem T="string" Value="@("Profile")">@L["CollectionFlow_OwnerProfile"]</AppSelectItem>
                <AppSelectItem T="string" Value="@("Library")">@L["CollectionFlow_OwnerLibrary"]</AppSelectItem>
            </AppSelect>
            @if (_ownerKind == "Profile")
            {
                <AppSelect T="string" @bind-Value="_audience" Label="@L["CollectionFlow_WhoCanSeeThis"].Value" Variant="AppVariant.Outlined">
                    <AppSelectItem T="string" Value="@("Private")">@L["CollectionFlow_OnlyMe"]</AppSelectItem>
                    <AppSelectItem T="string" Value="@("SelectedProfiles")">@L["CollectionFlow_SelectedProfiles"]</AppSelectItem>
                </AppSelect>
                @if (_audience == "SelectedProfiles")
                {
                    <div class="collection-editor-profile-picker" aria-label="@L["CollectionFlow_ProfilesWhoCanSee"].Value">
                        @if (_availableAudienceProfiles.Count == 0)
                        {
                            <small>@L["CollectionFlow_NoOtherProfiles"]</small>
                        }
                        else
                        {
                            @foreach (var profile in _availableAudienceProfiles)
                            {
                                <AppCheckbox Value="@_selectedProfileIds.Contains(profile.Id)"
                                             ValueChanged="@(selected => SetAudienceProfileAsync(profile.Id, selected))"
                                             Label="@profile.DisplayName" />
                            }
                        }
                    </div>
                }
            }
            else
            {
                <p>@L["CollectionFlow_LibraryOwnedForEveryone"]</p>
            }
        </MediaEditorPanel>
    </text>;

    private RenderFragment RenderDisplayOptionsPanel(bool includeOrderAndLimit) => @<text>
        <MediaEditorPanel Title="@L["CollectionFlow_More"].Value" Description="@L["CollectionFlow_MoreHelp"].Value">
            @if (HiddenUntilNote is { } hiddenNote)
            {
                <small><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Info" /> @hiddenNote</small>
            }
            <AppNumericField Label="@L["CollectionFlow_MinimumItems"].Value"
                             Value="@_minItems"
                             ValueChanged="OnMinItemsChanged"
                             Min="0"
                             HelpText="@L["CollectionFlow_MinimumItemsHelp"].Value"
                             Class="collection-editor-field" />
            @if (includeOrderAndLimit)
    {
        <AppNumericField Label="@L["CollectionRuleBuilder_AtMost"].Value"
                                 Value="@_maxItems"
                                 ValueChanged="OnMaxItemsChanged"
                                 Min="0"
                                 HelpText="@L["CollectionFlow_AtMostHelp"].Value"
                                 Class="collection-editor-field" />
                <AppSelect T="string"
                           Value="@(_randomOrder ? "random" : "set")"
                           ValueChanged="OnRandomOrderChanged"
                           ToStringFunc="@(value => value == "random" ? L["CollectionFlow_OrderRandom"].Value : L["CollectionFlow_OrderSet"].Value)"
                           Label=L["Common_Order"].Value
                           Variant="AppVariant.Outlined"
                           Class="collection-editor-field">
                    <AppSelectItem T="string" Value="@("set")">@L["CollectionFlow_OrderSet"]</AppSelectItem>
                    <AppSelectItem T="string" Value="@("random")">@L["CollectionFlow_OrderRandom"]</AppSelectItem>
                </AppSelect>
            }
    <AppCheckbox Value="@_seasonal"
                         ValueChanged="OnSeasonalChanged"
                         Label="@L["CollectionFlow_Seasonal"].Value" />
            @if (_seasonal)
            {
                <AppSelect T="string"
                           Value="@_seasonFromMonth.ToString()"
                           ValueChanged="@(value => OnSeasonEdgeChanged(() => _seasonFromMonth = int.Parse(value ?? "10")))"
                           ToStringFunc="MonthLabel"
                           Label=L["CollectionEditorShell_FromMonth"].Value
                           Variant="AppVariant.Outlined"
                           Class="collection-editor-field">
                    @for (var month = 1; month <= 12; month++)
                    {
                        <AppSelectItem T="string" Value="@month.ToString()">@MonthNames[month - 1]</AppSelectItem>
                    }
                </AppSelect>
                <AppNumericField Label="@L["CollectionFlow_FromDay"].Value" Value="@_seasonFromDay" Min="1" Max="31"
                                 ValueChanged="@(value => OnSeasonEdgeChanged(() => _seasonFromDay = value))"
                                 Class="collection-editor-field" />
                <AppSelect T="string"
                           Value="@_seasonToMonth.ToString()"
                           ValueChanged="@(value => OnSeasonEdgeChanged(() => _seasonToMonth = int.Parse(value ?? "11")))"
                           ToStringFunc="MonthLabel"
                           Label=L["CollectionEditorShell_ToMonth"].Value
                           Variant="AppVariant.Outlined"
                           Class="collection-editor-field">
                    @for (var month = 1; month <= 12; month++)
                    {
                        <AppSelectItem T="string" Value="@month.ToString()">@MonthNames[month - 1]</AppSelectItem>
                    }
                </AppSelect>
                <AppNumericField Label="@L["CollectionFlow_ToDay"].Value" Value="@_seasonToDay" Min="1" Max="31"
                                 ValueChanged="@(value => OnSeasonEdgeChanged(() => _seasonToDay = value))"
                                 HelpText=L["CollectionEditorShell_BothDaysAreIncludedA"].Value
                                 Class="collection-editor-field" />
            }
        </MediaEditorPanel>
    </text>;

    private RenderFragment RenderShowOnPanel() => @<MediaEditorPanel Title="@L["CollectionFlow_ShowOn"].Value" Description="@L["CollectionFlow_ShowOnHelp"].Value">
        @foreach (var (placeKey, placeLabel) in ShowOnPlaces)
        {
            var key = placeKey;
            <AppCheckbox Value="@_showOn.Contains(key)"
                         ValueChanged="@(selected => OnShowOnChanged(key, selected))"
                         Label="@placeLabel" />
        }
    </MediaEditorPanel>;

    private RenderFragment RenderDetailsTab() => @<div class="collection-editor-pane collection-editor-details">
        <div class="collection-editor-details-grid">
            <div class="collection-editor-panel-stack">
                @RenderBasicInformationPanel()

                @if (!IsPlaylistDialog)
                {
                    <MediaEditorPanel Title="Collection identity" Description="Structural settings for this curated library collection.">
                        <div class="collection-editor-identity-list">
                            <div><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Collections" /><span>Type</span><strong>Curated collection</strong></div>
                            <div><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Public" /><span>Media scope</span><strong>Cross-media</strong></div>
                            <div><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.AccountBalance" /><span>Owner</span><strong>Library</strong></div>
                            <div><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Sync" /><span>Fills up</span><strong>@WayTitle</strong></div>
                        </div>

                        <AppSelect T="string"
                                   Value="@(_iconName ?? string.Empty)"
                                   ValueChanged="OnIconChanged"
                                   ToStringFunc="IconLabelFor"
                                   Label="Collection icon"
                                   Variant="AppVariant.Outlined"
                                   Class="collection-editor-field">
                            @foreach (var choice in IconChoices)
                            {
                                <AppSelectItem T="string" Value="@choice.Icon">
                                    <AppMaterialIcon Icon="@choice.Icon" Size="AppIconSize.Control20" />
                                    @choice.Label
                                </AppSelectItem>
                            }
                        </AppSelect>
                    </MediaEditorPanel>

                    @RenderOwnershipPanel()

                    @if (!IsPlaylistDialog)
                    {
                        <MediaEditorPanel Title="Primary area" Description="Choose where this collection is primarily discovered.">
                            <AppSelect T="string" @bind-Value="_primaryArea" Label="Primary area" Variant="AppVariant.Outlined">
                                <AppSelectItem T="string" Value="@("Watch")">Watch</AppSelectItem>
                                <AppSelectItem T="string" Value="@("Read")">Read</AppSelectItem>
                                <AppSelectItem T="string" Value="@("Listen")">Listen</AppSelectItem>
                                <AppSelectItem T="string" Value="@("Mixed")">Mixed</AppSelectItem>
                            </AppSelect>
                        </MediaEditorPanel>
                    }

                    @RenderDisplayOptionsPanel(includeOrderAndLimit: !_rulesEnabled)

                    @RenderShowOnPanel()

                }
            </div>

            <div class="collection-editor-panel-stack">
                <MediaEditorPanel Title="Contents summary" Description="A live view of what belongs to this collection.">
                    <div class="collection-editor-membership-summary">
                        <strong>@(EditingCollection?.ItemCount ?? _manualItems.Count) item(s)</strong>
                        <span>@(SupportsManualItems
                            ? "Items are explicitly included and can be reordered."
                            : "Items are resolved automatically from the active rules.")</span>
                        <AppButton ButtonStyle="AppButtonStyle.Outlined"
                                   Tone="AppUiTone.Primary"
                                   StartIcon="@(SupportsManualItems ? AppMaterialIcons.Outlined.Inventory2 : AppMaterialIcons.Outlined.FilterAlt)"
                                   OnClick='@(() => SetActiveTab("membership"))'>
                            Open contents
                        </AppButton>
                    </div>
                </MediaEditorPanel>

                @if (EditingCollection is not null)
                {
                    <MediaEditorPanel Title="System details" Description="Read-only information maintained by Library.">
                        <div class="collection-editor-system-list">
                            <div><span>Created</span><strong>@EditingCollection.CreatedAt.ToLocalTime().ToString("g")</strong></div>
                            <div><span>Updated</span><strong>Not recorded</strong></div>
                            <div><span>Collection ID</span><code>@EditingCollection.Id</code></div>
                        </div>
                    </MediaEditorPanel>
                }
            </div>
        </div>

    </div>;

    private RenderFragment RenderArtworkTab() => @<div class="collection-editor-pane collection-editor-artwork-page">
        @if (CollectionArtworkItem is { } collectionArtworkItem)
        {
            <ArtworkWorkspace @key="collectionArtworkItem.EntityId"
                              Item="@collectionArtworkItem"
                              ActiveProfileId="@Request.ActiveProfileId"
                              OnChanged="@(() => _artworkChanged = true)"
                              ShowClose="false" />
        }
        else
        {
        <div class="collection-editor-draft-role-overview" role="tablist" aria-label="Artwork roles">
            @foreach (var role in DraftArtworkRoles)
            {
                var active = string.Equals(role.Slot, _activeArtworkSlot, StringComparison.OrdinalIgnoreCase);
                <AppNativeButton Type="button" role="tab" aria-selected="@active" Class="@(active ? "is-active" : string.Empty)" OnClick="@(() => SelectDraftArtworkRole(role.Slot))">
                    <AppMaterialIcon Icon="@role.Icon" /><span><strong>@role.Label</strong><small>@(_artworkFiles.ContainsKey(role.Slot) ? "1 staged variant" : role.Slot == "poster" && AutomaticArtworkItems.Count > 0 ? "Automatic" : "No artwork")</small></span><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" />
                </AppNativeButton>
            }
        </div>
        <div class="collection-editor-artwork-grid">
            <MediaEditorPanel Title="@ArtworkSlotTitle" Description="@ArtworkSlotDescription">
                <div class="collection-editor-artwork-preview @($"is-{_activeArtworkSlot}")">
                    @if (!string.IsNullOrWhiteSpace(SelectedArtworkPreviewUrl))
                    {
                        <img src="@SelectedArtworkPreviewUrl" alt="Selected @ArtworkSlotTitle artwork" />
                    }
                    else if (!string.IsNullOrWhiteSpace(CurrentArtworkUrl))
                    {
                        <img src="@MediaTileArtworkUrl.ForDrawnSize(CurrentArtworkUrl, ArtworkPreviewDrawnPx)" alt="Current @ArtworkSlotTitle artwork" />
                    }
                    else if (_activeArtworkSlot == "poster" && AutomaticArtworkItems.Count > 0)
                    {
                        <div class="collection-editor-automatic-stack">
                            <MediaTile Item="@AutomaticPreviewTile" ShowActions="false" />
                        </div>
                    }
                    else
                    {
                        <div class="collection-editor-empty collection-editor-empty--artwork">
                            <AppMaterialIcon Icon="@ArtworkSlotIcon" />
                            <strong>@ArtworkEmptyTitle</strong>
                            <span>@ArtworkEmptyDescription</span>
                        </div>
                    }
                </div>

                @if (_activeArtworkSlot == "poster")
                {
                    <div class="collection-editor-artwork-choice is-selected">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.AutoAwesomeMotion" />
                        <div><strong>Automatic stacked</strong><span>Uses up to four representative items and stays current as membership changes.</span></div>
                    </div>
                }
            </MediaEditorPanel>

            <MediaEditorPanel Title="Add or replace artwork" Description="@ArtworkUploadDescription">
                <label class="collection-editor-upload">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CloudUpload" />
                    <strong>Upload file</strong>
                    <span>@ArtworkFileRequirements</span>
                    <InputFile OnChange="OnArtworkSelected" accept="@ArtworkAccept" />
                </label>
                @if (!string.IsNullOrWhiteSpace(CurrentArtworkUrl) && EditingCollection is not null)
                {
                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Error" StartIcon="@AppMaterialIcons.Outlined.Restore"
                               OnClick="RemoveArtworkAsync">@(_activeArtworkSlot == "poster" ? "Use Automatic stacked" : "Remove artwork")</AppButton>
                }
                <div class="collection-editor-artwork-tip">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Info" />
                    <span>@ArtworkGuidance</span>
                </div>
            </MediaEditorPanel>
        </div>
        }
    </div>;

    private RenderFragment RenderHistoryTab() => @<div class="collection-editor-pane">
        <div class="collection-editor-history-list">
            @if (EditingCollection is null)
            {
                <div class="collection-editor-empty">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.History" />
                    <span>History begins after the collection is created.</span>
                </div>
            }
            else
            {
                <div class="collection-editor-history-entry">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.AddCircleOutline" />
                    <div><strong>Collection created</strong><span>@EditingCollection.CreatedAt.ToLocalTime().ToString("f")</span></div>
                </div>
                <div class="collection-editor-history-note">
                    Detailed rule, membership, and artwork events will appear when collection audit events are recorded by the Engine.
                </div>
            }
        </div>
    </div>;

    private RenderFragment RenderRulesTab() => @<div class="collection-editor-pane">
        @RenderRulesSection()
    </div>;

    private RenderFragment RenderMembershipTab() => @<div class="collection-editor-pane">
        <MediaEditorPanel Title="How it fills up" Description="Hand-picked titles stay as you set them. Rules keep the collection up to date on their own.">
            <div class="collection-flow__fills">
                <div class="collection-flow__fills-copy">
                    <strong>@WayTitle</strong>
                    <span>@(_rulesEnabled ? "Library keeps it up to date from the rules below." : "You choose and order every title.")</span>
                </div>
                <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Primary"
                           StartIcon="@AppMaterialIcons.Outlined.Tune"
                           OnClick="@(() => _changingWay = !_changingWay)">Change how it fills up</AppButton>
            </div>
            @if (_changingWay)
            {
                @RenderWayCards()
            }
        </MediaEditorPanel>
        @if (EditingCollection is not null && !IsPlaylistDialog && !_rulesEnabled)
        {
            <CollectionListSection CollectionId="EditingCollection.Id"
                                   ProfileId="Request.ActiveProfileId"
                                   OnLoaded="OnListSectionLoaded"
                                   OnContentsChanged="OnListContentsChangedAsync" />
        }
        @if (_rulesEnabled)
        {
            @RenderRulesSection()
        }
        else
        {
            @RenderItemsTab()
        }
    </div>;

    private RenderFragment RenderRulesSection() => @<section class="collection-editor-section collection-editor-section--rules">
        @if (_rulesEnabled)
        {
            @RenderRulesWithPreview()
        }
        else
        {
            <div class="collection-editor-empty">
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Inventory2" />
                <strong>This collection is hand-picked.</strong>
                <span>Use Change how it fills up to let rules keep it up to date.</span>
            </div>
        }
    </section>;

    private RenderFragment RenderItemsTab() => @<div class="collection-editor-pane">
        <section class="collection-editor-section">
            <div class="collection-editor-section-title">Contents</div>

            @if (SupportsManualItems)
            {
                @if (_loadingManualItems)
                {
                    <div class="collection-editor-empty">
                        <AppSpinner Indeterminate="true" Size="AppSize.Small" />
                        <span>Loading collection items...</span>
                    </div>
                }
                else
                {
                    <div class="collection-editor-contents-toolbar">
                        <div>
                            <strong>@_manualItems.Count item(s) in this collection</strong>
                            <span>Reorder or remove the items already included here.</span>
                        </div>
                        @if (!_showItemPicker)
                        {
                            <AppButton ButtonStyle="AppButtonStyle.Outlined"
                                       Tone="AppUiTone.Primary"
                                       StartIcon="@AppMaterialIcons.Outlined.Add"
                                       OnClick="OpenItemPickerAsync">
                                Add items
                            </AppButton>
                        }
                    </div>

                    @if (_manualItems.Count == 0)
                    {
                        <div class="collection-editor-empty collection-editor-empty--compact">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Inventory2" />
                            <span>This collection does not contain any items yet.</span>
                        </div>
                    }
                    else
                    {
                        <div class="collection-editor-item-list collection-editor-item-list--members">
                            @foreach (var item in _manualItems.OrderBy(item => item.SortOrder))
                            {
                                <div class="collection-editor-item-row">
                                    @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                                    {
                                        <img class="collection-editor-item-art"
                                             src="@MediaTileArtworkUrl.ForDrawnSize(item.CoverUrl, 62)"
                                             srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(item.CoverUrl, 62)"
                                             alt=""
                                             width="44"
                                             height="62"
                                             loading="lazy"
                                             decoding="async" />
                                    }
                                    <div class="collection-editor-item-copy">
                                        <div class="collection-editor-item-title">@item.Title</div>
                                        <div class="collection-editor-item-meta">@FormatManualItemMeta(item)</div>
                                    </div>
                                    <AppIconButton Icon="@AppMaterialIcons.Outlined.KeyboardArrowUp" Size="AppControlSize.Compact" Disabled="@(item.SortOrder == _manualItems.Min(existing => existing.SortOrder))" OnClick="@(() => MoveManualItemAsync(item, -1))" Tooltip="Move item up" />
                                    <AppIconButton Icon="@AppMaterialIcons.Outlined.KeyboardArrowDown" Size="AppControlSize.Compact" Disabled="@(item.SortOrder == _manualItems.Max(existing => existing.SortOrder))" OnClick="@(() => MoveManualItemAsync(item, 1))" Tooltip="Move item down" />
                                    <AppIconButton Icon="@AppMaterialIcons.Outlined.RemoveCircle" Size="AppControlSize.Compact" Tone="AppUiTone.Error" OnClick="@(() => RemoveManualItemAsync(item))" Tooltip="Remove item" />
                                </div>
                            }
                        </div>
                    }

                    @if (_showItemPicker)
                    {
                        <div class="collection-editor-item-picker">
                            <div class="collection-editor-item-picker-header">
                                <div>
                                    <strong>Add items</strong>
                                    <span>Search the library and add titles to this collection.</span>
                                </div>
                                <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" OnClick="CloseItemPicker">Done</AppButton>
                            </div>
                            <AppTextField T="string"
                                          Value="@_itemSearchText"
                                          ValueChanged="OnItemSearchChanged"
                                          Label="Search library"
                                          Placeholder="Search title, creator, or media type"
                                          Variant="AppVariant.Outlined"
                                          Immediate="true"
                                          DebounceInterval="300"
                                          Class="collection-editor-field" />
                            @if (_loadingLibraryItems)
                            {
                                <div class="collection-editor-empty collection-editor-empty--compact">
                                    <AppSpinner Indeterminate="true" Size="AppSize.Small" />
                                    <span>Searching the library...</span>
                                </div>
                            }
                            else if (FilteredLibraryItems.Count == 0)
                            {
                                <div class="collection-editor-empty collection-editor-empty--compact">
                                    <span>No matching items are available to add.</span>
                                </div>
                            }
                            else
                            {
                                <div class="collection-editor-item-list">
                                    @foreach (var work in FilteredLibraryItems)
                                    {
                                        <div class="collection-editor-item-row">
                                            <div class="collection-editor-item-copy">
                                                <div class="collection-editor-item-title">@work.Title</div>
                                                <div class="collection-editor-item-meta">@FormatWorkMeta(work)</div>
                                            </div>
                                            <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary" StartIcon="@AppMaterialIcons.Outlined.Add" OnClick="@(() => AddManualItemAsync(work))">Add</AppButton>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            }
            else
            {
                <div class="collection-editor-actions-row">
                    <div class="collection-editor-note collection-editor-note--tight">
                        <span>The preview below shows what currently matches these rules.</span>
                    </div>
                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Primary" OnClick="RunPreview">Refresh preview</AppButton>
                </div>

                @if (_previewResult is null)
                {
                    <div class="collection-editor-empty">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Visibility" Class="tl-u-font-size-24px tl-u-opacity-0-18" />
                        <span>Add at least one rule value to preview matching media.</span>
                    </div>
                }
                else
                {
                    <div class="collection-editor-preview">
                        <div class="collection-editor-preview-header">
                            <span>@_previewResult.Count item(s) match right now@(_previewResult.UsesPerProfileFields && !string.IsNullOrWhiteSpace(_previewResult.EvaluatedForProfileName) ? $" for {_previewResult.EvaluatedForProfileName}" : string.Empty)</span>
                        </div>

                        @foreach (var item in _previewResult.Items)
                        {
                            <div class="collection-editor-preview-item">
                                @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                                {
                                    <img class="collection-editor-item-art"
                                         src="@MediaTileArtworkUrl.ForDrawnSize(item.CoverUrl, 62)"
                                         srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(item.CoverUrl, 62)"
                                         alt=""
                                         width="44"
                                         height="62"
                                         loading="lazy"
                                         decoding="async" />
                                }
                                else
                                {
                                    <span class="collection-editor-item-art collection-editor-item-art--placeholder" aria-hidden="true">
                                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ImageNotSupported" Size="AppIconSize.Control20" />
                                    </span>
                                }
                                <div class="collection-editor-preview-copy">
                                    <div class="collection-editor-item-title">@item.Title</div>
                                    <div class="collection-editor-item-meta">@FormatPreviewMeta(item)</div>
                                </div>
                                <span class="collection-editor-preview-type">@item.MediaType</span>
                            </div>
                        }
                    </div>
                }
            }
        </section>
    </div>;

}
