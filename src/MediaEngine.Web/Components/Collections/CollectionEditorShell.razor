    // ── The New collection flow (Collections and lists spec 4b): how it fills up, build it, name and show it ───────────

    private enum FillWay { PickTitles, SetRules, FromList, Pack }

    private record WayCard(FillWay Way, string Title, string Text, string Icon, bool Available);

    private static readonly WayCard[] WayCards =
    [
        new(FillWay.PickTitles, "Pick titles", "Search your library and add titles yourself.", AppMaterialIcons.Outlined.PlaylistAdd, true),
        new(FillWay.SetRules, "Set rules", "Library keeps it up to date from rules you set, like “directed by” or “unwatched”.", AppMaterialIcons.Outlined.Tune, true),
        new(FillWay.FromList, "From a list", "Drop an export from IMDb, Letterboxd, Trakt, Goodreads or StoryGraph, or paste titles. Library finds the ones you own.", AppMaterialIcons.Outlined.UploadFile, true),
        new(FillWay.Pack, "Start from a pack", "Ready-made sets built from your own library: Decades, Award winners, Based on a book you own.", AppMaterialIcons.Outlined.AutoAwesome, false),
    ];

    private FillWay _way = FillWay.SetRules;
    private readonly ListImportDraft _listDraft = new();
    private bool _isListCollection;
    private int _step = 1;
    private bool _advanced;
    private bool _changingWay;
    private bool _showAllPreview;
    private string? _strictestRule;
    private string? _suggestedName;
    private CollectionRuleBuilder? _ruleBuilder;

    private bool IsCreateFlow => EditingCollection is null;
    private IReadOnlyList<CollectionMediaChips.MediaChipType> MediaChoices => IsPlaylistDialog ? CollectionMediaChips.PlaylistTypes : CollectionMediaChips.CollectionTypes;
    private bool HasUsableRules => _ruleDefinition.AllConditions.Any(IsCompleteRule);

    private string StepLabel(int step) => step switch
    {
        1 => "How it fills up",
        2 => _way switch { FillWay.PickTitles => "Pick titles", FillWay.SetRules => "Set rules", FillWay.FromList => "From a list", _ => "Pick a pack" },
        _ => "Name and show it",
    };

    private bool ListReady => _listDraft.HasList && _listDraft.OwnedCount > 0;

    private bool NextBlocked => _step == 2 && (_way == FillWay.SetRules ? !HasUsableRules : _way == FillWay.FromList ? !ListReady : IsEmptyCuratedCollection);

    private string FlowFooterSummary => _step switch
    {
        1 => "Choose how this fills up. You can go Back and change your mind.",
        2 when _way == FillWay.SetRules && !HasUsableRules => "Add a rule or tick a media type to continue.",
        2 when _way == FillWay.SetRules => _previewResult is null ? "Working out what matches…" : FormatMatchSummary(_previewResult),
        2 when _way == FillWay.FromList && !_listDraft.HasList => "Drop a list file or paste titles to continue.",
        2 when _way == FillWay.FromList && !ListReady => "None of these titles are in your library yet, so there is nothing to put in a collection.",
        2 when _way == FillWay.FromList => $"You own {_listDraft.OwnedCount} of {_listDraft.EntryCount}. {(_listDraft.CollectionCount > 1 ? $"{_listDraft.CollectionCount} collections will be made." : "One collection will be made.")}",
        2 when IsEmptyCuratedCollection => EmptyCuratedCollectionMessage,
        2 => $"{_manualItems.Count} item(s) staged for this collection.",
        _ => "Nothing is saved until you create it.",
    };

    private async Task ChooseWayAsync(FillWay way)
    {
        var card = WayCards.First(candidate => candidate.Way == way);
        if (!card.Available)
            return;

        _way = way;
        var rules = way == FillWay.SetRules;
        if (_rulesEnabled != rules)
        {
            _rulesEnabled = rules;
            _previewResult = null;
        }

        await Task.CompletedTask;
    }

    private async Task NextAsync()
    {
        if (_step == 1)
        {
            _step = 2;
            if (_way == FillWay.PickTitles)
            {
                _showItemPicker = true;
                await EnsureLibraryItemsLoadedAsync();
            }

            return;
        }

        if (_step == 2 && !NextBlocked)
        {
            SuggestName();
            _step = 3;
        }
    }

    private void Back()
    {
        if (_step > 1)
            _step--;
    }

    private Task OnMediaTypesChosenAsync(IReadOnlyList<string> types)
    {
        CollectionRuleSentence.SetMediaTypes(_ruleDefinition, types);
        MarkDirty();
        return Task.CompletedTask;
    }

    private Task OnAdvancedChangedAsync(bool advanced)
    {
        _advanced = advanced;
        return Task.CompletedTask;
    }

    private Task OnOrderRandomChangedAsync(bool random)
    {
        _randomOrder = random;
        MarkDirty();
        return Task.CompletedTask;
    }

    private Task OnMaxItemsChosenAsync(int value)
    {
        _maxItems = Math.Max(0, value);
        MarkDirty();
        return Task.CompletedTask;
    }

    private Task OnStrictestRuleChangedAsync(string? rule)
    {
        _strictestRule = rule;
        return InvokeAsync(StateHasChanged);
    }

    // The name offered on the last step: "Movies directed by Denis Villeneuve". Anything the person typed is kept.
    private void SuggestName()
    {
        var suggestion = _way == FillWay.SetRules
            ? NameFromRules()
            : _way == FillWay.FromList && _listDraft.Current is { } listPreview
                ? (_listDraft.Shelves.Count > 1 ? listPreview.SourceLabel.Replace(" export", string.Empty, StringComparison.Ordinal) : listPreview.SuggestedName)
                : null;
        if (suggestion is null)
            return;
        if (string.IsNullOrWhiteSpace(_name) || _name == _suggestedName)
            _name = suggestion;
        _suggestedName = suggestion;
    }

    private string? NameFromRules()
    {
        var types = CollectionRuleSentence.MediaTypes(_ruleDefinition);
        var noun = types.Count == 0
            ? "Titles"
            : string.Join(" and ", types.Select(type => type switch { "TV" => "TV shows", _ => type }));
        var rule = CollectionRuleSentence.IncludeGroup(_ruleDefinition).Conditions
            .FirstOrDefault(condition => condition.Op is "eq" or "in" && IsCompleteRule(condition));
        if (rule is null)
            return types.Count == 0 ? null : noun;

        var who = string.Join(" or ", rule.DisplayValues is { Length: > 0 } labels ? labels : rule.Values is { Length: > 0 } values ? values : [rule.DisplayValue ?? rule.Value ?? string.Empty]);
        return rule.Field switch
        {
            "director" => $"{noun} directed by {who}",
            "author" or "artist" => $"{noun} by {who}",
            "cast_member" => $"{noun} with {who}",
            "narrator" => $"{noun} narrated by {who}",
            "composer" => $"{noun} composed by {who}",
            "genre" => $"{who} {noun.ToLowerInvariant()}",
            _ => $"{noun}: {CollectionRuleSentence.Describe(rule, CollectionRuleCatalog.Instance)}",
        };
    }

    private RenderFragment RenderFlow() => @<main class="sme-main-pane collection-editor-main">
        <div class="sme-body collection-editor-body collection-flow" data-flow-step="@_step">
            @switch (_step)
            {
                case 1:
                    @RenderStartStep()
                    break;
                case 2:
                    @RenderBuildStep()
                    break;
                default:
                    @RenderNameStep()
                    break;
            }
        </div>

        <footer class="sme-footer collection-editor-footer">
            <div class="collection-editor-footer-copy" aria-live="polite">@FlowFooterSummary</div>
            <div class="collection-editor-footer-actions">
                @if (_step == 1)
                {
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" OnClick="Cancel" Disabled="@_saving">Cancel</AppButton>
                }
                else
                {
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" StartIcon="@AppMaterialIcons.Outlined.ArrowBack"
                               OnClick="Back" Disabled="@_saving">Back</AppButton>
                }
                @if (_step < 3)
                {
                    <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="NextAsync" Disabled="@(_saving || NextBlocked)">Next</AppButton>
                }
                else
                {
                    <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" StartIcon="@AppMaterialIcons.Outlined.Save"
                               OnClick="SaveCollection" Disabled="@(_saving || IsEmptyCuratedCollection)">
                        @if (_saving)
                        {
                            <AppSpinner Indeterminate="true" Size="AppSize.Small" Class="tl-u-color-inherit tl-u-width-14px tl-u-height-14px" />
                        }
                        @SaveButtonText
                    </AppButton>
                }
            </div>
        </footer>
    </main>;

    private RenderFragment RenderWayCards() => @<div class="collection-flow__ways" role="radiogroup" aria-label="How should it fill up?">
