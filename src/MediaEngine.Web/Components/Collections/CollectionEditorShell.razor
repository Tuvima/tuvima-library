            <div class="collection-flow__covers">
                @foreach (var item in _previewResult.Items.Take(12))
                {
                    <div class="collection-flow__cover" title="@item.Title">
                        @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                        {
                            <img src="@MediaTileArtworkUrl.ForDrawnSize(item.CoverUrl, 120)"
                                 srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(item.CoverUrl, 120)"
                                 alt="@item.Title" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <small>@item.Title</small>
                        }
                    </div>
                }
            </div>
            @if (_previewResult.Count > 12)
            {
                <div class="collection-flow__show-all">
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary"
                               OnClick="@(() => _showAllPreview = !_showAllPreview)">@(_showAllPreview ? "Show fewer" : $"Show all {_previewResult.Count}")</AppButton>
                </div>
