    private async Task AddManualItemAsync(CollectionMediaLookupDto work)
    {
        if (SelectedWorkIds.Contains(work.WorkId))
            return;

        if (EditingCollection is not null && !_storedRuleDriven)
        {
            var ok = await ApiClient.AddCollectionItemAsync(EditingCollection.Id, work.WorkId, Request.ActiveProfileId);
            if (!ok)
            {
                Snackbar.Add("Failed to add the item to this collection.", AppSeverity.Error);
                return;
            }

            await LoadManualItemsAsync();
            await RefreshLookupItemsAsync();
            return;
        }

        _manualItems.Add(new ManualCollectionItem
        {
            Id = Guid.Empty,
            WorkId = work.WorkId,
            Title = work.Title,
            Creator = work.Creator,
            MediaType = work.MediaType,
            CoverUrl = work.ArtworkUrl,
            SortOrder = _manualItems.Count == 0 ? 1 : _manualItems.Max(item => item.SortOrder) + 1,
        });
        MarkDirty();

        StateHasChanged();
    }

    private async Task RemoveManualItemAsync(ManualCollectionItem item)
    {
        if (EditingCollection is not null && !_storedRuleDriven)
        {
            var ok = await ApiClient.RemoveCollectionItemAsync(EditingCollection.Id, item.Id, Request.ActiveProfileId);
            if (!ok)
            {
                // The Engine says why when it refuses, for example when this is the collection's last item.
                Snackbar.Add(
                    string.IsNullOrWhiteSpace(ApiClient.LastError)
                        ? "Failed to remove the item from this collection."
                        : ApiClient.LastError,
                    AppSeverity.Error);
                return;
            }

            await LoadManualItemsAsync();
            await RefreshLookupItemsAsync();
            return;
        }

        _manualItems.RemoveAll(existing => existing.WorkId == item.WorkId);
        MarkDirty();
        StateHasChanged();
    }

    private async Task MoveManualItemAsync(ManualCollectionItem item, int direction)
    {
        var ordered = _manualItems.OrderBy(existing => existing.SortOrder).ToList();
        var index = ordered.FindIndex(existing => existing.Id == item.Id && existing.WorkId == item.WorkId);
        var targetIndex = index + direction;
        if (index < 0 || targetIndex < 0 || targetIndex >= ordered.Count)
            return;

        (ordered[index], ordered[targetIndex]) = (ordered[targetIndex], ordered[index]);

        _manualItems = ordered
            .Select((existing, order) => existing with { SortOrder = order + 1 })
            .ToList();

        if (EditingCollection is not null && !_storedRuleDriven)
        {
            var itemIds = _manualItems
                .OrderBy(existing => existing.SortOrder)
                .Select(existing => existing.Id)
                .Where(id => id != Guid.Empty)
                .ToList();
            var ok = await ApiClient.ReorderCollectionItemsAsync(EditingCollection.Id, itemIds, Request.ActiveProfileId);
            if (!ok)
            {
                Snackbar.Add("Failed to reorder the collection.", AppSeverity.Error);
                await LoadManualItemsAsync();
                return;
            }
        }
        else
        {
            MarkDirty();
        }

        StateHasChanged();
    }

    private async Task RunPreview()
    {
        if (!_rulesEnabled)
        {
            _previewResult = null;
            return;
        }

        var validRules = _ruleDefinition.AllConditions.Where(IsCompleteRule).ToList();

        if (validRules.Count == 0)
        {
            _previewResult = null;
            StateHasChanged();
            return;
        }

        _previewResult = await ApiClient.PreviewCollectionRulesAsync(
            CollectionRuleSentence.ToWire(_ruleDefinition),
            _sortField,
            _sortDirection,
            limit: 60,
            secondarySortField: _secondarySortField,
            secondarySortDirection: _secondarySortDirection);
        StateHasChanged();
    }

    private async Task SaveCollection()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("Please enter a name for the collection.", AppSeverity.Warning);
            _activeTab = "details";
            return;
        }

        if (string.Equals(PersistenceVisibility, "private", StringComparison.OrdinalIgnoreCase) && !Request.ActiveProfileId.HasValue)
        {
            Snackbar.Add("An active profile is required to save a private collection.", AppSeverity.Warning);
            _activeTab = "details";
            return;
        }

        if (_rulesEnabled && !_ruleDefinition.AllConditions.Any(IsCompleteRule))
        {
            Snackbar.Add("Add at least one complete rule before saving a collection that fills up from rules.", AppSeverity.Warning);
            _activeTab = "membership";
            _step = 2;
            return;
        }

        if (IsEmptyCuratedCollection)
        {
            Snackbar.Add(EmptyCuratedCollectionMessage, AppSeverity.Warning);
            _activeTab = "membership";
            _step = 2;
            return;
        }

        if (_seasonal && (!new DayMonth(_seasonFromMonth, _seasonFromDay).IsValid || !new DayMonth(_seasonToMonth, _seasonToDay).IsValid))
        {
            Snackbar.Add("Choose real days for the seasonal window, for example 1 October to 1 November.", AppSeverity.Warning);
            _activeTab = "details";
            return;
        }

        if (_ownerKind == "Profile" && _audience == "SelectedProfiles" && _selectedProfileIds.Count == 0)
        {
            Snackbar.Add("Choose at least one other profile to share this collection with.", AppSeverity.Warning);
            _activeTab = "details";
            return;
        }

        if (_personalMediaSection is not null && !_personalMediaSection.Validate(out var personalMediaError))
        {
            Snackbar.Add(personalMediaError ?? "Complete the companion source before saving.", AppSeverity.Warning);
            _activeTab = "companions";
            return;
        }

        if (IsCreateFlow && _way == FillWay.FromList)
        {
            await SaveListCollectionsAsync();
            return;
        }

        _saving = true;
        StateHasChanged();

        try
        {
            var definition = _rulesEnabled ? BuildPersistableDefinition() : new CollectionRuleDefinitionViewModel();

            var normalizedSortField = _randomOrder ? "random" : string.IsNullOrWhiteSpace(_sortField) ? null : _sortField;
            // Update treats empty text on both edges as "remove the window"; create just leaves it out.
            var seasonFrom = _seasonal ? SeasonText(_seasonFromMonth, _seasonFromDay) : string.Empty;
            var seasonTo = _seasonal ? SeasonText(_seasonToMonth, _seasonToDay) : string.Empty;
            Guid? savedCollectionId = EditingCollection?.Id ?? _createdCollectionId;
            var ok = false;

            if (savedCollectionId.HasValue)
            {
                ok = await ApiClient.UpdateCollectionAsync(
                    savedCollectionId.Value,
                    _name,
                    _description,
                    _iconName,
                    definition,
                    PersistenceVisibility,
                    normalizedSortField,
                    _sortDirection,
                    true,
                    null,
                    Request.ActiveProfileId,
                    secondarySortField: _secondarySortField,
                    secondarySortDirection: _secondarySortDirection,
                    membershipMode: _rulesEnabled ? "Smart" : "Manual",
                    primaryArea: _primaryArea,
                    ownerKind: _ownerKind,
                    audience: _ownerKind == "Library" ? "Everyone" : _audience,
                    selectedProfileIds: _selectedProfileIds.ToList(),
                    // Switching a rule-driven collection to manual brings its staged items in the same save, so it
                    // is never manual and empty at any point.
                    workIds: _storedRuleDriven && !_rulesEnabled ? _manualItems.Select(item => item.WorkId).ToList() : null,
                    minItems: _minItems,
                    maxItems: _maxItems,
                    seasonFrom: seasonFrom,
                    seasonTo: seasonTo,
                    showOn: _showOnLoaded ? _showOn.ToList() : null);
            }
            else
            {
                savedCollectionId = await ApiClient.CreateCollectionAndReturnIdAsync(
                    _name,
                    _description,
                    _iconName,
                    _collectionType,
                    definition,
                    normalizedSortField,
                    _sortDirection,
                    PersistenceVisibility,
                    Request.ActiveProfileId,
                    secondarySortField: _secondarySortField,
                    secondarySortDirection: _secondarySortDirection,
                    membershipMode: _rulesEnabled ? "Smart" : "Manual",
                    primaryArea: _primaryArea,
                    ownerKind: _ownerKind,
                    audience: _ownerKind == "Library" ? "Everyone" : _audience,
                    selectedProfileIds: _selectedProfileIds.ToList(),
                    // Curated items travel with the create call, so an empty curated collection never exists.
                    workIds: SupportsManualItems ? _manualItems.Select(item => item.WorkId).ToList() : null,
                    minItems: _minItems,
                    maxItems: _maxItems,
                    seasonFrom: _seasonal ? seasonFrom : null,
                    seasonTo: _seasonal ? seasonTo : null,
                    showOn: _showOn.ToList());
                _createdCollectionId = savedCollectionId;
                ok = savedCollectionId.HasValue;
            }

            if (!ok)
            {
                Snackbar.Add(
                    string.IsNullOrWhiteSpace(ApiClient.LastError)
                        ? "Failed to save collection."
                        : ApiClient.LastError,
                    AppSeverity.Error);
                return;
            }

            if (savedCollectionId.HasValue)
            {
                if (_personalMediaSection is not null
                    && !await _personalMediaSection.SaveAsync(savedCollectionId.Value))
                {
                    Snackbar.Add(
                        string.IsNullOrWhiteSpace(_personalMediaSection.LastError)
                            ? "The Collection was saved, but its personal-media sources could not be saved. Try again."
                            : _personalMediaSection.LastError,
                        AppSeverity.Error);
                    _activeTab = "companions";
                    return;
                }

                foreach (var (slot, file) in _artworkFiles)
                {
                    await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                    if (!await ApiClient.UploadCollectionArtworkAsync(savedCollectionId.Value, slot, stream, file.Name, Request.ActiveProfileId))
                        Snackbar.Add($"Collection saved, but {slot} artwork could not be uploaded.", AppSeverity.Warning);
                }
            }

            Snackbar.Add(
                EditingCollection is not null
                    ? $"Collection \"{_name}\" updated."
                    : $"Collection \"{_name}\" created.",
                AppSeverity.Success);

            _hasUnsavedChanges = false;
            await CloseEditorAsync(applied: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save collection: {ex.Message}", AppSeverity.Error);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    // From a list (Collections and lists spec 4b): one collection for the whole list, or one for each shelf ticked. Each collection is
    // created with the titles Library owns, then the list is attached as its source. If attaching fails the collection is taken
    // away again, so a half-made collection never stays behind.
    private async Task SaveListCollectionsAsync()
    {
        if (_listDraft.Recognition is not { } source || !ListReady)
        {
            Snackbar.Add("Drop a list with at least one title you own before creating the collection.", AppSeverity.Warning);
            _step = 2;
            return;
        }

        _saving = true;
        StateHasChanged();

        var created = new List<Guid>();
        var skipped = new List<string>();
        try
        {
            var shelves = _listDraft.Shelves.Count == 0
                ? new List<string?> { null }
                : _listDraft.Shelves.OrderBy(shelf => shelf, StringComparer.OrdinalIgnoreCase).Select(shelf => (string?)shelf).ToList();
            var seasonFrom = _seasonal ? SeasonText(_seasonFromMonth, _seasonFromDay) : null;
            var seasonTo = _seasonal ? SeasonText(_seasonToMonth, _seasonToDay) : null;
            var sortField = _randomOrder ? "random" : string.IsNullOrWhiteSpace(_sortField) ? null : _sortField;

            foreach (var shelf in shelves)
            {
                var preview = await ApiClient.PreviewCollectionListAsync(new ListImportPreviewRequest
                {
                    FileName = source.FileName,
                    ContentBase64 = source.ContentBase64,
                    Text = source.Text,
                    Shelf = shelf,
                    Overrides = _listDraft.Overrides,
                    ProfileId = Request.ActiveProfileId,
                });
                if (preview is null)
                {
                    Snackbar.Add(ApiClient.LastError ?? "The list could not be read again. Try again.", AppSeverity.Error);
                    break;
                }

                if (preview.MatchedWorkIds.Count == 0)
                {
                    skipped.Add(shelf ?? "the list");
                    continue;
                }

                var name = shelves.Count > 1 ? $"{_name.Trim()}: {shelf}" : _name.Trim();
                var collectionId = await ApiClient.CreateCollectionAndReturnIdAsync(
                    name,
                    _description,
                    _iconName,
                    _collectionType,
                    new CollectionRuleDefinitionViewModel(),
                    sortField,
                    _sortDirection,
                    PersistenceVisibility,
                    Request.ActiveProfileId,
                    secondarySortField: _secondarySortField,
                    secondarySortDirection: _secondarySortDirection,
                    membershipMode: "Manual",
                    primaryArea: _primaryArea,
                    ownerKind: _ownerKind,
                    audience: _ownerKind == "Library" ? "Everyone" : _audience,
                    selectedProfileIds: _selectedProfileIds.ToList(),
                    workIds: preview.MatchedWorkIds,
                    minItems: _minItems,
                    maxItems: _maxItems,
                    seasonFrom: seasonFrom,
                    seasonTo: seasonTo,
                    showOn: _showOn.ToList());
                if (collectionId is not { } id)
                {
                    Snackbar.Add(string.IsNullOrWhiteSpace(ApiClient.LastError) ? "Failed to save collection." : ApiClient.LastError, AppSeverity.Error);
                    break;
                }

                var attached = await ApiClient.ImportCollectionListAsync(id, new ListImportRequest
                {
                    FileName = source.FileName,
                    ContentBase64 = source.ContentBase64,
                    Text = source.Text,
                    Shelf = shelf,
                    Order = _listDraft.Order,
                    Refresh = _listDraft.Refresh,
                    SyncMode = _listDraft.SyncMode,
                    Overrides = _listDraft.Overrides,
                    ProfileId = Request.ActiveProfileId,
                });
                if (attached is null)
                {
                    var reason = ApiClient.LastError;
                    await ApiClient.DeleteCollectionAsync(id, Request.ActiveProfileId);
                    Snackbar.Add(string.IsNullOrWhiteSpace(reason) ? "The list could not be attached, so the collection was not created." : reason, AppSeverity.Error);
                    break;
                }

                created.Add(id);
                foreach (var (slot, file) in _artworkFiles)
                {
                    await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                    if (!await ApiClient.UploadCollectionArtworkAsync(id, slot, stream, file.Name, Request.ActiveProfileId))
                        Snackbar.Add($"Collection saved, but {slot} artwork could not be uploaded.", AppSeverity.Warning);
                }
            }

            if (skipped.Count > 0)
                Snackbar.Add($"Nothing from {string.Join(", ", skipped)} is in your library, so no collection was made for it.", AppSeverity.Warning);

            if (created.Count > 0)
            {
                Snackbar.Add(
                    created.Count == 1 ? $"Collection \"{_name.Trim()}\" created." : $"{created.Count} collections created.",
                    AppSeverity.Success);
            }

            // Nothing was made: stay on the last step so the person can fix it and try again. If some were made before a
            // failure the editor closes, so a retry cannot make them twice; the error above says what did not happen.
            if (created.Count == 0)
                return;

            _hasUnsavedChanges = false;
            await CloseEditorAsync(applied: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save collection: {ex.Message}", AppSeverity.Error);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task CloseEditorAsync(bool applied)
    {
        if (Inline)
        {
            await Closed.InvokeAsync(applied);
            return;
        }

        // Save or discard has already been approved by this editor's own flow.
        _dialogCloseGuard?.Dispose();
        _dialogCloseGuard = null;

        if (applied)
            DialogContext?.Close(AppDialogResult.Ok(true));
        else
            DialogContext?.Cancel();
    }

    private static string FormatWorkMeta(CollectionMediaLookupDto work)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(work.ParentContext))
            parts.Add(work.ParentContext);
        if (!string.IsNullOrWhiteSpace(work.Creator))
            parts.Add(work.Creator);
        if (!string.IsNullOrWhiteSpace(work.MediaType))
            parts.Add(work.MediaType);
        if (!string.IsNullOrWhiteSpace(work.Year))
            parts.Add(work.Year);
        return parts.Count == 0 ? "Library item" : string.Join("  -  ", parts);
    }

