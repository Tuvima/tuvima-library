                <div class="collection-flow__preview-sub">match now@(_previewResult.UsesPerProfileFields && !string.IsNullOrWhiteSpace(_previewResult.EvaluatedForProfileName) ? $", counted for {_previewResult.EvaluatedForProfileName}" : string.Empty). Updates as you type.</div>
            </div>
            <div class="collection-flow__pills">
                @foreach (var group in PreviewTypeCounts(_previewResult))
                {
                    <span class="collection-flow__pill" data-media="@group.Label">@FormatMediaCount(group.Label, group.Count)</span>
                }
