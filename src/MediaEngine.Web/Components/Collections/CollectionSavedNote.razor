@namespace MediaEngine.Web.Components.Collections
@inject IStringLocalizer<SharedStrings> L
@* The quiet confirmation for a page that does not show the saved collection as a tile (Watch, Read, Listen, Profile > Import):
   the collection editor records what it saved in CollectionEditorLaunchRequest.SavedCollectionIds, the host passes the count
   here, and the shared quiet saved line (AppSavedNote) says so. Pages that do show the tile glow it instead (CollectionsPage). There is no toast. *@
@if (Count > 0)
{
    <AppSavedNote Visible="true" data-collection-saved
                  Text="@(Count == 1 ? L["CollectionSaved_One"].Value : L["CollectionSaved_Many", Count].Value)" />
}

@code {
    /// <summary>How many collections the editor saved; nothing is drawn at zero.</summary>
    [Parameter] public int Count { get; set; }
}
