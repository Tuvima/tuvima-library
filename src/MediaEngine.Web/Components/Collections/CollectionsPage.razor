@namespace MediaEngine.Web.Components.Collections
@using MediaEngine.Contracts.Paging
@using MediaEngine.Contracts.Persons
@using MediaEngine.Contracts.Collections
@using MediaEngine.Web.Components.Browse
@using MediaEngine.Web.Components.MediaHub
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.MediaTiles

@inject IEngineApiClient ApiClient
@inject UIOrchestratorService Orchestrator
@inject DashboardSessionAccessor Session
@inject CollectionEditorLauncherService CollectionEditorLauncher
@inject IAppToastService Snackbar
@inject NavigationManager Nav
@inject ILogger<CollectionsPage> Logger

<BrowseShellStyles />

<MediaSectionShell Title="Collections"
                   NavigationGroups="@NavigationGroups"
                   ShowMobileNavigation="false">
    <LibrarySectionHeader Title="Collections"
                          Modes="@CollectionsSectionConfiguration.Modes"
                          ActiveMode="@_activeSection">
        <Actions>
            @if (CanManageCuratedCollections)
            {
                <AppButton ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary"
                           StartIcon="@AppMaterialIcons.Filled.Add"
                           OnClick="OpenCollectionBuilder">
                    New Collection
                </AppButton>
            }
        </Actions>
    </LibrarySectionHeader>

    <CollectionsSectionLayout>
        @if (_loading)
        {
            <AppPageState Kind="AppPageStateKind.Loading"
                          Title="Loading collections"
                          Message="Organizing automatic collections, curated collections, shelves, and people." />
        }
        else if (_loadFailed)
        {
            <AppErrorState Title="Collections failed to load"
                           Message="The Dashboard could not load the Collections section from the Engine."
                           Details="@_loadError"
                           Retry="ReloadAsync" />
        }
        else if (_activeSection == CollectionsSectionConfiguration.Overview)
        {
            <div class="collections-overview">
                @if (AutomaticTiles.Count > 0)
                {
                    <MediaTileShelf Shelf="@OverviewAutomaticShelf"
                                    HoverMode="MediaTileHoverMode.GlowOnly"
                                    HideMediaKindBadges="true"
                                    HideSourceBadges="true" />
                }

                @if (CuratedTiles.Count > 0)
                {
                    <MediaTileShelf Shelf="@OverviewCuratedShelf"
                                    HoverMode="MediaTileHoverMode.GlowOnly"
                                    HideMediaKindBadges="true"
                                    HideSourceBadges="true" />
                }

                @if (ShelfTiles.Count > 0)
                {
                    <MediaTileShelf Shelf="@OverviewShelvesShelf"
                                    HoverMode="MediaTileHoverMode.GlowOnly"
                                    HideMediaKindBadges="true"
                                    HideSourceBadges="true" />
                }

                @if (VisiblePeopleRoles.Count > 0)
                {
                    <section>
                        <div class="collections-results-heading">
                            <div class="collections-results-heading__copy">
                                <h1>Browse People</h1>
                                <p>Find the authors, directors, artists, narrators, and other primary contributors represented in your library.</p>
                            </div>
                            <AppButton ButtonStyle="AppButtonStyle.Text"
                                       Tone="AppUiTone.Neutral"
                                       Href="/collections/people"
                                       EndIcon="@AppMaterialIcons.Outlined.ArrowForward">
                                View all
                            </AppButton>
                        </div>
                        <div class="collections-overview__roles">
                            @foreach (var role in VisiblePeopleRoles)
                            {
                                <a class="collections-role-link"
                                   href="@($"/collections/people?role={Uri.EscapeDataString(role.Key)}")"
                                   @key="role.Key">
                                    <span class="collections-role-link__icon">
                                        <AppMaterialIcon Icon="@PeopleRoleIcon(role.Key)" />
                                    </span>
                                    <span>@RoleDisplayLabel(role.Key)</span>
                                    <span class="collections-role-link__count">@role.Value</span>
                                </a>
                            }
                        </div>
                    </section>
                }

                @if (AutomaticTiles.Count == 0 && CuratedTiles.Count == 0 && ShelfTiles.Count == 0 && VisiblePeopleRoles.Count == 0)
                {
                    <AppPageState Kind="AppPageStateKind.Empty"
                                  Title="Nothing has been grouped yet"
                                  Message="Collections and shelves appear as Tuvima Library identifies relationships in your library." />
                }
            </div>
        }
        else
        {
            <div class="browse-shell collections-browse">
                <div class="browse-shell__toolbar-anchor">
                    <div class="browse-shell__toolbar-panel">
                        <div class="browse-shell__filter-surface collections-filter-surface">
                            <div class="browse-shell__filter-search-row">
                                <AppTextField T="string"
                                              Value="@_searchText"
                                              ValueChanged="OnSearchChanged"
                                              Placeholder="@SearchPlaceholder"
                                              Variant="AppVariant.Outlined"
                                              Immediate="true"
                                              DebounceInterval="250"
                                              Adornment="AppAdornment.Start"
                                              AdornmentIcon="@AppMaterialIcons.Outlined.Search"
                                              Class="browse-shell__search" />
                            </div>

                            <div class="browse-shell__filter-lower-row collections-filter-lower-row">
                                <div class="browse-shell__control-group browse-shell__control-group--filters collections-filter-group">
                                    <span class="browse-shell__control-label">Filter by</span>
                                    <div class="collections-filter-selects">
                                <AppSelect T="string"
                                           Value="@_lane"
                                           ValueChanged="OnLaneChanged"
                                           Label="Lane"
                                           Variant="AppVariant.Outlined"
                                           Dense="true"
                                           Class="collections-filter-select">
                                    <AppSelectItem T="string" Value="@("all")">All lanes</AppSelectItem>
                                    @if (_activeSection == CollectionsSectionConfiguration.Automatic)
                                    {
                                        <AppSelectItem T="string" Value="@("CrossMedia")">Cross-media</AppSelectItem>
                                    }
                                    <AppSelectItem T="string" Value="@("Read")">Read</AppSelectItem>
                                    <AppSelectItem T="string" Value="@("Watch")">Watch</AppSelectItem>
                                    <AppSelectItem T="string" Value="@("Listen")">Listen</AppSelectItem>
                                </AppSelect>

                                @if (_activeSection == CollectionsSectionConfiguration.Automatic)
                                {
                                    <AppSelect T="string"
                                               Value="@_kind"
                                               ValueChanged="OnKindChanged"
                                               Label="Relationship"
                                               Variant="AppVariant.Outlined"
                                               Dense="true"
                                               Class="collections-filter-select collections-filter-select--wide">
                                        <AppSelectItem T="string" Value="@("all")">All relationships</AppSelectItem>
                                        <AppSelectItem T="string" Value="@("Universe")">Shared universes</AppSelectItem>
                                        <AppSelectItem T="string" Value="@("Series")">Series rollups</AppSelectItem>
                                        <AppSelectItem T="string" Value="@("ContentGroup")">Related works</AppSelectItem>
                                    </AppSelect>
                                }
                                else if (_activeSection == CollectionsSectionConfiguration.Curated)
                                {
                                    <AppSelect T="string"
                                               Value="@_membership"
                                               ValueChanged="OnMembershipChanged"
                                               Label="Membership"
                                               Variant="AppVariant.Outlined"
                                               Dense="true"
                                               Class="collections-filter-select collections-filter-select--wide">
                                        <AppSelectItem T="string" Value="@("all")">All membership</AppSelectItem>
                                        <AppSelectItem T="string" Value="@("manual")">Hand-picked</AppSelectItem>
                                        <AppSelectItem T="string" Value="@("rules")">Rule-driven</AppSelectItem>
                                    </AppSelect>
                                }
                                else if (_activeSection == CollectionsSectionConfiguration.Shelves)
                                {
                                    <AppSelect T="string"
                                               Value="@_kind"
                                               ValueChanged="OnKindChanged"
                                               Label="Media"
                                               Variant="AppVariant.Outlined"
                                               Dense="true"
                                               Class="collections-filter-select collections-filter-select--wide">
                                        <AppSelectItem T="string" Value="@("all")">All media</AppSelectItem>
                                        @foreach (var kind in ShelfMediaOptions)
                                        {
                                            <AppSelectItem T="string" Value="@kind.Value">@kind.Label</AppSelectItem>
                                        }
                                    </AppSelect>
                                }
                                else if (_activeSection == CollectionsSectionConfiguration.People)
                                {
                                    <AppSelect T="string"
                                               Value="@_role"
                                               ValueChanged="OnRoleChanged"
                                               Label="Role"
                                               Variant="AppVariant.Outlined"
                                               Dense="true"
                                               Class="collections-filter-select collections-filter-select--wide">
                                        <AppSelectItem T="string" Value="@("all")">All roles</AppSelectItem>
                                        @foreach (var role in PeopleRoleOptions)
                                        {
                                            <AppSelectItem T="string" Value="@role">@RoleDisplayLabel(role)</AppSelectItem>
                                        }
                                    </AppSelect>
                                }
                                    </div>
                                </div>

                                <div class="browse-shell__display-controls collections-display-controls">
                                    <span class="browse-shell__sort-label">Sort</span>
                                    <span class="browse-shell__display-label">Display</span>
                                <AppSelect T="string"
                                           Value="@_sortBy"
                                           ValueChanged="OnSortChanged"
                                           Variant="AppVariant.Outlined"
                                           Dense="true"
                                           Class="browse-shell__sort">
                                    @foreach (var option in SortOptions)
                                    {
                                        <AppSelectItem T="string" Value="@option.Value">@option.Label</AppSelectItem>
                                    }
                                </AppSelect>

                                @if (_activeSection != CollectionsSectionConfiguration.People)
                                {
                                    <label class="collections-tile-size">
                                        <span>Tile size</span>
                                        <AppNativeInput Type="range"
                                                        Value="@_tileSize"
                                                        Min="136"
                                                        Max="248"
                                                        Step="8"
                                                        AriaLabel="Collection tile size"
                                                        OnInput="OnTileSizeChanged" />
                                    </label>
                                }
                                </div>
                            </div>

                            <div class="collections-filter-summary">
                                <span class="collections-result-count">@ResultCountLabel</span>
                                <AppActiveFilterSummary Items="@ActiveFilterChips"
                                                        Remove="RemoveFilterAsync"
                                                        ClearAll="ClearFiltersAsync" />
                            </div>
                        </div>
                    </div>
                </div>

                @if (_activeSection == CollectionsSectionConfiguration.People)
                {
                    @if (FilteredPeople.Count == 0)
                    {
                        <AppPageState Kind="AppPageStateKind.Empty"
                                      Title="No people found"
                                      Message="Try removing a role, lane, or search filter."
                                      Class="collections-inline-empty" />
                    }
                    else
                    {
                        <PeopleCatalogList Items="@FilteredPeople" Presence="@_peoplePresence" />
                    }

                    @if (_peopleHasMore)
                    {
                        <div class="collections-load-more">
                            <AppButton ButtonStyle="AppButtonStyle.Filled"
                                       Tone="AppUiTone.Primary"
                                       OnClick="LoadMorePeopleAsync"
                                       Disabled="@_loadingMorePeople">
                                @(_loadingMorePeople ? "Loading..." : "Load more people")
                            </AppButton>
                        </div>
                    }
                }
                else if (ShowShelfLanePreviews)
                {
                    <div class="collections-shelf-lane-previews">
                        @foreach (var laneShelf in ShelfLanePreviews)
                        {
                            @if (laneShelf.Items.Count > 0)
                            {
                                <MediaTileShelf Shelf="@laneShelf"
                                                HoverMode="MediaTileHoverMode.GlowOnly"
                                                HideMediaKindBadges="true"
                                                HideSourceBadges="true" />
                            }
                            else
                            {
                                <EmptyShelfState Title="@laneShelf.Title" Message="@laneShelf.Subtitle" />
                            }
                        }
                    </div>
                }
                else if (ActiveTiles.Count == 0)
                {
                    <AppPageState Kind="AppPageStateKind.Empty"
                                  Title="@EmptyTitle"
                                  Message="@EmptyMessage"
                                  Class="collections-inline-empty" />
                }
                else
                {
                    <MediaTileGrid Items="@VisibleTiles"
                                   HoverMode="MediaTileHoverMode.GlowOnly"
                                   HideMediaKindBadges="true"
                                   HideSourceBadges="true"
                                   HideGroupIndicators="true"
                                   ShowCompactCaptions="true"
                                   TileSizePx="@_tileSize"
                                   Class="browse-shell__grid" />

                    @if (VisibleTiles.Count < ActiveTiles.Count)
                    {
                        <div class="collections-load-more">
                            <AppButton ButtonStyle="AppButtonStyle.Filled"
                                       Tone="AppUiTone.Primary"
                                       OnClick="ShowMoreTiles">
                                Load more
                            </AppButton>
                        </div>
                    }
                }
            </div>
        }
    </CollectionsSectionLayout>
</MediaSectionShell>

@code {
    private const int TilePageSize = 72;
    private const int PeoplePageSize = 100;

    [Parameter] public string? Section { get; set; }
    [Parameter] public string? SearchQuery { get; set; }
    [Parameter] public string? LaneQuery { get; set; }
    [Parameter] public string? KindQuery { get; set; }
    [Parameter] public string? MembershipQuery { get; set; }
    [Parameter] public string? RoleQuery { get; set; }
    [Parameter] public string? SortQuery { get; set; }
    [Parameter] public int? TileQuery { get; set; }

    private readonly List<CollectionManagementCatalogViewModel> _collections = [];
    private readonly List<ContentGroupViewModel> _shelves = [];
    private readonly List<PersonListItemResponse> _people = [];
    private readonly Dictionary<string, Dictionary<string, int>> _peoplePresence = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, int> _peopleRoleCounts = new(StringComparer.OrdinalIgnoreCase);
    private ProfileViewModel? _activeProfile;
    private string _activeSection = CollectionsSectionConfiguration.Overview;
    private string _searchText = string.Empty;
    private string _lane = "all";
    private string _kind = "all";
    private string _membership = "all";
    private string _role = "all";
    private string _sortBy = "title";
    private int _tileSize = 176;
    private int _visibleTileCount = TilePageSize;
    private int _peopleOffset;
    private bool _peopleHasMore;
    private bool _loading = true;
    private bool _loadingMorePeople;
    private bool _loaded;
    private bool _loadFailed;
    private string? _loadError;
    private string? _loadedPeopleQueryKey;

    private bool CanManageCuratedCollections =>
        Session.HasAction("access.manage");

    private IReadOnlyList<MediaSectionNavigationGroup> NavigationGroups =>
        CollectionsSectionConfiguration.BuildNavigation(
            AutomaticCollections.Count,
            CuratedCollections.Count,
            _shelves.Count,
            _people.Count == 0
                ? null
                : $"{_people.Count}{(_peopleHasMore ? "+" : string.Empty)}");

    private IReadOnlyList<CollectionManagementCatalogViewModel> AutomaticCollections =>
        _collections
            .Where(IsAutomaticCollection)
            .ToList();

    private IReadOnlyList<CollectionManagementCatalogViewModel> CuratedCollections =>
        _collections
            .Where(collection => string.Equals(collection.CollectionType, "Custom", StringComparison.OrdinalIgnoreCase))
            .ToList();

    private IReadOnlyList<MediaTileViewModel> AutomaticTiles =>
        AutomaticCollections.Select(CollectionSurfaceTileComposer.FromCollection).ToList();

    private IReadOnlyList<MediaTileViewModel> CuratedTiles =>
        CuratedCollections.Select(CollectionSurfaceTileComposer.FromCollection).ToList();

    private IReadOnlyList<MediaTileViewModel> ShelfTiles =>
        _shelves.Select(CollectionSurfaceTileComposer.FromContentGroup).ToList();

    private MediaTileShelfViewModel OverviewAutomaticShelf => new()
    {
        Key = "automatic-collections",
        Title = "Automatic Collections",
        Subtitle = "Broader worlds Tuvima Library found by connecting trusted relationships across your shelves",
        Items = SortCollectionTiles(AutomaticTiles).Take(12).ToList(),
        SeeAllRoute = "/collections/automatic",
    };

    private MediaTileShelfViewModel OverviewCuratedShelf => new()
    {
        Key = "curated-collections",
        Title = "Curated Collections",
        Subtitle = "Selections maintained by your library administrators",
        Items = SortCollectionTiles(CuratedTiles).Take(12).ToList(),
        SeeAllRoute = "/collections/curated",
    };

    private MediaTileShelfViewModel OverviewShelvesShelf => new()
    {
        Key = "library-shelves",
        Title = "Shelves Across Your Library",
        Subtitle = "Series, volumes, albums, and audiobook sequences grouped within their media type",
        Items = SortCollectionTiles(ShelfTiles).Take(12).ToList(),
        SeeAllRoute = "/collections/shelves",
    };

    private IReadOnlyList<KeyValuePair<string, int>> VisiblePeopleRoles =>
        _peopleRoleCounts
            .Where(pair => !string.Equals(pair.Key, "Composer", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(pair => pair.Value)
            .ThenBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase)
            .Take(8)
            .ToList();

    private IReadOnlyList<string> PeopleRoleOptions =>
        _peopleRoleCounts
            .Where(pair => pair.Value > 0)
            .Select(pair => pair.Key)
            .OrderBy(role => role, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private IReadOnlyList<MediaTileViewModel> ActiveTiles => _activeSection switch
    {
        CollectionsSectionConfiguration.Automatic => FilterAutomaticTiles(),
        CollectionsSectionConfiguration.Curated => FilterCuratedTiles(),
        CollectionsSectionConfiguration.Shelves => FilterShelfTiles(),
        _ => [],
    };

    private IReadOnlyList<MediaTileViewModel> VisibleTiles =>
        ActiveTiles.Take(_visibleTileCount).ToList();

    private IReadOnlyList<PersonListItemResponse> FilteredPeople
    {
        get
        {
            IEnumerable<PersonListItemResponse> people = _people;
            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                people = people.Where(person =>
                    person.name.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                    || person.roles.Any(role => role.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
                    || (person.occupation?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (_role != "all")
            {
                people = people.Where(person =>
                    person.roles.Contains(_role, StringComparer.OrdinalIgnoreCase));
            }

            if (_lane != "all")
            {
                people = people.Where(person => PersonHasLane(person.id, _lane));
            }

            return (_sortBy switch
            {
                "count" => people,
                _ => people.OrderBy(person => person.name, StringComparer.OrdinalIgnoreCase),
            }).ToList();
        }
    }

    private IReadOnlyList<(string Value, string Label)> SortOptions => _activeSection switch
    {
        CollectionsSectionConfiguration.Automatic =>
        [
            ("title", "A-Z"),
            ("count", "Largest"),
            ("newest", "Recently discovered"),
            ("year", "Newest year"),
        ],
        CollectionsSectionConfiguration.Curated =>
        [
            ("recent", "Recently updated"),
            ("title", "A-Z"),
            ("count", "Item count"),
            ("oldest", "Oldest"),
        ],
        CollectionsSectionConfiguration.Shelves =>
        [
            ("title", "A-Z"),
            ("count", "Owned count"),
            ("newest", "Recently added"),
            ("year", "Newest year"),
        ],
        _ =>
        [
            ("title", "A-Z"),
            ("count", "Most owned works"),
        ],
    };

    private static IReadOnlyList<(string Value, string Label)> ShelfMediaOptions { get; } =
    [
        ("Books", "Books"),
        ("Movies", "Movies"),
        ("Audiobooks", "Audiobooks"),
    ];

    private bool ShowShelfLanePreviews =>
        _activeSection == CollectionsSectionConfiguration.Shelves
        && string.IsNullOrWhiteSpace(_searchText)
        && _lane == "all"
        && _kind == "all";

    private IReadOnlyList<MediaTileShelfViewModel> ShelfLanePreviews =>
    [
        BuildShelfLanePreview(
            "Read",
            "Book series in your library"),
        BuildShelfLanePreview(
            "Watch",
            "Movie series in your library"),
        BuildShelfLanePreview(
            "Listen",
            "Audiobook series in your library"),
    ];

    private string SectionTitle => _activeSection switch
    {
        CollectionsSectionConfiguration.Automatic => "Automatic Collections",
        CollectionsSectionConfiguration.Curated => "Curated Collections",
        CollectionsSectionConfiguration.Shelves => "Shelves",
        CollectionsSectionConfiguration.People => "People",
        _ => "Collections",
    };

    private string SectionDescription => _activeSection switch
    {
        CollectionsSectionConfiguration.Automatic => "Broader franchise, universe, and related-work rollups discovered from trusted library relationships.",
        CollectionsSectionConfiguration.Curated => "Collections intentionally assembled or rule-maintained by administrators.",
        CollectionsSectionConfiguration.Shelves => "Series, volumes, albums, and audiobook sequences grouped within one media type.",
        CollectionsSectionConfiguration.People => "Primary contributors with owned work in your library, using the same canonical credits as detail pages.",
        _ => string.Empty,
    };

    private string SearchPlaceholder => _activeSection switch
    {
        CollectionsSectionConfiguration.Shelves => "Search shelves",
        CollectionsSectionConfiguration.People => "Search people or roles",
        _ => "Search collections",
    };

    private string ResultCountLabel => _activeSection == CollectionsSectionConfiguration.People
        ? $"{FilteredPeople.Count}{(_peopleHasMore ? "+" : string.Empty)} people"
        : $"{ActiveTiles.Count} {(_activeSection == CollectionsSectionConfiguration.Shelves ? "shelves" : "collections")}";

    private string EmptyTitle => _activeSection switch
    {
        CollectionsSectionConfiguration.Automatic => "No automatic collections found",
        CollectionsSectionConfiguration.Curated => "No curated collections found",
        CollectionsSectionConfiguration.Shelves => "No shelves found",
        _ => "Nothing found",
    };

    private string EmptyMessage => string.IsNullOrWhiteSpace(_searchText)
        ? _activeSection switch
        {
            CollectionsSectionConfiguration.Automatic => "Automatic collections appear when trusted relationships connect multiple shelves.",
            CollectionsSectionConfiguration.Curated => CanManageCuratedCollections
                ? "Create a collection to make it available to every profile."
                : "An administrator has not created any curated collections yet.",
            CollectionsSectionConfiguration.Shelves => "Shelves appear when at least two owned works belong to the same series, volume, album, or audiobook sequence.",
            _ => "Try another section.",
        }
        : "Clear the search or remove a filter to broaden the results.";

    private IReadOnlyList<ActiveFilterChip> ActiveFilterChips =>
    [
        .. _lane == "all" ? [] : new[] { new ActiveFilterChip("lane", _lane) },
        .. _kind == "all" ? [] : new[] { new ActiveFilterChip("kind", KindFilterLabel) },
        .. _membership == "all" ? [] : new[] { new ActiveFilterChip("membership", MembershipFilterLabel) },
        .. _role == "all" ? [] : new[] { new ActiveFilterChip("role", RoleDisplayLabel(_role)) },
    ];

    private string KindFilterLabel =>
        ShelfMediaOptions.FirstOrDefault(option => string.Equals(option.Value, _kind, StringComparison.OrdinalIgnoreCase)).Label
            is { Length: > 0 } shelfKindLabel
            ? shelfKindLabel
            : _kind switch
            {
                "Universe" => "Shared universes",
                "Series" => "Series rollups",
                "ContentGroup" => "Related works",
                _ => _kind,
            };

    private string MembershipFilterLabel => _membership == "manual" ? "Hand-picked" : "Rule-driven";
    protected override async Task OnParametersSetAsync()
    {
        _activeSection = CollectionsSectionConfiguration.NormalizeSection(Section);
        ReadUrlState();
        if (!_loaded)
        {
            await LoadAsync();
        }
        else if (_activeSection == CollectionsSectionConfiguration.People
                 && !string.Equals(_loadedPeopleQueryKey, CurrentPeopleQueryKey, StringComparison.Ordinal))
        {
            await ReloadPeopleForFiltersAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        _loadError = null;
        try
        {
            _activeProfile = await Orchestrator.GetActiveProfileAsync();

            var catalogTask = ApiClient.GetCollectionCatalogAsync(_activeProfile?.Id);
            var shelvesTask = ApiClient.GetContentGroupsAsync();
            var peopleRolesTask = ApiClient.GetPersonRoleCountsAsync();
            var peopleTask = ApiClient.GetPersonsPageAsync(
                search: _activeSection == CollectionsSectionConfiguration.People ? NullIfBlank(_searchText) : null,
                role: _activeSection == CollectionsSectionConfiguration.People && _role != "all" ? _role : null,
                offset: 0,
                limit: PeoplePageSize,
                lane: _activeSection == CollectionsSectionConfiguration.People && _lane != "all" ? _lane : null,
                sort: _activeSection == CollectionsSectionConfiguration.People ? _sortBy : null);

            await Task.WhenAll(
                catalogTask,
                shelvesTask,
                peopleRolesTask,
                peopleTask);

            _collections.Clear();
            _collections.AddRange(catalogTask.Result);
            BuildShelves(shelvesTask.Result);
            _peopleRoleCounts = peopleRolesTask.Result;

            _people.Clear();
            _peopleOffset = 0;
            await AppendPeoplePageAsync(peopleTask.Result ?? EmptyPeoplePage());
            _loadedPeopleQueryKey = CurrentPeopleQueryKey;
            _loaded = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the Collections section.");
            _loadFailed = true;
            _loadError = ApiClient.LastError ?? ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ReloadAsync()
    {
        _loaded = false;
        return LoadAsync();
    }

    private void BuildShelves(IReadOnlyList<ContentGroupViewModel> shelves)
    {
        _shelves.Clear();
        _shelves.AddRange(shelves
            .Where(shelf => shelf.DistinctTitleCount >= 2 && IsShelfMediaType(shelf.PrimaryMediaType))
            .GroupBy(shelf => $"{NormalizeShelfMediaType(shelf.PrimaryMediaType)}:{shelf.DisplayName}", StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First()));
    }

    private MediaTileShelfViewModel BuildShelfLanePreview(string lane, string subtitle) => new()
    {
        Key = $"{lane.ToLowerInvariant()}-shelves",
        Title = lane,
        Subtitle = subtitle,
        Items = SortCollectionTiles(_shelves
                .Where(shelf => string.Equals(ShelfLane(shelf.PrimaryMediaType), lane, StringComparison.OrdinalIgnoreCase))
                .Select(CollectionSurfaceTileComposer.FromContentGroup))
            .Take(12)
            .ToList(),
        SeeAllRoute = $"/collections/shelves?lane={lane}",
    };

    private async Task AppendPeoplePageAsync(PagedResponse<PersonListItemResponse> page)
    {
        _peopleHasMore = page.HasMore;
        _peopleOffset = page.Offset + page.Items.Count;

        var presence = await ApiClient.GetPersonPresenceAsync(page.Items.Select(person => person.id));
        foreach (var pair in presence)
            _peoplePresence[pair.Key] = pair.Value;

        _people.AddRange(page.Items
            .Where(person => _peoplePresence.TryGetValue(person.id.ToString(), out var counts)
                && counts.Values.Sum() > 0)
            .Where(person => _people.All(existing => existing.id != person.id)));
    }

    private async Task LoadMorePeopleAsync()
    {
        if (_loadingMorePeople || !_peopleHasMore)
            return;

        _loadingMorePeople = true;
        try
        {
            var next = await ApiClient.GetPersonsPageAsync(
                search: _activeSection == CollectionsSectionConfiguration.People ? NullIfBlank(_searchText) : null,
                role: _activeSection == CollectionsSectionConfiguration.People && _role != "all" ? _role : null,
                offset: _peopleOffset,
                limit: PeoplePageSize,
                lane: _activeSection == CollectionsSectionConfiguration.People && _lane != "all" ? _lane : null,
                sort: _activeSection == CollectionsSectionConfiguration.People ? _sortBy : null);
            await AppendPeoplePageAsync(next ?? EmptyPeoplePage(_peopleOffset));
        }
        finally
        {
            _loadingMorePeople = false;
        }
    }

    private IReadOnlyList<MediaTileViewModel> FilterAutomaticTiles()
    {
        var collections = AutomaticCollections.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchText))
            collections = collections.Where(MatchesCollectionSearch);
        if (_lane != "all")
            collections = collections.Where(collection => string.Equals(collection.PrimaryLane, _lane, StringComparison.OrdinalIgnoreCase));
        if (_kind != "all")
            collections = collections.Where(collection => string.Equals(collection.CollectionType, _kind, StringComparison.OrdinalIgnoreCase));
        return SortCollectionTiles(collections.Select(CollectionSurfaceTileComposer.FromCollection));
    }

    private IReadOnlyList<MediaTileViewModel> FilterCuratedTiles()
    {
        var collections = CuratedCollections.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchText))
            collections = collections.Where(MatchesCollectionSearch);
        if (_lane != "all")
            collections = collections.Where(collection => string.Equals(collection.PrimaryLane, _lane, StringComparison.OrdinalIgnoreCase));
        if (_membership == "manual")
            collections = collections.Where(collection => string.Equals(collection.Resolution, "materialized", StringComparison.OrdinalIgnoreCase));
        else if (_membership == "rules")
            collections = collections.Where(collection => string.Equals(collection.Resolution, "query", StringComparison.OrdinalIgnoreCase));
        return SortCollectionTiles(collections.Select(CollectionSurfaceTileComposer.FromCollection));
    }

    private IReadOnlyList<MediaTileViewModel> FilterShelfTiles()
    {
        var shelves = _shelves.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            shelves = shelves.Where(entry =>
                entry.DisplayName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || (entry.Description?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)
                || (entry.Creator?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        if (_lane != "all")
            shelves = shelves.Where(entry => string.Equals(ShelfLane(entry.PrimaryMediaType), _lane, StringComparison.OrdinalIgnoreCase));
        if (_kind != "all")
            shelves = shelves.Where(entry => string.Equals(NormalizeShelfMediaType(entry.PrimaryMediaType), _kind, StringComparison.OrdinalIgnoreCase));
        return SortCollectionTiles(shelves.Select(CollectionSurfaceTileComposer.FromContentGroup));
    }

    private static bool IsShelfMediaType(string? mediaType) => NormalizeShelfMediaType(mediaType) is
        "Books" or "Movies" or "Audiobooks";

    private static string NormalizeShelfMediaType(string? mediaType)
    {
        var value = mediaType ?? string.Empty;
        if (value.Contains("audio", StringComparison.OrdinalIgnoreCase)) return "Audiobooks";
        if (value.Contains("music", StringComparison.OrdinalIgnoreCase) || value.Contains("album", StringComparison.OrdinalIgnoreCase)) return "Albums";
        if (value.Contains("comic", StringComparison.OrdinalIgnoreCase)) return "Comics";
        if (value.Contains("movie", StringComparison.OrdinalIgnoreCase) || value.Contains("film", StringComparison.OrdinalIgnoreCase)) return "Movies";
        if (value.Contains("book", StringComparison.OrdinalIgnoreCase)) return "Books";
        return value;
    }

    private static string ShelfLane(string? mediaType) => NormalizeShelfMediaType(mediaType) switch
    {
        "Books" or "Comics" => "Read",
        "Movies" => "Watch",
        "Albums" or "Audiobooks" => "Listen",
        _ => "CrossMedia",
    };

    private IReadOnlyList<MediaTileViewModel> SortCollectionTiles(IEnumerable<MediaTileViewModel> items) =>
        (_sortBy switch
        {
            "count" => items.OrderByDescending(item => item.PreviewTotalCount).ThenBy(item => item.Title),
            "newest" or "recent" => items.OrderByDescending(item => item.SortTimestamp).ThenBy(item => item.Title),
            "oldest" => items.OrderBy(item => item.SortTimestamp).ThenBy(item => item.Title),
            "year" => items.OrderByDescending(item => item.SortYear).ThenBy(item => item.Title),
            _ => items.OrderBy(item => item.Title, StringComparer.OrdinalIgnoreCase),
        }).ToList();

    private bool MatchesCollectionSearch(CollectionManagementCatalogViewModel collection) =>
        collection.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
        || (collection.Description?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)
        || collection.CollectionType.Contains(_searchText, StringComparison.OrdinalIgnoreCase);

    private void ReadUrlState()
    {
        _searchText = SearchQuery ?? string.Empty;
        _lane = LaneQuery ?? "all";
        _kind = KindQuery ?? "all";
        _membership = MembershipQuery ?? "all";
        _role = RoleQuery ?? "all";
        _sortBy = ResolveSort(SortQuery);
        _tileSize = TileQuery.HasValue
            ? Math.Clamp(TileQuery.Value, 136, 248)
            : 176;
        _visibleTileCount = TilePageSize;
    }

    private string ResolveSort(string? requested)
    {
        var allowed = SortOptions.Select(option => option.Value).ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (!string.IsNullOrWhiteSpace(requested) && allowed.Contains(requested))
            return requested;
        return _activeSection == CollectionsSectionConfiguration.Curated ? "recent" : "title";
    }

    private async Task OnSearchChanged(string value)
    {
        _searchText = value;
        NavigateWithFilters();
        if (_activeSection == CollectionsSectionConfiguration.People)
            await ReloadPeopleForFiltersAsync();
    }

    private async Task OnLaneChanged(string value)
    {
        _lane = value;
        NavigateWithFilters();
        if (_activeSection == CollectionsSectionConfiguration.People)
            await ReloadPeopleForFiltersAsync();
    }

    private Task OnKindChanged(string value)
    {
        _kind = value;
        NavigateWithFilters();
        return Task.CompletedTask;
    }

    private Task OnMembershipChanged(string value)
    {
        _membership = value;
        NavigateWithFilters();
        return Task.CompletedTask;
    }

    private async Task OnRoleChanged(string value)
    {
        _role = value;
        NavigateWithFilters();
        await ReloadPeopleForFiltersAsync();
    }

    private async Task OnSortChanged(string value)
    {
        _sortBy = value;
        NavigateWithFilters();
        if (_activeSection == CollectionsSectionConfiguration.People)
            await ReloadPeopleForFiltersAsync();
    }

    private void OnTileSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var tileSize))
        {
            _tileSize = Math.Clamp(tileSize, 136, 248);
            NavigateWithFilters();
        }
    }

    private void NavigateWithFilters()
    {
        _visibleTileCount = TilePageSize;
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(_searchText))
            query.Add($"q={Uri.EscapeDataString(_searchText)}");
        if (_lane != "all")
            query.Add($"lane={Uri.EscapeDataString(_lane)}");
        if (_kind != "all" && _activeSection is CollectionsSectionConfiguration.Automatic or CollectionsSectionConfiguration.Shelves)
            query.Add($"kind={Uri.EscapeDataString(_kind)}");
        if (_membership != "all" && _activeSection == CollectionsSectionConfiguration.Curated)
            query.Add($"membership={Uri.EscapeDataString(_membership)}");
        if (_role != "all" && _activeSection == CollectionsSectionConfiguration.People)
            query.Add($"role={Uri.EscapeDataString(_role)}");
        if (_sortBy != ResolveSort(null))
            query.Add($"sort={Uri.EscapeDataString(_sortBy)}");
        if (_tileSize != 176 && _activeSection != CollectionsSectionConfiguration.People)
            query.Add($"tile={_tileSize}");

        var route = _activeSection == CollectionsSectionConfiguration.Overview
            ? "/collections"
            : $"/collections/{_activeSection}";
        Nav.NavigateTo(query.Count == 0 ? route : $"{route}?{string.Join("&", query)}");
    }

    private Task RemoveFilterAsync(string key)
    {
        switch (key)
        {
            case "lane": _lane = "all"; break;
            case "kind": _kind = "all"; break;
            case "membership": _membership = "all"; break;
            case "role": _role = "all"; break;
        }
        NavigateWithFilters();
        return Task.CompletedTask;
    }

    private Task ClearFiltersAsync()
    {
        _lane = "all";
        _kind = "all";
        _membership = "all";
        _role = "all";
        NavigateWithFilters();
        return Task.CompletedTask;
    }

    private async Task ReloadPeopleForFiltersAsync()
    {
        _loadingMorePeople = true;
        try
        {
            _people.Clear();
            _peoplePresence.Clear();
            _peopleOffset = 0;
            var page = await ApiClient.GetPersonsPageAsync(
                search: NullIfBlank(_searchText),
                role: _role == "all" ? null : _role,
                offset: 0,
                limit: PeoplePageSize,
                lane: _lane == "all" ? null : _lane,
                sort: _sortBy);
            await AppendPeoplePageAsync(page ?? EmptyPeoplePage());
            _loadedPeopleQueryKey = CurrentPeopleQueryKey;
        }
        finally
        {
            _loadingMorePeople = false;
        }
    }

    private void ShowMoreTiles() =>
        _visibleTileCount += TilePageSize;

    private async Task OpenCollectionBuilder()
    {
        if (_activeProfile is null || !CanManageCuratedCollections)
        {
            Snackbar.Add("Only an administrator can create a curated collection.", AppSeverity.Warning);
            return;
        }

        var changed = await CollectionEditorLauncher.OpenAsync(new CollectionEditorLaunchRequest
        {
            ActiveProfileId = _activeProfile.Id,
            InitialMembershipMode = "Manual",
            Kind = ContainerEditorKind.Collection,
        });

        if (changed)
        {
            _loaded = false;
            await LoadAsync();
        }
    }

    private bool PersonHasLane(Guid personId, string lane) =>
        _peoplePresence.TryGetValue(personId.ToString(), out var presence)
        && presence.Any(pair => string.Equals(LaneForMediaType(pair.Key), lane, StringComparison.OrdinalIgnoreCase)
            && pair.Value > 0);

    private static bool IsAutomaticCollection(CollectionManagementCatalogViewModel collection) =>
        !collection.IsSystem
        && collection.CollectionType is "Universe" or "Series" or "ContentGroup";

    private static string LaneForMediaType(string mediaType)
    {
        if (mediaType.Contains("book", StringComparison.OrdinalIgnoreCase)
            || mediaType.Contains("comic", StringComparison.OrdinalIgnoreCase)
            || mediaType.Contains("epub", StringComparison.OrdinalIgnoreCase))
            return "Read";
        if (mediaType.Contains("movie", StringComparison.OrdinalIgnoreCase)
            || mediaType.Contains("tv", StringComparison.OrdinalIgnoreCase)
            || mediaType.Contains("video", StringComparison.OrdinalIgnoreCase))
            return "Watch";
        if (mediaType.Contains("audio", StringComparison.OrdinalIgnoreCase)
            || mediaType.Contains("music", StringComparison.OrdinalIgnoreCase)
            || mediaType.Contains("track", StringComparison.OrdinalIgnoreCase))
            return "Listen";
        return "CrossMedia";
    }

    private static string RoleDisplayLabel(string role) => role switch
    {
        "Author" => "Authors",
        "Director" => "Directors",
        "Artist" => "Artists",
        "Narrator" => "Narrators",
        "Actor" => "Actors",
        "Performer" => "Performers",
        "Illustrator" => "Illustrators",
        "Writer" => "Writers",
        "Creator" => "Creators",
        _ => role,
    };

    private static string PeopleRoleIcon(string role) => role switch
    {
        "Author" or "Writer" => AppMaterialIcons.Outlined.Edit,
        "Director" => AppMaterialIcons.Outlined.MovieFilter,
        "Artist" or "Performer" => AppMaterialIcons.Outlined.MusicNote,
        "Narrator" => AppMaterialIcons.Outlined.RecordVoiceOver,
        "Actor" => AppMaterialIcons.Outlined.TheaterComedy,
        "Illustrator" => AppMaterialIcons.Outlined.Brush,
        _ => AppMaterialIcons.Outlined.Person,
    };

    private string CurrentPeopleQueryKey =>
        $"{_searchText.Trim().ToLowerInvariant()}|{_role.Trim().ToLowerInvariant()}|{_lane.Trim().ToLowerInvariant()}|{_sortBy.Trim().ToLowerInvariant()}";

    private static string? NullIfBlank(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static PagedResponse<PersonListItemResponse> EmptyPeoplePage(int offset = 0) =>
        new([], offset, PeoplePageSize, false);

}
