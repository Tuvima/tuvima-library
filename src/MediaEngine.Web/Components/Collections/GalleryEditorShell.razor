@namespace MediaEngine.Web.Components.Collections
@implements IDisposable
@using System.Text.Json
@using MediaEngine.Contracts.Collections
@using MediaEngine.Contracts.LocalAssets
@using MediaEngine.Contracts.Vault
@using MediaEngine.Web.Services.Vault
@using MediaEngine.Domain.PersonalMedia
@using MediaEngine.Web.Components.MediaEditor
@using MediaEngine.Web.Components.Rules
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Editing
@inject IEngineApiClient ApiClient
@inject UIOrchestratorService Orchestrator
@inject IAppToastService Snackbar
@inject IStringLocalizer<SharedStrings> L

<MediaEditorSurface>
    <div class="sme-shell collection-editor-workspace">
        <header class="sme-header collection-editor-header">
            <div class="collection-editor-header-icon"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PhotoAlbum" /></div>
            <div class="sme-header-copy">
                <div class="sme-kicker">@L["GalleryEditorShell_GalleryEditor"]</div>
                <h2 class="sme-title">@(string.IsNullOrWhiteSpace(_name) ? (IsEditing ? "Edit Gallery" : "New Gallery") : _name)</h2>
                <div class="sme-subtitle">@(Request.Vault ? "Organize Vault images by hand or with a rule." : "Organize photos and videos with the same manual or smart membership model.")</div>
            </div>
            <AppIconButton Icon="@AppMaterialIcons.Outlined.Close" Tooltip="@L["Common_CloseEditor"].Value" AriaLabel="@L["Common_CloseEditor"].Value" OnClick="Cancel" />
        </header>
        <div class="sme-workspace collection-editor-layout">
            <nav class="sme-section-nav collection-editor-rail" aria-label="@L["GalleryEditorShell_GalleryEditorSections"].Value">
                @foreach (var tab in VisibleTabs)
                {
                    <AppButton ButtonStyle="AppButtonStyle.Text" Class="@TabClass(tab.Id)" OnClick="@(() => _activeTab = tab.Id)">
                        <AppMaterialIcon Icon="@tab.Icon" Size="AppSize.Small" /><span>@tab.Label</span>
                    </AppButton>
                }
                @if (IsEditing)
                {
                    <div class="collection-editor-rail-footer">
                        <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Error" StartIcon="@AppMaterialIcons.Outlined.DeleteOutline" OnClick="DeleteAsync">@L["GalleryEditorShell_DeleteGallery"]</AppButton>
                        <small>@(Request.Vault ? "The images are kept." : "Original photos and videos are kept.")</small>
                    </div>
                }
            </nav>
            <main class="sme-main-pane collection-editor-main">
                <div class="sme-body collection-editor-body">
                    @if (_activeTab == "details")
                    {
                        <div class="collection-editor-pane collection-editor-panel-stack">
                            <AppTextField T="string" @bind-Value="_name" Label="@L["Users_ColName"].Value" Variant="AppVariant.Outlined" Immediate="true" />
                            <AppTextarea @bind-Value="_description" Label="@L["Common_DescriptionOptional"].Value" Lines="5" Immediate="true" />
                        </div>
                    }
                    else if (_activeTab == "artwork")
                    {
                        <div class="collection-editor-pane">
                            <div class="collection-editor-empty"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.AutoAwesomeMotion" /><strong>@L["GalleryEditorShell_AutomaticCover"]</strong><span>@L["GalleryEditorShell_TheGalleryUsesItsCover"]</span></div>
                        </div>
                    }
                    else if (_activeTab == "membership")
                    {
                        <div class="collection-editor-pane"><MediaEditorPanel Title="@L["Common_Membership"].Value" Description="@L["GalleryEditorShell_ChooseHowPhotosAndVideos"].Value">
                            @if (!(Request.Vault && IsEditing))
                            {
                                <div class="collection-editor-membership-mode"><div class="collection-editor-membership-mode__options">
                                    <AppNativeButton Type="button" Class="@(!_smart ? "is-selected" : null)" OnClick="@(() => SetSmart(false))">@L["GalleryEditorShell_Manual"]</AppNativeButton>
                                    <AppNativeButton Type="button" Class="@(_smart ? "is-selected" : null)" OnClick="@(() => SetSmart(true))">@L["Common_Smart"]</AppNativeButton>
                                </div></div>
                            }
                        </MediaEditorPanel>
                        @if (_smart)
                        {
                            <ViewRuleBuilder Catalog="@(Request.Vault ? VaultRuleCatalog.Instance : null)" Definition="@_rules" DefinitionChanged="RulesChanged" />
                        }
                        else if (Request.Vault)
                        {
                            <MediaEditorPanel Title="@L["GalleryEditorShell_ManualItems"].Value" Description="@L["GalleryEditorShell_OpenAnImageInThe"].Value">
                                <div class="collection-editor-empty"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.AddPhotoAlternate" /><span>@L["GalleryEditorShell_ImagesAreAddedOneAt"]</span></div>
                            </MediaEditorPanel>
                        }
                        else
                        {
                            <MediaEditorPanel Title="@L["GalleryEditorShell_ManualItems"].Value" Description="@L["GalleryEditorShell_UseAddToGalleryFrom"].Value">
                                <div class="collection-editor-empty"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.AddPhotoAlternate" /><span>@L["GalleryEditorShell_ManualMembershipStaysAvailableAs"]</span></div>
                            </MediaEditorPanel>
                        }
                        </div>
                    }
                    else if (_activeTab == "soundtrack")
                    {
                        <div class="collection-editor-pane"><MediaEditorPanel Title="@L["GalleryEditorShell_Soundtrack"].Value" Description="@L["GalleryEditorShell_OptionalMusicCanEnrichThis"].Value">
                            <AppSelect T="string" Value="@_soundtrackPlaylistValue" ValueChanged="SoundtrackChanged" Label="@L["GalleryEditorShell_Playlist"].Value" Variant="AppVariant.Outlined">
                                <AppSelectItem T="string" Value="@(string.Empty)">@L["GalleryEditorShell_NoSoundtrack"]</AppSelectItem>
                                @foreach (var playlist in _playlists)
                                {
                                    <AppSelectItem T="string" Value="@(playlist.Id.ToString("D"))">@playlist.Name</AppSelectItem>
                                }
                            </AppSelect>
                            @if (_playlists.Count == 0)
                            {
                                <AppAlert Tone="AppUiTone.Info">@L["GalleryEditorShell_CreateAPlaylistInListen"]</AppAlert>
                            }
                            else
                            {
                                <small>@L["GalleryEditorShell_TheLinkedPlaylistRemainsManaged"]</small>
                            }
                        </MediaEditorPanel></div>
                    }
                    else
                    {
                        <div class="collection-editor-pane">
                            <div class="collection-editor-history-entry"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.AddCircleOutline" /><div><strong>@L["GalleryEditorShell_GalleryCreated"]</strong><span>@Request.EditingGallery?.CreatedAt.ToLocalTime().ToString("f")</span></div></div>
                        </div>
                    }
                </div>
                <footer class="sme-footer collection-editor-footer">
                    <div></div><div class="collection-editor-footer-actions"><AppButton ButtonStyle="AppButtonStyle.Text" OnClick="Cancel">@L["Search_Cancel"]</AppButton><AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@_saving" OnClick="SaveAsync">@(IsEditing ? "Save" : "Create Gallery")</AppButton></div>
                </footer>
            </main>
        </div>
    </div>
</MediaEditorSurface>

@code {
    [CascadingParameter] private IAppDialogContext? DialogContext { get; set; }
    [Parameter] public GalleryEditorLaunchRequest Request { get; set; } = new();
    private static readonly (string Id, string Label, string Icon)[] Tabs =
    [
        ("details", "Details", AppMaterialIcons.Outlined.Article),
        ("artwork", "Artwork", AppMaterialIcons.Outlined.PhotoLibrary),
        ("membership", "Membership", AppMaterialIcons.Outlined.Inventory2),
        ("soundtrack", "Soundtrack", AppMaterialIcons.Outlined.MusicNote),
        ("history", "History", AppMaterialIcons.Outlined.History),
    ];
    // A Vault gallery has a name and its membership only: no artwork choice, no soundtrack and no history.
    private IEnumerable<(string Id, string Label, string Icon)> VisibleTabs => Request.Vault
        ? Tabs.Where(tab => tab.Id is "details" or "membership")
        : Tabs.Where(tab => IsEditing || tab.Id != "history");
    private bool IsEditing => Request.Vault ? Request.EditingVaultGallery is not null : Request.EditingGallery is not null;
    private string _activeTab = "details";
    private string _name = string.Empty;
    private string? _description;
    private bool _smart;
    private bool _saving;
    private IDisposable? _dialogCloseGuard;
    private string _soundtrackPlaylistValue = string.Empty;
    private List<ManagedCollectionViewModel> _playlists = [];
    private CollectionRuleDefinitionViewModel _rules = EmptyRules();

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (DialogContext is not null) _dialogCloseGuard ??= DialogContext.RegisterCloseGuard(() => Task.FromResult(!_saving));
        return Task.CompletedTask;
    }

    public void Dispose() => _dialogCloseGuard?.Dispose();

    protected override void OnInitialized()
    {
        if (Request.Vault)
        {
            _name = Request.EditingVaultGallery?.Name ?? string.Empty;
            _description = Request.EditingVaultGallery?.Description;
            _smart = Request.EditingVaultGallery?.Kind == VaultImageGalleryKinds.Smart
                || string.Equals(Request.InitialMembershipMode, "Smart", StringComparison.OrdinalIgnoreCase);
            if (_smart && Request.EditingVaultGallery is not null)
                _rules = ParseRules(Request.EditingVaultGallery.SmartRuleJson);
            return;
        }

        _name = Request.EditingGallery?.Name ?? string.Empty;
        _description = Request.EditingGallery?.Description;
        _smart = Request.EditingGallery?.Kind == ViewGalleryKind.Smart || string.Equals(Request.InitialMembershipMode, "Smart", StringComparison.OrdinalIgnoreCase);
        _soundtrackPlaylistValue = Request.EditingGallery?.SoundtrackPlaylistId?.ToString("D") ?? string.Empty;
        if (_smart && Request.EditingGallery is not null)
            _rules = ParseRules(Request.EditingGallery.SmartRuleJson);
    }

    protected override async Task OnInitializedAsync()
    {
        // The Vault has no soundtrack, so it reads no playlists.
        if (Request.Vault)
            return;

        var activeProfile = await Orchestrator.GetActiveProfileAsync();
        _playlists = (await ApiClient.GetManagedCollectionsAsync(activeProfile?.Id))
            .Where(collection => collection.IsEnabled
                && (string.Equals(collection.CollectionType, "Playlist", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(collection.CollectionType, "Smart", StringComparison.OrdinalIgnoreCase)))
            .OrderBy(collection => collection.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private string TabClass(string id) => id == _activeTab ? "app-selection-nav__item sme-section-nav__item is-active" : "app-selection-nav__item sme-section-nav__item";
    private void SetSmart(bool value) => _smart = value;
    private Task SoundtrackChanged(string value) { _soundtrackPlaylistValue = value; return Task.CompletedTask; }
    private Task RulesChanged(CollectionRuleDefinitionViewModel value) { _rules = value; return Task.CompletedTask; }
    private void Cancel() => DialogContext?.Cancel();

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name)) { Snackbar.Add(L["GalleryEditorShell_EnterAGalleryName"].Value, AppSeverity.Warning); _activeTab = "details"; return; }
        var ruleJson = _smart ? SerializeRules(_rules) : null;
        if (_smart && ruleJson is null) { Snackbar.Add(L["GalleryEditorShell_ASmartGalleryNeedsAt"].Value, AppSeverity.Warning); _activeTab = "membership"; return; }
        if (Request.Vault)
        {
            await SaveVaultAsync(ruleJson);
            return;
        }

        _saving = true;
        var soundtrackPlaylistId = Guid.TryParse(_soundtrackPlaylistValue, out var parsedPlaylistId) ? parsedPlaylistId : (Guid?)null;
        var request = new ViewGalleryRequest(_name.Trim(), _smart ? ViewGalleryKind.Smart : ViewGalleryKind.Manual,
            _description, ruleJson, Request.EditingGallery?.CoverItemId,
            Request.EditingGallery?.SortOrder ?? 0, soundtrackPlaylistId);
        var saved = IsEditing ? await ApiClient.UpdateViewGalleryAsync(Request.EditingGallery!.Id, request) : await ApiClient.CreateViewGalleryAsync(request);
        _saving = false;
        if (saved is null) { Snackbar.Add(L["GalleryEditorShell_TheGalleryCouldNotBe"].Value, AppSeverity.Error); return; }
        Snackbar.Add(IsEditing ? "Gallery updated." : "Gallery created.", AppSeverity.Success);
        DialogContext?.Close(AppDialogResult.Ok(true));
    }

    private async Task SaveVaultAsync(string? ruleJson)
    {
        _saving = true;
        VaultCall<VaultImageGalleryDto> saved;
        try
        {
            var request = new VaultImageGalleryRequest
            {
                Name = _name.Trim(),
                Description = _description,
                Kind = _smart ? VaultImageGalleryKinds.Smart : VaultImageGalleryKinds.Manual,
                SmartRuleJson = ruleJson,
                CoverImageId = Request.EditingVaultGallery?.CoverImageId,
            };
            saved = Request.EditingVaultGallery is { } existing
                ? await ApiClient.UpdateVaultImageGalleryAsync(existing.Id, request)
                : await ApiClient.CreateVaultImageGalleryAsync(request);
        }
        finally { _saving = false; }
        if (!saved.Succeeded) { Snackbar.Add(saved.Message ?? "The gallery could not be saved.", AppSeverity.Error); return; }
        Snackbar.Add(IsEditing ? "Gallery updated." : "Gallery created.", AppSeverity.Success);
        DialogContext?.Close(AppDialogResult.Ok(true));
    }

    private async Task DeleteAsync()
    {
        if (_saving) return;
        _saving = true;
        bool deleted;
        try
        {
            deleted = Request.Vault
                ? Request.EditingVaultGallery is { } vaultGallery && (await ApiClient.DeleteVaultImageGalleryAsync(vaultGallery.Id)).Succeeded
                : IsEditing && await ApiClient.DeleteViewGalleryAsync(Request.EditingGallery!.Id);
        }
        finally { _saving = false; }
        if (!deleted) { Snackbar.Add(L["Common_TheGalleryCouldNotBe"].Value, AppSeverity.Error); return; }
        Snackbar.Add(Request.Vault ? "Gallery deleted. The images were kept." : "Gallery deleted. Original media was kept.", AppSeverity.Success);
        DialogContext?.Close(AppDialogResult.Ok(true));
    }

    private static bool Complete(CollectionRulePredicateViewModel rule) => !string.IsNullOrWhiteSpace(rule.Field) && (rule.Op is "known" or "unknown" or "has_any_value" or "has_no_known_value" || !string.IsNullOrWhiteSpace(rule.Value) || rule.Values is { Length: > 0 });
    private static string? SerializeRules(CollectionRuleDefinitionViewModel source)
    {
        var groups = source.Groups.Select(group => new CollectionRuleGroupDto { Id = group.Id, JoinWithPrevious = group.JoinWithPrevious, MatchMode = group.MatchMode, Conditions = group.Conditions.Where(Complete).Select(condition => new CollectionRulePredicateDto { Field = condition.Field, Op = condition.Op, Value = condition.Value, DisplayValue = condition.DisplayValue, Values = condition.Values, DisplayValues = condition.DisplayValues }).ToList() }).Where(group => group.Conditions.Count > 0).ToList();
        return groups.Count == 0 ? null : JsonSerializer.Serialize(new CollectionRuleDefinitionDto { Version = 1, Groups = groups });
    }
    private static CollectionRuleDefinitionViewModel ParseRules(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return EmptyRules();
        try
        {
            var dto = JsonSerializer.Deserialize<CollectionRuleDefinitionDto>(json, MediaEngineJson.CaseInsensitive);
            return dto is null ? EmptyRules() : new CollectionRuleDefinitionViewModel { Version = dto.Version, Groups = dto.Groups.Select(group => new CollectionRuleGroupViewModel { Id = group.Id, JoinWithPrevious = group.JoinWithPrevious, MatchMode = group.MatchMode, Conditions = group.Conditions.Select(rule => new CollectionRulePredicateViewModel { Field = rule.Field, Op = rule.Op, Value = rule.Value, DisplayValue = rule.DisplayValue, Values = rule.Values, DisplayValues = rule.DisplayValues }).ToList() }).ToList() };
        }
        catch (JsonException) { return EmptyRules(); }
    }
    private static CollectionRuleDefinitionViewModel EmptyRules() => new() { Groups = [new CollectionRuleGroupViewModel { Conditions = [new CollectionRulePredicateViewModel()] }] };
}
