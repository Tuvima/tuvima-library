@namespace MediaEngine.Web.Components.Collections
@using MediaEngine.Contracts.Persons
@using MediaEngine.Web.Components.MediaTiles
@using MediaEngine.Web.Models.ViewDTOs
@inject IStringLocalizer<SharedStrings> L

@* The people list is a grid of the one shared round person tile: photo, name, and an icon-plus-count line per lane. *@
<div class="people-catalog-list" role="list" aria-label="@L["PeopleCatalogList_PeopleInYourLibrary"].Value">
    <PersonTileGrid Items="@Tiles" />
</div>

@code {
    private static readonly Dictionary<string, int> EmptyPresence = new(StringComparer.OrdinalIgnoreCase);

    [Parameter] public IReadOnlyList<PersonListItemResponse> Items { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, Dictionary<string, int>> Presence { get; set; } =
        new Dictionary<string, Dictionary<string, int>>();

    private IReadOnlyList<MediaTileViewModel> Tiles => Items.Select(ToTile).ToList();

    private MediaTileViewModel ToTile(PersonListItemResponse person)
    {
        var counts = Presence.TryGetValue(person.id.ToString(), out var presence) ? presence : EmptyPresence;
        var route = $"/details/person/{person.id:D}";
        var mediaCounts = new List<MediaTileMediaCountViewModel>();
        AddLane(mediaCounts, counts, "read", AppMaterialIcons.Outlined.MenuBook, L["PeopleCatalogList_LabelReadOne"].Value, L["PeopleCatalogList_LabelRead"].Value);
        AddLane(mediaCounts, counts, "watch", AppMaterialIcons.Outlined.Movie, L["PeopleCatalogList_LabelWatchOne"].Value, L["PeopleCatalogList_LabelWatch"].Value);
        AddLane(mediaCounts, counts, "listen", AppMaterialIcons.Outlined.Headphones, L["PeopleCatalogList_LabelListenOne"].Value, L["PeopleCatalogList_LabelListen"].Value);
        return new MediaTileViewModel
        {
            Id = person.id,
            Title = person.name,
            NavigationUrl = route,
            MediaCounts = mediaCounts,
            Person = new MediaTilePersonViewModel
            {
                Id = person.id,
                Name = person.name,
                ImageUrl = person.headshot_url,
                Roles = person.roles.ToList(),
            },
        };
    }

    private static void AddLane(List<MediaTileMediaCountViewModel> target, IReadOnlyDictionary<string, int> counts, string lane, string icon, string singular, string plural)
    {
        if (LaneCount(counts, lane) is var count and > 0)
        {
            target.Add(new MediaTileMediaCountViewModel(icon, count == 1 ? singular : plural, count));
        }
    }

    private static int LaneCount(IReadOnlyDictionary<string, int> counts, string lane) =>
        counts
            .Where(pair => LaneForMediaType(pair.Key) == lane)
            .Sum(pair => pair.Value);

    private static string LaneForMediaType(string mediaType)
    {
        if (mediaType.Contains("book", StringComparison.OrdinalIgnoreCase)
            || mediaType.Contains("comic", StringComparison.OrdinalIgnoreCase)
            || mediaType.Contains("epub", StringComparison.OrdinalIgnoreCase))
            return "read";
        if (mediaType.Contains("movie", StringComparison.OrdinalIgnoreCase)
            || mediaType.Contains("tv", StringComparison.OrdinalIgnoreCase)
            || mediaType.Contains("video", StringComparison.OrdinalIgnoreCase))
            return "watch";
        if (mediaType.Contains("audio", StringComparison.OrdinalIgnoreCase)
            || mediaType.Contains("music", StringComparison.OrdinalIgnoreCase)
            || mediaType.Contains("track", StringComparison.OrdinalIgnoreCase))
            return "listen";
        return string.Empty;
    }
}
