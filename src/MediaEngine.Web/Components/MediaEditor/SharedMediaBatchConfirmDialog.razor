@namespace MediaEngine.Web.Components.MediaEditor

<AppDialog Class="smb-dialog">
    <DialogContent>
        <div class="smb-shell">
            <div class="smb-title">Are you sure you want to edit information for multiple items?</div>
            <AppCheckbox
                         @bind-Value="_dontAskAgain"
                         Label="Don't ask again"
                         Color="AppColor.Primary"
                         Class="smb-check" />
            <div class="smb-actions">
                <AppButton ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary"
                           Class="smb-btn smb-btn--primary"
                           OnClick="Confirm">
                    Edit Items
                </AppButton>
                <AppButton ButtonStyle="AppButtonStyle.Text"
                           Tone="AppUiTone.Neutral"
                           Class="smb-btn smb-btn--secondary"
                           OnClick="Cancel">
                    Cancel
                </AppButton>
            </div>
        </div>
    </DialogContent>
</AppDialog>

@code {
    [CascadingParameter] private IAppDialogContext DialogContext { get; set; } = null!;
    private bool _dontAskAgain;

    private void Confirm() => DialogContext.Close(AppDialogResult.Ok(true));
    private void Cancel() => DialogContext.Cancel();
}
