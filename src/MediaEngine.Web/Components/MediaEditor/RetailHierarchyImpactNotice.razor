@using MediaEngine.Contracts.Metadata

@if (HasHierarchyImpact)
{
    <aside class="sme-match-hierarchy-impact-notice" role="status" aria-live="polite">
        <span class="sme-match-hierarchy-impact-notice__icon" aria-hidden="true">!</span>
        <div class="sme-match-hierarchy-impact-notice__content">
            <strong>This match will change the item’s hierarchy.</strong>
            <div class="sme-match-hierarchy-impact-notice__paths" aria-label="Previous hierarchy and target hierarchy">
                <span class="sme-match-hierarchy-impact-notice__path">@Preview!.CurrentPath</span>
                <span class="sme-match-hierarchy-impact-notice__arrow" aria-hidden="true">→</span>
                <span class="sme-match-hierarchy-impact-notice__path">@Preview!.TargetPath</span>
            </div>
            <p>Series, season, album, position, and related context updates are applied automatically. Apply selection is the only confirmation; there is no extra prompt.</p>
            @if (Preview!.SourceParentWillBeEmpty)
            {
                <p class="sme-match-hierarchy-impact-notice__cleanup">The original parent will be empty after this move. Its artwork and record stay in place for later reviewed cleanup.</p>
            }
        </div>
    </aside>
}

@code {
    [Parameter] public MediaEditorMembershipPreviewDto? Preview { get; set; }

    private bool HasHierarchyImpact => RetailHierarchyPreviewPolicy.ShouldShowImpactNotice(Preview);
}
