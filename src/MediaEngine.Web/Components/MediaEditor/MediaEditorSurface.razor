@namespace MediaEngine.Web.Components.MediaEditor
@inject IStringLocalizer<SharedStrings> L

@if (Inline)
{
    <section class="sme-inline-surface @(HeroConstrained ? "sme-inline-surface--hero" : string.Empty)" aria-label="@L["MediaEditorSurface_MediaEditor"].Value">
        @ChildContent
    </section>
}
else
{
    <AppDialogShell Bare="true" HostClass="sme-dialog">
        @ChildContent
    </AppDialogShell>
}

@code {
    [Parameter] public bool Inline { get; set; }
    [Parameter] public bool HeroConstrained { get; set; }

    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
}
