@namespace MediaEngine.Web.Components.MediaEditor

@if (Inline)
{
    <section class="sme-inline-surface @(HeroConstrained ? "sme-inline-surface--hero" : string.Empty) @(Section ? "sme-inline-surface--section" : string.Empty)" aria-label="Media editor">
        @ChildContent
    </section>
}
else
{
    <AppDialog Class="sme-dialog">
        <DialogContent>
            @ChildContent
        </DialogContent>
    </AppDialog>
}

@code {
    [Parameter] public bool Inline { get; set; }
    [Parameter] public bool HeroConstrained { get; set; }

    /// <summary>An Editing Mode section slot: sized by the slot that holds it, not by the screen.</summary>
    [Parameter] public bool Section { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
}
