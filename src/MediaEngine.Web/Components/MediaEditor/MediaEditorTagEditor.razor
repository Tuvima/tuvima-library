@namespace MediaEngine.Web.Components.MediaEditor
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components
@using MediaEngine.Web.Services.Ui

<div class="sme-tag-editor">
    <div class="sme-tag-editor__label-row">
        <label>@Label</label>
        @if (OnAction.HasDelegate)
        {
            <AppIconButton Icon="@ActionIcon"
                           Size="AppControlSize.Compact"
                           Tone="@(OverrideActive ? AppUiTone.Warning : AppUiTone.Neutral)"
                           AriaLabel="@ActionLabel"
                           Tooltip="@ActionLabel"
                           OnClick="OnAction" />
        }
    </div>
    <div class="sme-tag-editor__surface">
        @foreach (var tag in Parse(Value))
        {
            var capturedTag = tag;
            <AppChip T="string"
                     Variant="AppVariant.Outlined"
                     Size="AppSize.Small"
                     Class="sme-tag-editor__chip"
                     OnClose="@(() => RemoveAsync(capturedTag))">
                @capturedTag
            </AppChip>
        }

        @if (_adding)
        {
            <AppTextField T="string"
                          @bind-Value="_draft"
                          Placeholder="Add tag"
                          Variant="AppVariant.Text"
                          Margin="AppMargin.Dense"
                          Immediate="true"
                          Disabled="@Locked"
                          OnKeyDown="HandleKeyDownAsync"
                          Class="sme-tag-editor__input" />
            <AppIconButton Icon="@AppMaterialIcons.Outlined.Check"
                           Size="AppControlSize.Compact"
                           Tone="AppUiTone.Primary"
                           AriaLabel="Add tag"
                           Tooltip="Add tag"
                           Disabled="@Locked"
                           OnClick="AddAsync" />
            <AppIconButton Icon="@AppMaterialIcons.Outlined.Close"
                           Size="AppControlSize.Compact"
                           Tone="AppUiTone.Neutral"
                           AriaLabel="Cancel adding tag"
                           Tooltip="Cancel"
                           OnClick="Cancel" />
        }
        else
        {
            <AppButton ButtonStyle="AppButtonStyle.Text"
                       Tone="AppUiTone.Neutral"
                       StartIcon="@AppMaterialIcons.Outlined.Add"
                       Class="sme-tag-editor__add"
                       Disabled="@Locked"
                       OnClick="@(() => _adding = true)">
                @AddLabel
            </AppButton>
        }
    </div>
    @if (_adding && !Locked && FilteredSuggestions.Count > 0)
    {
        <div class="sme-tag-editor__suggestions" role="listbox" aria-label="@($"{Label} suggestions")">
            @foreach (var suggestion in FilteredSuggestions)
            {
                var capturedSuggestion = suggestion;
                <AppButton ButtonStyle="AppButtonStyle.Text"
                           Tone="AppUiTone.Neutral"
                           Class="sme-tag-editor__suggestion"
                           OnClick="@(() => CommitAsync(capturedSuggestion))">
                    @capturedSuggestion
                </AppButton>
            }
        </div>
    }
    @if (ConfirmingAction)
    {
        <div class="sme-tag-editor__confirmation" role="alert">
            <span>@ConfirmLabel</span>
            <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" OnClick="OnCancelAction">@CancelLabel</AppButton>
            <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Warning" OnClick="OnConfirmAction">Remove</AppButton>
        </div>
    }
    <small>@HelpText</small>
</div>

@code {
    [Parameter] public string Label { get; set; } = "Library tags";
    [Parameter] public string AddLabel { get; set; } = "Add tag";
    [Parameter] public string HelpText { get; set; } = "Tags are private library organization and are not replaced by provider refreshes.";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<string> Suggestions { get; set; } = [];
    [Parameter] public bool Locked { get; set; }
    [Parameter] public bool OverrideActive { get; set; }
    [Parameter] public string ActionIcon { get; set; } = AppMaterialIcons.Outlined.LockOpen;
    [Parameter] public string ActionLabel { get; set; } = "Use local override";
    [Parameter] public EventCallback OnAction { get; set; }
    [Parameter] public bool ConfirmingAction { get; set; }
    [Parameter] public string ConfirmLabel { get; set; } = "Remove local override";
    [Parameter] public string CancelLabel { get; set; } = "Keep override";
    [Parameter] public EventCallback OnConfirmAction { get; set; }
    [Parameter] public EventCallback OnCancelAction { get; set; }

    private bool _adding;
    private string _draft = string.Empty;
    private IReadOnlyList<string> FilteredSuggestions => Suggestions
        .Where(suggestion => !Parse(Value).Contains(suggestion, StringComparer.OrdinalIgnoreCase))
        .Where(suggestion => string.IsNullOrWhiteSpace(_draft)
            || suggestion.Contains(_draft.Trim(), StringComparison.OrdinalIgnoreCase))
        .Take(8)
        .ToList();

    private static IReadOnlyList<string> Parse(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? []
            : Regex.Split(value, @"\s*[;,|]\s*")
                .Where(tag => !string.IsNullOrWhiteSpace(tag))
                .Select(tag => tag.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

    private async Task AddAsync()
    {
        await CommitAsync(_draft);
    }

    private async Task CommitAsync(string? candidate)
    {
        var draft = (candidate ?? string.Empty).Trim();
        if (draft.Length == 0 || Locked)
            return;

        var values = Parse(Value).ToList();
        if (!values.Contains(draft, StringComparer.OrdinalIgnoreCase))
            values.Add(draft);

        await ValueChanged.InvokeAsync(string.Join(", ", values));
        Cancel();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.Ordinal))
            await AddAsync();
    }

    private Task RemoveAsync(string tag) =>
        ValueChanged.InvokeAsync(string.Join(", ", Parse(Value).Where(value => !string.Equals(value, tag, StringComparison.OrdinalIgnoreCase))));

    private void Cancel()
    {
        _adding = false;
        _draft = string.Empty;
    }
}
