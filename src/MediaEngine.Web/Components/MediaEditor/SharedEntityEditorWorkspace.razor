@namespace MediaEngine.Web.Components.MediaEditor
@using MediaEngine.Contracts.Universe
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using MudBlazor

<section class="see-workspace" aria-label="Universe editor">
    @if (_loading)
    {
        <div class="see-loading"><AppSpinner Indeterminate="true" Size="Size.Medium" /> Loading shared entity…</div>
    }
    else if (_context is null && !string.IsNullOrWhiteSpace(_error))
    {
        <div class="see-error" role="alert">@_error</div>
    }
    else
    {
        <p class="see-shared-scope">Changes to this Universe or its entities apply across linked titles.</p>
        @if (IsUniverse)
        {
            <div class="see-category-wrap">
                <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" Class="see-category-control" aria-label="Scroll categories left" OnClick="() => ScrollCategoryRailAsync(-1)">‹</AppButton>
                <div class="see-category-rail" @ref="_categoryRail" role="tablist" aria-label="Universe categories" @onwheel="ScrollCategoryWheelAsync" @onwheel:preventDefault="true">
                    @foreach (var category in _categories)
                    {
                        var categoryId = category.category;
                        <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" Class="@($"see-category {(string.Equals(categoryId, _selectedCategory, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)}")"
                                id="@($"see-category-{categoryId}")" tabindex="@(string.Equals(categoryId, _selectedCategory, StringComparison.OrdinalIgnoreCase) ? "0" : "-1")"
                                role="tab" aria-selected="@(string.Equals(categoryId, _selectedCategory, StringComparison.OrdinalIgnoreCase) ? "true" : "false")"
                                aria-label="@CategoryLabel(category)"
                                aria-haspopup="dialog"
                                aria-controls="see-selector-popover"
                                aria-expanded="@(string.Equals(categoryId, _selectedCategory, StringComparison.OrdinalIgnoreCase) && _showSelectorPopover ? "true" : "false")"
                                OnClick="() => ToggleCategorySelectorAsync(categoryId)"
                                @onkeydown="args => OnCategoryItemKeyDown(args, categoryId)">
                            <span>@CategoryLabel(category)</span><small>@category.count</small><MudIcon Icon="@Icons.Material.Outlined.ExpandMore" Size="Size.Small" aria-hidden="true" />
                        </AppButton>
                    }
                </div>
                <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" Class="see-category-control" aria-label="Scroll categories right" OnClick="() => ScrollCategoryRailAsync(1)">›</AppButton>
            </div>
            @if (_showSelectorPopover)
            {
                <div id="see-selector-popover" class="see-selector-popover" role="dialog" aria-modal="false" aria-label="@CategoryLabel(_categories.FirstOrDefault(x => x.category == _selectedCategory)) entities" tabindex="-1" @onkeydown="OnSelectorKeyDown" @onkeydown:stopPropagation="true">
                    <div class="see-popover-heading"><strong>@CategoryLabel(_categories.FirstOrDefault(x => x.category == _selectedCategory))</strong><AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" aria-label="Close selector" OnClick="CloseSelectorPopoverAsync">×</AppButton></div>
                    <div class="see-search"><AppTextField T="string" Label="Search entities" Value="@_search" ValueChanged="SearchChangedAsync" InputType="InputType.Search" /></div>
                    <div class="see-selector-list" role="listbox" aria-label="Category entities">
                        @foreach (var item in _selectorItems)
                        {
                            var selected = item.id == _context?.target.FictionalEntityId;
                            <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" role="option" aria-selected="@(selected ? "true" : "false")" Class="see-selector-item" OnClick="() => SelectEntityAsync(item)">
                                <span><strong>@item.label</strong><small>@item.qid</small></span>
                                @if (selected) { <MudIcon Icon="@Icons.Material.Filled.Check" aria-label="Selected" /> }
                            </AppButton>
                        }
                    </div>
                    @if (_selectorHasMore) { <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary" Class="see-load-more" Disabled="@_selectorLoading" OnClick="LoadMoreAsync">Load more</AppButton> }
                </div>
            }
        }
        else
        {
            <nav class="see-breadcrumb" aria-label="Entity location">
                <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary" OnClick="ReturnToUniverseAsync">@UniverseBreadcrumbLabel</AppButton><span aria-hidden="true">›</span><strong>@_context?.label</strong>
                <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Class="see-sibling-toggle" id="see-sibling-toggle" aria-haspopup="dialog" aria-controls="see-selector-popover" aria-expanded="@_showSelectorPopover" OnClick="ToggleSiblingSelectorAsync">Other @CategoryName(_context?.category ?? "")</AppButton>
            </nav>
            @if (_showSelectorPopover)
            {
                <div id="see-selector-popover" class="see-selector-popover" role="dialog" aria-modal="false" aria-label="Other @CategoryName(_context?.category ?? "")" tabindex="-1" @onkeydown="OnSelectorKeyDown" @onkeydown:stopPropagation="true">
                    <div class="see-popover-heading"><strong>Other @CategoryName(_context?.category ?? "")</strong><AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" aria-label="Close selector" OnClick="CloseSelectorPopoverAsync">×</AppButton></div>
                    <div class="see-search"><AppTextField T="string" Label="Search entities" Value="@_search" ValueChanged="SearchChangedAsync" InputType="InputType.Search" /></div>
                    <div class="see-selector-list" role="listbox" aria-label="Sibling entities">
                        @foreach (var item in _selectorItems)
                        {
                            var selected = item.id == _context?.target.FictionalEntityId;
                            <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" role="option" aria-selected="@(selected ? "true" : "false")" Class="see-selector-item" OnClick="() => SelectEntityAsync(item)">
                                <span><strong>@item.label</strong><small>@item.qid</small></span>
                                @if (selected) { <MudIcon Icon="@Icons.Material.Filled.Check" aria-label="Selected" /> }
                            </AppButton>
                        }
                    </div>
                    @if (_selectorHasMore) { <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary" Class="see-load-more" Disabled="@_selectorLoading" OnClick="LoadMoreAsync">Load more</AppButton> }
                </div>
            }
        }

        @if (_pendingTarget is not null)
        {
            <div class="see-switch-confirm" role="alert">
                <span>Save changes before editing @_pendingTargetLabel?</span>
                <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" OnClick="CancelTargetSwitch">Stay here</AppButton>
                <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Error" Class="is-danger" OnClick="DiscardAndSwitchAsync">Discard and switch</AppButton>
                <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Class="is-primary" OnClick="SaveAndSwitchAsync">Save and switch</AppButton>
            </div>
        }

        <div class="see-layout">
            <nav class="see-nav" aria-label="Editor sections">
                @foreach (var capability in ReadableCapabilities)
                {
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" Class="@($"see-nav-item {(string.Equals(_activeSection, capability.section, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)}")"
                            aria-current="@(string.Equals(_activeSection, capability.section, StringComparison.OrdinalIgnoreCase) ? "page" : null)"
                            OnClick="() => SelectSectionAsync(capability.section)">@SectionLabel(capability.section, _context?.category)</AppButton>
                }
                @if (CanRefresh)
                {
                    <div class="see-refresh">
                        <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" Disabled="@_refreshing" OnClick="RefreshEnrichmentAsync">@(_refreshing ? "Queueing…" : "Refresh enrichment")</AppButton>
                        @if (_enrichment is not null) { <small>@EnrichmentLabel</small> }
                    </div>
                }
            </nav>

            <main class="see-content">
                @if (IsUniverse && string.Equals(_activeSection, SharedEntityEditorSections.Entities, StringComparison.OrdinalIgnoreCase))
                {
                    <section class="see-panel" aria-labelledby="see-selector-title">
                        <div class="see-panel-heading"><div><h3 id="see-selector-title">@CategoryLabel(_categories.FirstOrDefault(x => x.category == _selectedCategory))</h3><p>Browse entities in this universe.</p></div></div>
                        <div class="see-search"><AppTextField T="string" Label="Search entities" Value="@_search" ValueChanged="SearchChangedAsync" InputType="InputType.Search" /></div>
                        @if (_selectorLoading) { <div class="see-muted">Loading entities…</div> }
                        else if (_selectorItems.Count == 0) { <div class="see-muted">No entities found.</div> }
                        else
                        {
                            <div class="see-selector-list" role="listbox" aria-label="Universe entities">
                                @foreach (var item in _selectorItems)
                                {
                                    var selected = item.id == _context?.target.FictionalEntityId;
                                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" role="option" aria-selected="@(selected ? "true" : "false")" Class="see-selector-item" OnClick="() => RequestTargetSwitchAsync(ToEntityTarget(item))">
                                        <span><strong>@item.label</strong><small>@item.qid · @CategoryName(item.category)</small></span>
                                        @if (selected) { <MudIcon Icon="@Icons.Material.Filled.Check" aria-label="Selected" /> }
                                    </AppButton>
                                }
                            </div>
                            @if (_selectorHasMore) { <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary" Class="see-load-more" Disabled="@_selectorLoading" OnClick="LoadMoreAsync">Load more entities</AppButton> }
                        }
                    </section>
                }
                else if (string.Equals(_activeSection, SharedEntityEditorSections.Details, StringComparison.OrdinalIgnoreCase))
                {
                    <section class="see-panel" aria-labelledby="see-details-title">
                        <h3 id="see-details-title">Details</h3>
                        <div class="see-field"><AppTextField T="string" Label="Name" Value="@_label" ValueChanged="LabelChangedAsync" /></div>
                        <div class="see-field"><AppTextarea Label="Description" Value="@_description" ValueChanged="DescriptionChangedAsync" Lines="5" /></div>
                        @if (_detailsEditable) { <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Class="see-primary" Disabled="@(!_dirty || _saving)" OnClick="SaveDetailsAsync">@(_saving ? "Saving…" : "Save details")</AppButton> }
                        else { <p class="see-muted">Details are read-only for this target.</p> }
                    </section>
                }
                else if (string.Equals(_activeSection, SharedEntityEditorSections.Artwork, StringComparison.OrdinalIgnoreCase))
                {
                    <section class="see-panel" aria-labelledby="see-art-title">
                        <h3 id="see-art-title">Managed artwork</h3>
                        @if (_artwork.Count > 0)
                        {
                            <div class="see-art-grid">
                                @foreach (var art in _artwork)
                                {
                                    <article class="see-art-card">
                                        @if (!string.IsNullOrWhiteSpace(AbsoluteArtworkUrl(art.image_url))) { <img src="@AbsoluteArtworkUrl(art.image_url)" alt="@art.asset_type artwork" /> }
                                        <strong>@ArtworkLabel(art.asset_type)</strong><small>@(art.is_user_override ? "Managed" : art.source_provider ?? "Source artwork")@(art.is_preferred ? " · Preferred" : string.Empty)</small>
                                    </article>
                                }
                            </div>
                        }
                        else { <p class="see-muted">No artwork is attached.</p> }
                        @if (_artworkEditable)
                        {
                            <div class="see-upload">
                                <label>Artwork type
                                    <span class="see-art-types">
                                        @foreach (var type in ArtworkTypes)
                                        { <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Class="@(_uploadType == type ? "is-active" : null)" OnClick="() => SelectUploadType(type)">@ArtworkLabel(type)</AppButton> }
                                    </span>
                                </label>
                                <InputFile OnChange="UploadArtworkAsync" accept="image/jpeg,image/png" />
                                <small>JPEG or PNG. Uploads are managed assets owned by this universe or entity.</small>
                            </div>
                        }
                    </section>
                }
                else if (string.Equals(_activeSection, SharedEntityEditorSections.Appearances, StringComparison.OrdinalIgnoreCase))
                {
                    <section class="see-panel"><h3>Appearances</h3>@if (_appearances.Count == 0) { <p class="see-muted">No work-scoped appearances are available.</p> } else { <div class="see-record-list">@foreach (var row in _appearances) { <article><strong>@(row.work_label ?? row.work_qid)</strong><span>@row.link_type@(string.IsNullOrWhiteSpace(row.role) ? string.Empty : $" · {row.role}")</span><small>@JoinNonEmpty(row.work_context, row.anchor_kind, row.anchor_value, row.narrative_time_index, row.start_time, row.end_time, string.IsNullOrWhiteSpace(row.spoiler_for_work_qid) ? null : $"Spoiler for {row.spoiler_for_work_qid}", row.provenance)</small></article> }</div> }</section>
                }
                else if (string.Equals(_activeSection, SharedEntityEditorSections.Members, StringComparison.OrdinalIgnoreCase)
                    || string.Equals(_activeSection, SharedEntityEditorSections.Participants, StringComparison.OrdinalIgnoreCase)
                    || string.Equals(_activeSection, SharedEntityEditorSections.Relationships, StringComparison.OrdinalIgnoreCase))
                {
                    <section class="see-panel"><h3>@SectionLabel(_activeSection, _context?.category)</h3>@if (!ActiveRelationshipRows.Any()) { <p class="see-muted">@($"No qualified {SectionLabel(_activeSection, _context?.category).ToLowerInvariant()} are available.")</p> } else { <div class="see-record-list">@foreach (var row in ActiveRelationshipRows) { <article><strong>@row.subject_qid — @row.type — @row.object_qid</strong><small>@JoinNonEmpty(row.work_qid, row.provenance, string.Join(" · ", row.qualifiers.Select(q => $"{q.type}: {q.value}")))</small></article> }</div> }</section>
                }
                else if (string.Equals(_activeSection, SharedEntityEditorSections.Timeline, StringComparison.OrdinalIgnoreCase))
                {
                    <section class="see-panel"><h3>In-universe timeline</h3><p class="see-muted">Narrative chronology, not editor or audit history.</p>@if (_timeline.Count == 0) { <p class="see-muted">No in-universe events are available.</p> } else { <div class="see-record-list">@foreach (var row in _timeline) { <article><strong>@row.kind · @row.value</strong><small>@JoinNonEmpty(row.start_time, row.end_time, row.work_qid, row.provenance)</small></article> }</div> }</section>
                }
                else if (string.Equals(_activeSection, SharedEntityEditorSections.Sources, StringComparison.OrdinalIgnoreCase))
                {
                    <section class="see-panel"><h3>Sources &amp; provenance</h3>@if (_sources.Count == 0) { <p class="see-muted">No provenance records are available.</p> } else { <div class="see-record-list">@foreach (var row in _sources) { <article><strong>@(row.supplemental ? "Supplemental" : "Canonical") · @row.kind · @row.value</strong><small>@JoinNonEmpty(row.source_provider, row.work_qid, row.provenance, row.confidence?.ToString("P0"))</small></article> }</div> }</section>
                }
                else if (string.Equals(_activeSection, SharedEntityEditorSections.History, StringComparison.OrdinalIgnoreCase))
                {
                    <section class="see-panel"><h3>History</h3>@if (_history.Count == 0) { <p class="see-muted">No edit history is available.</p> } else { <div class="see-record-list">@foreach (var row in _history.OrderByDescending(x => x.occurred_at)) { <article><strong>@row.event_type</strong><small>@row.occurred_at.LocalDateTime.ToString("g") · @row.detail</small></article> }</div> }</section>
                }
                else if (string.Equals(_activeSection, SharedEntityEditorSections.Enrichment, StringComparison.OrdinalIgnoreCase))
                {
                    <section class="see-panel"><h3>Enrichment</h3><p>@(_enrichment is null ? _context?.enrichment_status : EnrichmentLabel)</p>@if (_enrichment?.wikidata_revision_id is long revision) { <p class="see-muted">Wikidata revision @revision · Enriched @(_enrichment.enriched_at?.ToLocalTime().ToString("g") ?? "unknown")</p> }<AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Disabled="@_refreshing" OnClick="RefreshEnrichmentAsync">@(_refreshing ? "Queueing…" : "Refresh enrichment")</AppButton></section>
                }
                else { <section class="see-panel"><h3>@SectionLabel(_activeSection, _context?.category)</h3><p class="see-muted">This section is not available for the current target.</p></section> }

                @if (!string.IsNullOrWhiteSpace(_message)) { <p class="see-message" role="status">@_message</p> }
                @if (!string.IsNullOrWhiteSpace(_error)) { <p class="see-error" role="alert">@_error</p> }
            </main>
        </div>
    }
</section>
