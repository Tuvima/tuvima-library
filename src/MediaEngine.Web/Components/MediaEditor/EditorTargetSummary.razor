@namespace MediaEngine.Web.Components.MediaEditor

<div class="editor-target-summary" aria-label="Current editing target">
    <div class="editor-target-summary__identity">
        <span class="editor-target-summary__label">Editing @Label.ToLowerInvariant()</span>
        <h3>@Title</h3>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <span class="editor-target-summary__subtitle">@Subtitle</span>
        }
    </div>
    <div class="editor-target-summary__sources" aria-label="Match status">
        <span class="editor-target-summary__status @(RetailMatched ? "is-matched" : null)" aria-label="@(RetailMatched ? "Retail matched" : "Retail not matched")" title="@(RetailMatched ? "Retail matched" : "Retail not matched")">
            <AppMaterialIcon Icon="@(RetailMatched ? AppMaterialIcons.Outlined.Check : AppMaterialIcons.Outlined.Remove)" Size="AppSize.Small" />
            Retail
        </span>
        <span class="editor-target-summary__status @(CanonicalMatched ? "is-matched" : null)" aria-label="@(CanonicalMatched ? "Canonical matched" : "Canonical not matched")" title="@(CanonicalMatched ? "Canonical matched" : "Canonical not matched")">
            <AppMaterialIcon Icon="@(CanonicalMatched ? AppMaterialIcons.Outlined.Check : AppMaterialIcons.Outlined.Remove)" Size="AppSize.Small" />
            Canonical
        </span>
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "item";
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public bool RetailMatched { get; set; }
    [Parameter] public bool CanonicalMatched { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
