@namespace MediaEngine.Web.Components.MediaEditor
@implements IDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Forms
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Components.Artwork

<NavigationLock ConfirmExternalNavigation="@IsDirty"
                OnBeforeInternalNavigation="ConfirmNavigationWithUnsavedChanges" />

<MediaEditorSurface Inline="@Inline" HeroConstrained="@HeroConstrained">
        <div class="sme-shell @(HeroConstrained ? "sme-shell--hero" : string.Empty)">
            <div class="sme-header">
                <div class="sme-header-identity @(IsParentEditorTarget ? "is-active" : "")">
                @if (!Inline)
                {
                    <div class="sme-cover-cluster @(HasParentGroupArtwork && string.IsNullOrWhiteSpace(CurrentCoverUrl) ? "sme-cover-cluster--group" : "") @(IsSingleItem ? $"sme-cover-cluster--single {ArtworkShapeClass}" : "sme-cover-cluster--batch")">
                    @if (IsBatchMode)
                    {
                        <div class="sme-batch-cover-grid">
                            @foreach (var preview in Request.PreviewItems.Take(4))
                            {
                                <div class="sme-batch-cover-cell">
                                    @if (!string.IsNullOrWhiteSpace(preview.CoverUrl))
                                    {
                                        <img src="@preview.CoverUrl" alt="" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Outlined.Collections" Class="tl-u-font-size-20px tl-u-opacity-0-22" />
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (HasParentGroupArtwork && string.IsNullOrWhiteSpace(CurrentCoverUrl))
                    {
                        <div class="sme-automatic-artwork"><MediaArtworkGroupPreview Items="ParentGroupArtwork" Layout="MediaArtworkGroupPreviewLayout.Cluster" ShowOverflowCount="false" AriaLabel="Automatic stacked shelf artwork" /></div>
                    }
                    else if (!string.IsNullOrWhiteSpace(CurrentCoverUrl))
                    {
                        <img src="@CurrentCoverUrl" alt="" class="sme-cover-image" />
                    }
                    else
                    {
                        <div class="sme-cover-fallback">
                            <MudIcon Icon="@Icons.Material.Outlined.Image" Class="tl-u-font-size-36px tl-u-opacity-0-2" />
                        </div>
                    }
                    </div>
                }

                <div class="sme-header-copy @(Inline ? "sme-header-copy--inline" : string.Empty)">
                    @if (Inline)
                    {
                        <h2 class="sme-title sme-title--inline" tabindex="-1">@EditorPageTitle</h2>
                        <div class="sme-subtitle sme-subtitle--inline">@EditorHeaderDescription</div>
                    }
                    else
                    {
                        <div class="sme-kicker">@HeaderKicker</div>
                        <h2 class="sme-title" tabindex="-1">@HeaderTitle</h2>
                        @if (!string.IsNullOrWhiteSpace(HeaderSubtitle))
                        {
                            <div class="sme-subtitle">@HeaderSubtitle</div>
                        }
                    }
                </div>

                @if (HasContextNavigator && !IsSharedEntityMode)
                {
                    <AppButton ButtonStyle="AppButtonStyle.Text" Class="sme-parent-target" aria-label="@($"Edit {HeaderTitle}")"
                               aria-current="@(IsParentEditorTarget ? "page" : null)" Disabled="@_loading"
                               OnClick="@(() => SelectEditorContextTargetAsync(NavigatorRootNode!.EntityId))" />
                }
                </div>
                @if (!IsSharedEntityMode && HasContextNavigator && EditorContextLevels.Count > 0)
                {
                    <EditorContextNavigator Levels="@EditorContextLevels" OnTargetSelected="SelectEditorContextTargetAsync" />
                }

                @if (Inline)
                {
                    <div class="sme-inline-header-actions">
                        @if (IsDirty)
                        {
                            <AppButton ButtonStyle="AppButtonStyle.Text"
                                       Tone="AppUiTone.Neutral"
                                       Class="sme-inline-reset"
                                       OnClick="ResetEditorChanges">
                                Reset changes
                            </AppButton>
                        }
                        <AppButton ButtonStyle="AppButtonStyle.Outlined"
                                   Tone="AppUiTone.Neutral"
                                   OnClick="HandleClose">
                            Cancel
                        </AppButton>
                        <AppButton ButtonStyle="AppButtonStyle.Filled"
                                   Tone="AppUiTone.Primary"
                                   Disabled="@(!IsDirty || _saving)"
                                   OnClick="SaveAsync">
                            @(_saving ? "Saving..." : "Save Changes")
                        </AppButton>
                        <AppIconButton Icon="@Icons.Material.Outlined.Close"
                                       Size="AppControlSize.Compact"
                                       Tone="AppUiTone.Neutral"
                                       Class="sme-close sme-close--inline"
                                       Tooltip="Close editor"
                                       AriaLabel="Close editor"
                                       OnClick="HandleClose" />
                    </div>
                }
                @if (!Inline)
                {
                    <AppIconButton Icon="@Icons.Material.Outlined.Close"
                                   Size="AppControlSize.Compact"
                                   Tone="AppUiTone.Neutral"
                                   Class="sme-close"
                                   Tooltip="Close editor"
                                   AriaLabel="Close editor"
                                   OnClick="HandleClose" />
                }
            </div>

            @if (Request.Mode == SharedMediaEditorMode.Review)
            {
                <div class="sme-review-banner">
                    <div class="sme-review-icon" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Outlined.PriorityHigh" Class="tl-u-font-size-22px" />
                    </div>
                    <div class="sme-review-copy">
                        <div class="sme-review-title">Needs review <span class="sme-review-text">- @_reviewSummary</span></div>
                    </div>
                </div>
            }


            @if (!string.IsNullOrWhiteSpace(_saveError))
            {
                <div class="sme-save-error" role="alert" tabindex="-1">
                    <MudIcon Icon="@(_saveConflict ? Icons.Material.Outlined.SyncProblem : Icons.Material.Outlined.ErrorOutline)" />
                    <div>
                        <strong>@(_saveConflict ? "New library changes are available" : "Changes were not saved")</strong>
                        <span>@_saveError</span>
                    </div>
                    @if (_saveConflict)
                    {
                        <AppButton ButtonStyle="AppButtonStyle.Outlined"
                                   Tone="AppUiTone.Neutral"
                                   OnClick="ReloadAfterSaveConflictAsync">
                            Reload values
                        </AppButton>
                    }
                </div>
            }

            @if (Inline && _confirmDiscard)
            {
                <div class="sme-inline-decision" role="alert">
                    <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" />
                    <div>
                        <strong>Discard unsaved changes?</strong>
                        <span>Your edits will be lost and the unchanged detail page will return.</span>
                    </div>
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" OnClick="@(() => _confirmDiscard = false)">
                        Keep Editing
                    </AppButton>
                    <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Error" OnClick="DiscardAndClose">
                        Discard
                    </AppButton>
                </div>
            }

            @if (Inline && _pendingMembershipPreview is not null)
            {
                <div class="sme-inline-decision" role="status">
                    <MudIcon Icon="@Icons.Material.Outlined.AccountTree" />
                    <div>
                        <strong>Confirm structural change</strong>
                        <span>@_pendingMembershipPreview.Message</span>
                    </div>
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" OnClick="@(() => _pendingMembershipPreview = null)">
                        Keep Editing
                    </AppButton>
                    <AppButton ButtonStyle="AppButtonStyle.Filled"
                               Tone="AppUiTone.Primary"
                               Disabled="@_saving"
                               OnClick="ConfirmMembershipMoveAsync">
                        Save and Move
                    </AppButton>
                </div>
            }

            @if (HasPendingTargetSwitch)
            {
                <div class="sme-inline-decision sme-target-switch-decision" role="alert">
                    <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" />
                    <div>
                        <strong>Save changes before editing @PendingTargetSwitchTitle?</strong>
                        <span>Choose what to do with the changes on @CurrentTargetTitle.</span>
                    </div>
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" OnClick="KeepEditingCurrentTarget">
                        Stay here
                    </AppButton>
                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Error" OnClick="DiscardAndSwitchTargetAsync">
                        Discard and switch
                    </AppButton>
                    <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@_saving" OnClick="SaveAndSwitchTargetAsync">
                        @(_saving ? "Saving..." : "Save and switch")
                    </AppButton>
                </div>
            }

            @if (IsSharedEntityMode)
            {
                <SharedEntityEditorWorkspace @ref="_sharedEntityWorkspace"
                                             InitialTarget="@(Request.SharedEntityTarget!)"
                                             DirtyChanged="OnSharedEntityDirtyChanged"
                                             ContextChanged="OnSharedEntityContextChanged"
                                             Committed="OnSharedEntityCommittedAsync" />
            }
            else
            {
            <div class="sme-workspace">
                <nav class="sme-section-nav" aria-label="Editor sections">
                    @for (var index = 0; index < Tabs.Count; index++)
                    {
                        var tabIndex = index;
                        var tab = Tabs[index];
                        <AppButton ButtonStyle="AppButtonStyle.Text"
                                   Tone="AppUiTone.Neutral"
                                   Class="@GetSectionNavClass(tab.Id)"
                                   aria-current="@(string.Equals(tab.Id, _activeTab, StringComparison.OrdinalIgnoreCase) ? "page" : null)"
                                   Disabled="@IsTabDisabled(tab.Id)"
                                   OnClick="@(() => OnTabChanged(tabIndex))">
                            <MudIcon Icon="@tab.Icon" Size="Size.Small" />
                            <span>@tab.Label</span>
                        </AppButton>
                    }

                    @if (IsSingleItem)
                    {
                        <div class="sme-section-nav__footer">
                            <AppButton ButtonStyle="AppButtonStyle.Text"
                                       Tone="AppUiTone.Neutral"
                                       StartIcon="@Icons.Material.Outlined.Sync"
                                       Class="sme-section-nav__refresh"
                                       Disabled="@(_refreshQueueing || (_refreshSchedule?.Status.Equals("Queued", StringComparison.OrdinalIgnoreCase) ?? false))"
                                       OnClick="QueueFullEnrichmentAsync">
                                @(_refreshQueueing ? "Queueing..." : "Refresh enrichment")
                            </AppButton>
                            <small>@(_refreshSchedule is null ? "Ready on demand" : $"{_refreshSchedule.Status} · {FormatRefreshDate(_refreshSchedule.LastSuccessAt)}")</small>
                        </div>
                    }

                </nav>
                <div class="sme-main-pane">
                    <div class="sme-body">
                @if (_loading)
                {
                    <div class="sme-loading">
                        <MudProgressCircular Indeterminate="true" Size="Size.Medium" />
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_loadError))
                {
                    <div class="sme-empty-panel">
                        <MudIcon Icon="@Icons.Material.Outlined.CloudOff" Class="tl-u-font-size-24px tl-u-opacity-0-18" />
                        <span>@_loadError</span>
                    </div>
                }
                else if (_activeTab == "details")
                {
                    <div class="sme-details sme-details--single">
                        <div class="sme-fields-pane sme-details-main">
                            @if (HasInheritedArtwork && InheritedArtworkOwnerScope is not null)
                            {
                                <div class="sme-inherited-capability">
                                    <span>Artwork inherited from <strong>@InheritedArtworkOwnerScope.DisplayTitle</strong></span>
                                    <AppButton ButtonStyle="AppButtonStyle.Text"
                                               Tone="AppUiTone.Neutral"
                                               OnClick="EditInheritedArtworkOwnerAsync">
                                        Edit @InheritedArtworkOwnerScope.Label.ToLowerInvariant() artwork
                                    </AppButton>
                                </div>
                            }

                            <div class="sme-details-stack">
                                <MediaEditorPanel Title="Appearance" Description="The title and copy shown across Tuvima Library." Class="sme-details-section">
                                    @foreach (var field in GetAppearanceFields())
                                    {
                                        <AppFormFieldRow Label="@field.Label"
                                                         Value="@GetEditableValue(field.Key)"
                                                         ValueChanged="@((string? value) => OnFieldInput(field.Key, value))"
                                                         Placeholder="@GetPlaceholder(field)"
                                                      InputKind="@field.InputKind"
                                                      Lines="@GetFieldLineCount(field)"
                                                      Locked="@IsInlineFieldReadOnly(field.Key)"
                                                      Unlocked="@IsInlineOverrideEnabled(field.Key)"
                                                      OverrideActive="@HasActiveDisplayOverride(field.Key)"
                                                      HelpText="@GetInlineFieldHelpText(field)"
                                                      AutoFocus="@IsInlineFieldAutoFocus(field.Key)"
                                                      ActionIcon="@GetInlineFieldActionIcon(field.Key)"
                                                      ActionLabel="@GetInlineFieldActionLabel(field.Key, field.Label)"
                                                      ActionTone="@GetInlineFieldActionTone(field.Key)"
                                                      OnAction="@(() => HandleInlineFieldActionAsync(field.Key, field.Label))"
                                                      ConfirmingAction="@IsInlineFieldConfirmingRevert(field.Key)"
                                                      ConfirmLabel="@($"Remove local override for {field.Label}")"
                                                      CancelLabel="Keep override"
                                                          OnConfirmAction="@(() => ConfirmInlineFieldRevertAsync(field.Key))"
                                                      OnCancelAction="@(() => CancelInlineFieldRevert(field.Key))" />
                                    }

                                    @foreach (var field in GetDetailsMetadataFields().Where(field => field.Key == "genre"))
                                    {
                                        <MediaEditorTagEditor Label="Genres"
                                                              AddLabel="Add genre"
                                                              HelpText="A local genre override is preserved when provider metadata refreshes."
                                                              Value="@GetEditableValue(field.Key)"
                                                              ValueChanged="@((string? value) => OnFieldInput(field.Key, value))"
                                                              Suggestions="@_genreSuggestions"
                                                              Locked="@IsInlineFieldReadOnly(field.Key)"
                                                              OverrideActive="@HasActiveDisplayOverride(field.Key)"
                                                              ActionIcon="@GetInlineFieldActionIcon(field.Key)"
                                                              ActionLabel="@GetInlineFieldActionLabel(field.Key, field.Label)"
                                                              OnAction="@(() => HandleInlineFieldActionAsync(field.Key, field.Label))"
                                                              ConfirmingAction="@IsInlineFieldConfirmingRevert(field.Key)"
                                                              ConfirmLabel="Remove local genre override"
                                                              CancelLabel="Keep override"
                                                              OnConfirmAction="@(() => ConfirmInlineFieldRevertAsync(field.Key))"
                                                              OnCancelAction="@(() => CancelInlineFieldRevert(field.Key))" />
                                    }
                                </MediaEditorPanel>

                                <MediaEditorPanel Title="My Library" Description="Local organization that provider refreshes will not replace." Class="sme-details-section">
                                        @foreach (var field in GetLibraryFields())
                                        {
                                            @if (field.Key == "custom_tags")
                                            {
                                                <MediaEditorTagEditor Label="Local tags"
                                                                      Value="@GetEditableValue(field.Key)"
                                                                      ValueChanged="@((string? value) => OnFieldInput(field.Key, value))"
                                                                      Suggestions="@_tagSuggestions" />
                                            }
                                        }
                                </MediaEditorPanel>

                                @if (GetParentPositionFields().Count > 0)
                                {
                                    <MediaEditorPanel Title="Library placement"
                                                      Description="Choose where this item belongs. Structural changes are previewed before they are applied."
                                                      Class="sme-details-section">
                                        <div class="sme-parent-position-grid">
                                            @foreach (var field in GetParentPositionFields())
                                            {
                                                <div class="sme-parent-position-field">
                                                    <AppFormFieldRow Label="@field.Label"
                                                                     Value="@GetEditableValue(field.Key)"
                                                                     ValueChanged="@((string? value) => OnMembershipFieldInputAsync(field.Key, value))"
                                                                     Placeholder="@field.Placeholder"
                                                                     InputKind="@field.InputKind"
                                                                     HelpText="@GetParentPositionHelp(field.Key)" />
                                                    @if (CanSearchRetailMembership(field.Key))
                                                    {
                                                        <AppButton ButtonStyle="AppButtonStyle.Text"
                                                                   Tone="AppUiTone.Neutral"
                                                                   Class="sme-parent-position-search"
                                                                   OnClick="@(() => SearchRetailMembershipAsync(field.Key))">
                                                            Search outside this parent
                                                        </AppButton>
                                                    }
                                                    @if (GetMembershipSuggestions(field.Key).Count > 0)
                                                    {
                                                        <div class="sme-membership-suggestions" role="listbox" aria-label="@($"Suggestions for {field.Label}")">
                                                            @foreach (var suggestion in GetMembershipSuggestions(field.Key))
                                                            {
                                                                <AppButton ButtonStyle="AppButtonStyle.Text"
                                                                           Tone="AppUiTone.Neutral"
                                                                           FullWidth="true"
                                                                           Class="sme-membership-suggestion"
                                                                           OnClick="@(() => ApplyMembershipSuggestionAsync(field.Key, suggestion))">
                                                                    <span>
                                                                        <strong>@suggestion.Label</strong>
                                                                        @if (!string.IsNullOrWhiteSpace(suggestion.Subtitle))
                                                                        {
                                                                            <small>@suggestion.Subtitle</small>
                                                                        }
                                                                    </span>
                                                                    <small>@(suggestion.LocalExisting ? "In your library" : suggestion.ProviderName)</small>
                                                                </AppButton>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </MediaEditorPanel>
                                }

                                @if (GetSourceFacts().Count > 0)
                                {
                                    <MediaEditorPanel Title="Source facts"
                                                      Class="sme-details-section sme-details-section--source-facts">
                                        <Actions>
                                            <span class="sme-source-facts__description">These facts are managed by your library sources.</span>
                                        </Actions>
                                        <ChildContent>
                                            <dl class="sme-source-facts">
                                                @foreach (var fact in GetSourceFacts())
                                                {
                                                    <div class="sme-source-fact">
                                                        <MudIcon Icon="@GetSourceFactIcon(fact.Label)"
                                                                 Size="Size.Medium"
                                                                 Class="sme-source-fact__icon" />
                                                        <div class="sme-source-fact__copy">
                                                            <dt>@fact.Label</dt>
                                                            <dd>
                                                                @if (!string.IsNullOrWhiteSpace(fact.Url))
                                                                {
                                                                    <a href="@fact.Url" target="_blank" rel="noopener noreferrer">@fact.Value <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" /></a>
                                                                }
                                                                else
                                                                {
                                                                    @fact.Value
                                                                }
                                                            </dd>
                                                        </div>
                                                    </div>
                                                }
                                            </dl>
                                        </ChildContent>
                                    </MediaEditorPanel>
                                }

                            </div>
                        </div>
                    </div>
                }
                else if (_activeTab == "chapters"
                         && string.Equals(EditorMediaType, "Audiobooks", StringComparison.OrdinalIgnoreCase)
                         && !string.Equals(ActiveScope?.ScopeId, "series", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="sme-chapters-tab">
                        <section class="sme-content-media-summary">
                            <span class="sme-content-media-summary__art">
                                @if (!string.IsNullOrWhiteSpace(CurrentCoverUrl))
                                {
                                    <img src="@CurrentCoverUrl" alt="@HeaderTitle" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.Headphones" />
                                }
                            </span>
                            <span class="sme-content-media-summary__copy">
                                <span><strong>@HeaderTitle</strong><AppChip Text="Audiobook" Tone="AppUiTone.Primary" /></span>
                                @if (!string.IsNullOrWhiteSpace(HeaderSubtitle))
                                {
                                <small>@NormalizeDisplaySpacing(HeaderSubtitle)</small>
                                }
                                <span class="sme-content-media-summary__facts">
                                    <span><small>Tracks</small><strong>@AudiobookChapters.Count</strong></span>
                                    <span><small>Length</small><strong>@GetContentTotalDurationLabel()</strong></span>
                                    <span><small>Release</small><strong>@(_detail?.Year ?? "Unknown")</strong></span>
                                    <span><small>Language</small><strong>@(_detail?.Language ?? "Unknown")</strong></span>
                                </span>
                            </span>
                        </section>

                            @if (AudiobookChapters.Count == 0)
                            {
                                <div class="sme-empty-panel">
                                    <MudIcon Icon="@Icons.Material.Outlined.FormatListNumbered" Class="tl-u-font-size-24px tl-u-opacity-0-18" />
                                    <span>No embedded tracks are available for this audiobook.</span>
                                </div>
                            }
                            else
                            {
                                <div class="sme-chapter-workspace">
                                    <section class="sme-chapter-table-panel">
                                        <div class="sme-chapter-section-heading">
                                            <strong>@AudiobookChapters.Count tracks</strong>
                                        </div>
                                        <div class="sme-chapter-table-header"><span>#</span><span>Track title</span><span>Time range</span><span>Source</span></div>
                                        <div class="sme-audiobook-chapter-list">
                                            @foreach (var chapter in AudiobookChapters)
                                            {
                                                var chapterKey = BuildAudiobookChapterKey(chapter);
                                                <AppNativeButton Type="button"
                                                                 Class="@($"sme-audiobook-chapter {(IsFocusedAudiobookChapter(chapter) ? "is-editing" : string.Empty)}")"
                                                                 OnClick="@(() => ToggleAudiobookChapterEditor(chapter))">
                                                    <span class="sme-audiobook-chapter__number">@((chapter.ChapterIndex ?? 0) + 1)</span>
                                                    <strong>@GetAudiobookChapterTitle(chapter)</strong>
                                                    <span>@FormatAudiobookChapterRange(chapter)</span>
                                                    <span class="@(HasAudiobookChapterOverride(chapter) || _audiobookChapterEdits.ContainsKey(chapterKey) ? "is-override" : null)">
                                                        @(HasAudiobookChapterOverride(chapter) || _audiobookChapterEdits.ContainsKey(chapterKey) ? "Override" : "Embedded")
                                                    </span>
                                                </AppNativeButton>
                                            }
                                        </div>
                                    </section>

                                    @if (FocusedAudiobookChapter is { } focusedChapter)
                                    {
                                        <aside class="sme-chapter-editor-panel">
                                            <div class="sme-chapter-editor-heading">
                                                <div><strong>Edit track</strong><small>Track @((focusedChapter.ChapterIndex ?? 0) + 1)</small></div>
                                                @if (HasAudiobookChapterOverride(focusedChapter) || _audiobookChapterEdits.ContainsKey(BuildAudiobookChapterKey(focusedChapter)))
                                                {
                                                    <AppButton Label="Restore original"
                                                               StartIcon="@Icons.Material.Outlined.Restore"
                                                               OnClick="@(() => QueueAudiobookChapterReset(focusedChapter))" />
                                                }
                                            </div>
                                            <label>Track title</label>
                                            <AppTextField T="string"
                                                          Value="@GetAudiobookChapterTitle(focusedChapter)"
                                                          ValueChanged="@((string? value) => OnAudiobookChapterTitleInput(focusedChapter, value))"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Immediate="true" />
                                            <div class="sme-chapter-time-grid">
                                                <span><label>Start time</label><strong>@FormatAudiobookChapterTime(focusedChapter.StartSeconds)</strong></span>
                                                <span><label>End time</label><strong>@FormatAudiobookChapterTime(focusedChapter.EndSeconds)</strong></span>
                                                <span class="is-wide"><label>Duration</label><strong>@FormatAudiobookChapterDuration(focusedChapter)</strong></span>
                                            </div>
                                            <label>Source</label>
                                            <div class="sme-chapter-readonly-value">@(HasAudiobookChapterOverride(focusedChapter) ? "Override" : "Embedded")</div>
                                            <div class="sme-chapter-source-note">
                                                <MudIcon Icon="@Icons.Material.Outlined.Description" />
                                                <span>This track boundary is embedded in the audiobook file. Timing remains read-only.</span>
                                            </div>
                                        </aside>
                                    }
                                </div>
                            }
                    </div>
                }
                else if (_activeTab == "links")
                {
                    <div class="sme-match-tab">
                        @if (!string.IsNullOrWhiteSpace(_matchActionStatus))
                        {
                            <div class="sme-match-progress @(_matchActionPending ? "sme-match-progress--active" : string.Empty)" role="status">
                                <MudIcon Icon="@(_matchActionPending ? Icons.Material.Outlined.Sync : Icons.Material.Outlined.CheckCircle)" Class="tl-u-font-size-18px" />
                                <div>
                                    <strong>@(_matchActionPending ? "Updating identity" : "Identity update accepted")</strong>
                                    <span>@_matchActionStatus</span>
                                    @if (_matchIdentityJobId.HasValue)
                                    {
                                        <small>Pipeline job @_matchIdentityJobId</small>
                                    }
                                </div>
                            </div>
                        }

                        @if (IsSingleItem)
                        {
                            <div class="sme-match-workflow">
                                @{
                                    var currentRetail = BuildCurrentRetailMatchCard();
                                    var currentQid = BuildCurrentWikidataMatchCard();
                                }
                                <div class="sme-match-current-grid">
                                    <section class="sme-match-current-panel sme-match-summary-card">
                                        <div class="sme-match-summary-heading">
                                            <h3>Current retail match</h3>
                                            <span class="sme-current-match-status">@(HasCurrentRetailMatch ? "Matched" : "Not matched")</span>
                                        </div>
                                        <div class="sme-match-summary-body">
                                            <div class="sme-match-identity-art @ArtworkShapeClass">
                                                @if (!string.IsNullOrWhiteSpace(currentRetail.CoverUrl))
                                                {
                                                    <img src="@currentRetail.CoverUrl" alt="@currentRetail.Title" />
                                                }
                                                else
                                                {
                                                    <MudIcon Icon="@Icons.Material.Outlined.Image" Class="tl-u-font-size-32px tl-u-opacity-0-24" />
                                                }
                                            </div>
                                            <div class="sme-match-identity-copy">
                                                <h3>@currentRetail.Title</h3>
                                                @if (!string.IsNullOrWhiteSpace(currentRetail.Creator))
                                                {
                                                    <p>@NormalizeContributorDisplay(currentRetail.Creator)</p>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(currentRetail.Year))
                                                {
                                                    <p>@currentRetail.Year</p>
                                                }
                                            </div>
                                            <dl class="sme-match-provider-facts">
                                                <div><dt>Provider</dt><dd>@currentRetail.Badge</dd></div>
                                                <div><dt>Provider ID</dt><dd>@CurrentProviderId</dd></div>
                                            </dl>
                                        </div>
                                        @if (currentRetail.Links.Count > 0)
                                        {
                                            <div class="sme-match-source-links" aria-label="Retail match sources">
                                                @foreach (var link in currentRetail.Links)
                                                {
                                                    <a href="@link.Url" target="_blank" rel="noopener noreferrer"><span>@link.Label</span><MudIcon Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" /></a>
                                                }
                                            </div>
                                        }
                                    </section>

                                    <section class="sme-canonical-identity-panel sme-match-summary-card">
                                        <div class="sme-match-summary-heading">
                                            <h3>@CanonicalIdentityHeading</h3>
                                            <span class="sme-current-match-status">@(HasCurrentCanonicalIdentity ? "Matched" : "Not matched")</span>
                                        </div>
                                        <div class="sme-match-summary-body">
                                            <div class="sme-match-canonical-art"><MudIcon Icon="@Icons.Material.Outlined.Hub" /></div>
                                            <div class="sme-match-identity-copy">
                                                <h3>@currentQid.Title</h3>
                                                @if (!string.IsNullOrWhiteSpace(currentQid.Creator))
                                                {
                                                    <p>@currentQid.Creator</p>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(currentQid.Year))
                                                {
                                                    <p>@currentQid.Year</p>
                                                }
                                            </div>
                                            <dl class="sme-match-provider-facts">
                                                <div><dt>Source</dt><dd>Wikidata</dd></div>
                                                <div><dt>Identifier</dt><dd>@CurrentCanonicalQid</dd></div>
                                            </dl>
                                        </div>
                                        @if (currentQid.Links.Count > 0)
                                        {
                                            <div class="sme-match-source-links" aria-label="Canonical identity sources">
                                                @foreach (var link in currentQid.Links)
                                                {
                                                    <a href="@link.Url" target="_blank" rel="noopener noreferrer"><span>@link.Label</span><MudIcon Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" /></a>
                                                }
                                            </div>
                                        }
                                        @if (HasInheritedCanonicalIdentity && CanonicalIdentityOwnerScope is not null && EditorMediaType != "TV")
                                        {
                                            <div class="sme-inherited-capability">
                                                <span>Inherited from <strong>@CanonicalIdentityOwnerScope.DisplayTitle</strong></span>
                                                <AppButton ButtonStyle="AppButtonStyle.Text"
                                                           Tone="AppUiTone.Neutral"
                                                           OnClick="EditCanonicalIdentityOwnerAsync">
                                                    Edit @CanonicalIdentityOwnerScope.Label.ToLowerInvariant() identity
                                                </AppButton>
                                            </div>
                                        }
                                    </section>
                                </div>

                                <section class="sme-match-search-panel">
                                    <div class="sme-match-replacement-heading">
                                        <h3>@(HasActiveMatch ? "Find a replacement match" : "Find a match")</h3>
                                        <p>@(HasActiveMatch
                                            ? "Searching keeps the current match. Applying a result overrides the match shown above."
                                            : "Searching does not change this item. Select a result to apply a match.")</p>
                                    </div>
                                    @if (IsTvSeasonMatchReview)
                                    {
                                        <div class="sme-match-independence-note">
                                            <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                                            <span>Match this owned season to the same numbered TMDB season. Review its owned episodes separately afterward.</span>
                                        </div>
                                        @if (_tvSeasons is null)
                                        {
                                            <AppButton ButtonStyle="AppButtonStyle.Outlined"
                                                       Tone="AppUiTone.Primary"
                                                       Disabled="@_tvLoadingSeasons"
                                                       OnClick="LoadTvSeasonsAsync">
                                                @(_tvLoadingSeasons ? "Loading TMDB seasons…" : "Browse TMDB seasons")
                                            </AppButton>
                                        }
                                        else
                                        {
                                            <p>@_tvSeasons.ShowName · TMDB series @_tvSeasons.ShowId</p>
                                            <AppIntSelect Value="@_tvSelectedSeason"
                                                          ValueChanged="@SelectTvSeasonAsync"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Dense="true"
                                                          aria-label="TMDB season to match">
                                                @foreach (var season in _tvSeasons.Seasons)
                                                {
                                                    <MudSelectItem T="int" Value="@season.Number">
                                                        @(season.Number == 0 ? "Specials" : $"Season {season.Number}") · @season.Name
                                                    </MudSelectItem>
                                                }
                                            </AppIntSelect>
                                            @if (SelectedTvSeason is { } selectedSeason)
                                            {
                                                <div class="sme-tv-season-choice">
                                                    @if (!string.IsNullOrWhiteSpace(selectedSeason.PosterUrl))
                                                    {
                                                        <img src="@selectedSeason.PosterUrl"
                                                             srcset="@($"{selectedSeason.PosterUrl.Replace("/w300/", "/w185/", StringComparison.Ordinal)} 185w, {selectedSeason.PosterUrl} 300w")"
                                                             sizes="112px" alt="" loading="lazy" />
                                                    }
                                                    <div>
                                                        <strong>@selectedSeason.Name</strong>
                                                        <span>TMDB Season @selectedSeason.Number · @selectedSeason.EpisodeCount listed episode(s)</span>
                                                        <span>@(_tvSeasons.MatchedSeasonId == selectedSeason.Id ? "Matched to this owned season" : "Not yet matched to this owned season")</span>
                                                    </div>
                                                </div>
                                            }
                                            @if (CurrentOwnedTvSeasonNumber != _tvSelectedSeason)
                                            {
                                                <p role="status">This owned season is S@(CurrentOwnedTvSeasonNumber?.ToString() ?? "?"). To change season placement, correct the owned episodes individually.</p>
                                            }
                                            <AppButton ButtonStyle="AppButtonStyle.Filled"
                                                       Tone="AppUiTone.Primary"
                                                       Disabled="@(_tvSeasonMatching || IsDirty || CurrentOwnedTvSeasonNumber != _tvSelectedSeason || string.IsNullOrWhiteSpace(SelectedTvSeason?.Id))"
                                                       OnClick="MatchTvSeasonAsync">
                                                @(_tvSeasonMatching ? "Matching season…" : "Match season")
                                            </AppButton>
                                            <AppButton ButtonStyle="AppButtonStyle.Outlined"
                                                       Tone="AppUiTone.Primary"
                                                       Disabled="@(_tvReviewLoading || _tvReviewApplying || CurrentOwnedTvSeasonNumber != _tvSelectedSeason)"
                                                       OnClick="LoadTvSeasonReviewAsync">
                                                @(_tvReviewLoading ? "Checking owned episodes…" : "Review owned episodes")
                                            </AppButton>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(_tvSeasonMatchStatus))
                                        {
                                            <p role="status">@_tvSeasonMatchStatus</p>
                                        }
                                        @if (_tvSeasonReview is { } seasonReview)
                                        {
                                            <p>@seasonReview.ShowName · Season @seasonReview.SeasonNumber</p>
                                            <div class="sme-tv-episode-results">
                                                @foreach (var row in seasonReview.Rows)
                                                {
                                                    <div class="sme-tv-review-row">
                                                        <strong>@(row.LocalEpisodeNumber.HasValue ? $"E{row.LocalEpisodeNumber}" : "Episode ?") · @row.LocalTitle</strong>
                                                        <span>@(row.Episode is null ? row.Status : $"TMDB: {row.Episode.Title} · {row.Status}")</span>
                                                        @if (row.CanApply)
                                                        {
                                                            <AppNativeButton Type="button"
                                                             Class="sme-tv-review-toggle"
                                                             Disabled="@_tvReviewApplying"
                                                             aria-pressed="@_tvReviewSelectedAssets.Contains(row.AssetId)"
                                                             OnClick="@(() => ToggleTvSeasonReviewRow(row.AssetId))">
                                                                @(_tvReviewSelectedAssets.Contains(row.AssetId) ? "Selected for matching" : "Skip this episode")
                                                            </AppNativeButton>
                                                        }
                                                        @if (_tvReviewResults.TryGetValue(row.AssetId, out var rowResult))
                                                        {
                                                            <small role="status">@rowResult</small>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            <AppButton ButtonStyle="AppButtonStyle.Filled"
                                                       Tone="AppUiTone.Primary"
                                                       Disabled="@(_tvReviewApplying || IsDirty || _tvReviewSelectedAssets.Count == 0)"
                                                       OnClick="ApplyTvSeasonReviewAsync">
                                                @(_tvReviewApplying ? "Matching selected episodes…" : $"Match {_tvReviewSelectedAssets.Count} selected episode(s)")
                                            </AppButton>
                                            <AppButton ButtonStyle="AppButtonStyle.Text"
                                                       Tone="AppUiTone.Neutral"
                                                       Disabled="@(_tvReviewApplying || _providerArtworkRefreshing)"
                                                       OnClick="RefreshProviderArtworkAsync">
                                                Refresh season poster
                                            </AppButton>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(_tvLookupError))
                                        {
                                            <p role="alert">@_tvLookupError</p>
                                        }
                                    }
                                    else if (IsTvEpisodeMatchPicker)
                                    {
                                        <div class="sme-match-independence-note">
                                            <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                                            <span>Choose a TMDB episode within the matched series. Only this owned episode changes.</span>
                                        </div>
                                        @if (_tvSeasons is null)
                                        {
                                            <AppButton ButtonStyle="AppButtonStyle.Outlined"
                                                       Tone="AppUiTone.Primary"
                                                       Disabled="@_tvLoadingSeasons"
                                                       OnClick="LoadTvSeasonsAsync">
                                                @(_tvLoadingSeasons ? "Loading TMDB seasons…" : "Browse TMDB seasons")
                                            </AppButton>
                                        }
                                        else
                                        {
                                            <p>@_tvSeasons.ShowName · TMDB series @_tvSeasons.ShowId</p>
                                            <AppIntSelect Value="@_tvSelectedSeason"
                                                          ValueChanged="@SelectTvSeasonAsync"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Dense="true"
                                                          aria-label="TMDB season">
                                                @foreach (var season in _tvSeasons.Seasons)
                                                {
                                                    <MudSelectItem T="int" Value="@season.Number">
                                                        @(season.Number == 0 ? "Specials" : $"Season {season.Number}") · @season.Name
                                                    </MudSelectItem>
                                                }
                                            </AppIntSelect>
                                            @if (_tvLoadingEpisodes)
                                            {
                                                <p role="status">Loading episodes…</p>
                                            }
                                            else if (_tvEpisodes is { } tvEpisodeList)
                                            {
                                                <AppTextField T="string"
                                                              Value="@_tvEpisodeFilter"
                                                              ValueChanged="@SetTvEpisodeFilter"
                                                              Placeholder="Filter this season by title or episode number"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Immediate="true"
                                                              aria-label="Filter TMDB episodes" />
                                                @if (FilteredTvEpisodes.Count == 0)
                                                {
                                                    <p>No TMDB episodes match this season and filter.</p>
                                                }
                                                <div class="sme-tv-episode-results">
                                                    @foreach (var episode in FilteredTvEpisodes)
                                                    {
                                                        <AppNativeButton Type="button"
                                                                         Class="@(_tvSelectedEpisode?.Id == episode.Id ? "sme-tv-episode-option is-selected" : "sme-tv-episode-option")"
                                                                         aria-pressed="@(_tvSelectedEpisode?.Id == episode.Id)"
                                                                         OnClick="@(() => SelectTvEpisodeAsync(episode))">
                                                            @if (!string.IsNullOrWhiteSpace(episode.StillUrl))
                                                            {
                                                                <img src="@episode.StillUrl"
                                                                     srcset="@($"{episode.StillUrl.Replace("/w300/", "/w185/", StringComparison.Ordinal)} 185w, {episode.StillUrl} 300w")"
                                                                     sizes="96px" alt="" loading="lazy" />
                                                            }
                                                            else
                                                            {
                                                                <span class="sme-tv-episode-image-placeholder" aria-hidden="true"></span>
                                                            }
                                                            <span><strong>@($"S{tvEpisodeList.SeasonNumber} E{episode.Number} · {episode.Title}")</strong>
                                                                <small>@episode.AirDate</small>
                                                                <small>@episode.Overview</small></span>
                                                        </AppNativeButton>
                                                    }
                                                </div>
                                                @if (SelectedTvEpisodeCandidate is { } selectedEpisodeCandidate)
                                                {
                                                    var impact = GetRetailHierarchyImpactPreview(selectedEpisodeCandidate);
                                                    <div class="sme-match-independence-note">
                                                        <span>Selected: @selectedEpisodeCandidate.Title · TMDB episode @selectedEpisodeCandidate.ProviderItemId</span>
                                                    </div>
                                                    @if (impact is not null)
                                                    {
                                                        <div class="sme-match-independence-note">
                                                            <span>@impact.CurrentPath → @impact.TargetPath</span>
                                                        </div>
                                                    }
                                                    <AppButton ButtonStyle="AppButtonStyle.Filled"
                                                               Tone="AppUiTone.Primary"
                                                               Disabled="@(!CanApplyRetailCandidate(selectedEpisodeCandidate))"
                                                               OnClick="@(() => ApplyRetailCandidateAsync(selectedEpisodeCandidate))">
                                                        Match episode
                                                    </AppButton>
                                                }
                                            }
                                        }
                                        @if (!string.IsNullOrWhiteSpace(_tvLookupError))
                                        {
                                            <p role="alert">@_tvLookupError</p>
                                            <AppButton ButtonStyle="AppButtonStyle.Text" OnClick="LoadTvSeasonsAsync">Retry TMDB lookup</AppButton>
                                        }
                                    }
                                    else if (SupportsCanonicalSearch)
                                    {
                                        <div class="sme-match-search-modes" role="tablist" aria-label="Match search type">
                                            <AppNativeButton Type="button"
                                                             Class="@(!IsWikidataSearchMode ? "sme-match-search-mode is-active" : "sme-match-search-mode")"
                                                             role="tab"
                                                             aria-selected="@(!IsWikidataSearchMode)"
                                                             OnClick="@(() => SelectMatchSearchMode("retail"))">
                                                @RetailIdentityHeading
                                            </AppNativeButton>
                                            @if (CanEditCanonicalIdentity)
                                            {
                                                <AppNativeButton Type="button"
                                                                 Class="@(IsWikidataSearchMode ? "sme-match-search-mode is-active" : "sme-match-search-mode")"
                                                                 role="tab"
                                                                 aria-selected="@IsWikidataSearchMode"
                                                                 OnClick="@(() => SelectMatchSearchMode("wikidata"))">
                                                    Canonical Identity
                                                </AppNativeButton>
                                            }
                                        </div>

                                        <div class="sme-match-independence-note">
                                            <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                                            <span>@(IsWikidataSearchMode
                                                ? "Changing the canonical identity links this item to its shared work record. The retail edition and provider metadata remain unchanged."
                                                : RetailMatchChangeDescription)</span>
                                        </div>

                                        <div class="sme-match-section-heading sme-match-section-heading--search">
                                            <p>@(IsWikidataSearchMode
                                                ? "Select the shared Wikidata identity and relationships represented by this item."
                                                : RetailSearchInstruction)</p>
                                        </div>

                                        <div class="sme-search-row">
                                            <AppTextField T="string"
                                                          Value="@ActiveMatchSearchQuery"
                                                          ValueChanged="@SetActiveMatchSearchQuery"
                                                          Placeholder="@($"Search by title, creator, year, or identifier")"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Immediate="true"
                                                          Class="sme-text-input" />
                                            @if (IsActiveMatchSearchPending)
                                            {
                                                <AppButton ButtonStyle="AppButtonStyle.Outlined"
                                                           Tone="AppUiTone.Neutral"
                                                           Class="sme-inline-btn"
                                                           StartIcon="@Icons.Material.Outlined.Sync"
                                                           OnClick="CancelActiveMatchSearch">
                                                    Searching…
                                                </AppButton>
                                            }
                                            else
                                            {
                                                <AppButton ButtonStyle="AppButtonStyle.Filled"
                                                           Tone="AppUiTone.Primary"
                                                           Class="sme-inline-btn sme-inline-btn--primary"
                                                           StartIcon="@Icons.Material.Outlined.Search"
                                                           OnClick="SearchCanonicalAsync">
                                                    Search
                                                </AppButton>
                                            }
                                        </div>

                                        <div class="sme-match-search-tip">Include title, creator, year, ISBN, or provider identifiers for the best results.</div>

                                        <div class="sme-match-results">
                                            @{
                                                var searchResponse = ActiveMatchSearchResponse;
                                                @foreach (var error in searchResponse?.ProviderErrors ?? [])
                                                {
                                                    <div role="alert" class="pa-2">@error</div>
                                                }
                                            }
                                            @if (IsActiveMatchSearchPending)
                                            {
                                                <div class="sme-match-searching" role="status" aria-live="polite">
                                                    <div class="sme-match-searching__status">
                                                        <span class="sme-match-search-spinner" aria-hidden="true"></span>
                                                        <strong>@(IsWikidataSearchMode ? "Searching Wikidata…" : "Searching retail providers…")</strong>
                                                        <span>This usually takes a few seconds.</span>
                                                    </div>
                                                    <div class="sme-match-search-skeletons" aria-hidden="true">
                                                        @for (var placeholderIndex = 0; placeholderIndex < 3; placeholderIndex++)
                                                        {
                                                            <div class="sme-match-search-skeleton @(IsWikidataSearchMode ? "sme-match-search-skeleton--canonical" : "")">
                                                                <span class="sme-match-search-skeleton__selection"></span>
                                                                <span class="sme-match-search-skeleton__art"></span>
                                                                <span class="sme-match-search-skeleton__copy">
                                                                    <span class="sme-match-search-skeleton__title"></span>
                                                                    <span class="sme-match-search-skeleton__meta">
                                                                        <span></span><i></i><span></span><span></span>
                                                                    </span>
                                                                </span>
                                                                <span class="sme-match-search-skeleton__confidence">
                                                                    <span></span><small>Confidence</small>
                                                                </span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else if (searchResponse is null)
                                            {
                                                <div class="sme-empty-panel">
                                                    <MudIcon Icon="@Icons.Material.Outlined.TravelExplore" Class="tl-u-font-size-24px tl-u-opacity-0-18" />
                                                    <span>@(IsWikidataSearchMode ? "Search Wikidata for a canonical identity." : "Search retail providers for a provider match.")</span>
                                                </div>
                                            }
                                            else if (searchResponse.LinkedCandidates.Count == 0 && searchResponse.RetailCandidates.Count == 0)
                                            {
                                                <div class="sme-empty-panel">
                                                    <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Class="tl-u-font-size-24px tl-u-opacity-0-18" />
                                                    <span>@(searchResponse.NoResultMessage ?? "No safe matching results were found.")</span>
                                                </div>
                                            }
                                            else if (IsWikidataSearchMode)
                                            {
                                                @for (var canonicalIndex = 0; canonicalIndex < searchResponse.LinkedCandidates.Count; canonicalIndex++)
                                                {
                                                    var candidate = searchResponse.LinkedCandidates[canonicalIndex];
                                                    var candidateId = GetCandidateId(candidate);
                                                    var isSelected = IsCandidateSelected(candidateId);
                                                    var isBestMatch = canonicalIndex == 0;
                                                    var comparisonRows = BuildCanonicalComparisonRows(candidate);
                                                    var identityLink = BuildWikidataIdentityLinks(candidate.Qid).FirstOrDefault();
                                                    <div class="sme-match-result-card sme-match-result-card--canonical @(isSelected ? "sme-match-result-card--selected" : "")">
                                                        <div class="sme-match-result-hero">
                                                            <AppNativeButton Type="button"
                                                                             Class="sme-match-result-summary sme-match-result-summary--selectable"
                                                                             aria-pressed="@isSelected"
                                                                             AriaLabel="@($"Select {candidate.Label} as the canonical identity")"
                                                                             OnClick="@(() => SelectCandidate(candidate))">
                                                                <span class="sme-match-selection-indicator" aria-hidden="true">
                                                                    <MudIcon Icon="@(isSelected ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" Size="Size.Small" />
                                                                </span>
                                                                <div class="sme-match-result-copy">
                                                                    <div class="sme-match-result-title">@candidate.Label</div>
                                                                    <div class="sme-match-result-meta">@BuildWikidataCandidateSubtitle(candidate)</div>
                                                                    <div class="sme-match-chip-row">
                                                                        @if (isBestMatch)
                                                                        {
                                                                            <span class="sme-match-best-badge"><MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" /> Best match</span>
                                                                        }
                                                                        <span class="sme-match-quality sme-match-quality--@GetMatchQualityClass(candidate.Confidence)">@GetMatchQualityLabel(candidate.Confidence) match</span>
                                                                    </div>
                                                                </div>
                                                            </AppNativeButton>
                                                            <div class="sme-match-result-confidence" aria-label="@GetCandidateConfidenceLabel(candidate.Confidence)">
                                                                <small>Confidence</small>
                                                                <strong>@FormatCandidateScore(candidate.Confidence)</strong>
                                                                <span>@GetCandidateConfidenceSummary(candidate.Confidence)</span>
                                                            </div>
                                                            @if (isSelected)
                                                            {
                                                                <AppButton ButtonStyle="AppButtonStyle.Filled"
                                                                           Tone="AppUiTone.Primary"
                                                                           Class="sme-match-use-action"
                                                                           Disabled="@(!CanApplyLinkedCandidate(candidate))"
                                                                           OnClick="@(() => ApplyLinkedCandidateAsync(candidate))">
                                                                    @(_matchActionPending ? "Applying…" : HasCurrentCanonicalIdentity ? "Override canonical match" : "Apply canonical match")
                                                                </AppButton>
                                                            }
                                                        </div>
                                                        @if (isSelected)
                                                        {
                                                            @if (!candidate.IsApplicable && !string.IsNullOrWhiteSpace(candidate.BlockedReason))
                                                            {
                                                                <div class="sme-match-blocked-reason" role="status"><MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Size="Size.Small" /> @candidate.BlockedReason</div>
                                                            }
                                                            <div class="sme-match-consequence-note">
                                                                <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                                                                <span>This links the item to the selected shared work. Retail edition data and editable metadata remain unchanged.</span>
                                                            </div>
                                                            <section class="sme-match-comparison-panel">
                                                                <div class="sme-match-comparison-heading">
                                                                    <h4>Match comparison</h4>
                                                                    <span>Total confidence <strong>@FormatCandidateScore(candidate.Confidence)</strong></span>
                                                                </div>
                                                                <div class="sme-match-comparison-table" role="table" aria-label="Canonical match comparison">
                                                                    <div class="sme-match-comparison-row sme-match-comparison-row--header" role="row">
                                                                        <span role="columnheader">Field</span>
                                                                        <span role="columnheader">Your item</span>
                                                                        <span role="columnheader">Wikidata</span>
                                                                        <span role="columnheader">Match</span>
                                                                    </div>
                                                                    @foreach (var row in comparisonRows)
                                                                    {
                                                                        <div class="sme-match-comparison-row" role="row">
                                                                            <strong role="cell">@row.Label</strong>
                                                                            <span role="cell">@row.LocalValue</span>
                                                                            <span role="cell">@row.CandidateValue</span>
                                                                            <span role="cell" class="@GetConfidenceSignalClass(row.Score)">
                                                                                <MudIcon Icon="@GetConfidenceSignalIcon(row.Score)" Size="Size.Small" />
                                                                                @(row.Score >= 0 ? $"{GetComparisonScoreLabel(row.Score)} · {FormatCandidateScore(row.Score)}" : "Not compared")
                                                                            </span>
                                                                        </div>
                                                                    }
                                                                </div>
                                                                @if (identityLink is not null)
                                                                {
                                                                    <a class="sme-match-detail-link" href="@identityLink.Url" target="_blank" rel="noopener noreferrer">View on Wikidata <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" /></a>
                                                                }
                                                            </section>
                                                            @if (!string.IsNullOrWhiteSpace(candidate.WikipediaExtract ?? candidate.Description))
                                                            {
                                                                <section class="sme-candidate-evidence-panel">
                                                                    <div class="sme-candidate-description">
                                                                        <h4><MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Small" /> Description</h4>
                                                                        <p>@(candidate.WikipediaExtract ?? candidate.Description)</p>
                                                                    </div>
                                                                </section>
                                                            }
                                                        }
                                                    </div>
                                                }
                                                <div class="sme-file-actions">
                                                    <AppButton ButtonStyle="AppButtonStyle.Outlined"
                                                               Tone="AppUiTone.Neutral"
                                                               Class="sme-inline-btn"
                                                               Disabled="@_matchActionPending"
                                                               OnClick="MarkWikidataMissingAsync">
                                                        Mark canonical identity missing
                                                    </AppButton>
                                                    <AppButton ButtonStyle="AppButtonStyle.Outlined"
                                                               Tone="AppUiTone.Neutral"
                                                               Class="sme-inline-btn"
                                                               Disabled="@_matchActionPending"
                                                               OnClick="ClearWikidataMatchAsync">
                                                        Clear canonical match
                                                    </AppButton>
                                                </div>
                                            }
                                            else
                                            {
                                                @for (var retailIndex = 0; retailIndex < searchResponse.RetailCandidates.Count; retailIndex++)
                                                {
                                                    var candidate = searchResponse.RetailCandidates[retailIndex];
                                                    var candidateId = GetCandidateId(candidate);
                                                    var candidateScore = GetRetailCandidateScore(candidate);
                                                    var comparisonRows = BuildRetailComparisonRows(candidate);
                                                    var isSelected = IsCandidateSelected(candidateId);
                                                    var isBestMatch = retailIndex == 0;
                                                    var evidenceNotice = GetRetailCandidateEvidenceNotice(candidate);
                                                    var hierarchyPreviewStatus = GetRetailHierarchyPreviewStatus(candidate);
                                                    <div class="sme-match-result-card sme-match-result-card--retail @(isSelected ? "sme-match-result-card--selected" : "")">
                                                        <div class="sme-match-result-hero">
                                                            <AppNativeButton Type="button"
                                                                             Class="sme-match-result-summary sme-match-result-summary--selectable"
                                                                             aria-pressed="@isSelected"
                                                                             AriaLabel="@($"Select {candidate.Title} from {candidate.ProviderName}")"
                                                                             OnClick="@(() => SelectCandidateAsync(candidate))">
                                                                <span class="sme-match-selection-indicator" aria-hidden="true">
                                                                    <MudIcon Icon="@(isSelected ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" Size="Size.Small" />
                                                                </span>
                                                                <div class="sme-match-result-art @ArtworkShapeClass">
                                                                    @if (!string.IsNullOrWhiteSpace(candidate.CoverUrl))
                                                                    {
                                                                        <img src="@candidate.CoverUrl" alt="" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <MudIcon Icon="@Icons.Material.Outlined.Image" Class="tl-u-font-size-24px tl-u-opacity-0-24" />
                                                                    }
                                                                </div>
                                                                <div class="sme-match-result-copy">
                                                                    <div class="sme-match-result-title">@candidate.Title</div>
                                                                    <div class="sme-match-result-meta">@NormalizeDisplaySpacing(BuildRetailCandidateSubtitle(candidate))</div>
                                                                    <div class="sme-match-chip-row">
                                                                        @if (isBestMatch)
                                                                        {
                                                                            <span class="sme-match-best-badge"><MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" /> Best match</span>
                                                                        }
                                                                        <span class="sme-match-quality sme-match-quality--@GetMatchQualityClass(candidateScore)">@GetMatchQualityLabel(candidateScore) match</span>
                                                                    </div>
                                                                </div>
                                                            </AppNativeButton>
                                                            <div class="sme-match-result-confidence" aria-label="@GetCandidateConfidenceLabel(candidateScore)">
                                                                <small>Confidence</small>
                                                                <strong>@FormatCandidateScore(candidateScore)</strong>
                                                                <span>@GetCandidateConfidenceSummary(candidateScore)</span>
                                                            </div>
                                                            @if (isSelected)
                                                            {
                                                                <AppButton ButtonStyle="AppButtonStyle.Filled"
                                                                           Tone="AppUiTone.Primary"
                                                                           Class="sme-match-use-action"
                                                                           Disabled="@(!CanApplyRetailCandidate(candidate))"
                                                                           OnClick="@(() => ApplyRetailCandidateAsync(candidate))">
                                                                    @(_matchActionPending ? "Applying…" : HasCurrentRetailMatch ? "Override retail match" : "Apply retail match")
                                                                </AppButton>
                                                            }
                                                        </div>
                                                        @if (isSelected)
                                                        {
                                                            @if (IsDirty)
                                                            {
                                                                <div class="sme-match-blocked-reason" role="status"><MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Size="Size.Small" /> Save or discard your unsaved editor changes before applying a retail match.</div>
                                                            }
                                                            else if (!candidate.IsApplicable && !string.IsNullOrWhiteSpace(candidate.BlockedReason))
                                                            {
                                                                <div class="sme-match-blocked-reason" role="status"><MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Size="Size.Small" /> @candidate.BlockedReason</div>
                                                            }
                                                            else if (!string.IsNullOrWhiteSpace(evidenceNotice))
                                                            {
                                                                <div class="sme-match-evidence-notice" role="status"><MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" /> @evidenceNotice</div>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(hierarchyPreviewStatus))
                                                            {
                                                                <div class="@(IsRetailHierarchyPreviewLoading(candidate) ? "sme-match-evidence-notice" : "sme-match-blocked-reason")" role="status"><MudIcon Icon="@(IsRetailHierarchyPreviewLoading(candidate) ? Icons.Material.Outlined.Info : Icons.Material.Outlined.WarningAmber)" Size="Size.Small" /> @hierarchyPreviewStatus</div>
                                                            }
                                                            <RetailHierarchyImpactNotice Preview="@GetRetailHierarchyImpactPreview(candidate)" />
                                                            <div class="sme-match-consequence-note">
                                                                <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                                                                <span>This changes the linked retail edition and refreshes provider-managed artwork. Canonical identity and user-edited metadata remain unchanged.</span>
                                                            </div>
                                                            <section class="sme-match-comparison-panel">
                                                                <div class="sme-match-comparison-heading">
                                                                    <h4>Match comparison</h4>
                                                                    <span>Total confidence <strong>@FormatCandidateScore(candidateScore)</strong></span>
                                                                </div>
                                                                <div class="sme-match-comparison-table" role="table" aria-label="Retail match comparison">
                                                                    <div class="sme-match-comparison-row sme-match-comparison-row--header" role="row">
                                                                        <span role="columnheader">Field</span>
                                                                        <span role="columnheader">Your item</span>
                                                                        <span role="columnheader">Retail result</span>
                                                                        <span role="columnheader">Match</span>
                                                                    </div>
                                                                    @foreach (var row in comparisonRows)
                                                                    {
                                                                        <div class="sme-match-comparison-row" role="row">
                                                                            <strong role="cell">@row.Label</strong>
                                                                            <span role="cell">@row.LocalValue</span>
                                                                            <span role="cell">@row.CandidateValue</span>
                                                                            <span role="cell" class="@GetConfidenceSignalClass(row.Score)">
                                                                                <MudIcon Icon="@GetConfidenceSignalIcon(row.Score)" Size="Size.Small" />
                                                                                @(row.Score >= 0 ? $"{GetComparisonScoreLabel(row.Score)} · {FormatCandidateScore(row.Score)}" : "Not compared")
                                                                            </span>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </section>
                                                            <section class="sme-candidate-evidence-panel">
                                                                @if (!string.IsNullOrWhiteSpace(candidate.Description))
                                                                {
                                                                    <div class="sme-candidate-description">
                                                                        <h4><MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Small" /> Description</h4>
                                                                        <p>@candidate.Description</p>
                                                                    </div>
                                                                }
                                                                @if (_loadingRetailCandidateDetail)
                                                                {
                                                                    <div class="sme-candidate-detail-loading"><AppProgressBar Indeterminate="true" /> Loading provider details…</div>
                                                                }
                                                                else if (_retailCandidateDetail is { } detail)
                                                                {
                                                                    <div class="sme-candidate-provider-detail">
                                                                        <div class="sme-candidate-provider-detail__heading">
                                                                            <strong>@detail.Heading</strong>
                                                                            <span>Source: @detail.SourceLabel</span>
                                                                        </div>
                                                                        @if (!string.IsNullOrWhiteSpace(detail.UnavailableMessage))
                                                                        {
                                                                            <p class="sme-candidate-unavailable">@detail.UnavailableMessage</p>
                                                                        }
                                                                        @if (detail.Items.Count > 0)
                                                                        {
                                                                            <div class="sme-candidate-track-list" role="table" aria-label="Candidate track list">
                                                                                <div class="sme-candidate-track-list__header" role="row"><span>#</span><span>Title</span><span>Duration</span></div>
                                                                                @foreach (var track in detail.Items)
                                                                                {
                                                                                    <div class="sme-candidate-track" role="row">
                                                                                        <span>@(track.DiscNumber is > 1 ? $"{track.DiscNumber}.{track.Ordinal}" : track.Ordinal)</span>
                                                                                        <strong>@track.Title</strong>
                                                                                        <span>@FormatCandidateDuration(track.DurationSeconds)</span>
                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                }
                                                            </section>
                                                        }
                                                    </div>
                                                            }
                                                        }
                                                    </div>

                                    }
                                    else if (!string.IsNullOrWhiteSpace(CanonicalSearchUnavailableReason))
                                    {
                                        <div class="sme-search-inline-hint">@CanonicalSearchUnavailableReason</div>
                                    }
                                </section>
                            </div>
                        }
                        else
                        {
                            <div class="sme-search-inline-hint">Match and identity correction is available for one item at a time.</div>
                        }

                        @foreach (var group in GetGroupsForTab("links"))
                        {
                            <section class="sme-group">
                                <div class="sme-group-title">@group.Label</div>
                                @foreach (var field in group.Fields)
                                {
                                    <div class="sme-field-row">
                                        <label class="sme-field-label">
                                            <span>@field.Label</span>
                                            @if (field.IdentityField)
                                            {
                                                <MudTooltip Text="Used to identify the right title, edition, show, or person during matching.">
                                                    <span class="sme-field-info" aria-label="Matching help">
                                                        <MudIcon Icon="@Icons.Material.Outlined.Info" Class="tl-u-font-size-14px" />
                                                    </span>
                                                </MudTooltip>
                                            }
                                        </label>
                                        <div class="sme-field-control">
                                            @if (field.InputKind == "textarea")
                                            {
                                                <AppTextField T="string"
                                                              Value="@GetEditableValue(field.Key)"
                                                              ValueChanged="@((string? value) => OnFieldInput(field.Key, value))"
                                                              Placeholder="@GetPlaceholder(field)"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Immediate="true"
                                                              Lines="4"
                                                              Class="sme-textarea" />
                                            }
                                            else
                                            {
                                                <AppTextField T="string"
                                                              Value="@GetEditableValue(field.Key)"
                                                              ValueChanged="@((string? value) => OnFieldInput(field.Key, value))"
                                                              Placeholder="@GetPlaceholder(field)"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Immediate="true"
                                                              Class="sme-text-input" />
                                            }
                                        </div>
                                    </div>
                                }
                            </section>
                        }

                    </div>
                }
                else if (_activeTab == "artwork")
                {
                    <div class="sme-artwork">
                        @if (UnifiedArtworkItem is { } unifiedArtworkItem)
                        {
                            <ArtworkWorkspace @key="@($"{unifiedArtworkItem.EntityType}:{unifiedArtworkItem.EntityId}:{ActiveScope?.ScopeId}")"
                                              Item="@unifiedArtworkItem"
                                              ShowClose="false"
                                              ProviderRefreshEntityId="@EditorContextEntityId"
                                              ProviderRefreshScopeId="@ActiveScope?.ScopeId"
                                              OnChanged="UnifiedArtworkChangedAsync" />
                        }
                        else if (IsSingleItem)
                        {
                            <section class="sme-artwork-workspace">
                                <div class="sme-artwork-main">
                                    @if (ArtworkSlots.Count == 0)
                                    {
                                        <div class="sme-artwork-readonly">
                                            <div class="sme-artwork-readonly-title">@GetArtworkReadOnlyTitle()</div>
                                            <div class="sme-artwork-readonly-text">@GetArtworkReadOnlyText()</div>
                                            @if (GetArtworkReadOnlySwitchTargets().Count > 0)
                                            {
                                                <div class="sme-artwork-readonly-actions">
                                                    @foreach (var scope in GetArtworkReadOnlySwitchTargets())
                                                    {
                                                        <AppButton ButtonStyle="AppButtonStyle.Outlined"
                                                                   Tone="AppUiTone.Neutral"
                                                                   Class="sme-inline-btn"
                                                                   OnClick="@(() => SelectArtworkScopeAsync(scope.ScopeId))">
                                                            Edit @scope.Label.ToLowerInvariant() artwork
                                                        </AppButton>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (SelectedArtworkSlot is not null)
                                    {
                                        var slot = SelectedArtworkSlot;
                                        var focusedItem = LeadArtworkVariant;
                                        var rowItems = GetArtworkRowItems(slot.AssetType);
                                        var focusedPreviewClass = GetArtworkPreviewClass(slot, focusedItem);

                                        <section class="sme-artwork-editor-grid @(IsArtworkDragTarget(slot.AssetType) ? "sme-artwork-gallery-panel--drag" : "")"
                                                 @ondragenter="@(() => SetArtworkDragTarget(slot.AssetType))"
                                                 @ondragleave="@(() => ClearArtworkDragTarget(slot.AssetType))"
                                                 @ondragover:preventDefault="true"
                                                 @ondrop="@(() => ClearArtworkDragTarget(slot.AssetType))">
                                            <div class="sme-artwork-editor-heading">
                                                <div>
                                                    <h3>@slot.Label artwork</h3>
                                                    <p>@(HasAutomaticGroupArtwork ? "Use automatic artwork from owned titles or add a custom shelf cover." : $"Choose the preferred {slot.Label.ToLowerInvariant()} or add a new image.")</p>
                                                </div>
                                                <div class="sme-artwork-editor-actions">
                                                    @if (HasAutomaticGroupArtwork && focusedItem is not null)
                                                    {
                                                        <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" Disabled="@IsArtworkBusy" OnClick="RestoreAutomaticArtworkAsync">Restore automatic artwork</AppButton>
                                                    }
                                                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" StartIcon="@Icons.Material.Outlined.CloudUpload" Class="sme-artwork-action-upload">
                                                        Upload
                                                        <span class="sme-art-slot-input-shell">
                                                            <InputFile class="sme-art-slot-file-input"
                                                                       OnChange="@((InputFileChangeEventArgs args) => HandleArtworkSelectedAsync(slot.AssetType, args))"
                                                                       accept="@GetArtworkAcceptedTypes(slot.AssetType)" />
                                                        </span>
                                                    </AppButton>
                                                    <AppButton Label="From URL"
                                                               StartIcon="@Icons.Material.Outlined.Link"
                                                               OnClick="ToggleArtworkUrlInput" />
                                                    @if (CanRefreshProviderArtwork(ArtworkScope))
                                                    {
                                                        <AppButton Label="@(_providerArtworkRefreshing ? "Refreshing..." : "Refresh")"
                                                                   StartIcon="@Icons.Material.Outlined.Sync"
                                                                   Disabled="@IsArtworkBusy"
                                                                   OnClick="RefreshProviderArtworkAsync" />
                                                    }
                                                </div>
                                            </div>

                                            <div class="sme-artwork-showcase">
                                                <div class="sme-artwork-primary-card sme-artwork-primary-card--@focusedPreviewClass">
                                                    @if (focusedItem is not null)
                                                    {
                                                        <div class="sme-art-row-stage sme-art-row-stage--@focusedPreviewClass">
                                                            @if (!string.IsNullOrWhiteSpace(focusedItem.ImageUrl))
                                                            {
                                                                <img src="@GetArtworkThumbnailUrl(focusedItem)" alt="@slot.Label" class="sme-art-slot-image sme-art-slot-image--@slot.ImageClass" loading="lazy" decoding="async" />
                                                            }
                                                            else
                                                            {
                                                                <div class="sme-cover-fallback sme-art-slot-placeholder"><MudIcon Icon="@slot.Icon" /></div>
                                                            }
                                                            @if (focusedItem.IsPreferred)
                                                            {
                                                                <span class="sme-artwork-gallery-check" aria-label="Primary artwork"><MudIcon Icon="@Icons.Material.Filled.Check" /></span>
                                                                <span class="sme-artwork-primary-badge">Primary</span>
                                                            }
                                                            @if (!IsArtworkDeleteConfirming(focusedItem))
                                                            {
                                                                <div class="sme-artwork-image-actions">
                                                                    <AppIconButton Icon="@Icons.Material.Outlined.ZoomIn"
                                                                                   Size="AppControlSize.Compact"
                                                                                   Class="sme-artwork-image-action"
                                                                                   Tooltip="Preview artwork"
                                                                                   AriaLabel="Preview artwork"
                                                                                   OnClick="@(() => OpenArtworkZoom(slot, focusedItem))" />
                                                                    @if (focusedItem.VariantId != Guid.Empty && focusedItem.CanDelete)
                                                                    {
                                                                    <AppIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                                                                   Size="AppControlSize.Compact"
                                                                                   Tone="AppUiTone.Error"
                                                                                   Class="sme-artwork-image-action sme-artwork-image-action--delete"
                                                                                   Tooltip="@GetArtworkRemovalLabel(focusedItem)"
                                                                                   AriaLabel="@GetArtworkRemovalLabel(focusedItem)"
                                                                                   OnClick="@(() => DeleteArtworkVariantWithConfirmationAsync(focusedItem))" />
                                                                    }
                                                                </div>
                                                            }
                                                            @if (IsArtworkDeleteConfirming(focusedItem))
                                                            {
                                                                <div class="sme-artwork-delete-confirm"
                                                                     role="group"
                                                                     aria-label="@GetArtworkRemovalQuestion(focusedItem)">
                                                                    <AppIconButton Icon="@Icons.Material.Outlined.Check"
                                                                                   Size="AppControlSize.Compact"
                                                                                   Tone="AppUiTone.Error"
                                                                                   Class="sme-artwork-delete-confirm__action sme-artwork-delete-confirm__action--accept"
                                                                                   Tooltip="@GetArtworkRemovalConfirmLabel(focusedItem)"
                                                                                   AriaLabel="@GetArtworkRemovalConfirmLabel(focusedItem)"
                                                                                   OnClick="@(() => ConfirmArtworkDeleteAsync(focusedItem))" />
                                                                    <AppIconButton Icon="@Icons.Material.Outlined.Close"
                                                                                   Size="AppControlSize.Compact"
                                                                                   Class="sme-artwork-delete-confirm__action sme-artwork-delete-confirm__action--cancel"
                                                                                   Tooltip="Cancel"
                                                                                   AriaLabel="Cancel artwork removal"
                                                                                   OnClick="@(() => CancelArtworkDelete(focusedItem))" />
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else if (HasAutomaticGroupArtwork)
                                                    {
                                                        <div class="sme-automatic-artwork"><MediaArtworkGroupPreview Items="AutomaticGroupArtwork" Layout="MediaArtworkGroupPreviewLayout.Cluster" ShowOverflowCount="false" AriaLabel="Automatic stacked shelf artwork" /></div>
                                                        <span>Automatic artwork · Owned titles in series order</span>
                                                    }
                                                    else
                                                    {
                                                        <div class="sme-artwork-primary-empty"><MudIcon Icon="@slot.Icon" /><span>No @slot.Label.ToLowerInvariant() artwork yet</span></div>
                                                    }
                                                </div>

                                                <aside class="sme-artwork-details-panel">
                                                    <h3>Artwork details</h3>
                                                    <dl>
                                                        <div><dt>Artwork type</dt><dd>@slot.Label</dd></div>
                                                        <div><dt>Source</dt><dd>@(focusedItem is null ? "Not available" : GetArtworkCardSource(focusedItem))</dd></div>
                                                        <div><dt>Image size</dt><dd>@GetArtworkImageSize(focusedItem)</dd></div>
                                                        <div><dt>Added</dt><dd>@(focusedItem?.CreatedAt?.LocalDateTime.ToString("g", CultureInfo.CurrentCulture) ?? "Provider managed")</dd></div>
                                                    </dl>
                                                </aside>

                                                <div class="sme-artwork-add-panel">
                                                    <div class="sme-artwork-drop-zone">
                                                        <MudIcon Icon="@Icons.Material.Outlined.CloudUpload" />
                                                        <strong>Drop image here</strong>
                                                        <span>or click to browse for a new @slot.Label.ToLowerInvariant()</span>
                                                        <small>JPG or PNG, up to 20 MB</small>
                                                        <InputFile class="sme-artwork-drop-input"
                                                                   OnChange="@((InputFileChangeEventArgs args) => HandleArtworkSelectedAsync(slot.AssetType, args))"
                                                                   accept="@GetArtworkAcceptedTypes(slot.AssetType)" />
                                                    </div>
                                                    <AppButton Label="From URL" StartIcon="@Icons.Material.Outlined.Link" OnClick="ToggleArtworkUrlInput" />
                                                </div>
                                            </div>

                                            @if (_showArtworkUrlInput && string.Equals(slot.AssetType, SelectedArtworkSlot?.AssetType, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <div class="sme-artwork-import-url-row">
                                                    <AppTextField T="string"
                                                                  Value="@_artworkUrlInput"
                                                                  ValueChanged="@((string? value) => _artworkUrlInput = value ?? string.Empty)"
                                                                  Placeholder="Paste an image URL"
                                                                  InputType="InputType.Url"
                                                                  Variant="Variant.Outlined"
                                                                  Margin="Margin.Dense"
                                                                  Immediate="true"
                                                                  Class="sme-text-input" />
                                                    <div class="sme-artwork-import-url-actions">
                                                        <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Class="sme-inline-btn" OnClick="ToggleArtworkUrlInput">Cancel</AppButton>
                                                        <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Class="sme-inline-btn sme-inline-btn--primary" Disabled="@(_artworkUrlSubmitting || string.IsNullOrWhiteSpace(_artworkUrlInput))" OnClick="ApplyArtworkUrlAsync">Add</AppButton>
                                                    </div>
                                                </div>
                                            }

                                            @if (HasPendingArtwork(slot.AssetType))
                                            {
                                                <div class="sme-artwork-import-status">
                                                    <span>@GetPendingArtworkFileName(slot.AssetType)</span>
                                                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Class="sme-inline-btn" OnClick="@(() => ClearArtworkSelection(slot.AssetType))">Clear</AppButton>
                                                    @if (HasArtworkUploadError(slot.AssetType))
                                                    {
                                                        <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Class="sme-inline-btn" OnClick="@(() => RetryArtworkUploadAsync(slot.AssetType))">Retry Upload</AppButton>
                                                    }
                                                </div>
                                            }

                                            @if (HasArtworkUploadError(slot.AssetType))
                                            {
                                                <div class="sme-artwork-import-error">@GetArtworkUploadError(slot.AssetType)</div>
                                            }

                                            <div class="sme-artwork-tips sme-artwork-tips--banner">
                                                <MudIcon Icon="@Icons.Material.Outlined.Lightbulb" Size="Size.Small" />
                                                <div>
                                                    <strong>@slot.Label artwork tips</strong>
                                                    <span>@GetArtworkGuidance(slot)</span>
                                                </div>
                                            </div>

                                            @if (rowItems.Count > 1)
                                            {
                                                <div class="sme-artwork-variants-section">
                                                    <div class="sme-artwork-variants-heading">
                                                        <h4>Other @slot.Label.ToLowerInvariant() options</h4>
                                                        <span>@rowItems.Count options</span>
                                                    </div>
                                                    <div class="sme-artwork-variant-strip">
                                                        @foreach (var item in rowItems)
                                                        {
                                                            var itemPreviewClass = GetArtworkPreviewClass(slot, item);
                                                            <AppNativeButton Type="button"
                                                                             Class="@($"sme-artwork-variant-card sme-artwork-variant-card--{itemPreviewClass} {(focusedItem?.Key == item.Key ? "is-selected" : string.Empty)}")"
                                                                             aria-label="@BuildArtworkVariantHoverLabel(slot, item)"
                                                                             OnClick="@(() => HandleArtworkVariantClickAsync(slot, item))">
                                                                <span class="sme-art-row-stage sme-art-row-stage--@itemPreviewClass">
                                                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                                                    {
                                                                        <img src="@GetArtworkThumbnailUrl(item)" alt="" class="sme-art-slot-image sme-art-slot-image--@slot.ImageClass" loading="lazy" decoding="async" />
                                                                    }
                                                                </span>
                                                            </AppNativeButton>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </section>

                                    }
                                </div>
                            </section>

                            <MediaEditorArtworkLightbox IsOpen="@IsArtworkZoomOpen"
                                                        ImageUrl="@ZoomArtworkVariant?.ImageUrl"
                                                        Label="@ZoomArtworkSlot?.Label"
                                                        Summary="@(ZoomArtworkSlot is not null && ZoomArtworkVariant is not null ? BuildArtworkVariantSummary(ZoomArtworkSlot, ZoomArtworkVariant) : null)"
                                                        PreviewClass="@(ZoomArtworkSlot is null ? null : GetArtworkPreviewClass(ZoomArtworkSlot, ZoomArtworkVariant))"
                                                        ImageClass="@ZoomArtworkSlot?.ImageClass"
                                                        CanGoPrevious="@CanZoomPrevious"
                                                        CanGoNext="@CanZoomNext"
                                                        OnPrevious="ShowPreviousArtworkVariant"
                                                        OnNext="ShowNextArtworkVariant"
                                                        OnClose="CloseArtworkZoom" />
                        }
                        else
                        {
                            <div class="sme-empty-panel">
                                <MudIcon Icon="@Icons.Material.Outlined.Collections" Class="tl-u-font-size-24px tl-u-opacity-0-18" />
                                <span>Artwork changes are single-item only in this pass.</span>
                            </div>
                        }
                    </div>
                }
                else if (_activeTab == "options")
                {
                    var groups = GetAdditionalOptionsGroups().ToList();
                    <div class="sme-fields-pane sme-fields-pane--single">
                        <MediaEditorLocalOptions GenreValue="@GetEditableValue("genre")"
                                                 GenreValueChanged="@((string? value) => OnFieldInput("genre", value))"
                                                 TagValue="@GetEditableValue("custom_tags")"
                                                 TagValueChanged="@((string? value) => OnFieldInput("custom_tags", value))"
                                                 RatingValue="@GetEditableValue("rating")"
                                                 RatingValueChanged="@((string? value) => OnFieldInput("rating", value))" />

                        @if (groups.Count == 0)
                        {
                            <div class="sme-options-note">Additional item options will appear here when available.</div>
                        }
                        else
                        {
                            @foreach (var group in groups)
                            {
                                <section class="sme-group">
                                    <div class="sme-group-title">@group.Label</div>
                                    @foreach (var field in group.Fields)
                                    {
                                        <div class="sme-field-row">
                                            <label class="sme-field-label">@field.Label</label>
                                            <div class="sme-field-control">
                                                @if (field.InputKind == "textarea")
                                                {
                                                    <AppTextField T="string"
                                                                  Value="@GetEditableValue(field.Key)"
                                                                  ValueChanged="@((string? value) => OnFieldInput(field.Key, value))"
                                                                  Placeholder="@GetPlaceholder(field)"
                                                                  Variant="Variant.Outlined"
                                                                  Margin="Margin.Dense"
                                                                  Immediate="true"
                                                                  Lines="4"
                                                                  Class="sme-textarea" />
                                                }
                                                else
                                                {
                                                    <AppTextField T="string"
                                                                  Value="@GetEditableValue(field.Key)"
                                                                  ValueChanged="@((string? value) => OnFieldInput(field.Key, value))"
                                                                  Placeholder="@GetPlaceholder(field)"
                                                                  Variant="Variant.Outlined"
                                                                  Margin="Margin.Dense"
                                                                  Immediate="true"
                                                                  Class="sme-text-input" />
                                                }
                                            </div>
                                        </div>
                                    }
                                </section>
                            }
                        }
                    </div>
                }
                else if (_activeTab == "file")
                {
                    <div class="sme-file-tab">
                        @if (IsContainerEditor)
                        {
                            <MediaEditorPanel Title="Attached files" Description="A reconciliation summary across the owned children in this container.">
                                <div class="sme-container-file-summary">
                                    <div><strong>@ContainerAttachedFileCount</strong><span>Attached</span></div>
                                    <div><strong>@ContainerMissingFileCount</strong><span>Missing</span></div>
                                    <div><strong>@ContainerQuarantineCount</strong><span>Unassigned or quarantined</span></div>
                                </div>
                                @if (ContainerTechnicalBadges.Count > 0)
                                {
                                    <div class="sme-container-file-badges" aria-label="File quality and format summary">
                                        @foreach (var badge in ContainerTechnicalBadges)
                                        {
                                            <span>@badge.Label <strong>@badge.Count</strong></span>
                                        }
                                    </div>
                                }
                                <div class="sme-source-managed-note">
                                    <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                                    <span>Open a file entry to inspect its filename, path, and technical details.</span>
                                </div>
                            </MediaEditorPanel>
                        }
                        else if (!IsSingleItem || _detail is null)
                        {
                            <div class="sme-empty-panel">
                                <MudIcon Icon="@Icons.Material.Outlined.InsertDriveFile" Class="tl-u-font-size-24px tl-u-opacity-0-18" />
                                <span>File inspection is available for a single item.</span>
                            </div>
                        }
                        else
                        {
                            <section class="sme-file-item-summary">
                                <span class="sme-file-format-icon">
                                    <MudIcon Icon="@Icons.Material.Outlined.Description" />
                                    <small>@GetFileFormat(_detail.FileName)</small>
                                </span>
                                <span>
                                    <strong>@HeaderTitle</strong>
                                    <small>@GetFileFormat(_detail.FileName) file</small>
                                </span>
                                <AppChip Text="@HeaderKicker" Tone="AppUiTone.Neutral" />
                            </section>

                            @if (string.Equals(_detail.ReviewTrigger, "WritebackFailed", StringComparison.OrdinalIgnoreCase))
                            {
                                <section class="sme-writeback-remediation" role="alert">
                                    <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" />
                                    <span>
                                        <strong>Metadata could not be written to the file</strong>
                                        <small>@(_detail.ReviewDetail ?? "The file may be read-only, unavailable, or locked by another application.")</small>
                                    </span>
                                    <AppButton Label="@(_retryingWriteback ? "Retrying..." : "Retry write-back")"
                                               StartIcon="@Icons.Material.Outlined.Sync"
                                               ButtonStyle="AppButtonStyle.Filled"
                                               Tone="AppUiTone.Primary"
                                               Disabled="@_retryingWriteback"
                                               OnClick="RetryWritebackAsync" />
                                </section>
                            }

                            <section class="sme-file-status-panel">
                                <div class="sme-file-panel-heading">
                                    <span>File</span>
                                    <span class="sme-file-health"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Small" /> Available</span>
                                </div>
                                <dl class="sme-file-fact-grid">
                                    <div><dt>File name</dt><dd>@(_detail.FileName ?? "Unknown")</dd></div>
                                    <div><dt>Format</dt><dd>@GetFileFormat(_detail.FileName)</dd></div>
                                    <div class="sme-file-fact-grid__path"><dt>File path</dt><dd>@(_detail.FilePath ?? "Unknown")</dd></div>
                                    <div><dt>Size</dt><dd>@FormatFileSize(_detail.FileSizeBytes)</dd></div>
                                    <div><dt>Status</dt><dd><span class="sme-file-health"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Small" /> @(_detail.Status ?? "Available")</span></dd></div>
                                    <div><dt>Last activity</dt><dd>@FormatLastFileActivity()</dd></div>
                                </dl>
                            </section>

                            <section class="sme-file-status-panel">
                                <div class="sme-file-panel-heading">
                                    <span>Processing</span>
                                    <AppButton Label="@(_rereadingFileMetadata ? "Rereading..." : "Reread file metadata")"
                                               StartIcon="@Icons.Material.Outlined.Refresh"
                                               ButtonStyle="AppButtonStyle.Outlined"
                                               Tone="AppUiTone.Primary"
                                               Disabled="@_rereadingFileMetadata"
                                               OnClick="RereadFileMetadataAsync" />
                                </div>
                                <dl class="sme-file-fact-grid sme-file-fact-grid--processing">
                                    <div><dt>Identity</dt><dd><span class="sme-file-health"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Small" /> @(_detail.Status ?? "Identified")</span></dd></div>
                                    <div><dt>Pipeline</dt><dd><span class="sme-file-health"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Small" /> @(_detail.PipelineStep ?? "Complete")</span></dd></div>
                                    <div><dt>Metadata write-back</dt><dd><span class="sme-file-sync"><MudIcon Icon="@Icons.Material.Outlined.Sync" Size="Size.Small" /> @(_editorContext?.FileMetadataSyncStatus ?? "Current")</span></dd></div>
                                    <div><dt>Last write</dt><dd>@FormatLastFileActivity()</dd></div>
                                </dl>
                                <div class="sme-file-panel-note">
                                    <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                                    <span>Physical-file information is read-only. Metadata changes are written through the processing pipeline.</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_fileMetadataRereadMessage))
                                {
                                    <div class="sme-file-panel-note" role="status">
                                        <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                                        <span>@_fileMetadataRereadMessage</span>
                                    </div>
                                }
                            </section>

                            @if (SupportsTextTracks && CurrentTextTrackAssetId.HasValue)
                            {
                                <section class="sme-file-status-panel">
                                    <div class="sme-file-panel-heading">
                                        <span>@TextTrackHeading</span>
                                        <AppButton Label="@TextTrackRefreshLabel"
                                                   StartIcon="@Icons.Material.Outlined.CloudDownload"
                                                   ButtonStyle="AppButtonStyle.Outlined"
                                                   Tone="AppUiTone.Primary"
                                                   Disabled="@(_textTracksLoading || _textTracksRefreshing)"
                                                   OnClick="RefreshTextTracksAsync" />
                                        <label class="sme-text-track-import" aria-disabled="@_textTrackImporting">
                                            <InputFile class="sme-text-track-import__input"
                                                       OnChange="ImportTextTrackAsync"
                                                       disabled="@_textTrackImporting"
                                                       accept="@(UsesLyrics ? ".lrc,.txt" : ".vtt,.srt,.ass")" />
                                            <MudIcon Icon="@Icons.Material.Outlined.UploadFile" Size="Size.Small" />
                                            <span>@(_textTrackImporting ? "Importing..." : "Import")</span>
                                        </label>
                                    </div>
                                    @if (_textTracksLoading)
                                    {
                                        <div class="sme-text-track-empty">Loading managed @TextTrackHeading.ToLowerInvariant()...</div>
                                    }
                                    else if (_textTracks.Count == 0)
                                    {
                                        <div class="sme-text-track-empty">
                                            No managed @TextTrackHeading.ToLowerInvariant() are available. Tuvima checks local sidecars first and preserves user-owned files when refreshing.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="sme-text-track-list" aria-label="Managed @TextTrackHeading.ToLowerInvariant()">
                                            @foreach (var track in _textTracks.OrderByDescending(item => item.IsPreferred).ThenByDescending(item => item.IsUserOwned).ThenBy(item => item.Language))
                                            {
                                                <div class="sme-text-track-row">
                                                    <span class="sme-text-track-language">@track.Language.ToUpperInvariant()</span>
                                                    <span>
                                                        <strong>@(track.IsUserOwned ? "Local file" : track.Provider)</strong>
                                                        <small>@track.NormalizedFormat.ToUpperInvariant() · @(track.IsPreferred ? "Preferred" : "Available")</small>
                                                    </span>
                                                    <span class="sme-text-track-actions">
                                                        @if (!track.IsPreferred)
                                                        {
                                                            <AppButton Label="@(_textTrackPreferencePendingId == track.Id ? "Selecting..." : "Use")"
                                                                       ButtonStyle="AppButtonStyle.Text"
                                                                       Tone="AppUiTone.Primary"
                                                                       Disabled="@_textTrackPreferencePendingId.HasValue"
                                                                       OnClick="@(() => SetPreferredTextTrackAsync(track.Id))" />
                                                        }
                                                        <a href="@track.Url" target="_blank" rel="noopener noreferrer" aria-label="Open text track">
                                                            <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" />
                                                        </a>
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_textTrackRefreshMessage))
                                    {
                                        <div class="sme-file-panel-note" role="status">
                                            <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                                            <span>@_textTrackRefreshMessage</span>
                                        </div>
                                    }
                                </section>
                            }

                            @if (_detail.PlaybackSummary is { } technical)
                            {
                                <section class="sme-file-status-panel">
                                    <div class="sme-file-panel-heading"><span>Technical details</span></div>
                                    <dl class="sme-file-fact-grid">
                                    @if (!string.IsNullOrWhiteSpace(PlaybackTechnicalSummaryDisplay.VideoChip(technical)))
                                    {
                                        <div><dt>Video</dt><dd>@PlaybackTechnicalSummaryDisplay.VideoChip(technical)</dd></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(PlaybackTechnicalSummaryDisplay.AudioChip(technical)))
                                    {
                                        <div><dt>Audio</dt><dd>@PlaybackTechnicalSummaryDisplay.AudioChip(technical)</dd></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(PlaybackTechnicalSummaryDisplay.SubtitleChip(technical)))
                                    {
                                        <div><dt>Subtitles</dt><dd>@PlaybackTechnicalSummaryDisplay.SubtitleChip(technical)</dd></div>
                                    }
                                    </dl>
                                </section>
                            }

                        }
                    </div>
                }
                else if (_activeTab == "history")
                {
                    <div class="sme-file-tab sme-history-tab">
                        <section class="sme-history-item-summary">
                            <span class="sme-history-summary-art @ArtworkShapeClass">
                                @if (!string.IsNullOrWhiteSpace(CurrentCoverUrl))
                                {
                                    <img src="@CurrentCoverUrl" alt="@HeaderTitle" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.Image" />
                                }
                            </span>
                                <span class="sme-history-summary-copy">
                                    <strong>@HeaderTitle</strong>
                                    <span class="sme-history-summary-facts">
                                        <span><small>Type</small>@HeaderKicker</span>
                                        <span><small>Library</small>Local Library</span>
                                        <span><small>Provider</small>Tuvima Library</span>
                                        <span><small>Provider ID</small>@CurrentProviderId</span>
                                        <span><small>Retail Provider</small>@BuildCurrentRetailMatchCard().Badge</span>
                                        <span><small>Status</small><span class="sme-file-health"><MudIcon Icon="@Icons.Material.Outlined.Circle" Size="Size.Small" /> @(_detail?.Status ?? "Identified")</span></span>
                                    </span>
                            </span>
                        </section>

                        <div class="sme-history-toolbar">
                            <AppSelect T="string"
                                       @bind-Value="_historyFilter"
                                       Options="@HistoryFilterOptions"
                                       Class="sme-history-filter" />
                        </div>

                        <section class="sme-history-timeline-panel" aria-label="Change history">
                            @if (FilteredHistory.Count == 0)
                            {
                                <div class="sme-empty-panel">
                                    <MudIcon Icon="@Icons.Material.Outlined.History" Class="tl-u-font-size-24px tl-u-opacity-0-18" />
                                    <span>No recent history is available.</span>
                                </div>
                            }
                            else
                            {
                                <div class="sme-history-list">
                                    @foreach (var group in FilteredHistory.GroupBy(entry => entry.OccurredAt.LocalDateTime.Date))
                                    {
                                        <div class="sme-history-day">
                                            <h4 class="sme-history-date">@FormatHistoryDate(group.Key)</h4>
                                            <div class="sme-history-day__events">
                                                @foreach (var entry in group)
                                                {
                                                    <div class="sme-history-row sme-history-row--timeline">
                                                        <span class="sme-history-time">
                                                            <strong>@entry.OccurredAt.LocalDateTime.ToString("t", CultureInfo.CurrentCulture)</strong>
                                                            <small>@FormatRelativeHistoryAge(entry.OccurredAt)</small>
                                                        </span>
                                                        <span class="sme-history-icon @GetHistoryToneClass(entry.Category)" aria-hidden="true"><MudIcon Icon="@GetHistoryIcon(entry.Category)" Size="Size.Small" /></span>
                                                        <div class="sme-history-event-card">
                                                            <div class="sme-history-copy">
                                                                <div class="sme-history-title">@entry.Label</div>
                                                                @if (!string.IsNullOrWhiteSpace(entry.Detail))
                                                                {
                                                                    <div class="sme-history-detail">@entry.Detail</div>
                                                                }
                                                            </div>
                                                            <span>by <strong>@entry.ActorLabel</strong></span>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                    </div>
                }
                    </div>
                </div>
            </div>
            }

            @if (ShouldShowEditorFooter && !Inline)
            {
            <div class="sme-footer">
                @if (_confirmDiscard)
                {
                    <div class="sme-discard-warning">Discard unsaved changes?</div>
                    <AppButton ButtonStyle="AppButtonStyle.Text"
                               Tone="AppUiTone.Neutral"
                               Class="sme-footer-btn sme-footer-btn--ghost"
                               OnClick="@(() => _confirmDiscard = false)">
                        Keep Editing
                    </AppButton>
                    <AppButton ButtonStyle="AppButtonStyle.Filled"
                               Tone="AppUiTone.Error"
                               Class="sme-footer-btn sme-footer-btn--danger"
                               OnClick="DiscardAndClose">
                        Discard
                    </AppButton>
                }
                else
                {
                    <div class="sme-footer-spacer"></div>
                    @if (_pendingMembershipPreview is not null)
                    {
                        <div class="sme-footer-note">@_pendingMembershipPreview.Message</div>
                        <AppButton ButtonStyle="AppButtonStyle.Text"
                                   Tone="AppUiTone.Neutral"
                                   Class="sme-footer-btn sme-footer-btn--ghost"
                                   OnClick="@(() => _pendingMembershipPreview = null)">
                            Keep Editing
                        </AppButton>
                        <AppButton ButtonStyle="AppButtonStyle.Filled"
                                   Tone="AppUiTone.Primary"
                                   Class="sme-footer-btn sme-footer-btn--primary"
                                   OnClick="ConfirmMembershipMoveAsync"
                                   Disabled="@_saving">
                            Save and Move
                        </AppButton>
                    }
                    else if (IsDirty)
                    {
                        <AppButton ButtonStyle="AppButtonStyle.Filled"
                                   Tone="AppUiTone.Primary"
                                   Class="sme-footer-btn sme-footer-btn--primary"
                                   OnClick="SaveAsync"
                                   Disabled="@_saving">
                            @if (_saving)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="tl-u-color-inherit tl-u-width-14px tl-u-height-14px" />
                            }
                            @GetDirtySaveLabel()
                        </AppButton>
                    }
                    else if (Request.Mode == SharedMediaEditorMode.Review)
                    {
                        <AppButton ButtonStyle="AppButtonStyle.Filled"
                                   Tone="AppUiTone.Primary"
                                   Class="sme-footer-btn sme-footer-btn--primary"
                                   OnClick="HandleReviewPrimaryActionAsync"
                                   Disabled="@_saving">
                            @(_saving ? "Resolving..." : GetResolveReviewLabel())
                        </AppButton>
                    }
                }
            </div>
            }
        </div>
</MediaEditorSurface>
