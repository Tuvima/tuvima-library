@namespace MediaEngine.Web.Components.MediaEditor
@implements IDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Forms
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Components.Library
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Components.Artwork
@using MediaEngine.Web.Components.MediaEditor.Sections

<NavigationLock ConfirmExternalNavigation="@HasPendingNavigationChanges"
                OnBeforeInternalNavigation="ConfirmNavigationWithUnsavedChanges" />

<MediaEditorSurface Inline="@Inline" HeroConstrained="@HeroConstrained">
        <div class="sme-shell @(HeroConstrained ? "sme-shell--hero" : string.Empty)">

                    <EditorHeaderSection
                        SmallEditorArtworkUrl="@((string? url) => SmallEditorArtworkUrl(url))"
                        EditorArtworkSrcSet="@((string? url) => EditorArtworkSrcSet(url))"
                        StaticHeaderProviderUrl="@((MediaEngine.Contracts.Metadata.MediaEditorIdentitySummaryDto identity) => StaticHeaderProviderUrl(identity))"
                        HeaderProviderDisplayName="@((string? provider) => HeaderProviderDisplayName(provider))"
                        HeaderProviderIcon="@((string? provider) => HeaderProviderIcon(provider))"
                        HeaderProviderLogoUrl="@((string? provider) => HeaderProviderLogoUrl(provider))"
                        SaveAsyncRequested="@(SaveAsync)"
                        HandleCloseRequested="@(HandleClose)"
                        ResetEditorChangesRequested="@(ResetEditorChanges)"
                        StaticHeaderTitle="@(StaticHeaderTitle)"
                        StaticHeaderSubtitle="@(StaticHeaderSubtitle)"
                        StaticHeaderArtworkShapeClass="@(StaticHeaderArtworkShapeClass)"
                        StaticHeaderCoverUrl="@(StaticHeaderCoverUrl)"
                        StaticHeaderArtworkSizes="@(StaticHeaderArtworkSizes)"
                        StaticHeaderKind="@(StaticHeaderKind)"
                        StaticHeaderYear="@(StaticHeaderYear)"
                        StaticHeaderRuntime="@(StaticHeaderRuntime)"
                        StaticHeaderIdentity="@(StaticHeaderIdentity)"
                        Inline="@(Inline)"
                        ActiveTab="@(_activeTab)"
                        IsSingleItem="@(IsSingleItem)"
                        IsBatchMode="@(IsBatchMode)"
                        HasStagedEditorChanges="@(HasStagedEditorChanges)"
                        EditorPageTitle="@(EditorPageTitle)"
                        EditorHeaderDescription="@(EditorHeaderDescription)"
                        HasParentGroupArtwork="@(HasParentGroupArtwork)"
                        ParentGroupArtwork="@(ParentGroupArtwork)"
                        Saving="@(_saving)"
                        PreviewItems="@(Request.PreviewItems)"
                        WikidataUrl="@(StaticHeaderIdentity?.WikidataQid is { } qid && !string.IsNullOrWhiteSpace(qid) ? ProviderCatalogue.GetExternalUrl("wikidata_qid", qid, EditorMediaType)?.Url : null)" />
                            @if (!IsSharedEntityMode && HasContextNavigator && EditorContextLevels.Count > 0)
            {
                <div class="sme-context-band">
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral"
                               Class="@(IsParentEditorTarget ? "sme-context-root is-active" : "sme-context-root")"
                               aria-current="@(IsParentEditorTarget ? "page" : null)"
                               Disabled="@_loading"
                               OnClick="@(() => SelectEditorContextTargetAsync(ContextRootEntityId))">
                        @if (!string.IsNullOrWhiteSpace(ContextRootArtworkUrl))
                        {
                            <img class="sme-context-root__artwork @(NavigatorRootNode?.NodeKind is "album" or "artist" ? "is-square" : "is-portrait")" src="@SmallEditorArtworkUrl(ContextRootArtworkUrl)" srcset="@EditorArtworkSrcSet(ContextRootArtworkUrl)" sizes="(max-width: 700px) 2rem, 2.8rem" alt="" loading="lazy" />
                        }
                        else
                        {
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Collections" Class="sme-context-root__icon" />
                        }
                        <span class="sme-context-root__copy">
                            <small>@ContextRootLabel</small>
                            <strong>@ContextRootTitle</strong>
                        </span>
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" Class="sme-context-root__chevron" />
                    </AppButton>
                    <EditorContextNavigator Levels="@EditorContextLevels"
                                            OnTargetSelected="SelectEditorContextTargetAsync"
                                            SearchOptionsAsync="SearchEditorContextOptionsAsync" />
                </div>
            }

            @if (Request.Mode == SharedMediaEditorMode.Review)
            {
                <div class="sme-review-banner">
                    <div class="sme-review-icon" aria-hidden="true">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PriorityHigh" Class="tl-u-font-size-22px" />
                    </div>
                    <div class="sme-review-copy">
                        <div class="sme-review-title">Needs review <span class="sme-review-text">- @_reviewSummary</span></div>
                    </div>
                </div>
            }


            @if (!string.IsNullOrWhiteSpace(_saveError))
            {
                <div class="sme-save-error" role="alert" tabindex="-1">
                    <AppMaterialIcon Icon="@(_saveConflict ? AppMaterialIcons.Outlined.SyncProblem : AppMaterialIcons.Outlined.ErrorOutline)" />
                    <div>
                        <strong>@(_saveConflict ? "New library changes are available" : "Changes were not saved")</strong>
                        <span>@_saveError</span>
                    </div>
                    @if (_saveConflict)
                    {
                        <AppButton ButtonStyle="AppButtonStyle.Outlined"
                                   Tone="AppUiTone.Neutral"
                                   OnClick="ReloadAfterSaveConflictAsync">
                            Reload values
                        </AppButton>
                    }
                </div>
            }

            @if (Inline && _confirmDiscard)
            {
                <div class="sme-inline-decision" role="alert">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.WarningAmber" />
                    <div>
                        <strong>Discard unsaved changes?</strong>
                        <span>Your edits will be lost and the unchanged detail page will return.</span>
                    </div>
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" OnClick="@(() => _confirmDiscard = false)">
                        Keep Editing
                    </AppButton>
                    <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Error" OnClick="DiscardAndClose">
                        Discard
                    </AppButton>
                </div>
            }

            @if (_navigationGuard.PendingLocation is not null)
            {
                <div class="sme-inline-decision sme-navigation-decision" role="alert">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.WarningAmber" />
                    <div>
                        <strong>Save changes before leaving?</strong>
                        <span>@(HasPendingNavigationChanges
                            ? "Choose what to do with your unsaved editor changes."
                            : "Your changes are saved or cleared. Continue to the requested page.")</span>
                    </div>
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" OnClick="StayOnEditorPage">
                        Stay here
                    </AppButton>
                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Error" OnClick="DiscardAndNavigate">
                        Discard and leave
                    </AppButton>
                    <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@_saving" OnClick="SaveAndNavigateAsync">
                        @(!HasPendingNavigationChanges ? "Continue" : _saving ? "Saving..." : "Save and leave")
                    </AppButton>
                </div>
            }

            @if (Inline && _pendingMembershipPreview is not null)
            {
                <div class="sme-inline-decision" role="status">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.AccountTree" />
                    <div>
                        <strong>@MembershipPreviewHeading</strong>
                        <span>@_pendingMembershipPreview.Message</span>
                        @if (MembershipPreviewCleanupNote is { } cleanupNote)
                        {
                            <small class="sme-membership-cleanup-note">@cleanupNote</small>
                        }
                    </div>
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" OnClick="@(() => _pendingMembershipPreview = null)">
                        Keep Editing
                    </AppButton>
                    <AppButton ButtonStyle="AppButtonStyle.Filled"
                               Tone="AppUiTone.Primary"
                               Disabled="@_saving"
                               OnClick="ConfirmMembershipMoveAsync">
                        @MembershipPreviewActionLabel
                    </AppButton>
                </div>
            }

            @if (HasPendingTargetSwitch)
            {
                <div class="sme-inline-decision sme-target-switch-decision" role="alert">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.WarningAmber" />
                    <div>
                        <strong>Save changes before editing @PendingTargetSwitchTitle?</strong>
                        <span>Choose what to do with the changes on @CurrentTargetTitle.</span>
                    </div>
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" OnClick="KeepEditingCurrentTarget">
                        Stay here
                    </AppButton>
                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Error" OnClick="DiscardAndSwitchTargetAsync">
                        Discard and switch
                    </AppButton>
                    <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@_saving" OnClick="SaveAndSwitchTargetAsync">
                        @(_saving ? "Saving..." : "Save and switch")
                    </AppButton>
                </div>
            }

            @if (IsSharedEntityMode)
            {
                <SharedEntityEditorWorkspace @ref="_sharedEntityWorkspace"
                                             InitialTarget="@(Request.SharedEntityTarget!)"
                                             DirtyChanged="OnSharedEntityDirtyChanged"
                                             ContextChanged="OnSharedEntityContextChanged"
                                             Committed="OnSharedEntityCommittedAsync" />
            }
            else
            {
            <div class="sme-workspace">
                <nav class="sme-section-nav" aria-label="Editor sections">
                    @for (var index = 0; index < Tabs.Count; index++)
                    {
                        var tabIndex = index;
                        var tab = Tabs[index];
                        <AppButton ButtonStyle="AppButtonStyle.Text"
                                   Tone="AppUiTone.Neutral"
                                   Class="@GetSectionNavClass(tab.Id)"
                                   aria-current="@(string.Equals(tab.Id, _activeTab, StringComparison.OrdinalIgnoreCase) ? "page" : null)"
                                   Disabled="@IsTabDisabled(tab.Id)"
                                   OnClick="@(() => OnTabChanged(tabIndex))">
                            <AppMaterialIcon Icon="@tab.Icon" Size="AppSize.Small" />
                            <span>@tab.Label</span>
                        </AppButton>
                    }

                    @if (IsSingleItem && _activeTab != "details")
                    {
                        <div class="sme-section-nav__footer">
                            <AppTooltip Text="@WritebackPolicyExplanation">
                                <div class="sme-writeback-policy" role="status" aria-label="@WritebackPolicyExplanation">
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Info" Size="AppSize.Small" />
                                    <span>Write-back @WritebackPolicyLabel</span>
                                </div>
                            </AppTooltip>
                        </div>
                    }

                </nav>
                <div class="sme-main-pane">
                    <div class="sme-body">
                @if (_loading)
                {
                    <div class="sme-loading">
                        <AppSpinner Indeterminate="true" Size="AppSize.Medium" />
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_loadError))
                {
                    <div class="sme-empty-panel">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CloudOff" Class="tl-u-font-size-24px tl-u-opacity-0-18" />
                        <span>@_loadError</span>
                    </div>
                }
                else if (_activeTab == "details")
                {
                    <EditorDetailsSection
                        IsDetailsInlineEditing="@((string key) => IsDetailsInlineEditing(key))"
                        DetailsInlineValue="@((string key) => DetailsInlineValue(key))"
                        BeginEmptyDetailsTagsAsyncRequested="@(BeginEmptyDetailsTagsAsync)"
                        NavigateToDetailsLinkAsyncRequested="@(NavigateToDetailsLinkAsync)"
                        NavigateToDetailsFieldSourceAsyncRequested="@(NavigateToDetailsFieldSourceAsync)"
                        BeginDetailsInlineEditAsyncRequested="@(BeginDetailsInlineEditAsync)"
                        UpdateDetailsInlineDraftAsyncRequested="@(UpdateDetailsInlineDraftAsync)"
                        CancelDetailsInlineEditAsyncRequested="@(CancelDetailsInlineEditAsync)"
                        SaveDetailsInlineFieldAsyncRequested="@(SaveDetailsInlineFieldAsync)"
                        RevertDetailsInlineFieldAsyncRequested="@(RevertDetailsInlineFieldAsync)"
                        GetGroupsForTab="@((string tabId) => GetGroupsForTab(tabId))"
                        GetPlaceholder="@((MediaEngine.Web.Services.Editing.MediaEditorFieldDefinition field) => GetPlaceholder(field))"
                        GetFieldLineCount="@((MediaEngine.Web.Services.Editing.MediaEditorFieldDefinition field) => GetFieldLineCount(field))"
                        GetEditableValue="@((string key) => GetEditableValue(key))"
                        OnFieldInputRequested="@(((string, string?) value) => OnFieldInput(value.Item1, value.Item2))"
                        FormatRelativeHistoryAge="@((DateTimeOffset occurredAt) => FormatRelativeHistoryAge(occurredAt))"
                        GetHistoryPresentation="@((string? eventType, string? category) => GetHistoryPresentation(eventType, category))"
                        HasPendingDetailsInlineEdit="@(HasPendingDetailsInlineEdit)"
                        EmptyDetailsTagsField="@(EmptyDetailsTagsField)"
                        DetailsInlineError="@(DetailsInlineError)"
                        DetailsWritebackStatusText="@(DetailsWritebackStatusText)"
                        DetailsWritebackExplanation="@(DetailsWritebackExplanation)"
                        DetailsHeading="@(DetailsHeading)"
                        DetailsSecondaryFields="@(DetailsSecondaryFields)"
                        DetailsAdditionalFields="@(DetailsAdditionalFields)"
                        DetailsSynopsis="@(DetailsSynopsis)"
                        DetailsImageShape="@(DetailsImageShape)"
                        DetailsImageWidthClass="@(DetailsImageWidthClass)"
                        DetailsLibrarySummary="@(DetailsLibrarySummary)"
                        DetailsFiles="@(DetailsFiles)"
                        DetailsOwnedArtworkCount="@(DetailsOwnedArtworkCount)"
                        DetailsTechnicalFacts="@(DetailsTechnicalFacts)"
                        DetailsRecentActivity="@(DetailsRecentActivity)"
                        DetailsMetadataWritebackState="@(DetailsMetadataWritebackState)"
                        CanAddDetailsTags="@(CanAddDetailsTags)"
                        DetailsImageUrl="@(DetailsImageUrl)"
                        DetailsImageSrcSet="@(DetailsImageSrcSet)"
                        DetailsImageSizes="@(DetailsImageSizes)"
                        EditorMediaType="@(EditorMediaType)"
                        IsSingleItem="@(IsSingleItem)"
                        CurrentTargetTitle="@(CurrentTargetTitle)"
                        DetailsInlineSaving="@(_detailsInlineSaving)"
                        HistoryError="@(_historyError)"
                        HasActiveScope="@(ActiveScope is not null)"
                        ScopeEntityId="@(ActiveScope?.FieldEntityId)"
                        ScopeId="@(ActiveScope?.ScopeId)"
                        ScopeLabel="@(ActiveScope?.Label)" />
                }
                else if (_activeTab == "chapters"
                         && string.Equals(EditorMediaType, "Audiobooks", StringComparison.OrdinalIgnoreCase)
                         && !string.Equals(ActiveScope?.ScopeId, "series", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="sme-chapters-tab">
                        <section class="sme-content-media-summary">
                            <span class="sme-content-media-summary__art">
                                @if (!string.IsNullOrWhiteSpace(CurrentCoverUrl))
                                {
                                    <img src="@SmallEditorArtworkUrl(CurrentCoverUrl)" srcset="@EditorArtworkSrcSet(CurrentCoverUrl)" sizes="64px" alt="@HeaderTitle" />
                                }
                                else
                                {
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Headphones" />
                                }
                            </span>
                            <span class="sme-content-media-summary__copy">
                                <span><strong>@HeaderTitle</strong><AppChip Text="Audiobook" Tone="AppUiTone.Primary" /></span>
                                @if (!string.IsNullOrWhiteSpace(HeaderSubtitle))
                                {
                                <small>@NormalizeDisplaySpacing(HeaderSubtitle)</small>
                                }
                                <span class="sme-content-media-summary__facts">
                                    <span><small>Tracks</small><strong>@AudiobookChapters.Count</strong></span>
                                    <span><small>Length</small><strong>@GetContentTotalDurationLabel()</strong></span>
                                    <span><small>Release</small><strong>@(_detail?.Year ?? "Unknown")</strong></span>
                                    <span><small>Language</small><strong>@(_detail?.Language ?? "Unknown")</strong></span>
                                </span>
                            </span>
                        </section>

                            @if (AudiobookChapters.Count == 0)
                            {
                                <div class="sme-empty-panel">
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FormatListNumbered" Class="tl-u-font-size-24px tl-u-opacity-0-18" />
                                    <span>No embedded tracks are available for this audiobook.</span>
                                </div>
                            }
                            else
                            {
                                <div class="sme-chapter-workspace">
                                    <section class="sme-chapter-table-panel">
                                        <div class="sme-chapter-section-heading">
                                            <strong>@AudiobookChapters.Count tracks</strong>
                                        </div>
                                        <div class="sme-chapter-table-header"><span>#</span><span>Track title</span><span>Time range</span><span>Source</span></div>
                                        <div class="sme-audiobook-chapter-list">
                                            @foreach (var chapter in AudiobookChapters)
                                            {
                                                var chapterKey = BuildAudiobookChapterKey(chapter);
                                                <AppNativeButton Type="button"
                                                                 Class="@($"sme-audiobook-chapter {(IsFocusedAudiobookChapter(chapter) ? "is-editing" : string.Empty)}")"
                                                                 OnClick="@(() => ToggleAudiobookChapterEditor(chapter))">
                                                    <span class="sme-audiobook-chapter__number">@((chapter.ChapterIndex ?? 0) + 1)</span>
                                                    <strong>@GetAudiobookChapterTitle(chapter)</strong>
                                                    <span>@FormatAudiobookChapterRange(chapter)</span>
                                                    <span class="@(HasAudiobookChapterOverride(chapter) || _audiobookChapterEdits.ContainsKey(chapterKey) ? "is-override" : null)">
                                                        @(HasAudiobookChapterOverride(chapter) || _audiobookChapterEdits.ContainsKey(chapterKey) ? "Override" : "Embedded")
                                                    </span>
                                                </AppNativeButton>
                                            }
                                        </div>
                                    </section>

                                    @if (FocusedAudiobookChapter is { } focusedChapter)
                                    {
                                        <aside class="sme-chapter-editor-panel">
                                            <div class="sme-chapter-editor-heading">
                                                <div><strong>Edit track</strong><small>Track @((focusedChapter.ChapterIndex ?? 0) + 1)</small></div>
                                                @if (HasAudiobookChapterOverride(focusedChapter) || _audiobookChapterEdits.ContainsKey(BuildAudiobookChapterKey(focusedChapter)))
                                                {
                                                    <AppButton Label="Restore original"
                                                               StartIcon="@AppMaterialIcons.Outlined.Restore"
                                                               OnClick="@(() => QueueAudiobookChapterReset(focusedChapter))" />
                                                }
                                            </div>
                                            <label>Track title</label>
                                            <AppTextField T="string"
                                                          Value="@GetAudiobookChapterTitle(focusedChapter)"
                                                          ValueChanged="@((string? value) => OnAudiobookChapterTitleInput(focusedChapter, value))"
                                                          Variant="AppVariant.Outlined"
                                                          Margin="AppMargin.Dense"
                                                          Immediate="true" />
                                            <div class="sme-chapter-time-grid">
                                                <span><label>Start time</label><strong>@FormatAudiobookChapterTime(focusedChapter.StartSeconds)</strong></span>
                                                <span><label>End time</label><strong>@FormatAudiobookChapterTime(focusedChapter.EndSeconds)</strong></span>
                                                <span class="is-wide"><label>Duration</label><strong>@FormatAudiobookChapterDuration(focusedChapter)</strong></span>
                                            </div>
                                            <label>Source</label>
                                            <div class="sme-chapter-readonly-value">@(HasAudiobookChapterOverride(focusedChapter) ? "Override" : "Embedded")</div>
                                            <div class="sme-chapter-source-note">
                                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Description" />
                                                <span>This track boundary is embedded in the audiobook file. Timing remains read-only.</span>
                                            </div>
                                        </aside>
                                    }
                                </div>
                            }
                    </div>
                }
                else if (_activeTab == "links")
                {
                    @if (_movieTvSuggestion is { } tvSuggestion)
                    {
                        <div class="sme-movie-tv-suggestion">
                            <MovieAsTvSuggestionCard Suggestion="@tvSuggestion"
                                                     ShowSearchAgain="false"
                                                     Busy="@(_saving || _movieTvBusy)"
                                                     OnMoveToTv="MoveReviewToTvAsync"
                                                     OnKeepAsFilm="KeepReviewAsFilmAsync" />
                        </div>
                    }
                    <EditorMatchSection
                        SmallEditorArtworkUrl="@((string? url) => SmallEditorArtworkUrl(url))"
                        EditorArtworkSrcSet="@((string? url) => EditorArtworkSrcSet(url))"
                        SetTvdbLocalFilterRequested="@(SetTvdbLocalFilter)"
                        GetRetailCandidateArtworkShape="@((MediaEngine.Contracts.Matching.ItemCanonicalRetailCandidateDto candidate) => GetRetailCandidateArtworkShape(candidate))"
                        CanonicalConfidencePercentage="@((MediaEngine.Contracts.Matching.ItemCanonicalLinkedCandidateDto candidate) => CanonicalConfidencePercentage(candidate))"
                        EditCanonicalIdentityOwnerAsyncRequested="@(EditCanonicalIdentityOwnerAsync)"
                        GetGroupsForTab="@((string tabId) => GetGroupsForTab(tabId))"
                        GetPlaceholder="@((MediaEngine.Web.Services.Editing.MediaEditorFieldDefinition field) => GetPlaceholder(field))"
                        GetEditableValue="@((string key) => GetEditableValue(key))"
                        OnFieldInputRequested="@(((string, string?) value) => OnFieldInput(value.Item1, value.Item2))"
                        SearchCanonicalAsyncRequested="@(SearchCanonicalAsync)"
                        BuildRetailCandidateSubtitle="@((MediaEngine.Contracts.Matching.ItemCanonicalRetailCandidateDto candidate) => BuildRetailCandidateSubtitle(candidate))"
                        GetRetailCandidateArtworkUrl="@((MediaEngine.Contracts.Matching.ItemCanonicalRetailCandidateDto candidate) => GetRetailCandidateArtworkUrl(candidate))"
                        BuildWikidataCandidateSubtitle="@((MediaEngine.Contracts.Matching.ItemCanonicalLinkedCandidateDto candidate) => BuildWikidataCandidateSubtitle(candidate))"
                        BuildCurrentRetailMatchCard="@(() => BuildCurrentRetailMatchCard())"
                        BuildCurrentWikidataMatchCard="@(() => BuildCurrentWikidataMatchCard())"
                        BuildWikidataIdentityLinks="@((string? qid) => BuildWikidataIdentityLinks(qid))"
                        GetRetailCandidateScore="@((MediaEngine.Contracts.Matching.ItemCanonicalRetailCandidateDto candidate) => GetRetailCandidateScore(candidate))"
                        FormatCandidateScore="@((double score) => FormatCandidateScore(score))"
                        BuildCanonicalComparisonRows="@((MediaEngine.Contracts.Matching.ItemCanonicalLinkedCandidateDto candidate) => BuildCanonicalComparisonRows(candidate))"
                        BuildRetailComparisonRows="@((MediaEngine.Contracts.Matching.ItemCanonicalRetailCandidateDto candidate) => BuildRetailComparisonRows(candidate))"
                        GetRetailCandidateEvidenceNotice="@((MediaEngine.Contracts.Matching.ItemCanonicalRetailCandidateDto candidate) => GetRetailCandidateEvidenceNotice(candidate))"
                        SelectCandidateAsyncRequested="@(SelectCandidateAsync)"
                        SelectCandidateRequested="@(SelectCandidate)"
                        CancelMatchDraftRequested="@(CancelMatchDraft)"
                        CanApplyRetailCandidate="@((MediaEngine.Contracts.Matching.ItemCanonicalRetailCandidateDto candidate) => CanApplyRetailCandidate(candidate))"
                        MusicTrackMovePrerequisite="@((MediaEngine.Contracts.Matching.ItemCanonicalRetailCandidateDto candidate) => MusicTrackMovePrerequisite(candidate))"
                        PreviewMusicTrackMoveAsyncRequested="@(PreviewMusicTrackMoveAsync)"
                        SaveMusicTrackMoveAsyncRequested="@(SaveMusicTrackMoveAsync)"
                        GetRetailHierarchyImpactPreview="@((MediaEngine.Contracts.Matching.ItemCanonicalRetailCandidateDto candidate) => GetRetailHierarchyImpactPreview(candidate))"
                        GetRetailHierarchyPreviewStatus="@((MediaEngine.Contracts.Matching.ItemCanonicalRetailCandidateDto candidate) => GetRetailHierarchyPreviewStatus(candidate))"
                        CanApplyLinkedCandidate="@((MediaEngine.Contracts.Matching.ItemCanonicalLinkedCandidateDto candidate) => CanApplyLinkedCandidate(candidate))"
                        SelectMatchSearchModeRequested="@(SelectMatchSearchMode)"
                        ComparisonVerdictClass="@((MediaEngine.Web.Components.MediaEditor.CandidateComparisonRow row) => ComparisonVerdictClass(row))"
                        ComparisonVerdictLabel="@((MediaEngine.Web.Components.MediaEditor.CandidateComparisonRow row) => ComparisonVerdictLabel(row))"
                        SetActiveMatchSearchQueryRequested="@(SetActiveMatchSearchQuery)"
                        CancelActiveMatchSearchRequested="@(CancelActiveMatchSearch)"
                        FormatCandidateDuration="@((System.Nullable<double> seconds) => FormatCandidateDuration(seconds))"
                        BuildRetailCandidateFacts="@((MediaEngine.Contracts.Matching.ItemCanonicalRetailCandidateDto candidate) => BuildRetailCandidateFacts(candidate))"
                        IsCandidateSelected="@((string candidateId) => IsCandidateSelected(candidateId))"
                        ApplyRetailCandidateAsyncRequested="@(ApplyRetailCandidateAsync)"
                        CanSelectRetailCatalogChild="@((MediaEngine.Contracts.Matching.ItemCanonicalRetailCandidateDto candidate, MediaEngine.Contracts.Search.RetailCandidateDetailDto detail) => CanSelectRetailCatalogChild(candidate, detail))"
                        ApplyRetailCatalogChildAsyncRequested="@(((MediaEngine.Contracts.Matching.ItemCanonicalRetailCandidateDto, MediaEngine.Contracts.Search.RetailCandidateDetailItemDto) value) => ApplyRetailCatalogChildAsync(value.Item1, value.Item2))"
                        ApplyLinkedCandidateAsyncRequested="@(ApplyLinkedCandidateAsync)"
                        MarkWikidataMissingAsyncRequested="@(MarkWikidataMissingAsync)"
                        ClearWikidataMatchAsyncRequested="@(ClearWikidataMatchAsync)"
                        GetCandidateId="@((MediaEngine.Contracts.Matching.ItemCanonicalLinkedCandidateDto candidate) => GetCandidateId(candidate))"
                        NormalizeContributorDisplay="@((string? value) => NormalizeContributorDisplay(value))"
                        NormalizeDisplaySpacing="@((string? value) => NormalizeDisplaySpacing(value))"
                        BeginTvdbCrossShowSearchRequested="@(BeginTvdbCrossShowSearch)"
                        ReturnToTvdbScopedSearchRequested="@(ReturnToTvdbScopedSearch)"
                        TvdbCandidateDisplayTitle="@((MediaEngine.Contracts.Metadata.TvdbMatchCandidateDto candidate) => TvdbCandidateDisplayTitle(candidate))"
                        SearchTvdbScopedMatchesAsyncRequested="@(SearchTvdbScopedMatchesAsync)"
                        SelectTvdbCandidateRequested="@(SelectTvdbCandidate)"
                        ApplyTvdbScopedMatchAsyncRequested="@(ApplyTvdbScopedMatchAsync)"
                        SelectedRetailMatchCandidate="@(SelectedRetailMatchCandidate)"
                        SelectedCanonicalMatchCandidate="@(SelectedCanonicalMatchCandidate)"
                        FilteredTvdbPresentationCandidates="@(FilteredTvdbPresentationCandidates)"
                        EditorMediaType="@(EditorMediaType)"
                        SupportsCanonicalSearch="@(SupportsCanonicalSearch)"
                        SupportsRetailSearch="@(SupportsRetailSearch)"
                        RequiresWikidataOnlySearch="@(RequiresWikidataOnlySearch)"
                        CurrentMatchOptional="@(CurrentMatchOptional)"
                        ParentMatchContext="@(ParentMatchContext)"
                        CanEditCanonicalIdentity="@(CanEditCanonicalIdentity)"
                        HasInheritedCanonicalIdentity="@(HasInheritedCanonicalIdentity)"
                        CanonicalIdentityOwnerScope="@(CanonicalIdentityOwnerScope)"
                        MatchComparisonLocalColumn="@(MatchComparisonLocalColumn)"
                        MatchComparisonCandidateColumn="@(MatchComparisonCandidateColumn)"
                        ActiveMatchSearchResponse="@(ActiveMatchSearchResponse)"
                        ActiveMatchSearchQuery="@(ActiveMatchSearchQuery)"
                        IsActiveMatchSearchPending="@(IsActiveMatchSearchPending)"
                        CanonicalSearchUnavailableReason="@(CanonicalSearchUnavailableReason)"
                        IsSingleItem="@(IsSingleItem)"
                        IsDirty="@(IsDirty)"
                        IsWikidataSearchMode="@(IsWikidataSearchMode)"
                        CurrentProviderId="@(CurrentProviderId)"
                        CurrentCanonicalQid="@(CurrentCanonicalQid)"
                        HasCurrentRetailMatch="@(HasCurrentRetailMatch)"
                        HasCurrentCanonicalIdentity="@(HasCurrentCanonicalIdentity)"
                        IsMusicTrackMoveTarget="@(IsMusicTrackMoveTarget)"
                        ArtworkShapeClass="@(ArtworkShapeClass)"
                        IsTvdbScopedMatching="@(IsTvdbScopedMatching)"
                        CanSelectTvdbCandidates="@(CanSelectTvdbCandidates)"
                        TvdbLocalFilter="@(_tvdbLocalFilter)"
                        RetailCandidateDetail="@(_retailCandidateDetail)"
                        RetailMovePreview="@(_retailMovePreview)"
                        PendingRetailMoveCandidate="@(_pendingRetailMoveCandidate)"
                        MusicTrackMovePreview="@(_musicTrackMovePreview)"
                        MusicTrackMoveChoiceId="@(_musicTrackMoveChoiceId)"
                        MusicTrackMoveError="@(_musicTrackMoveError)"
                        MusicTrackMoveBusy="@(_musicTrackMoveBusy)"
                        MovedItemNotice="@(_movedItemNotice)"
                        MovedItemDestinationId="@(_movedItemDestinationId)"
                        MatchActionPending="@(_matchActionPending)"
                        MatchActionStatus="@(_matchActionStatus)"
                        TvdbCandidates="@(_tvdbCandidates)"
                        SelectedTvdbCandidate="@(_selectedTvdbCandidate)"
                        TvdbSearchPending="@(_tvdbSearchPending)"
                        TvdbSearchError="@(_tvdbSearchError)"
                        TvdbApplyPending="@(_tvdbApplyPending)"
                        TvdbCrossShowSearch="@(_tvdbCrossShowSearch)"
                        ScopeId="@(ActiveScope?.ScopeId)"
                        ToAbsoluteEngineUrl="@(ApiClient.ToAbsoluteEngineUrl)"
                        CancelParentMove="@(() => { _retailMovePreview = null; _pendingRetailMoveCandidate = null; })"
                        CancelTvdbSelection="@(() => _selectedTvdbCandidate = null)"
                        SelectMusicTrackMoveChoice="@((string value) => _musicTrackMoveChoiceId = value)"
                        GetRetailCandidateId="@((MediaEngine.Contracts.Matching.ItemCanonicalRetailCandidateDto candidate) => GetCandidateId(candidate))" />
                    @if (CoverageAssetId is { } coverageAssetId)
                    {
                        <MediaEditorFileCoveragePicker EntityId="@(CurrentEntityId)" AssetId="@(coverageAssetId)" />
                    }
                }
                else if (_activeTab == "artwork")
                {
                    <EditorArtworkSection
                        UnifiedArtworkChangedAsyncRequested="@(UnifiedArtworkChangedAsync)"
                        OnUnifiedArtworkPendingChangedRequested="@(OnUnifiedArtworkPendingChanged)"
                        RestoreAutomaticArtworkAsyncRequested="@(RestoreAutomaticArtworkAsync)"
                        SelectArtworkScopeAsyncRequested="@(SelectArtworkScopeAsync)"
                        HandleArtworkSelectedAsyncRequested="@(((string, Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs) value) => HandleArtworkSelectedAsync(value.Item1, value.Item2))"
                        ClearArtworkSelectionRequested="@(ClearArtworkSelection)"
                        HasPendingArtwork="@((string assetType) => HasPendingArtwork(assetType))"
                        GetPendingArtworkFileName="@((string assetType) => GetPendingArtworkFileName(assetType))"
                        GetArtworkUploadError="@((string assetType) => GetArtworkUploadError(assetType))"
                        HasArtworkUploadError="@((string assetType) => HasArtworkUploadError(assetType))"
                        GetArtworkCardSource="@((MediaEngine.Web.Components.MediaEditor.ArtworkVariantDisplayItem item) => GetArtworkCardSource(item))"
                        GetArtworkImageSize="@((MediaEngine.Web.Components.MediaEditor.ArtworkVariantDisplayItem? item) => GetArtworkImageSize(item))"
                        GetArtworkPreviewClass="@((MediaEngine.Web.Components.MediaEditor.ArtworkSlotDefinition slot, MediaEngine.Web.Components.MediaEditor.ArtworkVariantDisplayItem? item) => GetArtworkPreviewClass(slot, item))"
                        GetArtworkGuidance="@((MediaEngine.Web.Components.MediaEditor.ArtworkSlotDefinition slot) => GetArtworkGuidance(slot))"
                        GetArtworkAcceptedTypes="@((string assetType) => GetArtworkAcceptedTypes(assetType))"
                        SetArtworkDragTargetRequested="@(SetArtworkDragTarget)"
                        ClearArtworkDragTargetRequested="@(ClearArtworkDragTarget)"
                        IsArtworkDragTarget="@((string assetType) => IsArtworkDragTarget(assetType))"
                        GetArtworkThumbnailUrl="@((MediaEngine.Web.Components.MediaEditor.ArtworkVariantDisplayItem item) => GetArtworkThumbnailUrl(item))"
                        GetArtworkThumbnailSrcSet="@((MediaEngine.Web.Components.MediaEditor.ArtworkVariantDisplayItem item) => GetArtworkThumbnailSrcSet(item))"
                        GetArtworkRowItems="@((string assetType) => GetArtworkRowItems(assetType))"
                        IsArtworkDeleteConfirming="@((MediaEngine.Web.Components.MediaEditor.ArtworkVariantDisplayItem item) => IsArtworkDeleteConfirming(item))"
                        DeleteArtworkVariantWithConfirmationAsyncRequested="@(DeleteArtworkVariantWithConfirmationAsync)"
                        CancelArtworkDeleteRequested="@(CancelArtworkDelete)"
                        ConfirmArtworkDeleteAsyncRequested="@(ConfirmArtworkDeleteAsync)"
                        RetryArtworkUploadAsyncRequested="@(RetryArtworkUploadAsync)"
                        ApplyArtworkUrlAsyncRequested="@(ApplyArtworkUrlAsync)"
                        RefreshProviderArtworkAsyncRequested="@(RefreshProviderArtworkAsync)"
                        ToggleArtworkUrlInputRequested="@(ToggleArtworkUrlInput)"
                        HandleArtworkVariantClickAsyncRequested="@(((MediaEngine.Web.Components.MediaEditor.ArtworkSlotDefinition, MediaEngine.Web.Components.MediaEditor.ArtworkVariantDisplayItem) value) => HandleArtworkVariantClickAsync(value.Item1, value.Item2))"
                        SaveReviewedEditionCoverAsyncRequested="@(SaveReviewedEditionCoverAsync)"
                        OpenArtworkFullSizeAsyncRequested="@(OpenArtworkFullSizeAsync)"
                        BuildArtworkVariantHoverLabel="@((MediaEngine.Web.Components.MediaEditor.ArtworkSlotDefinition slot, MediaEngine.Web.Components.MediaEditor.ArtworkVariantDisplayItem item) => BuildArtworkVariantHoverLabel(slot, item))"
                        GetArtworkRemovalLabel="@((MediaEngine.Web.Components.MediaEditor.ArtworkVariantDisplayItem item) => GetArtworkRemovalLabel(item))"
                        GetArtworkRemovalQuestion="@((MediaEngine.Web.Components.MediaEditor.ArtworkVariantDisplayItem item) => GetArtworkRemovalQuestion(item))"
                        GetArtworkRemovalConfirmLabel="@((MediaEngine.Web.Components.MediaEditor.ArtworkVariantDisplayItem item) => GetArtworkRemovalConfirmLabel(item))"
                        GetArtworkReadOnlyTitle="@(() => GetArtworkReadOnlyTitle())"
                        GetArtworkReadOnlyText="@(() => GetArtworkReadOnlyText())"
                        GetArtworkReadOnlySwitchTargets="@(() => GetArtworkReadOnlySwitchTargets())"
                        ArtworkSlots="@(ArtworkSlots)"
                        IsSingleItem="@(IsSingleItem)"
                        EditorContextEntityId="@(EditorContextEntityId)"
                        IsArtworkBusy="@(IsArtworkBusy)"
                        SelectedArtworkSlot="@(SelectedArtworkSlot)"
                        LeadArtworkVariant="@(LeadArtworkVariant)"
                        EditionCoverReview="@(EditionCoverReview)"
                        UsesEditionCoverWorkflow="@(UsesEditionCoverWorkflow)"
                        EditionCoverOwnerLabel="@(EditionCoverOwnerLabel)"
                        CurrentTargetTitle="@(CurrentTargetTitle)"
                        UnifiedArtworkItem="@(UnifiedArtworkItem)"
                        HasAutomaticGroupArtwork="@(HasAutomaticGroupArtwork)"
                        AutomaticGroupArtwork="@(AutomaticGroupArtwork)"
                        ArtworkUrlInput="@(_artworkUrlInput)"
                        EditionCoverSaving="@(_editionCoverSaving)"
                        ArtworkUrlSubmitting="@(_artworkUrlSubmitting)"
                        ProviderArtworkRefreshing="@(_providerArtworkRefreshing)"
                        ShowArtworkUrlInput="@(_showArtworkUrlInput)"
                        ScopeId="@(ActiveScope?.ScopeId)"
                        ActiveProfileId="@(Request.ActiveProfileId)"
                        CanRefreshArtwork="@(CanRefreshProviderArtwork(ArtworkScope))"
                        ArtworkUrlInputChanged="@((string? value) => _artworkUrlInput = value ?? string.Empty)"
                        WorkspaceRendered="@((ArtworkWorkspace value) => _unifiedArtworkWorkspace = value)" />
                }
                else if (_activeTab == "options")
                {
                    var groups = GetAdditionalOptionsGroups().ToList();
                    <div class="sme-fields-pane sme-fields-pane--single">
                        <MediaEditorLocalOptions GenreValue="@GetEditableValue("genre")"
                                                 GenreValueChanged="@((string? value) => OnFieldInput("genre", value))"
                                                 TagValue="@GetEditableValue("custom_tags")"
                                                 TagValueChanged="@((string? value) => OnFieldInput("custom_tags", value))"
                                                 RatingValue="@GetEditableValue("rating")"
                                                 RatingValueChanged="@((string? value) => OnFieldInput("rating", value))" />

                        @if (groups.Count == 0)
                        {
                            <div class="sme-options-note">Additional item options will appear here when available.</div>
                        }
                        else
                        {
                            @foreach (var group in groups)
                            {
                                <section class="sme-group">
                                    <div class="sme-group-title">@group.Label</div>
                                    @foreach (var field in group.Fields)
                                    {
                                        <div class="sme-field-row">
                                            <label class="sme-field-label">@field.Label</label>
                                            <div class="sme-field-control">
                                                @if (field.InputKind == "textarea")
                                                {
                                                    <AppTextField T="string"
                                                                  Value="@GetEditableValue(field.Key)"
                                                                  ValueChanged="@((string? value) => OnFieldInput(field.Key, value))"
                                                                  Placeholder="@GetPlaceholder(field)"
                                                                  Variant="AppVariant.Outlined"
                                                                  Margin="AppMargin.Dense"
                                                                  Immediate="true"
                                                                  Lines="4"
                                                                  Class="sme-textarea" />
                                                }
                                                else
                                                {
                                                    <AppTextField T="string"
                                                                  Value="@GetEditableValue(field.Key)"
                                                                  ValueChanged="@((string? value) => OnFieldInput(field.Key, value))"
                                                                  Placeholder="@GetPlaceholder(field)"
                                                                  Variant="AppVariant.Outlined"
                                                                  Margin="AppMargin.Dense"
                                                                  Immediate="true"
                                                                  Class="sme-text-input" />
                                                }
                                            </div>
                                        </div>
                                    }
                                </section>
                            }
                        }
                    </div>
                }
                else if (_activeTab == "retired-file")
                {
                    <div class="sme-file-tab">
                        @if (IsContainerEditor)
                        {
                            <MediaEditorPanel Title="Attached files" Description="A reconciliation summary across the owned children in this container.">
                                <div class="sme-container-file-summary">
                                    <div><strong>@ContainerAttachedFileCount</strong><span>Attached</span></div>
                                    <div><strong>@ContainerMissingFileCount</strong><span>Missing</span></div>
                                    <div><strong>@ContainerQuarantineCount</strong><span>Unassigned or quarantined</span></div>
                                </div>
                                @if (ContainerTechnicalBadges.Count > 0)
                                {
                                    <div class="sme-container-file-badges" aria-label="File quality and format summary">
                                        @foreach (var badge in ContainerTechnicalBadges)
                                        {
                                            <span>@badge.Label <strong>@badge.Count</strong></span>
                                        }
                                    </div>
                                }
                                <div class="sme-source-managed-note">
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Info" Size="AppSize.Small" />
                                    <span>Open a file entry to inspect its filename, path, and technical details.</span>
                                </div>
                            </MediaEditorPanel>
                        }
                        else if (!IsSingleItem || _detail is null)
                        {
                            <div class="sme-empty-panel">
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.InsertDriveFile" Class="tl-u-font-size-24px tl-u-opacity-0-18" />
                                <span>File inspection is available for a single item.</span>
                            </div>
                        }
                        else
                        {
                            <section class="sme-file-item-summary">
                                <span class="sme-file-format-icon">
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Description" />
                                    <small>@GetFileFormat(_detail.FileName)</small>
                                </span>
                                <span>
                                    <strong>@HeaderTitle</strong>
                                    <small>@GetFileFormat(_detail.FileName) file</small>
                                </span>
                                <AppChip Text="@HeaderKicker" Tone="AppUiTone.Neutral" />
                            </section>

                            @if (string.Equals(_detail.ReviewTrigger, "WritebackFailed", StringComparison.OrdinalIgnoreCase))
                            {
                                <section class="sme-writeback-remediation" role="alert">
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ErrorOutline" />
                                    <span>
                                        <strong>Metadata could not be written to the file</strong>
                                        <small>@(_detail.ReviewDetail ?? "The file may be read-only, unavailable, or locked by another application.")</small>
                                    </span>
                                    <AppButton Label="@(_retryingWriteback ? "Retrying..." : "Retry write-back")"
                                               StartIcon="@AppMaterialIcons.Outlined.Sync"
                                               ButtonStyle="AppButtonStyle.Filled"
                                               Tone="AppUiTone.Primary"
                                               Disabled="@_retryingWriteback"
                                               OnClick="RetryWritebackAsync" />
                                </section>
                            }

                            <section class="sme-file-status-panel">
                                <div class="sme-file-panel-heading">
                                    <span>File</span>
                                    <span class="sme-file-health"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CheckCircle" Size="AppSize.Small" /> Available</span>
                                </div>
                                <dl class="sme-file-fact-grid">
                                    <div><dt>File name</dt><dd>@(_detail.FileName ?? "Unknown")</dd></div>
                                    <div><dt>Format</dt><dd>@GetFileFormat(_detail.FileName)</dd></div>
                                    <div class="sme-file-fact-grid__path"><dt>File path</dt><dd>@(_detail.FilePath ?? "Unknown")</dd></div>
                                    <div><dt>Size</dt><dd>@FormatFileSize(_detail.FileSizeBytes)</dd></div>
                                    <div><dt>Status</dt><dd><span class="sme-file-health"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CheckCircle" Size="AppSize.Small" /> @(_detail.Status ?? "Available")</span></dd></div>
                                    <div><dt>Last activity</dt><dd>@FormatLastFileActivity()</dd></div>
                                </dl>
                            </section>

                            <section class="sme-file-status-panel">
                                <div class="sme-file-panel-heading">
                                    <span>Processing</span>
                                    <AppButton Label="@(_rereadingFileMetadata ? "Rereading..." : "Reread file metadata")"
                                               StartIcon="@AppMaterialIcons.Outlined.Refresh"
                                               ButtonStyle="AppButtonStyle.Outlined"
                                               Tone="AppUiTone.Primary"
                                               Disabled="@_rereadingFileMetadata"
                                               OnClick="RereadFileMetadataAsync" />
                                </div>
                                <dl class="sme-file-fact-grid sme-file-fact-grid--processing">
                                    <div><dt>Identity</dt><dd><span class="sme-file-health"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CheckCircle" Size="AppSize.Small" /> @(_detail.Status ?? "Identified")</span></dd></div>
                                    <div><dt>Pipeline</dt><dd><span class="sme-file-health"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CheckCircle" Size="AppSize.Small" /> @(_detail.PipelineStep ?? "Complete")</span></dd></div>
                                    <div><dt>Metadata write-back</dt><dd><span class="sme-file-sync"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Sync" Size="AppSize.Small" /> @(_editorContext?.FileMetadataSyncStatus ?? "Current")</span></dd></div>
                                    <div><dt>Last write</dt><dd>@FormatLastFileActivity()</dd></div>
                                </dl>
                                <div class="sme-file-panel-note">
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Info" Size="AppSize.Small" />
                                    <span>Physical-file information is read-only. Metadata changes are written through the processing pipeline.</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_fileMetadataRereadMessage))
                                {
                                    <div class="sme-file-panel-note" role="status">
                                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Info" Size="AppSize.Small" />
                                        <span>@_fileMetadataRereadMessage</span>
                                    </div>
                                }
                            </section>

                            @if (SupportsTextTracks && CurrentTextTrackAssetId.HasValue)
                            {
                                <section class="sme-file-status-panel">
                                    <div class="sme-file-panel-heading">
                                        <span>@TextTrackHeading</span>
                                        <AppButton Label="@TextTrackRefreshLabel"
                                                   StartIcon="@AppMaterialIcons.Outlined.CloudDownload"
                                                   ButtonStyle="AppButtonStyle.Outlined"
                                                   Tone="AppUiTone.Primary"
                                                   Disabled="@(_textTracksLoading || _textTracksRefreshing)"
                                                   OnClick="RefreshTextTracksAsync" />
                                        <label class="sme-text-track-import" aria-disabled="@_textTrackImporting">
                                            <InputFile class="sme-text-track-import__input"
                                                       OnChange="ImportTextTrackAsync"
                                                       disabled="@_textTrackImporting"
                                                       accept="@(UsesLyrics ? ".lrc,.txt" : ".vtt,.srt,.ass")" />
                                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.UploadFile" Size="AppSize.Small" />
                                            <span>@(_textTrackImporting ? "Importing..." : "Import")</span>
                                        </label>
                                    </div>
                                    @if (_textTracksLoading)
                                    {
                                        <div class="sme-text-track-empty">Loading managed @TextTrackHeading.ToLowerInvariant()...</div>
                                    }
                                    else if (_textTracks.Count == 0)
                                    {
                                        <div class="sme-text-track-empty">
                                            No managed @TextTrackHeading.ToLowerInvariant() are available. Tuvima checks local sidecars first and preserves user-owned files when refreshing.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="sme-text-track-list" aria-label="Managed @TextTrackHeading.ToLowerInvariant()">
                                            @foreach (var track in _textTracks.OrderByDescending(item => item.IsPreferred).ThenByDescending(item => item.IsUserOwned).ThenBy(item => item.Language))
                                            {
                                                <div class="sme-text-track-row">
                                                    <span class="sme-text-track-language">@track.Language.ToUpperInvariant()</span>
                                                    <span>
                                                        <strong>@(track.IsUserOwned ? "Local file" : track.Provider)</strong>
                                                        <small>@track.NormalizedFormat.ToUpperInvariant() · @(track.IsPreferred ? "Preferred" : "Available")</small>
                                                    </span>
                                                    <span class="sme-text-track-actions">
                                                        @if (!track.IsPreferred)
                                                        {
                                                            <AppButton Label="@(_textTrackPreferencePendingId == track.Id ? "Selecting..." : "Use")"
                                                                       ButtonStyle="AppButtonStyle.Text"
                                                                       Tone="AppUiTone.Primary"
                                                                       Disabled="@_textTrackPreferencePendingId.HasValue"
                                                                       OnClick="@(() => SetPreferredTextTrackAsync(track.Id))" />
                                                        }
                                                        <a href="@track.Url" target="_blank" rel="noopener noreferrer" aria-label="Open text track">
                                                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.OpenInNew" Size="AppSize.Small" />
                                                        </a>
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_textTrackRefreshMessage))
                                    {
                                        <div class="sme-file-panel-note" role="status">
                                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Info" Size="AppSize.Small" />
                                            <span>@_textTrackRefreshMessage</span>
                                        </div>
                                    }
                                </section>
                            }

                            @if (_detail.PlaybackSummary is { } technical)
                            {
                                <section class="sme-file-status-panel">
                                    <div class="sme-file-panel-heading"><span>Technical details</span></div>
                                    <dl class="sme-file-fact-grid">
                                    @if (!string.IsNullOrWhiteSpace(PlaybackTechnicalSummaryDisplay.VideoChip(technical)))
                                    {
                                        <div><dt>Video</dt><dd>@PlaybackTechnicalSummaryDisplay.VideoChip(technical)</dd></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(PlaybackTechnicalSummaryDisplay.AudioChip(technical)))
                                    {
                                        <div><dt>Audio</dt><dd>@PlaybackTechnicalSummaryDisplay.AudioChip(technical)</dd></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(PlaybackTechnicalSummaryDisplay.SubtitleChip(technical)))
                                    {
                                        <div><dt>Subtitles</dt><dd>@PlaybackTechnicalSummaryDisplay.SubtitleChip(technical)</dd></div>
                                    }
                                    </dl>
                                </section>
                            }

                        }
                    </div>
                }
                else if (_activeTab == "history")
                {
                    <EditorHistorySection
                        SmallEditorArtworkUrl="@((string? url) => SmallEditorArtworkUrl(url))"
                        EditorArtworkSrcSet="@((string? url) => EditorArtworkSrcSet(url))"
                        FormatHistoryDate="@((DateTime date) => FormatHistoryDate(date))"
                        FormatRelativeHistoryAge="@((DateTimeOffset occurredAt) => FormatRelativeHistoryAge(occurredAt))"
                        GetHistoryPresentation="@((string? eventType, string? category) => GetHistoryPresentation(eventType, category))"
                        HistoryFilterOptions="@(HistoryFilterOptions)"
                        HeaderKicker="@(HeaderKicker)"
                        HeaderTitle="@(HeaderTitle)"
                        CurrentCoverUrl="@(CurrentCoverUrl)"
                        CurrentProviderId="@(CurrentProviderId)"
                        ArtworkShapeClass="@(ArtworkShapeClass)"
                        FilteredHistory="@(FilteredHistory)"
                        HistoryError="@(_historyError)"
                        HistoryFilter="@(_historyFilter)"
                        Status="@(_detail?.Status ?? "Identified")"
                        RetailProviderBadge="@(BuildCurrentRetailMatchCard().Badge)"
                        HistoryFilterChanged="@((string value) => _historyFilter = value)" />
                }
                    </div>
                </div>
            </div>
            }

            @if (ShouldShowNonInlineEditorFooter)
            {
            <div class="sme-footer">
                @if (_confirmDiscard)
                {
                    <div class="sme-discard-warning">Discard unsaved changes?</div>
                    <AppButton ButtonStyle="AppButtonStyle.Text"
                               Tone="AppUiTone.Neutral"
                               Class="sme-footer-btn sme-footer-btn--ghost"
                               OnClick="@(() => _confirmDiscard = false)">
                        Keep Editing
                    </AppButton>
                    <AppButton ButtonStyle="AppButtonStyle.Filled"
                               Tone="AppUiTone.Error"
                               Class="sme-footer-btn sme-footer-btn--danger"
                               OnClick="DiscardAndClose">
                        Discard
                    </AppButton>
                }
                else
                {
                    <div class="sme-footer-spacer"></div>
                    @if (_pendingMembershipPreview is not null)
                    {
                        <div class="sme-footer-note">
                            <span>@_pendingMembershipPreview.Message</span>
                            @if (MembershipPreviewCleanupNote is { } cleanupNote)
                            {
                                <small class="sme-membership-cleanup-note">@cleanupNote</small>
                            }
                        </div>
                        <AppButton ButtonStyle="AppButtonStyle.Text"
                                   Tone="AppUiTone.Neutral"
                                   Class="sme-footer-btn sme-footer-btn--ghost"
                                   OnClick="@(() => _pendingMembershipPreview = null)">
                            Keep Editing
                        </AppButton>
                        <AppButton ButtonStyle="AppButtonStyle.Filled"
                                   Tone="AppUiTone.Primary"
                                   Class="sme-footer-btn sme-footer-btn--primary"
                                   OnClick="ConfirmMembershipMoveAsync"
                                   Disabled="@_saving">
                            Save and Move
                        </AppButton>
                    }
                    else if (HasStagedEditorChanges)
                    {
                        <AppButton ButtonStyle="AppButtonStyle.Filled"
                                   Tone="AppUiTone.Primary"
                                   Class="sme-footer-btn sme-footer-btn--primary"
                                   OnClick="SaveAsync"
                                   Disabled="@_saving">
                            @if (_saving)
                            {
                                <AppSpinner Indeterminate="true" Size="AppSize.Small" Class="tl-u-color-inherit tl-u-width-14px tl-u-height-14px" />
                            }
                            @GetDirtySaveLabel()
                        </AppButton>
                    }
                    else if (Request.Mode == SharedMediaEditorMode.Review)
                    {
                        <AppButton ButtonStyle="AppButtonStyle.Filled"
                                   Tone="AppUiTone.Primary"
                                   Class="sme-footer-btn sme-footer-btn--primary"
                                   OnClick="HandleReviewPrimaryActionAsync"
                                   Disabled="@_saving">
                            @(_saving ? "Resolving..." : GetResolveReviewLabel())
                        </AppButton>
                    }
                }
            </div>
            }
        </div>
</MediaEditorSurface>
