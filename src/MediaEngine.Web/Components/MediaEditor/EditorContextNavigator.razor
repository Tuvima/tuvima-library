@namespace MediaEngine.Web.Components.MediaEditor
@using MediaEngine.Web.Components.Shared

<nav class="editor-context" aria-label="Editing target">
    @foreach (var level in Levels)
    {
        <div class="@GetLevelClass(level) is-@level.NodeKind">
            <AppOverflowMenu Icon="@Icons.Material.Outlined.KeyboardArrowDown"
                             AriaLabel="@($"Select {level.Label.ToLowerInvariant()}")"
                             Class="editor-context-level__selector"
                             TriggerClass="editor-context-level__selector-trigger"
                             PopoverClass="editor-context-level__popover"
                             MatchAnchorWidth="true" FocusOnOpen="true" Disabled="@(!level.ShowSelector || level.Options.Count == 0)"
                             AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                <AnchorContent>
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral"
                               Disabled="@(!level.CanOpen)" Class="editor-context-level__body"
                               aria-current="@(level.IsActive ? "page" : null)" OnClick="@(() => OpenLevelAsync(level))">
                        @if (!level.IsTextOnly && !string.IsNullOrWhiteSpace(level.ArtworkUrl))
                        {
                            <img class="editor-context-level__artwork" src="@level.ArtworkUrl" alt="" loading="lazy" />
                        }
                        else
                        {
                            <span class="editor-context-level__icon" aria-hidden="true"><MudIcon Icon="@GetLevelIcon(level.NodeKind)" Size="Size.Small" /></span>
                        }
                        <span class="editor-context-level__copy">
                            <span class="editor-context-level__label">@level.Label</span>
                            <strong>@level.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(level.Subtitle))
                            {
                                <span class="editor-context-level__subtitle">@level.Subtitle</span>
                            }
                        </span>
                    </AppButton>
                </AnchorContent>
                <ChildContent>
                    @if (level.Options.Count > SearchThreshold)
                    {
                        <div class="editor-context-option-search" @onclick:stopPropagation="true">
                            <AppNativeInput Type="search" Class="editor-context-option-search__input"
                                            Value="@GetQuery(level)" ValueChanged="@(value => SetQuery(level, value?.ToString() ?? string.Empty))"
                                            Placeholder="Search options" AriaLabel="@($"Search {level.Label.ToLowerInvariant()} options")" />
                        </div>
                    }
                    @foreach (var option in GetVisibleOptions(level))
                    {
                        <AppMenuItem Disabled="@(!option.IsEnabled)" Class="@(option.IsActive ? "editor-context-option is-active" : "editor-context-option")"
                                     OnClick="@(() => SelectOptionAsync(option))">
                            @if (!option.IsTextOnly && !string.IsNullOrWhiteSpace(option.ArtworkUrl))
                            {
                                <img class="editor-context-option__artwork is-@level.NodeKind" src="@option.ArtworkUrl" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="editor-context-option__icon" aria-hidden="true"><MudIcon Icon="@GetLevelIcon(level.NodeKind)" Size="Size.Small" /></span>
                            }
                            <span class="editor-context-option__copy">
                                <strong>@option.Title</strong>
                                @if (!string.IsNullOrWhiteSpace(option.Subtitle))
                                {
                                    <span class="editor-context-option__subtitle">@option.Subtitle</span>
                                }
                            </span>
                            @if (option.IsActive)
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.Check" Size="Size.Small" />
                            }
                        </AppMenuItem>
                    }
                    @if (level.Options.Count > MaxVisibleOptions && string.IsNullOrWhiteSpace(GetQuery(level)))
                    {
                        <p class="editor-context-empty">@($"Showing the first {MaxVisibleOptions}. Search to find a specific {level.Label.ToLowerInvariant()}.")</p>
                    }
                    @if (GetVisibleOptions(level).Count == 0)
                    {
                        <p class="editor-context-empty" role="status">No matching items</p>
                    }
                </ChildContent>
            </AppOverflowMenu>
        </div>
    }
</nav>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<EditorContextLevel> Levels { get; set; } = [];
    [Parameter] public EventCallback<Guid> OnTargetSelected { get; set; }

    private const int SearchThreshold = 8;
    private const int MaxVisibleOptions = 50;
    private readonly Dictionary<string, string> _queries = new(StringComparer.Ordinal);

    private string GetQuery(EditorContextLevel level) =>
        _queries.TryGetValue(GetLevelKey(level), out var query) ? query : string.Empty;

    private void SetQuery(EditorContextLevel level, string value) =>
        _queries[GetLevelKey(level)] = value;

    private IReadOnlyList<EditorContextOption> GetVisibleOptions(EditorContextLevel level)
    {
        var query = GetQuery(level).Trim();
        return level.Options
            .Where(option => string.IsNullOrWhiteSpace(query)
                || string.Join(" ", option.Label, option.Title, option.Subtitle)
                    .Contains(query, StringComparison.OrdinalIgnoreCase))
            .Take(MaxVisibleOptions)
            .ToList();
    }

    private static string GetLevelKey(EditorContextLevel level) => $"{level.NodeKind}:{level.Label}";

    private Task OpenLevelAsync(EditorContextLevel level) =>
        level.CanOpen && level.EntityId.HasValue
            ? OnTargetSelected.InvokeAsync(level.EntityId.Value)
            : Task.CompletedTask;

    private Task SelectOptionAsync(EditorContextOption option) =>
        option.IsEnabled
            ? OnTargetSelected.InvokeAsync(option.EntityId)
            : Task.CompletedTask;

    private static string GetLevelClass(EditorContextLevel level) =>
        string.Join(" ", new[]
        {
            "editor-context-level",
            level.IsActive ? "is-active" : null,
            level.CanOpen ? "is-clickable" : "is-placeholder",
        }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private static string GetLevelIcon(string nodeKind) =>
        (nodeKind ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            "series" => Icons.Material.Outlined.VideoLibrary,
            "film_series" => Icons.Material.Outlined.VideoLibrary,
            "season" => Icons.Material.Outlined.CalendarMonth,
            "episode" => Icons.Material.Outlined.Movie,
            "movie" => Icons.Material.Outlined.Movie,
            "volume" => Icons.Material.Outlined.CollectionsBookmark,
            "issue" => Icons.Material.Outlined.Article,
            "book" => Icons.Material.Outlined.MenuBook,
            "artist" or "release_group" => Icons.Material.Outlined.Person,
            "album" => Icons.Material.Outlined.Album,
            "track" => Icons.Material.Outlined.MusicNote,
            "audiobook" => Icons.Material.Outlined.Headphones,
            _ => Icons.Material.Outlined.FolderOpen,
        };
}
