@namespace MediaEngine.Web.Components.MediaEditor
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.MediaTiles
@implements IAsyncDisposable

<nav class="editor-context" aria-label="Editing target">
    @foreach (var level in Levels)
    {
        <div class="@GetLevelClass(level) is-@level.NodeKind">
            <AppOverflowMenu Icon="@AppMaterialIcons.Outlined.KeyboardArrowDown"
                             AriaLabel="@($"Select {level.Label.ToLowerInvariant()}")"
                             Class="editor-context-level__selector"
                             TriggerClass="editor-context-level__selector-trigger"
                             PopoverClass="editor-context-level__popover"
                             MatchAnchorWidth="true" FocusOnOpen="true" Disabled="@(!level.ShowSelector || !HasSelectableContent(level))"
                             AnchorOrigin="AppOrigin.BottomLeft" TransformOrigin="AppOrigin.TopLeft">
                <AnchorContent>
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral"
                               Disabled="@(!level.CanOpen)" Class="editor-context-level__body"
                               aria-current="@(level.IsActive ? "page" : null)" OnClick="@(() => OpenLevelAsync(level))">
                        @if (!level.IsTextOnly && !string.IsNullOrWhiteSpace(level.ArtworkUrl))
                        {
                            <img class="editor-context-level__artwork" src="@SmallArtwork(level.ArtworkUrl)"
                                 srcset="@ArtworkSrcSet(level.ArtworkUrl)"
                                 sizes="@(level.NodeKind == "episode" ? "(max-width: 700px) 2rem, 5rem" : "(max-width: 700px) 2rem, 2.8rem")" alt="" loading="lazy" />
                        }
                        else
                        {
                            <span class="editor-context-level__icon" aria-hidden="true"><AppMaterialIcon Icon="@GetLevelIcon(level.NodeKind)" Size="AppSize.Small" /></span>
                        }
                        <span class="editor-context-level__copy">
                            <span class="editor-context-level__label">@level.Label</span>
                            <strong>@level.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(level.Subtitle))
                            {
                                <span class="editor-context-level__subtitle">@level.Subtitle</span>
                            }
                        </span>
                    </AppButton>
                </AnchorContent>
                <ChildContent>
                    @if (CanSearch(level))
                    {
                        <div class="editor-context-option-search" @onclick:stopPropagation="true">
                            <AppNativeInput Type="search" Class="editor-context-option-search__input"
                                            Value="@GetQuery(level)" ValueChanged="@(value => SetQueryAsync(level, value?.ToString() ?? string.Empty))"
                                            Placeholder="Search options" AriaLabel="@($"Search {level.Label.ToLowerInvariant()} options")" />
                        </div>
                    }
                    @foreach (var option in GetVisibleOptions(level))
                    {
                        <AppMenuItem Disabled="@(!option.IsEnabled)" Class="@(option.IsActive ? "editor-context-option is-active" : "editor-context-option")"
                                     OnClick="@(() => SelectOptionAsync(option))">
                            @if (!option.IsTextOnly && !string.IsNullOrWhiteSpace(option.ArtworkUrl))
                            {
                                <img class="editor-context-option__artwork is-@level.NodeKind" src="@SmallArtwork(option.ArtworkUrl)"
                                     srcset="@ArtworkSrcSet(option.ArtworkUrl)" sizes="@(level.NodeKind == "episode" ? "5rem" : "2.5rem")" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="editor-context-option__icon" aria-hidden="true"><AppMaterialIcon Icon="@GetLevelIcon(level.NodeKind)" Size="AppSize.Small" /></span>
                            }
                            <span class="editor-context-option__copy">
                                <strong>@option.Title</strong>
                                @if (!string.IsNullOrWhiteSpace(option.Subtitle))
                                {
                                    <span class="editor-context-option__subtitle">@option.Subtitle</span>
                                }
                            </span>
                            @if (option.IsActive)
                            {
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Check" Size="AppSize.Small" />
                            }
                        </AppMenuItem>
                    }
                    @if (IsSearching(level))
                    {
                        <p class="editor-context-empty" role="status">Searching…</p>
                    }
                    else if (GetVisibleOptions(level).Count == 0)
                    {
                        <p class="editor-context-empty" role="status">No matching items</p>
                    }
                </ChildContent>
            </AppOverflowMenu>
        </div>
    }
</nav>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<EditorContextLevel> Levels { get; set; } = [];
    [Parameter] public EventCallback<Guid> OnTargetSelected { get; set; }
    [Parameter] public EditorContextOptionSearch? SearchOptionsAsync { get; set; }

    private const int SearchThreshold = 8;
    private const int MaximumSearchResults = 100;
    private static readonly TimeSpan SearchDelay = TimeSpan.FromMilliseconds(250);
    private readonly Dictionary<string, string> _queries = new(StringComparer.Ordinal);
    private readonly Dictionary<string, IReadOnlyList<EditorContextOption>> _searchResults = new(StringComparer.Ordinal);
    private readonly HashSet<string> _searching = new(StringComparer.Ordinal);
    private CancellationTokenSource? _searchCancellation;

    private static string? SmallArtwork(string? url) => MediaTileArtworkUrl.Sized(url, "s") ?? url;
    private static string? ArtworkSrcSet(string? url) => MediaTileArtworkUrl.SrcSet(
        MediaTileArtworkUrl.Sized(url, "s"), MediaTileArtworkUrl.Sized(url, "m"), MediaTileArtworkUrl.Sized(url, "l"));

    private string GetQuery(EditorContextLevel level) =>
        _queries.TryGetValue(GetLevelKey(level), out var query) ? query : string.Empty;

    private async Task SetQueryAsync(EditorContextLevel level, string value)
    {
        var key = GetLevelKey(level);
        _queries[key] = value;
        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
        _searchCancellation = null;

        if (SearchOptionsAsync is null || !level.UsesOwnedCollectionSearch || string.IsNullOrWhiteSpace(value))
        {
            _searchResults.Remove(key);
            _searching.Remove(key);
            return;
        }

        var cancellation = _searchCancellation = new CancellationTokenSource();
        _searching.Add(key);
        try
        {
            await Task.Delay(SearchDelay, cancellation.Token);
            var results = await SearchOptionsAsync(
                new EditorContextOptionSearchRequest(level, value.Trim(), MaximumSearchResults),
                cancellation.Token);
            if (!cancellation.IsCancellationRequested && ReferenceEquals(_searchCancellation, cancellation))
                _searchResults[key] = results;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(_searchCancellation, cancellation))
            {
                _searching.Remove(key);
                _searchCancellation = null;
                cancellation.Dispose();
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private IReadOnlyList<EditorContextOption> GetVisibleOptions(EditorContextLevel level)
    {
        var query = GetQuery(level).Trim();
        if (!string.IsNullOrWhiteSpace(query)
            && _searchResults.TryGetValue(GetLevelKey(level), out var remoteResults))
            return remoteResults;

        return level.Options
            .Where(option => string.IsNullOrWhiteSpace(query)
                || string.Join(" ", option.Label, option.Title, option.Subtitle)
                    .Contains(query, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private static string GetLevelKey(EditorContextLevel level) => $"{level.NodeKind}:{level.Label}:{level.EntityId}";
    private bool CanSearch(EditorContextLevel level) =>
        (SearchOptionsAsync is not null && level.UsesOwnedCollectionSearch) || level.Options.Count > SearchThreshold;
    private bool HasSelectableContent(EditorContextLevel level) =>
        level.Options.Count > 0 || (SearchOptionsAsync is not null && level.UsesOwnedCollectionSearch);
    private bool IsSearching(EditorContextLevel level) => _searching.Contains(GetLevelKey(level));

    private Task OpenLevelAsync(EditorContextLevel level) =>
        level.CanOpen && level.EntityId.HasValue
            ? OnTargetSelected.InvokeAsync(level.EntityId.Value)
            : Task.CompletedTask;

    private Task SelectOptionAsync(EditorContextOption option) =>
        option.IsEnabled
            ? OnTargetSelected.InvokeAsync(option.EntityId)
            : Task.CompletedTask;

    private static string GetLevelClass(EditorContextLevel level) =>
        string.Join(" ", new[]
        {
            "editor-context-level",
            level.IsActive ? "is-active" : null,
            level.CanOpen ? "is-clickable" : "is-placeholder",
            level.WidthWeight > 1 ? "is-wide" : null,
        }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private static string GetLevelIcon(string nodeKind) =>
        (nodeKind ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            "series" => AppMaterialIcons.Outlined.VideoLibrary,
            "film_series" => AppMaterialIcons.Outlined.VideoLibrary,
            "season" => AppMaterialIcons.Outlined.CalendarMonth,
            "episode" => AppMaterialIcons.Outlined.Movie,
            "movie" => AppMaterialIcons.Outlined.Movie,
            "volume" => AppMaterialIcons.Outlined.CollectionsBookmark,
            "issue" => AppMaterialIcons.Outlined.Article,
            "book" => AppMaterialIcons.Outlined.MenuBook,
            "artist" or "release_group" => AppMaterialIcons.Outlined.Person,
            "album" => AppMaterialIcons.Outlined.Album,
            "track" => AppMaterialIcons.Outlined.MusicNote,
            "audiobook" => AppMaterialIcons.Outlined.Headphones,
            _ => AppMaterialIcons.Outlined.FolderOpen,
        };

    public ValueTask DisposeAsync()
    {
        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
        _searchCancellation = null;
        return ValueTask.CompletedTask;
    }
}
