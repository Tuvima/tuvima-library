@namespace MediaEngine.Web.Components.Listen
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Models.ViewDTOs
@inject IStringLocalizer<SharedStrings> L

@* The one "..." menu of a playlist (spec listen-playlists D7), the same wherever a playlist is drawn: the playlist's own page, the sidebar
   and a tile. Rename, Edit description and cover, Duplicate, Pin to top (Unpin once pinned) and Delete; a Smart list adds Edit rules
   first. Favorites and the other built-in lists have no menu, so this draws nothing for them. Each action hands the playlist back to the
   caller, which does the work (rename and details windows, the one Delete question, the Engine calls). It is a bottom sheet on a phone and
   on a touch tablet, a popover elsewhere, with 44 px rows. The rows are plain words, as in the mockup. The trigger is an icon button, so it has a tooltip and an accessible name. *@
@if (Items.Count > 0)
{
    <AppTooltip Text="@Label" Placement="AppPlacement.Bottom">
        <AppRowMenu AriaLabel="@Label" Title="@Playlist.Name" Items="@Items" SheetOnTablet="true" Class="@Class" />
    </AppTooltip>
}

@code {
    /// <summary>The playlist the menu is for; its type decides the items and its pinned state decides Pin to top or Unpin.</summary>
    [Parameter, EditorRequired] public ManagedCollectionViewModel Playlist { get; set; } = default!;

    /// <summary>Edit rules (Smart lists only): the caller opens the rule editor for the playlist.</summary>
    [Parameter] public EventCallback<ManagedCollectionViewModel> OnEditRules { get; set; }

    /// <summary>Rename: the caller asks for the new name.</summary>
    [Parameter] public EventCallback<ManagedCollectionViewModel> OnRename { get; set; }

    /// <summary>Edit description and cover: the caller opens the small window for them.</summary>
    [Parameter] public EventCallback<ManagedCollectionViewModel> OnEditDetails { get; set; }

    /// <summary>Duplicate: the caller copies the playlist with its songs in order.</summary>
    [Parameter] public EventCallback<ManagedCollectionViewModel> OnDuplicate { get; set; }

    /// <summary>Pin to top or Unpin, whichever the menu showed; the caller flips the playlist's pin for this profile.</summary>
    [Parameter] public EventCallback<ManagedCollectionViewModel> OnTogglePin { get; set; }

    /// <summary>Delete: the caller asks once ("are you sure") and deletes.</summary>
    [Parameter] public EventCallback<ManagedCollectionViewModel> OnDelete { get; set; }

    /// <summary>
    /// Reorder (optional): only the sidebar of the Listen lane keeps its own reorder mode for playlists, so only it passes this and gets a
    /// Reorder row after Pin to top. The playlist's own page and the tiles leave it out.
    /// </summary>
    [Parameter] public EventCallback<ManagedCollectionViewModel> OnReorder { get; set; }

    /// <summary>
    /// Move up (optional, spec listen-playlists WP5): the places that keep their own order for the profile (the sidebar and the Playlists page in
    /// Manual order) pass this and <see cref="OnMoveDown"/>, and get Move up and Move down after Pin to top. This is the way to reorder playlists
    /// without dragging, by keyboard or by touch.
    /// </summary>
    [Parameter] public EventCallback<ManagedCollectionViewModel> OnMoveUp { get; set; }

    /// <summary>Move down (optional); see <see cref="OnMoveUp"/>.</summary>
    [Parameter] public EventCallback<ManagedCollectionViewModel> OnMoveDown { get; set; }

    /// <summary>False when Move up would change nothing (the first playlist, or the first after the pinned ones); the row is then greyed.</summary>
    [Parameter] public bool CanMoveUp { get; set; } = true;

    /// <summary>False when Move down would change nothing (the last playlist, or the last pinned one); the row is then greyed.</summary>
    [Parameter] public bool CanMoveDown { get; set; } = true;

    /// <summary>Extra class for the menu button, so each place can size and place it.</summary>
    [Parameter] public string? Class { get; set; }

    private string Label => L["PlaylistMenu_Options", Playlist.Name].Value;

    private IReadOnlyList<AppRowMenuItem> Items => [.. WithReorder(PlaylistMenuRules.ActionsFor(Playlist).Select(ItemFor))];

    private IEnumerable<AppRowMenuItem> WithReorder(IEnumerable<AppRowMenuItem> items)
    {
        var all = items.ToList();
        if (all.Count == 0)
        {
            return all;
        }

        // After the last plain action, before Delete (which is always last).
        var at = Math.Max(0, all.Count - 1);
        if (OnMoveUp.HasDelegate)
        {
            all.Insert(at++, new AppRowMenuItem { Label = L["Common_MoveUp"].Value, Disabled = !CanMoveUp, OnClick = Call(OnMoveUp) });
        }

        if (OnMoveDown.HasDelegate)
        {
            all.Insert(at++, new AppRowMenuItem { Label = L["Common_MoveDown"].Value, Disabled = !CanMoveDown, OnClick = Call(OnMoveDown) });
        }

        if (OnReorder.HasDelegate)
        {
            all.Insert(at, new AppRowMenuItem { Label = L["AppReorderBar_MenuReorder"].Value, OnClick = Call(OnReorder) });
        }

        return all;
    }

    private AppRowMenuItem ItemFor(PlaylistMenuAction action) => action switch
    {
        PlaylistMenuAction.EditRules => new AppRowMenuItem { Label = L["PlaylistMenu_EditRules"].Value, OnClick = Call(OnEditRules) },
        PlaylistMenuAction.Rename => new AppRowMenuItem { Label = L["Common_Rename"].Value, OnClick = Call(OnRename) },
        PlaylistMenuAction.EditDetails => new AppRowMenuItem { Label = L["PlaylistMenu_EditDetails"].Value, OnClick = Call(OnEditDetails) },
        PlaylistMenuAction.Duplicate => new AppRowMenuItem { Label = L["PlaylistMenu_Duplicate"].Value, OnClick = Call(OnDuplicate) },
        PlaylistMenuAction.TogglePin => new AppRowMenuItem
        {
            Label = Playlist.IsPinned == true ? L["PlaylistMenu_Unpin"].Value : L["PlaylistMenu_PinToTop"].Value,
           
            OnClick = Call(OnTogglePin),
        },
        _ => new AppRowMenuItem { Label = L["Common_Delete"].Value, Destructive = true, OnClick = Call(OnDelete) },
    };

    private EventCallback Call(EventCallback<ManagedCollectionViewModel> callback)
        => EventCallback.Factory.Create(this, () => callback.InvokeAsync(Playlist));
}
