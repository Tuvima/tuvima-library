@namespace MediaEngine.Web.Components.Listen
@using MediaEngine.Web.Services.Editing
@inject IServiceProvider Services
@inject IStringLocalizer<SharedStrings> L

@* The phone's bar for ticked songs (Listen music spec D12). A phone ticks songs after Select in a song's "..." sheet; this bar then sits at
   the bottom of the screen above the player bar and the bottom navigation, with the count and Done on top and Play, Add to queue and Add
   to playlist in one row of 44 px buttons. Add to playlist opens the same playlist list as the desktop bar, as a bottom sheet, and says how
   many songs went in on a line of this bar (no toast). There is no Edit here and no dragging on a phone. *@
<section class="song-selection-bar" role="toolbar" aria-label="@L["SongSelectionBar_Label"].Value" data-song-selection-bar="true">
    <div class="song-selection-bar__head">
        <strong class="song-selection-bar__count" role="status" aria-live="polite">@L["SongSelectionBar_Count", Count].Value</strong>
        <AppNativeButton Type="button" Class="song-selection-bar__done" OnClick="@(_ => OnDone.InvokeAsync())">@L["Common_Done"].Value</AppNativeButton>
    </div>
    @if (_notice is not null)
    {
        <p class="@NoticeClass" role="status" data-song-selection-notice="true">@_notice</p>
    }
    <div class="song-selection-bar__actions">
        @if (CanPlay)
        {
            <AppNativeButton Type="button" Class="song-selection-bar__action" Disabled="@(Count == 0 || _busy)" OnClick="@(_ => PlayAsync())">
                <AppMaterialIcon Icon="@AppMaterialIcons.Filled.PlayArrow" />
                <span>@L["Common_Play"].Value</span>
            </AppNativeButton>
        }
        @if (CanQueue)
        {
            <AppNativeButton Type="button" Class="song-selection-bar__action" Disabled="@(Count == 0 || _busy)" OnClick="@(_ => QueueAsync())">
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PlaylistAdd" />
                <span>@L["Common_AddToQueue"].Value</span>
            </AppNativeButton>
        }
        <AppNativeButton Type="button" Class="song-selection-bar__action" Disabled="@(Count == 0 || _busy)" OnClick="@(_ => AddToPlaylistAsync())">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.QueueMusic" />
            <span>@L["Common_AddToPlaylist"].Value</span>
        </AppNativeButton>
    </div>
</section>

@code {
    private string? _notice;
    private AppSeverity _noticeSeverity = AppSeverity.Info;
    private bool _busy;

    /// <summary>The ticked songs' work ids, in the order the list shows them.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<Guid> WorkIds { get; set; } = [];

    /// <summary>How many songs are ticked (the same as <see cref="WorkIds"/> unless a ticked row has no work yet).</summary>
    [Parameter] public int Count { get; set; }

    [Parameter] public bool CanPlay { get; set; }

    [Parameter] public bool CanQueue { get; set; }

    /// <summary>Play the ticked songs: the host replaces its queue with them and starts the first.</summary>
    [Parameter] public EventCallback OnPlay { get; set; }

    /// <summary>Add the ticked songs to the end of the queue.</summary>
    [Parameter] public EventCallback OnQueue { get; set; }

    /// <summary>Leave select mode: the ticks are dropped and the bar goes away.</summary>
    [Parameter] public EventCallback OnDone { get; set; }

    private string NoticeClass => _noticeSeverity switch
    {
        AppSeverity.Error => "song-selection-bar__notice song-selection-bar__notice--error",
        AppSeverity.Warning => "song-selection-bar__notice song-selection-bar__notice--warning",
        _ => "song-selection-bar__notice",
    };

    private async Task PlayAsync()
    {
        _notice = null;
        await OnPlay.InvokeAsync();
    }

    private async Task QueueAsync()
    {
        _notice = null;
        await OnQueue.InvokeAsync();
    }

    private async Task AddToPlaylistAsync()
    {
        if (_busy || WorkIds.Count == 0)
        {
            return;
        }

        _busy = true;
        _notice = null;
        try
        {
            var notice = await PlaylistMembershipFlow.RunForSongsAsync(Services, WorkIds, L["Common_AddToPlaylist"].Value);
            if (notice is not null)
            {
                _notice = notice.Message;
                _noticeSeverity = notice.Severity;
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
