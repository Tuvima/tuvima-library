@namespace MediaEngine.Web.Components.Listen
@using System.Globalization
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Playback
@implements IDisposable
@inject IStringLocalizer<SharedStrings> L

@* Picks the body of a Listen tool panel (unified player v2 D18 to D20). The Queue, History and Chapters lists have their own panels now (QueuePanel and
   ChaptersPanel, drawn from the mockup); this keeps the lyrics body and the audiobook's listening history, which no other panel owns yet. *@
@switch (_key)
{
    case "queue":
    case "history" when !IsAudiobook:
        <QueuePanel Snapshot="@Snapshot" Commands="@Commands" ShowTabs="@ShowTabs" ShowFooter="@ShowQueueSource" ActiveTab="@(_key == "history" ? "history" : "upnext")" />
        break;
    case "chapters":
        <ChaptersPanel Snapshot="@Snapshot" Commands="@Commands" ShowFooter="@ShowChaptersFooter" />
        break;
    default:
        <div class="listen-context-sidebar" aria-label="@L["PlaybackContextPanel_PlaybackContextPanel"].Value">
            <div class="listen-context-sidebar__body @(_key == "lyrics" ? "listen-context-sidebar__body--lyrics" : "playback-sheet-list")" data-playback-context-scroll-key="@($"{CurrentItem?.AssetId}:{Snapshot.PlaybackRequestVersion}:{_key}")">
                @switch (_key)
                {
                    case "lyrics":
                        <PlaybackLyrics Snapshot="@Snapshot" Commands="@Commands" />
                        break;
                    case "history":
                        @if (Snapshot.AudiobookHistory.Count == 0)
                        {
                            <p class="listen-context-sidebar__empty">@L["PlaybackContextPanel_RecentListeningPositionsWillAppear"]</p>
                        }
                        @foreach (var group in Snapshot.AudiobookHistory.GroupBy(item => item.EndedAt.LocalDateTime.Date).OrderByDescending(group => group.Key))
                        {
                            <h3 class="listen-context-sidebar__date">@group.Key.ToString("D", CultureInfo.CurrentCulture)</h3>
                            @foreach (var entry in group)
                            {
                                <PlaybackContextRow Variant="history" LeadingWidth="80px" LeadingText="@entry.EndedAt.LocalDateTime.ToString("t", CultureInfo.CurrentCulture)"
                                                   Title="@(entry.ChapterTitle ?? entry.Title)" Subtitle="@AudiobookHistorySubtitle(entry)"
                                                   OnClick="@(() => ResumeAsync(Snapshot, entry))"
                                                   AriaLabel="@($"Resume {entry.ChapterTitle ?? entry.Title} at {FormatTime(entry.PositionSeconds)}")">
                                    <Actions><AppNativeButton Type="button" Class="listen-context-sidebar__replay" AriaLabel="@($"Resume {entry.ChapterTitle ?? entry.Title}")" Tooltip="@L["Common_Resume"].Value" OnClick="@(() => ResumeAsync(Snapshot, entry))"><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Reset" /></AppNativeButton></Actions>
                                </PlaybackContextRow>
                            }
                        }
                        break;
                    default:
                        <p class="listen-context-sidebar__empty">@L["PlaybackContextPanel_ChooseAPlaybackPanel"]</p>
                        break;
                }
            </div>
            @if (_failure is not null) { <AppAlert Tone="AppUiTone.Warning" Dense="true" Class="listen-context-sidebar__feedback">@_failure</AppAlert> }
        </div>
        break;
}

@code {
    [Parameter, EditorRequired] public ListenPlaybackSnapshot Snapshot { get; set; } = new();
    [Parameter, EditorRequired] public IPlaybackCommandSink Commands { get; set; } = null!;
    [Parameter] public string? ActivePanelKey { get; set; }

    /// <summary>True when the Queue draws its own Up next and History tabs; false when the host (the Now playing scene) has already drawn them.</summary>
    [Parameter] public bool ShowTabs { get; set; }

    /// <summary>False leaves the Queue's "Playing from ..." line out (the Now playing scene already says it beside the cover).</summary>
    [Parameter] public bool ShowQueueSource { get; set; } = true;

    /// <summary>False leaves the Chapters "Timeline shows" control out (the pop-out window cannot reach the main window's choice).</summary>
    [Parameter] public bool ShowChaptersFooter { get; set; } = true;

    /// <summary>Kept for the hosts that still pass it; the lists now choose their own tabs.</summary>
    [Parameter] public EventCallback<string> OnTabChanged { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private string? _key, _failure;
    private ListenQueueItem? CurrentItem => Snapshot.CurrentIndex >= 0 && Snapshot.CurrentIndex < Snapshot.Queue.Count ? Snapshot.Queue[Snapshot.CurrentIndex] : null;
    private bool IsAudiobook => CurrentItem?.PlaybackExperience == PlaybackExperience.Audiobook;

    protected override void OnParametersSet() => _key = ActivePanelKey;

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private async Task ResumeAsync(ListenPlaybackSnapshot shown, AudiobookListenHistoryItemDto entry)
    {
        try
        {
            var reply = await Commands.SendAsync(shown, new() { Action = ListenPlaybackCommandActions.PlayAudiobookHistory, AudiobookHistoryItem = entry });
            _failure = reply?.Outcome == AudiobookBookmarkOperationOutcomes.Success ? null : reply?.Message ?? L["QueuePanel_NotConfirmed"].Value;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or OperationCanceledException)
        {
            _failure = L["QueuePanel_Interrupted"].Value;
        }
    }

    private static string AudiobookHistorySubtitle(AudiobookListenHistoryItemDto item)
    {
        var interval = (item.EndedAt - item.StartedAt).TotalSeconds;
        return interval > 0 ? $"Elapsed session · {FormatTime(interval)}" : $"Saved position · {FormatTime(item.PositionSeconds)}";
    }

    private static string FormatTime(double seconds) => TimeSpan.FromSeconds(Math.Max(0, seconds)).ToString(seconds >= 3600 ? @"h\:mm\:ss" : @"m\:ss", CultureInfo.InvariantCulture);
}
