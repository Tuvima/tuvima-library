@namespace MediaEngine.Web.Components.Listen
@using System.Globalization
@using MediaEngine.Web.Components.Shared

<div class="@RootClass" aria-label="@AriaLabel">
    @if (IsAudiobookMode)
    {
        @if (!Compact) {
        <PlaybackRelativeSkipButton Seconds="@SkipBackSeconds" Direction="back" Size="@SkipButtonSize" Class="@SkipBackClass" OnClick="@OnSkipBack" />
        }
        @if (!Compact)
        {
        <AppNativeButton Type="button" Class="@IconButtonClass" OnClick="OnPreviousChapter" Disabled="@(!HasChapters)" AriaLabel="Previous chapter" title="Previous chapter">
            <MudIcon Icon="@Icons.Material.Filled.SkipPrevious" Class="@SkipIconClass" />
        </AppNativeButton>
        }
        <PlaybackPrimaryButton IsPlaying="@IsPlaying"
                               NeedsUserGestureToStart="@NeedsUserGestureToStart"
                               Size="@PlayButtonSize"
                               Appearance="@PrimaryAppearance"
                               Class="@PlayButtonClass"
                               OnClick="@OnTogglePlay"
                               AriaLabel="Play or pause"
                               title="Play or pause"
                               data-listen-audio-toggle="true"
                               data-listen-start-url="@CurrentBrowserStreamUrl"
                               data-listen-start-position="@CurrentTimeSeconds.ToString("0.###", CultureInfo.InvariantCulture)"
                               data-listen-start-rate="@PlaybackRate.ToString("0.###", CultureInfo.InvariantCulture)"
                               data-listen-start-volume="@Volume.ToString("0.###", CultureInfo.InvariantCulture)"
                               data-listen-start-muted="@(IsMuted ? "true" : "false")" />
        @if (!Compact)
        {
        <AppNativeButton Type="button" Class="@IconButtonClass" OnClick="OnNextChapter" Disabled="@(!HasChapters)" AriaLabel="Next chapter" title="Next chapter">
            <MudIcon Icon="@Icons.Material.Filled.SkipNext" Class="@SkipIconClass" />
        </AppNativeButton>
        }
        @if (!Compact) {
        <PlaybackRelativeSkipButton Seconds="@SkipForwardSeconds" Direction="forward" Size="@SkipButtonSize" Class="@SkipForwardClass" OnClick="@OnSkipForward" />
        }
    }
    else
    {
        @if (ShowMusicModeButtons && !Compact)
        {
            <AppNativeButton Type="button" Class="@($"{IconButtonClass} listen-player__mode-button {(ShuffleEnabled ? "is-active" : null)}")" OnClick="OnShuffle" AriaLabel="@(ShuffleEnabled ? "Turn shuffle off" : "Turn shuffle on")" title="Shuffle" aria-pressed="@(ShuffleEnabled ? "true" : "false")">
                <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Shuffle" />
            </AppNativeButton>
        }
        @if (!Compact)
        {
        <AppNativeButton Type="button" Class="@IconButtonClass" OnClick="OnPreviousTrack" Disabled="@(!CanPreviousTrack)" AriaLabel="Previous track" title="Previous track">
            <MudIcon Icon="@Icons.Material.Outlined.SkipPrevious" Class="@TrackIconClass" />
        </AppNativeButton>
        }
        <PlaybackPrimaryButton IsPlaying="@IsPlaying"
                               NeedsUserGestureToStart="@NeedsUserGestureToStart"
                               Size="@PlayButtonSize"
                               Appearance="@PrimaryAppearance"
                               Class="@PlayButtonClass"
                               OnClick="@OnTogglePlay"
                               AriaLabel="Play or pause"
                               title="Play or pause"
                               data-listen-audio-toggle="true"
                               data-listen-start-url="@CurrentBrowserStreamUrl"
                               data-listen-start-position="@CurrentTimeSeconds.ToString("0.###", CultureInfo.InvariantCulture)"
                               data-listen-start-rate="@PlaybackRate.ToString("0.###", CultureInfo.InvariantCulture)"
                               data-listen-start-volume="@Volume.ToString("0.###", CultureInfo.InvariantCulture)"
                               data-listen-start-muted="@(IsMuted ? "true" : "false")" />
        @if (!Compact)
        {
        <AppNativeButton Type="button" Class="@IconButtonClass" OnClick="OnNextTrack" Disabled="@(!CanNextTrack)" AriaLabel="Next track" title="Next track">
            <MudIcon Icon="@Icons.Material.Outlined.SkipNext" Class="@TrackIconClass" />
        </AppNativeButton>
        }
        @if (ShowQueueButton && !Compact)
        {
            <AppNativeButton Type="button" Class="@IconButtonClass" OnClick="OnQueue" AriaLabel="Queue options" title="Queue options">
                <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Queue" />
            </AppNativeButton>
        }
        @if (ShowMusicModeButtons && !Compact)
        {
            <AppNativeButton Type="button" Class="@($"{IconButtonClass} listen-player__mode-button {(RepeatEnabled ? "is-active" : null)}")" OnClick="OnRepeat" AriaLabel="@(RepeatEnabled ? "Change repeat mode" : "Turn repeat on")" title="Repeat" aria-pressed="@(RepeatEnabled ? "true" : "false")">
                <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Repeat" />
            </AppNativeButton>
        }
    }
</div>

@code {
    [Parameter] public bool Compact { get; set; }

    [Parameter] public string Variant { get; set; } = "bar";
    [Parameter] public string PrimaryAppearance { get; set; } = "standard";
    [Parameter] public bool IsAudiobookMode { get; set; }
    [Parameter] public bool IsPlaying { get; set; }
    [Parameter] public bool NeedsUserGestureToStart { get; set; }
    [Parameter] public bool IsMuted { get; set; }
    [Parameter] public bool HasChapters { get; set; }
    [Parameter] public bool CanPreviousTrack { get; set; }
    [Parameter] public bool CanNextTrack { get; set; }
    [Parameter] public bool ShowQueueButton { get; set; }
    [Parameter] public bool ShowMusicModeButtons { get; set; }
    [Parameter] public bool ShuffleEnabled { get; set; }
    [Parameter] public bool RepeatEnabled { get; set; }
    [Parameter] public int SkipBackSeconds { get; set; }
    [Parameter] public int SkipForwardSeconds { get; set; }
    [Parameter] public string? CurrentBrowserStreamUrl { get; set; }
    [Parameter] public double CurrentTimeSeconds { get; set; }
    [Parameter] public double PlaybackRate { get; set; } = 1d;
    [Parameter] public double Volume { get; set; } = 0.8d;
    [Parameter] public EventCallback OnTogglePlay { get; set; }
    [Parameter] public EventCallback OnPreviousTrack { get; set; }
    [Parameter] public EventCallback OnNextTrack { get; set; }
    [Parameter] public EventCallback OnPreviousChapter { get; set; }
    [Parameter] public EventCallback OnNextChapter { get; set; }
    [Parameter] public EventCallback OnSkipBack { get; set; }
    [Parameter] public EventCallback OnSkipForward { get; set; }
    [Parameter] public EventCallback OnQueue { get; set; }
    [Parameter] public EventCallback OnShuffle { get; set; }
    [Parameter] public EventCallback OnRepeat { get; set; }

    private string AriaLabel => IsAudiobookMode ? "Audiobook playback controls" : "Playback controls";
    private string RootClass => Variant switch
    {
        "panel" => $"listen-transport listen-transport--panel listen-now-panel__controls {(IsAudiobookMode ? "listen-now-panel__controls--audiobook" : null)}",
        "popup" => $"listen-transport listen-transport--popup listen-popup__transport {(IsAudiobookMode ? "listen-transport--popup-audiobook" : "listen-transport--popup-music")}",
        "phone" => $"listen-transport listen-transport--phone {(IsAudiobookMode ? "listen-transport--phone-audiobook" : "listen-transport--phone-music")}",
        "expanded" => $"listen-transport listen-transport--expanded {(IsAudiobookMode ? "listen-transport--expanded-audiobook" : "listen-transport--expanded-music")}",
        "video" => "listen-transport listen-transport--video",
        _ => $"listen-transport listen-transport--bar listen-player__transport-buttons {(IsAudiobookMode ? "listen-player__transport-buttons--audiobook" : null)}",
    };
    private string IconButtonClass => Variant switch
    {
        "panel" => "listen-now-panel__icon",
        "popup" => "listen-popup__transport-icon",
        _ => "listen-player__icon",
    };
    private string PlayButtonClass => Variant switch
    {
        "panel" => "listen-now-panel__play",
        "popup" => "listen-popup__play",
        _ => "listen-player__play",
    };
    private string PlayButtonSize => Variant switch
    {
        "popup" => "large",
        "panel" => "standard",
        _ => "compact",
    };
    private string TrackIconClass => "listen-transport__secondary-icon";
    private string SkipIconClass => "listen-transport__secondary-icon";
    private string SkipButtonSize => Variant switch
    {
        "popup" => "large",
        "panel" => "standard",
        _ => "compact",
    };
    private string SkipBackClass => Variant switch
    {
        "panel" => "listen-now-panel__skip listen-now-panel__skip--back",
        "popup" => "listen-popup__skip listen-popup__skip--back",
        _ => "listen-player__skip listen-player__skip--back",
    };
    private string SkipForwardClass => Variant switch
    {
        "panel" => "listen-now-panel__skip listen-now-panel__skip--forward",
        "popup" => "listen-popup__skip listen-popup__skip--forward",
        _ => "listen-player__skip listen-player__skip--forward",
    };

}
