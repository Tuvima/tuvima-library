@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Components.Details
@using System.Globalization
@using MediaEngine.Web.Components.Library
@using MediaEngine.Web.Models.ViewDTOs
@using Microsoft.AspNetCore.Components.Web
@using MediaEngine.Contracts.Realtime
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Ui
@using MediaEngine.Web.Components.Shared
@implements IDisposable
@inject DeviceContextService DeviceContext
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject IStringLocalizer<SharedStrings> L

@if (DeviceContext.IsPhone)
{
    var phoneTracks = DisplayTracks;
    <AppTable CardsOn="AppTableCardsMode.Phone" Hover="true" Class="listen-song-table-cards">
        <caption class="sr-only">@AriaLabel</caption>
        <thead>
            <tr>
                <th data-card-role="title">@L["Common_Song"]</th>
                <th data-card-role="subtitle">@L["Common_ArtistAndAlbum"]</th>
                <th data-card-role="value">@L["Common_Time"]</th>
                <th data-card-role="actions"><span class="sr-only">@L["ApiKeys_Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var track in phoneTracks.Take(_phoneVisibleCount))
            {
                var trackTitle = DisplayTrackTitle(track);
                <tr @key="track.Id"
                    class="@RowClass(track)"
                    data-listen-immediate-start="music"
                    data-listen-start-url="@(track.AssetId is { } sourceId ? $"/engine-stream/{sourceId:D}" : null)"
                    tabindex="0"
                    @onclick="@(() => PlayAsync(track.Id, false))"
                    @onkeydown="@((args) => HandleRowKeyDownAsync(args, track.Id))">
                    <td data-card-role="title">@trackTitle</td>
                    <td data-card-role="subtitle">@CardSubtitle(track)</td>
                    <td data-card-role="value">@GetTrackDuration(track)</td>
                    <td data-card-role="actions" class="listen-song-table-cards__actions" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                        @if (ShowFavorite)
                        {
                            <AppNativeButton Type="button" Class='@($"listen-song-table__favorite-button {(FavoriteIds.Contains(track.Id) ? " is-active" : null)}")' AriaLabel="@($"Toggle favorite for {trackTitle}")" Title="@L["Common_ToggleFavorite"].Value" aria-pressed="@(FavoriteIds.Contains(track.Id) ? "true" : "false")" StopPropagation="true" OnClick="@(() => ToggleFavoriteAsync(track))">
                                <AppMaterialIcon Icon="@(FavoriteIds.Contains(track.Id) ? AppMaterialIcons.Filled.Favorite : AppMaterialIcons.Outlined.FavoriteBorder)" Size="AppSize.Small" />
                            </AppNativeButton>
                        }
                        <AppRowMenu AriaLabel="@($"Actions for {trackTitle}")" Title="@trackTitle" Items="@CardMenuItems(track)" />
                    </td>
                </tr>
            }
        </tbody>
    </AppTable>
    @if (phoneTracks.Count > _phoneVisibleCount)
    {
        <div class="listen-song-table-cards__more">
            <AppNativeButton Type="button" Class="listen-song-table-cards__more-button" OnClick="ShowMorePhoneTracks">
                @L["ListenSongTable_ShowMoreSongsLeft", phoneTracks.Count - _phoneVisibleCount]
            </AppNativeButton>
        </div>
    }
}
else
{
    // Worked out once per render: the column list and every row read it.
    _showDelete = ComputeShowDelete();
    _showSelect = ComputeShowSelect();
    if (ShowSelect)
    {
        @* Ticking songs shows the selection bar (Edit, Match, Move to album, Delete in "...") and its right-hand panel (universal editor spec D14). *@
        <BulkEditHost @ref="_bulkHost" Rows="@BulkRows" MediaType="Music" OnSaved="OnEditedAsync" OnCleared="ClearSelectionAsync" OnDeleted="OnDeletedAsync" />
    }
    <div class="listen-song-table"
         role="table"
         aria-label="@AriaLabel"
         @onmousemove="@(args => ResizeColumn(args.ClientX))"
         @onmouseup="EndColumnResize"
         @onmouseleave="EndColumnResize">
        <AppCssElement Tag="div" Class="listen-song-table__head" Css="@($"grid-template-columns: {GridTemplate}")" role="row">
            @foreach (var column in VisibleColumns)
            {
                if (column.Key == "select")
                {
                    <span class="listen-song-table__static-header listen-song-table__select-head" role="columnheader"><span class="sr-only">@L["Common_Select"]</span></span>
                }
                else if (Sortable && IsSortableColumn(column.Key))
                {
                    <AppNativeButton Type="button" Class="@GetSortHeaderClass(column.Key)" role="columnheader" aria-sort="@AriaSort(column.Key)" OnClick="@(() => ToggleSort(column.Key))">
                        <span>@column.Label</span>
                        @if (!string.IsNullOrWhiteSpace(SortIndicator(column.Key)))
                        {
                            <AppMaterialIcon Icon="@SortIndicator(column.Key)" Size="AppSize.Small" />
                        }
                        @if (!DeviceContext.IsTouch)
                        {
                            <span class="listen-song-table__resizer"
                                  role="separator"
                                  aria-label="@($"Resize {column.Label} column")"
                                  aria-orientation="vertical"
                                  tabindex="0"
                                  @onclick:stopPropagation="true"
                                  @onmousedown:stopPropagation="true"
                                  @onmousedown="@((args) => BeginColumnResize(column.Key, args.ClientX))"
                                  @onkeydown:stopPropagation="true"
                                  @onkeydown="@((args) => ResizeColumnByKeyboard(column.Key, args))"></span>
                        }
                    </AppNativeButton>
                }
                else
                {
                    <span class="@GetStaticHeaderClass(column.Key)"
                          role="columnheader">
                        <span>@column.Label</span>
                        @if (!DeviceContext.IsTouch)
                        {
                            <span class="listen-song-table__resizer"
                                  role="separator"
                                  aria-label="@($"Resize {column.Label} column")"
                                  aria-orientation="vertical"
                                  tabindex="0"
                                  @onmousedown:stopPropagation="true"
                                  @onmousedown="@((args) => BeginColumnResize(column.Key, args.ClientX))"
                                  @onkeydown:stopPropagation="true"
                                  @onkeydown="@((args) => ResizeColumnByKeyboard(column.Key, args))"></span>
                        }
                    </span>
                }
            }
        </AppCssElement>

        @{ var positions = PositionsOf(DisplayTracks); }
        <Virtualize Items="@DisplayTracks" Context="track" TItem="WorkViewModel" ItemSize="48" OverscanCount="8">
            @{
                var trackTitle = DisplayTrackTitle(track);
            }
            <AppCssElement Tag="div" Class="@RowClass(track)"
                 @key="track.Id"
                 Css="@($"grid-template-columns: {GridTemplate}")"
                 role="row"
                 data-listen-immediate-start="music"
                 data-listen-start-url="@(track.AssetId is { } sourceId ? $"/engine-stream/{sourceId:D}" : null)"
                 tabindex="0"
                 draggable="@CanDrag"
                 @ondragstart="@(() => StartDragAsync(track.Id))"
                 @ondragend="EndDragAsync"
                 @onclick="@(() => PlayAsync(track.Id, false))"
                 @onkeydown="@((args) => HandleRowKeyDownAsync(args, track.Id))">
                @if (ShowSelect)
                {
                    <div class="listen-song-table__select" role="cell" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                        <AppCheckbox Value="@_selected.Contains(track.Id)"
                                     ValueChanged="@(selected => SetSelected(track.Id, selected))"
                                     Dense="true"
                                     aria-label="@($"Select {trackTitle}")" />
                    </div>
                }
                <span class="listen-song-table__number" role="cell">@(positions.TryGetValue(track.Id, out var position) ? position : null)</span>
                <div class="listen-song-table__song @(ShowArtwork ? null : "listen-song-table__song--play-only")" role="cell">
                    @if (ShowArtwork)
                    {
                        <div class="listen-song-table__art @(track.IsUpdatingDetails ? "is-updating" : null)" title="@(track.IsUpdatingDetails ? "Details are being updated; playback is available" : null)">
                            @if (!string.IsNullOrWhiteSpace(track.CoverUrl))
                            {
                                <img src="@MediaTileArtworkUrl.ForDrawnSize(track.CoverUrl, 36)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(track.CoverUrl, 36)" alt="" loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.MusicNote" Size="AppSize.Small" />
                            }
                            <AppNativeButton Type="button" Class="listen-song-table__art-play" data-listen-row-play="true" Title="@L["Common_PlaySong"].Value" AriaLabel="@($" Play {trackTitle}")" StopPropagation="true" OnClick="@(() => PlayAsync(track.Id, false))">
                                <AppMaterialIcon Icon="@AppMaterialIcons.Filled.PlayArrow" Size="AppSize.Small" />
                            </AppNativeButton>
                        </div>
                    }
                    else
                    {
                        <AppNativeButton Type="button" Class="listen-song-table__play-only" data-listen-row-play="true" Title="@L["Common_PlaySong"].Value" AriaLabel="@($" Play {trackTitle}")" StopPropagation="true" OnClick="@(() => PlayAsync(track.Id, false))">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Filled.PlayArrow" Size="AppSize.Small" />
                        </AppNativeButton>
                    }
                    <span class="listen-song-table__title">@trackTitle</span>

                </div>

                @foreach (var column in VisibleDataColumns)
                {
                    @switch (column.Key)
                    {
                        case "favorite":
                            <div class="listen-song-table__favorite" role="cell">
                                <AppNativeButton Type="button" Class='@($"listen-song-table__favorite-button {(FavoriteIds.Contains(track.Id) ? " is-active" : null)}")' AriaLabel="@L["Common_ToggleFavorite"].Value" Title="@L["Common_ToggleFavorite"].Value" StopPropagation="true" OnClick="@(() => ToggleFavoriteAsync(track))">
                                    <AppMaterialIcon Icon="@(FavoriteIds.Contains(track.Id) ? AppMaterialIcons.Filled.Favorite : AppMaterialIcons.Outlined.FavoriteBorder)" Size="AppSize.Small" />
                                </AppNativeButton>
                            </div>
                            break;
                        case "time":
                            <span class="listen-song-table__time" role="cell">@GetTrackDuration(track)</span>
                            break;
                        case "artist":
                            <span class="listen-song-table__meta" role="cell">
                                @if (track.ArtistPersonId is { } artistId)
                                {
                                    <a href="@($"/details/person/{artistId:D}")" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">@StringHelpers.FirstNonBlankOr("-", track.Artist, track.Author)</a>
                                }
                                else { @StringHelpers.FirstNonBlankOr("-", track.Artist, track.Author) }
                            </span>
                            break;
                        case "album":
                            <span class="listen-song-table__meta" role="cell">
                                @if (track.RootWorkId is { } albumId && albumId != track.Id)
                                {
                                    <a href="@($"/details/musicalbum/{albumId:D}?context=listen")" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">@StringHelpers.FirstNonBlankOr("-", track.Album)</a>
                                }
                                else { @StringHelpers.FirstNonBlankOr("-", track.Album) }
                            </span>
                            break;
                        case "genre":
                            <span class="listen-song-table__meta" role="cell">@StringHelpers.FirstNonBlankOr("-", track.Genres.FirstOrDefault(), track.Genre)</span>
                            break;
                        case "plays":
                            <span class="listen-song-table__time" role="cell">@GetPlayCountDisplay(track)</span>
                            break;
                        case "dateAdded":
                            <span class="listen-song-table__meta" role="cell">@FormatDateAdded(track.CreatedAt)</span>
                            break;
                        case "edit":
                            <div class="listen-song-table__edit" role="cell" @onkeydown:stopPropagation="true">
                                @if (ShowSelect)
                                {
                                    <AppNativeButton Type="button" Class="listen-song-table__icon-button" Disabled="@track.IsUpdatingDetails" Title="@(track.IsUpdatingDetails ? "Updating details" : "Edit song")" AriaLabel="@($" Edit {trackTitle}")" StopPropagation="true" OnClick="@(() => EditAsync(track))">
                                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Edit" Size="AppSize.Small" />
                                    </AppNativeButton>
                                }
                            </div>
                            break;
                        case "options":
                            <div class="listen-song-table__options" role="cell" @onclick:stopPropagation="true">
                                @if (ShowQueue)
                                {
                                    <span class="listen-song-table__queue-hover">
                                        <AppNativeButton Type="button" Class="listen-song-table__icon-button" Title="@L["Common_AddToQueue"].Value" AriaLabel="@($" Add {trackTitle} to queue")" StopPropagation="true" OnClick="@(() => QueueAsync(track))">
                                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PlaylistAdd" Size="AppSize.Small" />
                                        </AppNativeButton>
                                    </span>
                                }
                                <AppOverflowMenu Size="AppControlSize.Compact" Class="listen-song-table__overflow">
                                    <PersonalStatusMenuItems WorkId="track.Id" />
                                    <AppMenuItem Label="@L["ListenSongTable_OpenAlbum"].Value"
                                                 Icon="@AppMaterialIcons.Outlined.Album"
                                                 Disabled="@(track.RootWorkId is null || track.RootWorkId == Guid.Empty)"
                                                 OnClick="@(() => OpenAlbumAsync(track))" />
                                    @if (ShowDelete)
                                    {
                                        <AppMenuItem Label="@L["ListenSongTable_DeleteFromLibrary"].Value"
                                                     Icon="@AppMaterialIcons.Outlined.Delete"
                                                     Tone="AppUiTone.Error"
                                                     DividerBefore="true"
                                                     OnClick="@(() => DeleteRowAsync(track))" />
                                    }
                                </AppOverflowMenu>
                            </div>
                            break;
                    }
                }
            </AppCssElement>
        </Virtualize>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<WorkViewModel> Tracks { get; set; } = [];
    [Parameter] public IReadOnlySet<Guid> FavoriteIds { get; set; } = new HashSet<Guid>();
    [Parameter] public string SourceLabel { get; set; } = "Music";
    [Parameter] public string AriaLabel { get; set; } = "Songs";
    [Parameter] public bool Sortable { get; set; } = true;
    [Parameter] public bool EnableDrag { get; set; } = true;
    [Parameter] public bool ShowArtwork { get; set; } = true;
    [Parameter] public bool ShowArtist { get; set; } = true;
    [Parameter] public bool ShowAlbum { get; set; } = true;
    [Parameter] public bool ShowGenre { get; set; }
    [Parameter] public bool ShowPlays { get; set; } = true;
    [Parameter] public bool ShowDateAdded { get; set; } = true;
    [Parameter] public bool ShowFavorite { get; set; } = true;
    [Parameter] public bool ShowQueue { get; set; } = true;
    [Parameter] public bool ShowEdit { get; set; }
    [Parameter] public Guid? CurrentWorkId { get; set; }
    [Parameter] public string DefaultSortColumn { get; set; } = "dateAdded";
    [Parameter] public bool DefaultSortDescending { get; set; } = true;
    [Parameter] public Func<IReadOnlyList<WorkViewModel>, Guid?, string?, bool, Task>? OnPlayRequested { get; set; }
    [Parameter] public Func<WorkViewModel, Task>? OnFavoriteToggled { get; set; }
    [Parameter] public Func<WorkViewModel, Task>? OnQueueRequested { get; set; }
    [Parameter] public Func<WorkViewModel, Task>? OnAlbumRequested { get; set; }
    [Parameter] public Func<WorkViewModel, Task>? OnPlayNextRequested { get; set; }

    /// <summary>Asks the host to reload its songs after the bulk panel saved changes; the table keeps its sort and selection.</summary>
    [Parameter] public Func<Task>? OnTracksChanged { get; set; }
    [Parameter] public Func<Guid, Task>? OnDragStarted { get; set; }
    [Parameter] public Func<Task>? OnDragEnded { get; set; }

    private readonly List<ListenSongTableColumn> _columns =
    [
        new("select", string.Empty, 40, 40),
        new("number", "#", 40, 36),
        new("song", "Song", 260, 150),
        new("favorite", "Favorite", 64, 56),
        new("time", "Time", 56, 52),
        new("artist", "Artist", 108, 80),
        new("album", "Album", 108, 80),
        new("genre", "Genre", 82, 60),
        new("plays", "Plays", 50, 46),
        new("dateAdded", "Date Added", 112, 88),
        new("edit", "Edit", 64, 44),
        new("options", string.Empty, 76, 52),
    ];

    // Phone cards render in pages: Virtualize spacer rows collapse to zero width inside the cards-mode table body.
    private const int PhonePageSize = 120;
    private int _phoneVisibleCount = PhonePageSize;

    private void ShowMorePhoneTracks() => _phoneVisibleCount += PhonePageSize;

    private string? _resizingColumnKey;
    private double _resizeStartX;
    private int _resizeStartWidth;
    private string? _sortColumn;
    private bool _sortDescending;

    // Delete from library (spec delete-from-library D13, D25): desktop administrators get a checkbox on each row and "Delete from library…" as the last, red item of the row's "..." menu (one-look spec WP6, F45).
    // The rule, the dialog and the toasts are LibraryItemDeletionFlow's; this table only collects the songs and hides them once gone.
    private readonly HashSet<Guid> _selected = [];
    private readonly HashSet<Guid> _removed = [];
    private UIOrchestratorService? _orchestrator;
    private bool _deleting;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _orchestrator = Services.GetService<UIOrchestratorService>();
        if (_orchestrator is not null)
        {
            _orchestrator.OnLibraryItemsRemoved += OnLibraryItemsRemoved;
        }
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(_sortColumn))
        {
            _sortColumn = DefaultSortColumn;
            _sortDescending = DefaultSortDescending;
        }

        if (_selected.Count > 0)
        {
            var present = Tracks.Select(track => track.Id).ToHashSet();
            _selected.RemoveWhere(id => !present.Contains(id));
        }
    }

    public void Dispose()
    {
        _disposed = true;
        if (_orchestrator is not null)
        {
            _orchestrator.OnLibraryItemsRemoved -= OnLibraryItemsRemoved;
        }
    }

    // Songs deleted here or in another window leave the list and the selection at once; the host page reloads behind this.
    private void OnLibraryItemsRemoved(LibraryItemsRemovedEvent removed) => _ = InvokeAsync(() =>
    {
        if (_disposed)
        {
            return;
        }

        MarkRemoved(removed.WorkIds);
        StateHasChanged();
    });

    private void MarkRemoved(IEnumerable<Guid> workIds)
    {
        foreach (var id in workIds)
        {
            _removed.Add(id);
            _selected.Remove(id);
        }
    }

    // Desktop administrators only. A phone renders cards and never reaches this; touch-only and tablet devices fail CanEdit.
    private bool _showDelete;
    private bool ShowDelete => _showDelete;

    // The tick boxes and the selection bar are for any desktop that may edit; the Engine decides who really may (the panel says so when it refuses).
    private bool _showSelect;
    private bool ShowSelect => _showSelect;

    private bool ComputeShowSelect() => !DeviceContext.IsPhone && EditorDeviceRule.CanEdit(DeviceContext);

    private bool ComputeShowDelete() => !DeviceContext.IsPhone
        && LibraryItemDeletionFlow.CanDelete(DeviceContext, Services.GetService<DashboardSessionAccessor>());

    private void SetSelected(Guid id, bool selected)
    {
        if (selected)
        {
            _selected.Add(id);
        }
        else
        {
            _selected.Remove(id);
        }
    }

    // The ticked songs in the order the list shows them, with the album each sits in, for the bulk panel.
    private IReadOnlyList<BulkEditRow> BulkRows => _selected.Count == 0
        ? []
        : [.. DisplayTracks
            .Where(track => _selected.Contains(track.Id))
            .Select(track => new BulkEditRow(
                track.Id,
                DisplayTrackTitle(track),
                DetailEntityType.Work,
                track.RootWorkId is { } album && album != track.Id && album != Guid.Empty ? album : null,
                "Music"))];

    private Task ClearSelectionAsync()
    {
        _selected.Clear();
        return Task.CompletedTask;
    }

    // Songs the bar deleted leave the list and the selection at once, as songs deleted from the row menu do.
    private Task OnDeletedAsync(IReadOnlyList<Guid> workIds)
    {
        MarkRemoved(workIds);
        return Task.CompletedTask;
    }

    // A save reached the library: the host page reloads its songs. The table's own sort, column widths and ticks stay.
    private async Task OnEditedAsync()
    {
        if (OnTracksChanged is { } changed)
        {
            await changed();
        }
    }

    internal Task DeleteRowAsync(WorkViewModel track) => DeleteAsync([track.Id], DisplayTrackTitle(track));

    private async Task DeleteAsync(IReadOnlyList<Guid> workIds, string? title)
    {
        if (workIds.Count == 0 || _deleting)
        {
            return;
        }

        // The icon and checkbox only show to an administrator on a desktop; a handler never trusts that.
        var toasts = Services.GetRequiredService<IAppToastService>();
        if (LibraryItemDeletionFlow.TryRefuse(DeviceContext, Services.GetService<DashboardSessionAccessor>(), toasts))
        {
            return;
        }

        _deleting = true;
        try
        {
            var outcome = await LibraryItemDeletionFlow.RunAsync(Services.GetRequiredService<IAppDialogService>(), toasts, workIds, title);
            if (outcome != LibraryItemDeletionFlowOutcome.Canceled)
            {
                MarkRemoved(workIds);
            }
        }
        finally
        {
            _deleting = false;
        }
    }

    // Drag and column resize are mouse affordances; touch screens use the row menu instead.
    private bool CanDrag => EnableDrag && !DeviceContext.IsTouch;

    private static string CardSubtitle(WorkViewModel track)
    {
        var artist = StringHelpers.FirstNonBlank(track.Artist, track.Author);
        var album = StringHelpers.FirstNonBlank(track.Album);
        return string.Join(" · ", new[] { artist, album }.Where(value => !string.IsNullOrWhiteSpace(value)));
    }

    private IReadOnlyList<AppRowMenuItem> CardMenuItems(WorkViewModel track)
    {
        var items = new List<AppRowMenuItem>();
        if (OnPlayNextRequested is not null)
        {
            items.Add(new AppRowMenuItem { Label = L["Common_PlayNext"].Value, Icon = AppMaterialIcons.Outlined.PlaylistPlay, OnClick = EventCallback.Factory.Create(this, () => OnPlayNextRequested(track)) });
        }

        items.Add(new AppRowMenuItem { Label = L["Common_AddToQueue"].Value, Icon = AppMaterialIcons.Outlined.PlaylistAdd, OnClick = EventCallback.Factory.Create(this, () => QueueAsync(track)) });
        items.Add(new AppRowMenuItem
        {
            Label = L["SongActions_GoToAlbum"].Value,
            Icon = AppMaterialIcons.Outlined.Album,
            Disabled = track.RootWorkId is null || track.RootWorkId == Guid.Empty,
            OnClick = EventCallback.Factory.Create(this, () => OpenAlbumAsync(track)),
        });
        items.Add(new AppRowMenuItem
        {
            Label = L["SongActions_GoToArtist"].Value,
            Icon = AppMaterialIcons.Outlined.Person,
            Disabled = track.ArtistPersonId is null,
            OnClick = EventCallback.Factory.Create(this, () => OpenArtist(track)),
        });
        return items;
    }

    private void OpenArtist(WorkViewModel track)
    {
        if (track.ArtistPersonId is { } artistId)
        {
            Navigation.NavigateTo($"/details/person/{artistId:D}");
        }
    }

    private IReadOnlyList<ListenSongTableColumn> VisibleColumns => _columns.Where(IsColumnVisible).ToList();
    private IReadOnlyList<ListenSongTableColumn> VisibleDataColumns => VisibleColumns.Where(column => column.Key is not ("select" or "number" or "song")).ToList();

    // Columns give up width down to their minimum before the table scrolls sideways, so the row menu stays in view at 1280 px.
    private string GridTemplate => string.Join(" ", VisibleColumns.Select(column => $"minmax({column.MinWidth}px, {column.Width}px)"));

    private IEnumerable<WorkViewModel> VisibleTracks => _removed.Count == 0
        ? Tracks
        : Tracks.Where(track => !_removed.Contains(track.Id));

    // Sorting a large list twice per render (rows and their numbers) would be wasteful, so the shown list is kept until something that shapes it changes.
    private List<WorkViewModel>? _shown;
    private (IReadOnlyList<WorkViewModel> Tracks, int Count, string? Column, bool Descending, int Removed, bool Sortable) _shownKey;

    private List<WorkViewModel> DisplayTracks
    {
        get
        {
            var key = (Tracks, Tracks.Count, _sortColumn, _sortDescending, _removed.Count, Sortable);
            if (_shown is null || !_shownKey.Equals(key))
            {
                _shown = Sortable ? SortTracks(VisibleTracks).ToList() : VisibleTracks.ToList();
                _shownKey = key;
            }

            return _shown;
        }
    }

    private bool IsColumnVisible(ListenSongTableColumn column) => column.Key switch
    {
        "artist" => ShowArtist,
        "album" => ShowAlbum,
        "genre" => ShowGenre,
        "plays" => ShowPlays,
        "dateAdded" => ShowDateAdded,
        "favorite" => ShowFavorite,
        "edit" => ShowEdit,
        "select" => ShowSelect,
        _ => true,
    };

    private static Dictionary<Guid, int> PositionsOf(IReadOnlyList<WorkViewModel> shown)
    {
        var positions = new Dictionary<Guid, int>(shown.Count);
        for (var index = 0; index < shown.Count; index++)
        {
            positions.TryAdd(shown[index].Id, index + 1);
        }

        return positions;
    }

    private string RowClass(WorkViewModel track) =>
        $"listen-song-table__row {(CurrentWorkId == track.Id ? "is-playing" : string.Empty)}".Trim();

    private static bool IsSortableColumn(string key) => key is not ("edit" or "select" or "number");

    private void BeginColumnResize(string key, double clientX)
    {
        var column = _columns.FirstOrDefault(item => item.Key == key);
        if (column is null)
            return;

        _resizingColumnKey = key;
        _resizeStartX = clientX;
        _resizeStartWidth = column.Width;
    }

    private void ResizeColumn(double clientX)
    {
        if (string.IsNullOrWhiteSpace(_resizingColumnKey))
            return;

        var column = _columns.FirstOrDefault(item => item.Key == _resizingColumnKey);
        if (column is null)
            return;

        column.Width = Math.Clamp(_resizeStartWidth + (int)Math.Round(clientX - _resizeStartX), column.MinWidth, 560);
    }

    private void EndColumnResize() => _resizingColumnKey = null;

    private void ResizeColumnByKeyboard(string key, KeyboardEventArgs args)
    {
        var delta = args.Key switch
        {
            "ArrowLeft" => -8,
            "ArrowRight" => 8,
            _ => 0,
        };
        if (delta == 0)
            return;

        var column = _columns.FirstOrDefault(item => item.Key == key);
        if (column is not null)
            column.Width = Math.Clamp(column.Width + delta, column.MinWidth, 560);
    }

    private void ToggleSort(string key)
    {
        if (!Sortable || !IsSortableColumn(key))
            return;

        key = NormalizeSortColumn(key);
        if (string.Equals(NormalizeSortColumn(_sortColumn), key, StringComparison.OrdinalIgnoreCase))
        {
            _sortDescending = !_sortDescending;
            return;
        }

        _sortColumn = key;
        _sortDescending = key is "dateAdded" or "plays" or "time" or "favorite";
    }

    private string SortIndicator(string key)
    {
        key = NormalizeSortColumn(key);
        return string.Equals(NormalizeSortColumn(_sortColumn), key, StringComparison.OrdinalIgnoreCase)
            ? (_sortDescending ? AppMaterialIcons.Outlined.ArrowDownward : AppMaterialIcons.Outlined.ArrowUpward)
            : string.Empty;
    }

    private string AriaSort(string key)
        => string.Equals(NormalizeSortColumn(_sortColumn), NormalizeSortColumn(key), StringComparison.OrdinalIgnoreCase)
            ? _sortDescending ? "descending" : "ascending"
            : "none";

    private IReadOnlyList<WorkViewModel> SortTracks(IEnumerable<WorkViewModel> tracks)
    {
        var ordered = NormalizeSortColumn(_sortColumn) switch
        {
            "title" => _sortDescending
                ? tracks.OrderByDescending(DisplayTrackTitle, StringComparer.OrdinalIgnoreCase)
                : tracks.OrderBy(DisplayTrackTitle, StringComparer.OrdinalIgnoreCase),
            "artist" => _sortDescending
                ? tracks.OrderByDescending(track => track.Artist ?? track.Author, StringComparer.OrdinalIgnoreCase).ThenByDescending(DisplayTrackTitle, StringComparer.OrdinalIgnoreCase)
                : tracks.OrderBy(track => track.Artist ?? track.Author, StringComparer.OrdinalIgnoreCase).ThenBy(DisplayTrackTitle, StringComparer.OrdinalIgnoreCase),
            "album" => _sortDescending
                ? tracks.OrderByDescending(track => track.Album, StringComparer.OrdinalIgnoreCase).ThenByDescending(track => ParseTrackNumber(track.TrackNumber))
                : tracks.OrderBy(track => track.Album, StringComparer.OrdinalIgnoreCase).ThenBy(track => ParseTrackNumber(track.TrackNumber)),
            "genre" => _sortDescending
                ? tracks.OrderByDescending(track => track.Genres.FirstOrDefault(), StringComparer.OrdinalIgnoreCase).ThenByDescending(DisplayTrackTitle, StringComparer.OrdinalIgnoreCase)
                : tracks.OrderBy(track => track.Genres.FirstOrDefault(), StringComparer.OrdinalIgnoreCase).ThenBy(DisplayTrackTitle, StringComparer.OrdinalIgnoreCase),
            "favorite" => _sortDescending
                ? tracks.OrderByDescending(track => FavoriteIds.Contains(track.Id)).ThenBy(DisplayTrackTitle, StringComparer.OrdinalIgnoreCase)
                : tracks.OrderBy(track => FavoriteIds.Contains(track.Id)).ThenBy(DisplayTrackTitle, StringComparer.OrdinalIgnoreCase),
            "plays" => _sortDescending
                ? tracks.OrderByDescending(GetPlayCount).ThenByDescending(DisplayTrackTitle, StringComparer.OrdinalIgnoreCase)
                : tracks.OrderBy(GetPlayCount).ThenBy(DisplayTrackTitle, StringComparer.OrdinalIgnoreCase),
            "time" => _sortDescending
                ? tracks.OrderByDescending(GetDurationSortKey).ThenByDescending(DisplayTrackTitle, StringComparer.OrdinalIgnoreCase)
                : tracks.OrderBy(GetDurationSortKey).ThenBy(DisplayTrackTitle, StringComparer.OrdinalIgnoreCase),
            "track" => _sortDescending
                ? tracks.OrderByDescending(track => ParseTrackNumber(track.TrackNumber)).ThenByDescending(DisplayTrackTitle, StringComparer.OrdinalIgnoreCase)
                : tracks.OrderBy(track => ParseTrackNumber(track.TrackNumber)).ThenBy(DisplayTrackTitle, StringComparer.OrdinalIgnoreCase),
            _ => _sortDescending
                ? tracks.OrderByDescending(track => track.CreatedAt).ThenByDescending(DisplayTrackTitle, StringComparer.OrdinalIgnoreCase)
                : tracks.OrderBy(track => track.CreatedAt).ThenBy(DisplayTrackTitle, StringComparer.OrdinalIgnoreCase),
        };

        return ordered.ToList();
    }

    private static string NormalizeSortColumn(string? column) =>
        (column ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            "song" => "title",
            "date_added" => "dateAdded",
            "track_number" => "track",
            _ => string.IsNullOrWhiteSpace(column) ? "dateAdded" : column,
        };

    private static string GetSortHeaderClass(string columnKey)
    {
        var classes = new List<string> { "listen-song-table__sort-header" };

        if (columnKey == "song")
            classes.Add("listen-song-table__song-head");

        if (columnKey == "favorite")
            classes.Add("listen-song-table__favorite-head");

        return string.Join(" ", classes);
    }

    private static string GetStaticHeaderClass(string columnKey)
    {
        var classes = new List<string> { "listen-song-table__static-header" };
        if (columnKey == "song")
            classes.Add("listen-song-table__song-head");
        if (columnKey == "favorite")
            classes.Add("listen-song-table__favorite-head");
        if (columnKey == "number")
            classes.Add("listen-song-table__number-head");
        return string.Join(" ", classes);
    }

    private Task PlayAsync(Guid? startWorkId, bool shuffle)
        => OnPlayRequested?.Invoke(DisplayTracks, startWorkId, SourceLabel, shuffle) ?? Task.CompletedTask;

    private Task ToggleFavoriteAsync(WorkViewModel track)
        => OnFavoriteToggled?.Invoke(track) ?? Task.CompletedTask;

    private Task QueueAsync(WorkViewModel track)
        => OnQueueRequested?.Invoke(track) ?? Task.CompletedTask;

    private Task OpenAlbumAsync(WorkViewModel track)
        => OnAlbumRequested?.Invoke(track) ?? Task.CompletedTask;

    private Task HandleRowKeyDownAsync(KeyboardEventArgs args, Guid trackId)
        => args.Key is "Enter" or " "
            ? PlayAsync(trackId, false)
            : Task.CompletedTask;

    // A song's Edit button ticks the song and opens the Edit panel beside the list (universal editor spec D2, D19): the list's filters, sort
    // and scroll stay where they are, and nothing opens in a pop-up.
    private Task EditAsync(WorkViewModel track)
    {
        if (!ShowSelect)
        {
            return Task.CompletedTask;
        }

        _selected.Add(track.Id);
        _openEditPanelAfterRender = true;
        return Task.CompletedTask;
    }

    private BulkEditHost? _bulkHost;
    private bool _openEditPanelAfterRender;

    protected override void OnAfterRender(bool firstRender)
    {
        // The host takes the ticked rows when this table renders; only then can its panel open for the song just ticked.
        if (_openEditPanelAfterRender && _bulkHost is not null)
        {
            _openEditPanelAfterRender = false;
            _bulkHost.OpenEditPanel();
        }
    }

    private Task StartDragAsync(Guid trackId)
        => CanDrag ? OnDragStarted?.Invoke(trackId) ?? Task.CompletedTask : Task.CompletedTask;

    private Task EndDragAsync()
        => CanDrag ? OnDragEnded?.Invoke() ?? Task.CompletedTask : Task.CompletedTask;

    private static string DisplayTrackTitle(WorkViewModel work)
        => StringHelpers.FirstNonBlank(
               IsUntitled(work.Title) ? null : work.Title,
               GetCanonicalValue(work, "track_title"),
               GetCanonicalValue(work, "track_name"),
               GetCanonicalValue(work, "song_title"),
               GetCanonicalValue(work, "name"),
               GetCanonicalValue(work, "file_title"),
               GetCanonicalValue(work, "file_name"))
           ?? work.Title;

    internal static string GetTrackDuration(WorkViewModel work)
    {
        var seconds = GetTrackDurationSeconds(work);
        return seconds > 0 ? LibraryHelpers.FormatDuration(seconds) : "–";
    }

    private static int GetDurationSortKey(WorkViewModel work)
    {
        var durationSeconds = GetTrackDurationSeconds(work);
        return durationSeconds > 0 ? (int)Math.Min(durationSeconds, int.MaxValue) : 0;
    }

    // The file's measured length wins; provider lengths only fill gaps. The plain "duration" and
    // "runtime" fields hold minutes (retail providers), so a bare number there is never read as seconds.
    internal static long GetTrackDurationSeconds(WorkViewModel work)
        => LibraryHelpers.NormalizeTrackDurationSeconds(
            GetCanonicalValue(work, "duration_sec"),
            GetCanonicalValue(work, "duration_seconds"),
            GetCanonicalValue(work, "duration"),
            GetCanonicalValue(work, "runtime")) ?? 0;

    private static string? GetCanonicalValue(WorkViewModel work, params string[] keys)
    {
        foreach (var key in keys)
        {
            var value = work.CanonicalValues.FirstOrDefault(item =>
                string.Equals(item.Key, key, StringComparison.OrdinalIgnoreCase))?.Value;

            if (!string.IsNullOrWhiteSpace(value))
                return value;
        }

        return null;
    }

    private static bool IsUntitled(string? value)
        => string.IsNullOrWhiteSpace(value)
           || value.Trim().StartsWith("Untitled", StringComparison.OrdinalIgnoreCase);

    private static string FormatDateAdded(DateTimeOffset createdAt)
        => createdAt == default ? "—" : createdAt.LocalDateTime.ToString("M/d/yyyy", CultureInfo.CurrentCulture);

    private static int GetPlayCount(WorkViewModel work)
    {
        var value = work.CanonicalValues.FirstOrDefault(item =>
            string.Equals(item.Key, "play_count", StringComparison.OrdinalIgnoreCase)
            || string.Equals(item.Key, "plays", StringComparison.OrdinalIgnoreCase))?.Value;

        return int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var plays) ? plays : 0;
    }

    private static string GetPlayCountDisplay(WorkViewModel work)
        => GetPlayCount(work) > 0 ? GetPlayCount(work).ToString(CultureInfo.InvariantCulture) : string.Empty;

    private static int ParseTrackNumber(string? value)
        => int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed) ? parsed : int.MaxValue;

    private sealed class ListenSongTableColumn
    {
        public ListenSongTableColumn(string key, string label, int width, int minWidth = 64)
        {
            Key = key;
            Label = label;
            Width = width;
            MinWidth = minWidth;
        }

        public string Key { get; }
        public string Label { get; }
        public int Width { get; set; }
        public int MinWidth { get; }
    }
}
