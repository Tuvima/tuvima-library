@namespace MediaEngine.Web.Components.Listen
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Playback
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IServiceProvider Services
@implements IAsyncDisposable
@inject IStringLocalizer<SharedStrings> L

@* The phone's Now playing (unified player v2 D26; mockup screen 15): the expanded player itself. A top line with a collapse chevron, "Playing from ..." and
   the "..." menu; large artwork; the title and artist on one line with Favorite, Like and Dislike at its right end (Favorite alone for an audiobook); the
   timeline; the transport of this media with a 64 px Play; and one row of at most four tools. Everything else (Playback settings, the item actions and,
   for music, Bookmarks) is in the "..." menu. Volume is the phone's own buttons, so there is no volume control. The tools open the same panels as the desktop
   bar, as bottom sheets over this view; the host (ListenNowPlayingBar) owns them and every playback command, and passes them in. *@
@if (Current is { } item)
{
    <div class="playback-full-owner">
    <AppCssElement Tag="section" Class="@($"playback-full playback-full--{MediaName} playback-full--phone")"
                   aria-label="@(IsBook ? L["PlaybackFullPlayer_AudiobookPlayer"].Value : L["PlaybackFullPlayer_MusicPlayer"].Value)" tabindex="-1"
                   data-playback-full data-playback-media="@MediaName" @onkeydown="HandleKeyDown" @ref="_section">
        <header class="playback-full__top">
            <AppTooltip Text="@L["PlaybackFullPlayer_CollapsePlayer"].Value">
                <AppNativeButton Type="button" Class="playback-full__collapse" AriaLabel="@L["PlaybackFullPlayer_CollapsePlayer"].Value" OnClick="CollapseAsync" data-playback-full-collapse>
                    <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.ChevronDown" />
                </AppNativeButton>
            </AppTooltip>
            <span class="playback-full__from" data-playback-full-from data-overflow-tooltip="@PlayingFrom">@PlayingFrom</span>
            <PlaybackItemMenu Media="@Media" Item="@item" Surface="dock" Snapshot="@Snapshot" Commands="@Commands" IsCurrent="@IsCurrent"
                              NavigationCompleted="@NavigationCompleted" SettingsPanel="@SettingsPanel" ExtraRows="@MenuRows" />
        </header>
        <div class="playback-full__art" data-playback-full-art>
            @if (!string.IsNullOrEmpty(PlaybackArtworkUrl.ForDrawnSize(item, 260)))
            {
                <img src="@PlaybackArtworkUrl.ForDrawnSize(item, 260)" srcset="@PlaybackArtworkUrl.SrcSetForDrawnSize(item, 260)" data-image-display="full-audio-artwork" alt="" decoding="async" />
            }
            else
            {
                <span class="playback-full__art-placeholder" aria-hidden="true"></span>
            }
        </div>
        <div class="playback-full__identity" data-playback-full-identity>
            <div class="playback-full__text">
                <div class="playback-full__title" data-overflow-tooltip="@IdentityLine.Title">@RenderLink(IdentityLine.Title, IdentityLine.TitleLinkKind, IdentityLine.TitleLinkId)</div>
                @if (IdentityLine.Secondary.Count > 0)
                {
                    <div class="playback-full__secondary" data-overflow-tooltip="@IdentityLine.SecondaryText">
                        @for (var index = 0; index < IdentityLine.Secondary.Count; index++)
                        {
                            var part = IdentityLine.Secondary[index];
                            @if (index > 0) { <span>@part.Separator</span> }
                            @RenderLink(part.Text, part.LinkKind, part.LinkId)
                        }
                    </div>
                }
            </div>
            <div class="playback-full__actions" data-playback-full-actions>
                <PlaybackIdentityActions Media="@Media" Item="@item" Surface="dock" ShowMore="false" Snapshot="@Snapshot" Commands="@Commands" IsCurrent="@IsCurrent"
                                         IsFavorite="@IsFavorite" FavoriteChanged="@FavoriteChanged" NavigationCompleted="@NavigationCompleted" />
            </div>
        </div>
        <div class="playback-full__timeline" data-playback-full-timeline aria-label="@L["PlaybackFullPlayer_PlaybackProgress"].Value">@TimelineContent</div>
        <div class="playback-full__transport" role="group" aria-label="@(IsBook ? L["Common_AudiobookControls"].Value : L["PlaybackFullPlayer_MusicPlayer"].Value)" data-playback-full-transport>
            @foreach (var control in TransportControls)
            {
                @switch (control.Key)
                {
                    case PlaybackControlKey.PlayPause:
                        <PlaybackPrimaryButton Size="phone" IsPlaying="@State.IsPlaying" NeedsUserGestureToStart="@State.NeedsUserGestureToStart"
                                               Disabled="@control.IsDisabled" AriaLabel="@control.AriaLabel"
                                               OnClick="@(() => OnTransport.InvokeAsync(control))" @attributes="PlayButtonAttributes" />
                        break;
                    case PlaybackControlKey.SkipBack:
                    case PlaybackControlKey.SkipForward:
                        <PlaybackRelativeSkipButton Size="bar" Direction="@(control.Key == PlaybackControlKey.SkipBack ? "back" : "forward")"
                                                    Seconds="@(control.Key == PlaybackControlKey.SkipBack ? State.SkipBackSeconds : State.SkipForwardSeconds)"
                                                    Disabled="@control.IsDisabled" OnClick="@(() => OnTransport.InvokeAsync(control))" />
                        break;
                    default:
                        <PlaybackIconButton Control="@control" Surface="phone" Appearance="bare" OnClick="@(() => OnTransport.InvokeAsync(control))" />
                        break;
                }
            }
        </div>
        <PlaybackToolRow Tools="@ToolControls" AriaLabel="@L["PlaybackFullPlayer_PhoneTools"].Value" HostedTools="@HostedTools" ToolContent="@ToolContent"
                         OnTransport="@OnTransport" OnTool="@OnTool" />
    </AppCssElement>
    </div>
}

@code {
    [Parameter, EditorRequired] public ListenPlaybackSnapshot Snapshot { get; set; } = new();
    [Parameter, EditorRequired] public IPlaybackCommandSink Commands { get; set; } = null!;

    /// <summary>What the transport and tools are drawn from (the same state the bar is drawn from).</summary>
    [Parameter] public PlaybackBarState State { get; set; } = new();

    /// <summary>The title and second line; without it they are built from the playing item.</summary>
    [Parameter] public PlaybackBarIdentity? Identity { get; set; }

    [Parameter] public EventCallback OnCollapse { get; set; }
    [Parameter] public bool? IsFavorite { get; set; }
    [Parameter] public EventCallback FavoriteChanged { get; set; }
    [Parameter] public EventCallback<string?> NavigationCompleted { get; set; }
    [Parameter] public Func<bool>? IsCurrent { get; set; }

    /// <summary>The timeline (the host passes its PlaybackSeekRail so the bar and this view show the same chapter or book scope).</summary>
    [Parameter] public RenderFragment? TimelineContent { get; set; }

    /// <summary>Extra attributes for the Play button (the audio bar's start-on-gesture data).</summary>
    [Parameter] public IReadOnlyDictionary<string, object>? PlayButtonAttributes { get; set; }

    [Parameter] public EventCallback<PlaybackControlDefinition> OnTransport { get; set; }
    [Parameter] public EventCallback<PlaybackControlActivation> OnTool { get; set; }
    [Parameter] public IReadOnlySet<PlaybackControlKey> HostedTools { get; set; } = new HashSet<PlaybackControlKey>();
    [Parameter] public RenderFragment<PlaybackControlDefinition>? ToolContent { get; set; }

    /// <summary>The Playback settings panel the "..." menu opens (unified player v2 D14).</summary>
    [Parameter] public RenderFragment<PlaybackAnchoredPanel>? SettingsPanel { get; set; }

    private AppCssElement? _section;
    private IJSObjectReference? _focusModule;
    private ElementReference? _focusRoot;
    private readonly SemaphoreSlim _focusLifecycle = new(1, 1);
    private bool _disposed;
    private string? _subject;

    public ElementReference Element => _section?.Element ?? default;
    private ListenQueueItem? Current => Snapshot.CurrentIndex >= 0 && Snapshot.CurrentIndex < Snapshot.Queue.Count ? Snapshot.Queue[Snapshot.CurrentIndex] : null;
    private bool IsBook => Current?.PlaybackExperience == PlaybackExperience.Audiobook;
    private PlaybackBarMedia Media => IsBook ? PlaybackBarMedia.Audiobook : PlaybackBarMedia.Music;
    private string MediaName => IsBook ? "audiobook" : "music";
    private string Subject => $"{Snapshot.ProfileId}:{Current?.WorkId}:{Current?.AssetId}:{Snapshot.PlaybackRequestVersion}";
    private PlaybackBarIdentity IdentityLine => Identity ?? PlaybackBarIdentity.Build(Media, Current!);

    // The source of the queue, else the album or the book the item belongs to, else just "Now playing".
    private string PlayingFrom
    {
        get
        {
            var name = Snapshot.SourceLabel;
            if (string.IsNullOrWhiteSpace(name)) name = IsBook ? Current?.Title : Current?.Album;
            return string.IsNullOrWhiteSpace(name) ? L["Common_NowPlaying"].Value : L["PlaybackFullPlayer_PlayingFrom", name.Trim()].Value;
        }
    }

    private IReadOnlyList<PlaybackControlDefinition> TransportControls => PlaybackControlCatalog.BuildPhoneTransport(Media, State);
    private IReadOnlyList<PlaybackControlDefinition> ToolControls => PlaybackControlCatalog.BuildPhoneTools(Media, State);

    // Music Bookmarks live in the "..." menu on a phone (the audiobook row has its own Bookmarks tool).
    private RenderFragment MenuRows => builder =>
    {
        if (IsBook || !State.CanBookmark) return;
        var bookmarks = PlaybackControlCatalog.BuildBarTools(Media, State).FirstOrDefault(control => control.Key == PlaybackControlKey.Bookmarks);
        if (bookmarks is null) return;
        builder.OpenComponent<PlaybackFullPlayerMenuRow>(0);
        builder.AddAttribute(1, nameof(PlaybackFullPlayerMenuRow.Label), L["PlaybackFullPlayer_Bookmarks"].Value);
        builder.AddAttribute(2, nameof(PlaybackFullPlayerMenuRow.Glyph), PlaybackUtilityGlyphKind.Bookmark);
        builder.AddAttribute(3, nameof(PlaybackFullPlayerMenuRow.Activated), EventCallback.Factory.Create<ElementReference>(this, trigger => OpenMenuRowAsync(bookmarks, trigger)));
        builder.CloseComponent();
    };

    private async Task OpenMenuRowAsync(PlaybackControlDefinition control, ElementReference trigger)
    {
        Services.GetService<PlaybackTransientToolCoordinator>()?.Close();
        await OnTool.InvokeAsync(new PlaybackControlActivation(control, trigger));
    }

    private RenderFragment RenderLink(string text, string? kind, Guid? id) => builder =>
    {
        if (!string.IsNullOrEmpty(kind) && id is { } target)
        {
            builder.OpenComponent<PlaybackIdentityLink>(0);
            builder.AddAttribute(1, nameof(PlaybackIdentityLink.Snapshot), Snapshot);
            builder.AddAttribute(2, nameof(PlaybackIdentityLink.Commands), Commands);
            builder.AddAttribute(3, nameof(PlaybackIdentityLink.Kind), kind);
            builder.AddAttribute(4, nameof(PlaybackIdentityLink.Id), (Guid?)target);
            builder.AddAttribute(5, nameof(PlaybackIdentityLink.Text), text);
            builder.AddAttribute(6, nameof(PlaybackIdentityLink.NavigationCompleted), NavigationCompleted);
            builder.CloseComponent();
        }
        else
        {
            builder.AddContent(7, text);
        }
    };

    protected override void OnParametersSet()
    {
        if (_subject == Subject) return;
        _subject = Subject;
        // A different song or book closes whatever panel was open for the last one.
        Services.GetService<PlaybackTransientToolCoordinator>()?.Close();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        await _focusLifecycle.WaitAsync();
        try
        {
            if (_disposed) return;
            _focusModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-full-focus.js");
            if (_disposed || _focusModule is null) return;
            if (Current is null || _section is null)
            {
                if (_focusRoot is { } previous) await _focusModule.InvokeVoidAsync("detach", previous);
                _focusRoot = null;
                return;
            }
            var root = _section.Element;
            if (_focusRoot is { } old && old.Id != root.Id) await _focusModule.InvokeVoidAsync("detach", old);
            _focusRoot = root;
            // The host captures the control that expanded the player and focuses the player itself, so the boundary only keeps Tab inside it.
            await _focusModule.InvokeVoidAsync("attach", root, Subject, false);
        }
        catch (InvalidOperationException) { }
        catch (JSDisconnectedException) { }
        finally { _focusLifecycle.Release(); }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        await _focusLifecycle.WaitAsync();
        try
        {
            if (_focusModule is not null)
            {
                if (_focusRoot is { } root) await _focusModule.InvokeVoidAsync("detach", root);
                await _focusModule.DisposeAsync();
            }
            _focusRoot = null;
        }
        catch (InvalidOperationException) { }
        catch (JSDisconnectedException) { }
        finally { _focusLifecycle.Release(); }
    }

    private async Task CollapseAsync()
    {
        Services.GetService<PlaybackTransientToolCoordinator>()?.Close();
        await OnCollapse.InvokeAsync();
    }

    // An open panel handles its own Escape first (playback-popover.js); Escape with none open collapses the player.
    private Task HandleKeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? CollapseAsync() : Task.CompletedTask;
}
