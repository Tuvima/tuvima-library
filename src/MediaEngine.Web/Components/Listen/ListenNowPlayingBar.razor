    private void HandleDeviceContextChanged()
    {
        var isMobile = DeviceContext.IsMobile;
        if (_lastDeviceContextIsMobile != isMobile)
        {
            CloseRateMenu();
            CloseSleepMenu();
            _isMusicDockMoreOpen = false;
            _lastDeviceContextIsMobile = isMobile;
        }

        _ = InvokeAsync(StateHasChanged);
    }

