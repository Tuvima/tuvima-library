@namespace MediaEngine.Web.Components.Listen
@using System.Globalization
@using System.Threading
@using System.Text.Json
@using Microsoft.JSInterop
@using MediaEngine.Contracts.Playback
@using MediaEngine.Domain.Enums
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.MediaTiles
@inject PlaybackSessionController Playback
@inject ListenContextSidebarState AudioSidebar
@inject IAudiobookBookmarkActions BookmarkActions
@inject AudiobookBookmarkActionService BookmarkActionOwner
@inject IUserPlaybackPreferencesAccessor PlaybackPreferences
@inject MediaEngine.Web.Services.Theming.DeviceContextService DeviceContext
@inject ListenAudioDragService AudioDrag
@inject MediaReactionService Reactions
@inject UIOrchestratorService Orchestrator
@inject IJSRuntime JS
@inject ILogger<ListenNowPlayingBar> Logger
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<audio @ref="_audioRef"
       id="listen-audio-engine"
       data-current-asset-id="@(Playback.CurrentItem?.AssetId?.ToString("D"))"
       data-playback-request-version="@Playback.PlaybackRequestVersion"
       class="listen-player__audio-native"
       @onloadedmetadata="HandleAudioMetricsChangedAsync"
       @ondurationchange="HandleAudioMetricsChangedAsync"
       @onplay="HandleAudioStarted"
       @onpause="HandleAudioPaused"
       @onerror="HandleAudioErrorAsync">
</audio>

@if (!string.IsNullOrWhiteSpace(_playbackRestoreError))
{
    <div class="listen-player__restore-status" role="status">
        <span>@_playbackRestoreError</span>
        <AppNativeButton Type="button" OnClick="RetryPlaybackStateRestoreAsync" AriaLabel="Retry playback state restore">Retry</AppNativeButton>
    </div>
}

@if (_bookmarkDialogContext is not null && _bookmarkDialogSnapshot is not null)
{
    <AudiobookBookmarkDialog Context="@_bookmarkDialogContext"
                             Actions="@BookmarkActions"
                             AuthorizedAssetIds="@_bookmarkAuthorizedAssetIds"
                             WorkTitle="@(_bookmarkWorkTitle ?? "Audiobook")"
                             IsMobile="@DeviceContext.IsMobile"
                             Trigger="@_bookmarkTrigger"
                             OnClose="DismissBookmarkDialogAsync" />
}

@if (Playback.HasQueue && Playback.CurrentItem is not null && !Playback.IsVideoMode)
{
    <div class="@PlayerShellClass"
         @ref="_playerShellRef"
         tabindex="0"
         @onkeydown="HandlePlayerKeyDown"
         @ondragover:preventDefault="true"
         @ondrop:preventDefault="true"
         @ondrop="QueueDraggedItemsAsync">
        @if (_isMusicDockMoreOpen)
        {
            <div class="listen-player-panel-backdrop" role="presentation" aria-hidden="true" @onclick="ClosePlaybackPanel"></div>
            <aside class="listen-player-panel listen-player-panel--shared listen-player-panel--more listen-player-panel--music-more">
                <PlaybackToolSheet Title="More music tools"
                                   Subtitle="Queue, lyrics, and listening history"
                                   Icon="@Icons.Material.Outlined.Tune"
                                   Surface="panel"
                                   Modal="true"
                                   OnClose="CloseBottomPanelAsync">
                    <div class="listen-player__more-volume" aria-label="More music playback controls">
                        <AppNativeButton Type="button" Class="listen-player__icon" OnClick="ToggleMuteAsync" AriaLabel="@(Playback.IsMuted ? "Unmute" : "Mute")" title="@(Playback.IsMuted ? "Unmute" : "Mute")">
                            <PlaybackUtilityGlyph Glyph="@(Playback.IsMuted || Playback.Volume <= 0 ? PlaybackUtilityGlyphKind.Mute : PlaybackUtilityGlyphKind.Volume)" />
                        </AppNativeButton>
                        <PlaybackRangeSlider Surface="panel" Min="0" Max="1" Step="@VolumeStep" Value="@Playback.Volume" ShowTicks="false" CommitOnChange="true" AriaLabel="Volume" ValueFormatter="FormatVolumeValue" ValueChanged="SetVolumeOnHostAsync" />
                    </div>
                    <PlaybackControlStrip Controls="@MusicMoreControls" Surface="expanded" Size="compact" Class="listen-player__more-tools listen-player__music-more-tools" AriaLabel="More music tools" OnControl="HandleMusicDockMoreControl" />
                </PlaybackToolSheet>
            </aside>
        }

        <PlaybackMiniPlayer Experience="@CurrentMiniPlayerExperience" Class="@($"listen-player {(Playback.IsAudiobookMode ? "listen-player--audiobook" : "listen-player--music")}")" AriaLabel="Now playing mini player">
            <div class="listen-player__meta">
                <div class="listen-player__thumb">
                    @if (!string.IsNullOrWhiteSpace(Playback.CurrentItem.CoverUrl))
                    {
                        <img src="@(ArtworkUrl(Playback.CurrentItem.CoverUrl, "s"))" srcset="@ArtworkSrcSet(Playback.CurrentItem.CoverUrl)" sizes="56px" alt="@Playback.CurrentItem.Title" decoding="async" />
                    }
                    else
                    {
                        <MudIcon Icon="@FallbackIconFor(Playback.CurrentItem)" Class="listen-player__thumbnail-fallback" />
                    }
                </div>

                <div class="listen-player__copy">
                    <div class="listen-player__title">
                        @if (Playback.IsAudiobookMode && Playback.CurrentChapter is { } miniCurrentChapter)
                        {
                            @miniCurrentChapter.Title
                        }
                        else if (Playback.IsAudiobookMode && !string.IsNullOrWhiteSpace(Playback.CurrentItem.Subtitle) && !string.Equals(Playback.CurrentItem.Subtitle, Playback.CurrentItem.Title, StringComparison.OrdinalIgnoreCase))
                        {
                            @Playback.CurrentItem.Subtitle
                        }
                        else if (Playback.IsAudiobookMode && ListenPlaybackIdentityRoutes.Audiobook(Playback.CurrentItem) is { } miniBookFallbackRoute)
                        {
                            <a href="@miniBookFallbackRoute">@Playback.CurrentItem.Title</a>
                        }
                        else if (Playback.IsAudiobookMode)
                        {
                            @Playback.CurrentItem.Title
                        }
                        else if (Playback.IsMusicMode && ListenPlaybackIdentityRoutes.Album(Playback.CurrentItem) is { } miniAlbumRoute)
                        {
                            <a href="@miniAlbumRoute">@Playback.CurrentItem.Title</a>
                        }
                        else { @Playback.CurrentItem.Title }
                    </div>
                    <div class="listen-player__subtitle">
                        @if (Playback.IsAudiobookMode)
                        {
                            @if (ListenPlaybackIdentityRoutes.Audiobook(Playback.CurrentItem) is { } audiobookRoute)
                            {
                                <a href="@audiobookRoute">@Playback.CurrentItem.Title</a>
                            }
                            else { @Playback.CurrentItem.Title }
                            @if (Playback.CurrentItem.Authors.Count > 0)
                            {
                                <span> · </span>
                                @for (var authorIndex = 0; authorIndex < Playback.CurrentItem.Authors.Count; authorIndex++)
                                {
                                    var author = Playback.CurrentItem.Authors[authorIndex];
                                    @if (authorIndex > 0) { <text>; </text> }
                                    @if (ListenPlaybackIdentityRoutes.Contributor(author) is { } authorRoute)
                                    {
                                        <a href="@authorRoute">@author.Name</a>
                                    }
                                    else { @author.Name }
                                }
                            }
                            else if (!string.IsNullOrWhiteSpace(Playback.CurrentItem.AuthorName))
                            {
                                <span> · @Playback.CurrentItem.AuthorName</span>
                            }
                        }
                        else if (Playback.IsMusicMode && ListenPlaybackIdentityRoutes.Artist(Playback.CurrentItem) is { } artistRoute)
                        {
                            <a href="@artistRoute">@PlayerSubtitleFor(Playback.CurrentItem, Playback.SourceLabel)</a>
                        }
                        else { @PlayerSubtitleFor(Playback.CurrentItem, Playback.SourceLabel) }
                    </div>
                    @if (!Playback.IsAudiobookMode && !string.IsNullOrWhiteSpace(Playback.CurrentItem.Album))
                    {
                        <div class="listen-player__context">
                            @if (Playback.IsMusicMode && ListenPlaybackIdentityRoutes.Album(Playback.CurrentItem) is { } albumRoute)
                            {
                                <a href="@albumRoute">@Playback.CurrentItem.Album</a>
                            }
                            else { @Playback.CurrentItem.Album }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Playback.CurrentError))
                    {
                        <div class="listen-player__error">@Playback.CurrentError</div>
                    }
                </div>
                <AppNativeButton Type="button" Class="listen-player__mini-open" OnClick="OpenNowPlaying" AriaLabel="Open full player" title="Open full player" />
            </div>

            <div class="listen-player__transport">
                <div class="listen-player__transport-line">
                    <ListenTransportControls Variant="bar"
                                             PrimaryAppearance="@(Playback.IsAudiobookMode ? "dock" : "standard")"
                                             IsAudiobookMode="@Playback.IsAudiobookMode"
                                             IsPlaying="@Playback.IsPlaying"
                                             NeedsUserGestureToStart="@Playback.NeedsUserGestureToStart"
                                             IsMuted="@Playback.IsMuted"
                                             HasChapters="@(Playback.CurrentItem?.Chapters.Count is > 0)"
                                             CanPreviousTrack="@(Playback.CurrentIndex > 0)"
                                             CanNextTrack="@CanPlayNext"
                                             SkipBackSeconds="@Playback.SkipBackSeconds"
                                             SkipForwardSeconds="@Playback.SkipForwardSeconds"
                                             CurrentBrowserStreamUrl="@Playback.CurrentBrowserStreamUrl"
                                             CurrentTimeSeconds="@Playback.CurrentTimeSeconds"
                                             PlaybackRate="@Playback.PlaybackRate"
                                             Volume="@Playback.Volume"
                                             ShowMusicModeButtons="@Playback.IsMusicMode"
                                             ShuffleEnabled="@Playback.ShuffleEnabled"
                                             RepeatEnabled="@(Playback.RepeatMode != PlayerRepeatModes.Off)"
                                             OnTogglePlay="TogglePlayPauseAsync"
                                             OnPreviousTrack="PlayPreviousAsync"
                                             OnNextTrack="PlayNextAsync"
                                             OnPreviousChapter="PlayPreviousChapterAsync"
                                             OnNextChapter="PlayNextChapterAsync"
                                             OnSkipBack="SkipBackAsync"
                                             OnSkipForward="SkipForwardAsync"
                                             OnShuffle="ToggleShuffleFromDockAsync"
                                             OnRepeat="CycleRepeatFromDockAsync" />
                </div>
                <div class="listen-player__progress">
                    <span>@FormatTimestamp(Playback.CurrentTimeSeconds)</span>
                    <PlaybackRangeSlider Surface="dock" Min="0" Max="@ProgressMax" Step="1"
                                         Value="@Math.Min(Playback.CurrentTimeSeconds, ProgressMax)"
                                         ShowTicks="false" CommitOnChange="true" Class="listen-player__progress-slider"
                                         AriaLabel="Playback position" ValueFormatter="@(_ => ProgressValueText)"
                                         ValueChanged="SeekOnHostAsync" />
                    <span>-@FormatTimestamp(Math.Max(0, Playback.DurationSeconds - Playback.CurrentTimeSeconds))</span>
                </div>
            </div>

            <div class="listen-player__actions">
                @if (Playback.IsAudiobookMode)
                {
                    <div class="listen-player__audiobook-controls">
                        <PlaybackControlStrip Controls="@AudiobookDockControls"
                                              Surface="dock"
                                              Appearance="bare"
                                              Size="compact"
                                              Class="listen-player__audiobook-actions"
                                              AriaLabel="Audiobook playback tools"
                                              SpeedValue="@Playback.PlaybackRate"
                                              SpeedChanged="SetAudiobookSpeedAsync"
                                              SpeedMenuOpen="@(_rateMenuOpen && _rateMenuSurface == "dock")"
                                              SpeedMenuOpenChanged="HandleRateMenuOpenChangedAsync"
                                              SleepTimerState="@Playback.SleepTimerState"
                                              SleepTimerAvailability="@Playback.SleepTimerAvailability"
                                              SleepTimerOptionsMinutes="@Playback.SleepTimerOptionsMinutes"
                                              SleepTimerChanged="SetAudiobookSleepTimerSelectionAsync"
                                              SleepMenuOpen="@(_sleepMenuOpen && _sleepMenuSurface == "dock")"
                                              SleepMenuOpenChanged="HandleSleepMenuOpenChangedAsync"
                                              OnControlActivation="HandleAudiobookDockActivationAsync" />
                        <PlaybackIconButton Control="@AudiobookMuteControl"
                                            Surface="dock"
                                            Appearance="bare"
                                            Size="compact"
                                            Class="listen-player__audiobook-mute"
                                            OnClick="ToggleMuteAsync" />
                        <span class="listen-player__audiobook-volume" title="Volume">
                            <PlaybackRangeSlider Surface="dock" Min="0" Max="1" Step="@VolumeStep" Value="@Playback.Volume" ShowTicks="false" CommitOnChange="true" Class="listen-player__volume-slider" AriaLabel="Volume" ValueFormatter="FormatVolumeValue" ValueChanged="SetVolumeOnHostAsync" />
                        </span>
                    </div>
                    <div class="listen-player__window-actions listen-player__window-actions--audiobook">
                        <AppNativeButton Type="button" Class="listen-player__icon listen-player__now-playing" OnClick="OpenNowPlaying" AriaLabel="Open Now Playing" title="Open Now Playing">
                            <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Expand" />
                        </AppNativeButton>
                        <AppNativeButton Type="button" Class="listen-player__icon listen-player__popup" OnClick="OpenPopupAsync" AriaLabel="Open separate player window" title="Open separate player window" data-listen-popup-route="@PopupRoute">
                            <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Popup" />
                        </AppNativeButton>
                        <AppNativeButton Type="button" Class="listen-player__icon listen-player__close" OnClick="ClosePlayerAsync" AriaLabel="Close player" title="Close player">
                            <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Close" />
                        </AppNativeButton>
                    </div>
                }
                else
                {
                    <PlaybackControlStrip Controls="@MusicDockControls"
                                      Surface="dock"
                                      Size="compact"
                                      Class="listen-player__music-actions"
                                      AriaLabel="Music tools"
                                      OnControl="HandleMusicPanelControl" />
                    <AppNativeButton Type="button" Class="listen-player__icon listen-player__music-more" OnClick="OpenMusicDockMore" AriaLabel="More music controls" title="More music controls" aria-haspopup="dialog" aria-expanded="@(_isMusicDockMoreOpen ? "true" : "false")">
                        <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.More" />
                    </AppNativeButton>
                }
                @if (!Playback.IsAudiobookMode)
                {
                    <span class="listen-player__volume">
                        <AppNativeButton Type="button" Class="listen-player__icon" OnClick="ToggleMuteAsync" AriaLabel="Mute or unmute" title="Mute or unmute">
                            <PlaybackUtilityGlyph Glyph="@(Playback.IsMuted || Playback.Volume <= 0 ? PlaybackUtilityGlyphKind.Mute : PlaybackUtilityGlyphKind.Volume)" />
                        </AppNativeButton>
                        <PlaybackRangeSlider Surface="dock" Min="0" Max="1" Step="@VolumeStep" Value="@Playback.Volume" ShowTicks="false" CommitOnChange="true" Class="listen-player__volume-slider" AriaLabel="Volume" ValueFormatter="FormatVolumeValue" ValueChanged="SetVolumeOnHostAsync" />
                    </span>
                <AppNativeButton Type="button" Class="listen-player__icon listen-player__expand" OnClick="OpenNowPlaying" AriaLabel="Open Now Playing" title="Open Now Playing">
                    <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Expand" />
                </AppNativeButton>
                <AppNativeButton Type="button" Class="listen-player__icon listen-player__popup" OnClick="OpenPopupAsync" AriaLabel="Open separate player window" title="Open separate player window" data-listen-popup-route="@PopupRoute">
                    <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Popup" />
                </AppNativeButton>
                <AppNativeButton Type="button" Class="listen-player__icon" OnClick="ClosePlayerAsync" AriaLabel="Close player" title="Close player">
                    <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Close" />
                </AppNativeButton>
                }
            </div>
        </PlaybackMiniPlayer>
        @if (Playback.PresentationSurface == PlaybackPresentationSurface.NowPlaying)
        {
            <AppCssElement Tag="div"
                           Class="listen-now-playing-vars"
                           Css="@NowPlayingBackdropStyle"
                           >
            <section class="@(Playback.IsMusicMode ? "listen-now-playing listen-now-playing--music" : "listen-now-playing listen-now-playing--audiobook")"
                           role="region"
                           aria-label="Now Playing"
                           tabindex="-1"
                           @onkeydown="HandleNowPlayingKeyDown"
                           @ref="_nowPlayingSection">
                <header class="listen-now-playing__header">
                    <span>Now Playing · @(Playback.IsAudiobookMode ? "Audiobook" : "Music")</span>
                    <div class="listen-now-playing__header-actions">
                        <AppNativeButton Type="button" Class="listen-now-playing__icon" OnClick="OpenPopupAsync" AriaLabel="Open separate player window" title="Open separate player window" data-listen-popup-route="@PopupRoute">
                        <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Popup" />
                        </AppNativeButton>
                        <AppNativeButton Type="button" Class="listen-now-playing__icon" OnClick="CloseNowPlaying" AriaLabel="Collapse Now Playing" title="Collapse Now Playing">
                        <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Collapse" />
                        </AppNativeButton>
                    </div>
                </header>
                <div class="listen-now-playing__body">
                    <div class="listen-now-playing__artwork">
                        @if (!string.IsNullOrWhiteSpace(Playback.CurrentItem.CoverUrl))
                        {
                            <img src="@(ArtworkUrl(Playback.CurrentItem.CoverUrl, "m"))"
                                 srcset="@ArtworkSrcSet(Playback.CurrentItem.CoverUrl)"
                                 sizes="@NowPlayingArtworkSizes"
                                 alt="" decoding="async" />
                        }
                        else
                        {
                            <MudIcon Icon="@FallbackIconFor(Playback.CurrentItem)" />
                        }
                    </div>
                    <div class="listen-now-playing__content">
                        <p class="listen-now-playing__eyebrow">@(Playback.IsAudiobookMode ? "YOUR AUDIOBOOK" : "NOW PLAYING")</p>
                        <div class="listen-now-playing__title-row">
                            <h1>
                                @if (Playback.IsAudiobookMode && ListenPlaybackIdentityRoutes.Audiobook(Playback.CurrentItem) is { } bookRoute)
                                {
                                    <a href="@bookRoute">@Playback.CurrentItem.Title</a>
                                }
                                else if (Playback.IsMusicMode && ListenPlaybackIdentityRoutes.Album(Playback.CurrentItem) is { } albumTitleRoute)
                                {
                                    <a href="@albumTitleRoute">@Playback.CurrentItem.Title</a>
                                }
                                else { @Playback.CurrentItem.Title }
                            </h1>
                            @if (Playback.IsMusicMode && Playback.CurrentItem.WorkId != Guid.Empty)
                            {
                                <AppNativeButton Type="button" Class="listen-now-playing__favorite" OnClick="ToggleFavoriteAsync" AriaLabel="@(_isFavorite ? "Remove song from Favorites" : "Add song to Favorites")" aria-pressed="@(_isFavorite ? "true" : "false")" title="@(_isFavorite ? "Remove song from Favorites" : "Add song to Favorites")">
                                    <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Favorite" />
                                </AppNativeButton>
                            }
                        </div>
                        <div class="listen-now-playing__byline">
                            @if (Playback.IsAudiobookMode)
                            {
                                @if (Playback.CurrentItem.Authors.Count > 0)
                                {
                                    <span class="listen-now-playing__author">By @for (var authorIndex = 0; authorIndex < Playback.CurrentItem.Authors.Count; authorIndex++)
                                    {
                                        var author = Playback.CurrentItem.Authors[authorIndex];
                                        @if (authorIndex > 0) { <text>; </text> }
                                        @if (ListenPlaybackIdentityRoutes.Contributor(author) is { } authorRoute)
                                        {
                                            <a href="@authorRoute">@author.Name</a>
                                        }
                                        else { @author.Name }
                                    }</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(Playback.CurrentItem.AuthorName))
                                {
                                    <span class="listen-now-playing__author">By @Playback.CurrentItem.AuthorName</span>
                                }
                                @if (Playback.CurrentItem.Narrators.Count > 0)
                                {
                                    <span class="listen-now-playing__narrator">Narrated by @for (var narratorIndex = 0; narratorIndex < Playback.CurrentItem.Narrators.Count; narratorIndex++)
                                    {
                                        var narrator = Playback.CurrentItem.Narrators[narratorIndex];
                                        @if (narratorIndex > 0) { <text>; </text> }
                                        @if (ListenPlaybackIdentityRoutes.Contributor(narrator) is { } narratorRoute)
                                        {
                                            <a href="@narratorRoute">@narrator.Name</a>
                                        }
                                        else { @narrator.Name }
                                    }</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(Playback.CurrentItem.NarratorName))
                                {
                                    <span class="listen-now-playing__narrator">Narrated by @Playback.CurrentItem.NarratorName</span>
                                }
                            }
                            else if (ListenPlaybackIdentityRoutes.Artist(Playback.CurrentItem) is { } personRoute)
                            {
                                <span class="listen-now-playing__artist"><a href="@personRoute">@PlayerSubtitleFor(Playback.CurrentItem, Playback.SourceLabel)</a></span>
                            }
                            else
                            {
                                <span class="listen-now-playing__artist">@PlayerSubtitleFor(Playback.CurrentItem, Playback.SourceLabel)</span>
                            }
                            @if (Playback.IsMusicMode && ListenPlaybackIdentityRoutes.Album(Playback.CurrentItem) is { } albumRoute && !string.IsNullOrWhiteSpace(Playback.CurrentItem.Album))
                            {
                                <span class="listen-now-playing__album"><a href="@albumRoute">@Playback.CurrentItem.Album</a></span>
                            }
                            @if (ListenPlaybackIdentityRoutes.Playlist(Playback.CurrentItem) is { } playlistRoute && !string.IsNullOrWhiteSpace(Playback.SourceLabel))
                            {
                                <span class="listen-now-playing__source">Playing from <a href="@playlistRoute">@Playback.SourceLabel</a></span>
                            }
                        </div>
                        @if (!DeviceContext.IsMobile && Playback.IsAudiobookMode && !string.IsNullOrWhiteSpace(Playback.CurrentItem.Synopsis))
                        {
                            <p class="listen-now-playing__synopsis">@Playback.CurrentItem.Synopsis</p>
                        }
                        @if (Playback.IsAudiobookMode && OverallBookProgress is { } bookProgress)
                        {
                            <div class="listen-now-playing__overall">
                                <div><span>@bookProgress.Label</span><span>@Math.Round(bookProgress.Position / bookProgress.Total * 100)%</span></div>
                            <PlaybackRangeSlider Surface="@(DeviceContext.IsMobile ? "phone" : "expanded")" Min="0" Max="@bookProgress.Total" Value="@bookProgress.Position" ShowTicks="false"
                                                     ReadOnly="true" SnapValueToStep="false" AriaLabel="Book progress"
                                                     ValueFormatter="@(value => $"{Math.Round(value / bookProgress.Total * 100)}%")" />
                            </div>
                        }
                        @if (DeviceContext.IsMobile || Playback.IsAudiobookMode)
                        {
                            <div class="listen-now-playing__timeline @(Playback.IsAudiobookMode && !DeviceContext.IsMobile ? "listen-now-playing__timeline--read-only" : null)">
                                @if (Playback.IsAudiobookMode)
                                {
                                    <div class="listen-now-playing__progress-heading"><strong>Chapter progress</strong></div>
                                }
                                <PlaybackRangeSlider Surface="@(DeviceContext.IsMobile ? "phone" : "expanded")" Min="0" Max="@NowPlayingTimelineMax" Step="1"
                                                     Value="@NowPlayingTimelinePosition" ShowTicks="false" CommitOnChange="true"
                                                     ReadOnly="@(Playback.IsAudiobookMode && !DeviceContext.IsMobile)"
                                                     AriaLabel="@(Playback.IsAudiobookMode ? "Chapter position" : "Playback position")"
                                                     ValueFormatter="@NowPlayingPositionText"
                                                     ValueChanged="@SeekNowPlayingPositionAsync" />
                                <div><span>@FormatTimestamp(NowPlayingTimelinePosition)</span><span>-@FormatTimestamp(Math.Max(0, NowPlayingTimelineMax - NowPlayingTimelinePosition))</span></div>
                            </div>
                            @if (Playback.IsAudiobookMode && Playback.CurrentChapter is { } chapter)
                            {
                                <div class="listen-now-playing__chapter">@chapter.Title</div>
                            }
                        }
                        @if (DeviceContext.IsMobile)
                        {
                        <ListenTransportControls Variant="phone"
                                                 IsAudiobookMode="@Playback.IsAudiobookMode"
                                                 IsPlaying="@Playback.IsPlaying"
                                                 NeedsUserGestureToStart="@Playback.NeedsUserGestureToStart"
                                                 IsMuted="@Playback.IsMuted"
                                                 HasChapters="@(CurrentChapters.Count > 0)"
                                                 CanPreviousTrack="@(Playback.CurrentIndex > 0)"
                                                 CanNextTrack="@CanPlayNext"
                                                 SkipBackSeconds="@Playback.SkipBackSeconds"
                                                 SkipForwardSeconds="@Playback.SkipForwardSeconds"
                                                 CurrentBrowserStreamUrl="@Playback.CurrentBrowserStreamUrl"
                                                 CurrentTimeSeconds="@Playback.CurrentTimeSeconds"
                                                 PlaybackRate="@Playback.PlaybackRate"
                                                 Volume="@Playback.Volume"
                                                 OnTogglePlay="TogglePlayPauseAsync"
                                                 OnPreviousTrack="PlayPreviousAsync"
                                                 OnNextTrack="PlayNextAsync"
                                                 OnPreviousChapter="PlayPreviousChapterAsync"
                                                 OnNextChapter="PlayNextChapterAsync"
                                                 OnSkipBack="SkipBackAsync"
                                                 OnSkipForward="SkipForwardAsync" />
                        <PlaybackControlStrip Controls="@(Playback.IsAudiobookMode ? AudiobookPanelControls : MusicNowPlayingControls)"
                                              Surface="phone"
                                              Size="standard"
                                              Class="listen-now-playing__tools"
                                              AriaLabel="Now Playing tools"
                                              SpeedValue="@Playback.PlaybackRate"
                                              SpeedChanged="SetAudiobookSpeedAsync"
                                              SpeedMenuOpen="@(_rateMenuOpen && _rateMenuSurface == "phone")"
                                              SpeedMenuOpenChanged="HandleRateMenuOpenChangedAsync"
                                              SleepTimerState="@Playback.SleepTimerState"
                                              SleepTimerAvailability="@Playback.SleepTimerAvailability"
                                              SleepTimerOptionsMinutes="@Playback.SleepTimerOptionsMinutes"
                                              SleepTimerChanged="SetAudiobookSleepTimerSelectionAsync"
                                              SleepMenuOpen="@(_sleepMenuOpen && _sleepMenuSurface == "phone")"
                                              SleepMenuOpenChanged="HandleSleepMenuOpenChangedAsync"
                                              OnControlActivation="HandleNowPlayingToolActivationAsync" />
                        @if (Playback.IsMusicMode && MusicSecondaryControls.Count > 0)
                        {
                            <PlaybackControlStrip Controls="@MusicSecondaryControls" Surface="phone" Size="compact" Class="listen-now-playing__secondary-tools" AriaLabel="More music tools" OnControl="HandleNowPlayingToolControl" />
                        }
                        }
                        else if (Playback.IsMusicMode)
                        {
                            <PlaybackControlStrip Controls="@MusicDesktopContextControls" Surface="expanded" Size="compact" Class="listen-now-playing__tools listen-now-playing__tools--desktop-context" AriaLabel="Music context tools" OnControl="HandleNowPlayingToolControl" />
                        }
                    </div>
                </div>
            </section>
            </AppCssElement>
        }
    </div>
}

@code {
    private const string PopupRoute = "/listen/player-popup";
    private static string ArtworkUrl(string? source, string size)
        => MediaTileArtworkUrl.Sized(source, size) ?? source ?? string.Empty;
    private static string? ArtworkSrcSet(string? source)
        => MediaTileArtworkUrl.SrcSet(
            MediaTileArtworkUrl.Sized(source, "s"),
