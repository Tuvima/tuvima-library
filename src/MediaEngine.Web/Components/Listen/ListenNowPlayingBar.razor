@namespace MediaEngine.Web.Components.Listen
@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.JSInterop
@using MediaEngine.Contracts.Playback
@using MediaEngine.Domain.Enums
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.MediaTiles
@inject PlaybackSessionController Playback
@inject ListenAudioDragService AudioDrag
@inject IEngineApiClient ApiClient
@inject MediaReactionService Reactions
@inject UIOrchestratorService Orchestrator
@inject IJSRuntime JS
@inject ILogger<ListenNowPlayingBar> Logger
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<audio @ref="_audioRef"
       id="listen-audio-engine"
       class="listen-player__audio-native"
       @onloadedmetadata="HandleAudioMetricsChangedAsync"
       @ondurationchange="HandleAudioMetricsChangedAsync"
       @onplay="HandleAudioStarted"
       @onpause="HandleAudioPaused"
       @onerror="HandleAudioErrorAsync"
       @onended="HandleAudioEndedAsync">
</audio>

@if (Playback.HasQueue && Playback.CurrentItem is not null && !Playback.IsVideoMode)
{
    <div class="@PlayerShellClass"
         @ref="_playerShellRef"
         tabindex="0"
         @onkeydown="HandlePlayerKeyDown"
         @ondragover:preventDefault="true"
         @ondrop:preventDefault="true"
         @ondrop="QueueDraggedItemsAsync">
        @if (Playback.IsPanelOpen)
        {
            <div class="listen-player-panel-backdrop" role="presentation" aria-hidden="true" @onclick="Playback.ClosePanel"></div>
            <aside class="@($"listen-player-panel listen-player-panel--shared {(Playback.IsAudiobookMode ? "listen-player-panel--audiobook" : null)} {(Playback.ActiveTab == ListenPlaybackTabs.Lyrics ? "listen-player-panel--lyrics" : null)}")">
                @if (Playback.IsAudiobookMode)
                {
                    <PlaybackToolSheet Title="@BottomPanelTitle"
                                       Subtitle="@BottomPanelSubtitle"
                                       Icon="@BottomPanelIcon"
                                       Surface="panel"
                                       OnClose="CloseBottomPanelAsync">
                    @switch (_activeAudiobookPanelTool)
                    {
                        case "speed":
                            <PlaybackSpeedControl Value="@Playback.PlaybackRate"
                                                  ValueChanged="SetAudiobookSpeedAsync"
                                                  Size="compact"
                                                  Class="listen-player-panel__speed-control" />
                            break;
                        case "chapters":
                            <div class="listen-player-panel__tool-list">
                                @if (CurrentChapters.Count == 0)
                                {
                                    <div class="listen-player-panel__empty">No timed chapters were found for this audiobook.</div>
                                }
                                else
                                {
                                    @foreach (var chapter in CurrentChapters)
                                    {
                                        var isActive = IsCurrentChapter(chapter);
                                        <AppNativeButton Type="button" Class="@($"listen-player-panel__tool-row listen-player-panel__tool-row--chapter {(isActive ? "is-active" : null)}")" OnClick="@(() => PlayAudiobookChapterFromPanelAsync(chapter.Index))" AriaLabel="@($"Play {chapter.Title}")" title="@($"Play {chapter.Title}")" data-playback-active-chapter="@(isActive ? "true" : null)">
                                            <span class="listen-player-panel__tool-copy">
                                                <strong>@chapter.Title</strong>
                                            </span>
                                            <span class="listen-player-panel__tool-duration">@ChapterDuration(chapter)</span>
                                        </AppNativeButton>
                                    }
                                }
                            </div>
                            break;
                        case "history":
                            <div class="listen-player-panel__tool-list">
                                @if (Playback.AudiobookHistory.Count == 0)
                                {
                                    <div class="listen-player-panel__empty">Recent listening positions will appear here.</div>
                                }
                                else
                                {
                                    <PlaybackPositionList Class="listen-player-panel__position-list">
                                        @foreach (var item in Playback.AudiobookHistory)
                                        {
                                            <PlaybackPositionRow Class="listen-player-panel__history-row"
                                                                 Size="compact"
                                                                 Presentation="list"
                                                                 Title="@HistoryTitle(item)"
                                                                 PositionText="@HistoryPositionText(item)"
                                                                 TimestampText="@HistorySubtitle(item)"
                                                                 OnClick="@(() => PlayAudiobookHistoryFromPanelAsync(item))"
                                                                 AriaLabel="@($"Resume {HistoryTitle(item)} from {HistoryPositionText(item)}")" />
                                        }
                                    </PlaybackPositionList>
                                }
                            </div>
                            break;
                        case "bookmarks":
                            <div class="listen-player-panel__sheet-toolbar">
                                <PlaybackPositionRow Class="listen-player-panel__bookmark-add"
                                                     Kind="add"
                                                     Size="compact"
                                                     Title="@($"Add bookmark at {FormatTimestamp(Playback.CurrentTimeSeconds)}")"
                                                     LeadingIcon="@Icons.Material.Outlined.BookmarkAdd"
                                                     ActionIcon="@Icons.Material.Outlined.ChevronRight"
                                                     ActionLabel=""
                                                     ActionVariant="plain"
                                                     OnClick="AddAudiobookBookmarkFromPanelAsync"
                                                     AriaLabel="Add bookmark at current position" />
                            </div>
                            <div class="listen-player-panel__tool-list">
                                @if (Playback.AudiobookBookmarks.Count == 0)
                                {
                                    <div class="listen-player-panel__empty">No bookmarks yet.</div>
                                }
                                else
                                {
                                    <PlaybackPositionList Class="listen-player-panel__position-list">
                                        @foreach (var bookmark in Playback.AudiobookBookmarks)
                                        {
                                            <PlaybackPositionRow Class="listen-player-panel__bookmark-row"
                                                                 Size="compact"
                                                                 Presentation="list"
                                                                 Title="@BookmarkTitle(bookmark)"
                                                                 PositionText="@BookmarkPositionText(bookmark)"
                                                                 TimestampText="@BookmarkSubtitle(bookmark)"
                                                                 LeadingIcon="@Icons.Material.Outlined.BookmarkBorder"
                                                                 ActionLabel="Go to"
                                                                 OnClick="@(() => PlayAudiobookBookmarkFromPanelAsync(bookmark))"
                                                                 AriaLabel="@($"Go to bookmark {BookmarkTitle(bookmark)} at {BookmarkPositionText(bookmark)}")" />
                                        }
                                    </PlaybackPositionList>
                                }
                            </div>
                            break;
                        case "sleep":
                            <PlaybackSleepTimerControl OptionsMinutes="@Playback.SleepTimerOptionsMinutes"
                                                       Mode="@Playback.SleepTimerMode"
                                                       TimerMode="@ListenSleepTimerModes.Timer"
                                                       OffMode="@ListenSleepTimerModes.Off"
                                                       EndOfSectionMode="@ListenSleepTimerModes.EndOfChapter"
                                                       EndsAtUtc="@Playback.SleepTimerEndsAtUtc"
                                                       AllowEndOfSection="@Playback.AllowEndOfChapterSleepTimer"
                                                       TimerMinutesChanged="SetAudiobookSleepTimerMinutesAsync"
                                                       EndOfSectionChanged="SetAudiobookSleepTimerEndOfChapterAsync"
                                                       Size="compact"
                                                       Class="listen-player-panel__sleep-control" />
                            break;
                    }
                    </PlaybackToolSheet>
                }
                else
                {
                <PlaybackToolSheet Title="@MusicPanelTitle"
                                   Subtitle="@MusicPanelSubtitle"
                                   Icon="@MusicPanelIcon"
                                   Surface="panel"
                                   OnClose="CloseBottomPanelAsync">
                @if (Playback.ActiveTab != ListenPlaybackTabs.Lyrics)
                {
                    <div class="listen-player-panel__tabs" role="tablist" aria-label="Queue panel">
                        <AppNativeButton Type="button" Class='@($"listen-player-panel__tab {(Playback.ActiveTab == ListenPlaybackTabs.Queue ? " is-active" : null)}")' OnClick="@(() => Playback.SetActiveTab(ListenPlaybackTabs.Queue))">
                            Playing Next
                        </AppNativeButton>
                        <AppNativeButton Type="button" Class='@($"listen-player-panel__tab {(Playback.ActiveTab == ListenPlaybackTabs.History ? " is-active" : null)}")' OnClick="@(() => Playback.SetActiveTab(ListenPlaybackTabs.History))">
                            History
                        </AppNativeButton>
                    </div>
                }

                @if (Playback.ActiveTab == ListenPlaybackTabs.Queue)
                {
                    <div class="listen-player-panel__subheader">
                        <span>Playing Next</span>
                        <AppNativeButton Type="button" Class="listen-player-panel__text-action" OnClick="ClearUpcoming">
                            Clear
                        </AppNativeButton>
                    </div>

                    @if (Playback.UpcomingQueue.Count == 0)
                    {
                        <div class="listen-player-panel__empty">The queue ends with the current track.</div>
                    }
                    else
                    {
                        <div class="listen-player-panel__list">
                            @for (var index = Playback.CurrentIndex + 1; index < Playback.Queue.Count; index++)
                            {
                                var item = Playback.Queue[index];
                                <div class="listen-player-panel__item">
                                    <AppNativeButton Type="button" Class="listen-player-panel__item-main" OnClick="@(() => PlayFromQueueAsync(index))">
                                        <div class="listen-player-panel__item-thumb">
                                            @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                                            {
                                                <img src="@(ArtworkUrl(item.CoverUrl, "s"))" alt="@item.Title" loading="lazy" decoding="async" />
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@FallbackIconFor(item)" Class="tl-u-font-size-16px" />
                                            }
                                        </div>
                                        <div class="listen-player-panel__item-copy">
                                            <div class="listen-player-panel__item-title">@item.Title</div>
                                            <div class="listen-player-panel__item-subtitle">@StringHelpers.FirstNonBlankOr("Library audio", item.Subtitle, item.Album, item.MediaType)</div>
                                        </div>
                                        <div class="listen-player-panel__item-duration">@item.Duration</div>
                                    </AppNativeButton>
                                    <AppNativeButton Type="button" Class="listen-player-panel__item-remove" AriaLabel="Remove from queue" OnClick="@(() => RemoveUpcoming(index))">
                                        <MudIcon Icon="@Icons.Material.Outlined.Close" Class="tl-u-font-size-16px" />
                                    </AppNativeButton>
                                </div>
                            }
                        </div>
                    }
                }
                else if (Playback.ActiveTab == ListenPlaybackTabs.History)
                {
                    <div class="listen-player-panel__subheader">
                        <span>History</span>
                    </div>

                    @if (Playback.History.Count == 0)
                    {
                        <div class="listen-player-panel__empty">Played tracks will appear here for this session.</div>
                    }
                    else
                    {
                        <div class="listen-player-panel__list">
                            @foreach (var item in Playback.History)
                            {
                                <AppNativeButton Type="button" Class="listen-player-panel__item-main" OnClick="@(() => PlayHistoryItemAsync(item))">
                                    <div class="listen-player-panel__item-thumb">
                                        @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                                        {
                                            <img src="@(ArtworkUrl(item.CoverUrl, "s"))" alt="@item.Title" loading="lazy" decoding="async" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@FallbackIconFor(item)" Class="tl-u-font-size-16px" />
                                        }
                                    </div>
                                    <div class="listen-player-panel__item-copy">
                                        <div class="listen-player-panel__item-title">@item.Title</div>
                                        <div class="listen-player-panel__item-subtitle">@StringHelpers.FirstNonBlankOr("Library audio", item.Subtitle, item.Album, FormatHistoryStamp(item.PlayedAt))</div>
                                    </div>
                                    <div class="listen-player-panel__item-duration">@item.Duration</div>
                                </AppNativeButton>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="listen-player-panel__lyric-actions">
                        @if (_lyricTracks.Count > 1)
                        {
                            <AppNativeSelect Value="@(_selectedLyricTrackId?.ToString("D") ?? string.Empty)" OnChange="SelectLyricVersionAsync" aria-label="Lyrics version">
                                @foreach (var track in _lyricTracks)
                                {
                                    <option value="@track.Id">@track.Provider · @track.Language · @(track.TimingMode) @(track.IsPreferred ? "· Preferred" : "")</option>
                                }
                            </AppNativeSelect>
                        }
                        @if (_selectedLyricTrackId.HasValue)
                        {
                            <AppNativeButton Type="button" OnClick="SetPreferredLyricsAsync">Set preferred version</AppNativeButton>
                        }
                        <AppNativeButton Type="button" OnClick="RefreshLyricsAsync" Disabled="@_lyricsRefreshing">@(_lyricsRefreshing ? "Finding lyrics…" : "Find better lyrics")</AppNativeButton>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_lyricsStatus))
                    {
                        <p role="status" class="listen-player-panel__empty">@_lyricsStatus</p>
                    }
                    @if (_lyricsLoading)
                    {
                        <div class="listen-player-panel__empty">Loading lyrics...</div>
                    }
                    else if (_lyricsLines.Count == 0)
                    {
                        <div class="listen-player-panel__empty">No lyrics available for this track.</div>
                    }
                    else
                    {
                        <div class="listen-player-panel__lyrics">
                            @foreach (var line in _lyricsLines)
                            {
                                @if (line.StartSeconds.HasValue)
                                {
                                    <AppNativeButton Type="button" Class="@($"listen-player-panel__lyric-line {(line == ActiveLyricLine ? "is-active" : string.Empty)}")" OnClick="@(() => SeekOnHostAsync(line.StartSeconds.Value))" AriaLabel="@($"Jump to {line.Text}")">@line.Text</AppNativeButton>
                                }
                                else
                                {
                                    <div class="listen-player-panel__lyric-line">@line.Text</div>
                                }
                            }
                        </div>
                    }
                }
                </PlaybackToolSheet>
                }
            </aside>
        }

        <PlaybackMiniPlayer Experience="@CurrentMiniPlayerExperience" Class="listen-player" AriaLabel="Now playing mini player">
            <div class="listen-player__meta">
                <div class="listen-player__thumb">
                    @if (!string.IsNullOrWhiteSpace(Playback.CurrentItem.CoverUrl))
                    {
                        <img src="@(ArtworkUrl(Playback.CurrentItem.CoverUrl, "s"))" alt="@Playback.CurrentItem.Title" decoding="async" />
                    }
                    else
                    {
                        <MudIcon Icon="@FallbackIconFor(Playback.CurrentItem)" Class="listen-player__thumbnail-fallback" />
                    }
                </div>

                <div class="listen-player__copy">
                    <div class="listen-player__title">@Playback.CurrentItem.Title</div>
                    <div class="listen-player__subtitle">
                        @if (Playback.IsMusicMode && Playback.CurrentItem.ArtistPersonId is { } artistId)
                        {
                            <a href="@($"/details/person/{artistId:D}")">@PlayerSubtitleFor(Playback.CurrentItem, Playback.SourceLabel)</a>
                        }
                        else { @PlayerSubtitleFor(Playback.CurrentItem, Playback.SourceLabel) }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Playback.CurrentItem.Album))
                    {
                        <div class="listen-player__context">
                            @if (Playback.IsMusicMode && Playback.CurrentItem.AlbumWorkId is { } albumId)
                            {
                                <a href="@($"/details/musicalbum/{albumId:D}?context=listen")">@Playback.CurrentItem.Album</a>
                            }
                            else { @Playback.CurrentItem.Album }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Playback.CurrentError))
                    {
                        <div class="listen-player__error">@Playback.CurrentError</div>
                    }
                </div>
            </div>

            <div class="listen-player__transport">
                <div class="listen-player__transport-line">
                    <ListenTransportControls Variant="bar"
                                             IsAudiobookMode="@Playback.IsAudiobookMode"
                                             IsPlaying="@Playback.IsPlaying"
                                             NeedsUserGestureToStart="@Playback.NeedsUserGestureToStart"
                                             IsMuted="@Playback.IsMuted"
                                             HasChapters="@(Playback.CurrentItem?.Chapters.Count is > 0)"
                                             CanPreviousTrack="@(Playback.CurrentIndex > 0)"
                                             CanNextTrack="@CanPlayNext"
                                             SkipBackSeconds="@Playback.SkipBackSeconds"
                                             SkipForwardSeconds="@Playback.SkipForwardSeconds"
                                             CurrentBrowserStreamUrl="@Playback.CurrentBrowserStreamUrl"
                                             CurrentTimeSeconds="@Playback.CurrentTimeSeconds"
                                             PlaybackRate="@Playback.PlaybackRate"
                                             Volume="@Playback.Volume"
                                             OnTogglePlay="TogglePlayPauseAsync"
                                             OnPreviousTrack="PlayPreviousAsync"
                                             OnNextTrack="PlayNextAsync"
                                             OnPreviousChapter="PlayPreviousChapterAsync"
                                             OnNextChapter="PlayNextChapterAsync"
                                             OnSkipBack="SkipBackAsync"
                                             OnSkipForward="SkipForwardAsync" />
                </div>
                <div class="listen-player__progress">
                    <span>@FormatTimestamp(Playback.CurrentTimeSeconds)</span>
                    <AppNativeInput Type="range" Min="0" Max="@ProgressMax" Step="1" Value="@Math.Min(Playback.CurrentTimeSeconds, ProgressMax)" Class="listen-player__progress-slider" OnChange="SeekAsync" AriaLabel="Playback position" aria-valuetext="@ProgressValueText" />
                    <span>-@FormatTimestamp(Math.Max(0, Playback.DurationSeconds - Playback.CurrentTimeSeconds))</span>
                </div>
                @if (Playback.IsAudiobookMode && Playback.CurrentChapter is { } currentChapter)
                {
                    <div class="listen-player__chapter-context">@currentChapter.Title</div>
                }
            </div>

            <div class="listen-player__actions">
                @if (Playback.IsAudiobookMode)
                {
                    <PlaybackControlStrip Controls="@AudiobookPanelControls"
                                          Size="compact"
                                          Class="listen-player__audiobook-actions"
                                          AriaLabel="Audiobook tools"
                                          OnControl="HandleAudiobookPanelControl" />
                }
                else
                {
                    <PlaybackControlStrip Controls="@MusicPanelControls"
                                          Size="compact"
                                          Class="listen-player__music-actions"
                                          AriaLabel="Music tools"
                                          OnControl="HandleMusicPanelControl" />
                }
                <span class="listen-player__volume">
                    <AppNativeButton Type="button" Class="listen-player__icon" OnClick="ToggleMuteAsync" AriaLabel="Mute or unmute" title="Mute or unmute">
                        <MudIcon Icon="@(Playback.IsMuted || Playback.Volume <= 0 ? Icons.Material.Outlined.VolumeOff : Icons.Material.Outlined.VolumeUp)" Class="listen-player__utility-glyph" />
                    </AppNativeButton>
                    <AppNativeInput Type="range" Min="0" Max="1" Step="@VolumeStep" Value="@Playback.Volume" Class="listen-player__volume-slider" OnChange="SetVolumeAsync" AriaLabel="Volume" aria-valuetext="@VolumeValueText" />
                </span>
                <AppNativeButton Type="button" Class="listen-player__icon listen-player__expand" OnClick="OpenNowPlaying" AriaLabel="Open Now Playing" title="Open Now Playing">
                    <MudIcon Icon="@Icons.Material.Outlined.OpenInFull" Class="listen-player__utility-glyph" />
                </AppNativeButton>
                <AppNativeButton Type="button" Class="listen-player__icon" OnClick="ClosePlayerAsync" AriaLabel="Close player" title="Close player">
                    <MudIcon Icon="@Icons.Material.Outlined.Close" Class="listen-player__utility-glyph" />
                </AppNativeButton>
            </div>
        </PlaybackMiniPlayer>
        @if (Playback.PresentationSurface == PlaybackPresentationSurface.NowPlaying)
        {
            <section class="listen-now-playing" role="region" aria-label="Now Playing" tabindex="-1" @ref="_nowPlayingRef" @onkeydown="HandleNowPlayingKeyDown">
                <header class="listen-now-playing__header">
                    <span>Now Playing · @(Playback.IsAudiobookMode ? "Audiobook" : "Music")</span>
                    <div class="listen-now-playing__header-actions">
                        <AppNativeButton Type="button" Class="listen-now-playing__icon" OnClick="TogglePopupAsync" AriaLabel="Open separate player window" title="Open separate player window" data-listen-popup-route="@(Playback.IsPopupOpen ? null : PopupRoute)">
                            <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" />
                        </AppNativeButton>
                        <AppNativeButton Type="button" Class="listen-now-playing__icon" OnClick="CloseNowPlaying" AriaLabel="Collapse Now Playing" title="Collapse Now Playing">
                            <MudIcon Icon="@Icons.Material.Outlined.CloseFullscreen" />
                        </AppNativeButton>
                    </div>
                </header>
                <div class="listen-now-playing__body">
                    <div class="listen-now-playing__artwork">
                        @if (!string.IsNullOrWhiteSpace(Playback.CurrentItem.CoverUrl))
                        {
                            <img src="@(ArtworkUrl(Playback.CurrentItem.CoverUrl, "m"))"
                                 srcset="@ArtworkSrcSet(Playback.CurrentItem.CoverUrl)"
                                 sizes="(max-width: 700px) min(58vw, 340px), min(44vw, 634px)"
                                 alt="" decoding="async" />
                        }
                        else
                        {
                            <MudIcon Icon="@FallbackIconFor(Playback.CurrentItem)" />
                        }
                    </div>
                    <div class="listen-now-playing__content">
                        <p class="listen-now-playing__eyebrow">@(Playback.IsAudiobookMode ? "YOUR AUDIOBOOK" : "NOW PLAYING")</p>
                        <h1>@Playback.CurrentItem.Title</h1>
                        <div class="listen-now-playing__byline">
                            @if (Playback.IsAudiobookMode && Playback.CurrentItem.AlbumWorkId is { } bookId)
                            {
                                <a href="@($"/details/audiobook/{bookId:D}?context=listen")">Open book details</a>
                            }
                            @if (Playback.IsAudiobookMode)
                            {
                                @if (!string.IsNullOrWhiteSpace(Playback.CurrentItem.AuthorName))
                                {
                                    <span>By @Playback.CurrentItem.AuthorName</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(Playback.CurrentItem.NarratorName))
                                {
                                    <span>Narrated by @Playback.CurrentItem.NarratorName</span>
                                }
                            }
                            else if (Playback.CurrentItem.ArtistPersonId is { } personId)
                            {
                                <a href="@($"/details/person/{personId:D}")">@PlayerSubtitleFor(Playback.CurrentItem, Playback.SourceLabel)</a>
                            }
                            else
                            {
                                <span>@PlayerSubtitleFor(Playback.CurrentItem, Playback.SourceLabel)</span>
                            }
                            @if (Playback.IsMusicMode && Playback.CurrentItem.AlbumWorkId is { } albumId && !string.IsNullOrWhiteSpace(Playback.CurrentItem.Album))
                            {
                                <a href="@($"/details/musicalbum/{albumId:D}?context=listen")">@Playback.CurrentItem.Album</a>
                            }
                        </div>
                        @if (Playback.IsMusicMode && Playback.CurrentItem.WorkId != Guid.Empty)
                        {
                            <AppNativeButton Type="button" Class="listen-now-playing__favorite" OnClick="ToggleFavoriteAsync" AriaLabel="@(_isFavorite ? "Remove song from Favorites" : "Add song to Favorites")" aria-pressed="@(_isFavorite ? "true" : "false")">
                                <MudIcon Icon="@(_isFavorite ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)" /> @(_isFavorite ? "Favorited" : "Add to Favorites")
                            </AppNativeButton>
                        }
                        @if (Playback.IsAudiobookMode && Playback.CurrentChapter is { } chapter)
                        {
                            <div class="listen-now-playing__chapter">@chapter.Title</div>
                        }
                        <div class="listen-now-playing__timeline">
                            <AppNativeInput Type="range" Min="0" Max="@NowPlayingTimelineMax" Step="1" Value="@NowPlayingTimelinePosition" OnChange="SeekNowPlayingAsync" AriaLabel="@(Playback.IsAudiobookMode ? "Chapter position" : "Playback position")" aria-valuetext="@ProgressValueText" />
                            <div><span>@FormatTimestamp(NowPlayingTimelinePosition)</span><span>-@FormatTimestamp(Math.Max(0, NowPlayingTimelineMax - NowPlayingTimelinePosition))</span></div>
                        </div>
                        <ListenTransportControls Variant="popup"
                                                 IsAudiobookMode="@Playback.IsAudiobookMode"
                                                 IsPlaying="@Playback.IsPlaying"
                                                 NeedsUserGestureToStart="@Playback.NeedsUserGestureToStart"
                                                 IsMuted="@Playback.IsMuted"
                                                 HasChapters="@(CurrentChapters.Count > 0)"
                                                 CanPreviousTrack="@(Playback.CurrentIndex > 0)"
                                                 CanNextTrack="@CanPlayNext"
                                                 SkipBackSeconds="@Playback.SkipBackSeconds"
                                                 SkipForwardSeconds="@Playback.SkipForwardSeconds"
                                                 CurrentBrowserStreamUrl="@Playback.CurrentBrowserStreamUrl"
                                                 CurrentTimeSeconds="@Playback.CurrentTimeSeconds"
                                                 PlaybackRate="@Playback.PlaybackRate"
                                                 Volume="@Playback.Volume"
                                                 OnTogglePlay="TogglePlayPauseAsync"
                                                 OnPreviousTrack="PlayPreviousAsync"
                                                 OnNextTrack="PlayNextAsync"
                                                 OnPreviousChapter="PlayPreviousChapterAsync"
                                                 OnNextChapter="PlayNextChapterAsync"
                                                 OnSkipBack="SkipBackAsync"
                                                 OnSkipForward="SkipForwardAsync" />
                        @if (Playback.IsAudiobookMode && OverallBookProgress is { } bookProgress)
                        {
                            <div class="listen-now-playing__overall"><span>@bookProgress.Label</span><progress value="@bookProgress.Position" max="@bookProgress.Total"></progress><span>@Math.Round(bookProgress.Position / bookProgress.Total * 100)%</span></div>
                        }
                        <PlaybackControlStrip Controls="@(Playback.IsAudiobookMode ? AudiobookPanelControls : MusicPanelControls)"
                                              Size="standard"
                                              Class="listen-now-playing__tools"
                                              AriaLabel="Now Playing tools"
                                              OnControl="HandleNowPlayingToolControl" />
                    </div>
                </div>
            </section>
        }
    </div>
}

@code {
    private const string PopupRoute = "/listen/player-popup";
    private static string ArtworkUrl(string? source, string size)
        => MediaTileArtworkUrl.Sized(source, size) ?? source ?? string.Empty;
    private static string? ArtworkSrcSet(string? source)
        => MediaTileArtworkUrl.SrcSet(
            MediaTileArtworkUrl.Sized(source, "s"),
            MediaTileArtworkUrl.Sized(source, "m"),
            MediaTileArtworkUrl.Sized(source, "l"));

    private readonly JsonSerializerOptions _jsonOptions = MediaEngineJson.Web;
    private ElementReference _audioRef;
    private ElementReference _playerShellRef;
    private DotNetObjectReference<ListenNowPlayingBar>? _selfReference;
    private ElementReference _nowPlayingRef;
    private bool _nowPlayingFocused;
    private bool _restored;
    private string? _lastAppliedStreamUrl;
    private string? _lastSeekedStreamUrl;
    private double? _lastSeekedPositionSeconds;
    private long _lastAppliedStartVersion = -1;
    private bool? _lastAppliedPlayingState;
    private double? _lastAppliedVolume;
