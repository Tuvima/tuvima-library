    private async Task OpenBookmarkDialogAsync(ElementReference trigger = default)
    {
        CloseSettingsMenu();
        if (!Playback.IsAudiobookMode || Playback.CurrentItem is not { AssetId: Guid assetId } item
            || assetId == Guid.Empty || PlaybackPreferences.ActiveProfileId is not Guid profileId
            || Playback.AudiobookBookSessionLeaseId is not Guid sessionLeaseId)
        {
            Snackbar.Add(L["ListenNowPlayingBar_BookmarksAreUnavailableUntilThe"].Value, AppSeverity.Info);
            return;
        }

        var context = new AudiobookBookmarkActionContext(Guid.NewGuid(), profileId,
            item.AudiobookWorkId ?? item.WorkId, sessionLeaseId, Playback.AudiobookBookSessionGeneration, assetId);
        try
        {
            await BookmarkActions.OpenAsync(context);
            var snapshot = await BookmarkActions.GetSnapshotAsync(context);
            var authorized = BookmarkActions is ListenPlaybackCommandActionsClient client
                ? client.GetAuthorizedAssetIds(context)
                : new HashSet<Guid>();
            if (snapshot.Draft is null || !authorized.Contains(assetId))
            {
                await BookmarkActions.CloseAsync(context);
                Snackbar.Add(snapshot.Message ?? "The current audiobook position could not be captured.", AppSeverity.Info);
                return;
            }

            _bookmarkDialogContext = context;
            _bookmarkDialogSnapshot = snapshot;
            _bookmarkTrigger = trigger;
            _bookmarkAuthorizedAssetIds = authorized;
            _bookmarkWorkTitle = item.Title;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogInformation(ex, "The bookmark dialog could not be opened by the active playback owner.");
            Snackbar.Add(L["ListenNowPlayingBar_TheAudiobookPositionCouldNot"].Value, AppSeverity.Info);
        }
    }

    private async Task HandleAudiobookDockActivationAsync(PlaybackControlActivation activation)
    {
        if (activation.Control.Sheet == "bookmark-dialog")
        {
            await OpenBookmarkDialogAsync(activation.Trigger);
            return;
        }
        await HandleAudiobookPanelControl(activation.Control);
    }

    private Task DismissBookmarkDialogAsync()
    {
        _bookmarkDialogContext = null;
        _bookmarkDialogSnapshot = null;
        _bookmarkAuthorizedAssetIds = new HashSet<Guid>();
        _bookmarkWorkTitle = null;
        return InvokeAsync(StateHasChanged);
    }

    private void OnBookmarkActionsChanged(Guid dialogId)
    {
        if (_bookmarkDialogContext?.DialogId != dialogId) return;
        _ = InvokeAsync(async () =>
        {
            if (_bookmarkDialogContext is not { } context) return;
            _bookmarkDialogSnapshot = await BookmarkActions.GetSnapshotAsync(context);
            StateHasChanged();
            if (ShowBookmarksOnBar) _ = RefreshBarMarkersAsync(force: true);
        });
    }

    private async Task SetAudiobookSleepTimerSelectionAsync(AudiobookSleepTimerSelectionDto selection)
    {
        if (!Playback.IsAudiobookMode || Playback.CurrentItem is not { AssetId: { } assetId } item
            || PlaybackPreferences.ActiveProfileId is not { } profileId)
        {
            return;
        }

        try
        {
            await Playback.SetAudiobookSleepTimerAsync(
                profileId,
                item.AudiobookWorkId ?? item.WorkId,
                assetId,
                Playback.PlaybackRequestVersion,
                selection);
        }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentException)
        {
            Logger.LogInformation(exception, "The audiobook sleep timer selection no longer matched the active playback session.");
            Snackbar.Add(exception.Message, AppSeverity.Info);
        }
    }

    private async Task QueueDraggedItemsAsync()
    {
        if (!AudioDrag.HasItems)
        {
            return;
        }

        if (Playback.IsAudiobookMode)
        {
            Snackbar.Add(L["ListenNowPlayingBar_FinishOrCloseTheAudiobook"].Value, AppSeverity.Info);
            AudioDrag.Clear();
            return;
        }

        var items = AudioDrag.Items.ToList();
        foreach (var item in items)
        {
            await Playback.AddQueueItemAsync(item);
        }

        AudioDrag.Clear();
        if (items.Count > 0)
        {
            Snackbar.Add(
                items.Count == 1 ? "Song added to the queue." : $"{items.Count} songs added to the queue.",
                AppSeverity.Success);
        }
    }

    public sealed record AudioClosePosition(Guid AssetId, long PlaybackRequestVersion, bool SourceVerified,
        double PositionSeconds, double? DurationSeconds);
    private bool _closeInProgress;
    private async Task ClosePlayerAsync()
    {
        if (_closeInProgress || Playback.IsVideoMode || Playback.CurrentItem is not { } item) return;
        var profile = Playback.ActiveProfileId;
        var request = Playback.PlaybackRequestVersion;
        var source = Playback.CurrentBrowserStreamUrl;
        var pendingSource = Playback.Phase == PlaybackPhase.Loading || item.AssetId is null || string.IsNullOrWhiteSpace(source);
        var predecessorSource = _lastAppliedStreamUrl;
        bool Current() => !_disposed && Playback.ActiveProfileId == profile && Playback.PlaybackRequestVersion == request
            && Playback.CurrentItem?.AssetId == item.AssetId && Playback.CurrentItem?.WorkId == item.WorkId && !Playback.IsVideoMode;
        _closeInProgress = true;
        try
        {
            // Pause only the captured native session before waiting on persistence.
            var position = await JS.InvokeAsync<AudioClosePosition?>("listenPlayback.pauseAudioForClose",
                item.AssetId, request, source, predecessorSource, pendingSource);
            if (!Current()) return;
            if (position is { SourceVerified: true } && position.AssetId == item.AssetId
                && position.PlaybackRequestVersion == request && double.IsFinite(position.PositionSeconds) && position.PositionSeconds >= 0)
                Playback.UpdateTransportState(currentTimeSeconds: position.PositionSeconds,
                    durationSeconds: position.DurationSeconds, isPlaying: false);
            else Playback.UpdateTransportState(isPlaying: false);
            await Playback.ReportHeartbeatAsync(force: true, hasPlaybackEnded: false);
            if (!Current()) return;
            var stopped = await JS.InvokeAsync<bool>("listenPlayback.finalizeAudioClose", item.AssetId, request, source, predecessorSource, pendingSource, profile);
            if (!Current()) return;
            if (!stopped && !pendingSource) return;
            Tools?.Close();
            await AudioSidebar.CloseAsync(Playback);
            if (!Current()) return;
            CloseSettingsMenu();
            Playback.ClosePlayer();
        }
        finally { _closeInProgress = false; }
    }

    [JSInvokable]
    public async Task HandlePlaybackCommand(string json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return;
        }

        using var document = JsonDocument.Parse(json);
        if (!document.RootElement.TryGetProperty("action", out var action)
            || !string.Equals(action.GetString(), "request-state", StringComparison.Ordinal))
        {
            return;
        }

        if (Playback.HasQueue)
        {
            var snapshot = JsonSerializer.Serialize(Playback.CreateSnapshot(), _jsonOptions);
            await JS.InvokeVoidAsync("listenPlayback.setState", snapshot);
        }
        else await JS.InvokeVoidAsync("listenPlayback.clearState");
    }

    private async Task HandleTransportCommandAsync(PlaybackTransportCommand command)
    {
        if (Playback.IsVideoMode)
        {
            return;
        }

        switch (command.Action)
        {
            case "toggle-play":
                await TogglePlayPauseAsync();
                break;
            case "pause":
                await PauseAudioAsync();
                break;
            case "play-next":
                await PlayNextAsync();
                break;
            case "play-previous":
                await PlayPreviousAsync();
                break;
            case "play-next-chapter":
                await Playback.PlayNextChapterAsync();
                break;
            case "play-previous-chapter":
                await Playback.PlayPreviousChapterAsync();
                break;
            case "skip-back":
                await SkipBackAsync();
                break;
            case "skip-forward":
                await SkipForwardAsync();
                break;
            case "seek" when command.Value.HasValue:
                await SeekOnHostAsync(command.Value.Value);
                break;
            case "start":
                await StartAudioAsync(command);
                break;
            case "set-volume" when command.Value.HasValue:
                await ApplyVolumeOnHostAsync(command.Value.Value);
                break;
            case "set-speed" when command.Value.HasValue:
                await ApplyPlaybackRateAsync(command.Value.Value);
                break;
            case "toggle-mute":
                await ToggleMuteOnHostAsync();
                break;
            case "close-player":
                await ClosePlayerAsync();
                break;
        }
    }

    private static string FallbackIconFor(ListenQueueItem item)
        => IsAudiobook(item) ? AppMaterialIcons.Outlined.Headphones : AppMaterialIcons.Outlined.Album;

    private static string PlayerSubtitleFor(ListenQueueItem item, string? sourceLabel)
    {
        if (IsAudiobook(item))
        {
            return StringHelpers.FirstNonBlankOr("Library audio", item.Subtitle, item.Album, sourceLabel, "Audiobook");
        }

        return StringHelpers.FirstNonBlankOr("Library audio", item.Subtitle, item.Album, sourceLabel, "Music library");
    }

    private static string FormatHistoryStamp(DateTimeOffset? playedAt)
        => playedAt.HasValue
            ? playedAt.Value.LocalDateTime.ToString("M/d h:mm tt", CultureInfo.CurrentCulture)
            : "Played earlier";

    private static string FormatHistoryTime(DateTimeOffset? playedAt)
        => playedAt?.LocalDateTime.ToString("h:mm tt", CultureInfo.CurrentCulture) ?? "—";

    private static string FormatHistoryTime(DateTimeOffset playedAt)
        => playedAt.LocalDateTime.ToString("h:mm tt", CultureInfo.CurrentCulture);

    private static string ContextSubtitle(params string?[] values)
        => StringHelpers.FirstNonBlankOr("Library audio", values);

    private static string FormatTimestamp(double seconds)
    {
        var safe = Math.Max(0, seconds);
        var span = TimeSpan.FromSeconds(safe);
        return span.TotalHours >= 1
            ? span.ToString(@"h\:mm\:ss", CultureInfo.InvariantCulture)
            : span.ToString(@"m\:ss", CultureInfo.InvariantCulture);
    }

    private static string ChapterDuration(PlaybackChapterDto chapter) =>
        chapter.EndSeconds is > 0 && chapter.EndSeconds.Value > chapter.StartSeconds
            ? FormatTimestamp(chapter.EndSeconds.Value - chapter.StartSeconds)
            : string.Empty;

    private static bool IsAudiobook(ListenQueueItem item)
        => MediaKindClassifier.IsAudiobook(item.MediaType);

    public async ValueTask DisposeAsync()
    {
        Reactions.Changed -= ReactionChanged;
        TimelineScope.Changed -= TimelineScopeChanged;
        _disposed = true;
        var bookmarkContext = _bookmarkDialogContext;
        _bookmarkDialogContext = null;
        if (bookmarkContext is not null)
        {
            try { await BookmarkActions.CloseAsync(bookmarkContext); }
            catch (Exception exception) { Logger.LogDebug(exception, "The audiobook bookmark dialog lease was already released during playback bar disposal."); }
        }

        Playback.SetTransportHostNotReady();
        Playback.Changed -= HandlePlaybackChanged;
        AudioSidebar.Changed -= HandleAudioPanelChanged;
        if (_launcher is not null) _launcher.Requested -= HandleNowPlayingRequested;
        Playback.TransportCommandRequested -= HandleTransportCommandAsync;
        Playback.SleepTimerNativeArmRequested -= BindNativeSleepTimerAsync;
        Playback.SleepTimerPauseRequested -= PauseNativeSleepTimerAsync;
        Playback.SleepTimerNativeSourcePrepareRequested -= PrepareNativeSleepTimerSourceAsync;
        Playback.SleepTimerNativePositionRequested -= ReadNativeSleepTimerPositionAsync;
        BookmarkActionOwner.Changed -= OnBookmarkActionsChanged;
        Nav.LocationChanged -= HandleLocationChanged;
        DeviceContext.OnChanged -= HandleDeviceContextChanged;

        await DetachBrowserClientAsync();

        _selfReference?.Dispose();
    }

    // Safe to call more than once and before the browser client was ever registered.
    private async Task DetachBrowserClientAsync()
    {
        if (!_browserClientRegistering) return;
        var mediaSession = _mediaSessionModule;
        var audioCapabilities = _audioCapabilitiesModule;
        var audioPresentation = _audioPresentationModule;
        _mediaSessionModule = null;
        _audioCapabilitiesModule = null;
        _audioPresentationModule = null;
        try
        {
            if (mediaSession is not null)
            {
                await mediaSession.InvokeVoidAsync("detach", _audioRef);
                await mediaSession.DisposeAsync();
            }
            if (audioCapabilities is not null)
            {
                await audioCapabilities.InvokeVoidAsync("detach");
                await audioCapabilities.DisposeAsync();
            }
            if (audioPresentation is not null)
            {
                await audioPresentation.InvokeVoidAsync("detach", _audioPresentationObserverId);
                await audioPresentation.DisposeAsync();
            }
            await JS.InvokeVoidAsync("listenPlayback.unregisterAudioStateObserver", _audioRef);
            await JS.InvokeVoidAsync("listenPlayback.unregisterPlayerShortcuts", _playerShellRef);
            await JS.InvokeVoidAsync("listenPlayback.unregisterCommandHandler", _selfReference);
        }
        catch (JSDisconnectedException)
        {
            // The browser connection is gone, so the handlers went with it.
        }
        catch (Exception ex) when (ex is InvalidOperationException or ObjectDisposedException or JSException or TaskCanceledException)
        {
            Logger.LogDebug(ex, "Failed to unregister listen playback command handler.");
        }
    }

