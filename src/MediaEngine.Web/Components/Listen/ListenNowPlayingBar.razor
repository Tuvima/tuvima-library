    private static IEnumerable<LrcDisplayLine> ParseLyrics(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
            yield break;

        var pattern = new Regex(@"\[(?<min>\d{1,3}):(?<sec>\d{2})(?:[.:](?<frac>\d{1,3}))?\]");
        var lines = content.Replace("\r\n", "\n").Split('\n');
        var isTimed = lines.Any(pattern.IsMatch);
        foreach (var rawLine in lines)
        {
            if (!isTimed)
            {
                if (!string.IsNullOrWhiteSpace(rawLine)) yield return new LrcDisplayLine(null, rawLine.Trim());
                continue;
            }
            var matches = pattern.Matches(rawLine);
            if (matches.Count == 0)
                continue;

            var text = pattern.Replace(rawLine, string.Empty).Trim();
            if (string.IsNullOrWhiteSpace(text))
                continue;

            foreach (Match match in matches)
            {
                if (!int.TryParse(match.Groups["min"].Value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var min)
                    || !int.TryParse(match.Groups["sec"].Value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var sec))
                    continue;

                var frac = match.Groups["frac"].Success ? match.Groups["frac"].Value : "0";
                var fracSeconds = frac.Length switch
                {
                    1 => int.Parse(frac, CultureInfo.InvariantCulture) / 10d,
                    2 => int.Parse(frac, CultureInfo.InvariantCulture) / 100d,
                    _ => int.Parse(frac.PadRight(3, '0')[..3], CultureInfo.InvariantCulture) / 1000d,
                };
                yield return new LrcDisplayLine(min * 60d + sec + fracSeconds, text);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        Playback.SetTransportHostNotReady();
        Playback.Changed -= HandlePlaybackChanged;
        Playback.TransportCommandRequested -= HandleTransportCommandAsync;
        Nav.LocationChanged -= HandleLocationChanged;

        try
        {
            await JS.InvokeVoidAsync("listenPlayback.unregisterAudioStateObserver", _audioRef);
            await JS.InvokeVoidAsync("listenPlayback.unregisterPlayerShortcuts", _playerShellRef);
            await JS.InvokeVoidAsync("listenPlayback.unregisterCommandHandler", _selfReference);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogDebug(ex, "Failed to unregister listen playback command handler.");
        }

        _selfReference?.Dispose();
    }

