@namespace MediaEngine.Web.Components.Listen
@using System.Globalization
@using System.Threading
@using System.Text.Json
@using Microsoft.JSInterop
@using MediaEngine.Contracts.Playback
@using MediaEngine.Domain.Enums
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Components.Details
@using Microsoft.Extensions.DependencyInjection
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.MediaTiles
@inject PlaybackSessionController Playback
@inject ListenContextSidebarState AudioSidebar
@inject IAudiobookBookmarkActions BookmarkActions
@inject AudiobookBookmarkActionService BookmarkActionOwner
@inject IUserPlaybackPreferencesAccessor PlaybackPreferences
@inject MediaEngine.Web.Services.Theming.DeviceContextService DeviceContext
@inject ListenAudioDragService AudioDrag
@inject MediaReactionService Reactions
@inject UIOrchestratorService Orchestrator
@inject IServiceProvider Services
@inject IJSRuntime JS
@inject ILogger<ListenNowPlayingBar> Logger
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<audio @ref="_audioRef"
       id="listen-audio-engine"
       data-current-asset-id="@(Playback.CurrentItem?.AssetId?.ToString("D"))"
       data-playback-request-version="@Playback.PlaybackRequestVersion"
       class="listen-player__audio-native"
       @onloadedmetadata="HandleAudioMetricsChangedAsync"
       @ondurationchange="HandleAudioMetricsChangedAsync"
       @onplay="HandleAudioStarted"
       @onpause="HandleAudioPaused"
       @onerror="HandleAudioErrorAsync">
</audio>

@if (!string.IsNullOrWhiteSpace(_playbackRestoreError))
{
    <div class="listen-player__restore-status" role="status">
        <span>@_playbackRestoreError</span>
        <AppNativeButton Type="button" OnClick="RetryPlaybackStateRestoreAsync" AriaLabel="Retry playback state restore">Retry</AppNativeButton>
    </div>
}

@if (_bookmarkDialogContext is not null && _bookmarkDialogSnapshot is not null)
{
    <AudiobookBookmarkDialog Context="@_bookmarkDialogContext"
                             Actions="@BookmarkActions"
                             AuthorizedAssetIds="@_bookmarkAuthorizedAssetIds"
                             WorkTitle="@(_bookmarkWorkTitle ?? "Audiobook")"
                             IsMobile="@IsPhonePresentation"
                             Trigger="@_bookmarkTrigger"
                             OnClose="DismissBookmarkDialogAsync" />
}

@if (Playback.HasQueue && Playback.CurrentItem is not null && !Playback.IsVideoMode)
{
    var dockSnapshot = Playback.CreateSnapshot();
    <div class="@PlayerShellClass"
         @ref="_playerShellRef"
         tabindex="0"
         @onkeydown="HandlePlayerKeyDown"
         @ondragover:preventDefault="true"
         @ondrop:preventDefault="true"
         @ondrop="QueueDraggedItemsAsync">
        <PlaybackMiniPlayer Experience="@CurrentMiniPlayerExperience" Class="@($"listen-player {(Playback.IsAudiobookMode ? "listen-player--audiobook" : "listen-player--music")}")" AriaLabel="Now playing mini player">
                <div class="listen-player__progress">
                    <span>@FormatTimestamp(Playback.CurrentTimeSeconds)</span>
                    <PlaybackRangeSlider Surface="dock" Min="0" Max="@ProgressMax" Step="1"
                                         Value="@Math.Min(Playback.CurrentTimeSeconds, ProgressMax)"
                                         ShowTicks="false" CommitOnChange="true" Class="listen-player__progress-slider" disabled="@(Playback.DurationSeconds <= 0)"
                                         AriaLabel="Playback position" ValueFormatter="@(_ => ProgressValueText)"
                                         ValueChanged="SeekOnHostAsync" />
                    <span>@(Playback.DurationSeconds > 0 ? $"-{FormatTimestamp(Math.Max(0, Playback.DurationSeconds - Playback.CurrentTimeSeconds))}" : "—")</span>
                </div>

            <div class="listen-player__meta">
                <div class="listen-player__thumb">
                    @if (!string.IsNullOrWhiteSpace(Playback.CurrentItem.CoverUrl))
                    {
                        <img src="@(ArtworkUrl(Playback.CurrentItem.CoverUrl, "s"))" srcset="@ArtworkSrcSet(Playback.CurrentItem.CoverUrl)" sizes="48px" data-image-display="audio-dock-thumbnail" alt="@Playback.CurrentItem.Title" decoding="async" />
                    }
                    else
                    {
                        <MudIcon Icon="@FallbackIconFor(Playback.CurrentItem)" Class="listen-player__thumbnail-fallback" />
                    }
                </div>

                <div class="listen-player__copy">
                    <div class="listen-player__title">
                        @if (Playback.IsAudiobookMode && Playback.CurrentChapter is { } miniCurrentChapter)
                        {
                            @miniCurrentChapter.Title
                        }
                        else if (Playback.IsAudiobookMode && !string.IsNullOrWhiteSpace(Playback.CurrentItem.Subtitle) && !string.Equals(Playback.CurrentItem.Subtitle, Playback.CurrentItem.Title, StringComparison.OrdinalIgnoreCase))
                        {
                            @Playback.CurrentItem.Subtitle
                        }
                        else if (Playback.IsAudiobookMode && ListenPlaybackIdentityRoutes.Audiobook(Playback.CurrentItem) is { } miniBookFallbackRoute)
                        {
                            <a href="@miniBookFallbackRoute">@Playback.CurrentItem.Title</a>
                        }
                        else if (Playback.IsAudiobookMode)
                        {
                            @Playback.CurrentItem.Title
                        }
                        else if (Playback.IsMusicMode && ListenPlaybackIdentityRoutes.Album(Playback.CurrentItem) is { } miniAlbumRoute)
                        {
                            <a href="@miniAlbumRoute">@Playback.CurrentItem.Title</a>
                        }
                        else { @Playback.CurrentItem.Title }
                    </div>
                    <div class="listen-player__subtitle">
                        @if (Playback.IsAudiobookMode)
                        {
                            @if (ListenPlaybackIdentityRoutes.Audiobook(Playback.CurrentItem) is { } audiobookRoute)
                            {
                                <a href="@audiobookRoute">@Playback.CurrentItem.Title</a>
                            }
                            else { @Playback.CurrentItem.Title }
                            @if (Playback.CurrentItem.Authors.Count > 0)
                            {
                                <span> · </span>
                                @for (var authorIndex = 0; authorIndex < Playback.CurrentItem.Authors.Count; authorIndex++)
                                {
                                    var author = Playback.CurrentItem.Authors[authorIndex];
                                    @if (authorIndex > 0) { <text>; </text> }
                                    @if (ListenPlaybackIdentityRoutes.Contributor(author) is { } authorRoute)
                                    {
                                        <a href="@authorRoute">@author.Name</a>
                                    }
                                    else { @author.Name }
                                }
                            }
                            else if (!string.IsNullOrWhiteSpace(Playback.CurrentItem.AuthorName))
                            {
                                <span> · @Playback.CurrentItem.AuthorName</span>
                            }
                        }
                        else if (Playback.IsMusicMode && ListenPlaybackIdentityRoutes.Artist(Playback.CurrentItem) is { } artistRoute)
                        {
                            <a href="@artistRoute">@PlayerSubtitleFor(Playback.CurrentItem, Playback.SourceLabel)</a>
                        }
                        else { @PlayerSubtitleFor(Playback.CurrentItem, Playback.SourceLabel) }
                    </div>
                    @if (!Playback.IsAudiobookMode && !string.IsNullOrWhiteSpace(Playback.CurrentItem.Album))
                    {
                        <div class="listen-player__context">
                            @if (Playback.IsMusicMode && ListenPlaybackIdentityRoutes.Album(Playback.CurrentItem) is { } albumRoute)
                            {
                                <a href="@albumRoute">@Playback.CurrentItem.Album</a>
                            }
                            else { @Playback.CurrentItem.Album }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Playback.CurrentError))
                    {
                        <div class="listen-player__error">@Playback.CurrentError</div>
                    }
                </div>
                @if (Playback.IsMusicMode)
                {
                    <AppNativeButton Type="button" Class="listen-player__icon listen-player__favorite" OnClick="ToggleFavoriteAsync"
                                     AriaLabel="@(_isFavorite ? "Remove song from Favorites" : "Add song to Favorites")" aria-pressed="@(_isFavorite ? "true" : "false")">
                        <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Favorite" />
                    </AppNativeButton>
                    <span class="listen-player__item-more" @key="DockItemKey">
                        <PlaybackPopover Title="More song actions" ToolId="audio-song-more" ItemKey="@DockItemKey">
                            <TriggerContent><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.More" /></TriggerContent>
                            <ChildContent>
                                <PersonalStatusMenuItems WorkId="@Playback.CurrentItem.WorkId" IsCurrent="@(() => IsCurrentDockSnapshot(dockSnapshot))" />
                                @if (ListenPlaybackIdentityRoutes.Album(Playback.CurrentItem) is { } moreAlbumRoute)
                                { <a class="listen-player__menu-link" href="@moreAlbumRoute">Open album</a> }
                            </ChildContent>
                        </PlaybackPopover>
                    </span>
                }
                <AppNativeButton Type="button" Class="listen-player__mini-open" OnClick="OpenNowPlaying" AriaLabel="Open full player" title="Open full player" />
            </div>

            <div class="listen-player__transport">
                <div class="listen-player__transport-line">
                    <ListenTransportControls Variant="bar"
                                             PrimaryAppearance="@(Playback.IsAudiobookMode ? "dock" : "standard")"
                                             IsAudiobookMode="@Playback.IsAudiobookMode"
                                             IsPlaying="@Playback.IsPlaying"
                                             NeedsUserGestureToStart="@Playback.NeedsUserGestureToStart"
                                             IsMuted="@Playback.IsMuted"
                                             HasChapters="@(Playback.CurrentItem?.Chapters.Count is > 0)"
                                             CanPreviousTrack="@(Playback.CurrentIndex > 0)"
                                             CanNextTrack="@CanPlayNext"
                                             SkipBackSeconds="@Playback.SkipBackSeconds"
                                             SkipForwardSeconds="@Playback.SkipForwardSeconds"
                                             CurrentBrowserStreamUrl="@Playback.CurrentBrowserStreamUrl"
                                             CurrentTimeSeconds="@Playback.CurrentTimeSeconds"
                                             PlaybackRate="@Playback.PlaybackRate"
                                             Volume="@Playback.Volume"
                                             ShowMusicModeButtons="@Playback.IsMusicMode"
                                             ShuffleEnabled="@Playback.ShuffleEnabled"
                                             RepeatEnabled="@(Playback.RepeatMode != PlayerRepeatModes.Off)"
                                             OnTogglePlay="TogglePlayPauseAsync"
                                             OnPreviousTrack="PlayPreviousAsync"
                                             OnNextTrack="PlayNextAsync"
                                             OnPreviousChapter="PlayPreviousChapterAsync"
                                             OnNextChapter="PlayNextChapterAsync"
                                             OnSkipBack="SkipBackAsync"
                                             OnSkipForward="SkipForwardAsync"
                                             OnShuffle="ToggleShuffleFromDockAsync"
                                             OnRepeat="CycleRepeatFromDockAsync" />
                </div>
            </div>

            <div class="listen-player__actions">
                <div class="listen-player__desktop-tools">
                    @if (Playback.IsAudiobookMode)
                    {
                        <PlaybackControlStrip Controls="@AudiobookDockControls.Where(control => control.Sheet is not ("chapters" or "history")).ToList()"
                                              Surface="dock" Appearance="bare" Size="compact" AriaLabel="Audiobook playback tools"
                                              SpeedValue="@Playback.PlaybackRate" SpeedChanged="SetAudiobookSpeedAsync"
                                              SpeedMenuOpen="@(_rateMenuOpen && _rateMenuSurface == "dock")" SpeedMenuOpenChanged="HandleRateMenuOpenChangedAsync"
                                              SleepTimerState="@Playback.SleepTimerState" SleepTimerAvailability="@Playback.SleepTimerAvailability"
                                              SleepTimerOptionsMinutes="@Playback.SleepTimerOptionsMinutes" SleepTimerChanged="SetAudiobookSleepTimerSelectionAsync"
                                              SleepMenuOpen="@(_sleepMenuOpen && _sleepMenuSurface == "dock")" SleepMenuOpenChanged="HandleSleepMenuOpenChangedAsync"
                                              OnControlActivation="HandleAudiobookDockActivationAsync" />
                        <ListenDockTool PanelKey="chapters" Title="@(HasUsableChapters ? "Chapters and history" : "History")"
                                        Glyph="@(HasUsableChapters ? PlaybackUtilityGlyphKind.Chapters : PlaybackUtilityGlyphKind.History)"
                                        ItemKey="@DockItemKey" Inline="@IsDesktopNowPlaying" IsSelected="@(InlinePanelKey is "chapters" or "history")" OnInlineSelected="@(() => SelectInlinePanelAsync(HasUsableChapters ? "chapters" : "history"))" OnOpenChanged="@(open => DockToolChangedAsync(HasUsableChapters ? "chapters" : "history", open))">
                            <ListenContextSidebar ActivePanelKey="@(HasUsableChapters ? "chapters" : "history")" ShowTabs="@HasUsableChapters" OnTabChanged="SelectDockTabAsync" />
                        </ListenDockTool>
                    }
                    else
                    {
                        <ListenDockTool PanelKey="queue" Title="Queue" Glyph="PlaybackUtilityGlyphKind.Queue" ItemKey="@DockItemKey"
                                        Inline="@IsDesktopNowPlaying" IsSelected="@(InlinePanelKey == "queue")" OnInlineSelected="@(() => SelectInlinePanelAsync("queue"))" OnOpenChanged="@(open => DockToolChangedAsync("queue", open))">
                            <ListenContextSidebar ActivePanelKey="queue" ShowTabs="true" OnTabChanged="SelectDockTabAsync" />
                        </ListenDockTool>
                        <ListenDockTool PanelKey="lyrics" Title="Lyrics" Glyph="PlaybackUtilityGlyphKind.Lyrics" ItemKey="@DockItemKey"
                                        Inline="@IsDesktopNowPlaying" IsSelected="@(InlinePanelKey == "lyrics")" OnInlineSelected="@(() => SelectInlinePanelAsync("lyrics"))" OnOpenChanged="@(open => DockToolChangedAsync("lyrics", open))">
                            <ListenContextSidebar ActivePanelKey="lyrics" />
                        </ListenDockTool>
                    }
                    <span class="listen-player__volume">
                        <AppNativeButton Type="button" Class="listen-player__icon" OnClick="ToggleMuteAsync" AriaLabel="@(Playback.IsMuted ? "Unmute" : "Mute")">
                            <PlaybackUtilityGlyph Glyph="@(Playback.IsMuted || Playback.Volume <= 0 ? PlaybackUtilityGlyphKind.Mute : PlaybackUtilityGlyphKind.Volume)" />
                        </AppNativeButton>
                        <PlaybackRangeSlider Surface="dock" Min="0" Max="1" Step="@VolumeStep" Value="@Playback.Volume" ShowTicks="false" CommitOnChange="true" Class="listen-player__volume-slider" AriaLabel="Volume" ValueFormatter="FormatVolumeValue" ValueChanged="SetVolumeOnHostAsync" />
                    </span>
                </div>
                <span class="listen-player__utility-more">
                    <ListenDockTool @ref="_utilityTool" PanelKey="utility-more" Title="More playback controls" Glyph="PlaybackUtilityGlyphKind.More" ItemKey="@DockItemKey">
                        <div class="listen-player__utility-menu">
                            @if (Playback.IsMusicMode)
                            {
                                <AppNativeButton Type="button" OnClick="@(() => OpenDockPanelAsync("queue"))" AriaLabel="Queue">Playing next and history</AppNativeButton>
                                <AppNativeButton Type="button" OnClick="@(() => OpenDockPanelAsync("lyrics"))" AriaLabel="Lyrics">Lyrics</AppNativeButton>
                                <AppNativeButton Type="button" OnClick="@(() => OpenDockPanelAsync("history"))" AriaLabel="History">History</AppNativeButton>
                                <AppNativeButton Type="button" OnClick="ToggleShuffleFromDockAsync" aria-pressed="@(Playback.ShuffleEnabled ? "true" : "false")">Shuffle · @(Playback.ShuffleEnabled ? "On" : "Off")</AppNativeButton>
                                <AppNativeButton Type="button" OnClick="CycleRepeatFromDockAsync">Repeat · @Playback.RepeatMode</AppNativeButton>
                            }
                            else
                            {
                                <AppNativeButton Type="button" OnClick="@(() => OpenDockPanelAsync(HasUsableChapters ? "chapters" : "history"))">@(HasUsableChapters ? "Chapters and history" : "History")</AppNativeButton>
                                <PlaybackControlStrip Controls="@AudiobookDockControls.Where(control => control.Sheet is not ("chapters" or "history")).ToList()"
                                                      Surface="panel" Appearance="bare" Size="compact" AriaLabel="Audiobook playback tools"
                                                      SpeedValue="@Playback.PlaybackRate" SpeedChanged="SetAudiobookSpeedAsync"
                                                      SpeedMenuOpen="@(_rateMenuOpen && _rateMenuSurface == "panel")" SpeedMenuOpenChanged="HandleRateMenuOpenChangedAsync"
                                                      SleepTimerState="@Playback.SleepTimerState" SleepTimerAvailability="@Playback.SleepTimerAvailability"
                                                      SleepTimerOptionsMinutes="@Playback.SleepTimerOptionsMinutes" SleepTimerChanged="SetAudiobookSleepTimerSelectionAsync"
                                                      SleepMenuOpen="@(_sleepMenuOpen && _sleepMenuSurface == "panel")" SleepMenuOpenChanged="HandleSleepMenuOpenChangedAsync"
                                                      OnControlActivation="HandleAudiobookDockActivationAsync" />
                            }
                            <div class="listen-player__more-volume">
                                <AppNativeButton Type="button" OnClick="ToggleMuteAsync" AriaLabel="@(Playback.IsMuted ? "Unmute" : "Mute")">@(Playback.IsMuted ? "Unmute" : "Mute")</AppNativeButton>
                                <PlaybackRangeSlider Surface="panel" Min="0" Max="1" Step="@VolumeStep" Value="@Playback.Volume" ShowTicks="false" CommitOnChange="true" AriaLabel="Volume" ValueFormatter="FormatVolumeValue" ValueChanged="SetVolumeOnHostAsync" />
                            </div>
                        </div>
                    </ListenDockTool>
                </span>
                <AppNativeButton Type="button" Class="listen-player__icon listen-player__popup" OnClick="OpenPopupAsync" AriaLabel="Open separate player window" data-listen-popup-route="@PopupRoute">
                    <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Popup" />
                </AppNativeButton>
                <AppNativeButton Type="button" Class="listen-player__icon listen-player__expand" OnClick="OpenNowPlaying" AriaLabel="@(IsDesktopNowPlaying ? "Collapse Now Playing" : "Open Now Playing")">
                    <PlaybackUtilityGlyph Glyph="@(IsDesktopNowPlaying ? PlaybackUtilityGlyphKind.Collapse : PlaybackUtilityGlyphKind.Expand)" />
                </AppNativeButton>
                <AppNativeButton Type="button" Class="listen-player__icon listen-player__close" OnClick="ClosePlayerAsync" AriaLabel="Close player">
                    <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Close" />
                </AppNativeButton>
            </div>
        </PlaybackMiniPlayer>
        <PlaybackPopover @ref="_compactContext" Title="@ContextToolTitle" ToolId="audio-compact-context" ItemKey="@DockItemKey"
                         Kind="@(_compactPanelKey == "lyrics" ? "lyrics" : "ordinary")" Trigger="@_compactToolTrigger" ShowHeading="false"
                         OpenChanged="@(open => DockToolChangedAsync(_compactPanelKey, open))">
            <ListenContextSidebar @key="_compactPanelKey" ActivePanelKey="@_compactPanelKey"
                                 ShowTabs="@(_compactPanelKey is "queue" or "chapters" || _compactPanelKey == "history" && (Playback.IsMusicMode || HasUsableChapters))" OnTabChanged="SelectDockTabAsync" />
        </PlaybackPopover>

        @if (Playback.PresentationSurface == PlaybackPresentationSurface.NowPlaying)
        {
            @if (!IsPhonePresentation)
            {
                <PlaybackDesktopScene Snapshot="@dockSnapshot" Commands="@PanelCommands" PanelKey="@InlinePanelKey"
                                      PanelChanged="SelectInlinePanelAsync" IsFavorite="@_isFavorite" FavoriteChanged="ToggleFavoriteAsync"
                                      OverallProgress="@DesktopOverallProgress" />
            }
            else
            {
                <PlaybackFullPlayer @ref="_phoneFullPlayer" Snapshot="@dockSnapshot" Commands="@PanelCommands"
                                    OnCollapse="CloseNowPlaying" IsFavorite="@_isFavorite" FavoriteChanged="ToggleFavoriteAsync"
                                    BookmarkRequested="OpenBookmarkDialogAsync" SelectedPanelKey="@InlinePanelKey"
                                    PanelChanged="SelectDockTabAsync" ToolVisibilityChanged="HandleFullPlayerToolsAsync" />
            }
        }
    </div>
}

@code {
    private ListenDockTool? _utilityTool;
    private PlaybackPopover? _compactContext;
    private ElementReference? _compactToolTrigger;
    private string _compactPanelKey = "queue";
    private bool _openCompactToolPending;
    private string ContextToolTitle => _compactPanelKey switch { "lyrics" => "Lyrics", "chapters" => "Chapters and history", "history" => "History", _ => "Queue" };
    private bool HasUsableChapters => CurrentChapters.Count > 1;
    private bool IsCurrentDockSnapshot(ListenPlaybackSnapshot snapshot) => !_disposed && snapshot.ProfileId == Playback.ActiveProfileId
        && snapshot.PlaybackRequestVersion == Playback.PlaybackRequestVersion && snapshot.CurrentIndex >= 0 && snapshot.CurrentIndex < snapshot.Queue.Count
        && snapshot.Queue[snapshot.CurrentIndex].QueueEntryId == Playback.CurrentItem?.QueueEntryId;
    private string DockItemKey => $"{Playback.ActiveProfileId}:{Playback.CurrentItem?.AssetId}:{Playback.PlaybackRequestVersion}";
    private PlaybackTransientToolCoordinator? Tools => Services.GetService<PlaybackTransientToolCoordinator>();
    private IPlaybackCommandSink PanelCommands => Services.GetRequiredService<IPlaybackCommandSink>();
    private bool IsDesktopNowPlaying => Playback.PresentationSurface == PlaybackPresentationSurface.NowPlaying && !IsPhonePresentation;
    private string InlinePanelKey => Playback.IsAudiobookMode && !HasUsableChapters ? "history" : AudioSidebar.For(Playback).ActivePanelKey ?? (Playback.IsAudiobookMode ? "chapters" : "queue");
    private string? DesktopOverallProgress => OverallBookProgress is { } progress
        ? $"{progress.Label} · {(progress.Total > 0 ? progress.Position / progress.Total * 100 : 0).ToString("0", CultureInfo.InvariantCulture)}% · {FormatTimestamp(progress.Position)} of {FormatTimestamp(progress.Total)}" : null;
    private void ObserveLyricsPresentation()
    {
        if (Services.GetService<PlaybackLyricsPresenter>() is { } presenter)
            presenter.Observe(Playback.CreateSnapshot(), PanelCommands);
    }
    private void HandleAudioPanelChanged() => _ = InvokeAsync(() => { ObserveLyricsPresentation(); StateHasChanged(); });
    private async Task SelectInlinePanelAsync(string key)
    {
        Tools?.Close(); CloseRateMenu(); CloseSleepMenu();
        await SelectDockTabAsync(key);
        await InvokeAsync(StateHasChanged);
    }
    private Task SelectDockTabAsync(string key) => AudioSidebar.OpenPanelAsync(Playback.IsAudiobookMode ? "desktop:audiobook" : "desktop:music", key);
    private async Task DockToolChangedAsync(string key, bool open)
    {
        if (open) { CloseRateMenu(); CloseSleepMenu(); await SelectDockTabAsync(key); }
        else if (Tools?.OpenToolId is null) await AudioSidebar.CloseAsync(Playback);
    }
    private async Task OpenDockPanelAsync(string key, ElementReference? trigger = null)
    {
        if (IsDesktopNowPlaying) { await SelectInlinePanelAsync(key); return; }
        Tools?.Close();
        _compactPanelKey = key;
        _compactToolTrigger = trigger ?? _utilityTool?.TriggerElement;
        await SelectDockTabAsync(key);
        _openCompactToolPending = _compactToolTrigger is not null;
        await InvokeAsync(StateHasChanged);
    }
    private const string PopupRoute = "/listen/player-popup";
    private static string ArtworkUrl(string? source, string size)
        => MediaTileArtworkUrl.Sized(source, size) ?? source ?? string.Empty;
    private static string? ArtworkSrcSet(string? source)
        => MediaTileArtworkUrl.SrcSet(
            MediaTileArtworkUrl.Sized(source, "s"),
            MediaTileArtworkUrl.Sized(source, "m"),
            MediaTileArtworkUrl.Sized(source, "l"));
    private readonly JsonSerializerOptions _jsonOptions = MediaEngineJson.Web;
    private ElementReference _audioRef;
    private ElementReference _playerShellRef;
    private DotNetObjectReference<ListenNowPlayingBar>? _selfReference;
    private PlaybackFullPlayer? _phoneFullPlayer;
    private bool _nowPlayingFocused;
    private bool _isPhonePresentation;
    private bool IsPhonePresentation => _isPhonePresentation;
    private IJSObjectReference? _audioPresentationModule;
    private readonly string _audioPresentationObserverId = Guid.NewGuid().ToString("D");
    private bool _restored;
    private bool _disposed;
    private string? _playbackRestoreError;
    private string? _lastAppliedStreamUrl;
    private string? _lastSeekedStreamUrl;
    private double? _lastSeekedPositionSeconds;
    private long _lastAppliedStartVersion = -1;
    private bool? _lastAppliedPlayingState;
    private long _playbackChangeNotificationVersion;
    private double? _lastAppliedVolume;
    private bool? _lastAppliedMuteState;
    private double? _lastAppliedPlaybackRate;
    private bool _rateMenuOpen;
    private string? _rateMenuSurface;
    private bool _sleepMenuOpen;
    private string? _sleepMenuSurface;
    private long _transientPlaybackRequestVersion = -1;
    private long _nativeSleepTimerBindVersion;
    private readonly object _nativeSleepTimerBindingGate = new();
    private PendingNativeSleepTimerBinding? _pendingNativeSleepTimerBinding;
    private NativeSleepTimerBindingRequest? _nativeSleepTimerBinding;
    private AudiobookBookmarkActionContext? _bookmarkDialogContext;
    private AudiobookBookmarkActionSnapshot? _bookmarkDialogSnapshot;
    private ElementReference _bookmarkTrigger;
    private IReadOnlySet<Guid> _bookmarkAuthorizedAssetIds = new HashSet<Guid>();
    private string? _bookmarkWorkTitle;
    private bool _shortcutsRegistered;
    private bool _scrollActiveChapterPending;

    private string PlayerShellClass
    {
        get
        {
            var classes = IsListenRoute
                ? "listen-player-shell listen-player-shell--listen-route"
                : "listen-player-shell";

            if (Playback.PresentationSurface == PlaybackPresentationSurface.NowPlaying)
            {
                classes += " listen-player-shell--expanded";
            }

            return Playback.IsAudiobookMode
                ? $"{classes} listen-player-shell--audiobook"
                : classes;
        }
    }

    private bool IsListenRoute => Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath.StartsWith("/listen", StringComparison.OrdinalIgnoreCase);

    private double ProgressMax => Playback.DurationSeconds > 0 ? Playback.DurationSeconds : 1;
    private sealed record NativeSleepTimerBindingRequest(
        AudiobookSleepTimerStateDto State,
        Guid AssetId,
        long RequestVersion,
        string? SourceUrl);
    private sealed record PendingNativeSleepTimerBinding(
        NativeSleepTimerBindingRequest Request,
        long Version,
        TaskCompletionSource<bool> Completion);
    private AudiobookPlaybackProjection? OverallBookProgress => Playback.IsAudiobookMode
        ? AudiobookPlaybackProjection.Create(Playback.CurrentItem?.Chapters, Playback.CurrentItem?.AssetId,
            Playback.CurrentTimeSeconds, Playback.DurationSeconds)
        : null;
    private Guid? _favoriteSongId, _favoriteProfileId;
    private long _favoriteLoadGeneration;
    private bool _isFavorite;
    private double VolumeStep => Playback.ClientSettings.VolumeStep;
    private string ProgressValueText => $"{FormatTimestamp(Playback.CurrentTimeSeconds)} of {FormatTimestamp(ProgressMax)}";
    private static string FormatVolumeValue(double value) => $"{Math.Clamp((int)Math.Round(value * 100d), 0, 100)}%";
    private Task ToggleShuffleFromDockAsync() => Playback.ToggleShuffleAsync();
    private Task CycleRepeatFromDockAsync() => Playback.CycleRepeatModeAsync();
    private void OpenCurrentDetails()
    {
        if (Playback.CurrentItem is not { } current)
        {
            return;
        }

        var route = Playback.IsMusicMode && current.CollectionId.HasValue
            ? $"/details/musicalbum/{current.CollectionId.Value:D}?context=listen&track={current.WorkId:D}"
            : $"/details/work/{current.WorkId:D}?context=listen";
        Nav.NavigateTo(route);
    }
    private bool CanPlayNext =>
        Playback.CurrentIndex < Playback.Queue.Count - 1
        || Playback.Queue.Count > 1 && Playback.ShuffleEnabled
        || Playback.Queue.Count > 0 && Playback.RepeatMode == PlayerRepeatModes.All;
    private string RepeatAriaLabel => Playback.RepeatMode switch
    {
        PlayerRepeatModes.One => "Repeat one",
        PlayerRepeatModes.All => "Repeat queue",
        _ => "Repeat off",
    };
    private PlaybackExperience CurrentMiniPlayerExperience => Playback.IsAudiobookMode ? PlaybackExperience.Audiobook : PlaybackExperience.Music;
    private IReadOnlyList<PlaybackChapterDto> CurrentChapters =>
