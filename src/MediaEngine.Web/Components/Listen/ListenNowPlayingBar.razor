    private async Task HandleAudioStarted()
    {
        if (Playback.IsVideoMode) return;
        Playback.MarkPlaybackStarted();
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task HandleAudioPaused()
    {
        if (Playback.IsVideoMode || Playback.Phase == PlaybackPhase.Loading) return;
        Playback.UpdateTransportState(isPlaying: false);
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private Task HandleAudioErrorAsync()
    {
        if (Playback.IsVideoMode) return Task.CompletedTask;
        Playback.MarkCurrentFailed("This audio source failed to load or play.");
        return Task.CompletedTask;
    }

    private async Task TogglePlayPauseAsync()
    {
        if (await ConsumeImmediateToggleAsync())
        {
            return;
        }

        if (Playback.IsPlaying && !Playback.NeedsUserGestureToStart)
        {
            await PauseAudioAsync();
            return;
        }

        if (!string.IsNullOrWhiteSpace(Playback.CurrentBrowserStreamUrl))
        {
            await StartAudioAsync(new PlaybackTransportCommand(
                "start",
                Value: Playback.CurrentTimeSeconds,
                StreamUrl: Playback.CurrentBrowserStreamUrl,
                PositionSeconds: Playback.CurrentTimeSeconds,
                PlaybackRate: Playback.PlaybackRate,
                RequestId: Playback.PlaybackStartVersion));
            return;
        }

        var started = await JS.InvokeAsync<bool>("listenPlayback.playAudio", _audioRef);
        if (started)
        {
            Playback.MarkPlaybackStarted();
        }
        else
        {
            await HandleStartFailureAsync();
        }
    }

    private async Task StartAudioAsync(PlaybackTransportCommand command)
    {
        var requestVersion = Playback.PlaybackRequestVersion;
        var rateSelectionVersion = Playback.PlaybackRateSelectionVersion;
        var streamUrl = StringHelpers.FirstNonBlankOr("Library audio", command.StreamUrl, Playback.CurrentBrowserStreamUrl);
        var positionSeconds = Math.Max(0, command.PositionSeconds ?? command.Value ?? Playback.CurrentTimeSeconds);
        var playbackRate = command.PlaybackRate ?? Playback.PlaybackRate;
        var started = await JS.InvokeAsync<bool>(
            "listenPlayback.startAudio",
            _audioRef,
            new
            {
                streamUrl,
                positionSeconds,
                playbackRate,
                volume = Playback.Volume,
                muted = Playback.IsMuted,
            });

        if (!string.IsNullOrWhiteSpace(streamUrl))
        {
            _lastAppliedStreamUrl = streamUrl;
            _lastSeekedStreamUrl = streamUrl;
        }

        _lastSeekedPositionSeconds = positionSeconds;
        _lastAppliedVolume = Playback.Volume;
        _lastAppliedMuteState = Playback.IsMuted;
        _lastAppliedPlayingState = started;

        if (requestVersion != Playback.PlaybackRequestVersion) return;
        if (started)
        {
            Playback.UpdateTransportState(
                currentTimeSeconds: positionSeconds,
                isPlaying: true,
                playbackRate: playbackRate,
                expectedPlaybackRateSelectionVersion: rateSelectionVersion,
                needsUserGestureToStart: false);
            if (rateSelectionVersion == Playback.PlaybackRateSelectionVersion)
                _lastAppliedPlaybackRate = playbackRate;
            Playback.MarkPlaybackStarted();
            await Playback.ReportHeartbeatAsync(force: true);
        }
        else
        {
            await HandleStartFailureAsync();
        }
    }

    private async Task PauseAudioAsync()
    {
        await JS.InvokeVoidAsync("listenPlayback.pauseAudio", _audioRef);
        Playback.UpdateTransportState(isPlaying: false);
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task ApplyPlaybackRateAsync(double rate)
    {
        if (!PlaybackRateOptions.IsValid(rate) || Playback.CurrentItem?.AssetId is not Guid assetId) return;
        var playbackRequestVersion = Playback.PlaybackRequestVersion;
        var rateSelectionVersion = Playback.PlaybackRateSelectionVersion;
        await JS.InvokeVoidAsync("listenPlayback.setPlaybackRate", _audioRef, rate);
        if (Playback.PlaybackRateSelectionVersion != rateSelectionVersion
            || !Playback.TrySetPlaybackRateFromHost(rate, assetId, playbackRequestVersion)) return;
        _lastAppliedPlaybackRate = rate;
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task PlayNextAsync()
    {
        if (Playback.IsAudiobookMode)
        {
            await SkipForwardAsync();
            return;
        }

        await Playback.SkipNextAsync();
    }

    private async Task PlayPreviousAsync()
    {
        if (Playback.IsAudiobookMode)
        {
            await SkipBackAsync();
            return;
        }

        // Music: after a few seconds of play Previous restarts the song; inside the first seconds, or on a second press, it goes back (D3).
        if (Playback.PressMusicPrevious() == PlaybackPreviousAction.Restart)
        {
            await SeekOnHostAsync(0);
            return;
        }

        await Playback.SkipPreviousAsync();
    }

    private Task PlayNextChapterAsync() => Playback.DispatchAsync(new PlaybackCommand(PlaybackCommandKind.PlayNextChapter));

    private Task PlayPreviousChapterAsync() => Playback.DispatchAsync(new PlaybackCommand(PlaybackCommandKind.PlayPreviousChapter));

    private Task SkipBackAsync() => SkipRelativeAsync(-Playback.SkipBackSeconds);

    private Task SkipForwardAsync() => SkipRelativeAsync(Playback.SkipForwardSeconds);

    private async Task SkipRelativeAsync(double deltaSeconds)
    {
        if (await ConsumeImmediateSeekAsync())
        {
            return;
        }

        await SeekRelativeOnHostAsync(deltaSeconds);
    }

    private async Task<bool> ConsumeImmediateToggleAsync()
    {
        try
        {
            if (!await JS.InvokeAsync<bool>("listenPlayback.consumeImmediateToggleHandled"))
            {
                return false;
            }

            await HandleAudioMetricsChangedAsync();
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not consume immediate audio toggle.");
            return false;
        }
    }

    private async Task<bool> ConsumeImmediateSeekAsync()
    {
        try
        {
            if (!await JS.InvokeAsync<bool>("listenPlayback.consumeImmediateSeekHandled"))
            {
                return false;
            }

            await HandleAudioMetricsChangedAsync();
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not consume immediate audio seek.");
            return false;
        }
    }

    private Task SeekRelativeOnHostAsync(double deltaSeconds)
    {
        var max = Playback.DurationSeconds > 0 ? Playback.DurationSeconds : double.MaxValue;
        var next = Math.Clamp(Playback.CurrentTimeSeconds + deltaSeconds, 0, max);
        return SeekOnHostAsync(next);
    }

    private async Task SeekAsync(ChangeEventArgs args)
    {
        if (!double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var seconds))
        {
            return;
        }

        await SeekOnHostAsync(seconds);
    }

    private async Task SeekOnHostAsync(double seconds)
    {
        var next = Math.Max(0, seconds);
        await JS.InvokeVoidAsync("listenPlayback.seekAudio", _audioRef, next);
        _lastSeekedStreamUrl = Playback.CurrentBrowserStreamUrl;
        _lastSeekedPositionSeconds = next;
        Playback.UpdateTransportState(currentTimeSeconds: next);
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task SetVolumeOnHostAsync(double volume)
    {
        await ApplyVolumeOnHostAsync(volume);
    }

    private Task ToggleMuteAsync() => Playback.DispatchAsync(new PlaybackCommand(PlaybackCommandKind.ToggleMute));

    private async Task ApplyVolumeOnHostAsync(double volume)
    {
        var next = Math.Clamp(volume, 0d, 1d);
        var muted = next <= 0d;
        await JS.InvokeVoidAsync("listenPlayback.setVolume", _audioRef, next);
        await JS.InvokeVoidAsync("listenPlayback.setMuted", _audioRef, muted);
        _lastAppliedVolume = next;
        _lastAppliedMuteState = muted;
        Playback.UpdateTransportState(volume: next, isMuted: muted);
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private Task ToggleMuteOnHostAsync() => ApplyVolumeOnHostAsync(Playback.GetMuteToggleTargetVolume());

    private async Task HandleMusicPanelControl(PlaybackControlDefinition control)
    {
        if (control.IsDisabled)
        {
            return;
        }

        CloseSettingsMenu();

        switch (control.Key)
        {
            case PlaybackControlKey.Queue:
                await OpenDockPanelAsync("queue");
                break;
            case PlaybackControlKey.History:
                await OpenDockPanelAsync("history");
                break;
            case PlaybackControlKey.Lyrics:
                await OpenDockPanelAsync("lyrics");
                break;
            case PlaybackControlKey.Shuffle:
                await Playback.ToggleShuffleAsync();
                break;
            case PlaybackControlKey.Repeat:
                await Playback.CycleRepeatModeAsync();
                break;
        }
    }

    private void HandlePlayerKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal) && Tools?.IsPinnedFor("audio-lyrics") != true
            && Tools?.IsPinnedFor("audio-queue") != true && Tools?.IsPinnedFor("audio-chapters") != true) Tools?.Close();
    }

    private NowPlayingLauncher? _launcher;

    // The navbar icon asks the bar, which alone knows whether it is drawn for a phone: a phone toggles its expanded player, a desktop opens or leaves the page.
    private void HandleNowPlayingRequested() => _ = InvokeAsync(async () =>
    {
        if (_disposed || !Playback.HasQueue || Playback.IsVideoMode) return;
        if (IsPhonePresentation && Playback.PresentationSurface == PlaybackPresentationSurface.NowPlaying) await CloseNowPlaying();
        else await OpenNowPlaying();
    });

    private async Task OpenNowPlaying()
    {
        Tools?.Close(); CloseSettingsMenu();
        if (IsNowPlayingPage) { await CloseNowPlaying(); return; }
        if (!IsPhonePresentation)
        {
            // A desktop opens the Now playing page and remembers where the person was, so Back to library and Close return there.
            OpenNowPlayingPage(returnTo: null);
            await LoadFavoriteAsync();
            return;
        }
        Playback.SetPresentationSurface(PlaybackPresentationSurface.NowPlaying);
        await LoadFavoriteAsync();
    }

    private void OpenNowPlayingPage(string? returnTo)
    {
        // A stale phone overlay (the window was widened while it was open) must not stay behind the page.
        if (Playback.PresentationSurface == PlaybackPresentationSurface.NowPlaying) Playback.SetPresentationSurface(PlaybackPresentationSurface.Docked);
        var from = returnTo ?? DetailsOverlayState.ToAppPath(Nav, RoutedPageAddress.AbsoluteFor(Nav, Overlay));
        Nav.NavigateTo(NowPlayingRoute.Build(from));
    }

    private async Task LoadFavoriteAsync()
    {
        var generation = Interlocked.Increment(ref _favoriteLoadGeneration);
        var item = Playback.CurrentItem;
        var request = Playback.PlaybackRequestVersion;
        var profileId = Playback.ActiveProfileId;
        _isFavorite = false;
        _favoriteSongId = null;
        _favoriteProfileId = null;
        if (!Playback.IsMusicMode || item?.WorkId is not { } workId || workId == Guid.Empty) return;
        var profile = await Orchestrator.GetActiveProfileAsync();
        bool Current() => !_disposed && generation == Volatile.Read(ref _favoriteLoadGeneration)
            && Playback.IsMusicMode && Playback.PlaybackRequestVersion == request
            && Playback.CurrentItem?.WorkId == workId && Playback.ActiveProfileId == profileId;
        if (!Current() || profile?.Id != profileId) return;
        var reaction = await Reactions.GetReactionAsync(workId, profileId, ProfileEntityKind.Song);
        if (!Current()) return;
        _favoriteSongId = workId;
        _favoriteProfileId = profileId;
        _isFavorite = reaction == MediaReaction.Love;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleFavoriteAsync()
    {
        var request = Playback.PlaybackRequestVersion;
        var profileId = Playback.ActiveProfileId;
        if (!Playback.IsMusicMode || Playback.CurrentItem?.WorkId is not { } workId || workId == Guid.Empty) return;
        bool Current() => !_disposed && Playback.IsMusicMode && Playback.PlaybackRequestVersion == request
            && Playback.CurrentItem?.WorkId == workId && Playback.ActiveProfileId == profileId;
        var profile = await Orchestrator.GetActiveProfileAsync();
        if (!Current()) return;
        if (profile is null || profile.Id != profileId)
        {
            Snackbar.Add(L["Common_FavoritesRequireAnActiveProfile"].Value, AppSeverity.Warning);
            return;
        }
        if (_favoriteSongId != workId || _favoriteProfileId != profileId) await LoadFavoriteAsync();
        if (!Current()) return;
        await Reactions.SetReactionAsync(workId, _isFavorite ? MediaReaction.Neutral : MediaReaction.Love, profile.Id, ProfileEntityKind.Song);
        if (Current()) await LoadFavoriteAsync();
    }

    // Unified player D6: an audiobook started from a details window must not stay under it. The window is a modal dialog, so it would hide the
    // bar and block the player; step it aside, show Now Playing, and open the same details page again when the person closes Now Playing.
    // Optional: a host rendered without the details overlay (some tests, the pop-out window) simply never steps one aside.
    private DetailsOverlayState? DetailsOverlay => Services.GetService<DetailsOverlayState>();
    private long _lastAudiobookRequestVersion = -1;
    private string? _returnToDetailsUri;

    private async Task StepAsideForNewAudiobookAsync()
    {
        var version = Playback.PlaybackRequestVersion;
        if (!Playback.IsAudiobookMode || Playback.IsVideoMode || version == _lastAudiobookRequestVersion) return;
        _lastAudiobookRequestVersion = version;
        if (DetailsOverlay is not { IsOpen: true } overlay || overlay.Current.OverlayUri is not { } detailsUri) return;
        if (!await overlay.DismissAsync()) return;
        if (!IsPhonePresentation)
        {
            // The page remembers the details window as the place to come back to.
            OpenNowPlayingPage(returnTo: detailsUri);
            return;
        }
        _returnToDetailsUri = detailsUri;
        Playback.SetPresentationSurface(PlaybackPresentationSurface.NowPlaying);
    }

    private void ReturnToDetailsAfterNowPlaying()
    {
        if (_returnToDetailsUri is not { } uri) return;
        _returnToDetailsUri = null;
        if (DetailsOverlay is { IsOpen: false }) Nav.NavigateTo(Nav.ToAbsoluteUri(uri).ToString());
    }

    private async Task CloseNowPlaying()
    {
        Tools?.Close(); CloseSettingsMenu();
        Playback.SetPresentationSurface(PlaybackPresentationSurface.Docked);
        // Leaving the page is going back to where the person came from; playback keeps going.
        if (IsNowPlayingPage) Nav.NavigateTo(NowPlayingRoute.ReturnTarget(Nav, Overlay));
        ReturnToDetailsAfterNowPlaying();
        if (_shell?.ArtworkElement is { } artwork) await artwork.FocusAsync();
    }

    private Task HandleFullPlayerToolsAsync(bool open)
    {
        if (open)
        {
            if (Tools?.OpenToolId is { } dockTool && dockTool.StartsWith("audio-", StringComparison.Ordinal)) Tools.Close(dockTool);
            CloseSettingsMenu();
