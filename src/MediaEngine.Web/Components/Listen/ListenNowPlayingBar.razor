    private sealed record BookProgressValue(string Label, double Position, double Total);
    private BookProgressValue? OverallBookProgress
    {
        get
        {
            if (!Playback.IsAudiobookMode || Playback.DurationSeconds <= 0) return null;
            var recording = Playback.CurrentItem;
            var parts = recording?.Chapters
                .Where(chapter => chapter.AssetId.HasValue)
                .GroupBy(chapter => chapter.AssetId!.Value)
                .OrderBy(group => group.Min(chapter => chapter.Index))
                .ToList();
            if (parts is not { Count: > 1 })
                return new("Book progress", Math.Clamp(Playback.CurrentTimeSeconds, 0, Playback.DurationSeconds), Playback.DurationSeconds);

            if (parts.Any(group => group.Any(chapter => !chapter.EndSeconds.HasValue)) ||
                recording?.AssetId is not Guid currentAssetId ||
                !parts.Any(group => group.Key == currentAssetId))
                return new("Current recording", Math.Clamp(Playback.CurrentTimeSeconds, 0, Playback.DurationSeconds), Playback.DurationSeconds);

            var total = parts.Sum(group => group.Max(chapter => chapter.EndSeconds!.Value));
            var before = 0d;
            foreach (var part in parts)
            {
                if (part.Key == currentAssetId) break;
                before += part.Max(chapter => chapter.EndSeconds!.Value);
            }
            return total > 0
                ? new("Book progress", Math.Clamp(before + Playback.CurrentTimeSeconds, 0, total), total)
                : null;
        }
    }
