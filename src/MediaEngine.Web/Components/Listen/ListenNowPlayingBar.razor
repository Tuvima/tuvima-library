        {
            if (_sleepMenuSurface == state.Surface) CloseSleepMenu();
            return;
        }

        _sleepMenuOpen = true;
        _sleepMenuSurface = state.Surface;
        _transientPlaybackRequestVersion = Playback.PlaybackRequestVersion;
        CloseRateMenu();
        _isMusicDockMoreOpen = false;
