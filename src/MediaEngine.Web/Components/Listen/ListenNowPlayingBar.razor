    {
        if (_disposed || !double.IsFinite(width) || width <= 0) return Task.CompletedTask;
        var isPhone = width <= 720;
        if (_isPhonePresentation == isPhone) return Task.CompletedTask;
        _isPhonePresentation = isPhone;
        CloseRateMenu(); CloseSleepMenu(); Tools?.Close();
        return InvokeAsync(StateHasChanged);
    }

