    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A full reload of a deep URL can mount the bar and dispose it again while its first render is still
        // awaiting the browser; the self reference is gone by then, so stop instead of using it.
        if (_disposed) return;
        try
        {
            await RunAfterRenderAsync(firstRender);
        }
        catch (JSDisconnectedException)
        {
            // The browser connection is gone, so there is nothing left to synchronise.
        }
        catch (Exception exception) when (_disposed && exception is ObjectDisposedException or JSException or TaskCanceledException or InvalidOperationException)
        {
            Logger.LogDebug(exception, "The playback bar was disposed while its browser calls were still running.");
        }
    }

    private async Task RunAfterRenderAsync(bool firstRender)
    {
        if (_openCompactToolPending && _compactContext is not null)
        {
            _openCompactToolPending = false;
            await _compactContext.OpenAsync(true);
        }
        if (firstRender)
        {
            try
            {
                await RegisterBrowserClientAsync();
            }
            catch (JSDisconnectedException)
            {
                return;
            }
            catch (Exception exception) when (_disposed && exception is ObjectDisposedException or JSException or TaskCanceledException)
            {
                Logger.LogDebug(exception, "The playback bar was disposed while it was connecting to the browser.");
            }

            if (_disposed)
            {
                // Disposal ran before registration finished and could not undo what registration added afterwards.
                await DetachBrowserClientAsync();
                _selfReference?.Dispose();
                _selfReference = null;
                return;
            }
        }

        if (Playback.HasQueue && !Playback.IsVideoMode && !_shortcutsRegistered && _selfReference is not null)
        {
            await JS.InvokeVoidAsync("listenPlayback.registerPlayerShortcuts", _playerShellRef, _selfReference);
            _shortcutsRegistered = true;
        }

        if (!_closeInProgress && !Playback.IsVideoMode
            && Playback.CurrentItem is not null
            && !string.IsNullOrWhiteSpace(Playback.CurrentBrowserStreamUrl))
        {
            await PrepareAudioSourceAsync();
            await SyncNativeSleepTimerAsync();
            await SyncAudioAsync();
        }

        if (_scrollActiveChapterPending)
        {
            _scrollActiveChapterPending = false;
            await JS.InvokeVoidAsync("playbackTools.scrollActiveChapter");
        }

        var vaultLocked = Services.GetService<NsfwModeState>() is not { Unlocked: true };
        var mediaSubject = $"{Playback.ActiveProfileId}:{Playback.CurrentItem?.WorkId}:{Playback.CurrentItem?.AssetId}:{Playback.PlaybackRequestVersion}:{Playback.IsDismissed}:{Playback.IsVideoMode}:{Playback.CurrentChapter?.Title}:{Playback.SkipBackSeconds}:{Playback.SkipForwardSeconds}:{vaultLocked}";
        if (_mediaSessionModule is not null && _mediaSessionSubject != mediaSubject)
        {
            _mediaSessionSubject = mediaSubject;
            var current = Playback.CurrentItem;
            // One builder serves the audio bar and the video player (unified player v2 D27): same lines as the bar, the actions that work, no metadata for a locked Vault item.
            var metadata = current is null || Playback.IsDismissed || Playback.IsVideoMode
                ? null
                : PlaybackSessionMetadata.Create(new PlaybackSessionContext(BarMedia, current, new Uri(Nav.BaseUri),
                    ChapterTitle: Playback.CurrentChapter?.Title, SkipBackSeconds: Playback.SkipBackSeconds, SkipForwardSeconds: Playback.SkipForwardSeconds, VaultLocked: vaultLocked));
            await _mediaSessionModule.InvokeVoidAsync("metadata", metadata);
        }

        var nowPlayingOpen = Playback.PresentationSurface == PlaybackPresentationSurface.NowPlaying && IsPhonePresentation;
        if (nowPlayingOpen && !_nowPlayingFocused)
        {
            await JS.InvokeVoidAsync("playbackTools.capturePlayerFocus", _phoneFullPlayer?.Element ?? default);
            _nowPlayingFocused = true;
        }
        else if (!nowPlayingOpen && _nowPlayingFocused)
        {
            await JS.InvokeVoidAsync("playbackTools.restorePlayerFocus");
            _nowPlayingFocused = false;
        }
    }

    private async Task RegisterBrowserClientAsync()
    {
        _browserClientRegistering = true;
        _selfReference = DotNetObjectReference.Create(this);
        _audioPresentationModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-audio-presentation.js");
        if (_disposed) return;
        if (_audioPresentationModule is not null) await _audioPresentationModule.InvokeVoidAsync("attach", _audioPresentationObserverId, _selfReference);
        await JS.InvokeVoidAsync("listenPlayback.configure", Playback.ClientSettings);
        await ConfigurePlaybackClientContextAsync();
        await JS.InvokeVoidAsync("listenPlayback.registerCommandHandler", _selfReference);
        await JS.InvokeVoidAsync(
            "listenPlayback.registerAudioStateObserver",
            _audioRef,
            _selfReference,
            Playback.ClientSettings.AudioObserverIntervalMilliseconds);
        if (_disposed) return;

        _audioCapabilitiesModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-output.js");
        if (_audioCapabilitiesModule is not null) {
            var audioCapabilities = await _audioCapabilitiesModule.InvokeAsync<AudioOutputStateDto>("attach", _selfReference);
            if (audioCapabilities is not null) Playback.SetAudioCapabilities(audioCapabilities.Supported, audioCapabilities.SoftwareVolumeSupported);
        }
        _mediaSessionModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-media-session.js");
        if (_mediaSessionModule is not null) await _mediaSessionModule.InvokeVoidAsync("attach", _audioRef, _selfReference);
        _restored = await RestorePlaybackStateStreamAsync();
        if (_disposed) return;
        await Playback.SetTransportHostReadyAsync();
    }

    private async Task ConfigurePlaybackClientContextAsync()
    {
        Playback.SetClientContext(PlaybackClientContext.WebDefault);
        await Task.CompletedTask;
    }

    private void HandlePlaybackChanged(PlaybackChangeKind changeKind)
    {
        var notificationVersion = Interlocked.Increment(ref _playbackChangeNotificationVersion);
        _ = InvokeAsync(async () =>
        {
            ObserveLyricsPresentation();
            await StepAsideForNewAudiobookAsync();
            var playbackRequestVersion = Playback.PlaybackRequestVersion;
            if (_settingsMenuOpen && _transientPlaybackRequestVersion != playbackRequestVersion)
            {
                CloseSettingsMenu();
            }
            StateHasChanged();
            _ = TimelineScope.EnsureLoadedAsync(); // a different profile has its own Chapter or Book choice
            _ = RefreshBarMarkersAsync();

            var snapshotJson = Playback.HasQueue
                ? JsonSerializer.Serialize(Playback.CreateSnapshot(), _jsonOptions)
                : null;
            var shouldPauseAudio = Playback.IsVideoMode && _lastAppliedStreamUrl is not null;
            var shouldLoadFavorite = Playback.IsMusicMode && (Playback.CurrentItem?.WorkId != _favoriteSongId || Playback.ActiveProfileId != _favoriteProfileId) &&
                                     changeKind is PlaybackChangeKind.State or PlaybackChangeKind.Queue;

            if (shouldPauseAudio)
            {
                await JS.InvokeVoidAsync("listenPlayback.pauseAudio", _audioRef);
                _lastAppliedPlayingState = false;
            }

            if (_restored && notificationVersion == Volatile.Read(ref _playbackChangeNotificationVersion) &&
                playbackRequestVersion == Playback.PlaybackRequestVersion)
            {
                try
                {
                    if (snapshotJson is not null)
                    {
                        await JS.InvokeVoidAsync("listenPlayback.setState", snapshotJson);
                    }
                    else
                    {
                        await JS.InvokeVoidAsync("listenPlayback.clearState");
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogDebug(ex, "Could not persist listen playback state to browser storage.");
                }
            }

            if (notificationVersion == Volatile.Read(ref _playbackChangeNotificationVersion) &&
                playbackRequestVersion == Playback.PlaybackRequestVersion && shouldLoadFavorite)
            {
                await LoadFavoriteAsync();
            }
        });
    }

    private async Task<bool> RestorePlaybackStateStreamAsync()
    {
        var restoreGeneration = Volatile.Read(ref _playbackChangeNotificationVersion);
        try
        {
            var hasStoredState = await JS.InvokeAsync<bool>("listenPlayback.hasState");
            if (_disposed || restoreGeneration != Volatile.Read(ref _playbackChangeNotificationVersion))
            {
                return _restored;
            }

            if (!hasStoredState)
            {
                _playbackRestoreError = null;
                return true;
            }

            var snapshotStream = await JS.InvokeAsync<IJSStreamReference>("listenPlayback.getStateStream");
            if (_disposed || restoreGeneration != Volatile.Read(ref _playbackChangeNotificationVersion))
            {
                await DisposeUnusedPlaybackStreamAsync(snapshotStream);
                return _restored;
            }

            var snapshot = await PlaybackSnapshotStream.ReadAsync(snapshotStream, _jsonOptions);
            if (_disposed || restoreGeneration != Volatile.Read(ref _playbackChangeNotificationVersion)) return _restored;
            if (snapshot is not null) Playback.RestoreInitialState(snapshot);

            _playbackRestoreError = null;
            return true;
        }
        catch (Exception exception)
        {
            if (_disposed || restoreGeneration != Volatile.Read(ref _playbackChangeNotificationVersion)) return _restored;
            Logger.LogDebug(exception, "Could not restore listen playback state from the browser stream.");
            _playbackRestoreError = L["ListenNowPlayingBar_PlaybackStateCouldNotBe"].Value;
            return false;
        }
    }

    private static async Task DisposeUnusedPlaybackStreamAsync(IJSStreamReference reference)
    {
        try { await reference.DisposeAsync(); }
        catch (Exception) { }
    }

    private async Task RetryPlaybackStateRestoreAsync()
    {
        _restored = await RestorePlaybackStateStreamAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleStartFailureAsync()
    {
        var failure = await JS.InvokeAsync<string>("listenPlayback.startFailure", _audioRef);
        if (failure == "AbortError") return; // A superseding source/start owns the result.
        if (failure == "NotAllowedError") Playback.MarkNeedsUserGestureToStart();
        else Playback.MarkCurrentFailed("The media source could not start playback. Retry playback or check the source.");
    }

    private async Task SyncAudioAsync()
    {
        var browserStreamUrl = Playback.CurrentBrowserStreamUrl;
        var targetPositionSeconds = Playback.CurrentTimeSeconds;
        var targetPlaybackRate = Playback.PlaybackRate;
        var hasAppliedStartVersion = _lastAppliedStartVersion >= 0;
        var startVersionChanged = hasAppliedStartVersion
            && _lastAppliedStartVersion != Playback.PlaybackStartVersion;
        if (!hasAppliedStartVersion || startVersionChanged)
        {
            _lastAppliedStartVersion = Playback.PlaybackStartVersion;
            _lastSeekedStreamUrl = null;
            _lastSeekedPositionSeconds = null;
            _lastAppliedPlayingState = null;
        }

        await PrepareAudioSourceAsync();

        if (_lastAppliedVolume != Playback.Volume)
        {
            await JS.InvokeVoidAsync("listenPlayback.setVolume", _audioRef, Playback.Volume);
            _lastAppliedVolume = Playback.Volume;
        }

        if (_lastAppliedMuteState != Playback.IsMuted)
        {
            await JS.InvokeVoidAsync("listenPlayback.setMuted", _audioRef, Playback.IsMuted);
            _lastAppliedMuteState = Playback.IsMuted;
        }

        if (!_lastAppliedPlaybackRate.HasValue || Math.Abs(_lastAppliedPlaybackRate.Value - targetPlaybackRate) >= 0.01d)
        {
            await JS.InvokeVoidAsync("listenPlayback.setPlaybackRate", _audioRef, targetPlaybackRate);
            _lastAppliedPlaybackRate = targetPlaybackRate;
        }

        var streamChanged = !string.Equals(_lastSeekedStreamUrl, browserStreamUrl, StringComparison.Ordinal);
        var shouldSeek = targetPositionSeconds > 0 && streamChanged
            || startVersionChanged;
        if (shouldSeek)
        {
            await JS.InvokeVoidAsync("listenPlayback.seekAudio", _audioRef, targetPositionSeconds);
            _lastSeekedStreamUrl = browserStreamUrl;
            _lastSeekedPositionSeconds = targetPositionSeconds;
        }

        if (_lastAppliedPlayingState != Playback.IsPlaying)
        {
            if (Playback.IsPlaying)
            {
                if (Playback.IsAudiobookMode
                    && Playback.SleepTimerState.Mode != AudiobookSleepTimerModes.Off
                    && !IsSleepTimerBindingCurrent(Playback.SleepTimerState, browserStreamUrl))
                {
                    return;
                }

                var started = await JS.InvokeAsync<bool>("listenPlayback.playAudio", _audioRef);
                if (!started)
                {
                    await HandleStartFailureAsync();
                }
            }
            else
            {
                await JS.InvokeVoidAsync("listenPlayback.pauseAudio", _audioRef);
            }

            _lastAppliedPlayingState = Playback.IsPlaying;
        }
    }

    private async Task HandleAudioMetricsChangedAsync()
    {
        var rateSelectionVersion = Playback.PlaybackRateSelectionVersion;
        var state = await JS.InvokeAsync<AudioMetrics>("listenPlayback.readAudioState", _audioRef);
        await ApplyAudioMetricsAsync(state, rateSelectionVersion);
    }

    [JSInvokable]
    public Task HandleObservedAudioState(AudioMetrics state) =>
        ApplyAudioMetricsAsync(state, expectedRateSelectionVersion: null);

    [JSInvokable]
    public async Task HandlePlayerShortcut(string action)
    {
        switch (action)
        {
            case "toggle-play":
                await TogglePlayPauseAsync();
                break;
            case "skip-back":
                await SkipBackAsync();
                break;
            case "skip-forward":
                await SkipForwardAsync();
                break;
            case "volume-up":
                await SetVolumeOnHostAsync(Playback.Volume + Playback.ClientSettings.VolumeStep);
                break;
            case "volume-down":
                await SetVolumeOnHostAsync(Playback.Volume - Playback.ClientSettings.VolumeStep);
                break;
            case "toggle-mute":
                await ToggleMuteOnHostAsync();
                break;
        }
    }

    private async Task ApplyAudioMetricsAsync(AudioMetrics state, long? expectedRateSelectionVersion)
    {
        if (Playback.IsVideoMode) return;
        Playback.UpdateTransportState(
            currentTimeSeconds: state.CurrentTime,
            durationSeconds: state.Duration,
            isPlaying: state.Paused && Playback.Phase == PlaybackPhase.Loading ? null : !state.Paused,
            volume: state.Volume,
            isMuted: state.Muted,
            playbackRate: state.PlaybackRate,
            expectedPlaybackRateSelectionVersion: expectedRateSelectionVersion);
        await Playback.ReportHeartbeatAsync();
    }

    private Task<bool> BindNativeSleepTimerAsync(AudiobookSleepTimerStateDto state) =>
        BindNativeSleepTimerCoreAsync(state);

    private async Task<bool> PrepareNativeSleepTimerSourceAsync(AudiobookSleepTimerStateDto state, string streamUrl)
    {
        var requestVersion = Playback.PlaybackRequestVersion;
        var assetId = Playback.CurrentItem?.AssetId;
        if (state.Mode == AudiobookSleepTimerModes.Off
            || !Playback.IsCurrentSleepTimerArm(state.TimerGeneration, state.BoundAssetId, state.PlaybackRequestVersion)
            || state.PlaybackRequestVersion != requestVersion
            || state.BoundAssetId != assetId
            || !string.Equals(streamUrl, Playback.CurrentBrowserStreamUrl, StringComparison.Ordinal)
            || string.IsNullOrWhiteSpace(streamUrl))
        {
            return false;
        }

        try
        {
            await JS.InvokeVoidAsync("listenPlayback.ensureAudioSource", _audioRef, streamUrl);
            if (!Playback.IsCurrentSleepTimerArm(state.TimerGeneration, state.BoundAssetId, state.PlaybackRequestVersion)
                || Playback.PlaybackRequestVersion != requestVersion
                || Playback.CurrentItem?.AssetId != assetId
                || !string.Equals(streamUrl, Playback.CurrentBrowserStreamUrl, StringComparison.Ordinal))
            {
                return false;
            }

            _lastAppliedStreamUrl = streamUrl;
            _lastSeekedStreamUrl = null;
            _lastSeekedPositionSeconds = null;
            _lastAppliedPlayingState = null;
            return true;
        }
        catch (JSDisconnectedException)
        {
            return false;
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogDebug(exception, "The audiobook source could not be prepared for its active sleep timer.");
            return false;
        }
    }

    private async Task<bool> PauseNativeSleepTimerAsync(AudiobookSleepTimerStateDto state)
    {
        if (state.Mode == AudiobookSleepTimerModes.Off
            || !Playback.IsCurrentSleepTimerArm(state.TimerGeneration, state.BoundAssetId, state.PlaybackRequestVersion))
        {
            return false;
        }

        try
        {
            var paused = await JS.InvokeAsync<bool>(
                "listenPlayback.pauseAudioForSleepTimer",
                _audioRef,
                state.TimerGeneration,
                state.BoundAssetId,
                state.PlaybackRequestVersion);
            var accepted = paused
                && Playback.IsCurrentSleepTimerArm(state.TimerGeneration, state.BoundAssetId, state.PlaybackRequestVersion);
            return accepted;
        }
        catch (JSDisconnectedException)
        {
            return false;
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogDebug(exception, "The audiobook sleep timer could not pause playback through the native player.");
            return false;
        }
    }

    private async Task<double?> ReadNativeSleepTimerPositionAsync(Guid expectedAssetId, long expectedPlaybackRequestVersion)
    {
        var item = Playback.CurrentItem;
        var profileId = PlaybackPreferences.ActiveProfileId;
        var workId = item?.AudiobookWorkId ?? item?.WorkId;
        var sourceUrl = Playback.CurrentBrowserStreamUrl;
        if (!Playback.IsAudiobookMode
            || item?.AssetId != expectedAssetId
            || Playback.PlaybackRequestVersion != expectedPlaybackRequestVersion
            || string.IsNullOrWhiteSpace(sourceUrl))
        {
            return null;
        }
        if (profileId is not Guid expectedProfileId || expectedProfileId == Guid.Empty
            || workId is not Guid expectedWorkId || expectedWorkId == Guid.Empty)
        {
            return null;
        }

        try
        {
            var currentTime = await JS.InvokeAsync<double?>(
                "listenPlayback.readAudioPositionForSleepTimer",
                _audioRef,
                expectedAssetId,
                expectedPlaybackRequestVersion,
                sourceUrl);
            var current = Playback.CurrentItem;
            if (PlaybackPreferences.ActiveProfileId != expectedProfileId
                || !Playback.IsAudiobookMode
                || current is null
                || current.AssetId != expectedAssetId
                || (current.AudiobookWorkId ?? current.WorkId) != expectedWorkId
                || Playback.PlaybackRequestVersion != expectedPlaybackRequestVersion
                || !string.Equals(Playback.CurrentBrowserStreamUrl, sourceUrl, StringComparison.Ordinal)
                || currentTime is not { } position
                || !double.IsFinite(position)
                || position < 0)
            {
                return null;
            }

            return currentTime;
        }
        catch (JSDisconnectedException)
        {
            return null;
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogDebug(exception, "The current audiobook position could not be read for its sleep timer.");
            return null;
        }
    }

    private async Task PrepareAudioSourceAsync()
    {
        var browserStreamUrl = Playback.CurrentBrowserStreamUrl;
        if (string.IsNullOrWhiteSpace(browserStreamUrl)
            || string.Equals(_lastAppliedStreamUrl, browserStreamUrl, StringComparison.Ordinal))
        {
            return;
        }

        _lastAppliedStreamUrl = browserStreamUrl;
        _lastSeekedStreamUrl = null;
        _lastSeekedPositionSeconds = null;
        _lastAppliedPlayingState = null;
        await JS.InvokeVoidAsync("listenPlayback.ensureAudioSource", _audioRef, browserStreamUrl);
    }

    private bool IsSleepTimerBindingCurrent(AudiobookSleepTimerStateDto state, string? sourceUrl) =>
        _nativeSleepTimerBinding is { } binding
        && binding.State == state
        && (state.Mode == AudiobookSleepTimerModes.Off
            || (binding.AssetId == state.BoundAssetId
                && binding.RequestVersion == state.PlaybackRequestVersion
                && string.Equals(binding.SourceUrl, sourceUrl, StringComparison.Ordinal)
                && Playback.CurrentItem?.AssetId == state.BoundAssetId
                && Playback.PlaybackRequestVersion == state.PlaybackRequestVersion));

    private async Task SyncNativeSleepTimerAsync()
    {
        if (_selfReference is null || Playback.SleepTimerRegistrationInProgress) return;
        var state = Playback.SleepTimerState;
        if (IsSleepTimerBindingCurrent(state, Playback.CurrentBrowserStreamUrl)) return;
        await BindNativeSleepTimerCoreAsync(state);
    }

    private Task<bool> BindNativeSleepTimerCoreAsync(AudiobookSleepTimerStateDto state)
    {
        var requestVersion = Playback.PlaybackRequestVersion;
        var assetId = Playback.CurrentItem?.AssetId;
        var sourceUrl = Playback.CurrentBrowserStreamUrl;
        var request = new NativeSleepTimerBindingRequest(state, assetId ?? Guid.Empty, requestVersion, sourceUrl);

        // Reject stale or invalid passive callbacks before advancing the bind
        // version; an invalid request must not cancel a valid source transition.
        if (!IsNativeSleepTimerBindingRequestCurrent(request))
        {
            return Task.FromResult(false);
        }

        lock (_nativeSleepTimerBindingGate)
        {
            if (!IsNativeSleepTimerBindingRequestCurrent(request))
            {
                return Task.FromResult(false);
            }

            if (_pendingNativeSleepTimerBinding is { } pending && pending.Request == request)
            {
                return pending.Completion.Task;
            }

            var version = Interlocked.Increment(ref _nativeSleepTimerBindVersion);
            var completion = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
            var next = new PendingNativeSleepTimerBinding(request, version, completion);
            var previous = _pendingNativeSleepTimerBinding;
            _pendingNativeSleepTimerBinding = next;
            previous?.Completion.TrySetResult(false);
            _ = CompleteNativeSleepTimerBindingAsync(next);
            return completion.Task;
        }
    }

    private async Task CompleteNativeSleepTimerBindingAsync(PendingNativeSleepTimerBinding pending)
    {
        var request = pending.Request;
        var state = request.State;
        var accepted = false;
        try
        {
            var registered = await JS.InvokeAsync<bool>(
                "listenPlayback.setAudiobookSleepTimer",
                _audioRef,
                state,
                request.SourceUrl);
            accepted = registered
                && pending.Version == Volatile.Read(ref _nativeSleepTimerBindVersion)
                && IsNativeSleepTimerBindingRequestCurrent(request);
            if (accepted)
            {
                _nativeSleepTimerBinding = request;
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogDebug(exception, "The audiobook sleep timer could not be bound before the audio element became interactive.");
        }
        catch (JSException exception)
        {
            Logger.LogDebug(exception, "The audiobook sleep timer registration was rejected by the native player.");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The audiobook sleep timer registration failed unexpectedly.");
        }
        finally
        {
            pending.Completion.TrySetResult(accepted);
            lock (_nativeSleepTimerBindingGate)
            {
                if (ReferenceEquals(_pendingNativeSleepTimerBinding, pending))
                {
                    _pendingNativeSleepTimerBinding = null;
                }
            }
        }
    }

    private bool IsNativeSleepTimerBindingRequestCurrent(NativeSleepTimerBindingRequest request)
    {
        var state = request.State;
        if (!Playback.CanBindNativeSleepTimerState(state)) return false;
        if (state.Mode == AudiobookSleepTimerModes.Off)
        {
            var currentOff = Playback.SleepTimerState;
            if (currentOff.Mode == AudiobookSleepTimerModes.Off
                && currentOff.TimerGeneration == state.TimerGeneration)
            {
                // An authority invalidation clears the former source binding
                // with the committed Off generation, even after the live source
                // has moved on.
                return true;
            }

            // A user-selected Off is a staged candidate; keep it scoped to the
            // exact live source that authorized the selection.
            return Playback.PlaybackRequestVersion == request.RequestVersion
                && (Playback.CurrentItem?.AssetId ?? Guid.Empty) == request.AssetId
                && string.Equals(Playback.CurrentBrowserStreamUrl, request.SourceUrl, StringComparison.Ordinal);
        }

        var item = Playback.CurrentItem;
        var profileId = PlaybackPreferences.ActiveProfileId;
        var workId = item?.AudiobookWorkId ?? item?.WorkId;
        var liveScopeMatches = Playback.IsAudiobookMode
            && item?.AssetId == request.AssetId
            && Playback.PlaybackRequestVersion == request.RequestVersion
            && state.BoundAssetId == request.AssetId
            && state.PlaybackRequestVersion == request.RequestVersion
            && state.ProfileId != Guid.Empty
            && profileId == state.ProfileId
            && workId == state.WorkId
            && !string.IsNullOrWhiteSpace(request.SourceUrl)
            && string.Equals(Playback.CurrentBrowserStreamUrl, request.SourceUrl, StringComparison.Ordinal);
        if (!liveScopeMatches) return false;

        return true;
    }

