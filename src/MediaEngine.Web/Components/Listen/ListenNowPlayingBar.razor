    protected override void OnInitialized()
    {
        Playback.SetTransportHostNotReady();
        Playback.Changed += HandlePlaybackChanged;
        Playback.TransportCommandRequested += HandleTransportCommandAsync;
        Nav.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) =>
        _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("listenPlayback.configure", Playback.ClientSettings);
            await ConfigurePlaybackClientContextAsync();
            await JS.InvokeVoidAsync("listenPlayback.registerCommandHandler", _selfReference);
            await JS.InvokeVoidAsync(
                "listenPlayback.registerAudioStateObserver",
                _audioRef,
                _selfReference,
                Playback.ClientSettings.AudioObserverIntervalMilliseconds);

            try
            {
                var json = await JS.InvokeAsync<string?>("listenPlayback.getState");
                if (!string.IsNullOrWhiteSpace(json))
                {
                    var snapshot = JsonSerializer.Deserialize<ListenPlaybackSnapshot>(json, _jsonOptions);
                    if (snapshot is not null)
                    {
                        Playback.RestoreInitialState(snapshot);
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Could not restore listen playback state from browser storage.");
            }

            _restored = true;
            await Playback.SetTransportHostReadyAsync();
        }

        if (Playback.HasQueue && !Playback.IsVideoMode && !_shortcutsRegistered && _selfReference is not null)
        {
            await JS.InvokeVoidAsync("listenPlayback.registerPlayerShortcuts", _playerShellRef, _selfReference);
            _shortcutsRegistered = true;
        }

        if (!Playback.IsVideoMode
            && Playback.CurrentItem is not null
            && !string.IsNullOrWhiteSpace(Playback.CurrentBrowserStreamUrl))
        {
            await SyncAudioAsync();
        }

        if (_scrollActiveChapterPending)
        {
            _scrollActiveChapterPending = false;
            await JS.InvokeVoidAsync("playbackTools.scrollActiveChapter");
        }

        var nowPlayingOpen = Playback.PresentationSurface == PlaybackPresentationSurface.NowPlaying;
        if (nowPlayingOpen && !_nowPlayingFocused)
        {
            await JS.InvokeVoidAsync("playbackTools.capturePlayerFocus", _nowPlayingRef);
            _nowPlayingFocused = true;
        }
        else if (!nowPlayingOpen && _nowPlayingFocused)
        {
            await JS.InvokeVoidAsync("playbackTools.restorePlayerFocus");
            _nowPlayingFocused = false;
        }
    }

    private async Task ConfigurePlaybackClientContextAsync()
    {
        Playback.SetClientContext(PlaybackClientContext.WebDefault);
        await Task.CompletedTask;
    }

    private void HandlePlaybackChanged(PlaybackChangeKind changeKind)
    {
        _ = InvokeAsync(async () =>
        {
            if (Playback.IsVideoMode && _lastAppliedStreamUrl is not null)
            {
                await JS.InvokeVoidAsync("listenPlayback.pauseAudio", _audioRef);
                _lastAppliedPlayingState = false;
            }

            if (_restored)
            {
                try
                {
                    if (Playback.HasQueue)
                    {
                        await JS.InvokeVoidAsync("listenPlayback.setState", JsonSerializer.Serialize(Playback.CreateSnapshot(), _jsonOptions));
                    }
                    else
                    {
                        await JS.InvokeVoidAsync("listenPlayback.clearState");
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogDebug(ex, "Could not persist listen playback state to browser storage.");
                }
            }

            StateHasChanged();
            if (Playback.PresentationSurface == PlaybackPresentationSurface.NowPlaying &&
                Playback.IsMusicMode && Playback.CurrentItem?.WorkId != _favoriteSongId &&
                changeKind is PlaybackChangeKind.State or PlaybackChangeKind.Queue)
            {
                await LoadFavoriteAsync();
            }
            _ = EnsureLyricsLoadedAsync();
        });
    }

    private async Task EnsureLyricsLoadedAsync()
    {
        var assetId = Playback.CurrentItem?.AssetId;
        if (!assetId.HasValue || _lyricsAssetId == assetId)
            return;

        _lyricsAssetId = assetId;
        _lyricsLines = [];
        _lyricTracks = [];
        _selectedLyricTrackId = null;
        _lyricsStatus = null;
        _lyricsLoading = true;
        await InvokeAsync(StateHasChanged);

        var tracks = await ApiClient.GetTextTracksAsync(assetId.Value);
        var lyrics = await ApiClient.GetLyricsAsync(assetId.Value);
        if (Playback.CurrentItem?.AssetId != assetId) return;
        _lyricTracks = tracks.Where(track => track.Kind.Equals("Lyrics", StringComparison.OrdinalIgnoreCase)).ToList();
        _selectedLyricTrackId = _lyricTracks.FirstOrDefault(track => track.IsPreferred)?.Id ?? _lyricTracks.FirstOrDefault()?.Id;
        _lyricsLines = ParseLyrics(lyrics).ToList();
        _lyricsLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectLyricVersionAsync(ChangeEventArgs args)
    {
        if (Playback.CurrentItem?.AssetId is not Guid assetId || !Guid.TryParse(args.Value?.ToString(), out var trackId)) return;
        var content = await ApiClient.GetTextTrackContentAsync(assetId, trackId);
        if (Playback.CurrentItem?.AssetId != assetId) return;
        if (content is null)
        {
            _lyricsStatus = "That lyrics version is unavailable.";
            return;
        }
        _selectedLyricTrackId = trackId;
        _lyricsLines = ParseLyrics(content).ToList();
        _lyricsStatus = null;
    }

    private async Task SetPreferredLyricsAsync()
    {
        if (Playback.CurrentItem?.AssetId is not Guid assetId || _selectedLyricTrackId is not Guid trackId) return;
        if (await ApiClient.SetPreferredTextTrackAsync(assetId, trackId))
        {
            _lyricTracks = (await ApiClient.GetTextTracksAsync(assetId))
                .Where(track => track.Kind.Equals("Lyrics", StringComparison.OrdinalIgnoreCase)).ToList();
            _lyricsStatus = "Preferred lyrics saved.";
        }
        else _lyricsStatus = "Could not save preferred lyrics.";
    }

    private async Task RefreshLyricsAsync()
    {
        if (_lyricsRefreshing || Playback.CurrentItem?.AssetId is not Guid assetId) return;
        _lyricsRefreshing = true;
        _lyricsStatus = null;
        try
        {
            var result = await ApiClient.RefreshTextTracksAsync(assetId, "lyrics");
            if (Playback.CurrentItem?.AssetId != assetId) return;
            var outcome = result?.message ?? "Lyrics search could not start.";
            _lyricsAssetId = null;
            await EnsureLyricsLoadedAsync();
            _lyricsStatus = outcome;
        }
        finally { _lyricsRefreshing = false; }
    }

    private async Task HandleStartFailureAsync()
    {
        var failure = await JS.InvokeAsync<string>("listenPlayback.startFailure", _audioRef);
        if (failure == "AbortError") return; // A superseding source/start owns the result.
        if (failure == "NotAllowedError") Playback.MarkNeedsUserGestureToStart();
        else Playback.MarkCurrentFailed("The media source could not start playback. Retry playback or check the source.");
    }

    private async Task SyncAudioAsync()
    {
        var browserStreamUrl = Playback.CurrentBrowserStreamUrl;
        var targetPositionSeconds = Playback.CurrentTimeSeconds;
        var targetPlaybackRate = Playback.PlaybackRate;
        var startVersionChanged = _lastAppliedStartVersion != Playback.PlaybackStartVersion;
        if (startVersionChanged)
        {
            _lastAppliedStartVersion = Playback.PlaybackStartVersion;
            _lastSeekedStreamUrl = null;
            _lastSeekedPositionSeconds = null;
            _lastAppliedPlayingState = null;
        }

        if (!string.Equals(_lastAppliedStreamUrl, browserStreamUrl, StringComparison.Ordinal))
        {
            _lastAppliedStreamUrl = browserStreamUrl;
            _lastSeekedStreamUrl = null;
            _lastSeekedPositionSeconds = null;
            _lastAppliedPlayingState = null;
            await JS.InvokeVoidAsync("listenPlayback.ensureAudioSource", _audioRef, browserStreamUrl);
        }

        if (_lastAppliedVolume != Playback.Volume)
        {
            await JS.InvokeVoidAsync("listenPlayback.setVolume", _audioRef, Playback.Volume);
            _lastAppliedVolume = Playback.Volume;
        }

        if (_lastAppliedMuteState != Playback.IsMuted)
        {
            await JS.InvokeVoidAsync("listenPlayback.setMuted", _audioRef, Playback.IsMuted);
            _lastAppliedMuteState = Playback.IsMuted;
        }

        if (!_lastAppliedPlaybackRate.HasValue || Math.Abs(_lastAppliedPlaybackRate.Value - targetPlaybackRate) >= 0.01d)
        {
            await JS.InvokeVoidAsync("listenPlayback.setPlaybackRate", _audioRef, targetPlaybackRate);
            _lastAppliedPlaybackRate = targetPlaybackRate;
        }

        var shouldSeek = targetPositionSeconds > 0
            && (!string.Equals(_lastSeekedStreamUrl, browserStreamUrl, StringComparison.Ordinal)
                || startVersionChanged);
        if (shouldSeek)
        {
            await JS.InvokeVoidAsync("listenPlayback.seekAudio", _audioRef, targetPositionSeconds);
            _lastSeekedStreamUrl = browserStreamUrl;
            _lastSeekedPositionSeconds = targetPositionSeconds;
        }

        if (_lastAppliedPlayingState != Playback.IsPlaying)
        {
            if (Playback.IsPlaying)
            {
                var started = await JS.InvokeAsync<bool>("listenPlayback.playAudio", _audioRef);
                if (!started)
                {
                    await HandleStartFailureAsync();
                }
            }
            else
            {
                await JS.InvokeVoidAsync("listenPlayback.pauseAudio", _audioRef);
            }

            _lastAppliedPlayingState = Playback.IsPlaying;
        }
    }

    private async Task HandleAudioMetricsChangedAsync()
    {
        var state = await JS.InvokeAsync<AudioMetrics>("listenPlayback.readAudioState", _audioRef);
        await ApplyAudioMetricsAsync(state);
    }

    [JSInvokable]
    public Task HandleObservedAudioState(AudioMetrics state) => ApplyAudioMetricsAsync(state);

    [JSInvokable]
    public async Task HandlePlayerShortcut(string action)
    {
        switch (action)
        {
            case "toggle-play":
                await TogglePlayPauseAsync();
                break;
            case "skip-back":
                await SkipBackAsync();
                break;
            case "skip-forward":
                await SkipForwardAsync();
                break;
            case "volume-up":
                await SetVolumeOnHostAsync(Playback.Volume + Playback.ClientSettings.VolumeStep);
                break;
            case "volume-down":
                await SetVolumeOnHostAsync(Playback.Volume - Playback.ClientSettings.VolumeStep);
                break;
            case "toggle-mute":
                await ToggleMuteAsync();
                break;
        }
    }

    private async Task ApplyAudioMetricsAsync(AudioMetrics state)
    {
        if (Playback.IsVideoMode) return;
        Playback.UpdateTransportState(
            currentTimeSeconds: state.CurrentTime,
            durationSeconds: state.Duration,
            isPlaying: state.Paused && Playback.Phase == PlaybackPhase.Loading ? null : !state.Paused,
            volume: state.Volume,
            isMuted: state.Muted,
            playbackRate: state.PlaybackRate);
        await Playback.ReportHeartbeatAsync();
    }

    private async Task HandleAudioStarted()
    {
        if (Playback.IsVideoMode) return;
        Playback.MarkPlaybackStarted();
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task HandleAudioPaused()
    {
        if (Playback.IsVideoMode || Playback.Phase == PlaybackPhase.Loading) return;
        Playback.UpdateTransportState(isPlaying: false);
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task HandleAudioEndedAsync()
    {
        if (Playback.IsVideoMode) return;
        await Playback.CompleteCurrentAsync();
    }

    private Task HandleAudioErrorAsync()
    {
        if (Playback.IsVideoMode) return Task.CompletedTask;
        Playback.MarkCurrentFailed("This audio source failed to load or play.");
        return Task.CompletedTask;
    }

    private async Task TogglePlayPauseAsync()
    {
        if (await ConsumeImmediateToggleAsync())
        {
            return;
        }

        if (Playback.IsPlaying && !Playback.NeedsUserGestureToStart)
        {
            await PauseAudioAsync();
            return;
        }

        if (!string.IsNullOrWhiteSpace(Playback.CurrentBrowserStreamUrl))
        {
            await StartAudioAsync(new PlaybackTransportCommand(
                "start",
                Value: Playback.CurrentTimeSeconds,
                StreamUrl: Playback.CurrentBrowserStreamUrl,
                PositionSeconds: Playback.CurrentTimeSeconds,
                PlaybackRate: Playback.PlaybackRate,
                RequestId: Playback.PlaybackStartVersion));
            return;
        }

        var started = await JS.InvokeAsync<bool>("listenPlayback.playAudio", _audioRef);
        if (started)
        {
            Playback.MarkPlaybackStarted();
        }
        else
        {
            await HandleStartFailureAsync();
        }
    }

    private async Task StartAudioAsync(PlaybackTransportCommand command)
    {
        var requestVersion = Playback.PlaybackRequestVersion;
        var streamUrl = StringHelpers.FirstNonBlankOr("Library audio", command.StreamUrl, Playback.CurrentBrowserStreamUrl);
        var positionSeconds = Math.Max(0, command.PositionSeconds ?? command.Value ?? Playback.CurrentTimeSeconds);
        var playbackRate = command.PlaybackRate ?? Playback.PlaybackRate;
        var started = await JS.InvokeAsync<bool>(
            "listenPlayback.startAudio",
            _audioRef,
            new
            {
                streamUrl,
                positionSeconds,
                playbackRate,
                volume = Playback.Volume,
                muted = Playback.IsMuted,
            });

        if (!string.IsNullOrWhiteSpace(streamUrl))
        {
            _lastAppliedStreamUrl = streamUrl;
            _lastSeekedStreamUrl = streamUrl;
        }

        _lastSeekedPositionSeconds = positionSeconds;
        _lastAppliedPlaybackRate = playbackRate;
        _lastAppliedVolume = Playback.Volume;
        _lastAppliedMuteState = Playback.IsMuted;
        _lastAppliedPlayingState = started;

        if (requestVersion != Playback.PlaybackRequestVersion) return;
        if (started)
        {
            Playback.UpdateTransportState(
                currentTimeSeconds: positionSeconds,
                isPlaying: true,
                playbackRate: playbackRate,
                needsUserGestureToStart: false);
            Playback.MarkPlaybackStarted();
            await Playback.ReportHeartbeatAsync(force: true);
        }
        else
        {
            await HandleStartFailureAsync();
        }
    }

    private async Task PauseAudioAsync()
    {
        await JS.InvokeVoidAsync("listenPlayback.pauseAudio", _audioRef);
        Playback.UpdateTransportState(isPlaying: false);
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task ApplyPlaybackRateAsync(double rate)
    {
        var next = Math.Clamp(rate, 0.5d, 3d);
        await JS.InvokeVoidAsync("listenPlayback.setPlaybackRate", _audioRef, next);
        Playback.UpdateTransportState(playbackRate: next);
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private Task PlayFromQueueAsync(int index) => Playback.PlayIndexAsync(index);

    private Task PlayHistoryItemAsync(ListenQueueItem item)
        => Playback.PlayQueueItemAsync(item, item.Album ?? item.Title);

    private async Task PlayNextAsync()
    {
        if (Playback.IsAudiobookMode)
        {
            await SkipForwardAsync();
            return;
        }

        await Playback.SkipNextAsync();
    }

    private async Task PlayPreviousAsync()
    {
        if (Playback.IsAudiobookMode)
        {
            await SkipBackAsync();
            return;
        }

        await Playback.SkipPreviousAsync();
    }

    private Task PlayNextChapterAsync() => Playback.DispatchAsync(new PlaybackCommand(PlaybackCommandKind.PlayNextChapter));

    private Task PlayPreviousChapterAsync() => Playback.DispatchAsync(new PlaybackCommand(PlaybackCommandKind.PlayPreviousChapter));

    private Task SkipBackAsync() => SkipRelativeAsync(-Playback.SkipBackSeconds);

    private Task SkipForwardAsync() => SkipRelativeAsync(Playback.SkipForwardSeconds);

    private async Task SkipRelativeAsync(double deltaSeconds)
    {
        if (await ConsumeImmediateSeekAsync())
        {
            return;
        }

        await SeekRelativeOnHostAsync(deltaSeconds);
    }

    private async Task<bool> ConsumeImmediateToggleAsync()
    {
        try
        {
            if (!await JS.InvokeAsync<bool>("listenPlayback.consumeImmediateToggleHandled"))
            {
                return false;
            }

            await HandleAudioMetricsChangedAsync();
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not consume immediate audio toggle.");
            return false;
        }
    }

    private async Task<bool> ConsumeImmediateSeekAsync()
    {
        try
        {
            if (!await JS.InvokeAsync<bool>("listenPlayback.consumeImmediateSeekHandled"))
            {
                return false;
            }

            await HandleAudioMetricsChangedAsync();
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not consume immediate audio seek.");
            return false;
        }
    }

    private Task SeekRelativeOnHostAsync(double deltaSeconds)
    {
        var max = Playback.DurationSeconds > 0 ? Playback.DurationSeconds : double.MaxValue;
        var next = Math.Clamp(Playback.CurrentTimeSeconds + deltaSeconds, 0, max);
        return SeekOnHostAsync(next);
    }

    private void RemoveUpcoming(int absoluteIndex) => Playback.RemoveUpcomingAt(absoluteIndex);

    private void ClearUpcoming() => Playback.ClearUpcoming();

    private async Task SeekAsync(ChangeEventArgs args)
    {
        if (!double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var seconds))
        {
            return;
        }

        await SeekOnHostAsync(seconds);
    }

    private async Task SeekNowPlayingAsync(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var seconds))
        {
            await SeekOnHostAsync(NowPlayingTimelineStart + seconds);
        }
    }

    private async Task SeekOnHostAsync(double seconds)
    {
        var next = Math.Max(0, seconds);
        await JS.InvokeVoidAsync("listenPlayback.seekAudio", _audioRef, next);
        _lastSeekedStreamUrl = Playback.CurrentBrowserStreamUrl;
        _lastSeekedPositionSeconds = next;
        Playback.UpdateTransportState(currentTimeSeconds: next);
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task SetVolumeAsync(ChangeEventArgs args)
    {
        if (!double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var volume))
        {
            return;
        }

        await SetVolumeOnHostAsync(volume);
    }

    private async Task SetVolumeOnHostAsync(double volume)
    {
        volume = Math.Clamp(volume, 0d, 1d);
        await JS.InvokeVoidAsync("listenPlayback.setVolume", _audioRef, volume);
        Playback.UpdateTransportState(volume: volume, isMuted: volume <= 0 ? true : false);
        _lastAppliedVolume = volume;
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task ToggleMuteAsync()
    {
        Playback.UpdateTransportState(isMuted: !Playback.IsMuted);
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private Task ToggleMusicPanelAsync()
    {
        if (Playback.ActiveTab == ListenPlaybackTabs.Lyrics)
        {
            Playback.SetActiveTab(ListenPlaybackTabs.Queue);
            if (Playback.IsPanelOpen)
            {
                return Task.CompletedTask;
            }
        }

        Playback.TogglePanel();
        return Task.CompletedTask;
    }

    private Task ToggleLyricsPanelAsync()
    {
        if (Playback.IsPanelOpen && Playback.ActiveTab == ListenPlaybackTabs.Lyrics)
        {
            Playback.ClosePanel();
            return Task.CompletedTask;
        }

        Playback.SetActiveTab(ListenPlaybackTabs.Lyrics);
        if (!Playback.IsPanelOpen)
        {
            Playback.TogglePanel();
        }
        return Task.CompletedTask;
    }

    private async Task HandleMusicPanelControl(PlaybackControlDefinition control)
    {
        if (control.IsDisabled)
        {
            return;
        }

        switch (control.Key)
        {
            case PlaybackControlKey.Queue:
                ToggleMusicToolPanel(ListenPlaybackTabs.Queue);
                break;
            case PlaybackControlKey.History:
                ToggleMusicToolPanel(ListenPlaybackTabs.History);
                break;
            case PlaybackControlKey.Lyrics:
                await ToggleLyricsPanelAsync();
                break;
            case PlaybackControlKey.Shuffle:
                await Playback.ToggleShuffleAsync();
                break;
            case PlaybackControlKey.Repeat:
                await Playback.CycleRepeatModeAsync();
                break;
        }
    }

    private void ToggleMusicToolPanel(string tab)
    {
        if (Playback.IsPanelOpen && Playback.ActiveTab == tab)
        {
            Playback.ClosePanel();
            return;
        }

        Playback.SetActiveTab(tab);
        if (!Playback.IsPanelOpen)
        {
            Playback.TogglePanel();
        }
    }

    private Task CloseBottomPanelAsync()
    {
        Playback.ClosePanel();
        return Task.CompletedTask;
    }

    private void HandlePlayerKeyDown(KeyboardEventArgs args)
    {
        if (Playback.IsPanelOpen && string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            Playback.ClosePanel();
        }
    }

    private async Task OpenNowPlaying()
    {
        Playback.SetPresentationSurface(PlaybackPresentationSurface.NowPlaying);
        await LoadFavoriteAsync();
    }

    private async Task LoadFavoriteAsync()
    {
        if (!Playback.IsMusicMode || Playback.CurrentItem?.WorkId is not { } workId || workId == Guid.Empty) return;
        var profile = await Orchestrator.GetActiveProfileAsync();
        _favoriteSongId = workId;
        _isFavorite = await Reactions.GetReactionAsync(workId, profile?.Id, ProfileEntityKind.Song) is MediaReaction.Like or MediaReaction.Love;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleFavoriteAsync()
    {
        if (!Playback.IsMusicMode || Playback.CurrentItem?.WorkId is not { } workId || workId == Guid.Empty) return;
        var profile = await Orchestrator.GetActiveProfileAsync();
        if (profile is null)
        {
            Snackbar.Add("Favorites require an active profile.", Severity.Warning);
            return;
        }
        if (_favoriteSongId != workId) await LoadFavoriteAsync();
        await Reactions.SetReactionAsync(workId, _isFavorite ? MediaReaction.Neutral : MediaReaction.Like, profile.Id, ProfileEntityKind.Song);
        _isFavorite = await Reactions.GetReactionAsync(workId, profile.Id, ProfileEntityKind.Song) is MediaReaction.Like or MediaReaction.Love;
    }

    private void CloseNowPlaying()
    {
        Playback.ClosePanel();
        Playback.SetPresentationSurface(PlaybackPresentationSurface.Docked);
    }

    private void HandleNowPlayingKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            if (Playback.IsPanelOpen) Playback.ClosePanel();
            else Playback.SetPresentationSurface(PlaybackPresentationSurface.Docked);
        }
    }

    private async Task HandleNowPlayingToolControl(PlaybackControlDefinition control)
    {
        if (Playback.IsAudiobookMode) HandleAudiobookPanelControl(control);
        else await HandleMusicPanelControl(control);
    }

    private void HandleAudiobookPanelControl(PlaybackControlDefinition control)
    {
        if (control.IsDisabled || string.IsNullOrWhiteSpace(control.Sheet))
        {
            return;
        }

        if (Playback.IsPanelOpen && string.Equals(_activeAudiobookPanelTool, control.Sheet, StringComparison.Ordinal))
        {
            Playback.ClosePanel();
            return;
        }

        _activeAudiobookPanelTool = control.Sheet;
        _scrollActiveChapterPending = string.Equals(control.Sheet, "chapters", StringComparison.Ordinal);
        if (!Playback.IsPanelOpen)
        {
            Playback.TogglePanel();
        }
    }

