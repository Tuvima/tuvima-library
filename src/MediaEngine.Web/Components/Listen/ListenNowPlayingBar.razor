    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_openCompactToolPending && _compactContext is not null)
        {
            _openCompactToolPending = false;
            await _compactContext.OpenAsync(true);
        }
        if (firstRender)
        {
            _selfReference = DotNetObjectReference.Create(this);
            _audioPresentationModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-audio-presentation.js");
            if (_audioPresentationModule is not null) await _audioPresentationModule.InvokeVoidAsync("attach", _audioPresentationObserverId, _selfReference);
            await JS.InvokeVoidAsync("listenPlayback.configure", Playback.ClientSettings);
            await ConfigurePlaybackClientContextAsync();
            await JS.InvokeVoidAsync("listenPlayback.registerCommandHandler", _selfReference);
            await JS.InvokeVoidAsync(
                "listenPlayback.registerAudioStateObserver",
                _audioRef,
                _selfReference,
                Playback.ClientSettings.AudioObserverIntervalMilliseconds);

            _restored = await RestorePlaybackStateStreamAsync();
            await Playback.SetTransportHostReadyAsync();
        }

        if (Playback.HasQueue && !Playback.IsVideoMode && !_shortcutsRegistered && _selfReference is not null)
        {
            await JS.InvokeVoidAsync("listenPlayback.registerPlayerShortcuts", _playerShellRef, _selfReference);
            _shortcutsRegistered = true;
        }

        if (!_closeInProgress && !Playback.IsVideoMode
            && Playback.CurrentItem is not null
            && !string.IsNullOrWhiteSpace(Playback.CurrentBrowserStreamUrl))
        {
            await PrepareAudioSourceAsync();
            await SyncNativeSleepTimerAsync();
            await SyncAudioAsync();
        }

        if (_scrollActiveChapterPending)
        {
            _scrollActiveChapterPending = false;
            await JS.InvokeVoidAsync("playbackTools.scrollActiveChapter");
        }

        var nowPlayingOpen = Playback.PresentationSurface == PlaybackPresentationSurface.NowPlaying && IsPhonePresentation;
        if (nowPlayingOpen && !_nowPlayingFocused)
        {
            await JS.InvokeVoidAsync("playbackTools.capturePlayerFocus", _phoneFullPlayer?.Element ?? default);
            _nowPlayingFocused = true;
        }
        else if (!nowPlayingOpen && _nowPlayingFocused)
        {
            await JS.InvokeVoidAsync("playbackTools.restorePlayerFocus");
            _nowPlayingFocused = false;
        }
    }

    private async Task ConfigurePlaybackClientContextAsync()
    {
        Playback.SetClientContext(PlaybackClientContext.WebDefault);
        await Task.CompletedTask;
    }

    private void HandlePlaybackChanged(PlaybackChangeKind changeKind)
    {
        var notificationVersion = Interlocked.Increment(ref _playbackChangeNotificationVersion);
        _ = InvokeAsync(async () =>
        {
            ObserveLyricsPresentation();
            var playbackRequestVersion = Playback.PlaybackRequestVersion;
            if ((_rateMenuOpen || _sleepMenuOpen) && _transientPlaybackRequestVersion != playbackRequestVersion)
            {
                CloseRateMenu();
                CloseSleepMenu();
            }
            StateHasChanged();

            var snapshotJson = Playback.HasQueue
                ? JsonSerializer.Serialize(Playback.CreateSnapshot(), _jsonOptions)
                : null;
            var shouldPauseAudio = Playback.IsVideoMode && _lastAppliedStreamUrl is not null;
            var shouldLoadFavorite = Playback.IsMusicMode && (Playback.CurrentItem?.WorkId != _favoriteSongId || Playback.ActiveProfileId != _favoriteProfileId) &&
                                     changeKind is PlaybackChangeKind.State or PlaybackChangeKind.Queue;

            if (shouldPauseAudio)
            {
                await JS.InvokeVoidAsync("listenPlayback.pauseAudio", _audioRef);
                _lastAppliedPlayingState = false;
            }

            if (_restored && notificationVersion == Volatile.Read(ref _playbackChangeNotificationVersion) &&
                playbackRequestVersion == Playback.PlaybackRequestVersion)
            {
                try
                {
                    if (snapshotJson is not null)
                    {
                        await JS.InvokeVoidAsync("listenPlayback.setState", snapshotJson);
                    }
                    else
                    {
                        await JS.InvokeVoidAsync("listenPlayback.clearState");
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogDebug(ex, "Could not persist listen playback state to browser storage.");
                }
            }

            if (notificationVersion == Volatile.Read(ref _playbackChangeNotificationVersion) &&
                playbackRequestVersion == Playback.PlaybackRequestVersion && shouldLoadFavorite)
            {
                await LoadFavoriteAsync();
            }
        });
    }

    private async Task<bool> RestorePlaybackStateStreamAsync()
    {
        var restoreGeneration = Volatile.Read(ref _playbackChangeNotificationVersion);
        try
        {
            var hasStoredState = await JS.InvokeAsync<bool>("listenPlayback.hasState");
            if (_disposed || restoreGeneration != Volatile.Read(ref _playbackChangeNotificationVersion))
            {
                return _restored;
            }

            if (!hasStoredState)
            {
                _playbackRestoreError = null;
                return true;
            }

            var snapshotStream = await JS.InvokeAsync<IJSStreamReference>("listenPlayback.getStateStream");
            if (_disposed || restoreGeneration != Volatile.Read(ref _playbackChangeNotificationVersion))
            {
                await DisposeUnusedPlaybackStreamAsync(snapshotStream);
                return _restored;
            }

            var snapshot = await PlaybackSnapshotStream.ReadAsync(snapshotStream, _jsonOptions);
            if (_disposed || restoreGeneration != Volatile.Read(ref _playbackChangeNotificationVersion)) return _restored;
            if (snapshot is not null) Playback.RestoreInitialState(snapshot);

            _playbackRestoreError = null;
            return true;
        }
        catch (Exception exception)
        {
            if (_disposed || restoreGeneration != Volatile.Read(ref _playbackChangeNotificationVersion)) return _restored;
            Logger.LogDebug(exception, "Could not restore listen playback state from the browser stream.");
            _playbackRestoreError = "Playback state could not be loaded. Your current player state is still shown.";
            return false;
        }
    }

    private static async Task DisposeUnusedPlaybackStreamAsync(IJSStreamReference reference)
    {
        try { await reference.DisposeAsync(); }
        catch (Exception) { }
    }

    private async Task RetryPlaybackStateRestoreAsync()
    {
        _restored = await RestorePlaybackStateStreamAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleStartFailureAsync()
    {
        var failure = await JS.InvokeAsync<string>("listenPlayback.startFailure", _audioRef);
        if (failure == "AbortError") return; // A superseding source/start owns the result.
        if (failure == "NotAllowedError") Playback.MarkNeedsUserGestureToStart();
        else Playback.MarkCurrentFailed("The media source could not start playback. Retry playback or check the source.");
    }

    private async Task SyncAudioAsync()
    {
        var browserStreamUrl = Playback.CurrentBrowserStreamUrl;
        var targetPositionSeconds = Playback.CurrentTimeSeconds;
        var targetPlaybackRate = Playback.PlaybackRate;
        var hasAppliedStartVersion = _lastAppliedStartVersion >= 0;
        var startVersionChanged = hasAppliedStartVersion
            && _lastAppliedStartVersion != Playback.PlaybackStartVersion;
        if (!hasAppliedStartVersion || startVersionChanged)
        {
            _lastAppliedStartVersion = Playback.PlaybackStartVersion;
            _lastSeekedStreamUrl = null;
            _lastSeekedPositionSeconds = null;
            _lastAppliedPlayingState = null;
        }

        await PrepareAudioSourceAsync();

        if (_lastAppliedVolume != Playback.Volume)
        {
            await JS.InvokeVoidAsync("listenPlayback.setVolume", _audioRef, Playback.Volume);
            _lastAppliedVolume = Playback.Volume;
        }

        if (_lastAppliedMuteState != Playback.IsMuted)
        {
            await JS.InvokeVoidAsync("listenPlayback.setMuted", _audioRef, Playback.IsMuted);
            _lastAppliedMuteState = Playback.IsMuted;
        }

        if (!_lastAppliedPlaybackRate.HasValue || Math.Abs(_lastAppliedPlaybackRate.Value - targetPlaybackRate) >= 0.01d)
        {
            await JS.InvokeVoidAsync("listenPlayback.setPlaybackRate", _audioRef, targetPlaybackRate);
            _lastAppliedPlaybackRate = targetPlaybackRate;
        }

        var streamChanged = !string.Equals(_lastSeekedStreamUrl, browserStreamUrl, StringComparison.Ordinal);
        var shouldSeek = targetPositionSeconds > 0 && streamChanged
            || startVersionChanged;
        if (shouldSeek)
        {
            await JS.InvokeVoidAsync("listenPlayback.seekAudio", _audioRef, targetPositionSeconds);
            _lastSeekedStreamUrl = browserStreamUrl;
            _lastSeekedPositionSeconds = targetPositionSeconds;
        }

        if (_lastAppliedPlayingState != Playback.IsPlaying)
        {
            if (Playback.IsPlaying)
            {
                if (Playback.IsAudiobookMode
                    && Playback.SleepTimerState.Mode != AudiobookSleepTimerModes.Off
                    && !IsSleepTimerBindingCurrent(Playback.SleepTimerState, browserStreamUrl))
                {
                    return;
                }

                var started = await JS.InvokeAsync<bool>("listenPlayback.playAudio", _audioRef);
                if (!started)
                {
                    await HandleStartFailureAsync();
                }
            }
            else
            {
                await JS.InvokeVoidAsync("listenPlayback.pauseAudio", _audioRef);
            }

            _lastAppliedPlayingState = Playback.IsPlaying;
        }
    }

    private async Task HandleAudioMetricsChangedAsync()
    {
        var rateSelectionVersion = Playback.PlaybackRateSelectionVersion;
        var state = await JS.InvokeAsync<AudioMetrics>("listenPlayback.readAudioState", _audioRef);
        await ApplyAudioMetricsAsync(state, rateSelectionVersion);
    }

    [JSInvokable]
    public Task HandleObservedAudioState(AudioMetrics state) =>
