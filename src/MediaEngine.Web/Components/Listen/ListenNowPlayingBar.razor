@namespace MediaEngine.Web.Components.Listen
@using System.Globalization
@using System.Threading
@using System.Text.Json
@using Microsoft.JSInterop
@using MediaEngine.Contracts.Playback
@using MediaEngine.Domain.Enums
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Components.Details
@using Microsoft.Extensions.DependencyInjection
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.MediaTiles
@using MediaEngine.Web.Services.Vault
@inject PlaybackSessionController Playback
@inject ListenContextSidebarState AudioSidebar
@inject IAudiobookBookmarkActions BookmarkActions
@inject AudiobookBookmarkActionService BookmarkActionOwner
@inject IUserPlaybackPreferencesAccessor PlaybackPreferences
@inject MediaEngine.Web.Services.Theming.DeviceContextService DeviceContext
@inject ListenAudioDragService AudioDrag
@inject MediaReactionService Reactions
@inject UIOrchestratorService Orchestrator
@inject IServiceProvider Services
@inject IJSRuntime JS
@inject ILogger<ListenNowPlayingBar> Logger
@using MediaEngine.Web.Services.Navigation
@inject NavigationManager Nav
@inject IAppToastService Snackbar
@implements IAsyncDisposable
@inject IStringLocalizer<SharedStrings> L

<audio @ref="_audioRef"
       id="listen-audio-engine"
       data-current-asset-id="@(Playback.CurrentItem?.AssetId?.ToString("D"))"
       data-playback-request-version="@Playback.PlaybackRequestVersion"
       class="listen-player__audio-native"
       @onloadedmetadata="HandleAudioMetricsChangedAsync"
       @ondurationchange="HandleAudioMetricsChangedAsync"
       @onplay="HandleAudioStarted"
       @onpause="HandleAudioPaused"
       @onerror="HandleAudioErrorAsync">
</audio>

@if (!string.IsNullOrWhiteSpace(_playbackRestoreError))
{
    <div class="listen-player__restore-status" role="status">
        <span>@_playbackRestoreError</span>
        <AppNativeButton Type="button" OnClick="RetryPlaybackStateRestoreAsync" AriaLabel="@L["ListenNowPlayingBar_RetryPlaybackStateRestore"].Value">@L["Common_Retry"]</AppNativeButton>
    </div>
}

@if (_bookmarkDialogContext is not null && _bookmarkDialogSnapshot is not null && _phoneFullPlayer?.ActiveMode != "bookmarks")
{
    <AudiobookBookmarkDialog Context="@_bookmarkDialogContext"
                             Actions="@BookmarkActions"
                             AuthorizedAssetIds="@_bookmarkAuthorizedAssetIds"
                             WorkTitle="@(_bookmarkWorkTitle ?? "Audiobook")"
                             IsMobile="@IsPhonePresentation"
                             Trigger="@_bookmarkTrigger"
                             OnClose="DismissBookmarkDialogAsync" />
}

@if (Playback.HasQueue && Playback.CurrentItem is not null && !Playback.IsVideoMode)
{
    var dockSnapshot = Playback.CreateSnapshot();
    <div class="@PlayerShellClass"
         @ref="_playerShellRef"
         tabindex="0"
         @onkeydown="HandlePlayerKeyDown"
         @ondragover:preventDefault="true"
         @ondrop:preventDefault="true"
         @ondrop="QueueDraggedItemsAsync">
        <PlaybackShell @ref="_shell" Media="@BarMedia" Surface="dock" Compact="@IsPhonePresentation"
                       Class="@($"listen-player {(Playback.IsAudiobookMode ? "listen-player--audiobook" : "listen-player--music")}")"
                       AriaLabel="@L["ListenNowPlayingBar_NowPlayingMiniPlayer"].Value"
                       State="@BarState" Identity="@BarIdentity" ErrorText="@Playback.CurrentError"
                       ArtworkSrc="@BarArtwork.Src" ArtworkSrcSet="@BarArtwork.SrcSet"
                       ArtworkAlt="@Playback.CurrentItem.Title" ArtworkDisplay="audio-dock-thumbnail"
                       ArtworkClick="OpenNowPlaying" ArtworkLabel="@(IsNowPlayingPage ? L["ListenNowPlayingBar_CloseNowPlaying"].Value : L["ListenNowPlayingBar_OpenNowPlaying"].Value)"
                       PlayButtonAttributes="@PlayButtonAttributes"
                       Volume="@Playback.Volume" IsMuted="@(PlaybackMuteDisplay.ShowsMuted(Playback.IsMuted, Playback.Volume, Playback.VolumeReported))"
                       VolumeSupported="@Playback.SoftwareVolumeSupported" VolumeStep="@VolumeStep"
                       OnToggleMute="ToggleMuteAsync" OnVolumeChanged="SetVolumeOnHostAsync"
                       OnTransport="HandleBarTransportAsync" OnTool="HandleBarToolAsync"
                       HostedTools="@HostedBarTools">
            <LinkContent Context="link">
                <PlaybackIdentityLink Snapshot="dockSnapshot" Commands="PanelCommands" Kind="@link.Kind" Id="link.Id" Text="@link.Text" />
            </LinkContent>
            <IdentityActions>
                @* Music: Favorite, Like, Dislike and More. Audiobooks: Favorite and More (unified player v2 D5, D23). *@
                <PlaybackIdentityActions Media="@BarMedia" Item="@Playback.CurrentItem" Surface="dock"
                                         IsFavorite="@BarIsFavorite" FavoriteChanged="@BarFavoriteChanged"
                                         Snapshot="@dockSnapshot" Commands="@PanelCommands" IsCurrent="@(() => IsCurrentDockSnapshot(dockSnapshot))">
                    <SettingsPanel Context="anchor">
                        @* Playback settings from the "..." menu (unified player v2 D14): speed and skip lengths for audiobooks, only Playback information for music. *@
                        <PlaybackSettingsPanel Media="@BarMedia" Surface="dock" ShowTrigger="false" Trigger="@anchor.Trigger" Open="@anchor.Open" OpenChanged="@anchor.OpenChanged"
                                               ItemKey="@DockItemKey" Rate="@Playback.PlaybackRate" RateChanged="SetAudiobookSpeedAsync"
                                               SkipBackSeconds="@Playback.SkipBackSeconds" SkipForwardSeconds="@Playback.SkipForwardSeconds" SkipChanged="ChangeSkipLengthAsync"
                                               Manifest="@Playback.CurrentManifest" OnReset="ResetPlaybackPreferencesAsync" />
                    </SettingsPanel>
                </PlaybackIdentityActions>
            </IdentityActions>
            <TimelineContent>
                @* The timeline above the row (unified player v2 D9): elapsed, the rail, the time left. An audiobook with chapters adds its label between the
                   elapsed time and the rail, "Chapter 8" or "Book · 32%", and the time left reads "−18:32" or "6h 12m left". *@
                @if (ChapterScope is { } scope)
                {
                    <PlaybackSeekRail Position="@scope.Elapsed(Playback.CurrentTimeSeconds)" Duration="@scope.Length" ValueChanged="@(seconds => SeekOnHostAsync(scope.ToAbsolute(seconds)))" Surface="dock"
                                      Label="@PlaybackTimelineLabels.ChapterLabel(L, scope.Number)" LabelClick="@(() => SetBarScopeAsync(true))" LabelActionText="@L["ListenNowPlayingBar_ShowWholeBook"].Value"
                                      Summary="@PlaybackTimelineLabels.ChapterSummary(L, scope.Number, scope.Elapsed(Playback.CurrentTimeSeconds), Math.Max(0, scope.Length - scope.Elapsed(Playback.CurrentTimeSeconds)))"
                                      Bookmarks="@BarMarkers(scope)" BookmarkJump="@(marker => SeekOnHostAsync(AudiobookBarMarkers.ToAbsolute(marker, scope)))" />
                }
                else if (Playback.IsAudiobookMode && AudiobookWindow is not null)
                {
                    <PlaybackSeekRail Position="@Playback.CurrentTimeSeconds" Duration="@Playback.DurationSeconds" ValueChanged="SeekOnHostAsync" Surface="dock"
                                      Label="@PlaybackTimelineLabels.BookLabel(L, Playback.CurrentTimeSeconds, Playback.DurationSeconds)" LabelClick="@(() => SetBarScopeAsync(false))" LabelActionText="@L["ListenNowPlayingBar_ShowThisChapter"].Value"
                                      EndText="@PlaybackTimelineLabels.TimeLeft(L, Playback.DurationSeconds - Playback.CurrentTimeSeconds)"
                                      Summary="@PlaybackTimelineLabels.BookSummary(L, Playback.CurrentTimeSeconds, Playback.DurationSeconds)"
                                      Bookmarks="@BarMarkers(null)" BookmarkJump="@(marker => SeekOnHostAsync(marker.Seconds))" />
                }
                else
                {
                    <PlaybackSeekRail Position="@Playback.CurrentTimeSeconds" Duration="@Playback.DurationSeconds" ValueChanged="SeekOnHostAsync" Surface="dock"
                                      Bookmarks="@BarMarkers(null)" BookmarkJump="@(marker => SeekOnHostAsync(marker.Seconds))" />
                }
            </TimelineContent>
            <ToolContent Context="tool">
                @switch (tool.Key)
                {
                    case PlaybackControlKey.Lyrics:
                        @if (IsDesktopNowPlaying)
                        {
                            @* On the Now playing page the lyrics are a tab of the page, so this tool only selects it. *@
                            <ListenDockTool PanelKey="lyrics" Title="@L["Common_Lyrics"].Value" Glyph="PlaybackUtilityGlyphKind.Lyrics" ItemKey="@DockItemKey"
                                            Inline="true" IsSelected="@(PressedInlineKey == "lyrics")" OnInlineSelected="@(() => SelectInlinePanelAsync("lyrics"))" />
                        }
                        else
                        {
                            @* The Lyrics panel (unified player v2 D17, mockup screen 7); its Open Now playing button does what the artwork does. It stays open when the song changes: the lyrics reset by themselves. *@
                            <PlaybackLyricsPanel OnOpenNowPlaying="OpenNowPlaying" OnOpenChanged="@(open => DockToolChangedAsync("lyrics", open))" />
                        }
                        break;
                    case PlaybackControlKey.Queue:
                        <ListenDockTool PanelKey="queue" Title="@L["Common_Queue"].Value" ListPanel="true" Glyph="PlaybackUtilityGlyphKind.Queue" ItemKey="@DockItemKey"
                                        Inline="@IsDesktopNowPlaying" IsSelected="@(PressedInlineKey is "queue" or "history")" OnInlineSelected="@(() => SelectInlinePanelAsync("queue"))" OnOpenChanged="@(open => DockToolChangedAsync("queue", open))">
                            <ListenContextSidebar ActivePanelKey="@(InlinePanelKey == "history" ? "history" : "queue")" ShowTabs="true" />
                        </ListenDockTool>
                        break;
                    case PlaybackControlKey.Chapters:
                        <ListenDockTool PanelKey="chapters" Title="@(HasUsableChapters ? L["Common_Chapters"].Value : "History")" ListPanel="@HasUsableChapters"
                                        Glyph="@(HasUsableChapters ? PlaybackUtilityGlyphKind.Chapters : PlaybackUtilityGlyphKind.History)"
                                        ItemKey="@DockItemKey" Inline="@IsDesktopNowPlaying" IsSelected="@(PressedInlineKey is "chapters" or "history")" OnInlineSelected="@(() => SelectInlinePanelAsync(HasUsableChapters ? "chapters" : "history"))" OnOpenChanged="@(open => DockToolChangedAsync(HasUsableChapters ? "chapters" : "history", open))">
                            <ListenContextSidebar ActivePanelKey="@(HasUsableChapters ? "chapters" : "history")" />
                        </ListenDockTool>
                        break;
                    case PlaybackControlKey.Speed:
                        @* The speed value on the bar opens the Speed panel directly (unified player v2 D15, mockup screen 5). *@
                        <PlaybackSpeedPanel Surface="dock" Rate="@Playback.PlaybackRate" RateChanged="SetAudiobookSpeedAsync" ItemKey="@DockItemKey"
                                            IsOn="@tool.IsActive" TriggerText="@tool.ValueText" TriggerClass="playback-shell__chip"
                                            Open="@(_settingsMenuOpen && _settingsMenuSurface == "dock" && _settingsMenuTool == "speed")"
                                            OpenChanged="@(state => HandleBarSettingsOpenChangedAsync("speed", state))" />
                        break;
                    case PlaybackControlKey.SleepTimer:
                        @* The moon opens the Sleep timer panel directly (unified player v2 D16, mockup screen 6). *@
                        <SleepTimerPanel Surface="dock" ItemKey="@DockItemKey" IsOn="@tool.IsActive" State="@Playback.SleepTimerState" Availability="@Playback.SleepTimerAvailability"
                                         Chapters="@SleepTimerChapters" OffersEndOfChapter="@Playback.AllowEndOfChapterSleepTimer" SelectionChanged="SetAudiobookSleepTimerSelectionAsync"
                                         Open="@(_settingsMenuOpen && _settingsMenuSurface == "dock" && _settingsMenuTool == "sleep")" OpenChanged="@(state => HandleBarSettingsOpenChangedAsync("sleep", state))" />
                        break;
                }
            </ToolContent>
        </PlaybackShell>
        <PlaybackPanel @ref="_compactContext" Title="@ContextToolTitle" ToolId="audio-compact-context" ItemKey="@DockItemKey"
                         Kind="@CompactPanelKind(_compactPanelKey, Playback.IsMusicMode)" Trigger="@_compactToolTrigger" ShowHeading="@CompactIsList"
                         OpenChanged="@(open => DockToolChangedAsync(_compactPanelKey, open))">
            <ListenContextSidebar @key="_compactPanelKey" ActivePanelKey="@_compactPanelKey"
                                 ShowTabs="@(_compactPanelKey is "queue" || _compactPanelKey == "history" && Playback.IsMusicMode)" />
        </PlaybackPanel>

        @* On a phone, Now playing is the expanded player over the page. On a desktop it is the Now playing page (route /listen/now-playing), which
           the bar sits under; the bar and the page share this one audio element (unified player v2 D24). *@
        @if (Playback.PresentationSurface == PlaybackPresentationSurface.NowPlaying && IsPhonePresentation)
        {
            <PlaybackFullPlayer @ref="_phoneFullPlayer" Snapshot="@dockSnapshot" Commands="@PanelCommands"
                                OnCollapse="CloseNowPlaying" IsFavorite="@_isFavorite" FavoriteChanged="ToggleFavoriteAsync"
                                BookmarkRequested="OpenBookmarkDialogAsync" SelectedPanelKey="@InlinePanelKey"
                                PanelChanged="SelectDockTabAsync" ModeChanged="FullModeChangedAsync" ToolVisibilityChanged="HandleFullPlayerToolsAsync">
                <BookmarksContent>
                    @if (_bookmarkDialogContext is not null && _bookmarkDialogSnapshot is not null) {
                        <AudiobookBookmarkDialog Context="_bookmarkDialogContext" Actions="BookmarkActions" AuthorizedAssetIds="_bookmarkAuthorizedAssetIds"
                            WorkTitle="@(_bookmarkWorkTitle ?? "Audiobook")" Embedded="true" Trigger="_bookmarkTrigger" OnClose="DismissEmbeddedBookmarksAsync" />
                    } else { <p role="status">@L["ListenNowPlayingBar_BookmarksAreUnavailableUntilThe"]</p> }
                </BookmarksContent>
            </PlaybackFullPlayer>
        }
    </div>
}

@code {
    private async Task FullModeChangedAsync(string? mode) { if (mode != "bookmarks" && _bookmarkDialogContext is not null) await DismissBookmarkDialogAsync(); }
    private async Task DismissEmbeddedBookmarksAsync() { await DismissBookmarkDialogAsync(); if (_phoneFullPlayer is not null) await _phoneFullPlayer.DismissToolsAsync(); }
    private IJSObjectReference? _audioCapabilitiesModule;
    private IJSObjectReference? _mediaSessionModule;
    private string? _mediaSessionSubject;

    [JSInvokable]
    public Task AudioCapabilitiesChangedAsync(AudioOutputStateDto state) => InvokeAsync(() =>
    {
        if (!_disposed) Playback.SetAudioCapabilities(state.Supported, state.SoftwareVolumeSupported);
    });

    [JSInvokable]
    public Task MediaSessionActionAsync(string action, double? value) => InvokeAsync(async () =>
    {
        if (_disposed || !Playback.HasQueue || Playback.IsVideoMode || Playback.IsDismissed) return;
        var shown = Playback.CreateSnapshot();
        var command = action switch
        {
            "play" => ListenPlaybackCommandActions.Play,
            "pause" => ListenPlaybackCommandActions.Pause,
            "previoustrack" => Playback.IsAudiobookMode ? ListenPlaybackCommandActions.PlayPreviousChapter : ListenPlaybackCommandActions.PlayPrevious,
            "nexttrack" => Playback.IsAudiobookMode ? ListenPlaybackCommandActions.PlayNextChapter : ListenPlaybackCommandActions.PlayNext,
            "seekto" or "seekforward" or "seekbackward" => ListenPlaybackCommandActions.Seek,
            _ => null,
        };
        if (command is null) return;
        if (command == ListenPlaybackCommandActions.Seek)
        {
            if (value is double number && !double.IsFinite(number)) return;
            var seconds = action == "seekto" ? value : shown.CurrentTimeSeconds + (action == "seekbackward" ? -1 : 1) * (value ?? (action == "seekbackward" ? shown.SkipBackSeconds : shown.SkipForwardSeconds));
            if (seconds is null || !double.IsFinite(shown.DurationSeconds) || shown.DurationSeconds <= 0) return;
            value = Math.Clamp(seconds.Value, 0, shown.DurationSeconds);
        }
        await PanelCommands.SendAsync(shown, new() { Action = command, Value = value });
    });
    private PlaybackPanel? _compactContext;
    private ElementReference? _compactToolTrigger;
    private string _compactPanelKey = "queue";
    private bool _openCompactToolPending;
    private string ContextToolTitle => _compactPanelKey switch { "lyrics" => "Lyrics", "chapters" => L["Common_Chapters"].Value, "history" => Playback.IsMusicMode ? L["Common_Queue"].Value : "History", _ => L["Common_Queue"].Value };
    private bool CompactIsList => _compactPanelKey is "queue" or "chapters" || _compactPanelKey == "history" && Playback.IsMusicMode;

    /// <summary>
    /// The panel kind the compact tool panel is drawn as. A music "history" request is the Queue panel opened on its History tab, so it gets the Queue's
    /// 440 x 440 size (mockup screen 8); an audiobook's history is the ordinary listening-history list.
    /// </summary>
    public static string CompactPanelKind(string key, bool isMusic) => key switch
    {
        "lyrics" => "lyrics",
        "queue" => "queue",
        "chapters" => "chapters",
        "history" when isMusic => "queue",
        _ => "ordinary",
    };
    private bool HasUsableChapters => CurrentChapters.Count > 1;
    private bool IsCurrentDockSnapshot(ListenPlaybackSnapshot snapshot) => !_disposed && snapshot.ProfileId == Playback.ActiveProfileId
        && snapshot.PlaybackRequestVersion == Playback.PlaybackRequestVersion && snapshot.CurrentIndex >= 0 && snapshot.CurrentIndex < snapshot.Queue.Count
        && snapshot.Queue[snapshot.CurrentIndex].QueueEntryId == Playback.CurrentItem?.QueueEntryId;
    private string DockItemKey => $"{Playback.ActiveProfileId}:{Playback.CurrentItem?.AssetId}:{Playback.PlaybackRequestVersion}";
    private PlaybackTransientToolCoordinator? Tools => Services.GetService<PlaybackTransientToolCoordinator>();
    private IPlaybackCommandSink PanelCommands => Services.GetRequiredService<IPlaybackCommandSink>();
    // Now playing on a desktop is the routed page (unified player v2 D24); its tabs are chosen by the bar's Lyrics, Queue and Chapters tools too.
    private bool IsNowPlayingPage => NowPlayingRoute.IsNowPlaying(RoutedPageAddress.AbsoluteFor(Nav, Overlay));
    private bool IsDesktopNowPlaying => IsNowPlayingPage && !IsPhonePresentation;
    // While the Now playing page is open the bar follows the page's tab: a tool is pressed only for the tab the page shows, and none is pressed when the
    // page opens on its default tab or shows About (mockup screen 13 presses only Now playing).
    private string? PressedInlineKey => IsDesktopNowPlaying ? AudioSidebar.NowPlayingTab : InlinePanelKey;
    private string InlinePanelKey => Playback.IsAudiobookMode && !HasUsableChapters ? "history" : AudioSidebar.For(Playback).ActivePanelKey ?? (Playback.IsAudiobookMode ? "chapters" : "queue");
    private void ObserveLyricsPresentation()
    {
        if (Services.GetService<PlaybackLyricsPresenter>() is { } presenter)
            presenter.Observe(Playback.CreateSnapshot(), PanelCommands);
    }
    private void HandleAudioPanelChanged() => _ = InvokeAsync(() => { ObserveLyricsPresentation(); StateHasChanged(); });
    private async Task SelectInlinePanelAsync(string key)
    {
        Tools?.Close(); CloseSettingsMenu();
        await SelectDockTabAsync(key);
        await InvokeAsync(StateHasChanged);
    }
    private Task SelectDockTabAsync(string key) => AudioSidebar.OpenPanelAsync(Playback.IsAudiobookMode ? "desktop:audiobook" : "desktop:music", key);
    private async Task DockToolChangedAsync(string key, bool open)
    {
        if (open) { CloseSettingsMenu(); await SelectDockTabAsync(key); }
        else if (Tools?.OpenToolId is null) await AudioSidebar.CloseAsync(Playback);
    }
    private async Task OpenDockPanelAsync(string key, ElementReference? trigger = null)
    {
        if (IsDesktopNowPlaying) { await SelectInlinePanelAsync(key); return; }
        Tools?.Close();
        _compactPanelKey = key;
        _compactToolTrigger = trigger ?? _shell?.ArtworkElement;
        await SelectDockTabAsync(key);
        _openCompactToolPending = _compactToolTrigger is not null;
        await InvokeAsync(StateHasChanged);
    }
    private readonly JsonSerializerOptions _jsonOptions = MediaEngineJson.Web;
    private PlaybackShell? _shell;
    private ElementReference _audioRef;
    private ElementReference _playerShellRef;
    private DotNetObjectReference<ListenNowPlayingBar>? _selfReference;
    private PlaybackFullPlayer? _phoneFullPlayer;
    private bool _nowPlayingFocused;
    private bool _isPhonePresentation;
    private bool IsPhonePresentation => _isPhonePresentation;
    private IJSObjectReference? _audioPresentationModule;
    private readonly string _audioPresentationObserverId = Guid.NewGuid().ToString("D");
    private bool _restored;
    private bool _disposed;
    private bool _browserClientRegistering;
    private string? _playbackRestoreError;
    private string? _lastAppliedStreamUrl;
    private string? _lastSeekedStreamUrl;
    private double? _lastSeekedPositionSeconds;
    private long _lastAppliedStartVersion = -1;
    private bool? _lastAppliedPlayingState;
    private long _playbackChangeNotificationVersion;
    private double? _lastAppliedVolume;
    private bool? _lastAppliedMuteState;
    private double? _lastAppliedPlaybackRate;
    private bool _settingsMenuOpen;
    private string? _settingsMenuTool;
    private string? _settingsMenuSurface;
    private long _transientPlaybackRequestVersion = -1;
    private long _nativeSleepTimerBindVersion;
    private readonly object _nativeSleepTimerBindingGate = new();
    private PendingNativeSleepTimerBinding? _pendingNativeSleepTimerBinding;
    private NativeSleepTimerBindingRequest? _nativeSleepTimerBinding;
    private AudiobookBookmarkActionContext? _bookmarkDialogContext;
    private AudiobookBookmarkActionSnapshot? _bookmarkDialogSnapshot;
    private ElementReference _bookmarkTrigger;
    private IReadOnlySet<Guid> _bookmarkAuthorizedAssetIds = new HashSet<Guid>();
    private string? _bookmarkWorkTitle;
    private bool _shortcutsRegistered;
    private bool _scrollActiveChapterPending;

    private string PlayerShellClass
    {
        get
        {
            var classes = IsListenRoute
                ? "listen-player-shell listen-player-shell--listen-route"
                : "listen-player-shell";

            if (Playback.PresentationSurface == PlaybackPresentationSurface.NowPlaying && IsPhonePresentation)
            {
                classes += " listen-player-shell--expanded";
            }

            return Playback.IsAudiobookMode
                ? $"{classes} listen-player-shell--audiobook"
                : classes;
        }
    }

    // The page under the details overlay counts as the current page while it is open.
    [CascadingParameter] public DetailsOverlayState? Overlay { get; set; }

    private bool IsListenRoute => new Uri(RoutedPageAddress.AbsoluteFor(Nav, Overlay)).AbsolutePath.StartsWith("/listen", StringComparison.OrdinalIgnoreCase);

    private double ProgressMax => Playback.DurationSeconds > 0 ? Playback.DurationSeconds : 1;
    private sealed record NativeSleepTimerBindingRequest(
        AudiobookSleepTimerStateDto State,
        Guid AssetId,
        long RequestVersion,
        string? SourceUrl);
    private sealed record PendingNativeSleepTimerBinding(
        NativeSleepTimerBindingRequest Request,
        long Version,
        TaskCompletionSource<bool> Completion);
    private Guid? _favoriteSongId, _favoriteProfileId;
    private long _favoriteLoadGeneration;
    private bool _isFavorite;
    private double VolumeStep => Playback.ClientSettings.VolumeStep;
    private string ProgressValueText => $"{FormatTimestamp(Playback.CurrentTimeSeconds)} of {FormatTimestamp(ProgressMax)}";
    private static string FormatVolumeValue(double value) => $"{Math.Clamp((int)Math.Round(value * 100d), 0, 100)}%";
    private Task ToggleShuffleFromDockAsync() => Playback.ToggleShuffleAsync();
    // The persistent bar (unified player v2 D1 to D6). PlaybackShell draws it from PlaybackControlCatalog; these are the host's answers.
    private PlaybackBarMedia BarMedia => Playback.IsAudiobookMode ? PlaybackBarMedia.Audiobook : PlaybackBarMedia.Music;
    private PlaybackSlotArtwork BarArtwork => PlaybackArtworkUrl.ForBarSlot(BarMedia, Playback.CurrentItem);
    // The music bar shares its Favorite state with Now playing; an audiobook's Favorite is read and written by the identity actions themselves.
    private bool? BarIsFavorite => Playback.IsMusicMode ? _isFavorite : null;
    private EventCallback BarFavoriteChanged => Playback.IsMusicMode ? EventCallback.Factory.Create(this, ToggleFavoriteAsync) : default;
    private PlaybackBarIdentity BarIdentity => Playback.CurrentItem is { } item
        ? PlaybackBarIdentity.Build(BarMedia, item, chapterTitle: Playback.CurrentChapter?.Title)
        : new(string.Empty, null, null, []);
    private PlaybackBarState BarState => new(
        IsPlaying: Playback.IsPlaying,
        NeedsUserGestureToStart: Playback.NeedsUserGestureToStart,
        // Music Previous always acts (it restarts the song at the start of the queue); an audiobook's steps are its chapters.
        CanPrevious: Playback.IsAudiobookMode ? Playback.CurrentItem?.Chapters.Count is > 0 : true,
        CanNext: Playback.IsAudiobookMode ? Playback.CurrentItem?.Chapters.Count is > 0 : CanPlayNext,
        SkipBackSeconds: Playback.SkipBackSeconds,
        SkipForwardSeconds: Playback.SkipForwardSeconds,
        ShuffleEnabled: Playback.ShuffleEnabled,
        RepeatMode: Playback.RepeatMode,
        PlaybackRate: Playback.PlaybackRate,
        HasChapters: CurrentChapters.Count > 0,
        CanBookmark: Playback.IsAudiobookMode && Playback.CurrentItem?.AssetId is not null,
        IsSleepTimerActive: Playback.SleepTimerState.Mode != AudiobookSleepTimerModes.Off,
        HasQueue: Playback.HasQueue,
        ActiveSheet: IsNowPlayingPage ? "now-playing" : _bookmarkDialogContext is not null ? "bookmarks" : null);
    private static readonly IReadOnlySet<PlaybackControlKey> HostedBarTools = new HashSet<PlaybackControlKey>
    {
        PlaybackControlKey.Lyrics, PlaybackControlKey.Queue, PlaybackControlKey.Chapters, PlaybackControlKey.Speed, PlaybackControlKey.SleepTimer,
    };

    // Starting playback from a click needs the browser's own gesture, so the Play button carries what the page script needs to start the stream.
    private IReadOnlyDictionary<string, object> PlayButtonAttributes => new Dictionary<string, object>
    {
        ["data-listen-audio-toggle"] = "true",
        ["data-listen-start-url"] = Playback.CurrentBrowserStreamUrl ?? string.Empty,
        ["data-listen-start-position"] = Playback.CurrentTimeSeconds.ToString("0.###", CultureInfo.InvariantCulture),
        ["data-listen-start-rate"] = Playback.PlaybackRate.ToString("0.###", CultureInfo.InvariantCulture),
        ["data-listen-start-volume"] = Playback.Volume.ToString("0.###", CultureInfo.InvariantCulture),
        ["data-listen-start-muted"] = Playback.IsMuted ? "true" : "false",
    };

    private Task HandleBarTransportAsync(PlaybackControlDefinition control) => control.Command switch
    {
        "toggle-play" => TogglePlayPauseAsync(),
        "skip-back" => SkipBackAsync(),
        "skip-forward" => SkipForwardAsync(),
        "play-previous" => PlayPreviousAsync(),
        "play-next" => PlayNextAsync(),
        "play-previous-chapter" => PlayPreviousChapterAsync(),
        "play-next-chapter" => PlayNextChapterAsync(),
        "shuffle" => ToggleShuffleFromDockAsync(),
        "repeat" => CycleRepeatFromDockAsync(),
        _ => Task.CompletedTask,
    };

    private Task HandleBarToolAsync(PlaybackControlActivation activation) => activation.Control.Command switch
    {
        "open-bookmarks" => OpenBookmarkDialogAsync(activation.Trigger),
        "open-now-playing" => OpenNowPlaying(),
        "close" => ClosePlayerAsync(),
        _ => Task.CompletedTask,
    };
    private Task CycleRepeatFromDockAsync() => Playback.CycleRepeatModeAsync();
    private void OpenCurrentDetails()
    {
        if (Playback.CurrentItem is not { } current)
        {
            return;
        }

        var route = Playback.IsMusicMode && current.CollectionId.HasValue
            ? $"/details/musicalbum/{current.CollectionId.Value:D}?context=listen&track={current.WorkId:D}"
            : $"/details/work/{current.WorkId:D}?context=listen";
        Nav.NavigateTo(route);
    }
    private bool CanPlayNext =>
        Playback.CurrentIndex < Playback.Queue.Count - 1
        || Playback.Queue.Count > 1 && Playback.ShuffleEnabled
        || Playback.Queue.Count > 0 && Playback.RepeatMode == PlayerRepeatModes.All;
    private string RepeatAriaLabel => Playback.RepeatMode switch
    {
        PlayerRepeatModes.One => "Repeat one",
        PlayerRepeatModes.All => "Repeat queue",
        _ => "Repeat off",
    };
