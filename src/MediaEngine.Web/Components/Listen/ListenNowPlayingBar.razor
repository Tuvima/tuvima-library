    private double NowPlayingTimelineStart => Playback.IsAudiobookMode ? Playback.CurrentChapter?.StartSeconds ?? 0 : 0;
    private double NowPlayingTimelineMax => Playback.IsAudiobookMode && Playback.CurrentChapter?.EndSeconds is { } end
