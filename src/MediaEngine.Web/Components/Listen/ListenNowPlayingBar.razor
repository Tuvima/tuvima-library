    [JSInvokable]
    public async Task HandlePlaybackCommand(string json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return;
        }

        using var document = JsonDocument.Parse(json);
        if (!document.RootElement.TryGetProperty("action", out var action)
            || !string.Equals(action.GetString(), "request-state", StringComparison.Ordinal))
        {
            return;
        }

        if (Playback.HasQueue)
        {
            var snapshot = JsonSerializer.Serialize(Playback.CreateSnapshot(), _jsonOptions);
            await JS.InvokeVoidAsync("listenPlayback.setState", snapshot);
        }
        else await JS.InvokeVoidAsync("listenPlayback.clearState");
    }

    private async Task HandleTransportCommandAsync(PlaybackTransportCommand command)
    {
        if (Playback.IsVideoMode)
        {
            return;
        }

        switch (command.Action)
        {
            case "toggle-play":
                await TogglePlayPauseAsync();
                break;
            case "pause":
                await PauseAudioAsync();
                break;
            case "play-next":
                await PlayNextAsync();
                break;
            case "play-previous":
                await PlayPreviousAsync();
                break;
            case "play-next-chapter":
                await Playback.PlayNextChapterAsync();
                break;
            case "play-previous-chapter":
                await Playback.PlayPreviousChapterAsync();
                break;
            case "skip-back":
                await SkipBackAsync();
                break;
            case "skip-forward":
                await SkipForwardAsync();
                break;
            case "seek" when command.Value.HasValue:
                await SeekOnHostAsync(command.Value.Value);
                break;
            case "start":
                await StartAudioAsync(command);
                break;
            case "set-volume" when command.Value.HasValue:
                await ApplyVolumeOnHostAsync(command.Value.Value);
                break;
            case "set-speed" when command.Value.HasValue:
                await ApplyPlaybackRateAsync(command.Value.Value);
                break;
            case "toggle-mute":
                await ToggleMuteOnHostAsync();
                break;
            case "close-player":
                await ClosePlayerAsync();
                break;
        }
    }

    private static string FallbackIconFor(ListenQueueItem item)
        => IsAudiobook(item) ? Icons.Material.Outlined.Headphones : Icons.Material.Outlined.Album;

    private static string PlayerSubtitleFor(ListenQueueItem item, string? sourceLabel)
    {
        if (IsAudiobook(item))
        {
            return StringHelpers.FirstNonBlankOr("Library audio", item.Subtitle, item.Album, sourceLabel, "Audiobook");
        }

        return StringHelpers.FirstNonBlankOr("Library audio", item.Subtitle, item.Album, sourceLabel, "Music library");
    }

    private static string FormatHistoryStamp(DateTimeOffset? playedAt)
        => playedAt.HasValue
            ? playedAt.Value.LocalDateTime.ToString("M/d h:mm tt", CultureInfo.CurrentCulture)
            : "Played earlier";

    private static string FormatHistoryTime(DateTimeOffset? playedAt)
        => playedAt?.LocalDateTime.ToString("h:mm tt", CultureInfo.CurrentCulture) ?? "—";

    private static string FormatHistoryTime(DateTimeOffset playedAt)
        => playedAt.LocalDateTime.ToString("h:mm tt", CultureInfo.CurrentCulture);

    private static string ContextSubtitle(params string?[] values)
        => StringHelpers.FirstNonBlankOr("Library audio", values);

    private static string FormatTimestamp(double seconds)
    {
        var safe = Math.Max(0, seconds);
        var span = TimeSpan.FromSeconds(safe);
        return span.TotalHours >= 1
            ? span.ToString(@"h\:mm\:ss", CultureInfo.InvariantCulture)
            : span.ToString(@"m\:ss", CultureInfo.InvariantCulture);
    }

    private static string ChapterDuration(PlaybackChapterDto chapter) =>
        chapter.EndSeconds is > 0 && chapter.EndSeconds.Value > chapter.StartSeconds
            ? FormatTimestamp(chapter.EndSeconds.Value - chapter.StartSeconds)
            : string.Empty;

    private static bool IsAudiobook(ListenQueueItem item)
        => MediaKindClassifier.IsAudiobook(item.MediaType);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        var bookmarkContext = _bookmarkDialogContext;
        _bookmarkDialogContext = null;
        if (bookmarkContext is not null)
        {
            try { await BookmarkActions.CloseAsync(bookmarkContext); }
            catch (Exception exception) { Logger.LogDebug(exception, "The audiobook bookmark dialog lease was already released during playback bar disposal."); }
        }

        Playback.SetTransportHostNotReady();
        Playback.Changed -= HandlePlaybackChanged;
        Playback.TransportCommandRequested -= HandleTransportCommandAsync;
        Playback.SleepTimerNativeArmRequested -= BindNativeSleepTimerAsync;
        Playback.SleepTimerPauseRequested -= PauseNativeSleepTimerAsync;
        Playback.SleepTimerNativeSourcePrepareRequested -= PrepareNativeSleepTimerSourceAsync;
        Playback.SleepTimerNativePositionRequested -= ReadNativeSleepTimerPositionAsync;
        BookmarkActionOwner.Changed -= OnBookmarkActionsChanged;
        Nav.LocationChanged -= HandleLocationChanged;
        DeviceContext.OnChanged -= HandleDeviceContextChanged;

        try
        {
            await JS.InvokeVoidAsync("listenPlayback.unregisterAudioStateObserver", _audioRef);
            await JS.InvokeVoidAsync("listenPlayback.unregisterPlayerShortcuts", _playerShellRef);
            await JS.InvokeVoidAsync("listenPlayback.unregisterCommandHandler", _selfReference);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogDebug(ex, "Failed to unregister listen playback command handler.");
        }

        _selfReference?.Dispose();
    }

    public sealed class AudioMetrics
    {
        public double CurrentTime { get; set; }
        public double Duration { get; set; }
        public double Volume { get; set; }
        public bool Muted { get; set; }
        public bool Paused { get; set; }
        public double PlaybackRate { get; set; } = 1d;
    }

}
