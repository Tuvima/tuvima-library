@namespace MediaEngine.Web.Components.Listen
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Web.Components.Shared
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject PlaybackLyricsPresenter Presenter
@inject IJSRuntime JS

<div class="playback-lyrics" @ref="_root" aria-label="Lyrics">
    <div class="playback-lyrics__toolbar">
        <AppSelect Appearance="playback-flat" Value="@(Presenter.SelectedTrackId?.ToString("D"))" ValueChanged="SelectAsync"
                   Options="@VersionOptions" AriaLabel="Lyrics version" Disabled="@(Presenter.Tracks.Count == 0)"
                   Variant="Variant.Text" Margin="Margin.None" Dense="true" FullWidth="false">
            <TriggerContent><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Lyrics" /></TriggerContent>
        </AppSelect>
        <span class="playback-lyrics__version">@SelectedVersion</span>
        <PlaybackTooltip Text="@PreferredLabel">
            <AppNativeButton Type="button" Class="playback-lyrics__tool" AriaLabel="@PreferredLabel"
                             Disabled="@(Presenter.SelectedTrackId is null)" aria-pressed="@(IsPreferred ? "true" : "false")" OnClick="Presenter.PreferAsync">
                <MudIcon Icon="@(IsPreferred ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)" />
            </AppNativeButton>
        </PlaybackTooltip>
        <PlaybackTooltip Text="Find better lyrics">
            <AppNativeButton Type="button" Class="playback-lyrics__tool" AriaLabel="Find better lyrics"
                             Disabled="@Presenter.Refreshing" OnClick="Presenter.RefreshAsync"><MudIcon Icon="@Icons.Material.Outlined.Refresh" /></AppNativeButton>
        </PlaybackTooltip>
    </div>
    @if (!string.IsNullOrWhiteSpace(Presenter.Status)) { <p class="playback-lyrics__status" role="status">@Presenter.Status</p> }
    <div class="playback-lyrics__lines" tabindex="0" aria-label="Lyric lines">
        @if (Presenter.Loading) { <p class="playback-lyrics__empty">Loading lyrics…</p> }
        else if (Presenter.Lines.Count == 0) { <p class="playback-lyrics__empty">No lyrics are available for this track.</p> }
        else
        {
            @for (var index = 0; index < Presenter.Lines.Count; index++)
            {
                var line = Presenter.Lines[index];
                var renderedSnapshot = Snapshot;
                @if (line.StartSeconds is double time)
                {
                    <AppNativeButton Type="button" Class="@($"playback-lyrics__line {(index == ActiveIndex ? "is-active" : "")}")"
                                     data-lyric-index="@index" aria-current="@(index == ActiveIndex ? "true" : null)"
                                     AriaLabel="@($"Seek to {line.Text}")" OnClick="@(() => SeekAsync(renderedSnapshot, time))">@line.Text</AppNativeButton>
                }
                else { <p class="playback-lyrics__line playback-lyrics__line--static">@line.Text</p> }
            }
        }
    </div>
    @if (_needsReturn && ActiveIndex >= 0)
    { <AppNativeButton Type="button" Class="playback-lyrics__return" OnClick="FollowAsync" AriaLabel="Back to current line">Back to current line</AppNativeButton> }
</div>

@code {
    [Parameter, EditorRequired] public ListenPlaybackSnapshot Snapshot { get; set; } = new();
    [Parameter, EditorRequired] public IPlaybackCommandSink Commands { get; set; } = null!;
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PlaybackLyrics>? _self;
    private bool _needsReturn, _disposed;
    private PlaybackLyricsIdentity? _identity;
    private IReadOnlyList<AppSelectOption> VersionOptions => Presenter.Tracks.Select(track =>
        new AppSelectOption(track.Id.ToString("D"), $"{track.Provider} · {track.Language} · {track.TimingMode}{(track.IsPreferred ? " · Preferred" : "")}")).ToArray();
    private string SelectedVersion => Presenter.Tracks.FirstOrDefault(track => track.Id == Presenter.SelectedTrackId) is { } track
        ? $"{track.Provider} · {track.Language}" : "Version";
    private bool IsPreferred => Presenter.Tracks.Any(track => track.Id == Presenter.SelectedTrackId && track.IsPreferred);
    private string PreferredLabel => IsPreferred ? "Preferred lyrics version" : "Set preferred lyrics version";
    private int ActiveIndex => Presenter.Lines.Select((line, index) => (line, index))
        .Where(row => row.line.StartSeconds is double time && time <= Snapshot.CurrentTimeSeconds)
        .OrderByDescending(row => row.line.StartSeconds).Select(row => row.index).DefaultIfEmpty(-1).First();
    protected override void OnInitialized() => Presenter.Changed += Changed;
    protected override async Task OnParametersSetAsync()
    {
        var identity = PlaybackLyricsIdentity.From(Snapshot);
        if (identity != _identity) { _identity = identity; _needsReturn = false; }
        await Presenter.EnsureAsync(Snapshot, Commands);
    }
    private void Changed() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private Task SelectAsync(string? value) => Guid.TryParse(value, out var track) ? Presenter.SelectAsync(track) : Task.CompletedTask;
    private Task SeekAsync(ListenPlaybackSnapshot snapshot, double seconds) => Commands.SendAsync(snapshot,
        new MediaEngine.Contracts.Playback.ListenPlaybackCommandDto { Action = MediaEngine.Contracts.Playback.ListenPlaybackCommandActions.Seek, Value = seconds });
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (_module is null)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-lyrics.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _root, _self);
        }
        await _module.InvokeVoidAsync("update", _root, ActiveIndex, $"{_identity}:{Presenter.SelectedTrackId}");
    }
    [JSInvokable] public Task FollowChanged(bool needsReturn) { _needsReturn = needsReturn; return InvokeAsync(StateHasChanged); }
    private Task FollowAsync() => _module?.InvokeVoidAsync("follow", _root).AsTask() ?? Task.CompletedTask;
    public async ValueTask DisposeAsync()
    {
        _disposed = true; Presenter.Changed -= Changed;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("detach", _root); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
