@namespace MediaEngine.Web.Components.Listen
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Web.Components.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@inject IServiceProvider Services
@inject DeviceContextService DeviceContext
@implements IAsyncDisposable
@inject PlaybackLyricsPresenter Presenter
@inject IJSRuntime JS
@inject PlaybackSessionController Playback

<div class="playback-lyrics" @ref="_root" aria-label="Lyrics">
    @if (ShowMenu)
    {
        <div class="playback-lyrics__toolbar">
            <AppOverflowMenu AriaLabel="Lyrics options" Class="playback-lyrics__menu">
                @if (Presenter.Offers("find_lyrics"))
                {
                    <AppMenuItem Label="Look for lyrics again" Icon="@AppMaterialIcons.Outlined.Refresh" Disabled="@(Presenter.Refreshing)" OnClick="Presenter.RefreshAsync" />
                    <AppMenuItem Label="Not right? Find another" Icon="@AppMaterialIcons.Outlined.Search" OnClick="Presenter.OpenAlternativesAsync" />
                }
                @if (CanManageLyrics)
                {
                    <AppMenuItem Label="Edit lyrics" Icon="@AppMaterialIcons.Outlined.Edit" OnClick="ManageLyricsAsync" />
                }
                @if (Presenter.Lines.Count > 0 && Presenter.SelectedTrackId is not null)
                {
                    <AppMenuItem Label="This one is wrong" Icon="@AppMaterialIcons.Outlined.Close" OnClick="Presenter.MarkWrongAsync" />
                }
            </AppOverflowMenu>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Presenter.Status)) { <p class="playback-lyrics__status" role="status">@Presenter.Status</p> }
    <div class="playback-lyrics__lines" tabindex="0" aria-label="Lyric lines">
        @if (Presenter.AlternativesOpen)
        {
            <div class="playback-lyrics__alternatives" data-lyrics-state="alternatives">
                @if (Presenter.AlternativesLoading) { <p class="playback-lyrics__empty">Looking for other lyrics…</p> }
                else if (Presenter.Alternatives is { items.Count: > 0 } found)
                {
                    <ul>
                        @foreach (var alternative in found.items)
                        {
                            <li>
                                <AppNativeButton Type="button" Class="playback-lyrics__manage" Disabled="@(alternative.is_current || Presenter.Choosing)"
                                                 OnClick="@(() => Presenter.ChooseAsync(alternative))">
                                    <span class="playback-lyrics__alternative"><strong>@alternative.provider_name</strong>
                                    <span>@(alternative.is_timed ? "Timed to the song" : "Words only")@(alternative.is_current ? " · In use" : null)</span>
                                    @if (!string.IsNullOrWhiteSpace(alternative.preview)) { <small>@alternative.preview</small> }</span>
                                </AppNativeButton>
                            </li>
                        }
                    </ul>
                }
                else { <p class="playback-lyrics__empty">@(Presenter.Alternatives?.message is { Length: > 0 } message ? message : "No other lyrics were found.")</p> }
                <AppNativeButton Type="button" Class="playback-lyrics__manage" OnClick="Presenter.CloseAlternatives">Go back</AppNativeButton>
            </div>
        }
        else if (Presenter.Loading || Presenter.Refreshing) { <p class="playback-lyrics__empty" data-lyrics-state="looking">Looking for lyrics…</p> }
        else if (Presenter.Lines.Count == 0) {
            if (Presenter.NoSourceOn)
            {
                <div class="playback-lyrics__notice" role="status" data-lyrics-state="no-source">
                    <span class="playback-lyrics__notice-icon" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Info" /></span>
                    <div>
                        <strong>No lyrics source is switched on</strong>
                        <p>Lyrics are fetched from an online lyrics source that is part of Library's plugins. @(IsAdministrator ? "Switch one on and lyrics will appear here." : "Ask an administrator to switch one on.")</p>
                        <p>@OriginText</p>
                        @if (IsAdministrator) { <a class="playback-lyrics__manage" href="/settings/plugins">Open Plugins</a> }
                        @AddLyricsFile
                    </div>
                </div>
            }
            else
            {
                <p class="playback-lyrics__empty" data-lyrics-state="none-found">No lyrics found for this song.</p>
                <p class="playback-lyrics__empty">@OriginText</p>
                @if (Presenter.Offers("find_lyrics")) { <AppNativeButton Type="button" Class="playback-lyrics__manage" OnClick="Presenter.RefreshAsync">Look up lyrics now</AppNativeButton> }
                @AddLyricsFile
            }
        }
        else
        {
            @for (var index = 0; index < Timeline.Count; index++)
            {
                var line = Timeline[index];
                var renderedSnapshot = Snapshot;
                @if (line.IsInstrumental)
                {
                    <div class="playback-lyrics__line playback-lyrics__gap" data-lyric-index="@index" aria-label="Instrumental">
                        <span class="playback-lyrics__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    </div>
                }
                else if (line.StartSeconds is double time)
                {
                    <AppNativeButton Type="button" Class="playback-lyrics__line"
                                     data-lyric-index="@index"
                                     AriaLabel="@($"Seek to {line.Text}")" OnClick="@(() => SeekAsync(renderedSnapshot, time))">
                        @if (line.Words is { Count: > 0 } words)
                        {
                            @for (var wordIndex = 0; wordIndex < words.Count; wordIndex++)
                            { <span class="playback-lyrics__word" data-word-index="@wordIndex">@words[wordIndex].Text</span> }
                        }
                        else { @line.Text }
                    </AppNativeButton>
                }
                else { <p class="playback-lyrics__line playback-lyrics__line--static">@line.Text</p> }
            }
        }
    </div>
    @if (Presenter.SourceLine is { } sourceLine)
    { <small class="playback-lyrics__attribution" data-lyrics-source>@sourceLine</small> }
    @if (_needsReturn && ActiveIndex >= 0)
    { <AppNativeButton Type="button" Class="playback-lyrics__return" OnClick="FollowAsync" AriaLabel="Back to current line">Back to current line</AppNativeButton> }
</div>

@code {
    private const string OriginText = "Lyrics come from a .lrc file next to the song, or from LRCLIB, a free lyrics service. Library looks them up when it adds a song.";
    private const long MaxLyricsFileBytes = 5 * 1024 * 1024;
    private RenderFragment AddLyricsFile => @<AppFileUpload T="Microsoft.AspNetCore.Components.Forms.IBrowserFile" Accept=".lrc,.txt,text/plain" Disabled="@Presenter.Refreshing" FilesChanged="LyricsFileChosenAsync" Class="playback-lyrics__add-file">
        <CustomContent Context="upload"><AppButton Label="Add a lyrics file" ButtonStyle="AppButtonStyle.Outlined" Disabled="@Presenter.Refreshing" OnClick="upload.OpenFilePickerAsync" /></CustomContent>
    </AppFileUpload>;
    private async Task LyricsFileChosenAsync(Microsoft.AspNetCore.Components.Forms.IBrowserFile? file)
    {
        if (file is null) return;
        if (file.Size > MaxLyricsFileBytes) { Presenter.ShowStatus("That lyrics file is too big. Lyrics files must be 5 MB or smaller."); return; }
        try
        {
            await using var stream = file.OpenReadStream(MaxLyricsFileBytes);
            await Presenter.ImportFileAsync(file.Name, file.ContentType, stream);
        }
        catch (IOException) { Presenter.ShowStatus("That lyrics file could not be read."); }
    }
    [Parameter, EditorRequired] public ListenPlaybackSnapshot Snapshot { get; set; } = new();
    [Parameter, EditorRequired] public IPlaybackCommandSink Commands { get; set; } = null!;
    private ListenPlaybackSnapshot? _clockSnapshot;
    private IReadOnlyList<PlaybackLyricLine>? _clockLines;
    private string? _clockKey;
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PlaybackLyrics>? _self;
    private bool _needsReturn, _disposed;
    private PlaybackLyricsIdentity? _identity;
    private IReadOnlyList<PlaybackLyricLine>? _sourceLines;
    private IReadOnlyList<PlaybackLyricLine> _timeline = [];
    private double _timelineDuration;
    private IReadOnlyList<PlaybackLyricLine> Timeline
    {
        get
        {
            if (!ReferenceEquals(_sourceLines, Presenter.Lines) || _timelineDuration != Snapshot.DurationSeconds)
            {
                _sourceLines = Presenter.Lines; _timelineDuration = Snapshot.DurationSeconds;
                _timeline = PlaybackLyricsTimeline.Build(Presenter.Lines, Snapshot.DurationSeconds, Playback.ClientSettings);
            }
            return _timeline;
        }
    }
    private bool IsAdministrator => Services.GetService<DashboardSessionAccessor>()?.Authority?.EffectiveAdministrator == true;
    private bool ShowMenu => CanManageLyrics || Presenter.Offers("find_lyrics") || (Presenter.Lines.Count > 0 && Presenter.SelectedTrackId is not null);
    private bool CanManageLyrics => !DeviceContext.IsPhone && Services.GetService<DashboardSessionAccessor>()?.Authority?.EffectiveAdministrator == true;
    // The lyrics button opens the editor on the page behind the player (universal editor spec D18): edit mode starts on the song's album page
    // with this song ticked. A song that is not on an album has no such page, so it says so in plain words instead of opening a pop-up.
    private Task ManageLyricsAsync()
    {
        if (!CanManageLyrics || _identity is not { } identity || Snapshot.CurrentIndex < 0 || Snapshot.CurrentIndex >= Snapshot.Queue.Count)
            return Task.CompletedTask;
        var item = Snapshot.Queue[Snapshot.CurrentIndex];
        if (item.AlbumWorkId is not { } album || album == Guid.Empty)
        {
            Services.GetService<IAppToastService>()?.Add("Lyrics can be edited once this song is on an album.", AppSeverity.Info);
            return Task.CompletedTask;
        }
        var row = new BulkEditRow(identity.WorkId, item.Title, MediaEngine.Contracts.Details.DetailEntityType.Work, album, "Music");
        Services.GetService<MediaEngine.Web.Services.Navigation.DetailsOverlayState>()?.OfferEditResume(
            new MediaEngine.Web.Services.Navigation.DetailsEditResume(album, EditingSection.Details, null, row));
        Services.GetService<NavigationManager>()?.NavigateTo($"/details/musicalbum/{album:D}?context=listen&track={identity.WorkId:D}");
        return Task.CompletedTask;
    }
    private int ActiveIndex => Timeline.Select((line, index) => (line, index))
        .Where(row => row.line.StartSeconds is double time && time <= Snapshot.CurrentTimeSeconds
            && (!row.line.IsInstrumental || Snapshot.CurrentTimeSeconds < row.line.EndSeconds))
        .OrderByDescending(row => row.line.StartSeconds).Select(row => row.index).DefaultIfEmpty(-1).First();
    protected override void OnInitialized() => Presenter.Changed += Changed;
    protected override async Task OnParametersSetAsync()
    {
        var identity = PlaybackLyricsIdentity.From(Snapshot);
        if (identity != _identity) { _identity = identity; _needsReturn = false; _clockSnapshot = null; _clockKey = null; }
        await Presenter.EnsureAsync(Snapshot, Commands);
        await Presenter.EnsureActionsAsync();
        await Presenter.ProbeSourcesAsync();
    }
    private void Changed() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private Task SeekAsync(ListenPlaybackSnapshot snapshot, double seconds) => Commands.SendAsync(snapshot,
        new MediaEngine.Contracts.Playback.ListenPlaybackCommandDto { Action = MediaEngine.Contracts.Playback.ListenPlaybackCommandActions.Seek, Value = seconds });
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (_module is null)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-lyrics.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _root, _self);
        }
        var key = $"{_identity}:{Presenter.SelectedTrackId}";
        if (_clockKey != key || !ReferenceEquals(_clockLines, Timeline))
        {
            _clockKey = key; _clockLines = Timeline;
            await _module.InvokeVoidAsync("setTimes", _root, Timeline.Select(line => new { start = line.StartSeconds, end = line.EndSeconds, instrumental = line.IsInstrumental, words = line.Words?.Select(word => new { start = word.StartSeconds, end = word.EndSeconds }).ToArray() }).ToArray(), key);
        }
        if (!ReferenceEquals(_clockSnapshot, Snapshot))
        {
            _clockSnapshot = Snapshot;
            await _module.InvokeVoidAsync("setClock", _root, new { time = Snapshot.CurrentTimeSeconds, playing = Snapshot.IsPlaying && !Snapshot.NeedsUserGestureToStart,
                rate = Snapshot.PlaybackRate, asset = _identity?.AssetId.ToString("D"), request = Snapshot.PlaybackRequestVersion,
                lead = Playback.ClientSettings.LyricsLeadMilliseconds });
        }
    }
    [JSInvokable] public Task FollowChanged(bool needsReturn) { _needsReturn = needsReturn; return InvokeAsync(StateHasChanged); }
    private Task FollowAsync() => _module?.InvokeVoidAsync("follow", _root).AsTask() ?? Task.CompletedTask;
    public async ValueTask DisposeAsync()
    {
        _disposed = true; Presenter.Changed -= Changed;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("detach", _root); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
