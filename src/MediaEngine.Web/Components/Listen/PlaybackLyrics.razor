@namespace MediaEngine.Web.Components.Listen
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Web.Components.Shared
@using Microsoft.JSInterop
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@inject IServiceProvider Services
@implements IAsyncDisposable
@inject PlaybackLyricsPresenter Presenter
@inject IJSRuntime JS
@inject PlaybackSessionController Playback

<div class="playback-lyrics" @ref="_root" aria-label="Lyrics">
    @if (Presenter.Lines.Any(line => line.StartSeconds.HasValue)) { <small class="playback-lyrics__sync">Synced</small> }
    @if (!string.IsNullOrWhiteSpace(Presenter.Status)) { <p class="playback-lyrics__status" role="status">@Presenter.Status</p> }
    <div class="playback-lyrics__lines" tabindex="0" aria-label="Lyric lines">
        @if (Presenter.Loading) { <p class="playback-lyrics__empty">Loading lyrics…</p> }
        else if (Presenter.Lines.Count == 0) {
            <p class="playback-lyrics__empty">No lyrics are available for this track.</p>
            @if (CanManageLyrics) { <AppNativeButton Type="button" Class="playback-lyrics__manage" OnClick="ManageLyricsAsync">Manage lyrics</AppNativeButton> }
        }
        else
        {
            @for (var index = 0; index < Timeline.Count; index++)
            {
                var line = Timeline[index];
                var renderedSnapshot = Snapshot;
                @if (line.IsInstrumental)
                {
                    <div class="playback-lyrics__line playback-lyrics__gap" data-lyric-index="@index" aria-label="Instrumental">
                        <span class="playback-lyrics__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    </div>
                }
                else if (line.StartSeconds is double time)
                {
                    <AppNativeButton Type="button" Class="playback-lyrics__line"
                                     data-lyric-index="@index"
                                     AriaLabel="@($"Seek to {line.Text}")" OnClick="@(() => SeekAsync(renderedSnapshot, time))">
                        @if (line.Words is { Count: > 0 } words)
                        {
                            @for (var wordIndex = 0; wordIndex < words.Count; wordIndex++)
                            { <span class="playback-lyrics__word" data-word-index="@wordIndex">@words[wordIndex].Text</span> }
                        }
                        else { @line.Text }
                    </AppNativeButton>
                }
                else { <p class="playback-lyrics__line playback-lyrics__line--static">@line.Text</p> }
            }
        }
    </div>
    @if (Presenter.Tracks.FirstOrDefault(track => track.Id == Presenter.SelectedTrackId)?.Provider.Equals("lrclib", StringComparison.OrdinalIgnoreCase) == true)
    { <small class="playback-lyrics__attribution">Lyrics from LRCLIB</small> }
    @if (_needsReturn && ActiveIndex >= 0)
    { <AppNativeButton Type="button" Class="playback-lyrics__return" OnClick="FollowAsync" AriaLabel="Back to current line">Back to current line</AppNativeButton> }
</div>

@code {
    [Parameter, EditorRequired] public ListenPlaybackSnapshot Snapshot { get; set; } = new();
    [Parameter, EditorRequired] public IPlaybackCommandSink Commands { get; set; } = null!;
    private ListenPlaybackSnapshot? _clockSnapshot;
    private IReadOnlyList<PlaybackLyricLine>? _clockLines;
    private string? _clockKey;
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PlaybackLyrics>? _self;
    private bool _needsReturn, _disposed;
    private PlaybackLyricsIdentity? _identity;
    private IReadOnlyList<PlaybackLyricLine>? _sourceLines;
    private IReadOnlyList<PlaybackLyricLine> _timeline = [];
    private double _timelineDuration;
    private IReadOnlyList<PlaybackLyricLine> Timeline
    {
        get
        {
            if (!ReferenceEquals(_sourceLines, Presenter.Lines) || _timelineDuration != Snapshot.DurationSeconds)
            {
                _sourceLines = Presenter.Lines; _timelineDuration = Snapshot.DurationSeconds;
                _timeline = PlaybackLyricsTimeline.Build(Presenter.Lines, Snapshot.DurationSeconds, Playback.ClientSettings);
            }
            return _timeline;
        }
    }
    private bool CanManageLyrics => Services.GetService<DashboardSessionAccessor>()?.Authority?.EffectiveAdministrator == true;
    private async Task ManageLyricsAsync()
    {
        if (CanManageLyrics && _identity is { } identity && Services.GetService<MediaEditorLauncherService>() is { } editor)
            await editor.OpenAsync(new() { EntityIds = [identity.WorkId], LaunchEntityId = identity.WorkId, LaunchEntityKind = "Work",
                ActiveProfileId = identity.ProfileId, MediaType = "Music", InitialTab = "details" });
    }
    private int ActiveIndex => Timeline.Select((line, index) => (line, index))
        .Where(row => row.line.StartSeconds is double time && time <= Snapshot.CurrentTimeSeconds
            && (!row.line.IsInstrumental || Snapshot.CurrentTimeSeconds < row.line.EndSeconds))
        .OrderByDescending(row => row.line.StartSeconds).Select(row => row.index).DefaultIfEmpty(-1).First();
    protected override void OnInitialized() => Presenter.Changed += Changed;
    protected override async Task OnParametersSetAsync()
    {
        var identity = PlaybackLyricsIdentity.From(Snapshot);
        if (identity != _identity) { _identity = identity; _needsReturn = false; _clockSnapshot = null; _clockKey = null; }
        await Presenter.EnsureAsync(Snapshot, Commands);
    }
    private void Changed() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private Task SeekAsync(ListenPlaybackSnapshot snapshot, double seconds) => Commands.SendAsync(snapshot,
        new MediaEngine.Contracts.Playback.ListenPlaybackCommandDto { Action = MediaEngine.Contracts.Playback.ListenPlaybackCommandActions.Seek, Value = seconds });
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (_module is null)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-lyrics.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _root, _self);
        }
        var key = $"{_identity}:{Presenter.SelectedTrackId}";
        if (_clockKey != key || !ReferenceEquals(_clockLines, Timeline))
        {
            _clockKey = key; _clockLines = Timeline;
            await _module.InvokeVoidAsync("setTimes", _root, Timeline.Select(line => new { start = line.StartSeconds, end = line.EndSeconds, instrumental = line.IsInstrumental, words = line.Words?.Select(word => new { start = word.StartSeconds, end = word.EndSeconds }).ToArray() }).ToArray(), key);
        }
        if (!ReferenceEquals(_clockSnapshot, Snapshot))
        {
            _clockSnapshot = Snapshot;
            await _module.InvokeVoidAsync("setClock", _root, new { time = Snapshot.CurrentTimeSeconds, playing = Snapshot.IsPlaying && !Snapshot.NeedsUserGestureToStart,
                rate = Snapshot.PlaybackRate, asset = _identity?.AssetId.ToString("D"), request = Snapshot.PlaybackRequestVersion,
                lead = Playback.ClientSettings.LyricsLeadMilliseconds });
        }
    }
    [JSInvokable] public Task FollowChanged(bool needsReturn) { _needsReturn = needsReturn; return InvokeAsync(StateHasChanged); }
    private Task FollowAsync() => _module?.InvokeVoidAsync("follow", _root).AsTask() ?? Task.CompletedTask;
    public async ValueTask DisposeAsync()
    {
        _disposed = true; Presenter.Changed -= Changed;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("detach", _root); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
