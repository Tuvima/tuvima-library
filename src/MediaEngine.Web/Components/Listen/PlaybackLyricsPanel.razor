@namespace MediaEngine.Web.Components.Listen
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Playback
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IServiceProvider Services
@inject IStringLocalizer<SharedStrings> L

@* The Lyrics panel of the music bar (unified player v2 D17; mockup screen 7): a 460 px panel with the fixed header "Lyrics" + the Synced or Unsynced chip,
   Open Now playing and Close, the song's identity row, the lyrics (PlaybackLyrics, the part the Now playing page places too) and the fixed footer with the
   source and the "..." menu. "About lyrics sources" slides in as a nested view. On a phone PlaybackPanel draws all of it as a bottom sheet. *@
<PlaybackPanel @ref="_panel" Title="@L["Common_Lyrics"].Value" ToolId="audio-lyrics" Kind="lyrics" ItemKey="@ItemKey" OpenChanged="HandleOpenChangedAsync"
               TitleAdornment="@ChipContent" HeaderActions="@HeaderActionContent" Footer="@FooterContent">
    <TriggerContent><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Lyrics" /></TriggerContent>
    <ChildContent>
        <PlaybackLyrics Snapshot="@CurrentSnapshot" Commands="@CurrentCommands" ShowIdentity="true" ShowFooter="false" />
    </ChildContent>
</PlaybackPanel>

@code {
    private PlaybackPanel? _panel;
    private PlaybackSessionController? _playback;
    private bool _disposed;

    /// <summary>Closes the panel when this key changes (the song that is playing).</summary>
    [Parameter] public string? ItemKey { get; set; }

    /// <summary>The song to show; without it the panel follows the live player.</summary>
    [Parameter] public ListenPlaybackSnapshot? Snapshot { get; set; }

    [Parameter] public IPlaybackCommandSink? Commands { get; set; }

    /// <summary>Opens the Now playing view (the header's Open Now playing button). Without a handler the button is not drawn.</summary>
    [Parameter] public EventCallback OnOpenNowPlaying { get; set; }

    [Parameter] public EventCallback<bool> OnOpenChanged { get; set; }

    private ListenPlaybackSnapshot CurrentSnapshot => Snapshot ?? Services.GetService<PlaybackSessionController>()?.CreateSnapshot() ?? new();
    private IPlaybackCommandSink CurrentCommands => Commands ?? Services.GetRequiredService<IPlaybackCommandSink>();

    public Task OpenAsync() => _panel?.OpenAsync(true) ?? Task.CompletedTask;

    public ElementReference? TriggerElement => _panel?.TriggerElement;

    private RenderFragment ChipContent => @<PlaybackLyricsChip />;

    private RenderFragment? HeaderActionContent => !OnOpenNowPlaying.HasDelegate ? null :
        @<AppTooltip Text="@L["PlaybackLyrics_OpenNowPlaying"].Value">
            <AppNativeButton Type="button" Class="playback-panel__icon-button" AriaLabel="@L["PlaybackLyrics_OpenNowPlaying"].Value" OnClick="OpenNowPlayingAsync">
                <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.OpenExternal" />
            </AppNativeButton>
        </AppTooltip>;

    private RenderFragment FooterContent => @<PlaybackLyricsFooter Snapshot="@CurrentSnapshot" />;

    private async Task OpenNowPlayingAsync()
    {
        if (_panel is not null) await _panel.CloseAsync();
        await OnOpenNowPlaying.InvokeAsync();
    }

    // The panel follows the player only while it is open, so a closed panel costs nothing.
    private async Task HandleOpenChangedAsync(bool open)
    {
        var playback = open ? Services.GetService<PlaybackSessionController>() : null;
        if (!ReferenceEquals(_playback, playback))
        {
            if (_playback is not null) _playback.Changed -= PlaybackChanged;
            _playback = playback;
            if (_playback is not null) _playback.Changed += PlaybackChanged;
        }
        await OnOpenChanged.InvokeAsync(open);
    }

    private void PlaybackChanged(PlaybackChangeKind kind) { if (!_disposed) _ = InvokeAsync(StateHasChanged); }

    public void Dispose()
    {
        _disposed = true;
        if (_playback is not null) _playback.Changed -= PlaybackChanged;
    }
}
