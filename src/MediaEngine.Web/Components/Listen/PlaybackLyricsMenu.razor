@namespace MediaEngine.Web.Components.Listen
@using MediaEngine.Web.Services.Playback
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IStringLocalizer<SharedStrings> L

@* The rows of the lyrics footer's "..." menu (unified player v2 D17): 44 px rows, a 24 px glyph then the label, the extra rows under a hairline. One Tab
   stop; the arrow keys move between the rows (roving-focus.js). *@
<div class="playback-lyrics-menu" role="menu" aria-label="@L["PlaybackLyrics_LyricsOptions"].Value" @ref="_root" data-playback-lyrics-menu>
    @for (var index = 0; index < Items.Count; index++)
    {
        var item = Items[index];
        @if (item.DividerBefore)
        {
            <div class="playback-lyrics-menu__divider" role="separator"></div>
        }
        <AppNativeButton Type="button" Class="playback-lyrics-menu__row" role="menuitem" tabindex="@(index == 0 ? 0 : -1)" data-lyrics-action="@item.Key"
                         OnClick="@(() => OnSelected.InvokeAsync(item.Key))">
            <PlaybackUtilityGlyph Glyph="@item.Glyph" />
            <span class="playback-lyrics-menu__label">@item.Label</span>
        </AppNativeButton>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PlaybackLyricsMenuItem> Items { get; set; } = [];

    /// <summary>Raised with the chosen row's key; the footer closes the menu and does the work.</summary>
    [Parameter] public EventCallback<string> OnSelected { get; set; }

    private ElementReference _root;
    private IJSObjectReference? _roving;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || !firstRender) return;
        try
        {
            _roving = await JS.InvokeAsync<IJSObjectReference>("import", "./js/roving-focus.js");
            await _roving.InvokeVoidAsync("attach", _root, "[role=menuitem]", new { vertical = true });
        }
        catch (InvalidOperationException)
        {
            // Prerendering has no browser yet; the rows are ordinary buttons until the arrow keys attach.
        }
        catch (JSDisconnectedException)
        {
            // The circuit closed while the menu was drawing; there is nothing left to attach to.
        }
        catch (JSException)
        {
            // The arrow keys are a nicety (for example a stale cached module); Tab and Enter still reach every row.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_roving is null) return;
        try
        {
            await _roving.InvokeVoidAsync("detach", _root);
            await _roving.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone, so the browser has dropped the listeners with the page.
        }
    }
}
