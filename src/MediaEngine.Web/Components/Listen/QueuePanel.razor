@namespace MediaEngine.Web.Components.Listen
@using System.Globalization
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Playback
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IStringLocalizer<SharedStrings> L
@inject IJSRuntime JS
@inject IServiceProvider Services
@inject NavigationManager Nav

@* The Queue panel for music (unified player v2 D18; mockup screen 8). Two tabs, "Up next · N" and "History". Up next: the compact Now playing row, the "Up next · N"
   heading with Clear (which removes the upcoming songs and never stops the current one), then one row per song: drag handle in its own column, 40 px art, title and
   artist, length, and a "..." menu (Play next, Move up, Move down, Remove, Go to album, Go to artist). Dragging reorders; Move up and Move down are the keyboard and
   menu way to do the same through the same queue command. History lists what played this session with "3 min ago" and a Play action. The footer says where the queue
   came from. Rows are a fixed 52 px and only the ones on screen are drawn, so a 200 song queue is as light as a short one and never touches the bar. *@
<PlaybackListPanel @ref="_list" Inset="true" ScrollKey="@ScrollKey" ShowFooter="@(ShowFooter && !string.IsNullOrWhiteSpace(Snapshot.SourceLabel))" PanelId="@(ShowTabs ? PlaybackListTabs.PanelId(_idPrefix) : null)" LabelledBy="@(ShowTabs ? PlaybackListTabs.TabId(_idPrefix, Tab) : null)">
    <Header>
        @if (ShowTabs)
        {
            <PlaybackListTabs Tabs="@Tabs" Active="@Tab" ActiveChanged="SelectTabAsync" AriaLabel="@L["QueuePanel_Sections"].Value" IdPrefix="@_idPrefix" />
        }
    </Header>
    <ChildContent>
        @if (Tab == HistoryTab)
        {
            @HistoryList
        }
        else
        {
            @UpNextList
        }
        <p class="sr-only" role="status" aria-live="polite" data-queue-announce>@_announcement</p>
        @if (_failure is not null)
        {
            <div class="qp__failure"><AppAlert Tone="AppUiTone.Warning" Dense="true" data-queue-failure>@_failure</AppAlert></div>
        }
    </ChildContent>
    <Footer>
        @if (ShowFooter && !string.IsNullOrWhiteSpace(Snapshot.SourceLabel))
        {
            <span class="qp__source" data-queue-source><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Playlist" />@L["QueuePanel_PlayingFrom"] <b>@Snapshot.SourceLabel</b></span>
        }
    </Footer>
</PlaybackListPanel>
@if (_historyConfirmation is not null)
{
    <AppDialogShell Framed="true" Title="@L["QueuePanel_ClearHistoryTitle"].Value" Size="Small" Tone="AppUiTone.Warning" OnClose="@(() => _historyConfirmation = null)">
        <ChildContent><div class="app-dialog-shell__pad app-dialog-shell__pad--flow"><p>@L["QueuePanel_ClearHistoryBody"]</p></div></ChildContent>
        <FooterContent>
            <AppButton ButtonStyle="AppButtonStyle.Outlined" OnClick="@(() => _historyConfirmation = null)">@L["Search_Cancel"]</AppButton>
            <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Error" OnClick="ConfirmClearHistoryAsync">@L["QueuePanel_ClearHistory"]</AppButton>
        </FooterContent>
    </AppDialogShell>
}

@code {
    private const string UpNextTab = "upnext";
    private const string HistoryTab = "history";

    /// <summary>The upcoming rows have a fixed height so only the ones on screen are drawn.</summary>
    private const float RowHeightPx = 52f;

    private sealed record UpcomingRow(ListenQueueItem Item, int Index);

    private sealed record PendingFocus(Guid? Row, long QueueRevision, DateTimeOffset Until);

    [Parameter, EditorRequired] public ListenPlaybackSnapshot Snapshot { get; set; } = new();
    [Parameter, EditorRequired] public IPlaybackCommandSink Commands { get; set; } = null!;

    /// <summary>False when the host draws its own Up next and History tabs (the Now playing scene).</summary>
    [Parameter] public bool ShowTabs { get; set; } = true;

    /// <summary>The tab shown when <see cref="ShowTabs"/> is false: "upnext" or "history".</summary>
    [Parameter] public string? ActiveTab { get; set; }

    /// <summary>False leaves the "Playing from ..." footer out.</summary>
    [Parameter] public bool ShowFooter { get; set; } = true;

    private readonly string _idPrefix = $"queue-{Guid.NewGuid():N}";
    private readonly CancellationTokenSource _lifetime = new();
    private PlaybackListPanel? _list;
    private string _tab = UpNextTab;
    private string? _requestedTab;
    private bool _tabRequested;
    private Guid? _dragOccurrence;
    private ListenPlaybackSnapshot? _dragSnapshot, _historyConfirmation;
    private string? _announcement, _failure;
    private Task? _relativeTimeLoop;
    private IJSObjectReference? _dragModule;
    private bool _attaching, _disposed;
    private PendingFocus? _pendingFocus;
    private ElementReference? _dragRoot;

    private string Tab => ShowTabs ? _tab : ActiveTab == HistoryTab ? HistoryTab : UpNextTab;
    private ListenQueueItem? CurrentItem => Snapshot.CurrentIndex >= 0 && Snapshot.CurrentIndex < Snapshot.Queue.Count ? Snapshot.Queue[Snapshot.CurrentIndex] : null;
    private bool IsPlaybackActive => Snapshot.IsPlaying && !Snapshot.NeedsUserGestureToStart && string.IsNullOrWhiteSpace(Snapshot.CurrentError);
    private string ScrollKey => $"{CurrentItem?.AssetId}:{Snapshot.PlaybackRequestVersion}:{Tab}";
    private IReadOnlyList<ListenQueueItem> MusicHistory => Snapshot.History.Where(item => item.PlaybackExperience == PlaybackExperience.Music).ToArray();

    private List<UpcomingRow> UpcomingRows
    {
        get
        {
            var rows = new List<UpcomingRow>();
            for (var queueIndex = Math.Max(0, Snapshot.CurrentIndex + 1); queueIndex < Snapshot.Queue.Count; queueIndex++)
            {
                rows.Add(new UpcomingRow(Snapshot.Queue[queueIndex], queueIndex - Math.Max(0, Snapshot.CurrentIndex + 1)));
            }
            return rows;
        }
    }

    private IReadOnlyList<PlaybackListTabs.Tab> Tabs => [
        new(UpNextTab, L["QueuePanel_UpNextTab", Math.Max(0, Snapshot.Queue.Count - Math.Max(0, Snapshot.CurrentIndex + 1))].Value),
        new(HistoryTab, L["QueuePanel_HistoryTab"].Value)];

    protected override void OnInitialized() => _relativeTimeLoop = RefreshRelativeTimesAsync();

    // The tab the host asks for: the bar's History control opens the History tab, and a change of the request moves a panel that is already open.
    // After that the listener's own tab clicks win until the host asks for something else.
    protected override void OnParametersSet()
    {
        if (_tabRequested && ActiveTab == _requestedTab) return;
        _tabRequested = true;
        _requestedTab = ActiveTab;
        if (ActiveTab is not null) _tab = ActiveTab == HistoryTab ? HistoryTab : UpNextTab;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocus is { } pending)
        {
            if (DateTimeOffset.UtcNow > pending.Until) _pendingFocus = null;
            else if (Snapshot.QueueRevision != pending.QueueRevision)
            {
                _pendingFocus = null;
                await FocusAsync(pending.Row);
            }
        }
        if (_dragModule is not null || _attaching || _disposed || _list is null) return;
        _attaching = true;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-queue-drag.js");
            if (_disposed)
            {
                // The panel closed while the script was loading: nothing will ever detach from this copy, so release it here, once.
                await module.DisposeAsync();
                return;
            }
            _dragModule = module;
            _dragRoot = _list.Element;
            await module.InvokeVoidAsync("attach", _dragRoot);
        }
        catch (InvalidOperationException)
        {
            // Prerendering has no browser yet (dragging attaches once the panel is live, and Move up and Move down never need it), or the panel closed between
            // loading the script and attaching it (ObjectDisposedException); disposal already released the script.
        }
        catch (JSDisconnectedException)
        {
            // The circuit closed while the panel was drawing; there is nothing left to attach to.
        }
        finally
        {
            _attaching = false;
        }
    }

    private async Task RefreshRelativeTimesAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
            {
                if (Tab == HistoryTab) await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The panel closed; the minute clock stops with it.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _lifetime.Cancel();
        if (_relativeTimeLoop is not null) await _relativeTimeLoop;
        _lifetime.Dispose();
        var module = _dragModule;
        _dragModule = null;
        if (module is null) return;
        try
        {
            if (_dragRoot is { } root) await module.InvokeVoidAsync("detach", root);
            await module.DisposeAsync();
        }
        catch (InvalidOperationException)
        {
            // The browser side is already gone.
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone, so the browser has dropped the listeners with the page.
        }
    }

    private Task SelectTabAsync(string key)
    {
        _tab = key == HistoryTab ? HistoryTab : UpNextTab;
        return Task.CompletedTask;
    }

    // ---- Up next ----

    private RenderFragment UpNextList =>
        @<text>
            @if (CurrentItem is null)
            {
                <p class="qp__empty">@L["QueuePanel_Empty"]</p>
            }
            else
            {
                var upcoming = UpcomingRows;
                var snapshot = Snapshot;
                <div class="qp__label">@L["Common_NowPlaying"]</div>
                <PlaybackListRow Variant="now" Title="@CurrentItem.Title" Secondary="@CurrentItem.Subtitle" ArtUrl="@PlaybackArtworkUrl.ForItem(CurrentItem, "s")"
                                 Length="@CurrentItem.Duration" IsCurrent="true" AriaLabel="@($"{L["Common_NowPlaying"].Value}: {CurrentItem.Title}")">
                    <Trailing><PlaybackActivityMark IsPlaying="@IsPlaybackActive" Size="compact" /></Trailing>
                </PlaybackListRow>
                <div class="qp__heading">
                    <span data-queue-heading>@L["QueuePanel_UpNextHeading", upcoming.Count]</span>
                    <AppNativeButton Type="button" Class="qp__clear" Disabled="@(upcoming.Count == 0)" AriaLabel="@L["QueuePanel_ClearLabel"].Value" data-queue-clear
                                     OnClick="@(() => ClearUpcomingAsync(snapshot))">@L["Activity_Clear"]</AppNativeButton>
                </div>
                @if (upcoming.Count == 0)
                {
                    <p class="qp__empty">@L["QueuePanel_NothingNext"]</p>
                }
                else
                {
                    <Virtualize Items="@upcoming" ItemSize="RowHeightPx" OverscanCount="12" Context="row">
                        @UpcomingRowView(snapshot, row, upcoming.Count)
                    </Virtualize>
                }
            }
        </text>;

    private RenderFragment UpcomingRowView(ListenPlaybackSnapshot shown, UpcomingRow row, int count) =>
        @<div @key="row.Item.QueueEntryId" class="qp__drop" @ondragover:preventDefault="true" @ondrop="@(() => DropAsync(row.Index))">
            <PlaybackListRow Variant="queue" Title="@row.Item.Title" Secondary="@row.Item.Subtitle" ArtUrl="@PlaybackArtworkUrl.ForItem(row.Item, "s")" Length="@row.Item.Duration"
                             OnClick="@(() => PlayOccurrenceAsync(shown, row.Item.QueueEntryId))" AriaLabel="@L["QueuePanel_PlayLabel", row.Item.Title].Value">
                <Leading>
                    <AppNativeButton Type="button" Class="qp__handle" draggable="true" data-playback-queue-drag="@row.Item.QueueEntryId" AriaLabel="@L["QueuePanel_ReorderLabel", row.Item.Title].Value"
                                     Tooltip="@L["QueuePanel_DragHint"].Value"
                                     @ondragstart="@(() => BeginDrag(shown, row.Item.QueueEntryId))" @ondragend="@(() => _dragOccurrence = null)"
                                     @onkeydown="@(args => ReorderKeyAsync(args, shown, row.Item.QueueEntryId, row.Index))">
                        <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Drag" />
                    </AppNativeButton>
                </Leading>
                <Trailing>
                    <PlaybackRowMenu Title="@L["QueuePanel_RowMenu", row.Item.Title].Value" HeaderLine="@row.Item.Title" Items="@QueueMenu(row.Item, row.Index, count)"
                                     OnSelect="@(key => QueueActionAsync(shown, row, key))" />
                </Trailing>
            </PlaybackListRow>
        </div>;

    private IReadOnlyList<PlaybackRowMenuItem> QueueMenu(ListenQueueItem item, int index, int count)
    {
        var items = new List<PlaybackRowMenuItem>
        {
            new("play-next", L["QueuePanel_PlayNext"].Value, PlaybackUtilityGlyphKind.NextUp, Disabled: index == 0),
            new("move-up", L["QueuePanel_MoveUp"].Value, PlaybackUtilityGlyphKind.ChevronUp, Disabled: index == 0),
            new("move-down", L["QueuePanel_MoveDown"].Value, PlaybackUtilityGlyphKind.ChevronDown, Disabled: index == count - 1),
            new("remove", L["Common_Remove"].Value, PlaybackUtilityGlyphKind.Close),
        };
        if (ListenPlaybackIdentityRoutes.Album(item) is not null)
        {
            items.Add(new("go-album", L["QueuePanel_GoToAlbum"].Value, PlaybackUtilityGlyphKind.Disc, DividerBefore: true));
        }
        if (ListenPlaybackIdentityRoutes.Artist(item) is not null)
        {
            items.Add(new("go-artist", L["QueuePanel_GoToArtist"].Value, PlaybackUtilityGlyphKind.Person, DividerBefore: items.Count == 4));
        }
        return items;
    }

    private async Task QueueActionAsync(ListenPlaybackSnapshot shown, UpcomingRow row, string key)
    {
        switch (key)
        {
            case "play-next":
                var afterPlayNext = NeighbourOf(row);
                await MoveAsync(shown, row.Item.QueueEntryId, 0);
                await KeepFocusAsync(afterPlayNext, shown);
                break;
            case "move-up":
                await MoveAsync(shown, row.Item.QueueEntryId, row.Index - 1);
                break;
            case "move-down":
                await MoveAsync(shown, row.Item.QueueEntryId, row.Index + 1);
                break;
            case "remove":
                var afterRemove = NeighbourOf(row);
                await SendAsync(shown, new() { Action = ListenPlaybackCommandActions.RemoveUpcoming, QueueEntryId = row.Item.QueueEntryId });
                await KeepFocusAsync(afterRemove, shown);
                break;
            case "go-album":
                await GoToAsync(shown, row.Item, "album", row.Item.AlbumWorkId, ListenPlaybackIdentityRoutes.Album(row.Item));
                break;
            case "go-artist":
                await GoToAsync(shown, row.Item, "artist", row.Item.ArtistPersonId, ListenPlaybackIdentityRoutes.Artist(row.Item));
                break;
        }
    }

    // The row after the one acted on, else the one before it; null leaves the list itself to take focus.
    private Guid? NeighbourOf(UpcomingRow row)
    {
        var rows = UpcomingRows;
        return (row.Index + 1 < rows.Count ? rows[row.Index + 1] : row.Index > 0 ? rows[row.Index - 1] : null)?.Item.QueueEntryId;
    }

    // Remove and Play next take the acted-on row's "..." button away (or move it), which would drop keyboard focus to the page. Focus goes to the
    // neighbouring row's drag handle instead, now and again once the new queue has drawn.
    private async Task KeepFocusAsync(Guid? neighbour, ListenPlaybackSnapshot shown)
    {
        _pendingFocus = new PendingFocus(neighbour, shown.QueueRevision, DateTimeOffset.UtcNow.AddSeconds(2));
        await FocusAsync(neighbour);
    }

    private async Task FocusAsync(Guid? row)
    {
        if (_dragModule is null || _list is null) return;
        try
        {
            await _dragModule.InvokeVoidAsync("focusHandle", _list.Element, row?.ToString());
        }
        catch (InvalidOperationException)
        {
            // No browser to focus in (prerendering), or the panel closed while focus was moving (ObjectDisposedException).
        }
        catch (JSDisconnectedException)
        {
            // The circuit closed; there is nothing left to focus.
        }
    }

    // The pop-out window hands album and artist navigation to the main player window; everything else opens in this window and closes the panel.
    private async Task GoToAsync(ListenPlaybackSnapshot shown, ListenQueueItem item, string kind, Guid? id, string? route)
    {
        if (id is not Guid identity || route is null) return;
        if (Commands is IPlaybackIdentityNavigationSink navigation)
        {
            try
            {
                var reply = await navigation.NavigateIdentityAsync(shown, kind, identity);
                if (reply?.BooleanResult != true) ShowFailure(L["QueuePanel_NotConfirmed"].Value);
            }
            catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or OperationCanceledException)
            {
                ShowFailure(L["QueuePanel_Interrupted"].Value);
            }
            return;
        }
        Services.GetService<PlaybackTransientToolCoordinator>()?.Close();
        Nav.NavigateTo(route);
    }

    private Task PlayOccurrenceAsync(ListenPlaybackSnapshot shown, Guid id) => SendAsync(shown, new() { Action = ListenPlaybackCommandActions.PlayIndex, QueueEntryId = id });
    private Task ClearUpcomingAsync(ListenPlaybackSnapshot shown) => SendAsync(shown, new() { Action = ListenPlaybackCommandActions.ClearUpcoming });

    // ---- Reordering ----

    private void BeginDrag(ListenPlaybackSnapshot shown, Guid occurrence) { _dragSnapshot = shown; _dragOccurrence = occurrence; }
    private Task DropAsync(int index) => _dragOccurrence is Guid id && _dragSnapshot is { } shown ? MoveAsync(shown, id, index) : Task.CompletedTask;

    private Task ReorderKeyAsync(KeyboardEventArgs args, ListenPlaybackSnapshot shown, Guid id, int index) => args.AltKey && args.Key is "ArrowUp" or "ArrowDown"
        ? MoveAsync(shown, id, index + (args.Key == "ArrowUp" ? -1 : 1)) : Task.CompletedTask;

    private async Task MoveAsync(ListenPlaybackSnapshot shown, Guid id, int index)
    {
        _dragOccurrence = null;
        if (index < 0 || index >= shown.Queue.Count - shown.CurrentIndex - 1) return;
        try
        {
            var reply = await Commands.SendAsync(shown, new() { Action = ListenPlaybackCommandActions.ReorderUpcoming, QueueEntryId = id, Index = index, ExpectedQueueRevision = shown.QueueRevision });
            if (reply?.Outcome == AudiobookBookmarkOperationOutcomes.Success) { _failure = null; _announcement = L["QueuePanel_Moved", index + 1].Value; }
            else ShowFailure(reply?.Message ?? L["QueuePanel_MoveFailed"].Value);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or OperationCanceledException)
        {
            ShowFailure(L["QueuePanel_Interrupted"].Value);
        }
    }

    // ---- History ----

    private RenderFragment HistoryList =>
        @<text>
            @{ var history = MusicHistory; var snapshot = Snapshot; }
            <div class="qp__heading">
                <span data-queue-heading>@L["QueuePanel_HistoryHeading", history.Count]</span>
                <AppNativeButton Type="button" Class="qp__clear" Disabled="@(history.Count == 0)" AriaLabel="@L["QueuePanel_ClearHistory"].Value" data-history-clear
                                 OnClick="@(() => _historyConfirmation = snapshot)">@L["Activity_Clear"]</AppNativeButton>
            </div>
            @if (history.Count == 0)
            {
                <p class="qp__empty">@L["QueuePanel_HistoryEmpty"]</p>
            }
            @foreach (var item in history)
            {
                var played = item;
                <PlaybackListRow @key="played.QueueEntryId" Variant="history" Title="@played.Title" Secondary="@played.Subtitle" ArtUrl="@PlaybackArtworkUrl.ForItem(played, "s")" Length="@PlayedAt(played)"
                                 OnClick="@(() => PlayHistoryAsync(snapshot, played))" AriaLabel="@L["QueuePanel_PlayLabel", played.Title].Value">
                    <Trailing>
                        <PlaybackRowMenu Title="@L["QueuePanel_HistoryRowMenu", played.Title].Value" HeaderLine="@played.Title"
                                         Items="@HistoryMenu" OnSelect="@(_ => PlayHistoryAsync(snapshot, played))" />
                    </Trailing>
                </PlaybackListRow>
            }
        </text>;

    private IReadOnlyList<PlaybackRowMenuItem> HistoryMenu => [new("play", L["Common_Play"].Value, PlaybackUtilityGlyphKind.Play)];

    private Task PlayHistoryAsync(ListenPlaybackSnapshot shown, ListenQueueItem item) =>
        SendAsync(shown, new() { Action = ListenPlaybackCommandActions.PlayHistory, QueueEntryId = item.QueueEntryId, QueueItem = ToQueueItem(item) });

    private async Task ConfirmClearHistoryAsync()
    {
        var shown = _historyConfirmation;
        _historyConfirmation = null;
        if (shown is not null) await SendAsync(shown, new() { Action = ListenPlaybackCommandActions.ClearHistory });
    }

    // "Just now", "3 min ago", "2 hr ago", then the date.
    private string PlayedAt(ListenQueueItem item)
    {
        if (item.PlayedAt is not { } played) return L["QueuePanel_PlayedEarlier"].Value;
        var elapsed = DateTimeOffset.UtcNow - played;
        return elapsed.TotalMinutes < 1 ? L["QueuePanel_PlayedNow"].Value
            : elapsed.TotalHours < 1 ? L["QueuePanel_PlayedMinutes", Math.Max(1, (int)elapsed.TotalMinutes)].Value
            : elapsed.TotalDays < 1 ? L["QueuePanel_PlayedHours", (int)elapsed.TotalHours].Value
            : played.LocalDateTime.ToString("d", CultureInfo.CurrentCulture);
    }

    // ---- Sending ----

    private async Task SendAsync(ListenPlaybackSnapshot shown, ListenPlaybackCommandDto command)
    {
        try
        {
            var reply = await Commands.SendAsync(shown, command);
            if (reply?.Outcome == AudiobookBookmarkOperationOutcomes.Success) { _failure = null; _announcement = null; }
            else ShowFailure(reply?.Message ?? L["QueuePanel_NotConfirmed"].Value);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or OperationCanceledException)
        {
            ShowFailure(L["QueuePanel_Interrupted"].Value);
        }
    }

    // A failure is a notice that dismisses itself; a success only reaches screen readers (the row moving is the sighted confirmation).
    private void ShowFailure(string message)
    {
        _announcement = null;
        _failure = message;
        _ = DismissFailureLaterAsync(message);
    }

    private async Task DismissFailureLaterAsync(string message)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(6), _lifetime.Token);
            if (_failure == message) { _failure = null; await InvokeAsync(StateHasChanged); }
        }
        catch (OperationCanceledException)
        {
            // The panel closed before the notice timed out.
        }
        catch (ObjectDisposedException)
        {
            // The panel closed before the notice timed out.
        }
    }

    private static PlayerQueueItemDto ToQueueItem(ListenQueueItem item) => new()
    {
        WorkId = item.WorkId, AssetId = item.AssetId, CollectionId = item.CollectionId, MediaType = item.MediaType,
        Title = item.Title, Subtitle = item.Subtitle, Album = item.Album, Author = item.AuthorName, Artist = item.PlaybackExperience == PlaybackExperience.Music ? item.Subtitle : null, Narrator = item.NarratorName,
        Year = item.Year, ContentRating = item.ContentRating, SeasonNumber = item.SeasonNumber, EpisodeNumber = item.EpisodeNumber, Quality = item.Quality,
        CoverUrl = item.CoverUrl, DurationSeconds = PlaybackTimeParser.TryParseDurationSeconds(item.Duration),
        PositionSeconds = item.InitialPositionSeconds, StreamUrl = item.StreamUrl, Chapters = item.Chapters.ToList(), Manifest = item.Manifest,
    };
}
