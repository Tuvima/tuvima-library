@namespace MediaEngine.Web.Components.Listen
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Playback
@inject IStringLocalizer<SharedStrings> L

@if (Current is { } item)
{
    <div class="playback-desktop-owner">
    <AppCssElement Tag="section" Class="@($"playback-desktop {(IsBook ? "playback-desktop--book" : "playback-desktop--music")} {(Snapshot.IsPlaying ? null : "playback-desktop--paused")}")"
                   Css="@Atmosphere" aria-label="@L["PlaybackDesktopScene_NowPlaying"].Value" tabindex="-1">
        <AppNativeButton Type="button" Class="playback-desktop__collapse" AriaLabel="@L["PlaybackDesktopScene_CollapseNowPlaying"].Value" OnClick="OnCollapse"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronLeft" /></AppNativeButton>
        <div class="playback-desktop__stage">
            <div class="playback-desktop__left">
                <div class="playback-desktop__stack">
                <div class="playback-desktop__art">
                    @* The picture is never an empty hole (unified player D7a): a tile with the media icon stands in until the image has loaded,
                       and a failed load is tried once more a moment later. *@
                    @if (!_artLoaded)
                    {
                        <span class="playback-desktop__art-placeholder" aria-hidden="true"><AppMaterialIcon Icon="@(IsBook ? AppMaterialIcons.Outlined.MenuBook : AppMaterialIcons.Outlined.MusicNote)" /></span>
                    }
                    @if (PlaybackArtworkUrl.ForItem(item) is { } artworkUrl)
                    {
                        @* Drawn up to 520px (medium copy) *@
                        <img @key="@($"{item.WorkId}:{_artAttempt}")" src="@PlaybackArtworkUrl.ForItemRetry(item, _artAttempt)" @onload="HandleArtLoaded" @onerror="HandleArtErrorAsync"
                             data-image-display="desktop-now-playing-artwork" alt="" decoding="async" />
                    }
                </div>
                <PlaybackQualityBadge Item="@item" BrowserStreamUrl="@Snapshot.CurrentBrowserStreamUrl" />
                <div class="playback-desktop__identity">
                    <div class="playback-desktop__title">
                        <h1>@item.Title</h1>
                    </div>
                    @if (IsBook)
                    {
                        <p class="playback-desktop__byline">By @if (item.Authors.Count > 0)
                            { @for (var index = 0; index < item.Authors.Count; index++) { var author = item.Authors[index]; @if (index > 0) { <text>; </text> } @if (ListenPlaybackIdentityRoutes.Contributor(author) is { } route) { <PlaybackIdentityLink Snapshot="Snapshot" Commands="Commands" Kind="person" Id="author.PersonId" Text="@author.Name" /> } else { @author.Name } } }
                            else { @(item.AuthorName ?? item.Subtitle) }</p>
                        @if (item.Narrators.Count > 0 || !string.IsNullOrWhiteSpace(item.NarratorName))
                        { <p class="playback-desktop__secondary">Narrated by @if (item.Narrators.Count > 0)
                            { @for (var index = 0; index < item.Narrators.Count; index++) { var narrator = item.Narrators[index]; @if (index > 0) { <text>; </text> } @if (ListenPlaybackIdentityRoutes.Contributor(narrator) is { } route) { <PlaybackIdentityLink Snapshot="Snapshot" Commands="Commands" Kind="person" Id="narrator.PersonId" Text="@narrator.Name" /> } else { @narrator.Name } } }
                            else { @item.NarratorName }</p> }
                        @if (ChapterNow is { } chapterNow) { <p class="playback-desktop__progress playback-desktop__chapter">@chapterNow.Label@if (!string.IsNullOrWhiteSpace(chapterNow.Title)) { <text> · @chapterNow.Title</text> }</p> }
                        @if (!string.IsNullOrWhiteSpace(OverallProgress)) { <p class="playback-desktop__progress">@OverallProgress</p> }
                        @if (ListenPlaybackIdentityRoutes.Audiobook(item) is { } bookRoute) { <PlaybackIdentityLink Snapshot="Snapshot" Commands="Commands" Kind="audiobook" Id="@(item.AudiobookWorkId ?? item.WorkId)" Text="@L["PlaybackDesktopScene_OpenAudiobook"].Value" /> }
                    }
                    else
                    {
                        <p class="playback-desktop__byline">@if (MusicArtistRoute(item) is { } artistRoute) { <PlaybackIdentityLink Snapshot="Snapshot" Commands="Commands" Kind="artist" Id="item.ArtistPersonId" Text="@item.Subtitle" /> } else { @item.Subtitle }</p>
                        <p class="playback-desktop__secondary">@if (ListenPlaybackIdentityRoutes.Album(item) is { } albumRoute) { <PlaybackIdentityLink Snapshot="Snapshot" Commands="Commands" Kind="album" Id="item.AlbumWorkId" Text="@item.Album" /> } else { @item.Album }</p>
                    }
                    <div class="playback-desktop__actions">
                        @if (!IsBook)
                        { <PlaybackSongActions Item="@item" Snapshot="Snapshot" Commands="Commands" IsFavorite="IsFavorite"
                            FavoriteChanged="FavoriteChanged" Surface="expanded" NavigationCompleted="@(_ => OnCollapse.InvokeAsync())" /> }
                        @if (IsBook) { @ActionsContent }
                    </div>
                    @if (ListenPlaybackIdentityRoutes.Playlist(item) is { } playlist && !string.IsNullOrWhiteSpace(Snapshot.SourceLabel))
                    { <p class="playback-desktop__source">@L["PlaybackDesktopScene_PlayingFrom"] <PlaybackIdentityLink Snapshot="Snapshot" Commands="Commands" Kind="playlist" Id="item.PlaylistId" Text="@Snapshot.SourceLabel" /></p> }
                </div>
                </div>
            </div>
            <section class="playback-desktop__panel" aria-label="@L["PlaybackDesktopScene_PlaybackTools"].Value">
                <div class="playback-desktop__tabs" role="tablist" aria-label="@L["PlaybackDesktopScene_NowPlayingPanels"].Value">
                    @foreach (var tab in Tabs)
                    {
                        @if (tab.Key == "lyrics")
                        { <AppTooltip Text="@L["Common_Lyrics"].Value"><AppNativeButton Type="button" role="tab" AriaLabel="@L["Common_Lyrics"].Value" aria-selected="@(PanelKey == tab.Key ? "true" : "false")" OnClick="@(() => PanelChanged.InvokeAsync(tab.Key))"><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Lyrics" /></AppNativeButton></AppTooltip> }
                        else
                        { <AppNativeButton Type="button" role="tab" aria-selected="@(PanelKey == tab.Key ? "true" : "false")" OnClick="@(() => PanelChanged.InvokeAsync(tab.Key))">@tab.Title</AppNativeButton> }
                    }
                </div>
                <PlaybackPanelCard Snapshot="@Snapshot" Commands="@Commands" PanelKey="@PanelKey" ShowTabs="false" ShowQueueSource="false" />
            </section>
        </div>
    </AppCssElement>
    </div>
}

@code {
    [Parameter, EditorRequired] public ListenPlaybackSnapshot Snapshot { get; set; } = new();
    [Parameter, EditorRequired] public IPlaybackCommandSink Commands { get; set; } = null!;
    [Parameter] public string PanelKey { get; set; } = "lyrics";
    [Parameter] public EventCallback<string> PanelChanged { get; set; }
    [Parameter] public bool IsFavorite { get; set; }
    [Parameter] public EventCallback FavoriteChanged { get; set; }
    [Parameter] public EventCallback OnCollapse { get; set; }
    [Parameter] public RenderFragment? ActionsContent { get; set; }
    [Parameter] public string? OverallProgress { get; set; }
    private Guid _artItemKey;
    private bool _artLoaded;
    private int _artAttempt;

    protected override void OnParametersSet()
    {
        var key = Current?.WorkId ?? Guid.Empty;
        if (key == _artItemKey) return;
        _artItemKey = key;
        _artLoaded = false;
        _artAttempt = 0;
    }


    private void HandleArtLoaded() => _artLoaded = true;

    private async Task HandleArtErrorAsync()
    {
        if (_artAttempt >= 2) return;
        var key = _artItemKey;
        await Task.Delay(TimeSpan.FromMilliseconds(1200));
        if (key != _artItemKey) return;
        _artAttempt++;
        await InvokeAsync(StateHasChanged);
    }

    private ListenQueueItem? Current => Snapshot.CurrentIndex >= 0 && Snapshot.CurrentIndex < Snapshot.Queue.Count ? Snapshot.Queue[Snapshot.CurrentIndex] : null;
    // Unified player D7: the details line for an audiobook names the chapter, "Chapter 4 of 21 · chapter title".
    private AudiobookChapterWindow? ChapterNow => IsBook && Current is { } now
        ? AudiobookChapterWindow.Find(now.Chapters, Snapshot.CurrentTimeSeconds, Snapshot.DurationSeconds)
        : null;
    private bool IsBook => Current?.PlaybackExperience == PlaybackExperience.Audiobook;
    private IReadOnlyList<(string Key, string Title)> Tabs => IsBook
        ? Current?.Chapters.Count > 1 ? [("chapters", "Chapters"), ("history", "History")] : [("history", "History")]
        : [("lyrics", "Lyrics"), ("queue", "Up Next"), ("history", "History")];
    private static string? MusicArtistRoute(ListenQueueItem item) => ListenPlaybackIdentityRoutes.Artist(item)
        ?? (!string.IsNullOrWhiteSpace(item.Subtitle) ? $"/search?q={Uri.EscapeDataString(item.Subtitle)}&media=Music" : null);
    private string Atmosphere => PlaybackArtworkUrl.ForItem(Current) is { } cover
        ? $"--playback-desktop-cover:url('{cover.Replace("'", "%27", StringComparison.Ordinal)}');" : string.Empty;
}
