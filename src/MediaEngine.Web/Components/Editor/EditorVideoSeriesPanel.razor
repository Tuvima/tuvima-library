@namespace MediaEngine.Web.Components.Editor
@using MediaEngine.Contracts.Editing
@using MediaEngine.Contracts.Items
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient Api
@inject ILogger<EditorVideoSeriesPanel> Logger
@inject IStringLocalizer<SharedStrings> L

@* "Move this video to another series" (universal editor v6, D17 and D24; it started as the Match tool's series choice in v3.1). A folder of videos
   is already a series, so this is for the exceptions: a video on its own, or one that belongs with a different series. A choice only stages a
   change: Save changes shows it in Review first. In a Managed folder the file follows its series, so the choice also stages the file move the
   editor's footer and Review already show for a match; in a Read-only folder nothing on disk changes and the line under the choice says so. Cancel
   (and Escape while this panel holds a change made on this visit) puts back what was staged when the panel opened and keeps the editor open. *@
@if (Subject is not null && IsVideo)
{
    @if (ShowSeriesChooser && _series is { Supported: true })
    {
        @* While this visit holds a change, Escape belongs to this panel (it cancels the change) and does not close the editor window. *@
        <section class="tl-vseries" data-testid="video-series" data-app-escape-owner="@(HasVisitChanges ? "field" : null)" @onkeydown="OnKeyDown">
            <h3 class="tl-vseries__heading">
                @L["EditorVideoSeries_Heading"]
                @if (_series is { InSeries: false } && ChoiceValue == None)
                {
                    @* The same amber "not matched" mark the tree gives a video that is in no series (universal editor v3.1, D8). *@
                    <span class="tl-vseries__tag" data-testid="video-not-matched">@L["EditorVideoSeries_NotMatched"]</span>
                }
            </h3>
            <p class="tl-vseries__intro" data-testid="video-series-intro">@L["EditorVideoSeries_Intro"]</p>
            <AppSelect T="string"
                       Label="@L["EditorVideoSeries_ChooseSeries"].Value"
                       Value="@ChoiceValue"
                       ValueChanged="OnChoiceChangedAsync"
                       Options="@ChoiceOptions"
                       Disabled="@(!CanChange)"
                       AriaLabel="@L["EditorVideoSeries_ChooseSeries"].Value" />
            @if (_naming)
            {
                <div class="tl-vseries__new">
                    <AppTextField Label="@L["EditorVideoSeries_NewSeriesName"].Value" Value="@_newName" ValueChanged="@(value => _newName = value ?? string.Empty)"
                                  Immediate="true" MaxLength="@EditSessionVideo.MaxSeriesNameLength" />
                    <AppButton Label="@L["EditorVideoSeries_Add"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Size="AppControlSize.Compact"
                               Disabled="@string.IsNullOrWhiteSpace(_newName)" OnClick="StageNewSeriesAsync" />
                </div>
            }

            @if (SeriesSentence is { } sentence)
            {
                <p class="tl-vseries__happen" data-testid="video-series-happen">@sentence</p>
            }

            @if (FileLine is { } file)
            {
                <p class="@(file.Problem ? "tl-vseries__file tl-vseries__file--problem" : "tl-vseries__file")" data-testid="video-series-file">@file.Text</p>
            }

            @if (CanChange && HasVisitChanges)
            {
                <div class="tl-vseries__actions">
                    <AppButton Label="@L["Search_Cancel"].Value" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact"
                               OnClick="CancelAsync" data-testid="video-series-cancel" />
                </div>
            }
        </section>
    }

    @if (ShowOrder)
    {
        <EditorVideoOrderList EntityId="Subject.EntityId" SeriesTitle="@_series?.SeriesTitle" Session="Session" Family="Family" CanEdit="CanEdit" />
    }
}

@code {
    private sealed record Staged(string? TargetId, string? Token, string? Label, string? Before, string? MoveFrom, string? MoveTo);

    private VideoSeriesStateResponse? _series;
    private Guid _loadedFor;
    private bool _naming;
    private string _newName = string.Empty;

    // What the Engine said about the file for the choice made on this visit (its reason, when the file will stay or cannot move).
    private EditorVideoSeriesPlacementDto? _placement;

    // What was staged for this video when the panel opened, so Cancel can put it back.
    private Staged? _entry;

    /// <summary>The item being edited; null until its fields have loaded.</summary>
    [Parameter] public EditorMatchSubject? Subject { get; set; }

    [Parameter] public EditSessionState? Session { get; set; }

    /// <summary>The editor's family tree, so it can show the order as it is being arranged.</summary>
    [Parameter] public EditorFamilyState? Family { get; set; }

    [Parameter] public bool CanEdit { get; set; }

    /// <summary>Shows the series chooser. The browser's order view turns it off and shows only the order.</summary>
    [Parameter] public bool ShowSeriesChooser { get; set; } = true;

    /// <summary>Shows the order list (the browser). Match keeps it until its own packet narrows the panel to the series chooser.</summary>
    [Parameter] public bool ShowOrder { get; set; } = true;

    private PendingEditList? Pending => Session?.Pending;

    private bool CanChange => CanEdit && Session is { IsActive: true };

    private bool IsVideo => Subject is not null && string.Equals(Subject.MediaType, "Videos", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        if (!IsVideo || Subject is null)
        {
            _series = null;
            _loadedFor = Guid.Empty;
            return;
        }

        if (_loadedFor == Subject.EntityId)
        {
            return;
        }

        var id = Subject.EntityId;
        _loadedFor = id;
        _naming = false;
        _newName = string.Empty;
        _placement = null;
        _entry = Capture(id);
        try
        {
            var series = await Api.GetVideoSeriesAsync(id);
            if (_loadedFor != id)
            {
                return;
            }

            _series = series;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "The series of video {EntityId} could not be read for the editor", id);
            _series = null;
            // Forget that this item was loaded, so the next time the panel is shown it reads again instead of staying blank.
            _loadedFor = Guid.Empty;
        }
    }

    // ----- Series chooser -----

    private const string Current = "current";
    private const string None = "none";
    private const string Start = "new";

    private string ChoiceValue
    {
        get
        {
            var staged = Subject is null ? null : Pending?.FindVideoSeries(Subject.EntityId);
            if (staged is null)
            {
                return _series is { InSeries: true } ? Current : None;
            }

            if (EditSessionVideo.IsNoSeries(staged.Token))
            {
                return None;
            }

            return EditSessionVideo.TryParseNewSeries(staged.Token, out _) ? Start : staged.TargetId ?? None;
        }
    }

    private string FromFolderSuffix => $" · {L["EditorVideoSeries_FromFolder"].Value}";

    // The series it is in now (marked when the folder put it there), the other series, a new one, and on its own.
    private IReadOnlyList<AppSelectOption> ChoiceOptions
    {
        get
        {
            var options = new List<AppSelectOption>();
            var inSeries = _series is { InSeries: true };
            if (inSeries)
            {
                var title = _series!.SeriesTitle ?? L["EditorVideoSeries_Series"].Value;
                options.Add(new AppSelectOption(Current, _series.FromFolder ? title + FromFolderSuffix : title));
            }

            foreach (var target in _series?.Targets ?? [])
            {
                options.Add(new AppSelectOption(target.Id.ToString(), $"{target.Title} · {CountText(target.VideoCount)}"));
            }

            options.Add(new AppSelectOption(Start, L["EditorVideoSeries_StartANewSeries"].Value));
            var onItsOwn = L["EditorVideoSeries_OnItsOwn"].Value;
            options.Add(new AppSelectOption(None, inSeries ? onItsOwn : onItsOwn + FromFolderSuffix));
            return options;
        }
    }

    private string CountText(int count) => count == 1 ? L["EditorVideoSeries_VideoOne"].Value : L["EditorVideoSeries_VideoMany", count].Value;

    private async Task OnChoiceChangedAsync(string? value)
    {
        if (!CanChange || Subject is null || Pending is not { } pending)
        {
            return;
        }

        EditorVideoSeriesStaging.Unstage(pending, Subject.EntityId);
        _naming = false;
        _placement = null;
        switch (value)
        {
            case Start:
                _naming = true;
                break;
            case None when _series is { InSeries: true }:
                pending.SetTarget(EditSessionChangeKinds.VideoSeries, Subject.EntityId, null, EditSessionVideo.NoSeriesToken, null, null, _series.SeriesTitle);
                await RefreshPlacementAsync(null, EditSessionVideo.NoSeriesToken);
                break;
            case Current or None or null:
                break;
            default:
                if (Guid.TryParse(value, out var target))
                {
                    var place = _series?.Targets.FirstOrDefault(candidate => candidate.Id == target);
                    pending.SetTarget(EditSessionChangeKinds.VideoSeries, Subject.EntityId, target.ToString(), null, place?.Title, null, _series?.SeriesTitle ?? EditReviewRows.NotInASeries);
                    await RefreshPlacementAsync(target.ToString(), null);
                }

                break;
        }
    }

    private async Task StageNewSeriesAsync()
    {
        if (!CanChange || Subject is null || Pending is not { } pending || string.IsNullOrWhiteSpace(_newName))
        {
            return;
        }

        EditorVideoSeriesStaging.Unstage(pending, Subject.EntityId);
        var token = EditSessionVideo.NewSeriesToken(_newName);
        pending.SetTarget(EditSessionChangeKinds.VideoSeries, Subject.EntityId, null, token, _newName.Trim(), null, _series?.SeriesTitle ?? EditReviewRows.NotInASeries);
        _naming = false;
        await RefreshPlacementAsync(null, token);
    }

    // Asks the Engine where the file would go for the choice just made, and stages the file move beside it when the file will move. The Engine
    // asks again at Save, so an answer that has gone stale cannot move a file anywhere unexpected.
    private async Task RefreshPlacementAsync(string? targetId, string? token)
    {
        if (Subject is null || Pending is not { } pending)
        {
            return;
        }

        var id = Subject.EntityId;
        EditorVideoSeriesPlacementDto? placement = null;
        try
        {
            placement = await Api.GetVideoSeriesPlacementAsync(id, targetId, token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Where the file of video {EntityId} goes with its series could not be read for the editor", id);
        }

        // Another choice may have been made while the Engine was answering.
        var staged = pending.FindVideoSeries(id);
        if (staged is null || staged.TargetId != targetId || staged.Token != token)
        {
            return;
        }

        _placement = placement;
        EditorVideoSeriesStaging.StageMove(pending, id, placement);
    }

    // ----- Cancel -----

    private Staged? Capture(Guid id)
    {
        if (Pending?.FindVideoSeries(id) is not { } series)
        {
            return null;
        }

        var move = MoveOf(id);
        return new Staged(
            series.TargetId, series.Token, Pending.Label(series.Id), Pending.Before(series.Id),
            move is null ? null : Pending.Before(move.Id), move is null ? null : Pending.Label(move.Id));
    }

    private EditSessionChange? MoveOf(Guid id) =>
        Pending?.Changes.FirstOrDefault(change =>
            change.Kind == EditSessionChangeKinds.FileMove && change.EntityId == id
            && string.Equals(change.Token, EditSessionVideo.MovesWithSeriesToken, StringComparison.Ordinal));

    // True when this visit changed the choice (or is part-way through naming a new series), so there is something to cancel.
    private bool HasVisitChanges
    {
        get
        {
            if (Subject is null)
            {
                return false;
            }

            var now = Pending?.FindVideoSeries(Subject.EntityId);
            if (_naming)
            {
                return true;
            }

            if (now is null || _entry is null)
            {
                return now is not null || _entry is not null;
            }

            return now.TargetId != _entry.TargetId || now.Token != _entry.Token;
        }
    }

    // Cancel and Escape: back to what was staged when the panel opened, with nothing of this visit left staged. The editor stays open.
    private Task CancelAsync()
    {
        if (Subject is null || Pending is not { } pending)
        {
            return Task.CompletedTask;
        }

        var id = Subject.EntityId;
        EditorVideoSeriesStaging.Unstage(pending, id);
        if (_entry is { } entry)
        {
            pending.SetTarget(EditSessionChangeKinds.VideoSeries, id, entry.TargetId, entry.Token, entry.Label, null, entry.Before);
            if (!string.IsNullOrWhiteSpace(entry.MoveFrom) && !string.IsNullOrWhiteSpace(entry.MoveTo))
            {
                pending.SetTarget(EditSessionChangeKinds.FileMove, id, null, EditSessionVideo.MovesWithSeriesToken, entry.MoveTo, null, entry.MoveFrom);
            }
        }

        _naming = false;
        _newName = string.Empty;
        _placement = null;
        return Task.CompletedTask;
    }

    private Task OnKeyDown(KeyboardEventArgs args) =>
        args.Key == "Escape" && CanChange && HasVisitChanges ? CancelAsync() : Task.CompletedTask;

    // ----- What the choice does -----

    private string? SeriesSentence
    {
        get
        {
            if (Subject is null || Pending?.FindVideoSeries(Subject.EntityId) is not { } staged)
            {
                return null;
            }

            var title = Subject.Title;
            if (EditSessionVideo.IsNoSeries(staged.Token))
            {
                return L["EditorVideoSeries_LeavesSentence", title].Value;
            }

            if (EditSessionVideo.TryParseNewSeries(staged.Token, out var started))
            {
                return L["EditorVideoSeries_StartsSentence", started, title].Value;
            }

            var name = _series?.Targets.FirstOrDefault(candidate => candidate.Id.ToString() == staged.TargetId)?.Title ?? Pending.Label(staged.Id) ?? L["EditorVideoSeries_ChosenSeries"].Value;
            return L["EditorVideoSeries_JoinsSentence", title, name].Value;
        }
    }

    private sealed record FileText(string Text, bool Problem);

    // The second line under the choice: where the file goes in a Managed folder (the footer and Review carry the full from and to), or that it
    // stays where it is. A name taken at the destination is a problem the person is told about now; Save changes stops on it too.
    private FileText? FileLine
    {
        get
        {
            if (Subject is null || Pending?.FindVideoSeries(Subject.EntityId) is not { } staged)
            {
                return null;
            }

            var move = MoveOf(Subject.EntityId);
            if (move is not null)
            {
                if (_placement?.Reason is { Length: > 0 } clash)
                {
                    return new FileText(clash, true);
                }

                var folder = FolderName(Pending.Label(move.Id));
                return EditSessionVideo.TryParseNewSeries(staged.Token, out _)
                    ? new FileText(L["EditorVideoSeries_NewFolderLine", folder].Value, false)
                    : new FileText(L["EditorVideoSeries_MovesToLine", folder].Value, false);
            }

            var setByYou = L["EditorSupportingFile_ScopeSetByYouReadOnly"].Value;
            return _placement?.Reason is { Length: > 0 } reason
                ? new FileText($"{L["EditorSupportingFile_ScopeSetByYou"].Value} {reason}", false)
                : new FileText(setByYou, false);
        }
    }

    // The folder a path ends up in, named by its last part ("Videos/Course/a.mp4" is "Course"), whichever way the Engine's machine writes paths.
    private static string FolderName(string? path)
    {
        var parts = (path ?? string.Empty).Split(['/', '\\'], StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? parts[^2] : parts.Length == 1 ? parts[0] : string.Empty;
    }
}
