@namespace MediaEngine.Web.Components.Editor
@using System.Globalization
@using System.Net.Http
@using MediaEngine.Contracts.Editing
@using MediaEngine.Contracts.Matching
@using MediaEngine.Contracts.Metadata
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@implements IDisposable
@inject IEngineApiClient Api
@inject ILogger<EditorTvMatchFlow> Logger
@inject IStringLocalizer<SharedStrings> L

@* The Match tab's TV flow (universal editor v5, 3c; v6 WP6, mock screen C). The same shapes as every other Match step: the shared search row (the
   provider the tab hands in as RowStart, Show, Year and a labeled Search, with the count of shows on its message line), the "Your file" bar, a list
   of rows on the left and the card on the right. Finding the show comes first; once a show is chosen the row becomes the chosen show (read-only,
   with Change show) and, for an episode, the left column holds the Season dropdown (Specials is season 0) over the text list of that season's
   episodes with the one the file name names already chosen ("Suggested from filename: S02E03"; a file with no number falls back to the nearest
   runtime, then air order; an anime's absolute number is shown as the provider's season and episode). A show page needs only the show. A search never
   runs on opening for an item that is not matched yet: the boxes are filled and the person presses Search. The pick is judged by the Engine and the
   card shows its verdict in words and its compare table; Apply match is always available. Choosing only hands the pick up; staging, the move and the
   show re-match belong to the Match tab. On a phone (section 4a) each step is one screen: the shows (search row and list), then the season and its
   episodes under the chosen show (Change show goes back), with the card of a tapped show or episode as a full-height sheet whose Back returns to the
   list with the tick kept. A show page needs only the shows screen: tapping a show opens its sheet. *@
<div class="tl-tvflow" data-testid="tv-flow" data-scope="@(NeedsEpisode ? "episode" : "show")">
    @if (ShowsStep)
    {
        <EditorMatchSearchRow Columns="@RowColumns" Message="@RowMessage" SearchDisabled="@(_showsLoading || string.IsNullOrWhiteSpace(_showText))" OnSearch="SearchAsync"
                              ButtonTestId="tv-flow-search">
            @RowStart
            <AppTextField Label="@L["EditorTvMatchFlow_Show"].Value" Value="@_showText" ValueChanged="@(value => _showText = value ?? string.Empty)" Immediate="true"
                          OnKeyDown="OnSearchKey" aria-label="@L["EditorTvMatchFlow_Show"].Value" data-testid="tv-flow-show" />
            <AppTextField Label="@L["EditorTvMatchFlow_Year"].Value" Value="@_yearText" ValueChanged="@(value => _yearText = value ?? string.Empty)" Immediate="true"
                          OnKeyDown="OnSearchKey" Placeholder="@L["EditorMatchPanel_Optional"].Value" aria-label="@L["EditorTvMatchFlow_Year"].Value" data-testid="tv-flow-year" />
        </EditorMatchSearchRow>
    }
    else
    {
        @* The chosen show, read-only, with Change show on the control line beside it (mock C). *@
        <AppFormRow Columns="minmax(0, 1fr) auto" Wrap="@(!IsPhone)" Stack="@IsPhone" ReserveMessage="@(!IsPhone)" data-testid="tv-flow-card">
            <ChildContent>
                <AppTextField Label="@L["EditorTvMatchFlow_Show"].Value" Value="@ChosenShowText()" ReadOnly="true" aria-label="@L["EditorTvMatchFlow_Show"].Value" data-testid="tv-flow-chosen-show" />
                <div data-form-row-field="fit">
                    @if (!IsPhone)
                    {
                        <span class="app-field__label" aria-hidden="true">&nbsp;</span>
                    }
                    <AppButton Label="@L["EditorTvMatchFlow_ChangeShow"].Value" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral"
                               FullWidth="@IsPhone" OnClick="ChangeShow" data-testid="tv-flow-change-show" />
                </div>
            </ChildContent>
        </AppFormRow>
    }

    @Lead

    @if (ShowsStep)
    {
        @if (_showsLoading)
        {
            <EditorMatchLookingUp />
        }
        else if (_showsProblem is not null)
        {
            <AppAlert Severity="AppSeverity.Info" Dense="true" data-testid="tv-flow-problem">@_showsProblem</AppAlert>
        }
        else if (_searched)
        {
            <EditorMatchList Heading="@L["EditorTvMatchFlow_Shows"].Value" Count="@CountText(_shows.Count)" TestId="tv-flow-shows">
                @foreach (var show in _shows)
                {
                    var current = show;
                    <EditorMatchListRow Title="@show.Name" Meta="@ShowMeta(show)" ArtShape="portrait" ImageUrl="@show.ImageUrl" data-testid="tv-flow-show-row"
                                        Selected="@(IsPhone && !NeedsEpisode && _show?.SeriesId == show.SeriesId)"
                                        OnClick="@(() => ChooseShowAsync(current, openSheet: IsPhone && !NeedsEpisode))" />
                }
            </EditorMatchList>
        }

        @if (IsPhone && !NeedsEpisode && _sheet && _candidate is not null)
        {
            <EditorMatchSheet Title="@L["EditorMatchResults_SelectedResult"].Value" OnBack="CloseSheet">@CardPart()</EditorMatchSheet>
        }

        @if (ShowCancel)
        {
            @CancelOnly()
        }
    }
    else if (NeedsEpisode)
    {
        <EditorMatchSplit TestId="tv-flow-split" ShowCard="@(_candidate is not null)" SheetOpen="_sheet" OnSheetClose="CloseSheet">
            <List>@EpisodePart()</List>
            <Card>@CardPart()</Card>
        </EditorMatchSplit>

        @if (_candidate is null && ShowCancel)
        {
            @CancelOnly()
        }
    }
    else if (_candidate is not null)
    {
        @CardPart()
    }
    else if (ShowCancel)
    {
        @CancelOnly()
    }
</div>

@code {
    private CancellationTokenSource? _cts;
    private Guid _startedFor;
    private string _showText = string.Empty;
    private string _yearText = string.Empty;
    private bool _showsLoading;
    private bool _searched;
    private string? _showsProblem;
    private IReadOnlyList<TvMatchBrowserShowDto> _shows = [];
    private TvMatchBrowserShowDto? _show;
    private TvMatchBrowserSeasonsDto? _seasons;
    private int? _seasonNumber;
    private bool _episodesLoading;
    private string? _episodesProblem;
    private IReadOnlyList<TvMatchBrowserEpisodeDto> _episodes = [];
    private TvMatchBrowserEpisodeDto? _picked;
    private EditorEpisodeSuggestion? _suggestion;
    private ItemCanonicalRetailCandidateDto? _candidate;
    private EditorMatchResultDto? _judged;
    private bool _judging;

    // On a phone: the card of the tapped show or episode is open as a sheet.
    private bool _sheet;

    /// <summary>What the Match tab puts first in the row: the provider dropdown.</summary>
    [Parameter] public RenderFragment? RowStart { get; set; }

    /// <summary>What the Match tab shows under the row: a staged note and the "Your file" bar.</summary>
    [Parameter] public RenderFragment? Lead { get; set; }

    /// <summary>The providers the Engine offered for this item, so the card can name the one a record came from.</summary>
    [Parameter] public IReadOnlyList<EditorMatchProviderDto> Providers { get; set; } = [];

    /// <summary>The item being matched; the search starts from its show's name.</summary>
    [Parameter, EditorRequired] public EditorMatchSubject? Subject { get; set; }

    /// <summary>True when the item is not matched: the boxes start from the file name and the Engine's best guess is tagged.</summary>
    [Parameter] public bool Unmatched { get; set; }

    /// <summary>What the Engine read from the item's file name, and its best guess; null when not read.</summary>
    [Parameter] public EditorMatchContextDto? Context { get; set; }

    /// <summary>The length measured from the file, for choosing an episode when the file name has no number.</summary>
    [Parameter] public EditorMatchLocalEvidenceDto? Evidence { get; set; }

    /// <summary>True when the person may stage a match (they may edit and an edit session is open).</summary>
    [Parameter] public bool CanApply { get; set; }

    /// <summary>Shown as Cancel when there is a current match to go back to.</summary>
    [Parameter] public bool ShowCancel { get; set; }

    /// <summary>Raised by Apply match with the picked record, as a search result would be.</summary>
    [Parameter] public EventCallback<ItemCanonicalRetailCandidateDto> OnApplyMatch { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    [CascadingParameter] public EditorWindowLayout? Layout { get; set; }

    private bool IsPhone => EditorWindowLayout.IsPhone(false, Layout);

    // The first screen: finding the show. A show page on a phone stays on it (the chosen show is ticked in the list and its card is a sheet).
    private bool ShowsStep => _show is null || (IsPhone && !NeedsEpisode);

    private void CloseSheet() => _sheet = false;

    private bool NeedsEpisode => Subject is not null && EditorTvMatchCandidates.NeedsEpisode(Subject.ScopeId);

    private string KindId => NeedsEpisode ? MediaEngine.Domain.Configuration.EditorKinds.TvEpisode : MediaEngine.Domain.Configuration.EditorKinds.TvShow;

    // The row's columns when it is wide enough for one line: the provider (when the tab hands one in), the show widest, the year narrow, the button as wide as its word.
    private string RowColumns => (RowStart is null ? string.Empty : "220px ") + "minmax(12rem, 1.6fr) minmax(7rem, .5fr) auto";

    // After a search the row's message line says how many shows came back and from whom; a search that found nothing says so in the list area.
    private string? RowMessage
    {
        get
        {
            if (!_searched || _showsProblem is not null || _shows.Count == 0)
            {
                return null;
            }

            var from = ProviderDisplay(EditorMatchCandidates.TvdbName);
            return _shows.Count == 1 ? L["EditorMatchPanel_ResultOneFrom", from].Value : L["EditorMatchPanel_ResultsFrom", _shows.Count, from].Value;
        }
    }

    // The provider a name stands for, as the Engine offered it ("TheTVDB"). The TV search reads TheTVDB only, so the count and the chosen show name that provider,
    // never the one the dropdown happens to show.
    private string ProviderDisplay(string name) =>
        Providers.FirstOrDefault(provider => string.Equals(provider.Name, name, StringComparison.OrdinalIgnoreCase))?.DisplayName ?? name;

    private string CountText(int count) => count == 1 ? L["EditorMatchResults_CountOne"].Value : L["EditorMatchResults_Count", count].Value;

    protected override async Task OnParametersSetAsync()
    {
        if (Subject is null || _startedFor == Subject.EntityId)
        {
            return;
        }

        _startedFor = Subject.EntityId;
        _showText = StartingShow();
        _yearText = Unmatched ? Context?.ParsedYear ?? string.Empty : string.Empty;
        _show = null;
        _seasons = null;
        _episodes = [];
        ClearPick();
        _shows = [];
        _searched = false;
        _showsProblem = null;

        // Opening only fills the boxes. An item that is not matched yet waits for Search; one the person chose to change starts from its own show.
        if (!Unmatched)
        {
            await RunSearchAsync(chooseStart: true);
        }
    }

    // A failed item starts from what its file name says; a matched item starts from its own show (an episode) or title (a show).
    private string StartingShow()
    {
        if (Unmatched && !string.IsNullOrWhiteSpace(Context?.ParsedShow))
        {
            return Context!.ParsedShow!;
        }

        if (Unmatched && !NeedsEpisode && !string.IsNullOrWhiteSpace(Context?.ParsedTitle))
        {
            return Context!.ParsedTitle!;
        }

        return NeedsEpisode ? Subject!.ParentLabel ?? string.Empty : Subject!.Title;
    }

    private bool IsBestGuess(TvMatchBrowserShowDto show) =>
        Unmatched && Context?.BestGuess is { } guess && string.Equals(guess.ProviderItemId, show.SeriesId, StringComparison.Ordinal);

    // The year, then a plain note when this is the item's own show or the Engine's best guess (a note in words, not a pill).
    private string? ShowMeta(TvMatchBrowserShowDto show) => EditorMatchCardModels.Join(
        show.Year,
        show.IsCurrent ? L["EditorTvMatchFlow_ThisItemsShow"].Value : null,
        IsBestGuess(show) ? L["EditorTvMatchFlow_BestGuess"].Value : null);

    // The chosen show on one line: its name, its year and the provider it came from.
    private string ChosenShowText() => EditorMatchCardModels.Join(_show?.Name, _seasons?.Year ?? _show?.Year, ProviderDisplay(EditorMatchCandidates.TvdbName)) ?? string.Empty;

    private Task OnSearchKey(KeyboardEventArgs args) => args.Key == "Enter" ? SearchAsync() : Task.CompletedTask;

    private Task SearchAsync()
    {
        _show = null;
        _seasons = null;
        _episodes = [];
        ClearPick();
        return RunSearchAsync(chooseStart: false);
    }

    private void ChangeShow()
    {
        _show = null;
        _seasons = null;
        _episodes = [];
        ClearPick();
    }

    private void ClearPick()
    {
        _sheet = false;
        _picked = null;
        _suggestion = null;
        _candidate = null;
        _judged = null;
        _judging = false;
    }

    private CancellationToken NewToken()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        return _cts.Token;
    }

    private async Task RunSearchAsync(bool chooseStart)
    {
        if (Subject is null)
        {
            return;
        }

        var text = _showText.Trim();
        var ct = NewToken();
        _showsLoading = true;
        _showsProblem = null;
        StateHasChanged();
        try
        {
            var response = await Api.SearchTvMatchBrowserShowsAsync(Subject.EntityId, text, ct);
            if (ct.IsCancellationRequested)
            {
                return;
            }

            _shows = ByYear(response?.Shows ?? []);
            _showsProblem = response is null
                ? L["EditorTvMatchFlow_DidNotAnswer"].Value
                : _shows.Count == 0
                    ? text.Length == 0 ? L["EditorTvMatchFlow_TypeAShow"].Value : L["EditorTvMatchFlow_NothingCalled", text].Value
                    : null;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "The TV match flow could not search shows for {EntityId}", Subject.EntityId);
            _shows = [];
            _showsProblem = L["EditorTvMatchFlow_DidNotAnswer"].Value;
        }

        _showsLoading = false;
        _searched = true;

        // The show the item already has, else the Engine's best guess for a failed file, is opened for the person; an episode always opens on one.
        var start = !chooseStart
            ? null
            : _shows.FirstOrDefault(show => show.IsCurrent && !Unmatched)
              ?? (Unmatched && Context?.BestGuess is { } guess ? _shows.FirstOrDefault(show => show.SeriesId == guess.ProviderItemId) : null)
              ?? _shows.FirstOrDefault(show => show.IsCurrent);
        if (start is not null)
        {
            await ChooseShowAsync(start);
        }
    }

    // A year typed in the box puts the shows from that year first; the order is otherwise the provider's.
    private IReadOnlyList<TvMatchBrowserShowDto> ByYear(IReadOnlyList<TvMatchBrowserShowDto> shows) =>
        string.IsNullOrWhiteSpace(_yearText)
            ? shows
            : [.. shows.OrderBy(show => string.Equals(show.Year, _yearText.Trim(), StringComparison.Ordinal) ? 0 : 1)];

    private async Task ChooseShowAsync(TvMatchBrowserShowDto show, bool openSheet = false)
    {
        if (Subject is null)
        {
            return;
        }

        var ct = NewToken();
        _show = show;
        _seasons = null;
        _episodes = [];
        _episodesProblem = null;
        ClearPick();
        _sheet = openSheet;
        _episodesLoading = NeedsEpisode;
        StateHasChanged();
        try
        {
            _seasons = await Api.GetTvMatchBrowserSeasonsAsync(Subject.EntityId, show.SeriesId, ct);
            if (ct.IsCancellationRequested)
            {
                return;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "The TV match flow could not list seasons for {EntityId}", Subject.EntityId);
        }

        if (!NeedsEpisode)
        {
            await PickShowAsync(show);
            return;
        }

        if (_seasons is null || _seasons.Seasons.Count == 0)
        {
            _episodesLoading = false;
            _episodesProblem = _seasons is null ? L["EditorTvMatchFlow_DidNotAnswer"].Value : L["EditorTvMatchFlow_NoSeasons"].Value;
            return;
        }

        await OpenEpisodesAsync(opening: true, ct);
    }

    private async Task PickShowAsync(TvMatchBrowserShowDto show)
    {
        _picked = null;
        await JudgeAsync(EditorTvMatchCandidates.ForShow(show));
    }

    private async Task OnSeasonChangedAsync(string? value)
    {
        if (int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var number))
        {
            _seasonNumber = number;
            await OpenEpisodesAsync(opening: false, NewToken());
        }
    }

    // Loads the season's episodes. Only the first load pre-selects: browsing to another season leaves the choice to the person.
    private async Task OpenEpisodesAsync(bool opening, CancellationToken ct)
    {
        if (Subject is null || _show is null)
        {
            return;
        }

        TvMatchBrowserEpisodeDto? absolute = null;
        if (opening)
        {
            _seasonNumber = EditorTvEpisodeSuggestion.OpeningSeason(_seasons!.Seasons, Context, useFileName: true);
            if (Context is { ParsedEpisode: null, ParsedAbsolute: { } number })
            {
                absolute = await ReadAbsoluteAsync(number, ct);
                _seasonNumber = absolute?.SeasonNumber ?? _seasonNumber;
            }
        }

        if (_seasonNumber is not { } season)
        {
            _episodesLoading = false;
            return;
        }

        ClearPick();
        _episodes = [];
        _episodesProblem = null;
        _episodesLoading = true;
        StateHasChanged();
        try
        {
            var response = await Api.GetTvMatchBrowserEpisodesAsync(Subject.EntityId, _show.SeriesId, season, ct);
            if (ct.IsCancellationRequested)
            {
                return;
            }

            _episodes = response?.Episodes ?? [];
            _episodesProblem = response is null
                ? L["EditorTvMatchFlow_DidNotAnswer"].Value
                : _episodes.Count == 0 ? L["EditorTvMatchFlow_NoEpisodes"].Value : null;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "The TV match flow could not list episodes for {EntityId}", Subject.EntityId);
            _episodesProblem = L["EditorTvMatchFlow_DidNotAnswer"].Value;
        }

        _episodesLoading = false;
        if (!opening || _episodes.Count == 0)
        {
            return;
        }

        var suggestion = EditorTvEpisodeSuggestion.FromFileName(_episodes, Context)
                         ?? EditorTvEpisodeSuggestion.FromAbsolute(absolute is null ? null : _episodes.FirstOrDefault(episode => episode.EpisodeId == absolute.EpisodeId))
                         ?? EditorTvEpisodeSuggestion.Fallback(_episodes, Evidence?.MeasuredSeconds);
        if (suggestion is not null)
        {
            _suggestion = suggestion;
            await PickEpisodeAsync(suggestion.Episode);
        }
    }

    private async Task<TvMatchBrowserEpisodeDto?> ReadAbsoluteAsync(int number, CancellationToken ct)
    {
        try
        {
            return await Api.GetTvMatchBrowserAbsoluteEpisodeAsync(Subject!.EntityId, _show!.SeriesId, number, ct);
        }
        catch (OperationCanceledException)
        {
            return null;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "The TV match flow could not read absolute episode {Number} for {EntityId}", number, Subject!.EntityId);
            return null;
        }
    }

    private async Task PickEpisodeAsync(TvMatchBrowserEpisodeDto episode)
    {
        _picked = episode;
        await JudgeAsync(EditorTvMatchCandidates.ForEpisode(episode));
    }

    // The Engine judges the pick against the file with the same facts and tolerances a search result is judged by.
    private async Task JudgeAsync(ItemCanonicalRetailCandidateDto candidate)
    {
        if (Subject is null)
        {
            return;
        }

        _candidate = candidate;
        _judged = null;
        _judging = true;
        StateHasChanged();
        try
        {
            var judged = await Api.GetEditorMatchVerdictAsync(Subject.EntityId, candidate);
            if (!ReferenceEquals(_candidate, candidate))
            {
                return;
            }

            _judged = judged ?? new EditorMatchResultDto { Candidate = candidate, ProviderName = candidate.ProviderName, Title = candidate.Title, Verdict = EditorMatchVerdicts.Possible };
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "The TV match flow could not judge a pick for {EntityId}", Subject.EntityId);
            _judged = new EditorMatchResultDto { Candidate = candidate, ProviderName = candidate.ProviderName, Title = candidate.Title, Verdict = EditorMatchVerdicts.Possible };
        }
        finally
        {
            if (ReferenceEquals(_candidate, candidate))
            {
                _judging = false;
            }
        }
    }

    // Apply match stages the pick and leaves the sheet; the tab shows its note.
    private Task ApplyAsync()
    {
        _sheet = false;
        return _candidate is null ? Task.CompletedTask : OnApplyMatch.InvokeAsync(_candidate);
    }

    // A tap on an episode picks it and, on a phone, opens its card as a sheet.
    private Task TapEpisodeAsync(TvMatchBrowserEpisodeDto episode)
    {
        _sheet = IsPhone;
        return PickEpisodeAsync(episode);
    }

    private IReadOnlyList<AppSelectOption> SeasonOptions =>
    [
        .. (_seasons?.Seasons ?? [])
            .OrderBy(season => season.SeasonNumber == 0 ? 1 : 0)
            .ThenBy(season => season.SeasonNumber)
            .Select(season => new AppSelectOption(
                season.SeasonNumber.ToString(CultureInfo.InvariantCulture),
                season.SeasonNumber == 0 ? L["EditorTvMatchFlow_Specials"].Value : L["EditorTvMatchFlow_Season", season.SeasonNumber].Value)),
    ];

    private string SuggestionText(TvMatchBrowserEpisodeDto episode)
    {
        if (_suggestion is not { } suggestion || _picked is null || suggestion.Episode.EpisodeId != _picked.EpisodeId || suggestion.Episode.EpisodeId != episode.EpisodeId)
        {
            return string.Empty;
        }

        var slot = EditorTvMatchCandidates.SlotLabel(suggestion.Episode.SeasonNumber, suggestion.Episode.EpisodeNumber).Replace(" ", string.Empty, StringComparison.Ordinal);
        return suggestion.Source switch
        {
            EditorEpisodeSuggestionSources.FileName => L["EditorTvMatchFlow_SuggestedFileName", slot].Value,
            EditorEpisodeSuggestionSources.Absolute => L["EditorTvMatchFlow_SuggestedAbsolute", Context?.ParsedAbsolute ?? 0, slot].Value,
            EditorEpisodeSuggestionSources.Runtime => L["EditorTvMatchFlow_SuggestedRuntime", slot].Value,
            _ => L["EditorTvMatchFlow_SuggestedAirOrder", slot].Value,
        };
    }

    // The left column of the episode step: the Season dropdown on the shared row, then the plain list of that season's episodes. Each row is the
    // episode's number, its title, its air date (with the reason when it is the suggested one) and its runtime.
    private RenderFragment EpisodePart() => __builder =>
    {
        if (_seasons is { Seasons.Count: > 0 })
        {
            <AppFormRow Columns="12rem" Wrap="@(!IsPhone)" Stack="@IsPhone">
                <AppSelect Value="@(_seasonNumber?.ToString(CultureInfo.InvariantCulture))" ValueChanged="OnSeasonChangedAsync" Options="@SeasonOptions"
                           Label="@L["EditorTvMatchFlow_SeasonLabel"].Value" data-testid="tv-flow-season" />
            </AppFormRow>
        }

        if (_episodesLoading)
        {
            <EditorMatchLookingUp Width="60%" />
        }
        else if (_episodesProblem is not null)
        {
            <AppAlert Severity="AppSeverity.Info" Dense="true" data-testid="tv-flow-problem">@_episodesProblem</AppAlert>
        }
        else if (_episodes.Count > 0)
        {
            <EditorMatchList AriaLabel="@L["EditorTvMatchFlow_ChooseAnEpisode"].Value" TestId="tv-flow-episodes">
                @foreach (var episode in _episodes)
                {
                    var current = episode;
                    var active = _picked?.EpisodeId == episode.EpisodeId;
                    var slot = EditorTvMatchCandidates.SlotLabel(episode.SeasonNumber, episode.EpisodeNumber).Replace(" ", string.Empty, StringComparison.Ordinal);
                    var suggested = SuggestionText(episode);
                    <EditorMatchListRow Title="@episode.Title" Number="@episode.EpisodeNumber.ToString(CultureInfo.InvariantCulture)"
                                        Meta="@EditorMatchCardModels.Join(EditorMatchFormat.AirDate(episode.Aired), suggested)"
                                        Trailing="@(episode.RuntimeMinutes is > 0 ? L["EditorTvMatchFlow_Minutes", episode.RuntimeMinutes.Value].Value : null)"
                                        Selected="active" MetaTestId="@(suggested.Length > 0 ? "tv-flow-suggested" : "tv-flow-episode-meta")"
                                        aria-label="@L["EditorTvMatchFlow_EpisodeRow", slot, episode.Title].Value" data-testid="tv-flow-episode-pick"
                                        data-number="@episode.EpisodeNumber" OnClick="@(() => TapEpisodeAsync(current))" />
                }
            </EditorMatchList>
        }
    };

    // The card for the picked show or episode: the same card as every other Match step, judged by the Engine. While the Engine is judging, a
    // placeholder holds its place.
    private RenderFragment CardPart() => __builder =>
    {
        if (_judging || _judged is null || _candidate is null)
        {
            <EditorMatchLookingUp />
        }
        else
        {
            var model = CardModel(_judged, _candidate);
            <EditorMatchCard Model="@model" ResultLabel="@L["EditorMatchResults_SelectedResult"].Value" data-testid="match-preview">
                <Foot>
                    <EditorMatchApply ShowCancel="ShowCancel" CanApply="@(CanApply && !_judging)" OnApply="ApplyAsync" OnCancel="OnCancel"
                                      Line="@EditorMatchCardModels.ApplyLine(KindId, model.ProviderName, L)" />
                </Foot>
            </EditorMatchCard>
        }
    };

    // An episode's card says which show and which slot it is (mock C) and when it aired; a show's card is the search result's.
    private EditorMatchCardModel CardModel(EditorMatchResultDto judged, ItemCanonicalRetailCandidateDto candidate)
    {
        var model = EditorMatchCardModels.ForPick(judged, candidate, KindId, ProviderDisplay(candidate.ProviderName), L);
        if (!NeedsEpisode || _picked is not { } episode)
        {
            return model;
        }

        return model with
        {
            SeriesLine = EditorMatchCardModels.Join(episode.ShowName, L["EditorMatchPanel_FileSeasonEpisode", episode.SeasonNumber, episode.EpisodeNumber].Value),
            Byline = EditorMatchFormat.AirDate(episode.Aired) is { Length: > 0 } aired ? aired : model.Byline,
        };
    }

    private RenderFragment CancelOnly() => __builder =>
    {
        <div class="tl-tvflow__foot">
            <AppButton Label="@L["EditorMatchResults_Cancel"].Value" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" OnClick="OnCancel" data-testid="match-cancel" />
        </div>
    };

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
