@namespace MediaEngine.Web.Components.Editor
@inject IStringLocalizer<SharedStrings> L

@if (Inline)
{
    <section class="sme-inline-surface @(HeroConstrained ? "sme-inline-surface--hero" : string.Empty)" aria-label="@L["MediaEditorSurface_MediaEditor"].Value">
        @ChildContent
    </section>
}
else
{
    <AppDialogShell Bare="true" HostClass="@(Phone ? "sme-dialog--phone" : "sme-dialog")">
        @ChildContent
    </AppDialogShell>
}

@code {
    [Parameter] public bool Inline { get; set; }
    [Parameter] public bool HeroConstrained { get; set; }

    /// <summary>The phone arrangement: the window is a full-screen sheet, so it drops the framed window's width, border and shadow (the phone rules are in app.css).</summary>
    [Parameter] public bool Phone { get; set; }

    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
}
