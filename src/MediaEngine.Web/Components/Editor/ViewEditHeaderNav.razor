@namespace MediaEngine.Web.Components.Editor
@using MediaEngine.Contracts.LocalAssets
@using MediaEngine.Web.Services.Editing
@implements IDisposable
@inject ViewEditorHost Host
@inject IStringLocalizer<SharedStrings> L

@* The nav row of the View editor's header (universal editor v5 D25, D19, D26; mock-up screen L): the gallery is the family. An accent home button
   goes to the gallery, and the item dropdown lists the gallery's pictures with thumbnails ("14 of 96"): the first few inline (the number comes from
   config/editor.json, carried on the gallery's photo read), then "All photos", which opens the whole gallery as a searchable, paged list in the same
   pop-over. There is no Season or Section dropdown. A photo opened outside a gallery has no family, so nothing is drawn. A new gallery lists the photos
   it was started with. Choosing a photo keeps what was staged on the others. Nothing is saved here. *@
@if (_hasFamily)
{
    var busy = Session.Saving || Session.Switching || _moving;
    var atHome = Session.IsGallery;
    <div class="view-hnav" role="group" aria-label="@L["ViewEdit_NavLabel"].Value" aria-busy="@(busy ? "true" : null)">
        <div class="view-hnav__cell">
            <AppIconButton Icon="@AppMaterialIcons.Outlined.Home"
                           ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary"
                           Size="AppControlSize.Normal"
                           Class="@(atHome ? "view-hnav__home is-current" : "view-hnav__home")"
                           Tooltip="@HomeName()"
                           AriaLabel="@HomeName()"
                           aria-current="@(atHome ? "true" : null)"
                           Disabled="@(busy)"
                           OnClick="GoHomeAsync" />
        </div>
        @if (Session.Active.IsGroup && !atHome)
        {
            @* Several photos at once (screen P): the way back to the gallery. *@
            <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary" Size="AppControlSize.Compact" StartIcon="@AppMaterialIcons.Outlined.ArrowBack"
                       Disabled="@(busy)" data-view-back="true" OnClick="GoHomeAsync">@L["ViewEdit_NavBackToGallery"]</AppButton>
        }
        else
        {
            <div class="view-hnav__cell view-hnav__cell--item">
                <AppRowButton id="view-hnav-item"
                              Class="@(_open ? "view-hnav__trigger is-open" : "view-hnav__trigger")"
                              aria-haspopup="listbox"
                              aria-expanded="@(_open ? "true" : "false")"
                              data-level="photo"
                              Disabled="@(busy)"
                              OnClick="ToggleAsync">
                    @if (!atHome && Session.Active.Items.Count == 1)
                    {
                        var current = Session.Active.Items[0];
                        @Still(current)
                        <span class="view-hnav__text">
                            <small>@Position(current)</small>
                            <span>@ViewEditStage.DisplayTitle(current)</span>
                        </span>
                    }
                    else
                    {
                        <span class="view-hnav__text">
                            <small>@L["ViewEdit_KindPhotos"]</small>
                            <span class="view-hnav__placeholder">@L["ViewEdit_NavChoosePhoto"]</span>
                        </span>
                    }

                    @if (OthersWaiting() > 0)
                    {
                        <span class="view-hnav__dot" role="img" aria-label="@L["EditorRail_ChangesWaiting"].Value"></span>
                    }
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ExpandMore" Size="AppIconSize.Control20" />
                </AppRowButton>
                @if (_open)
                {
                    @* Drawn through the shared popover so it sits in the top layer above the editor window. *@
                    <AppPopover Open="true" OpenChanged="PopoverChanged" Class="view-hnav__surface">
                        <div class="view-hnav__panel">
                            @if (_all)
                            {
                                <div class="view-hnav__search">
                                    <AppSearchField Value="@_query"
                                                    ValueChanged="SearchAsync"
                                                    Placeholder="@L["ViewEdit_NavFindPhoto"].Value"
                                                    Label="@L["ViewEdit_NavFindPhoto"].Value"
                                                    HideLabel="true"
                                                    Size="AppControlSize.Compact"
                                                    DebounceInterval="200" />
                                </div>
                            }

                            <div class="view-hnav__scroll">
                                @if (_loading && Shown.Count == 0)
                                {
                                    <div class="view-hnav__note"><AppSkeleton Height="1.5rem" Width="70%" /></div>
                                }
                                else if (Shown.Count == 0)
                                {
                                    <div class="view-hnav__note">@L["ViewEdit_NavNoPhotos"]</div>
                                }
                                else
                                {
                                    <ul class="view-hnav__options" role="listbox" aria-label="@L["ViewEdit_KindPhotos"].Value">
                                        @foreach (var member in Shown)
                                        {
                                            var selected = !atHome && Session.Active.Items.Count == 1 && Session.Active.Items[0].Id == member.Id;
                                            <li @key="member.Id" role="none">
                                                <AppRowButton role="option"
                                                              aria-selected="@(selected ? "true" : "false")"
                                                              Class="@(selected ? "view-hnav__option is-selected" : "view-hnav__option")"
                                                              OnClick="@(() => PickAsync(member))">
                                                    @Still(member)
                                                    <span class="view-hnav__text">
                                                        <small>@Kind(member)</small>
                                                        <b>@ViewEditStage.DisplayTitle(member)</b>
                                                    </span>
                                                </AppRowButton>
                                            </li>
                                        }
                                    </ul>
                                }

                                @if (_all && _cursor is not null)
                                {
                                    <div class="view-hnav__more">
                                        <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary" Size="AppControlSize.Compact" Disabled="@_loading"
                                                   OnClick="LoadMoreAsync">@L["ViewEdit_NavShowMore"]</AppButton>
                                    </div>
                                }
                            </div>

                            @if (!_all && MoreThanInline)
                            {
                                <ul class="view-hnav__options view-hnav__options--tail">
                                    <li>
                                        <AppRowButton id="view-hnav-all" Class="view-hnav__option view-hnav__option--plain" OnClick="OpenAllAsync">
                                            <span class="view-hnav__badge" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Collections" Size="AppIconSize.Control20" /></span>
                                            <span class="view-hnav__text"><b>@string.Format(L["ViewEdit_NavAllPhotos"].Value, _itemCount)</b></span>
                                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" Size="AppIconSize.Control20" />
                                        </AppRowButton>
                                    </li>
                                </ul>
                            }
                            else if (_all)
                            {
                                <ul class="view-hnav__options view-hnav__options--tail">
                                    <li>
                                        <AppRowButton Class="view-hnav__option view-hnav__option--plain" OnClick="BackToShort">
                                            <span class="view-hnav__badge" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ArrowBack" Size="AppIconSize.Control20" /></span>
                                            <span class="view-hnav__text"><b>@L["ViewEdit_NavBack"]</b></span>
                                        </AppRowButton>
                                    </li>
                                </ul>
                            }
                        </div>
                    </AppPopover>
                }
            </div>
        }
    </div>
}

@code {
    private ViewEditSession? _bound;
    private bool _hasFamily;
    private Guid? _galleryId;
    private string _galleryName = string.Empty;
    private int _itemCount;
    private ViewEditorLimits? _limits;
    private object? _membersFrom;
    private List<LocalAssetDto> _members = [];
    private List<LocalAssetDto> _found = [];
    private bool _open, _all, _loading, _moving;
    private string _query = string.Empty;
    private string? _cursor;
    private int _findVersion;

    [Parameter, EditorRequired] public ViewEditSession Session { get; set; } = default!;

    // Before the Engine has said how many show inline, the loaded photos all show (a new gallery has no photo read to ask).
    private IReadOnlyList<LocalAssetDto> Shown => _all ? _found : _limits is { } limits ? _members.Take(limits.InlineItems).ToList() : _members;

    private bool MoreThanInline => _limits is { } limits && Math.Max(_itemCount, _members.Count) > limits.InlineItems;

    public void Dispose()
    {
        if (_bound is not null)
        {
            _bound.Changed -= OnChanged;
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnParametersSetAsync()
    {
        // The window can swap its session (home, a pick in the dropdown): follow the new one, and start the dropdown closed.
        if (!ReferenceEquals(_bound, Session))
        {
            if (_bound is not null)
            {
                _bound.Changed -= OnChanged;
            }

            _bound = Session;
            _bound.Changed += OnChanged;
            _open = false;
            _all = false;
        }

        // A photo opened from a gallery knows the gallery, its size and the photos loaded so far; a saved gallery's own editor knows only itself and reads
        // the photos when the list opens; a new gallery lists the photos it was started with. A Vault or saved-view gallery has no photo list to step through.
        var previous = _galleryId;
        if (Session.Rail is { } rail)
        {
            _hasFamily = true;
            _galleryId = rail.GalleryId;
            _galleryName = rail.GalleryName;
            _itemCount = rail.ItemCount;
            Fill(rail, rail.Members);
        }
        else if (Session.Gallery is { IsNew: false, IsVault: false, IsDocumentView: false, Id: { } id } gallery)
        {
            _hasFamily = true;
            _galleryId = id;
            _galleryName = string.IsNullOrWhiteSpace(gallery.Name) ? gallery.OriginalName : gallery.Name;
            _itemCount = gallery.Original?.ItemCount ?? 0;
            Fill(gallery, []);
        }
        else if (Session.Gallery is { IsNew: true, IsVault: false, IsDocumentView: false } fresh && fresh.StartingMembers.Count > 0)
        {
            _hasFamily = true;
            _galleryId = null;
            _galleryName = string.IsNullOrWhiteSpace(fresh.Name) ? L["ViewEdit_NewGallery"].Value : fresh.Name;
            _itemCount = fresh.StartingMembers.Count;
            Fill(fresh, fresh.StartingMembers);
        }
        else
        {
            _hasFamily = false;
            _galleryId = null;
        }

        if (_galleryId is { } galleryId && (_limits is null || previous != galleryId))
        {
            _limits = await Host.GetLimitsAsync(galleryId);
        }
    }

    private void Fill(object source, IReadOnlyList<LocalAssetDto> members)
    {
        if (!ReferenceEquals(_membersFrom, source))
        {
            _membersFrom = source;
            _members = [.. members];
        }
    }

    private string HomeName() => string.Format(L["ViewEdit_NavGoToGallery"].Value, _galleryName);

    private string Position(LocalAssetDto current)
    {
        var index = _members.FindIndex(member => member.Id == current.Id);
        return index < 0 ? L["ViewEdit_KindPhotos"].Value : string.Format(L["ViewEdit_NavPosition"].Value, index + 1, Math.Max(_itemCount, _members.Count));
    }

    private string Kind(LocalAssetDto item) => item.MediaKind == ViewMediaKinds.Video ? L["ViewEdit_KindVideo"].Value : L["ViewEdit_KindPhoto"].Value;

    // A dot on the dropdown when some other photo of the gallery has changes waiting.
    private int OthersWaiting() => Session.IsGallery ? 0 : Session.ChangeCount - Session.Active.ChangeCount;

    private RenderFragment Still(LocalAssetDto item) => __builder =>
    {
        <span class="view-hnav__still" aria-hidden="true"><AppImage Src="@item.ThumbnailUrl" Alt="" DrawnPx="120" ObjectFit="AppObjectFit.Cover" Class="view-hnav__img" /></span>
    };

    private async Task ToggleAsync()
    {
        _open = !_open;
        if (!_open)
        {
            return;
        }

        _all = false;
        _query = string.Empty;
        if (_members.Count == 0 && _galleryId is { } id)
        {
            _loading = true;
            var page = await Host.GalleryPhotosAsync(id, null, null, _limits?.PageSize);
            _members = [.. page?.Items ?? []];
            _loading = false;
        }
    }

    private void PopoverChanged(bool open)
    {
        if (!open)
        {
            _open = false;
        }
    }

    private async Task OpenAllAsync()
    {
        _all = true;
        _query = string.Empty;
        await LoadFoundAsync(reset: true);
    }

    private void BackToShort()
    {
        _findVersion++;
        _all = false;
        _query = string.Empty;
    }

    private async Task SearchAsync(string? value)
    {
        _query = value ?? string.Empty;
        await LoadFoundAsync(reset: true);
    }

    private Task LoadMoreAsync() => LoadFoundAsync(reset: false);

    // Typing quickly starts a read before the last one has come back; each read is numbered, and an answer that is no longer the latest is dropped
    // so an older search can never replace a newer one.
    private async Task LoadFoundAsync(bool reset)
    {
        if (_galleryId is not { } id)
        {
            _found = [.. _members];
            return;
        }

        var version = ++_findVersion;
        var query = _query;
        var cursor = reset ? null : _cursor;
        _loading = true;
        if (reset)
        {
            _cursor = null;
            _found = [];
        }

        var page = await Host.GalleryPhotosAsync(id, cursor, query, _limits?.PageSize);
        if (version != _findVersion)
        {
            return;
        }

        _found.AddRange(page?.Items ?? []);
        _cursor = page?.HasMore == true ? page.NextCursor : null;
        _loading = false;
    }

    private async Task PickAsync(LocalAssetDto member)
    {
        _open = false;
        _moving = true;
        try
        {
            if (!Session.IsGallery)
            {
                await Host.SwitchItemAsync(member);
            }
            else if (_galleryId is { } id)
            {
                await Host.OpenPhotoInGalleryAsync(member, id, _galleryName, _itemCount);
            }
            else
            {
                await Host.OpenItemsAsync([member]);
            }
        }
        finally
        {
            _moving = false;
        }
    }

    private async Task GoHomeAsync()
    {
        if (Session.IsGallery || _galleryId is not { } id)
        {
            return;
        }

        _moving = true;
        try
        {
            await Host.OpenGalleryByIdAsync(id);
        }
        finally
        {
            _moving = false;
        }
    }
}
