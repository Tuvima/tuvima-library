@namespace MediaEngine.Web.Components.Editor
@using MediaEngine.Contracts.Editing
@inject IStringLocalizer<SharedStrings> L

@* The verdict line and the buttons under the TV and music flows (universal editor v5, 3c, mockups G3 and G4): Strong, Possible or Check with the
   reasons, and at the right of the same line "Your file: 45:52 measured · Provider: 46 min (rounded)" when a length was compared, then Cancel
   and Apply match. Apply match is always available once something is chosen; the verdict is advice. The verdict is a polite live region, so a
   screen reader hears it change when another episode or track is chosen. Nothing is saved here. *@
<div class="tl-matchbar" data-testid="match-verdict-bar">
    <div class="tl-matchbar__verdict" aria-live="polite" aria-atomic="true" data-testid="@(Result is not null && !Judging ? "match-verdict" : null)">
        @if (Judging)
        {
            <div role="status" aria-busy="true"><AppSkeleton Shape="AppSkeletonShape.Text" Width="40%" /></div>
        }
        else if (Result is { } result)
        {
            <span class="tl-matchbar__chip"><AppChip Text="@L["EditorMatchVerdictBar_Verdict", EditorMatchResults.VerdictText(result.Verdict, L)].Value" Tone="@EditorMatchResults.VerdictTone(result.Verdict)" /></span>
            @foreach (var reason in result.Reasons)
            {
                <span class="tl-matchbar__reason" data-state="@reason.State">@Mark(reason.State) @reason.Text</span>
            }

            @if (LengthNote(result) is { } note)
            {
                <span class="tl-matchbar__length" data-testid="match-length-line">@L["EditorMatchVerdictBar_LengthLine", note.Yours, note.Provider]</span>
            }
        }
    </div>

    <div class="tl-matchbar__actions">
        @if (ShowCancel)
        {
            <AppButton Label="@L["EditorMatchResults_Cancel"].Value" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" OnClick="OnCancel" data-testid="match-cancel" />
        }
        <AppButton Label="@L["EditorMatchResults_ApplyMatch"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(!CanApply)" OnClick="OnApply" data-testid="match-apply" />
    </div>
</div>

@code {
    /// <summary>The judged pick; null until something is chosen.</summary>
    [Parameter] public EditorMatchResultDto? Result { get; set; }

    /// <summary>True while the Engine is judging a fresh pick.</summary>
    [Parameter] public bool Judging { get; set; }

    [Parameter] public bool CanApply { get; set; }

    /// <summary>Shown as Cancel when there is a current match to go back to.</summary>
    [Parameter] public bool ShowCancel { get; set; }

    [Parameter] public EventCallback OnApply { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    private static string Mark(string state) => state switch
    {
        EditorMatchEvidenceStates.Agrees => "✓",
        EditorMatchEvidenceStates.Differs => "✕",
        _ => "–",
    };

    // The length reason's note is "45:52 measured · 46 min (rounded)": your file's side and the provider's side, split at the dot.
    private static (string Yours, string Provider)? LengthNote(EditorMatchResultDto result)
    {
        var note = result.Reasons.FirstOrDefault(reason => reason.Fact is "runtime" or "track_length")?.Note;
        if (string.IsNullOrWhiteSpace(note))
        {
            return null;
        }

        var parts = note.Split(" · ", 2, StringSplitOptions.TrimEntries);
        return parts.Length == 2 ? (parts[0], parts[1]) : null;
    }
}
