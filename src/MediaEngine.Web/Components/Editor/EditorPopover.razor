@namespace MediaEngine.Web.Components.Editor
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Theming
@using MediaEngine.Web.Services.Ui
@using Microsoft.AspNetCore.Components.Routing
@implements IAsyncDisposable
@inject EditorHost Editor
@inject IAppDialogService Dialogs
@inject DeviceContextService Device
@inject IServiceProvider Services
@inject IStringLocalizer<SharedStrings> L
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ILogger<EditorPopover> Logger

@* The universal editor's pop-over (v3 D1, D6), drawn once by the app layout so it can open over any page or list. It is a native modal
   dialog (opened with showModal by app-dialog.js), so it stacks above the details overlay, makes everything behind it inert, traps focus
   and keeps the page where it was. The page behind is never put into an "editing" state. After Save the slim ribbon proves the save.
   Its frame is the v4 one (D2, D3, D16): the item's header (with the item's family, as a tile and dropdowns, inside it), the tab bar and a fixed footer. *@
<EditSavedRibbon Flow="Editor.Flow" />
@if (Editor.IsOpen)
{
    var flow = Editor.Flow;
    var mode = Editor.Mode;
    var binding = Editor.Binding;
    @* Reload and tab close ask the browser's own question; in-app navigation is asked here only for a page outside the details overlay
       (inside it the overlay's leave guard asks, so nothing asks twice). *@
    <NavigationLock ConfirmExternalNavigation="@flow.Session.HasUnsavedWork" OnBeforeInternalNavigation="ConfirmNavigationAsync" />
    <AppDialogFrame Open="true"
                    Title="@DialogLabel"
                    DialogOptions="_options"
                    OnCancel="@(() => Editor.RequestCloseAsync())"
                    Class="tl-editor-dialog">
        <CascadingValue Value="Layout">
        <EditorPanelHost Mode="mode"
                         Flow="flow"
                         Phone="Phone"
                         Picker="Editor.Picker"
                         TitleOverride="@(BulkPanelTitle ?? FilesBatchTitle)"
                         FilesBatch="@Editor.FileBatch.IsOpen"
                         ChangeSuffix="@(Editor.FileBatch.IsOpen ? string.Format(L["EditorFilesBatch_FilesCount"].Value, Editor.FileBatch.Rows.Count) : null)"
                         ShowHistory="@(binding?.ShowHistory == true)"
                         ActionNotice="@_actionNotice"
                         ActionNoticeIsError="_actionNoticeIsError"
                         ActionNoticeDismissed="@(() => _actionNotice = null)"
                         ItemHeader="@(Editor.FileBatch.IsOpen ? FilesBatchHeaderFragment(flow, mode) : Editor.Batch.Panel == BulkPanelKind.None ? ItemHeaderFragment(flow, mode) : null)"
                         FooterStart="@FooterStartFragment(flow, mode)">
            <HeaderContent>
                @if (Editor.FileBatch.IsOpen)
                {
                    @* The framed header carries Back to the list. *@
                }
                else if (Editor.Batch.Panel == BulkPanelKind.None && Editor.Session.ActiveItem is { } editing)
                {
                    <span class="tl-editor-popover__editing" data-overflow-tooltip="@editing.Title">@L["EditorPopover_EditingItem", editing.Title]</span>
                }
            </HeaderContent>
            <ChildContent Context="tool">
                @if (Editor.FileBatch.IsOpen)
                {
                    @* Several supporting files edited together: Details, or History with one collapsed section per file (read when opened). *@
                    @if (tool == EditTool.History)
                    {
                        <EditorFilesBatchHistory Rows="Editor.FileBatch.Rows" TitleId="Editor.FileBatch.TitleId" />
                    }
                    else
                    {
                        <EditorFilesBatchPanel State="Editor.FileBrowser" CanEdit="@mode.CanEdit" />
                    }
                }
                else if (Editor.Batch.Panel != BulkPanelKind.None && tool == EditTool.Details)
                {
                    @* Ticked rows are edited together: the panel needs the rows, not the fields of any one item, so a failed read of the first row never blocks it. *@
                    <BulkEditPanel Selection="Editor.Batch" Pending="flow.Session.Pending" CanEdit="@mode.CanEdit" />
                }
                else if (!mode.Fields.Loaded && !mode.Fields.Loading && !string.IsNullOrWhiteSpace(mode.Fields.LoadError))
                {
                    <div class="tl-editor-details">
                        <AppAlert Severity="AppSeverity.Error" Dense="true">@L["EditorPopover_EditingIsNotReady"] @mode.Fields.LoadError</AppAlert>
                        <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" OnClick="@(() => Editor.RetryLoadAsync())">@L["Common_TryAgain"]</AppButton>
                    </div>
                }
                else if (tool == EditTool.Details && mode.Fields.SupportingFile is not null)
                {
                    <EditorSupportingFilePanel Mode="mode" Flow="flow" />
                }
                else if (tool == EditTool.Preview && mode.Fields.SupportingFile is not null)
                {
                    <EditorPreviewTab Fields="mode.Fields" />
                }
                else if (tool == EditTool.History && mode.Fields.SupportingFile is not null)
                {
                    <div data-supporting-file-history="true">
                        <EditorHistoryTool EntityId="@(Guid.TryParse(mode.Fields.SupportingFile.File.Id, out var fileId) ? fileId : Guid.Empty)"
                                           SupportingFileTitleId="@mode.Fields.SupportingFile.TitleId" Phone="Phone" />
                    </div>
                }
                else if (tool == EditTool.Details)
                {
                    <EditorDetailsPanel Mode="mode" Session="flow.Session" Flow="flow" Phone="Phone">@binding?.DetailsExtra</EditorDetailsPanel>
                }
                else if (tool == EditTool.Match && EditorUniverseRules.IsUniverseSubject(mode.Fields.SubjectKind))
                {
                    <EditorUniverseMatchPanel Fields="mode.Fields" UniverseQid="@binding?.UniverseQid" />
                }
                else if (tool == EditTool.Match)
                {
                    @if (mode.Fields.Loading)
                    {
                        <EditorPanelBusy Label="@L["DetailPage_LoadingThisItemSMatch"].Value" />
                    }

                    <EditorMatchPanel Subject="@(mode.Fields.Loading ? null : mode.Fields.MatchSubject())"
                                      Session="flow.Session"
                                      CanEdit="@mode.CanEdit"
                                      IsUnmatched="@IsActiveUnmatched"
                                      OnMatchState="@(state => _matchRead = state)"
                                      Universe="@binding?.UniverseLink?.Invoke()"
                                      OnOpenUniverse="OpenUniverseAsync" />
                }
                else if (tool == EditTool.Bookmarks)
                {
                    <EditorBookmarksPanel Flow="flow" HasFamily="@EditorBookmarksPanel.FamilyHoldsTheFiles(Editor.Family.Kind)" Phone="Phone" />
                }
                else if (tool == EditTool.History)
                {
                    <EditorHistoryTool EntityId="@(flow.Session.ActiveItem?.EntityId ?? Guid.Empty)" ForUniverse="@EditorUniverseRules.IsUniverseSubject(mode.Fields.SubjectKind)" Phone="Phone" />
                }
            </ChildContent>
        </EditorPanelHost>
        </CascadingValue>
    </AppDialogFrame>
}

@code {
    private RenderFragment ItemHeaderFragment(EditSessionFlow flow, EditingModeContext mode) => __builder =>
    {
        @* The way around the family (home, Season or Section, item) sits in the header's nav row and is read from the Engine's header (v5 D1). A
           Universe keeps its own tile and kind dropdowns. *@
        <EditorItemHeader Flow="flow" Fields="mode.Fields" Family="Editor.Family" Unmatched="@IsActiveUnmatched"
                          Compact="@(flow.Session.ActiveTool == EditTool.Match)" MatchRead="_matchRead"
                          UniverseName="@Editor.Universe.UniverseName"
                          HasFamily="@Editor.Universe.Visible"
                          Phone="Phone" PhoneMenuItems="@DeleteMenu(flow, mode)"
                          Hooks="Editor.HeaderHooks">
            <Tile>
                @if (Editor.Universe.Visible)
                {
                    <EditorUniverseRail State="Editor.Universe" Flow="flow" Part="EditorFamilyRailPart.Tile" />
                }
            </Tile>
            <Selects>
                @if (Editor.Universe.Visible)
                {
                    <EditorUniverseRail State="Editor.Universe" Flow="flow" Part="EditorFamilyRailPart.Selects" />
                }
            </Selects>
        </EditorItemHeader>
    };

    // "Editing N files": the framed header in group mode (WP8, screen F), with the home button and "Back to the list".
    private RenderFragment FilesBatchHeaderFragment(EditSessionFlow flow, EditingModeContext mode) => __builder =>
    {
        <EditorItemHeader Flow="flow" Fields="mode.Fields" Family="Editor.Family"
                          Phone="Phone" PhoneMenuItems="@DeleteMenu(flow, mode)"
                          GroupRows="Editor.FileBatch.Rows"
                          GroupLabel="@Editor.FileBatch.TitleName"
                          GroupTitle="@EditorFileBrowserRules.EditingTitle(L, Editor.FileBatch.Rows.Count)"
                          OnGroupBack="BackToTheListAsync"
                          OnGroupHome="HomeFromFilesAsync" />
    };

    // Delete in "Editing N files": asks once naming the count, then runs the browser's bulk delete (D29); the group then shrinks or closes.
    private RenderFragment FilesBatchDeleteFragment(EditSessionFlow flow, EditingModeContext mode) => __builder =>
    {
        <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Error" Size="AppControlSize.Large" Class="tl-editor-window__delete"
                   StartIcon="@AppMaterialIcons.Outlined.Delete" Disabled="@(flow.Saving || flow.Switching || !mode.CanEdit)" data-files-batch-delete="true"
                   OnClick="DeleteFilesAsync">
            @L["EditorFilesBatch_Delete"]
        </AppButton>
    };

    private async Task DeleteFilesAsync()
    {
        if (_deleting)
        {
            return;
        }

        _deleting = true;
        try
        {
            var rows = Editor.FileBatch.Rows.ToList();
            await ShowAsync(await EditorFileBrowserDeleteFlow.DeleteAsync(Editor.FileBrowser, rows, Dialogs, L));
        }
        finally
        {
            _deleting = false;
        }
    }

    // The home button: the group form closes and the editor goes to the title itself.
    private async Task HomeFromFilesAsync()
    {
        var root = Editor.Mode.Fields.Header?.Root.Id ?? Editor.FileBatch.TitleId;
        Editor.FileBatch.Close();
        await Editor.Flow.SwitchToAsync(root);
    }

    // Delete sits bottom-left of the footer as a red button that always says "Delete" (v5 D29). On a phone the footer holds only Discard and Save changes
    // and Delete is in the header's "..." menu (v6 D22); the same three ways to delete, the same confirmation.
    private RenderFragment? FooterStartFragment(EditSessionFlow flow, EditingModeContext mode) =>
        Phone ? null
        : Editor.FileBatch.IsOpen ? FilesBatchDeleteFragment(flow, mode)
        : Editor.Batch.Panel == BulkPanelKind.None && (CanDeleteActive || CanDeleteThing || CanDeleteFile) ? DeleteButtonFragment(flow, mode)
        : null;

    private IReadOnlyList<AppRowMenuItem>? DeleteMenu(EditSessionFlow flow, EditingModeContext mode)
    {
        if (!Phone)
        {
            return null;
        }

        Func<Task>? delete = Editor.FileBatch.IsOpen
            ? DeleteFilesAsync
            : Editor.Batch.Panel == BulkPanelKind.None && (CanDeleteActive || CanDeleteThing || CanDeleteFile)
                ? () => CanDeleteFile ? DeleteFileAsync() : CanDeleteThing ? DeleteThingAsync() : DeleteActiveAsync()
                : null;
        if (delete is null)
        {
            return null;
        }

        return
        [
            new AppRowMenuItem
            {
                Label = L["EditorFooter_Delete"].Value,
                Icon = AppMaterialIcons.Outlined.Delete,
                Destructive = true,
                Disabled = flow.Saving || flow.Switching || (Editor.FileBatch.IsOpen && !mode.CanEdit),
                OnClick = EventCallback.Factory.Create(this, delete),
            },
        ];
    }

    // Delete sits bottom-left of the footer as a red button that always says "Delete" (v5 D29). It asks once, naming the item and what goes with
    // it, and then happens at once; it does not wait for Save.
    private RenderFragment DeleteButtonFragment(EditSessionFlow flow, EditingModeContext mode) => __builder =>
    {
        <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Error" Size="AppControlSize.Large" Class="tl-editor-window__delete"
                   StartIcon="@AppMaterialIcons.Outlined.Delete" Disabled="@(flow.Saving || flow.Switching)"
                   OnClick="@(CanDeleteFile ? DeleteFileAsync : CanDeleteThing ? DeleteThingAsync : DeleteActiveAsync)">
            @L["EditorFooter_Delete"]
        </AppButton>
    };

    private bool _deleting;

    // What the Match tab read from the Engine about the active item's match; the one-line header on the Match tab says the same thing.
    private EditorMatchReadState? _matchRead;
    private bool _dataSavedSeen;

    // What the last Delete had to say (a refusal, a failure, a file that stayed on disk): shown at the top of the window until dismissed or the next try.
    private string? _actionNotice;
    private bool _actionNoticeIsError;

    private async Task ShowAsync(EditorDeleteResult result)
    {
        if (!Editor.IsOpen)
        {
            // The delete closed the window (the item had no parent to move to), so there is no window to show the line in: it goes to the
            // page the person lands on, and nothing is left here for the next time the editor opens.
            _actionNotice = null;
            if (result.Notice is { } notice)
            {
                await Editor.HandNoticeToPageAsync(notice);
            }

            return;
        }

        _actionNotice = result.Notice;
        _actionNoticeIsError = result.NoticeIsError;
    }

    private bool CanDeleteFile => EditorSupportingFileFlow.CanDelete(Editor, Device, Services.GetService<DashboardSessionAccessor>());

    // Delete from a supporting file's footer: asks once, naming the file and what happens to it on disk, then happens at once.
    private async Task DeleteFileAsync()
    {
        if (_deleting)
        {
            return;
        }

        _deleting = true;
        try
        {
            await ShowAsync(await EditorSupportingFileFlow.DeleteAsync(Editor, Dialogs, Device, Services.GetService<DashboardSessionAccessor>()));
        }
        finally
        {
            _deleting = false;
        }
    }

    private bool CanDeleteThing => EditorDeleteFlow.CanDeleteThing(Editor, Device, Services.GetService<DashboardSessionAccessor>());

    // Delete from the "..." of a character, place or faction someone added by hand (WP11): asks once, then happens at once.
    private async Task DeleteThingAsync()
    {
        if (_deleting)
        {
            return;
        }

        _deleting = true;
        try
        {
            await ShowAsync(await EditorDeleteFlow.DeleteThingAsync(Editor, Dialogs, Device, Services.GetService<DashboardSessionAccessor>()));
        }
        finally
        {
            _deleting = false;
        }
    }

    // Delete from the header's "..." (v4 D13): the item being edited, including a whole show, season, album or Series. It asks once and happens
    // at once, without waiting for Save; the pop-over then moves to the item's parent, or closes when there is none.
    private bool CanDeleteActive => EditorDeleteFlow.CanDeleteActive(Editor, Device, Services.GetService<DashboardSessionAccessor>());

    private async Task DeleteActiveAsync()
    {
        if (_deleting)
        {
            return;
        }

        _deleting = true;
        try
        {
            await ShowAsync(await EditorDeleteFlow.DeleteActiveAsync(Editor, Dialogs, Device, Services.GetService<DashboardSessionAccessor>()));
        }
        finally
        {
            _deleting = false;
        }
    }

    private static readonly AppDialogOptions _options = new()
    {
        NoHeader = true,
        BackdropClick = false,
        CloseOnEscapeKey = true,
    };

    // Whether the active item is matched, said the same way on every tab and in the header (v6 D10). The Match tab's own read of the Engine wins as
    // soon as it exists. Before that the Engine's header says it by the same rule (a provider match, EditorMatchRule); an item with no header falls
    // back to the family tree's mark, then to the page's answer for the item it was opened on.
    private bool IsActiveUnmatched => Editor.Session.ActiveItem is { } active
        && (_matchRead is { } read && read.EntityId == active.EntityId
            ? !read.Matched
            : Editor.Mode.Fields is { Loaded: true, Header: { } header } && header.CurrentId == active.EntityId
                ? !header.ProviderMatched
                : Editor.Family.IsMatched(active.EntityId) is { } matched ? !matched : Editor.Binding?.IsUnmatched == true);

    private string? FilesBatchTitle => Editor.FileBatch.IsOpen ? EditorFileBrowserRules.EditingTitle(L, Editor.FileBrowser.Ticked.Count) : null;

    private string DialogLabel => Editor.FileBatch.IsOpen
        ? EditorFileBrowserRules.EditingTitle(L, Editor.FileBrowser.Ticked.Count)
        : Editor.Batch.Panel == BulkPanelKind.None
        ? $"Editing {Editor.Session.ActiveItem?.Title ?? "item"}"
        : BulkEditRules.EditingTitle(Editor.Batch.Rows, Editor.Batch.MediaType);

    // The Details tool is called "Edit 4 songs", "Move to album", "Match" while the bulk panel is in it.
    private string? BulkPanelTitle => Editor.Batch.Panel switch
    {
        BulkPanelKind.Edit => BulkEditRules.EditingTitle(Editor.Batch.Rows, Editor.Batch.MediaType),
        BulkPanelKind.Move => BulkEditRules.MoveLabel(Editor.Batch.Rows, Editor.Batch.MediaType),
        BulkPanelKind.Series => BulkEditRules.PutInSeriesLabel,
        BulkPanelKind.Match => $"Match {Editor.Batch.Count} {BulkEditRules.Noun(Editor.Batch.Rows, Editor.Batch.MediaType)}",
        _ => null,
    };

    /// <summary>Draws the window in the phone arrangement (true) or the desktop one (false) whatever the device says; left unset, the device's form factor decides.</summary>
    [Parameter] public bool? PhoneArrangement { get; set; }

    // The phone arrangement (v6 section 4a): a phone or a tablet says so by its form factor, which the browser reports before the first draw and again
    // whenever the window crosses a form-factor width, so a window resized or a tablet turned is drawn again in the other arrangement.
    private bool Phone => PhoneArrangement ?? EditorPhoneArrangement.Applies(Device);

    // What the parts of the window read instead of each being handed Phone.
    private EditorWindowLayout Layout => Phone ? EditorWindowLayout.PhoneSheet : EditorWindowLayout.Desktop;

    protected override void OnInitialized()
    {
        Device.OnChanged += DeviceChanged;
        Editor.AskSaveOrDiscard = () => EditingSaveOrDiscardDialog.AskAsync(Dialogs);
        Editor.ConfirmDiscard = () => EditingUnsavedChangesDialog.AskDiscardAsync(Dialogs);
        Editor.HeaderHooks.OpenSupportingFiles = request => OpenBrowserAsync(EditorBrowserView.Files);
        Editor.HeaderHooks.OpenFolders = _ => OpenBrowserAsync(EditorBrowserView.Folders);
        Editor.Changed += OnChanged;
    }

    // The supporting-files browser (v5 WP8): "All supporting files" and the folder button open it over the editor. It always shows the whole
    // title (the header's root), so the files of one level and of the whole show are one list with a Where filter.
    private async Task OpenBrowserAsync(EditorBrowserView view)
    {
        if (_browsing || Editor.Mode.Fields.Header is not { } header)
        {
            return;
        }

        _browsing = true;
        try
        {
            // The dialog opens first and shows its loading state while the list is read; the folder button opens the Folders view at its own level.
            var reading = Editor.FileBrowser.OpenAsync(
                header.Root.Id, header.Root.Title, view, folder: header.FolderButton?.RelativeFolder, mediaType: Editor.Mode.Fields.MediaType);
            var dialog = await Dialogs.ShowAsync<EditorFileBrowserDialog>(
                string.Empty,
                new AppDialogParameters<EditorFileBrowserDialog>
                {
                    { component => component.State, Editor.FileBrowser },
                    { component => component.Session, Editor.Flow.Session },
                    { component => component.IsVideoSeries, EditorNavText.CanReorder(header) },
                    { component => component.Subject, Editor.Mode.Fields.Loading ? null : Editor.Mode.Fields.MatchSubject() },
                    { component => component.Family, Editor.Family },
                    { component => component.CanEdit, Editor.Mode.CanEdit },
                },
                new AppDialogOptions { NoHeader = true, FullWidth = true, Size = AppWindowSize.ExtraLarge, BackdropClick = false, CloseOnEscapeKey = true });
            await reading;
            if (await dialog.Result is { Canceled: false, Data: EditorFileBrowserOutcome outcome })
            {
                await HandleBrowserOutcomeAsync(outcome);
            }
        }
        finally
        {
            _browsing = false;
        }
    }

    private bool _browsing;

    private async Task HandleBrowserOutcomeAsync(EditorFileBrowserOutcome outcome)
    {
        switch (outcome.Action)
        {
            case EditorFileBrowserAction.EditSelected:
                var ticked = Editor.FileBrowser.Ticked;
                if (ticked.Count >= 2)
                {
                    Editor.FileBatch.Open(Editor.FileBrowser.TitleId, Editor.FileBrowser.TitleName, ticked);
                }
                else if (ticked.Count == 1 && Guid.TryParse(ticked[0].Id, out var only))
                {
                    await Editor.HeaderHooks.OpenSupportingFile!(only);
                }

                break;
            case EditorFileBrowserAction.OpenFile:
                await Editor.HeaderHooks.OpenSupportingFile!(outcome.Id);
                if (outcome.Preview)
                {
                    await Editor.Flow.SelectToolAsync(EditTool.Preview);
                }

                break;
            case EditorFileBrowserAction.OpenItem:
                await Editor.Flow.SwitchToAsync(outcome.Id);
                break;
        }
    }

    // "Back to the list": the several-files form closes and the browser opens again with the same ticks and filters.
    private async Task BackToTheListAsync()
    {
        Editor.FileBatch.Close();
        await OpenBrowserAsync(EditorBrowserView.Files);
    }

    private void DeviceChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Device.OnChanged -= DeviceChanged;
        Editor.Changed -= OnChanged;
        Editor.AskSaveOrDiscard = null;
        Editor.ConfirmDiscard = null;
        Editor.HeaderHooks.OpenSupportingFiles = null;
        Editor.HeaderHooks.OpenFolders = null;
        if (_focusModule is not null)
        {
            try
            {
                if (_watching)
                {
                    await _focusModule.InvokeVoidAsync("stopKeyboard");
                }

                await _focusModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit ended first; the browser already dropped its listeners with the page.
            }
        }
    }

    private bool _wasOpen;

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        if (!Editor.IsOpen || !_wasOpen)
        {
            // A notice belongs to the window it was shown in: it goes when the window closes and when a new one opens.
            _actionNotice = null;
        }

        _wasOpen = Editor.IsOpen;

        // What the Match tab read belongs to one item and goes with it: another item, a closed window, or a Save (which can change the match) clears it
        // so a stale answer is never shown; the tab reads the match afresh the next time it is open.
        var savedNow = Editor.Flow.DataSaved;
        if (_matchRead is { } stale && (!Editor.IsOpen || stale.EntityId != Editor.Session.ActiveItem?.EntityId || (savedNow && !_dataSavedSeen)))
        {
            _matchRead = null;
        }

        _dataSavedSeen = savedNow;

        StateHasChanged();
    });

    // Open Universe (v4 D17): closes the editor, asking "Unsaved changes" first, then opens the Universe page. Staying leaves everything as it was.
    private async Task OpenUniverseAsync(EditorUniverseLink universe)
    {
        if (!await Editor.Flow.LeaveAsync())
        {
            return;
        }

        Nav.NavigateTo($"/universe/{Uri.EscapeDataString(universe.Qid)}");
    }

    private int _focusTries;
    private IJSObjectReference? _focusModule;
    private bool _watching;
    private bool _disposed;

    // While the window is open on a phone arrangement, its height is kept above the on-screen keyboard (editor-focus.js). A failure to reach the script (a test
    // host, a closing circuit, a moment when the connection is down) leaves the state as it was, so the next draw tries again; the window works without the fit.
    private async Task SyncKeyboardAsync()
    {
        var wanted = Editor.IsOpen && Phone;
        if (_disposed || wanted == _watching)
        {
            return;
        }

        try
        {
            _focusModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/editor-focus.js");
            if (wanted)
            {
                await _focusModule.InvokeVoidAsync("watchKeyboard");
            }
            else
            {
                await _focusModule.InvokeVoidAsync("stopKeyboard");
            }

            _watching = wanted;
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException or JSDisconnectedException)
        {
            Logger.LogDebug(ex, "The editor could not reach its keyboard script; it will try again at the next draw");
        }
    }

    // The player's lyrics button asks for the Lyrics field: once the pop-over has drawn the fields, the cursor goes there. A field the
    // item does not show (or a page without scripts) is not an error; the request is dropped after a few tries.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncKeyboardAsync();
        if (Editor.FocusField is not { } key || !Editor.IsOpen)
        {
            _focusTries = 0;
            return;
        }

        var found = false;
        try
        {
            _focusModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/editor-focus.js");
            found = await _focusModule.InvokeAsync<bool>("focusField", key);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException or JSDisconnectedException)
        {
            // No script support here (a test host, a closing circuit): the pop-over is still fully usable without the cursor placed.
        }

        if (found || ++_focusTries >= 4)
        {
            _focusTries = 0;
            Editor.ClearFocusRequest();
        }
    }

    private async Task ConfirmNavigationAsync(LocationChangingContext context)
    {
        if (Editor.OverlayGuardsNavigation || Editor.Flow is not { Session.HasUnsavedWork: true } flow)
        {
            return;
        }

        if (!await flow.LeaveAsync())
        {
            context.PreventNavigation();
        }
    }
}
