@namespace MediaEngine.Web.Components.Editor
@using MediaEngine.Web.Components.Details
@using System.Globalization
@using MediaEngine.Contracts.Editing
@using MediaEngine.Contracts.Matching
@using MediaEngine.Domain
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@implements IDisposable
@inject IEngineApiClient Api
@inject IStringLocalizer<SharedStrings> L

@* The Match tab for one item (universal editor v5, 3c, mockups G1 and G2). The first row carries the provider dropdown (label above) and the
   "Media providers / Wikidata" switch at the right; while searching it also carries the boxes of the item's kind and a filled Search button. An
   item that is matched opens on what it is matched to, found by its provider id, with the reasons it fits (Why this match) and the actions
   Remove match and Change match; nothing is searched until a person asks. An item that is not matched yet opens on the search with
   "Not matched yet", the boxes pre-filled from the cleaned file name, tags and folders. Apply match only stages the choice in the pending list
   (Review shows it, with the move it brings when the match names another place); Save changes writes it. Remove match stages a removal the same
   way. The Engine decides the kind of item, the providers and the boxes; the Dashboard only renders what match-setup returns. *@
@if (Subject is not null)
{
    <div class="tl-match" data-testid="match-panel">
        @if (!CanEdit)
        {
            <AppAlert Severity="AppSeverity.Info" Dense="true">@L["EditorMatchPanel_YouCanLookAtMatches"]</AppAlert>
        }

        @if (FlowOwnsRow)
        {
            @FlowHost()
        }
        else if (_wikidata && !_loading)
        {
            <EditorWikidataMatch Subject="Subject" Kind="@_kind" Session="Session" CanEdit="CanEdit" SearchStart="@Subject.Title"
                                 ProviderKey="@ProviderSide?.Key" ProviderName="@ProviderSide?.Name" ProviderItemId="@ProviderSide?.Id" ProviderTitle="@ProviderSide?.Title" ProviderYear="@ProviderSide?.Year"
                                 RowEnd="SwitchPart()">
                @UniverseSection()
            </EditorWikidataMatch>
        }
        else
        {
            <EditorMatchRow>
                <Start>
                    @ProviderPart()
                    @if (ShowsSearchBoxes)
                    {
                        @foreach (var field in _setup!.Fields)
                        {
                            <div class="tl-matchrow__field">
                                <AppTextField Label="@field.Label" Value="@FieldValue(field.Key)" ValueChanged="@(value => OnFieldChangedAsync(field.Key, value))"
                                              aria-label="@field.Label" Placeholder="@(field.Key == "year" ? L["EditorMatchPanel_Optional"].Value : null)"
                                              Immediate="false" Disabled="@(!ProviderIsReady || _searching)" data-testid="@("match-field-" + field.Key)" />
                            </div>
                        }

                        <AppIconButton Icon="@AppMaterialIcons.Outlined.Search" Tooltip="@L["EditorMatchPanel_Search"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary"
                                       Disabled="@(_searching || _wikidata || !CanSearch)" OnClick="StartSearchAsync" data-testid="match-search-button" />
                    }
                </Start>
                <End>@SwitchPart()</End>
            </EditorMatchRow>

            @if (_loading)
            {
                <div aria-busy="true" aria-label="@L["EditorMatchPanel_ReadingMatch"].Value"><AppSkeleton Shape="AppSkeletonShape.Text" Width="60%" /></div>
            }
            else
            {
                @ProvidersSide()
            }
        }
    </div>
}

@code {
    private const string SideProviders = "providers";
    private const string SideWikidata = "wikidata";
    private const string YouTubeProvider = "youtube";

    private CancellationTokenSource? _cts;
    private PendingEditList? _watched;
    private Guid _startedFor;
    private bool _loading;
    private bool _fresh;
    private bool _wikidata;
    private bool _changing;
    private bool _searching;
    private string? _kind;
    private string _provider = string.Empty;
    private string? _fileName;
    private EditorCurrentMatchDto? _current;
    private EditorMatchSetupDto? _setup;
    private EditorMatchContextDto? _tvContext;
    private Dictionary<string, string> _fields = new(StringComparer.OrdinalIgnoreCase);
    private EditorMatchSearchResultDto? _found;
    private EditorMatchResultDto? _selected;
    private EditorMatchResultDto? _edition;
    private string? _problem;
    private string? _staged;
    private string? _stagedMove;
    private bool _staging;
    private ProviderMatchSide? _stagedSide;

    // The provider match as the Wikidata side compares it: what the person has staged, else what the item is matched to. Only read; the two sides never change each other.
    private sealed record ProviderMatchSide(string Key, string Name, string Id, string? Title, string? Year);

    private ProviderMatchSide? ProviderSide => RemovalStaged
        ? null
        : _stagedSide ?? (_current is { State: EditorCurrentMatchStates.Matched, Record: { } record } && !string.IsNullOrWhiteSpace(record.ProviderItemId)
            ? new ProviderMatchSide(record.ProviderId, record.ProviderName, record.ProviderItemId, record.Title, record.Year)
            : null);

    /// <summary>The item being matched; null until the editor's fields have loaded.</summary>
    [Parameter] public EditorMatchSubject? Subject { get; set; }

    /// <summary>The edit session whose pending list the match is staged in.</summary>
    [Parameter, EditorRequired] public EditSessionState? Session { get; set; }

    /// <summary>False when the person may look but not change (the Engine still decides who may edit).</summary>
    [Parameter] public bool CanEdit { get; set; } = true;

    /// <summary>True when the item is not matched yet (or its last match failed): the tab then opens on the search, pre-filled from the file.</summary>
    [Parameter] public bool IsUnmatched { get; set; }

    /// <summary>The Universe the item belongs to, shown with "Open Universe"; null when the item has none.</summary>
    [Parameter] public EditorUniverseLink? Universe { get; set; }

    /// <summary>Raised by "Open Universe". The window closes (asking about unsaved changes) and the Universe page opens; the host does both.</summary>
    [Parameter] public EventCallback<EditorUniverseLink> OnOpenUniverse { get; set; }

    // The Engine's own read wins once the panel has read it again after a save; before that the page's answer (IsUnmatched) decides.
    private bool IsMatched => (_fresh || !IsUnmatched) && !RemovalStaged && _current is { State: EditorCurrentMatchStates.Matched, Record: not null };

    private bool RemovalStaged => Session is not null && Subject is not null
        && Session.Pending.Changes.Any(change => change.Kind == EditSessionChangeKinds.MatchRemoval && change.EntityId == Subject.EntityId);

    // A show page and an episode page use the TV flow, a song uses the music flow; every other kind uses the search below.
    private bool UsesTvBrowser => Subject is not null && EditorTvMatchCandidates.UsesBrowser(Subject.MediaType, Subject.ScopeId);

    // An item with no provider of its own can still offer a box (a local video: paste a YouTube link or ID), so the row follows what the Engine sent.
    private bool HasProviders => _setup is { Providers.Count: > 0 };

    private bool UsesMusicFlow => _kind == MediaEngine.Domain.Configuration.EditorKinds.Song && HasProviders;

    // While the TV or music flow is searching, its own boxes sit in the Match tab's first row, so the tab hands the flow the provider dropdown and
    // the source switch and the flow draws the row. Every other time the tab draws the row itself.
    private bool FlowOwnsRow => (UsesTvBrowser || UsesMusicFlow) && _setup is { NoProvider: false } && !_loading && !_wikidata && (_changing || !IsMatched);

    private bool ShowsSearchBoxes => HasProviders && !UsesTvBrowser && !UsesMusicFlow && (_changing || !IsMatched) && !_wikidata && _loading == false;

    private bool CanSearch => _kind is not null && HasProviders && ProviderIsReady && _setup!.Fields.Count > 0;

    private bool ProviderIsReady => _setup?.Providers.FirstOrDefault(p => p.Name == _provider)?.State == EditorMatchProviderStates.Ready;

    private bool CanApply => CanEdit && Session is { IsActive: true } && (_edition ?? _selected) is not null;

    private IReadOnlyList<AppSelectOption> SideOptions =>
        [new AppSelectOption(SideProviders, L["EditorMatchPanel_MediaProviders"].Value), new AppSelectOption(SideWikidata, L["EditorMatchPanel_Wikidata"].Value)];

    private IReadOnlyList<AppSelectOption> ProviderOptions =>
        [.. (_setup?.Providers ?? []).Select(p => new AppSelectOption(p.Name, L["EditorMatchPanel_ProviderOption", p.DisplayName, StateText(p.State)].Value))];

    private string StateText(string state) => state switch
    {
        EditorMatchProviderStates.NeedsKey => L["EditorMatchPanel_StateNeedsKey"].Value,
        EditorMatchProviderStates.Off => L["EditorMatchPanel_StateOff"].Value,
        _ => L["EditorMatchPanel_StateReady"].Value,
    };

    protected override async Task OnParametersSetAsync()
    {
        Watch();
        if (Subject is null || _startedFor == Subject.EntityId)
        {
            return;
        }

        _startedFor = Subject.EntityId;
        _fresh = false;
        await LoadAsync();
    }

    // Opening only reads: what the item is matched to (found by its stored id) and what the search would start from. No search runs.
    private async Task LoadAsync()
    {
        if (Subject is null)
        {
            return;
        }

        _cts?.Cancel();
        _wikidata = false;
        _changing = false;
        _searching = false;
        _current = null;
        _setup = null;
        _tvContext = null;
        _found = null;
        _selected = null;
        _edition = null;
        _problem = null;
        _staged = null;
        _stagedMove = null;
        _stagedSide = null;
        _fileName = null;
        _fields = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        _loading = true;

        var id = Subject.EntityId;
        var current = Api.GetEditorCurrentMatchAsync(id);
        var setup = Api.GetEditorMatchSetupAsync(id);
        var context = UsesTvBrowser ? Api.GetEditorMatchContextAsync(id) : Task.FromResult<EditorMatchContextDto?>(null);
        await Task.WhenAll(current, setup, context);
        if (_startedFor != id)
        {
            return;
        }

        _current = await current;
        _setup = await setup;
        _tvContext = await context;
        _kind = _setup?.Kind;
        _fileName = _setup?.FileName ?? _current?.FileName ?? _tvContext?.FileName;
        if (_setup is { Providers.Count: > 0 } ready)
        {
            _provider = ready.Providers.FirstOrDefault(p => p.IsDefault)?.Name ?? ready.Providers[0].Name;
            foreach (var field in ready.Fields)
            {
                _fields[field.Key] = field.Value;
            }
        }

        // An item with no match yet opens on the search; one with a match opens on the match. Either way nothing has been asked of a provider.
        _changing = !IsMatched;
        _loading = false;
    }

    // After Save the staged match has left the pending list: the note clears and the panel reads what the Engine now has.
    private void Watch()
    {
        if (ReferenceEquals(_watched, Session?.Pending))
        {
            return;
        }

        if (_watched is not null)
        {
            _watched.Changed -= OnPendingChanged;
        }

        _watched = Session?.Pending;
        if (_watched is not null)
        {
            _watched.Changed += OnPendingChanged;
        }
    }

    private void OnPendingChanged()
    {
        if (_staged is null || Subject is null || _loading || _staging)
        {
            return;
        }

        var id = Subject.EntityId;
        if (_watched!.Changes.Any(change => change.EntityId == id && change.Kind is EditSessionChangeKinds.Identity or EditSessionChangeKinds.MatchRemoval))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            _fresh = true;
            await LoadAsync();
            StateHasChanged();
        });
    }

    private Task OnProviderChanged(string? value)
    {
        _provider = value ?? _provider;
        _found = null;
        _selected = null;
        _edition = null;
        _problem = null;
        return Task.CompletedTask;
    }

    private Task OnSideChanged(string value)
    {
        _wikidata = value == SideWikidata;
        return Task.CompletedTask;
    }

    // The filled Search in the first row: opens the compact search in place and asks the provider with the boxes as they stand.
    private async Task StartSearchAsync()
    {
        _changing = true;
        _staged = null;
        await SearchAsync();
    }

    private void StartChange()
    {
        _changing = true;
        _staged = null;
        _found = null;
        _selected = null;
        _edition = null;
        _problem = null;
    }

    private void CancelChange()
    {
        _changing = false;
        _found = null;
        _selected = null;
        _edition = null;
        _problem = null;
    }

    private async Task OnFieldChangedAsync(string key, string? value)
    {
        _fields[key] = value?.Trim() ?? string.Empty;
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (Subject is null || !CanSearch)
        {
            return;
        }

        _cts?.Cancel();
        _cts?.Dispose();
        var source = _cts = new CancellationTokenSource();
        _searching = true;
        _problem = null;
        _found = null;
        _selected = null;
        _edition = null;
        StateHasChanged();
        try
        {
            var request = new EditorMatchSearchRequestDto
            {
                Provider = _provider,
                Fields = new Dictionary<string, string>(_fields, StringComparer.OrdinalIgnoreCase),
            };
            var found = await Api.SearchEditorMatchAsync(Subject.EntityId, request, source.Token);
            if (source.IsCancellationRequested)
            {
                return;
            }

            _found = found;
            if (found is null)
            {
                _problem = L["EditorMatchPanel_CouldNotReachEngine"].Value;
            }
            else
            {
                // The best result is chosen for the person, with the edition the Engine says is closest to the file.
                _selected = found.Results.FirstOrDefault();
                _edition = _selected?.Editions.FirstOrDefault(edition => edition.IsSuggested) ?? _selected?.Editions.FirstOrDefault();
            }
        }
        finally
        {
            if (!source.IsCancellationRequested)
            {
                _searching = false;
            }
        }
    }

    private Task OnSelectedAsync(EditorMatchResultDto result)
    {
        _selected = result;
        _edition = result.Editions.FirstOrDefault(edition => edition.IsSuggested) ?? result.Editions.FirstOrDefault();
        return Task.CompletedTask;
    }

    private Task OnEditionAsync(EditorMatchResultDto edition)
    {
        _edition = edition;
        return Task.CompletedTask;
    }

    // Stages the choice: an Identity entry in the pending list, plus the move the match brings when it names another place (a Relationship
    // change, and a FileMove only in a Managed folder). Review shows them and Save changes writes them. Nothing is written here.
    private Task ApplyAsync() => (_edition ?? _selected) is { } chosen ? ApplyCandidateAsync(chosen.Candidate) : Task.CompletedTask;

    // The TV and music flows hand up the record they judged; it is staged exactly as a search result is.
    private async Task ApplyCandidateAsync(ItemCanonicalRetailCandidateDto candidate)
    {
        if (!CanEdit || Subject is null || Session is not { IsActive: true })
        {
            return;
        }

        var id = Subject.EntityId;
        var request = EditorMatchRules.RequestFor(candidate, Subject, Subject.TargetGroup);
        var facts = EditorMatchRules.FactsOf(candidate);
        _staging = true;
        try
        {
            Unstage(EditSessionChangeKinds.MatchRemoval);
            Session.Pending.SetTarget(
                EditSessionChangeKinds.Identity,
                id,
                EditSessionIdentityTarget.Serialize(request),
                label: $"{facts.Title} ({facts.Provider})",
                before: MatchBefore());

            // Where would the matched record put this item? A video has no place to move to; everything else asks the Engine.
            var placement = string.Equals(candidate.ProviderName, YouTubeProvider, StringComparison.OrdinalIgnoreCase)
                ? null
                : await Api.GetEditorMatchPlacementAsync(id, candidate);
            StagePlacement(id, placement);
            await StageShowRematchAsync(id, candidate);
        }
        finally
        {
            _staging = false;
        }

        _stagedSide = new ProviderMatchSide(candidate.ProviderId, candidate.ProviderName, candidate.ProviderItemId ?? string.Empty, facts.Title, facts.Year);
        _staged = $"{facts.Title} ({facts.Provider})";
        _changing = false;
        _found = null;
        _selected = null;
        _edition = null;
    }

    // A show whose match changes takes its seasons and episodes with it: one Review row says how many follow by number and how many go to
    // Needs Review. No switch and no table; the person sees the count and Save changes does the rest.
    private async Task StageShowRematchAsync(Guid id, ItemCanonicalRetailCandidateDto candidate)
    {
        Unstage(EditSessionChangeKinds.ChildRematch);
        if (Subject is not { ScopeId: var scope } || !string.Equals(scope, "series", StringComparison.OrdinalIgnoreCase)
            || _setup is null
            || !_setup.Providers.Any(provider => string.Equals(provider.Name, candidate.ProviderName, StringComparison.OrdinalIgnoreCase))
            || string.IsNullOrWhiteSpace(candidate.ProviderItemId))
        {
            return;
        }

        var preview = await Api.PreviewShowChildRematchAsync(id, candidate.ProviderItemId);
        if (preview is null || preview.EpisodeCount == 0)
        {
            return;
        }

        Session!.Pending.SetTarget(
            EditSessionChangeKinds.ChildRematch,
            id,
            EditSessionChildRematchTarget.Serialize(new ShowChildRematchTarget { SeriesId = candidate.ProviderItemId }),
            label: L["EditorMatchPanel_EpisodesFollow", preview.MatchableCount, candidate.Title, preview.NotFoundCount].Value,
            before: L["EditorMatchPanel_EpisodesAsTheyAre"].Value);
    }

    private void StagePlacement(Guid id, EditorMatchPlacementDto? placement)
    {
        EditorMatchStaging.StageMove(Session!.Pending, id, placement);
        _stagedMove = null;
        if (placement is null)
        {
            return;
        }

        if (placement.DestinationId is not null && !string.IsNullOrWhiteSpace(placement.ParentLabel))
        {
            _stagedMove = L["EditorMatchPanel_StagedMoves", placement.ParentLabel].Value;
        }

        // Files follow the match only in a Managed folder; a read-only folder keeps its files and the match still applies.
        if (!placement.Managed && placement.DestinationId is not null)
        {
            _stagedMove = string.Join(" ", new[] { _stagedMove, L["EditorMatchPanel_StagedFilesStay"].Value }.Where(part => !string.IsNullOrWhiteSpace(part)));
        }

        if (!string.IsNullOrWhiteSpace(placement.BlockedReason))
        {
            _stagedMove = string.Join(" ", new[] { _stagedMove, placement.BlockedReason }.Where(part => !string.IsNullOrWhiteSpace(part)));
        }
    }

    // Remove match: one staged change; the match, its provider ids and bridge ids go on Save, nothing else (details, pictures and the Wikidata id stay).
    private void RemoveMatch()
    {
        if (!CanEdit || Subject is not { } subject || Session is not { IsActive: true } || !IsMatched)
        {
            return;
        }

        _staging = true;
        try
        {
            Unstage(EditSessionChangeKinds.Identity);
            Unstage(EditSessionChangeKinds.Relationship);
            Unstage(EditSessionChangeKinds.FileMove);
            Unstage(EditSessionChangeKinds.ChildRematch);
            Session.Pending.SetTarget(
                EditSessionChangeKinds.MatchRemoval,
                subject.EntityId,
                null,
                label: L["EditorMatchPanel_NoMatch"].Value,
                before: MatchBefore());
        }
        finally
        {
            _staging = false;
        }

        _staged = L["EditorMatchPanel_RemovalStaged"].Value;
        _stagedSide = null;
        _stagedMove = null;
        _changing = true;
        _found = null;
        _selected = null;
        _edition = null;
    }

    private void Unstage(string kind)
    {
        if (Session is null || Subject is null)
        {
            return;
        }

        var existing = Session.Pending.Changes.FirstOrDefault(change => change.Kind == kind && change.EntityId == Subject.EntityId);
        if (existing is not null)
        {
            Session.Pending.Remove(existing.Id);
        }
    }

    private string MatchBefore() => _current is { State: EditorCurrentMatchStates.Matched, Record: { } record }
        ? string.Join(" · ", new[] { record.Title, record.ProviderName }.Where(part => !string.IsNullOrWhiteSpace(part)))
        : L["EditorMatchPanel_NotMatchedYet"].Value;

    private RenderFragment ProvidersSide() => __builder =>
    {
        if (_kind is null && _setup is null)
        {
            <AppAlert Severity="AppSeverity.Warning" Dense="true">@L["EditorMatchPanel_CouldNotReadSetup"]</AppAlert>
            return;
        }

        if (_setup is { NoProvider: true })
        {
            <AppAlert Severity="AppSeverity.Info" Dense="true" data-testid="match-no-provider">@(_setup.NoProviderMessage ?? L["EditorMatchPanel_NoProvider"].Value)</AppAlert>
            if (!HasProviders)
            {
                return;
            }
        }

        // A matched item that is not being changed shows its staged note here; while searching, the note sits inside the search section.
        if (!_changing && IsMatched)
        {
            @StagedNote()
            @CurrentCard(_current!)
            @WhyTable(_current!)
        }
        else
        {
            @SearchSection()
        }
    };

    private RenderFragment CurrentCard(EditorCurrentMatchDto current) => __builder =>
    {
        var record = current.Record!;
        var idText = string.IsNullOrWhiteSpace(record.ProviderItemId) ? record.ProviderName : $"{record.ProviderName} · {record.ProviderItemId}";
        <section class="tl-matchcard" aria-label="@L["EditorMatchPanel_CurrentMatch"].Value" data-testid="match-current">
            @if (!string.IsNullOrWhiteSpace(record.ImageUrl))
            {
                <AppImage Src="@record.ImageUrl" Alt="" Width="64" Height="96" ObjectFit="AppObjectFit.Cover" Class="tl-match__art tl-matchcard__art" />
            }
            else
            {
                <span class="tl-match__art tl-match__art--empty tl-matchcard__art" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Image" /></span>
            }
            <div class="tl-match__text">
                <div class="tl-match__title"><span class="tl-match__meta">@L["EditorMatchPanel_CurrentMatch"]</span> <AppChip Text="@L["EditorMatchPanel_Matched"].Value" Tone="AppUiTone.Success" />@if (current.Pinned) { <AppChip Text="@L["EditorMatchPanel_ChosenByYou"].Value" Tone="AppUiTone.Neutral" /> }</div>
                <div class="tl-matchcard__name">@record.Title</div>
                <div class="tl-match__meta" data-testid="match-current-id">@idText</div>
                <div class="tl-match__meta">@string.Join(" · ", new[] { record.Kind, record.Year }.Where(part => !string.IsNullOrWhiteSpace(part)))</div>
                @if (!string.IsNullOrWhiteSpace(record.Creator))
                {
                    <div class="tl-match__meta" data-testid="match-current-creator">@CreatorLine(record)</div>
                }
                @if (!string.IsNullOrWhiteSpace(current.Note))
                {
                    <div class="tl-match__meta">@current.Note</div>
                }
            </div>
            <div class="tl-matchcard__actions">
                @if (!string.IsNullOrWhiteSpace(record.SourceUrl))
                {
                    <AppButton Label="@L["EditorMatchPanel_OpenSource"].Value" Href="@record.SourceUrl" Target="_blank" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact" />
                }
                <AppButton Label="@L["EditorMatchPanel_RemoveMatch"].Value" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Error" Size="AppControlSize.Compact"
                           Disabled="@(!CanEdit || Session is not { IsActive: true })" OnClick="RemoveMatch" data-testid="match-remove" />
                <AppButton Label="@L["EditorMatchPanel_ChangeMatch"].Value" StartIcon="@AppMaterialIcons.Outlined.Search" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact"
                           Disabled="@(!CanEdit || Session is not { IsActive: true })" OnClick="StartChange" data-testid="match-change" />
            </div>
        </section>
    };

    // "Directed by" belongs to a film; every other kind of record just names its creator.
    private string CreatorLine(EditorMatchedRecordDto record) =>
        string.Equals(record.Kind, "Film", StringComparison.OrdinalIgnoreCase) ? L["EditorMatchPanel_DirectedBy", record.Creator!].Value : record.Creator!;

    private RenderFragment WhyTable(EditorCurrentMatchDto current) => __builder =>
    {
        var checkedRows = current.Why.Where(row => row.State != EditorMatchEvidenceStates.NotChecked).ToList();
        var notChecked = current.Why.Where(row => row.State == EditorMatchEvidenceStates.NotChecked).ToList();
        var rows = checkedRows.Select(row => new EditorEvidenceCard.Row(
            WhyFieldLabel(row.Field), WhyValue(row, row.YourFile, true), WhyValue(row, row.MatchedRecord, false), row.State,
            row.Verdict is null ? null : EditorMatchResults.VerdictText(row.Verdict))).ToList();
        <EditorEvidenceCard Title="@L["EditorMatchPanel_WhyThisMatch"].Value" YourLabel="@L["EditorMatchPanel_YourFile"].Value" OtherLabel="@L["EditorMatchPanel_MatchedRecord"].Value"
                            Rows="rows" data-testid="match-why">
            <Header>
                @if (current.Verdict is { } verdict)
                {
                    <AppChip Text="@L["EditorMatchPanel_MatchVerdict", EditorMatchResults.VerdictText(verdict)].Value" Tone="@EditorMatchResults.VerdictTone(verdict)" />
                }
            </Header>
            <Footer>
                @foreach (var row in notChecked)
                {
                    <p class="tl-match__meta tl-matchwhy__footnote" data-testid="match-why-footnote">@L["EditorMatchPanel_NotCheckedNote", WhyFieldLabel(row.Field)]</p>
                }
                <p class="tl-match__meta">@L["EditorMatchPanel_ChangingKeepsLocked"]</p>
            </Footer>
        </EditorEvidenceCard>
    };

    // The measured length and the provider's rounded one say so inside their cells.
    private string WhyValue(EditorMatchEvidenceRowDto row, string? value, bool yours)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "–";
        }

        return row.Field != "runtime" ? value : yours ? L["EditorMatchPanel_Measured", value].Value : L["EditorMatchPanel_Rounded", value].Value;
    }

    private string WhyFieldLabel(string field) => field switch
    {
        "title" => L["EditorMatchPanel_FieldTitle"].Value,
        "year" => L["EditorMatchPanel_FieldYear"].Value,
        "season_number" => L["EditorMatchPanel_FieldSeason"].Value,
        "episode_number" => L["EditorMatchPanel_FieldEpisode"].Value,
        "runtime" => L["EditorMatchPanel_FieldRuntime"].Value,
        _ => field.Replace('_', ' '),
    };

    private RenderFragment ProviderPart() => __builder =>
    {
        if (HasProviders)
        {
            <div class="tl-matchrow__provider">
                <AppSelect Value="@_provider" ValueChanged="OnProviderChanged" Options="@ProviderOptions" Label="@L["EditorMatchPanel_Provider"].Value" Disabled="@(_searching || _wikidata)" />
            </div>
        }
    };

    private RenderFragment SwitchPart() => __builder =>
    {
        <AppSegmentedControl Options="@SideOptions" Value="@(_wikidata ? SideWikidata : SideProviders)" ValueChanged="OnSideChanged" AriaLabel="@L["EditorMatchPanel_MatchSource"].Value" />
    };

    private RenderFragment StagedNote() => __builder =>
    {
        if (_staged is not null)
        {
            <AppAlert Severity="AppSeverity.Success" Dense="true" data-testid="match-staged">@L["EditorMatchPanel_Staged", _staged]@if (!string.IsNullOrWhiteSpace(_stagedMove)) { <span data-testid="match-staged-move"> @_stagedMove</span> }</AppAlert>
        }
    };

    private RenderFragment SearchHeading() => __builder =>
    {
        <div>
            <h3 class="tl-matchsearch__heading">@L["EditorMatchPanel_MatchKind", KindWord]</h3>
            @if (!IsMatched)
            {
                <span class="tl-matchsearch__tag"><NotMatchedTag /> <span class="tl-match__meta">@L["EditorMatchPanel_NotMatchedYet"]</span></span>
            }
        </div>
        @if (YourFileLine() is { Length: > 0 } fileLine)
        {
            <div class="tl-match__meta" data-testid="match-your-file">@L["EditorMatchPanel_YourFileLine", fileLine]</div>
        }
    };

    // What the flow shows under the row it draws: a staged note, the heading with the "Not matched yet" tag, and the file the Engine read.
    private RenderFragment FlowLead() => __builder =>
    {
        @StagedNote()
        @SearchHeading()
    };

    private RenderFragment FlowHost() => __builder =>
    {
        <section class="tl-matchsearch" aria-label="@L["EditorMatchPanel_Match"].Value" data-testid="match-search">
            @if (UsesTvBrowser)
            {
                <EditorTvMatchFlow Subject="Subject" Unmatched="@(!IsMatched)" Context="_tvContext" Evidence="_setup?.Evidence" CanApply="@(CanEdit && Session is { IsActive: true })"
                                   ShowCancel="IsMatched" OnApplyMatch="ApplyCandidateAsync" OnCancel="CancelChange"
                                   RowStart="ProviderPart()" RowEnd="SwitchPart()" Lead="FlowLead()" />
            }
            else
            {
                <EditorMusicMatchFlow Subject="Subject" Fields="_setup!.Fields" Evidence="_setup.Evidence" CanApply="@(CanEdit && Session is { IsActive: true })"
                                      ShowCancel="IsMatched" OnApplyMatch="ApplyCandidateAsync" OnCancel="CancelChange"
                                      RowStart="ProviderPart()" RowEnd="SwitchPart()" Lead="FlowLead()" />
            }
        </section>
    };

    private RenderFragment SearchSection() => __builder =>
    {
        <section class="tl-matchsearch" aria-label="@L["EditorMatchPanel_Match"].Value" data-testid="match-search">
            @StagedNote()
            @SearchHeading()
            @if (HasProviders && !ProviderIsReady)
            {
                <AppAlert Severity="AppSeverity.Info" Dense="true">@ProviderStateSentence</AppAlert>
            }

            <EditorMatchResults Results="@(_found?.Results ?? [])" Evidence="_found?.Evidence ?? _setup?.Evidence"
                                Selected="_selected" SelectedChanged="OnSelectedAsync" Edition="_edition" EditionChanged="OnEditionAsync"
                                Loading="_searching" Message="@(_problem ?? _found?.Message)" Failed="@(_problem is not null || _found?.FailedProviders.Count > 0)"
                                CanApply="CanApply" OnApply="ApplyAsync" ShowCancel="IsMatched" OnCancel="CancelChange" />
        </section>
    };

    // The muted line under the heading: what the Engine read from the file (cleaned name, year, measured length).
    private string YourFileLine()
    {
        var evidence = _setup?.Evidence;
        var parts = new[] { _fileName, evidence?.Year, evidence?.MeasuredText };
        return string.Join(" · ", parts.Where(part => !string.IsNullOrWhiteSpace(part)));
    }

    private string FieldValue(string key) => _fields.TryGetValue(key, out var value) ? value : string.Empty;

    private string ProviderStateSentence => _setup?.Providers.FirstOrDefault(p => p.Name == _provider) is { } provider
        ? provider.State == EditorMatchProviderStates.NeedsKey
            ? L["EditorMatchPanel_NeedsKeySentence", provider.DisplayName].Value
            : L["EditorMatchPanel_OffSentence", provider.DisplayName].Value
        : L["EditorMatchPanel_ChooseProvider"].Value;

    private string KindWord => _kind switch
    {
        "movie" => L["EditorMatchPanel_KindMovie"].Value,
        "book" => L["EditorMatchPanel_KindBook"].Value,
        "audiobook" => L["EditorMatchPanel_KindAudiobook"].Value,
        "comic" => L["EditorMatchPanel_KindComic"].Value,
        "tv_show" => L["EditorMatchPanel_KindShow"].Value,
        "tv_season" => L["EditorMatchPanel_KindSeason"].Value,
        "tv_episode" => L["EditorMatchPanel_KindEpisode"].Value,
        "album" => L["EditorMatchPanel_KindAlbum"].Value,
        "song" => L["EditorMatchPanel_KindSong"].Value,
        "video" => L["EditorMatchPanel_KindVideo"].Value,
        _ => L["EditorMatchPanel_KindItem"].Value,
    };

    // The Universe the item belongs to. "Open Universe" closes the editor, asking about unsaved changes first.
    private RenderFragment UniverseSection() => __builder =>
    {
        if (Universe is not { } universe)
        {
            return;
        }

        <section class="tl-match__universe" aria-label="@L["EditorMatchPanel_Universe"].Value" data-testid="match-universe">
            <h3 class="tl-match__section-heading">@L["EditorMatchPanel_Universe"]</h3>
            <div class="tl-match__row">
                @if (!string.IsNullOrWhiteSpace(universe.ImageUrl))
                {
                    <AppImage Src="@universe.ImageUrl" Alt="" Width="48" Height="48" ObjectFit="AppObjectFit.Cover" Class="tl-match__art" />
                }
                else
                {
                    <span class="tl-match__art tl-match__art--empty" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Public" /></span>
                }
                <div class="tl-match__text"><div class="tl-match__title"><span>@universe.Name</span></div></div>
                <AppButton Label="@L["EditorMatchPanel_OpenUniverse"].Value" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact"
                           OnClick="@(() => OnOpenUniverse.InvokeAsync(universe))" />
            </div>
        </section>
    };

    public void Dispose()
    {
        if (_watched is not null)
        {
            _watched.Changed -= OnPendingChanged;
        }

        _cts?.Cancel();
        _cts?.Dispose();
    }
}
