@namespace MediaEngine.Web.Components.Editor
@using MediaEngine.Contracts.Editing
@using MediaEngine.Contracts.Items
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@implements IAsyncDisposable
@inject IEngineApiClient Api
@inject ILogger<EditorVideoOrderList> Logger
@inject IJSRuntime JS
@inject IStringLocalizer<SharedStrings> L

@* The order of a Videos series (universal editor v3.1 WP2 and WP3, v5 D19): the videos of a series, or of one section of it, in the order the
   person wants, by drag and drop or Move up and Move down, and a series with sections lets a video be dragged from one section to another. One
   list serves both places that show it: the Reorder videos mode of the item dropdown, and the Videos view of the supporting-files browser. Everything
   here only stages a change: Save changes shows it in Review first, and none of it moves a file. The one exception is the "Rename the files to match
   this order" switch, off by default and offered only when every video is in a Managed folder. In Reorder mode (HoldChanges, the header lists) the
   arrangement is held here until the shared Reorder bar's Save order calls CommitAsync, so Cancel leaves nothing staged (v6 D23). *@
@if (_editor.HasSomethingToOrder)
{
    <section class="tl-vorder" data-testid="video-order-section" @ref="_root">
        @* Move up and Move down are said aloud ("Moved Lesson 3 to position 2") so the order can be followed without seeing the list. *@
        <div class="sr-only" role="status" aria-live="polite" data-testid="video-order-announce">@_announcement</div>
        @if (!Compact)
        {
            <h3 class="tl-vorder__heading">@L["EditorVideoSeries_OrderHeading"]</h3>
        }

        @for (var listIndex = 0; listIndex < _editor.Lists.Count; listIndex++)
        {
            var list = _editor.Lists[listIndex];
            var li = listIndex;
            if (OnlyList is { } only && _editor.IndexOfList(only) >= 0 && list.ParentId != only)
            {
                continue;
            }

            <div class="tl-vorder__list" data-testid="video-order-list">
                @if (_editor.HasSections && !Compact)
                {
                    <h4 class="tl-vorder__section">@list.Title</h4>
                }

                @if (ShowSort)
                {
                    <div class="tl-vorder__sort">
                        <AppButton Label="@L["EditorVideoSeries_SortByFileName"].Value" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact"
                                   Disabled="@(!CanChange || list.Current.Count < 2)" OnClick="@(() => SortAsync(li, VideoSortBy.FileName))" />
                        <AppButton Label="@L["EditorVideoSeries_SortByDateAdded"].Value" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact"
                                   Disabled="@(!CanChange || list.Current.Count < 2)" OnClick="@(() => SortAsync(li, VideoSortBy.DateAdded))" />
                        @if (list.IsChanged || Pending?.FindVideoOrder(list.ParentId) is not null)
                        {
                            <AppButton Label="@L["EditorVideoSeries_Reset"].Value" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact"
                                       OnClick="ResetAsync" />
                        }
                    </div>
                }

                <ol class="tl-vorder__rows" aria-label="@L["EditorVideoSeries_OrderHeading"].Value">
                    @for (var rowIndex = 0; rowIndex < list.Current.Count; rowIndex++)
                    {
                        var row = list.Current[rowIndex];
                        var ri = rowIndex;
                        <li class="tl-vorder__row" data-vo-list="@li" data-vo-row="@ri" data-vo-title="@row.Title" @key="row.Id">
                            <AppTooltip Text="@L["EditorVideoSeries_DragToReorder", row.Title].Value">
                                <span class="tl-vorder__grip" data-vo-handle draggable="@(CanChange ? "true" : "false")" aria-hidden="true">
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.DragIndicator" />
                                </span>
                            </AppTooltip>
                            <span class="tl-vorder__position" aria-label="@L["EditorVideoSeries_Position", ri + 1].Value">@(ri + 1)</span>
                            <span class="tl-vorder__title" data-overflow-tooltip="@row.Title">@row.Title</span>
                            <span class="tl-vorder__arrows">
                                <AppIconButton Icon="@AppMaterialIcons.Outlined.ArrowUpward" Size="AppControlSize.Compact" Tooltip="@L["EditorVideoSeries_MoveUp", row.Title].Value"
                                               AriaLabel="@L["EditorVideoSeries_MoveUp", row.Title].Value" Disabled="@(!CanChange || !_editor.CanMoveUp(li, ri))"
                                               OnClick="@(() => NudgeAsync(li, ri, -1))" />
                                <AppIconButton Icon="@AppMaterialIcons.Outlined.ArrowDownward" Size="AppControlSize.Compact" Tooltip="@L["EditorVideoSeries_MoveDown", row.Title].Value"
                                               AriaLabel="@L["EditorVideoSeries_MoveDown", row.Title].Value" Disabled="@(!CanChange || !_editor.CanMoveDown(li, ri))"
                                               OnClick="@(() => NudgeAsync(li, ri, 1))" />
                            </span>
                        </li>
                    }
                </ol>

                @if (list.CanRenameFiles && list.Current.Count > 0)
                {
                    <AppSwitchRow Label="@L["EditorVideoSeries_RenameFiles"].Value"
                                  Description="@L["EditorVideoSeries_RenameDescription"].Value"
                                  Value="@RenameOn(list)"
                                  ValueChanged="@(value => SetRenameAsync(list, value))"
                                  Disabled="@(!CanChange)" />
                }
            </div>
        }

        @if (_editor.WhatWillHappen(_editor.Lists.Any(RenameOn)) is { Length: > 0 } happen)
        {
            <p class="tl-vorder__happen" data-testid="video-order-happen"><strong>@L["EditorVideoSeries_WhatWillHappen"]</strong> @happen</p>
        }
    </section>
}
else if (_loaded && HoldChanges)
{
    <div class="tl-vorder__empty" data-testid="video-order-empty">
        <p>@L["EditorReorder_NothingToOrder"]</p>
    </div>
}

@code {
    private readonly VideoOrderEditor _editor = new();
    private ElementReference _root;
    private Guid _loadedFor;
    private bool _loaded;
    // The element the drag script is attached to; a new element (another video was opened) needs it attached again.
    private string? _attachedTo;
    private IJSObjectReference? _module;
    private DotNetObjectReference<EditorVideoOrderList>? _self;
    // Reorder mode: the "Rename the files" choices made but not yet staged, by list.
    private readonly Dictionary<Guid, bool> _renameHeld = [];
    private bool _lastDirty;

    /// <summary>An item of the series (the series itself, a section or one video); the Engine reads the series' lists from it.</summary>
    [Parameter, EditorRequired] public Guid EntityId { get; set; }

    /// <summary>The series' own title, used when it has no sections.</summary>
    [Parameter] public string? SeriesTitle { get; set; }

    [Parameter] public EditSessionState? Session { get; set; }

    /// <summary>The editor's family tree, so it can show the order as it is being arranged.</summary>
    [Parameter] public EditorFamilyState? Family { get; set; }

    [Parameter] public bool CanEdit { get; set; }

    /// <summary>Shows only this list (the section the dropdown is on), when the series has it; null shows every list.</summary>
    [Parameter] public Guid? OnlyList { get; set; }

    /// <summary>Orders the sections of the series instead of the videos in them (the Section dropdown's Reorder mode).</summary>
    [Parameter] public bool SectionsMode { get; set; }

    // The sections become the rows of one list whose parent is the series, so the staged change is one order change on the series.
    private VideoOrderResponse SectionsOf(VideoOrderResponse? order, Guid seriesId) => new()
    {
        Groups = (order?.Groups.Count ?? 0) < 2
            ? []
            :
            [
                new VideoOrderGroupDto
                {
                    ParentId = seriesId,
                    Title = SeriesTitle ?? string.Empty,
                    Entries = [.. order!.Groups.Select(group => new VideoOrderEntryDto { Id = group.ParentId, Title = group.Title })],
                },
            ],
    };

    /// <summary>The dropdown's slim form: no heading, no section titles.</summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>Shows the one-time Sort by file name and Sort by date added buttons.</summary>
    [Parameter] public bool ShowSort { get; set; } = true;

    /// <summary>Reorder mode (the header lists, v6 D23): the arrangement is only held here, and staged by <see cref="CommitAsync"/> (the Reorder bar's Save order). Left off, every change is staged as it is made.</summary>
    [Parameter] public bool HoldChanges { get; set; }

    /// <summary>Raised in Reorder mode when the held arrangement starts or stops differing from the one the mode began with; Save order waits for it.</summary>
    [Parameter] public EventCallback<bool> OnDirtyChanged { get; set; }

    /// <summary>
    /// Reorder mode (the header lists): an arrangement an earlier list of the same header held and left in the session (the window crossed 1024 wide and
    /// the header was drawn again); it is put back when the lists have been read, so a half-arranged order is not lost.
    /// </summary>
    [Parameter] public HeldVideoOrder? Resume { get; set; }

    /// <summary>The arrangement held in Reorder mode and not staged yet, or null when there is none.</summary>
    public HeldVideoOrder? Hold() =>
        HoldChanges && IsDirty ? new HeldVideoOrder(SectionsMode, _editor.Arrangement, new Dictionary<Guid, bool>(_renameHeld)) : null;

    /// <summary>Raised after the arrangement changed and was staged, so a list that shows the same videos can follow the new order.</summary>
    [Parameter] public EventCallback<IReadOnlyList<Guid>> OnOrderChanged { get; set; }

    /// <summary>True in Reorder mode once the held arrangement (or a held "Rename the files" choice) differs from the one the mode began with.</summary>
    public bool IsDirty => HoldChanges && (_editor.DiffersFromBaseline || _renameHeld.Any(held => held.Value != (Pending?.FindVideoRename(held.Key) is not null)));

    private bool RenameOn(VideoOrderList list) =>
        HoldChanges && _renameHeld.TryGetValue(list.ParentId, out var held) ? held : Pending?.FindVideoRename(list.ParentId) is not null;

    private PendingEditList? Pending => Session?.Pending;

    private bool CanChange => CanEdit && Session is { IsActive: true };

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == EntityId)
        {
            return;
        }

        var id = EntityId;
        _loadedFor = id;
        _loaded = false;
        if (id == Guid.Empty)
        {
            _editor.Load(null);
            return;
        }

        try
        {
            var order = await Api.GetVideoOrderAsync(id);
            if (_loadedFor != id)
            {
                return;
            }

            _editor.OrdersSections = SectionsMode;
            _editor.Load(SectionsMode ? SectionsOf(order, id) : order, SeriesTitle);
            // What was staged earlier (switching items keeps every item's changes) is shown again, not lost.
            if (Pending is { } pending)
            {
                _editor.Restore(pending);
            }

            _editor.MarkBaseline();
            _renameHeld.Clear();
            if (HoldChanges && Resume is { } resume && resume.SectionsMode == SectionsMode)
            {
                _editor.Apply(resume.Lists);
                foreach (var (parentId, on) in resume.Renames)
                {
                    _renameHeld[parentId] = on;
                }
            }

            _loaded = true;
            await NotifyDirtyAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "The order of video series {EntityId} could not be read for the editor", id);
            _editor.Load(null);
            // Forget that this item was loaded, so the next time the list is shown it reads again instead of staying blank.
            _loadedFor = Guid.Empty;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_attachedTo == _root.Id || !_editor.HasSomethingToOrder || _root.Context is null)
        {
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/video-order-drag.js");
            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _root, _self);
            _attachedTo = _root.Id;
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException or JSDisconnectedException)
        {
            // No script support here (a test host, a closing circuit): the arrows still reorder, so the list is fully usable without drag.
            Logger.LogDebug(ex, "Drag and drop for the series order could not start; the arrows still work");
        }
    }

    private string _announcement = string.Empty;

    private Task NudgeAsync(int list, int index, int step)
    {
        var title = _editor.Lists[list].Current[index].Title;
        var changed = _editor.Nudge(list, index, step);
        if (changed)
        {
            _announcement = string.Format(L["EditorReorder_Moved"].Value, title, index + step + 1);
        }

        return ChangedAsync(changed);
    }

    private Task SortAsync(int list, VideoSortBy by)
    {
        _editor.Sort(list, by);
        return ChangedAsync(true);
    }

    private Task ResetAsync()
    {
        _editor.Reset();
        return ChangedAsync(true);
    }

    [JSInvokable]
    public Task OnDropAsync(int fromList, int fromIndex, int toList, int insertAt) =>
        InvokeAsync(() => ChangedAsync(CanChange && _editor.Drop(fromList, fromIndex, toList, insertAt)));

    [JSInvokable]
    public Task OnDropOnParentAsync(int fromList, int fromIndex, string parentId) =>
        InvokeAsync(() =>
        {
            if (!CanChange || !Guid.TryParse(parentId, out var parent))
            {
                return Task.CompletedTask;
            }

            var target = _editor.IndexOfList(parent);
            return ChangedAsync(target >= 0 && _editor.Drop(fromList, fromIndex, target, _editor.Lists[target].Current.Count));
        });

    private async Task ChangedAsync(bool changed)
    {
        if (!changed)
        {
            return;
        }

        if (HoldChanges)
        {
            StateHasChanged();
            await NotifyDirtyAsync();
            return;
        }

        if (Pending is { } pending)
        {
            await StageAsync(pending);
        }
    }

    /// <summary>
    /// Save order (Reorder mode): stages the held arrangement as the one order change (and any held rename choice) the editor's Save changes
    /// will write and Review changes will list. False when there is no active edit session to stage into.
    /// </summary>
    public async Task<bool> CommitAsync()
    {
        if (!CanChange || Pending is not { } pending)
        {
            return false;
        }

        foreach (var (parentId, on) in _renameHeld)
        {
            var at = _editor.IndexOfList(parentId);
            if (at >= 0)
            {
                ApplyRename(pending, _editor.Lists[at], on);
            }
        }

        _renameHeld.Clear();
        await StageAsync(pending);
        _editor.MarkBaseline();
        await NotifyDirtyAsync();
        return true;
    }

    private async Task NotifyDirtyAsync()
    {
        var dirty = IsDirty;
        if (dirty != _lastDirty)
        {
            _lastDirty = dirty;
            await OnDirtyChanged.InvokeAsync(dirty);
        }
    }

    private async Task StageAsync(PendingEditList pending)
    {
        _editor.Stage(pending);
        if (!SectionsMode)
        {
            Family?.ApplyArrangement(_editor.Lists.Select(list => (list.ParentId, (IReadOnlyList<Guid>)[.. list.Current.Select(row => row.Id)])));
        }

        StateHasChanged();
        if (OnOrderChanged.HasDelegate)
        {
            var shown = OnlyList is { } only && _editor.IndexOfList(only) >= 0 ? _editor.Lists[_editor.IndexOfList(only)] : _editor.Lists.FirstOrDefault();
            await OnOrderChanged.InvokeAsync(shown is null ? [] : [.. shown.Current.Select(row => row.Id)]);
        }
    }

    private async Task SetRenameAsync(VideoOrderList list, bool on)
    {
        if (!CanChange || Pending is not { } pending)
        {
            return;
        }

        if (HoldChanges)
        {
            _renameHeld[list.ParentId] = on;
            await NotifyDirtyAsync();
            return;
        }

        ApplyRename(pending, list, on);
    }

    private static void ApplyRename(PendingEditList pending, VideoOrderList list, bool on)
    {
        if (pending.FindVideoRename(list.ParentId) is { } staged)
        {
            pending.Remove(staged.Id);
        }

        if (on)
        {
            pending.SetTarget(EditSessionChangeKinds.VideoRename, list.ParentId, null, null, list.Title);
        }
    }

    public async ValueTask DisposeAsync()
    {
        // A header list that goes away while its arrangement is still held and unstaged (the window crossed 1024 wide, so the header was drawn again in
        // its other arrangement) leaves it in the session for the list that takes its place. Save order and Cancel clear the held flag first.
        if (HoldChanges && Session is { IsActive: true, HasHeldOrder: true } && Hold() is { } held)
        {
            Session.StashHeldOrder(held);
        }

        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("detach", _root);
                await _module.DisposeAsync();
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // The page is already gone; there is nothing left to detach.
            Logger.LogDebug(ex, "The series order drag script was already gone when the list closed");
        }

        _self?.Dispose();
    }
}
