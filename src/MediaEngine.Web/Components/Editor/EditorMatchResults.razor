@namespace MediaEngine.Web.Components.Editor
@using MediaEngine.Contracts.Editing
@using MediaEngine.Web.Services.Editing
@inject IStringLocalizer<SharedStrings> L

@* The results half of the Match tab's search (universal editor v6, WP3; mock screen A). On the left a list: a small cover, the title, then
   creator · year · series and number (a collection says "Collection"); a tick marks the chosen row; no verdict pill and no description. Six rows,
   then "Show N more results". On the right the card for the chosen result (EditorMatchCard): the large cover, the facts, the verdict in words, the
   compare table the Engine supplied, and Apply match with one line saying what it does. A book's, comic's or audiobook's editions sit under both.
   Apply match is always available once a result is chosen, even for a Weak match: the verdict is advice. Nothing is searched and nothing is
   saved here; the panel owns both. The results and the "Looking up" line sit on a full-width row of their own. *@
<div class="tl-matchres" data-testid="match-results">
    @if (Loading)
    {
        <div class="tl-matchres__wide" role="status" aria-busy="true" data-testid="match-looking-up">
            <AppSkeleton Shape="AppSkeletonShape.Text" Width="40%" />
            <span class="tl-matchres__meta">@L["EditorMatchResults_LookingUp"]</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="tl-matchres__wide tl-matchres__message" data-testid="match-message">
            <AppAlert Severity="@(Failed ? AppSeverity.Warning : AppSeverity.Info)" Dense="true">@Message</AppAlert>
            @if (Failed && OnRetry.HasDelegate)
            {
                <AppButton Label="@L["Common_TryAgain"].Value" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" OnClick="OnRetry" data-testid="match-try-again" />
            }
        </div>
    }

    @if (!Loading && Results.Count > 0)
    {
        <EditorMatchSplit TestId="match-split" ShowCard="@(Selected is not null)">
            <List>
                <EditorMatchList Heading="@L["EditorMatchResults_SearchResults"].Value" Count="@(Results.Count == 1 ? L["EditorMatchResults_CountOne"].Value : L["EditorMatchResults_Count", Results.Count].Value)">
                    @foreach (var result in Visible)
                    {
                        var current = result;
                        <EditorMatchListRow Title="@result.Title" Meta="@Line(result)" ArtShape="@Shape(result)" ImageUrl="@result.ImageUrl" Selected="@ReferenceEquals(result, Selected)"
                                            OnClick="@(() => SelectedChanged.InvokeAsync(current))" data-testid="match-result" />
                    }
                </EditorMatchList>
                @if (Hidden > 0)
                {
                    <div>
                        <AppButton Label="@(Hidden == 1 ? L["EditorMatchResults_ShowOneMore"].Value : L["EditorMatchResults_ShowMore", Hidden].Value)" EndIcon="@AppMaterialIcons.Outlined.ExpandMore"
                                   ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary" OnClick="ShowAll" data-testid="match-show-more" />
                    </div>
                }
            </List>
            <Card>
                @if (Selected is { } selected)
                {
                    var shown = Edition ?? selected;
                    <EditorMatchCard Model="@EditorMatchCardModels.ForResult(shown, selected, Kind, L)" ResultLabel="@L["EditorMatchResults_SelectedResult"].Value" data-testid="match-preview">
                        <Foot>
                            <EditorMatchApply ShowCancel="ShowCancel" CanApply="CanApply" OnApply="OnApply" OnCancel="OnCancel" Line="@EditorMatchCardModels.ApplyLine(Kind, shown.ProviderName, L)" />
                        </Foot>
                    </EditorMatchCard>
                }
            </Card>
        </EditorMatchSplit>

        @if (Selected is { Editions.Count: > 0 } work)
        {
            <div class="tl-matchres__wide" data-testid="match-editions">
                <EditorMatchList Heading="@L["EditorMatchResults_EditionsAndReleases"].Value">
                    @foreach (var edition in work.Editions)
                    {
                        var picked = ReferenceEquals(edition, Edition);
                        var current = edition;
                        <EditorMatchListRow Title="@EditionLine(edition)" Meta="@(edition.IsSuggested ? L["EditorMatchResults_ClosestToYourFile"].Value : null)" Selected="picked"
                                            OnClick="@(() => EditionChanged.InvokeAsync(current))" />
                    }
                </EditorMatchList>
            </div>
        }
    }
    else if (!Loading && ShowCancel)
    {
        <div class="tl-matchres__buttons">
            <AppButton Label="@L["EditorMatchResults_Cancel"].Value" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" OnClick="OnCancel" data-testid="match-cancel" />
        </div>
    }
</div>

@code {
    /// <summary>How many rows show before "Show N more results".</summary>
    internal const int FirstRows = 6;

    private IReadOnlyList<EditorMatchResultDto>? _listed;
    private bool _all;

    /// <summary>The results, best first. For a book, comic or audiobook, each is a work with its editions.</summary>
    [Parameter] public IReadOnlyList<EditorMatchResultDto> Results { get; set; } = [];

    /// <summary>The editor's kind of the item (book, movie, episode, song ...): it words the series position, the picture shape and "Links this book to ...".</summary>
    [Parameter] public string? Kind { get; set; }

    [Parameter] public EditorMatchResultDto? Selected { get; set; }

    [Parameter] public EventCallback<EditorMatchResultDto> SelectedChanged { get; set; }

    /// <summary>The edition chosen under the selected work; null for a single record.</summary>
    [Parameter] public EditorMatchResultDto? Edition { get; set; }

    [Parameter] public EventCallback<EditorMatchResultDto> EditionChanged { get; set; }

    [Parameter] public bool Loading { get; set; }

    /// <summary>The sentence shown when there is nothing to list (nothing found, a provider that did not answer).</summary>
    [Parameter] public string? Message { get; set; }

    /// <summary>True when <see cref="Message"/> is a provider that did not answer rather than an empty answer.</summary>
    [Parameter] public bool Failed { get; set; }

    /// <summary>Raised by Try again, shown beside a message about a provider that did not answer; nothing is shown when this has no handler.</summary>
    [Parameter] public EventCallback OnRetry { get; set; }

    /// <summary>True once a result is chosen and the person may stage it. A Weak match can be applied too.</summary>
    [Parameter] public bool CanApply { get; set; }

    [Parameter] public EventCallback OnApply { get; set; }

    /// <summary>Shown when there is a current match to go back to.</summary>
    [Parameter] public bool ShowCancel { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    private IEnumerable<EditorMatchResultDto> Visible => _all ? Results : Results.Take(FirstRows);

    private int Hidden => _all ? 0 : Math.Max(0, Results.Count - FirstRows);

    protected override void OnParametersSet()
    {
        // A new answer starts folded again at six rows.
        if (!ReferenceEquals(_listed, Results))
        {
            _listed = Results;
            _all = false;
        }
    }

    private void ShowAll() => _all = true;

    private string Shape(EditorMatchResultDto result) => EditorMatchCardModels.ArtFor(result.KindText, Kind).ToString().ToLowerInvariant();

    // Creator · year · series and number; a collection or box set says "Collection" in the series place.
    private string Line(EditorMatchResultDto result) =>
        EditorMatchCardModels.Join(
            result.Creator,
            result.Year,
            result.IsCollection ? L["EditorMatchResults_Collection"].Value : EditorMatchCardModels.SeriesLine(result.SeriesName, result.SeriesNumber, Kind, ", ", L)) ?? string.Empty;

    private static string EditionLine(EditorMatchResultDto edition) =>
        edition.Edition is { } info
            ? string.Join(" · ", new[] { info.Year, info.Format, info.Publisher, info.Language }.Where(part => !string.IsNullOrWhiteSpace(part)))
            : edition.Title;

    // The one word for a verdict ("Strong", "Possible", "Weak"); the verdict bar puts "match" after it.
    internal static string VerdictText(string verdict, IStringLocalizer<SharedStrings> l) => verdict switch
    {
        EditorMatchVerdicts.Strong => l["EditorMatchResults_VerdictWordStrong"].Value,
        EditorMatchVerdicts.Weak => l["EditorMatchResults_VerdictWordWeak"].Value,
        _ => l["EditorMatchResults_VerdictWordPossible"].Value,
    };

    internal static AppUiTone VerdictTone(string verdict) => verdict switch
    {
        EditorMatchVerdicts.Strong => AppUiTone.Success,
        EditorMatchVerdicts.Weak => AppUiTone.Warning,
        _ => AppUiTone.Neutral,
    };
}
