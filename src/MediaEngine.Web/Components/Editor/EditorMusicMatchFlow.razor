@namespace MediaEngine.Web.Components.Editor
@using System.Globalization
@using System.Net.Http
@using MediaEngine.Contracts.Editing
@using MediaEngine.Contracts.Matching
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@implements IDisposable
@inject IEngineApiClient Api
@inject ILogger<EditorMusicMatchFlow> Logger
@inject IStringLocalizer<SharedStrings> L

@* The Match tab's music flow (universal editor v5, 3c; v6 WP6, mock screen D). The same shapes as every other Match step: the shared search row (the
   provider the tab hands in as RowStart, Artist, Album and Song and a labeled Search, with the count of releases on its message line), the "Your
   file" bar, a list on the left and the card on the right. The left column holds the releases (each with its cover, "year · format · N tracks ·
   label" and a note when it is the current or the closest one) and, under them, the chosen release's discs and tracks, with the track that fits the
   file already chosen. The card shows the picked track, the Engine's verdict in words and its compare table. A pick that would move the song to
   another album says so in an amber note beside Apply match. Nothing runs on opening: the boxes are filled and the person presses Search. Choosing
   only hands the pick up; the match, the album move and the file move are staged by the Match tab and written on Save changes. On a phone (section 4a)
   each step is one screen: the search and the releases, then (once a release is tapped) that release's tracks with a way back to the releases, and the
   card of a tapped track as a full-height sheet whose Back returns to the track list with the tick kept. *@
<div class="tl-musicflow" data-testid="music-flow">
    @if (!TracksStep)
    {
        <EditorMatchSearchRow Columns="@RowColumns" Message="@RowMessage" SearchDisabled="@(_releasesLoading || !HasWords)" OnSearch="SearchAsync" ButtonTestId="music-flow-search">
            @RowStart
            @foreach (var box in Boxes)
            {
                <AppTextField Label="@box.Label" Value="@box.Get()" ValueChanged="@(value => box.Set(value ?? string.Empty))" Immediate="true" OnKeyDown="OnSearchKey"
                              aria-label="@box.Label" data-testid="@("music-flow-" + box.Key)" />
            }
        </EditorMatchSearchRow>
    }

    @Lead

    @if (_releasesLoading)
    {
        <EditorMatchLookingUp />
    }
    else if (!string.IsNullOrWhiteSpace(_releasesMessage))
    {
        <AppAlert Severity="AppSeverity.Info" Dense="true" data-testid="music-flow-message">@_releasesMessage</AppAlert>
    }

    @if (!_releasesLoading && _releases.Count > 0)
    {
        <EditorMatchSplit TestId="music-flow-split" ShowCard="@(_candidate is not null)" SheetOpen="_sheet" OnSheetClose="CloseSheet">
            <List>
                @if (TracksStep)
                {
                    @* The second screen on a phone: a way back to the releases, which release this is, then its tracks. *@
                    <div class="tl-musicflow__back" data-testid="music-flow-release-bar">
                        <AppButton Label="@L["EditorMusicMatchFlow_AllReleases"].Value" StartIcon="@AppMaterialIcons.Outlined.ArrowBack" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral"
                                   OnClick="BackToReleases" data-testid="music-flow-back" />
                        <span class="tl-musicflow__release" data-testid="music-flow-release-name">@(EditorMatchCardModels.Join(_release!.Title, ReleaseMeta(_release)))</span>
                    </div>
                }
                else
                {
                    <EditorMatchList Heading="@L["EditorMusicMatchFlow_Releases"].Value" Count="@CountText(_releases.Count)" TestId="music-flow-releases">
                        @foreach (var release in _releases)
                        {
                            var current = release;
                            <EditorMatchListRow Title="@release.Title" Meta="@ReleaseMeta(release)" ArtShape="square" ImageUrl="@release.ImageUrl" Selected="@(_release?.ReleaseId == release.ReleaseId)"
                                                data-testid="music-flow-release" OnClick="@(() => TapReleaseAsync(current))" />
                        }
                    </EditorMatchList>
                }

                @if (IsPhone && !TracksStep)
                {
                    @* The tracks wait for a tap on a release. *@
                }
                else if (_tracksLoading)
                {
                    <EditorMatchLookingUp Width="60%" />
                }
                else if (_tracksProblem is not null)
                {
                    <AppAlert Severity="AppSeverity.Info" Dense="true" data-testid="music-flow-problem">@_tracksProblem</AppAlert>
                }
                else if (_tracks is not null && _release is not null)
                {
                    @TracksPart()
                }
            </List>
            <Card>@CardPart()</Card>
        </EditorMatchSplit>
    }

    @if (_candidate is null && ShowCancel)
    {
        <div class="tl-musicflow__foot">
            <AppButton Label="@L["EditorMatchResults_Cancel"].Value" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" OnClick="OnCancel" data-testid="match-cancel" />
        </div>
    }
</div>

@code {
    private sealed record Box(string Key, string Label, Func<string> Get, Action<string> Set);

    private CancellationTokenSource? _cts;
    private Guid _startedFor;
    private string _artist = string.Empty;
    private string _album = string.Empty;
    private string _song = string.Empty;
    private bool _releasesLoading;
    private string? _releasesMessage;
    private IReadOnlyList<EditorMusicReleaseDto> _releases = [];
    private EditorMusicReleaseDto? _release;
    private bool _tracksLoading;
    private string? _tracksProblem;
    private EditorMusicReleaseTracksDto? _tracks;
    private EditorMusicTrackDto? _pickedTrack;
    private ItemCanonicalRetailCandidateDto? _candidate;
    private EditorMatchResultDto? _judged;
    private EditorMatchPlacementDto? _placement;
    private bool _judging;

    // On a phone: the second screen (the chosen release's tracks) is showing, and the card of a tapped track is open as a sheet.
    private bool _tracksScreen;
    private bool _sheet;

    /// <summary>What the Match tab puts first in the row: the provider dropdown.</summary>
    [Parameter] public RenderFragment? RowStart { get; set; }

    /// <summary>What the Match tab shows under the row: a staged note and the "Your file" bar.</summary>
    [Parameter] public RenderFragment? Lead { get; set; }

    /// <summary>The providers the Engine offered for this item, so the card can name the one a record came from.</summary>
    [Parameter] public IReadOnlyList<EditorMatchProviderDto> Providers { get; set; } = [];

    /// <summary>The item being matched (a song).</summary>
    [Parameter, EditorRequired] public EditorMatchSubject? Subject { get; set; }

    /// <summary>The boxes the Engine pre-filled from the file name, tags and folders (artist, album, song).</summary>
    [Parameter] public IReadOnlyList<EditorMatchFieldDto> Fields { get; set; } = [];

    /// <summary>What the Engine read from the file: its track number is the "from" side of the move note.</summary>
    [Parameter] public EditorMatchLocalEvidenceDto? Evidence { get; set; }

    /// <summary>True when the person may stage a match (they may edit and an edit session is open).</summary>
    [Parameter] public bool CanApply { get; set; }

    /// <summary>Shown as Cancel when there is a current match to go back to.</summary>
    [Parameter] public bool ShowCancel { get; set; }

    /// <summary>Raised by Apply match with the chosen track as a song record carrying its exact release and recording.</summary>
    [Parameter] public EventCallback<ItemCanonicalRetailCandidateDto> OnApplyMatch { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    [CascadingParameter] public EditorWindowLayout? Layout { get; set; }

    private bool IsPhone => EditorWindowLayout.IsPhone(false, Layout);

    private bool TracksStep => IsPhone && _tracksScreen && _release is not null;

    private void CloseSheet() => _sheet = false;

    // A tap on a release picks it and, on a phone, goes on to its tracks (the second screen).
    private Task TapReleaseAsync(EditorMusicReleaseDto release)
    {
        _tracksScreen = IsPhone;
        return ChooseReleaseAsync(release);
    }

    private void BackToReleases()
    {
        _tracksScreen = false;
        _sheet = false;
    }

    // A tap on a track picks it and, on a phone, opens its card as a sheet.
    private Task TapTrackAsync(EditorMusicTrackDto track)
    {
        _sheet = IsPhone;
        return PickTrackAsync(track);
    }

    private IReadOnlyList<Box> Boxes =>
    [
        new("artist", L["EditorMusicMatchFlow_Artist"].Value, () => _artist, value => _artist = value),
        new("album", L["EditorMusicMatchFlow_Album"].Value, () => _album, value => _album = value),
        new("song", L["EditorMusicMatchFlow_Song"].Value, () => _song, value => _song = value),
    ];

    private bool HasWords => !string.IsNullOrWhiteSpace(_album) || !string.IsNullOrWhiteSpace(_song);

    // The row's columns when it is wide enough for one line: the provider (when the tab hands one in), the three boxes, the button as wide as its word.
    private string RowColumns => (RowStart is null ? string.Empty : "220px ") + "minmax(9rem, 1fr) minmax(9rem, 1fr) minmax(9rem, 1fr) auto";

    // After a search the row's message line says how many releases came back and from whom.
    private string? RowMessage
    {
        get
        {
            if (_releases.Count == 0)
            {
                return null;
            }

            var from = ProviderDisplay(EditorMatchCandidates.MusicBrainzName);
            return _releases.Count == 1 ? L["EditorMatchPanel_ResultOneFrom", from].Value : L["EditorMatchPanel_ResultsFrom", _releases.Count, from].Value;
        }
    }

    // The provider a name stands for, as the Engine offered it ("MusicBrainz"). The music search reads MusicBrainz only, so the count names that provider.
    private string ProviderDisplay(string name) =>
        Providers.FirstOrDefault(provider => string.Equals(provider.Name, name, StringComparison.OrdinalIgnoreCase))?.DisplayName ?? name;

    private string CountText(int count) => count == 1 ? L["EditorMatchResults_CountOne"].Value : L["EditorMatchResults_Count", count].Value;

    protected override void OnParametersSet()
    {
        if (Subject is null || _startedFor == Subject.EntityId)
        {
            return;
        }

        _startedFor = Subject.EntityId;
        _artist = FieldValue("artist");
        _album = FieldValue("album");
        _song = FieldValue("song");
        _releases = [];
        _releasesMessage = null;
        _release = null;
        _tracks = null;
        _tracksScreen = false;
        ClearPick();
    }

    private string FieldValue(string key) => Fields.FirstOrDefault(field => string.Equals(field.Key, key, StringComparison.OrdinalIgnoreCase))?.Value ?? string.Empty;

    private Task OnSearchKey(KeyboardEventArgs args) => args.Key == "Enter" ? SearchAsync() : Task.CompletedTask;

    private void ClearPick()
    {
        _sheet = false;
        _pickedTrack = null;
        _candidate = null;
        _judged = null;
        _judging = false;
        _placement = null;
    }

    private CancellationToken NewToken()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        return _cts.Token;
    }

    private async Task SearchAsync()
    {
        if (Subject is null || !HasWords)
        {
            return;
        }

        var ct = NewToken();
        _releasesLoading = true;
        _releasesMessage = null;
        _releases = [];
        _release = null;
        _tracks = null;
        _tracksProblem = null;
        _tracksScreen = false;
        ClearPick();
        StateHasChanged();
        EditorMusicReleasesDto? found = null;
        try
        {
            found = await Api.GetEditorMusicReleasesAsync(Subject.EntityId, _artist.Trim(), _album.Trim(), _song.Trim(), ct);
            if (ct.IsCancellationRequested)
            {
                return;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "The music match flow could not list releases for {EntityId}", Subject.EntityId);
        }

        _releasesLoading = false;
        if (found is null)
        {
            _releasesMessage = L["EditorMusicMatchFlow_DidNotAnswer"].Value;
            return;
        }

        _releases = found.Releases;
        _releasesMessage = EditorMatchMessages.Text(L, found.MessageCode);

        // The release that fits the file is opened for the person; failing that, the one the song is on now.
        var start = _releases.FirstOrDefault(release => release.IsSuggested) ?? _releases.FirstOrDefault(release => release.IsCurrent);
        if (start is not null)
        {
            await ChooseReleaseAsync(start);
        }
    }

    private async Task ChooseReleaseAsync(EditorMusicReleaseDto release)
    {
        if (Subject is null)
        {
            return;
        }

        var ct = NewToken();
        _release = release;
        _tracks = null;
        _tracksProblem = null;
        _tracksLoading = true;
        ClearPick();
        StateHasChanged();
        try
        {
            _tracks = await Api.GetEditorMusicReleaseTracksAsync(Subject.EntityId, release.ReleaseId, ct);
            if (ct.IsCancellationRequested)
            {
                return;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "The music match flow could not read release {ReleaseId} for {EntityId}", release.ReleaseId, Subject.EntityId);
        }

        _tracksLoading = false;
        if (_tracks is null)
        {
            _tracksProblem = L["EditorMusicMatchFlow_DidNotAnswer"].Value;
            return;
        }

        var suggested = _tracks.Discs.SelectMany(disc => disc.Tracks).FirstOrDefault(track => track.IsSuggested);
        if (suggested is not null)
        {
            await PickTrackAsync(suggested);
        }
    }

    private async Task PickTrackAsync(EditorMusicTrackDto track)
    {
        if (Subject is null || _release is not { } release)
        {
            return;
        }

        _pickedTrack = track;
        var candidate = EditorMatchCandidates.ForMusicTrack(
            release.ReleaseId, release.ReleaseGroupId, release.Title, release.Artist, release.Year, release.HasCover,
            track.RecordingId, track.Title, track.Artist, track.Disc, track.Track, track.LengthSeconds, track.Disambiguation);
        _candidate = candidate;
        _judged = null;
        _placement = null;
        _judging = true;
        StateHasChanged();
        try
        {
            var verdict = Api.GetEditorMatchVerdictAsync(Subject.EntityId, candidate);
            var placement = Api.GetEditorMatchPlacementAsync(Subject.EntityId, candidate);
            await Task.WhenAll(verdict, placement);
            if (!ReferenceEquals(_candidate, candidate))
            {
                return;
            }

            _judged = verdict.Result ?? new EditorMatchResultDto { Candidate = candidate, ProviderName = candidate.ProviderName, Title = candidate.Title, Verdict = EditorMatchVerdicts.Possible };
            _placement = placement.Result;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "The music match flow could not judge a pick for {EntityId}", Subject.EntityId);
            _judged = new EditorMatchResultDto { Candidate = candidate, ProviderName = candidate.ProviderName, Title = candidate.Title, Verdict = EditorMatchVerdicts.Possible };
        }
        finally
        {
            if (ReferenceEquals(_candidate, candidate))
            {
                _judging = false;
            }
        }
    }

    // Apply match stages the pick and leaves the sheet; the tab shows its note.
    private Task ApplyAsync()
    {
        _sheet = false;
        return _candidate is null ? Task.CompletedTask : OnApplyMatch.InvokeAsync(_candidate);
    }

    // "2018 · CD · 11 tracks · label", then a plain note when it is the release the song is on or the one that fits the file best.
    private string ReleaseMeta(EditorMusicReleaseDto release) => string.Join(" · ", new[]
    {
        release.Year,
        release.Format,
        release.TrackCount > 0 ? CountTracks(release.TrackCount) : null,
        release.Label,
        release.Country,
        release.IsCurrent ? L["EditorMusicMatchFlow_CurrentRelease"].Value : null,
        release.IsSuggested ? L["EditorMusicMatchFlow_Suggested"].Value : null,
    }.Where(part => !string.IsNullOrWhiteSpace(part)));

    // The recording's artist and its own note ("live at Wembley", "2011 remaster") tell the recordings of one song apart.
    private string TrackMeta(EditorMusicTrackDto track) => string.Join(" · ", new[]
    {
        track.Artist,
        track.Disambiguation,
    }.Where(part => !string.IsNullOrWhiteSpace(part)));

    private string NumberText(EditorMusicTrackDto track, bool manyDiscs) =>
        manyDiscs ? $"{track.Disc.ToString(CultureInfo.InvariantCulture)}·{track.Track.ToString(CultureInfo.InvariantCulture)}" : track.Track.ToString(CultureInfo.InvariantCulture);

    // The release's tracks under the releases: one "Tracks" list per disc, the disc named at the right of its heading.
    private RenderFragment TracksPart() => __builder =>
    {
        var manyDiscs = _tracks!.Discs.Count > 1;
        <div class="tl-musicflow__tracks" data-testid="music-flow-tracks">
            @foreach (var disc in _tracks.Discs)
            {
                // Mock D: "Tracks", with the disc at the right of the heading.
                var discName = string.IsNullOrWhiteSpace(disc.Title) ? L["EditorMusicMatchFlow_Disc", disc.Number].Value : L["EditorMusicMatchFlow_DiscTitled", disc.Number, disc.Title].Value;
                <EditorMatchList Heading="@L["EditorMusicMatchFlow_Tracks"].Value" Count="@discName">
                    @foreach (var track in disc.Tracks)
                    {
                        var current = track;
                        <EditorMatchListRow Title="@track.Title" Number="@NumberText(track, manyDiscs)" Meta="@TrackMeta(track)" Trailing="@track.LengthText"
                                            Selected="@ReferenceEquals(_pickedTrack, track)" MetaTestId="music-flow-track-meta"
                                            aria-label="@L["EditorMusicMatchFlow_TrackRow", NumberText(track, manyDiscs), track.Title].Value" data-testid="music-flow-track-pick"
                                            data-disc="@track.Disc" data-track="@track.Track" OnClick="@(() => TapTrackAsync(current))" />
                    }
                </EditorMatchList>
            }
        </div>
    };

    private string CountTracks(int count) => count == 1 ? L["EditorMusicMatchFlow_TrackCountOne"].Value : L["EditorMusicMatchFlow_TrackCount", count].Value;

    // The card for the picked track: the same card as every other Match step, judged by the Engine. A pick that would move the song to another
    // album says so beside Apply match. While the Engine is judging, a placeholder holds its place.
    private RenderFragment CardPart() => __builder =>
    {
        if (_judging || _judged is null || _candidate is null)
        {
            <EditorMatchLookingUp />
        }
        else
        {
            var model = CardModel(_judged, _candidate);
            <EditorMatchCard Model="@model" ResultLabel="@L["EditorMatchResults_SelectedResult"].Value" data-testid="match-preview">
                <Basis>
                    @if (_placement is not null)
                    {
                        @MoveCard()
                    }
                </Basis>
                <Foot>
                    <EditorMatchApply ShowCancel="ShowCancel" CanApply="@(CanApply && !_judging)" OnApply="ApplyAsync" OnCancel="OnCancel"
                                      Line="@EditorMatchCardModels.ApplyLine(MediaEngine.Domain.Configuration.EditorKinds.Song, model.ProviderName, L)" />
                </Foot>
            </EditorMatchCard>
        }
    };

    // The song's card names its album and its place on it (mock D): "Shoreline · Disc 1, Track 4".
    private EditorMatchCardModel CardModel(EditorMatchResultDto judged, ItemCanonicalRetailCandidateDto candidate)
    {
        var model = EditorMatchCardModels.ForPick(judged, candidate, MediaEngine.Domain.Configuration.EditorKinds.Song, ProviderDisplay(candidate.ProviderName), L);
        return _pickedTrack is { } track && _release is { } release
            ? model with { SeriesLine = EditorMatchCardModels.Join(release.Title, L["EditorMusicMatchFlow_DiscTrack", track.Disc, track.Track].Value) }
            : model;
    }

    // Shown only when the pick would put the song on a different album than it is on now (compared by the album's identity, never its name).
    // Otherwise a pick the Engine cannot place says why; a pick that stays where it is says nothing.
    private RenderFragment MoveCard() => __builder =>
    {
        var placement = _placement!;
        var moves = placement.DestinationId is { } destination && destination != placement.CurrentParentId;
        if (moves && _pickedTrack is { } track)
        {
            var from = placement.CurrentParentLabel ?? string.Empty;
            var to = placement.ParentLabel ?? _release?.Title ?? string.Empty;
            var disc = track.Disc.ToString(CultureInfo.InvariantCulture);
            var number = track.Track.ToString(CultureInfo.InvariantCulture);
            <AppAlert Severity="AppSeverity.Warning" Dense="true" data-testid="music-flow-move">
                <strong>@L["EditorMusicMatchFlow_MoveHeading"]</strong>
                <span>@L["EditorMusicMatchFlow_MoveFrom"] <i>@from</i>@(Evidence?.Number is { } now ? L["EditorMusicMatchFlow_MoveTrackN", now.ToString(CultureInfo.InvariantCulture)].Value : string.Empty) @L["EditorMusicMatchFlow_MoveTo"] <i>@to</i>@L["EditorMusicMatchFlow_MoveToPos", disc, number]
                    @L["EditorMusicMatchFlow_MoveFollows"] @if (placement.CurrentParentKeeps is { } keeps) { @KeepsText(from, keeps) }</span>
            </AppAlert>
        }
        else if (!string.IsNullOrWhiteSpace(placement.BlockedReason))
        {
            <AppAlert Severity="AppSeverity.Warning" Dense="true" data-testid="music-flow-move">@placement.BlockedReason</AppAlert>
        }
    };

    private MarkupString KeepsText(string album, int keeps)
    {
        var tail = keeps == 1 ? L["EditorMusicMatchFlow_MoveKeepsOne"].Value : L["EditorMusicMatchFlow_MoveKeeps", keeps].Value;
        return new MarkupString($"<i>{System.Net.WebUtility.HtmlEncode(album)}</i>{System.Net.WebUtility.HtmlEncode(tail)}");
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
