@namespace MediaEngine.Web.Components.Editor
@inject IStringLocalizer<SharedStrings> L

@* The frame of every editor window (universal editor v4 D2, D3, D16; v5 D10 and screen J; photos and documents editor D1): the item's header
   (which holds the way around the family), the tab bar, one scroll area for the tool, and the fixed footer: Delete at the left, the file status
   text, the unsaved count, Discard and Save changes (primary last), always in the same places. It knows nothing about what is being edited, so the library editor (EditorPanelHost) and the
   View editor (photos, videos, documents, galleries) draw exactly the same window and a guardrail can insist that nothing draws its own. *@
<div class="@RootClass"
     data-tool="@ActiveKey.ToLowerInvariant()"
     data-phone="@(Phone ? "true" : null)">
    @if (Framed)
    {
        @ItemHeader
        <AppIconButton Icon="@AppMaterialIcons.Outlined.Close"
                       Size="AppControlSize.Large"
                       Tone="AppUiTone.Neutral"
                       Class="tl-editor-panel__close tl-editor-window__close"
                       Tooltip="@L["EditorHeader_Close"].Value"
                       AriaLabel="@L["EditorHeader_Close"].Value"
                       OnClick="OnClose" />
    }
    else
    {
        <header class="tl-editor-panel__header">
            <h2 id="tl-editor-panel-title" class="tl-editor-panel__title" tabindex="-1">@Title</h2>
            @HeaderExtra
            <AppIconButton Icon="@AppMaterialIcons.Outlined.Close"
                           Size="AppControlSize.Large"
                           Tone="AppUiTone.Neutral"
                           Class="tl-editor-panel__close"
                           Tooltip="@($"Close {CloseName}")"
                           AriaLabel="@($"Close {CloseName}")"
                           OnClick="OnClose" />
        </header>
    }
    @Notice
    <div class="tl-editor-window__main">
        <div class="tl-editor-window__content">
            @{
                RenderFragment body = @<div class="tl-editor-panel__body">@Body</div>;
            }
            @if (ShowTabs)
            {
                @* The shared tab strip (the same underline, spacing and arrow keys as the profile and browse pages). The open tool's panel holds the body. *@
                var activeIndex = Math.Max(0, Tabs.ToList().FindIndex(entry => entry.Key == ActiveKey));
                <AppTabs Class="tl-editor-window__tabs"
                         Label="@L["Common_EditingTools"].Value"
                         Rounded="false"
                         Border="false"
                         Elevation="0"
                         ActivePanelIndex="@activeIndex"
                         ActivePanelIndexChanged="@(index => OnTabIndex(index))">
                    @foreach (var tab in Tabs)
                    {
                        <AppTabPanel Text="@tab.Label" Icon="@tab.Icon" Class="@($"tl-editor-tab tl-editor-tab--{tab.Key.ToLowerInvariant()}")" Disabled="@TabsDisabled">
                            @if (tab.Key == ActiveKey)
                            {
                                @body
                            }
                        </AppTabPanel>
                    }
                </AppTabs>
            }
            else
            {
                @body
            }
        </div>
    </div>
    @if (ShowFooter && ReadOnly)
    {
        @* A read-only item (a Series, v5 D7 and screen H) has nothing to save or discard: the footer says so and offers only Close. *@
        <footer class="tl-editor-window__footer tl-editor-window__footer--read-only" data-read-only="true">
            <div class="tl-editor-window__where" role="status">
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Lock" Size="AppIconSize.Control20" Class="tl-editor-window__where-icon" />
                <div class="tl-editor-window__where-text">
                    <strong>@L["EditorSeries_ReadOnlyTitle"]</strong>
                    <small>@L["EditorSeries_ReadOnlyDetail"]</small>
                </div>
            </div>
            <span class="tl-editor-window__changes"></span>
            <div class="tl-editor-window__actions">
                <AppButton ButtonStyle="AppButtonStyle.Outlined"
                           Tone="AppUiTone.Neutral"
                           Size="AppControlSize.Large"
                           Class="tl-editor-window__cancel tl-editor-window__close-button"
                           OnClick="OnClose">
                    @L["Common_Close"]
                </AppButton>
            </div>
        </footer>
    }
    else if (ShowFooter)
    {
        <footer class="tl-editor-window__footer">
            @if (FooterStart is not null)
            {
                <div class="tl-editor-window__footer-start">@FooterStart</div>
            }
            @if (Framed)
            {
                @Where
            }

            <span class="tl-editor-window__changes" role="status">@(ChangeCount == 0 ? L["EditorFooter_NoChanges"].Value : ChangeCount == 1 ? L["EditorFooter_OneUnsaved"].Value : string.Format(L["EditorFooter_ManyUnsaved"].Value, ChangeCount))@(string.IsNullOrEmpty(ChangeSuffix) ? null : " " + ChangeSuffix)</span>
            <div class="tl-editor-window__actions">
                <AppButton ButtonStyle="AppButtonStyle.Outlined"
                           Tone="AppUiTone.Neutral"
                           Size="AppControlSize.Large"
                           Class="tl-editor-window__cancel"
                           Disabled="@Saving"
                           OnClick="OnDiscard">
                    @(Framed ? L["EditorFooter_Discard"] : L["Search_Cancel"])
                </AppButton>
                <AppButton ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary"
                           Size="AppControlSize.Large"
                           Class="tl-editor-window__save"
                           Disabled="@(ChangeCount == 0 || Saving)"
                           OnClick="OnSave">
                    @(Saving ? L["EditorFooter_Saving"] : L["EditorFooter_SaveChanges"])
                </AppButton>
            </div>
        </footer>
    }
</div>

@code {
    /// <summary>One tab of the strip.</summary>
    public sealed record Tab(string Key, string Label, string Icon);

    /// <summary>True for the v4 frame (rail, header, where-line); false for the plain title bar used while several ticked items are edited together or Review is open.</summary>
    [Parameter] public bool Framed { get; set; }

    [Parameter] public RenderFragment? ItemHeader { get; set; }

    /// <summary>The plain title bar's text (not framed).</summary>
    [Parameter] public string Title { get; set; } = string.Empty;

    [Parameter] public string CloseName { get; set; } = string.Empty;

    [Parameter] public RenderFragment? HeaderExtra { get; set; }

    [Parameter] public bool ShowTabs { get; set; } = true;

    [Parameter] public IReadOnlyList<Tab> Tabs { get; set; } = [];

    [Parameter] public string ActiveKey { get; set; } = string.Empty;

    [Parameter] public bool TabsDisabled { get; set; }

    [Parameter] public EventCallback<string> OnTab { get; set; }

    /// <summary>A notice above the tools (a save that left changes behind).</summary>
    [Parameter] public RenderFragment? Notice { get; set; }

    [Parameter] public RenderFragment? Body { get; set; }

    [Parameter] public bool ShowFooter { get; set; } = true;

    /// <summary>True for an item nothing can be changed on (a Series): the footer then shows only Close, with no Delete, count, Discard or Save changes.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>The footer's first words: where changes go.</summary>
    [Parameter] public RenderFragment? Where { get; set; }

    /// <summary>Bottom-left of the footer: Delete, for an item that can be deleted.</summary>
    [Parameter] public RenderFragment? FooterStart { get; set; }

    [Parameter] public int ChangeCount { get; set; }

    /// <summary>Text after the unsaved count ("· 2 files").</summary>
    [Parameter] public string? ChangeSuffix { get; set; }

    [Parameter] public bool Saving { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public EventCallback OnDiscard { get; set; }

    [Parameter] public EventCallback OnSave { get; set; }

    /// <summary>The phone arrangement (v6 D19 to D22, section 4a): a full-screen sheet whose footer holds the write-back line and then Discard and Save changes side by side. Delete is not in the footer then; the header's "..." holds it.</summary>
    [Parameter] public bool Phone { get; set; }

    private string RootClass => (Framed ? "tl-editor-panel tl-editor-window tl-editor-window--framed" : "tl-editor-panel tl-editor-window") + (Phone ? " tl-editor-window--phone" : string.Empty);

    private Task OnTabIndex(int index) =>
        index >= 0 && index < Tabs.Count && Tabs[index].Key != ActiveKey ? OnTab.InvokeAsync(Tabs[index].Key) : Task.CompletedTask;
}
