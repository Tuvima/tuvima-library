@namespace MediaEngine.Web.Components.Editor
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject IEngineApiClient Api
@inject IJSRuntime JS
@inject IStringLocalizer<SharedStrings> L

@* The Bookmarks tab of a show, season or album (universal editor v5 D37, mockup Q2): one row per episode or song, grouped by season, with
   how many bookmarks Everyone sees on it. It follows the header's dropdowns: the show, a season, or the album. The chevron on a row picks
   that episode through the editor's own switch, so its bookmarks open on the same tab and every staged change is kept. Export the show and
   Import for the show sit at the top of the family only. *@
<div class="tl-bookmarks">
    @if (_loading)
    {
        <EditorPanelBusy Label="@L["EditorBookmarks_LoadingOverview"].Value" />
    }
    else if (_overview is null)
    {
        <div class="tl-bookmarks__empty" role="alert">
            <span>@L["EditorBookmarks_LoadFailed"] @Api.LastError</span>
            <AppButton ButtonStyle="AppButtonStyle.Outlined" OnClick="LoadAsync">@L["Common_TryAgain"]</AppButton>
        </div>
    }
    else if (_showCompare is { } compare)
    {
        <section class="tl-bookmarks-compare">
            <div class="tl-bookmarks__state">
                <div class="tl-bookmarks__state-copy">
                    <AppButton ButtonStyle="AppButtonStyle.Text" StartIcon="@AppMaterialIcons.Outlined.ArrowBack" OnClick="@(() => _showCompare = null)">@L["Common_Back"]</AppButton>
                    <h3>@compare.Name</h3>
                    <span class="tl-bookmarks__state-text">@L["EditorBookmarks_FileCount", compare.BookmarkCount]</span>
                </div>
                <div class="tl-bookmarks__actions">
                    <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(Included(compare).Count == 0)" OnClick="@(() => TakeAllNewAsync(compare))">@L["EditorBookmarks_TakeAllNew"]</AppButton>
                </div>
            </div>
            @if (compare.UnmatchedEpisodes > 0)
            {
                <AppAlert Severity="AppSeverity.Warning" Dense="true">@L["EditorBookmarks_UnmatchedEpisodes", compare.UnmatchedEpisodes]</AppAlert>
            }
            <ul class="tl-bookmarks__list">
                @foreach (var episode in compare.Episodes)
                {
                    var matched = episode.WorkId is not null && episode.Compare is { Match: BookmarkPackMatchResults.Match };
                    <li class="tl-bookmarks__row" @key="@(episode.SeasonNumber + ":" + episode.EpisodeNumber)">
                        <AppCheckbox Value="@(matched && _skipped.Contains(episode.WorkId!.Value) == false && episode.NewCount > 0)"
                                     ValueChanged="@(value => Include(episode, value))" Disabled="@(!matched || episode.NewCount == 0)"
                                     Label="@L["EditorBookmarks_Take"].Value" HideLabel="true" />
                        <span class="tl-bookmarks__place">S@(episode.SeasonNumber) E@(episode.EpisodeNumber)</span>
                        <span class="tl-bookmarks__copy">
                            <span class="tl-bookmarks__name">@episode.Title</span>
                            <span class="tl-bookmarks__from">@(matched ? L["EditorBookmarks_NewOfFile", episode.NewCount, episode.Compare!.BookmarkCount] : L["EditorBookmarks_EpisodeNotInShow"])</span>
                        </span>
                    </li>
                }
            </ul>
        </section>
    }
    else
    {
        <header class="tl-bookmarks__state">
            <div class="tl-bookmarks__state-copy">
                <h3>@_overview.RootTitle</h3>
                <span class="tl-bookmarks__state-text">
                    @L["EditorBookmarks_OverviewTotals", _overview.EveryoneTotal, _overview.MemberCount]
                    @if (_overview.DefinitiveCount > 0)
                    {
                        <span> · @L["EditorBookmarks_DefinitiveCount", _overview.DefinitiveCount]</span>
                    }
                </span>
            </div>
            @if (AtTheTop)
            {
                <div class="tl-bookmarks__actions">
                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Disabled="@(_busy || _overview.EveryoneTotal == 0)" StartIcon="@AppMaterialIcons.Outlined.Download" OnClick="ExportAsync">@L["EditorBookmarks_ExportShow"]</AppButton>
                    <AppFileUpload T="IBrowserFile" Accept=".zip,.json" FilesChanged="ImportFileChosenAsync" Disabled="@_busy">
                        <CustomContent Context="upload">
                            <AppButton ButtonStyle="AppButtonStyle.Outlined" Disabled="@_busy" StartIcon="@AppMaterialIcons.Outlined.FileUpload" OnClick="@(() => upload.OpenFilePickerAsync())">@L["EditorBookmarks_ImportShow"]</AppButton>
                        </CustomContent>
                    </AppFileUpload>
                </div>
            }
        </header>

        @if (_notice is not null)
        {
            <p class="tl-bookmarks__notice" role="status">@_notice</p>
        }

        @foreach (var group in _overview.Groups)
        {
            <section class="tl-bookmarks__profiles" @key="@(group.GroupId ?? Guid.Empty)">
                @if (!string.IsNullOrWhiteSpace(group.Title))
                {
                    <h3>@group.Title <span class="tl-bookmarks__count">@group.BookmarkCount</span></h3>
                }
                <div class="tl-bookmarks__cols" aria-hidden="true">
                    <span class="tl-bookmarks__place">@L["EditorBookmarks_ColEpisode"]</span>
                    <span class="tl-bookmarks__copy">@L["EditorBookmarks_ColTitle"]</span>
                    <span class="tl-bookmarks__num">@L["EditorBookmarks_ColEveryone"]</span>
                    <span class="tl-bookmarks__set">@L["EditorBookmarks_ColSet"]</span>
                    <span class="tl-bookmarks__num">@L["EditorBookmarks_FromProfiles"]</span>
                    <span class="tl-bookmarks__row-action"></span>
                </div>
                <ul class="tl-bookmarks__list">
                    @foreach (var row in group.Rows)
                    {
                        var staged = Pending.BookmarkOps(row.WorkId).Count;
                        <li class="tl-bookmarks__row" @key="row.WorkId" data-state="@row.State">
                            <span class="tl-bookmarks__place">@row.Code</span>
                            <span class="tl-bookmarks__copy">
                                <span class="tl-bookmarks__name">@row.Title</span>
                            </span>
                            <span class="tl-bookmarks__num" data-col="everyone">@row.EveryoneCount</span>
                            <span class="tl-bookmarks__set" data-col="set">@SetLabel(row)</span>
                            <span class="tl-bookmarks__num" data-col="profiles">@row.ProfileCount</span>
                            @if (staged > 0)
                            {
                                <AppChip Text="@L["EditorBookmarks_StagedCount", staged].Value" Tone="AppUiTone.Warning" />
                            }
                            <span class="tl-bookmarks__row-action">
                                <AppIconButton Icon="@AppMaterialIcons.Outlined.ChevronRight" AriaLabel="@L["EditorBookmarks_OpenEpisode", row.Title].Value"
                                               Disabled="@(Flow.Saving || Flow.Switching)" OnClick="@(() => PickAsync(row))" />
                            </span>
                        </li>
                    }
                </ul>
            </section>
        }
    }
</div>

@code {
    private EditorBookmarkOverviewDto? _overview;
    private EditorBookmarkShowCompareDto? _showCompare;
    private readonly HashSet<Guid> _skipped = [];
    private bool _loading = true;
    private bool _busy;
    private string? _notice;
    private Guid _loadedFor;

    [Parameter, EditorRequired] public EditSessionFlow Flow { get; set; } = null!;

    /// <summary>The show, season or album being edited.</summary>
    [Parameter, EditorRequired] public Guid WorkId { get; set; }

    /// <summary>True on the show or album itself: Export the show and Import for the show are offered there, once, and not on a season.</summary>
    [Parameter] public bool AtTheTop { get; set; }

    private PendingEditList Pending => Flow.Session.Pending;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == WorkId)
        {
            return;
        }

        _loadedFor = WorkId;
        Pending.Changed -= OnPendingChanged;
        Pending.Changed += OnPendingChanged;
        await LoadAsync();
    }

    private void OnPendingChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        _loading = true;
        _notice = null;
        _showCompare = null;
        var requested = WorkId;
        var overview = await Api.GetEditorBookmarkOverviewAsync(requested);
        if (requested != WorkId)
        {
            return;
        }

        _overview = overview;
        _loading = false;
    }

    // What the player will show for the member: a definitive set an administrator made, or every profile's bookmarks pooled. A staged
    // change makes the set definitive on Save, except a staged Start over, which pools it again.
    private string SetLabel(EditorBookmarkOverviewRowDto row)
    {
        var ops = Pending.BookmarkOps(row.WorkId);
        if (ops.Count > 0)
        {
            return ops[^1].Kind == EditorBookmarkOpKinds.StartOver ? L["EditorBookmarks_SetPooledStaged"].Value : L["EditorBookmarks_SetDefinitiveStaged"].Value;
        }

        return row.State == EditorBookmarkStates.Definitive ? L["EditorBookmarks_StateDefinitive"].Value : L["EditorBookmarks_SetPooled"].Value;
    }

    // The chevron: pick that episode through the editor's own switch, on this same tab.
    private Task PickAsync(EditorBookmarkOverviewRowDto row) => Flow.SwitchToAsync(row.WorkId, row.Title);

    private async Task ExportAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var file = await Api.ExportEditorShowBookmarksAsync(WorkId);
            if (file is null)
            {
                _notice = Api.LastError ?? L["EditorBookmarks_ExportFailed"].Value;
                return;
            }

            await using var stream = new MemoryStream(Convert.FromBase64String(file.ContentBase64), writable: false);
            using var reference = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("tuvimaDownloads.fromStream", file.FileName, reference, "application/zip");
            _notice = L["EditorBookmarks_Exported", file.BookmarkCount].Value;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportFileChosenAsync(IBrowserFile? file)
    {
        if (file is null || _busy)
        {
            return;
        }

        _busy = true;
        _notice = null;
        try
        {
            await using var stream = file.OpenReadStream(EditorBookmarkLimits.MaximumShowFileBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            var compare = await Api.CompareEditorShowBookmarkFileAsync(WorkId, new EditorBookmarkCompareRequestDto { ContentBase64 = Convert.ToBase64String(memory.ToArray()) });
            if (compare is null)
            {
                _notice = Api.LastError ?? L["EditorBookmarks_NotABookmarkFile"].Value;
                return;
            }

            _skipped.Clear();
            _showCompare = compare;
        }
        catch (IOException)
        {
            _notice = L["EditorBookmarks_FileTooLarge"].Value;
        }
        finally
        {
            _busy = false;
        }
    }

    // The episodes "Take all new" will stage: matched in the library, with something new in the file, and not unticked.
    private IReadOnlyList<EditorBookmarkShowCompareEpisodeDto> Included(EditorBookmarkShowCompareDto compare) =>
        [.. compare.Episodes.Where(episode => episode.WorkId is { } id && episode.Compare is { Match: BookmarkPackMatchResults.Match } && episode.NewCount > 0 && !_skipped.Contains(id))];

    private void Include(EditorBookmarkShowCompareEpisodeDto episode, bool include)
    {
        if (episode.WorkId is not { } id)
        {
            return;
        }

        if (include)
        {
            _skipped.Remove(id);
        }
        else
        {
            _skipped.Add(id);
        }
    }

    // One import per episode, keyed by its season and episode number in the file; only the bookmarks nothing in Everyone's is near.
    private Task TakeAllNewAsync(EditorBookmarkShowCompareDto compare)
    {
        foreach (var episode in Included(compare))
        {
            var items = episode.Compare!.Rows
                .Where(row => row.Closeness == BookmarkClosenessLabels.New)
                .Select(row => EditorBookmarkWording.ImportItem(row, replaceNearest: false))
                .ToList();
            if (items.Count > 0)
            {
                Pending.StageBookmarkOp(episode.WorkId!.Value, new EditorBookmarkOp { Kind = EditorBookmarkOpKinds.Import, Items = items },
                    EditorBookmarkWording.ImportedLine(items.Count, $"S{episode.SeasonNumber} E{episode.EpisodeNumber}"));
            }
        }

        _showCompare = null;
        return Task.CompletedTask;
    }

    public void Dispose() => Pending.Changed -= OnPendingChanged;
}
