@namespace MediaEngine.Web.Components.Editor
@using MediaEngine.Contracts.Editing
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Ui
@inject IStringLocalizer<SharedStrings> L

@* Review changes (universal editor spec D8, D12; v7 D11): the last stop before anything is saved, as a page of the pop-over window (it has no dialog of its
   own: every way into the editor, including ticked rows, saves through the window). It asks the Engine to check the whole list and shows what would change as a
   compact list, one line per change (field, old value struck through, new value, the same fact never twice), with one amber block when a file will move
   or be renamed, and saves only on "Save changes". Each row can be sent back to its tool
   (Edit) or taken out of the list (the row's menu). A row the Engine refuses shows its plain reason and blocks Save until it is fixed or
   removed. After a save that only partly went through it stays, shows every row's result and says what was saved. How the person left it is
   raised as an outcome. *@
<div class="@(IsPhone ? "review-changes review-changes--page review-changes--phone" : "review-changes review-changes--page")" data-phone="@(IsPhone ? "true" : null)">
    <header class="review-changes__heading">
        @if (Subtitle is not null)
        {
            <p>@Subtitle</p>
        }
    </header>
    @if (_notice is not null)
    {
        <AppAlert Tone="AppUiTone.Error">
            @_notice
            @if (!_afterSave)
            {
                <AppButton Label="@L["Common_CheckAgain"].Value" ButtonStyle="AppButtonStyle.Text" Class="review-changes__retry" Disabled="@Busy" OnClick="RefreshAsync" />
            }
        </AppAlert>
    }

    @if (_savedNote is not null)
    {
        <AppAlert Tone="AppUiTone.Warning" Class="review-changes__saved-note">@_savedNote</AppAlert>
    }

    @if (_loading)
    {
        <p class="review-changes__state">@L["ReviewChangesView_CheckingYourChanges"]</p>
    }
    else if (_rows.Count == 0)
    {
        <p class="review-changes__state">@L["ReviewChangesView_ThereAreNoChangesTo"]</p>
    }

    @if (Compact is { Count: > 0 } layout)
    {
        <ul class="review-changes__rows">
            @foreach (var row in layout.Lines)
            {
                var shown = StatusOf(row);
                var note = ReviewChangeLines.NoteFor(row);
                <li class="review-changes__row" data-row="@row.RowId" data-state="@shown.State">
                    <span class="review-changes__field">
                        @if (layout.MultipleItems)
                        {
                            <span class="review-changes__item">@row.Item</span>
                        }
                        @row.What
                    </span>
                    <span class="review-changes__change">
                        @if (ReviewChangeLines.HasBefore(row))
                        {
                            <s class="review-changes__before">@row.Before</s>
                            <span class="review-changes__arrow" aria-hidden="true">&rarr;</span>
                        }
                        <span class="review-changes__after">@row.After</span>
                        @if (row.NowYours)
                        {
                            <span class="review-changes__yours" data-now-yours>&mdash; @L["ReviewChangesView_NowYours"]</span>
                        }
                    </span>
                    @RowActions(row)
                    @if (note is not null)
                    {
                        <span class="review-changes__detail">@note</span>
                    }
                    @if (shown.Text is not null)
                    {
                        <span class="review-changes__status review-changes__detail" role="@(shown.State == "invalid" || shown.State == "failed" ? "alert" : "status")">@shown.Text</span>
                    }
                </li>
            }
        </ul>
        @if (layout.FileHeading is { } heading)
        {
            @* The one amber block (editor v7 D11): every file that will move or be renamed, each said once. *@
            <AppAlert Tone="AppUiTone.Warning" Class="review-changes__move">
                <strong>@heading</strong>
                <ul class="review-changes__rows review-changes__rows--files">
                    @foreach (var entry in layout.Files)
                    {
                        var shown = StatusOf(entry.Row);
                        <li class="review-changes__row review-changes__row--file" data-row="@entry.Row.RowId" data-state="@shown.State">
                            <span class="review-changes__change">
                                @if (layout.MultipleItems)
                                {
                                    <span class="review-changes__item">@entry.Row.Item</span>
                                }
                                @entry.Text
                            </span>
                            @RowActions(entry.Row)
                            @if (shown.Text is not null)
                            {
                                <span class="review-changes__status review-changes__detail" role="@(shown.State == "invalid" || shown.State == "failed" ? "alert" : "status")">@shown.Text</span>
                            }
                        </li>
                    }
                </ul>
                <span class="review-changes__detail">@L["ReviewChangesView_CannotBeUndone"]</span>
            </AppAlert>
        }
    }

    <p class="review-changes__note">@L["ReviewChangesView_ProviderRecordsAreNeverModified"]</p>
    @if (Source.ShowsFilesStatus)
    {
        <ReviewFilesStatus Source="Source" Disabled="@Busy" />
    }
    <AppActionBar Class="review-changes__footer">
    @if (_finished)
    {
        <AppButton Label="@L["Common_Close"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="BackAsync" />
    }
    else
    {
        @* One row at the foot (editor v7 D11): Back to editing alone at the left, Discard and Save changes together at the right. A phone stacks them, Save changes first. *@
        <AppButton Label="@L["ReviewChangesView_BackToEditing"].Value" ButtonStyle="AppButtonStyle.Text" Class="app-footer-start" Disabled="@Busy" OnClick="BackAsync" />
        <AppButton Label="@L["ReviewChangesView_DiscardChanges"].Value" ButtonStyle="AppButtonStyle.Outlined" Disabled="@Busy" OnClick="DiscardAsync" />
        <AppButton Label="@SaveLabel"
                   ButtonStyle="AppButtonStyle.Filled"
                   Tone="AppUiTone.Primary"
                   Loading="@_saving"
                   Disabled="@(!CanSave)"
                   OnClick="SaveAsync" />
    }
    </AppActionBar>
</div>

@code {
    private RenderFragment RowActions(EditReviewRow row) => @<text>
        @if (!_finished)
        {
            <span class="review-changes__actions">
                @if (Source.CanJumpTo(row))
                {
                    <AppButton Label="@L["Common_Edit"].Value" ButtonStyle="AppButtonStyle.Text" Disabled="@Busy" aria-label="@($"Edit {row.What} for {row.Item}")" OnClick="@(() => EditAsync(row))" />
                }
                <AppRowMenu AriaLabel="@($"More actions for {row.What}")" Items="@MenuFor(row)" />
            </span>
        }
    </text>;

    private readonly Dictionary<string, EditSessionChangeResult> _results = new(StringComparer.Ordinal);
    private List<EditReviewRow> _rows = [];
    private bool _loading = true;
    private bool _saving;
    private bool _afterSave;
    private bool _finished;
    private string? _notice;
    private string? _savedNote;

    [Parameter, EditorRequired] public IReviewSource Source { get; set; } = default!;

    /// <summary>Raised when the person leaves Review: back to editing, to a tool, discarded, or saved.</summary>
    [Parameter] public EventCallback<ReviewChangesOutcome> OnOutcome { get; set; }

    /// <summary>The phone arrangement (v6 section 4a): a full-screen step with every change listed and the footer stacked, Save changes first.</summary>
    [Parameter] public bool Phone { get; set; }

    /// <summary>The arrangement the window is drawn in (cascaded from the editor window); the <c>Phone</c> parameter still works on its own.</summary>
    [CascadingParameter] public EditorWindowLayout? Layout { get; set; }

    private bool IsPhone => EditorWindowLayout.IsPhone(Phone, Layout);

    /// <summary>True while a save is running, so a host can refuse to close.</summary>
    public bool IsSaving => _saving;

    private bool Busy => _loading || _saving;

    private ReviewChangeLayout? Compact => _rows.Count == 0 ? null : ReviewChangeLines.Build(_rows);

    // "3 changes to The Sea of Monsters" (editor v7 D11): the count and the item, in one line.
    private string? Subtitle
    {
        get
        {
            if (_finished || Compact is not { } layout)
            {
                return null;
            }

            var count = layout.Count == 1 ? "1 change" : $"{layout.Count} changes";
            var items = _rows.Select(row => row.Item).Distinct(StringComparer.Ordinal).ToList();
            return items.Count == 1 ? $"{count} to {items[0]}" : $"{count} to {items.Count} items";
        }
    }

    private bool HasInvalidRow => !_afterSave && _rows.Any(row => IsRefused(row));

    private bool CanSave => !Busy && _rows.Count > 0 && _notice is null && !HasInvalidRow;

    private string SaveLabel => _saving ? "Saving..." : "Save changes";

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    // Rebuilds the rows from the pending list and asks the Engine to check them. A change the check refuses keeps its reason on its row.
    private async Task RefreshAsync()
    {
        _rows = [.. Source.ReviewRows()];
        _results.Clear();
        _notice = null;
        _afterSave = false;
        if (_rows.Count == 0)
        {
            _loading = false;
            return;
        }

        _loading = true;
        StateHasChanged();
        var outcome = await Source.PreviewAsync();
        if (outcome.Results is { } results)
        {
            foreach (var result in results)
            {
                _results[result.Id] = result;
            }
        }
        else
        {
            _notice = outcome.Message ?? "Your changes could not be checked.";
        }

        _loading = false;
    }

    private (string State, string? Text) StatusOf(EditReviewRow row)
    {
        if (!_results.TryGetValue(row.ChangeId, out var result))
        {
            return ("pending", null);
        }

        var reason = string.IsNullOrWhiteSpace(result.Reason) ? "This change could not be saved." : result.Reason;
        return result.Status switch
        {
            EditSessionChangeStatuses.Invalid or EditSessionChangeStatuses.Failed => (result.Status, reason),
            EditSessionChangeStatuses.NotApplied => ("not_applied", "Not applied"),
            // A passed check is not worth a line; after a save it means saved, unless the whole list was held back.
            _ => _afterSave ? (Source.DataSaved ? "ok" : "not_applied", Source.DataSaved ? "Saved" : "Not applied") : ("ok", null),
        };
    }

    private bool IsRefused(EditReviewRow row) =>
        _results.TryGetValue(row.ChangeId, out var result) && result.Status is EditSessionChangeStatuses.Invalid or EditSessionChangeStatuses.Failed;

    private IReadOnlyList<AppRowMenuItem> MenuFor(EditReviewRow row) =>
    [
        new AppRowMenuItem
        {
            Label = L["ReviewChangesView_RemoveThisChange"].Value,
            Icon = AppMaterialIcons.Outlined.Close,
            Destructive = true,
            Disabled = Busy,
            OnClick = EventCallback.Factory.Create(this, () => RemoveAsync(row)),
        },
    ];

    private async Task RemoveAsync(EditReviewRow row)
    {
        Source.RemoveReviewRow(row);
        await RefreshAsync();
    }

    private async Task EditAsync(EditReviewRow row)
    {
        if (!Source.CanJumpTo(row))
        {
            return;
        }

        await Source.JumpToAsync(row);
        await OnOutcome.InvokeAsync(ReviewChangesOutcome.Edit);
    }

    private Task BackAsync() => _saving ? Task.CompletedTask : OnOutcome.InvokeAsync(ReviewChangesOutcome.Back);

    private async Task DiscardAsync()
    {
        // Asks "Unsaved changes" first; staying keeps this dialog and every change.
        if (await Source.LeaveAsync())
        {
            await OnOutcome.InvokeAsync(ReviewChangesOutcome.Discarded);
        }
    }

    private async Task SaveAsync()
    {
        if (!CanSave)
        {
            return;
        }

        _saving = true;
        _notice = null;
        var saved = await Source.SaveAsync();
        _saving = false;
        if (saved)
        {
            await OnOutcome.InvokeAsync(ReviewChangesOutcome.Saved);
            return;
        }

        _results.Clear();
        foreach (var result in Source.Results)
        {
            _results[result.Id] = result;
        }

        _afterSave = true;
        if (Source.DataSaved)
        {
            // The data is in the library; what is left are file moves (or similar) that did not go through. The rows are no longer editable.
            var failed = _rows.Count(row => _results.TryGetValue(row.ChangeId, out var result) && result.Status != EditSessionChangeStatuses.Ok);
            var onlyMoves = _rows.Where(row => _results.TryGetValue(row.ChangeId, out var result) && result.Status != EditSessionChangeStatuses.Ok)
                .All(row => EditSessionChangeKinds.IsFileChange(row.Kind));
            _savedNote = onlyMoves
                ? $"Your changes were saved; {failed} file {(failed == 1 ? "move" : "moves")} could not be completed."
                : $"Your changes were saved; {failed} {(failed == 1 ? "change" : "changes")} could not be completed.";
            _finished = true;
        }
        else if (!string.IsNullOrWhiteSpace(Source.Message))
        {
            _notice = Source.Message;
        }
        else if (_results.Count == 0)
        {
            _notice = L["ReviewChangesView_NothingWasSavedTryAgain"].Value;
        }
    }
}
