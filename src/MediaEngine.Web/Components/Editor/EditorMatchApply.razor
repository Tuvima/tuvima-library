@namespace MediaEngine.Web.Components.Editor
@inject IStringLocalizer<SharedStrings> L

@* The foot of the Match card (universal editor v6, D7): Apply match at the bottom right, with Cancel before it when there is a current match to go back
   to, and one line under it saying what Apply does ("Links this book to Apple Books."). Apply is always available once something is chosen; the
   verdict is advice. Apply only stages; Save changes writes. The search, the TV, music and Wikidata flows put it in the card's Foot. *@
<div class="@(IsPhone ? "tl-mapply__buttons tl-mapply__buttons--phone" : "tl-mapply__buttons")">
    @if (ShowCancel)
    {
        <AppButton Label="@(CancelLabel ?? L["EditorMatchResults_Cancel"].Value)" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" OnClick="OnCancel" data-testid="@CancelTestId" />
    }
    <AppButton Label="@(ApplyLabel ?? L["EditorMatchResults_ApplyMatch"].Value)" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(!CanApply)" OnClick="OnApply" data-testid="@ApplyTestId" />
</div>
@if (!string.IsNullOrWhiteSpace(Line))
{
    <span class="@(IsPhone ? "tl-mapply__line tl-mapply__line--phone" : "tl-mapply__line")" data-testid="match-apply-line">@Line</span>
}

@code {
    [Parameter] public bool CanApply { get; set; }

    [Parameter] public bool ShowCancel { get; set; }

    [Parameter] public EventCallback OnApply { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>What Apply does, in one line.</summary>
    [Parameter] public string? Line { get; set; }

    /// <summary>The button's word when it is not "Apply match" (the Wikidata side says "Apply identity").</summary>
    [Parameter] public string? ApplyLabel { get; set; }

    [Parameter] public string? CancelLabel { get; set; }

    [Parameter] public string ApplyTestId { get; set; } = "match-apply";

    [Parameter] public string CancelTestId { get; set; } = "match-cancel";

    [CascadingParameter] public MediaEngine.Web.Services.Editing.EditorWindowLayout? Layout { get; set; }

    // On a phone the buttons share the width (Apply match the wider) and the line under them is centered.
    private bool IsPhone => MediaEngine.Web.Services.Editing.EditorWindowLayout.IsPhone(false, Layout);
}
