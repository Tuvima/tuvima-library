    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            if (_focusPending && _focusId is { } focus)
            {
                _focusPending = false;
                await JS.InvokeVoidAsync("tuvimaFocusById", focus);
            }

            await SyncObserverAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit ended; there is nothing left to focus or observe.
        }
    }

    // The "Showing n of N" row is watched so the next page comes in as it scrolls near; the row is also a button for keyboards and when scripts are off.
    private async Task SyncObserverAsync()
    {
        var wanted = _open == Open.Item && _hasMore;
        if (!wanted)
        {
            await StopObservingAsync();
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ObserverModule);
        _observed ??= DotNetObjectReference.Create(new MoreCallback(() => InvokeAsync(LoadMoreAsync)));
        await _module.InvokeVoidAsync("observeById", MoreId, _observed, new { rootMargin = "120px 0px" });
    }

    private async Task StopObservingAsync()
    {
        if (_observed is null)
        {
            return;
        }

        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("disconnectById", MoreId);
            }
        }
        catch (JSDisconnectedException)
        {
            // Nothing left to disconnect.
        }

        _observed.Dispose();
        _observed = null;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _reads?.Cancel();
        _reads?.Dispose();
        if (_flow is not null)
        {
            _flow.Changed -= OnChanged;
            _flow.Session.Changed -= OnChanged;
        }

        await StopObservingAsync();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit ended first.
            }
        }
    }

    /// <summary>What the page-in observer calls when the "Showing n of N" row nears the screen.</summary>
    public sealed class MoreCallback(Func<Task> loadMore)
    {
        [JSInvokable]
        public Task LoadMoreFromObserverAsync() => loadMore();
    }
}
