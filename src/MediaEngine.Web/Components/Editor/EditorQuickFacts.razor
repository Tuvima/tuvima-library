@namespace MediaEngine.Web.Components.Editor
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Ui
@implements IDisposable
@inject IJSRuntime JS
@inject ILogger<EditorQuickFacts> Logger
@inject IStringLocalizer<SharedStrings> L

@* Quick Facts (universal editor v4 D4, section 3a): three to five read-only facts that suit the kind of item being edited. Nothing here can
   be changed; it sits to the right of the form, and under it below 1280 px. A fact the Engine and the item's fields do not know is left
   out, never guessed. The file's path is not in the list: it shows once, on one line at the foot, shortened in the middle, with the whole
   path in a tooltip (hover, focus or a press) and a copy button (Editor v6 D14). Whether the library is Read-only or write-back is off is
   said once, by the editor's footer line, not here (D15). *@
@if (_model is { IsEmpty: false } model)
{
    <aside class="tl-quick-facts" aria-label="@L["EditorQuickFacts_Title"].Value" data-quick-facts-kind="@model.Kind.ToString().ToLowerInvariant()">
        <h3 class="tl-quick-facts__title">@L["EditorQuickFacts_Title"]</h3>
        @foreach (var fact in model.Facts)
        {
            <div class="tl-quick-facts__row" data-fact="@fact.Key">
                <span class="tl-quick-facts__icon" aria-hidden="true"><AppMaterialIcon Icon="@IconFor(fact.Icon)" Size="AppIconSize.Control20" /></span>
                <div class="tl-quick-facts__text">
                    <strong class="tl-quick-facts__value">@fact.Value</strong>
                    <small class="tl-quick-facts__label">@fact.Label</small>
                </div>
            </div>
        }
        @foreach (var note in model.Notes)
        {
            <div class="tl-quick-facts__note" data-note="@note" role="note">@note</div>
        }
        @if (model.OffersPreview && OnPreview.HasDelegate)
        {
            <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact" Class="tl-quick-facts__preview"
                       StartIcon="@AppMaterialIcons.Outlined.Visibility" data-quick-facts-preview="true" OnClick="OnPreview">@model.PreviewLabel</AppButton>
        }
        @if (model.FilePath is { } path)
        {
            var (start, end) = SplitPath(path);
            var copyText = _copied ? L["Common_Copied"].Value : L["EditorQuickFacts_CopyPath"].Value;
            <div class="tl-quick-facts__path" data-quick-facts-path="true">
                <span class="tl-quick-facts__path-icon" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FolderOpen" Size="AppIconSize.Control20" /></span>
                <AppTooltip Text="@path">
                    <span class="tl-quick-facts__path-text" tabindex="0" role="group" aria-label="@L["EditorQuickFacts_FilePath"].Value">
                        <span class="sr-only">@path</span>
                        <span class="tl-quick-facts__path-start" aria-hidden="true">@start</span><span class="tl-quick-facts__path-end" dir="rtl" aria-hidden="true"><bdi dir="ltr">@end</bdi></span>
                    </span>
                </AppTooltip>
                <AppIconButton Icon="@(_copied ? AppMaterialIcons.Outlined.Check : AppMaterialIcons.Outlined.ContentCopy)"
                               Size="AppControlSize.Compact"
                               ButtonStyle="AppButtonStyle.Text"
                               Class="tl-quick-facts__path-copy"
                               Tooltip="@copyText"
                               AriaLabel="@L["EditorQuickFacts_CopyPath"].Value"
                               data-quick-facts-copy="true"
                               OnClick="@(() => CopyPathAsync(path))" />
            </div>
            @if (_copyFailed)
            {
                <div class="tl-quick-facts__path-error" role="alert">@ClipboardInterop.FailedMessage("the path")</div>
            }
        }
    </aside>
}

@code {
    private QuickFactsModel _model = QuickFactsModel.Empty;
    private CancellationTokenSource? _copiedTimer;
    private bool _copied;
    private bool _copyFailed;
    private static readonly TimeSpan CopiedFor = TimeSpan.FromSeconds(2);

    // The path in two parts for the stylesheet to shorten in the middle at whatever width the panel has: the folders (the start, cut with an
    // ellipsis at its end) and the file name (the end, which gives way last, and then loses the front of its name, never its extension).
    private static (string Start, string End) SplitPath(string path)
    {
        var cut = path.LastIndexOfAny(['/', '\\']) + 1;
        return (path[..cut], path[cut..]);
    }

    private async Task CopyPathAsync(string path)
    {
        _copyFailed = false;
        switch (await JS.TryCopyAsync(path, Logger))
        {
            case ClipboardCopyResult.Copied:
                _copiedTimer?.Cancel();
                _copiedTimer?.Dispose();
                var timer = _copiedTimer = new CancellationTokenSource();
                _copied = true;
                StateHasChanged();
                try
                {
                    await Task.Delay(CopiedFor, timer.Token);
                }
                catch (OperationCanceledException)
                {
                    // Pressed again or the panel went away: the newer press (or the end of the page) owns the icon now.
                    return;
                }

                _copied = false;
                break;
            case ClipboardCopyResult.Failed:
                _copyFailed = true;
                break;
        }
    }

    public void Dispose()
    {
        _copiedTimer?.Cancel();
        _copiedTimer?.Dispose();
        _copiedTimer = null;
    }

    /// <summary>The editor's loaded item: its fields, kind and the Engine's totals.</summary>
    [Parameter] public ItemFieldEditSession? Fields { get; set; }

    /// <summary>A supporting file's Preview button: opens its Preview tab. Without it the button is not drawn.</summary>
    [Parameter] public EventCallback OnPreview { get; set; }

    /// <summary>Facts the caller already worked out (several files edited together sum their selection); with it the card reads nothing itself.</summary>
    [Parameter] public QuickFactsModel? Model { get; set; }

    protected override void OnParametersSet()
    {
        if (Model is not null)
        {
            _model = Model;
            return;
        }

        if (Fields is not { Loaded: true } fields)
        {
            _model = QuickFactsModel.Empty;
            return;
        }

        if (fields.SupportingFile is { } supportingFile)
        {
            // The file's own facts: Library never writes into a supporting file.
            _model = EditorQuickFactsBuilder.ForSupportingFile(supportingFile);
            return;
        }

        var kind = EditorQuickFactsBuilder.KindOf(fields.MediaType, fields.ScopeId, fields.SubjectKind, fields.QuickFacts);
        _model = EditorQuickFactsBuilder.WithFileFacts(
            EditorQuickFactsBuilder.Build(
                kind,
                keys => fields.Find(keys) is { } found ? found.DisplayValue ?? found.Value : null,
                fields.QuickFacts,
                fields.MediaType),
            fields.Header,
            fields.Identity?.ProviderName);
    }

    private static string IconFor(string name) => name switch
    {
        "Schedule" => AppMaterialIcons.Outlined.Schedule,
        "CalendarToday" => AppMaterialIcons.Outlined.CalendarToday,
        "HighQuality" => AppMaterialIcons.Outlined.HighQuality,
        "Storage" => AppMaterialIcons.Outlined.Storage,
        "MenuBook" => AppMaterialIcons.Outlined.MenuBook,
        "Tag" => AppMaterialIcons.Outlined.Tag,
        "FolderOpen" => AppMaterialIcons.Outlined.FolderOpen,
        "Person" => AppMaterialIcons.Outlined.Person,
        "People" => AppMaterialIcons.Outlined.People,
        "ViewAgenda" => AppMaterialIcons.Outlined.ViewAgenda,
        "LiveTv" => AppMaterialIcons.Outlined.LiveTv,
        "QueueMusic" => AppMaterialIcons.Outlined.QueueMusic,
        "LibraryBooks" => AppMaterialIcons.Outlined.LibraryBooks,
        "Hub" => AppMaterialIcons.Outlined.Hub,
        "RecordVoiceOver" => AppMaterialIcons.Outlined.RecordVoiceOver,
        "Check" => AppMaterialIcons.Outlined.Check,
        "InsertDriveFile" => AppMaterialIcons.Outlined.InsertDriveFile,
        "Collections" => AppMaterialIcons.Outlined.Collections,
        _ => AppMaterialIcons.Outlined.Folder,
    };
}
