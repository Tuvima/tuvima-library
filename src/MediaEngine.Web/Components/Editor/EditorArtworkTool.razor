@namespace MediaEngine.Web.Components.Editor
@using System.Globalization
@using MediaEngine.Contracts.Artwork
@using MediaEngine.Web.Components.Artwork
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Formatting
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject IAppDialogService Dialogs
@inject IStringLocalizer<SharedStrings> L

@* The Artwork tool of the pop-over editor (universal editor v4, section 3b; v4.1 WP3), drawn inside its window.
   One clean row of role tabs across the top (Poster, Background, Logo, ... each with its number of versions), then one row of actions
   (Upload, From URL, Choose from Library, Preferred, Remove, Refresh) beside a small preview (about 200 px on its long side) at the role's
   real shape with a "View full size" link under it (v7 D8: no zoom steps), the file's facts in a slim line, and one wrapping row of small version
   thumbnails. Clicking a version makes it Preferred and moves it to the front (D19). Upload, From URL,
   Choose from Library and Refresh open their source in place of the preview, with Language and Size filters for the provider's pictures.
   Choose from Library opens the Library's own picture picker above the window. A picture applies the moment it is chosen (v7 D9): a version
   clicked, a provider picture, an upload, a pasted link and a Library picture each change the item at once, the preview shows a short busy
   state, and a change that fails says so on one line under the actions with Try again. There is no Undo (the earlier pictures stay in the
   versions row) and Save changes never lists a picture. Remove asks first and happens at once. *@
@if (Picker is { ActiveSlot: { } slot } picker)
{
    var tabs = picker.Tabs;
    var preferred = picker.PreferredVersion(slot);
    var label = ArtworkPickerRules.LabelFor(slot, CoverLabel(picker));
    <section class="@(Phone ? "tl-art-picker tl-art-picker--phone tl-editor-touch" : "tl-art-picker")"
             data-phone="@(Phone ? "true" : null)"
             role="region"
             aria-label="@L["EditorArtworkTool_Artwork"].Value">
        <div class="tl-art-picker__body">
            @RoleTabs(picker, tabs, slot)

            @if (picker.CanFetchAllStills)
            {
                @* Pulls the provider's still for every episode under this item and applies them all at once. *@
                <div class="tl-art-picker__fetch">
                    <AppButton ButtonStyle="AppButtonStyle.Outlined"
                               Tone="AppUiTone.Neutral"
                               StartIcon="@AppMaterialIcons.Outlined.Image"
                               Class="tl-art-picker__fetch-all"
                               Disabled="@picker.Busy"
                               OnClick="@(() => picker.FetchAllStillsAsync())">
                        @L["EditorArtworkTool_FetchAllStills"]
                    </AppButton>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(picker.Message))
            {
                <AppAlert Severity="AppSeverity.Warning" Dense="true" Class="tl-art-picker__message">@picker.Message</AppAlert>
                @if (Phone && picker.SavedLoadFailed)
                {
                    @* Offline or the Engine did not answer (v6 section 4a): the same plain line, then Try again. Nothing staged is lost. *@
                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Class="tl-art-picker__retry" Disabled="@picker.Busy"
                               data-artwork-retry="true" OnClick="@(() => picker.RetryLoadSavedAsync())">@L["Common_TryAgain"]</AppButton>
                }
            }

            @if (_adding)
            {
                @ActionRow(picker, slot, preferred)
                @AddPanel(picker, slot, label)
            }
            else
            {
                @* One column at 1023 px and narrower (preview above actions and versions); on a computer the preview is on the left, the rest on the right. *@
                <div class="tl-art-picker__art">
                    @Preview(picker, slot, preferred, label)
                    <div class="tl-art-picker__controls">
                        @ActionRow(picker, slot, preferred)
                        @Info(picker, slot, preferred)
                        @Strip(picker, slot, label)
                    </div>
                </div>
            }
        </div>
    </section>
}

@code {
    private const string SourceProviders = "providers";
    private const string SourceUpload = "upload";
    private const string SourceLink = "link";
    private const string SourceLibrary = "library";

    // The small preview is about 200 px on its long side; the full-size view asks for the largest copy.
    private const int PreviewDrawnPx = 200;
    private const int FullDrawnPx = 1280;

    private static readonly IReadOnlyList<AppSelectOption> Sources =
    [
        new(SourceProviders, "Provider", AppMaterialIcons.Outlined.Search),
        new(SourceUpload, "Upload", AppMaterialIcons.Outlined.CloudUpload),
        new(SourceLink, "From URL", AppMaterialIcons.Outlined.Link),
        new(SourceLibrary, "Library", AppMaterialIcons.Outlined.PhotoLibrary),
    ];

    // People, series, curated collections and universes have no provider artwork to offer, so Provider is left out for them.
    private static readonly IReadOnlyList<AppSelectOption> SourcesWithoutProviders = Sources.Where(option => option.Value != SourceProviders).ToList();

    private static readonly IReadOnlyList<AppSelectOption> SizeOptions =
    [
        new(ArtworkCandidateFilter.AnySize, "All sizes"),
        new(ArtworkCandidateFilter.LargeOnly, $"Large ({ArtworkCandidateFilter.LargeFromPixels} px or more)"),
        new(ArtworkCandidateFilter.MediumOnly, $"Medium ({ArtworkCandidateFilter.MediumFromPixels} to {ArtworkCandidateFilter.LargeFromPixels - 1} px)"),
    ];

    private bool _opened;
    private string? _lastRequestedSlot;
    private bool _adding;
    private bool _full;
    private string _source = SourceProviders;
    private string _address = string.Empty;
    private string _language = ArtworkCandidateFilter.All;
    private bool _languageSeeded;
    private string _size = ArtworkCandidateFilter.AnySize;
    private EditingModeContext? _subscribed;
    private ArtworkPickerSession? _subscribedPicker;

    [Parameter, EditorRequired] public EditingModeContext? Mode { get; set; }

    [Parameter, EditorRequired] public ArtworkPickerSession? Picker { get; set; }

    /// <summary>The phone arrangement (v6 section 4a, D21): two pictures per row, 44 px targets, the picker as a full-screen step, photos and camera as sources.</summary>
    [Parameter] public bool Phone { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!ReferenceEquals(_subscribed, Mode))
        {
            if (_subscribed is not null)
            {
                _subscribed.Changed -= OnModeChanged;
            }

            _subscribed = Mode;
            if (_subscribed is not null)
            {
                _subscribed.Changed += OnModeChanged;
            }
        }

        if (!ReferenceEquals(_subscribedPicker, Picker))
        {
            if (_subscribedPicker is not null)
            {
                _subscribedPicker.Changed -= OnModeChanged;
            }

            _subscribedPicker = Picker;
            if (_subscribedPicker is not null)
            {
                _subscribedPicker.Changed += OnModeChanged;
            }
        }

        if (Picker is null)
        {
            return;
        }

        // The tool opens on the role it was asked for; a later request for another role moves the picker to that card.
        var requested = Mode?.OpenSectionArtworkSlot;
        if (!_opened)
        {
            _opened = true;
            _lastRequestedSlot = requested;
            await Picker.OpenAsync(requested);
        }
        else if (!string.Equals(requested, _lastRequestedSlot, StringComparison.OrdinalIgnoreCase))
        {
            _lastRequestedSlot = requested;
            if (requested is not null)
            {
                await Picker.OpenAsync(requested);
            }
        }
    }

    // -- Role tabs ----------------------------------------------------------------------------------------

    private RenderFragment RoleTabs(ArtworkPickerSession picker, IReadOnlyList<ArtworkPickerTab> tabs, string active) => __builder =>
    {
        // A show has pictures at three levels (its own, its seasons', its episodes' stills): one row of tabs per level.
        var groups = ArtworkPickerRules.GroupByLevel(tabs);
        <div class="tl-art-picker__levels" role="group" aria-label="@L["EditorArtworkTool_ArtworkToChange"].Value">
            @foreach (var group in groups)
            {
                <div class="tl-art-picker__level" data-level="@group.Level">
                    @if (groups.Count > 1)
                    {
                        <span class="tl-art-picker__level-name">@group.Level</span>
                    }
                    <div class="tl-art-picker__roles">
                        @foreach (var tab in group.Tabs)
                        {
                            var isActive = string.Equals(tab.Slot, active, StringComparison.OrdinalIgnoreCase);
                            var count = picker.VersionCount(tab.Slot);
                            var hasPicture = picker.PreferredVersion(tab.Slot) is not null;
                            @ThumbButton(
                                "tl-art-picker__role",
                                $"tl-art-picker__face tl-art-picker__face--role{(isActive ? " is-active" : string.Empty)}",
                                $"{tab.Label}, {(hasPicture ? "Preferred chosen" : "No artwork")}, {VersionsText(count)}",
                                isActive,
                                picker.Busy,
                                () => SelectSlotAsync(tab.Slot),
                                @<text>
                                    <strong>@tab.Label</strong>
                                    <span class="tl-art-picker__tab-count" aria-hidden="true">@count</span>
                                </text>)
                        }
                    </div>
                </div>
            }
        </div>
    };

    // -- One row of actions -------------------------------------------------------------------------------

    private RenderFragment ActionRow(ArtworkPickerSession picker, string slot, ArtworkPickerPicture? preferred) => __builder =>
    {
        var providers = Mode?.Fields.ProvidersAvailable != false;
        var hasVersions = picker.VersionCount(slot) > 0;
        <div class="tl-art-picker__actions" role="toolbar" aria-label="Artwork actions">
            <AppButton ButtonStyle="AppButtonStyle.Outlined"
                       Tone="AppUiTone.Neutral"
                       StartIcon="@AppMaterialIcons.Outlined.CloudUpload"
                       Class="tl-art-picker__action tl-art-picker__upload"
                       Disabled="@picker.Busy"
                       OnClick="@(() => BeginAddAsync(SourceUpload))">
                Upload
            </AppButton>
            <AppButton ButtonStyle="AppButtonStyle.Outlined"
                       Tone="AppUiTone.Neutral"
                       StartIcon="@AppMaterialIcons.Outlined.Link"
                       Class="tl-art-picker__action tl-art-picker__url"
                       Disabled="@picker.Busy"
                       OnClick="@(() => BeginAddAsync(SourceLink))">
                From URL
            </AppButton>
            <AppButton ButtonStyle="AppButtonStyle.Outlined"
                       Tone="AppUiTone.Neutral"
                       StartIcon="@AppMaterialIcons.Outlined.PhotoLibrary"
                       Class="tl-art-picker__action tl-art-picker__library"
                       Disabled="@(picker.Busy || !picker.CanChooseFromLibrary)"
                       OnClick="@(() => BeginAddAsync(SourceLibrary))">
                Choose from Library
            </AppButton>
            <span class="tl-art-picker__actions-sep" aria-hidden="true"></span>
            @* Clicking a version makes it Preferred (D19); this button says it is, and makes the first version Preferred when none is. *@
            <AppButton ButtonStyle="AppButtonStyle.Outlined"
                       Tone="AppUiTone.Neutral"
                       StartIcon="@(preferred is not null ? AppMaterialIcons.Outlined.Check : AppMaterialIcons.Outlined.Image)"
                       Class="@(preferred is not null ? "tl-art-picker__action tl-art-picker__prefer is-on" : "tl-art-picker__action tl-art-picker__prefer")"
                       aria-pressed="@(preferred is not null ? "true" : "false")"
                       Disabled="@(picker.Busy || preferred is not null || !hasVersions)"
                       OnClick="@(() => PreferFirstAsync(picker, slot))">
                Preferred
            </AppButton>
            <AppButton ButtonStyle="AppButtonStyle.Outlined"
                       Tone="AppUiTone.Error"
                       StartIcon="@AppMaterialIcons.Outlined.Delete"
                       Class="tl-art-picker__action tl-art-picker__delete"
                       Disabled="@(picker.Busy || preferred is null)"
                       OnClick="@(() => DeleteAsync(preferred))">
                Remove
            </AppButton>
            @if (providers)
            {
                <AppButton ButtonStyle="AppButtonStyle.Outlined"
                           Tone="AppUiTone.Neutral"
                           StartIcon="@AppMaterialIcons.Outlined.Refresh"
                           Class="tl-art-picker__action tl-art-picker__refresh"
                           Disabled="@picker.Busy"
                           OnClick="@(() => BeginAddAsync(SourceProviders, refresh: true))">
                    Refresh
                </AppButton>
            }
        </div>
        @if (picker.Failure is { } failure)
        {
            @* One plain line under the actions: what failed. The previous picture stays; Try again repeats the change. *@
            <div class="tl-art-picker__failure" role="alert">
                <span>@failure</span>
                @if (picker.CanRetryChange)
                {
                    <AppButton ButtonStyle="AppButtonStyle.Text"
                               Tone="AppUiTone.Neutral"
                               Size="AppControlSize.Compact"
                               Class="tl-art-picker__try-again"
                               Disabled="@picker.Busy"
                               OnClick="@(() => picker.RetryChangeAsync())">
                        @L["Common_TryAgain"]
                    </AppButton>
                }
            </div>
        }
    };

    // -- Preview and the file's facts ---------------------------------------------------------------------

    private RenderFragment Preview(ArtworkPickerSession picker, string slot, ArtworkPickerPicture? preferred, string label) => __builder =>
    {
        var shape = ShapeClass(slot, picker);
        var url = preferred is null ? null : picker.RolePictureUrl(slot) ?? preferred.ContentUrl;
        <div class="tl-art-picker__preview-col">
            <div class="@($"tl-art-picker__preview tl-art-picker__preview--{shape}{(picker.Applying ? " is-busy" : string.Empty)}")"
                 aria-busy="@(picker.Applying ? "true" : null)">
                @if (url is not null)
                {
                    <img class="tl-art-picker__image"
                         src="@MediaTileArtworkUrl.ForDrawnSize(url, PreviewDrawnPx)"
                         srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(url, PreviewDrawnPx)"
                         alt="@($"{label} preview")" />
                }
                else
                {
                    <span class="tl-art-picker__empty">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Image" />
                        <span>No artwork for this yet</span>
                    </span>
                }
                @if (picker.Applying)
                {
                    @* A short busy state while the change goes through; the buttons stay where they are. *@
                    <span class="tl-art-picker__busy"><AppSpinner Size="AppSize.Small" /></span>
                }
            </div>
            @if (url is not null)
            {
                <AppButton ButtonStyle="AppButtonStyle.Text"
                           Tone="AppUiTone.Neutral"
                           StartIcon="@AppMaterialIcons.Outlined.Fullscreen"
                           Class="tl-art-picker__fullsize"
                           OnClick="ShowFull">
                    View full size
                </AppButton>
            }
        </div>
        @if (_full && url is not null)
        {
            @* One picture, large, over the window; Close puts the tab back as it was. *@
            <AppViewer Class="tl-art-picker__full-viewer"
                       Label="@($"{label} full size")"
                       OnClose="HideFull"
                       CloseLabel="Close full size">
                <div class="tl-art-picker__full-stage">
                    <img class="tl-art-picker__full-image" src="@MediaTileArtworkUrl.ForDrawnSize(url, FullDrawnPx)" alt="@($"{label} full size")" />
                </div>
            </AppViewer>
        }
    };

    // A slim line under the preview: what the change reaches, and the file's name, source, size and type.
    private RenderFragment Info(ArtworkPickerSession picker, string slot, ArtworkPickerPicture? preferred) => __builder =>
    {
        <div class="tl-art-picker__info">
            <p class="tl-art-picker__reach">
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Info" />
                <span>@ArtworkPickerRules.ReachFor(slot, picker.MediaType, picker.SubjectKind)</span>
            </p>
            <p class="tl-art-picker__status" role="status">Click a version below to make it Preferred. It changes at once.</p>

            @if (preferred is not null)
            {
                <dl class="tl-art-picker__facts" aria-label="File facts">
                    @Fact("File name", preferred.FileName)
                    @Fact("Source", preferred.Source)
                    @Fact("Dimensions", preferred.Width is > 0 && preferred.Height is > 0 ? $"{preferred.Width} × {preferred.Height}" : null)
                    @Fact("Shape", ShapeText(ArtworkPickerRules.ShapeFor(slot, picker.MediaType)))
                    @Fact("File size", preferred.FileSizeBytes is { } bytes ? DisplayFormat.FormatFileSize(bytes) : null)
                    @Fact("Type", TypeText(preferred.ContentType))
                </dl>
            }
        </div>
    };

    private static RenderFragment Fact(string name, string? value) => __builder =>
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            <dt>@name</dt>
            <dd>@value</dd>
        }
    };

    // -- Versions strip ---------------------------------------------------------------------------------

    private RenderFragment Strip(ArtworkPickerSession picker, string slot, string label) => __builder =>
    {
        var versions = picker.Versions(slot);
        var preferredId = picker.PreferredAssetId(slot);
        var shape = ShapeClass(slot, picker);
        <div class="@($"tl-art-picker__strip tl-art-picker__strip--{shape}")" role="group" aria-label="@($"{label} versions. Choose one to make it Preferred.")">
            @if (picker.SavedLoading && versions.Count == 0)
            {
                <AppPageState Kind="AppPageStateKind.Loading" Title="Loading saved pictures" />
            }

            @foreach (var version in versions)
            {
                var isPreferred = version.AssetId == preferredId;
                @ThumbButton(
                    "tl-art-picker__version",
                    $"tl-art-picker__face tl-art-picker__face--version tl-art-picker__thumb--{shape}{(isPreferred ? " is-preferred" : string.Empty)}",
                    $"{version.Caption}{(isPreferred ? ", Preferred" : string.Empty)}",
                    isPreferred,
                    picker.Busy,
                    () => picker.MakePreferredAsync(version),
                    @<text>
                        <img src="@MediaTileArtworkUrl.ForDrawnSize(version.ThumbnailUrl, 96)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(version.ThumbnailUrl, 96)" alt="" loading="lazy" decoding="async" />
                        @if (isPreferred)
                        {
                            <span class="tl-art-picker__chip">Preferred</span>
                        }
                    </text>)
            }

            @ThumbButton(
                "tl-art-picker__version tl-art-picker__add-version",
                $"tl-art-picker__face tl-art-picker__face--version tl-art-picker__face--add tl-art-picker__thumb--{shape}",
                "Add version",
                false,
                picker.Busy,
                () => BeginAddAsync(),
                @<text><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Add" /></text>)
        </div>
    };

    // -- Add artwork (Provider, Upload, Link) -------------------------------------------------------------

    private RenderFragment AddPanel(ArtworkPickerSession picker, string slot, string label) => __builder =>
    {
        var shape = ArtworkPickerRules.ShapeFor(slot, picker.MediaType);
        var shapeClass = ShapeClass(slot, picker);
        var providers = Mode?.Fields.ProvidersAvailable != false;
        <div class="@(Phone ? "tl-art-picker__add-panel tl-art-picker__add-panel--step" : "tl-art-picker__add-panel")" data-artwork-step="@(Phone ? "true" : null)">
            @if (Phone)
            {
                @* On a phone the picker is a full-screen step with a way back (v6 section 4a). *@
                <div class="tl-art-picker__step-bar">
                    <AppIconButton Icon="@AppMaterialIcons.Outlined.ArrowBack"
                                   Tooltip="@L["Common_Back"].Value"
                                   AriaLabel="@($"Back to {label}")"
                                   Class="tl-art-picker__back"
                                   OnClick="EndAdd" />
                    <strong>@($"Add a {label.ToLowerInvariant()}")</strong>
                </div>
            }
            <div class="@(Phone ? "tl-art-picker__step-body" : "tl-art-picker__add-flow")">
            <div class="tl-art-picker__add-head">
                @if (!Phone)
                {
                    <strong>@($"Add a {label.ToLowerInvariant()}")</strong>
                }
                <span class="tl-art-picker__muted">@label · @ShapeText(shape)</span>
                <AppSegmentedControl Class="tl-art-picker__sources"
                                     AriaLabel="@L["EditorArtworkTool_WhereToFindArtwork"].Value"
                                     Options="@(providers ? Sources : SourcesWithoutProviders)"
                                     Value="@_source"
                                     ValueChanged="SelectSourceAsync" />
                @if (!Phone)
                {
                    <AppButton ButtonStyle="AppButtonStyle.Text"
                               Tone="AppUiTone.Neutral"
                               StartIcon="@AppMaterialIcons.Outlined.ArrowBack"
                               Class="tl-art-picker__back"
                               OnClick="EndAdd">
                        @($"Back to {label}")
                    </AppButton>
                }
            </div>

            @switch (_source)
            {
                case SourceUpload when Phone:
                    @* The phone's own photos or its camera, through the same upload as on a computer (same types and size limit). *@
                    <p class="tl-art-picker__hint">@L["EditorArtworkTool_ChooseAJPEGOrPNG"]</p>
                    <div class="tl-art-picker__phone-sources">
                        <AppFileUpload T="IBrowserFile" Accept="image/jpeg,image/png" FilesChanged="UploadAsync" Disabled="@picker.Busy" data-artwork-photos="true">
                            <CustomContent Context="upload">
                                <AppButton ButtonStyle="AppButtonStyle.Outlined" StartIcon="@AppMaterialIcons.Outlined.PhotoLibrary" Disabled="@picker.Busy"
                                           OnClick="@(() => upload.OpenFilePickerAsync())">@L["EditorPhone_ArtworkChoosePhoto"]</AppButton>
                            </CustomContent>
                        </AppFileUpload>
                        <AppFileUpload T="IBrowserFile" Accept="image/jpeg,image/png" FilesChanged="UploadAsync" Disabled="@picker.Busy" capture="environment" data-artwork-camera="true">
                            <CustomContent Context="upload">
                                <AppButton ButtonStyle="AppButtonStyle.Outlined" StartIcon="@AppMaterialIcons.Outlined.PhotoCamera" Disabled="@picker.Busy"
                                           OnClick="@(() => upload.OpenFilePickerAsync())">@L["EditorPhone_ArtworkTakePhoto"]</AppButton>
                            </CustomContent>
                        </AppFileUpload>
                    </div>
                    break;
                case SourceUpload:
                    <p class="tl-art-picker__hint">@L["EditorArtworkTool_ChooseAJPEGOrPNG"]</p>
                    <AppFileUpload T="IBrowserFile" Accept="image/jpeg,image/png" FilesChanged="UploadAsync" Disabled="@picker.Busy" />
                    break;
                case SourceLink:
                    <AppTextField Label="@L["EditorArtworkTool_PictureWebAddress"].Value"
                                  Placeholder="https://"
                                  Value="@_address"
                                  ValueChanged="@((string? value) => _address = value ?? string.Empty)" />
                    <div>
                        <AppButton ButtonStyle="AppButtonStyle.Outlined"
                                   StartIcon="@AppMaterialIcons.Outlined.Link"
                                   Disabled="@(picker.Busy || string.IsNullOrWhiteSpace(_address))"
                                   OnClick="PasteLinkAsync">
                            @L["EditorArtworkTool_FetchPicture"]
                        </AppButton>
                    </div>
                    break;
                case SourceLibrary:
                    <p class="tl-art-picker__hint">Choose a picture that is already in your Library: this item's other pictures, its family's and, for a Universe, its other things'.</p>
                    <div>
                        <AppButton ButtonStyle="AppButtonStyle.Outlined"
                                   StartIcon="@AppMaterialIcons.Outlined.PhotoLibrary"
                                   Class="tl-art-picker__open-library"
                                   Disabled="@(picker.Busy || !picker.CanChooseFromLibrary)"
                                   OnClick="@(() => OpenLibraryAsync(closeIfNone: false))">
                            Choose from Library
                        </AppButton>
                    </div>
                    break;
                default:
                    @ProviderSource(picker, slot, shapeClass)
                    break;
            }

            </div>
        </div>
    };

    private RenderFragment ProviderSource(ArtworkPickerSession picker, string slot, string shapeClass) => __builder =>
    {
        if (picker.ProviderLoading)
        {
            <AppPageState Kind="AppPageStateKind.Loading" Title="Finding provider artwork" />
        }
        else if (picker.Provider is null)
        {
            <p class="tl-art-picker__hint">Ask the providers this item is matched with for pictures.</p>
            <div>
                <AppButton ButtonStyle="AppButtonStyle.Outlined" StartIcon="@AppMaterialIcons.Outlined.Search" OnClick="picker.LoadProviderAsync">
                    Find provider artwork
                </AppButton>
            </div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(picker.Provider.Message))
            {
                <p class="tl-art-picker__hint">@picker.Provider.Message</p>
                @if (picker.Provider.Message == ProviderArtworkDiscoveryDto.UnmatchedTvShowMessage && Mode is { Fields.CanMatch: true } matchMode)
                {
                    <div>
                        <AppButton ButtonStyle="AppButtonStyle.Outlined" StartIcon="@AppMaterialIcons.Outlined.Search"
                                   OnClick="@(() => matchMode.ShowSectionAsync(EditingSection.Match))">
                            Open Match and Identity
                        </AppButton>
                    </div>
                }
            }

            var appLanguage = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
            var languages = ArtworkCandidateFilter.Languages(picker.Provider.Items, appLanguage);
            var hasSizes = picker.Provider.Items.Any(item => item.Width is not null || item.Height is not null);
            if (!_languageSeeded && picker.Provider.Items.Count > 0)
            {
                // The list opens on the app's language when the provider has pictures in it.
                _language = ArtworkCandidateFilter.DefaultLanguage(picker.Provider.Items, appLanguage);
                _languageSeeded = true;
            }

            var shown = ArtworkCandidateFilter.SortBySize(ArtworkCandidateFilter.Apply(picker.Provider.Items, _language, _size));
            @if (languages.Count > 1 || hasSizes)
            {
                <div class="tl-art-picker__filters">
                    @if (languages.Count > 1)
                    {
                        <AppSelect T="string"
                                   Label="Language"
                                   Value="@_language"
                                   ValueChanged="@((string value) => _language = value)"
                                   Options="@(new[] { new AppSelectOption(ArtworkCandidateFilter.All, "All languages") }.Concat(languages.Select(entry => new AppSelectOption(entry.Value, entry.Label))).ToList())" />
                    }
                    @if (hasSizes)
                    {
                        <AppSelect T="string"
                                   Label="Size"
                                   Value="@_size"
                                   ValueChanged="@((string value) => _size = value)"
                                   Options="@SizeOptions" />
                    }
                    <span class="tl-art-picker__muted tl-art-picker__count">@($"{shown.Count} pictures · largest first")</span>
                </div>
            }

            @if (shown.Count == 0)
            {
                <p class="tl-art-picker__hint">No pictures match these filters.</p>
            }

            <div class="@($"tl-art-picker__grid tl-art-picker__grid--{shapeClass}")" role="group" aria-label="Provider pictures">
                @foreach (var candidate in shown)
                {
                    var small = ArtworkPickerRules.IsSmall(slot, candidate.Width, candidate.Height);
                    @ThumbButton(
                        "tl-art-picker__tile",
                        $"tl-art-picker__face tl-art-picker__face--tile{(candidate.AlreadyAdded ? " is-disabled" : string.Empty)}",
                        $"{candidate.Provider} picture{(candidate.AlreadyAdded ? ", already saved" : string.Empty)}{(small ? ", small" : string.Empty)}",
                        false,
                        candidate.AlreadyAdded || picker.Busy,
                        () => ChooseProviderAsync(candidate),
                        @<text>
                            <span class="@($"tl-art-picker__thumb tl-art-picker__thumb--{shapeClass}{(small ? " is-small" : string.Empty)}")">
                                <img src="@MediaTileArtworkUrl.ForDrawnSize(candidate.ThumbnailUrl, 160)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(candidate.ThumbnailUrl, 160)" alt="" loading="lazy" decoding="async" />
                            </span>
                            <span class="tl-art-picker__caption">
                                @CandidateCaption(candidate)
                                @if (small)
                                {
                                    <span class="tl-art-picker__small">Small</span>
                                }
                            </span>
                        </text>)
                }
            </div>
        }
    };

    // -- Helpers --------------------------------------------------------------------------------------------

    // The one bare button of this tool: role cards, versions and provider tiles are all pictures you press.
    private RenderFragment ThumbButton(string cssClass, string faceClass, string ariaLabel, bool pressed, bool disabled, Func<Task> onClick, RenderFragment content) => __builder =>
    {
        <AppNativeButton Type="button"
                         Class="@($"tl-art-picker__hit {cssClass}")"
                         Disabled="@disabled"
                         AriaLabel="@ariaLabel"
                         aria-pressed="@(pressed ? "true" : "false")"
                         OnClick="@(() => onClick())">
            <span class="@faceClass">@content</span>
        </AppNativeButton>
    };

    private static string ShapeClass(string slot, ArtworkPickerSession picker) =>
        ArtworkPickerRules.ShapeFor(slot, picker.MediaType).ToString().ToLowerInvariant();

    private static string ShapeText(ArtworkRoleShape shape) => shape switch
    {
        ArtworkRoleShape.Landscape => "Landscape 16:9",
        ArtworkRoleShape.Wide => "Wide logo",
        ArtworkRoleShape.Square => "Square 1:1",
        _ => "Portrait 2:3",
    };

    private static string VersionsText(int count) => count == 1 ? "1 version" : $"{count} versions";

    private static string? Dimensions(int? width, int? height) =>
        width is > 0 && height is > 0 ? $"{width} × {height}" : null;

    private static string? TypeText(string? contentType) =>
        string.IsNullOrWhiteSpace(contentType) ? null : contentType.Split('/').Last().ToUpperInvariant();

    private static string CandidateCaption(ProviderArtworkCandidateDto candidate)
    {
        if (candidate.AlreadyAdded)
        {
            return "Already saved";
        }

        var size = Dimensions(candidate.Width, candidate.Height);
        var language = ArtworkCandidateFilter.LabelFor(candidate.Language) ?? "No text";
        return size is null ? $"{candidate.Provider} · {language}" : $"{size} · {language}";
    }

    private static string CoverLabel(ArtworkPickerSession picker) =>
        ArtworkPickerRules.TabsFor(["CoverArt"], picker.MediaType).FirstOrDefault()?.Label ?? "Poster";

    private void ShowFull() => _full = true;

    private void HideFull() => _full = false;

    // Opens the add panel on a source. Refresh asks the providers again even when their pictures are already listed; Choose from Library opens
    // the Library's picker at once, and a picker closed without a choice goes back to the preview.
    private async Task BeginAddAsync(string? source = null, bool refresh = false)
    {
        var providers = Mode?.Fields.ProvidersAvailable != false;
        _adding = true;
        _address = string.Empty;
        _languageSeeded = false;
        _source = source is null || (source == SourceProviders && !providers) ? providers ? SourceProviders : SourceUpload : source;
        if (_source == SourceProviders && Picker is { ProviderLoading: false } picker && (refresh || picker.Provider is null))
        {
            await picker.LoadProviderAsync();
        }
        else if (_source == SourceLibrary)
        {
            await OpenLibraryAsync(closeIfNone: true);
        }
    }

    private void EndAdd() => _adding = false;

    // A provider picture is added to the item and made Preferred at once; the add panel closes when it went through.
    private async Task ChooseProviderAsync(ProviderArtworkCandidateDto candidate)
    {
        if (Picker is not null && await Picker.ChooseProviderAsync(candidate))
        {
            _adding = false;
        }
    }

    // "Choose from Library": the Library's own picture picker, opened above the editor window (the dialog service stacks it in front of the
    // modal editor). What is chosen is added to this item as a version, the same as an upload, and made Preferred at once.
    private async Task OpenLibraryAsync(bool closeIfNone)
    {
        if (Picker is not { } picker || picker.LibraryQuery() is not { } query || picker.LibraryTarget() is not { } target)
        {
            return;
        }

        var label = ArtworkPickerRules.LabelFor(picker.ActiveSlot ?? string.Empty, CoverLabel(picker));
        var dialog = await Dialogs.ShowAsync<ArtworkAssetPickerDialog>(
            string.Empty,
            new AppDialogParameters<ArtworkAssetPickerDialog>
            {
                { component => component.Query, query },
                { component => component.TargetItem, target },
                { component => component.TargetSummary, $"{target.DisplayTitle} > {label}" },
                { component => component.DeferLinks, false },
            },
            new AppDialogOptions { NoHeader = true, FullWidth = true, MaxWidth = AppMaxWidth.Large, Position = AppDialogPosition.Center, BackdropClick = false, CloseOnEscapeKey = true });
        if (await dialog.Result is { Canceled: false, Data: List<Guid> { Count: > 0 } added })
        {
            if (await picker.UseLibraryPicturesAsync(added))
            {
                _adding = false;
            }
        }
        else if (closeIfNone)
        {
            EndAdd();
        }
    }

    // The Preferred button when no version is Preferred: the first one becomes it (a click on any version does the same).
    private async Task PreferFirstAsync(ArtworkPickerSession picker, string slot)
    {
        if (picker.Versions(slot).FirstOrDefault() is { } first)
        {
            await picker.MakePreferredAsync(first);
        }
    }

    private async Task SelectSlotAsync(string slot)
    {
        if (Picker is null)
        {
            return;
        }

        _address = string.Empty;
        _adding = false;
        _full = false;
        _languageSeeded = false;
        await Picker.SelectSlotAsync(slot);
    }

    private async Task SelectSourceAsync(string source)
    {
        _source = source;
        if (Picker is null)
        {
            return;
        }

        if (source == SourceProviders && Picker.Provider is null && !Picker.ProviderLoading)
        {
            await Picker.LoadProviderAsync();
        }
    }

    // An upload and a pasted link are stored as versions of the item and made Preferred at once; the add panel closes when that went through.
    private async Task UploadAsync(IBrowserFile? file)
    {
        if (Picker is not null && file is not null && await Picker.UploadAsync(file))
        {
            _adding = false;
        }
    }

    private async Task PasteLinkAsync()
    {
        if (Picker is not null && await Picker.PasteLinkAsync(_address))
        {
            _address = string.Empty;
            _adding = false;
        }
    }

    private async Task DeleteAsync(ArtworkPickerPicture? version)
    {
        if (Picker?.ActiveSlot is not { } slot || version is null)
        {
            return;
        }

        // Delete is the one artwork action that happens at once (spec 3b), so it asks first and shows the picture that would go.
        var label = ArtworkPickerRules.LabelFor(slot, CoverLabel(Picker));
        if (await ArtworkRemoveConfirmation.AskRemoveAsync(
                Dialogs,
                label,
                version.ThumbnailUrl,
                "This takes the picture out of the item now, without waiting for Save changes. Other versions stay."))
        {
            await Picker.DeleteVersionAsync(version);
        }
    }

    private void OnModeChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnModeChanged;
        }

        if (_subscribedPicker is not null)
        {
            _subscribedPicker.Changed -= OnModeChanged;
        }

        Picker?.Close();
    }
}
