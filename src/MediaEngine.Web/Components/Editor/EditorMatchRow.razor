@namespace MediaEngine.Web.Components.Editor

@* The first row of the TV, music and Wikidata flows (universal editor v5, 3c): the provider dropdown, then the boxes of the item's kind and an
   icon-only Search. The "Media providers / Wikidata" selector is no longer in it (v6 D1): the Match tab draws it once on its own line above
   the row. The plain search no longer uses this row; it uses the shared form row (v6 D3), and a later packet moves these flows onto it too. *@
<div class="tl-matchrow" data-testid="match-row">
    <div class="tl-matchrow__start">@Start</div>
</div>

@code {
    /// <summary>What sits in the row: the provider dropdown, the boxes and Search.</summary>
    [Parameter] public RenderFragment? Start { get; set; }
}
