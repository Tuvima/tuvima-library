@namespace MediaEngine.Web.Components.Setup
@using MediaEngine.Contracts.Settings
@using MediaEngine.Contracts.Vault
@using MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Services.Vault
@inject IEngineApiClient ApiClient
@inject NsfwModeState Nsfw
@inject DashboardIdentityClient Identity
@inject ConfirmedActionRunner Confirmed
@inject DeviceContextService DeviceContext
@inject IStringLocalizer<SharedStrings> L

@* "Turn on the Vault?" (library setup and add-folder v2, D17 to D21): its own optional step after Libraries, offered once, after the libraries,
   to the first administrator only. Not now leaves no trace: the caller carries straight on and nothing here is ever drawn. Set up the Vault asks for a PIN
   typed twice (strongly suggested, never required: Vault sections D44), turns the Vault on for this administrator only, opens it for the rest of setup
   with the usual two-screen Add library so a first private library can be added now, and leaves it out of the main menu. It is one profile PIN, the same
   one that protects the profile (Videos D52). The caller locks the Vault again when setup finishes. *@
<div class="setup-stage-content" data-setup-vault>
    @switch (_phase)
    {
        case Phase.Offer:
            <div class="setup-stage__heading"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Lock" /><div><h2 id="setup-stage-title">@L["SetupVaultOffer_TurnOnTheVault"]</h2><p>@L["SetupVaultOffer_TheVaultIsAPrivate"]</p></div></div>
            <SetupStageFooter>
                <AppButton Label="@L["Common_NotNow"].Value" ButtonStyle="AppButtonStyle.Text" Disabled="@_busy" OnClick="@(() => Finished.InvokeAsync(false))" />
                <AppButton Label="@L["SetupVaultOffer_SetUpTheVault"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@_busy" OnClick="StartSetup" />
            </SetupStageFooter>
            break;

        case Phase.Pin when _hasPin:
            <div class="setup-stage__heading"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Lock" /><div><h2 id="setup-stage-title">@L["SetupVaultOffer_EnterYourPIN"]</h2><p>@L["SetupVaultOffer_YourProfilePINAlsoProtects"]</p></div></div>
            <div class="setup-form-grid">
                <AppTextField Label="@L["SetupVaultOffer_YourPIN"].Value" InputType="AppInputType.Password" Value="@_pin" ValueChanged="PinChanged" InputMode="@AppInputMode.numeric" MaxLength="12" ReadOnly="@_busy" />
            </div>
            @if (_error is not null) { <AppAlert Tone="AppUiTone.Warning" Dense="true">@_error</AppAlert> }
            <SetupStageFooter>
                <AppButton Label="@L["Common_NotNow"].Value" ButtonStyle="AppButtonStyle.Text" Disabled="@_busy" OnClick="@(() => Finished.InvokeAsync(false))" />
                <AppButton Label="@L["SetupVaultOffer_TurnOnTheVault2"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_busy" Disabled="@(_busy || !PinTypedValid)" OnClick="@(() => TurnOnAsync(_pin))" />
            </SetupStageFooter>
            break;

        case Phase.Pin:
            <div class="setup-stage__heading"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Lock" /><div><h2 id="setup-stage-title">@L["SetupVaultOffer_ProtectItWithAPIN"]</h2><p>@L["SetupVaultOffer_APINIsStronglySuggested"]</p></div></div>
            <div class="setup-form-grid">
                <AppTextField Label="@L["Common_PIN"].Value" InputType="AppInputType.Password" Value="@_pin" ValueChanged="PinChanged" InputMode="@AppInputMode.numeric" MaxLength="12" ReadOnly="@_busy"
                              Error="@(_pin.Length > 0 && !PinTypedValid)" ErrorText="Use 4 to 12 digits." HelpText="4 to 12 digits." />
                <AppTextField Label="@L["SetupVaultOffer_TypeItAgain"].Value" InputType="AppInputType.Password" Value="@_pinAgain" ValueChanged="PinAgainChanged" InputMode="@AppInputMode.numeric" MaxLength="12" ReadOnly="@_busy"
                              Error="@Mismatch" ErrorText="The two PINs don't match." />
            </div>
            @if (_error is not null) { <AppAlert Tone="AppUiTone.Warning" Dense="true">@_error</AppAlert> }
            <SetupStageFooter>
                <AppButton Label="@L["SetupVaultOffer_SkipPIN"].Value" ButtonStyle="AppButtonStyle.Text" Disabled="@_busy" OnClick="AskToSkip" />
                <AppButton Label="@L["SetupVaultOffer_TurnOnTheVault2"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_busy" Disabled="@(_busy || !PinPairValid)" OnClick="@(() => TurnOnAsync(_pin))" />
            </SetupStageFooter>
            break;

        case Phase.ConfirmSkip:
            <div class="setup-stage__heading"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.WarningAmber" /><div><h2 id="setup-stage-title">@L["SetupVaultOffer_SkipThePIN"]</h2><p data-pin-skip-warning>@L["SetupVaultOffer_WithoutAPINAnyoneUsing"]</p></div></div>
            @if (_error is not null) { <AppAlert Tone="AppUiTone.Warning" Dense="true">@_error</AppAlert> }
            <SetupStageFooter>
                <AppButton Label="@L["SetupVaultOffer_AddAPIN"].Value" ButtonStyle="AppButtonStyle.Text" Disabled="@_busy" OnClick="BackToPin" />
                <AppButton Label="@L["SetupVaultOffer_SkipAnyway"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_busy" Disabled="@_busy" OnClick="@(() => TurnOnAsync(null))" />
            </SetupStageFooter>
            break;

        default:
            <div class="setup-stage__heading"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Lock" /><div><h2 id="setup-stage-title">@L["SetupVaultOffer_YourVaultIsOn"]</h2><p>@L["SetupVaultOffer_AddAFirstPrivateLibrary"]</p></div></div>
            @if (_configuration is not null)
            {
                <LibrariesOverview Simple="true"
                                   ShowVault="true"
                                   OnlyArea="vault"
                                   SetupSession="@SetupSession"
                                   Configuration="@_configuration"
                                   Kinds="@_kinds"
                                   ReadOnly="@DeviceContext.IsMobile"
                                   FolderAdded="LoadAsync" />
            }
            else if (_loadError is not null)
            {
                <AppAlert Tone="AppUiTone.Error"><span>@_loadError</span></AppAlert>
            }
            <SetupStageFooter>
                <AppButton Label="@L["Common_Continue"].Value" EndIcon="@AppMaterialIcons.Outlined.ArrowForward" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="@(() => Finished.InvokeAsync(true))" />
            </SetupStageFooter>
            break;
    }
</div>

@code {
    private enum Phase { Offer, Pin, ConfirmSkip, On }

    /// <summary>The administrator running setup.</summary>
    [Parameter, EditorRequired] public Guid ProfileId { get; set; }

    /// <summary>True when that administrator already has a profile PIN (they gave one in the Administrator step).</summary>
    [Parameter] public bool AdministratorHasPin { get; set; }

    [Parameter] public string? SetupSession { get; set; }

    /// <summary>Raised when the person is done with this part: Not now, or Continue once the Vault is on.</summary>
    /// <summary>Raised when the step is over; true when the Vault was turned on, false after Not now.</summary>
    [Parameter] public EventCallback<bool> Finished { get; set; }

    private Phase _phase = Phase.Offer;
    private bool _hasPin;
    private bool _busy;
    private string _pin = string.Empty;
    private string _pinAgain = string.Empty;
    private string? _error;
    private string? _loadError;
    private LibrariesConfigurationDto? _configuration;
    private LibraryKindCatalog _kinds = LibraryKindCatalog.Empty;

    protected override void OnInitialized() => _hasPin = AdministratorHasPin;

    private static bool IsValidPin(string value) => value.Length is >= 4 and <= 12 && value.All(char.IsAsciiDigit);
    private bool PinTypedValid => IsValidPin(_pin);
    private bool PinPairValid => PinTypedValid && string.Equals(_pin, _pinAgain, StringComparison.Ordinal);
    private bool Mismatch => _pinAgain.Length > 0 && !string.Equals(_pin, _pinAgain, StringComparison.Ordinal);

    private void StartSetup()
    {
        _error = null;
        _phase = Phase.Pin;
    }

    private void PinChanged(string? value) => _pin = value ?? string.Empty;
    private void PinAgainChanged(string? value) => _pinAgain = value ?? string.Empty;
    private void AskToSkip() { _error = null; _phase = Phase.ConfirmSkip; }
    private void BackToPin() { _error = null; _phase = Phase.Pin; }

    // Saves the PIN when one was typed, opens the Vault for this administrator only, unlocks it for the rest of setup and shows the Vault's own libraries.
    private async Task TurnOnAsync(string? pin)
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            if (!_hasPin && pin is not null)
            {
                var set = await Confirmed.RunAsync(() => Identity.SetProfilePinResultAsync(ProfileId, pin));
                if (!set.Succeeded)
                {
                    _error = L["SetupVaultOffer_YourPINCouldnTBe"].Value;
                    _phase = Phase.Pin;
                    return;
                }

                _hasPin = true;
            }

            var access = await ApiClient.SetProfileNsfwAccessAsync(ProfileId, new SetNsfwAccessRequest { Mode = _hasPin ? "pin" : "allowed", AdminPin = _hasPin ? pin : null });
            if (!access.Succeeded)
            {
                _error = VaultMessages.For(access) ?? VaultMessages.Unreachable;
                _phase = Phase.Pin;
                return;
            }

            await Nsfw.RefreshAsync(ProfileId, isKids: false);
            var unlocked = await Nsfw.UnlockAsync(_hasPin ? pin : null);
            if (!unlocked.Succeeded)
            {
                _error = VaultMessages.For(unlocked) ?? VaultMessages.Unreachable;
                _phase = Phase.Pin;
                return;
            }

            _pin = string.Empty;
            _pinAgain = string.Empty;
            _phase = Phase.On;
            await LoadAsync();
        }
        finally
        {
            if (_phase != Phase.On) { _pin = string.Empty; _pinAgain = string.Empty; }
            _busy = false;
        }
    }

    // The setup list never holds the Vault's libraries, so the signed-in administrator's own Vault list is added to it for this view.
    private async Task LoadAsync()
    {
        var fresh = await ApiClient.GetSetupLibrariesAsync(SetupSession);
        var kinds = await ApiClient.GetSetupLibraryKindsAsync(SetupSession);
        if (fresh is null || kinds is null)
        {
            _configuration = null;
            _loadError = ApiClient.LastError ?? "Your libraries could not be loaded.";
            return;
        }

        if (await ApiClient.GetVaultSiblingLibrariesAsync() is { } vault)
        {
            foreach (var library in vault)
            {
                if (fresh.Libraries.All(existing => !string.Equals(existing.Id, library.Id, StringComparison.OrdinalIgnoreCase))) fresh.Libraries.Add(library);
            }
        }

        _kinds = new LibraryKindCatalog(kinds);
        _configuration = fresh;
        _loadError = null;
    }
}
