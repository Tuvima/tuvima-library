@namespace MediaEngine.Web.Components.Setup
@using MediaEngine.Contracts.Settings
@using MediaEngine.Contracts.Setup
@using MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Models.ViewDTOs
@inject IEngineApiClient ApiClient
@inject DeviceContextService DeviceContext

@* "What do you have?": the same Libraries table Settings shows (LibrariesOverview), with Simple on (Library pages D13). Add library opens the
   one Create library dialog, which saves through setup's own session; View's rows take folders through the View folder dialog (add-folder v2 D14, D15).
   The footer, the step key and the deferral belong to this step. The optional private step that may follow is the page's to offer. *@
<div class="setup-stage-content">
    <div class="setup-stage__heading"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FolderOpen" /><div><h2 id="setup-stage-title">What do you have?</h2><p>Add a library for what you'd like Library to show. You can add more later in Settings.</p></div></div>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <AppAlert Tone="AppUiTone.Error"><span>@_loadError</span></AppAlert>
        <div><AppButton Label="Try again" ButtonStyle="AppButtonStyle.Outlined" OnClick="RetryAsync" /></div>
    }
    else if (_configuration is not null)
    {
        <LibrariesOverview Simple="true"
                           SetupSession="@SetupSession"
                           Configuration="@_configuration"
                           Kinds="@_kinds"
                           ViewFolders="@_viewFolders"
                           ReadOnly="@DeviceContext.IsMobile"
                           FolderAdded="LibraryAddedAsync" />
    }

    @if (HasLibraries && Media is not null)
    {
        <AppAlert Tone="@(Media.Passed ? AppUiTone.Success : AppUiTone.Warning)" Class="setup-media-notice"><span>@Media.Detail</span></AppAlert>
    }
    <SetupStageFooter Back="Back" ShowReturnToCurrentStep="ShowReturnToCurrentStep" ReturnToCurrentStep="ReturnToCurrentStep">
        @if (!HasLibraries)
        {
            <AppButton Label="Skip for now" ButtonStyle="AppButtonStyle.Text" Disabled="@Busy" OnClick="DeferMedia" />
        }
        else
        {
            <AppButton Label="Continue" EndIcon="@AppMaterialIcons.Outlined.ArrowForward" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@Busy" OnClick="ContinueAsync" />
        }
    </SetupStageFooter>
</div>

@code {
    [Parameter] public bool HasLibraries { get; set; }
    [Parameter] public EventCallback DeferMedia { get; set; }
    [Parameter] public SetupMediaLocationsDto? Media { get; set; }
    [Parameter] public string? SetupSession { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback LibraryCreated { get; set; }
    [Parameter] public EventCallback ValidateMedia { get; set; }
    [Parameter] public EventCallback Back { get; set; }
    [Parameter] public bool ShowReturnToCurrentStep { get; set; }
    [Parameter] public EventCallback ReturnToCurrentStep { get; set; }

    private LibrariesConfigurationDto? _configuration;
    private string? _loadError;
    private IReadOnlyDictionary<string, int>? _viewFolders;

    // The list of library kinds the setup session can read; the areas and the Create library dialog are drawn from it.
    private LibraryKindCatalog _kinds = LibraryKindCatalog.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    // Setup saves replace the whole list, so the table and the dialog never start from a copy that could not be refreshed.
    private async Task LoadAsync()
    {
        var fresh = await ApiClient.GetSetupLibrariesAsync(SetupSession);
        if (fresh is null)
        {
            _configuration = null;
            _loadError = ApiClient.LastError ?? "Your folders could not be loaded.";
            return;
        }

        var kinds = await ApiClient.GetSetupLibraryKindsAsync(SetupSession);
        if (kinds is null)
        {
            _configuration = null;
            _loadError = ApiClient.LastError ?? "The kinds of library could not be loaded.";
            return;
        }

        _kinds = new LibraryKindCatalog(kinds);
        _configuration = fresh;
        _loadError = null;
        _viewFolders = await CountViewFoldersAsync();
    }

    // View's folders in setup are all shared ones; the counts are unknown (null) when they could not be read, never a guessed zero.
    private async Task<IReadOnlyDictionary<string, int>?> CountViewFoldersAsync()
    {
        var sources = await ApiClient.GetViewSharedSourcesAsync();
        if (sources is null) return null;
        return _kinds.ViewKinds.ToDictionary(
            kind => kind.Key,
            kind => sources
                .Where(source => !string.IsNullOrWhiteSpace(source.Location) && LibraryRollup.ViewFolderBelongsTo(source, kind.Key))
                .Select(source => source.Location)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count());
    }

    private Task ContinueAsync() => ValidateMedia.InvokeAsync();

    private async Task LibraryAddedAsync()
    {
        await LoadAsync();
        await LibraryCreated.InvokeAsync();
    }

    private async Task RetryAsync()
    {
        await LoadAsync();
        await LibraryCreated.InvokeAsync();
    }
}
