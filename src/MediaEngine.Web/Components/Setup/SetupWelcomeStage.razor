@namespace MediaEngine.Web.Components.Setup
@using MediaEngine.Contracts.Setup
@using MediaEngine.Web.Components.Settings
@inject IStringLocalizer<SharedStrings> L

<div class="setup-stage-content">
    <div class="setup-stage__heading">
        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Dns" />
        <div><h2 id="setup-stage-title">@L["SetupWelcomeStage_WelcomeToYourLibrary"]</h2><p>@L["SetupWelcomeStage_ChooseYourLanguageThenGive"]</p></div>
    </div>

    <SetupLocaleStage Value="@Locale" ValueChanged="LocaleChanged" ShowDisplay="true" ShowMetadata="false" />

    <div class="setup-server-form">
        <AppTextField Label="@L["Common_ServerName"].Value" Value="@ServerName" ValueChanged="OnNameChanged" Placeholder="@L["SetupWelcomeStage_ShayaSLibrary"].Value" />
        <AppTextField Label="@L["SetupWelcomeStage_NetworkName"].Value" Value="@HostName" ValueChanged="OnHostChanged" Placeholder="tuvima" />
        <p class="setup-server-form__preview">@L["SetupWelcomeStage_OtherDevicesOnYourHome"] <strong>http://@(string.IsNullOrWhiteSpace(HostName) ? "tuvima" : HostName).local</strong>@L["SetupWelcomeStage_IfADeviceCannotFind"]</p>
    </div>

    <SetupStageFooter ShowReturnToCurrentStep="@ShowReturnToCurrentStep" ReturnToCurrentStep="ReturnToCurrentStep">
        <AppButton Label="@L["Common_Continue"].Value" EndIcon="@AppMaterialIcons.Outlined.ArrowForward" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary"
                   Loading="@Busy" Disabled="@(string.IsNullOrWhiteSpace(ServerName))" OnClick="Save" />
    </SetupStageFooter>

    @if (ShowRestore)
    {
        <div class="setup-restore">
            <h3>@L["SetupWelcomeStage_RestoreABackupFile"]</h3>
            <p>@L["SetupWelcomeStage_ChooseALibraryBackupZIP"]</p>
            <InputFile OnChange="UploadBackup" accept=".zip,application/zip" class="setup-file-input" />
            @if (!string.IsNullOrWhiteSpace(BackupError))
            {
                <AppAlert Tone="AppUiTone.Error" data-testid="setup-restore-error">@BackupError</AppAlert>
            }
            @if (Backup is not null)
            {
                <dl class="setup-facts"><div><dt>@L["Common_File"]</dt><dd>@Backup.FileName</dd></div><div><dt>@L["ApiKeys_Created"]</dt><dd>@(Backup.CreatedAt?.ToString("g") ?? "Unknown")</dd></div><div><dt>@L["SetupWelcomeStage_Entries"]</dt><dd>@Backup.EntryCount</dd></div></dl>
                <AppAlert Tone="AppUiTone.Warning" data-testid="setup-restore-first-look">
                    @if (Backup.Contents is { } contents)
                    {
                        <BackupContentsSummary Contents="contents" />
                        <div>@L["SetupWelcomeStage_TheApplicationWillRestartAfter"]</div>
                    }
                    else
                    {
                        <div>@Backup.Warning</div><div>@L["SetupWelcomeStage_TheApplicationWillRestartAfter"]</div>
                    }
                </AppAlert>
                <div class="setup-actions"><AppButton Label="@L["SetupWelcomeStage_CancelRestore"].Value" OnClick="CancelRestore" /><AppButton Label="@L["SetupWelcomeStage_RestoreAndRestart"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Warning" Loading="@Busy" OnClick="ConfirmRestore" /></div>
            }
            else
            {
                <div class="setup-actions"><AppButton Label="@L["SetupWelcomeStage_CancelRestore"].Value" OnClick="CancelRestore" /></div>
            }
        </div>
    }
    else
    {
        <div class="setup-actions setup-actions--secondary"><AppButton Label="@L["SetupWelcomeStage_RestoreABackupInstead"].Value" StartIcon="@AppMaterialIcons.Outlined.Restore" ButtonStyle="AppButtonStyle.Text" OnClick="OpenRestore" /></div>
    }
</div>

@code {
    /// <summary>Display language and region, saved together with the server name when Continue is pressed.</summary>
    [Parameter] public SetupLocaleDto? Locale { get; set; }
    [Parameter] public EventCallback<SetupLocaleDto> LocaleChanged { get; set; }
    [Parameter] public string ServerName { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ServerNameChanged { get; set; }
    [Parameter] public string HostName { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> HostNameChanged { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback Save { get; set; }
    [Parameter] public bool ShowReturnToCurrentStep { get; set; }
    [Parameter] public EventCallback ReturnToCurrentStep { get; set; }
    [Parameter] public SetupBackupInspectionDto? Backup { get; set; }
    /// <summary>The Engine's one sentence when it refused the chosen file (an older layout, a damaged file); shown as it is.</summary>
    [Parameter] public string? BackupError { get; set; }
    [Parameter] public bool ShowRestore { get; set; }
    [Parameter] public EventCallback OpenRestore { get; set; }
    [Parameter] public EventCallback CancelRestore { get; set; }
    [Parameter] public EventCallback<InputFileChangeEventArgs> UploadBackup { get; set; }
    [Parameter] public EventCallback ConfirmRestore { get; set; }

    // The network name follows the friendly name until the person edits it themselves.
    private bool _hostEdited;

    private async Task OnNameChanged(string? value)
    {
        var name = value ?? string.Empty;
        await ServerNameChanged.InvokeAsync(name);
        if (!_hostEdited) await HostNameChanged.InvokeAsync(ToLabel(name));
    }

    private Task OnHostChanged(string? value)
    {
        _hostEdited = true;
        return HostNameChanged.InvokeAsync(ToLabel(value ?? string.Empty));
    }

    private static string ToLabel(string value)
    {
        var builder = new System.Text.StringBuilder();
        foreach (var character in value.Trim().ToLowerInvariant())
        {
            if (character is >= 'a' and <= 'z' or >= '0' and <= '9') builder.Append(character);
            else if (builder.Length > 0 && builder[^1] != '-') builder.Append('-');
        }
        var label = builder.ToString().TrimEnd('-');
        return label.Length > 63 ? label[..63].TrimEnd('-') : label;
    }
}
