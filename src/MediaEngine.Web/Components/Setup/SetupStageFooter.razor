@namespace MediaEngine.Web.Components.Setup
@inject IStringLocalizer<SharedStrings> L

<footer class="setup-stage__footer">
    @* The first step has nothing before it, so it passes no Back and shows none. *@
    @if (Back.HasDelegate)
    {
        <AppButton Label="@L["Common_Back"].Value"
                   StartIcon="@AppMaterialIcons.Outlined.ArrowBack"
                   OnClick="Back" />
    }
    @Leading
    <div class="setup-stage__footer-actions">
        @ChildContent
        @if (ShowReturnToCurrentStep)
        {
            <AppButton Label="@L["SetupStageFooter_ReturnToCurrentStep"].Value"
                       EndIcon="@AppMaterialIcons.Outlined.ArrowForward"
                       ButtonStyle="AppButtonStyle.Filled"
                       Tone="AppUiTone.Primary"
                       OnClick="ReturnToCurrentStep" />
        }
    </div>
</footer>

@code {
    [Parameter] public EventCallback Back { get; set; }
    [Parameter] public bool ShowReturnToCurrentStep { get; set; }
    [Parameter] public EventCallback ReturnToCurrentStep { get; set; }
    /// <summary>An optional Secondary action drawn on the left, where Back sits (Welcome uses it for "Restore a backup").</summary>
    [Parameter] public RenderFragment? Leading { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
