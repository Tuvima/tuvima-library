@using System.Globalization
@using MediaEngine.Contracts.Setup
@using MediaEngine.Web.Components.Settings
@inject IStringLocalizer<SharedStrings> L

@if (Value is not null)
{
    <section class="setup-locale-form" aria-label="@L["Settings_LanguageAndRegion"].Value">
        @if (ShowDisplay)
        {
            <DisplayLanguagePicker Value="@Value.DisplayLanguage" ValueChanged="@(tag => Change(display: tag))" />
            <label>@L["ServerGeneral_CountryLabel"]
                <AppNativeSelect Value="@Value.Country" OnChange="@(args => Change(country: args.Value?.ToString()))">
                    @foreach (var region in Regions) { <option value="@region.TwoLetterISORegionName">@region.EnglishName</option> }
                </AppNativeSelect>
            </label>
        }
        @if (ShowMetadata)
        {
            <label>@L["SetupLocaleStage_MetadataLanguage"]
                <AppNativeSelect Value="@Value.MetadataLanguage" OnChange="@(args => Change(metadata: args.Value?.ToString()))">
                    @foreach (var culture in Languages) { <option value="@culture.Name">@culture.NativeName</option> }
                </AppNativeSelect>
            </label>
        }
    </section>
}
@code {
    [Parameter] public SetupLocaleDto? Value { get; set; }
    [Parameter] public EventCallback<SetupLocaleDto> ValueChanged { get; set; }

    /// <summary>Welcome asks for the display language and region; the Metadata step asks for the metadata language alone.</summary>
    [Parameter] public bool ShowDisplay { get; set; } = true;
    [Parameter] public bool ShowMetadata { get; set; } = true;
    private static readonly CultureInfo[] Languages = CultureInfo.GetCultures(CultureTypes.NeutralCultures | CultureTypes.SpecificCultures)
        .Where(c => c.Name.Length > 0).OrderBy(c => c.NativeName).ToArray();
    private static readonly RegionInfo[] Regions = CultureInfo.GetCultures(CultureTypes.SpecificCultures)
        .Select(c => new RegionInfo(c.Name)).DistinctBy(r => r.TwoLetterISORegionName).OrderBy(r => r.EnglishName).ToArray();
    private Task Change(string? display = null, string? metadata = null, string? country = null) =>
        ValueChanged.InvokeAsync(new SetupLocaleDto(display ?? Value!.DisplayLanguage, metadata ?? Value!.MetadataLanguage, country ?? Value!.Country));
}
