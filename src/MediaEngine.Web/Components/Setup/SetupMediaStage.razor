@namespace MediaEngine.Web.Components.Setup
@using MediaEngine.Contracts.Setup

<div class="setup-stage-content">
    <div class="setup-stage__heading"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FolderOpen" /><div><h2 id="setup-stage-title">Media locations</h2><p>Add the folders Tuvima Library should index. Existing libraries can remain completely read-only.</p></div></div>
    @if (ShowLibraryWizard)
    {
        <AddLibraryWizard Embedded="true" SetupSession="@SetupSession" LibraryCreated="LibraryCreated" Cancelled="CancelLibraryWizard" />
    }
    else
    {
        <AppAlert Tone="@(Media is null ? AppUiTone.Info : Media.Passed ? AppUiTone.Success : AppUiTone.Warning)" Class="setup-media-notice">
            <strong>You can add your media folders later in Settings · Libraries.</strong>
            <span>@(Media?.Detail ?? "Existing libraries will remain completely read-only.")</span>
        </AppAlert>
        <div class="setup-choice-grid">
            <AppChoiceCard Class="setup-choice-card" Icon="@AppMaterialIcons.Outlined.CreateNewFolder" Title="Add a library" Description="Choose media folders to index now." OnClick="OpenLibraryWizard" />
            <AppChoiceCard Class="setup-choice-card" Icon="@AppMaterialIcons.Outlined.Schedule" Title="Do this later" Description="You can always add libraries in Settings." Disabled="@Busy" OnClick="DeferMedia" />
        </div>
        <SetupStageFooter Back="Back" ShowReturnToCurrentStep="ShowReturnToCurrentStep" ReturnToCurrentStep="ReturnToCurrentStep">
            @if (HasLibraries)
            {
                <AppButton Label="Continue" EndIcon="@AppMaterialIcons.Outlined.ArrowForward" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@Busy" OnClick="ValidateMedia" />
            }
        </SetupStageFooter>
    }
</div>

@code {
    [Parameter] public bool HasLibraries { get; set; }
    [Parameter] public EventCallback DeferMedia { get; set; }
    [Parameter] public SetupMediaLocationsDto? Media { get; set; }
    [Parameter] public string? SetupSession { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool ShowLibraryWizard { get; set; }
    [Parameter] public EventCallback OpenLibraryWizard { get; set; }
    [Parameter] public EventCallback CancelLibraryWizard { get; set; }
    [Parameter] public EventCallback LibraryCreated { get; set; }
    [Parameter] public EventCallback ValidateMedia { get; set; }
    [Parameter] public EventCallback Back { get; set; }
    [Parameter] public bool ShowReturnToCurrentStep { get; set; }
    [Parameter] public EventCallback ReturnToCurrentStep { get; set; }
}
