@namespace MediaEngine.Web.Components.Setup
@using MediaEngine.Contracts.Setup

<div class="setup-stage-content">
    @if (!Busy && NeedsAttention)
    {
        <div class="setup-stage__heading">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FactCheck" />
            <div><h2 id="setup-stage-title">Tuvima needs a hand</h2><p>Something on this server stopped setup from getting ready.</p></div>
        </div>
        <AppAlert Tone="AppUiTone.Error">
            @if (Problems.Count == 0)
            {
                <p>@Error</p>
            }
            else
            {
                @foreach (var problem in Problems)
                {
                    <p>@problem</p>
                }
            }
            <p>Fix this on the server, then try again.</p>
        </AppAlert>
        <div class="setup-actions"><AppButton Label="Retry" StartIcon="@AppMaterialIcons.Outlined.Refresh" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@Busy" OnClick="Retry" /></div>
    }
    else
    {
        <div class="setup-stage__heading">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FactCheck" />
            <div><h2 id="setup-stage-title">Getting things ready</h2><p>This usually takes only a moment.</p></div>
        </div>
        <div class="setup-preparing" role="status" aria-live="polite">
            <AppSpinner Indeterminate="true" Color="AppColor.Primary" />
            <span>Getting things ready…</span>
        </div>
    }
</div>

@code {
    [Parameter] public SetupPreflightDto? Preflight { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback Retry { get; set; }

    private bool NeedsAttention => !string.IsNullOrWhiteSpace(Error) || Preflight is { Passed: false };

    // The failing checks' own explanations, in everyday words; the internal check names are never shown.
    private IReadOnlyList<string> Problems => Preflight is { Passed: false }
        ? Preflight.Checks
            .Where(check => check.Status != "passed" && !string.IsNullOrWhiteSpace(check.Detail))
            .Select(check => check.Detail.Trim())
            .Distinct(StringComparer.Ordinal)
            .ToList()
        : [];
}
