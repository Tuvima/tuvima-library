@namespace MediaEngine.Web.Components.Setup
@using MediaEngine.Contracts.Setup

<div class="setup-stage-content">
    @if (!Busy && NeedsAttention)
    {
        <div class="setup-stage__heading">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FactCheck" />
            <div><h2 id="setup-stage-title">The Library needs a hand</h2><p>Something on this server stopped setup from getting ready.</p></div>
        </div>
        @* One plain message however many checks failed; the technical detail is only in the Engine log. *@
        <AppAlert Tone="AppUiTone.Error">
            <p>@CouldNotCheckMessage</p>
        </AppAlert>
        <div class="setup-actions"><AppButton Label="Retry" StartIcon="@AppMaterialIcons.Outlined.Refresh" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@Busy" OnClick="Retry" /></div>
    }
    else if (!Busy && ToolsNeedAttention)
    {
        <div class="setup-stage__heading">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FactCheck" />
            @if (ToolsDownloading)
            {
                <div><h2 id="setup-stage-title">Getting your media tools</h2><p>Library is downloading what it needs. This can take a minute. You can wait here or continue setting up.</p></div>
            }
            else
            {
                <div><h2 id="setup-stage-title">A few things to install</h2><p>Library could not set these up by itself. Check your internet connection and press Check again, or install them with the steps shown. You can finish setting up now; anything listed waits until it is installed.</p></div>
            }
        </div>
        @* Read-only: each row says what it affects, how far its download is and how to fix it. Pointing the Library at a tool is done later in Settings. *@
        <div class="setup-tools">
            @foreach (var tool in ToolsToInstall)
            {
                <ToolRequirementRow Tool="@tool" />
            }
        </div>
        <div class="setup-actions">
            <AppButton Label="Check again" StartIcon="@AppMaterialIcons.Outlined.Refresh" ButtonStyle="AppButtonStyle.Outlined" OnClick="Retry" />
            <AppButton Label="Continue" EndIcon="@AppMaterialIcons.Outlined.ArrowForward" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="Continue" />
        </div>
    }
    else if (!Busy && Preflight is { Passed: true })
    {
        <div class="setup-stage__heading">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FactCheck" />
            <div><h2 id="setup-stage-title">Your tools are ready</h2><p>Everything Library needs on this server was checked and is in place.</p></div>
        </div>
        <div class="setup-actions">
            <AppButton Label="Continue" EndIcon="@AppMaterialIcons.Outlined.ArrowForward" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="Continue" />
        </div>
    }
    else
    {
        <div class="setup-stage__heading">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FactCheck" />
            <div><h2 id="setup-stage-title">Getting things ready</h2><p>This usually takes only a moment.</p></div>
        </div>
        <div class="setup-preparing" role="status" aria-live="polite">
            <AppSpinner Indeterminate="true" Color="AppColor.Primary" />
            <span>Getting things ready…</span>
        </div>
    }
</div>

@code {
    [Parameter] public SetupPreflightDto? Preflight { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback Retry { get; set; }

    /// <summary>Moves on although a Required tool is missing; setup warns about tools and never blocks (D5).</summary>
    [Parameter] public EventCallback Continue { get; set; }

    private bool NeedsAttention => !string.IsNullOrWhiteSpace(Error) || Preflight is { Passed: false };

    private bool ToolsNeedAttention => Preflight is { Passed: true, Tools.NeedsAttention: true };

    private bool ToolsDownloading => SetupToolRules.IsDownloadingRequiredTool(Preflight?.Tools);

    private IEnumerable<ToolRequirementDto> ToolsToInstall => Preflight?.Tools.Tools
        .Where(tool => tool.Requirement == ToolRequirementLevels.Required && tool.State != ToolRequirementStates.Ready) ?? [];

    private const string CouldNotCheckMessage =
        "We could not check this server. Check that the data folder is writable and has free space, then try again.";
}
