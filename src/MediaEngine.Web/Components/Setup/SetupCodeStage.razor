@namespace MediaEngine.Web.Components.Setup
@inject IStringLocalizer<SharedStrings> L

<div class="setup-stage-content">
    @if (Remote)
    {
        <div class="setup-stage__heading"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Lock" /><div><h2 id="setup-stage-title">@L["SetupCodeStage_FinishSetupAtHome"]</h2><p>@L["SetupCodeStage_SetupHasToBeFinished"]</p></div></div>
        <AppAlert Tone="AppUiTone.Info">@L["SetupCodeStage_OpenThisPageFromA"]</AppAlert>
    }
    else
    {
        <div class="setup-stage__heading"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Key" /><div><h2 id="setup-stage-title">@L["SetupCodeStage_EnterTheSetupCodeFrom"]</h2><p>@L["SetupCodeStage_ThisProvesYouCanReach"]</p></div></div>
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <AppAlert Tone="AppUiTone.Warning">@Message</AppAlert>
        }
        <div class="setup-form-grid">
            <AppTextField Label="@L["SetupCodeStage_SetupCode"].Value" Value="@Code" ValueChanged="CodeChanged" MaxLength="9" HelpText="Eight characters, like ABCD-EFGH. It works once and expires after 30 minutes." />
        </div>
        <div class="setup-code-help">
            <p><strong>@L["SetupCodeStage_RunningInDockerUnraidSynology"]</strong> @L["SetupCodeStage_OpenATerminalOnThe"]</p>
            <pre><code>docker exec -it &lt;container&gt; tuvima-admin setup code</code></pre>
            <p><strong>@L["SetupCodeStage_OnWindows"]</strong> @L["SetupCodeStage_OpenTheInstallFolderIn"]</p>
            <pre><code>tuvima-admin setup code</code></pre>
        </div>
        <footer class="setup-stage__footer">
            <div class="setup-stage__footer-actions">
                <AppButton Label="@L["Common_Continue"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@Busy" Disabled="@(Busy || string.IsNullOrWhiteSpace(Code))" OnClick="Submit" />
            </div>
        </footer>
    }
</div>

@code {
    [Parameter] public bool Remote { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public string Code { get; set; } = string.Empty;
    [Parameter] public EventCallback<string?> CodeChanged { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback Submit { get; set; }
}
