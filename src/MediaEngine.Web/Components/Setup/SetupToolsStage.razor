@namespace MediaEngine.Web.Components.Setup
@using MediaEngine.Contracts.Setup
@using MediaEngine.Web.Components.Shared.Tools

@* "Here is what Library needs": every tool is listed with the same row Settings > Tools and requirements draws, ready or not. A missing optional tool
   has a "Download now" tick, on by default, that starts its download when Continue is pressed. Nothing here blocks: Continue is always offered once the
   server check has passed, and downloads carry on in the background through the rest of setup. Local AI is not part of setup (it is set up in Settings). *@
<div class="setup-stage-content">
    @if (!Busy && NeedsAttention)
    {
        <div class="setup-stage__heading">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FactCheck" />
            <div><h2 id="setup-stage-title">The Library needs a hand</h2><p>Something on this server stopped setup from getting ready.</p></div>
        </div>
        @* One plain message however many checks failed; the technical detail is only in the Engine log. *@
        <AppAlert Tone="AppUiTone.Error">
            <p>@CouldNotCheckMessage</p>
        </AppAlert>
        <div class="setup-actions"><AppButton Label="Retry" StartIcon="@AppMaterialIcons.Outlined.Refresh" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@Busy" OnClick="Retry" /></div>
    }
    else if (!Busy && Preflight is { Passed: true })
    {
        <div class="setup-stage__heading">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FactCheck" />
            <div><h2 id="setup-stage-title">Tools</h2><p>Library uses a few outside programs to read and prepare your media. Optional ones can be downloaded now or later.</p></div>
        </div>
        <div class="setup-tools" data-testid="setup-tools">
            @foreach (var tool in Listed)
            {
                <ToolRequirementRow Tool="@tool" Busy="@Busy">
                    <Actions>
                        @if (SetupToolRules.Action(tool) == SetupToolAction.Download)
                        {
                            <AppCheckbox Label="Download now" Value="@(!Skipped.Contains(tool.Id))" ValueChanged="@(value => DownloadChanged.InvokeAsync((tool.Id, value)))" />
                        }
                        else if (SetupToolRules.Action(tool) == SetupToolAction.RunInstaller)
                        {
                            <AppButton Label="Run installer" Size="AppControlSize.Compact" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" OnClick="@(() => RunInstaller.InvokeAsync(tool))" />
                        }
                    </Actions>
                </ToolRequirementRow>
            }
        </div>
        <small>The local AI engine is set up in Settings, Local AI, after setup.</small>
        <SetupStageFooter Back="Back" ShowReturnToCurrentStep="ShowReturnToCurrentStep" ReturnToCurrentStep="ReturnToCurrentStep">
            <AppButton Label="Check again" StartIcon="@AppMaterialIcons.Outlined.Refresh" ButtonStyle="AppButtonStyle.Outlined" OnClick="Retry" />
            <AppButton Label="Continue" EndIcon="@AppMaterialIcons.Outlined.ArrowForward" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="Continue" />
        </SetupStageFooter>
    }
    else
    {
        <div class="setup-stage__heading">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FactCheck" />
            <div><h2 id="setup-stage-title">Checking your tools</h2><p>This usually takes only a moment.</p></div>
        </div>
        <div class="setup-preparing" role="status" aria-live="polite">
            <AppSpinner Indeterminate="true" Color="AppColor.Primary" />
            <span>Checking your tools…</span>
        </div>
    }
</div>

@code {
    [Parameter] public SetupPreflightDto? Preflight { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback Retry { get; set; }

    /// <summary>Moves on although a tool is missing; setup warns about tools and never blocks on them.</summary>
    [Parameter] public EventCallback Continue { get; set; }
    [Parameter] public EventCallback Back { get; set; }
    [Parameter] public bool ShowReturnToCurrentStep { get; set; }
    [Parameter] public EventCallback ReturnToCurrentStep { get; set; }

    /// <summary>Tool ids whose "Download now" tick the person turned off; every missing optional tool is ticked until then.</summary>
    [Parameter] public IReadOnlySet<string> Skipped { get; set; } = new HashSet<string>();
    [Parameter] public EventCallback<(string ToolId, bool Download)> DownloadChanged { get; set; }
    [Parameter] public EventCallback<MediaEngine.Contracts.Settings.ToolRequirementDto> RunInstaller { get; set; }

    private bool NeedsAttention => !string.IsNullOrWhiteSpace(Error) || Preflight is { Passed: false };

    private IReadOnlyList<MediaEngine.Contracts.Settings.ToolRequirementDto> Listed => SetupToolRules.ListedTools(Preflight?.Tools);

    private const string CouldNotCheckMessage =
        "We could not check this server. Check that the data folder is writable and has free space, then try again.";
}
