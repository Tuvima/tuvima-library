@namespace MediaEngine.Web.Components.Setup
@using MediaEngine.Contracts.Playback
@using MediaEngine.Contracts.Settings
@using MediaEngine.Contracts.Setup
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Web.Components.Shared.Tools
@inject IStringLocalizer<SharedStrings> L

@* "Here is what Library needs": every tool is listed with the same row Settings > Tools and requirements draws, ready or not. A tool that is not installed
   offers Install, which starts its download at once and carries on in the background. Nothing here blocks: Continue is always offered once the
   server check has passed, and downloads carry on in the background through the rest of setup. Local AI is not part of setup (it is set up in Settings), so it is a "Later" row. *@
<div class="setup-stage-content">
    @if (!Busy && NeedsAttention)
    {
        <div class="setup-stage__heading">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FactCheck" />
            <div><h2 id="setup-stage-title">@L["SetupToolsStage_TheLibraryNeedsAHand"]</h2><p>@L["SetupToolsStage_SomethingOnThisServerStopped"]</p></div>
        </div>
        @* One plain message however many checks failed; the technical detail is only in the Engine log. *@
        <AppAlert Tone="AppUiTone.Error">
            <p>@CouldNotCheckMessage</p>
        </AppAlert>
        <div class="setup-actions"><AppButton Label="@L["Common_Retry"].Value" StartIcon="@AppMaterialIcons.Outlined.Refresh" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@Busy" OnClick="Retry" /></div>
    }
    else if (!Busy && Preflight is { Passed: true })
    {
        <div class="setup-stage__heading">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FactCheck" />
            <div><h2 id="setup-stage-title">@L["Common_Tools"]</h2><p>@L["SetupToolsStage_LibraryUsesAFewOutside"]</p></div>
        </div>
        <div class="setup-tools" data-testid="setup-tools">
            <ToolsSummaryLine Tools="@Listed" />
            @foreach (var tool in Listed)
            {
                <ToolRequirementRow Tool="@tool" Busy="@Busy" OnInstall="InstallTool" OnRunInstaller="RunInstaller" />
                @if (tool.Id == ToolRequirementIds.Ffmpeg)
                {
                    @* The Graphics hardware row (playback-path spec D11): filled in on its own once FFmpeg is ready, the same words as
                       Settings > Playback; it never blocks Continue and asks nothing. *@
                    var hardware = GraphicsHardwareText.ForSetupRow(Graphics, L);
                    <div class="setup-tools__later" data-tool-id="graphics-hardware" data-state="@(Graphics?.Outcome ?? GraphicsHardwareOutcomes.Unavailable)">
                        <div>
                            <strong>@L["GraphicsHardware_Title"]</strong>
                            <span data-graphics-hardware-line>@hardware.Headline</span>
                        </div>
                        <AppStatusBadge Text="@hardware.Badge" Tone="@hardware.Tone" />
                    </div>
                }
            }
            @* Local AI is not part of setup; it gets a quiet "Later" row so the list is complete (first-run setup rework, Tools). *@
            <div class="setup-tools__later" data-tool-id="local-ai" data-state="later">
                <div>
                    <strong>@L["SetupToolsStage_LocalAIName"]</strong>
                    <span>@L["SetupToolsStage_LocalAIDetail"]</span>
                </div>
                <AppStatusBadge Text="@L["SetupToolsStage_LocalAILater"].Value" Tone="AppUiTone.Neutral" />
            </div>
        </div>
        <SetupStageFooter Back="Back" ShowReturnToCurrentStep="ShowReturnToCurrentStep" ReturnToCurrentStep="ReturnToCurrentStep">
            <AppButton Label="@L["Common_CheckAgain"].Value" StartIcon="@AppMaterialIcons.Outlined.Refresh" ButtonStyle="AppButtonStyle.Outlined" OnClick="Retry" />
            <AppButton Label="@L["Common_Continue"].Value" EndIcon="@AppMaterialIcons.Outlined.ArrowForward" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="Continue" />
        </SetupStageFooter>
    }
    else
    {
        <div class="setup-stage__heading">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FactCheck" />
            <div><h2 id="setup-stage-title">@L["SetupToolsStage_CheckingYourTools"]</h2><p>@L["SetupToolsStage_ThisUsuallyTakesOnlyA"]</p></div>
        </div>
        <div class="setup-preparing" role="status" aria-live="polite">
            <AppSpinner Indeterminate="true" Color="AppColor.Primary" />
            <span>@L["SetupToolsStage_CheckingYourTools2"]</span>
        </div>
    }
</div>

@code {
    [Parameter] public SetupPreflightDto? Preflight { get; set; }
    /// <summary>What the Engine found when it tested the graphics hardware, or null before FFmpeg is ready.</summary>
    [Parameter] public GraphicsHardwareDto? Graphics { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback Retry { get; set; }

    /// <summary>Moves on although a tool is missing; setup warns about tools and never blocks on them.</summary>
    [Parameter] public EventCallback Continue { get; set; }
    [Parameter] public EventCallback Back { get; set; }
    [Parameter] public bool ShowReturnToCurrentStep { get; set; }
    [Parameter] public EventCallback ReturnToCurrentStep { get; set; }

    /// <summary>Starts the download of a tool that is not installed (the row's Install); it carries on in the background.</summary>
    [Parameter] public EventCallback<MediaEngine.Contracts.Settings.ToolRequirementDto> InstallTool { get; set; }
    [Parameter] public EventCallback<MediaEngine.Contracts.Settings.ToolRequirementDto> RunInstaller { get; set; }

    private bool NeedsAttention => !string.IsNullOrWhiteSpace(Error) || Preflight is { Passed: false };

    private IReadOnlyList<MediaEngine.Contracts.Settings.ToolRequirementDto> Listed => SetupToolRules.ListedTools(Preflight?.Tools);

    private const string CouldNotCheckMessage =
        "We could not check this server. Check that the data folder is writable and has free space, then try again.";
}
