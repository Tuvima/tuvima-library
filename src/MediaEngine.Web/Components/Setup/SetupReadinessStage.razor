@namespace MediaEngine.Web.Components.Setup
@using MediaEngine.Contracts.Setup
@inject IStringLocalizer<SharedStrings> L

<div class="setup-stage-content">
    <div class="setup-stage__heading"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.TaskAlt" /><div><h2 id="setup-stage-title">@(Readiness?.CanComplete == true ? "You're all set" : "Almost there…")</h2><p>@Subtitle</p></div></div>
    @if (Readiness is null && Failed && !Busy)
    {
        @* A browser with no session cannot read the server's answer. One plain card, no spinner (first-run setup B20). *@
        <AppAlert Tone="AppUiTone.Warning" data-testid="setup-sign-in-card">
            <strong>@L["SetupReadinessStage_SignInToFinishSetup"]</strong>
            <p>@L["SetupReadinessStage_ThisBrowserIsNotSigned"]</p>
        </AppAlert>
        <SetupStageFooter Back="Back" ShowReturnToCurrentStep="ShowReturnToCurrentStep" ReturnToCurrentStep="ReturnToCurrentStep">
            <AppButton Label="@L["Common_TryAgain"].Value" StartIcon="@AppMaterialIcons.Outlined.Refresh" ButtonStyle="AppButtonStyle.Outlined" OnClick="Retry" />
            <AppButton Label="@L["SetupReadinessStage_SignIn"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Href="/auth/login?returnUrl=%2Fsetup" />
        </SetupStageFooter>
    }
    else if (Readiness is null || Busy && !Readiness.CanComplete)
    {
        <div class="setup-preparing" role="status"><AppSpinner Indeterminate="true" Color="AppColor.Primary" /><span>@L["SetupReadinessStage_CheckingYourProfileLibrariesAnd"]</span></div>
    }
    else
    {
        @if (!Readiness.CanComplete)
        {
            <AppAlert Tone="AppUiTone.Warning">@L["Common_NeedsAttention"]</AppAlert>
        }
        <div class="setup-checks" data-testid="setup-summary">
            @foreach (var capability in Readiness.Capabilities.Where(item => item.Key != "done"))
            {
                <article data-step="@capability.Key">
                    <span class="setup-checks__icon"><AppMaterialIcon Icon="@CapabilityIcon(capability.Key)" /></span>
                    <div>
                        <strong>@CapabilityLabel(capability.Key)</strong><small>@capability.Detail</small>
                        @if (capability.Status is not "passed")
                        {
                            <a href="@(string.IsNullOrWhiteSpace(capability.RepairTarget) ? "/settings" : capability.RepairTarget)">@(capability.Status == "deferred" ? "Set up in Settings" : "Fix") <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ArrowForward" Size="AppSize.Small" /></a>
                        }
                    </div>
                    <AppStatusBadge Text="@StatusLabel(capability.Status)" Tone="@StatusTone(capability.Status)" Icon="@(capability.Status == "passed" ? AppMaterialIcons.Filled.CheckCircle : null)" />
                </article>
            }
        </div>
        @if (DownloadRunning)
        {
            <AppAlert Tone="AppUiTone.Info" data-testid="setup-download-note">@L["SetupReadinessStage_ADownloadIsStillRunning"]</AppAlert>
        }
        <SetupStageFooter Back="Back" ShowReturnToCurrentStep="ShowReturnToCurrentStep" ReturnToCurrentStep="ReturnToCurrentStep">
            <AppButton Label="@L["SetupReadinessStage_OpenMyLibrary"].Value" EndIcon="@AppMaterialIcons.Outlined.ArrowForward" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@Busy" Disabled="@(!Readiness.CanComplete)" OnClick="Complete" />
        </SetupStageFooter>
    }
</div>

@code {
    [Parameter] public SetupReadinessDto? Readiness { get; set; }
    /// <summary>Only used to say that a download is still running; the tools themselves are listed on the Tools step.</summary>
    [Parameter] public ToolRequirementsDto? Tools { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Failed { get; set; }
    [Parameter] public EventCallback Retry { get; set; }
    [Parameter] public EventCallback Complete { get; set; }
    [Parameter] public EventCallback Back { get; set; }
    [Parameter] public bool ShowReturnToCurrentStep { get; set; }
    [Parameter] public EventCallback ReturnToCurrentStep { get; set; }

    // Neutral until the check has an answer, so the spinner never claims something needs attention.
    private string Subtitle => Readiness is null
        ? "One moment while Library checks your setup."
        : Readiness.CanComplete
            ? "Library is ready to start finding your media."
            : "A few things need attention before you open your library.";

    private bool DownloadRunning => Tools?.Tools.Any(tool => tool.State == ToolRequirementStates.Downloading) == true;

    private static string CapabilityLabel(string key) => key switch { "welcome" => "Welcome", "profile" => "Your profile", "tools" => "Tools", "libraries" => "Libraries", "metadata" => "Metadata", _ => key.Replace('-', ' ') };
    private static string CapabilityIcon(string key) => key switch { "welcome" => AppMaterialIcons.Outlined.Dns, "tools" => AppMaterialIcons.Outlined.Build, "profile" => AppMaterialIcons.Outlined.PersonOutline, "libraries" => AppMaterialIcons.Outlined.FolderOpen, "metadata" => AppMaterialIcons.Outlined.Storage, _ => AppMaterialIcons.Outlined.CheckCircleOutline };
    private static string StatusLabel(string status) => status switch { "passed" => "Ready", "deferred" => "Later", "blocked" => "Needs attention", _ => "Needs attention" };
    private static AppUiTone StatusTone(string status) => status switch { "passed" => AppUiTone.Success, "deferred" => AppUiTone.Neutral, _ => AppUiTone.Error };
}
