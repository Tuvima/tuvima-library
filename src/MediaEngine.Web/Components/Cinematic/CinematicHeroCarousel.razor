@namespace MediaEngine.Web.Components.Cinematic
@using Microsoft.Extensions.DependencyInjection
@using MediaEngine.Domain.Enums
@using MediaEngine.Contracts.Progress
@using MediaEngine.Contracts.Playback
@using MediaEngine.Contracts.Details
@using MediaEngine.Contracts.Display
@using MediaEngine.Web.Services.MediaTiles
@using MediaEngine.Domain.Services
@using MediaEngine.Web.Components.Details
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Playback
@inject IServiceProvider Services
@inject IEngineApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<CinematicHeroCarousel> Logger
@inject PlaybackSessionController Playback
@implements IAsyncDisposable

@if (Slides.Count > 0)
{
    <section class="@CarouselClass"
             aria-roledescription="carousel"
             aria-label="@AriaLabel"
             @onmouseenter="PauseForHover"
             @onmouseleave="ResumeFromHover"
             @onfocusin="PauseForFocus"
             @onfocusout="ResumeFromFocus">
        <div class="cinematic-hero-carousel__slide" aria-live="@(IsPaused ? "polite" : "off")">
            <CinematicHeroSurface Artwork="@ActiveArtwork"
                                  IsLanding="true"
                                  HeroImageWidthPx="@(UsesLandscapeBackground ? ActiveHero.BackgroundWidthPx : ActiveHero.CoverWidthPx)"
                                  HeroImageHeightPx="@(UsesLandscapeBackground ? ActiveHero.BackgroundHeightPx : ActiveHero.CoverHeightPx)"
                                  CoverWidthPx="@ActiveHero.CoverWidthPx"
                                  CoverHeightPx="@ActiveHero.CoverHeightPx"
                                  EntityType="@ActiveEntityType"
                                  Title="@ActiveHero.Title"
                                  Class="@HeroClass"
                                  Css="@HeroStyle">
                <a class="cinematic-hero-carousel__detail-link"
                   href="@ActiveDetailsUrl"
                   aria-label="@($"Open details for {ActiveHero.Title}")"></a>

                <div class="cinematic-hero-carousel__context">@CarouselContextLabel</div>

                <DetailHeroContent Title="@ActiveHero.Title"
                                   UseLogo="@UsesLogo"
                                   LogoUrl="@ActiveHero.LogoUrl"
                                   Subtitle="@DisplaySubtitle"
                                   Synopsis="@DisplaySummary"
                                   Class="cinematic-hero__content">
                    <MetadataContent>
                        <HeroMetadataPills Metadata="@LandingMetadata"
                                           EntityType="@ActiveEntityType"
                                           IdentityStatus="CanonicalIdentityStatus.Unknown"
                                           IsWatchHero="@IsWatchHero"
                                           UsePrimaryHeroChrome="true"
                                           RenderHeroBrandInMetadata="false" />
                    </MetadataContent>
                    <ActionContent>
                        <HeroActionRow PrimaryActions="@LandingPrimaryActions"
                                       SecondaryActions="@LandingSecondaryActions"
                                       OverflowActions="@LandingOverflowActions"
                                       Progress="@LandingProgress"
                                       UsePrimaryHeroChrome="true"
                                       OnActionSelected="OpenLandingActionAsync" />
                    </ActionContent>
                    <SupplementalContent>
                        @if (Density == CinematicHeroDensity.CompactAudio && ActiveHero.PreviewItems.Count > 0)
                        {
                            <div class="cinematic-hero__track-preview" aria-label="Featured album tracks">
                                <div class="cinematic-hero__track-preview-heading">
                                    <span>Tracks</span>
                                    @if (ActiveHero.PreviewTotalCount is > 0)
                                    {
                                        <small>@ActiveHero.PreviewTotalCount total</small>
                                    }
                                </div>
                                <ol>
                                    @foreach (var track in ActiveHero.PreviewItems.Take(4))
                                    {
                                        <li>
                                            <span>@(string.IsNullOrWhiteSpace(track.Position) ? "-" : track.Position)</span>
                                            @if (!string.IsNullOrWhiteSpace(track.NavigationUrl))
                                            {
                                                <a href="@track.NavigationUrl">@track.Title</a>
                                            }
                                            else
                                            {
                                                <span class="cinematic-hero__track-title">@track.Title</span>
                                            }
                                        </li>
                                    }
                                </ol>
                            </div>
                        }
                    </SupplementalContent>
                </DetailHeroContent>
            </CinematicHeroSurface>
        </div>

        @if (Slides.Count > 1)
        {
            <div class="cinematic-hero-carousel__controls">
                <div class="cinematic-hero-carousel__timeline"
                     role="group"
                     aria-label="Choose featured item">
                    @for (var index = 0; index < Slides.Count; index++)
                    {
                        var slideIndex = index;
                        var isActive = slideIndex == _activeIndex;
                        <AppNativeButton Type="button"
                                         Class="@TimelineItemClass(isActive)"
                                         AriaLabel="@TimelineItemLabel(slideIndex)"
                                         aria-current="@(isActive ? "true" : null)"
                                         Title="@Slides[slideIndex].Title"
                                         OnClick="@(_ => SelectSlideAsync(slideIndex))">
                            <span class="cinematic-hero-carousel__dash" aria-hidden="true">
                                @if (isActive)
                                {
                                    <span @key="TimelineFillKey"
                                          class="cinematic-hero-carousel__dash-fill"></span>
                                }
                            </span>
                        </AppNativeButton>
                    }
                    <span class="cinematic-hero-carousel__status" aria-live="polite">
                        @($"Featured item {_activeIndex + 1} of {Slides.Count}")
                    </span>
                </div>

                <div class="cinematic-hero-carousel__navigation">
                    <AppNativeButton Type="button"
                                     Class="cinematic-hero-carousel__control cinematic-hero-carousel__control--previous"
                                     AriaLabel="Previous featured item"
                                     Title="Previous featured item"
                                     OnClick="PreviousAsync">
                        <MudIcon Icon="@Icons.Material.Outlined.ChevronLeft" />
                    </AppNativeButton>

                    <AppNativeButton Type="button"
                                     Class="cinematic-hero-carousel__control cinematic-hero-carousel__control--next"
                                     AriaLabel="Next featured item"
                                     Title="Next featured item"
                                     OnClick="NextAsync">
                        <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" />
                    </AppNativeButton>

                    <AppNativeButton Type="button"
                                     Class="cinematic-hero-carousel__control cinematic-hero-carousel__control--pause"
                                     AriaLabel="@PauseButtonLabel"
                                     Title="@PauseButtonLabel"
                                     OnClick="TogglePauseAsync">
                        <MudIcon Icon="@PauseButtonIcon" />
                    </AppNativeButton>
                </div>
            </div>
        }
    </section>
}

@code {
    [Parameter] public IReadOnlyList<DiscoveryHeroViewModel> Items { get; set; } = [];
    [Parameter] public string SectionTitle { get; set; } = string.Empty;
    [Parameter] public string? SectionSubtitle { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Featured media";
    [Parameter] public CinematicHeroDensity Density { get; set; } = CinematicHeroDensity.Full;
    [Parameter] public EventCallback<DiscoveryHeroViewModel> ActiveItemChanged { get; set; }

    private const int MaxSlides = 5;
    private static readonly TimeSpan RotationInterval = TimeSpan.FromSeconds(8);
    private static readonly TimeSpan RotationClockResolution = TimeSpan.FromMilliseconds(100);
    private readonly CancellationTokenSource _disposeCts = new();
    private int _activeIndex;
    private (string Kind, Guid Id)? _selectedHero;
    private Guid? _selectionProfile;
    private int _rotationVersion;
    private bool _initializedMotionPreference;
    private bool _prefersReducedMotion;
    private bool _userPaused;
    private bool _hoverPaused;
    private bool _focusPaused;
    private Task? _rotationTask;

    private IReadOnlyList<DiscoveryHeroViewModel> Slides => Items
        .Where(item => !string.IsNullOrWhiteSpace(item.Title))
        .Take(MaxSlides)
        .ToList();

    private DiscoveryHeroViewModel ActiveHero => Slides[Math.Clamp(_activeIndex, 0, Slides.Count - 1)];
    private bool IsPaused => _prefersReducedMotion || _userPaused || _hoverPaused || _focusPaused || Slides.Count < 2;
    private bool UsesLandscapeArtwork => ActiveHero.SurfaceKind == MediaTileSurfaceKind.BannerLandscape;
    private bool UsesLandscapeBackground => UsesLandscapeArtwork
        && !string.IsNullOrWhiteSpace(StringHelpers.FirstNonBlank(ActiveHero.HeroBackgroundImageUrl, ActiveHero.BackgroundImageUrl, ActiveHero.BannerImageUrl));
    private bool UsesLogo => UsesLandscapeArtwork && ActiveHero.EpisodeContext is null && !string.IsNullOrWhiteSpace(ActiveHero.LogoUrl);
    private bool IsWatchHero => ActiveEntityType is DetailEntityType.Movie or DetailEntityType.TvShow;
    private bool IsContinuation => ActiveEntityType != DetailEntityType.MusicAlbum
        && ActiveHero.ContinuationState == DisplayContinuationState.InProgress;
    private string? DisplaySummary => ActiveHero.EpisodeContext is not null
        ? ActiveHero.Description
        : StringHelpers.FirstNonBlank(ActiveHero.Tagline, ActiveHero.Tldr, ActiveHero.Description);
    private string? DisplaySubtitle => ActiveHero.EpisodeContext is not null || !IsWatchHero ? ActiveHero.Subtitle : null;
    private string CarouselContextLabel => IsContinuation
        ? ActiveEntityType switch
        {
            DetailEntityType.Movie or DetailEntityType.TvShow => "Continue Watching",
            DetailEntityType.Book or DetailEntityType.ComicIssue => "Continue Reading",
            _ => "Continue Listening",
        }
        : "Featured Content";

    private IReadOnlyList<MetadataPill> LandingMetadata => ActiveHero.MetaPills
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Where(value => !value.StartsWith("New ", StringComparison.OrdinalIgnoreCase))
        .Select(ToMetadataPill)
        .Concat(ActiveHero.Genres
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => new MetadataPill { Kind = "genre", Label = value.Trim() }))
        .Where(item => !string.IsNullOrWhiteSpace(item.Kind))
        .DistinctBy(item => $"{item.Kind}:{item.Label}", StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IReadOnlyList<DetailAction> LandingPrimaryActions
    {
        get
        {
            var primary = new DetailAction
            {
                Key = IsContinuation ? "resume" : IsOpenAction ? "open-feature" : PrimaryActionKey,
                Label = LandingPrimaryLabel,
                Icon = IsOpenAction ? null : PrimaryActionIcon,
                Route = ActiveHero.PrimaryNavigationUrl,
                IsPrimary = true,
            };

            return [primary];
        }
    }

    private ProgressViewModel? LandingProgress => IsContinuation && ActiveHero.ProgressPct is > 0 and < 99.5
        ? new ProgressViewModel
        {
            Percent = ActiveHero.ProgressPct.Value,
            Label = ActiveHero.StatusText,
            Kind = ActiveEntityType switch
            {
                DetailEntityType.Movie or DetailEntityType.TvShow => DetailProgressKind.Watching,
                DetailEntityType.Audiobook or DetailEntityType.MusicAlbum => DetailProgressKind.Listening,
                _ => DetailProgressKind.Reading,
            },
        }
        : null;

    private string CarouselClass => $"cinematic-hero-carousel cinematic-hero-carousel--{Density.ToString().ToLowerInvariant()}{(IsPaused ? " is-rotation-paused" : string.Empty)}";
    private string HeroClass => $"cinematic-hero cinematic-hero--landing cinematic-hero--{Density.ToString().ToLowerInvariant()} {HeroMediaClass}";
    private string HeroMediaClass => ActiveEntityType switch
    {
        DetailEntityType.Movie or DetailEntityType.TvShow => "tl-detail-hero--watch",
        DetailEntityType.MusicAlbum => "tl-detail-hero--music",
        DetailEntityType.Audiobook => "tl-detail-hero--listen",
        _ => "tl-detail-hero--read",
    };
    private HomeHeroFraming Framing => HomeHeroFraming.Resolve(ActiveHero.BackgroundWidthPx, ActiveHero.BackgroundHeightPx,
        MediaTileArtworkUrl.Sized(ActiveHero.HeroBackgroundImageUrl ?? ActiveHero.BackgroundImageUrl, "l") is not null);
    private string HeroStyle => $"--cinematic-hero-accent: {ActiveHero.AccentColor}; --hero-image-position:{Framing.Position}; --mobile-image-position:{Framing.Position};";
    private bool IsOpenAction => ActiveHero.PrimaryActionLabel.StartsWith("Open", StringComparison.OrdinalIgnoreCase);
    private string LandingPrimaryLabel => ActiveEntityType switch
    {
        DetailEntityType.MusicAlbum when !IsOpenAction => "Play",
        DetailEntityType.Audiobook when IsContinuation => "Resume",
        DetailEntityType.Audiobook when !IsOpenAction => "Listen",
        _ => ActiveHero.PrimaryActionLabel,
    };
    private string ActiveDetailsUrl => StringHelpers.FirstNonBlank(ActiveHero.SecondaryNavigationUrl, ActiveHero.PrimaryNavigationUrl) ?? "/";
    private string PrimaryActionKey => ActiveEntityType switch
    {
        DetailEntityType.Book or DetailEntityType.ComicIssue => "read",
        DetailEntityType.MusicAlbum => "play-album",
        DetailEntityType.Audiobook => "listen",
        _ => "watch",
    };
    private string PrimaryActionIcon => ActiveEntityType switch
    {
        DetailEntityType.Book or DetailEntityType.ComicIssue => "auto_stories",
        DetailEntityType.MusicAlbum => "play_arrow",
        DetailEntityType.Audiobook => "headphones",
        _ => "play_arrow",
    };
    private string PauseButtonLabel => _userPaused ? "Resume featured item rotation" : "Pause featured item rotation";
    private string PauseButtonIcon => _userPaused ? Icons.Material.Filled.PlayArrow : Icons.Material.Filled.Pause;
    private string TimelineFillKey => $"{_activeIndex}:{_rotationVersion}";

    private DetailEntityType ActiveEntityType => (ActiveHero.MediaKind ?? string.Empty).Trim().ToLowerInvariant() switch
    {
        "movie" => DetailEntityType.Movie,
        "tv" => DetailEntityType.TvShow,
        "music" => DetailEntityType.MusicAlbum,
        "audiobook" => DetailEntityType.Audiobook,
        "comic" => DetailEntityType.ComicIssue,
        _ => DetailEntityType.Book,
    };

    private ArtworkSet ActiveArtwork
    {
        get
        {
            var backdrop = StringHelpers.FirstNonBlank(ActiveHero.HeroBackgroundImageUrl, ActiveHero.BackgroundImageUrl, ActiveHero.BannerImageUrl);
            var fallback = StringHelpers.FirstNonBlank(ActiveHero.PreviewImageUrl, backdrop);
            var hasBackdrop = !string.IsNullOrWhiteSpace(backdrop) && UsesLandscapeArtwork && !Framing.CoverLed;
            var source = hasBackdrop ? backdrop : fallback;
            var small = MediaTileArtworkUrl.Sized(source, "s");
            var medium = MediaTileArtworkUrl.Sized(source, "m");
            var large = MediaTileArtworkUrl.Sized(source, "l");
            var url = hasBackdrop ? large ?? medium ?? source : medium ?? source;
            return new ArtworkSet
            {
                BackdropUrl = backdrop,
                BannerUrl = ActiveHero.BannerImageUrl,
                CoverUrl = MediaTileArtworkUrl.Sized(ActiveHero.PreviewImageUrl, "m") ?? ActiveHero.PreviewImageUrl,
                PosterUrl = MediaTileArtworkUrl.Sized(ActiveHero.PreviewImageUrl, "m") ?? ActiveHero.PreviewImageUrl,
                LogoUrl = ActiveHero.LogoUrl,
                PrimaryColor = ActiveHero.AccentColor,
                AccentColor = ActiveHero.AccentColor,
                HeroArtwork = new HeroArtworkViewModel
                {
                    Url = url,
                    SmallUrl = small,
                    MediumUrl = medium,
                    LargeUrl = large,
                    HasImage = !string.IsNullOrWhiteSpace(url),
                    Mode = string.IsNullOrWhiteSpace(url)
                        ? HeroArtworkMode.Placeholder
                        : hasBackdrop
                            ? string.IsNullOrWhiteSpace(ActiveHero.LogoUrl)
                                ? HeroArtworkMode.BackdropWithRenderedTitle
                                : HeroArtworkMode.BackdropWithLogo
                            : HeroArtworkMode.ArtworkFallback,
                    BackgroundPosition = Framing.Position,
                    MobilePosition = Framing.Position,
                },
            };
        }
    }

    private SavedItemService? _savedItems;
    private MediaReactionService? _reactions;
    protected override void OnInitialized()
    {
        _savedItems = Services.GetService<SavedItemService>();
        _reactions = Services.GetService<MediaReactionService>();
        if (_savedItems is not null) _savedItems.Changed += PersonalChanged;
        if (_reactions is not null) _reactions.Changed += PersonalChanged;
    }
    private void PersonalChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposeCts.IsCancellationRequested) return;
        _personal.Clear();
        await LoadPersonalAsync();
        if (!_disposeCts.IsCancellationRequested) StateHasChanged();
    });

    protected override async Task OnParametersSetAsync()
    {
        var slides = Slides;
        var profile = Playback.ActiveProfileId;
        if (_selectionProfile != profile)
        {
            _selectedHero = null;
            _activeIndex = 0;
            _selectionProfile = profile;
        }
        if (_selectedHero is { } selected)
        {
            var index = slides.ToList().FindIndex(item => HeroIdentity(item) == selected);
            if (index >= 0) _activeIndex = index;
        }
        _activeIndex = Math.Clamp(_activeIndex, 0, Math.Max(0, slides.Count - 1));
        _selectedHero = slides.Count > 0 ? HeroIdentity(ActiveHero) : null;
        await LoadPersonalAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initializedMotionPreference)
        {
            return;
        }

        _initializedMotionPreference = true;
        try
        {
            _prefersReducedMotion = await JS.InvokeAsync<bool>("tuvimaPrefersReducedMotion");
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not read the reduced-motion preference for the cinematic hero.");
        }

        _rotationTask = RunRotationAsync(_disposeCts.Token);
        await NotifyActiveItemAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RunRotationAsync(CancellationToken token)
    {
        var elapsed = TimeSpan.Zero;
        var observedVersion = Volatile.Read(ref _rotationVersion);
        var previousTimestamp = System.Diagnostics.Stopwatch.GetTimestamp();

        while (!token.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(RotationClockResolution, token);
                var currentTimestamp = System.Diagnostics.Stopwatch.GetTimestamp();
                var currentVersion = Volatile.Read(ref _rotationVersion);
                if (currentVersion != observedVersion)
                {
                    elapsed = TimeSpan.Zero;
                    observedVersion = currentVersion;
                    previousTimestamp = currentTimestamp;
                    continue;
                }

                if (IsPaused || Slides.Count < 2)
                {
                    previousTimestamp = currentTimestamp;
                    continue;
                }

                elapsed += System.Diagnostics.Stopwatch.GetElapsedTime(previousTimestamp, currentTimestamp);
                previousTimestamp = currentTimestamp;
                if (elapsed < RotationInterval)
                    continue;

                elapsed = TimeSpan.Zero;
                await InvokeAsync(async () =>
                {
                    _activeIndex = (_activeIndex + 1) % Slides.Count;
                    ResetRotationClock();
                    observedVersion = Volatile.Read(ref _rotationVersion);
                    await NotifyActiveItemAsync();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) when (token.IsCancellationRequested)
            {
                break;
            }
        }
    }

    private async Task PreviousAsync()
    {
        if (Slides.Count > 1)
        {
            _activeIndex = (_activeIndex - 1 + Slides.Count) % Slides.Count;
            ResetRotationClock();
            await NotifyActiveItemAsync();
        }
    }

    private async Task NextAsync()
    {
        if (Slides.Count > 1)
        {
            _activeIndex = (_activeIndex + 1) % Slides.Count;
            ResetRotationClock();
            await NotifyActiveItemAsync();
        }
    }

    private async Task SelectSlideAsync(int index)
    {
        if (index < 0 || index >= Slides.Count)
            return;

        _activeIndex = index;
        ResetRotationClock();
        await NotifyActiveItemAsync();
    }

    private Task TogglePauseAsync()
    {
        _userPaused = !_userPaused;
        return Task.CompletedTask;
    }

    private async Task OpenLandingActionAsync(DetailAction action)
    {
        var identity = LandingIdentity;
        var profile = Playback.ActiveProfileId;
        if (action.Key == "my-list" && Services.GetService<SavedItemService>() is { } saved) {
            await saved.ToggleAsync(identity.Kind, identity.Id); _personal.Remove((profile, identity.Id)); await LoadPersonalAsync(); return;
        }
        if (action.Key is "reaction-like" or "reaction-dislike" && Services.GetService<MediaReactionService>() is { } reactions) {
            var current = await reactions.GetReactionAsync(identity.Id, profile, identity.Kind);
            if (identity != LandingIdentity || profile != Playback.ActiveProfileId) return;
            await reactions.SetReactionAsync(identity.Id, MediaReactionService.ToggleRating(current, action.Key == "reaction-like" ? MediaReaction.Like : MediaReaction.Dislike), profile, identity.Kind);
            _personal.Remove((profile, identity.Id)); await LoadPersonalAsync(); return;
        }
        if (action.Key == "copy-link") { await JS.InvokeVoidAsync("navigator.clipboard.writeText", new Uri(new Uri(Nav.BaseUri), ActiveDetailsUrl).AbsoluteUri); return; }
        if (action.Key.StartsWith("status-")) {
            var status = await ApiClient.GetPersonalStatusAsync(ActiveEntityType, identity.Id);
            if (status is null || identity != LandingIdentity) return;
            var command = action.Key switch { "status-complete" => PersonalStatusAction.Complete, "status-reset" => PersonalStatusAction.Reset, "status-hide" => PersonalStatusAction.HideContinue, "status-show" => PersonalStatusAction.ShowContinue, _ => (PersonalStatusAction?)null };
            if (command is not null) { await ApiClient.ChangePersonalStatusAsync(new(Guid.NewGuid(), ActiveEntityType, identity.Id, command.Value, status.Revision)); _personal.Remove((profile, identity.Id)); await LoadPersonalAsync(); }
            else Nav.NavigateTo(ActiveDetailsUrl);
            return;
        }
        if (action.Key == "play-from-beginning")
        {
            if (ActiveEntityType is DetailEntityType.Book or DetailEntityType.ComicIssue && await OpenLandingReaderAsync(restart: true)) return;
            if (ActiveEntityType == DetailEntityType.Audiobook && await PlayLandingAudiobookAsync(restart: true)) return;
        }
        if (ActiveEntityType is DetailEntityType.Book or DetailEntityType.ComicIssue
            && action.Key is "read" or "resume")
        {
            if (await OpenLandingReaderAsync())
                return;
        }

        if (ActiveEntityType == DetailEntityType.MusicAlbum && action.Key is "play-album" or "resume")
        {
            if (await PlayLandingAlbumAsync())
                return;
        }

        if (ActiveEntityType == DetailEntityType.Audiobook && action.Key is "listen" or "resume")
        {
            if (await PlayLandingAudiobookAsync())
                return;
        }

        await OpenAsync(action.Route);
    }

    private async Task<bool> OpenLandingReaderAsync(bool restart = false)
    {
        var assetId = ActiveHero.PreviewItems
            .Select(item => item.AssetId)
            .FirstOrDefault(id => id.HasValue);
        if (!assetId.HasValue)
        {
            var workId = ActiveHero.WorkId ?? ActiveHero.RepresentativeEntityId;
            if (workId.HasValue)
                assetId = await ApiClient.ResolveWorkToAssetAsync(workId.Value);
        }

        if (!assetId.HasValue)
            return false;

        Nav.NavigateTo($"/read/{assetId.Value:D}{(restart ? "?restart=true" : "")}");
        return true;
    }

    private async Task<bool> PlayLandingAlbumAsync()
    {
        var tracks = ActiveHero.PreviewItems
            .Where(item => item.WorkId.HasValue)
            .OrderBy(item => TrackPosition(item.Position))
            .ThenBy(item => item.Title, StringComparer.OrdinalIgnoreCase)
            .Select(item => new ListenQueueItem
            {
                WorkId = item.WorkId!.Value,
                AssetId = item.AssetId,
                MediaType = "Music",
                Title = item.Title,
                Subtitle = ActiveHero.Subtitle,
                Album = ActiveHero.Title,
                CoverUrl = StringHelpers.FirstNonBlank(item.ImageUrl, ActiveHero.PreviewImageUrl),
            })
            .ToList();
        if (tracks.Count == 0)
            return false;

        await Playback.ReplaceQueueItemsAsync(tracks, 0, ActiveHero.Title, shuffle: false);
        return true;
    }

    private async Task<bool> PlayLandingAudiobookAsync(bool restart = false)
    {
        var workId = ActiveHero.WorkId
                     ?? ActiveHero.PreviewItems.Select(item => item.WorkId).FirstOrDefault(id => id.HasValue);
        if (!workId.HasValue)
            return false;

        var preview = ActiveHero.PreviewItems.FirstOrDefault(item => item.WorkId == workId);
        var item = new ListenQueueItem
        {
            WorkId = workId.Value,
            AssetId = preview?.AssetId,
            MediaType = "Audiobooks",
            Title = ActiveHero.Title,
            Subtitle = ActiveHero.Subtitle,
            Album = ActiveHero.Title,
            CoverUrl = StringHelpers.FirstNonBlank(preview?.ImageUrl, ActiveHero.PreviewImageUrl),
        };
        if (restart) await Playback.StartAudiobookAsync(new AudiobookStartRequest(item, AudiobookStartKinds.Chapter, 0, 0, ActiveHero.Title));
        else await Playback.PlayAudiobookAsync(item, ActiveHero.Title);
        return true;
    }

    private Task OpenAsync(string? url)
    {
        if (!string.IsNullOrWhiteSpace(url))
        {
            Nav.NavigateTo(url);
        }

        return Task.CompletedTask;
    }

    private static (string Kind, Guid Id)? HeroIdentity(DiscoveryHeroViewModel item)
    {
        var id = item.WorkId ?? item.RepresentativeEntityId ?? item.CollectionId;
        return id is Guid identity && identity != Guid.Empty ? (item.MediaKind ?? string.Empty, identity) : null;
    }
    private async Task NotifyActiveItemAsync()
    {
        if (Slides.Count == 0) return;
        _selectedHero = HeroIdentity(ActiveHero);
        await LoadPersonalAsync();
        if (ActiveItemChanged.HasDelegate) await ActiveItemChanged.InvokeAsync(ActiveHero);
    }
    private (ProfileEntityKind Kind, Guid Id) LandingIdentity => (ActiveEntityType switch { DetailEntityType.TvShow or DetailEntityType.TvEpisode => ProfileEntityKind.TvShow, DetailEntityType.Movie => ProfileEntityKind.Movie, DetailEntityType.Audiobook => ProfileEntityKind.Audiobook, DetailEntityType.MusicAlbum => ProfileEntityKind.Album, DetailEntityType.ComicIssue => ProfileEntityKind.Comic, _ => ProfileEntityKind.Book }, ActiveHero.EpisodeContext?.ShowWorkId ?? ActiveHero.CollectionId ?? ActiveHero.WorkId ?? ActiveHero.RepresentativeEntityId ?? Guid.Empty);
    private readonly Dictionary<(Guid? Profile, Guid Id), (bool Saved, MediaReaction Reaction, IReadOnlyList<DetailAction> Menu)> _personal = [];
    private (bool Saved, MediaReaction Reaction, IReadOnlyList<DetailAction> Menu) Personal => _personal.GetValueOrDefault((Playback.ActiveProfileId, LandingIdentity.Id), (false, MediaReaction.Neutral, []));
    private IReadOnlyList<DetailAction> LandingSecondaryActions => LandingIdentity.Id == Guid.Empty ? [] : [
        new() { Key="my-list", Label=Personal.Saved ? "Remove from My List" : "Add to My List", Icon=Personal.Saved ? "check_circle" : "add", IsSelected=Personal.Saved },
        new() { Key="reaction-menu", Label="Rate", Icon="thumb_up", IsSelected=Personal.Reaction is MediaReaction.Like or MediaReaction.Love, Children=[new() { Key="reaction-dislike",Label="Not for me",Icon="thumb_down",IsSelected=Personal.Reaction==MediaReaction.Dislike },new() { Key="reaction-like",Label="I like this",Icon="thumb_up",IsSelected=Personal.Reaction is MediaReaction.Like or MediaReaction.Love }] } ];
    private IReadOnlyList<DetailAction> LandingOverflowActions => (IsContinuation ? new[] { new DetailAction { Key="play-from-beginning",Label="Restart from beginning",Icon="restart_alt",Route=RestartRoute(ActiveHero.PrimaryNavigationUrl) } } : []).Concat(Personal.Menu.Where(action => action.Key != "edit" && action.Key != "play-from-beginning")).Concat([new DetailAction { Key="go-details",Label="Go to details",Icon="info",Route=ActiveDetailsUrl }]).ToList();
    private async Task LoadPersonalAsync() {
        if (Slides.Count == 0) return;
        var identity=LandingIdentity; var profile=Playback.ActiveProfileId;
        if (identity.Id==Guid.Empty || _personal.ContainsKey((profile,identity.Id))) return;
        try {
            var saved=Services.GetService<SavedItemService>(); var reactions=Services.GetService<MediaReactionService>();
            var member=saved is null ? null : await saved.GetMembershipAsync(identity.Kind,identity.Id);
            var reaction=reactions is null ? MediaReaction.Neutral : await reactions.GetReactionAsync(identity.Id,profile,identity.Kind);
            var detail=await ApiClient.GetDetailPageAsync(ActiveEntityType,identity.Id,DetailPresentationContext.Default,profileId:profile);
            if (identity==LandingIdentity && profile==Playback.ActiveProfileId) _personal[(profile,identity.Id)]=(member?.IsSaved==true,reaction,detail?.OverflowActions ?? []);
        } catch(Exception ex) { Logger.LogDebug(ex,"Could not load Home hero personal actions."); }
    }

    private void PauseForHover() => _hoverPaused = true;
    private void ResumeFromHover() => _hoverPaused = false;
    private void PauseForFocus() => _focusPaused = true;
    private void ResumeFromFocus() => _focusPaused = false;

    private void ResetRotationClock() => Interlocked.Increment(ref _rotationVersion);

    private string TimelineItemClass(bool isActive)
        => $"cinematic-hero-carousel__timeline-item{(isActive ? " is-active" : string.Empty)}";

    private string TimelineItemLabel(int index)
        => $"Show featured item {index + 1} of {Slides.Count}: {Slides[index].Title}";

    private static double TrackPosition(string? value)
        => double.TryParse(value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var position)
            ? position
            : double.MaxValue;

    private static string RestartRoute(string route)
        => Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(route, "restart", "true");

    private static MetadataPill ToMetadataPill(string value)
    {
        var label = value.Trim();
        var kind = MetadataKind(label);
        if (kind == "rating")
        {
            label = label.TrimStart('★').Trim();
        }

        return new MetadataPill { Kind = kind, Label = label };
    }

    private static string? MetadataKind(string value)
    {
        if (value.StartsWith('★'))
            return "rating";
        if (value.Length == 4 && int.TryParse(value, out var year) && year is >= 1800 and <= 2200)
            return "year";
        if (value.Contains("episode", StringComparison.OrdinalIgnoreCase))
            return "episode_count";
        if (value.Contains("season", StringComparison.OrdinalIgnoreCase))
            return "season_count";
        if (value.Contains("page", StringComparison.OrdinalIgnoreCase))
            return "page_count";
        if (value.Contains("track", StringComparison.OrdinalIgnoreCase))
            return "track_count";
        if (value.Contains("min", StringComparison.OrdinalIgnoreCase)
            || value.Contains("hour", StringComparison.OrdinalIgnoreCase)
            || value.EndsWith('h')
            || value.Contains(':'))
        {
            return "duration";
        }
        if (value.StartsWith("TV-", StringComparison.OrdinalIgnoreCase)
            || value is "G" or "PG" or "PG-13" or "R" or "NC-17")
        {
            return "content_rating";
        }
        if (value is "4K" or "UHD" or "HD" or "1080p" or "2160p")
            return "quality";

        return null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_savedItems is not null) _savedItems.Changed -= PersonalChanged;
        if (_reactions is not null) _reactions.Changed -= PersonalChanged;
        _disposeCts.Cancel();
        if (_rotationTask is not null)
        {
            try
            {
                await _rotationTask;
            }
            catch (OperationCanceledException)
            {
                // Cancellation is expected while the page is being disposed.
            }
        }

        _disposeCts.Dispose();
    }
}
