@namespace MediaEngine.Web.Components.Cinematic
@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Components.Details
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Ui
@inject IStringLocalizer<SharedStrings> L

@* The phone Home hero: one rounded card of fixed height, identical for every slide and media type, so nothing below it
   moves when the slide changes. Fixed slots: picture, title (two lines at most), one meta line, one full-width primary
   button and at most two compact icon buttons (My List, More). Swipe and the dots change slides; nothing rotates by itself. *@
@if (Hero is not null)
{
    <div class="phone-hero">
        <div class="@CardClass">
            <a class="phone-hero__link" href="@DetailsUrl" aria-label="@($"Open details for {Hero.Title}")"></a>
            <div class="phone-hero__art" aria-hidden="true">
                @switch (Art.Mode)
                {
                    case PhoneHeroArt.Backdrop:
                        <img class="phone-hero__backdrop" src="@Art.ImageUrl" alt="" decoding="async" fetchpriority="high" />
                        break;
                    case PhoneHeroArt.Cover:
                        @* A blurred copy of the cover fills the card behind the large cover, so there is no empty dark area. *@
                        <img class="phone-hero__cover-blur" src="@Art.ImageUrl" alt="" decoding="async" />
                        <img class="phone-hero__cover" src="@Art.ImageUrl" alt="" decoding="async" fetchpriority="high" />
                        break;
                    default:
                        <div class="phone-hero__placeholder">
                            <AppMaterialIcon Icon="@PlaceholderIcon" Class="phone-hero__placeholder-icon" />
                            <span class="phone-hero__placeholder-word">@PhoneHeroPresentation.PlaceholderLabel(Hero.MediaKind)</span>
                        </div>
                        break;
                }
            </div>
            <div class="phone-hero__content">
                <div class="phone-hero__tag-slot">
                    @if (Hero.IsSettling)
                    {
                        <span class="phone-hero__tag">@L["Common_StillBeingMatched"]</span>
                    }
                    else if (PhoneHeroPresentation.VideoLabel(Hero) is { } videoLabel)
                    {
                        @* A video says what it is ("Video folder", "Video") or that it is being continued, over its title. *@
                        <span class="phone-hero__tag">@videoLabel</span>
                    }
                </div>
                @* The logo zone is a fixed two-line box: a logo scales to fit inside it, and a title with no logo is drawn as text in it. *@
                <div class="phone-hero__title-zone">
                    @if (!string.IsNullOrWhiteSpace(Art.LogoUrl))
                    {
                        <img class="phone-hero__logo" src="@Art.LogoUrl" alt="" decoding="async" />
                    }
                    <h1 class="@(string.IsNullOrWhiteSpace(Art.LogoUrl) ? "phone-hero__title" : "phone-hero__title sr-only")">@Hero.Title</h1>
                </div>
                <p class="phone-hero__meta">@PhoneHeroPresentation.HeroLine(Hero)</p>
                <div class="phone-hero__progress-slot">
                    @if (ProgressPercent is > 0 and < 99.5)
                    {
                        <progress class="phone-hero__progress" max="100" value="@((int)Math.Round(ProgressPercent.Value))" aria-label="@L["Common_Progress"].Value"></progress>
                    }
                </div>
                <div class="phone-hero__actions">
                    @* The same row as the Home and details heroes: the light 56 px main button and Plain companions (Look v3 D12). *@
                    @if (Primary is not null)
                    {
                        <HeroActionRow PrimaryActions="@(new[] { Primary })"
                                       SecondaryActions="@(MyList is null ? Array.Empty<DetailAction>() : new[] { MyList })"
                                       OverflowActions="MoreActions"
                                       PrimaryLabel="@PrimaryText.Text"
                                       PrimaryDetail="@PrimaryText.Detail"
                                       PrimaryAriaLabel="@PrimaryText.Full"
                                       OnActionSelected="OnAction" />
                    }
                </div>
            </div>
        </div>

        @if (Slides.Count > 1)
        {
            <div class="phone-hero__dots" role="group" aria-label="@L["Common_ChooseFeaturedItem"].Value">
                @for (var index = 0; index < Slides.Count; index++)
                {
                    var slideIndex = index;
                    var isActive = slideIndex == ActiveIndex;
                    <AppNativeButton Type="button"
                                     Class="@(isActive ? "phone-hero__dot is-active" : "phone-hero__dot")"
                                     AriaLabel="@($"Show featured item {slideIndex + 1} of {Slides.Count}: {Slides[slideIndex].Title}")"
                                     aria-current="@(isActive ? "true" : null)"
                                     OnClick="@(_ => OnSelectSlide.InvokeAsync(slideIndex))">
                        <span class="phone-hero__dot-mark" aria-hidden="true"></span>
                    </AppNativeButton>
                }
                <span class="sr-only" aria-live="polite">@($"Featured item {ActiveIndex + 1} of {Slides.Count}")</span>
            </div>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<DiscoveryHeroViewModel> Slides { get; set; } = [];
    [Parameter] public int ActiveIndex { get; set; }
    [Parameter] public string DetailsUrl { get; set; } = "/";
    [Parameter] public DetailAction? Primary { get; set; }
    [Parameter] public DetailAction? MyList { get; set; }
    [Parameter] public IReadOnlyList<DetailAction> MoreActions { get; set; } = [];
    [Parameter] public double? ProgressPercent { get; set; }
    [Parameter] public EventCallback<DetailAction> OnAction { get; set; }
    [Parameter] public EventCallback<int> OnSelectSlide { get; set; }

    private DiscoveryHeroViewModel? Hero => Slides.Count == 0 ? null : Slides[Math.Clamp(ActiveIndex, 0, Slides.Count - 1)];
    private PhoneHeroArtwork Art => Hero is null ? new(PhoneHeroArt.Placeholder, null, null) : PhoneHeroPresentation.ResolveArt(Hero);
    private PhoneHeroPrimaryLabel PrimaryText => Hero is null ? new(Primary?.Label ?? string.Empty, null) : PhoneHeroPresentation.PrimaryLabel(Hero);
    private string CardClass => $"phone-hero__card phone-hero__card--{Art.Mode.ToString().ToLowerInvariant()}";

    private string PlaceholderIcon => (Hero?.MediaKind ?? string.Empty).Trim().ToLowerInvariant() switch
    {
        "movie" => AppMaterialIcons.Outlined.Movie,
        "tv" => AppMaterialIcons.Outlined.Tv,
        "music" => AppMaterialIcons.Outlined.Album,
        "audiobook" => AppMaterialIcons.Outlined.Headphones,
        var other when PhoneHeroPresentation.IsVideoKind(other) => AppMaterialIcons.Outlined.Movie,
        "book" or "books" or "ebook" or "comic" or "comics" => AppMaterialIcons.Outlined.MenuBook,
        _ => AppMaterialIcons.Outlined.Image, // An unknown kind never gets the book icon.
    };
}
