@namespace MediaEngine.Web.Components.Navigation
@implements IDisposable
@inject PlaybackSessionController Playback
@inject NavigationManager Nav
@inject MediaEngine.Web.Services.Theming.DeviceContextService DeviceContext
@inject IStringLocalizer<SharedStrings> L
@using MediaEngine.Web.Services.Navigation
@using MediaEngine.Web.Services.Playback

@* Unified player D7a: while something is playing, a small animated sound-bars mark sits in the top bar. For audio it opens or
   closes the Now playing page (route /listen/now-playing); for video it returns to the player page. Playback never stops either way. *@
@if (Playback.HasQueue && Playback.CurrentItem is not null && !Playback.IsDismissed)
{
    <span class="now-playing-nav-button" data-now-playing-nav>
        <AppTooltip Text="@L["NowPlayingNavButton_NowPlaying"].Value" Placement="AppPlacement.Bottom">
            <AppButton ButtonStyle="AppButtonStyle.Text" Size="AppControlSize.Normal" OnClick="OpenAsync" UserAttributes="@_labelAttributes">
                <PlaybackActivityMark IsPlaying="@Playback.IsPlaying" AriaLabel="@L["NowPlayingNavButton_NowPlaying"].Value" />
            </AppButton>
        </AppTooltip>
    </span>
}

@code {
    // The page under the details overlay counts as the current page while it is open.
    [CascadingParameter] public DetailsOverlayState? Overlay { get; set; }

    private readonly Dictionary<string, object> _labelAttributes = new() { ["aria-label"] = "Now playing" };

    protected override void OnInitialized() => Playback.Changed += OnPlaybackChanged;

    private void OnPlaybackChanged(PlaybackChangeKind kind)
    {
        if (kind is PlaybackChangeKind.TransportTick) return;
        _ = InvokeAsync(StateHasChanged);
    }

    private void Open()
    {
        if (Playback.IsVideoMode)
        {
            if (Playback.CurrentItem?.WorkId is Guid workId && workId != Guid.Empty)
                Nav.NavigateTo($"/watch/player/{workId:D}");
            return;
        }
        if (DeviceContext.IsPhone)
        {
            Playback.SetPresentationSurface(Playback.PresentationSurface == PlaybackPresentationSurface.NowPlaying
                ? PlaybackPresentationSurface.Docked
                : PlaybackPresentationSurface.NowPlaying);
            return;
        }
        // A desktop opens the Now playing page, remembering where the person was, or goes back from it (unified player v2 D24).
        if (NowPlayingRoute.IsNowPlaying(Nav.Uri))
        {
            Nav.NavigateTo(NowPlayingRoute.ReturnTarget(Nav));
            return;
        }
        Nav.NavigateTo(NowPlayingRoute.Build(DetailsOverlayState.ToAppPath(Nav, RoutedPageAddress.AbsoluteFor(Nav, Overlay))));
    }

    private Task OpenAsync() { Open(); return Task.CompletedTask; }

    public void Dispose() => Playback.Changed -= OnPlaybackChanged;
}
