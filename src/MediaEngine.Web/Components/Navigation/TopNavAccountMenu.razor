@namespace MediaEngine.Web.Components.Navigation

@inject IStringLocalizer<SharedStrings> L

<div class="top-nav-account-menu-shell"
     data-app-dismissible="@(_open ? "open" : null)"
     @onkeydown="HandleKeyDown">
    @if (_open)
    {
        <AppNativeButton Type="button"
                         Class="app-dismissible-surface__dismiss"
                         data-app-dismiss
                         tabindex="-1"
                         aria-hidden="true"
                         OnClick="CloseMenu" />
    }
    <AppNativeButton Type="button"
                     Class="top-nav-account-menu__trigger"
                     AriaLabel="@ProfileMenuAriaLabel"
                     aria-haspopup="menu"
                     aria-expanded="@(_open ? "true" : "false")"
                     OnClick="ToggleMenu">
                <AppAvatar ImageUrl="@AvatarImageUrl"
                           AltText=""
                           Initials="@AvatarInitial"
                           AccentColor="@AvatarColor"
                           ForegroundColor="@AvatarForeground"
                           Class="top-nav-account-menu__avatar" />
                <span class="top-nav-account-menu__trigger-copy">@DisplayName</span>
                @if (IsKids)
                {
                    <span class="kids-badge">Kids</span>
                }
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.KeyboardArrowDown"
                         Class="top-nav-account-menu__chevron" />
    </AppNativeButton>

    @if (_open)
    {
            <div class="top-nav-account-menu__panel" role="menu">
                @if (ShowSecureAccount && !_secureNotNow && !IsKids)
                {
                    <section class="top-nav-account-menu__secure-card" aria-labelledby="top-nav-secure-account-title">
                        <h3 id="top-nav-secure-account-title" class="top-nav-account-menu__secure-title">Secure your account</h3>
                        <p class="top-nav-account-menu__secure-body">Add a password to use the Library away from home. Phones and TVs at home keep working without one.</p>
                        <div class="top-nav-account-menu__secure-actions">
                            <AppButton Label="Secure account"
                                       Href="@SecureAccountPrompt.SecureAccountHref"
                                       ButtonStyle="AppButtonStyle.Filled"
                                       Tone="AppUiTone.Primary"
                                       Class="top-nav-account-menu__secure-action"
                                       OnClick="CloseMenu" />
                            <AppButton Label="Not now"
                                       ButtonStyle="AppButtonStyle.Text"
                                       Class="top-nav-account-menu__secure-action"
                                       OnClick="NotNowAsync" />
                        </div>
                    </section>
                }

                <header class="top-nav-account-menu__header">
                    <AppAvatar ImageUrl="@AvatarImageUrl"
                               AltText=""
                               Initials="@AvatarInitial"
                               AccentColor="@AvatarColor"
                               ForegroundColor="@AvatarForeground"
                               Class="top-nav-account-menu__header-avatar" />
                    <strong>@HeaderLabel</strong>
                    @if (IsKids)
                    {
                        <span class="kids-badge">Kids</span>
                    }
                </header>

                @* The other people come first (Netflix order, in the household's order). The signed-in person is not listed, and a household of one has no list. *@
                @if (Profiles.Count > 1)
                {
                    <TopNavProfileSwitcher ActiveProfileId="@ActiveProfileId" Profiles="@Profiles" />

                    <a class="top-nav-account-menu__item"
                       href="@ProfilePickerRoute.Path"
                       role="menuitem"
                       @onclick="CloseMenu">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.People"
                                 Class="top-nav-account-menu__item-icon" />
                        <span>Who's watching?</span>
                    </a>

                    <AppDivider Class="top-nav-account-menu__divider" />
                }

                @if (CanManageProfiles && !IsKids)
                {
                    <a class="top-nav-account-menu__item"
                       href="@ManageProfilesHref"
                       role="menuitem"
                       @onclick="CloseMenu">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ManageAccounts"
                                 Class="top-nav-account-menu__item-icon" />
                        <span>Manage profiles</span>
                    </a>
                }

                @* A Kids profile cannot reach Settings, so its Profile link opens its own pages outside Settings. *@
                <a class="top-nav-account-menu__item"
                   href="@(IsKids ? KidsProfileHref : MyProfileHref)"
                   role="menuitem"
                   @onclick="CloseMenu">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Person"
                             Class="top-nav-account-menu__item-icon" />
                    <span>Profile</span>
                </a>

                @if (!IsKids)
                {
                    <a class="top-nav-account-menu__item"
                       href="/settings"
                       role="menuitem"
                       @onclick="CloseMenu">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Settings"
                                 Class="top-nav-account-menu__item-icon" />
                        <span>@L["Nav_Settings"]</span>
                    </a>
                }

                <a class="top-nav-account-menu__item"
                   href="@ProjectLinks.DocsSite"
                   target="_blank"
                   rel="noopener noreferrer"
                   role="menuitem"
                   @onclick="CloseMenu">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.HelpOutline"
                             Class="top-nav-account-menu__item-icon" />
                    <span class="top-nav-account-menu__item-copy">
                        <span>@L["TopBar_Help"]</span>
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.OpenInNew"
                                 Class="top-nav-account-menu__external" />
                    </span>
                </a>

                @if (!IsKids)
                {
                    <MediaEngine.Web.Components.Vault.NsfwQuickCheck OnChanged="CloseMenu" />
                }

                @foreach (var entry in PluginMenu)
                {
                    <a class="top-nav-account-menu__item"
                       href="@PluginPageRoute.Href(entry)"
                       role="menuitem"
                       @onclick="CloseMenu">
                        <AppMaterialIcon Icon="@PluginPageRoute.Icon(entry.PageType)"
                                 Class="top-nav-account-menu__item-icon" />
                        <span>@entry.Label</span>
                    </a>
                }

                @if (ShowSignOut)
                {
                    <AppDivider Class="top-nav-account-menu__divider" />
                    <form method="post" action="/auth/logout" class="top-nav-account-menu__signout-form">
                        <AntiforgeryToken />
                        <AppNativeButton Type="submit"
                                         Class="top-nav-account-menu__signout"
                                         role="menuitem">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Logout" />
                            <span>@L["TopBar_SignOut"]</span>
                        </AppNativeButton>
                    </form>
                }
            </div>
    }
</div>

@code {
    [Parameter] public string DisplayName { get; set; } = string.Empty;
    /// <summary>Signed-in account (email); the header falls back to <see cref="DisplayName"/> when unavailable.</summary>
    [Parameter] public string? AccountLabel { get; set; }
    [Parameter] public bool CanManageProfiles { get; set; }
    /// <summary>True while the account is this-computer-only and has not chosen Not now: shows the Secure your account card at the top of the menu.</summary>
    [Parameter] public bool ShowSecureAccount { get; set; }
    /// <summary>Raised when the person chooses Not now on the Secure your account card; the owner remembers it with the account.</summary>
    [Parameter] public EventCallback OnSecureAccountNotNow { get; set; }
    public const string ManageProfilesHref = "/settings/profiles";
    /// <summary>Profile opens the person's own Overview.</summary>
    public const string MyProfileHref = "/settings/overview";
    public const string KidsProfileHref = "/my-profile";
    [Parameter] public string ProfileRole { get; set; } = "Profile";
    [Parameter] public string AvatarInitial { get; set; } = string.Empty;
    [Parameter] public string AvatarColor { get; set; } = "var(--tl-accent-primary)";
    [Parameter] public string AvatarForeground { get; set; } = "#fff";
    [Parameter] public string? AvatarImageUrl { get; set; }
    [Parameter] public Guid? ActiveProfileId { get; set; }
    [Parameter] public IReadOnlyList<ProfileViewModel> Profiles { get; set; } = [];
    /// <summary>Pages plugins add to the menu, already cut to what the active profile may see.</summary>
    [Parameter] public IReadOnlyList<PluginMenuEntryDto> PluginMenu { get; set; } = [];
    [Parameter] public bool ShowSignOut { get; set; }

    /// <summary>True for a Kids profile: no settings or review links, and a "Kids" badge.</summary>
    [Parameter] public bool IsKids { get; set; }

    private bool _open;
    private string HeaderLabel => string.IsNullOrWhiteSpace(AccountLabel) ? DisplayName : AccountLabel!;
    private string ProfileMenuAriaLabel =>
        string.IsNullOrWhiteSpace(DisplayName) ? L["TopBar_OpenProfileMenu"].Value : string.Concat(L["TopBar_OpenProfileMenu"].Value, ": ", DisplayName);

    private void ToggleMenu()
    {
        if (_open)
            CloseMenu();
        else
            _open = true;
    }
    private void CloseMenu()
    {
        _open = false;
    }

    // Not now hides the card at once, before the owner has finished remembering the choice.
    private bool _secureNotNow;

    private async Task NotNowAsync()
    {
        _secureNotNow = true;
        await OnSecureAccountNotNow.InvokeAsync();
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            CloseMenu();
        }
    }
}
