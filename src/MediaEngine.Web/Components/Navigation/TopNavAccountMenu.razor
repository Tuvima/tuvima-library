@namespace MediaEngine.Web.Components.Navigation

@inject IStringLocalizer<SharedStrings> L

<div class="top-nav-account-menu-shell"
     data-app-dismissible="@(_open ? "open" : null)"
     @onkeydown="HandleKeyDown">
    @if (_open)
    {
        <AppNativeButton Type="button"
                         Class="app-dismissible-surface__dismiss"
                         data-app-dismiss
                         tabindex="-1"
                         aria-hidden="true"
                         OnClick="CloseMenu" />
    }
    <AppNativeButton Type="button"
                     Class="top-nav-account-menu__trigger"
                     AriaLabel="@ProfileMenuAriaLabel"
                     aria-haspopup="menu"
                     aria-expanded="@(_open ? "true" : "false")"
                     OnClick="ToggleMenu">
                <AppAvatar ImageUrl="@AvatarImageUrl"
                           AltText=""
                           Initials="@AvatarInitial"
                           AccentColor="@AvatarColor"
                           ForegroundColor="@AvatarForeground"
                           Class="top-nav-account-menu__avatar" />
                <span class="top-nav-account-menu__trigger-copy">@DisplayName</span>
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.KeyboardArrowDown"
                         Class="top-nav-account-menu__chevron" />
    </AppNativeButton>

    @if (_open)
    {
            <div class="top-nav-account-menu__panel" role="menu">
                <header class="top-nav-account-menu__header">
                    <AppAvatar ImageUrl="@AvatarImageUrl"
                               AltText=""
                               Initials="@AvatarInitial"
                               AccentColor="@AvatarColor"
                               ForegroundColor="@AvatarForeground"
                               Class="top-nav-account-menu__header-avatar" />
                    <strong>@DisplayName</strong>
                </header>

                @if (_pendingProfile is not null)
                {
                    <section class="top-nav-account-menu__switch-prompt"
                             role="dialog"
                             aria-labelledby="profile-switch-title"
                             aria-describedby="profile-switch-description">
                        <strong id="profile-switch-title">Switch profile?</strong>
                        <p id="profile-switch-description">
                            Continue as @_pendingProfile.DisplayName? Any administrator elevation for the current profile will be cleared.
                        </p>
                        @if (_pinRequired)
                        {
                            <label class="top-nav-account-menu__pin-field">
                                <span>Profile PIN</span>
                                <AppNativeInput Type="password"
                                                Value="@_profilePin"
                                                ValueChanged="@(value => _profilePin = value?.ToString() ?? string.Empty)"
                                                OnKeyDown="HandlePinKeyDownAsync"
                                                AriaLabel="Profile PIN"
                                                autocomplete="current-password"
                                                inputmode="numeric" />
                            </label>
                        }
                        @if (!string.IsNullOrWhiteSpace(_switchError))
                        {
                            <p class="top-nav-account-menu__switch-error" role="alert">@_switchError</p>
                        }
                        <div class="top-nav-account-menu__switch-actions">
                            <AppNativeButton Type="button"
                                             Class="top-nav-account-menu__switch-cancel"
                                             Disabled="@_switching"
                                             OnClick="CancelProfileSwitch">Cancel</AppNativeButton>
                            <AppNativeButton Type="button"
                                             Class="top-nav-account-menu__switch-confirm"
                                             Disabled="@(_switching || (_pinRequired && string.IsNullOrWhiteSpace(_profilePin)))"
                                             OnClick="ConfirmProfileSwitchAsync">
                                @(_switching ? "Switching…" : "Switch")
                            </AppNativeButton>
                        </div>
                    </section>
                }
                else if (ProfilesForMenu.Count > 0)
                {
                    <div class="top-nav-account-menu__profiles">
                        @foreach (var profile in ProfilesForMenu)
                        {
                            var isActive = profile.Id == ActiveProfileId;
                            @if (isActive)
                            {
                                <a class="top-nav-account-menu__item top-nav-account-menu__profile-item is-active"
                                   href="/settings/profile"
                                   role="menuitem"
                                   aria-current="page"
                                   @key="profile.Id"
                                   @onclick="CloseMenu">
                                    <AppAvatar ImageUrl="@profile.AvatarImageUrl"
                                               AltText=""
                                               Initials="@AvatarInitialFor(profile.DisplayName)"
                                               AccentColor="@profile.AvatarColor"
                                               ForegroundColor="@AvatarForeground"
                                               Class="top-nav-account-menu__profile-avatar" />
                                    <span>@profile.DisplayName</span>
                                    <span class="top-nav-account-menu__current-label">Current</span>
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Check" Class="top-nav-account-menu__current-icon" />
                                </a>
                            }
                            else
                            {
                                <AppNativeButton Type="button"
                                                 Class="top-nav-account-menu__item top-nav-account-menu__profile-item"
                                                 role="menuitem"
                                                 @key="profile.Id"
                                                 OnClick="@(() => BeginProfileSwitch(profile))">
                                    <AppAvatar ImageUrl="@profile.AvatarImageUrl"
                                               AltText=""
                                               Initials="@AvatarInitialFor(profile.DisplayName)"
                                               AccentColor="@profile.AvatarColor"
                                               ForegroundColor="@AvatarForeground"
                                               Class="top-nav-account-menu__profile-avatar" />
                                    <span>@profile.DisplayName</span>
                                </AppNativeButton>
                            }
                        }
                    </div>
                }

                <AppDivider Class="top-nav-account-menu__divider" />

                @if (CanViewReview)
                {
                    <a class="top-nav-account-menu__item"
                       href="/settings/recently-added?review=expanded"
                       role="menuitem"
                       @onclick="CloseMenu">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.RateReview"
                                 Class="top-nav-account-menu__item-icon" />
                        <span class="top-nav-account-menu__item-copy">
                            <span>@L["TopBar_NeedsReview"]</span>
                            <span class="top-nav-account-menu__review-count">@ReviewCountLabel</span>
                        </span>
                    </a>
                }

                <a class="top-nav-account-menu__item"
                   href="/settings"
                   role="menuitem"
                   @onclick="CloseMenu">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Settings"
                             Class="top-nav-account-menu__item-icon" />
                    <span>@L["Nav_Settings"]</span>
                </a>

                <a class="top-nav-account-menu__item"
                   href="https://tuvima.github.io/tuvima_library/"
                   target="_blank"
                   rel="noopener noreferrer"
                   role="menuitem"
                   @onclick="CloseMenu">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.HelpOutline"
                             Class="top-nav-account-menu__item-icon" />
                    <span class="top-nav-account-menu__item-copy">
                        <span>@L["TopBar_Help"]</span>
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.OpenInNew"
                                 Class="top-nav-account-menu__external" />
                    </span>
                </a>

                @if (ShowSignOut)
                {
                    <AppDivider Class="top-nav-account-menu__divider" />
                    <form method="post" action="/auth/logout" class="top-nav-account-menu__signout-form">
                        <AntiforgeryToken />
                        <AppNativeButton Type="submit"
                                         Class="top-nav-account-menu__signout"
                                         role="menuitem">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Logout" />
                            <span>@L["TopBar_SignOut"]</span>
                        </AppNativeButton>
                    </form>
                }
            </div>
    }
</div>

@code {
    [Parameter] public string DisplayName { get; set; } = "User";
    [Parameter] public string ProfileRole { get; set; } = "Profile";
    [Parameter] public string AvatarInitial { get; set; } = "?";
    [Parameter] public string AvatarColor { get; set; } = "var(--tl-accent-primary)";
    [Parameter] public string AvatarForeground { get; set; } = "#fff";
    [Parameter] public string? AvatarImageUrl { get; set; }
    [Parameter] public Guid? ActiveProfileId { get; set; }
    [Parameter] public IReadOnlyList<ProfileViewModel> Profiles { get; set; } = [];
    [Parameter] public int ReviewCount { get; set; }
    [Parameter] public bool CanViewReview { get; set; }
    [Parameter] public bool ShowSignOut { get; set; }
    [Parameter] public Func<Guid, string?, Task<ProfileSwitchOutcome>>? ProfileSwitchRequested { get; set; }

    private bool _open;
    private ProfileViewModel? _pendingProfile;
    private bool _pinRequired;
    private bool _switching;
    private string _profilePin = string.Empty;
    private string? _switchError;

    private IReadOnlyList<ProfileViewModel> ProfilesForMenu => Profiles
        .OrderByDescending(profile => profile.Id == ActiveProfileId)
        .ThenBy(profile => profile.DisplayName, StringComparer.OrdinalIgnoreCase)
        .ToList();
    private string ProfileMenuAriaLabel =>
        string.Concat(L["TopBar_OpenProfileMenu"].Value, ": ", DisplayName);

    private string ReviewCountLabel => ReviewCount > 99 ? "99+" : Math.Max(0, ReviewCount).ToString();

    private void ToggleMenu()
    {
        if (_open)
            CloseMenu();
        else
            _open = true;
    }
    private void CloseMenu()
    {
        _open = false;
        CancelProfileSwitch();
    }

    private void BeginProfileSwitch(ProfileViewModel profile)
    {
        _pendingProfile = profile;
        _pinRequired = false;
        _profilePin = string.Empty;
        _switchError = null;
    }

    private void CancelProfileSwitch()
    {
        _pendingProfile = null;
        _pinRequired = false;
        _switching = false;
        _profilePin = string.Empty;
        _switchError = null;
    }

    private async Task ConfirmProfileSwitchAsync()
    {
        if (_pendingProfile is null || ProfileSwitchRequested is null)
            return;

        _switching = true;
        _switchError = null;
        var outcome = await ProfileSwitchRequested(
            _pendingProfile.Id,
            _pinRequired ? _profilePin : null);
        _switching = false;

        switch (outcome.Status)
        {
            case ProfileSwitchStatus.Succeeded:
                CloseMenu();
                break;
            case ProfileSwitchStatus.PinRequired:
                _pinRequired = true;
                _profilePin = string.Empty;
                _switchError = "This profile requires its PIN.";
                break;
            case ProfileSwitchStatus.Forbidden:
                _switchError = "This account cannot switch to that profile.";
                break;
            case ProfileSwitchStatus.NotFound:
                _switchError = "That profile is no longer available.";
                break;
            default:
                _switchError = "The profile could not be switched. Try again.";
                break;
        }
    }

    private Task HandlePinKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.Ordinal))
            return ConfirmProfileSwitchAsync();
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
            CancelProfileSwitch();
        return Task.CompletedTask;
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            CloseMenu();
        }
    }

    private static string AvatarInitialFor(string displayName)
    {
        var initial = displayName.FirstOrDefault(character => !char.IsWhiteSpace(character));
        return initial == default ? "?" : char.ToUpperInvariant(initial).ToString();
    }
}
