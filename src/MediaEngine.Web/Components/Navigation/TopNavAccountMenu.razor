@namespace MediaEngine.Web.Components.Navigation

@inject IStringLocalizer<SharedStrings> L

<div class="top-nav-account-menu-shell"
     @ref="_anchor"
     data-app-dismissible="@(_open ? "open" : null)"
     @onkeydown="HandleKeyDown">
    <AppNativeButton Type="button"
                     Class="top-nav-account-menu__trigger"
                     AriaLabel="@ProfileMenuAriaLabel"
                     aria-haspopup="menu"
                     aria-expanded="@(_open ? "true" : "false")"
                     OnClick="ToggleMenu">
                <AppAvatar ImageUrl="@AvatarImageUrl"
                           AltText=""
                           Initials="@AvatarInitial"
                           AccentColor="@OwnColor"
                           ForegroundColor="@OwnForeground"
                           Class="top-nav-account-menu__avatar" />
                <span class="top-nav-account-menu__trigger-copy">@DisplayName</span>
                @if (IsKids)
                {
                    <AppChip Text="@L["Common_Kids"].Value" Tone="AppUiTone.Info" />
                }
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.KeyboardArrowDown"
                         Class="top-nav-account-menu__chevron" />
    </AppNativeButton>

    @if (_open)
    {
        @* Drawn through the shared popover so it sits in the top layer and no bar or scroll box can clip it. *@
        <AppPopover Open="true" OpenChanged="PopoverChanged" Anchor="_anchor" AnchorOrigin="AppOrigin.BottomRight" TransformOrigin="AppOrigin.TopRight" Size="AppPopoutSize.Menu" Class="top-nav-account-menu__surface">
            <div class="top-nav-account-menu__panel" role="menu">
                @* Your own row is one button to My profile (profile and household D1; a Kids profile opens its own simple page, D15).
                   It is drawn at once from the signed-in person, so the menu never waits for the household list. *@
                <a class="top-nav-account-menu__me"
                   href="@(IsKids ? KidsProfileHref : MyProfileHref)"
                   aria-label="@OwnRowAriaLabel"
                   role="menuitem"
                   data-testid="profile-menu-own-row"
                   @onclick="CloseMenu">
                    <span class="top-nav-account-menu__me-avatar">
                        <ProfileAvatar DisplayName="@DisplayName" ImageUrl="@OwnImageUrl" Color="@OwnColor" Icon="@OwnIcon" />
                    </span>
                    <span class="top-nav-account-menu__me-copy">
                        <strong>@DisplayName</strong>
                        <small>@L["TopNavAccountMenu_ProfileAndPreferences"]</small>
                    </span>
                    @if (IsKids)
                    {
                        <AppChip Text="@L["Common_Kids"].Value" Tone="AppUiTone.Info" />
                    }
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight"
                                     Class="top-nav-account-menu__me-arrow" />
                </a>

                @* The other people, in the household's order. A household of one has no heading and no list. The full-screen
                   picker is not offered here (D9): this list does the same job. *@
                @if (HasOtherProfiles)
                {
                    <p class="top-nav-account-menu__label" data-testid="profile-menu-switch-to">@L["TopNavAccountMenu_SwitchTo"]</p>
                    <TopNavProfileSwitcher ActiveProfileId="@ActiveProfileId" Profiles="@Profiles" />
                }

                <AppDivider Class="top-nav-account-menu__divider" />

                @if (CanManageProfiles && !IsKids)
                {
                    <a class="top-nav-account-menu__item"
                       href="@ManageProfilesHref"
                       role="menuitem"
                       @onclick="CloseMenu">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ManageAccounts"
                                 Class="top-nav-account-menu__item-icon" />
                        <span>@L["Common_ManageProfiles"]</span>
                    </a>
                }

                @if (!IsKids)
                {
                    <a class="top-nav-account-menu__item"
                       href="/settings"
                       role="menuitem"
                       @onclick="CloseMenu">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Settings"
                                 Class="top-nav-account-menu__item-icon" />
                        <span class="top-nav-account-menu__item-copy">
                            <span>@L["Nav_Settings"]</span>
                            @* The one place the app says "something needs you" (universal editor v3 D13): a small count that goes away at zero. *@
                            @if (ReviewCount > 0)
                            {
                                <span class="top-nav-account-menu__review-count" data-testid="settings-review-count" role="img"
                                      aria-label="@L["TopNavAccountMenu_NeedsReviewCount", ReviewCount.ToString("N0")].Value">@ReviewCount.ToString("N0")</span>
                            }
                        </span>
                    </a>
                }

                @if (!IsKids)
                {
                    <a class="top-nav-account-menu__item"
                       href="/recycle-bin"
                       role="menuitem"
                       @onclick="CloseMenu">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.DeleteOutline"
                                 Class="top-nav-account-menu__item-icon" />
                        <span>@L["Common_RecycleBin"]</span>
                    </a>
                }

                <a class="top-nav-account-menu__item"
                   href="@ProjectLinks.DocsSite"
                   target="_blank"
                   rel="noopener noreferrer"
                   role="menuitem"
                   @onclick="CloseMenu">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.HelpOutline"
                             Class="top-nav-account-menu__item-icon" />
                    <span class="top-nav-account-menu__item-copy">
                        <span>@L["TopBar_Help"]</span>
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.OpenInNew"
                                 Class="top-nav-account-menu__external" />
                    </span>
                </a>

                @if (!IsKids)
                {
                    <MediaEngine.Web.Components.Vault.NsfwQuickCheck OnChanged="CloseMenu" />
                }

                @foreach (var entry in PluginMenu)
                {
                    <a class="top-nav-account-menu__item"
                       href="@PluginPageRoute.Href(entry)"
                       role="menuitem"
                       @onclick="CloseMenu">
                        <AppMaterialIcon Icon="@PluginPageRoute.Icon(entry.PageType)"
                                 Class="top-nav-account-menu__item-icon" />
                        <span>@entry.Label</span>
                    </a>
                }

                @if (ShowSignOut)
                {
                    <AppDivider Class="top-nav-account-menu__divider" />
                    <form method="post" action="/auth/logout" class="top-nav-account-menu__signout-form">
                        <AntiforgeryToken />
                        <AppNativeButton Type="submit"
                                         Class="top-nav-account-menu__signout"
                                         role="menuitem">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Logout"
                                     Class="top-nav-account-menu__item-icon" />
                            <span>@L["TopBar_SignOut"]</span>
                        </AppNativeButton>
                    </form>
                }
            </div>
        </AppPopover>
    }
</div>

@code {
    [Parameter] public string DisplayName { get; set; } = string.Empty;
    /// <summary>Signed-in account (email); the header falls back to <see cref="DisplayName"/> when unavailable.</summary>
    [Parameter] public string? AccountLabel { get; set; }
    [Parameter] public bool CanManageProfiles { get; set; }
    public const string ManageProfilesHref = "/settings/household";
    /// <summary>The own row opens My profile.</summary>
    public const string MyProfileHref = "/settings/overview";
    public const string KidsProfileHref = "/my-profile";
    [Parameter] public string ProfileRole { get; set; } = "Profile";
    [Parameter] public string AvatarInitial { get; set; } = string.Empty;
    [Parameter] public string AvatarColor { get; set; } = "var(--tl-accent-primary)";
    [Parameter] public string AvatarForeground { get; set; } = "#fff";
    [Parameter] public string? AvatarImageUrl { get; set; }
    [Parameter] public Guid? ActiveProfileId { get; set; }
    [Parameter] public IReadOnlyList<ProfileViewModel> Profiles { get; set; } = [];
    /// <summary>Pages plugins add to the menu, already cut to what the active profile may see.</summary>
    [Parameter] public IReadOnlyList<PluginMenuEntryDto> PluginMenu { get; set; } = [];

    /// <summary>Sign out is offered only when this browser signed in with a password (profile and household D14); a no-password home sign-in has nothing to sign out of.</summary>
    [Parameter] public bool ShowSignOut { get; set; }

    /// <summary>Rows in Needs Review (review items plus files the Engine could not match); shown beside Settings, and absent at zero. Zero for anyone who is not an administrator.</summary>
    [Parameter] public int ReviewCount { get; set; }

    /// <summary>True for a Kids profile: no settings or review links, and a "Kids" badge.</summary>
    [Parameter] public bool IsKids { get; set; }

    private bool _open;
    private ElementReference _anchor;

    // The household's order decides each person's circle colour (D13), so the menu and the switcher agree.
    private ProfileViewModel? ActiveProfile => ActiveProfileId is { } id ? Profiles.FirstOrDefault(profile => profile.Id == id) : null;
    // Names the signed-in account too (when the shell knows it), since the email is no longer printed in the menu.
    private string? OwnRowAriaLabel => string.IsNullOrWhiteSpace(AccountLabel)
        ? null
        : string.Join(", ", DisplayName, L["TopNavAccountMenu_ProfileAndPreferences"].Value, AccountLabel);
    private bool HasOtherProfiles => Profiles.Any(profile => profile.Id != ActiveProfileId);
    private string? OwnImageUrl => ActiveProfile?.AvatarImageUrl ?? AvatarImageUrl;
    private string? OwnIcon => ActiveProfile?.AvatarIcon;
    private string OwnColor
    {
        get
        {
            var index = ActiveProfileId is { } id ? Profiles.ToList().FindIndex(profile => profile.Id == id) : -1;
            return index >= 0
                ? ProfileAvatarPalette.Distinct([.. Profiles.Select(profile => (string?)profile.AvatarColor)])[index]
                : AvatarColor;
        }
    }
    private string OwnForeground => string.Equals(OwnColor, AvatarColor, StringComparison.OrdinalIgnoreCase) ? AvatarForeground : ProfileAvatarPalette.InkFor(OwnColor);
    private string ProfileMenuAriaLabel =>
        string.IsNullOrWhiteSpace(DisplayName) ? L["TopBar_OpenProfileMenu"].Value : string.Concat(L["TopBar_OpenProfileMenu"].Value, ": ", DisplayName);

    private void ToggleMenu()
    {
        if (_open)
            CloseMenu();
        else
            _open = true;
    }
    private void CloseMenu()
    {
        _open = false;
    }

    // The popover reports an outside click or Escape; the menu closes with it.
    private void PopoverChanged(bool open)
    {
        if (!open)
            CloseMenu();
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            CloseMenu();
        }
    }
}
