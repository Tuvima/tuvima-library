@namespace MediaEngine.Web.Components.Navigation
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@inject UIOrchestratorService Orchestrator
@inject NavigationManager Navigation
@inject ILogger<TopNavProfileSwitcher> Logger
@* Quick switch inside the account menu. It only uses the profile list the page shell already loaded, so opening it adds no Engine requests.
   A profile with a PIN swaps the list for the number pad; a wrong PIN, a lockout or a refusal is shown here and nothing changes. *@
@if (Others.Count > 0)
{
    @if (_pending is { } pending)
    {
        <div class="profile-switcher profile-switcher--pin">
            <button type="button" class="profile-switcher__back" @onclick="CancelPin" disabled="@_busy">
                <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path fill="currentColor" d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" /></svg>
                <span>Back</span>
            </button>
            <span class="profile-switcher__who">
                <span class="profile-switcher__avatar"><ProfileAvatar DisplayName="@pending.DisplayName" ImageUrl="@pending.AvatarImageUrl" Color="@pending.AvatarColor" Icon="@pending.AvatarIcon" /></span>
                <strong>@pending.DisplayName</strong>
            </span>
            <PinPad @bind-Value="_pin" Label="@($"PIN for {pending.DisplayName}")" Disabled="@_busy" ShakeCount="@_shake" OnSubmit="SubmitPinAsync" OnCancel="CancelPin" />
            @if (_error is not null)
            {
                <p class="profile-switcher__error" role="alert">@_error</p>
            }
            <button type="button" class="profile-switcher__go" disabled="@(_busy || _pin.Length == 0)" @onclick="SubmitPinAsync">Open profile</button>
        </div>
    }
    else
    {
        <div class="profile-switcher" role="group" aria-label="Switch to another profile">
            @foreach (var profile in Others)
            {
                <button type="button" class="profile-switcher__item" role="menuitem" disabled="@_busy"
                        aria-label="@ItemLabel(profile)" @key="profile.Id" @onclick="@(() => ChooseAsync(profile))">
                    <span class="profile-switcher__avatar"><ProfileAvatar DisplayName="@profile.DisplayName" ImageUrl="@profile.AvatarImageUrl" Color="@profile.AvatarColor" Icon="@profile.AvatarIcon" /></span>
                    <span class="profile-switcher__name">@profile.DisplayName</span>
                    @if (profile.IsRestricted)
                    {
                        <span class="profile-switcher__tag">Kids</span>
                    }
                    @if (profile.HasPin)
                    {
                        <svg class="profile-switcher__lock" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path fill="currentColor" d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" /></svg>
                    }
                </button>
            }
            @if (_error is not null)
            {
                <p class="profile-switcher__error" role="alert">@_error</p>
            }
        </div>
    }
}

@code {
    [Parameter] public Guid? ActiveProfileId { get; set; }
    [Parameter] public IReadOnlyList<ProfileViewModel> Profiles { get; set; } = [];

    private ProfileViewModel? _pending;
    private string _pin = string.Empty;
    private string? _error;
    private int _shake;
    private bool _busy;

    private IReadOnlyList<ProfileViewModel> Others => Profiles.Where(profile => profile.Id != ActiveProfileId).ToList();

    private static string ItemLabel(ProfileViewModel profile)
    {
        var kids = profile.IsRestricted ? ", Kids profile" : string.Empty;
        return profile.HasPin ? $"Switch to {profile.DisplayName}{kids}, needs a PIN" : $"Switch to {profile.DisplayName}{kids}";
    }

    private Task ChooseAsync(ProfileViewModel profile)
    {
        _error = null;
        if (profile.HasPin)
        {
            BeginPin(profile);
            return Task.CompletedTask;
        }

        return SwitchAsync(profile, null);
    }

    private void BeginPin(ProfileViewModel profile)
    {
        _pending = profile;
        _pin = string.Empty;
        _shake = 0;
        _error = null;
    }

    private void CancelPin()
    {
        if (_busy)
        {
            return;
        }

        _pending = null;
        _pin = string.Empty;
        _error = null;
    }

    private Task SubmitPinAsync() => _pending is { } profile && !string.IsNullOrWhiteSpace(_pin)
        ? SwitchAsync(profile, _pin)
        : Task.CompletedTask;

    private async Task SwitchAsync(ProfileViewModel profile, string? pin)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var outcome = await Orchestrator.SetActiveProfileAsync(profile.Id, pin);
            if (!outcome.Succeeded)
            {
                _pin = string.Empty;
                if (outcome.Status == ProfileSwitchStatus.PinRequired && _pending is not null)
                {
                    _shake++;
                }

                _error = outcome.Status switch
                {
                    ProfileSwitchStatus.PinRequired => _pending is null ? null : "That PIN didn't work. Try again.",
                    ProfileSwitchStatus.Forbidden => "This account can't use that profile.",
                    ProfileSwitchStatus.NotFound => "That profile is no longer available.",
                    ProfileSwitchStatus.TooManyAttempts => "Too many attempts. Try again in a minute.",
                    _ => "That profile couldn't be opened. Try again.",
                };
                if (outcome.Status == ProfileSwitchStatus.PinRequired && _pending is null)
                {
                    // The Engine wants a PIN the list didn't know about (for example leaving a Kids profile for an adult).
                    BeginPin(profile);
                }

                return;
            }

            // A profile switch changes the signed-in role and every profile-scoped data source, so rebuild the circuit.
            Navigation.NavigateTo("/", forceLoad: true, replace: true);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(exception, "Could not switch profile from the top bar.");
            _error = "That profile couldn't be opened. Try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
