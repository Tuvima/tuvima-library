@namespace MediaEngine.Web.Components.Navigation
@implements IDisposable

@inject ShellActivityState Activity
@inject NavigationManager Nav

<span class="system-activity-indicator-shell">
    <AppTooltip Text="@TooltipText" Placement="AppPlacement.Bottom">
        <AppNativeButton Type="button"
                         Class="@ButtonClass"
                         AriaLabel="@AriaLabel"
                         OnClick="HandleClick">
            @if (Snapshot.IsWorking && Snapshot.Primary?.ProgressPercent is { } progress)
            {
                <span class="@RingClass" aria-hidden="true">
                    <AppSpinner Indeterminate="false" Value="@progress" Size="AppSize.Small" StrokeWidth="2" />
                </span>
            }
            else if (Snapshot.IsWorking)
            {
                <span class="system-activity-indicator__dot" aria-hidden="true"></span>
            }
            <AppMaterialIcon Icon="@PrimaryIcon" Class="system-activity-indicator__center-icon" />
            @if (Snapshot.IsWorking && Snapshot.ActiveCount > 1)
            {
                <span class="system-activity-indicator__count" aria-hidden="true">@CountLabel</span>
            }
            <span class="sr-only">@StateLabel</span>
        </AppNativeButton>
    </AppTooltip>
</span>

@code {
    [Parameter] public bool CanOpenSystemActivity { get; set; }

    private ShellActivitySnapshot Snapshot => Activity.Current;
    private string ButtonClass => Snapshot.IsWorking
        ? "system-activity-indicator is-working"
        : "system-activity-indicator is-idle";
    private string RingClass => Snapshot.Primary is { ProgressPercent: not null } primary
        && primary.Kind is ShellActivityKind.Ingestion or ShellActivityKind.Enrichment
            ? "system-activity-indicator__ring is-animated"
            : "system-activity-indicator__ring";

    private string PrimaryIcon => !Snapshot.IsWorking ? AppMaterialIcons.Outlined.Sync : Snapshot.Primary?.Kind switch
    {
        ShellActivityKind.Ingestion => AppMaterialIcons.Outlined.Sync,
        ShellActivityKind.Ai => AppMaterialIcons.Outlined.AutoAwesome,
        ShellActivityKind.Enrichment => AppMaterialIcons.Outlined.Hub,
        _ => AppMaterialIcons.Outlined.Build,
    };

    private string CountLabel => Snapshot.ActiveCount > 9 ? "9+" : Snapshot.ActiveCount.ToString();

    // The state is spoken and written as text, never conveyed by colour alone.
    private string StateLabel => Snapshot.IsWorking ? SystemActivityText.WorkingState : SystemActivityText.IdleState;

    private string AriaLabel => $"{StateLabel}. {TooltipText}";

    private string TooltipText => SystemActivityText.Tooltip(Snapshot, DateTimeOffset.UtcNow);

    protected override void OnInitialized() => Activity.Changed += OnActivityChanged;

    private void OnActivityChanged() => _ = InvokeAsync(StateHasChanged);

    private Task HandleClick()
    {
        if (!CanOpenSystemActivity)
            return Task.CompletedTask;

        Nav.NavigateTo("/settings/libraries");
        return Task.CompletedTask;
    }

    public void Dispose() => Activity.Changed -= OnActivityChanged;
}
