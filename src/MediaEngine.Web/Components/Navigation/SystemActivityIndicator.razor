@namespace MediaEngine.Web.Components.Navigation
@implements IDisposable

@inject ShellActivityState Activity
@inject PlayingNowState Playing
@inject NavigationManager Nav
@inject IStringLocalizer<SharedStrings> L

<span class="system-activity-indicator-shell">
    <AppTooltip Text="@TooltipText" Placement="AppPlacement.Bottom">
        <AppNativeButton Type="button"
                         Class="@ButtonClass"
                         AriaLabel="@AriaLabel"
                         OnClick="HandleClick">
            @* The one activity icon the Activity and Libraries progress card also draws (spec library-activity D32). *@
            <AppSyncActivityIcon Percent="@RingPercent" Working="@Working" Spinning="@RingSpins" Icon="@PrimaryIcon" />
            @if (Snapshot.IsWorking && Snapshot.ActiveCount > 1)
            {
                <span class="system-activity-indicator__count" aria-hidden="true">@CountLabel</span>
            }
            <span class="sr-only">@StateLabel</span>
        </AppNativeButton>
    </AppTooltip>
</span>

@code {
    [Parameter] public bool CanOpenSystemActivity { get; set; }

    private ShellActivitySnapshot Snapshot => Activity.Current;

    // The spinner also turns while the Engine prepares a video for someone (spec playing-now-and-general-tabs D16), shown only to someone who can open it.
    private bool EncodeBusy => CanOpenSystemActivity && Playing.HasEncode;

    private bool Working => Snapshot.IsWorking || EncodeBusy;

    private bool _retained;

    // The last library update ended with failures and nobody has opened Activity since: a quiet warning state (never a pop-up), shown only
    // to someone who can open Activity, and never over the working look.
    private bool NeedsAttention => !Snapshot.IsWorking && Snapshot.NeedsAttention && CanOpenSystemActivity;

    private string ButtonClass => Working
        ? "system-activity-indicator is-working"
        : NeedsAttention ? "system-activity-indicator is-attention" : "system-activity-indicator is-idle";
    private int? RingPercent => Snapshot.IsWorking ? Snapshot.Primary?.ProgressPercent : null;
    private bool RingSpins => Snapshot.Primary is { ProgressPercent: not null } primary
        && primary.Kind is ShellActivityKind.Ingestion or ShellActivityKind.Enrichment;

    private string PrimaryIcon => NeedsAttention ? AppMaterialIcons.Outlined.ErrorOutline
        : !Snapshot.IsWorking ? AppMaterialIcons.Outlined.Sync : Snapshot.Primary?.Kind switch
    {
        ShellActivityKind.Ingestion => AppMaterialIcons.Outlined.Sync,
        ShellActivityKind.Ai => AppMaterialIcons.Outlined.AutoAwesome,
        ShellActivityKind.Enrichment => AppMaterialIcons.Outlined.Hub,
        _ => AppMaterialIcons.Outlined.Build,
    };

    private string CountLabel => Snapshot.ActiveCount > 9 ? "9+" : Snapshot.ActiveCount.ToString();

    // The state is spoken and written as text, never conveyed by colour alone.
    private string StateLabel => Snapshot.IsWorking ? SystemActivityText.WorkingState
        : NeedsAttention ? L["SystemActivityIndicator_NeedsAttentionState"].Value : SystemActivityText.IdleState;

    private string AriaLabel => $"{StateLabel}. {TooltipText}";

    private string TooltipText => NeedsAttention
        ? L["SystemActivityIndicator_NeedsAttentionTooltip"].Value
        : SystemActivityText.Tooltip(Snapshot, DateTimeOffset.UtcNow);

    // Library work opens Library activity; otherwise the spinner (which also turns for an encode) opens Playing now (spec playing-now-and-general-tabs D16).
    private const string LibraryActivityRoute = "/settings/general/library-activity";
    private const string PlayingNowRoute = "/settings/general/playing-now";

    protected override void OnInitialized()
    {
        Activity.Changed += OnActivityChanged;
        Playing.Changed += OnActivityChanged;
    }

    protected override void OnParametersSet()
    {
        if (CanOpenSystemActivity && !_retained)
        {
            _retained = true;
            Playing.Retain();
        }
    }

    private void OnActivityChanged() => _ = InvokeAsync(StateHasChanged);

    private Task HandleClick()
    {
        if (!CanOpenSystemActivity)
            return Task.CompletedTask;

        Activity.AcknowledgeAttention();
        Nav.NavigateTo(Snapshot.IsWorking || !Playing.HasLiveWork ? LibraryActivityRoute : PlayingNowRoute);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Activity.Changed -= OnActivityChanged;
        Playing.Changed -= OnActivityChanged;
        if (_retained)
        {
            Playing.Release();
        }
    }
}
