@namespace MediaEngine.Web.Components.Navigation
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IStringLocalizer<SharedStrings> L

@* The phone hamburger menu: a full-screen sheet that mirrors the desktop top navigation. Its destinations arrive from
   ShellNavigation (the catalogue the desktop top bar renders), so nothing is retyped here. Photos and Documents live
   inside View and have no entries of their own. Below the divider: Settings, Switch profile, Sign out, each only when
   the active profile has it.
   The sheet is a native modal dialog, so focus stays inside it, Escape closes it and focus returns to the hamburger.
   Back also closes it: opening it adds one history entry that Back removes (see js/phone-nav-menu.js). *@
<AppDialogFrame Open="true" Title="@L["Nav_Menu"]" DialogOptions="MenuOptions" Class="phone-nav-menu-dialog" OnCancel="RequestCloseAsync">
    <div class="phone-nav-menu">
        <header class="phone-nav-menu__header">
            <h2 id="phone-nav-menu-title" class="phone-nav-menu__title">@L["Nav_Menu"]</h2>
            <AppNativeButton Type="button" Class="phone-nav-menu__close" AriaLabel="@L["Nav_CloseNavigation"]" OnClick="RequestCloseAsync">
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Close" />
            </AppNativeButton>
        </header>

        <nav class="phone-nav-menu__nav" aria-label="@L["Nav_Menu"]">
            <ul class="phone-nav-menu__list">
                @foreach (var link in Links)
                {
                    var current = ShellNavigation.IsCurrent(link.Path, CurrentPath);
                    var path = link.Path;
                    <li @key="link.Key">
                        <a class="@ItemClass(current)"
                           href="@link.Path"
                           aria-current="@(current ? "page" : null)"
                           @onclick="@(() => NavigateAsync(path))"
                           @onclick:preventDefault="true">
                            <AppMaterialIcon Icon="@link.Icon" />
                            <span>@L[link.LabelKey]</span>
                        </a>
                    </li>
                }
            </ul>

            @if (PluginEntries.Count > 0)
            {
                <hr class="phone-nav-menu__divider" />

                <ul class="phone-nav-menu__list">
                    @foreach (var entry in PluginEntries)
                    {
                        var path = PluginPageRoute.Href(entry);
                        var current = ShellNavigation.IsCurrent(path, CurrentPath);
                        <li @key="path">
                            <a class="@ItemClass(current)"
                               href="@path"
                               aria-current="@(current ? "page" : null)"
                               @onclick="@(() => NavigateAsync(path))"
                               @onclick:preventDefault="true">
                                <AppMaterialIcon Icon="@PluginPageRoute.Icon(entry.PageType)" />
                                <span>@entry.Label</span>
                            </a>
                        </li>
                    }
                </ul>
            }

            <hr class="phone-nav-menu__divider" />

            <ul class="phone-nav-menu__list">
                @if (ShowSettings)
                {
                    <li>
                        <a class="@ItemClass(IsSettings)"
                           href="@ShellDock.SettingsPath"
                           aria-current="@(IsSettings ? "page" : null)"
                           @onclick="@(() => NavigateAsync(ShellDock.SettingsPath))"
                           @onclick:preventDefault="true">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Settings" />
                            <span>@L["Nav_Settings"]</span>
                        </a>
                    </li>
                }
                @if (ShowSwitchProfile)
                {
                    <li>
                        <a class="@ItemClass(false)"
                           href="@ProfilePickerRoute.Path"
                           @onclick="@(() => NavigateAsync(ProfilePickerRoute.Path))"
                           @onclick:preventDefault="true">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.People" />
                            <span>@L["TopBar_SwitchProfile"]</span>
                        </a>
                    </li>
                }
                <li>
                    <form method="post" action="/auth/logout" class="phone-nav-menu__signout-form">
                        <AntiforgeryToken />
                        <AppNativeButton Type="submit" Class="@ItemClass(false)">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Logout" />
                            <span>@L["TopBar_SignOut"]</span>
                        </AppNativeButton>
                    </form>
                </li>
            </ul>
        </nav>
    </div>
</AppDialogFrame>

@code {
    // Full screen, no default header (the sheet has its own with the title and Close), Escape closes it; there is no backdrop to tap.
    private static readonly AppDialogOptions MenuOptions = new() { FullScreen = true, NoHeader = true, BackdropClick = false, CloseOnEscapeKey = true };

    /// <summary>The destinations, from <see cref="ShellNavigation.MenuLinks"/>.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ShellNavLink> Links { get; set; } = [];

    /// <summary>The current location, so the entry for the page the person is on is marked.</summary>
    [Parameter] public string CurrentPath { get; set; } = "/";

    /// <summary>Settings is offered when the active profile has it (not Kids).</summary>
    [Parameter] public bool ShowSettings { get; set; }

    /// <summary>Switch profile is offered when the household has more than one profile.</summary>
    [Parameter] public bool ShowSwitchProfile { get; set; }

    /// <summary>Pages plugins add that suit a phone (never the guide timeline).</summary>
    [Parameter] public IReadOnlyList<PluginMenuEntryDto> PluginEntries { get; set; } = [];

    /// <summary>Raised when the menu should close: its Close button, Escape, Back, or after an entry was chosen.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private IJSObjectReference? _module;
    private DotNetObjectReference<PhoneNavigationMenu>? _self;
    private bool _historyEntryHeld;

    private bool IsSettings => ShellNavigation.IsCurrent(ShellDock.SettingsPath, CurrentPath);

    private static string ItemClass(bool current) => current ? "phone-nav-menu__item is-current" : "phone-nav-menu__item";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/phone-nav-menu.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _self);
            _historyEntryHeld = true;
        }
        catch (JSDisconnectedException)
        {
            // The circuit closed while the menu opened; there is nothing left to close.
        }
        catch (JSException)
        {
            // Back-to-close is a nicety (for example a stale cached module); the Close button and Escape still work.
        }
    }

    /// <summary>Back removed the menu's history entry in the browser, so only the menu itself needs to close.</summary>
    [JSInvokable]
    public Task CloseFromBack()
    {
        _historyEntryHeld = false;
        return InvokeAsync(() => OnClose.InvokeAsync());
    }

    private async Task RequestCloseAsync()
    {
        await ReleaseHistoryEntryAsync();
        await OnClose.InvokeAsync();
    }

    // Take the menu's history entry off first so Back from the next page goes to this one, then navigate.
    private async Task NavigateAsync(string path)
    {
        await ReleaseHistoryEntryAsync();
        Nav.NavigateTo(path);
        await OnClose.InvokeAsync();
    }

    private async Task ReleaseHistoryEntryAsync()
    {
        if (!_historyEntryHeld || _module is null) return;
        _historyEntryHeld = false;
        try
        {
            await _module.InvokeVoidAsync("detach", true);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, so the browser has dropped the page and its history with it.
        }
        catch (JSException)
        {
            // The entry could not be removed; the browser keeps one extra Back step on this page, which is harmless.
        }
    }

    public async ValueTask DisposeAsync()
    {
        await ReleaseHistoryEntryAsync();
        _self?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone, so the browser has dropped the module with the page.
            }
        }
    }
}
