@inject IStringLocalizer<SharedStrings> L
<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal"
        aria-labelledby="components-reconnect-title"
        aria-describedby="components-reconnect-status"
        data-nosnippet>
    <div class="components-reconnect-container" aria-live="assertive">
        <h2 id="components-reconnect-title">@L["ReconnectModal_ConnectionToLibrary"]</h2>
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p id="components-reconnect-status" class="components-reconnect-first-attempt-visible">
            Connection lost. Reconnecting to your Library Engine&hellip;
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            @L["ReconnectModal_StillDisconnectedRetryingIn"] <span id="components-seconds-to-next-attempt"></span> seconds.
        </p>
        <p class="components-reconnect-failed-visible">
            @L["ReconnectModal_TheLibraryEngineIsStill"]
        </p>
        <AppNativeButton id="components-reconnect-button" Class="components-reconnect-failed-visible">
            @L["ReconnectModal_RetryConnection"]
        </AppNativeButton>
        <p class="components-pause-visible">
            @L["ReconnectModal_TheSessionHasBeenPaused"]
        </p>
        <p class="components-resume-failed-visible">
            @L["ReconnectModal_FailedToResumeTheSession"]<br />@L["ReconnectModal_PleaseRetryOrReloadThe"]
        </p>
        <AppNativeButton id="components-resume-button" Class="components-pause-visible components-resume-failed-visible">
            @L["Common_Resume"]
        </AppNativeButton>
    </div>
</dialog>
