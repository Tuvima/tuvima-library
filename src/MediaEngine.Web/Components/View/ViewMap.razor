@using MediaEngine.Contracts.LocalAssets
@inject IJSRuntime JS
@implements IAsyncDisposable
@namespace MediaEngine.Web.Components.View

<div class="@RootClass" role="group" aria-label="@AriaLabel">
    <div class="view-map__canvas" @ref="_container"></div>
    @if (!_ready && string.IsNullOrWhiteSpace(_error))
    {
        <div class="view-map__state" role="status"><MudProgressCircular Indeterminate="true" Size="Size.Small" /><span>Drawing the map…</span></div>
    }
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="view-map__state is-error" role="status"><MudIcon Icon="@Icons.Material.Outlined.Map" /><span>Map unavailable</span><small>@_error</small></div>
    }
</div>

@code {
    [Parameter] public string Mode { get; set; } = "location";
    [Parameter] public string AriaLabel { get; set; } = "Map";
    [Parameter] public string? Class { get; set; }
    [Parameter] public IReadOnlyList<ViewAtlasHotspotDto> Hotspots { get; set; } = [];
    [Parameter] public Func<ViewAtlasHotspotDto, string>? ThumbnailUrl { get; set; }
    [Parameter] public double? Latitude { get; set; }
    [Parameter] public double? Longitude { get; set; }
    [Parameter] public double Zoom { get; set; } = 11;
    [Parameter] public bool Editable { get; set; }
    [Parameter] public bool Interactive { get; set; } = true;
    [Parameter] public bool ShowNavigation { get; set; } = true;
    [Parameter] public bool JourneyEnabled { get; set; }
    [Parameter] public EventCallback<string> OnHotspotSelected { get; set; }
    [Parameter] public EventCallback<ViewMapCoordinate> OnCoordinateChanged { get; set; }
    [Parameter] public EventCallback<ViewMapCamera> OnCameraChanged { get; set; }
    private ElementReference _container;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ViewMap>? _reference;
    private bool _initialized, _ready, _updatePending;
    private string? _error;
    private string RootClass => $"view-map view-map--{Mode}{(string.IsNullOrWhiteSpace(Class) ? string.Empty : $" {Class}")}";

    protected override void OnParametersSet()
    {
        if (_initialized) _updatePending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_initialized)
        {
            _initialized = true;
            // Keep an explicit revision on this long-lived dynamic module. A
            // running Blazor session otherwise keeps the previous module in the
            // browser module cache after a Dashboard update.
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/view-map.js?v=20260926.2");
            _reference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("initialize", _container, _reference, new
            {
                mode = Mode,
                hotspots = HotspotModels(),
                latitude = Latitude,
                longitude = Longitude,
                zoom = Zoom,
                editable = Editable,
                interactive = Interactive,
                showNavigation = ShowNavigation,
                journeyEnabled = JourneyEnabled,
            });
            return;
        }
        if (_updatePending && _module is not null)
        {
            _updatePending = false;
            if (Mode == "atlas") { await _module.InvokeVoidAsync("updateHotspots", _container, HotspotModels()); await _module.InvokeVoidAsync("setJourney", _container, JourneyEnabled); }
            else if (Latitude.HasValue && Longitude.HasValue) await _module.InvokeVoidAsync("updateLocation", _container, Latitude.Value, Longitude.Value);
        }
    }

    private object[] HotspotModels() => Hotspots.Select(item => new
    {
        item.Key, item.Name, item.Latitude, item.Longitude, item.AssetCount,
        item.ImageCount, item.VideoCount, item.EarliestAt, item.LatestAt,
        ThumbnailUrl = ThumbnailUrl?.Invoke(item),
    }).Cast<object>().ToArray();

    public Task ResetWorldAsync() => _module?.InvokeVoidAsync("resetWorld", _container).AsTask() ?? Task.CompletedTask;
    public Task FitHotspotsAsync() => _module?.InvokeVoidAsync("fitHotspots", _container).AsTask() ?? Task.CompletedTask;
    public Task ZoomInAsync() => _module?.InvokeVoidAsync("zoomBy", _container, 1).AsTask() ?? Task.CompletedTask;
    public Task ZoomOutAsync() => _module?.InvokeVoidAsync("zoomBy", _container, -1).AsTask() ?? Task.CompletedTask;
    public Task ResizeAsync() => _module?.InvokeVoidAsync("resize", _container).AsTask() ?? Task.CompletedTask;

    [JSInvokable] public Task MapReady() { _ready = true; _error = null; return InvokeAsync(StateHasChanged); }
    [JSInvokable] public Task MapFailed(string message) { _error = message; _ready = false; return InvokeAsync(StateHasChanged); }
    [JSInvokable] public Task SelectHotspot(string key) => OnHotspotSelected.InvokeAsync(key);
    [JSInvokable] public Task CoordinateChanged(double latitude, double longitude) => OnCoordinateChanged.InvokeAsync(new(latitude, longitude));
    [JSInvokable] public Task CameraChanged(double latitude, double longitude, double zoom) => OnCameraChanged.InvokeAsync(new(latitude, longitude, zoom));

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _container); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _reference?.Dispose();
    }

    public sealed record ViewMapCoordinate(double Latitude, double Longitude);
    public sealed record ViewMapCamera(double Latitude, double Longitude, double Zoom);
}
