@namespace MediaEngine.Web.Components.View
@using MediaEngine.Contracts.LocalAssets
@using MediaEngine.Web.Components.Settings
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IStringLocalizer<SharedStrings> L

@* The Folders filter of a View kind's page (View folders spec D4b): All folders, or one folder by its friendly name with its Read-only or Managed tag. It is drawn only
   once the kind has two or more folders, and the choice is remembered for this profile in the browser. *@
@if (Folders.Count >= 2)
{
    <div class="view-folder-filter" data-folder-filter>
        <AppOverflowMenu ListWidth="true" Icon="@AppMaterialIcons.Outlined.FolderOpen" EndIcon="@AppMaterialIcons.Outlined.ExpandMore" Label="@ButtonLabel" AriaLabel="@L["ViewFolderFilter_Folders"].Value"
                         Size="AppControlSize.Compact">
            <AppMenuItem Label="@L["ViewFolderFilter_AllFolders"].Value" Checked="@(Chosen is null)" OnClick="@(() => ChangedAsync(null))" />
            @foreach (var folder in Folders)
            {
                var id = folder.Id.ToString("D");
                var managed = ViewFolderRules.IsManaged(folder);
                <AppMenuItem Checked="@(Chosen?.Id == folder.Id)" OnClick="@(() => ChangedAsync(id))">
                    <span class="view-folder-filter__name">@folder.Name</span>
                    <AppChip Class="view-folder-filter__tag" Text="@FolderHandlingWords.LabelFor(managed)" data-handling="@(managed ? "managed" : "read-only")" />
                </AppMenuItem>
            }
        </AppOverflowMenu>
    </div>
}

@code {
    /// <summary>The kind's folders (see <see cref="ViewFolderRules.OfKind"/>).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ViewSourceAdminDto> Folders { get; set; } = [];
    /// <summary>The kind the page shows, so each kind remembers its own choice.</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = string.Empty;
    /// <summary>The active profile, so each profile remembers its own choice.</summary>
    [Parameter] public Guid? ProfileId { get; set; }
    [Parameter] public Guid? Selected { get; set; }
    [Parameter] public EventCallback<Guid?> SelectedChanged { get; set; }

    private bool _restored;

    // The folder the filter is on, if it is still one of the kind's folders.
    private ViewSourceAdminDto? Chosen => Selected is { } id ? Folders.FirstOrDefault(folder => folder.Id == id) : null;

    // "Folders" while on All folders, "Folders: Holidays" once one is picked.
    private string ButtonLabel => Chosen is { } folder ? L["ViewFolderFilter_Button", folder.Name].Value : L["ViewFolderFilter_Folders"].Value;

    private string StorageKey => $"tuvima.view.folder.{Kind}.{ProfileId?.ToString("N") ?? "device"}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The remembered folder applies once, as soon as the folders are known; a folder that has gone is forgotten.
        if (_restored || Folders.Count < 2) return;
        _restored = true;
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            if (Guid.TryParse(stored, out var id) && Folders.Any(folder => folder.Id == id) && Selected != id)
            {
                await SelectedChanged.InvokeAsync(id);
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or OperationCanceledException)
        {
            // Storage is blocked or the circuit ended: the filter starts on All folders.
        }
    }

    private async Task ChangedAsync(string? value)
    {
        Guid? chosen = Guid.TryParse(value, out var id) && Folders.Any(folder => folder.Id == id) ? id : null;
        try
        {
            if (chosen is null) await JS.InvokeVoidAsync("localStorage.removeItem", StorageKey);
            else await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, chosen.Value.ToString("D"));
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or OperationCanceledException)
        {
            // Not remembered; the choice still applies to this visit.
        }

        await SelectedChanged.InvokeAsync(chosen);
    }
}
