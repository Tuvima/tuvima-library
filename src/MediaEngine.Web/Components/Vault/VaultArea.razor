@namespace MediaEngine.Web.Components.Vault
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Navigation
@implements IDisposable
@inject NsfwModeState Nsfw
@inject NavigationManager Nav
@inject IVaultCatalogue Catalogue
@inject DashboardSessionAccessor Session

@* The Vault area (Videos spec D16, D39, D45): the fourth top-level area. The shell is the Blur toggle, Search, the viewing options of
   D24 and the views of D39; Library settings sit inside it for administrators. The main page shows videos only: Recently added with
   its Matched/Unmatched chips, Scenes, Folders and the Unmatched list. Performers, Studios and Tags are lists of their own, reached
   from the views and never mixed into the main page; opening a performer, studio, tag or folder tile lists the scenes the person
   owns. It draws only while Vault mode is on; the page that hosts it sends everyone else to the same "not found" a missing page gets. *@
@if (Nsfw.Unlocked)
{
    <div class="vault-area" data-vault-area>
        <header class="vault-area__header">
            <h1 class="vault-area__title">Vault</h1>
            <div class="vault-area__tools">
                <VaultBlurToggle />
                <AppButton Label="Lock now" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact" OnClick="LockAsync" />
            </div>
        </header>

        <AppSearchField Label="Search the Vault" HideLabel="true" Placeholder="Search the Vault"
                        Value="@_query" ValueChanged="@(value => { _query = value ?? string.Empty; })" DebounceInterval="250" />
        <VaultSearchGroup Query="@_query" />

        <nav class="vault-area__views" aria-label="Vault views">
            <AppSegmentedControl Options="@ViewOptions" Value="@_view.Key" ValueChanged="OpenViewAsync" AriaLabel="Vault views" />
        </nav>

        @if (_view.Key == VaultViews.LibrarySettings)
        {
            <VaultLibrarySettings />
        }
        else
        {
            <VaultViewOptions />
            @if (_view.Key == VaultViews.RecentlyAdded && !HasTile)
            {
                <div class="vault-area__chips" role="group" aria-label="Filter">
                    <AppSegmentedControl Options="@MatchFilters" Value="@_match" ValueChanged="ChangeMatchAsync" AriaLabel="Matched or unmatched" Size="AppControlSize.Compact" />
                    <AppSegmentedControl Options="@KindFilters" Value="@_kind" ValueChanged="ChangeKindAsync" AriaLabel="Videos or images" Size="AppControlSize.Compact" />
                </div>
            }

            @if (HasTile)
            {
                <div class="vault-area__tile-head">
                    <a class="vault-area__back" href="@VaultViews.Route(_view.Key)">‹ @_view.Label</a>
                    @if (TileHeading is { Length: > 0 } heading)
                    {
                        <h2 class="vault-area__heading @(Nsfw.Preferences.TitlesHiddenUntilPointed ? "vault-area__heading--hidden" : null)">@heading</h2>
                    }
                </div>
            }

            @if (_view.Key == "images")
            {
                @* The Images view lists the galleries (a gallery for every folder of images, then hand-made and rule galleries); a
                   gallery's own page can edit or delete a hand-made or rule gallery. *@
                <VaultGalleryTools GalleryId="@(HasTile ? Id : null)" IsAdministrator="@IsAdministrator" OnChanged="ReloadAsync" />
            }

            @if (_items is null)
            {
                <AppSkeleton Height="160px" />
            }
            else if (!_supported)
            {
                <AppEmptyState Title="The Vault could not be read" Message="Try again in a moment. If this keeps happening, lock the Vault and unlock it again." />
            }
            else if (_items.Count == 0)
            {
                <AppEmptyState Title="@($"Nothing in {(HasTile ? "this list" : _view.Label)} yet")"
                               Message="@EmptyMessage" />
            }
            else if (_view.Key == "unmatched" && !HasTile)
            {
                <VaultUnmatchedList Items="@_items" TitlesHidden="@Nsfw.Preferences.TitlesHiddenUntilPointed"
                                    IsAdministrator="@IsAdministrator" OnMatched="ReloadAsync" />
            }
            else
            {
                <VaultItemList Items="@_items" Layout="@Nsfw.Preferences.Layout" GroupBy="@Nsfw.Preferences.GroupBy"
                               Mode="@Nsfw.EffectiveCovers" TitlesHidden="@Nsfw.Preferences.TitlesHiddenUntilPointed"
                               IsAdministrator="@IsAdministrator" OnImageChanged="ReloadAsync" />
            }

            @if (_items is not null && (_items.Count < _total || _cursor is not null))
            {
                <div class="vault-area__more">
                    <AppButton Label="Show more" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" OnClick="ShowMoreAsync" />
                </div>
            }
        }
    </div>
}

@code {
    private VaultView _view = VaultViews.All[0];
    private List<VaultCatalogueItem>? _items;
    private bool _supported = true;
    private int _total;
    private string? _heading;
    private string _query = string.Empty;
    private string _match = "all";
    private string _kind = "all";
    private string? _loadedKey;
    private string? _cursor;
    private int _version;

    private static readonly IReadOnlyList<AppSelectOption> MatchFilters =
        [new("all", "All"), new("matched", "Matched"), new("unmatched", "Unmatched")];

    private static readonly IReadOnlyList<AppSelectOption> KindFilters =
        [new("all", "Videos and images"), new("videos", "Videos"), new("images", "Images")];

    /// <summary>The view named in the address (<c>/vault/{view}</c>); the default when none.</summary>
    [Parameter] public string? View { get; set; }

    /// <summary>A performer, studio or tag id (or a folder's id) named in the address (<c>/vault/performers/{id}</c>): the scenes of that name are listed.</summary>
    [Parameter] public string? Id { get; set; }

    private bool IsAdministrator => Session.Authority?.EffectiveAdministrator == true;

    private bool HasTile => !string.IsNullOrEmpty(Id) && VaultViews.OpensToScenes(_view.Key);

    private string? TileHeading => _heading ?? (_view.Key == "images" ? ImagesHeading : _items?.FirstOrDefault()?.Folder);

    // A gallery's page is headed by "All images" or its own name (the gallery tile that opened it carries the name in the list before).
    private string? ImagesHeading => Id == VaultViews.AllImages ? "All images" : null;

    private IReadOnlyList<AppSelectOption> ViewOptions =>
        [.. VaultViews.For(IsAdministrator).Select(view => new AppSelectOption(view.Key, view.Label))];

    private string EmptyMessage => _view.Key switch
    {
        "performers" when !HasTile => "Performers appear here once a matched video has some, and only while you own one of their scenes.",
        "studios" when !HasTile => "Studios appear here once a matched video has one, and only while you own one of their scenes.",
        "tags" when !HasTile => "Tags appear here once a matched video brings some back.",
        "unmatched" => "Videos the Library could not match with confidence appear here. Nothing is lost: you can identify them by hand.",
        "images" when HasTile => "This gallery has no images yet.",
        "images" => "Images appear here once a Vault folder with images has been added and scanned.",
        _ when IsAdministrator && !_supported => "Items appear here once a Vault folder has been added and scanned. Library settings holds the Vault's own settings.",
        _ => "Items appear here once a Vault folder has been added and scanned.",
    };

    private string LoadKey =>
        $"{_view.Key}|{Id}|{_match}|{_kind}|{Nsfw.Preferences.Sort}|{Nsfw.Preferences.HoverStills}";

    protected override void OnInitialized() => Nsfw.Changed += OnChanged;

    protected override async Task OnParametersSetAsync()
    {
        var previous = _view.Key;
        _view = VaultViews.Resolve(View, IsAdministrator) ?? VaultViews.All[0];
        if (previous != _view.Key)
        {
            // Another view starts from its own defaults.
            _match = "all";
            _kind = "all";
        }

        await EnsureLoadedAsync();
    }

    private async Task EnsureLoadedAsync()
    {
        if (!Nsfw.Unlocked || _view.Key == VaultViews.LibrarySettings)
        {
            return;
        }

        var key = LoadKey;
        if (_loadedKey == key)
        {
            return;
        }

        _loadedKey = key;
        _items = null;
        await LoadAsync(skip: 0, append: false);
    }

    private async Task LoadAsync(int skip, bool append)
    {
        var version = ++_version;
        var filter = FilterFor(skip, append);
        var result = await Catalogue.ListAsync(_view.Key, Nsfw.Preferences, filter);
        if (version != _version)
        {
            return;
        }

        _supported = result.Supported;
        _total = result.Total;
        _cursor = result.NextCursor;
        _heading = result.Heading;
        if (!append)
        {
            _items = [.. result.Items];
        }
        else
        {
            _items = [.. _items ?? [], .. result.Items];
        }

        StateHasChanged();
    }

    private VaultListFilter FilterFor(int skip, bool append)
    {
        var filter = new VaultListFilter { Match = _match, Kind = _kind, Skip = skip, Take = EngineVaultCatalogue.DefaultPageSize, Cursor = append ? _cursor : null };
        if (!HasTile)
        {
            return filter;
        }

        return _view.Key switch
        {
            "images" => filter with { ImageGallery = Id },
            "performers" when Guid.TryParse(Id, out var performer) => filter with { PerformerId = performer },
            "studios" when Guid.TryParse(Id, out var studio) => filter with { StudioId = studio },
            "tags" when Guid.TryParse(Id, out var tag) => filter with { TagId = tag },
            "folders" => filter with { FolderId = Id },
            _ => filter,
        };
    }

    // Images page by cursor and videos by count; asking for the next page sends whichever the last answer gave.
    // Recently added puts its newest images among the first page of videos, so only the videos count towards the skip.
    private Task ShowMoreAsync() => LoadAsync(_items?.Count(item => item.ImageId is null) ?? 0, append: true);

    private Task ReloadAsync()
    {
        _loadedKey = null;
        return EnsureLoadedAsync();
    }

    private Task ChangeMatchAsync(string value)
    {
        _match = value;
        return EnsureLoadedAsync();
    }

    private Task ChangeKindAsync(string value)
    {
        _kind = value;
        return EnsureLoadedAsync();
    }

    // Changed options (the sort, the optional hover stills) read the list again; the layout and covers only redraw it.
    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        if (!Nsfw.Unlocked)
        {
            // Locked: nothing from the Vault stays in memory behind the closed screen.
            _items = null;
            _loadedKey = null;
            _version++;
        }
        else
        {
            await EnsureLoadedAsync();
        }

        StateHasChanged();
    });

    private Task OpenViewAsync(string key)
    {
        Nav.NavigateTo(VaultViews.Route(key));
        return Task.CompletedTask;
    }

    private async Task LockAsync()
    {
        await Nsfw.LockAsync();
        VaultExit.Leave(Nav, VaultExit.Home);
    }

    public void Dispose() => Nsfw.Changed -= OnChanged;
}
