@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Theming
@using MediaEngine.Web.Services.Vault
@namespace MediaEngine.Web.Components.Vault
@inject DeviceContextService Device

@* The Unmatched list (Videos spec D40): a plain sortable list of title, file name, length, size and date added. Each row opens the
   video's own page, and an administrator on a computer also gets an Identify link that opens the Identify panel under the row. Nothing
   is hidden or queued just for being unmatched. *@
<div class="vault-unmatched" role="table" aria-label="Unmatched videos">
    <div class="vault-unmatched__head" role="row">
        @foreach (var column in Columns)
        {
            <span role="columnheader" aria-sort="@AriaSort(column.Key)">
                <AppButton ButtonStyle="AppButtonStyle.Text" Class="vault-unmatched__sort" OnClick="() => SortBy(column.Key)">@column.Label@SortMark(column.Key)</AppButton>
            </span>
        }
        <span role="columnheader" class="vault-unmatched__actions-head">Actions</span>
    </div>
    @foreach (var item in Sorted)
    {
        <div @key="item.Id" class="vault-unmatched__row" role="row">
            <a role="cell" class="vault-unmatched__title @(TitlesHidden ? "vault-unmatched__title--hidden" : null)" href="@item.Route"
               aria-label="@(TitlesHidden ? "Open item" : item.Title)">@item.Title</a>
            <span role="cell" class="vault-unmatched__muted vault-unmatched__file @(TitlesHidden ? "vault-unmatched__title--hidden" : null)">@item.FileName</span>
            <span role="cell" class="vault-unmatched__muted">@VaultFormat.Duration(item.DurationSeconds)</span>
            <span role="cell" class="vault-unmatched__muted">@VaultFormat.Size(item.SizeBytes)</span>
            <span role="cell" class="vault-unmatched__muted">@VaultFormat.Date(item.AddedAt)</span>
            <span role="cell" class="vault-unmatched__actions">
                @if (CanIdentify && item.AssetId is not null)
                {
                    <AppButton Label="Identify" ButtonStyle="AppButtonStyle.Outlined" Class="vault-unmatched__identify" aria-expanded="@((_open == item.AssetId).ToString().ToLowerInvariant())" OnClick="() => Toggle(item.AssetId.Value)" />
                }
            </span>
            @if (CanIdentify && item.AssetId is { } assetId && _open == assetId)
            {
                <div class="vault-unmatched__panel">
                    <VaultIdentifyPanel AssetId="@assetId" OnApplied="OnIdentified" />
                </div>
            }
        </div>
    }
</div>

@code {
    private static readonly (string Key, string Label)[] Columns =
        [("title", "Title"), ("file", "File name"), ("length", "Length"), ("size", "Size"), ("added", "Added")];

    private string _sort = "added";
    private bool _descending = true;
    private Guid? _open;

    [Parameter, EditorRequired] public IReadOnlyList<VaultCatalogueItem> Items { get; set; } = [];
    [Parameter] public bool TitlesHidden { get; set; }

    /// <summary>True for an administrator (the Engine only lets one apply a match); the panel also needs a computer, like every editor.</summary>
    [Parameter] public bool IsAdministrator { get; set; }

    /// <summary>Raised after Identify applied fields, so the list can be read again (the video is then matched and leaves this list).</summary>
    [Parameter] public EventCallback OnMatched { get; set; }

    private bool CanIdentify => IsAdministrator && EditorDeviceRule.CanEdit(Device);

    private IEnumerable<VaultCatalogueItem> Sorted
    {
        get
        {
            Func<VaultCatalogueItem, object?> key = _sort switch
            {
                "title" => item => item.Title.ToUpperInvariant(),
                "file" => item => (item.FileName ?? string.Empty).ToUpperInvariant(),
                "length" => item => item.DurationSeconds ?? -1,
                "size" => item => item.SizeBytes ?? -1,
                _ => item => item.AddedAt ?? DateTimeOffset.MinValue,
            };
            return _descending ? Items.OrderByDescending(key) : Items.OrderBy(key);
        }
    }

    private void SortBy(string column)
    {
        _descending = _sort == column ? !_descending : column is "added" or "length" or "size";
        _sort = column;
    }

    private string AriaSort(string column) => _sort != column ? "none" : _descending ? "descending" : "ascending";

    private string SortMark(string column) => _sort != column ? string.Empty : _descending ? " ↓" : " ↑";

    private void Toggle(Guid assetId) => _open = _open == assetId ? null : assetId;

    private Task OnIdentified()
    {
        _open = null;
        return OnMatched.InvokeAsync();
    }
}
