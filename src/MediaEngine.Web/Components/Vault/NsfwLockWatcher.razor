@namespace MediaEngine.Web.Components.Vault
@implements IAsyncDisposable
@inject NsfwModeState Nsfw
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<NsfwLockWatcher> Logger

@* Draws nothing. It keeps the Dashboard's NSFW mode in step with the Engine for the shell: it asks the Engine's status route for
   the active profile (a Kids profile is never asked), and only while NSFW mode is on does it load the script that locks on a
   double Escape and restarts the idle timer. When NSFW mode is off for any reason it sends the person Home if they were in the
   Vault, so switching profile or locking never leaves the area on screen. *@

@code {
    private DotNetObjectReference<NsfwLockWatcher>? _self;
    private IJSObjectReference? _module;
    private Guid? _loadedFor;
    private bool _loadedKids;
    private bool _watching;
    private bool _disposed;

    /// <summary>The profile that is signed in on this device; null until the shell has loaded it.</summary>
    [Parameter] public Guid? ActiveProfileId { get; set; }

    /// <summary>True for a Kids profile: the Engine is never asked.</summary>
    [Parameter] public bool IsKids { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == ActiveProfileId && _loadedKids == IsKids)
        {
            return;
        }

        _loadedFor = ActiveProfileId;
        _loadedKids = IsKids;
        await Nsfw.RefreshAsync(ActiveProfileId, IsKids);
    }

    protected override void OnInitialized() => Nsfw.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender) => await SyncWatchingAsync();

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed)
        {
            return;
        }

        await SyncWatchingAsync();
        if (!Nsfw.Unlocked && InVault(Nav.ToBaseRelativePath(Nav.Uri)))
        {
            VaultExit.Leave(Nav, VaultExit.Home);
        }
    });

    private static bool InVault(string relativePath) =>
        relativePath.Equals("vault", StringComparison.OrdinalIgnoreCase)
        || relativePath.StartsWith("vault/", StringComparison.OrdinalIgnoreCase);

    // The script is loaded only while NSFW mode is on, and let go of as soon as it is off.
    private async Task SyncWatchingAsync()
    {
        try
        {
            if (Nsfw.Unlocked && !_watching && !_disposed)
            {
                _self ??= DotNetObjectReference.Create(this);
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/vault-lock.js");
                await _module.InvokeVoidAsync("start", _self);
                _watching = true;
            }
            else if (!Nsfw.Unlocked && _watching && _module is not null)
            {
                await _module.InvokeVoidAsync("stop");
                _watching = false;
            }
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or InvalidOperationException)
        {
            Logger.LogDebug(exception, "Could not change the NSFW lock shortcut.");
        }
    }

    /// <summary>Escape pressed twice: lock at once and go Home.</summary>
    [JSInvokable]
    public Task OnDoubleEscape() => InvokeAsync(async () =>
    {
        if (_disposed || !Nsfw.Unlocked)
        {
            return;
        }

        await Nsfw.LockAsync();
        VaultExit.Leave(Nav, VaultExit.Home);
    });

    /// <summary>The person is using the page: restart the Engine's idle timer.</summary>
    [JSInvokable]
    public Task OnActivity() => InvokeAsync(async () =>
    {
        if (!_disposed)
        {
            await Nsfw.KeepAliveAsync();
        }
    });

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Nsfw.Changed -= OnChanged;
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or InvalidOperationException)
        {
            Logger.LogDebug(exception, "Could not release the NSFW lock shortcut.");
        }

        _self?.Dispose();
    }
}
