@using MediaEngine.Contracts.Authentication
@using MediaEngine.Web.Services.Configuration
<!DOCTYPE html>
<html lang="en" translate="no">

<head>
    <meta charset="utf-8" />
    <meta name="google" content="notranslate" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0B1020" />
    <meta name="description" content="Browse, read, watch and listen to your local Tuvima Library." />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Tuvima Library" />
    <base href="/" />
    <ResourcePreloader />
    <link href="/vendor/maplibre/maplibre-gl.css" rel="stylesheet" />
    <!-- App styles -->
    <link rel="stylesheet" href="@Assets["native-utilities.css"]" />
    <link rel="stylesheet" href="@Assets["native-structure.css"]" />
    <link rel="stylesheet" href="@Assets["native-fields.css"]" />
    <link rel="stylesheet" href="@Assets["tuvima.tokens.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MediaEngine.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="icons/tuvima-192.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" ClientIngress="@Ingress" ClientAddress="@Address" />
    <ReconnectModal />
    <script src="@Assets["vendor/hls/hls.min.js"]"></script>
    <script src="@Assets["app.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="js/lazy-load.js"></script>
    <script src="js/cover-popup.js"></script>
</body>

</html>

@code {
    // Classified here, where the real connection is visible. Blazor protects root-component parameters, so the
    // browser cannot change this value on its way into the interactive circuit.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string Ingress => HttpContext?.ClientIngress() ?? ClientIngressValues.Remote;

    // The connection address, classified and limited by the Dashboard (never read from a browser header).
    private string? Address => HttpContext?.Connection.RemoteIpAddress?.ToString();
}
