@namespace MediaEngine.Web.Components.MediaHub
@inject IStringLocalizer<SharedStrings> L

<div class="shelf-header">
    <div class="shelf-header__copy">
        <h2>@Title</h2>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p>@Subtitle</p>
        }
    </div>

    @if (Count is > 0)
    {
        <span class="shelf-header__count">@Count</span>
    }

    @if (!string.IsNullOrWhiteSpace(Route))
    {
        <a href="@Route" class="shelf-header__link">@L["Common_ViewAll"]</a>
    }

    @if (!string.IsNullOrEmpty(LanePlace) && !string.IsNullOrEmpty(ShelfKey))
    {
        <LaneMenu ShelfKey="@ShelfKey" Place="@LanePlace" Title="@Title" OnHidden="OnLaneHidden" />
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public int? Count { get; set; }
    [Parameter] public string? Route { get; set; }
    /// <summary>The shelf key and the page it is on (watch, read, listen); together they give a collection lane its "Hide this lane" menu.</summary>
    [Parameter] public string? ShelfKey { get; set; }
    [Parameter] public string? LanePlace { get; set; }
    [Parameter] public EventCallback<string> OnLaneHidden { get; set; }
}
