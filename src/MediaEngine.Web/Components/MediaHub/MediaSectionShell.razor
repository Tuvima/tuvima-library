@namespace MediaEngine.Web.Components.MediaHub
@using MediaEngine.Web.Models.ViewDTOs
@using Microsoft.AspNetCore.Components.Routing
@using MediaEngine.Web.Services.Navigation
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IAppDialogService Dialogs
@inject IStringLocalizer<SharedStrings> L

<div class="@ShellCssClass" @onkeydown="HandleShellKey">
    @if (ShowMobileNavigation)
    {
    <nav class="media-section-shell__mobile-nav" aria-label="@($"{Title} mobile navigation")">
        <details>
            <summary>
                <span>
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Menu" aria-hidden="true" />
                    <span>@MobileActiveLabel</span>
                </span>
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ExpandMore" aria-hidden="true" />
            </summary>
            <div class="media-section-shell__mobile-nav-panel">
                @NavigationHeader
                @foreach (var group in NavigationGroups)
                {
                    <section aria-labelledby="@($"{GroupId(group)}-mobile")">
                        <div id="@($"{GroupId(group)}-mobile")" class="media-section-shell__mobile-nav-label">@group.Label</div>
                        @foreach (var item in group.Items)
                        {
                            <a href="@item.Route"
                               class="media-section-shell__mobile-nav-link @(IsOwnRouteActive(item, forceExact: true) ? "is-active" : null)"
                               aria-current="@(IsOwnRouteActive(item, forceExact: true) ? "page" : null)">
                                <AppMaterialIcon Icon="@item.Icon" aria-hidden="true" />
                                <span>@item.Label</span>
                                @if (!string.IsNullOrWhiteSpace(item.Meta))
                                {
                                    <small>@item.Meta</small>
                                }
                            </a>
                            @if (HasChildren(item))
                            {
                                @foreach (var child in item.Children!)
                                {
                                    <a href="@child.Route"
                                       class="media-section-shell__mobile-nav-link is-child @(IsActive(child) ? "is-active" : null)"
                                       aria-current="@(IsActive(child) ? "page" : null)">
                                        <span aria-hidden="true" class="media-section-shell__mobile-nav-marker"></span>
                                        <span>@child.Label</span>
                                        @if (!string.IsNullOrWhiteSpace(child.Meta))
                                        {
                                            <small>@child.Meta</small>
                                        }
                                    </a>
                                }
                            }
                        }
                    </section>
                }
            </div>
        </details>
    </nav>
    }
    <aside class="media-section-shell__rail" aria-label="@($"{Title} navigation")">
        @NavigationHeader
        @foreach (var group in NavigationGroups)
        {
            <section class="media-section-shell__rail-group @(IsFlatTree ? "is-flat" : null)" aria-labelledby="@GroupId(group)">
                <div class="media-section-shell__rail-heading"
                     @ondragover:preventDefault="@(group.CreateOptions?.ManualDropTarget is not null)"
                     @ondrop:preventDefault="@(group.CreateOptions?.ManualDropTarget is not null)"
                     @ondrop="@(() => DropOnCreateGroupAsync(group))">
                    <div id="@GroupId(group)" class="media-section-shell__rail-label">@group.Label</div>
                    @if (group.CreateOptions is { OpensCollectionFlow: true } flowOptions)
                    {
                        <AppIconButton Icon="@AppMaterialIcons.Outlined.Add"
                                       AriaLabel="@($"Create in {group.Label}")"
                                       Tooltip="@flowOptions.ManualLabel"
                                       Size="AppControlSize.Compact"
                                       Class="media-section-shell__flow-add"
                                       OnClick="@(() => BeginSmartCreateAsync(group))" />
                    }
                    else if (group.CreateOptions is { } createOptions)
                    {
                        <AppOverflowMenu Icon="@AppMaterialIcons.Outlined.Add"
                                         AriaLabel="@($"Create in {group.Label}")"
                                         Size="AppControlSize.Compact"
                                         Class="media-section-shell__create-menu">
                            <AppMenuItem Label="@createOptions.ManualLabel"
                                         Icon="@AppMaterialIcons.Outlined.Add"
                                         OnClick="@(() => BeginManualCreateAsync(group))" />
                            <AppMenuItem Label="@createOptions.SmartLabel"
                                         Icon="@AppMaterialIcons.Outlined.AutoAwesome"
                                         OnClick="@(() => BeginSmartCreateAsync(group))" />
                        </AppOverflowMenu>
                    }
                </div>
                @if (IsCreating(group))
                {
                    <div class="media-section-shell__inline-create">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Add" />
                        <AppNativeInput @ref="_createInput"
                                        Value="@_createName"
                                        ValueChanged="OnCreateNameChanged"
                                        OnKeyDown="HandleCreateKeyDownAsync"
                                        Placeholder="@group.CreateOptions!.InputPlaceholder"
                                        AriaLabel="@group.CreateOptions.InputPlaceholder"
                                        Disabled="@_creating" />
                        @if (_creating)
                        {
                            <AppSpinner Indeterminate="true" Size="AppSize.Small" />
                        }
                    </div>
                }
                @if (FixedColumnTree)
                {
                    <div class="media-section-shell__tree @(IsFlatTree ? "media-section-shell__tree--flat" : null)">
                        @foreach (var item in group.Items)
                        {
                            @RenderTreeNode(item, 0)
                        }
                    </div>
                }
                else
                {
                @foreach (var item in Ordered(group.Items))
                {
                    if (HasChildren(item))
                    {
                        var active = IsActive(item);
                        var expanded = IsExpanded(item);
                        <div @key="item.Route" class="media-section-shell__rail-branch @(active ? "is-active" : null) @(expanded ? "is-expanded" : null)">
                            <div class="media-section-shell__rail-parent-row"
                                 @ondragenter="@(() => ExpandDropBranch(item))"
                                 @ondragover:preventDefault="@(item.DropTarget is not null)"
                                 @ondrop:preventDefault="@(item.DropTarget is not null)"
                                 @ondrop="@(() => DropOnNavigationItemAsync(item))">
                                <a id="@ItemId(item)"
                                   href="@item.Route"
                                   class="media-section-shell__rail-item media-section-shell__rail-item--parent @(IsParentRouteCurrent(item) ? "is-active" : active ? "is-branch-active" : null) @(DropClass(item))"
                                   aria-current="@(IsParentRouteCurrent(item) ? "page" : null)"
                                   @onclick="@(() => NavigateBranch(item))"
                                   @onclick:preventDefault="true">
                                    <AppMaterialIcon Icon="@item.Icon" />
                                    <span>@item.Label</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Meta))
                                    {
                                        <span class="media-section-shell__rail-meta @(item.MetaIsNotification ? "media-section-shell__rail-meta--notification" : null)"
                                              aria-label="@item.MetaAriaLabel">@item.Meta</span>
                                    }
                                </a>
                                <AppNativeButton Type="button"
                                                 Class="media-section-shell__rail-chevron-button"
                                                 AriaLabel="@(expanded ? $"Collapse {item.Label}" : $"Expand {item.Label}")"
                                                 aria-expanded="@(expanded ? "true" : "false")"
                                                 aria-controls="@ChildrenId(item)"
                                                 OnClick="@(_ => ToggleBranch(item))">
                                    <AppMaterialIcon Icon="@(expanded ? AppMaterialIcons.Outlined.ExpandLess : AppMaterialIcons.Outlined.ExpandMore)"
                                             Class="media-section-shell__rail-chevron"
                                             aria-hidden="true" />
                                </AppNativeButton>
                            </div>

                            @if (expanded)
                            {
                                <div id="@ChildrenId(item)" class="media-section-shell__rail-children" role="group" aria-label="@($"{item.Label} subsections")">
                                    @foreach (var child in Ordered(item.Children!))
                                    {
                                        var childActive = IsActive(child);
                                        @if (child.Management is { } management)
                                        {
                                            <div @key="child.Route"
                                                 class="@ManagedRowClass(child)"
                                                 @onpointerdown="@(args => BeginSwipe(child, args))"
                                                 @onpointermove="@(args => TrackSwipe(child, args))"
                                                 @onpointerup="@(args => EndSwipe(child, args))"
                                                 @onpointercancel="@(args => EndSwipe(child, args))"
                                                 @ondragover:preventDefault="@(child.DropTarget is not null || _reorderingItem is not null)"
                                                 @ondrop:preventDefault="@(child.DropTarget is not null || _reorderingItem is not null)"
                                                 @ondrop="@(() => DropOnManagedItemAsync(child))">
                                                <div class="media-section-shell__swipe-actions" aria-hidden="@(_swipedRoute == child.Route ? "false" : "true")">
                                                    @if (management.CanRename && !InReorder(management))
                                                    {
                                                        <AppNativeButton Type="button" Class="is-rename" AriaLabel="@($"Rename {child.Label}")" OnClick="@(_ => BeginRename(child))">@L["Common_Rename"]</AppNativeButton>
                                                    }
                                                    @if (management.CanDelete && !InReorder(management))
                                                    {
                                                        <AppNativeButton Type="button" Class="is-delete" AriaLabel="@($"Delete {child.Label}")" OnClick="@(_ => BeginDelete(child))">@L["Common_Delete"]</AppNativeButton>
                                                    }
                                                </div>
                                                <div class="media-section-shell__managed-main">
                                                    @if (_renameRoute == child.Route)
                                                    {
                                                        <div class="media-section-shell__rename-row">
                                                            <AppNativeInput @ref="_renameInput"
                                                                            Value="@_renameName"
                                                                            ValueChanged="OnRenameNameChanged"
                                                                            OnKeyDown="@(args => HandleRenameKeyDownAsync(child, args))"
                                                                            AriaLabel="@($"Rename {child.Label}")"
                                                                            Disabled="@_managing" />
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        @if (management.CanReorder && InReorder(management))
                                                        {
                                                            <AppNativeButton Type="button"
                                                                             Class="media-section-shell__drag-handle"
                                                                             draggable="true"
                                                                             AriaLabel="@($"Drag to reorder {child.Label}")"
                                                                             @ondragstart="@(() => BeginReorder(child))"
                                                                             @ondragend="EndReorder"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.DragIndicator" /></AppNativeButton>
                                                        }
                                                        <a id="@ItemId(child)"
                                                           href="@child.Route"
                                                           class="media-section-shell__rail-item media-section-shell__rail-item--managed @(childActive ? "is-active" : null) @(DropClass(child))"
                                                           @onclick="@(() => NavigateManagedItem(child))"
                                                           @onclick:preventDefault="true"
                                                           aria-current="@(childActive ? "page" : null)">
                                                            <AppMaterialIcon Icon="@child.Icon" />
                                                            <span>@child.Label</span>
                                                            @if (management.IsSmart)
                                                            {
                                                                <AppChip Text="@L["Common_Smart"].Value" Title="@L["MediaSectionShell_SmartMembershipIsControlledBy"].Value" />
                                                            }
                                                            else if (!string.IsNullOrWhiteSpace(child.Meta))
                                                            {
                                                                <span class="media-section-shell__rail-meta @(child.MetaIsNotification ? "media-section-shell__rail-meta--notification" : null)"
                                                                      aria-label="@child.MetaAriaLabel">@child.Meta</span>
                                                            }
                                                        </a>
                                                        <AppOverflowMenu Icon="@AppMaterialIcons.Outlined.MoreVert" AriaLabel="@($"Manage {child.Label}")" Size="AppControlSize.Compact" Class="media-section-shell__manage-menu">
                                                            @if (management.CanRename && !InReorder(management))
                                                            {
                                                                <AppMenuItem Label="@L["Common_Rename"].Value" Icon="@AppMaterialIcons.Outlined.DriveFileRenameOutline" OnClick="@(() => BeginRename(child))" />
                                                            }
                                                            @if (management.CanReorder && !InReorder(management))
                                                            {
                                                                <AppMenuItem Label="@L["AppReorderBar_MenuReorder"].Value" Icon="@AppMaterialIcons.Outlined.SwapVert" OnClick="@(() => BeginReorderMode(child))" />
                                                            }
                                                            @if (management.CanReorder && InReorder(management))
                                                            {
                                                                <AppMenuItem Label="@L["Common_MoveUp"].Value" Icon="@AppMaterialIcons.Outlined.KeyboardArrowUp" OnClick="@(() => MoveManagedItemAsync(child, -1))" />
                                                                <AppMenuItem Label="@L["Common_MoveDown"].Value" Icon="@AppMaterialIcons.Outlined.KeyboardArrowDown" OnClick="@(() => MoveManagedItemAsync(child, 1))" />
                                                            }
                                                            @if (management.CanDelete && !InReorder(management))
                                                            {
                                                                <AppMenuItem Label="@L["Common_Delete"].Value" Icon="@AppMaterialIcons.Outlined.DeleteOutline" Tone="AppUiTone.Error" DividerBefore="true" OnClick="@(() => BeginDelete(child))" />
                                                            }
                                                        </AppOverflowMenu>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <a @key="child.Route"
                                               id="@ItemId(child)"
                                               href="@child.Route"
                                               class="media-section-shell__rail-item media-section-shell__rail-item--child @(childActive ? "is-active" : null) @(SectionBreakClass(child)) @(DropClass(child))"
                                               @ondragover:preventDefault="@(child.DropTarget is not null)"
                                               @ondrop:preventDefault="@(child.DropTarget is not null)"
                                               @ondrop="@(() => DropOnNavigationItemAsync(child))"
                                               aria-current="@(childActive ? "page" : null)">
                                                <span class="media-section-shell__rail-child-marker" aria-hidden="true"></span>
                                                <span>@child.Label</span>
                                                @if (!string.IsNullOrWhiteSpace(child.Meta))
                                                {
                                                    <span class="media-section-shell__rail-meta @(child.MetaIsNotification ? "media-section-shell__rail-meta--notification" : null)"
                                                          aria-label="@child.MetaAriaLabel">@child.Meta</span>
                                                }
                                            </a>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (item.Management is { } management)
                    {
                        var active = IsActive(item);
                        <div @key="item.Route"
                             class="@ManagedRowClass(item)"
                             @onpointerdown="@(args => BeginSwipe(item, args))"
                             @onpointermove="@(args => TrackSwipe(item, args))"
                             @onpointerup="@(args => EndSwipe(item, args))"
                             @onpointercancel="@(args => EndSwipe(item, args))"
                             @ondragover:preventDefault="@(item.DropTarget is not null || _reorderingItem is not null)"
                             @ondrop:preventDefault="@(item.DropTarget is not null || _reorderingItem is not null)"
                             @ondrop="@(() => DropOnManagedItemAsync(item))">
                            <div class="media-section-shell__swipe-actions" aria-hidden="@(_swipedRoute == item.Route ? "false" : "true")">
                                @if (management.CanRename && !InReorder(management))
                                {
                                    <AppNativeButton Type="button" Class="is-rename" AriaLabel="@($"Rename {item.Label}")" OnClick="@(_ => BeginRename(item))">@L["Common_Rename"]</AppNativeButton>
                                }
                                @if (management.CanDelete && !InReorder(management))
                                {
                                    <AppNativeButton Type="button" Class="is-delete" AriaLabel="@($"Delete {item.Label}")" OnClick="@(_ => BeginDelete(item))">@L["Common_Delete"]</AppNativeButton>
                                }
                            </div>
                            <div class="media-section-shell__managed-main">
                                @if (_renameRoute == item.Route)
                                {
                                    <div class="media-section-shell__rename-row">
                                        <AppNativeInput @ref="_renameInput"
                                                        Value="@_renameName"
                                                        ValueChanged="OnRenameNameChanged"
                                                        OnKeyDown="@(args => HandleRenameKeyDownAsync(item, args))"
                                                        AriaLabel="@($"Rename {item.Label}")"
                                                        Disabled="@_managing" />
                                    </div>
                                }
                                else
                                {
                                    @if (management.CanReorder && InReorder(management))
                                    {
                                        <AppNativeButton Type="button"
                                                         Class="media-section-shell__drag-handle"
                                                         draggable="true"
                                                         AriaLabel="@($"Drag to reorder {item.Label}")"
                                                         @ondragstart="@(() => BeginReorder(item))"
                                                         @ondragend="EndReorder"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.DragIndicator" /></AppNativeButton>
                                    }
                                    <a id="@ItemId(item)"
                                       href="@item.Route"
                                       class="media-section-shell__rail-item media-section-shell__rail-item--managed @(active ? "is-active" : null) @(DropClass(item))"
                                       @onclick="@(() => NavigateManagedItem(item))"
                                       @onclick:preventDefault="true"
                                       aria-current="@(active ? "page" : null)">
                                        <AppMaterialIcon Icon="@item.Icon" />
                                        <span>@item.Label</span>
                                        @if (management.IsSmart)
                                        {
                                            <AppChip Text="@L["Common_Smart"].Value" Title="@L["MediaSectionShell_SmartMembershipIsControlledBy"].Value" />
                                        }
                                        else if (!string.IsNullOrWhiteSpace(item.Meta))
                                        {
                                            <span class="media-section-shell__rail-meta @(item.MetaIsNotification ? "media-section-shell__rail-meta--notification" : null)"
                                                  aria-label="@item.MetaAriaLabel">@item.Meta</span>
                                        }
                                    </a>
                                    <AppOverflowMenu Icon="@AppMaterialIcons.Outlined.MoreVert" AriaLabel="@($"Manage {item.Label}")" Size="AppControlSize.Compact" Class="media-section-shell__manage-menu">
                                        @if (management.CanRename && !InReorder(management))
                                        {
                                            <AppMenuItem Label="@L["Common_Rename"].Value" Icon="@AppMaterialIcons.Outlined.DriveFileRenameOutline" OnClick="@(() => BeginRename(item))" />
                                        }
                                        @if (management.CanReorder && !InReorder(management))
                                        {
                                            <AppMenuItem Label="@L["AppReorderBar_MenuReorder"].Value" Icon="@AppMaterialIcons.Outlined.SwapVert" OnClick="@(() => BeginReorderMode(item))" />
                                        }
                                        @if (management.CanReorder && InReorder(management))
                                        {
                                            <AppMenuItem Label="@L["Common_MoveUp"].Value" Icon="@AppMaterialIcons.Outlined.KeyboardArrowUp" OnClick="@(() => MoveManagedItemAsync(item, -1))" />
                                            <AppMenuItem Label="@L["Common_MoveDown"].Value" Icon="@AppMaterialIcons.Outlined.KeyboardArrowDown" OnClick="@(() => MoveManagedItemAsync(item, 1))" />
                                        }
                                        @if (management.CanDelete && !InReorder(management))
                                        {
                                            <AppMenuItem Label="@L["Common_Delete"].Value" Icon="@AppMaterialIcons.Outlined.DeleteOutline" Tone="AppUiTone.Error" DividerBefore="true" OnClick="@(() => BeginDelete(item))" />
                                        }
                                    </AppOverflowMenu>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        var active = IsActive(item);
                        <a @key="item.Route"
                           id="@ItemId(item)"
                           href="@item.Route"
                           class="media-section-shell__rail-item @(active ? "is-active" : null) @(SectionBreakClass(item)) @(DropClass(item))"
                           @ondragover:preventDefault="@(item.DropTarget is not null)"
                           @ondrop:preventDefault="@(item.DropTarget is not null)"
                           @ondrop="@(() => DropOnNavigationItemAsync(item))"
                           aria-current="@(active ? "page" : null)">
                            <AppMaterialIcon Icon="@item.Icon" />
                            <span>@item.Label</span>
                            @if (!string.IsNullOrWhiteSpace(item.Meta))
                            {
                                <span class="media-section-shell__rail-meta @(item.MetaIsNotification ? "media-section-shell__rail-meta--notification" : null)"
                                      aria-label="@item.MetaAriaLabel">@item.Meta</span>
                            }
                            @if (item.AttentionDot)
                            {
                                <span class="media-section-shell__attention-dot" aria-hidden="true"></span>
                            }
                        </a>
                    }
                }
                }
            </section>
        }
        <LibraryStorageSummary Area="@CapacityArea" />
    </aside>

    <main @ref="_content" class="media-section-shell__content" data-detail-origin-scroll="@Title">
        @ChildContent
    </main>
</div>

<AppReorderBar Active="@(_reorderKind is not null)" Dirty="@ReorderDirty" Busy="@_reorderBusy" OnSave="SaveReorderAsync" OnCancel="CancelReorder" />

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IReadOnlyList<MediaSectionNavigationGroup> NavigationGroups { get; set; } = [];
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public EventCallback<MediaSectionNavigationDropEvent> OnNavigationItemDrop { get; set; }
    [Parameter] public EventCallback<MediaSectionNavigationCreateDropEvent> OnNavigationCreateDrop { get; set; }
    [Parameter] public EventCallback<MediaSectionNavigationCreateTarget> OnNavigationCreateCanceled { get; set; }
    [Parameter] public Func<MediaSectionNavigationCreateEvent, Task<bool>>? OnNavigationCreate { get; set; }
    [Parameter] public Func<MediaSectionNavigationCreateTarget, Task>? OnNavigationSmartCreate { get; set; }
    [Parameter] public Func<MediaSectionNavigationRenameEvent, Task<bool>>? OnNavigationItemRename { get; set; }
    [Parameter] public Func<MediaSectionNavigationManageEvent, Task<bool>>? OnNavigationItemDelete { get; set; }
    [Parameter] public Func<MediaSectionNavigationReorderEvent, Task<bool>>? OnNavigationItemReorder { get; set; }
    /// <summary>Optional content shown at the top of the rail and as the first row of the phone menu (View uses it for the Viewing switch).</summary>
    [Parameter] public RenderFragment? NavigationHeader { get; set; }
    [Parameter] public bool ShowMobileNavigation { get; set; } = true;

    /// <summary>
    /// Draws the rail as one fixed-column tree: every row, parent or not, has a chevron slot (blank for a leaf), an icon,
    /// a label and a badge slot, and children indent by one fixed step, so icons and labels at one level share a left
    /// edge. Rows can be shaded by <see cref="MediaSectionNavigationItem.Attention"/>. Off by default: the library
    /// browse shells keep their own rows.
    /// </summary>
    [Parameter] public bool FixedColumnTree { get; set; }
    private string CapacityArea => Title.Trim().ToLowerInvariant() switch
    {
        "photos" or "view" => "view",
        "read" => "read",
        "watch" => "watch",
        "listen" => "listen",
        "collections" => "collections",
        _ => Title.Trim().ToLowerInvariant(),
    };

    private string MobileActiveLabel => NavigationGroups
        .SelectMany(group => group.Items)
        .SelectMany(item => HasChildren(item) ? new[] { item }.Concat(item.Children!) : [item])
        .FirstOrDefault(IsActive)?.Label ?? $"Browse {Title}";
    [Parameter] public bool AccordionNavigation { get; set; }

    private readonly HashSet<string> _expandedRoutes = new(StringComparer.OrdinalIgnoreCase);
    private ElementReference _content;
    private AppNativeInput? _createInput;
    private AppNativeInput? _renameInput;
    private bool _scrollActiveItem;
    private bool _scrollContentTop;
    private bool _focusCreateInput;
    private bool _focusRenameInput;
    private bool _creating;
    private bool _managing;
    private string? _creatingGroupLabel;
    private MediaSectionNavigationCreateOptions? _creatingOptions;
    private string _createName = string.Empty;
    private string? _renameRoute;
    private string _renameName = string.Empty;
    private string? _swipedRoute;
    private MediaSectionNavigationItem? _reorderingItem;
    private string? _pointerRoute;
    private double _pointerStartX;
    private double _pointerStartY;

    private string ShellCssClass => string.Join(' ', new[]
    {
        "media-section-shell",
        HasNestedNavigation ? "media-section-shell--nested" : null,
        ShowMobileNavigation ? "media-section-shell--has-mobile-nav" : null,
        IsFlatTree ? "media-section-shell--flat" : null,
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private bool HasNestedNavigation => NavigationGroups.Any(group =>
        group.CreateOptions is not null
        || group.Items.Any(item => HasChildren(item) || item.Management is not null));

    /// <summary>The details overlay state, cascaded by the route view; null where the shell is shown on its own.</summary>
    [CascadingParameter] public DetailsOverlayState? Overlay { get; set; }

    // The routed page's own address: while the details overlay is open the address bar names the title, not this page.
    private RoutedPageAddress? _address;

    protected override void OnInitialized()
    {
        _address = new RoutedPageAddress(Nav, Overlay);
        Nav.LocationChanged += OnLocationChanged;
        ExpandActiveBranch();
        _scrollActiveItem = true;
    }

    // The Router renders before this shell's own location handler runs, so a render for a new address must already see it.
    protected override void OnParametersSet()
    {
        if (_address!.Accept(Nav.Uri))
        {
            ApplyAddressChange();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        // The details overlay opening, swapping titles or closing leaves this page where it was: no scroll, no change of active entry.
        if (!_address!.Accept(args.Location))
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            ApplyAddressChange();
            StateHasChanged();
        });
    }

    private void ApplyAddressChange()
    {
        ExpandActiveBranch();
        _scrollActiveItem = true;
        _scrollContentTop = true;
    }

    /// <summary>A tree whose rows have no children (Settings): drawn flat, with no chevron column and one step larger text.</summary>
    private bool IsFlatTree => FixedColumnTree && NavigationGroups.All(group => group.Items.All(item => !HasChildren(item)));

    private Uri CurrentUri => new(_address!.Absolute);

    private bool IsActive(MediaSectionNavigationItem item)
    {
        if (HasChildren(item))
        {
            return IsOwnRouteActive(item, forceExact: true)
                   || item.Children!.Any(IsActive);
        }

        return IsOwnRouteActive(item);
    }

    private bool IsOwnRouteActive(MediaSectionNavigationItem item, bool forceExact = false)
    {
        var itemUri = Nav.ToAbsoluteUri(item.Route);
        if (forceExact || item.Exact)
        {
            return string.Equals(NormalizePathAndQuery(CurrentUri), NormalizePathAndQuery(itemUri), StringComparison.OrdinalIgnoreCase);
        }

        var hasExactShortcut = NavigationGroups
            .SelectMany(group => Flatten(group.Items))
            .Where(candidate => candidate.Exact)
            .Select(candidate => Nav.ToAbsoluteUri(candidate.Route))
            .Any(candidate => string.Equals(
                NormalizePathAndQuery(CurrentUri),
                NormalizePathAndQuery(candidate),
                StringComparison.OrdinalIgnoreCase));
        if (hasExactShortcut)
        {
            return false;
        }

        var currentPath = NormalizePath(CurrentUri);
        var itemPath = NormalizePath(itemUri);
        if (item.InactiveRoutes is { Count: > 0 } && item.InactiveRoutes.Any(route =>
                string.Equals(currentPath, route, StringComparison.OrdinalIgnoreCase)
                || currentPath.StartsWith($"{route}/", StringComparison.OrdinalIgnoreCase)))
        {
            return false;
        }

        return string.Equals(currentPath, itemPath, StringComparison.OrdinalIgnoreCase)
               || currentPath.StartsWith($"{itemPath}/", StringComparison.OrdinalIgnoreCase)
               || item.ActiveRoutes is { Count: > 0 } && item.ActiveRoutes.Any(route =>
                   string.Equals(currentPath, route, StringComparison.OrdinalIgnoreCase)
                   || currentPath.StartsWith($"{route}/", StringComparison.OrdinalIgnoreCase));
    }

    private static string NormalizePathAndQuery(Uri uri) => $"{NormalizePath(uri)}{uri.Query}";

    private static string NormalizePath(Uri uri) => uri.AbsolutePath.TrimEnd('/');

    private static bool HasChildren(MediaSectionNavigationItem item) =>
        item.Children is { Count: > 0 };

    private bool IsExpanded(MediaSectionNavigationItem item) =>
        _expandedRoutes.Contains(item.Route);

    private bool IsParentRouteCurrent(MediaSectionNavigationItem item) =>
        IsOwnRouteActive(item, forceExact: true)
        && item.Children?.Any(child => IsOwnRouteActive(child, forceExact: true)) != true;

    private void ExpandBranch(MediaSectionNavigationItem item)
    {
        if (IsExpanded(item))
        {
            return;
        }

        if (AccordionNavigation)
        {
            _expandedRoutes.Clear();
        }

        _expandedRoutes.Add(item.Route);
    }

    private void NavigateBranch(MediaSectionNavigationItem item)
    {
        ExpandBranch(item);
        if (!IsOwnRouteActive(item, forceExact: true))
        {
            Nav.NavigateTo(item.Route);
        }
    }

    private void ToggleBranch(MediaSectionNavigationItem item)
    {
        if (_expandedRoutes.Remove(item.Route))
        {
            return;
        }

        if (AccordionNavigation)
        {
            _expandedRoutes.Clear();
        }

        _expandedRoutes.Add(item.Route);
    }

    private void ExpandDropBranch(MediaSectionNavigationItem item)
    {
        if (!HasChildren(item) || IsExpanded(item))
        {
            return;
        }

        if (AccordionNavigation)
        {
            _expandedRoutes.Clear();
        }

        _expandedRoutes.Add(item.Route);
    }

    private void ExpandActiveBranch()
    {
        if (FixedColumnTree)
        {
            ExpandActiveTreePath();
            return;
        }

        var activeBranch = NavigationGroups
            .SelectMany(group => group.Items)
            .FirstOrDefault(item => HasChildren(item) && IsActive(item));
        if (activeBranch is null)
        {
            return;
        }

        if (AccordionNavigation)
        {
            _expandedRoutes.Clear();
        }

        _expandedRoutes.Add(activeBranch.Route);
    }

    private List<MediaSectionNavigationItem>? FindTreePath(Func<MediaSectionNavigationItem, bool> predicate)
    {
        foreach (var group in NavigationGroups)
        {
            var path = FindTreePath(group.Items, predicate);
            if (path is not null)
            {
                return path;
            }
        }

        return null;
    }

    private static List<MediaSectionNavigationItem>? FindTreePath(
        IEnumerable<MediaSectionNavigationItem> items, Func<MediaSectionNavigationItem, bool> predicate)
    {
        foreach (var item in items)
        {
            if (predicate(item))
            {
                return [item];
            }

            if (item.Children is { Count: > 0 } && FindTreePath(item.Children, predicate) is { } below)
            {
                below.Insert(0, item);
                return below;
            }
        }

        return null;
    }

    // Opens the row and every row above it. With accordion navigation everything else folds, so one branch is open per level.
    private void ExpandTreeNode(MediaSectionNavigationItem item)
    {
        var path = FindTreePath(candidate => string.Equals(candidate.Route, item.Route, StringComparison.OrdinalIgnoreCase))
                   ?? [item];
        if (AccordionNavigation)
        {
            _expandedRoutes.Clear();
        }

        foreach (var node in path.Where(HasChildren))
        {
            _expandedRoutes.Add(node.Route);
        }
    }

    private void ToggleTreeNode(MediaSectionNavigationItem item)
    {
        if (_expandedRoutes.Remove(item.Route))
        {
            foreach (var descendant in Flatten(item.Children ?? []))
            {
                _expandedRoutes.Remove(descendant.Route);
            }

            return;
        }

        ExpandTreeNode(item);
    }

    private void NavigateTreeNode(MediaSectionNavigationItem item)
    {
        ExpandTreeNode(item);
        if (!IsOwnRouteActive(item, forceExact: true))
        {
            Nav.NavigateTo(item.Route);
        }
    }

    private void ExpandActiveTreePath()
    {
        // A row marked non-exact (Settings > Libraries, which has pages below it) also opens its branch from those pages.
        var path = FindTreePath(candidate => IsOwnRouteActive(candidate, forceExact: candidate.Exact));
        if (path is null)
        {
            return;
        }

        if (AccordionNavigation)
        {
            _expandedRoutes.Clear();
        }

        foreach (var node in path.Where(HasChildren))
        {
            _expandedRoutes.Add(node.Route);
        }
    }

    private bool IsTreeRowCurrent(MediaSectionNavigationItem item) =>
        HasChildren(item) ? IsParentRouteCurrent(item) : IsOwnRouteActive(item);

    private string TreeRowClass(MediaSectionNavigationItem item)
    {
        var current = IsTreeRowCurrent(item);
        return string.Join(' ', new[]
        {
            "media-section-shell__tree-row",
            current ? "is-active" : IsActive(item) ? "is-branch-active" : null,
            item.EffectiveAttention switch
            {
                MediaSectionAttentionLevel.Waiting => "is-attention-waiting",
                MediaSectionAttentionLevel.Blocked => "is-attention-blocked",
                _ => null,
            },
        }.Where(value => !string.IsNullOrWhiteSpace(value)));
    }

    // A count pill is part of the row's name for a screen reader ("Libraries, 8 items need review"); other rows keep their text.
    private static string? TreeRowAccessibleName(MediaSectionNavigationItem item) =>
        item.MetaIsNotification && !string.IsNullOrWhiteSpace(item.Meta) && !string.IsNullOrWhiteSpace(item.MetaAriaLabel)
            ? $"{item.Label}, {item.MetaAriaLabel}"
            : null;

    private static string? TreeAttentionLabel(MediaSectionNavigationItem item) =>
        item.EffectiveAttention == MediaSectionAttentionLevel.Blocked && !string.IsNullOrWhiteSpace(item.AttentionLabel)
            ? item.AttentionLabel
            : null;

    private RenderFragment RenderTreeNode(MediaSectionNavigationItem item, int depth) => @<div class="media-section-shell__tree-node" @key="item.Route">
        <div class="@TreeRowClass(item)" data-tree-depth="@depth">
            <span class="media-section-shell__tree-chevron-slot">
                @if (HasChildren(item))
                {
                    <AppIconButton Icon="@(IsExpanded(item) ? AppMaterialIcons.Outlined.ExpandLess : AppMaterialIcons.Outlined.ExpandMore)"
                                   Size="AppControlSize.Compact"
                                   Class="media-section-shell__tree-chevron"
                                   AriaLabel="@(IsExpanded(item) ? $"Collapse {item.Label}" : $"Expand {item.Label}")"
                                   aria-expanded="@(IsExpanded(item) ? "true" : "false")"
                                   aria-controls="@ChildrenId(item)"
                                   OnClick="@(() => ToggleTreeNode(item))" />
                }
            </span>
            <a id="@ItemId(item)"
               href="@item.Route"
               class="media-section-shell__tree-link"
               aria-current="@(IsTreeRowCurrent(item) ? "page" : null)"
               aria-label="@TreeRowAccessibleName(item)"
               @onclick="@(() => NavigateTreeNode(item))"
               @onclick:preventDefault="@HasChildren(item)">
                <span class="media-section-shell__tree-icon"><AppMaterialIcon Icon="@item.Icon" Size="AppIconSize.Control20" aria-hidden="true" /></span>
                <span class="media-section-shell__tree-label" data-overflow-tooltip="@item.Label">@item.Label</span>
                <span class="media-section-shell__tree-badge">
                    @if (!string.IsNullOrWhiteSpace(item.Meta))
                    {
                        <span class="media-section-shell__rail-meta @(item.MetaIsNotification ? "media-section-shell__rail-meta--notification" : null)"
                              aria-label="@item.MetaAriaLabel">@item.Meta</span>
                    }
                    else if (TreeAttentionLabel(item) is { } attentionLabel)
                    {
                        <span class="media-section-shell__tree-attention-label">@attentionLabel</span>
                    }
                    @if (item.AttentionDot)
                    {
                        <span class="media-section-shell__attention-dot" aria-hidden="true"></span>
                    }
                </span>
            </a>
        </div>
        @if (HasChildren(item) && IsExpanded(item))
        {
            <div id="@ChildrenId(item)" class="media-section-shell__tree-children" role="group" aria-label="@($"{item.Label} subsections")">
                @foreach (var child in item.Children!)
                {
                    @RenderTreeNode(child, depth + 1)
                }
            </div>
        }
    </div>;

    private static IEnumerable<MediaSectionNavigationItem> Flatten(IEnumerable<MediaSectionNavigationItem> items)
    {
        foreach (var item in items)
        {
            yield return item;
            if (item.Children is null)
            {
                continue;
            }

            foreach (var child in Flatten(item.Children))
            {
                yield return child;
            }
        }
    }

    private static string ItemId(MediaSectionNavigationItem item) =>
        $"media-section-nav-{Slugify(item.Route)}";

    private static string ChildrenId(MediaSectionNavigationItem item) =>
        $"{ItemId(item)}-children";

    private static string Slugify(string value) =>
        new string(value
            .ToLowerInvariant()
            .Select(character => char.IsLetterOrDigit(character) ? character : '-')
            .ToArray())
        .Trim('-');

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusCreateInput && _createInput is not null)
        {
            _focusCreateInput = false;
            await _createInput.FocusAsync();
        }

        if (_focusRenameInput && _renameInput is not null)
        {
            _focusRenameInput = false;
            await _renameInput.FocusAsync();
        }

        if (!_scrollActiveItem && !_scrollContentTop)
        {
            return;
        }

        if (_scrollContentTop)
        {
            _scrollContentTop = false;
            await JS.InvokeVoidAsync("scrollElementToTop", _content);
        }

        if (_scrollActiveItem)
        {
            _scrollActiveItem = false;
            var activeItem = NavigationGroups
                .SelectMany(group => Flatten(group.Items))
                .LastOrDefault(IsActive);
            if (activeItem is not null)
            {
                await JS.InvokeVoidAsync("scrollToLetter", ItemId(activeItem));
            }
        }
    }

    private static string? DropClass(MediaSectionNavigationItem item) =>
        item.DropTarget is null ? null : "is-drop-target";

    private static string? SectionBreakClass(MediaSectionNavigationItem item) =>
        item.SectionBreakBefore ? "media-section-shell__rail-item--section-break" : null;

    private Task DropOnNavigationItemAsync(MediaSectionNavigationItem item) =>
        item.DropTarget is { } target && OnNavigationItemDrop.HasDelegate
            ? OnNavigationItemDrop.InvokeAsync(new MediaSectionNavigationDropEvent(item, target))
            : Task.CompletedTask;

    private bool IsCreating(MediaSectionNavigationGroup group) =>
        string.Equals(_creatingGroupLabel, group.Label, StringComparison.Ordinal);

    private async Task BeginManualCreateAsync(MediaSectionNavigationGroup group)
    {
        if (_creatingOptions is not null && OnNavigationCreateCanceled.HasDelegate)
            await OnNavigationCreateCanceled.InvokeAsync(_creatingOptions.ManualTarget);

        _creatingGroupLabel = group.Label;
        _creatingOptions = group.CreateOptions;
        _createName = string.Empty;
        _renameRoute = null;
        _focusCreateInput = true;
    }

    public async Task BeginManualCreateAsync(string groupLabel)
    {
        var group = NavigationGroups.FirstOrDefault(candidate =>
            string.Equals(candidate.Label, groupLabel, StringComparison.OrdinalIgnoreCase));
        if (group?.CreateOptions is not null)
            await BeginManualCreateAsync(group);
    }

    private Task BeginSmartCreateAsync(MediaSectionNavigationGroup group) =>
        group.CreateOptions is { } options && OnNavigationSmartCreate is not null
            ? OnNavigationSmartCreate(options.SmartTarget)
            : Task.CompletedTask;

    private async Task DropOnCreateGroupAsync(MediaSectionNavigationGroup group)
    {
        if (group.CreateOptions is not { ManualDropTarget: { } dropTarget } options)
            return;

        if (OnNavigationCreateDrop.HasDelegate)
            await OnNavigationCreateDrop.InvokeAsync(new(group.Label, options.ManualTarget, dropTarget));

        _creatingGroupLabel = group.Label;
        _creatingOptions = options;
        _createName = string.Empty;
        _focusCreateInput = true;
    }

    private Task OnCreateNameChanged(object? value)
    {
        _createName = value?.ToString() ?? string.Empty;
        return Task.CompletedTask;
    }

    private async Task HandleCreateKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            await CancelCreateAsync();
            return;
        }

        if (!string.Equals(args.Key, "Enter", StringComparison.Ordinal)
            || string.IsNullOrWhiteSpace(_createName)
            || _creatingOptions is null
            || OnNavigationCreate is null)
            return;

        _creating = true;
        var succeeded = await OnNavigationCreate(new(
            _creatingGroupLabel ?? string.Empty,
            _creatingOptions.ManualTarget,
            _createName.Trim()));
        _creating = false;
        if (succeeded)
        {
            _creatingGroupLabel = null;
            _creatingOptions = null;
            _createName = string.Empty;
        }
    }

    private async Task CancelCreateAsync()
    {
        if (_creatingOptions is not null && OnNavigationCreateCanceled.HasDelegate)
            await OnNavigationCreateCanceled.InvokeAsync(_creatingOptions.ManualTarget);
        _creatingGroupLabel = null;
        _creatingOptions = null;
        _createName = string.Empty;
    }

    private string ManagedRowClass(MediaSectionNavigationItem item) => string.Join(" ", new[]
    {
        "media-section-shell__managed-row",
        _swipedRoute == item.Route ? "is-swiped" : null,
        _reorderingItem?.Route == item.Route ? "is-reordering" : null,
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private void NavigateManagedItem(MediaSectionNavigationItem item)
    {
        if (_swipedRoute == item.Route)
        {
            _swipedRoute = null;
            return;
        }

        Nav.NavigateTo(item.Route);
    }

    private void BeginRename(MediaSectionNavigationItem item)
    {
        _swipedRoute = null;
        _renameRoute = item.Route;
        _renameName = item.Label;
        _focusRenameInput = true;
    }

    private Task OnRenameNameChanged(object? value)
    {
        _renameName = value?.ToString() ?? string.Empty;
        return Task.CompletedTask;
    }

    private async Task HandleRenameKeyDownAsync(MediaSectionNavigationItem item, KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            _renameRoute = null;
            return;
        }

        if (!string.Equals(args.Key, "Enter", StringComparison.Ordinal)
            || string.IsNullOrWhiteSpace(_renameName)
            || item.Management is null
            || OnNavigationItemRename is null)
            return;

        _managing = true;
        var succeeded = await OnNavigationItemRename(new(item, item.Management, _renameName.Trim()));
        _managing = false;
        if (succeeded)
            _renameRoute = null;
    }

    // Delete is instant after one "are you sure" (the shared confirm), then the host does the delete.
    private async Task BeginDelete(MediaSectionNavigationItem item)
    {
        _swipedRoute = null;
        _renameRoute = null;
        if (item.Management is null || OnNavigationItemDelete is null)
            return;

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["Common_Delete2", item.Label].Value,
            string.Empty,
            yesText: L["Common_Delete"].Value,
            cancelText: L["Search_Cancel"].Value,
            options: AppDialogOptions.DestructiveConfirm);
        if (confirmed != true)
            return;

        _managing = true;
        try
        {
            await OnNavigationItemDelete(new(item, item.Management));
        }
        finally
        {
            _managing = false;
        }
    }

    private void BeginReorder(MediaSectionNavigationItem item) => _reorderingItem = item;
    private void EndReorder() => _reorderingItem = null;

    private async Task DropOnManagedItemAsync(MediaSectionNavigationItem item)
    {
        if (_reorderKind is not null
            && _reorderingItem is { Management: { } sourceManagement } source
            && item.Management is { } targetManagement
            && source.Route != item.Route
            && sourceManagement.ContainerKind == _reorderKind
            && targetManagement.ContainerKind == _reorderKind)
        {
            // Reorder mode only changes the staged copy; nothing is written until Save order.
            StageMoveBefore(sourceManagement.ContainerId, targetManagement.ContainerId);
            _reorderingItem = null;
            return;
        }

        await DropOnNavigationItemAsync(item);
    }

    // ---- Reorder mode: the staged order of one kind of container (playlists, Galleries, ...) ----

    private string? _reorderKind;
    private List<Guid> _stagedOrder = [];
    private List<Guid> _savedOrder = [];
    private bool _reorderBusy;

    private bool InReorder(MediaSectionNavigationItemManagement management) => _reorderKind == management.ContainerKind;
    private bool ReorderDirty => !_stagedOrder.SequenceEqual(_savedOrder);

    private IEnumerable<MediaSectionNavigationItem> ManagedItems(string kind) =>
        NavigationGroups
            .SelectMany(group => group.Items.SelectMany(item => (item.Children ?? []).Prepend(item)))
            .Where(item => item.Management is { } management && management.ContainerKind == kind);

    private void BeginReorderMode(MediaSectionNavigationItem item)
    {
        if (item.Management is not { CanReorder: true } management)
            return;
        _reorderKind = management.ContainerKind;
        _savedOrder = ManagedItems(_reorderKind).Select(managed => managed.Management!.ContainerId).Distinct().ToList();
        _stagedOrder = [.. _savedOrder];
    }

    private void HandleShellKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && _reorderKind is not null && !_reorderBusy)
            CancelReorder();
    }

    private void CancelReorder()
    {
        _reorderKind = null;
        _reorderingItem = null;
        _stagedOrder = [];
        _savedOrder = [];
    }

    /// <summary>The rows in the staged order: rows of the reordered kind take its slots in staged order, every other row stays where it is.</summary>
    private IReadOnlyList<MediaSectionNavigationItem> Ordered(IReadOnlyList<MediaSectionNavigationItem> items)
    {
        if (_reorderKind is null)
            return items;
        var slots = items.Select((item, index) => (item, index)).Where(pair => pair.item.Management?.ContainerKind == _reorderKind).Select(pair => pair.index).ToList();
        if (slots.Count < 2)
            return items;
        var byId = slots.Select(index => items[index]).GroupBy(item => item.Management!.ContainerId).ToDictionary(group => group.Key, group => group.First());
        var inOrder = _stagedOrder.Where(byId.ContainsKey).Select(id => byId[id]).ToList();
        if (inOrder.Count != slots.Count)
            return items;
        var result = items.ToList();
        for (var i = 0; i < slots.Count; i++)
            result[slots[i]] = inOrder[i];
        return result;
    }

    private void StageMoveBefore(Guid id, Guid beforeId)
    {
        var from = _stagedOrder.IndexOf(id);
        if (from < 0 || !_stagedOrder.Contains(beforeId) || id == beforeId)
            return;
        _stagedOrder.RemoveAt(from);
        _stagedOrder.Insert(_stagedOrder.IndexOf(beforeId), id);
    }

    private Task<bool> MoveManagedItemAsync(MediaSectionNavigationItem item, int direction)
    {
        if (item.Management is not { } management || _reorderKind != management.ContainerKind)
            return Task.FromResult(false);
        var from = _stagedOrder.IndexOf(management.ContainerId);
        var to = Math.Clamp(from + direction, 0, _stagedOrder.Count - 1);
        if (from < 0 || to == from)
            return Task.FromResult(false);
        _stagedOrder.RemoveAt(from);
        _stagedOrder.Insert(to, management.ContainerId);
        return Task.FromResult(true);
    }

    /// <summary>Save order: replays the staged order to the page one move at a time, then leaves the mode. A move the page refuses stops the rest and leaves the mode too (the page shows why).</summary>
    private async Task<bool> SaveReorderAsync()
    {
        if (_reorderKind is null || OnNavigationItemReorder is null)
            return false;
        if (!ReorderDirty)
        {
            CancelReorder();
            return true;
        }

        _reorderBusy = true;
        try
        {
            var kind = _reorderKind;
            var itemsById = ManagedItems(kind).GroupBy(item => item.Management!.ContainerId).ToDictionary(group => group.Key, group => group.First());
            // Rows deleted or added elsewhere while the mode was open are left out, so the replay only touches rows that still exist.
            var current = _savedOrder.Where(itemsById.ContainsKey).ToList();
            var target = _stagedOrder.Where(itemsById.ContainsKey).ToList();
            for (var i = 0; i < Math.Min(target.Count, current.Count); i++)
            {
                if (current[i] == target[i])
                    continue;
                var moved = itemsById[target[i]];
                if (!await OnNavigationItemReorder(new(moved, moved.Management!, current[i])))
                    return false;
                current.Remove(target[i]);
                current.Insert(i, target[i]);
            }

            return true;
        }
        finally
        {
            _reorderBusy = false;
            CancelReorder();
        }
    }

    private void BeginSwipe(MediaSectionNavigationItem item, PointerEventArgs args)
    {
        if (!string.Equals(args.PointerType, "touch", StringComparison.OrdinalIgnoreCase))
            return;
        _pointerRoute = item.Route;
        _pointerStartX = args.ClientX;
        _pointerStartY = args.ClientY;
    }

    private void TrackSwipe(MediaSectionNavigationItem item, PointerEventArgs args)
    {
        if (_pointerRoute != item.Route)
            return;
        var horizontal = args.ClientX - _pointerStartX;
        var vertical = args.ClientY - _pointerStartY;
        if (Math.Abs(horizontal) < 44 || Math.Abs(horizontal) <= Math.Abs(vertical))
            return;
        _swipedRoute = horizontal < 0 ? item.Route : null;
    }

    private void EndSwipe(MediaSectionNavigationItem item, PointerEventArgs args)
    {
        if (_pointerRoute == item.Route)
            _pointerRoute = null;
    }

    private static string GroupId(MediaSectionNavigationGroup group) =>
        $"media-section-{new string(group.Label.ToLowerInvariant().Select(character => char.IsLetterOrDigit(character) ? character : '-').ToArray()).Trim('-')}";

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
