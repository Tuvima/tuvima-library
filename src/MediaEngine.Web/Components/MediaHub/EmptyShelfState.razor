@namespace MediaEngine.Web.Components.MediaHub

<section class="empty-shelf-state">
    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.AutoAwesome" />
    <div>
        <h2>@Title</h2>
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p>@Message</p>
        }
        @if (!string.IsNullOrWhiteSpace(ActionLabel) && !string.IsNullOrWhiteSpace(ActionHref))
        {
            <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" StartIcon="@AppMaterialIcons.Outlined.CreateNewFolder" Href="@ActionHref">@ActionLabel</AppButton>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? ActionLabel { get; set; }
    [Parameter] public string? ActionHref { get; set; }
}
