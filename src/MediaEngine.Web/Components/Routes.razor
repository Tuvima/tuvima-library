<CascadingValue Name="ClientIngress" Value="ClientIngress" IsFixed="true">
<CascadingValue Name="ClientAddress" Value="ClientAddress" IsFixed="true">
<CascadingValue Name="ClientSignInRefusal" Value="ClientSignInRefusal" IsFixed="true">
<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <ErrorBoundary>
            <ChildContent>
                <RouteView RouteData="routeData" DefaultLayout="typeof(MediaEngine.Web.Shared.MainLayout)" />
            </ChildContent>
            <ErrorContent>
                <LayoutView Layout="typeof(MediaEngine.Web.Shared.MainLayout)">
                    <AppErrorState Title="Screen failed to load"
                                   Message="Something went wrong while rendering this screen."
                                   Details="@context.Message"
                                   Icon="@AppMaterialIcons.Outlined.ReportProblem" />
                </LayoutView>
            </ErrorContent>
        </ErrorBoundary>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
</CascadingValue>
</CascadingValue>
</CascadingValue>

@code {
    /// <summary>The Dashboard's classification of this visitor, set once by the host page and shared with every screen.</summary>
    [Parameter] public string ClientIngress { get; set; } = MediaEngine.Contracts.Authentication.ClientIngressValues.Remote;

    /// <summary>The visitor's connection address, set once by the host page; used only to limit sign-in guesses.</summary>
    [Parameter] public string? ClientAddress { get; set; }

    /// <summary>Why sign-in and setup cannot work from this visitor's address, set once by the host page; null when they can.</summary>
    [Parameter] public string? ClientSignInRefusal { get; set; }
}
