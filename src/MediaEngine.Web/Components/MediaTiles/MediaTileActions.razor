@namespace MediaEngine.Web.Components.MediaTiles
@using MediaEngine.Contracts.Details
@using MediaEngine.Domain.Services
@using MediaEngine.Web.Components.Details
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.MediaTiles
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Web.Services.Theming
@using MediaEngine.Web.Services.Ui
@implements IDisposable
@inject NavigationManager Nav
@inject IServiceProvider Services
@inject DeviceContextService DeviceContext
@inject IStringLocalizer<SharedStrings> L
@inject ILogger<MediaTileActions> Logger
@* The cover's one button (One tile design D3, D4): "..." sits top right, always visible, and holds Add to My List (first, on every device),
   Restart (only once started), Open Universe (when there is one), Edit (a device that may edit items) and Delete (administrators on such a device). A Continue
   tile adds "Go to ..." first and "Remove from Continue" after Restart (D8). It sits beside the cover's link, never inside it. Edit opens the
   pop-over editor over the page; nothing navigates away. It is not drawn when it would be empty. *@
@if (_target is not null || IsContinue)
{
    <div class="media-tile-actions" data-media-tile-actions>
        <OverflowActionMenu Actions="MenuActions" ButtonClass="media-tile-action app-icon-button app-icon-button--plain" TriggerIcon="@AppMaterialIcons.Outlined.MoreVert" KeepOrder="true" OnActionSelected="SelectAsync" />
        @if (_notice is not null)
        {
            @* Edit that is not available, or files a delete left on disk: said under the button, in place, until the close button. *@
            <div class="media-tile-actions__notice" data-media-tile-notice>
                <AppAlert Severity="AppSeverity.Warning" Dense="true" ShowCloseIcon="true" CloseIconClicked="DismissNoticeAsync">@_notice</AppAlert>
            </div>
        }
    </div>
}

@code {
    private MediaTileActionTarget? _target;
    private Guid _loadedFor;
    private bool _isSaved;
    private bool _busy;
    private SavedItemService? _saved;
    private string? _notice;
    private bool _removeWhenDismissed;

    [Parameter, EditorRequired] public MediaTileViewModel Item { get; set; } = default!;

    /// <summary>Raised after the title was deleted, so the cover can leave the row.</summary>
    [Parameter] public EventCallback OnDeleted { get; set; }

    /// <summary>True on a Continue tile: its menu starts with "Go to ..." and holds "Remove from Continue" (D8).</summary>
    [Parameter] public bool IsContinue { get; set; }

    /// <summary>Raised when "Remove from Continue" is chosen; the tile hides itself and tells the Engine.</summary>
    [Parameter] public EventCallback OnRemoveFromContinue { get; set; }

    /// <summary>Set by a list that lets its covers be ticked (the Listen Albums list): on a phone the menu then holds "Select".</summary>
    [CascadingParameter] public MediaTileSelectionOffer? SelectionOffer { get; set; }

    private const string OpenUniverseKey = "open-universe";
    private const string GoToKey = "go-to";
    private const string RemoveFromContinueKey = "remove-from-continue";
    private const string SelectKey = "select";

    private string ListLabel => _isSaved ? L["MediaTile_RemoveFromMyList"].Value : L["MediaTile_AddToMyList"].Value;

    private IReadOnlyList<DetailAction> MenuActions
    {
        get
        {
            var actions = new List<DetailAction>();
            // A Continue tile plays when tapped, so its page is one row away (D8): named by what it is.
            if (IsContinue)
            {
                actions.Add(new DetailAction { Key = GoToKey, Label = GoToLabel, Icon = "arrow_forward" });
            }

            if (_target is { CanSave: true })
            {
                actions.Add(new DetailAction
                {
                    Key = DetailActionKeys.MyList,
                    Label = ListLabel,
                    Icon = _isSaved ? "playlist_add_check" : "playlist_add",
                });
            }

            // Several covers at once on a phone: this cover is ticked and the list goes into select mode (a desktop or tablet has the list's Select button).
            if (DeviceContext.IsPhone && SelectionOffer?.Applies(Item) == true)
            {
                actions.Add(new DetailAction { Key = SelectKey, Label = L["Common_Select"].Value, Icon = "check_circle" });
            }

            // A Series, collection, Universe or playlist is not started or restarted as a whole (the same targets cannot be deleted from the cover).
            if (_target is not { CanDelete: false } && MediaTileActionTarget.IsStarted(Item))
            {
                actions.Add(new DetailAction { Key = "restart", Label = L["MediaTile_Restart"].Value, Icon = "restart_alt" });
            }

            if (IsContinue)
            {
                actions.Add(new DetailAction { Key = RemoveFromContinueKey, Label = L["MediaTile_RemoveFromContinue"].Value, Icon = "close" });
            }

            // Only when the Engine says this title's Universe page can open, so the row is never a dead link (Universe entry points spec).
            if (!string.IsNullOrWhiteSpace(Item.UniverseQid))
            {
                actions.Add(new DetailAction { Key = OpenUniverseKey, Label = L["MediaTile_OpenUniverse"].Value, Icon = "open_in_new" });
            }

            // Item editing needs a device that may edit and a profile the Engine says may edit item details (EditorDeviceRule.CanEditItems);
            // the Engine's own answer for this item is read when Edit is chosen.
            if (_target is { CanEdit: true } && EditorDeviceRule.CanEditItems(DeviceContext, Services.GetService<DashboardSessionAccessor>()))
            {
                actions.Add(new DetailAction { Key = DetailActionKeys.Edit, Label = L["MediaTile_Edit"].Value, Icon = "edit" });
            }

            if (_target is { CanDelete: true } target && LibraryItemDeletionFlow.CanDelete(DeviceContext, Services.GetService<DashboardSessionAccessor>()))
            {
                actions.Add(target.IsGroup
                    ? DetailMenuGrouping.DeleteGroupAction(target.GroupKind == LibraryGroupKinds.Album ? L["MediaTile_DeleteAlbum"].Value
                        : VideoFolderWording.IsVideoFolderMediaType(Item.MediaKind) ? L["MediaTile_DeleteFolder"].Value : L["MediaTile_DeleteShow"].Value)
                    : DetailMenuGrouping.DeleteFromLibraryAction);
            }

            return actions;
        }
    }

    protected override void OnInitialized()
    {
        _saved = Services.GetService<SavedItemService>();
        if (_saved is not null)
        {
            _saved.Changed += SavedChanged;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _target = MediaTileActionTarget.For(Item);
        if (_target is null || _saved is null || _loadedFor == _target.Id)
        {
            return;
        }

        _loadedFor = _target.Id;
        await RefreshSavedAsync();
    }

    private async Task RefreshSavedAsync()
    {
        if (_target is null || _saved is null)
        {
            return;
        }

        try
        {
            _isSaved = (await _saved.GetMembershipAsync(_target.SavedKind, _target.Id)).IsSaved;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogDebug(ex, "Could not read whether {Title} is on My List.", _target.Title);
        }
    }

    private void SavedChanged() => _ = InvokeAsync(async () =>
    {
        await RefreshSavedAsync();
        StateHasChanged();
    });

    private async Task ToggleListAsync()
    {
        if (_target is null || _saved is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var membership = await _saved.ToggleAsync(_target.SavedKind, _target.Id);
            if (membership is not null)
            {
                // The menu row now reads Add to or Remove from My List; that is the confirmation.
                _isSaved = membership.IsSaved;
            }
            else
            {
                // The button keeps its old state; a page that shows My List says so in place.
                _saved.ReportChangeFailed();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private string GoToLabel => MediaTileActionTarget.GoToKind(Item) switch
    {
        "show" => L["MediaTile_GoToShow"].Value,
        "folder" => L["MediaTile_GoToFolder"].Value,
        "movie" => L["MediaTile_GoToMovie"].Value,
        "book" => L["MediaTile_GoToBook"].Value,
        "audiobook" => L["MediaTile_GoToAudiobook"].Value,
        "comic" => L["MediaTile_GoToComic"].Value,
        "album" => L["MediaTile_GoToAlbum"].Value,
        "series" => L["MediaTile_GoToSeries"].Value,
        _ => L["MediaTile_GoToTitle"].Value,
    };

    private async Task SelectAsync(DetailAction action)
    {
        if (action.Key == GoToKey)
        {
            Nav.NavigateTo(MediaTileActionTarget.GoToUrl(Item));
            return;
        }

        if (action.Key == RemoveFromContinueKey)
        {
            await OnRemoveFromContinue.InvokeAsync();
            return;
        }

        if (action.Key == SelectKey)
        {
            if (SelectionOffer is { } offer)
            {
                await offer.BeginAsync(Item);
            }

            return;
        }

        if (_target is null)
        {
            return;
        }

        switch (action.Key)
        {
            case DetailActionKeys.MyList:
                await ToggleListAsync();
                break;
            case "restart":
                Nav.NavigateTo(MediaTileActionTarget.RestartUrl(Item));
                break;
            case OpenUniverseKey:
                if (!string.IsNullOrWhiteSpace(Item.UniverseQid))
                {
                    Nav.NavigateTo($"/universe/{Uri.EscapeDataString(Item.UniverseQid)}");
                }

                break;
            case DetailActionKeys.Edit:
                _notice = null;
                if (EditorDeviceRule.ItemRefusal(DeviceContext, Services.GetService<DashboardSessionAccessor>()) is { } refusal)
                {
                    _notice = refusal;
                    break;
                }

                if (Services.GetService<ListEditLauncher>() is { } launcher
                    && !await launcher.OpenAsync(_target.ToEditTarget()))
                {
                    _notice = launcher.LastNotice;
                }

                break;
            case DetailActionKeys.DeleteFromLibrary:
                await DeleteAsync();
                break;
        }
    }

    private async Task DeleteAsync()
    {
        var dialogs = Services.GetService<IAppDialogService>();
        if (_target is null || dialogs is null)
        {
            return;
        }

        // A locked administrator is asked for the PIN before the question; closing the prompt stops quietly.
        var deleteGate = await LibraryItemDeletionFlow.EnsureMayDeleteAsync(DeviceContext, Services.GetService<DashboardSessionAccessor>(), Services.GetService<IAdministratorSurfaceAccessService>());
        if (!deleteGate.Allowed)
        {
            if (deleteGate.Message is { } refusal)
            {
                _notice = refusal;
            }

            return;
        }

        _notice = null;
        bool deleted;
        string? notice;
        if (_target.IsGroup)
        {
            var answer = await LibraryItemDeletionFlow.RunGroupAsync(dialogs, new LibraryGroupTarget(_target.Id, _target.GroupKind!, _target.Title, []));
            deleted = answer is not null;
            notice = LibraryItemDeletionFlow.NoticeFor(answer);
        }
        else
        {
            var result = await LibraryItemDeletionFlow.RunAsync(dialogs, [_target.Id], _target.Title);
            deleted = result.Outcome != LibraryItemDeletionFlowOutcome.Canceled;
            notice = result.Notice;
        }

        if (!deleted)
        {
            return;
        }

        if (notice is null)
        {
            await OnDeleted.InvokeAsync();
            return;
        }

        // The title is gone but something needs saying (files left on disk): the cover stays with the line until it is closed.
        _notice = notice;
        _removeWhenDismissed = true;
    }

    private async Task DismissNoticeAsync()
    {
        _notice = null;
        if (_removeWhenDismissed)
        {
            _removeWhenDismissed = false;
            await OnDeleted.InvokeAsync();
        }
    }

    public void Dispose()
    {
        if (_saved is not null)
        {
            _saved.Changed -= SavedChanged;
        }
    }
}
