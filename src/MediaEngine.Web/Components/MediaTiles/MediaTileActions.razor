@namespace MediaEngine.Web.Components.MediaTiles
@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Components.Details
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.MediaTiles
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Web.Services.Theming
@using MediaEngine.Web.Services.Ui
@implements IDisposable
@inject NavigationManager Nav
@inject IServiceProvider Services
@inject DeviceContextService DeviceContext
@inject IStringLocalizer<SharedStrings> L
@inject ILogger<MediaTileActions> Logger
@* The two overlay buttons on a cover (Home, detail and tiles spec D6, D8): "+" adds it to My List (a tick once added) and "..." holds
   Restart (only once started), Edit (desktop only) and Delete (administrators on a desktop). They sit beside the cover's link, never
   inside it, and show on hover or keyboard focus (always on touch). Edit opens the pop-over editor over the page; nothing navigates away. *@
@if (_target is not null)
{
    <div class="media-tile-actions" data-media-tile-actions>
        <AppNativeButton Type="button"
                         Class="@($"media-tile-action media-tile-action--list{(_isSaved ? " is-saved" : string.Empty)}")"
                         AriaLabel="@ListLabel"
                         Title="@ListLabel"
                         aria-pressed="@(_isSaved ? "true" : "false")"
                         OnClick="@(_ => ToggleListAsync())">
            <AppMaterialIcon Icon="@(_isSaved ? AppMaterialIcons.Outlined.Check : AppMaterialIcons.Outlined.Add)" aria-hidden="true" />
        </AppNativeButton>
        <OverflowActionMenu Actions="MenuActions" ButtonClass="media-tile-action" OnActionSelected="SelectAsync" />
    </div>
}

@code {
    private MediaTileActionTarget? _target;
    private Guid _loadedFor;
    private bool _isSaved;
    private bool _busy;
    private SavedItemService? _saved;

    [Parameter, EditorRequired] public MediaTileViewModel Item { get; set; } = default!;

    /// <summary>Raised after the title was deleted, so the cover can leave the row.</summary>
    [Parameter] public EventCallback OnDeleted { get; set; }

    private string ListLabel => _isSaved ? L["MediaTile_RemoveFromMyList"].Value : L["MediaTile_AddToMyList"].Value;

    private IReadOnlyList<DetailAction> MenuActions
    {
        get
        {
            var actions = new List<DetailAction>();
            if (MediaTileActionTarget.IsStarted(Item))
            {
                actions.Add(new DetailAction { Key = "restart", Label = L["MediaTile_Restart"].Value, Icon = "restart_alt" });
            }

            // Editing is desktop-only (EditorDeviceRule); the Engine's own answer for this item is read when Edit is chosen.
            if (EditorDeviceRule.CanEdit(DeviceContext))
            {
                actions.Add(new DetailAction { Key = DetailActionKeys.Edit, Label = L["MediaTile_Edit"].Value, Icon = "edit" });
            }

            if (_target is { } target && LibraryItemDeletionFlow.CanDelete(DeviceContext, Services.GetService<DashboardSessionAccessor>()))
            {
                actions.Add(target.IsGroup
                    ? DetailMenuGrouping.DeleteGroupAction(target.GroupKind == LibraryGroupKinds.Album ? L["MediaTile_DeleteAlbum"].Value : L["MediaTile_DeleteShow"].Value)
                    : DetailMenuGrouping.DeleteFromLibraryAction);
            }

            return actions;
        }
    }

    protected override void OnInitialized()
    {
        _saved = Services.GetService<SavedItemService>();
        if (_saved is not null)
        {
            _saved.Changed += SavedChanged;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _target = MediaTileActionTarget.For(Item);
        if (_target is null || _saved is null || _loadedFor == _target.Id)
        {
            return;
        }

        _loadedFor = _target.Id;
        await RefreshSavedAsync();
    }

    private async Task RefreshSavedAsync()
    {
        if (_target is null || _saved is null)
        {
            return;
        }

        try
        {
            _isSaved = (await _saved.GetMembershipAsync(_target.SavedKind, _target.Id)).IsSaved;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogDebug(ex, "Could not read whether {Title} is on My List.", _target.Title);
        }
    }

    private void SavedChanged() => _ = InvokeAsync(async () =>
    {
        await RefreshSavedAsync();
        StateHasChanged();
    });

    private async Task ToggleListAsync()
    {
        if (_target is null || _saved is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var membership = await _saved.ToggleAsync(_target.SavedKind, _target.Id);
            if (membership is not null)
            {
                _isSaved = membership.IsSaved;
                Services.GetService<IAppToastService>()?.Add(_isSaved ? L["MediaTile_AddedToMyList"].Value : L["MediaTile_RemovedFromMyList"].Value, AppSeverity.Success);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SelectAsync(DetailAction action)
    {
        if (_target is null)
        {
            return;
        }

        switch (action.Key)
        {
            case "restart":
                Nav.NavigateTo(MediaTileActionTarget.RestartUrl(Item));
                break;
            case DetailActionKeys.Edit:
                if (Services.GetService<ListEditLauncher>() is { } launcher)
                {
                    await launcher.OpenAsync(_target.ToEditTarget());
                }

                break;
            case DetailActionKeys.DeleteFromLibrary:
                await DeleteAsync();
                break;
        }
    }

    private async Task DeleteAsync()
    {
        var toasts = Services.GetService<IAppToastService>();
        var dialogs = Services.GetService<IAppDialogService>();
        if (_target is null || toasts is null || dialogs is null
            || LibraryItemDeletionFlow.TryRefuse(DeviceContext, Services.GetService<DashboardSessionAccessor>(), toasts))
        {
            return;
        }

        var deleted = _target.IsGroup
            ? await LibraryItemDeletionFlow.RunGroupAsync(dialogs, toasts, new LibraryGroupTarget(_target.Id, _target.GroupKind!, _target.Title, [])) is not null
            : await LibraryItemDeletionFlow.RunAsync(dialogs, toasts, [_target.Id], _target.Title) != LibraryItemDeletionFlowOutcome.Canceled;
        if (deleted)
        {
            await OnDeleted.InvokeAsync();
        }
    }

    public void Dispose()
    {
        if (_saved is not null)
        {
            _saved.Changed -= SavedChanged;
        }
    }
}
