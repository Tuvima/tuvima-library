@namespace MediaEngine.Web.Components.MediaTiles
@using MediaEngine.Web.Components.Shared
@inject NavigationManager Nav
@inject IStringLocalizer<SharedStrings> L

@* The one tile for every group of titles (curated collection, Series, Universe, imported list, pack set):
   a landscape picture with a fanned stack of covers and a small corner word naming the kind, then the name
   and the shared icon-plus-count line below, like every other tile's text. Custom artwork replaces the
   stack. One hover for all: lift and glow, no popover. People groups use PersonTile instead. *@
<AppCssElement Tag="div" Css="@($"display: contents; {TileStyle}")">
    <article class="media-group-tile" aria-label="@Item.Title">
        <a class="media-group-tile__link"
           href="@GroupNavigationUrl"
           aria-label="@AccessibleLabel"
           @onclick="OpenGroupAsync"
           @onclick:preventDefault="true">
            <span class="media-group-tile__picture">
                @if (ShowCustomArtwork)
                {
                    <img class="media-group-tile__custom"
                         src="@MediaTileArtworkUrl.ForDrawnSize(Item.CoverUrl, 480)"
                         srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(Item.CoverUrl, 480)"
                         alt="" loading="lazy" decoding="async" />
                }
                else if (ShowBrandLogo)
                {
                    <img class="media-group-tile__brand" src="@Item.LogoUrl" alt="" loading="lazy" decoding="async" />
                }
                else if (Covers.Count > 0)
                {
                    <span class="media-group-tile__stack" data-cover-count="@Covers.Count" aria-hidden="true">
                        @for (var index = 0; index < Covers.Count; index++)
                        {
                            <img class="media-group-tile__cover media-group-tile__cover--@index"
                                 src="@MediaTileArtworkUrl.ForDrawnSize(Covers[index], 200)"
                                 srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(Covers[index], 200)"
                                 alt="" loading="lazy" decoding="async" />
                        }
                    </span>
                }
                else
                {
                    <span class="media-group-tile__fallback" role="img" aria-label="@L["MediaGroupTile_NoArtwork", Item.Title]">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CollectionsBookmark" />
                    </span>
                }

                <span class="media-group-tile__kind">@KindWord</span>
            </span>
            <span class="media-group-tile__name">@Item.Title</span>
            <MediaCountLine Counts="@Counts" />
        </a>
    </article>
</AppCssElement>

@code {
    private const int MaxCovers = 3;

    [Parameter, EditorRequired] public MediaTileViewModel Item { get; set; } = default!;

    // A network group (HBO, Netflix) shows its logo in place of the stack.
    private bool ShowBrandLogo => Item.ShowLogoAsBrand && !string.IsNullOrWhiteSpace(Item.LogoUrl);

    private bool ShowCustomArtwork => Item.HasCustomArtwork && !string.IsNullOrWhiteSpace(Item.CoverUrl);

    // The API orders previews by progress and canonical position; keep that order and fan the first few.
    private IReadOnlyList<string> Covers => Item.ArtworkStackItems
        .Select(item => item.ImageUrl)
        .Concat(Item.PreviewImages)
        .Where(url => !string.IsNullOrWhiteSpace(url))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Take(MaxCovers)
        .ToList();

    private IReadOnlyList<MediaTileMediaCountViewModel> Counts
    {
        get
        {
            var counts = Item.MediaCounts.Where(count => count.Count > 0).ToList();
            if (counts.Count == 0)
            {
                var total = Item.GroupSummary?.OwnedCount ?? Item.PreviewTotalCount ?? 0;
                if (total > 0)
                {
                    counts.Add(new MediaTileMediaCountViewModel(AppMaterialIcons.Outlined.CollectionsBookmark, total == 1 ? "title" : "titles", total));
                }
            }

            return counts;
        }
    }

    // A series presentation reads as a Series whichever composer built the tile.
    private MediaTileGroupKind Kind => Item.GroupKind == MediaTileGroupKind.Collection
        && Item.Presentation is MediaTilePresentation.MovieSeries or MediaTilePresentation.BookSeries
            or MediaTilePresentation.ComicSeries or MediaTilePresentation.AudiobookSeries
        ? MediaTileGroupKind.Series
        : Item.GroupKind;

    private string KindWord => Kind switch
    {
        MediaTileGroupKind.Series => L["MediaGroupTile_KindSeries"],
        MediaTileGroupKind.Universe => L["MediaGroupTile_KindUniverse"],
        MediaTileGroupKind.List => L["MediaGroupTile_KindList"],
        MediaTileGroupKind.Set => L["MediaGroupTile_KindSet"],
        _ => L["MediaGroupTile_KindCollection"],
    };

    private string GroupNavigationUrl =>
        StringHelpers.FirstNonBlank(Item.DetailsNavigationUrl, Item.NavigationUrl, Item.PrimaryNavigationUrl) ?? "/";

    private string AccessibleLabel
    {
        get
        {
            var counts = string.Join(", ", Counts.Select(count => $"{count.Count} {count.Label.ToLowerInvariant()}"));
            var label = L["MediaGroupTile_Label", Item.Title, KindWord].Value;
            return counts.Length == 0 ? label : $"{label}, {counts}";
        }
    }

    private string TileStyle =>
        $"{Item.ArtworkPalette?.CssVariableStyle} --media-group-accent: {Item.AccentColor}; --media-group-secondary: {Item.SecondaryAccentColor};";

    private Task OpenGroupAsync(MouseEventArgs _)
    {
        Nav.NavigateTo(GroupNavigationUrl);
        return Task.CompletedTask;
    }
}
