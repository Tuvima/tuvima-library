@namespace MediaEngine.Web.Components.MediaTiles
@using MediaEngine.Web.Models.ViewDTOs
@inject IEngineApiClient ApiClient
@inject IStringLocalizer<SharedStrings> L

@* The "..." menu on a collection lane's header (Collections and lists spec D10): "Hide this lane" for the active profile.
   Shown on every device, phone and TV included. Renders nothing for any other shelf. *@
@if (MediaTileShelfKeys.TryGetLaneCollectionId(ShelfKey, out _))
{
    <span class="lane-menu">
        <AppRowMenu AriaLabel="@($"More actions for {Title}")" Title="@Title" Items="@_items" />
        @if (_failure is not null)
        {
            @* The lane could not be hidden: said under the menu, in place, until the next try or the close button. *@
            <span class="lane-menu__notice" data-lane-menu-notice>
                <AppAlert Severity="AppSeverity.Error" Dense="true" ShowCloseIcon="true" CloseIconClicked="@(() => _failure = null)">@_failure</AppAlert>
            </span>
        }
    </span>
}

@code {
    /// <summary>The shelf key; only a lane key ("lane-...") shows the menu.</summary>
    [Parameter, EditorRequired] public string ShelfKey { get; set; } = string.Empty;
    /// <summary>Where the lane is shown: home, watch, read or listen.</summary>
    [Parameter, EditorRequired] public string Place { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = string.Empty;
    /// <summary>Raised with the shelf key once the Engine has saved the hide, so the page can drop the lane at once.</summary>
    [Parameter] public EventCallback<string> OnHidden { get; set; }

    private IReadOnlyList<AppRowMenuItem> _items = [];
    private string? _failure;

    protected override void OnInitialized() =>
        _items = [new AppRowMenuItem { Label = L["LaneMenu_HideThisLane"].Value, OnClick = EventCallback.Factory.Create(this, HideAsync) }];

    private async Task HideAsync()
    {
        if (!MediaTileShelfKeys.TryGetLaneCollectionId(ShelfKey, out var collectionId))
        {
            return;
        }

        _failure = null;
        if (await ApiClient.SetDisplayLaneHiddenAsync(Place, collectionId, hidden: true))
        {
            await OnHidden.InvokeAsync(ShelfKey);
        }
        else
        {
            _failure = L["LaneMenu_ThatLaneCouldNotBe"].Value;
        }
    }
}
