@namespace MediaEngine.Web.Components.MediaTiles
@using MediaEngine.Web.Services.Theming
@inject DeviceContextService DeviceContext
@inject IStringLocalizer<SharedStrings> L

@if (Shelf.Items.Count > 0)
{
    <section class="media-tile-shelf @RowClass @ContinueRowClass">
        @if (ShowHeader)
        {
            <div class="media-tile-shelf-header">
                <div class="media-tile-shelf-copy">
                    <h2 class="media-tile-shelf-title">@Shelf.Title</h2>
                    @if (!string.IsNullOrWhiteSpace(Shelf.Subtitle))
                    {
                        <p class="media-tile-shelf-subtitle">@Shelf.Subtitle</p>
                    }
                </div>

                @if (HasViewAllTile)
                {
                    <a href="@Shelf.SeeAllRoute" class="media-tile-shelf-link">@(DeviceContext.IsPhone ? "See All" : "View all")</a>
                }

                @if (!string.IsNullOrEmpty(LanePlace))
                {
                    <LaneMenu ShelfKey="@Shelf.Key" Place="@LanePlace" Title="@Shelf.Title" OnHidden="OnLaneHidden" />
                }
            </div>
        }

        <MediaShelfScroller ItemCount="@(Shelf.Items.Count + (HasViewAllTile ? 1 : 0))" AriaLabel="@Shelf.Title" OnOverflowChanged="OnOverflowChanged">
                    @foreach (var (item, index) in Shelf.Items.Select((item, index) => (item, index)))
                    {
                        @if (UseContinueWatchingOrListeningTiles)
                        {
                            <ContinueWatchingOrListeningTile Item="@item" @key="item.RenderKey" />
                        }
                        else
                        {
                            <MediaTile Item="@item"
                                       EagerArtwork="@(index < EagerItemCount)"
                                       @key="item.RenderKey" />
                        }
                    }
                    @if (HasViewAllTile)
                    {
                        @* The last item of the row: opens the whole shelf as a grid. A plain link, so keys and TV remotes reach it like any tile. *@
                        <a href="@Shelf.SeeAllRoute" class="media-tile-shelf-view-all" aria-label="@($"View all {Shelf.Title}")" data-shelf-view-all>
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ArrowForward" Size="AppIconSize.Tile32" aria-hidden="true" />
                            <span class="media-tile-shelf-view-all-text">@L["Common_ViewAll"]</span>
                        </a>
                    }
        </MediaShelfScroller>
    </section>
}
else if (ShowHeader && !string.IsNullOrWhiteSpace(EmptyMessage))
{
    @* An empty shelf normally disappears; with EmptyMessage it keeps its title and says how to fill it. No buttons. *@
    <section class="media-tile-shelf media-tile-shelf--empty">
        <div class="media-tile-shelf-header">
            <div class="media-tile-shelf-copy">
                <h2 class="media-tile-shelf-title">@Shelf.Title</h2>
            </div>
        </div>
        <p class="media-tile-shelf-empty">@EmptyMessage</p>
    </section>
}

@code {
    [Parameter, EditorRequired] public MediaTileShelfViewModel Shelf { get; set; } = default!;
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool UseContinueWatchingOrListeningTiles { get; set; }
    [Parameter] public int EagerItemCount { get; set; }
    /// <summary>When set, an empty shelf keeps its header and shows this helper text instead of disappearing.</summary>
    [Parameter] public string? EmptyMessage { get; set; }
    /// <summary>Where this shelf is shown (home, watch, read, listen). When set, a collection lane gets a "Hide this lane" menu.</summary>
    [Parameter] public string? LanePlace { get; set; }
    /// <summary>Raised with the shelf key after a lane is hidden, so the page drops it at once.</summary>
    [Parameter] public EventCallback<string> OnLaneHidden { get; set; }

    // "View all" shows only when the row holds more than fits at the current width (issue 1119). It starts shown, so a page
    // without scripting still reaches the whole shelf; the row reports back once it has measured.
    private bool _overflows = true;
    private bool HasViewAllTile => !string.IsNullOrWhiteSpace(Shelf.SeeAllRoute) && _overflows;
    private async Task OnOverflowChanged(bool overflows)
    {
        if (_overflows == overflows) return;
        _overflows = overflows;
        await OverflowChanged.InvokeAsync(overflows);
    }
    /// <summary>Raised when the row starts or stops holding more than fits, so a header drawn outside this shelf can show or hide its own View all.</summary>
    [Parameter] public EventCallback<bool> OverflowChanged { get; set; }

    private string ContinueRowClass => UseContinueWatchingOrListeningTiles ? "is-continue-row" : string.Empty;

    private string RowClass => Shelf.Items.FirstOrDefault()?.Shape switch
    {
        MediaTileShape.Landscape => "is-landscape-row",
        MediaTileShape.Square => "is-square-row",
        MediaTileShape.Portrait => "is-portrait-row",
        _ => string.Empty,
    };

}
