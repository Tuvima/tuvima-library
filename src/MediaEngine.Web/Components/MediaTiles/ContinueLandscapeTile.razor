@namespace MediaEngine.Web.Components.MediaTiles
@using MediaEngine.Contracts.Details
@using MediaEngine.Contracts.Progress
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.MediaTiles
@inject IEngineApiClient ApiClient
@inject ILogger<ContinueLandscapeTile> Logger
@inject IStringLocalizer<SharedStrings> L
@inject IJSRuntime JS
@implements IAsyncDisposable
@* One landscape Continue tile (One tile design D8, details-and-tile-fixes D3): every kind is the same size as the show tile. A movie or episode
   shows its picture with a play mark bottom-left; a book or audiobook shows its cover (portrait, left) on a blurred wash of itself, the kind
   word in the top-left label slot and the play mark bottom-right. The progress bar runs full width along the bottom edge, and an episode's
   "S3 E8" sits just above it, never over it. Under the tile: the title, then the content rating (a movie or show) or the rating or author
   and then the progress (a book or audiobook); never a movie's or show's star rating. Tapping it plays; its "..." menu starts with
   "Go to ..." (the title's own page), then Add to My List, Restart, Remove from Continue, Open Universe, Edit and Delete. Removing hides
   it until it is played again. *@
@if (!_hidden)
{
    <article class="@TileClass" aria-label="@Item.Title">
        <div class="continue-tile__frame">
            <a class="continue-tile__link" href="@ResumeUrl" aria-label="@($"Resume {Title}")"></a>
            <div class="continue-tile__picture">
                @if (ShowsCollage)
                {
                    <div class="continue-tile__collage" aria-hidden="true">
                        @foreach (var cover in Item.PreviewImages.Take(8))
                        {
                            <img src="@MediaTileArtworkUrl.ForDrawnSize(cover, 120)" alt="" loading="lazy" decoding="async" />
                        }
                    </div>
                }
                else if (UsesCoverLayout)
                {
                    @if (!string.IsNullOrWhiteSpace(CoverUrl))
                    {
                        <img class="continue-tile__soft" src="@MediaTileArtworkUrl.ForDrawnSize(CoverUrl, 320)" alt="" loading="lazy" decoding="async" aria-hidden="true" />
                        <img class="continue-tile__cover" src="@MediaTileArtworkUrl.ForDrawnSize(CoverUrl, 200)" alt="" loading="lazy" decoding="async" />
                    }
                }
                else if (!string.IsNullOrWhiteSpace(BackdropUrl))
                {
                    <img class="continue-tile__backdrop" src="@MediaTileArtworkUrl.ForDrawnSize(BackdropUrl, 640)" alt="" loading="lazy" decoding="async" />
                    @if (WantsSavedFrame)
                    {
                        @* The frame at the saved position (issue 891): drawn over the hero picture once the preview index has loaded. *@
                        <div class="continue-tile__frame-at-position" @ref="_frameElement" data-asset="@Item.AssetId" data-position="@Item.PositionSeconds?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)" aria-hidden="true"></div>
                    }
                }
                else if (!string.IsNullOrWhiteSpace(CoverUrl))
                {
                    <img class="continue-tile__soft" src="@MediaTileArtworkUrl.ForDrawnSize(CoverUrl, 320)" alt="" loading="lazy" decoding="async" aria-hidden="true" />
                    <img class="continue-tile__cover is-centred" src="@MediaTileArtworkUrl.ForDrawnSize(CoverUrl, 200)" alt="" loading="lazy" decoding="async" />
                }
            </div>
            <span class="continue-tile__play" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Filled.PlayArrow" /></span>
            @if (KindWord is { } kind)
            {
                <span class="media-tile-label media-tile-label--status media-tile-label--kind">@kind</span>
            }
            @if (EpisodeCode is { } episodeCode)
            {
                <span class="continue-tile__episode-code">@episodeCode</span>
            }
            @if (PhoneContinueLogic.ShowsProgressBar(Item))
            {
                <div class="continue-tile__progress"><AppProgressBar Value="@Item.ProgressPct" Title="@($"Progress for {Title}")" /></div>
            }
            <MediaTileActions Item="@Item" IsContinue="true" OnRemoveFromContinue="HideAsync" />
        </div>
        <div class="continue-tile__text">
            <span class="continue-tile__title" data-overflow-tooltip="@HeadingText">@HeadingText</span>
            @if (!string.IsNullOrWhiteSpace(Line))
            {
                <span class="continue-tile__line">@Line</span>
            }
            @if (!string.IsNullOrWhiteSpace(ProgressText))
            {
                <span class="continue-tile__line continue-tile__progress-text">@ProgressText</span>
            }
        </div>
    </article>
}

@code {
    [Parameter, EditorRequired] public MediaTileViewModel Item { get; set; } = default!;

    private bool _hidden;
    private ElementReference _frameElement;
    private IJSObjectReference? _frameModule;

    // Movies and TV show the frame at the saved position when the Engine made previews; the hero picture stays underneath as the fallback.
    private bool WantsSavedFrame => IsWatch && Item.AssetId is not null && Item.PositionSeconds is > 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !WantsSavedFrame || _hidden)
        {
            return;
        }

        try
        {
            _frameModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/continue-frame.js");
            await _frameModule.InvokeVoidAsync("attach", _frameElement);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // The circuit is gone or prerendering: the hero picture simply stays.
            Logger.LogDebug(ex, "Saved frame not attached for {Title}.", Item.Title);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_frameModule is null)
        {
            return;
        }

        try
        {
            await _frameModule.InvokeVoidAsync("detach", _frameElement);
            await _frameModule.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException)
        {
            Logger.LogDebug(ex, "Saved frame module already gone.");
        }
    }

    private string Title => Item.EpisodeContext?.ShowTitle ?? Item.Title;
    private string ResumeUrl => Item.PrimaryNavigationUrl ?? Item.NavigationUrl;
    private string? CoverUrl => Item.CoverUrl ?? Item.TileImageUrl ?? Item.PreviewImageUrl;
    private string? BackdropUrl => Item.BackgroundUrl ?? Item.HoverImageUrl ?? Item.HeroBackgroundImageUrl ?? Item.BannerUrl;
    private bool IsWatch => Item.MediaKind is "Movie" or "TV";
    private bool UsesCoverLayout => !IsWatch;
    private bool ShowsCollage => Item.MediaKind == "Music" && string.IsNullOrWhiteSpace(CoverUrl) && Item.PreviewImages.Count >= 4;
    private string TileClass => $"continue-tile{(UsesCoverLayout ? " continue-tile--cover" : " continue-tile--backdrop")}{(ShowsCollage ? " continue-tile--collage" : string.Empty)}{(KindWord is not null ? " continue-tile--kind" : string.Empty)}";

    // A book or audiobook says what it is in the top-left label slot (details-and-tile-fixes D3), as a group says Series or Universe.
    private string? KindWord => Item.MediaKind switch
    {
        "Book" => L["ContinueTile_KindBook"].Value,
        "Audiobook" => L["ContinueTile_KindAudiobook"].Value,
        _ => null,
    };

    // "S3 E8", just above the progress bar (D3): never at the corner over it, so a few percent of progress stays visible.
    private string? EpisodeCode => Item.EpisodeContext is { } episode ? MediaTileLabels.EpisodeCode(Item, episode) : null;

    // The title; for an episode its own title (the S3 E8 code sits on the picture), falling back to the show's.
    private string HeadingText => Item.EpisodeContext is { } episode && !string.IsNullOrWhiteSpace(episode.EpisodeTitle)
        ? episode.EpisodeTitle
        : Title;

    // Under the title (D3). A movie or show: the content rating (R, PG-13, TV-MA), never the star rating; an episode leads with its show.
    // A book or audiobook: a rating only when one is available, otherwise its author or narrator.
    private string? Line
    {
        get
        {
            if (IsWatch)
            {
                return string.Join(" · ", new[] { Item.EpisodeContext?.ShowTitle, Item.ContentRating?.Trim() }.Where(part => !string.IsNullOrWhiteSpace(part)));
            }

            return MediaTileLabels.RatingText(Item) ?? Item.Creator ?? Item.Subtitle;
        }
    }

    // A book or audiobook ends with its progress ("42% complete · 3 hr left").
    private string? ProgressText => UsesCoverLayout && PhoneContinueLogic.ShowsProgressBar(Item) ? PhoneContinueLogic.PickUpProgressText(Item) : null;

    private DetailEntityType EntityType => Item.MediaKind switch
    {
        "Movie" => DetailEntityType.Movie,
        "TV" => DetailEntityType.TvShow,
        "Music" => DetailEntityType.MusicAlbum,
        "Audiobook" => DetailEntityType.Audiobook,
        "Comic" => DetailEntityType.ComicIssue,
        _ => DetailEntityType.Book,
    };

    private async Task HideAsync()
    {
        // The tile disappears at once; the Engine remembers it per profile, and playing it again brings it back.
        _hidden = true;
        try
        {
            var target = Item.EpisodeContext?.ShowWorkId ?? Item.WorkId ?? Item.Id;
            var status = await ApiClient.GetPersonalStatusAsync(EntityType, target);
            if (status is not null)
            {
                await ApiClient.ChangePersonalStatusAsync(new PersonalStatusRequest(Guid.NewGuid(), EntityType, target, PersonalStatusAction.HideContinue, status.Revision));
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not hide {Title} from Continue.", Item.Title);
        }
    }
}
