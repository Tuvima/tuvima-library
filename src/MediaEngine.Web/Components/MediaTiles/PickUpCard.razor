@namespace MediaEngine.Web.Components.MediaTiles
@using MediaEngine.Web.Models.ViewDTOs
<article class="pickup-card" aria-label="@Title">
    <a class="pickup-art" href="@ResumeUrl" tabindex="-1" aria-hidden="true">
        @if (!string.IsNullOrWhiteSpace(ArtworkUrl))
        {
            <img src="@MediaTileArtworkUrl.ForDrawnSize(ArtworkUrl, 112)" alt="" loading="lazy" decoding="async" />
        }
    </a>
    <div class="pickup-body">
        <span class="pickup-kind"><AppMaterialIcon Icon="@PhoneContinueLogic.TypeIcon(Item.MediaKind)" Size="AppSize.Small" aria-hidden="true" />@PhoneContinueLogic.ActionWord(Item.MediaKind)</span>
        <a class="pickup-title" href="@(Item.DetailsNavigationUrl ?? Item.NavigationUrl)">@Title</a>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <span class="pickup-subtitle">@Subtitle</span>
        }
        @if (PhoneContinueLogic.ShowsProgressBar(Item))
        {
            <AppProgressBar Value="@Item.ProgressPct" Title="@($"Progress for {Title}")" />
        }
        <span class="pickup-progress-text">@PhoneContinueLogic.PickUpProgressText(Item)</span>
    </div>
    <a class="pickup-play" href="@ResumeUrl" aria-label="@($"Resume {Title}")"><AppMaterialIcon Icon="@AppMaterialIcons.Filled.PlayArrow" /></a>
</article>
@code {
    [Parameter, EditorRequired] public MediaTileViewModel Item { get; set; } = default!;

    private string Title => Item.EpisodeContext?.ShowTitle ?? Item.Title;
    private string? ArtworkUrl => Item.PreviewImageUrl ?? Item.TileImageUrl;
    private string ResumeUrl => Item.PrimaryNavigationUrl ?? Item.NavigationUrl;
    private string? Subtitle => Item.EpisodeContext is { } episode
        ? $"S{episode.SeasonNumber} E{episode.EpisodeNumber} · {episode.EpisodeTitle}"
        : Item.Creator ?? Item.Subtitle;
}
