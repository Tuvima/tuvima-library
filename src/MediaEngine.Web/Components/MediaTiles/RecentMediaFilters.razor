@namespace MediaEngine.Web.Components.MediaTiles
<div class="recent-filters" role="group" aria-label="Recently added media">
    @foreach (var type in Types)
    {
        <AppNativeButton Type="button" Class="@($"app-discovery-filter__tab {(Selected == type.Key ? "is-active" : null)}")" aria-pressed="@(Selected == type.Key ? "true" : "false")" OnClick="() => SelectedChanged.InvokeAsync(type.Key)">@type.Label</AppNativeButton>
    }
</div>
@code {
    private static readonly (string Key, string Label)[] Types = [("all", "All"), ("watch", "Watch"), ("read", "Read"), ("listen", "Listen"), ("view", "View")];
    [Parameter] public string Selected { get; set; } = "all";
    [Parameter] public EventCallback<string> SelectedChanged { get; set; }
}
