@namespace MediaEngine.Web.Components.MediaTiles
@inject IStringLocalizer<SharedStrings> L
@if (Visible.Count > 0)
{
    <div class="recent-filters" role="group" aria-label="@L["Common_RecentlyAddedMedia"].Value">
        <AppToggleChip Class="recent-filter" Pressed="@RecentFilterLogic.IsAll(Selected)" OnClick="SelectAllAsync">@L["ApiKeys_AllKeysRevoked"]</AppToggleChip>
        @foreach (var type in Visible)
        {
            var on = RecentFilterLogic.Selected(Selected).Contains(type);
            <AppToggleChip Class="recent-filter" Pressed="@on" OnClick="() => SelectedChanged.InvokeAsync(RecentFilterLogic.Toggle(Selected, type, Visible))">@RecentFilterLogic.Label(type)</AppToggleChip>
        }
    </div>
}
@code {
    [Parameter] public string Selected { get; set; } = "all";
    /// <summary>Types that have recent items (from the Engine). Null until known: no pills yet.</summary>
    [Parameter] public IReadOnlyList<string>? Available { get; set; }
    [Parameter] public EventCallback<string> SelectedChanged { get; set; }
    private Task SelectAllAsync() => SelectedChanged.InvokeAsync("all");
    private IReadOnlyList<string> Visible => RecentFilterLogic.VisibleTypes(Available);
}
