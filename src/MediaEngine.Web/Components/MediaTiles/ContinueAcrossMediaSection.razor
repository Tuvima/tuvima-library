@namespace MediaEngine.Web.Components.MediaTiles
@* One mixed row of landscape Continue tiles (details-and-tile-fixes D3), most recently touched first. Nothing started hides the whole section (no empty heading). *@
@{
    var items = PhoneContinueLogic.Select(Shelf.Items);
}
@if (items.Count > 0)
{
    <section class="continue-across-media" aria-label="@Heading">
        @if (ShowHeading)
        {
            <h2>@Heading</h2>
        }
        <MediaShelfScroller ItemCount="@items.Count" AriaLabel="@Heading" Class="pickup-row">
            @foreach (var item in items)
            {
                <ContinueWatchingOrListeningTile Item="@item" @key="item.RenderKey" />
            }
        </MediaShelfScroller>
    </section>
}
@code {
    [Parameter, EditorRequired] public MediaTileShelfViewModel Shelf { get; set; } = default!;
    /// <summary>The section heading. Home says "Pick up where you left off"; My Library calls it "Continue".</summary>
    /// <summary>False when the host already shows the heading (the profile Overview panel), so it is never said twice.</summary>
    [Parameter] public bool ShowHeading { get; set; } = true;
    [Parameter] public string Heading { get; set; } = "Pick up where you left off";
}
