@namespace MediaEngine.Web.Components.MediaTiles
@using MediaEngine.Domain.Services
@using MediaEngine.Web.Services.Theming
@inject DeviceContextService DeviceContext
@if (DeviceContext.IsPhone)
{
    @* Phones: one row, newest activity first, started items only. Nothing started hides the whole section (no empty header). *@
    var phoneItems = PhoneContinueLogic.Select(Shelf.Items);
    @if (phoneItems.Count > 0)
    {
        <section class="continue-across-media continue-across-media--phone" aria-label="@Heading">
            <h2>@Heading</h2>
            <div class="continue-groups">
                <AppCssElement Tag="section" Class="continue-group continue-mixed" aria-label="@Heading">
                    <MediaShelfScroller ItemCount="@phoneItems.Count" AriaLabel="@Heading">
                        @foreach (var item in phoneItems)
                        {
                            <MediaTile Item="@item" IsHomeSurface="true" IsContinueCard="true" HideMediaKindBadge="true" HideSourceBadge="true" HideGroupIndicators="true" HoverMode="@MediaTileHoverPolicy.ForContinue(item)" @key="item.RenderKey">
                                <CaptionContent>
                                    <strong>@(item.EpisodeContext is { } episode ? $"S{episode.SeasonNumber} E{episode.EpisodeNumber} · {episode.EpisodeTitle}" : item.Title)</strong>
                                    <span class="continue-sublabel"><AppMaterialIcon Icon="@PhoneContinueLogic.TypeIcon(item.MediaKind)" Size="AppSize.Small" aria-hidden="true" /><span class="sr-only">@PhoneContinueLogic.TypeName(item.MediaKind), </span>@PhoneContinueLogic.SubLabel(item)</span>
                                </CaptionContent>
                            </MediaTile>
                        }
                    </MediaShelfScroller>
                </AppCssElement>
            </div>
        </section>
    }
}
else
{
<section class="continue-across-media" aria-label="@Heading">
    <h2>@Heading</h2>
    <div class="continue-groups">
        @foreach (var group in Groups.Where(group => group.Items.Count > 0))
        {
            <AppCssElement Tag="section" Class="@($"continue-group {group.Class}")" Css="@($"--continue-units:{GroupUnits(group).ToString(System.Globalization.CultureInfo.InvariantCulture)};")" aria-label="@group.Title">
                <h3><AppMaterialIcon Icon="@group.Icon" />@group.Title</h3>
                <MediaShelfScroller ItemCount="@group.Items.Count" AriaLabel="@group.Title">
                    @foreach (var item in group.Items)
                    {
                        <MediaTile Item="@item" IsHomeSurface="true" IsContinueCard="true" HideMediaKindBadge="true" HideSourceBadge="true" HideGroupIndicators="true" HoverMode="@MediaTileHoverPolicy.ForContinue(item)" @key="item.RenderKey">
                            <CaptionContent><strong>@(item.EpisodeContext is { } episode ? $"S{episode.SeasonNumber} E{episode.EpisodeNumber} · {episode.EpisodeTitle}" : item.Title)</strong><span>@(item.EpisodeContext?.ShowTitle ?? Caption(item))</span></CaptionContent>
                        </MediaTile>
                    }
                </MediaShelfScroller>
            </AppCssElement>
        }
    </div>
</section>
}
@code {
    [Parameter, EditorRequired] public MediaTileShelfViewModel Shelf { get; set; } = default!;
    /// <summary>The section heading. Home keeps "Continue Across Media"; My Library calls it "Continue".</summary>
    [Parameter] public string Heading { get; set; } = "Continue Across Media";
    private IReadOnlyList<ContinueGroup> Groups => [
        new("Continue Watching", "continue-watching", AppMaterialIcons.Outlined.PlayArrow, Shelf.Items.Where(item => item.MediaKind is "TV" or "Movie").ToList()),
        new("Continue Reading", "continue-reading", AppMaterialIcons.Outlined.MenuBook, Shelf.Items.Where(item => item.MediaKind is "Book" or "Comic").ToList()),
        new("Continue Listening", "continue-listening", AppMaterialIcons.Outlined.Headphones, Shelf.Items.Where(item => item.MediaKind is "Audiobook" or "Music").ToList())];
    private static double GroupUnits(ContinueGroup group) => Math.Min(group.Items.Count, 2) * (group.Class == "continue-watching" ? 16d / 9 : group.Class == "continue-reading" ? 2d / 3 : 1d) + .5;
    private sealed record ContinueGroup(string Title, string Class, string Icon, IReadOnlyList<MediaTileViewModel> Items);
    private static string? Caption(MediaTileViewModel item)
    {
        if (item.MediaKind is not ("TV" or "Movie")) return item.Creator ?? item.Subtitle;
        var identity = item.EpisodeContext is { } episode ? $"S{episode.SeasonNumber} E{episode.EpisodeNumber}" : "Movie";
        if (item.RemainingSeconds is not > 0) return identity;
        var minutes = (int)Math.Ceiling(item.RemainingSeconds.Value / 60);
        var remaining = minutes >= 60 ? $"{minutes / 60} hr {minutes % 60} min left" : $"{minutes} min left";
        return $"{identity} · {remaining}";
    }
}
