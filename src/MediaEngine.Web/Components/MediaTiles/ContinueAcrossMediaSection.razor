@namespace MediaEngine.Web.Components.MediaTiles
@using MediaEngine.Domain.Services
<section class="continue-across-media" aria-label="Continue Across Media">
    <h2>Continue Across Media</h2>
    <div class="continue-groups">
        @foreach (var group in Groups.Where(group => group.Items.Count > 0))
        {
            <section class="continue-group @group.Class" aria-label="@group.Title">
                <h3><MudIcon Icon="@group.Icon" />@group.Title</h3>
                <MediaShelfScroller ItemCount="@group.Items.Count" AriaLabel="@group.Title">
                    @foreach (var item in group.Items)
                    {
                        <MediaTile Item="@item" HideMediaKindBadge="true" HideSourceBadge="true" HideGroupIndicators="true" HoverMode="MediaTileHoverMode.GlowOnly" @key="item.RenderKey">
                            <CaptionContent><strong>@item.Title</strong><span>@Caption(item)</span></CaptionContent>
                        </MediaTile>
                    }
                </MediaShelfScroller>
            </section>
        }
    </div>
</section>
@code {
    [Parameter, EditorRequired] public MediaTileShelfViewModel Shelf { get; set; } = default!;
    private IReadOnlyList<ContinueGroup> Groups => [
        new("Continue Watching", "continue-watching", Icons.Material.Outlined.PlayArrow, Shelf.Items.Where(item => item.MediaKind is "TV" or "Movie").ToList()),
        new("Continue Reading", "continue-reading", Icons.Material.Outlined.MenuBook, Shelf.Items.Where(item => item.MediaKind is "Book" or "Comic").ToList()),
        new("Continue Listening", "continue-listening", Icons.Material.Outlined.Headphones, Shelf.Items.Where(item => item.MediaKind is "Audiobook" or "Music").ToList())];
    private sealed record ContinueGroup(string Title, string Class, string Icon, IReadOnlyList<MediaTileViewModel> Items);
    private static string? Caption(MediaTileViewModel item)
    {
        if (item.MediaKind is not ("TV" or "Movie")) return item.Creator ?? item.Subtitle;
        var identity = item.EpisodeContext is { } episode ? $"S{episode.SeasonNumber} E{episode.EpisodeNumber}" : "Movie";
        if (item.RemainingSeconds is not > 0) return identity;
        var minutes = (int)Math.Ceiling(item.RemainingSeconds.Value / 60);
        var remaining = minutes >= 60 ? $"{minutes / 60} hr {minutes % 60} min left" : $"{minutes} min left";
        return $"{identity} · {remaining}";
    }
}
