@namespace MediaEngine.Web.Components.MediaTiles
@* One mixed row of compact cards, most recently touched first. Nothing started hides the whole section (no empty heading). *@
@{
    var items = PhoneContinueLogic.SelectPickUp(Shelf.Items);
}
@if (items.Count > 0)
{
    <section class="continue-across-media" aria-label="@Heading">
        <h2>@Heading</h2>
        <MediaShelfScroller ItemCount="@items.Count" AriaLabel="@Heading" Class="pickup-row">
            @foreach (var item in items)
            {
                <PickUpCard Item="@item" @key="item.RenderKey" />
            }
        </MediaShelfScroller>
    </section>
}
@code {
    [Parameter, EditorRequired] public MediaTileShelfViewModel Shelf { get; set; } = default!;
    /// <summary>The section heading. Home says "Pick up where you left off"; My Library calls it "Continue".</summary>
    [Parameter] public string Heading { get; set; } = "Pick up where you left off";
}
