@namespace MediaEngine.Web.Components.MediaTiles
@using MediaEngine.Contracts.Display
@using MediaEngine.Domain.Services
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.MediaTiles
@inject NavigationManager Nav
@inject IServiceProvider Services
@inject IStringLocalizer<SharedStrings> L

@* One tile for every cover (One tile design spec). The cover fills the tile and carries its own title on the art; nothing sits under it.
   "..." is top right and always visible, a status label touches the top-left corner and a bottom label (the group count) touches the
   bottom-left corner. Hover and keyboard focus draw one thin purple outline around the cover; the tile never grows or moves.
   A video with no cover art is the two-part tile (a still on top, its title and one detail line below, D7). A group of titles (Series,
   curated collection, Universe) is the same poster: its cover and the count as the bottom label, nothing else drawn over the art (D2, D11). *@
@if (Item.RenderAsPersonTile)
{
    <PersonTile Item="@Item" />
}
else if (Item.IsPlaylist)
{
    <MediaSquareTile Item="@Item" />
}
else if (!_removed)
{
<AppCssElement Tag="div"
               Css="@PaletteScopeStyle">
<article class='@($"media-tile {ShapeClass} {MediaKindClass} {PresentationClass} {SurfaceClass} {(IsVideoStill ? "is-video-still" : string.Empty)} {(IsGroup ? "is-group" : string.Empty)} {(ShowsEpisodeCaption ? "has-episode-caption" : string.Empty)} {(IsJustSaved ? "tl-just-changed" : string.Empty)}")'
         data-new="@(IsJustSaved ? "true" : null)"
         aria-label="@Item.Title">
    <a class="media-tile-link" href="@DetailsNavigationUrl" aria-label="@DetailsActionAriaLabel" @onclick="OpenDetails" @onclick:preventDefault="true">
    <div class="media-tile-frame">
        <div class="media-tile-media @(HasArtworkSurface ? "has-artwork-surface" : null)">
            @if (ShowBrandLogo)
            {
                @* A network group (HBO, Netflix) shows its logo in place of a cover. *@
                <img class="media-tile-brand" src="@Item.LogoUrl" alt="" loading="lazy" decoding="async" />
            }
            else if (ShowCollectionBanner)
            {
                @if (!string.IsNullOrWhiteSpace(CardImageUrl))
                {
                    <img src="@MediaTileArtworkUrl.ForDrawnSize(CardImageUrl, TileDrawnPx)"
                         srcset="@TileSrcSet"
                         sizes="@Item.TileImageSizes"
                         alt=""
                         class="media-tile-collection-backdrop @TileImageFitClass"
                         loading="lazy"
                         decoding="async" />
                }
                <div class="media-tile-collection-wash"></div>
                @if (ShowTileLogo)
                {
                    <img src="@Item.LogoUrl" alt="@Item.Title" class="media-tile-landscape-logo is-banner" loading="lazy" decoding="async" />
                }
                else
                {
                    <span class="media-tile-landscape-title is-banner">@Item.Title</span>
                }
            }
            else if (ShowPreviewStack)
            {
                <div class="media-tile-stack" aria-hidden="true">
                    @for (var index = 0; index < PreviewImages.Count; index++)
                    {
                        <img src="@MediaTileArtworkUrl.ForDrawnSize(PreviewImages[index], TileDrawnPx)"
                             alt=""
                             class="@GetStackImageClass(index)"
                             loading="lazy"
                             decoding="async" />
                    }
                </div>
            }
            else if (Item.IsStandInPicture)
            {
                @* TheTVDB has no picture for this episode: a marked stand-in, never a real-looking still. *@
                <div class="media-tile-standin" data-standin="true">
                    @if (!string.IsNullOrWhiteSpace(CardImageUrl))
                    {
                        <img src="@MediaTileArtworkUrl.ForDrawnSize(CardImageUrl, TileDrawnPx)" srcset="@TileSrcSet" sizes="@Item.TileImageSizes"
                             alt="" aria-hidden="true" class="media-tile-standin__image" loading="@CardImageLoading" decoding="async" />
                    }
                    else
                    {
                        <div class="media-tile-standin__library-tile" aria-hidden="true">
                            <AppMaterialIcon Icon="@FallbackIcon" Class="tl-u-font-size-44px tl-u-color-rgba-255-255-255--18" />
                        </div>
                    }
                    <span class="media-tile-standin__number">@Item.StandInLabel</span>
                    <span class="media-tile-standin__tag" aria-label="@($"{L["MediaTile_StandIn_Tag"].Value}. {StandInTooltip}")">@L["MediaTile_StandIn_Tag"]</span>
                </div>
            }
            else if (IsVideoCollection)
            {
                @* A group of videos (issue 869): a tall dark-purple card, the collection's still wide on a soft copy of itself, the kind, a big title,
                   the creator, and the count once at the bottom-left beside a round play mark. The New pill and the "..." menu are the shared labels. *@
                <div class="media-tile-video-collection">
                    <span class="media-tile-video-collection__layers" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Layers" /></span>
                    <div class="media-tile-video-collection__art">
                        @if (!string.IsNullOrWhiteSpace(CardImageUrl))
                        {
                            <img src="@MediaTileArtworkUrl.ForDrawnSize(CardImageUrl, TileDrawnPx)" alt="" aria-hidden="true" class="media-tile-video-collection__soft" loading="@CardImageLoading" decoding="async" />
                            <img src="@MediaTileArtworkUrl.ForDrawnSize(CardImageUrl, TileDrawnPx)" alt="" aria-hidden="true" class="media-tile-video-collection__still" loading="@CardImageLoading" decoding="async" />
                        }
                        else
                        {
                            <span class="media-tile-video-collection__still media-tile-video-collection__still--empty" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Movie" /></span>
                        }
                    </div>
                    <span class="media-tile-video-collection__kind">@L["MediaTile_VideoCollection"]</span>
                    <span class="media-tile-video-collection__title" data-overflow-tooltip="@Item.Title">@Item.Title</span>
                    @if (!string.IsNullOrWhiteSpace(Item.Creator))
                    {
                        <span class="media-tile-video-collection__creator">@Item.Creator</span>
                    }
                    <div class="media-tile-video-collection__foot">
                        <span class="media-tile-video-collection__count"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Layers" Size="AppIconSize.Control20" aria-hidden="true" />@MediaTileLabels.CountText(Item)</span>
                        <span class="media-tile-video-collection__play" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PlayArrow" /></span>
                    </div>
                </div>
            }
            else if (IsVideoStill)
            {
                @* A video's still on top, its name and one detail line below (D7, D16). With no frame at all the top is a plain dark panel with a video icon. *@
                <div class="media-tile-video-still">
                    @if (!string.IsNullOrWhiteSpace(CardImageUrl))
                    {
                        <img src="@MediaTileArtworkUrl.ForDrawnSize(CardImageUrl, TileDrawnPx)"
                             srcset="@TileSrcSet"
                             sizes="@Item.TileImageSizes"
                             alt=""
                             aria-hidden="true"
                             class="media-tile-video-still__image"
                             loading="@CardImageLoading"
                             decoding="async" />
                    }
                    else
                    {
                        <span class="media-tile-video-still__panel" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Movie" /></span>
                    }
                </div>
                <div class="media-tile-video-text">
                    <span class="media-tile-video-text__title" data-overflow-tooltip="@Item.Title">@Item.Title</span>
                    @if (VideoDetail is { } detail)
                    {
                        <span class="media-tile-video-text__detail">@detail</span>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(CardImageUrl))
            {
                @if (Item.TileImageFitMode == MediaTileImageFitMode.Contain)
                {
                    <img src="@MediaTileArtworkUrl.ForDrawnSize(CardImageUrl, TileDrawnPx)" alt="" aria-hidden="true" class="media-tile-contained-backdrop" loading="lazy" decoding="async" />
                }
                <img src="@MediaTileArtworkUrl.ForDrawnSize(CardImageUrl, TileDrawnPx)"
                     srcset="@TileSrcSet"
                     sizes="@Item.TileImageSizes"
                     alt="@Item.Title"
                     class="media-tile-image @TileImageFitClass"
                     loading="@CardImageLoading"
                     decoding="async" />
            }
            else
            {
                @* No cover art: a plain dark cover with the kind's icon, the title and its author or artist at the bottom (D7). *@
                <div class="media-tile-fallback">
                    <AppMaterialIcon Icon="@FallbackIcon" Class="tl-u-font-size-44px tl-u-color-rgba-255-255-255--18" />
                    <span class="media-tile-fallback__title">@Item.Title</span>
                    @if (!string.IsNullOrWhiteSpace(DisplaySubtitle))
                    {
                        <span class="media-tile-fallback__detail">@DisplaySubtitle</span>
                    }
                </div>
            }

            @if (StatusLabel is { } status)
            {
                <span class="media-tile-label media-tile-label--status">@status</span>
            }
            @if (BottomLabel is { } bottom && !IsVideoCollection)
            {
                <span class="media-tile-label media-tile-label--bottom" aria-label="@bottom" data-overflow-tooltip="@bottom">@bottom</span>
            }
            <AppArtworkProgress Enabled="@SupportsCompletion" State="@Item.ContinuationState" Percent="@Item.ProgressPct" MediaKind="@Item.MediaKind" RemainingSeconds="@Item.RemainingSeconds" Label="@Item.ProgressLabel" />
        </div>
    </div>

    @if (ShowsEpisodeCaption)
    {
        @* Only the episode lists of a show or season (their own pages) keep text under a still: the episode number and title. *@
        <div class="media-tile-episode-caption"><strong>@(Item.EpisodeContext is { } episode ? MediaTileLabels.EpisodeHeading(Item, episode) : Item.Title)</strong><span>@EpisodeShowCaption</span></div>
    }
    </a>
    @if (ShowActions)
    {
        <MediaTileActions Item="@Item" OnDeleted="@(() => { _removed = true; StateHasChanged(); })" />
    }
</article>
</AppCssElement>
}

@code {
    [Parameter, EditorRequired] public MediaTileViewModel Item { get; set; } = default!;
    [Parameter] public bool EagerArtwork { get; set; }

    /// <summary>
    /// The collections the person just saved, cascaded by the Collections page. A tile for one of them glows (the same glow as a
    /// changed row) as the confirmation, in place of a toast. Null everywhere else.
    /// </summary>
    [CascadingParameter(Name = "JustSavedCollectionIds")] public IReadOnlySet<Guid>? JustSavedCollectionIds { get; set; }

    private bool IsJustSaved => JustSavedCollectionIds is { Count: > 0 } saved
        && (Item.CollectionId is { } collectionId && saved.Contains(collectionId));
    /// <summary>Draws the cover's "..." menu; off for places where a cover is only a picture.</summary>
    [Parameter] public bool ShowActions { get; set; } = true;
    /// <summary>The episode lists of a show or season keep the episode number and title under each still; no other tile has text under it.</summary>
    [Parameter] public bool ShowEpisodeText { get; set; }
    private bool _removed;

    private string CardImageLoading => EagerArtwork ? "eager" : "lazy";

    private IReadOnlyList<string> _previewImages = [];

    private string TileStyle => $"{Item.ArtworkPalette?.CssVariableStyle} --media-tile-accent: {Item.AccentColor}; --media-tile-secondary-accent: {Item.SecondaryAccentColor};";

    private string PaletteScopeStyle => $"display: contents; {TileStyle}";

    private string ShapeClass => IsGroup ? "is-portrait" : Item.Shape switch
    {
        MediaTileShape.Landscape => "is-landscape",
        MediaTileShape.Square => "is-square",
        _ => "is-portrait",
    };

    private string MediaKindClass => MediaKindLabel switch
    {
        "Book" => "is-media-book",
        "Comic" => "is-media-comic",
        "Audiobook" or "Music" => "is-media-audio",
        "Movie" => "is-media-movie",
        "TV" => "is-media-tv",
        _ => "is-media-default",
    };

    private string PresentationClass => Item.Presentation switch
    {
        MediaTilePresentation.TvSeries => "is-tv-series",
        MediaTilePresentation.MovieSeries => "is-movie-series",
        MediaTilePresentation.BookSeries => "is-book-series",
        MediaTilePresentation.ComicSeries => "is-comic-series",
        MediaTilePresentation.AudiobookSeries => "is-audiobook-series",
        MediaTilePresentation.Album => "is-album",
        MediaTilePresentation.Artist => "is-artist",
        _ => "is-default",
    };

    private string SurfaceClass => Item.SurfaceKind switch
    {
        MediaTileSurfaceKind.BannerLandscape => "is-banner-surface",
        MediaTileSurfaceKind.CoverSquare => "is-cover-square",
        MediaTileSurfaceKind.ArtistPhotoSquare => "is-artist-photo-square",
        _ => "is-cover-portrait",
    };

    // A folder of videos is the tall collection card, never the plain still tile (issue 869).
    private bool IsVideoCollection => IsVideoStill && Item.IsCollection && VideoFolderWording.IsVideoFolderMediaType(Item.MediaKind);
    private bool IsVideoStill => MediaTileLabels.IsVideoStillTile(Item) && !ShowCollectionBanner;
    private string? VideoDetail => MediaTileLabels.VideoDetail(Item);
    private string? StatusLabel => MediaTileLabels.Status(Item, L["MediaTile_GettingDetails"].Value);
    private string? BottomLabel => MediaTileLabels.Bottom(Item, L["MediaTile_Kept"].Value);

    // A group of titles is always a poster (Series, curated collection, Universe); a person has its own tile before this one.
    private bool IsGroup => Item.RenderAsGroupTile;

    private bool ShowBrandLogo => IsGroup && Item.ShowLogoAsBrand && !string.IsNullOrWhiteSpace(Item.LogoUrl);

    private bool ShowCollectionBanner => !IsGroup && Item.IsCollection && Item.SurfaceKind == MediaTileSurfaceKind.BannerLandscape;

    private bool ShowPreviewStack => !IsGroup && !ShowBrandLogo && !ShowCollectionBanner && string.IsNullOrWhiteSpace(CardImageUrl) && PreviewImages.Count > 0 && !IsVideoStillWithoutStack;

    // A video with no frame shows the plain panel, never a fan of other pictures.
    private bool IsVideoStillWithoutStack => MediaTileLabels.IsVideoStillTile(Item);

    // Tiles are one size (214 px wide, 112 px on a phone), so the small copy covers every tile and a 1x/2x/3x list keeps sharp screens sharp.
    private const int TileDrawnPx = 320;
    private const int TileWidthPx = 214;

    private string? TileSrcSet => Item.TileImageSrcSet ?? MediaTileArtworkUrl.SrcSetForDrawnSize(CardImageUrl, TileWidthPx);

    private string StandInTooltip => string.IsNullOrWhiteSpace(Item.StandInRetryAfter)
        ? L["MediaTile_StandIn_Tooltip"].Value
        : $"{L["MediaTile_StandIn_Tooltip"].Value} {L["MediaTile_StandIn_NextCheck", Item.StandInRetryAfter].Value}";

    // A group shows its own cover; with none, the first cover of what it holds (as the Series tile always did). Nothing at all is the plain fallback.
    private string CardImageUrl => IsGroup
        ? StringHelpers.FirstNonBlank(Item.TileImageUrl, Item.CoverUrl, Item.ArtworkStackItems.Select(stack => stack.ImageUrl).Concat(Item.PreviewImages).FirstOrDefault(url => !string.IsNullOrWhiteSpace(url))) ?? string.Empty
        : Item.TileImageUrl ?? string.Empty;

    private bool HasArtworkSurface => ShowBrandLogo || ShowCollectionBanner || !string.IsNullOrWhiteSpace(CardImageUrl) || ShowPreviewStack;

    private bool ShowTileLogo => Item.SurfaceKind == MediaTileSurfaceKind.BannerLandscape && !ShowPreviewStack && !string.IsNullOrWhiteSpace(Item.LogoUrl);

    private IReadOnlyList<string> PreviewImages => _previewImages;

    private string TileImageFitClass => Item.TileImageFitMode == MediaTileImageFitMode.Contain ? "is-contained" : "is-fill";

    private bool SupportsCompletion => !IsGroup && Item.Subject != DisplaySubjectKind.TvShow && Item.Presentation != MediaTilePresentation.Album && Item.MediaKind is "Movie" or "TV" or "Book" or "Comic" or "Audiobook";

    private bool ShowsEpisodeCaption => ShowEpisodeText && Item.Subject == DisplaySubjectKind.TvEpisode && !string.IsNullOrWhiteSpace(EpisodeShowCaption);

    private string? EpisodeShowCaption => Item.EpisodeContext?.ShowTitle ?? Item.Subtitle;

    private string FallbackIcon => IsGroup ? AppMaterialIcons.Outlined.CollectionsBookmark : Item.Presentation switch
    {
        MediaTilePresentation.Album => AppMaterialIcons.Filled.Album,
        MediaTilePresentation.Artist => AppMaterialIcons.Filled.Person,
        MediaTilePresentation.MovieSeries or MediaTilePresentation.TvSeries => AppMaterialIcons.Filled.Movie,
        MediaTilePresentation.ComicSeries => AppMaterialIcons.Filled.AutoStories,
        MediaTilePresentation.AudiobookSeries => AppMaterialIcons.Filled.Headphones,
        _ => Item.MediaKind switch
        {
            "Movie" or "TV" => AppMaterialIcons.Filled.Movie,
            "Music" => AppMaterialIcons.Filled.Album,
            "Audiobook" => AppMaterialIcons.Filled.Headphones,
            _ => AppMaterialIcons.Filled.MenuBook,
        },
    };

    private string MediaKindLabel => Item.MediaKind switch
    {
        "Movie" => "Movie",
        "TV" => "TV",
        "Music" => "Music",
        "Audiobook" => "Audiobook",
        "Comic" => "Comic",
        "Book" => "Book",
        _ => string.IsNullOrWhiteSpace(Item.MediaKind) ? "Media" : Item.MediaKind,
    };

    private string DisplaySubtitle => Item.Subtitle ?? Item.Creator ?? string.Empty;

    protected override void OnParametersSet()
    {
        _previewImages = Item.PreviewImages
            .Where(image => !string.IsNullOrWhiteSpace(image))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(5)
            .ToList();
    }

    private string DetailsNavigationUrl => IsGroup
        ? StringHelpers.FirstNonBlank(Item.DetailsNavigationUrl, Item.NavigationUrl, Item.PrimaryNavigationUrl) ?? "/"
        : Item.DetailsNavigationUrl ?? Item.NavigationUrl;

    // A group's name and kind are not on the art, so the link says both ("Dune Saga, Series") and what it holds.
    private string DetailsActionAriaLabel => IsGroup
        ? GroupAccessibleLabel
        : $"View details for {Item.Title}" + (Item.IsSettling ? ". Still being matched" : string.Empty);

    private string GroupAccessibleLabel
    {
        get
        {
            var counts = string.Join(", ", Item.MediaCounts.Where(count => count.Count > 0).Select(count => $"{count.Count} {count.Label.ToLowerInvariant()}"));
            var label = L["MediaGroupTile_Label", Item.Title, GroupKindWord].Value;
            return counts.Length == 0 ? label : $"{label}, {counts}";
        }
    }

    // A series presentation reads as a Series whichever composer built the tile.
    private string GroupKindWord => (Item.GroupKind == MediaTileGroupKind.Collection
        && Item.Presentation is MediaTilePresentation.MovieSeries or MediaTilePresentation.BookSeries
            or MediaTilePresentation.ComicSeries or MediaTilePresentation.AudiobookSeries
            ? MediaTileGroupKind.Series
            : Item.GroupKind) switch
    {
        MediaTileGroupKind.Series => L["MediaGroupTile_KindSeries"],
        MediaTileGroupKind.Universe => L["MediaGroupTile_KindUniverse"],
        MediaTileGroupKind.List => L["MediaGroupTile_KindList"],
        MediaTileGroupKind.Set => L["MediaGroupTile_KindSet"],
        _ => L["MediaGroupTile_KindCollection"],
    };

    private void OpenDetails()
    {
        // The details page draws its hero from what this tile already knows instead of showing empty boxes.
        Services.GetService<MediaEngine.Web.Services.Navigation.DetailPreviewState>()?.Set(new MediaEngine.Web.Services.Navigation.DetailPreview(
            new[] { Item.Id, Item.WorkId ?? Guid.Empty, Item.CollectionId ?? Guid.Empty }.Where(id => id != Guid.Empty).ToList(),
            Item.EpisodeContext?.ShowTitle ?? Item.Title,
            Item.PreviewImageUrl ?? Item.TileImageUrl,
            Item.LogoUrl,
            Item.HeroBackgroundImageUrl));
        Nav.NavigateTo(DetailsNavigationUrl);
    }

    private static string GetStackImageClass(int index) => $"media-tile-stack-image media-tile-stack-image-{Math.Min(index, 2)}";
}
