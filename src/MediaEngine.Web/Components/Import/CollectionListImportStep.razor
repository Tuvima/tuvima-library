@namespace MediaEngine.Web.Components.Import
@using MediaEngine.Contracts.Collections
@using MediaEngine.Contracts.Import
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient Api

@* New collection > From a list (Collections and lists spec 4b, 4d, 4h): drop an export or paste titles, see how much of it the Library
   owns, tick the shelves to make a collection for each, fix the titles Library could not match, and choose how the list is followed.
   Nothing is saved here; the last step of the flow creates the collection(s) from this draft. *@
<div class="list-step" data-list-step>
    <ImportPanel AllowedKinds="@AllowedKinds"
                 ShowPaste="true"
                 ShowPreview="false"
                 Prompt="Drop your list here, or click to choose a file"
                 OnRecognised="OnRecognisedAsync"
                 OnCleared="OnClearedAsync" />

    @if (Draft.HasList && Draft.Current is { } current)
    {
        <section class="list-step__summary" data-list-summary aria-live="polite">
            <div class="list-step__source">
                <AppChip Text="@current.SourceLabel" Tone="AppUiTone.Primary" />
                <span>@current.SourceName</span>
            </div>
            <div class="list-step__owned">
                <span class="list-step__owned-big" data-list-owned>You own @Draft.OwnedCount of @Draft.EntryCount</span>
                @if (Draft.OwnedCount == 0)
                {
                    <p class="list-step__hint">None of these are in your library yet, so there is nothing to put in a collection.</p>
                }
            </div>
            @if (current.Owned.Count > 0 && Draft.CollectionCount == 1)
            {
                <ul class="list-step__covers" aria-label="Some of the titles you own from this list">
                    @foreach (var owned in current.Owned.Take(8))
                    {
                        <li title="@owned.Title">@owned.Title</li>
                    }
                </ul>
            }
        </section>

        @if (Draft.Whole is { Shelves.Count: > 0 } whole)
        {
            <section class="list-step__shelves" data-list-shelves aria-label="Shelves">
                <h4 class="list-step__heading">Shelves</h4>
                <p class="list-step__hint">Tick the shelves you want. Each one becomes its own collection. Leave them all unticked for one collection of the whole list.</p>
                @foreach (var shelf in whole.Shelves)
                {
                    var name = shelf.Name;
                    <AppCheckboxRow Label="@name"
                                    Description="@($"{shelf.EntryCount} title{(shelf.EntryCount == 1 ? "" : "s")}, you own {shelf.OwnedCount}")"
                                    Value="@Draft.Shelves.Contains(name)"
                                    ValueChanged="@(on => OnShelfChangedAsync(name, on))" />
                }
            </section>
        }

        <section class="list-step__choices" aria-label="How the list is followed">
            <h4 class="list-step__heading">How it is followed</h4>
            <ListChoicesPanel Order="@Draft.Order"
                              OrderChanged="@(value => ChangeAsync(() => Draft.Order = value))"
                              SyncMode="@Draft.SyncMode"
                              SyncModeChanged="@(value => ChangeAsync(() => Draft.SyncMode = value))"
                              ShowRefresh="false" />
        </section>

        @if (Unresolved.Count > 0)
        {
            <section class="list-step__unmatched" data-list-unmatched aria-label="Titles that could not be matched">
                <h4 class="list-step__heading">Couldn't match (@Unresolved.Count(entry => entry.Status == ListImportChoices.StatusUnmatched))</h4>
                <p class="list-step__hint">Search your library and pick the right title, or ignore the ones you do not own.</p>
                @foreach (var entry in Unresolved.Take(MaximumShown))
                {
                    <ListEntryFixRow @key="entry.Position"
                                     Entry="entry"
                                     Disabled="@_busy"
                                     OnPick="PickAsync"
                                     OnIgnore="IgnoreAsync"
                                     OnRestore="RestoreAsync" />
                }
                @if (Unresolved.Count > MaximumShown)
                {
                    <p class="list-step__hint">and @(Unresolved.Count - MaximumShown) more. They stay off the collection until Library owns them.</p>
                }
            </section>
        }
    }
</div>

@code {
    private const int MaximumShown = 40;
    private static readonly IReadOnlyList<string> AllowedKinds = [ImportKinds.CollectionList];
    private bool _busy;

    [Parameter, EditorRequired] public ListImportDraft Draft { get; set; } = new();

    /// <summary>Raised whenever the draft changes, so the flow can update its footer and Next button.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private IReadOnlyList<CollectionListEntryDto> Unresolved =>
        Draft.Current?.Entries.Where(entry => entry.Status != ListImportChoices.StatusMatched).ToList() ?? [];

    private async Task OnRecognisedAsync(ImportRecognition recognition)
    {
        if (recognition.Preview.List is not { } list)
            return;

        Draft.Set(recognition, list);
        await OnChanged.InvokeAsync();
    }

    private async Task OnClearedAsync()
    {
        Draft.Clear();
        await OnChanged.InvokeAsync();
    }

    private async Task OnShelfChangedAsync(string shelf, bool selected)
    {
        Draft.SetShelf(shelf, selected);
        await RefreshPreviewAsync();
    }

    private async Task ChangeAsync(Action change)
    {
        change();
        await OnChanged.InvokeAsync();
    }

    private async Task PickAsync((CollectionListEntryDto Entry, Guid WorkId) pick)
    {
        Draft.Pick(pick.Entry.Position, pick.WorkId);
        await RefreshPreviewAsync();
    }

    private async Task IgnoreAsync(CollectionListEntryDto entry)
    {
        Draft.Ignore(entry.Position);
        await RefreshPreviewAsync();
    }

    private async Task RestoreAsync(CollectionListEntryDto entry)
    {
        Draft.Restore(entry.Position);
        await RefreshPreviewAsync();
    }

    // The Engine reads the list again with the shelf and the hand fixes applied, so the counts always match what Save will make.
    private async Task RefreshPreviewAsync()
    {
        if (Draft.Recognition is not { } recognition)
            return;

        _busy = true;
        try
        {
            var preview = await Api.PreviewCollectionListAsync(new ListImportPreviewRequest
            {
                FileName = recognition.FileName,
                ContentBase64 = recognition.ContentBase64,
                Text = recognition.Text,
                Shelf = Draft.PreviewShelf,
                Overrides = Draft.Overrides,
            });
            if (preview is not null)
                Draft.Current = preview;
        }
        finally
        {
            _busy = false;
        }

        await OnChanged.InvokeAsync();
    }
}
