@namespace MediaEngine.Web.Components.Import
@using MediaEngine.Contracts.Import
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using Microsoft.AspNetCore.Components.Forms
@inject IEngineApiClient Api
@inject ILogger<ImportPanel> Logger
@inject IStringLocalizer<SharedStrings> L

@* The shared Import (Collections and lists spec D17): one place to drop a file or paste text. The Engine recognises what it is and
   the preview answers in that kind's own words. It is used by New collection > From a list, the player's bookmark pack import and
   Settings > Profile > Import, each with the kinds that place can use (AllowedKinds); a file of another kind still gets its own
   preview and a line on where it goes. Files stay on this machine: nothing here opens a connection other than to the Engine. *@
<section class="import-panel" data-import-panel aria-label="@L["ImportPanel_Import"].Value">
    @if (ShowPaste)
    {
        @* One field (mock): drop a file, paste a link, or paste the titles. The file chooser sits under the field, so a click or a
           drop on the box around the field takes a file; a paste or Enter in the field reads the text. *@
        <div class="import-panel__drop import-panel__drop--field @(_busy ? "is-busy" : null)" data-import-drop data-import-field>
            <InputFile class="tl-file-drop__input" OnChange="OnFileChosenAsync" accept="@AcceptAttribute" disabled="@_busy" aria-label="@L["ImportPanel_ChooseAFile"].Value" />
            <div class="import-panel__field" @ondragover="KeepDropOnPage" @ondragover:preventDefault @ondrop="KeepDropOnPage" @ondrop:preventDefault>
                <AppTextarea Value="@(_fileName ?? _pasted)"
                             ValueChanged="OnFieldChangedAsync"
                             OnKeyDown="OnFieldKeyDownAsync"
                             Placeholder="@DropTitle"
                             Lines="2"
                             Disabled="@_busy"
                             aria-label="@DropTitle" />
            </div>
            <span class="import-panel__accepts">@AcceptText</span>
        </div>
    }
    else
    {
        <div class="import-panel__drop @(_busy ? "is-busy" : null)" data-import-drop>
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.UploadFile" />
            <strong>@DropTitle</strong>
            <span class="import-panel__accepts">@AcceptText</span>
            <InputFile class="tl-file-drop__input" OnChange="OnFileChosenAsync" accept="@AcceptAttribute" disabled="@_busy" aria-label="@L["ImportPanel_ChooseAFile"].Value" />
        </div>
    }

    <p class="import-panel__privacy" data-import-privacy>@(_shown?.Preview.PrivacyNote ?? ImportPrivacy.FilesStayOnThisMachine)</p>

    @if (_busy)
    {
        <div class="import-panel__busy" role="status"><AppSpinner Indeterminate="true" Size="AppSize.Small" /><span>@L["ImportPanel_Reading"]</span></div>
    }

    @if (_error is not null)
    {
        <AppAlert Tone="AppUiTone.Warning" Dense="true" data-import-error>
            @_error
            @if (_errorLinkHref is not null)
            {
                <a class="import-panel__link" href="@_errorLinkHref" data-import-error-link>@(_errorLinkLabel ?? L["ImportPanel_OpenSettings"].Value)</a>
            }
        </AppAlert>
    }

    @if (_shown is { } shown && ShowPreview)
    {
        <ImportPreviewFrame Preview="shown.Preview">
            @if (!IsAllowed(shown.Preview))
            {
                <AppAlert Tone="AppUiTone.Info" Dense="true" data-import-elsewhere>
                    @L["ImportPanel_NotForThisStep", ImportKindGuidance.KindNoun(shown.Preview.Kind), ImportKindGuidance.WhereItGoes(shown.Preview.Kind)]
                </AppAlert>
            }
            else if (shown.Preview.CanApply && AllowApply)
            {
                <div class="import-panel__actions">
                    <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@_busy" OnClick="@(() => ApplyAsync(shown))">
                        @(shown.Preview.ApplyLabel ?? L["ImportPanel_Add"].Value)
                    </AppButton>
                </div>
            }

            @if (Actions is not null && IsAllowed(shown.Preview))
            {
                <div class="import-panel__actions">@Actions(shown)</div>
            }

            @if (_applied is not null)
            {
                <AppAlert Tone="@(_appliedOk ? AppUiTone.Success : AppUiTone.Warning)" Dense="true" data-import-applied>@_applied</AppAlert>
            }
        </ImportPreviewFrame>
    }
</section>

@code {
    private string _pasted = string.Empty;
    private string? _fileName;
    private bool _busy;
    private string? _error;
    private string? _errorLinkHref;
    private string? _errorLinkLabel;
    private string? _applied;
    private bool _appliedOk;
    private ImportRecognition? _shown;

    /// <summary>The kinds this place can use. Null accepts every kind (Settings > Import).</summary>
    [Parameter] public IReadOnlyList<string>? AllowedKinds { get; set; }

    /// <summary>Offers the paste box (a list pasted as text). Off where only a file makes sense, such as a bookmark pack.</summary>
    [Parameter] public bool ShowPaste { get; set; }

    /// <summary>Shows the preview frame under the drop zone. A host that draws its own richer summary turns this off.</summary>
    [Parameter] public bool ShowPreview { get; set; } = true;

    /// <summary>Shows the Apply button for kinds that can be applied from the dialog on its own (plugin settings).</summary>
    [Parameter] public bool AllowApply { get; set; } = true;

    /// <summary>Text above the drop zone's hint. Defaults to a generic prompt.</summary>
    [Parameter] public string? Prompt { get; set; }

    /// <summary>Raised when a file of an allowed kind has been recognised.</summary>
    [Parameter] public EventCallback<ImportRecognition> OnRecognised { get; set; }

    /// <summary>Raised when the person clears the file or a new file replaces it.</summary>
    [Parameter] public EventCallback OnCleared { get; set; }

    /// <summary>Raised after a kind was applied from the dialog.</summary>
    [Parameter] public EventCallback<ImportApplyResultDto> OnApplied { get; set; }

    /// <summary>Buttons the host adds under the preview of an allowed kind (for example "Make a collection").</summary>
    [Parameter] public RenderFragment<ImportRecognition>? Actions { get; set; }

    private string DropTitle => Prompt ?? (ShowPaste ? L["ImportPanel_FieldPrompt"].Value : L["ImportPanel_DropPrompt"].Value);

    private bool Accepts(string kind) => AllowedKinds is null || AllowedKinds.Contains(kind, StringComparer.Ordinal);

    private bool IsAllowed(ImportPreviewDto preview) => !preview.Recognised || Accepts(preview.Kind);

    // One hint that names what this place takes, so the person never has to guess which exports work.
    private string AcceptText
    {
        get
        {
            if (ShowPaste && Accepts(ImportKinds.CollectionList))
                return L["ImportPanel_ListFieldHelp"].Value;

            var parts = new List<string>();
            if (Accepts(ImportKinds.CollectionList))
                parts.Add(L["ImportPanel_TakesList"].Value);
            if (Accepts(ImportKinds.PackFile))
                parts.Add(L["ImportPanel_TakesPack"].Value);
            if (Accepts(ImportKinds.BookmarkPack))
                parts.Add(L["ImportPanel_TakesBookmarkPack"].Value);
            if (Accepts(ImportKinds.PluginSettings))
                parts.Add(L["ImportPanel_TakesPluginSettings"].Value);
            return parts.Count == 0 ? string.Empty : L["ImportPanel_Takes", string.Join("; ", parts)].Value;
        }
    }

    private string? AcceptAttribute => AllowedKinds is { Count: > 0 } && AllowedKinds.All(kind => kind == ImportKinds.BookmarkPack)
        ? ".zip,application/zip"
        : ".csv,.txt,.zip,.json,text/csv,text/plain,application/zip,application/json";

    private async Task OnFileChosenAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        await ResetAsync();
        if (file.Size > ImportLimits.MaximumFileBytes)
        {
            _error = L["ImportPanel_FileTooLarge", ImportLimits.MaximumFileBytes / (1024 * 1024)].Value;
            return;
        }

        _fileName = file.Name;
        _pasted = string.Empty;
        _busy = true;
        try
        {
            await using var stream = file.OpenReadStream(ImportLimits.MaximumFileBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            await RecogniseAsync(file.Name, Convert.ToBase64String(buffer.ToArray()), null);
        }
        catch (IOException ex)
        {
            Logger.LogDebug(ex, "The chosen import file could not be read");
            _error = L["ImportPanel_ReadFailed"].Value;
        }
        finally
        {
            _busy = false;
        }
    }

    private void KeepDropOnPage()
    {
        // A file dropped on the text itself is not read; the box around the field takes files. Cancelling the drop keeps the browser on this page.
    }

    // A paste (more than one character arriving at once) reads straight away; typing waits for Enter.
    private async Task OnFieldChangedAsync(string? value)
    {
        var text = value ?? string.Empty;
        var arrived = text.Length - (_fileName ?? _pasted).Length;
        _fileName = null;
        _pasted = text;
        if (!_busy && arrived > 1 && !string.IsNullOrWhiteSpace(text))
            await ReadPastedAsync();
    }

    private async Task OnFieldKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey && !_busy && _fileName is null && !string.IsNullOrWhiteSpace(_pasted))
            await ReadPastedAsync();
    }

    private async Task ReadPastedAsync()
    {
        await ResetAsync();
        _busy = true;
        try
        {
            await RecogniseAsync("pasted-list.txt", null, _pasted);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RecogniseAsync(string fileName, string? contentBase64, string? text)
    {
        var preview = await Api.RecogniseImportAsync(new ImportRecogniseRequest
        {
            FileName = fileName,
            ContentBase64 = contentBase64,
            Text = text,
        });
        if (preview is null)
        {
            _error = Api.LastError ?? L["ImportPanel_CouldNotRead"].Value;
            return;
        }

        if (!preview.Recognised)
        {
            _error = preview.Message ?? L["ImportPanel_NotRecognized"].Value;
            // Only an address inside this app is followed (the Plugins page for a source that is off).
            if (preview.MessageLinkHref is { } href && href.StartsWith('/') && !href.StartsWith("//", StringComparison.Ordinal))
            {
                _errorLinkHref = href;
                _errorLinkLabel = preview.MessageLinkLabel;
            }

            return;
        }

        _shown = new ImportRecognition(fileName, contentBase64, text, preview);
        if (IsAllowed(preview))
            await OnRecognised.InvokeAsync(_shown);
    }

    private async Task ApplyAsync(ImportRecognition recognition)
    {
        _busy = true;
        try
        {
            var result = await Api.ApplyImportAsync(new ImportApplyRequest
            {
                Kind = recognition.Preview.Kind,
                FileName = recognition.FileName,
                ContentBase64 = recognition.ContentBase64,
                Text = recognition.Text,
            });
            _appliedOk = result?.Applied == true;
            _applied = result?.Message ?? Api.LastError ?? L["ImportPanel_CouldNotAdd"].Value;
            if (result is not null)
                await OnApplied.InvokeAsync(result);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResetAsync()
    {
        var hadFile = _shown is not null;
        _error = null;
        _errorLinkHref = null;
        _errorLinkLabel = null;
        _applied = null;
        _shown = null;
        if (hadFile)
            await OnCleared.InvokeAsync();
    }
}
