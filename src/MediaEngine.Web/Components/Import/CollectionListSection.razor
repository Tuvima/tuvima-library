@namespace MediaEngine.Web.Components.Import
@using MediaEngine.Contracts.Collections
@using MediaEngine.Contracts.Import
@using MediaEngine.Web.Components.MediaEditor
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient Api
@inject IAppToastService Toast
@inject IStringLocalizer<SharedStrings> L

@* The "From a list" part of a list collection's Contents tab (Collections and lists spec D5, D6, 4h): where the list came from, how
   much of it the Library owns, how it is followed, and the titles that could not be matched, each fixable by hand. Titles a person
   added to the collection by hand are never touched by the list. A collection that was not made from a list shows nothing. *@
@if (_source is { } source)
{
    <MediaEditorPanel Title="@L["ListSection_Title"].Value" Description="@($"{source.SourceLabel}: {source.SourceName}")">
        <div class="list-section" data-list-section>
            <div class="list-section__owned">
                <strong data-list-section-owned>@L["ListStep_YouOwn", source.OwnedCount, source.EntryCount]</strong>
                <span>@(source.LastRefreshedAt is { } at ? $"Last checked {at.LocalDateTime:d MMM yyyy}." : "Not checked yet.")</span>
            </div>

            <ListChoicesPanel Order="@source.Order"
                              OrderChanged="@(value => SaveSettingsAsync(order: value))"
                              SyncMode="@source.SyncMode"
                              SyncModeChanged="@(value => SaveSettingsAsync(sync: value))"
                              Refresh="@source.Refresh"
                              RefreshChanged="@(value => SaveSettingsAsync(refresh: value))"
                              ShowRefresh="@source.IsWebSource"
                              Disabled="@_busy" />

            <div class="list-section__actions">
                <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Primary" StartIcon="@AppMaterialIcons.Outlined.Sync"
                           Disabled="@_busy" OnClick="MatchAgainAsync">@L["ListSection_MatchAgain"]</AppButton>
                <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" StartIcon="@AppMaterialIcons.Outlined.UploadFile"
                           Disabled="@_busy" OnClick="@(() => _updating = !_updating)">@L["ListSection_Update"]</AppButton>
            </div>

            @if (_updating)
            {
                <ImportPanel ShowPaste="true" ShowPreview="false" AllowedKinds="@AllowedKinds"
                             Prompt="@L["ListSection_UpdatePrompt"].Value" OnRecognised="UpdateFromFileAsync" />
            }

            @if (source.Unmatched.Count > 0)
            {
                <div class="list-section__unmatched" data-list-section-unmatched>
                    <h4 class="list-section__heading">@L["ListStep_CouldntMatch", source.UnmatchedCount]</h4>
                    <p class="list-section__hint">@L["ListStep_FixHelp"]</p>
                    @foreach (var entry in source.Unmatched.Take(MaximumShown))
                    {
                        <ListEntryFixRow @key="entry.Id" Entry="entry" Disabled="@_busy"
                                         OnPick="PickAsync" OnIgnore="IgnoreAsync" OnRestore="RestoreAsync" />
                    }
                    @if (source.Unmatched.Count > MaximumShown)
                    {
                        <p class="list-section__hint">@L["ListSection_AndMore", source.Unmatched.Count - MaximumShown]</p>
                    }
                </div>
            }
        </div>
    </MediaEditorPanel>
}

@code {
    private const int MaximumShown = 40;
    private static readonly IReadOnlyList<string> AllowedKinds = [ImportKinds.CollectionList];
    private CollectionListSourceDto? _source;
    private bool _busy;
    private bool _updating;

    [Parameter, EditorRequired] public Guid CollectionId { get; set; }

    [Parameter] public Guid? ProfileId { get; set; }

    /// <summary>Raised after the list changed what the collection holds, so the editor reloads its item list.</summary>
    [Parameter] public EventCallback OnContentsChanged { get; set; }

    /// <summary>Raised once the list source has been read. True when the collection was made from a list.</summary>
    [Parameter] public EventCallback<bool> OnLoaded { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_source is null || _source.CollectionId != CollectionId)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _source = await Api.GetCollectionListSourceAsync(CollectionId);
        await OnLoaded.InvokeAsync(_source is not null);
    }

    private async Task SaveSettingsAsync(string? order = null, string? sync = null, string? refresh = null)
    {
        if (_source is null)
            return;

        _busy = true;
        try
        {
            var ok = await Api.UpdateCollectionListSettingsAsync(CollectionId, new ListSourceSettingsRequest
            {
                Order = order ?? _source.Order,
                Refresh = refresh ?? _source.Refresh,
                SyncMode = sync ?? _source.SyncMode,
                ProfileId = ProfileId,
            });
            if (!ok)
            {
                Toast.Add(Api.LastError ?? "The list settings could not be saved.", AppSeverity.Error);
                return;
            }

            await LoadAsync();
            await OnContentsChanged.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MatchAgainAsync()
    {
        _busy = true;
        try
        {
            var result = await Api.RefreshCollectionListAsync(CollectionId, new ListRefreshRequest { ProfileId = ProfileId });
            if (result is null)
            {
                Toast.Add(Api.LastError ?? "The list could not be checked.", AppSeverity.Error);
                return;
            }

            Toast.Add(
                result.WillTryAgain
                    ? L["ListSection_WillTryAgain", _source?.SourceLabel ?? string.Empty].Value
                    : $"Checked the list: you own {result.Matched}, {result.Unmatched} still unmatched.",
                result.WillTryAgain ? AppSeverity.Warning : AppSeverity.Success);
            await LoadAsync();
            await OnContentsChanged.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UpdateFromFileAsync(ImportRecognition recognition)
    {
        _busy = true;
        try
        {
            var result = await Api.RefreshCollectionListAsync(CollectionId, new ListRefreshRequest
            {
                FileName = recognition.FileName,
                ContentBase64 = recognition.ContentBase64,
                Text = recognition.Text,
                ProfileId = ProfileId,
            });
            if (result is null)
            {
                Toast.Add(Api.LastError ?? "The newer file could not be used.", AppSeverity.Error);
                return;
            }

            Toast.Add($"Updated from the newer file: {result.Added} added, {result.Removed} left the list.", AppSeverity.Success);
            _updating = false;
            await LoadAsync();
            await OnContentsChanged.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private Task PickAsync((CollectionListEntryDto Entry, Guid WorkId) pick) =>
        FixAsync(pick.Entry, new ListEntryFixRequest { Action = "pick", WorkId = pick.WorkId, ProfileId = ProfileId });

    private Task IgnoreAsync(CollectionListEntryDto entry) =>
        FixAsync(entry, new ListEntryFixRequest { Action = "ignore", ProfileId = ProfileId });

    private Task RestoreAsync(CollectionListEntryDto entry) =>
        FixAsync(entry, new ListEntryFixRequest { Action = "restore", ProfileId = ProfileId });

    private async Task FixAsync(CollectionListEntryDto entry, ListEntryFixRequest request)
    {
        if (entry.Id is not { } entryId)
            return;

        _busy = true;
        try
        {
            if (!await Api.FixCollectionListEntryAsync(CollectionId, entryId, request))
            {
                Toast.Add(Api.LastError ?? "That could not be saved.", AppSeverity.Error);
                return;
            }

            await LoadAsync();
            await OnContentsChanged.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
