@namespace MediaEngine.Web.Components.Browse
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Contracts.Display
@using MediaEngine.Web.Services.MediaTiles

@if (Items.Count > 0)
{
    <section class="compact-continue" aria-label="@Title">
        <div class="compact-continue__heading">
            <AppMaterialIcon Icon="@Icon" />
            <div>
                <strong>@Title</strong>
                <span>@ItemCountLabel</span>
            </div>
        </div>

        <div class="compact-continue__items">
            @foreach (var item in Items.Take(3))
            {
                <a @key="item.RenderKey" class="compact-continue__item" href="@(item.DetailsNavigationUrl ?? item.NavigationUrl)">
                    <div class="compact-continue__art">
                        @if (!string.IsNullOrWhiteSpace(ArtworkUrl(item)))
                        {
                            <img src="@MediaTileArtworkUrl.ForDrawnSize(ArtworkUrl(item), 58)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(ArtworkUrl(item), 58)" data-artwork-purpose="continue-thumbnail" alt="" loading="lazy" decoding="async" />
                        }
                        <AppArtworkProgress State="@item.ContinuationState" Percent="@item.ProgressPct" MediaKind="@item.MediaKind" RemainingSeconds="@item.RemainingSeconds" />
                        else
                        {
                            <AppMaterialIcon Icon="@Icon" />
                        }
                    </div>
                    <div class="compact-continue__copy">
                        <strong>@Identity(item)</strong>
                        @if (!string.IsNullOrWhiteSpace(item.EpisodeContext?.ShowTitle ?? item.Subtitle))
                        {
                            <span>@(item.EpisodeContext?.ShowTitle ?? item.Subtitle)</span>
                        }
                    </div>
                </a>
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "Continue";
    [Parameter, EditorRequired] public IReadOnlyList<MediaTileViewModel> Items { get; set; } = [];

    private string ItemCountLabel => Items.Count == 1 ? "1 item" : $"{Items.Count} items";

    private string Icon => Title.Contains("Read", StringComparison.OrdinalIgnoreCase)
        ? AppMaterialIcons.Outlined.MenuBook
        : Title.Contains("Listen", StringComparison.OrdinalIgnoreCase)
            ? AppMaterialIcons.Outlined.Headphones
            : AppMaterialIcons.Outlined.PlayCircle;

    // Drawn 44x58px (CompactContinueStrip.razor.css); the picture is sized where it is drawn. Only Engine
    // pictures are shown: a provider's web link never reaches the browser (local-first), the tile shows its fallback.
    private static string? ArtworkUrl(MediaTileViewModel item)
    {
        var url = item.TileImageUrl ?? item.CoverUrl ?? item.PreviewImageUrl;
        return url is not null && MediaTileArtworkUrl.SupportsRenditions(url) ? url : null;
    }

    private static string Identity(MediaTileViewModel item) => item.EpisodeContext is { } episode
        ? $"S{episode.SeasonNumber} E{episode.EpisodeNumber} · {episode.EpisodeTitle}" : item.Title;

}
