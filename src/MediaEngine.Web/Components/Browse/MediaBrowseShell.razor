@namespace MediaEngine.Web.Components.Browse
@using System.Globalization
@using System.Security.Cryptography
@using System.Text
@using MediaEngine.Contracts.Details
@using MediaEngine.Contracts.Display
@using MediaEngine.Contracts.Realtime
@using MediaEngine.Domain.Enums
@using MediaEngine.Web.Components.Details
@using MediaEngine.Web.Components.Listen
@using MediaEngine.Web.Components.Library
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Branding
@using MediaEngine.Web.Services.MediaTiles
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Navigation
@using MediaEngine.Web.Services.Playback

@implements IDisposable

@inject IEngineApiClient ApiClient
@inject IServiceProvider Services
@inject ListEditLauncher EditLauncher
@inject EditorHost Editor
@inject MediaEngine.Web.Services.Theming.DeviceContextService DeviceContext
@inject UIOrchestratorService Orchestrator
@inject SavedItemService SavedItems
@inject PlaybackSessionController Playback
@inject ListenAudioDragService AudioDrag
@inject NavigationManager Nav
@inject ILogger<MediaBrowseShell> Logger
@inject UniverseStateContainer StateContainer
@inject IStringLocalizer<SharedStrings> L

<BrowseShellStyles />

<div class="@RootClass" @onclick="CloseFacetMenuOnBackgroundAsync">
    @if (_notice is not null)
    {
        @* What the last action had to say (a refusal, a failure): it stays at the top of the list until the next action or the close button. *@
        <AppAlert Tone="@_noticeTone" Urgent="_noticeUrgent" Dense="true" ShowCloseIcon="true" CloseIconClicked="ClearNotice" data-browse-notice="true">@_notice</AppAlert>
    }
    <div class="browse-shell__toolbar-anchor">
        <div class="browse-shell__toolbar-panel">
            @if (ShowHeaderRow)
            {
                <div class="browse-shell__tab-row">
                    @if (ShowTitleBlock)
                    {
                        <div class="browse-shell__title-block">
                            <div class="browse-shell__title-eyebrow">@Preset.Title</div>
                            <div class="browse-shell__title-text">@CurrentTab.Label</div>
                        </div>
                    }

                    @if (ShowTabs)
                    {
                        <div class="browse-shell__tabs-frame">
                            <AppTabs ActivePanelIndex="@ActiveBrowseTabIndex"
                                     ActivePanelIndexChanged="OnBrowseTabChanged"
                                     Rounded="false"
                                     Border="false"
                                     Elevation="0"
                                     Class="browse-shell__tabs">
                                @foreach (var tab in Preset.Tabs)
                                {
                                    <AppTabPanel @key="tab.Id" Text="@tab.Label" Icon="@MediaEngine.Web.Components.Pages.MediaLaneConfigurationBuilder.ResolveTabIcon(tab)" />
                                }
                            </AppTabs>
                        </div>
                    }
                </div>
            }

            @if (CurrentTab.LibraryChips.Count > 0)
            {
                @* A gathering tab (Videos) narrows to one library with a chip each; only libraries this profile may see are listed. *@
                <div class="browse-shell__library-chips" role="group" aria-label="@($"{CurrentTab.Label} libraries")" data-library-chips>
                    <AppChip Text="@L["ApiKeys_AllKeysRevoked"].Value"
                             Variant="@(_libraryChip is null ? AppVariant.Filled : null)"
                             Color="@(_libraryChip is null ? AppColor.Primary : null)"
                             aria-pressed="@(_libraryChip is null ? "true" : "false")"
                             OnClick="@(() => OnLibraryChipChanged(null))" />
                    @foreach (var chip in CurrentTab.LibraryChips)
                    {
                        <AppChip @key="chip.Id"
                                 Text="@chip.Label"
                                 Variant="@(_libraryChip == chip.Id ? AppVariant.Filled : null)"
                                 Color="@(_libraryChip == chip.Id ? AppColor.Primary : null)"
                                 aria-pressed="@(_libraryChip == chip.Id ? "true" : "false")"
                                 OnClick="@(() => OnLibraryChipChanged(chip.Id))" />
                    }
                </div>
            }

            @if (ActiveFolders.Count >= 2)
            {
                @* The Folders filter (Libraries v3 D18): a library with two or more folders can be narrowed to the titles of one. *@
                <div class="browse-shell__folders" data-folders-filter>
                    <AppSelect Label="@L["MediaBrowseShell_Folders"].Value"
                               AriaLabel="@L["MediaBrowseShell_Folders"].Value"
                               Value="@(ActiveFolderId ?? string.Empty)"
                               ValueChanged="@((string? value) => OnFolderChanged(value))"
                               Options="@FolderOptions"
                               Size="AppControlSize.Compact" />
                </div>
            }

            <div class="browse-shell__filter-surface">
                @if (!UsePhoneSongsHeader)
                {
                    @* The phone Songs list has its own search in the Songs header (music table spec D21). *@
                    <div class="browse-shell__filter-search-row">
                        <AppTextField @key="_searchInputVersion"
                                      T="string"
                                      @bind-Value="_searchText"
                                      Placeholder="@SearchPlaceholder"
                                      Variant="AppVariant.Outlined"
                                      Adornment="AppAdornment.Start"
                                      AdornmentIcon="@AppMaterialIcons.Outlined.Search"
                                      Immediate="true"
                                      DebounceInterval="250"
                                      OnDebounceIntervalElapsed="OnSearchChanged"
                                      Class="browse-shell__search" />
                    </div>
                }

                <div class="browse-shell__filter-lower-row">
                    <div class="browse-shell__control-group browse-shell__control-group--browse">
                        <span class="browse-shell__control-label">@L["Common_BrowseAs"]</span>
                        <AppBrowseModeSelector Options="@CurrentTab.GroupingOptions"
                                               Value="@_grouping"
                                               ValueChanged="SwitchGroupingAsync"
                                               AriaLabel="@($"Browse {CurrentTab.Label} as")" />
                    </div>

                    <BrowseFilterSheet ActiveCount="@ActiveFilterChips.Count"
                                       ResultLabel="@ResultCountLabel"
                                       OnClear="ClearFiltersAsync">
                    <ChildContent Context="inSheet">
                    <div class="browse-shell__control-group browse-shell__control-group--filters @(inSheet ? "is-sheet" : "")">
                        <span class="browse-shell__control-label">@L["Common_FilterBy"]</span>
                        <div class="browse-shell__filter-row">
                            <div class="browse-shell__filter-selects">
                                @if (GenreFacets.Count > 0 && SupportsFacetFilters)
                                {
                                     <BrowseMultiSelect Label="@L["Common_Filters"].Value"
                                                        ButtonLabel="Genres"
                                                        MenuKey="genres"
                                                        OpenMenuKey="@_openFacetMenuKey"
                                                        OpenMenuKeyChanged="OnOpenFacetMenuChanged"
                                                        Icon="@AppMaterialIcons.Outlined.LocalOffer"
                                                       Options="GenreFacets"
                                                       SelectedValues="SelectedGenres"
                                                       SelectedValuesChanged="OnGenresChanged"
                                                       SearchPlaceholder="Search genres..."
                                                       AllLabel="All genres"
                                                       AllHelpText="No genre filter applied"
                                                       EmptyText="@L["MediaBrowseShell_NoMatchingGenres"].Value"
                                                       HelpText="Select one or more genres to filter results."
                                                       ShowLabel="false"
                                                       Class="browse-shell__multi-select browse-shell__multi-select--genres" />
                                }

                                @if (SupportsFacetFilters)
                                {
                                     <BrowseMultiSelect Label="@CreatorFilterLabel"
                                                        ButtonLabel="@AllCreatorLabel"
                                                        MenuKey="creators"
                                                        OpenMenuKey="@_openFacetMenuKey"
                                                        OpenMenuKeyChanged="OnOpenFacetMenuChanged"
                                                        Icon="@AppMaterialIcons.Outlined.PersonOutline"
                                                       Options="CreatorFacets"
                                                       SelectedValues="SelectedCreators"
                                                       SelectedValuesChanged="OnCreatorsChanged"
                                                       SearchPlaceholder="@CreatorSearchPlaceholder"
                                                       AllLabel="@AllCreatorLabel"
                                                       AllHelpText="No creator filter applied"
                                                       EmptyText="@L["MediaBrowseShell_NoMatchingCreators"].Value"
                                                       ShowLabel="false"
                                                       Class="browse-shell__multi-select browse-shell__multi-select--creator" />

                                     <BrowseMultiSelect Label="@L["Common_Year"].Value"
                                                        ButtonLabel="All years"
                                                        MenuKey="years"
                                                        OpenMenuKey="@_openFacetMenuKey"
                                                        OpenMenuKeyChanged="OnOpenFacetMenuChanged"
                                                        Icon="@AppMaterialIcons.Outlined.CalendarMonth"
                                                       Options="YearFacets"
                                                       SelectedValues="SelectedYears"
                                                       SelectedValuesChanged="OnYearsChanged"
                                                       SearchPlaceholder="Search years..."
                                                       AllLabel="All years"
                                                       AllHelpText="No year filter applied"
                                                       EmptyText="@L["MediaBrowseShell_NoMatchingYears"].Value"
                                                       ShowLabel="false"
                                                       Class="browse-shell__multi-select browse-shell__multi-select--year" />

                                     @if (VibeFacets.Count > 0)
                                     {
                                         <BrowseMultiSelect Label="@L["MediaBrowseShell_Vibe"].Value"
                                                            ButtonLabel="Vibes"
                                                            MenuKey="vibes"
                                                            OpenMenuKey="@_openFacetMenuKey"
                                                            OpenMenuKeyChanged="OnOpenFacetMenuChanged"
                                                            Icon="@AppMaterialIcons.Outlined.AutoAwesome"
                                                           Options="VibeFacets"
                                                           SelectedValues="SelectedVibes"
                                                           SelectedValuesChanged="OnVibesChanged"
                                                           SearchPlaceholder="Search vibes..."
                                                           AllLabel="All vibes"
                                                           AllHelpText="No vibe filter applied"
                                                           EmptyText="@L["MediaBrowseShell_NoMatchingVibes"].Value"
                                                           HelpText="Suggested by Local AI. Select one or more to filter results."
                                                           ShowLabel="false"
                                                           Class="browse-shell__multi-select browse-shell__multi-select--vibe" />
                                     }

                                     @if (ThemeFacets.Count > 0)
                                     {
                                         <BrowseMultiSelect Label="@L["Common_Theme"].Value"
                                                            ButtonLabel="Themes"
                                                            MenuKey="themes"
                                                            OpenMenuKey="@_openFacetMenuKey"
                                                            OpenMenuKeyChanged="OnOpenFacetMenuChanged"
                                                            Icon="@AppMaterialIcons.Outlined.AutoAwesome"
                                                           Options="ThemeFacets"
                                                           SelectedValues="SelectedThemes"
                                                           SelectedValuesChanged="OnThemesChanged"
                                                           SearchPlaceholder="Search themes..."
                                                           AllLabel="All themes"
                                                           AllHelpText="No theme filter applied"
                                                           EmptyText="@L["MediaBrowseShell_NoMatchingThemes"].Value"
                                                           HelpText="Suggested by Local AI. Select one or more to filter results."
                                                           ShowLabel="false"
                                                           Class="browse-shell__multi-select browse-shell__multi-select--theme" />
                                     }
                                }
                            </div>

                            @if (SupportsFacetFilters)
                            {
                                <div class="browse-shell__toggle-row">
                                    @if (!IsMusicTab)
                                    {
                                        <AppQuickFilterToggle Label="@L["MediaBrowseShell_InProgress"].Value"
                                                              Selected="@IsInProgressOnly"
                                                              SelectedChanged="OnInProgressChanged" />
                                    }
                                    <AppQuickFilterToggle Label="@SecondaryQuickFilterLabel"
                                                          Selected="@IsSecondaryQuickFilterSelected"
                                                          SelectedChanged="OnSecondaryQuickFilterChanged" />
                                    @if (IsAudiobookTab)
                                    {
                                        <AppQuickFilterToggle Label="@L["Common_Finished"].Value"
                                                              Selected="@IsFinishedOnly"
                                                              SelectedChanged="OnFinishedChanged" />
                                    }
                                    @if (ActiveLibraryId is not null)
                                    {
                                        <AppQuickFilterToggle Label="@L["MediaBrowseShell_NeedsReview"].Value"
                                                              Selected="@_unmatched"
                                                              SelectedChanged="OnUnmatchedChanged" />
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="browse-shell__display-controls @(IsTimelineGrouping ? "is-timeline" : "") @(inSheet ? "is-sheet" : "")">
                        @if (IsTimelineGrouping) { <div class="browse-shell__timeline-grouping"><AppTimelineGroupingControl Inline="true" Value="@_timelineGrouping" ValueChanged="TimelineGroupingChanged" /></div> }
                        <span class="browse-shell__sort-label">@L["Common_Sort"]</span>
                        <span class="browse-shell__display-label">@L["Common_Display"]</span>
                        <AppSelect T="string"
                                   AriaLabel="@L["Common_Sort"].Value"
                                   Value="@_sortBy"
                                   ValueChanged="OnSortChanged"
                                   Variant="AppVariant.Outlined"
                                   Dense="true"
                                   Class="browse-shell__sort">
                            @foreach (var option in GetSortOptions())
                            {
                                <AppSelectItem T="string" @key="option.Value" Value="@option.Value">@option.Label</AppSelectItem>
                            }
                        </AppSelect>
                        @if (SupportsLayoutToggle && !IsTimelineGrouping)
                        {
                            <div class="browse-shell__layout-toggle" role="group" aria-label="@L["MediaBrowseShell_ViewMode"].Value">
                                <AppNativeButton Type="button"
                                                 Class="@LayoutToggleClass(LibraryLayoutMode.Card)"
                                                 AriaLabel="@L["MediaBrowseShell_ShowCards"].Value"
                                                 aria-pressed="@(_layout == LibraryLayoutMode.Card ? "true" : "false")"
                                                 OnClick="@(_ => SwitchLayoutAsync(LibraryLayoutMode.Card))">
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.GridView" />
                                    <span>@L["Common_Cards"]</span>
                                </AppNativeButton>
                                <AppNativeButton Type="button"
                                                 Class="@LayoutToggleClass(LibraryLayoutMode.List)"
                                                 AriaLabel="@L["MediaBrowseShell_ShowList"].Value"
                                                 aria-pressed="@(_layout == LibraryLayoutMode.List ? "true" : "false")"
                                                 OnClick="@(_ => SwitchLayoutAsync(LibraryLayoutMode.List))">
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ViewList" />
                                    <span>@L["Common_List"]</span>
                                </AppNativeButton>
                            </div>
                        }

                    </div>
                    </ChildContent>
                    </BrowseFilterSheet>
                </div>

                <AppActiveFilterSummary Items="@ActiveFilterChips"
                                        Remove="RemoveFilterAsync"
                                        ClearAll="ClearFiltersAsync" />
            </div>
        </div>
    </div>

    @if (!_loading || _hasLoadedOnce)
    {
        <div class="browse-shell__result-summary">
            <div>
                <h2>@ActiveGroupingLabel</h2>
                <span>@ResultCountLabel</span>
            </div>
            @if (ShowAlbumSelectButton)
            {
                @* Albums can be ticked to go into a playlist (Listen music spec D15). Select turns the album covers into tick targets, as My List does. *@
                <AppButton ButtonStyle="AppButtonStyle.Outlined"
                           Label="@(AlbumSelectionOn ? L["Common_Done"].Value : L["Common_Select"].Value)"
                           OnClick="ToggleAlbumSelectAsync"
                           aria-pressed="@(AlbumSelectionOn ? "true" : "false")"
                           data-album-select />
            }
        </div>

        @if (IsAlbumSelectionList && !_loadFailed)
        {
            @* Ticked albums get the selection bar (Add to playlist, Add to collection) on a desktop or tablet, and the phone's bottom bar on a phone. They are never edited, moved, matched or deleted here. *@
            <BulkListEntry Rows="@AlbumBulkRows" MediaType="Music" OnCleared="ClearAlbumSelectionAsync" />
            @if (DeviceContext.IsPhone && (AlbumSelectionOn || AlbumBulkRows.Count > 0))
            {
                <SongSelectionBar WorkIds="@(Array.Empty<Guid>())"
                                  AlbumRows="@AlbumBulkRows"
                                  Count="@AlbumBulkRows.Count"
                                  OnDone="EndAlbumSelectAsync" />
            }
        }

        <CompactContinueStrip Title="@ContinueTitle" Items="@_continueCards" Loading="@_continueLoading" OnViewAll="@(IsInProgressOnly ? default : EventCallback.Factory.Create(this, () => OnInProgressChanged(true)))" />
    }

    @if (_loading && !_hasLoadedOnce)
    {
        <div class="browse-shell__loading">
            <AppSpinner Indeterminate="true" Size="AppSize.Large" Class="tl-u-color-tl-text-muted" />
        </div>
    }
    else if (_loadFailed)
    {
        <AppErrorState Title="@L["MediaBrowseShell_LibraryViewFailedToLoad"].Value"
                       Message="@L["MediaBrowseShell_TheDashboardCouldNotLoad"].Value"
                       Details="@_loadError"
                       Retry="ReloadAsync" />
    }
    else if (UseListLayout && IsMusicSongsGrouping)
    {
        <div class="browse-shell__list">
            @if (UsePhoneSongsHeader)
            {
                <SongsPhoneHeader ProfileId="@_activeProfileId"
                                  SearchText="@_searchText"
                                  SearchTextChanged="OnPhoneSongsSearchAsync"
                                  Sort="@SongListSort"
                                  SortChanged="OnPhoneSongsSortAsync"
                                  FavoritesOnly="@IsSecondaryQuickFilterSelected"
                                  FavoritesOnlyChanged="OnSecondaryQuickFilterChanged"
                                  Genres="@GenreFacets"
                                  SelectedGenres="@SelectedGenres"
                                  SelectedGenresChanged="OnGenresChanged"
                                  PlayDisabled="@(SongTracks.Count == 0)"
                                  OnPlay="@(() => PlayPhoneSongsAsync(shuffle: false))"
                                  OnShuffle="@(() => PlayPhoneSongsAsync(shuffle: true))" />
            }
            <SongList Place="SongTablePlace.Songs"
                      Tracks="@SongTracks"
                      FavoriteIds="@SongFavoriteIds"
                      SourceLabel="All Songs"
                      AriaLabel="@L["Common_Songs"].Value"
                      ProfileId="@_activeProfileId"
                      Sort="@SongListSort"
                      PhoneLetterIndex="@UsePhoneSongsHeader"
                      CurrentWorkId="@Playback.CurrentItem?.WorkId"
                      IsPlaying="@Playback.IsPlaying"
                      OnPlayRequested="PlaySongTracksAsync"
                      OnFavoriteToggled="ToggleSongFavoriteAsync"
                      OnQueueRequested="QueueSongAsync"
                      OnPlayNextRequested="PlayNextSongAsync"
                      OnAlbumRequested="OpenSongAlbumAsync"
                      OnTracksChanged="ReloadAsync"
                      OnDragStarted="BeginSongDragAsync"
                      OnDragEnded="EndSongDragAsync" />
        </div>
    }
    else if (UseListLayout)
    {
        <div class="browse-shell__list">
            @if (!IsContainerGrouping)
            {
                @* Ticked rows get the selection bar and the right-hand "Edit N items" panel (universal editor spec D14). Filters, sort and scroll stay. *@
                <BulkListEntry Rows="@BulkRows" MediaType="@CurrentTab.MediaType" OnSaved="ReloadAfterBulkSaveAsync" OnCleared="ClearBulkSelectionAsync" OnDeleted="OnBulkDeletedAsync" />
            }
            <LibraryConfigurableTable Columns="@ActiveColumns"
                                      VisibleColumnKeys="@VisibleColumnKeys"
                                      Items="@ActiveTableItems"
                                      Loading="@_loading"
                                      PosterSize="56"
                                      SelectedItems="@_selectedItems"
                                      SelectedItemsChanged="OnSelectionChanged"
                                      OnEditClicked="@(CanEditItems ? EventCallback.Factory.Create<Guid>(this, OpenItemEditorAsync) : default)"
                                      OnFavoriteToggled="ToggleFavoriteAsync"
                                      OnRowClicked="HandleTableRowClicked" />
        </div>
    }
    else if (_cards.Count == 0)
    {
        <div class="browse-shell__empty">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Inbox" Class="tl-u-font-size-52px tl-u-opacity-0-16" />
            <h3>@EmptyStateTitle</h3>
            @if (!_unmatched)
            {
                <p>@EmptyStateMessage</p>
            }
            @if (string.IsNullOrWhiteSpace(_searchText) && !IsPlaylistGrouping && !_unmatched)
            {
                <AppButton ButtonStyle="AppButtonStyle.Text"
                           Tone="AppUiTone.Neutral"
                           StartIcon="@AppMaterialIcons.Outlined.PendingActions"
                           Href="/settings/libraries">
                    @L["MediaBrowseShell_OpenIngestionActivity"]
                </AppButton>
            }
        </div>
    }
    else if (IsTimelineGrouping)
    {
        <AppTimelineResults Items="@_cards"
                            Grouping="@_timelineGrouping" ShowGroupingControl="false" Descending="@(_sortBy != "oldest")"
                            Index="@_timelineIndex" OnJumpYear="JumpTimelineYearAsync"
                            YearSemantic="@CurrentTab.YearSemantic"
                            ItemNoun="@CurrentTab.TimelineItemNoun" />
    }
    else if (_cards.All(card => card.Person is not null))
    {
        <PersonTileGrid Items="@_cards" />
    }
    else
    {
        <CascadingValue Value="@AlbumSelectionOffer" IsFixed="true">
            <MediaTileGrid Items="@_cards"
                           Class="browse-shell__grid"
                           SelectionMode="@AlbumSelectionOn"
                           IsSelected="@IsAlbumTileSelected"
                           OnToggle="ToggleAlbumTileAsync" />
        </CascadingValue>
    }

    @if (_hasMore && !IsContainerGrouping)
    {
        <div class="browse-shell__load-more">
            <AppButton ButtonStyle="AppButtonStyle.Filled"
                       Tone="AppUiTone.Primary"
                       OnClick="LoadMoreAsync"
                       Class="browse-shell__load-more-button">
                @L["Common_LoadMore"]
            </AppButton>
        </div>
    }
</div>
