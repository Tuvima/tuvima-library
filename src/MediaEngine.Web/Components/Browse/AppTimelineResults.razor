@using MediaEngine.Web.Models.ViewDTOs
@namespace MediaEngine.Web.Components.Browse
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable
@using MediaEngine.Contracts.Display

<section class="@RootClass" aria-label="Timeline results" @ref="_root">
    <AppTimelineNavigator Periods="@Periods" ActiveKey="@ActiveKey" ActiveChildKey="@_selectedYear" OnJump="JumpPeriodAsync" />

    <div class="app-timeline__content">
        <header class="app-timeline__header">
            @if (ShowGroupingControl) { <AppTimelineGroupingControl Value="@Grouping" ValueChanged="ChangeGroupingAsync" /> }
            <small>@YearSemantic</small>
        </header>

        <div class="app-timeline__groups">
            @foreach (var group in Groups)
            {
                @if (Grouping == TimelineGrouping.Decade && (group == Groups.First() || (Groups.TakeWhile(value => value != group).Last().Key / 10 != group.Key / 10)))
                {
                    <h2 class="app-timeline__decade-heading">@(group.Key == 0 ? "Unknown year" : $"{group.Key / 10 * 10}s")</h2>
                }
                <section data-timeline-key="@group.Key" id="@YearAnchor(group.Key)"
                         class="@YearGroupClass(group.Key)"
                         aria-labelledby="@($"{_instanceId}-heading-{group.Key}")"
                         @key="group.Key">
                    <header class="app-timeline__year-heading">
                        <h3 id="@($"{_instanceId}-heading-{group.Key}")">@DisplayYear(group.Key)</h3>
                        <span>@CountLabel(Index?.FirstOrDefault(p => p.Year == group.Key)?.Count ?? group.Count())</span>
                    </header>

                    <div class="app-timeline__items">
                        @foreach (var item in group)
                        {
                            <a class="app-timeline__item"
                               href="@ItemNavigationUrl(item)"
                               aria-label="@($"Open {item.Title}")"
                               @key="item.RenderKey">
                                <span class="app-timeline__artwork @ArtworkShapeClass(item.Shape)">
                                    @if (!string.IsNullOrWhiteSpace(ItemArtworkUrl(item)))
                                    {
                                        <img src="@ItemArtworkUrl(item)"
                                             srcset="@item.TileImageSrcSet"
                                             sizes="@($"{ArtworkWidth(item.Shape)}px")"
                                             alt=""
                                             loading="lazy"
                                             decoding="async" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Outlined.ImageNotSupported" />
                                    }
                                </span>
                                <span class="app-timeline__item-title" title="@item.Title">@item.Title</span>
                            </a>
                        }
                    </div>
                </section>
            }
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MediaTileViewModel> Items { get; set; } = [];
    [Parameter] public int TileSizePx { get; set; } = 168;
    [Parameter] public string YearSemantic { get; set; } = "Release / publication year";
    [Parameter] public string ItemNoun { get; set; } = "item";

    [Parameter] public TimelineGrouping Grouping { get; set; }
    [Parameter] public EventCallback<TimelineGrouping> GroupingChanged { get; set; }
    [Parameter] public bool ShowGroupingControl { get; set; } = true;
    [Parameter] public bool Descending { get; set; } = true;
    [Parameter] public IReadOnlyList<DisplayTimelinePeriodDto>? Index { get; set; }
    [Parameter] public EventCallback<int> OnJumpYear { get; set; }
    private ElementReference _root;
    private readonly string _instanceId = $"timeline-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<AppTimelineResults>? _reference;
    private int? _selectedYear;
    private int? _pendingJump;
    private int _jumpVersion;
    private int TimelineArtworkSizePx => Math.Clamp((int)Math.Round(TileSizePx * 0.55 / 4, MidpointRounding.AwayFromZero) * 4, 72, 104);
    private string RootClass => $"app-timeline app-timeline--art-{TimelineArtworkSizePx}";
    private IReadOnlyList<IGrouping<int, MediaTileViewModel>> Groups = [];
    private IReadOnlyList<TimelinePeriod> Years => (Index?.Select(p => new TimelinePeriod(p.Year, DisplayYear(p.Year), p.Count))
        ?? Groups.Select(g => new TimelinePeriod(g.Key, DisplayYear(g.Key), g.Count())))
        .OrderBy(p => p.Key == 0).ThenBy(p => Descending ? -p.Key : p.Key).ToList();
    private IReadOnlyList<TimelinePeriod> Periods => Grouping == TimelineGrouping.Year ? Years
        : Years.GroupBy(p => p.Key / 10 * 10).Select(g => new TimelinePeriod(g.Key, g.Key == 0 ? "Unknown year" : $"{g.Key}s", g.Sum(p => p.Count), g.Key == 0 ? null : g.ToList())).ToList();
    private int? ActiveKey => Grouping == TimelineGrouping.Decade ? _selectedYear / 10 * 10 : _selectedYear;
    protected override void OnParametersSet()
    {
        Groups = Items.GroupBy(item => Math.Max(0, item.SortYear))
            .OrderBy(group => group.Key == 0).ThenBy(group => Descending ? -group.Key : group.Key).ToList();
        if (ShowGroupingControl) Grouping = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["period"] == "decade" ? TimelineGrouping.Decade : TimelineGrouping.Year;
        if (!_selectedYear.HasValue || !Years.Any(p => p.Key == _selectedYear)) _selectedYear = Groups.FirstOrDefault()?.Key;
    }
    private async Task ChangeGroupingAsync(TimelineGrouping value)
    {
        Grouping = value;
        await GroupingChanged.InvokeAsync(value);
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("period", value == TimelineGrouping.Decade ? "decade" : null));
    }
    private async Task JumpPeriodAsync(TimelinePeriod period)
    {
        var version = ++_jumpVersion;
        var year = period.Children?.FirstOrDefault()?.Key ?? period.Key;
        if (!Groups.Any(g => g.Key == year) && OnJumpYear.HasDelegate) await OnJumpYear.InvokeAsync(year);
        if (version != _jumpVersion) return;
        _selectedYear = year;
        _pendingJump = year;
    }
    [JSInvokable] public Task SetActivePeriod(int year) { _selectedYear = year; return InvokeAsync(StateHasChanged); }
    [JSInvokable] public async Task RestorePeriod(int year)
    {
        if (Years.FirstOrDefault(p => p.Key == year) is not { } period) return;
        await JumpPeriodAsync(period);
        await InvokeAsync(StateHasChanged);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/catalogue-timeline.js");
        _reference ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("observe", _root, _reference);
        if (_pendingJump is { } year && await _module.InvokeAsync<bool>("jump", _root, year)) _pendingJump = null;
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null) { try { await _module.InvokeVoidAsync("disconnect", _root); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
        _reference?.Dispose();
    }
    private string YearGroupClass(int year) => $"app-timeline__year {(year == _selectedYear ? "is-selected" : "")}";
    private string YearAnchor(int year) => $"{_instanceId}-year-{year}";
    private static string DisplayYear(int year) => year > 0 ? year.ToString() : "Unknown year";
    private string CountLabel(int count) => count == 1
        ? $"1 {ItemNoun}"
        : $"{count} {ItemNoun}s";

    private static string ItemNavigationUrl(MediaTileViewModel item) =>
        StringHelpers.FirstNonBlank(item.DetailsNavigationUrl, item.NavigationUrl, item.PrimaryNavigationUrl) ?? "/";

    private static string? ItemArtworkUrl(MediaTileViewModel item) =>
        StringHelpers.FirstNonBlank(item.TileImageUrl, item.CoverUrl, item.PreviewImageUrl);

    private static string ArtworkShapeClass(MediaTileShape shape) => shape switch
    {
        MediaTileShape.Landscape => "is-landscape",
        MediaTileShape.Square => "is-square",
        _ => "is-portrait",
    };
    private int ArtworkWidth(MediaTileShape shape) => (int)Math.Ceiling(TimelineArtworkSizePx * (shape == MediaTileShape.Landscape ? 1.18 : shape == MediaTileShape.Portrait ? .73 : 1));


}
