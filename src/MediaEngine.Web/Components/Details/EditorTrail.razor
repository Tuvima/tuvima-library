@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.MediaTiles
@using MediaEngine.Web.Services.Ui
@implements IDisposable
@inject IStringLocalizer<SharedStrings> L

@* Where the item being edited sits (Show > Season > Episode, Artist > Album > Track), in the pop-over's header. Each step with
   somewhere to go is a dropdown of the item and its children; choosing one switches the item being edited and keeps every staged
   change. The family tree (universal editor v3 WP2) replaces this. *@
@if (Flow is { Session.IsActive: true } flow)
{
    var session = flow.Session;
    <ol class="tl-editing-bar__trail tl-editor-trail" aria-label="@L["EditingBar_ItemBeingEdited"].Value" aria-busy="@(flow.Switching ? "true" : null)">
        @for (var index = 0; index < session.Trail.Count; index++)
        {
            var step = session.Trail[index];
            var options = flow.Catalog.ChildrenOf(step.EntityId);
            var isActive = index == session.Trail.Count - 1;
            <li class="@(isActive ? "is-active" : null)">
                @if (options.Count > 0)
                {
                    <AppOverflowMenu Label="@step.Title"
                                     ShowIcon="false"
                                     EndIcon="@AppMaterialIcons.Outlined.ExpandMore"
                                     AriaLabel="@($"{step.Title}. Choose another item to edit")"
                                     Class="tl-editing-bar__step"
                                     TriggerClass="tl-editing-bar__step-trigger"
                                     PopoverClass="tl-editing-bar__step-menu"
                                     AnchorOrigin="AppOrigin.BottomLeft"
                                     TransformOrigin="AppOrigin.TopLeft"
                                     Disabled="@(flow.Switching || flow.Saving)">
                        @StepOption(flow, session, step)
                        @foreach (var child in options)
                        {
                            @StepOption(flow, session, child)
                        }
                    </AppOverflowMenu>
                }
                else
                {
                    @step.Title
                }
            </li>
        }
    </ol>
    @if (flow.Switching)
    {
        <span class="tl-editing-bar__opening" role="status">@L["EditingBar_Opening"]</span>
    }
}

@code {
    private EditSessionFlow? _subscribed;

    [Parameter, EditorRequired] public EditSessionFlow? Flow { get; set; }

    // One row of a step's dropdown: a small picture, the name, and a dot when the item already has changes waiting.
    private RenderFragment StepOption(EditSessionFlow flow, EditSessionState session, EditTrailItem item) => __builder =>
    {
        var isActive = session.ActiveItem?.EntityId == item.EntityId;
        var hasChanges = session.Pending.Changes.Any(change => change.EntityId == item.EntityId);
        <AppMenuItem Class="tl-editing-bar__option"
                     Checked="@isActive"
                     OnClick="@(() => flow.SwitchToAsync(item.EntityId, item.Title))">
            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
            {
                <img class="tl-editing-bar__thumb" src="@MediaTileArtworkUrl.ForDrawnSize(item.ImageUrl, 40)" alt="" loading="lazy" decoding="async" />
            }
            else
            {
                <span class="tl-editing-bar__thumb tl-editing-bar__thumb--blank" aria-hidden="true"></span>
            }
            <span class="tl-editing-bar__option-text">@item.Title</span>
            @if (hasChanges)
            {
                <span class="tl-editing-bar__option-dot" role="img" aria-label="Has changes waiting" title="Has changes waiting"></span>
            }
        </AppMenuItem>
    };

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Flow))
        {
            return;
        }

        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnChanged;
            _subscribed.Session.Changed -= OnChanged;
        }

        _subscribed = Flow;
        if (_subscribed is not null)
        {
            _subscribed.Changed += OnChanged;
            _subscribed.Session.Changed += OnChanged;
        }
    }

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnChanged;
            _subscribed.Session.Changed -= OnChanged;
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
}
