@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject IEngineApiClient Api
@inject IJSRuntime JS
@inject IStringLocalizer<SharedStrings> L

@* One title's Bookmarks tab (universal editor v5 D37, mockup Q). Two lists: Everyone's bookmarks above (the list the player shows) and the
   profiles' own below ("From profiles"), each row with a picture of its moment when the title is a video. Everything here is staged like any
   other editor change and written on Save changes; the lists show what Save would do, marked "staged". Export and Import sit at the top only
   for a title that is not part of a show or album (a family has them once, on its own page). *@
<div class="tl-bookmarks">
    @if (_loading)
    {
        <EditorPanelBusy Label="@L["EditorBookmarks_Loading"].Value" />
    }
    else if (_loaded is null)
    {
        <div class="tl-bookmarks__empty" role="alert">
            <span>@L["EditorBookmarks_LoadFailed"] @Api.LastError</span>
            <AppButton ButtonStyle="AppButtonStyle.Outlined" OnClick="LoadAsync">@L["Common_TryAgain"]</AppButton>
        </div>
    }
    else if (_compare is { } compare)
    {
        <EditorBookmarkCompare Compare="compare" OnTake="TakeImportAsync" OnBack="@(() => { _compare = null; })" />
    }
    else
    {
        var view = EditorBookmarkProjection.Apply(_loaded, Pending.BookmarkOps(WorkId));
        <header class="tl-bookmarks__state">
            <div class="tl-bookmarks__state-copy">
                <h3>@L["EditorBookmarks_EveryoneHeading"] <span class="tl-bookmarks__count">@view.Everyone.Count(row => row.Mark != EditorBookmarkRowMark.Removed)</span></h3>
                <span class="tl-bookmarks__state-text" data-state="@view.State">
                    @(view.State == EditorBookmarkStates.Definitive ? L["EditorBookmarks_StateDefinitive"] : L["EditorBookmarks_StatePooled"])
                    @if (view.StateStaged)
                    {
                        <AppChip Text="@L["EditorBookmarks_Staged"].Value" Tone="AppUiTone.Warning" />
                    }
                </span>
                @if (view.StagedCount > 0)
                {
                    <span class="tl-bookmarks__staged">@L["EditorBookmarks_StagedCount", view.StagedCount]</span>
                }
            </div>
            <div class="tl-bookmarks__actions">
                @if (view.State == EditorBookmarkStates.Definitive && !StartOverStaged)
                {
                    <AppButton ButtonStyle="AppButtonStyle.Text" Disabled="@_busy" OnClick="StartOverAsync">@L["EditorBookmarks_StartOver"]</AppButton>
                }
                @if (!HasFamily && _loaded.HasTimes)
                {
                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Disabled="@(_busy || _loaded.Everyone.Count == 0)" StartIcon="@AppMaterialIcons.Outlined.Download" OnClick="ExportAsync">@L["EditorBookmarks_Export"]</AppButton>
                    <AppFileUpload T="IBrowserFile" Accept=".zip,.json" FilesChanged="ImportFileChosenAsync" Disabled="@_busy">
                        <CustomContent Context="upload">
                            <AppButton ButtonStyle="AppButtonStyle.Outlined" Disabled="@_busy" StartIcon="@AppMaterialIcons.Outlined.FileUpload" OnClick="@(() => upload.OpenFilePickerAsync())">@L["EditorBookmarks_Import"]</AppButton>
                        </CustomContent>
                    </AppFileUpload>
                }
            </div>
        </header>

        @if (_notice is not null)
        {
            <p class="tl-bookmarks__notice" role="status">@_notice</p>
        }

        @if (_loaded.AssetId is null)
        {
            <p class="tl-bookmarks__empty">@L["EditorBookmarks_NoFile"]</p>
        }
        else
        {
            <ul class="tl-bookmarks__list" aria-label="@L["EditorBookmarks_EveryoneHeading"].Value">
                @foreach (var row in view.Everyone)
                {
                    @RowFor(row, true)
                }
                @if (view.Everyone.Count == 0)
                {
                    <li class="tl-bookmarks__empty">@L["EditorBookmarks_EveryoneEmpty"]</li>
                }
            </ul>

            <section class="tl-bookmarks__profiles">
                <h3>@L["EditorBookmarks_FromProfiles"] <span class="tl-bookmarks__count">@view.FromProfiles.Count</span></h3>
                <p class="tl-bookmarks__hint">@L["EditorBookmarks_FromProfilesHint"]</p>
                <ul class="tl-bookmarks__list" aria-label="@L["EditorBookmarks_FromProfiles"].Value">
                    @foreach (var row in view.FromProfiles)
                    {
                        @RowFor(row, false)
                    }
                    @if (view.FromProfiles.Count == 0)
                    {
                        <li class="tl-bookmarks__empty">@L["EditorBookmarks_ProfilesEmpty"]</li>
                    }
                </ul>
            </section>
        }
    }
</div>

@code {
    private EditorBookmarksDto? _loaded;
    private BookmarkSetCompareDto? _compare;
    private bool _loading = true;
    private bool _busy;
    private string? _notice;
    private Guid? _editId;
    private bool _editTime;
    private string _editText = string.Empty;
    private string? _editError;
    private Guid _loadedFor;

    [Parameter, EditorRequired] public EditSessionFlow Flow { get; set; } = null!;

    [Parameter, EditorRequired] public Guid WorkId { get; set; }

    /// <summary>True when the title belongs to a show or album: Export and Import are then offered once, on the family's own page.</summary>
    [Parameter] public bool HasFamily { get; set; }

    private PendingEditList Pending => Flow.Session.Pending;

    private bool StartOverStaged => Pending.BookmarkOps(WorkId).Any(op => op.Kind == EditorBookmarkOpKinds.StartOver);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == WorkId)
        {
            return;
        }

        _loadedFor = WorkId;
        Pending.Changed -= OnPendingChanged;
        Pending.Changed += OnPendingChanged;
        await LoadAsync();
    }

    private void OnPendingChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        _loading = true;
        _notice = null;
        _compare = null;
        _editId = null;
        var requested = WorkId;
        var loaded = await Api.GetEditorBookmarksAsync(requested);
        if (requested != WorkId)
        {
            return;
        }

        _loaded = loaded;
        _loading = false;
    }

    // One list row. Both lists draw it; the upper one has the "..." menu, the lower one the Add button.
    private RenderFragment RowFor(EditorBookmarkViewRow view, bool everyone) => __builder =>
    {
        var row = view.Row;
        var removed = view.Mark == EditorBookmarkRowMark.Removed;
        var editing = everyone && _editId == row.Id;
        <li class="tl-bookmarks__row" data-mark="@view.Mark.ToString().ToLowerInvariant()" @key="@(everyone ? row.Id : row.Id.ToString("N") + "p")">
            @if (_loaded is { HasFrames: true })
            {
                var frame = EditorBookmarkWording.FrameSource(row);
                <span class="tl-bookmarks__frame" aria-hidden="true">
                    @if (frame is not null)
                    {
                        <img src="@frame" alt="" loading="lazy" />
                    }
                </span>
            }
            <span class="tl-bookmarks__place">@EditorBookmarkWording.Place(row)</span>
            <span class="tl-bookmarks__copy">
                @if (editing)
                {
                    <AppTextField Value="@_editText" ValueChanged="@(value => _editText = value ?? string.Empty)"
                                  Label="@(_editTime ? L["EditorBookmarks_TimeLabel"].Value : L["EditorBookmarks_NameLabel"].Value)"
                                  MaxLength="@(_editTime ? 12 : 200)" AutoFocus="true" Error="@(_editError is not null)" ErrorText="@_editError"
                                  OnKeyDown="@(key => OnEditKeyAsync(key, row))" />
                    <span class="tl-bookmarks__edit-actions">
                        <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Size="AppControlSize.Compact" OnClick="@(() => CommitEditAsync(row))">@L["Common_Done"]</AppButton>
                        <AppButton ButtonStyle="AppButtonStyle.Text" Size="AppControlSize.Compact" OnClick="@(() => { _editId = null; _editError = null; })">@L["Search_Cancel"]</AppButton>
                    </span>
                }
                else
                {
                    <span class="tl-bookmarks__name">@(string.IsNullOrWhiteSpace(row.Name) ? row.ChapterTitle : row.Name)</span>
                    <span class="tl-bookmarks__from">@(row.IsYours ? L["EditorBookmarks_FromYou"] : L["EditorBookmarks_From", row.OwnerName ?? string.Empty])</span>
                }
            </span>
            @if (view.Mark != EditorBookmarkRowMark.None)
            {
                <AppChip Text="@MarkText(view.Mark)" Tone="@(removed ? AppUiTone.Error : AppUiTone.Warning)" />
            }
            <span class="tl-bookmarks__row-action">
                @if (everyone && removed)
                {
                    <AppButton ButtonStyle="AppButtonStyle.Text" Size="AppControlSize.Compact" OnClick="@(() => UndoRemoveAsync(row))">@L["EditorBookmarks_Undo"]</AppButton>
                }
                else if (everyone && !editing)
                {
                    <AppRowMenu AriaLabel="@L["EditorBookmarks_MoreFor", EditorBookmarkWording.Place(row)].Value" Items="@MenuFor(row)" />
                }
                else if (!everyone && row.InEveryone)
                {
                    <span class="tl-bookmarks__in">@L["EditorBookmarks_InEveryone"]</span>
                }
                else if (!everyone)
                {
                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Size="AppControlSize.Compact" Disabled="@_busy" OnClick="@(() => AddAsync(row))">@L["EditorBookmarks_Add"]</AppButton>
                }
            </span>
        </li>
    };

    private string MarkText(EditorBookmarkRowMark mark) => mark switch
    {
        EditorBookmarkRowMark.Added => L["EditorBookmarks_MarkAdded"].Value,
        EditorBookmarkRowMark.Removed => L["EditorBookmarks_MarkRemoved"].Value,
        EditorBookmarkRowMark.Renamed => L["EditorBookmarks_MarkRenamed"].Value,
        EditorBookmarkRowMark.Moved => L["EditorBookmarks_MarkMoved"].Value,
        _ => L["EditorBookmarks_MarkImported"].Value,
    };

    private IReadOnlyList<AppRowMenuItem> MenuFor(EditorBookmarkRowDto row)
    {
        var items = new List<AppRowMenuItem>
        {
            new() { Label = L["EditorBookmarks_Rename"].Value, Icon = AppMaterialIcons.Outlined.Edit, Disabled = _busy, OnClick = EventCallback.Factory.Create(this, () => BeginEdit(row, time: false)) },
        };
        if (_loaded is { HasTimes: true } && row.PositionKind == "time")
        {
            items.Add(new() { Label = L["EditorBookmarks_ChangeTime"].Value, Icon = AppMaterialIcons.Outlined.Schedule, Disabled = _busy, OnClick = EventCallback.Factory.Create(this, () => BeginEdit(row, time: true)) });
        }

        items.Add(new()
        {
            Label = L["EditorBookmarks_Remove"].Value,
            Icon = AppMaterialIcons.Outlined.Close,
            Destructive = true,
            Disabled = _busy,
            OnClick = EventCallback.Factory.Create(this, () => Stage(new EditorBookmarkOp { Kind = EditorBookmarkOpKinds.Remove, BookmarkId = row.Id }, EditorBookmarkWording.RemovedLine(row))),
        });
        return items;
    }

    private void BeginEdit(EditorBookmarkRowDto row, bool time)
    {
        _editId = row.Id;
        _editTime = time;
        _editText = time ? EditorBookmarkWording.Time(row.PositionSeconds) : row.Name;
        _editError = null;
    }

    private Task OnEditKeyAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs key, EditorBookmarkRowDto row)
    {
        if (key.Key == "Enter")
        {
            return CommitEditAsync(row);
        }

        if (key.Key == "Escape")
        {
            _editId = null;
            _editError = null;
        }

        return Task.CompletedTask;
    }

    private Task CommitEditAsync(EditorBookmarkRowDto row)
    {
        if (_editTime)
        {
            if (!EditorBookmarkWording.TryParseTime(_editText, _loaded?.RunningTimeSeconds, out var seconds))
            {
                _editError = L["EditorBookmarks_TimeInvalid"].Value;
                return Task.CompletedTask;
            }

            Stage(new EditorBookmarkOp { Kind = EditorBookmarkOpKinds.ChangeTime, BookmarkId = row.Id, PositionSeconds = seconds },
                EditorBookmarkWording.TimeChangedLine(row, seconds), EditorBookmarkWording.Time(row.PositionSeconds));
        }
        else
        {
            var name = _editText.Trim();
            Stage(new EditorBookmarkOp { Kind = EditorBookmarkOpKinds.Rename, BookmarkId = row.Id, Name = name },
                EditorBookmarkWording.RenamedLine(row, name), string.IsNullOrWhiteSpace(row.Name) ? EditorBookmarkWording.Place(row) : row.Name);
        }

        _editId = null;
        _editError = null;
        return Task.CompletedTask;
    }

    private Task AddAsync(EditorBookmarkRowDto row)
    {
        Stage(new EditorBookmarkOp { Kind = EditorBookmarkOpKinds.Add, BookmarkId = row.Id }, EditorBookmarkWording.AddedLine(row));
        return Task.CompletedTask;
    }

    private Task StartOverAsync()
    {
        Stage(new EditorBookmarkOp { Kind = EditorBookmarkOpKinds.StartOver }, EditorBookmarkWording.StartOverLine);
        return Task.CompletedTask;
    }

    private Task UndoRemoveAsync(EditorBookmarkRowDto row)
    {
        if (Pending.BookmarkOps(WorkId).FirstOrDefault(op => op.Kind == EditorBookmarkOpKinds.Remove && op.BookmarkId == row.Id) is { } staged)
        {
            Pending.ClearBookmarkOp(WorkId, staged.Id);
        }

        return Task.CompletedTask;
    }

    private void Stage(EditorBookmarkOp op, string label, string? before = null)
    {
        _notice = null;
        Pending.StageBookmarkOp(WorkId, op, label, before);
    }

    private async Task ExportAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var file = await Api.ExportEditorBookmarksAsync(WorkId);
            if (file is null)
            {
                _notice = Api.LastError ?? L["EditorBookmarks_ExportFailed"].Value;
                return;
            }

            await using var stream = new MemoryStream(Convert.FromBase64String(file.ContentBase64), writable: false);
            using var reference = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("tuvimaDownloads.fromStream", file.FileName, reference, "application/zip");
            _notice = L["EditorBookmarks_Exported", file.BookmarkCount].Value;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportFileChosenAsync(IBrowserFile? file)
    {
        if (file is null || _busy)
        {
            return;
        }

        _busy = true;
        _notice = null;
        try
        {
            await using var stream = file.OpenReadStream(EditorBookmarkLimits.MaximumShowFileBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            var compare = await Api.CompareEditorBookmarkFileAsync(WorkId, new EditorBookmarkCompareRequestDto
            {
                ContentBase64 = Convert.ToBase64String(memory.ToArray()),
                RunningTimeSeconds = _loaded?.RunningTimeSeconds,
            });
            if (compare is null)
            {
                _notice = Api.LastError ?? L["EditorBookmarks_NotABookmarkFile"].Value;
                return;
            }

            _compare = compare;
        }
        catch (IOException)
        {
            _notice = L["EditorBookmarks_FileTooLarge"].Value;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task TakeImportAsync(IReadOnlyList<EditorBookmarkImportItem> items)
    {
        _compare = null;
        if (items.Count > 0)
        {
            Stage(new EditorBookmarkOp { Kind = EditorBookmarkOpKinds.Import, Items = items }, EditorBookmarkWording.ImportedLine(items.Count));
        }

        return Task.CompletedTask;
    }

    public void Dispose() => Pending.Changed -= OnPendingChanged;
}
