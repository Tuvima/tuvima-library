@namespace MediaEngine.Web.Components.Details
@using System.Net.Http
@using MediaEngine.Contracts.Metadata
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@implements IDisposable
@inject IEngineApiClient Api
@inject ILogger<EditorTvMatchBrowser> Logger

@* The Match tool's TV browser (universal editor v2, D4): Show, Season and Episode side by side. The Show column searches every show on
   TheTVDB, not only the item's own, and the Episode column lists real episode records, so an episode can be matched into another show
   but a show can never be chosen for an episode. A show page needs only the Show column. Choosing a row only hands the choice up; the
   "What will happen" step and the staging are the Match tool's. *@
<div class="tl-tvm" data-scope="@(NeedsEpisode ? "episode" : "show")">
    <section class="tl-tvm__column tl-tvm__column--shows" aria-label="Show">
        <h3 class="tl-tvm__heading">Show</h3>
        <div class="tl-tvm__search">
            <AppTextField Label="Search shows" HideLabel="true" Value="@_query" ValueChanged="@(value => _query = value ?? string.Empty)"
                          Placeholder="Search for a show" Immediate="true" OnKeyDown="OnQueryKey" aria-label="Search for a show" />
            <AppButton Label="Search" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" StartIcon="@AppMaterialIcons.Outlined.Search"
                       Disabled="@_showsLoading" OnClick="SearchShowsAsync" />
        </div>
        @if (_showsLoading)
        {
            @Skeleton()
        }
        else if (_showsProblem is not null)
        {
            <AppAlert Severity="AppSeverity.Warning" Dense="true">
                <span>@_showsProblem</span>
                <AppButton Label="Retry" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary" Size="AppControlSize.Compact" OnClick="SearchShowsAsync" />
            </AppAlert>
        }
        else
        {
            <div class="tl-tvm__list" role="list">
                @foreach (var show in _shows)
                {
                    <div class="tl-tvm__row @(IsActiveShow(show) ? "is-active" : null)" role="listitem">
                        @Art(show.ImageUrl)
                        <div class="tl-tvm__text">
                            <div class="tl-tvm__title">@show.Name @if (show.IsCurrent) { <AppChip Text="This item's show" Tone="AppUiTone.Neutral" /> }</div>
                            @if (!string.IsNullOrWhiteSpace(show.Year))
                            {
                                <div class="tl-tvm__meta">@show.Year</div>
                            }
                        </div>
                        @if (NeedsEpisode)
                        {
                            <AppButton Label="Open" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact"
                                       aria-label="@($"Open {show.Name}")" OnClick="@(() => OpenShowAsync(show))" />
                        }
                        else
                        {
                            <AppButton Label="Select" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact"
                                       aria-label="@($"Select {show.Name}")" Disabled="@(!CanEdit)" OnClick="@(() => OnShowChosen.InvokeAsync(show))" />
                        }
                    </div>
                }
            </div>
        }
    </section>

    @if (NeedsEpisode)
    {
        <section class="tl-tvm__column" aria-label="Season">
            <h3 class="tl-tvm__heading">Season</h3>
            @if (_show is null)
            {
                <p class="tl-tvm__hint">Open a show to see its seasons.</p>
            }
            else if (_seasonsLoading)
            {
                @Skeleton()
            }
            else if (_seasonsProblem is not null)
            {
                <AppAlert Severity="AppSeverity.Warning" Dense="true">
                    <span>@_seasonsProblem</span>
                    <AppButton Label="Retry" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary" Size="AppControlSize.Compact" OnClick="@(() => OpenShowAsync(_show))" />
                </AppAlert>
            }
            else
            {
                <div class="tl-tvm__list" role="list">
                    @foreach (var season in _seasons)
                    {
                        <div class="tl-tvm__row @(_season?.SeasonId == season.SeasonId ? "is-active" : null)" role="listitem">
                            <div class="tl-tvm__text">
                                <div class="tl-tvm__title">@season.Title @if (season.IsCurrent) { <AppChip Text="This item's season" Tone="AppUiTone.Neutral" /> }</div>
                            </div>
                            <AppButton Label="Open" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact"
                                       aria-label="@($"Open {season.Title}")" OnClick="@(() => OpenSeasonAsync(season))" />
                        </div>
                    }
                </div>
            }
        </section>

        <section class="tl-tvm__column" aria-label="Episode">
            <h3 class="tl-tvm__heading">Episode</h3>
            @if (_season is null)
            {
                <p class="tl-tvm__hint">Open a season to see its episodes.</p>
            }
            else if (_episodesLoading)
            {
                @Skeleton()
            }
            else if (_episodesProblem is not null)
            {
                <AppAlert Severity="AppSeverity.Warning" Dense="true">
                    <span>@_episodesProblem</span>
                    <AppButton Label="Retry" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary" Size="AppControlSize.Compact" OnClick="@(() => OpenSeasonAsync(_season))" />
                </AppAlert>
            }
            else
            {
                <div class="tl-tvm__list" role="list">
                    @foreach (var episode in _episodes)
                    {
                        <div class="tl-tvm__row" role="listitem" data-slot="@EditorTvMatchCandidates.SlotLabel(episode.SeasonNumber, episode.EpisodeNumber)">
                            <span class="tl-tvm__slot">@EditorTvMatchCandidates.SlotLabel(episode.SeasonNumber, episode.EpisodeNumber)</span>
                            <div class="tl-tvm__text">
                                <div class="tl-tvm__title">@episode.Title @if (episode.IsCurrent) { <AppChip Text="This episode" Tone="AppUiTone.Neutral" /> }</div>
                                <div class="tl-tvm__meta">@EpisodeLine(episode)</div>
                            </div>
                            <AppButton Label="Select" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact"
                                       aria-label="@($"Select {episode.Title}")" Disabled="@(!CanEdit || episode.IsCurrent)" OnClick="@(() => OnEpisodeChosen.InvokeAsync(episode))" />
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private CancellationTokenSource? _cts;
    private Guid _startedFor;
    private string _query = string.Empty;
    private bool _showsLoading;
    private string? _showsProblem;
    private IReadOnlyList<TvMatchBrowserShowDto> _shows = [];
    private TvMatchBrowserShowDto? _show;
    private bool _seasonsLoading;
    private string? _seasonsProblem;
    private IReadOnlyList<TvMatchBrowserSeasonDto> _seasons = [];
    private TvMatchBrowserSeasonDto? _season;
    private bool _episodesLoading;
    private string? _episodesProblem;
    private IReadOnlyList<TvMatchBrowserEpisodeDto> _episodes = [];

    /// <summary>The item being matched; the search starts from its show's name.</summary>
    [Parameter, EditorRequired] public EditorMatchSubject? Subject { get; set; }

    /// <summary>False when the person may look but not change.</summary>
    [Parameter] public bool CanEdit { get; set; } = true;

    /// <summary>Raised when a show is chosen (a show page).</summary>
    [Parameter] public EventCallback<TvMatchBrowserShowDto> OnShowChosen { get; set; }

    /// <summary>Raised when an episode is chosen (an episode page).</summary>
    [Parameter] public EventCallback<TvMatchBrowserEpisodeDto> OnEpisodeChosen { get; set; }

    private bool NeedsEpisode => Subject is not null && EditorTvMatchCandidates.NeedsEpisode(Subject.ScopeId);

    private bool IsActiveShow(TvMatchBrowserShowDto show) => _show?.SeriesId == show.SeriesId;

    protected override async Task OnParametersSetAsync()
    {
        if (Subject is null || _startedFor == Subject.EntityId)
        {
            return;
        }

        _startedFor = Subject.EntityId;
        // An episode starts on its own show: by name when known, otherwise blank, which the Engine answers with the item's stored show.
        _query = NeedsEpisode ? Subject.ParentLabel ?? string.Empty : Subject.Title;
        _show = null;
        _season = null;
        _seasons = [];
        _episodes = [];
        await SearchShowsAsync();
    }

    private static string EpisodeLine(TvMatchBrowserEpisodeDto episode)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(episode.Aired))
        {
            parts.Add(episode.Aired!);
        }

        parts.Add(episode.HasFile ? "In your library" : "Not in your library");
        return string.Join(" · ", parts);
    }

    private RenderFragment Skeleton() => __builder =>
    {
        <div class="tl-tvm__list" aria-busy="true" aria-label="Loading">
            @for (var i = 0; i < 4; i++)
            {
                <div class="tl-tvm__row">
                    <AppSkeleton Width="3rem" Height="3rem" />
                    <div class="tl-tvm__text">
                        <AppSkeleton Shape="AppSkeletonShape.Text" Width="60%" />
                        <AppSkeleton Shape="AppSkeletonShape.Text" Width="40%" />
                    </div>
                </div>
            }
        </div>
    };

    private RenderFragment Art(string? url) => __builder =>
    {
        if (!string.IsNullOrWhiteSpace(url))
        {
            <AppImage Src="@url" Alt="" Width="48" Height="48" ObjectFit="AppObjectFit.Cover" Class="tl-match__art" />
        }
        else
        {
            <span class="tl-match__art tl-match__art--empty" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Language" /></span>
        }
    };

    private Task OnQueryKey(KeyboardEventArgs args) => args.Key == "Enter" ? SearchShowsAsync() : Task.CompletedTask;

    private CancellationToken NewToken()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        return _cts.Token;
    }

    private async Task SearchShowsAsync()
    {
        if (Subject is null)
        {
            return;
        }

        var text = _query.Trim();
        var ct = NewToken();
        _showsLoading = true;
        _showsProblem = null;
        StateHasChanged();
        try
        {
            var response = await Api.SearchTvMatchBrowserShowsAsync(Subject.EntityId, text, ct);
            if (ct.IsCancellationRequested)
            {
                return;
            }

            _shows = response?.Shows ?? [];
            _showsProblem = response is null
                ? "TheTVDB did not answer. Try again."
                : _shows.Count == 0
                    ? text.Length == 0 ? "Type a show name to search for." : $"Nothing called \"{text}\" on TheTVDB. Try other words."
                    : null;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "The TV match browser could not search shows for {EntityId}", Subject.EntityId);
            _shows = [];
            _showsProblem = "TheTVDB did not answer. Try again.";
        }

        _showsLoading = false;
        if (NeedsEpisode && _show is null && _shows.FirstOrDefault(show => show.IsCurrent) is { } own)
        {
            await OpenShowAsync(own);
        }
    }

    private async Task OpenShowAsync(TvMatchBrowserShowDto show)
    {
        if (Subject is null)
        {
            return;
        }

        var ct = NewToken();
        _show = show;
        _season = null;
        _episodes = [];
        _seasons = [];
        _seasonsProblem = null;
        _seasonsLoading = true;
        StateHasChanged();
        try
        {
            var response = await Api.GetTvMatchBrowserSeasonsAsync(Subject.EntityId, show.SeriesId, ct);
            if (ct.IsCancellationRequested)
            {
                return;
            }

            _seasons = response?.Seasons ?? [];
            _seasonsProblem = response is null ? "TheTVDB did not answer. Try again." : _seasons.Count == 0 ? "TheTVDB lists no seasons for this show." : null;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "The TV match browser could not list seasons for {EntityId}", Subject.EntityId);
            _seasonsProblem = "TheTVDB did not answer. Try again.";
        }

        _seasonsLoading = false;
        var current = _seasons.FirstOrDefault(s => s.IsCurrent);
        if (current is not null && _seasonsProblem is null)
        {
            await OpenSeasonAsync(current);
        }
    }

    private async Task OpenSeasonAsync(TvMatchBrowserSeasonDto season)
    {
        if (Subject is null || _show is null)
        {
            return;
        }

        var ct = NewToken();
        _season = season;
        _episodes = [];
        _episodesProblem = null;
        _episodesLoading = true;
        StateHasChanged();
        try
        {
            var response = await Api.GetTvMatchBrowserEpisodesAsync(Subject.EntityId, _show.SeriesId, season.SeasonNumber, ct);
            if (ct.IsCancellationRequested)
            {
                return;
            }

            _episodes = response?.Episodes ?? [];
            _episodesProblem = response is null ? "TheTVDB did not answer. Try again." : _episodes.Count == 0 ? "TheTVDB lists no episodes for this season." : null;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "The TV match browser could not list episodes for {EntityId}", Subject.EntityId);
            _episodesProblem = "TheTVDB did not answer. Try again.";
        }

        _episodesLoading = false;
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
