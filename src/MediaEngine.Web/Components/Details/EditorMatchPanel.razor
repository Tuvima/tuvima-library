@namespace MediaEngine.Web.Components.Details
@using System.Globalization
@using MediaEngine.Contracts.Editing
@using MediaEngine.Contracts.Matching
@using MediaEngine.Domain
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@implements IDisposable
@inject IEngineApiClient Api
@inject IStringLocalizer<SharedStrings> L

@* The Match tab for one item (universal editor v5, 3c, mockups G1 and G2). The first row carries the provider dropdown and an icon-only Search at
   the left and the "Media providers / Wikidata" switch at the right. An item that is matched opens on what it is matched to, found by its
   provider id, with the reasons it fits (Why this match); nothing is searched until a person asks. Change match opens a compact search in place:
   the boxes of the item's kind pre-filled from the cleaned file name, tags and folders, the results with a preview, and the verdict with its
   evidence. An item that is not matched yet opens on that search with "Not matched yet". Apply match only stages the choice in the pending
   list (Review shows it); Save changes writes it. The TV flows (WP9a) and the Wikidata side (WP9b) plug in at the two marked places. *@
@if (Subject is not null)
{
    <div class="tl-match" data-testid="match-panel">
        @if (!CanEdit)
        {
            <AppAlert Severity="AppSeverity.Info" Dense="true">@L["EditorMatchPanel_YouCanLookAtMatches"]</AppAlert>
        }

        <div class="tl-matchrow" data-testid="match-row">
            <div class="tl-matchrow__start">
                @if (_setup is { NoProvider: false, Providers.Count: > 0 })
                {
                    <div class="tl-matchrow__provider">
                        <AppSelect Value="@_provider" ValueChanged="OnProviderChanged" Options="@ProviderOptions" Label="@L["EditorMatchPanel_Provider"].Value" HideLabel="true" Disabled="@(_searching || _wikidata)" />
                    </div>
                    <AppIconButton Icon="@AppMaterialIcons.Outlined.Search" Tooltip="@L["EditorMatchPanel_Search"].Value" Size="AppControlSize.Compact"
                                   Disabled="@(_searching || _wikidata || !CanSearch)" OnClick="StartSearchAsync" />
                }
                @if (!string.IsNullOrWhiteSpace(_fileName))
                {
                    <span class="tl-matchrow__file" data-overflow-tooltip="@_fileName" data-testid="match-file-name">@_fileName</span>
                }
            </div>
            <div class="tl-matchrow__end">
                <AppSegmentedControl Options="@SideOptions" Value="@(_wikidata ? SideWikidata : SideProviders)" ValueChanged="OnSideChanged" AriaLabel="@L["EditorMatchPanel_MatchSource"].Value" />
            </div>
        </div>

        @if (_loading)
        {
            <div aria-busy="true" aria-label="@L["EditorMatchPanel_ReadingMatch"].Value"><AppSkeleton Shape="AppSkeletonShape.Text" Width="60%" /></div>
        }
        else if (_wikidata)
        {
            @* WP9b plugs the Wikidata match in here; until then the Wikidata side keeps the identity card and the Universe link. *@
            @IdentityCard()
            @UniverseSection()
        }
        else
        {
            @ProvidersSide()
        }
    </div>
}

@code {
    private const string SideProviders = "providers";
    private const string SideWikidata = "wikidata";

    private CancellationTokenSource? _cts;
    private Guid _startedFor;
    private bool _loading;
    private bool _wikidata;
    private bool _changing;
    private bool _searching;
    private string? _kind;
    private string _provider = string.Empty;
    private string? _fileName;
    private EditorCurrentMatchDto? _current;
    private EditorMatchSetupDto? _setup;
    private EditorMatchContextDto? _tvContext;
    private Dictionary<string, string> _fields = new(StringComparer.OrdinalIgnoreCase);
    private EditorMatchSearchResultDto? _found;
    private EditorMatchResultDto? _selected;
    private EditorMatchResultDto? _edition;
    private string? _problem;
    private string? _staged;

    /// <summary>The item being matched; null until the editor's fields have loaded.</summary>
    [Parameter] public EditorMatchSubject? Subject { get; set; }

    /// <summary>The edit session whose pending list the match is staged in.</summary>
    [Parameter, EditorRequired] public EditSessionState? Session { get; set; }

    /// <summary>False when the person may look but not change (the Engine still decides who may edit).</summary>
    [Parameter] public bool CanEdit { get; set; } = true;

    /// <summary>True when the item is not matched yet (or its last match failed): the tab then opens on the search, pre-filled from the file.</summary>
    [Parameter] public bool IsUnmatched { get; set; }

    /// <summary>The Universe the item belongs to, shown with "Open Universe"; null when the item has none.</summary>
    [Parameter] public EditorUniverseLink? Universe { get; set; }

    /// <summary>Raised by "Open Universe". The window closes (asking about unsaved changes) and the Universe page opens; the host does both.</summary>
    [Parameter] public EventCallback<EditorUniverseLink> OnOpenUniverse { get; set; }

    private bool IsMatched => !IsUnmatched && _current is { State: EditorCurrentMatchStates.Matched, Record: not null };

    // The TV show and episode lists live in the TV browser (WP9a rebuilds them); every other kind uses the search below.
    private bool UsesTvBrowser => Subject is not null && EditorTvMatchCandidates.UsesBrowser(Subject.MediaType, Subject.ScopeId);

    private bool CanSearch => _kind is not null && _setup is { NoProvider: false } && ProviderIsReady;

    private bool ProviderIsReady => _setup?.Providers.FirstOrDefault(p => p.Name == _provider)?.State == EditorMatchProviderStates.Ready;

    private bool CanApply => CanEdit && Session is { IsActive: true } && (_edition ?? _selected) is not null;

    private IReadOnlyList<AppSelectOption> SideOptions =>
        [new AppSelectOption(SideProviders, "Media providers"), new AppSelectOption(SideWikidata, "Wikidata")];

    private IReadOnlyList<AppSelectOption> ProviderOptions =>
        [.. (_setup?.Providers ?? []).Select(p => new AppSelectOption(p.Name, $"{p.DisplayName} · {StateText(p.State)}"))];

    private static string StateText(string state) => state switch
    {
        EditorMatchProviderStates.NeedsKey => "Needs a key",
        EditorMatchProviderStates.Off => "Off",
        _ => "Ready",
    };

    protected override async Task OnParametersSetAsync()
    {
        if (Subject is null || _startedFor == Subject.EntityId)
        {
            return;
        }

        _startedFor = Subject.EntityId;
        _cts?.Cancel();
        _wikidata = false;
        _changing = false;
        _searching = false;
        _current = null;
        _setup = null;
        _tvContext = null;
        _found = null;
        _selected = null;
        _edition = null;
        _problem = null;
        _staged = null;
        _fileName = null;
        _fields = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        _kind = EditorMatchKindRules.KindOf(Subject.MediaType, Subject.ScopeId);
        _loading = true;

        // Opening only reads: what the item is matched to (found by its stored id) and what the search would start from. No search runs.
        var id = Subject.EntityId;
        var current = IsUnmatched ? Task.FromResult<EditorCurrentMatchDto?>(null) : Api.GetEditorCurrentMatchAsync(id);
        var setup = _kind is null ? Task.FromResult<EditorMatchSetupDto?>(null) : Api.GetEditorMatchSetupAsync(id, _kind);
        var context = UsesTvBrowser ? Api.GetEditorMatchContextAsync(id) : Task.FromResult<EditorMatchContextDto?>(null);
        await Task.WhenAll(current, setup, context);
        if (_startedFor != id)
        {
            return;
        }

        _current = await current;
        _setup = await setup;
        _tvContext = await context;
        _fileName = _setup?.FileName ?? _current?.FileName ?? _tvContext?.FileName;
        if (_setup is { NoProvider: false } ready)
        {
            _provider = ready.Providers.FirstOrDefault(p => p.IsDefault)?.Name ?? ready.Providers[0].Name;
            foreach (var field in ready.Fields)
            {
                _fields[field.Key] = field.Value;
            }
        }

        // An item with no match yet opens on the search; one with a match opens on the match. Either way nothing has been asked of a provider.
        _changing = !IsMatched;
        _loading = false;
    }

    private Task OnProviderChanged(string? value)
    {
        _provider = value ?? _provider;
        _found = null;
        _selected = null;
        _edition = null;
        _problem = null;
        return Task.CompletedTask;
    }

    private Task OnSideChanged(string value)
    {
        _wikidata = value == SideWikidata;
        return Task.CompletedTask;
    }

    // The icon-only Search in the first row: opens the compact search in place and asks the provider with the boxes as they stand.
    private async Task StartSearchAsync()
    {
        _changing = true;
        _staged = null;
        await SearchAsync();
    }

    private void StartChange()
    {
        _changing = true;
        _staged = null;
        _found = null;
        _selected = null;
        _edition = null;
        _problem = null;
    }

    private void CancelChange()
    {
        _changing = false;
        _found = null;
        _selected = null;
        _edition = null;
        _problem = null;
    }

    private async Task OnFieldChangedAsync(string key, string? value)
    {
        _fields[key] = value?.Trim() ?? string.Empty;
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (Subject is null || _kind is null || _setup is null || !ProviderIsReady)
        {
            return;
        }

        _cts?.Cancel();
        _cts?.Dispose();
        var source = _cts = new CancellationTokenSource();
        _searching = true;
        _problem = null;
        _found = null;
        _selected = null;
        _edition = null;
        StateHasChanged();
        try
        {
            var request = new EditorMatchSearchRequestDto
            {
                Kind = _kind,
                Provider = _provider,
                Fields = new Dictionary<string, string>(_fields, StringComparer.OrdinalIgnoreCase),
            };
            var found = await Api.SearchEditorMatchAsync(Subject.EntityId, request, source.Token);
            if (source.IsCancellationRequested)
            {
                return;
            }

            _found = found;
            if (found is null)
            {
                _problem = "Library could not reach the Engine. Try again.";
            }
            else
            {
                // The best result is chosen for the person, with the edition the Engine says is closest to the file.
                _selected = found.Results.FirstOrDefault();
                _edition = _selected?.Editions.FirstOrDefault(edition => edition.IsSuggested) ?? _selected?.Editions.FirstOrDefault();
            }
        }
        finally
        {
            if (!source.IsCancellationRequested)
            {
                _searching = false;
            }
        }
    }

    private Task OnSelectedAsync(EditorMatchResultDto result)
    {
        _selected = result;
        _edition = result.Editions.FirstOrDefault(edition => edition.IsSuggested) ?? result.Editions.FirstOrDefault();
        return Task.CompletedTask;
    }

    private Task OnEditionAsync(EditorMatchResultDto edition)
    {
        _edition = edition;
        return Task.CompletedTask;
    }

    // A pick in the TV browser becomes the same kind of candidate a search result is, so Apply match stages it the same way.
    private Task OnShowChosenAsync(TvMatchBrowserShowDto show) => PickAsync(EditorTvMatchCandidates.ForShow(show));

    private Task OnEpisodeChosenAsync(TvMatchBrowserEpisodeDto episode) => PickAsync(EditorTvMatchCandidates.ForEpisode(episode));

    // Season and episode typed by hand, for a file the provider has nothing for: staged as the item's own details.
    private Task OnManualPlacementAsync((int Season, int Episode) numbers)
    {
        if (!CanEdit || Subject is null || Session is not { IsActive: true })
        {
            return Task.CompletedTask;
        }

        var season = numbers.Season.ToString(CultureInfo.InvariantCulture);
        var episode = numbers.Episode.ToString(CultureInfo.InvariantCulture);
        Session.Pending.SetField(Subject.EntityId, MetadataFieldConstants.SeasonNumber, season);
        Session.Pending.SetField(Subject.EntityId, MetadataFieldConstants.EpisodeNumber, episode);
        _staged = $"Season {season}, episode {episode} as this item's own details";
        _changing = false;
        return Task.CompletedTask;
    }

    private Task PickAsync(ItemCanonicalRetailCandidateDto candidate)
    {
        _selected = new EditorMatchResultDto
        {
            Candidate = candidate,
            ProviderName = candidate.ProviderName,
            Title = candidate.Title,
            Year = candidate.Year,
            Verdict = EditorMatchVerdicts.Possible,
        };
        _edition = null;
        return Task.CompletedTask;
    }

    // Stages the choice: one Identity entry in the pending list, which Review shows and Save changes writes. Nothing is written here.
    private void Apply()
    {
        var chosen = _edition ?? _selected;
        if (!CanApply || Subject is null || Session is null || chosen is null)
        {
            return;
        }

        var candidate = chosen.Candidate;
        var request = EditorMatchRules.RequestFor(candidate, Subject, Subject.TargetGroup);
        request.ClearAutoAlignedWikidata = true;
        var facts = EditorMatchRules.FactsOf(candidate);
        Session.Pending.SetTarget(
            EditSessionChangeKinds.Identity,
            Subject.EntityId,
            EditSessionIdentityTarget.Serialize(request),
            label: $"{facts.Title} ({facts.Provider})",
            before: MatchBefore());
        _staged = $"{facts.Title} ({facts.Provider})";
        _changing = false;
        _found = null;
        _selected = null;
        _edition = null;
    }

    private string MatchBefore() => IsMatched && _current?.Record is { } record
        ? string.Join(" · ", new[] { record.Title, record.ProviderName }.Where(part => !string.IsNullOrWhiteSpace(part)))
        : "Not matched yet";

    private RenderFragment ProvidersSide() => __builder =>
    {
        if (_kind is null || _setup is { NoProvider: true })
        {
            <AppAlert Severity="AppSeverity.Info" Dense="true" data-testid="match-no-provider">@(_setup?.NoProviderMessage ?? EditorMatchNoProvider)</AppAlert>
            return;
        }

        if (_setup is null)
        {
            <AppAlert Severity="AppSeverity.Warning" Dense="true">Library could not read what this item would be matched with. Try again.</AppAlert>
            return;
        }

        if (_staged is not null)
        {
            <AppAlert Severity="AppSeverity.Success" Dense="true" data-testid="match-staged">Staged: @_staged. Nothing is saved until you press Save changes.</AppAlert>
        }

        if (!_changing && IsMatched)
        {
            @CurrentCard(_current!)
            @WhyTable(_current!)
        }
        else
        {
            @SearchSection()
        }
    };

    private RenderFragment CurrentCard(EditorCurrentMatchDto current) => __builder =>
    {
        var record = current.Record!;
        <section class="tl-matchcard" aria-label="Current match" data-testid="match-current">
            @if (!string.IsNullOrWhiteSpace(record.ImageUrl))
            {
                <AppImage Src="@record.ImageUrl" Alt="" Width="64" Height="96" ObjectFit="AppObjectFit.Cover" Class="tl-match__art tl-matchcard__art" />
            }
            else
            {
                <span class="tl-match__art tl-match__art--empty tl-matchcard__art" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Image" /></span>
            }
            <div class="tl-match__text">
                <div class="tl-match__title"><span class="tl-match__meta">Current match</span> <AppChip Text="Matched" Tone="AppUiTone.Success" />@if (current.Pinned) { <AppChip Text="Chosen by you" Tone="AppUiTone.Neutral" /> }</div>
                <div class="tl-matchcard__name">@record.Title</div>
                <div class="tl-match__meta">@string.Join(" · ", new[] { record.Kind, record.Year, record.Creator, record.ProviderName }.Where(part => !string.IsNullOrWhiteSpace(part)))</div>
                @if (!string.IsNullOrWhiteSpace(current.Note))
                {
                    <div class="tl-match__meta">@current.Note</div>
                }
            </div>
            <div class="tl-matchcard__actions">
                @if (!string.IsNullOrWhiteSpace(record.SourceUrl))
                {
                    <AppButton Label="Open source ↗" Href="@record.SourceUrl" Target="_blank" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact" />
                }
                <AppButton Label="Change match" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact"
                           Disabled="@(!CanEdit || Session is not { IsActive: true })" OnClick="StartChange" />
            </div>
        </section>
    };

    private RenderFragment WhyTable(EditorCurrentMatchDto current) => __builder =>
    {
        <section class="tl-matchcard tl-matchcard--why" aria-label="Why this match" data-testid="match-why">
            <div class="tl-match__title">
                <h3 class="tl-match__section-heading">Why this match</h3>
                @if (current.Verdict is { } verdict)
                {
                    <AppChip Text="@($"{EditorMatchResults.VerdictText(verdict)} match")" Tone="@EditorMatchResults.VerdictTone(verdict)" />
                }
            </div>
            <table class="tl-matchwhy">
                <thead>
                    <tr><th scope="col">Field</th><th scope="col">Your file</th><th scope="col">Matched record</th><th scope="col"><span class="sr-only">Result</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var row in current.Why)
                    {
                        <tr data-state="@row.State">
                            <th scope="row">@FieldLabel(row.Field)@if (!string.IsNullOrWhiteSpace(row.Note)) { <small class="tl-match__meta">@row.Note</small> }</th>
                            <td>@(string.IsNullOrWhiteSpace(row.YourFile) ? "–" : row.YourFile)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.MatchedRecord) ? "–" : row.MatchedRecord)</td>
                            <td>@WhyMark(row)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="tl-match__meta">Changing the match updates unlocked metadata. Locked fields stay unchanged.</p>
        </section>
    };

    private static RenderFragment WhyMark(EditorMatchEvidenceRowDto row) => __builder =>
    {
        if (row.State == EditorMatchEvidenceStates.NotChecked)
        {
            <span class="tl-match__meta">Not checked</span>
        }
        else
        {
            <span class="tl-matchwhy__mark" data-state="@row.State">@(row.State == EditorMatchEvidenceStates.Agrees ? "✓" : "✕") @(row.Verdict is null ? null : EditorMatchResults.VerdictText(row.Verdict))</span>
        }
    };

    private static string FieldLabel(string field) => field switch
    {
        "title" => "Title",
        "year" => "Year",
        "season_number" => "Season",
        "episode_number" => "Episode",
        "runtime" => "Runtime",
        _ => field.Replace('_', ' '),
    };

    private RenderFragment SearchSection() => __builder =>
    {
        <section class="tl-matchsearch" aria-label="Match" data-testid="match-search">
            <div>
                <h3 class="tl-matchsearch__heading">Match @KindWord</h3>
                @if (!IsMatched)
                {
                    <span class="tl-matchsearch__tag"><NotMatchedTag /> <span class="tl-match__meta">Not matched yet</span></span>
                }
            </div>
            @if (UsesTvBrowser)
            {
                @* WP9a replaces the TV browser with the show-first flow; until then a pick here is staged with Apply match. *@
                <EditorTvMatchBrowser Subject="Subject" CanEdit="CanEdit" Unmatched="@(!IsMatched)" Context="_tvContext"
                                      OnShowChosen="OnShowChosenAsync" OnEpisodeChosen="OnEpisodeChosenAsync" OnManualPlacement="OnManualPlacementAsync" />
                @if (_selected is not null)
                {
                    <EditorMatchResults Results="@(new[] { _selected })" Selected="_selected" SelectedChanged="OnSelectedAsync" Evidence="_setup?.Evidence"
                                        CanApply="CanApply" OnApply="Apply" ShowCancel="IsMatched" OnCancel="CancelChange" />
                }
            }
            else
            {
                <div class="tl-matchsearch__fields">
                    @foreach (var field in _setup!.Fields)
                    {
                        <div class="tl-matchsearch__field">
                            <AppTextField Label="@field.Label" Value="@FieldValue(field.Key)" ValueChanged="@(value => OnFieldChangedAsync(field.Key, value))"
                                          Immediate="false" Disabled="@(!ProviderIsReady || _searching)" aria-label="@field.Label" />
                        </div>
                    }
                </div>
                @if (!ProviderIsReady)
                {
                    <AppAlert Severity="AppSeverity.Info" Dense="true">@ProviderStateSentence</AppAlert>
                }

                <EditorMatchResults Results="@(_found?.Results ?? [])" Evidence="_found?.Evidence ?? _setup.Evidence"
                                    Selected="_selected" SelectedChanged="OnSelectedAsync" Edition="_edition" EditionChanged="OnEditionAsync"
                                    Loading="_searching" Message="@(_problem ?? _found?.Message)" Failed="@(_problem is not null || _found?.FailedProviders.Count > 0)"
                                    CanApply="CanApply" OnApply="Apply" ShowCancel="IsMatched" OnCancel="CancelChange" />
            }
        </section>
    };

    private string FieldValue(string key) => _fields.TryGetValue(key, out var value) ? value : string.Empty;

    private string ProviderStateSentence => _setup?.Providers.FirstOrDefault(p => p.Name == _provider) is { } provider
        ? provider.State == EditorMatchProviderStates.NeedsKey
            ? $"{provider.DisplayName} needs a key before it can be searched. Add it in Settings, or choose another provider."
            : $"{provider.DisplayName} is switched off. Turn it on in Settings, or choose another provider."
        : "Choose a provider to search.";

    private string KindWord => _kind switch
    {
        "movie" => "movie",
        "book" => "book",
        "audiobook" => "audiobook",
        "comic" => "comic",
        "tv_show" => "show",
        "tv_season" => "season",
        "tv_episode" => "episode",
        "album" => "album",
        "song" => "song",
        _ => "item",
    };

    private const string EditorMatchNoProvider = "No provider matches this kind of item. The details you enter stand on their own.";

    // The Wikidata side keeps what the tab always showed: what the item is matched to now.
    private RenderFragment IdentityCard() => __builder =>
    {
        if (Subject is null)
        {
            return;
        }

        var line = string.Join(" · ", new[] { Subject.Creator, Subject.ParentLabel, Subject.Year }.Where(part => !string.IsNullOrWhiteSpace(part)));
        <section class="tl-match__now" aria-label="Matched to now" data-testid="match-now">
            <h3 class="tl-match__section-heading">Matched to now</h3>
            @if (!IsMatched)
            {
                <div class="tl-match__title"><span>@(string.IsNullOrWhiteSpace(_fileName) ? Subject.Title : _fileName)</span> <NotMatchedTag /></div>
            }
            else
            {
                <div class="tl-match__title"><span>@Subject.Title</span> <AppChip Text="Matched" Tone="AppUiTone.Success" /></div>
                @if (line.Length > 0)
                {
                    <div class="tl-match__meta">@line</div>
                }
            }
        </section>
    };

    // The Universe the item belongs to. "Open Universe" closes the editor, asking about unsaved changes first.
    private RenderFragment UniverseSection() => __builder =>
    {
        if (Universe is not { } universe)
        {
            return;
        }

        <section class="tl-match__universe" aria-label="Universe" data-testid="match-universe">
            <h3 class="tl-match__section-heading">Universe</h3>
            <div class="tl-match__row">
                @if (!string.IsNullOrWhiteSpace(universe.ImageUrl))
                {
                    <AppImage Src="@universe.ImageUrl" Alt="" Width="48" Height="48" ObjectFit="AppObjectFit.Cover" Class="tl-match__art" />
                }
                else
                {
                    <span class="tl-match__art tl-match__art--empty" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Public" /></span>
                }
                <div class="tl-match__text"><div class="tl-match__title"><span>@universe.Name</span></div></div>
                <AppButton Label="Open Universe" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact"
                           OnClick="@(() => OnOpenUniverse.InvokeAsync(universe))" />
            </div>
        </section>
    };

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
