@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Formatting
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Theming
@using MediaEngine.Web.Services.Ui
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IServiceProvider Services
@inject IStringLocalizer<SharedStrings> L

@* The Contents tab of the universal editor window (v4 D3, WP5): the children of a show, season, album or series with a picture, a number,
   the title, a matched mark and the file's size, paged in as the list scrolls. Ticking rows switches the editor to several-items editing
   ("Editing 5 episodes"): the bar above the list names the ticked rows and opens the fields they share; what those fields are is the bulk
   panel's job. A video series also shows its order here, set by dragging or the arrows (v3.1). Nothing on this tab is saved. *@
@{
    var page = Family.ContentsOf(ParentId);
    var rows = Batch.Rows;
}
<div class="tl-contents" data-testid="editor-contents">
    @if (CanEdit && Batch.Count > 0)
    {
        <div class="tl-contents__bar" role="toolbar" aria-label="@L["EditorContents_TickedRows"].Value">
            <span class="tl-contents__count" role="status">@BulkEditRules.EditingTitle(rows, Batch.MediaType)</span>
            <span class="tl-contents__actions">
                <AppButton Label="@L["EditorContents_ChooseWhatToChange"].Value"
                           StartIcon="@AppMaterialIcons.Outlined.Edit"
                           ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary"
                           Size="AppControlSize.Compact"
                           Class="tl-contents__edit"
                           Disabled="@Flow.Saving"
                           OnClick="OpenEdit" />
                @if (BulkEditRules.CanMatch(rows, Batch.MediaType))
                {
                    <AppButton Label="@string.Format(L["EditorContents_MatchN"].Value, Batch.Count, Noun)"
                               StartIcon="@AppMaterialIcons.Outlined.TravelExplore"
                               ButtonStyle="AppButtonStyle.Outlined"
                               Tone="AppUiTone.Neutral"
                               Size="AppControlSize.Compact"
                               Class="tl-contents__match"
                               Disabled="@Flow.Saving"
                               OnClick="OpenMatch" />
                }

                @if (CanDeleteRows)
                {
                    @* Delete the ticked rows (v4 D13): one question, then it happens at once; it does not wait for Save. *@
                    <AppButton Label="@EditorDeleteRules.DeleteRowsLabel(Batch.Count, Noun)"
                               StartIcon="@AppMaterialIcons.Outlined.Delete"
                               ButtonStyle="AppButtonStyle.Outlined"
                               Tone="AppUiTone.Error"
                               Size="AppControlSize.Compact"
                               Class="tl-contents__delete"
                               Disabled="@(Flow.Saving || _deleting)"
                               OnClick="DeleteTickedAsync" />
                }

                <AppButton Label="@L["Activity_Clear"].Value" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact" OnClick="ClearTicks" />
            </span>
        </div>
    }

    @if (!page.Known || (page.Rows.Count == 0 && page.Loading))
    {
        <EditorPanelBusy Label="@L["EditorContents_Loading"].Value" />
    }
    else if (page.Rows.Count == 0 && page.Failed)
    {
        <AppAlert Severity="AppSeverity.Error" Dense="true">
            @L["EditorContents_CouldNotRead"]
            <AppButton Label="@L["Common_TryAgain"].Value" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact" OnClick="RetryAsync" />
        </AppAlert>
    }
    else if (page.Rows.Count == 0)
    {
        <p class="tl-contents__empty" data-testid="contents-empty">@L["EditorContents_Empty"]</p>
    }
    else
    {
        <table class="tl-contents__table" data-testid="contents-table">
            <caption class="tl-contents__caption">@Heading</caption>
            <thead>
                <tr>
                    <th scope="col" class="tl-contents__tick"><span class="tl-contents__visually-hidden">@L["EditorContents_Select"]</span></th>
                    <th scope="col" class="tl-contents__pic"><span class="tl-contents__visually-hidden">@L["EditorContents_Picture"]</span></th>
                    <th scope="col" class="tl-contents__num">#</th>
                    <th scope="col">@L["EditorContents_Title"]</th>
                    <th scope="col">@L["EditorContents_Status"]</th>
                    <th scope="col" class="tl-contents__size">@L["EditorContents_Size"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in page.Rows)
                {
                    var selectable = CanEdit && !row.IsParent;
                    var ticked = Batch.Contains(row.EntityId);
                    <tr class="@(ticked ? "tl-contents__row is-ticked" : "tl-contents__row")" data-row-id="@row.EntityId" @key="row.EntityId">
                        <td class="tl-contents__tick">
                            @if (selectable)
                            {
                                <AppCheckbox Value="@ticked"
                                             ValueChanged="@(_ => Toggle(row))"
                                             Disabled="@Flow.Saving"
                                             aria-label="@BulkEditRules.SelectLabel(row.Title)" />
                            }
                        </td>
                        <td class="tl-contents__pic">
                            @if (!string.IsNullOrWhiteSpace(row.ImageUrl))
                            {
                                <AppImage Src="@row.ImageUrl" Alt="" Width="72" Height="40" ObjectFit="AppObjectFit.Cover" Class="tl-contents__img" />
                            }
                        </td>
                        <td class="tl-contents__num">@(row.Number ?? "?")</td>
                        <td class="tl-contents__title">
                            <AppButton Label="@row.Title"
                                       ButtonStyle="AppButtonStyle.Text"
                                       Tone="AppUiTone.Neutral"
                                       Size="AppControlSize.Compact"
                                       Class="tl-contents__open"
                                       Disabled="@(Flow.Saving || Flow.Switching)"
                                       OnClick="@(() => OpenRowAsync(row))" />
                            @if (row.Variant is { Length: > 0 } variant)
                            {
                                <small class="tl-contents__variant">@variant</small>
                            }
                        </td>
                        <td>
                            @if (row.Matched)
                            {
                                <AppChip Text="@L["EditorContents_Matched"].Value" Icon="@AppMaterialIcons.Outlined.Check" Tone="AppUiTone.Success" Class="tl-contents__mark" />
                            }
                            else
                            {
                                <AppChip Text="@L["EditorContents_NotMatched"].Value" Icon="@AppMaterialIcons.Outlined.Warning" Tone="AppUiTone.Warning" Title="@row.Reason" Class="tl-contents__mark is-unmatched" />
                            }
                        </td>
                        <td class="tl-contents__size">@(row.SizeBytes is > 0 ? DisplayFormat.FormatFileSize(row.SizeBytes.Value) : string.Empty)</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (page.Loading)
        {
            <EditorPanelBusy Label="@L["EditorContents_LoadingMore"].Value" />
        }
        else if (page.HasMore)
        {
            <div id="@SentinelId" class="tl-contents__more">
                <AppButton Label="@string.Format(L["EditorRail_ShowMore"].Value, page.Remaining)"
                           ButtonStyle="AppButtonStyle.Text"
                           Tone="AppUiTone.Neutral"
                           OnClick="LoadMoreAsync" />
            </div>
        }
        else if (page.Failed)
        {
            <AppAlert Severity="AppSeverity.Error" Dense="true">
                @L["EditorContents_RestCouldNotRead"]
                <AppButton Label="@L["Common_TryAgain"].Value" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact" OnClick="RetryAsync" />
            </AppAlert>
        }
    }

    @if (OrderContent is not null)
    {
        @OrderContent
    }
</div>

@code {
    private const string ObserverModule = "./js/load-more-observer.js";
    private IJSObjectReference? _module;
    private DotNetObjectReference<MoreCallback>? _callback;
    private string? _observedId;
    private Guid _requestedFor;
    private EditorFamilyState? _family;
    private BulkEditSelection? _batch;

    /// <summary>The editor's session flow: switching to a row's own item, and whether a save is running.</summary>
    [Parameter, EditorRequired] public EditSessionFlow Flow { get; set; } = default!;

    [Parameter, EditorRequired] public EditorFamilyState Family { get; set; } = default!;

    /// <summary>The ticked rows; shared with the bulk panel, so ticking here is what makes the editor several-items.</summary>
    [Parameter, EditorRequired] public BulkEditSelection Batch { get; set; } = default!;

    /// <summary>The show, season, album or series whose children are listed.</summary>
    [Parameter, EditorRequired] public Guid ParentId { get; set; }

    /// <summary>The Engine allows editing here; without it the rows are listed with no tick boxes.</summary>
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>Told which items were deleted from the ticked rows, so the editor drops them from its lists (the host's <c>ItemsDeletedAsync</c>).</summary>
    [Parameter] public EventCallback<IReadOnlyCollection<Guid>> OnDeleted { get; set; }

    /// <summary>The order of a video series (drag and arrows), drawn under the list; null for anything whose order is not the person's.</summary>
    [Parameter] public RenderFragment? OrderContent { get; set; }

    private string SentinelId => $"tl-contents-more-{ParentId:N}";

    private string Heading => Family.Kind switch
    {
        EditorFamilyKind.Show => L["EditorContents_HeadingShow"].Value,
        EditorFamilyKind.Album => L["EditorContents_HeadingAlbum"].Value,
        _ => L["EditorContents_HeadingSeries"].Value,
    };

    private string Noun => BulkEditRules.Noun(Batch.Rows, Batch.MediaType);

    private bool _deleting;

    // Delete is for an administrator on a desktop; the Engine still decides on every call.
    private bool CanDeleteRows => CanEdit
        && Batch.Count > 0
        && LibraryItemDeletionFlow.CanDelete(Services.GetService<DeviceContextService>(), Services.GetService<DashboardSessionAccessor>());

    protected override async Task OnParametersSetAsync()
    {
        if (!ReferenceEquals(_family, Family))
        {
            if (_family is not null)
            {
                _family.Changed -= OnChanged;
            }

            _family = Family;
            _family.Changed += OnChanged;
        }

        if (!ReferenceEquals(_batch, Batch))
        {
            if (_batch is not null)
            {
                _batch.Changed -= OnChanged;
            }

            _batch = Batch;
            _batch.Changed += OnChanged;
        }

        // The first page of children is read when the tab opens on a parent that has none yet.
        if (_requestedFor != ParentId)
        {
            _requestedFor = ParentId;
            await Family.EnsureChildrenAsync(ParentId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Family.ContentsOf(ParentId).Known)
        {
            // The family was still being read when this tab asked; once the parent is known its first page is read.
            _requestedFor = Guid.Empty;
            return;
        }

        if (_requestedFor == Guid.Empty)
        {
            _requestedFor = ParentId;
            await Family.EnsureChildrenAsync(ParentId);
        }

        await SyncObserverAsync();
    }

    private void Toggle(ContentsRow row)
    {
        // The rows hold only what the tree knows; an episode of a show or a song of an album is told apart so the bar can name them.
        var kind = Family.Kind == EditorFamilyKind.Show ? DetailEntityType.TvEpisode : DetailEntityType.Work;
        var mediaType = Family.Kind switch
        {
            EditorFamilyKind.Album => "Music",
            EditorFamilyKind.Show => "TV",
            _ => Batch.MediaType,
        };
        if (Batch.Toggle(new BulkEditRow(row.EntityId, row.Title, kind, Family.ParentOf(row.EntityId), mediaType)) && Batch.MediaType is null && mediaType is not null)
        {
            Batch.MediaType = mediaType;
        }
    }

    // Ticked rows are edited together: the Edit panel opens in the window, and Back returns to this list with the ticks kept.
    private void OpenEdit()
    {
        Batch.ReturnTool = EditTool.Contents;
        Batch.OpenPanel(BulkPanelKind.Edit);
    }

    private void OpenMatch()
    {
        Batch.ReturnTool = EditTool.Contents;
        Batch.OpenPanel(BulkPanelKind.Match);
    }

    private void ClearTicks() => Batch.Clear();

    // The ticked rows go at once after the one question. A failure shows its reason in the question and nothing leaves the list; a row
    // leaves it only for a title the Engine deleted.
    private async Task DeleteTickedAsync()
    {
        if (_deleting || Batch.Count == 0 || Services.GetService<IAppDialogService>() is not { } dialogs || Services.GetService<IAppToastService>() is not { } toasts)
        {
            return;
        }

        if (LibraryItemDeletionFlow.TryRefuse(Services.GetService<DeviceContextService>(), Services.GetService<DashboardSessionAccessor>(), toasts))
        {
            return;
        }

        var ids = Batch.Ids;
        _deleting = true;
        using var editorDeleting = Services.GetService<EditorHost>()?.MarkDeleting();
        try
        {
            var answer = await LibraryItemDeletionFlow.RunForResultAsync(dialogs, toasts, ids, ids.Count == 1 ? Batch.Rows[0].Title : null);
            if (answer is not null)
            {
                await OnDeleted.InvokeAsync(EditorDeleteRules.Removed(answer, ids, null, Family.ParentOf));
            }
        }
        finally
        {
            _deleting = false;
        }
    }

    private Task LoadMoreAsync() => Family.LoadMoreAsync(ParentId);

    private Task RetryAsync() => Family.RetryAsync(ParentId);

    // A row's title opens that item in the editor (its own Details; Match when it is not matched yet).
    private async Task OpenRowAsync(ContentsRow row)
    {
        if (Family.TrailTo(row.EntityId) is not { Count: > 0 } trail || !await Flow.SwitchToAsync(trail))
        {
            return;
        }

        if (!row.Matched && Flow.Session.ActiveTool == EditTool.Details)
        {
            await Flow.SelectToolAsync(EditTool.Match);
        }
    }

    private async Task SyncObserverAsync()
    {
        var wantedId = Family.ContentsOf(ParentId) is { HasMore: true, Loading: false } ? SentinelId : null;
        try
        {
            if (_observedId is not null && _observedId != wantedId && _module is not null)
            {
                await _module.InvokeVoidAsync("disconnectById", _observedId);
            }

            _observedId = wantedId;
            if (wantedId is null)
            {
                return;
            }

            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ObserverModule);
            _callback ??= DotNetObjectReference.Create(new MoreCallback(() => InvokeAsync(LoadMoreAsync)));
            // Observing again reports the sentinel's state at once, so a list still short of the bottom keeps paging in.
            await _module.InvokeVoidAsync("observeById", wantedId, _callback, new { rootMargin = "160px 0px" });
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException or JSDisconnectedException)
        {
            // No script support (a test host, a closing circuit): the "Show more" button still pages the list in.
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        if (_family is not null)
        {
            _family.Changed -= OnChanged;
        }

        if (_batch is not null)
        {
            _batch.Changed -= OnChanged;
        }

        try
        {
            if (_module is not null)
            {
                if (_observedId is not null)
                {
                    await _module.InvokeVoidAsync("disconnectById", _observedId);
                }

                await _module.DisposeAsync();
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or InvalidOperationException)
        {
            // The circuit ended first, or the script never loaded; there is nothing left to disconnect.
        }

        _callback?.Dispose();
    }

    /// <summary>What the page-in observer calls when the end of the list nears the screen.</summary>
    public sealed class MoreCallback(Func<Task> loadMore)
    {
        [JSInvokable]
        public Task LoadMoreFromObserverAsync() => loadMore();
    }
}
