        if (item.EntityType == DetailEntityType.TvEpisode || !Guid.TryParse(item.Id, out var id))
            return null;

        return $"/details/work/{id:D}?context={ContextKey(item.EntityType)}";
    }

    private static bool AreCanonicallyAdjacent(SequenceItemViewModel left, SequenceItemViewModel right)
    {
        var leftPosition = CanonicalSequencePosition(left);
        var rightPosition = CanonicalSequencePosition(right);
        if (!leftPosition.HasValue || !rightPosition.HasValue)
            return false;

        return Math.Abs((rightPosition.Value - leftPosition.Value) - 1d) < 0.0001d;
    }

    private static double? CanonicalSequencePosition(SequenceItemViewModel item)
    {
        if (item.PositionSort.HasValue)
            return item.PositionSort.Value;

        var label = SequenceNumberOrNull(item);
        if (string.IsNullOrWhiteSpace(label))
            return null;

        var match = System.Text.RegularExpressions.Regex.Match(label, @"-?\d+(?:\.\d+)?");
        return match.Success
            && double.TryParse(match.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed)
                ? parsed
                : null;
    }

