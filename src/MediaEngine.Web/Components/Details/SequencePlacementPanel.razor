    private async Task ShowMissingChangedAsync(bool value)
    {
        if (_savingMissingPreference)
            return;

        var previous = _showMissing;
        _showMissing = value;
        _visibleMissingLimit = _missingItemPolicy?.PageSize ?? 0;
        ResetWindowToCurrentItem();

        var containerKey = ResolveSeriesPreferenceContainerKey();
        var mediaType = ResolveMediaPolicyKey();
        if (_activeProfileId is not { } profileId
            || string.IsNullOrWhiteSpace(containerKey)
            || string.IsNullOrWhiteSpace(mediaType))
        {
            _showMissing = previous;
            ResetWindowToCurrentItem();
            Snackbar.Add("An active profile and stable series identity are required to remember this setting.", AppSeverity.Warning);
            return;
        }

        _savingMissingPreference = true;
        try
        {
            var saved = await ApiClient.SaveSeriesMissingItemPreferenceAsync(
                profileId,
                mediaType,
                containerKey,
                value);
            if (saved?.ShowMissing is not { } savedValue)
            {
                _showMissing = previous;
                ResetWindowToCurrentItem();
                Snackbar.Add("The series preference could not be saved.", AppSeverity.Error);
                return;
            }

            _showMissing = savedValue;
            _hasMissingPreferenceOverride = true;
            ResetWindowToCurrentItem();
        }
        finally
        {
            _savingMissingPreference = false;
        }
    }

    private async Task ResetMissingPreferenceAsync()
    {
        if (_savingMissingPreference)
            return;

        var containerKey = ResolveSeriesPreferenceContainerKey();
        var mediaType = ResolveMediaPolicyKey();
        if (_activeProfileId is not { } profileId
            || string.IsNullOrWhiteSpace(containerKey)
            || string.IsNullOrWhiteSpace(mediaType))
        {
            return;
        }

        _savingMissingPreference = true;
        try
        {
            var reset = await ApiClient.ResetSeriesMissingItemPreferenceAsync(
                profileId,
                mediaType,
                containerKey);
            if (reset is null)
            {
                Snackbar.Add("The series preference could not be reset.", AppSeverity.Error);
                return;
            }

            _hasMissingPreferenceOverride = false;
            _showMissing = _configuredShowMissingDefault;
            _visibleMissingLimit = _missingItemPolicy?.PageSize ?? 0;
            ResetWindowToCurrentItem();
        }
        finally
        {
            _savingMissingPreference = false;
        }
    }

    private IReadOnlyList<SequenceItemViewModel> ApplyMissingItemPolicy(
        IReadOnlyList<SequenceItemViewModel> source)
    {
        if (!CanShowMissingToggle || !_showMissing)
            return source.Where(item => item.IsOwned).ToList();

        if (!UsesPagedMissingItems)
            return source;

        var missingRemaining = Math.Max(0, _visibleMissingLimit);
        return source.Where(item => item.IsOwned || missingRemaining-- > 0).ToList();
    }

    private void LoadMoreMissingItems()
    {
        _visibleMissingLimit += _missingItemPolicy?.PageSize ?? 0;
        ResetWindowToCurrentItem();
    }

