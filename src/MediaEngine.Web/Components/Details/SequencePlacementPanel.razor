@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details
@using MediaEngine.Contracts.Display
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Services.Integration
@using System.Globalization
@using Microsoft.JSInterop
@inject IEngineApiClient ApiClient
@inject UIOrchestratorService Orchestrator
@inject DashboardSessionAccessor Session
@inject IJSRuntime Js
@inject IAppToastService Snackbar
@implements IAsyncDisposable

@if (DetailSurface)
{
<section class="@DetailSurfaceClass" aria-label="@($"{Placement.ContainerTitle} {Placement.ItemPluralLabel}")">
    @if (!string.IsNullOrWhiteSpace(ActiveGroup?.BackgroundArtworkUrl))
    {
        <AppCssElement Tag="div"
                       Class="tl-series-detail__season-atmosphere"
                       Css="@SeasonAtmosphereStyle"
                       aria-hidden="true" />
    }
    @if (HasTopControls)
    {
    <header class="tl-series-detail__header">
        <div class="tl-series-detail__controls">
            <div class="tl-series-detail__selectors">
                @if (CanChooseDistinctContainer)
                {
                    <AppCssElement Tag="div"
                                   Class="tl-series-detail__control tl-series-detail__control--container"
                                   >
                        <span class="sr-only">Choose series</span>
                        <div class="tl-series-detail__select-with-action">
                            <AppSelect Value="@SelectedContainerValue"
                                       ValueChanged="SelectContainerValueAsync"
                                       Options="@ContainerSelectOptions"
                                       LeadingIcon="@ContainerIcon"
                                       Class="tl-series-detail__select" Sizing="intrinsic" FullWidth="false"
                                       PopoverClass="app-select__popover tl-series-select-popover"
                                       aria-label="Choose series" />
                            @if (ShowSetDefault)
                            {
                                <AppIconButton Icon="@AppMaterialIcons.Outlined.Check"
                                               Size="AppControlSize.Compact"
                                               AriaLabel="Make this the default series"
                                               Tooltip="Make default"
                                               Disabled="@_settingDefault"
                                               OnClick="SetDefaultSequenceAsync" />
                            }
                        </div>
                    </AppCssElement>
                }

                @if (ShowGroupSelector)
                {
                    <AppCssElement Tag="div"
                                   Class="tl-series-detail__control tl-series-detail__control--group"
                                   >
                        <span class="sr-only">@(IsSeasonContainer ? "Season" : "Arc / sub-series")</span>
                        @if (IsSeasonContainer)
                        {
                            <AppNativeButton Type="button"
                                             Class="@SeasonToggleClass"
                                             OnClick="ToggleSeasonBrowser"
                                             aria-pressed="@_seasonBrowserOpen"
                                             aria-expanded="@_seasonBrowserOpen"
                                             aria-controls="@_seasonStripId"
                                             AriaLabel="@($"Choose season; {ActiveGroup?.Title ?? "current season"} selected")">
                                <span class="tl-season-toggle__art">
                                    @if (!string.IsNullOrWhiteSpace(ActiveGroup?.ArtworkSmallUrl))
                                    {
                                        <img src="@ActiveGroup.ArtworkSmallUrl" alt="" width="40" height="60" decoding="async" />
                                    }
                                    else
                                    {
                                        <span>@SeasonShortLabel(ActiveGroup)</span>
                                    }
                                </span>
                                <span class="tl-season-toggle__label">@(ActiveGroup?.Title ?? "Season")</span>
                                <AppMaterialIcon Class="tl-season-toggle__chevron"
                                         Icon="@AppMaterialIcons.Outlined.ExpandMore"
                                         Size="AppSize.Small" />
                            </AppNativeButton>
                        }
                        else
                        {
                            <AppSelect Value="@SelectedGroupKey"
                                       ValueChanged="SelectGroup"
                                       Options="@GroupSelectOptions"
                                       LeadingIcon="@AppMaterialIcons.Outlined.AccountTree"
                                       Class="tl-series-detail__select" Sizing="intrinsic" FullWidth="false"
                                       PopoverClass="app-select__popover tl-series-select-popover"
                                       aria-label="@GroupSelectorAriaLabel" />
                        }
                    </AppCssElement>
                    }
            </div>

        @if (IsSeasonContainer && ShowJumpSelector && !_seasonBrowserOpen)
        {
            <div class="tl-series-detail__jump">
                <span>Jump to @ItemNoun.ToLowerInvariant()</span>
                <AppSelect Value="@JumpSelectionValue"
                           ValueChanged="SelectJump"
                           Options="@JumpSelectOptions"
                           Size="AppControlSize.Large"
                           Class="tl-series-detail__select" Sizing="intrinsic" FullWidth="false"
                           PopoverClass="app-select__popover tl-series-select-popover"
                           aria-label="@($"Jump to {ItemNoun.ToLowerInvariant()} by name")" />
            </div>
        }
        </div>
    </header>
    }

    @if (!IsSeasonContainer)
    {
    <div class="tl-series-detail__heading">
        @if (!IsSeasonContainer)
        {
            <div class="tl-series-detail__identity">
                <AppMaterialIcon Icon="@ContainerIcon" Size="AppSize.Small" />
                <div>
                    <span>@ContainerTitleDisplay</span>
                    <small>@Placement.ItemPluralLabel · @OwnedSummary</small>
                </div>
            </div>
        }
        @if (!IsSeasonContainer && ShowJumpSelector && !_seasonBrowserOpen)
        {
            <div class="tl-series-detail__jump">
                <span>Jump to @ItemNoun.ToLowerInvariant()</span>
                <AppSelect Value="@JumpSelectionValue"
                           ValueChanged="SelectJump"
                           Options="@JumpSelectOptions"
                           Size="AppControlSize.Large"
                           Class="tl-series-detail__select" Sizing="intrinsic" FullWidth="false"
                           PopoverClass="app-select__popover tl-series-select-popover"
                           aria-label="@($"Jump to {ItemNoun.ToLowerInvariant()} by name")" />
            </div>
        }
    </div>
    }

    @if (_seasonBrowserOpen && IsSeasonContainer)
    {
    <div class="tl-series-detail__carousel tl-season-browser">
        <AppIconButton Class="tl-series-carousel__arrow tl-series-carousel__arrow--left"
                       Icon="@AppMaterialIcons.Outlined.ChevronLeft"
                       Size="AppControlSize.Large"
                       AriaLabel="Previous seasons"
                       OnClick="@(() => PageSeasonRailAsync(-1))" />
        <div id="@_seasonStripId"
             class="tl-season-browser__strip"
             role="listbox"
             aria-label="Choose season">
            @for (var index = 0; index < VisibleGroups.Count; index++)
            {
                var season = VisibleGroups[index];
                var selected = string.Equals(season.Key, SelectedGroupKey, StringComparison.OrdinalIgnoreCase);
                <AppNativeButton Type="button"
                                 Class="@(selected ? "tl-season-card is-selected" : "tl-season-card")"
                                 OnClick="@(() => SelectSeason(season.Key))"
                                 data-sequence-index="@index"
                                 role="option"
                                 aria-selected="@selected"
                                 aria-current="@(selected ? "true" : null)">
                    <span class="tl-season-card__art">
                        @if (!string.IsNullOrWhiteSpace(season.ArtworkUrl))
                        {
                            <img src="@season.ArtworkUrl"
                                 alt=""
                                 width="280"
                                 height="420"
                                 loading="@(selected ? "eager" : "lazy")"
                                 fetchpriority="@(selected ? "high" : "auto")"
                                 decoding="async" />
                        }
                        else
                        {
                            <span>@SeasonShortLabel(season)</span>
                        }
                    </span>
                    <strong>@season.Title</strong>
                </AppNativeButton>
            }
        </div>
        <AppIconButton Class="tl-series-carousel__arrow tl-series-carousel__arrow--right"
                       Icon="@AppMaterialIcons.Outlined.ChevronRight"
                       Size="AppControlSize.Large"
                       AriaLabel="Next seasons"
                       OnClick="@(() => PageSeasonRailAsync(1))" />
    </div>
    }
    else
    {
    <div class="tl-series-detail__carousel">
        <AppIconButton Class="@LeftArrowClass"
                       Icon="@AppMaterialIcons.Outlined.ChevronLeft"
                       Size="AppControlSize.Large"
                       aria-label="@($"Previous {Placement.ItemPluralLabel.ToLowerInvariant()}")"
                       Disabled="@(!CanPageLeft)"
                       OnClick="PageLeft" />
        <AppCssElement Tag="div"
                       @ref="_episodeStrip"
                       id="@_episodeStripId"
                       Class="tl-series-detail__strip"
                       Css="@SequenceGridStyle"
                       aria-label="@($"{Placement.ContainerTitle} order")">
            @for (var index = 0; index < VisibleItems.Count; index++)
            {
                var item = VisibleItems[index];
                var previousItem = index > 0 ? VisibleItems[index - 1] : null;
                var route = SequenceItemRoute(item);
                if (route is not null)
                {
                    <a class="@SequenceItemClass(item)"
                       href="@route"
                       aria-current="@(item.IsCurrent ? "page" : null)"
                       aria-label="Open @SequenceItemTitle(item)">
                        <SequenceEntryContent Item="item" IsSeasonContainer="IsSeasonContainer"
                                              ShowConnector="@(previousItem is not null && AreCanonicallyAdjacent(previousItem, item))"
                                              PositionLabel="@SequenceNumber(item)" Title="@SequenceItemTitle(item)"
                                              DisplayTitle="@SequenceItemDisplayTitle(item)" TitleClass="@SequenceItemTitleClass(item)"
                                              AirDate="@SequenceItemAirDate(item)" ItemDate="@SequenceItemDate(item)"
                                              MissingIcon="@MissingIcon" />
                    </a>
                }
                else
                {
                    <article class="@SequenceItemClass(item)"
                             aria-current="@(item.IsCurrent ? "page" : null)"
                             aria-label="@SequenceItemAccessibilityLabel(item)">
                        <SequenceEntryContent Item="item" IsSeasonContainer="IsSeasonContainer"
                                              ShowConnector="@(previousItem is not null && AreCanonicallyAdjacent(previousItem, item))"
                                              PositionLabel="@SequenceNumber(item)" Title="@SequenceItemTitle(item)"
                                              DisplayTitle="@SequenceItemDisplayTitle(item)" TitleClass="@SequenceItemTitleClass(item)"
                                              AirDate="@SequenceItemAirDate(item)" ItemDate="@SequenceItemDate(item)"
                                              MissingIcon="@MissingIcon" />
                    </article>
                }
            }
        </AppCssElement>
        <AppIconButton Class="@RightArrowClass"
                       Icon="@AppMaterialIcons.Outlined.ChevronRight"
                       Size="AppControlSize.Large"
                       aria-label="@($"Next {Placement.ItemPluralLabel.ToLowerInvariant()}")"
                       Disabled="@(!CanPageRight)"
                       OnClick="PageRight" />
    </div>
    }

    @if (HasMoreConfiguredMissingItems)
    {
        <AppNativeButton Type="button"
                         Class="tl-series-load-missing"
                         OnClick="LoadMoreMissingItems">
            Load more missing @Placement.ItemPluralLabel.ToLowerInvariant()
        </AppNativeButton>
    }

    <footer class="tl-series-detail__ownership"
            aria-label="@OwnershipSummaryLabel">
        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Layers" Size="AppSize.Small" />
        <strong>@OwnedCount owned</strong>
        @if (ShowCoverageBar)
        {
            <span class="tl-series-detail__ownership-separator" aria-hidden="true"></span>
            <span>@MissingCount missing</span>
            <span class="tl-series-detail__ownership-progress"
                  role="progressbar"
                  aria-label="@OwnershipSummaryLabel"
                  aria-valuemin="0"
                  aria-valuemax="@TotalItems"
                  aria-valuenow="@OwnedCount">
                <AppCssElement Tag="span"
                               Class="tl-series-detail__ownership-progress-fill"
                               Css="@OwnershipProgressStyle" />
            </span>
            <span>@TotalItems total</span>
        }
            <div class="tl-series-detail__footer-utilities">
                @if (CanShowMissingToggle)
                {
                    <div class="tl-series-detail__missing">
                        <AppCheckbox
                                     Value="@_showMissing"
                                     ValueChanged="ShowMissingChangedAsync"
                                     Color="AppColor.Primary"
                                     Dense="true"
                                     Disabled="@_savingMissingPreference"
                                     Label="Show missing" />
                        @if (_hasMissingPreferenceOverride)
                        {
                            <AppIconButton Icon="@AppMaterialIcons.Outlined.Restore"
                                           Size="AppControlSize.Compact"
                                           AriaLabel="Use the configured media default"
                                           Tooltip="Use media default"
                                           Disabled="@_savingMissingPreference"
                                           OnClick="ResetMissingPreferenceAsync" />
                        }
                    </div>
                }
            </div>
    </footer>
</section>
}
else
{
<section class="tl-series-placement @PanelClass">
    <div class="tl-series-layout">
    <aside class="tl-series-header">
        @if (Compact)
        {
            <div class="tl-series-eyebrow">
                <span>@HeadingLabel</span>
                <small>@HeadingValue</small>
            </div>
        }
        else
        {
        <div class="tl-series-controls">
            <div class="tl-series-heading">
                @if (IsSeasonContainer)
                {
                    <a class="tl-series-show-link" href="@ShowDetailRoute">@ContainerTitleDisplay</a>
                    <span aria-hidden="true">:</span>
                    <strong>@HeadingValue</strong>
                }
                else
                {
                    <span>@HeadingLabel:</span>
                    <strong>@HeadingValue</strong>
                }
            </div>
            @if (CanChooseDistinctContainer)
            {
                <div class="tl-series-control-row">
                    <AppSelect Value="@SelectedContainerValue"
                               ValueChanged="SelectContainerValueAsync"
                               Options="@ContainerSelectOptions"
                               LeadingIcon="@AppMaterialIcons.Outlined.Layers"
                               Size="AppControlSize.Large"
                               Class="tl-series-control tl-series-control--set"
                               PopoverClass="app-select__popover tl-series-select-popover"
                               aria-label="Choose series" />
                    @if (ShowSetDefault)
                    {
                        <div class="tl-series-default-control">
                            <AppNativeButton Type="button" Class="tl-series-default-action" Disabled="@_settingDefault" OnClick="SetDefaultSequenceAsync">
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.StarOutline" Size="AppSize.Small" />
                                <span>Make default</span>
                            </AppNativeButton>
                            <small>Use as your default series</small>
                        </div>
                    }
                </div>
            }
            @if (ShowGroupSelector)
            {
                <AppSelect Value="@SelectedGroupKey"
                           ValueChanged="SelectGroup"
                           Options="@GroupSelectOptions"
                           Size="AppControlSize.Large"
                           Class="tl-series-control tl-series-control--group"
                           PopoverClass="app-select__popover tl-series-select-popover"
                           aria-label="@GroupSelectorAriaLabel" />
            }
            @if (CanShowMissingToggle)
            {
                <div class="tl-series-missing-preference">
                    <AppCheckbox
                                 Value="@_showMissing"
                                 ValueChanged="ShowMissingChangedAsync"
                                 Class="tl-series-show-missing"
                                 Color="AppColor.Primary"
                                 Dense="true"
                                 Disabled="@_savingMissingPreference"
                                 Label="Show missing" />
                    @if (_hasMissingPreferenceOverride)
                    {
                        <AppIconButton Icon="@AppMaterialIcons.Outlined.Restore"
                                       Size="AppControlSize.Compact"
                                       Class="tl-series-missing-preference__reset"
                                       AriaLabel="Use the configured media default"
                                       Tooltip="Use media default"
                                       Disabled="@_savingMissingPreference"
                                       OnClick="ResetMissingPreferenceAsync" />
                    }
                </div>
            }
        </div>
        }

        <div class="tl-series-position-summary" aria-label="@PositionSummary">
            <div class="@CoverageVisualClass">
                @if (ShowCoverageDonut)
                {
                    <AppChart T="double"
                              ChartType="AppChartType.Donut"
                              ChartSeries="@SequenceDonutSeries"
                              ChartLabels="@SequenceDonutLabels"
                              ChartOptions="@SequenceDonutOptions"
                              Width="8.8rem"
                              Height="8.8rem" />
                }
                <div class="@CoverageCenterClass">
                    @if (IsComicSequence && HasCurrentPosition)
                    {
                        <span class="tl-series-position-summary__total">@CoverageSecondaryText</span>
                        <span class="tl-series-position-summary__number">@CoveragePrimaryText</span>
                    }
                    else
                    {
                        <span class="tl-series-position-summary__number">@CoveragePrimaryText</span>
                        <span class="tl-series-position-summary__total">@CoverageSecondaryText</span>
                    }
                </div>
            </div>
        </div>

        @if (!IsSeasonContainer && SeriesDateRange is not null)
        {
            <div class="tl-series-date-range">
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CalendarMonth" Size="AppSize.Small" />
                <span>@SeriesDateRange</span>
            </div>
        }

        @if (!Compact && !IsSeasonContainer && !string.IsNullOrWhiteSpace(Placement.ContainerDescription))
        {
            <p class="tl-series-description">@Placement.ContainerDescription</p>
        }

        @if (!Compact && IsSeasonContainer && !string.IsNullOrWhiteSpace(Placement.ContainerDescription))
        {
            <section class="tl-series-information" aria-labelledby="series-description-heading">
                <h2 id="series-description-heading"><span>Series Description</span></h2>
                <p id="series-description-copy" class="@SeriesDescriptionClass" @ref="_seriesDescriptionElement">@Placement.ContainerDescription</p>
                @if (HasExpandableSeriesDescription)
                {
                    <AppNativeButton Type="button"
                                     Class="tl-series-information__toggle"
                                     AdditionalAttributes="SeriesDescriptionToggleAttributes"
                                     OnClick="ToggleSeriesDescription">
                        @(_seriesDescriptionExpanded ? "Less" : "More")
                    </AppNativeButton>
                }
            </section>
        }

        <div class="tl-series-owned-summary">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Layers" Size="AppSize.Small" />
            <span>@OwnedSummary</span>
            @if (ShowCoverageDonut)
            {
                <span class="tl-series-owned-summary__dot" aria-hidden="true"></span>
                <span>@MissingCount missing</span>
            }
            @if (SeriesWikidataUrl is not null)
            {
                <a class="tl-series-source-link"
                   href="@SeriesWikidataUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                    aria-label="Open @SeriesWikidataQid on Wikidata in a new tab">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.OpenInNew" Size="AppSize.Small" />
                    <span>@SourceKindLabel: Wikidata (@SeriesWikidataQid)</span>
                </a>
            }
            @if (ComicVineSeriesUrl is not null)
            {
                <a class="tl-series-source-link"
                   href="@ComicVineSeriesUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Open this comic series on Comic Vine in a new tab">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.OpenInNew" Size="AppSize.Small" />
                    <span>@SourceKindLabel: Comic Vine</span>
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(Placement.ContainerWikipediaUrl))
            {
                <a class="tl-series-source-link"
                   href="@Placement.ContainerWikipediaUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Open the series article on Wikipedia in a new tab">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.OpenInNew" Size="AppSize.Small" />
                    <span>@SourceKindLabel: Wikipedia</span>
                </a>
            }
        </div>

    </aside>

    <div class="tl-series-content">
        @if (!Compact && ShowJumpSelector)
        {
            <div class="tl-series-content__toolbar">
                <div class="tl-series-jump">
                    <AppSelect Label="Jump to"
                               Value="@JumpSelectionValue"
                               ValueChanged="SelectJump"
                               Options="@JumpSelectOptions"
                               Class="tl-series-control tl-series-control--jump"
                               PopoverClass="app-select__popover tl-series-select-popover" />
                </div>
            </div>
        }

        <div class="tl-series-carousel">
        <AppIconButton Class="@LeftArrowClass"
                       Icon="@AppMaterialIcons.Outlined.ChevronLeft"
                       Size="AppControlSize.Large"
                       aria-label="@($"Previous {Placement.ItemPluralLabel.ToLowerInvariant()}")"
                       Disabled="@(!CanPageLeft)"
                       OnClick="PageLeft" />
        <AppCssElement Tag="div" @ref="_episodeStrip" id="@_episodeStripId" Class="tl-series-strip" Css="@SequenceGridStyle" aria-label="@($"{Placement.ContainerTitle} order")">
            @for (var index = 0; index < VisibleItems.Count; index++)
            {
                var item = VisibleItems[index];
                var previousItem = index > 0 ? VisibleItems[index - 1] : null;
                var route = SequenceItemRoute(item);
                if (IsSeasonContainer && item.IsOwned && item.EpisodeContext is not null)
                {
                    <div class="sequence-episode-tile @(item.IsCurrent ? "is-current" : null) @(_sameFileHighlight.Contains(item.Id) ? "is-same-file-highlight" : null)" aria-current="@(item.IsCurrent ? "page" : null)">
                        <MediaTile ShowCompactCaption="true" Item="@SequenceEpisodeTileAdapter.FromItem(item)" />
                        <SameFileChip Links="item.CoveredWith"
                                      CanHighlight="@HasVisibleSibling(item)"
                                      IsHighlighting="@IsHighlightingSiblings(item)"
                                      OnHighlight="@(() => ToggleSameFileHighlight(item))" />
                    </div>
                }
                else if (route is not null)
                {
                    <a class="@SequenceItemClass(item)"
                       href="@route"
                       aria-current="@(item.IsCurrent ? "page" : null)"
                       aria-label="Open @SequenceItemTitle(item)">
                        <SequenceEntryContent Item="item" IsSeasonContainer="IsSeasonContainer"
                                              ShowConnector="@(previousItem is not null && AreCanonicallyAdjacent(previousItem, item))"
                                              PositionLabel="@SequenceNumber(item)" Title="@SequenceItemTitle(item)"
                                              DisplayTitle="@SequenceItemDisplayTitle(item)" TitleClass="@SequenceItemTitleClass(item)"
                                              AirDate="@SequenceItemAirDate(item)" ItemDate="@SequenceItemDate(item)"
                                              MissingIcon="@MissingIcon" />
                    </a>
                }
                else
                {
                    <article class="@SequenceItemClass(item)"
                             aria-current="@(item.IsCurrent ? "page" : null)"
                             aria-label="@SequenceItemAccessibilityLabel(item)">
                        <SequenceEntryContent Item="item" IsSeasonContainer="IsSeasonContainer"
                                              ShowConnector="@(previousItem is not null && AreCanonicallyAdjacent(previousItem, item))"
                                              PositionLabel="@SequenceNumber(item)" Title="@SequenceItemTitle(item)"
                                              DisplayTitle="@SequenceItemDisplayTitle(item)" TitleClass="@SequenceItemTitleClass(item)"
                                              AirDate="@SequenceItemAirDate(item)" ItemDate="@SequenceItemDate(item)"
                                              MissingIcon="@MissingIcon" />
                    </article>
                }
            }
        </AppCssElement>
        <AppIconButton Class="@RightArrowClass"
                       Icon="@AppMaterialIcons.Outlined.ChevronRight"
                       Size="AppControlSize.Large"
                       aria-label="@($"Next {Placement.ItemPluralLabel.ToLowerInvariant()}")"
                       Disabled="@(!CanPageRight)"
                       OnClick="PageRight" />
        </div>

        @if (HasMoreConfiguredMissingItems)
        {
            <AppNativeButton Type="button"
                             Class="tl-series-load-missing"
                             OnClick="LoadMoreMissingItems">
                Load more missing @Placement.ItemPluralLabel.ToLowerInvariant()
            </AppNativeButton>
        }

    </div>
    </div>
</section>
}

@code {
    [Parameter, EditorRequired] public SequencePlacementViewModel Placement { get; set; } = default!;
    [Parameter] public EventCallback<SequenceContainerOptionViewModel> OnContainerSelected { get; set; }
    [Parameter] public EventCallback<SequenceItemViewModel> OnEditItem { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool DetailSurface { get; set; }

    private const int LongSequenceThreshold = 6;
    private const int PortraitWindowSize = 6;

    private readonly HashSet<string> _sameFileHighlight = new(StringComparer.OrdinalIgnoreCase);
    private string? _placementKey;
    private string? _selectedGroupKey;
    private string? _jumpSelectionValue;
    private int _windowCenterIndex;
    private bool _canCurateSequence;
    private bool _settingDefault;
    private bool _seriesDescriptionExpanded;
    private bool _hasExpandableSeriesDescription;
    private bool _needsSeriesDescriptionMeasurement = true;
    private bool _showMissing;
    private bool _configuredShowMissingDefault;
    private bool _hasMissingPreferenceOverride;
    private bool _savingMissingPreference;
    private bool _seasonBrowserOpen;
    private bool _scrollToCurrentSeason;
    private Guid? _activeProfileId;
    private int _visibleMissingLimit;
    private MissingItemDisplayPolicy? _missingItemPolicy;
    private ElementReference _seriesDescriptionElement;
    private readonly string _seasonStripId = "seasons-" + Guid.NewGuid().ToString("N");

    private bool HasVisibleSibling(SequenceItemViewModel item)
        => item.CoveredWith.Any(link => VisibleItems.Any(other => string.Equals(other.Id, link.Id, StringComparison.OrdinalIgnoreCase)));

    private bool IsHighlightingSiblings(SequenceItemViewModel item)
        => item.CoveredWith.Count > 0 && item.CoveredWith.All(link => _sameFileHighlight.Contains(link.Id));

    private void ToggleSameFileHighlight(SequenceItemViewModel item)
    {
        var turnOff = IsHighlightingSiblings(item);
        _sameFileHighlight.Clear();
        if (!turnOff)
        {
            foreach (var link in item.CoveredWith)
            {
                _sameFileHighlight.Add(link.Id);
            }
        }
    }

    private string PanelClass => $"{MediaShapeClass}{(IsLongSequence ? " tl-series-placement--long" : string.Empty)}{(Compact ? " tl-series-placement--compact" : string.Empty)}";
    private string DetailSurfaceClass => $"tl-series-detail {MediaShapeClass}{(IsSeasonContainer ? " is-season-container" : string.Empty)}";
    private string MediaShapeClass => Placement.CurrentItem.EntityType switch
    {
        DetailEntityType.TvShow or DetailEntityType.TvSeason or DetailEntityType.TvEpisode => "tl-series-panel--landscape",
        DetailEntityType.MusicAlbum or DetailEntityType.Audiobook => "tl-series-panel--square",
        _ => "tl-series-panel--portrait",
    };

    private IReadOnlyList<SequenceGroupViewModel> VisibleGroups
    {
        get
        {
            if (Placement.Groups.Count == 0)
            {
                return [new SequenceGroupViewModel { Key = "all", Title = Placement.ItemPluralLabel, Items = Placement.OrderedItems }];
            }

            var nonEmptyGroups = Placement.Groups.Where(group => group.Items.Count > 0).ToList();
            var scopedGroups = nonEmptyGroups
                .Where(group => !string.Equals(group.Key, "all", StringComparison.OrdinalIgnoreCase))
                .ToList();
            return scopedGroups.Count > 0 ? scopedGroups : nonEmptyGroups;
        }
    }

    private bool IsSeasonContainer => string.Equals(Placement.GroupLabel, "Season", StringComparison.OrdinalIgnoreCase)
