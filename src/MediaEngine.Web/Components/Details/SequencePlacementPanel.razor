    private string? SequenceItemRoute(SequenceItemViewModel item)
    {
        if (!item.IsOwned || (!IsSeasonContainer && item.IsCurrent))
            return null;

        if (EpisodeDetailRoute(item) is { } episodeRoute)
            return episodeRoute;

        if (!string.IsNullOrWhiteSpace(item.Route))
