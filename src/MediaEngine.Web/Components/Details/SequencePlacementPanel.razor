    protected override async Task OnParametersSetAsync()
    {
        var profile = await Orchestrator.GetActiveProfileAsync();
        _activeProfileId = profile?.Id;
        _canCurateSequence = Session.HasNavigation("settings.administration");

        var key = $"{Placement.ContainerId}:{Placement.SelectedContainerId}:{Placement.CurrentItem.Id}:{Placement.OrderedItems.Count}:{Placement.Groups.Count}:{Placement.ContainerDescription}:{_activeProfileId}";
        if (!string.Equals(key, _placementKey, StringComparison.Ordinal))
        {
            _placementKey = key;
            _selectedGroupKey = Placement.CurrentGroupKey;
            _seasonBrowserOpen = false;
            _scrollToCurrentSeason = false;
            _seriesDescriptionExpanded = false;
            _hasExpandableSeriesDescription = false;
            _needsSeriesDescriptionMeasurement = true;
            var preferences = await ApiClient.GetLibraryPreferencesAsync();
            _missingItemPolicy = preferences is not null
                && preferences.MissingItemDisplay.TryGetValue(ResolveMediaPolicyKey(), out var policy)
                    ? policy
                    : null;
            _configuredShowMissingDefault = string.Equals(
                _missingItemPolicy?.DefaultVisibility,
                "shown",
                StringComparison.OrdinalIgnoreCase);
            _showMissing = _configuredShowMissingDefault;
            _hasMissingPreferenceOverride = false;

            var preferenceContainerKey = ResolveSeriesPreferenceContainerKey();
            var mediaType = ResolveMediaPolicyKey();
            if (_activeProfileId is { } profileId
                && !string.IsNullOrWhiteSpace(preferenceContainerKey)
                && !string.IsNullOrWhiteSpace(mediaType))
            {
                var preference = await ApiClient.GetSeriesMissingItemPreferenceAsync(
                    profileId,
                    mediaType,
                    preferenceContainerKey);
                if (preference?.ShowMissing is { } showMissing)
                {
                    _showMissing = showMissing;
                    _hasMissingPreferenceOverride = true;
                }
            }

            _visibleMissingLimit = _missingItemPolicy?.PageSize ?? 0;
            ResetWindowToCurrentItem();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsSeasonContainer && !_seasonBrowserOpen && _episodeStrip is not null
            && !_observedEpisodeStrip.Equals(_episodeStrip.Element))
        {
            if (_episodeReference is not null) await Js.InvokeVoidAsync("unregisterMediaShelfBoundaries", _observedEpisodeStrip);
            _episodeReference ??= DotNetObjectReference.Create(this);
            _observedEpisodeStrip = _episodeStrip.Element;
            await Js.InvokeVoidAsync("registerMediaShelfBoundaries", _observedEpisodeStrip, _episodeReference);
        }
        if (_scrollToCurrentEpisode)
        {
            _scrollToCurrentEpisode = false;
            await Js.InvokeVoidAsync("scrollSequenceItem", _episodeStripId, 0, "start", "auto");
        }
        if (_scrollToCurrentSeason)
        {
            _scrollToCurrentSeason = false;
            var seasonIndex = VisibleGroups.ToList().FindIndex(group =>
                string.Equals(group.Key, SelectedGroupKey, StringComparison.OrdinalIgnoreCase));
            if (seasonIndex >= 0)
            {
                await Js.InvokeVoidAsync("scrollSequenceItem", _seasonStripId, seasonIndex, "center", "auto");
            }
        }
        if (!_needsSeriesDescriptionMeasurement
            || Compact
            || !IsSeasonContainer
            || string.IsNullOrWhiteSpace(Placement.ContainerDescription))
        {
            return;
        }

        _needsSeriesDescriptionMeasurement = false;
        var hasOverflow = await Js.InvokeAsync<bool>("isElementContentOverflowing", _seriesDescriptionElement);
        if (_hasExpandableSeriesDescription != hasOverflow)
        {
            _hasExpandableSeriesDescription = hasOverflow;
            await InvokeAsync(StateHasChanged);
        }
    }

