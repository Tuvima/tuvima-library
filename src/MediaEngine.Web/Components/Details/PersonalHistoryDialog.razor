@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Progress
@inject IStringLocalizer<SharedStrings> L
<AppDialog>
    <DialogContent>
        <p>@L["PersonalHistoryDialog_PlaybackReadingAndManualStatus"]</p>
        @if (Items.Count == 0) { <p>@L["PersonalHistoryDialog_NoHistoryRecorded"]</p> }
        @foreach (var item in Items)
        {
            <p>@Label(item.Command) &#183; @item.ChangedAt.ToLocalTime().ToString("g") @(item.Undone ? "(Undone)" : "")</p>
        }
    </DialogContent>
    <DialogActions><AppButton ButtonStyle="AppButtonStyle.Outlined" OnClick="@(() => Dialog.Close())">@L["Common_Close"]</AppButton></DialogActions>
</AppDialog>
@code {
    [CascadingParameter] private IAppDialogContext Dialog { get; set; } = default!;
    [Parameter] public IReadOnlyList<PersonalStatusHistoryItem> Items { get; set; } = [];
    private static string Label(string command) => command switch {
        "Read" => "Reading session", "Played" => "Playback session",
        "Complete" => "Marked complete", "Reset" => "Marked unstarted", "HideContinue" => "Hidden from Continue",
        "ShowContinue" => "Restored to Continue", _ => command,
    };
}
