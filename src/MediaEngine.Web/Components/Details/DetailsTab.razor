@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Models.ViewDTOs
@inject IStringLocalizer<SharedStrings> L

<div class="tl-detail-tab-panel">
    @* Your copy replaces About this (details-page-bottom spec D4): the Engine writes the chips and the File details panel. History left the page
       (D6; it stays in the editor's History tab), and the Type and Library rows of the old details list are gone (D7). *@
    <YourCopyRow Model="Model" />

    @if (ShowSeriesFacts)
    {
        @* A Series has no file of its own: its facts sit in the same quiet grid (Series details mock). *@
        <section class="tl-detail-panel tl-file-facts" aria-label="@L["DetailPage_AboutThis"].Value">
            <div class="tl-section-heading"><h2>@L["DetailPage_AboutThis"]</h2></div>
            <div class="tl-file-facts__block">
                <dl class="tl-file-facts__list">
                    @foreach (var row in SeriesFacts)
                    {
                        <div class="tl-file-facts__cell"><dt>@row.Label</dt><dd>@row.Value</dd></div>
                    }
                </dl>
            </div>
        </section>
    }
    else if (Model.EntityType == DetailEntityType.Collection)
    {
        <section class="tl-detail-panel tl-file-facts" aria-label="@L["Common_Files"].Value">
            <div class="tl-section-heading"><h2>@L["Common_Files"]</h2></div>
            <p class="tl-file-facts__note">@L["DetailsTab_ThisIsAGroupingOpen"]</p>
        </section>
    }

    <DetailAiResults Results="@Model.Facts?.AiResults" />

    @if (Model.SourceLinks.Count > 0)
    {
        @* The Sources row (details-page-bottom D8): a quiet line of links for this title only, one per site, each opening in a new tab. *@
        <nav class="tl-source-row" aria-label="@L["Common_Sources"].Value" data-testid="sources-row">
            <span class="tl-source-row__label">@L["Common_Sources"]</span>
            @foreach (var link in Model.SourceLinks)
            {
                <a class="tl-source-link"
                   href="@link.Url"
                   target="_blank"
                   rel="noopener noreferrer">
                    <span>@link.Label</span>
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.OpenInNew" Size="AppIconSize.Control20" />
                </a>
            }
        </nav>
    }
</div>

@code {
    [Parameter, EditorRequired] public DetailPageViewModel Model { get; set; } = default!;

    private IReadOnlyList<DetailFileFactRow> SeriesFacts => DetailFileFacts.IsSeriesContainer(Model.EntityType)
        ? DetailFileFacts.BuildSeriesFacts(
            Model,
            L["DetailsTab_SeriesInLibrary"].Value,
            L["DetailsTab_SeriesFirstPublished"].Value,
            L["DetailsTab_SeriesLatest"].Value,
            L["DetailsTab_SeriesAuthor"].Value,
            L["DetailsTab_SeriesOwnedOfTotal"].Value)
        : [];
    private bool ShowSeriesFacts => SeriesFacts.Count > 0;


    private static string SourceIcon(string key) => key switch
    {
        "wikidata" or "wikidata_qid" or "wikidata-series" or "wikidata-show" or "wikidata-album" => AppMaterialIcons.Outlined.AccountTree,
        "wikipedia" => AppMaterialIcons.Outlined.Article,
        _ => AppMaterialIcons.Outlined.OpenInNew,
    };
}
