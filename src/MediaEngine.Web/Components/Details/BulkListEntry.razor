@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Web.Services.Editing
@implements IDisposable
@inject EditorHost Editor
@inject ListEditLauncher Launcher
@inject DeviceContextService Device

@* Ticked rows of a list that has no detail page behind it (the songs list, a library table; universal editor spec D14, v3 WP3). There is
   no editor of its own here: the list hands over the rows it has ticked, the bar below them is the shared selection bar, and its Edit,
   Match or Move open the one pop-over (EditorHost, drawn by the layout) over the list, which stages and saves through the same pending
   list, check and Review as everywhere else. The list's own filters, sort and scroll are never touched: after a save the list is only
   asked to reload. Nothing renders on a device that may not edit, except for ticked songs: those get Play, Add to queue and Add to
   playlist from a bar of their own on any desktop or tablet (Listen music spec D9), with no editor behind it. *@
@if (_canEdit && !AlbumsTicked && ReferenceEquals(Editor.Binding, _binding))
{
    <BulkSelectionBar Selection="Editor.Batch" Busy="Editor.Flow.Saving" OnDeleted="OnDeletedAsync" OnPlay="OnPlay" OnQueue="OnQueue" />
}
else if (!Device.IsPhone && ((!_canEdit && BulkEditRules.IsSongSelection(_playOnly.Rows, MediaType)) || AlbumsTicked))
{
    <BulkSelectionBar Selection="_playOnly" OnPlay="OnPlay" OnQueue="OnQueue" OnCleared="OnCleared" />
}

@code {
    private EditorBinding _binding = default!;
    private bool _canEdit;
    private bool _disposed;
    private readonly BulkEditSelection _playOnly = new();

    // Ticked albums (the Listen Albums list, spec D15) only go into playlists and collections: they are never edited, so no editor is bound for them.
    private bool AlbumsTicked => BulkEditRules.IsAlbumSelection(Rows);

    /// <summary>The rows the list has ticked, in the order it shows them.</summary>
    [Parameter] public IReadOnlyList<BulkEditRow> Rows { get; set; } = [];

    /// <summary>The list's editor media type ("Music", "TV"...) when its rows do not carry their own.</summary>
    [Parameter] public string? MediaType { get; set; }

    /// <summary>Raised after a save reached the library: the list reloads its rows (its filters, sort and scroll stay).</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    /// <summary>Raised when the ticks ended (Clear, or the pop-over closed): the list drops its own ticks.</summary>
    [Parameter] public EventCallback OnCleared { get; set; }

    /// <summary>Raised after the bar deleted the ticked rows: the list drops them.</summary>
    [Parameter] public EventCallback<IReadOnlyList<Guid>> OnDeleted { get; set; }

    /// <summary>Play the ticked songs (the host replaces its queue with them in list order). Songs only; without it the bar shows no Play.</summary>
    [Parameter] public EventCallback<IReadOnlyList<BulkEditRow>> OnPlay { get; set; }

    /// <summary>Add the ticked songs to the queue. Songs only; without it the bar shows no Add to queue.</summary>
    [Parameter] public EventCallback<IReadOnlyList<BulkEditRow>> OnQueue { get; set; }

    protected override void OnInitialized()
    {
        _binding = Launcher.BindRows(MediaType, () => Rows, AfterSavedAsync);
        _binding.SectionCommitted = () => OnSaved.InvokeAsync();
        Editor.Batch.Changed += OnBatchChanged;
        Editor.Changed += OnEditorChanged;
        Device.OnChanged += OnDeviceChanged;
        _canEdit = EditorDeviceRule.CanEdit(Device);
    }

    protected override void OnParametersSet()
    {
        _canEdit = EditorDeviceRule.CanEdit(Device);
        // A device that may not edit still shows ticked songs: they get their own bar, with no editor behind it.
        _playOnly.MediaType = MediaType;
        _playOnly.Replace(!Device.IsPhone && ((!_canEdit && BulkEditRules.IsSongSelection(Rows, MediaType)) || AlbumsTicked) ? Rows : []);
        _binding.BulkMediaType = MediaType;
        _binding.EntityId = Rows.FirstOrDefault()?.Id ?? Guid.Empty;
        if (_canEdit && Rows.Count > 0 && !AlbumsTicked)
        {
            // Ticked rows belong to this list: the editor serves it while the pop-over is closed (an open pop-over keeps its own).
            if (!Editor.IsOpen)
            {
                Editor.Bind(_binding);
            }

            Editor.Batch.MediaType = MediaType;
        }

        // A list that stops qualifying for editing (the window became a tablet) drops the ticks; what is staged is kept for the guard to ask about.
        if (ReferenceEquals(Editor.Binding, _binding))
        {
            Editor.Batch.Replace(_canEdit && !AlbumsTicked ? Rows : []);
        }
    }

    /// <summary>A row's own Edit button: the row is ticked by the list, then this opens the pop-over's Edit panel for the ticked rows.</summary>
    public void OpenEditPanel()
    {
        if (!_canEdit || Rows.Count == 0)
        {
            return;
        }

        Editor.Bind(_binding);
        Editor.Batch.Replace(Rows);
        Editor.Batch.OpenPanel(BulkPanelKind.Edit);
    }

    // The ticks ended outside the list (Clear on the bar, or the pop-over closed): the list drops its own ticks too.
    private void OnBatchChanged()
    {
        if (!_disposed && Editor.Batch.Count == 0 && Rows.Count > 0 && ReferenceEquals(Editor.Binding, _binding))
        {
            _ = InvokeAsync(() => OnCleared.InvokeAsync());
        }
    }

    private void OnEditorChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnDeviceChanged() => _ = InvokeAsync(() =>
    {
        if (_disposed)
        {
            return;
        }

        _canEdit = EditorDeviceRule.CanEdit(Device);
        if (!_canEdit && ReferenceEquals(Editor.Binding, _binding))
        {
            Editor.Batch.Clear();
        }

        StateHasChanged();
    });

    // The list reloads its rows; the panel reads the saved values again. Nothing about the list's own view is reset.
    private async Task AfterSavedAsync()
    {
        Editor.Batch.NotifySaved();
        await OnSaved.InvokeAsync();
    }

    private async Task OnDeletedAsync(IReadOnlyList<Guid> ids) => await OnDeleted.InvokeAsync(ids);

    public void Dispose()
    {
        _disposed = true;
        Editor.Batch.Changed -= OnBatchChanged;
        Editor.Changed -= OnEditorChanged;
        Device.OnChanged -= OnDeviceChanged;
        Editor.Unbind(_binding);
    }
}
