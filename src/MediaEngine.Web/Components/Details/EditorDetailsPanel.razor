@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Items
@using MediaEngine.Web.Components.MediaEditor
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@implements IDisposable
@inject IStringLocalizer<SharedStrings> L

@* The Details tool (spec D3, D4, D5, WP5): the item's fields from the editor's own per-type field list. Typing only stages a change in the
   pending list, which the page shows at once and Save changes writes later. Provider facts are read-only with a lock and the provider's
   name; a field you have overridden shows a purple dot and a way back to the provider's value. *@
@if (Mode is { IsOn: true, Fields.Loading: true } && Session is { IsActive: true })
{
    @* Another item's fields are on their way (the person switched items): never show the item that was left. *@
    <EditorPanelBusy />
}
else if (Mode is { IsOn: true } mode && Session is { IsActive: true } session && mode.Fields.Loaded)
{
    var fields = mode.Fields;
    var canEdit = mode.CanEdit && fields.CanEditFields;
    var editable = canEdit ? Rows(fields).Where(IsEditable).ToList() : [];
    var facts = Rows(fields).Where(row => !editable.Contains(row)).ToList();
    <div class="tl-editor-details-layout">
    <div class="tl-editor-details">
        @if (!canEdit)
        {
            <AppAlert Severity="AppSeverity.Info" Dense="true">@L["Common_YouCanLookAtThese"]</AppAlert>
        }

        @if (editable.Count > 0)
        {
            @if (canEdit && ResettableRows(fields, session, editable).Count > 0)
            {
                <div class="tl-editor-details__toolbar">
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact"
                               OnClick="@(() => ResetAll(fields, session, editable))">@L["EditorDetailsPanel_ResetAllToProviderValues"]</AppButton>
                </div>
            }
            <section class="tl-editor-details__group" aria-label="@L["Common_DetailsYouCanChange"].Value">
                @foreach (var field in editable)
                {
                    @EditableRow(fields, session, field)
                }
            </section>
        }

        @if (canEdit && fields.ExplicitMark is { } explicitMark)
        {
            @ExplicitRow(fields, session, explicitMark)
        }

        @if (facts.Count > 0)
        {
            <section class="tl-editor-details__group" aria-label="@L["Common_ProviderFacts"].Value">
                <h3 class="tl-editor-details__heading">@(fields.SubjectKind is null ? "From providers" : "Also on record")</h3>
                @foreach (var field in facts)
                {
                    @FactRow(field)
                }
            </section>
        }

        @ChildContent
    </div>
    <EditorQuickFacts Fields="fields" />
    </div>
}

@code {
    private EditSessionState? _subscribed;
    private EditingModeContext? _subscribedMode;

    [Parameter, EditorRequired] public EditingModeContext? Mode { get; set; }

    [Parameter, EditorRequired] public EditSessionState? Session { get; set; }

    /// <summary>Extra read-only content shown under the fields (the Universe's Series list).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private static string Canonical(MediaEditorDetailsFieldPresentation field) => field.CanonicalName ?? "provider's";

    private RenderFragment EditableRow(ItemFieldEditSession fields, EditSessionState session, MediaEditorDetailsFieldPresentation field) => __builder =>
    {
        var entityId = fields.EntityId;
        var key = StageKey(field);
        var staged = session.Pending.TryGetField(entityId, key, out var stagedValue);
        var isReset = staged && string.IsNullOrWhiteSpace(stagedValue);
        var shown = staged ? stagedValue ?? string.Empty : Baseline(field);
        var isTags = IsTags(field);
        var state = StateOf(fields, session, field);
        var overridden = state.Changed;
        <div class="@FieldClass(field, state)" data-field-key="@field.Key" data-locked="@(state.Locked ? "true" : "false")" data-changed="@(state.Changed ? "true" : "false")">
            <div class="tl-editor-field__label">
                <span>@field.Label</span>
                @if (overridden)
                {
                    <span class="tl-editor-field__dot" role="img" aria-label="@($"{field.Label} is changed")" title="@($"Changed from the {Canonical(field)} value")"></span>
                }
                <span class="tl-editor-field__tools">
                    @if (state.Changed && !isReset)
                    {
                        <AppIconButton Icon="@AppMaterialIcons.Outlined.Replay"
                                       Size="AppControlSize.Compact"
                                       Tone="AppUiTone.Neutral"
                                       Class="tl-editor-field__reset"
                                       Tooltip="@RevertText(field, state)"
                                       AriaLabel="@RevertText(field, state)"
                                       OnClick="@(() => Revert(fields, session, field, state))" />
                    }
                    <AppIconButton Icon="@(state.Locked ? AppMaterialIcons.Outlined.Lock : AppMaterialIcons.Outlined.LockOpen)"
                                   Size="AppControlSize.Compact"
                                   Tone="@(state.Locked ? AppUiTone.Primary : AppUiTone.Neutral)"
                                   Class="tl-editor-field__lock-toggle"
                                   Disabled="@(state.LockFixed || (!state.Locked && string.IsNullOrWhiteSpace(Baseline(field))))"
                                   Tooltip="@LockText(field, state)"
                                   AriaLabel="@LockText(field, state)"
                                   aria-pressed="@(state.Locked ? "true" : "false")"
                                   OnClick="@(() => ToggleLock(fields, session, field, state))" />
                </span>
            </div>
            @if (field.IsChips)
            {
                <MediaEditorTagEditor Label="@field.Label"
                                      HideLabel="true"
                                      AddLabel="@(isTags ? "Add tag" : "Add genre")"
                                      HelpText="@(isTags ? "Tags are private library organization and are not replaced by provider refreshes." : "Genres you set replace the provider's genres on this item only.")"
                                      Value="@shown"
                                      ValueChanged="@(value => Stage(fields, session, field, value))"
                                      Suggestions="@(isTags ? fields.TagSuggestions : fields.GenreSuggestions)" />
            }
            else if (string.Equals(field.InputKind, "choice", StringComparison.OrdinalIgnoreCase))
            {
                <AppSelect T="string" Value="@shown" ValueChanged="@(value => Stage(fields, session, field, value))"
                           Options="@ChoiceOptions(field)" AriaLabel="@field.Label" />
            }
            else if (string.Equals(field.InputKind, "textarea", StringComparison.OrdinalIgnoreCase))
            {
                <AppTextarea Value="@shown" ValueChanged="@(value => Stage(fields, session, field, value))"
                             Lines="@LinesFor(shown)" aria-label="@field.Label" />
                <small class="tl-editor-field__count">@Count(shown)</small>
            }
            else
            {
                <AppTextField Value="@shown" ValueChanged="@(value => Stage(fields, session, field, value))"
                              InputType="@InputTypeOf(field)" aria-label="@field.Label" />
            }
            @if (isReset)
            {
                <span class="tl-editor-field__note">Goes back to the @Canonical(field) value when you save.
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact"
                               OnClick="@(() => Undo(fields, session, field))">Undo</AppButton></span>
            }
        </div>
    };

    // Where one editable field stands: Changed (the value differs from the provider's, saved or waiting for Save), Locked (the value is kept
    // when the provider refreshes) and whether the lock can be turned off. A changed value is always kept, so its lock is fixed on; Tags are
    // private to the library and never replaced by a refresh, so theirs is fixed on too. A field that follows the provider can be locked
    // as it is: that stages its current value as the person's own, exactly as typing the same value would.
    private readonly record struct FieldState(bool Changed, bool Locked, bool LockFixed, bool Pinned, bool StagedOnly);

    private FieldState StateOf(ItemFieldEditSession fields, EditSessionState session, MediaEditorDetailsFieldPresentation field)
    {
        var staged = session.Pending.TryGetField(fields.EntityId, StageKey(field), out var stagedValue);
        var isReset = staged && string.IsNullOrWhiteSpace(stagedValue);
        var stagedChange = staged && !isReset && !string.Equals(stagedValue?.Trim(), Baseline(field).Trim(), StringComparison.Ordinal);
        var pinned = staged && !isReset && !stagedChange;
        var changed = !isReset && (stagedChange || field.CanRevert);
        var tags = IsTags(field);
        var locked = tags || (!isReset && (changed || pinned || field.CanRevert));
        return new FieldState(changed, locked, tags || changed, pinned, staged && !isReset && !field.CanRevert);
    }

    private static string FieldClass(MediaEditorDetailsFieldPresentation field, FieldState state) =>
        string.Join(' ', new[]
        {
            "tl-editor-field",
            IsWide(field) ? "tl-editor-field--wide" : null,
            state.Changed ? "tl-editor-field--changed" : null,
        }.Where(part => part is not null));

    private static string RevertText(MediaEditorDetailsFieldPresentation field, FieldState state) =>
        state.StagedOnly ? $"Put back the saved {field.Label.ToLowerInvariant()}" : $"Reset to {field.CanonicalName ?? "provider"} value";

    private static string LockText(MediaEditorDetailsFieldPresentation field, FieldState state) =>
        IsTags(field) ? "Tags are yours: a provider refresh never replaces them."
        : state.Changed ? "Locked: a value you changed is kept when the provider refreshes. Use the arrow to go back."
        : state.Locked ? "Locked: your value is kept when the provider refreshes. Click to let the provider update it."
        : string.IsNullOrWhiteSpace(Baseline(field)) ? "Nothing to keep yet."
        : "Click to keep this value when the provider refreshes.";

    private void Revert(ItemFieldEditSession fields, EditSessionState session, MediaEditorDetailsFieldPresentation field, FieldState state)
    {
        if (state.StagedOnly)
        {
            Undo(fields, session, field);
        }
        else
        {
            Reset(fields, session, field);
        }
    }

    private void ToggleLock(ItemFieldEditSession fields, EditSessionState session, MediaEditorDetailsFieldPresentation field, FieldState state)
    {
        if (!session.IsActive || Mode is not { CanEdit: true } || state.LockFixed)
        {
            return;
        }

        if (state.Locked)
        {
            // Unlocking a field that only follows a pin takes the pin back out; nothing else was staged for it.
            session.Pending.ClearField(fields.EntityId, StageKey(field));
        }
        else if (!string.IsNullOrWhiteSpace(Baseline(field)))
        {
            session.Pending.SetField(fields.EntityId, StageKey(field), Baseline(field), before: PinBefore);
        }
    }

    private const string PinBefore = "Follows the provider";

    // Only a video or a series of videos has the mark (the Engine says so). It is staged like a field and saved with Save changes.
    private RenderFragment ExplicitRow(ItemFieldEditSession fields, EditSessionState session, ItemExplicitResponse saved) => __builder =>
    {
        var on = session.Pending.TryGetField(fields.EntityId, ItemFieldEditSession.ExplicitFieldKey, out var staged)
            ? string.Equals(staged, "true", StringComparison.OrdinalIgnoreCase)
            : saved.IsExplicit;
        <section class="tl-editor-details__group tl-editor-explicit" aria-label="@L["EditorDetailsPanel_ExplicitMark"].Value" data-field-key="explicit">
            <AppTooltip Text="@L["EditorDetailsPanel_ExplicitInfo"].Value">
                <AppSwitchRow Label="@L["EditorDetailsPanel_Explicit"].Value"
                              Description="@L["EditorDetailsPanel_ExplicitInfo"].Value"
                              Value="@on"
                              ValueChanged="@((bool value) => StageExplicit(fields, session, saved, value))" />
            </AppTooltip>
        </section>
    };

    private void StageExplicit(ItemFieldEditSession fields, EditSessionState session, ItemExplicitResponse saved, bool value)
    {
        if (!session.IsActive || Mode is not { CanEdit: true })
        {
            return;
        }

        // Back to what is saved takes the staged change out, so Save never counts a no-op.
        if (value == saved.IsExplicit)
        {
            session.Pending.ClearField(fields.EntityId, ItemFieldEditSession.ExplicitFieldKey);
        }
        else
        {
            session.Pending.SetField(fields.EntityId, ItemFieldEditSession.ExplicitFieldKey, value ? "true" : "false",
                before: EditReviewRows.ExplicitText(saved.IsExplicit));
        }
    }

    private RenderFragment FactRow(MediaEditorDetailsFieldPresentation field) => __builder =>
    {
        var why = WhyLocked(field);
        <div class="tl-editor-field tl-editor-field--locked" data-field-key="@field.Key">
            <div class="tl-editor-field__label">
                <span>@field.Label</span>
                <AppTooltip Text="@why">
                    <span class="tl-editor-field__lock" tabindex="0" role="img" aria-label="@($"{field.Label} is locked. {why}")">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Lock" Size="AppSize.Small" />
                        <small>@SourceName(field)</small>
                    </span>
                </AppTooltip>
            </div>
            <div class="tl-editor-field__value">@(string.IsNullOrWhiteSpace(field.DisplayValue ?? field.Value) ? "Not set" : field.DisplayValue ?? field.Value)</div>
        </div>
    };

    // Every field the item presents, once each, with the empty Tags row when tags can be added (the same rows the editor lists).
    private static IReadOnlyList<MediaEditorDetailsFieldPresentation> Rows(ItemFieldEditSession fields)
    {
        var rows = fields.AllFields().ToList();
        if (fields.EmptyTagsField is { } emptyTags && rows.All(row => !string.Equals(row.Key, emptyTags.Key, StringComparison.OrdinalIgnoreCase)))
        {
            rows.Add(emptyTags);
        }

        return rows;
    }

    private static bool IsEditable(MediaEditorDetailsFieldPresentation field) =>
        field.CanOverride && !string.Equals(field.Provenance, "Inherited", StringComparison.OrdinalIgnoreCase);

    private static string StageKey(MediaEditorDetailsFieldPresentation field) =>
        string.IsNullOrWhiteSpace(field.OverrideKey) ? field.Key : field.OverrideKey;

    private static IReadOnlyList<AppSelectOption> ChoiceOptions(MediaEditorDetailsFieldPresentation field) =>
        (field.Options ?? []).Select(option => new AppSelectOption(option.Value, option.Label)).ToList();

    private static string Baseline(MediaEditorDetailsFieldPresentation field) => field.RawValue ?? field.Value ?? string.Empty;

    private static bool IsTags(MediaEditorDetailsFieldPresentation field) =>
        MediaEditorTagRules.IsLibraryTagsKey(field.OverrideKey) || MediaEditorTagRules.IsLibraryTagsKey(field.Key);

    private static AppInputType InputTypeOf(MediaEditorDetailsFieldPresentation field) => field.InputKind?.ToLowerInvariant() switch
    {
        "date" => AppInputType.Date,
        "number" or "rating" => AppInputType.Number,
        _ => AppInputType.Text,
    };

    // Title, description and chip lists take the whole row; short single-line facts share it two to a row (spec D3).
    private static bool IsWide(MediaEditorDetailsFieldPresentation field) =>
        field.IsChips
        || string.Equals(field.InputKind, "textarea", StringComparison.OrdinalIgnoreCase)
        || string.Equals(field.Label, "Title", StringComparison.OrdinalIgnoreCase)
        || string.Equals(field.Key, "title", StringComparison.OrdinalIgnoreCase)
        || (Baseline(field).Length > 36 && !string.Equals(field.InputKind, "date", StringComparison.OrdinalIgnoreCase));

    private void ResetAll(ItemFieldEditSession fields, EditSessionState session, IReadOnlyList<MediaEditorDetailsFieldPresentation> editable)
    {
        if (!session.IsActive || Mode is not { CanEdit: true })
        {
            return;
        }

        foreach (var field in ResettableRows(fields, session, editable))
        {
            session.Pending.SetField(fields.EntityId, StageKey(field), string.Empty, before: BeforeText(field));
        }
    }

    // "Reset all" is for overrides that are saved in the library: a field with nothing saved has nothing to reset, and one already sent
    // back to the provider's value (staged, waiting for Save) is not offered again.
    private static IReadOnlyList<MediaEditorDetailsFieldPresentation> ResettableRows(
        ItemFieldEditSession fields, EditSessionState session, IReadOnlyList<MediaEditorDetailsFieldPresentation> editable) =>
        editable
            .Where(row => row.CanRevert
                && !(session.Pending.TryGetField(fields.EntityId, StageKey(row), out var staged) && string.IsNullOrWhiteSpace(staged)))
            .ToList();

    // The box grows with the text, so a long synopsis never gets a scroll bar of its own inside the window's.
    private static int LinesFor(string value) => Math.Clamp((value.Length / 90) + 2, 4, 14);

    private static string Count(string value) => $"{value.Length:N0} character{(value.Length == 1 ? string.Empty : "s")}";

    private static string SourceName(MediaEditorDetailsFieldPresentation field) =>
        string.Equals(field.Provenance, "Inherited", StringComparison.OrdinalIgnoreCase)
            ? $"From {field.SourceLabel ?? "its parent"}"
            : !string.IsNullOrWhiteSpace(field.ProviderName)
                ? ProviderCatalogueService.FormatProviderLabel(field.ProviderName)
                : field.SourceLabel ?? "Provider";

    private static string WhyLocked(MediaEditorDetailsFieldPresentation field) =>
        string.Equals(field.Provenance, "Inherited", StringComparison.OrdinalIgnoreCase)
            ? $"Inherited from {field.SourceLabel ?? "its parent"}. Change it there."
            : $"Set by {SourceName(field)}. Provider facts cannot be edited here.";

    // Typing stages the change. Typing the value the item already has takes the staged change back out, so Save never counts a no-op.
    private void Stage(ItemFieldEditSession fields, EditSessionState session, MediaEditorDetailsFieldPresentation field, string? typed)
    {
        if (!session.IsActive || Mode is not { CanEdit: true })
        {
            return;
        }

        // The typed text is staged as it is (a trailing space is part of typing); only the comparison ignores the edges.
        var value = typed ?? string.Empty;
        if (IsTags(field))
        {
            value = MediaEditorTagRules.NormalizeLibraryTags(value, out var tagError);
            if (tagError is not null)
            {
                return;
            }
        }

        var key = StageKey(field);
        if (string.Equals(value.Trim(), Baseline(field).Trim(), StringComparison.Ordinal))
        {
            session.Pending.ClearField(fields.EntityId, key);
        }
        else
        {
            session.Pending.SetField(fields.EntityId, key, value, before: BeforeText(field));
        }
    }

    private void Reset(ItemFieldEditSession fields, EditSessionState session, MediaEditorDetailsFieldPresentation field)
    {
        if (session.IsActive && Mode is { CanEdit: true })
        {
            session.Pending.SetField(fields.EntityId, StageKey(field), string.Empty, before: BeforeText(field));
        }
    }

    // What the field holds before this change, for Review's Before column.
    private static string BeforeText(MediaEditorDetailsFieldPresentation field) =>
        string.IsNullOrWhiteSpace(field.DisplayValue ?? field.Value) ? EditReviewRows.NotSet : (field.DisplayValue ?? field.Value)!.Trim();

    private static void Undo(ItemFieldEditSession fields, EditSessionState session, MediaEditorDetailsFieldPresentation field) =>
        session.Pending.ClearField(fields.EntityId, StageKey(field));

    protected override void OnParametersSet()
    {
        // The fields loading or being replaced (the person switched items) redraws the panel on its own, whatever page hosts it.
        if (!ReferenceEquals(_subscribedMode, Mode))
        {
            if (_subscribedMode is not null)
            {
                _subscribedMode.Changed -= OnChanged;
            }

            _subscribedMode = Mode;
            if (_subscribedMode is not null)
            {
                _subscribedMode.Changed += OnChanged;
            }
        }

        if (ReferenceEquals(_subscribed, Session))
        {
            return;
        }

        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnChanged;
        }

        _subscribed = Session;
        if (_subscribed is not null)
        {
            _subscribed.Changed += OnChanged;
        }
    }

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnChanged;
        }

        if (_subscribedMode is not null)
        {
            _subscribedMode.Changed -= OnChanged;
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
}
