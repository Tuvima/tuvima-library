@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Theming
@implements IDisposable
@inject IStringLocalizer<SharedStrings> L

@* The header of the pop-over (universal editor v5 D1, D9, 1a items 1 to 7, screens A, B, C, D, K). A 96 by 144 cover (a picture only, never a
   button), the plain label above the title (the show, series or album it belongs to, or the kind word for a standalone item), the title, one
   line of facts with the match state, the provider links with their logos and, in the nav row, the way around the family: the home button, the
   Season (or Section) dropdown and the item dropdown. What shows in that row is told by the Engine's header (EditorHeaderDto), never decided
   here from the kind. The background is a gradient from the cover's two main colours, darkened into the window surface by the palette config.
   A Universe keeps its own tile and kind dropdowns, and an item the Engine builds no header for (a person, a collection) shows the plain
   header. Read-only: nothing here is edited or saved. *@
@if (Flow?.Session.ActiveItem is { } active)
{
    var fields = Fields;
    var header = fields.Loaded && !EditorUniverseRules.IsUniverseSubject(fields.SubjectKind) ? fields.Header : null;
    var subject = fields.Loaded ? fields.MatchSubject() : null;
    var title = string.IsNullOrWhiteSpace(subject?.Title) ? active.Title : subject!.Title;
    var isUniverse = EditorUniverseRules.IsUniverseSubject(fields.SubjectKind);
    var links = fields.Loaded && !isUniverse ? EditorHeaderRules.Links(fields.Identity, fields.MediaType, fields.ScopeId) : [];
    var image = header?.Root.CoverUrl;
    if (string.IsNullOrWhiteSpace(image))
    {
        image = !string.IsNullOrWhiteSpace(active.ImageUrl) ? active.ImageUrl : Family.TrailTo(active.EntityId)?[^1].ImageUrl;
    }

    string label;
    string facts;
    if (header is not null)
    {
        label = header.Label;
        facts = string.Join(" · ", EditorHeaderFacts.Parts(header.Config, FieldText, fields.QuickFacts, header));
    }
    else
    {
        var kind = isUniverse
            ? EditorUniverseRules.KindLine(fields.SubjectKind, fields.Find("kind")?.DisplayValue ?? fields.Find("kind")?.Value, UniverseName)
            : EditorHeaderRules.KindLabel(fields.MediaType, fields.ScopeId, fields.ScopeLabel);
        var trail = Flow.Session.Trail;
        var parent = subject?.ParentLabel ?? (trail.Count > 1 && trail[0].EntityId != active.EntityId ? trail[0].Title : null);
        label = isUniverse ? kind : EditorHeaderRules.FactsLine(parent, kind);
        facts = fields.Loaded
            ? EditorHeaderRules.FactsLine(FieldText("air_date", "release_date", "premiere_date") ?? subject?.Year, FieldText("runtime", "duration"), subject?.Creator)
            : string.Empty;
    }

    var gradient = EditorHeaderGradient.Style(header?.Colors, PaletteProvider.Current.EditorHeader);
    var showState = fields.Loaded && !isUniverse && fields.CanMatch && (header is null || EditorHeaderFacts.ShowsMatchState(header.Config));
    // The show's tile already carries its picture, so a show's seasons and episodes draw no second picture beside it; every other family keeps the item's own.
    var showCover = header is not null || !(HasFamily && Family.Kind == EditorFamilyKind.Show);
    var kindKey = header?.Kind ?? string.Empty;
    <header class="@(HasFamily && header is null ? "tl-editor-header tl-editor-header--family" : "tl-editor-header")"
            data-kind="@kindKey"
            data-gradient="@(gradient is null ? "none" : "cover")"
            aria-busy="@(fields.Loading ? "true" : null)">
        @if (gradient is not null)
        {
            <AppWash Class="tl-editor-header__wash" Background="@gradient" />
        }

        @if (HasFamily && header is null && Tile is not null)
        {
            <div class="tl-editor-header__tile">@Tile</div>
        }

        @if (showCover)
        {
            <div class="@(header is null && IsLandscape(fields.ScopeId) ? "tl-editor-header__cover tl-editor-header__cover--landscape" : "tl-editor-header__cover")" aria-hidden="true">
                @if (!string.IsNullOrWhiteSpace(image))
                {
                    <AppImage Src="@image" Alt="" DrawnPx="200" ObjectFit="AppObjectFit.Cover" Class="tl-editor-header__img" />
                }
                else
                {
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Image" Size="AppIconSize.Tile32" />
                }
            </div>
        }
        <div class="tl-editor-header__body">
            <div class="tl-editor-header__label">@label</div>
            <h2 id="tl-editor-panel-title" class="tl-editor-header__title" tabindex="-1" data-overflow-tooltip="@title">@title</h2>
            <div class="tl-editor-header__line">
                @if (fields.Loading && !fields.Loaded)
                {
                    <AppSkeleton Height="1rem" Width="12rem" />
                }
                else if (!string.IsNullOrWhiteSpace(facts))
                {
                    <div class="tl-editor-header__facts">@facts</div>
                }

                @if (showState)
                {
                    <div class="tl-editor-header__chips">
                        @if (Unmatched)
                        {
                            <AppStatusBadge Tone="AppUiTone.Warning" Text="@L["EditorFamily_NotMatched"].Value" />
                        }
                        else
                        {
                            <AppStatusBadge Tone="AppUiTone.Success" Text="@L["EditorFamily_Matched"].Value" Icon="@AppMaterialIcons.Outlined.Check" />
                        }
                    </div>
                }
            </div>

            @if (header is not null)
            {
                <EditorHeaderNav Header="header" Flow="Flow" Hooks="Hooks" CanMatch="@fields.CanMatch" />
            }
            else if (HasFamily && Selects is not null)
            {
                <div class="tl-editor-header__selects">@Selects</div>
            }
        </div>
        @if (links.Count > 0)
        {
            <div class="tl-editor-header__links">
                @foreach (var link in links)
                {
                    <AppLink Href="@link.Url" Target="_blank" Underline="AppUnderline.None" Class="tl-editor-header__link"
                             aria-label="@(string.Format(L["EditorHeader_OpenAt"].Value, link.Name))">
                        <AppProviderLogo FallbackText="@link.Name[..1]" Size="AppControlSize.Compact" AltText="" Class="tl-editor-header__link-logo" />
                        <span class="tl-editor-header__link-name">@link.Name</span>
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.OpenInNew" Size="AppIconSize.Control20" />
                    </AppLink>
                }
            </div>
        }
    </header>
}

@code {
    private EditSessionFlow? _flow;
    private ItemFieldEditSession? _fields;

    [Parameter, EditorRequired] public EditSessionFlow? Flow { get; set; }

    [Parameter, EditorRequired] public ItemFieldEditSession Fields { get; set; } = default!;

    [Parameter, EditorRequired] public EditorFamilyState Family { get; set; } = default!;

    /// <summary>A Universe or an item with no header from the Engine has a family: the header draws its tile and its dropdowns.</summary>
    [Parameter] public bool HasFamily { get; set; }

    /// <summary>The fixed tile of a Universe, at the left of the header.</summary>
    [Parameter] public RenderFragment? Tile { get; set; }

    /// <summary>The dropdowns of a Universe (its kinds), under the title.</summary>
    [Parameter] public RenderFragment? Selects { get; set; }

    /// <summary>The name of the Universe being edited, for the kind line of a character, place or faction ("Faction in Dune").</summary>
    [Parameter] public string? UniverseName { get; set; }

    /// <summary>The item has no match yet (the pop-over knows, from the family and the page).</summary>
    [Parameter] public bool Unmatched { get; set; }

    /// <summary>Where the supporting-file rows and the folder button of the nav row lead.</summary>
    [Parameter] public EditorHeaderHooks? Hooks { get; set; }

    // Episodes and stills are wide; everything else is a portrait cover. Only the plain header (no Engine header) still uses this.
    private static bool IsLandscape(string scopeId) => string.Equals(scopeId, "episode", StringComparison.OrdinalIgnoreCase);

    private string? FieldText(params string[] keys)
    {
        var field = Fields.Find(keys);
        var text = field?.DisplayValue ?? field?.Value;
        return string.IsNullOrWhiteSpace(text) ? null : text;
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_flow, Flow))
        {
            if (_flow is not null)
            {
                _flow.Changed -= OnChanged;
                _flow.Session.Changed -= OnChanged;
            }

            _flow = Flow;
            if (_flow is not null)
            {
                _flow.Changed += OnChanged;
                _flow.Session.Changed += OnChanged;
            }
        }

        if (!ReferenceEquals(_fields, Fields))
        {
            if (_fields is not null)
            {
                _fields.Changed -= OnChanged;
            }

            _fields = Fields;
            _fields.Changed += OnChanged;
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_flow is not null)
        {
            _flow.Changed -= OnChanged;
            _flow.Session.Changed -= OnChanged;
        }

        if (_fields is not null)
        {
            _fields.Changed -= OnChanged;
        }
    }
}
