@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Components.Listen
@implements IDisposable
@inject IStringLocalizer<SharedStrings> L

@* An audiobook keeps its own chapter list. An album's tracks are the one SongTable in its album-page place (spec
   music-table-and-reader-frame WP4): this component stays the host that owns the tracks, what playing, queueing and favoriting
   mean, the Show missing tracks switch and the ticks that feed the page's bulk bar. *@
@if (IsAudiobook)
{
    <AudioItemTable Groups="Groups"
                    SourceTitle="@AlbumTitle"
                    AuthorName="@AuthorName" NarratorName="@NarratorName"
                    Synopsis="@Synopsis"
                    Authors="@Authors" Narrators="@Narrators" AudiobookId="@AudiobookId"
                    ArtworkUrl="@AlbumArtworkUrl"
                    CompactToolbarLeadingContent="ToolbarLeadingContent" />
}
else if (AllItems.Count > 0)
{
    <section class="tl-music-tracks" aria-label="@($"{AlbumTitle} tracks")">
        <header class="tl-music-tracks__toolbar">
            @if (ToolbarLeadingContent is not null)
            {
                <div class="tl-music-tracks__leading">@ToolbarLeadingContent</div>
            }
            <span class="tl-music-tracks__count">@TrackCountSummary</span>
            <label class="tl-detail-track-toggle">
                <AppNativeInput Type="checkbox" Checked="@_showMissing" OnChange="ToggleMissing" />
                <span>@L["AudioItemTable_ShowMissingTracks"]</span>
            </label>
        </header>

        <SongTable Place="SongTablePlace.AlbumPage"
                   Rows="@_rows"
                   AriaLabel="@($"{AlbumTitle} tracks")"
                   ProfileId="@_profileId"
                   CurrentRowId="@CurrentRowId"
                   IsPlaying="@Playback.IsPlaying"
                   FavoriteIds="@_favoriteRowIds"
                   OnSortChanged="@OnSortChangedAsync"
                   AlbumArtist="@ArtistName"
                   ShowSelection="@SelectionShown"
                   SelectedIds="@_selectedIds"
                   SelectedIdsChanged="@OnSelectedIdsChangedAsync"
                   CanEdit="@CanEditRows"
                   CanDelete="@CanDeleteRows"
                   Notice="@_notice"
                   OnNoticeDismissed="@ClearNoticeAsync"
                   OnPlay="@PlayAsync"
                   OnPlayNext="@PlayNextAsync"
                   OnQueue="@QueueAsync"
                   OnToggleFavorite="@ToggleFavoriteAsync"
                   OnEdit="@EditAsync"
                   OnDelete="@DeleteRowAsync"
                   OnDragOutStarted="@DragStartedCallback"
                   OnDragOutEnded="@DragEndedCallback"
                   EmptyContent="@EmptyContent">
            <BulkContent Context="selected">
                <BulkSelectionBar OnPlay="@PlayTickedCallback(selected)" OnQueue="@QueueTickedCallback(selected)" />
            </BulkContent>
        </SongTable>
    </section>
}

@code {
    private RenderFragment EmptyContent => @<div class="tl-detail-track-empty">@L["AudioItemTable_NoMatchTheCurrentView", "tracks"]</div>;
}
