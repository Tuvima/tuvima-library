@namespace MediaEngine.Web.Components.Details
@using System.Globalization
@using MediaEngine.Contracts.Details
<div class="tl-detail-actions">
    <div class="tl-detail-primary-actions">
        @foreach (var action in PrimaryActions.Where(action => action.Key != "restart").Take(1))
        {
            <AppNativeButton Type="button" Class="@($"tl-detail-action--primary tl-detail-action--{ActionKeyClass(action)} {(HasEmbeddedProgress ? "tl-detail-action--has-progress" : "")}")" Disabled="@action.IsDisabled" AriaLabel="@action.Label" OnClick="@(() => Select(action))" @attributes="AttributesFor(action)">
                <MudIcon Icon="@IconFor(action)" />
                <span class="tl-detail-action-label">
                    <span>@action.Label</span>
                    @if (HasEmbeddedProgress) { <span class="tl-detail-action-progress__label">@EmbeddedProgressLabel</span> }
                </span>
                @if (HasEmbeddedProgress) { <span class="tl-detail-action-progress__track" role="progressbar" aria-label="@EmbeddedProgressAriaLabel" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@EmbeddedProgressPercent"><AppCssElement Tag="span" Class="tl-detail-action-progress__fill" Css="@EmbeddedProgressStyle" /></span> }
            </AppNativeButton>
        }
    </div>
    <div class="tl-detail-secondary-actions">
        @foreach (var action in VisibleSecondaryActions)
        {
            @if (action.Key == "reaction-menu")
            {
                <MediaRateControl Positive="@(action.IsSelected || action.Children.Any(child => child.Key == "reaction-like" && child.IsSelected))" Negative="@(action.Children.Any(child => child.Key == "reaction-dislike" && child.IsSelected))" Selected="@(positive => SelectReaction(action.Children.First(child => child.Key == (positive ? "reaction-like" : "reaction-dislike"))))" />
            }
            else
            {
                <PlaybackTooltip Text="@TooltipFor(action)"><AppNativeButton Type="button" Class="hero-icon-circle" AriaLabel="@TooltipFor(action)" Disabled="@action.IsDisabled" aria-pressed="@(action.IsSelected ? "true" : "false")" OnClick="@(() => Select(action))"><MudIcon Icon="@(action.Key == "my-list" && action.IsSelected ? Icons.Material.Outlined.Check : IconFor(action))" /></AppNativeButton></PlaybackTooltip>
            }
        }
        <OverflowActionMenu Actions="OverflowMenuActions" ButtonClass="hero-icon-circle" OnActionSelected="OnActionSelected" />
    </div>
</div>
@code {
    [Parameter] public IReadOnlyList<DetailAction> PrimaryActions { get; set; } = [];
    [Parameter] public IReadOnlyList<DetailAction> SecondaryActions { get; set; } = [];
    [Parameter] public IReadOnlyList<DetailAction> OverflowActions { get; set; } = [];
    [Parameter] public ProgressViewModel? Progress { get; set; }
    [Parameter] public bool UsePrimaryHeroChrome { get; set; }
    [Parameter] public bool IsMusicAlbum { get; set; }
    [Parameter] public EventCallback<DetailAction> OnActionSelected { get; set; }
    [Parameter] public Func<DetailAction, IReadOnlyDictionary<string, object>?>? ActionAttributes { get; set; }

    private IReadOnlyList<DetailAction> VisibleSecondaryActions => PrimaryActions.Skip(1).Where(action => action.Key == "shuffle").Concat(SecondaryActions).ToList();
    private IReadOnlyList<DetailAction> OverflowMenuActions => OverflowActions.Concat(PrimaryActions.Skip(1).Where(action => action.Key is not ("restart" or "shuffle"))).ToList();
    private bool HasEmbeddedProgress => Progress?.Percent is > 0 && PrimaryActions.Count > 0;
    private int EmbeddedProgressPercent => Progress is null
        ? 0
        : Math.Clamp((int)Math.Round(Progress.Percent, MidpointRounding.AwayFromZero), 0, 100);
    private string EmbeddedProgressStyle =>
        $"width:{EmbeddedProgressPercent.ToString(CultureInfo.InvariantCulture)}%;";
    private string EmbeddedProgressLabel =>
        $"{EmbeddedProgressPercent}% {ProgressVerb}";
    private string EmbeddedProgressAriaLabel =>
        string.IsNullOrWhiteSpace(Progress?.Label) ? EmbeddedProgressLabel : Progress.Label;
    private string ProgressVerb => Progress?.Kind switch
    {
        DetailProgressKind.Reading => "read",
        DetailProgressKind.Listening => "listened",
        DetailProgressKind.Watching => "watched",
        _ => "complete",
    };

    private Task Select(DetailAction action) => action.IsDisabled ? Task.CompletedTask : OnActionSelected.InvokeAsync(action);
    private Task SelectReaction(DetailAction action) => Select(action);

    private IReadOnlyDictionary<string, object>? AttributesFor(DetailAction action) =>
        ActionAttributes?.Invoke(action);

    private static string TooltipFor(DetailAction action)
        => action.Tooltip ?? (action.IsStub ? $"{action.Label} (coming soon)" : action.Label);

    private static string ActionKeyClass(DetailAction action)
        => new string(action.Key.Select(character => char.IsLetterOrDigit(character) ? char.ToLowerInvariant(character) : '-').ToArray()).Trim('-');

    public static string IconFor(DetailAction action) => action.Icon switch
    {
        "play_arrow" => Icons.Material.Filled.PlayArrow,
        "restart_alt" => Icons.Material.Outlined.RestartAlt,
        "headphones" => Icons.Material.Outlined.Headphones,
        "menu_book" => Icons.Material.Outlined.MenuBook,
        "groups" => Icons.Material.Outlined.Groups,
        "shuffle" => Icons.Material.Outlined.Shuffle,
        "add" => Icons.Material.Outlined.Add,
        "playlist_add" => Icons.Material.Outlined.PlaylistAdd,
        "thumb_up" => Icons.Material.Outlined.ThumbUp,
        "thumb_down" => Icons.Material.Outlined.ThumbDown,
        "favorite" when action.IsSelected => Icons.Material.Filled.Favorite,
        "favorite_filled" => Icons.Material.Filled.Favorite,
        "favorite" => Icons.Material.Outlined.FavoriteBorder,
        "playlist_add_check" => Icons.Material.Filled.PlaylistAddCheck,
        "check_circle" => Icons.Material.Outlined.CheckCircle,
        "link" => Icons.Material.Outlined.Link,
        "compare_arrows" => Icons.Material.Outlined.CompareArrows,
        "image" => Icons.Material.Outlined.Image,
        "sync" => Icons.Material.Outlined.Sync,
        "delete" => Icons.Material.Outlined.Delete,
        "edit" => Icons.Material.Outlined.Edit,
        "info" => Icons.Material.Outlined.Info,
        "arrow_back" => Icons.Material.Outlined.ArrowBack,
        "account_tree" => Icons.Material.Outlined.AccountTree,
        "auto_stories" => Icons.Material.Outlined.AutoStories,
        "read_listen" => Icons.Material.Outlined.Sync,
        "settings" => Icons.Material.Outlined.Settings,
        _ => Icons.Material.Outlined.OpenInNew,
    };
}
