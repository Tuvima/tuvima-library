@namespace MediaEngine.Web.Components.Details
@using System.Globalization
@using MediaEngine.Contracts.Details
<div class="tl-detail-actions">
    @* No main button when nothing is playable: the primary slot is not rendered at all, so the circles sit flush left. *@
    @foreach (var action in PrimaryActions.Where(action => action.Key != "restart").Take(1))
    {
        <div class="tl-detail-primary-actions">
            <AppNativeButton Type="button" Class="@($"tl-detail-action--primary tl-detail-action--{ActionKeyClass(action)} {(HasEmbeddedProgress ? "tl-detail-action--has-progress" : "")}")" Disabled="@action.IsDisabled" AriaLabel="@action.Label" OnClick="@(() => Select(action))" @attributes="AttributesFor(action)">
                <AppMaterialIcon Icon="@IconFor(action)" />
                <span class="tl-detail-action-label">
                    <span>@action.Label</span>
                    @if (HasEmbeddedProgress) { <span class="tl-detail-action-progress__label">@EmbeddedProgressLabel</span> }
                </span>
                @if (HasEmbeddedProgress) { <span class="tl-detail-action-progress__track" role="progressbar" aria-label="@EmbeddedProgressAriaLabel" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@EmbeddedProgressPercent"><AppCssElement Tag="span" Class="tl-detail-action-progress__fill" Css="@EmbeddedProgressStyle" /></span> }
            </AppNativeButton>
        </div>
    }
    <div class="tl-detail-secondary-actions">
        @foreach (var action in VisibleSecondaryActions)
        {
            @if (action.Key == "reaction-menu")
            {
                <MediaRateControl UseUtilityGlyph="true" Positive="@(action.IsSelected || action.Children.Any(child => child.Key == "reaction-like" && child.IsSelected))" Negative="@(action.Children.Any(child => child.Key == "reaction-dislike" && child.IsSelected))" Selected="@(positive => SelectReaction(action.Children.First(child => child.Key == (positive ? "reaction-like" : "reaction-dislike"))))" />
            }
            else
            {
                <AppTooltip Text="@TooltipFor(action)"><AppNativeButton Type="button" Class="hero-icon-circle" AriaLabel="@TooltipFor(action)" data-phone-label="@PhoneLabelFor(action)" Disabled="@action.IsDisabled" aria-pressed="@(action.IsSelected ? "true" : "false")" OnClick="@(() => Select(action))"><PlaybackUtilityGlyph Glyph="@UtilityGlyphFor(action)" Filled="@(action.Key == "my-list" && action.IsSelected)" /></AppNativeButton></AppTooltip>
            }
        }
        <OverflowActionMenu Actions="OverflowMenuActions" ButtonClass="hero-icon-circle" UsePlaybackGlyph="true" OnActionSelected="OnActionSelected" />
    </div>
</div>
@code {
    [Parameter] public IReadOnlyList<DetailAction> PrimaryActions { get; set; } = [];
    [Parameter] public IReadOnlyList<DetailAction> SecondaryActions { get; set; } = [];
    [Parameter] public IReadOnlyList<DetailAction> OverflowActions { get; set; } = [];
    [Parameter] public ProgressViewModel? Progress { get; set; }
    [Parameter] public bool UsePrimaryHeroChrome { get; set; }
    [Parameter] public bool IsMusicAlbum { get; set; }

    /// <summary>
    /// True while Editing Mode is on: "Mark as watched" and its reset are viewing actions, so the "..." menu leaves them out
    /// until editing ends (details overlay spec section 4).
    /// </summary>
    [Parameter] public bool HideStatusActions { get; set; }
    [Parameter] public EventCallback<DetailAction> OnActionSelected { get; set; }
    [Parameter] public Func<DetailAction, IReadOnlyDictionary<string, object>?>? ActionAttributes { get; set; }

    private IReadOnlyList<DetailAction> VisibleSecondaryActions => PrimaryActions.Skip(1).Where(action => action.Key == "shuffle").Concat(SecondaryActions).ToList();
    private IReadOnlyList<DetailAction> OverflowMenuActions => HideStatusActions
        ? OverflowMenu(PrimaryActions, OverflowActions)
            .Where(action => action.Key is not (DetailActionKeys.StatusComplete or DetailActionKeys.StatusReset))
            .ToList()
        : OverflowMenu(PrimaryActions, OverflowActions);

    /// <summary>The shared More list: the overflow actions plus the primary actions that do not fit in the row.</summary>
    public static IReadOnlyList<DetailAction> OverflowMenu(IReadOnlyList<DetailAction> primaryActions, IReadOnlyList<DetailAction> overflowActions) =>
        overflowActions.Concat(primaryActions.Skip(1).Where(action => action.Key is not ("restart" or "shuffle"))).ToList();
    private bool HasEmbeddedProgress => Progress?.Percent is > 0 && PrimaryActions.Count > 0;
    private int EmbeddedProgressPercent => Progress is null
        ? 0
        : Math.Clamp((int)Math.Round(Progress.Percent, MidpointRounding.AwayFromZero), 0, 100);
    private string EmbeddedProgressStyle =>
        $"width:{EmbeddedProgressPercent.ToString(CultureInfo.InvariantCulture)}%;";
    private string EmbeddedProgressLabel =>
        $"{EmbeddedProgressPercent}% {ProgressVerb}";
    private string EmbeddedProgressAriaLabel =>
        string.IsNullOrWhiteSpace(Progress?.Label) ? EmbeddedProgressLabel : Progress.Label;
    private string ProgressVerb => Progress?.Kind switch
    {
        DetailProgressKind.Reading => "read",
        DetailProgressKind.Listening => "listened",
        DetailProgressKind.Watching => "watched",
        _ => "complete",
    };

    private Task Select(DetailAction action) => action.IsDisabled ? Task.CompletedTask : OnActionSelected.InvokeAsync(action);
    private Task SelectReaction(DetailAction action) => Select(action);
    private static PlaybackUtilityGlyphKind UtilityGlyphFor(DetailAction action) => action.Key switch
    {
        "my-list" => PlaybackUtilityGlyphKind.Favorite,
        "shuffle" => PlaybackUtilityGlyphKind.Shuffle,
        "favorite" or "favorite-song" => PlaybackUtilityGlyphKind.Favorite,
        _ => action.Icon switch
        {
            "shuffle" => PlaybackUtilityGlyphKind.Shuffle,
            "favorite" or "favorite_filled" => PlaybackUtilityGlyphKind.Favorite,
            "thumb_up" => PlaybackUtilityGlyphKind.Like,
            "thumb_down" => PlaybackUtilityGlyphKind.Dislike,
            "check" or "check_circle" or "playlist_add_check" => PlaybackUtilityGlyphKind.Check,
            _ => PlaybackUtilityGlyphKind.Add,
        },
    };

    private IReadOnlyDictionary<string, object>? AttributesFor(DetailAction action) =>
        ActionAttributes?.Invoke(action);

    private static string PhoneLabelFor(DetailAction action)
        => action.Key == "my-list" ? "My List" : action.Label;

    /// <summary>My List's name follows its saved state, which the page toggles in place without rebuilding the action.</summary>
    private static string TooltipFor(DetailAction action)
        => action.Key == "my-list"
            ? action.IsSelected ? "Remove from My List" : "Add to My List"
            : action.Tooltip ?? action.Label;

    private static string ActionKeyClass(DetailAction action)
        => new string(action.Key.Select(character => char.IsLetterOrDigit(character) ? char.ToLowerInvariant(character) : '-').ToArray()).Trim('-');

    public static string IconFor(DetailAction action) => action.Icon switch
    {
        "play_arrow" => AppMaterialIcons.Filled.PlayArrow,
        "restart_alt" => AppMaterialIcons.Outlined.RestartAlt,
        "headphones" => AppMaterialIcons.Outlined.Headphones,
        "menu_book" => AppMaterialIcons.Outlined.MenuBook,
        "groups" => AppMaterialIcons.Outlined.Groups,
        "shuffle" => AppMaterialIcons.Outlined.Shuffle,
        "add" => AppMaterialIcons.Outlined.Add,
        "playlist_add" => AppMaterialIcons.Outlined.PlaylistAdd,
        "thumb_up" => AppMaterialIcons.Outlined.ThumbUp,
        "thumb_down" => AppMaterialIcons.Outlined.ThumbDown,
        "favorite" when action.IsSelected => AppMaterialIcons.Filled.Favorite,
        "favorite_filled" => AppMaterialIcons.Filled.Favorite,
        "favorite" => AppMaterialIcons.Outlined.FavoriteBorder,
        "playlist_add_check" => AppMaterialIcons.Filled.PlaylistAddCheck,
        "check" => AppMaterialIcons.Outlined.Check,
        "check_circle" => AppMaterialIcons.Outlined.CheckCircle,
        "link" => AppMaterialIcons.Outlined.Link,
        "compare_arrows" => AppMaterialIcons.Outlined.CompareArrows,
        "image" => AppMaterialIcons.Outlined.Image,
        "sync" => AppMaterialIcons.Outlined.Sync,
        "delete" => AppMaterialIcons.Outlined.Delete,
        "edit" => AppMaterialIcons.Outlined.Edit,
        "info" => AppMaterialIcons.Outlined.Info,
        "arrow_back" => AppMaterialIcons.Outlined.ArrowBack,
        "account_tree" => AppMaterialIcons.Outlined.AccountTree,
        "auto_stories" => AppMaterialIcons.Outlined.AutoStories,
        "settings" => AppMaterialIcons.Outlined.Settings,
        _ => AppMaterialIcons.Outlined.OpenInNew,
    };
}
