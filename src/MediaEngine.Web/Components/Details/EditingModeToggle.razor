@namespace MediaEngine.Web.Components.Details

@* There is no standing Edit button: Edit is an entry in the "..." menu (details overlay spec D2). While Editing Mode
   is on this stays as the Done button, for a person who may edit this item on a device that may edit. *@
@if (Mode is { CanEdit: true, IsOn: true })
{
    <AppButton ButtonStyle="AppButtonStyle.Filled"
               Tone="AppUiTone.Primary"
               Size="AppControlSize.Large"
               Class="tl-editing-toggle"
               StartIcon="@AppMaterialIcons.Outlined.Check"
               aria-pressed="true"
               OnClick="OnToggle">
        Done
    </AppButton>
}

@code {
    [Parameter, EditorRequired] public EditingModeContext? Mode { get; set; }

    [Parameter] public EventCallback OnToggle { get; set; }
}
