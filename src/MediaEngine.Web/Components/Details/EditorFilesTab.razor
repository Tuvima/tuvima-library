@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Metadata
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Formatting
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Theming
@using MediaEngine.Web.Services.Ui
@inject IEngineApiClient Api
@inject IServiceProvider Services
@inject ILogger<EditorFilesTab> Logger
@inject IStringLocalizer<SharedStrings> L

@* The Files tab of the universal editor window (v4 D3, WP5): the files of the item being edited with their name, folder, size, quality and a
   Read-only mark for a file in a Read-only library folder. An audiobook's files are numbered in the order they play. It is read-only
   and reads again whenever the item being edited changes. Delete (v4 D13) is offered on each file for an administrator on a desktop: one
   question, then it happens at once and the row leaves the list; it does not wait for Save. *@
<div class="tl-files" data-testid="editor-files">
    @if (_loading)
    {
        <EditorPanelBusy Label="@L["EditorFiles_Loading"].Value" />
    }
    else if (_failed)
    {
        <AppAlert Severity="AppSeverity.Error" Dense="true">
            @L["EditorFiles_CouldNotRead"]
            <AppButton Label="@L["Common_TryAgain"].Value" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact" OnClick="ReloadAsync" />
        </AppAlert>
    }
    else if (Visible.Count == 0)
    {
        <p class="tl-files__empty" data-testid="files-empty">@(IsGrouping ? L["EditorFiles_EmptyGrouping"].Value : L["EditorFiles_Empty"].Value)</p>
    }
    else
    {
        @foreach (var edition in Visible)
        {
            <section class="tl-files__group">
                @if (Visible.Count > 1 && !string.IsNullOrWhiteSpace(edition.Label))
                {
                    <h3 class="tl-files__heading">@edition.Label</h3>
                }

                <table class="tl-files__table">
                    <thead>
                        <tr>
                            @if (edition.Assets.Count > 1)
                            {
                                <th scope="col" class="tl-files__num">#</th>
                            }

                            <th scope="col">@L["EditorFiles_Name"]</th>
                            <th scope="col">@L["EditorFiles_Folder"]</th>
                            <th scope="col" class="tl-files__size">@L["EditorFiles_Size"]</th>
                            <th scope="col">@L["EditorFiles_Quality"]</th>
                            <th scope="col">@L["EditorFiles_Access"]</th>
                            @if (ShowDelete)
                            {
                                <th scope="col" class="tl-files__actions"><span class="tl-files__visually-hidden">@L["EditorFiles_Actions"]</span></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var index = 0; index < edition.Assets.Count; index++)
                        {
                            var asset = edition.Assets[index];
                            <tr class="tl-files__row" data-asset-id="@asset.AssetId" @key="asset.AssetId">
                                @if (edition.Assets.Count > 1)
                                {
                                    <td class="tl-files__num">@(index + 1)</td>
                                }

                                <td class="tl-files__name" data-overflow-tooltip="@asset.FileName">@asset.FileName</td>
                                <td class="tl-files__folder" data-overflow-tooltip="@asset.Folder">@asset.Folder</td>
                                <td class="tl-files__size">@(asset.FileSizeBytes is > 0 ? DisplayFormat.FormatFileSize(asset.FileSizeBytes.Value) : string.Empty)</td>
                                <td class="tl-files__quality">@asset.TechnicalLabel</td>
                                <td>
                                    @if (asset.ReadOnly)
                                    {
                                        <AppChip Text="@L["EditorFiles_ReadOnly"].Value" Icon="@AppMaterialIcons.Outlined.Lock" Tone="AppUiTone.Neutral" Title="@L["EditorFiles_ReadOnlyTip"].Value" Class="tl-files__mark" />
                                    }
                                </td>
                                @if (ShowDelete)
                                {
                                    <td class="tl-files__actions">
                                        <AppIconButton Icon="@AppMaterialIcons.Outlined.Delete"
                                                       Size="AppControlSize.Compact"
                                                       Tone="AppUiTone.Error"
                                                       Class="tl-files__delete"
                                                       Tooltip="@string.Format(L["EditorFiles_DeleteFile"].Value, asset.FileName)"
                                                       AriaLabel="@string.Format(L["EditorFiles_DeleteFile"].Value, asset.FileName)"
                                                       Disabled="@_deleting"
                                                       OnClick="@(() => DeleteFileAsync(asset))" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }

        @if (_truncated)
        {
            <p class="tl-files__note">@L["EditorFiles_OnlyFirst"]</p>
        }
    }
</div>

@code {
    private IReadOnlyList<MediaEditorEditionSelectorDto> _editions = [];
    private bool _loading;
    private bool _failed;
    private bool _truncated;
    private Guid _loadedFor;
    private bool _deleting;
    private readonly HashSet<Guid> _removed = [];

    // The files still shown: one the Engine has deleted leaves the list at once, and an edition left with none leaves with it.
    private IReadOnlyList<MediaEditorEditionSelectorDto> Visible => _removed.Count == 0
        ? _editions
        : [.. _editions
            .Select(edition => new MediaEditorEditionSelectorDto
            {
                EditionId = edition.EditionId,
                Label = edition.Label,
                Collapse = edition.Collapse,
                Assets = [.. edition.Assets.Where(asset => !_removed.Contains(asset.AssetId))],
            })
            .Where(edition => edition.Assets.Count > 0)];

    // Delete is for an administrator on a desktop; the Engine still decides on every call.
    private bool ShowDelete => CanDelete
        && EntityId != Guid.Empty
        && !IsGrouping
        && LibraryItemDeletionFlow.CanDelete(Services.GetService<DeviceContextService>(), Services.GetService<DashboardSessionAccessor>());

    /// <summary>The Engine allows editing here; without it no file offers Delete.</summary>
    [Parameter] public bool CanDelete { get; set; }

    /// <summary>Told which items went when a file was the item's last (the item leaves the Library too), so the editor moves off it. Not raised when the item stays.</summary>
    [Parameter] public EventCallback<IReadOnlyCollection<Guid>> OnDeleted { get; set; }

    /// <summary>The item being edited.</summary>
    [Parameter, EditorRequired] public Guid EntityId { get; set; }

    /// <summary>The item is a show, season or album: it holds no file itself, so an empty list says where the files are.</summary>
    [Parameter] public bool IsGrouping { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == EntityId)
        {
            return;
        }

        await ReloadAsync();
    }

    // One file goes at once after the one question. A failure shows its reason in the question and the row stays; a row leaves the list only
    // for a file the Engine deleted. When it was the item's last file the Engine deletes the item, and the editor moves to its parent.
    private async Task DeleteFileAsync(MediaEditorAssetSelectorDto asset)
    {
        if (_deleting || Services.GetService<IAppDialogService>() is not { } dialogs || Services.GetService<IAppToastService>() is not { } toasts)
        {
            return;
        }

        if (LibraryItemDeletionFlow.TryRefuse(Services.GetService<DeviceContextService>(), Services.GetService<DashboardSessionAccessor>(), toasts))
        {
            return;
        }

        var workId = EntityId;
        _deleting = true;
        using var editorDeleting = Services.GetService<EditorHost>()?.MarkDeleting();
        try
        {
            var answer = await LibraryItemDeletionFlow.RunFileAsync(dialogs, toasts, new LibraryFileTarget(workId, asset.AssetId, asset.FileName));
            if (answer is null)
            {
                return;
            }

            _removed.Add(asset.AssetId);
            if (answer.NoLongerInLibrary || answer.Deleted?.DeletedWorkIds.Contains(workId) == true)
            {
                await OnDeleted.InvokeAsync(new[] { workId });
            }
        }
        finally
        {
            _deleting = false;
        }
    }

    private async Task ReloadAsync()
    {
        var id = EntityId;
        _loadedFor = id;
        _removed.Clear();
        _loading = true;
        _failed = false;
        try
        {
            var versions = id == Guid.Empty ? null : await Api.GetMediaEditorWorkVersionsAsync(id);
            if (_loadedFor != id)
            {
                return;
            }

            _editions = versions?.Editions ?? [];
            _truncated = versions?.IsTruncated == true;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "The files of {EntityId} could not be read for the editor", id);
            if (_loadedFor == id)
            {
                _editions = [];
                _failed = true;
            }
        }
        finally
        {
            if (_loadedFor == id)
            {
                _loading = false;
            }
        }
    }
}
