@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Services.Editing
@implements IDisposable
@inject DeviceContextService Device
@inject IAppToastService Toasts
@inject IAppDialogService Dialogs
@inject IServiceProvider Services

@* The ticked rows' bar, the "Edit together" section, the bar's Move section and the result line, in the list column directly above the
   rows (details overlay spec D8). It is a sibling of the rows inside their own column, not the hero's section slot, but its two sections
   share Editing Mode's one open section (EditingSection.Batch and BatchMove). The bar reads "{n} selected · Edit together · ... · Clear";
   the "..." menu holds "Move…" and, last and red, "Delete from library…". Nothing renders outside Editing Mode, on a device that may not
   edit, or while no row is ticked and nothing is left to say. *@
@if (Mode is { IsOn: true, CanEdit: true } mode && Selection is { } selection && IsShown(mode, selection))
{
    <section class="tl-batch" aria-label="Selected rows">
        @if (selection.Count > 0)
        {
            <div class="tl-batch__bar" role="toolbar" aria-label="Selected rows">
                <span class="tl-batch__count" role="status">@DetailBatchText.SelectedLabel(selection.Count)</span>
                <span class="tl-batch__actions">
                    <AppButton Label="@DetailBatchText.EditTogether"
                               StartIcon="@AppMaterialIcons.Outlined.Edit"
                               Class="tl-batch__edit-together"
                               ButtonStyle="@(mode.OpenSectionKind == EditingSection.Batch ? AppButtonStyle.Filled : AppButtonStyle.Outlined)"
                               Tone="@(mode.OpenSectionKind == EditingSection.Batch ? AppUiTone.Primary : AppUiTone.Neutral)"
                               Disabled="@IsBusy(mode)"
                               aria-pressed="@(mode.OpenSectionKind == EditingSection.Batch ? "true" : "false")"
                               OnClick="ToggleEditTogetherAsync" />
                    <OverflowActionMenu Actions="@MenuActions(mode, selection)"
                                        ButtonClass="tl-editing-banner__more"
                                        OnActionSelected="OnMenuActionAsync" />
                    <AppButton Label="Clear"
                               ButtonStyle="AppButtonStyle.Text"
                               Disabled="@IsBusy(mode)"
                               OnClick="ClearAsync" />
                </span>
            </div>
        }

        @if (mode.OpenSectionKind == EditingSection.Batch)
        {
            <DetailBatchSection Mode="mode" Selection="selection" />
        }

        @if (mode.OpenSectionKind == EditingSection.BatchMove && selection.Count > 0)
        {
            <DetailBatchMoveFlow Mode="mode"
                                 ItemIds="@selection.Ids"
                                 MediaType="@selection.MediaType"
                                 OnClosed="CloseMove"
                                 OnMoved="OnMovedAsync" />
        }

        @if (selection.Result is { } result)
        {
            <div class="@(result.HasProblems ? "tl-batch__result has-problems" : "tl-batch__result")" role="status">
                <p class="tl-batch__result-line">@result.Line</p>
                @if (result.Notes.Count > 0)
                {
                    <ul class="tl-batch__result-notes" aria-label="Rows that did not change">
                        @foreach (var note in result.Notes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                }
            </div>
        }
    </section>
}

@code {
    private EditingModeContext? _mode;
    private DetailBatchSelection? _selection;
    private bool _deleting;

    [CascadingParameter] public EditingModeContext? Mode { get; set; }

    [CascadingParameter] public DetailBatchSelection? Selection { get; set; }

    private static bool IsShown(EditingModeContext mode, DetailBatchSelection selection) =>
        selection.Count > 0 || mode.OpenSectionKind.IsBatch() || selection.Result is not null;

    // A save, a question or a delete is in flight: nothing on the bar starts a second one.
    private bool IsBusy(EditingModeContext mode) => mode.IsSettling || mode.SectionSaving || _deleting;

    private IReadOnlyList<DetailAction> MenuActions(EditingModeContext mode, DetailBatchSelection selection) =>
        DetailBatchRules.BarMenuActions(selection.Rows, CanMove(selection), CanDelete(selection), IsBusy(mode));

    private bool CanMove(DetailBatchSelection selection) =>
        EditorDeviceRule.CanEdit(Device) && DetailBatchRules.CanMove(selection.Rows);

    private bool CanDelete(DetailBatchSelection selection) =>
        DetailBatchRules.AreDeletable(selection.Rows)
        && LibraryItemDeletionFlow.CanDelete(Device, Services.GetService<DashboardSessionAccessor>());

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_mode, Mode))
        {
            if (_mode is not null)
            {
                _mode.Changed -= OnStateChanged;
            }

            _mode = Mode;
            if (_mode is not null)
            {
                _mode.Changed += OnStateChanged;
            }
        }

        if (!ReferenceEquals(_selection, Selection))
        {
            if (_selection is not null)
            {
                _selection.Changed -= OnSelectionChanged;
            }

            _selection = Selection;
            if (_selection is not null)
            {
                _selection.Changed += OnSelectionChanged;
            }
        }
    }

    // The section follows the rows: with nothing left ticked and nothing typed, there is nothing to edit together.
    private void OnSelectionChanged()
    {
        if (Selection is { Count: 0 } && Mode is { SectionDirty: false } && Mode.OpenSectionKind.IsBatch())
        {
            Mode.CloseSection();
        }

        OnStateChanged();
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    // The bar's "Edit together": one section open at a time, so this closes a hero section first (asking Save or discard if it holds input).
    private async Task ToggleEditTogetherAsync()
    {
        if (Mode is null || EditorDeviceRule.TryRefuse(Device, Toasts))
        {
            return;
        }

        await Mode.ToggleSectionAsync(EditingSection.Batch);
    }

    private async Task OnMenuActionAsync(DetailAction action)
    {
        switch (action.Key)
        {
            case DetailBatchRules.MoveActionKey:
                await OpenMoveAsync();
                break;
            case DetailActionKeys.DeleteFromLibrary:
                await DeleteAsync();
                break;
        }
    }

    // Move is a section like "Edit together": one open at a time, so this closes a hero section or the batch section first, asking
    // "Save or discard?" when it holds input. The handler checks the gates again; the menu entry is never the only protection.
    private async Task OpenMoveAsync()
    {
        if (Mode is null || Selection is null || EditorDeviceRule.TryRefuse(Device, Toasts))
        {
            return;
        }

        if (!DetailBatchRules.CanMove(Selection.Rows))
        {
            return;
        }

        await Mode.ShowSectionAsync(EditingSection.BatchMove);
    }

    private void CloseMove()
    {
        if (Mode is { OpenSectionKind: EditingSection.BatchMove })
        {
            Mode.CloseSection();
        }
    }

    private async Task OnMovedAsync(string line)
    {
        CloseMove();
        Selection?.Clear();
        Toasts.Add(line, AppSeverity.Success);
        await RefreshAsync();
    }

    // One dialog listing every file. The gate is the single Delete's own, checked again here; the Engine checks as well.
    private async Task DeleteAsync()
    {
        if (Selection is null || _deleting || Selection.Count == 0)
        {
            return;
        }

        if (LibraryItemDeletionFlow.TryRefuse(Device, Services.GetService<DashboardSessionAccessor>(), Toasts)
            || !DetailBatchRules.AreDeletable(Selection.Rows)
            || Selection.Count > DetailBatchRules.MaxDeleteItems)
        {
            return;
        }

        _deleting = true;
        try
        {
            var outcome = await LibraryItemDeletionFlow.RunAsync(Dialogs, Toasts, Selection.Ids);
            if (outcome != LibraryItemDeletionFlowOutcome.Canceled)
            {
                if (Mode is not null && Mode.OpenSectionKind.IsBatch())
                {
                    Mode.CloseSection();
                }

                Selection.Clear();
                await RefreshAsync();
            }
        }
        finally
        {
            _deleting = false;
        }
    }

    // Clear empties the ticks. An open batch section (typed fields, or move picks) asks Save or discard first; Cancel keeps everything as it was.
    private async Task ClearAsync()
    {
        if (Mode is null || Selection is null)
        {
            return;
        }

        if (Mode.OpenSectionKind.IsBatch() && !await Mode.CloseSectionAsync())
        {
            return;
        }

        Selection.Clear();
    }

    private async Task RefreshAsync()
    {
        if (Selection?.RefreshAsync is { } refresh)
        {
            await refresh();
        }
    }

    public void Dispose()
    {
        if (_mode is not null)
        {
            _mode.Changed -= OnStateChanged;
        }

        if (_selection is not null)
        {
            _selection.Changed -= OnSelectionChanged;
        }
    }
}
