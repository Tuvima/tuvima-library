@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Navigation
@using MediaEngine.Web.Services.Theming
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject DetailsOverlayState Overlay
@inject IServiceProvider Services

@* The details overlay frame (spec D1): a modal window over the page the person came from (a bottom sheet on phones).
   The browser makes everything outside it inert and unreachable, app-dialog.js locks the page scroll, returns focus to
   the element that opened it, and routes Esc, the backdrop and the sheet's grip to RequestCancel, which asks the guards. *@
<dialog @ref="_dialog"
        class="@RootClass"
        role="dialog"
        aria-modal="true"
        aria-labelledby="@TitleId"
        data-details-overlay>
    @if (IsSheet)
    {
        <div class="tl-details-overlay__grip" data-app-dialog-grip aria-hidden="true"><span></span></div>
    }
    @* First, so app-dialog.js (which labels a dialog by its first h2 with an id) picks it up. *@
    <h2 id="@TitleId" class="tl-details-overlay__title">@(string.IsNullOrWhiteSpace(Overlay.Title) ? "Details" : Overlay.Title)</h2>
    <div class="tl-details-overlay__frame">
        @* AppNativeButton renders the element, so its 44px top-right style lives in app.css (scoped styles cannot reach it). *@
        <AppNativeButton Type="button"
                         Class="tl-details-overlay__close"
                         AriaLabel="Close"
                         Title="Close"
                         OnClick="CloseAsync">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Close" />
        </AppNativeButton>
        <div class="tl-details-overlay__scroller" data-detail-origin-scroll="details-overlay" tabindex="-1" autofocus>
            @ChildContent
        </div>
    </div>
</dialog>

@code {
    private const string TitleId = "tl-details-overlay-title";

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ElementReference _dialog;
    private readonly string _frameId = Guid.NewGuid().ToString("N");
    private IJSObjectReference? _module;
    private DotNetObjectReference<DetailsOverlayHost>? _self;
    private DeviceContextService? _device;
    private bool _disposed;

    private bool IsSheet => _device?.IsPhone == true;

    private string RootClass => IsSheet ? "tl-details-overlay tl-details-overlay--sheet" : "tl-details-overlay";

    protected override void OnInitialized()
    {
        // Optional: a host rendered without a device context stays a centred window.
        _device = Services.GetService(typeof(DeviceContextService)) as DeviceContextService;
        if (_device is not null)
            _device.OnChanged += OnDeviceChanged;

        Overlay.TitleChanged += OnTitleChanged;
    }

    private void OnDeviceChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnTitleChanged() => _ = InvokeAsync(() =>
    {
        if (!_disposed)
            StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
            return;

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/app-dialog.js");
            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("update", _dialog, _self, true, true, true, _frameId, IsSheet);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; there is no window left to open.
        }
    }

    // Esc, the backdrop and a swipe down on the sheet's grip all arrive here, like the close button.
    [JSInvokable]
    public Task RequestCancel() => CloseAsync();

    private async Task CloseAsync()
    {
        if (!_disposed)
            await Overlay.DismissAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Overlay.TitleChanged -= OnTitleChanged;
        if (_device is not null)
            _device.OnChanged -= OnDeviceChanged;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detach", _frameId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone; the browser already dropped the window.
            }
        }

        _self?.Dispose();
    }
}
