@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details

@* Quiet "Same file as Episode N" note for episodes stored in one combined file. The data arrives with the episode item, so the chip never makes a request of its own. *@
@if (Links.Count > 0)
{
    @if (CanHighlight)
    {
        <AppToggleChip Class="same-file-chip"
                       AriaLabel="@($"{Label}. Highlight the matching episode.")"
                       Pressed="IsHighlighting"
                       OnClick="OnHighlight">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Link" Size="AppIconSize.Inline16" />
            <span>@Label</span>
        </AppToggleChip>
    }
    else
    {
        <AppChip Class="same-file-chip" Icon="@AppMaterialIcons.Outlined.Link" Text="@Label" />
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SequenceCoverageLinkViewModel> Links { get; set; } = [];
    [Parameter] public bool CanHighlight { get; set; }
    [Parameter] public bool IsHighlighting { get; set; }
    [Parameter] public EventCallback OnHighlight { get; set; }

    private string Label
    {
        get
        {
            var numbers = Links
                .Select(link => link.PositionLabel)
                .Where(label => !string.IsNullOrWhiteSpace(label))
                .ToList();
            return numbers.Count switch
            {
                0 => "Same file as another episode",
                1 => $"Same file as Episode {numbers[0]}",
                _ => $"Same file as Episodes {string.Join(", ", numbers)}",
            };
        }
    }
}
