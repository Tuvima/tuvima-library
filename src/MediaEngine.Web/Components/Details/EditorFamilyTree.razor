@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Editing
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IStringLocalizer<SharedStrings> L

@* The family tree in the pop-over's left column (universal editor v3 WP2, D3, D11): "This show", "This album" or "This series" and only
   that. Each row shows a tick when matched, an amber "not matched" when it failed (the reason is its tooltip) and a purple dot when it has
   changes waiting. Clicking a row switches the right side to that item; every item's staged changes stay in the one list. The rows are one tab
   stop with arrow keys (Up and Down move, Right opens, Left closes or goes up, Home and End jump, Enter picks). Long seasons and albums page in
   as the end of the list scrolls into view. Below 1280px the column becomes a dropdown on top of the right side (the same list, opened by its
   button). Nothing is saved here. *@
@if (Family.Visible && Flow is not null)
{
    var rows = Family.Rows();
    var activeId = Flow.Session.ActiveItem?.EntityId ?? Guid.Empty;
    var pending = Flow.Session.Pending.Changes.Select(change => change.EntityId).ToHashSet();
    var focusId = FocusTarget(rows, activeId);
    <aside class="@(_open ? "tl-family is-open" : "tl-family")" aria-label="@Family.Heading" aria-busy="@(Family.Loading || Flow.Switching ? "true" : null)">
        <div class="tl-family__toggle-wrap">
        <AppButton ButtonStyle="AppButtonStyle.Outlined"
                   Tone="AppUiTone.Neutral"
                   Class="tl-family__toggle"
                   aria-expanded="@(_open ? "true" : "false")"
                   aria-controls="tl-family-list"
                   OnClick="ToggleOpen">
            <span class="tl-family__toggle-heading">@Family.Heading</span>
            <span class="tl-family__toggle-current">@Split(Flow.Session.ActiveItem?.Title ?? string.Empty, Flow.Session.ActiveItem?.Title).Title</span>
            <AppIcon Name="@(_open ? AppIcons.ChevronDown : AppIcons.ChevronRight)" Decorative="true" />
        </AppButton>
        </div>
        <h3 class="tl-family__heading">@Family.Heading</h3>
        <ul id="tl-family-list" class="tl-family__list" role="tree" aria-label="@Family.Heading" aria-multiselectable="false">
            @foreach (var row in rows.Select((row, index) => (row, index)))
            {
                @Render(row.row, row.index, activeId, pending, focusId)
            }
        </ul>
    </aside>
}

@code {
    private const string ObserverModule = "./js/load-more-observer.js";

    private readonly Dictionary<Guid, (DotNetObjectReference<MoreCallback> Reference, string ElementId)> _observed = [];
    private IJSObjectReference? _module;
    private EditorFamilyState? _family;
    private EditSessionFlow? _flow;
    private Guid? _focusRow;
    private bool _focusPending;
    private bool _open;
    private bool _disposed;

    [Parameter, EditorRequired] public EditorFamilyState Family { get; set; } = default!;

    [Parameter, EditorRequired] public EditSessionFlow? Flow { get; set; }

    /// <summary>Opens Match for a row that is not matched yet (the editor opens on Match when the item is not matched, D4).</summary>
    [Parameter] public bool CanMatch { get; set; }

    /// <summary>
    /// A combined label such as "The Beatles Abbey Road" reads as the title with the artist as a muted second line. The clean title is known
    /// for the item being edited; when the row's label ends with it, the rest is the context.
    /// </summary>
    internal static (string Title, string? Context) Split(string label, string? cleanTitle)
    {
        if (!string.IsNullOrWhiteSpace(cleanTitle)
            && label.Length > cleanTitle.Length + 1
            && label.EndsWith(cleanTitle, StringComparison.OrdinalIgnoreCase)
            && char.IsWhiteSpace(label[label.Length - cleanTitle.Length - 1]))
        {
            var context = label[..(label.Length - cleanTitle.Length)].TrimEnd(' ', '-', '\u2013', '\u2014', ':', '\u2022');
            if (context.Length > 0)
            {
                return (cleanTitle, context);
            }
        }

        return (label, null);
    }

    private static string RowId(Guid id) => $"tl-family-row-{id:N}";

    // Rows are indented by depth through a class (no inline styles); deeper levels share the last indent.
    private static string DepthClass(string name, int depth) => $"{name} tl-family-depth-{Math.Clamp(depth, 0, 5)}";

    // The one row with tabindex 0: the row the keys last moved to, else the item being edited, else the first row.
    private Guid FocusTarget(IReadOnlyList<FamilyRow> rows, Guid activeId)
    {
        if (_focusRow is { } chosen && rows.Any(row => IsStop(row) && row.EntityId == chosen && row.Type == FamilyRowType.Item))
        {
            return chosen;
        }

        return rows.Any(row => row.Type == FamilyRowType.Item && row.EntityId == activeId)
            ? activeId
            : rows.FirstOrDefault(row => row.Type == FamilyRowType.Item)?.EntityId ?? Guid.Empty;
    }

    private static bool IsStop(FamilyRow row) => row.Type is FamilyRowType.Item or FamilyRowType.More;

    private RenderFragment Render(FamilyRow row, int index, Guid activeId, HashSet<Guid> pending, Guid focusId) => __builder =>
    {
        switch (row.Type)
        {
            case FamilyRowType.Skeleton:
                <li role="none" class="@DepthClass("tl-family__skeleton", row.Depth)" @key="@($"s{index}")">
                    <AppSkeleton Height="1.25rem" Width="@(index % 2 == 0 ? "70%" : "55%")" />
                </li>
                break;
            case FamilyRowType.Heading:
                <li role="none" class="@DepthClass("tl-family__heading-row", row.Depth)" @key="@($"h{row.EntityId:N}")">@row.Title</li>
                break;
            case FamilyRowType.Note:
                <li role="none" class="@DepthClass("tl-family__note", row.Depth)" @key="@($"n{row.EntityId:N}")">
                    @row.Title
                    @if (row.Kind == "Retry")
                    {
                        <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary" Size="AppControlSize.Compact" Class="tl-family__retry"
                                   OnClick="() => Family.RetryAsync(row.EntityId)">@L["Common_TryAgain"]</AppButton>
                    }
                </li>
                break;
            case FamilyRowType.More:
                <li role="none" class="@DepthClass("tl-family__more", row.Depth)" @key="@($"m{row.EntityId:N}")">
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary" Size="AppControlSize.Compact" Class="tl-family__more-button"
                               id="@MoreId(row.EntityId)" tabindex="-1"
                               OnClick="() => Family.LoadMoreAsync(row.EntityId)">@row.Title</AppButton>
                </li>
                break;
            default:
                var selected = row.EntityId == activeId;
                var dot = pending.Contains(row.EntityId);
                var rowClass = DepthClass("tl-family__row", row.Depth) + (selected ? " is-selected" : string.Empty) + (row.Matched ? string.Empty : " is-unmatched");
                <li role="none" @key="@($"i{row.EntityId:N}")">
                    <div id="@RowId(row.EntityId)"
                         class="@rowClass"
                         role="treeitem"
                         tabindex="@(row.EntityId == focusId ? "0" : "-1")"
                         aria-level="@(row.Depth + 1)"
                         aria-selected="@(selected ? "true" : "false")"
                         aria-expanded="@(row.IsParent && row.Depth > 0 ? (row.Expanded ? "true" : "false") : null)"
                         aria-current="@(selected ? "true" : null)"
                         data-kind="@row.Kind"
                         data-matched="@(row.Matched ? "true" : "false")"
                         data-vo-drop-parent="@(row.IsParent && row.Depth > 0 ? row.EntityId.ToString() : null)"
                         @onclick="() => PickAsync(row)"
                         @onkeydown="args => KeyAsync(args, row)">
                        @if (row.IsParent && row.Depth > 0)
                        {
                            <span class="tl-family__chevron" aria-hidden="true"
                                  @onclick="() => Family.ToggleAsync(row.EntityId)" @onclick:stopPropagation="true">
                                <AppIcon Name="@(row.Expanded ? AppIcons.ChevronDown : AppIcons.ChevronRight)" Decorative="true" />
                            </span>
                        }
                        else
                        {
                            <span class="tl-family__chevron tl-family__chevron--none" aria-hidden="true"></span>
                        }
                        @if (!string.IsNullOrWhiteSpace(row.Detail))
                        {
                            <span class="tl-family__number">@row.Detail</span>
                        }
                        @{ var shown = Split(row.Title, selected ? Flow?.Session.ActiveItem?.Title : null); }
                        <span class="tl-family__title">@shown.Title@if (shown.Context is not null){<span class="tl-family__context">@shown.Context</span>}</span>
                        @if (!string.IsNullOrWhiteSpace(row.Variant))
                        {
                            <span class="tl-family__variant">@row.Variant</span>
                        }
                        @if (dot)
                        {
                            <span class="tl-family__dot" role="img" aria-label="Changes waiting" title="Changes waiting"></span>
                        }
                        @if (row.Matched)
                        {
                            <span class="tl-family__state tl-family__state--ok" title="@L["EditorFamily_Matched"]"><span aria-hidden="true">&#10003;</span><span class="sr-only">@L["EditorFamily_Matched"]</span></span>
                        }
                        else
                        {
                            <span class="tl-family__state tl-family__state--warn" title="@row.Reason">@L["EditorFamily_NotMatched"]</span>
                        }
                    </div>
                </li>
                break;
        }
    };

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_family, Family))
        {
            if (_family is not null)
            {
                _family.Changed -= OnChanged;
            }

            _family = Family;
            _family.Changed += OnChanged;
        }

        if (!ReferenceEquals(_flow, Flow))
        {
            if (_flow is not null)
            {
                _flow.Changed -= OnChanged;
                _flow.Session.Changed -= OnChanged;
            }

            _flow = Flow;
            if (_flow is not null)
            {
                _flow.Changed += OnChanged;
                _flow.Session.Changed += OnChanged;
            }
        }
    }

    private void OnChanged()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleOpen() => _open = !_open;

    private async Task PickAsync(FamilyRow row)
    {
        if (Flow is null || row.Type != FamilyRowType.Item)
        {
            return;
        }

        _focusRow = row.EntityId;
        if (row.IsParent && row.Depth > 0 && !row.Expanded)
        {
            await Family.OpenAsync(row.EntityId);
        }

        if (Family.TrailTo(row.EntityId) is { Count: > 0 } trail
            && await Flow.SwitchToAsync(trail)
            && !row.Matched && CanMatch && Flow.Session.ActiveTool == EditTool.Details)
        {
            // Nothing matches this item yet: it opens on Match, where the search is already filled in.
            await Flow.SelectToolAsync(EditTool.Match);
        }

        _open = false;
        _focusPending = true;
    }

    private async Task KeyAsync(KeyboardEventArgs args, FamilyRow row)
    {
        var rows = Family.Rows();
        var stops = rows.Where(IsStop).ToList();
        var at = stops.FindIndex(candidate => candidate.EntityId == row.EntityId && candidate.Type == row.Type);
        FamilyRow? target = null;
        switch (args.Key)
        {
            case "ArrowDown":
                target = at + 1 < stops.Count ? stops[at + 1] : null;
                break;
            case "ArrowUp":
                target = at > 0 ? stops[at - 1] : null;
                break;
            case "Home":
                target = stops.FirstOrDefault();
                break;
            case "End":
                target = stops.LastOrDefault();
                break;
            case "ArrowRight" when row.IsParent && row.Depth > 0 && !row.Expanded:
                await Family.OpenAsync(row.EntityId);
                return;
            case "ArrowRight" when row.IsParent && at + 1 < stops.Count && stops[at + 1].Depth > row.Depth:
                target = stops[at + 1];
                break;
            case "ArrowLeft" when row.IsParent && row.Depth > 0 && row.Expanded:
                await Family.ToggleAsync(row.EntityId);
                return;
            case "ArrowLeft":
                target = at > 0 ? stops.Take(at).LastOrDefault(candidate => candidate.Depth < row.Depth && candidate.Type == FamilyRowType.Item) : null;
                break;
            case "Enter" or " ":
                await PickAsync(row);
                return;
            default:
                return;
        }

        if (target is { Type: FamilyRowType.Item } item)
        {
            _focusRow = item.EntityId;
            _focusPending = true;
        }
        else if (target is { Type: FamilyRowType.More } more)
        {
            await Family.LoadMoreAsync(more.EntityId);
        }
    }

    private static string MoreId(Guid parentId) => $"tl-family-more-{parentId:N}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            if (_focusPending && _focusRow is { } row)
            {
                _focusPending = false;
                await JS.InvokeVoidAsync("tuvimaFocusFamilyRow", RowId(row));
            }

            await SyncObserversAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit ended; there is nothing left to focus or observe.
        }
    }

    // A "Show more" row is watched so the next page comes in as it scrolls near; the button stays for keyboards and when scripts are off.
    private async Task SyncObserversAsync()
    {
        var wanted = Family.Visible
            ? Family.Rows().Where(row => row.Type == FamilyRowType.More).Select(row => row.EntityId).ToHashSet()
            : [];
        foreach (var gone in _observed.Keys.Where(id => !wanted.Contains(id)).ToList())
        {
            await StopObservingAsync(gone);
        }

        if (wanted.Count == 0)
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ObserverModule);
        foreach (var parentId in wanted)
        {
            if (!_observed.TryGetValue(parentId, out var entry))
            {
                entry = (DotNetObjectReference.Create(new MoreCallback(() => InvokeAsync(() => Family.LoadMoreAsync(parentId)))), MoreId(parentId));
                _observed[parentId] = entry;
            }

            // Observing again replaces the old observer and reports the sentinel's current state, so a row still in view asks again.
            await _module.InvokeVoidAsync("observeById", entry.ElementId, entry.Reference, new { rootMargin = "200px 0px" });
        }
    }

    private async Task StopObservingAsync(Guid parentId)
    {
        if (!_observed.Remove(parentId, out var entry))
        {
            return;
        }

        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("disconnectById", entry.ElementId);
            }
        }
        catch (JSDisconnectedException)
        {
            // Nothing left to disconnect.
        }

        entry.Reference.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_family is not null)
        {
            _family.Changed -= OnChanged;
        }

        if (_flow is not null)
        {
            _flow.Changed -= OnChanged;
            _flow.Session.Changed -= OnChanged;
        }

        foreach (var id in _observed.Keys.ToList())
        {
            await StopObservingAsync(id);
        }

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit ended first.
            }
        }
    }

    /// <summary>What the page-in observer calls when a "Show more" row nears the screen.</summary>
    public sealed class MoreCallback(Func<Task> loadMore)
    {
        [JSInvokable]
        public Task LoadMoreFromObserverAsync() => loadMore();
    }
}
