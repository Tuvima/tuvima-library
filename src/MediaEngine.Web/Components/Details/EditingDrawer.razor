@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Web.Components.MediaEditor
@implements IDisposable
@inject IJSRuntime JS

@* The right-hand Editing Mode drawer. It is the existing media editor re-housed beside the unchanged detail page, not
   a second editor: the same Details, Artwork and Match and Identity sections, in the same shell, with the drawer's own
   header and tab strip. History is read-only and is not here. It closes with X, Esc or Done and returns focus to
   whatever opened it. *@
@if (Mode is { DrawerOpen: true } && _request is not null)
{
    <aside class="tl-editing-drawer"
           role="complementary"
           aria-labelledby="tl-editing-drawer-title"
           @onkeydown="HandleKeyDownAsync">
        <header class="tl-editing-drawer__header">
            <div class="tl-editing-drawer__heading">
                <h2 id="tl-editing-drawer-title" tabindex="-1">@HeaderTitle</h2>
                <p>@HeaderSubtitle</p>
            </div>
            <AppIconButton Icon="@AppMaterialIcons.Outlined.Close"
                           Size="AppControlSize.Large"
                           Tone="AppUiTone.Neutral"
                           Class="tl-editing-drawer__close"
                           Tooltip="Close editor drawer"
                           AriaLabel="Close editor drawer"
                           OnClick="CloseAsync" />
        </header>
        <div class="tl-editing-drawer__body">
            <SharedMediaEditorShell @ref="_shell"
                                    Request="@_request"
                                    Inline="true"
                                    Drawer="true"
                                    RequestedTab="@TabId(Mode.DrawerTab)"
                                    RequestedArtworkSlot="@Mode.DrawerArtworkSlot"
                                    RequestVersion="@Mode.DrawerRequestVersion"
                                    DirtyChanged="OnDirtyChanged"
                                    Committed="OnCommittedAsync"
                                    TabChanged="OnTabChanged"
                                    Closed="OnShellClosedAsync" />
        </div>
    </aside>
}

@code {
    private SharedMediaEditorShell? _shell;
    private MediaEditorLaunchRequest? _request;
    private EditingModeContext? _subscribed;
    private bool _wasOpen;
    private bool _focusDrawer;

    [Parameter, EditorRequired] public EditingModeContext? Mode { get; set; }

    /// <summary>Builds the editor request for the item shown on the page, opened on the given tab and artwork slot.</summary>
    [Parameter, EditorRequired] public Func<string, string?, MediaEditorLaunchRequest?> BuildRequest { get; set; } = (_, _) => null;

    /// <summary>The name of what is being edited, shown in the drawer header.</summary>
    [Parameter] public string ItemTitle { get; set; } = string.Empty;

    /// <summary>Raised after the drawer saved something so the page behind it can refresh.</summary>
    [Parameter] public EventCallback OnCommitted { get; set; }

    private string HeaderTitle => $"Editing {ItemTitle}".TrimEnd();

    private string HeaderSubtitle => Mode?.DrawerTab switch
    {
        EditingDrawerTab.Artwork => "Artwork",
        EditingDrawerTab.Match => "Match and Identity",
        _ => "Details",
    };

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_subscribed, Mode))
        {
            if (_subscribed is not null)
            {
                _subscribed.Changed -= OnModeChanged;
            }

            _subscribed = Mode;
            if (_subscribed is not null)
            {
                _subscribed.Changed += OnModeChanged;
            }
        }

        SyncOpenState();
    }

    private void SyncOpenState()
    {
        var open = Mode is { DrawerOpen: true };
        if (open && !_wasOpen && Mode is { DrawerTab: { } tab })
        {
            // A fresh opening builds a fresh editor session; a request made while it is open flows through parameters.
            _request = BuildRequest(TabId(tab) ?? "details", Mode.DrawerArtworkSlot);
            _focusDrawer = _request is not null;
            if (_request is not null)
            {
                _ = RememberOpenerAsync();
            }
        }
        else if (!open && _wasOpen)
        {
            _request = null;
            _ = RestoreOpenerAsync();
        }

        _wasOpen = open && _request is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDrawer && _request is not null)
        {
            _focusDrawer = false;
            await JS.InvokeVoidAsync("tuvimaFocusById", "tl-editing-drawer-title");
        }
    }

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnModeChanged;
        }
    }

    private static string? TabId(EditingDrawerTab? tab) => tab switch
    {
        EditingDrawerTab.Details => "details",
        EditingDrawerTab.Artwork => "artwork",
        EditingDrawerTab.Match => "links",
        _ => null,
    };

    private void OnModeChanged()
    {
        SyncOpenState();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnDirtyChanged(bool dirty) => Mode?.SetDrawerDirty(dirty);

    private void OnTabChanged(string tabId)
    {
        var tab = tabId switch
        {
            "artwork" => EditingDrawerTab.Artwork,
            "links" => EditingDrawerTab.Match,
            _ => EditingDrawerTab.Details,
        };
        Mode?.FollowDrawerTab(tab);
    }

    private Task OnCommittedAsync() => OnCommitted.InvokeAsync();

    private Task OnShellClosedAsync(bool applied)
    {
        Mode?.CloseDrawer();
        return Task.CompletedTask;
    }

    /// <summary>X: ask the editor to close (it asks first when it has unsaved input, then raises Closed).</summary>
    private async Task CloseAsync()
    {
        if (_shell is not null)
        {
            await _shell.RequestCloseAsync();
        }
        else
        {
            Mode?.CloseDrawer();
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        // A field being edited stops its own Esc from reaching here, so Esc closes the field first and the drawer second.
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            await CloseAsync();
        }
    }

    private async Task RememberOpenerAsync()
    {
        try { await JS.InvokeVoidAsync("tuvimaFocusReturn.remember"); }
        catch (JSDisconnectedException) { /* the circuit ended; there is nothing to remember */ }
    }

    private async Task RestoreOpenerAsync()
    {
        try { await JS.InvokeVoidAsync("tuvimaFocusReturn.restore"); }
        catch (JSDisconnectedException) { /* the circuit ended; focus no longer matters */ }
    }
}
