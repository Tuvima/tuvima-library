@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Web.Services.Editing
@implements IDisposable
@inject IJSRuntime JS
@inject IAppDialogService Dialogs
@inject IStringLocalizer<SharedStrings> L

@* The universal editor's window (v3 spec D1, D2): the content of the pop-over the layout shows in a modal dialog, with one header (title,
   the item's trail and close), the family tree on the left (where the item has a family) and the tools as tabs across the top of the right side (Details, Artwork, Match, only where the item has them), one scroll area for the
   tool, and a footer whose Cancel and Save are always in the same place. Closing it with the X, Esc or Cancel asks "Unsaved changes" when
   something is staged. The native dialog around it makes the page inert and traps focus; what the tool shows is chosen by the pop-over;
   Artwork is drawn here from the editor's picker session. *@
@if (Mode is { IsOn: true, CanEdit: true } mode && Flow?.Session is { IsActive: true, ActiveTool: { } tool } session)
{
    var count = session.Pending.ChangeCount;
    var flow = Flow;
    <div class="tl-editor-panel tl-editor-window"
         data-tool="@tool.ToString().ToLowerInvariant()">
        <header class="tl-editor-panel__header">
            <h2 id="tl-editor-panel-title" class="tl-editor-panel__title" tabindex="-1">@(_reviewing ? "Review changes" : TitleOverride ?? TitleFor(tool))</h2>
            @HeaderContent
            <AppIconButton Icon="@AppMaterialIcons.Outlined.Close"
                           Size="AppControlSize.Large"
                           Tone="AppUiTone.Neutral"
                           Class="tl-editor-panel__close"
                           Tooltip="@($"Close {TitleOverride ?? TitleFor(tool)}")"
                           AriaLabel="@($"Close {TitleOverride ?? TitleFor(tool)}")"
                           OnClick="@(() => flow.LeaveAsync())" />
        </header>
        @if (!_reviewing && (flow.Failures.Count > 0 || !string.IsNullOrWhiteSpace(flow.Message)))
        {
            @* A save that left changes behind, or an item that could not be opened: the reason stays above the tools until it is dealt with. *@
            <div class="tl-editor-window__notice" role="alert">
                <AppAlert Severity="AppSeverity.Error" Dense="true">
                    <strong>@(flow.Failures.Count > 0 ? "Some changes could not be saved." : flow.Message)</strong>
                    @if (flow.Failures.Count > 0)
                    {
                        <ul>
                            @foreach (var failure in flow.Failures)
                            {
                                <li>@flow.Describe(failure)</li>
                            }
                        </ul>
                    }
                </AppAlert>
            </div>
        }
        <div class="tl-editor-window__main">
            @if (TitleOverride is null && !_reviewing)
            {
                @TreeContent
            }
            <div class="tl-editor-window__content">
                @{
                    RenderFragment body = @<div class="tl-editor-panel__body">
                            @if (_reviewing)
                            {
                                <ReviewChangesView Source="flow" OnOutcome="OnReviewOutcome" />
                            }
                            else if (tool == EditTool.Artwork && Picker is not null)
                            {
                                <EditorArtworkTool Mode="Mode" Picker="Picker" />
                            }
                            else
                            {
                                @ChildContent?.Invoke(tool)
                            }
                        </div>;
                }
                @if (TitleOverride is null && !_reviewing)
                {
                    @* The shared tab strip (the same underline, spacing and arrow keys as the profile and browse pages). The open tool's panel holds the body. *@
                    var railTools = RailTools(mode, ShowHistory).ToList();
                    var activeIndex = Math.Max(0, railTools.FindIndex(entry => entry.Item1 == tool));
                    <AppTabs Class="tl-editor-window__tabs"
                             Label="@L["Common_EditingTools"].Value"
                             Rounded="false"
                             Border="false"
                             Elevation="0"
                             ActivePanelIndex="@activeIndex"
                             ActivePanelIndexChanged="@(index => index >= 0 && index < railTools.Count && railTools[index].Item1 != tool ? flow.SelectToolAsync(railTools[index].Item1) : Task.CompletedTask)">
                        @foreach (var (railTool, label, icon) in railTools)
                        {
                            <AppTabPanel Text="@label" Icon="@icon" Disabled="@(flow.Saving || flow.Switching)">
                                @if (railTool == tool)
                                {
                                    @body
                                }
                            </AppTabPanel>
                        }
                    </AppTabs>
                }
                else
                {
                    @body
                }
            </div>
        </div>
        @if (!_reviewing)
        {
        <footer class="tl-editor-window__footer">
            <span class="tl-editor-window__changes" role="status">@(count == 0 ? "No changes yet" : $"{count} {(count == 1 ? "change" : "changes")} waiting")</span>
            <div class="tl-editor-window__actions">
                <AppButton ButtonStyle="AppButtonStyle.Outlined"
                           Tone="AppUiTone.Neutral"
                           Size="AppControlSize.Large"
                           Class="tl-editor-window__cancel"
                           Disabled="@flow.Saving"
                           OnClick="@(() => flow.LeaveAsync())">
                    @L["Search_Cancel"]
                </AppButton>
                <AppButton ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary"
                           Size="AppControlSize.Large"
                           Class="tl-editor-window__save"
                           StartIcon="@AppMaterialIcons.Outlined.Check"
                           Disabled="@(count == 0 || flow.Saving)"
                           OnClick="OpenReviewAsync">
                    @(flow.Saving ? "Saving..." : count == 0 ? "Save changes" : $"Save {count} {(count == 1 ? "change" : "changes")}")
                </AppButton>
            </div>
        </footer>
        }
    </div>
}

@code {
    private EditTool? _focused;
    private bool _reviewing;
    private EditSessionFlow? _subscribed;

    [Parameter, EditorRequired] public EditingModeContext? Mode { get; set; }

    [Parameter, EditorRequired] public EditSessionFlow? Flow { get; set; }

    /// <summary>A title for the panel in place of the tool's name ("Edit 4 songs" while several ticked items are edited together).</summary>
    [Parameter] public string? TitleOverride { get; set; }

    /// <summary>What the open tool shows; the page decides (the Details fields, or the section the tool hosts).</summary>
    [Parameter] public RenderFragment<EditTool>? ChildContent { get; set; }

    /// <summary>Extra content in the header, between the title and the close button.</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>The left column (the family tree), drawn before the tools and the tool's content so the Tab order is header, tree, tools, content, footer.</summary>
    [Parameter] public RenderFragment? TreeContent { get; set; }

    /// <summary>The editor's artwork picker session; when set, the Artwork tool is drawn inside the window instead of by the page.</summary>
    [Parameter] public ArtworkPickerSession? Picker { get; set; }

    /// <summary>True on pages whose items keep a change history (not the Universe pages): the rail then offers the History tool.</summary>
    [Parameter] public bool ShowHistory { get; set; }

    private static IReadOnlyList<(EditTool Tool, string Label, string Icon)> RailTools(EditingModeContext mode, bool showHistory)
    {
        var tools = new List<(EditTool, string, string)> { (EditTool.Details, "Details", AppMaterialIcons.Outlined.Description) };
        if (mode.Fields.CanEditArtwork)
        {
            tools.Add((EditTool.Artwork, "Artwork", AppMaterialIcons.Outlined.PhotoLibrary));
        }

        if (mode.Fields.CanMatch)
        {
            tools.Add((EditTool.Match, "Match", AppMaterialIcons.Outlined.TravelExplore));
        }

        if (showHistory)
        {
            tools.Add((EditTool.History, "History", AppMaterialIcons.Outlined.History));
        }

        return tools;
    }

    // Save changes never saves straight away: it settles any open input, then opens Review changes, which checks the list and saves it.
    private async Task OpenReviewAsync()
    {
        if (Flow is not { Saving: false, Session.HasPendingChanges: true } flow || !await flow.SettleForReviewAsync())
        {
            return;
        }

        _reviewing = true;
    }

    // Review is a page of the window (spec D8): any way out of it returns to the tool, and a save or discard has already ended the session.
    private void OnReviewOutcome(ReviewChangesOutcome outcome) => _reviewing = false;

    private static string TitleFor(EditTool tool) => tool switch
    {
        EditTool.Artwork => "Artwork",
        EditTool.Match => "Match",
        EditTool.History => "History",
        _ => "Details",
    };

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Flow))
        {
            return;
        }

        if (_subscribed is not null)
        {
            _subscribed.Session.Changed -= OnChanged;
            _subscribed.Changed -= OnChanged;
        }

        _subscribed = Flow;
        if (_subscribed is not null)
        {
            _subscribed.Session.Changed += OnChanged;
            _subscribed.Changed += OnChanged;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var tool = Flow?.Session.ActiveTool;
        if (tool == _focused)
        {
            return;
        }

        _focused = tool;
        if (tool is null)
        {
            return;
        }

        try
        {
            // Names the panel for screen readers and keeps the keyboard inside it; this never scrolls the page.
            await JS.InvokeVoidAsync("tuvimaFocusById", "tl-editor-panel-title");
        }
        catch (JSDisconnectedException)
        {
            // The circuit ended; there is no page left to focus.
        }
    }

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Session.Changed -= OnChanged;
            _subscribed.Changed -= OnChanged;
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
}
