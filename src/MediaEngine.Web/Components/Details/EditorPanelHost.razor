@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Web.Services.Editing
@implements IDisposable
@inject IJSRuntime JS
@inject IAppDialogService Dialogs
@inject IStringLocalizer<SharedStrings> L
@inject IServiceProvider Services

@* The universal editor's window (v4 spec D2, D3, D16; v5 D1, D3, D10): the content of the pop-over the layout shows in a modal dialog. Top to
   bottom: the item's header (with the way around the family inside it), the tab bar (Details, Artwork, Match, Bookmarks, History, as far as the item's kind
   has them; the kind's list comes from the Engine), one scroll area for the tool, and a footer with Delete, the file status text, the unsaved
   count, Discard and Save changes in the same places. The window keeps one size whatever the tab; only the tab's content
   scrolls. While several ticked items are edited together, or Review changes is open, the plain title bar replaces the header. Closing it with the X, Esc
   or Discard asks "Unsaved changes" when something is staged. The native dialog around it makes the page inert and traps focus; what the
   tool shows is chosen by the pop-over; Artwork is drawn here from the editor's picker session. *@
@if (Mode is { IsOn: true, CanEdit: true } mode && Flow?.Session is { IsActive: true, ActiveTool: { } tool } session)
{
    var count = session.Pending.ChangeCount;
    var flow = Flow;
    var railTools = RailTools(mode, ShowHistory, IsAdministrator).ToList();
    // A tool the item switched to does not have (Match on a course video) falls back to Details instead of drawing nothing.
    var shown = railTools.Any(entry => entry.Item1 == tool) ? tool : EditTool.Details;
    var framed = ItemHeader is not null && TitleOverride is null && !_reviewing;
    var tabs = railTools.Select(entry => new EditorWindowChrome.Tab(entry.Item1.ToString(), entry.Item2, entry.Item3)).ToList();
    var title = _reviewing ? "Review changes" : TitleOverride ?? TitleFor(shown);
    <EditorWindowChrome Framed="framed"
                        ItemHeader="ItemHeader"
                        FooterStart="@(_reviewing ? null : FooterStart)"
                        Title="@title"
                        CloseName="@(TitleOverride ?? TitleFor(shown))"
                        HeaderExtra="HeaderContent"
                        ShowTabs="@(TitleOverride is null && !_reviewing)"
                        Tabs="tabs"
                        ActiveKey="@shown.ToString()"
                        TabsDisabled="@(flow.Saving || flow.Switching)"
                        OnTab="@(key => Enum.TryParse<EditTool>(key, out var picked) && picked != shown ? flow.SelectToolAsync(picked) : Task.CompletedTask)"
                        ShowFooter="@(!_reviewing)"
                        ReadOnly="@mode.Fields.IsReadOnlySeries"
                        ChangeCount="count"
                        Saving="flow.Saving"
                        OnClose="@(() => flow.LeaveAsync())"
                        OnDiscard="@(() => flow.LeaveAsync())"
                        OnSave="OpenReviewAsync">
        <Notice>
            @if (!_reviewing && (flow.Failures.Count > 0 || !string.IsNullOrWhiteSpace(flow.Message)))
            {
                @* A save that left changes behind, or an item that could not be opened: the reason stays above the tools until it is dealt with. *@
                <div class="tl-editor-window__notice" role="alert">
                    <AppAlert Severity="AppSeverity.Error" Dense="true">
                        <strong>@(flow.Failures.Count > 0 ? "Some changes could not be saved." : flow.Message)</strong>
                        @if (flow.Failures.Count > 0)
                        {
                            <ul>
                                @foreach (var failure in flow.Failures)
                                {
                                    <li>@flow.Describe(failure)</li>
                                }
                            </ul>
                        }
                    </AppAlert>
                </div>
            }
        </Notice>
        <Where>
            <EditorWhereLine Source="flow" />
        </Where>
        <Body>
            @if (_reviewing)
            {
                <ReviewChangesView Source="flow" OnOutcome="OnReviewOutcome" />
            }
            else if (shown == EditTool.Artwork && Picker is not null)
            {
                <EditorArtworkTool Mode="Mode" Picker="Picker" />
            }
            else
            {
                @ChildContent?.Invoke(shown)
            }
        </Body>
    </EditorWindowChrome>
}

@code {
    private EditTool? _focused;
    private bool _reviewing;
    private EditSessionFlow? _subscribed;

    [Parameter, EditorRequired] public EditingModeContext? Mode { get; set; }

    [Parameter, EditorRequired] public EditSessionFlow? Flow { get; set; }

    /// <summary>A title for the panel in place of the tool's name ("Edit 4 songs" while several ticked items are edited together).</summary>
    [Parameter] public string? TitleOverride { get; set; }

    /// <summary>What the open tool shows; the page decides (the Details fields, or the section the tool hosts).</summary>
    [Parameter] public RenderFragment<EditTool>? ChildContent { get; set; }

    /// <summary>Extra content in the header, between the title and the close button.</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>The item's header (picture, kind, title, facts, provider links, and the family's tile and dropdowns). When set, it replaces the plain title bar for a single item.</summary>
    [Parameter] public RenderFragment? ItemHeader { get; set; }

    /// <summary>Bottom-left of the footer (Delete); hidden while the changes are being reviewed.</summary>
    [Parameter] public RenderFragment? FooterStart { get; set; }

    /// <summary>The editor's artwork picker session; when set, the Artwork tool is drawn inside the window instead of by the page.</summary>
    [Parameter] public ArtworkPickerSession? Picker { get; set; }

    /// <summary>True on pages whose items keep a change history (not the Universe pages): the rail then offers the History tool.</summary>
    [Parameter] public bool ShowHistory { get; set; }

    // The tabs come from the kind's own list (config/editor.json, read by the Engine) in the fixed order Details, Artwork, Match, History; the item's
    // own abilities decide whether a listed tab can really open.
    private static IReadOnlyList<(EditTool Tool, string Label, string Icon)> RailTools(EditingModeContext mode, bool showHistory, bool isAdministrator) =>
        [.. EditorTabRules.For(mode.Fields.Config, mode.Fields, showHistory, isAdministrator).Select(tab => (tab.Tool, tab.Label, IconFor(tab.Tool)))];

    // The Bookmarks tab is an administrator's alone, and only on a desktop (the editor itself is desktop-only); the Engine checks again.
    private bool IsAdministrator => Services.GetService<DashboardSessionAccessor>()?.Authority?.EffectiveAdministrator == true;

    private static string IconFor(EditTool tool) => tool switch
    {
        EditTool.Artwork => AppMaterialIcons.Outlined.PhotoLibrary,
        EditTool.Match => AppMaterialIcons.Outlined.TravelExplore,
        EditTool.Bookmarks => AppMaterialIcons.Outlined.Bookmarks,
        EditTool.History => AppMaterialIcons.Outlined.History,
        EditTool.Preview => AppMaterialIcons.Outlined.Visibility,
        _ => AppMaterialIcons.Outlined.Description,
    };

    // Save changes never saves straight away: it settles any open input, then opens Review changes, which checks the list and saves it.
    private async Task OpenReviewAsync()
    {
        if (Flow is not { Saving: false, Session.HasPendingChanges: true } flow || !await flow.SettleForReviewAsync())
        {
            return;
        }

        _reviewing = true;
    }

    // Review is a page of the window (spec D8): any way out of it returns to the tool, and a save or discard has already ended the session.
    private void OnReviewOutcome(ReviewChangesOutcome outcome) => _reviewing = false;

    private static string TitleFor(EditTool tool) => tool switch
    {
        EditTool.Artwork => "Artwork",
        EditTool.Match => "Match",
        EditTool.Bookmarks => "Bookmarks",
        EditTool.History => "History",
        EditTool.Preview => "Preview",
        _ => "Details",
    };

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Flow))
        {
            return;
        }

        if (_subscribed is not null)
        {
            _subscribed.Session.Changed -= OnChanged;
            _subscribed.Changed -= OnChanged;
        }

        _subscribed = Flow;
        if (_subscribed is not null)
        {
            _subscribed.Session.Changed += OnChanged;
            _subscribed.Changed += OnChanged;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var tool = Flow?.Session.ActiveTool;
        if (tool == _focused)
        {
            return;
        }

        _focused = tool;
        if (tool is null)
        {
            return;
        }

        try
        {
            // Names the panel for screen readers and keeps the keyboard inside it; this never scrolls the page.
            await JS.InvokeVoidAsync("tuvimaFocusById", "tl-editor-panel-title");
        }
        catch (JSDisconnectedException)
        {
            // The circuit ended; there is no page left to focus.
        }
    }

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Session.Changed -= OnChanged;
            _subscribed.Changed -= OnChanged;
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
}
