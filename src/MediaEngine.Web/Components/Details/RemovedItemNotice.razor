@namespace MediaEngine.Web.Components.Details
@inject IStringLocalizer<SharedStrings> L

@* Shown in place of a detail page whose title was deleted by someone else while it was open (details overlay spec section 4). The
   overlay stays open so nothing typed is lost without warning: changes that were only staged are shown here, read-only, with
   a Copy button. Close dismisses the overlay as usual. *@
<section class="tl-removed-notice" role="alert" aria-labelledby="tl-removed-notice-title">
    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ErrorOutline" Size="AppIconSize.Tile32" />
    <h2 id="tl-removed-notice-title" class="tl-removed-notice__title">@Heading</h2>
    @if (!string.IsNullOrWhiteSpace(Note))
    {
        <AppAlert Severity="AppSeverity.Warning" Dense="true" data-removed-notice-note="true">@Note</AppAlert>
    }
    @if (!string.IsNullOrEmpty(InputText))
    {
        <div class="tl-removed-notice__input">
            <p class="tl-removed-notice__input-label">@(string.IsNullOrWhiteSpace(InputLabel) ? "What you were typing" : $"What you were typing in {InputLabel}")</p>
            <pre class="tl-removed-notice__input-text" tabindex="0" aria-label="@L["RemovedItemNotice_YourUnsavedText"].Value">@InputText</pre>
            <div class="tl-removed-notice__actions">
                <AppCopyButton Label="@L["Common_Copy"].Value"
                               Text="@InputText"
                               What="the text"
                               Class="tl-removed-notice__copy"
                               CopyFailed="@(message => _copyFailure = message)" />
            </div>
            @if (_copyFailure is not null)
            {
                <AppAlert Severity="AppSeverity.Warning" Dense="true" ShowCloseIcon="true" CloseIconClicked="@(() => _copyFailure = null)" data-removed-notice-copy-failed="true">@_copyFailure</AppAlert>
            }
        </div>
    }
    @if (LostSectionInput)
    {
        <p class="tl-removed-notice__lost">@L["RemovedItemNotice_AnOpenSectionAlsoHad"]</p>
    }
    <AppButton ButtonStyle="AppButtonStyle.Filled"
               Tone="AppUiTone.Primary"
               Size="AppControlSize.Large"
               Class="tl-removed-notice__close"
               OnClick="OnClose">
        @L["Common_Close"]
    </AppButton>
</section>

@code {
    public const string Heading = "This item is no longer in your library";

    /// <summary>The field whose unsaved text is shown (for example "Title"), when known.</summary>
    [Parameter] public string? InputLabel { get; set; }

    /// <summary>Unsaved text the person had typed; empty when there was none.</summary>
    [Parameter] public string? InputText { get; set; }

    /// <summary>True when an open section held unsaved changes that cannot be shown here.</summary>
    [Parameter] public bool LostSectionInput { get; set; }

    /// <summary>A line to show with the notice (files a delete left on disk); empty when there is nothing to add.</summary>
    [Parameter] public string? Note { get; set; }

    private string? _copyFailure;

    [Parameter] public EventCallback OnClose { get; set; }
}
