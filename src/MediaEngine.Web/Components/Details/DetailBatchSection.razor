@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Library
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@implements IDisposable
@implements IEditingSectionHost
@inject IEngineApiClient ApiClient
@inject IAppToastService Toasts
@inject DeviceContextService Device
@inject ILogger<DetailBatchSection> Logger

@* The batch section "Edit together" (details overlay spec D8, D9, D11): it opens above the rows in the list column, shows how the ticked
   rows stand on each metadata field, and applies the touched fields to all of them in one request. Every field starts as "No change".
   It holds the person's input until Apply, and counts as unsaved input for the page's "Save or discard?" (Save here means Apply). *@
<section class="tl-batch-section" id="tl-batch-section" aria-labelledby="tl-batch-section-title" data-section="batch">
    <header class="tl-batch-section__header">
        <div class="tl-batch-section__heading">
            <h3 id="tl-batch-section-title" class="tl-batch-section__title">@DetailBatchText.EditTogether</h3>
            <span class="tl-batch-section__scope">@Selection.Count @Noun</span>
        </div>
        <AppIconButton Icon="@AppMaterialIcons.Outlined.Close"
                       Size="AppControlSize.Large"
                       Tone="AppUiTone.Neutral"
                       Tooltip="Close Edit together"
                       AriaLabel="Close Edit together"
                       OnClick="CloseAsync" />
    </header>

    <div class="tl-batch-section__body">
        @if (_loading)
        {
            <AppPageState Kind="AppPageStateKind.Loading" Title="Loading the fields" />
        }
        else if (_preview is null)
        {
            <div class="tl-batch-section__message">
                <AppAlert Tone="AppUiTone.Error">@(_loadError ?? "Couldn't load the fields. Close this and try again.")</AppAlert>
            </div>
        }
        else
        {
            @if (_preview.UnavailableItems.Count > 0)
            {
                <p class="tl-batch-section__note" role="status">
                    @UnavailableText(_preview)
                </p>
            }

            @foreach (var field in _preview.Fields)
            {
                @FieldRow(field)
            }
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="tl-batch-section__message"><AppAlert Tone="AppUiTone.Error">@_error</AppAlert></div>
        }
    </div>

    <footer class="tl-batch-section__footer">
        <AppButton Label="@ApplyLabel"
                   ButtonStyle="AppButtonStyle.Filled"
                   Tone="AppUiTone.Primary"
                   Disabled="@(!CanApply)"
                   Loading="_applying"
                   OnClick="ApplyFromButtonAsync" />
        @if (!Draft.HasTouched)
        {
            <span class="tl-batch-section__hint">Every field says No change until you touch it.</span>
        }
    </footer>
</section>

@code {
    private readonly DetailBatchDraft _draft = new();
    private EditingModeContext? _mode;
    private DetailBatchSelection? _selection;
    private LibraryBatchEditPreview? _preview;
    private List<Guid> _loadedIds = [];
    private string? _loadError;
    private string? _error;
    private bool _loading = true;
    private bool _applying;
    private bool _disposed;
    private int _loadVersion;

    [Parameter, EditorRequired] public EditingModeContext Mode { get; set; } = default!;

    [Parameter, EditorRequired] public DetailBatchSelection Selection { get; set; } = default!;

    private DetailBatchDraft Draft => _draft;

    private string Noun => DetailBatchText.Noun(Selection.Rows.Select(row => row.Kind), Selection.Count);

    private string ApplyLabel => DetailBatchText.ApplyLabel(Selection.Count, Selection.Rows.Select(row => row.Kind));

    private bool CanApply => !_applying && _preview is not null && Selection.Count > 0 && Draft.HasTouched;

    protected override async Task OnInitializedAsync()
    {
        Mode.SectionHost = this;
        _mode = Mode;
        _selection = Selection;
        Selection.Changed += OnSelectionChanged;
        await LoadAsync();
    }

    private void OnSelectionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (_disposed || _applying)
            {
                return;
            }

            // Ticking or unticking rows while the section is open re-reads how the new set stands; what was typed stays.
            if (!Selection.Ids.SequenceEqual(_loadedIds))
            {
                await LoadAsync();
            }
            else
            {
                StateHasChanged();
            }
        });
    }

    private async Task LoadAsync()
    {
        var ids = Selection.Ids.ToList();
        var version = ++_loadVersion;
        _loadedIds = ids;
        _error = null;
        if (ids.Count == 0)
        {
            _preview = null;
            _loading = false;
            _loadError = "Tick some rows to edit them together.";
            return;
        }

        _loading = _preview is null;
        _loadError = null;
        var outcome = await ApiClient.PreviewLibraryBatchEditAsync(new LibraryBatchEditPreviewRequest { EntityIds = ids });
        if (_disposed || version != _loadVersion)
        {
            // A later tick or a close has replaced this answer.
            return;
        }

        _loading = false;
        if (outcome.IsOk)
        {
            _preview = outcome.Value;
            Draft.Keep(_preview!.Fields);
        }
        else
        {
            _preview = null;
            _loadError = Describe(outcome);
        }
    }

    private static string Describe(LibraryBatchEditOutcome<LibraryBatchEditPreview> outcome) => outcome.Status switch
    {
        LibraryBatchEditOutcomeStatus.Forbidden => "You can't edit these items together.",
        LibraryBatchEditOutcomeStatus.Invalid => outcome.Message ?? "These items can't be edited together.",
        _ => "Couldn't load the fields. Close this and try again.",
    };

    private static string Describe(LibraryBatchEditOutcome<LibraryBatchEditResult> outcome) => outcome.Status switch
    {
        LibraryBatchEditOutcomeStatus.Forbidden => "You can't edit these items together. Nothing was changed.",
        LibraryBatchEditOutcomeStatus.Invalid => outcome.Message ?? "The Engine did not accept these changes. Nothing was changed.",
        _ => "Couldn't reach the Engine. Nothing was changed; try Apply again.",
    };

    private Task ApplyFromButtonAsync() => ApplyAsync(fromSaveOrDiscard: false);

    // The page's "Save or discard?" answered Save: it means Apply.
    async Task<bool> IEditingSectionHost.SaveAsync() => await ApplyAsync(fromSaveOrDiscard: true);

    Task IEditingSectionHost.DiscardAsync()
    {
        Draft.Reset();
        Mode.SetSectionDirty(false);
        return Task.CompletedTask;
    }

    /// <summary>Sends the touched fields once for every ticked row. Returns true when nothing unsaved is left (a failed call keeps the input).</summary>
    private async Task<bool> ApplyAsync(bool fromSaveOrDiscard)
    {
        if (_applying)
        {
            return false;
        }

        if (!Draft.HasTouched)
        {
            return true;
        }

        if (Selection.Count == 0 || EditorDeviceRule.TryRefuse(Device, Toasts))
        {
            return false;
        }

        _applying = true;
        _error = null;
        Mode.SetSectionSaving(true);
        await InvokeAsync(StateHasChanged);
        try
        {
            var rows = Selection.Rows.ToList();
            var outcome = await ApiClient.ApplyLibraryBatchEditAsync(new LibraryBatchEditRequest
            {
                EntityIds = [.. rows.Select(row => row.Id)],
                FieldChanges = Draft.ToChanges(),
            });
            if (!outcome.IsOk)
            {
                _error = Describe(outcome);
                return false;
            }

            var view = DetailBatchText.Result(outcome.Value!, rows);
            Selection.SetResult(view);
            if (fromSaveOrDiscard)
            {
                // The section closes right after this Save, so the line is also said in a toast.
                Toasts.Add(view.Line, view.HasProblems ? AppSeverity.Warning : AppSeverity.Success);
            }

            Draft.Reset();
            Mode.SetSectionDirty(false);
            await RefreshPageAsync();
            await LoadAsync();
            return true;
        }
        finally
        {
            _applying = false;
            Mode.SetSectionSaving(false);
            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    // The page behind the rows shows what changed. A failed refresh never undoes the apply.
    private async Task RefreshPageAsync()
    {
        if (Selection.RefreshAsync is not { } refresh)
        {
            return;
        }

        try
        {
            await refresh();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The detail page could not refresh after a batch edit");
            Toasts.Add("Changes applied, but the page could not refresh. Reload to see them.", AppSeverity.Warning);
        }
    }

    private async Task CloseAsync() => await Mode.CloseSectionAsync();

    private void DraftChanged() => Mode.SetSectionDirty(Draft.HasTouched);

    private string CurrentText(LibraryBatchFieldState field)
    {
        if (field.IsMixed)
        {
            var hint = DetailBatchText.DistinctHint(field);
            return string.IsNullOrEmpty(hint) ? DetailBatchText.Mixed : $"{DetailBatchText.Mixed}: {hint}";
        }

        var shared = string.Equals(field.Kind, LibraryBatchFieldKinds.List, StringComparison.Ordinal)
            ? string.Join(", ", field.Values)
            : field.Value;
        return string.IsNullOrWhiteSpace(shared) ? "Empty on every item" : $"Same on every item: {shared}";
    }

    private string LockedText(LibraryBatchFieldState field)
    {
        var reason = field.LockedItems.Select(item => item.Reason).FirstOrDefault(text => !string.IsNullOrWhiteSpace(text));
        return string.IsNullOrWhiteSpace(reason) ? "This can't be changed here." : reason;
    }

    private string PartlyLockedText(LibraryBatchFieldState field)
    {
        var names = field.LockedItems
            .Select(item => (Title: Selection.Rows.FirstOrDefault(row => row.Id == item.EntityId)?.Title ?? "An item", item.Reason))
            .Take(3)
            .Select(item => $"{item.Title} ({item.Reason.TrimEnd('.')})");
        var more = field.LockedItems.Count - 3;
        var tail = more > 0 ? $", and {more} more" : string.Empty;
        return $"{field.LockedItems.Count} of {Selection.Count} can't take this change: {string.Join(", ", names)}{tail}. They are sent to Needs Review.";
    }

    private string UnavailableText(LibraryBatchEditPreview preview)
    {
        var names = preview.UnavailableItems
            .Select(item => (Title: Selection.Rows.FirstOrDefault(row => row.Id == item.EntityId)?.Title ?? "An item", item.Reason))
            .Take(3)
            .Select(item => $"{item.Title} ({item.Reason.TrimEnd('.')})");
        var more = preview.UnavailableItems.Count - 3;
        var tail = more > 0 ? $", and {more} more" : string.Empty;
        return $"{preview.UnavailableItems.Count} selected can't be edited and will be skipped: {string.Join(", ", names)}{tail}.";
    }

    private static string OperationLabel(string operation) => operation switch
    {
        LibraryBatchEditOps.Add => "Add",
        LibraryBatchEditOps.Replace => "Replace",
        LibraryBatchEditOps.Remove => "Remove",
        _ => operation,
    };

    private static string OperationHelp(string operation) => operation switch
    {
        LibraryBatchEditOps.Add => "Adds these to what each item already has.",
        LibraryBatchEditOps.Replace => "Each item gets exactly these.",
        LibraryBatchEditOps.Remove => "Takes these away from each item.",
        _ => string.Empty,
    };

    private static readonly Func<string?, CancellationToken, Task<IEnumerable<string>>> NoSuggestions =
        (_, _) => Task.FromResult<IEnumerable<string>>([]);

    private RenderFragment FieldRow(LibraryBatchFieldState field) => @<div class="tl-batch-field" data-field="@field.Key" role="group" aria-label="@field.Label">
        <div class="tl-batch-field__head">
            <span class="tl-batch-field__label">@field.Label</span>
            @if (field.Operations.Count > 0)
            {
                var touched = Draft.For(field).IsTouched;
                <span class="@(touched ? "tl-batch-field__state is-changing" : "tl-batch-field__state")">@(touched ? "Will change" : DetailBatchText.NoChange)</span>
            }
        </div>
        <p class="@(field.IsMixed ? "tl-batch-field__current is-mixed" : "tl-batch-field__current")">@CurrentText(field)</p>
        @if (field.Operations.Count == 0)
        {
            <p class="tl-batch-field__locked">@LockedText(field)</p>
        }
        else
        {
            var draft = Draft.For(field);
            @if (!field.Editable && field.LockedItems.Count > 0)
            {
                <p class="tl-batch-field__locked">@PartlyLockedText(field)</p>
            }

            @if (draft.IsList)
            {
                <div class="tl-batch-field__control">
                    @if (field.Operations.Count > 1)
                    {
                        <AppSegmentedControl Options="@field.Operations.Select(operation => new AppSelectOption(operation, OperationLabel(operation))).ToList()"
                                             Value="@draft.ListOperation"
                                             ValueChanged="@(operation => { draft.SetListOperation(operation); DraftChanged(); })"
                                             AriaLabel="@($"How to change {field.Label}")" />
                        <span class="tl-batch-field__help">@OperationHelp(draft.ListOperation)</span>
                    }

                    <AppTagInput Commit="@(value => AddValue(draft, value))" Search="@NoSuggestions" />
                    @if (draft.Values.Count > 0)
                    {
                        <div class="tl-batch-field__chips" aria-label="@($"{field.Label} to {OperationLabel(draft.ListOperation).ToLowerInvariant()}")">
                            @foreach (var value in draft.Values)
                            {
                                var current = value;
                                <AppChip Text="@current" OnClose="@(() => RemoveValue(draft, current))" />
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="tl-batch-field__control tl-batch-field__control--scalar">
                    <AppTextField Label="@field.Label"
                                  HideLabel="true"
                                  Value="@draft.Text"
                                  ValueChanged="@(text => SetText(draft, text))"
                                  Placeholder="@(draft.Clear ? "Will be cleared" : DetailBatchText.NoChange)"
                                  Disabled="@draft.Clear" />
                    @if (draft.CanClear)
                    {
                        <AppButton Label="@(draft.Clear ? "Keep values" : "Clear")"
                                   ButtonStyle="AppButtonStyle.Text"
                                   OnClick="@(() => ToggleClear(draft))" />
                    }
                </div>
            }
        }
    </div>;

    private Task<bool> AddValue(DetailBatchFieldDraft draft, string value)
    {
        var added = draft.AddValue(value);
        DraftChanged();
        return Task.FromResult(added);
    }

    private void RemoveValue(DetailBatchFieldDraft draft, string value)
    {
        draft.RemoveValue(value);
        DraftChanged();
    }

    private void SetText(DetailBatchFieldDraft draft, string? text)
    {
        draft.SetText(text);
        DraftChanged();
    }

    private void ToggleClear(DetailBatchFieldDraft draft)
    {
        draft.SetClear(!draft.Clear);
        DraftChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        _loadVersion++;
        if (_selection is not null)
        {
            _selection.Changed -= OnSelectionChanged;
        }

        if (_mode is not null && ReferenceEquals(_mode.SectionHost, this))
        {
            _mode.SectionHost = null;
        }
    }
}
