@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Navigation
@using Microsoft.AspNetCore.WebUtilities
@inject IEngineApiClient ApiClient
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@PageTitleText</PageTitle>

@if (_detail is not null)
{
    var version = _detailVersion;
    @* While the next item loads, the previous page stays on screen but dimmed and inert, so the wrong
       item's actions can never be used; DetailPage is re-created (via @key) only when the new payload lands. *@
    <div class="@ShellClass" inert="@_loading" aria-busy="@(_loading ? "true" : null)">
        <DetailPage @key="_detailVersion"
                    Model="_detail"
                    ActiveTab="@_activeTab"
                    ActiveTabChanged="HandleTabChangedAsync"
                    SelectedSeasonId="_selectedSeasonId"
                    SelectedSeasonChanged="HandleSeasonSelectedAsync"
                    ModelRefreshed="@(refreshed => HandleModelRefreshed(version, refreshed))"
                    OnActionSelected="HandleActionAsync" />
    </div>

    @if (_loading)
    {
        <div class="tl-detail-route-progress" role="status" aria-live="polite">
            <span class="tl-detail-route-progress__label">Loading details</span>
            <span class="tl-detail-route-progress__bar" aria-hidden="true"></span>
        </div>
    }
}
else if (_loading)
{
    <div class="tl-detail-route-state">
        <DetailHeroSkeleton />
    </div>
}
else
{
    <div class="tl-detail-page tl-detail-route-state">
        @switch (_failure)
        {
            case DetailPageLoadFailure.NotAllowed:
                <AppPageState Kind="AppPageStateKind.Unavailable"
                              Title="You don't have access to this"
                              Message="Your account can't open this item. Ask a server administrator if you think this is wrong."
                              Class="tl-detail-route-state__content" />
                break;
            case DetailPageLoadFailure.Unreachable:
                <AppPageState Kind="AppPageStateKind.Error"
                              Title="Can't reach the Engine"
                              Message="The Engine didn't respond. Check that it's running, then try again."
                              Class="tl-detail-route-state__content">
                    <Actions>
                        <AppButton Label="Retry" OnClick="RetryAsync" />
                    </Actions>
                </AppPageState>
                break;
            default:
                <AppPageState Kind="AppPageStateKind.Unavailable"
                              Title="@Request.NotFoundTitle"
                              Message="@Request.NotFoundMessage"
                              Class="tl-detail-route-state__content" />
                break;
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public DetailRouteRequest Request { get; set; } =
        DetailRouteRequest.ForUnified(string.Empty, Guid.Empty, null);

    /// <summary>The details overlay this page is shown in; null when the host is rendered on its own.</summary>
    [CascadingParameter] public DetailsOverlayState? Overlay { get; set; }

    private DetailPageViewModel? _detail;
    private DetailPageLoadFailure _failure;
    private bool _loading = true;
    private string? _activeTab;
    // The tab and season the page address named when the current page was last (re)applied. The address carries
    // them (D19), so a request that differs from the loaded page only here is applied without asking the Engine.
    private string? _addressTab;
    private Guid? _addressSeasonId;
    private Guid? _selectedSeasonId;
    // Which Engine payload the page on screen (or in flight) is; see DetailRouteRequest.LoadKey.
    private string? _pageKey;
    private string? _requestKey;
    private int _loadVersion;
    private int _detailVersion;
    private CancellationTokenSource? _loadCts;

    private string ShellClass =>
        _loading ? "tl-detail-route-shell tl-detail-route-shell--loading" : "tl-detail-route-shell";

    // The previous item's title must not label the page while the next item loads.
    private string PageTitleText =>
        $"{(_loading ? null : _detail?.Title) ?? Request.PageTitleFallback} - {Request.ProductTitle}";

    protected override Task OnParametersSetAsync()
    {
        var showsRequestedPage = _pageKey is not null
            && (string.Equals(Request.LoadKey, _pageKey, StringComparison.Ordinal)
                || string.Equals(Request.LoadKey, _requestKey, StringComparison.Ordinal))
            && (_loading || _detail is not null);
        if (!showsRequestedPage)
            return LoadAsync();

        // Only the tab or the season changed (a pick written back into the address, or a link to another tab):
        // the page stays as it is.
        ApplyAddressState();
        return Task.CompletedTask;
    }

    private Task RetryAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var loadVersion = ++_loadVersion;

        // Navigating to another detail page supersedes the load still in flight; cancel it so the
        // Engine stops composing a payload nobody will see.
        CancelPendingLoad();
        var cts = _loadCts = new CancellationTokenSource();
        var ct = cts.Token;

        // The previous page (if any) stays visible, dimmed, until the new payload replaces it.
        _loading = true;
        Overlay?.SetTitle(null);
        _failure = DetailPageLoadFailure.None;
        _pageKey = _requestKey = Request.LoadKey;
        _addressTab = Request.RequestedTab;
        _addressSeasonId = Request.SelectedSeasonId;
        _selectedSeasonId = Request.SelectedSeasonId;
        _activeTab = Request.RequestedTab;

        if (Request.EntityType is not { } entityType)
        {
            _detail = null;
            _failure = DetailPageLoadFailure.NotFound;
            _loading = false;
            Overlay?.SetTitle(null);
            return;
        }

        var result = await ApiClient.LoadDetailPageAsync(
            entityType,
            Request.EntityId,
            Request.PresentationContext,
            containerId: Request.ContainerId,
            sequence: SequenceWindowQuery.Windowed,
            ct: ct);

        if (ct.IsCancellationRequested || loadVersion != _loadVersion)
            return;

        _detail = result.Detail;
        _failure = result.Detail is null && result.Failure == DetailPageLoadFailure.None
            ? DetailPageLoadFailure.NotFound
            : result.Failure;
        _detailVersion++;
        // A season opened by its own address answers with its show's page; later requests name the show.
        if (_detail is { EntityType: DetailEntityType.TvShow } && Guid.TryParse(_detail.Id, out var showId))
            _pageKey = Request.ShowLoadKey(showId);
        ApplyDetailTabRoute();
        _loading = false;
        Overlay?.SetTitle(_detail?.Title);
    }

    private void ApplyAddressState()
    {
        if (!string.Equals(Request.RequestedTab, _addressTab, StringComparison.Ordinal))
        {
            _addressTab = Request.RequestedTab;
            _activeTab = Request.RequestedTab;
            ApplyDetailTabRoute();
        }

        if (Request.SelectedSeasonId != _addressSeasonId)
        {
            _addressSeasonId = Request.SelectedSeasonId;
            _selectedSeasonId = Request.SelectedSeasonId;
        }
    }

    private void CancelPendingLoad()
    {
        var cts = _loadCts;
        _loadCts = null;
        if (cts is null)
            return;

        cts.Cancel();
        cts.Dispose();
    }

    public void Dispose() => CancelPendingLoad();

    private Task HandleActionAsync(DetailAction action)
    {
        if (!string.IsNullOrWhiteSpace(action.Route))
            Nav.NavigateTo(action.Route);

        return Task.CompletedTask;
    }

    private Task HandleTabChangedAsync(string tab)
    {
        _activeTab = tab;
        ReplaceAddress(tab, season: null);
        return Task.CompletedTask;
    }

    private Task HandleSeasonSelectedAsync(Guid seasonId)
    {
        if (_selectedSeasonId == seasonId)
            return Task.CompletedTask;

        _selectedSeasonId = seasonId;
        // Only a show's page opens on a season; an episode's page keeps its own address.
        if (_detail is { EntityType: DetailEntityType.TvShow })
            ReplaceAddress(tab: null, season: seasonId);

        return Task.CompletedTask;
    }

    // A personal action refreshed the page inside DetailPage; keep that payload so a later re-render of this host
    // does not hand the stale one back.
    // The callback is bound to the page version it was rendered for, so a refresh that lands after the person moved
    // to another item (or while the next one loads) is ignored instead of replacing the newer page.
    private void HandleModelRefreshed(int version, DetailPageViewModel refreshed)
    {
        if (version != _detailVersion || _loading)
            return;

        _detail = refreshed;
        Overlay?.SetTitle(refreshed.Title);
    }

    /// <summary>
    /// Writes the chosen tab or season into the page address by replacing the current history entry, so reload
    /// returns to it and Back does not gain a step (D19). Other query values (context, episode) are kept.
    /// </summary>
    private void ReplaceAddress(string? tab, Guid? season)
    {
        var current = new Uri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(current.Query);
        var path = current.GetLeftPart(UriPartial.Path);

        if (tab is not null)
            query["tab"] = tab;

        if (season is { } seasonId)
        {
            query["season"] = seasonId.ToString("D");
            // The show's own address (a season opened by /details/tvseason/{id} moves to it).
            if (_detail is { } show)
                path = Nav.ToAbsoluteUri($"details/tvshow/{show.Id}").GetLeftPart(UriPartial.Path);
        }

        var target = QueryHelpers.AddQueryString(path, query);
        if (string.Equals(target, Nav.Uri, StringComparison.Ordinal))
            return;

        // In the overlay the entry is replaced with its underlay kept, so Back and Forward still restore it.
        DetailsOverlayNavigation.ReplaceAddress(Nav, Overlay, target);
    }

    private void ApplyDetailTabRoute()
    {
        if (_detail is null)
            return;

        var resolution = DetailTabNavigation.Resolve(_detail, _activeTab);
        _activeTab = resolution.ActiveTab;
    }
}
