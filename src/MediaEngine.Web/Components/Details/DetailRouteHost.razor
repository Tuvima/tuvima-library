@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@PageTitleText</PageTitle>

@if (_detail is not null)
{
    @* While the next item loads, the previous page stays on screen but dimmed and inert, so the wrong
       item's actions can never be used; DetailPage is re-created (via @key) only when the new payload lands. *@
    <div class="@ShellClass" inert="@_loading" aria-busy="@(_loading ? "true" : null)">
        <DetailPage @key="_detailVersion"
                    Model="_detail"
                    ActiveTab="@_activeTab"
                    ActiveTabChanged="HandleTabChangedAsync"
                    OnActionSelected="HandleActionAsync" />
    </div>

    @if (_loading)
    {
        <div class="tl-detail-route-progress" role="status" aria-live="polite">
            <span class="tl-detail-route-progress__label">Loading details</span>
            <span class="tl-detail-route-progress__bar" aria-hidden="true"></span>
        </div>
    }
}
else if (_loading)
{
    <div class="tl-detail-route-state">
        <DetailHeroSkeleton />
    </div>
}
else
{
    <div class="tl-detail-page tl-detail-route-state">
        @switch (_failure)
        {
            case DetailPageLoadFailure.NotAllowed:
                <AppPageState Kind="AppPageStateKind.Unavailable"
                              Title="You don't have access to this"
                              Message="Your account can't open this item. Ask a server administrator if you think this is wrong."
                              Class="tl-detail-route-state__content" />
                break;
            case DetailPageLoadFailure.Unreachable:
                <AppPageState Kind="AppPageStateKind.Error"
                              Title="Can't reach the Engine"
                              Message="The Engine didn't respond. Check that it's running, then try again."
                              Class="tl-detail-route-state__content">
                    <Actions>
                        <AppButton Label="Retry" OnClick="RetryAsync" />
                    </Actions>
                </AppPageState>
                break;
            default:
                <AppPageState Kind="AppPageStateKind.Unavailable"
                              Title="@Request.NotFoundTitle"
                              Message="@Request.NotFoundMessage"
                              Class="tl-detail-route-state__content" />
                break;
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public DetailRouteRequest Request { get; set; } =
        DetailRouteRequest.ForUnified(string.Empty, Guid.Empty, null);

    private DetailPageViewModel? _detail;
    private DetailPageLoadFailure _failure;
    private bool _loading = true;
    private string? _activeTab;
    private int _loadVersion;
    private int _detailVersion;
    private CancellationTokenSource? _loadCts;

    private string ShellClass =>
        _loading ? "tl-detail-route-shell tl-detail-route-shell--loading" : "tl-detail-route-shell";

    // The previous item's title must not label the page while the next item loads.
    private string PageTitleText =>
        $"{(_loading ? null : _detail?.Title) ?? Request.PageTitleFallback} - {Request.ProductTitle}";

    protected override Task OnParametersSetAsync() => LoadAsync();

    private Task RetryAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var loadVersion = ++_loadVersion;

        // Navigating to another detail page supersedes the load still in flight; cancel it so the
        // Engine stops composing a payload nobody will see.
        CancelPendingLoad();
        var cts = _loadCts = new CancellationTokenSource();
        var ct = cts.Token;

        // The previous page (if any) stays visible, dimmed, until the new payload replaces it.
        _loading = true;
        _failure = DetailPageLoadFailure.None;

        if (Request.EntityType is not { } entityType)
        {
            _detail = null;
            _failure = DetailPageLoadFailure.NotFound;
            _loading = false;
            return;
        }

        var result = await ApiClient.LoadDetailPageAsync(
            entityType,
            Request.EntityId,
            Request.PresentationContext,
            containerId: Request.ContainerId,
            sequence: SequenceWindowQuery.Windowed,
            ct: ct);

        if (ct.IsCancellationRequested || loadVersion != _loadVersion)
            return;

        _detail = result.Detail;
        _failure = result.Detail is null && result.Failure == DetailPageLoadFailure.None
            ? DetailPageLoadFailure.NotFound
            : result.Failure;
        _detailVersion++;
        ApplyDetailTabRoute();
        _loading = false;
    }

    private void CancelPendingLoad()
    {
        var cts = _loadCts;
        _loadCts = null;
        if (cts is null)
            return;

        cts.Cancel();
        cts.Dispose();
    }

    public void Dispose() => CancelPendingLoad();

    private Task HandleActionAsync(DetailAction action)
    {
        if (!string.IsNullOrWhiteSpace(action.Route))
            Nav.NavigateTo(action.Route);

        return Task.CompletedTask;
    }

    private Task HandleTabChangedAsync(string tab)
    {
        _activeTab = tab;
        return Task.CompletedTask;
    }

    private void ApplyDetailTabRoute()
    {
        if (_detail is null)
            return;

        var resolution = DetailTabNavigation.Resolve(_detail, _activeTab);
        _activeTab = resolution.ActiveTab;
    }
}
