@namespace MediaEngine.Web.Components.Details
@using System.Globalization
@using MediaEngine.Contracts.Details
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Playback
@using Microsoft.AspNetCore.Components.Web
@using MediaEngine.Web.Services.Theming
@inject PlaybackSessionController Playback
@inject DeviceContextService DeviceContext
@implements IDisposable
@inject IStringLocalizer<SharedStrings> L

@* The audiobook chapter list (spec music-table-and-reader-frame keeps it out of the shared song table). An album's tracks are drawn by
   MusicTrackList on the one SongTable. *@
@if (Items.Count > 0)
{
    @if (DeviceContext.IsPhone)
    {
        <section class="tl-audio-item-cards tl-audio-item-cards--audiobook" aria-label="@($"{SourceTitle} {ItemNounPlural}")">
            @if (CompactToolbarLeadingContent is not null)
            {
                <header class="tl-audio-item-cards__toolbar">
                    <div class="tl-audio-item-cards__leading">@CompactToolbarLeadingContent</div>
                </header>
            }

            <AppTable CardsOn="AppTableCardsMode.Phone" Hover="true" Class="tl-audio-item-cards__table">
                <caption class="sr-only">@SourceTitle @ItemNounPlural</caption>
                <thead>
                    <tr>
                        <th data-card-role="title">@L["Common_Title"]</th>
                        <th data-card-role="subtitle">@L["Common_Progress"]</th>
                        <th data-card-role="value">@L["AudioItemTable_Duration"]</th>
                        <th data-card-role="actions"><span class="sr-only">@L["ApiKeys_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < VisibleItems.Count; index++)
                    {
                        var item = VisibleItems[index];
                        var isPlaying = IsCurrentItem(item);
                        @if (StartsUnnumberedGroup(VisibleItems, index))
                        {
                            <tr class="tl-audio-item-table__group-row" data-card-role="hidden"><th colspan="4" scope="colgroup">@L["AudioItemTable_Unnumbered"]</th></tr>
                        }
                        <tr @key="item.Id"
                            class="@RowClass(item, isPlaying)"
                            data-audio-row="true"
                            data-work-id="@item.Id"
                            tabindex="@(item.IsOwned ? 0 : -1)"
                            @onclick="@(() => PlayItemAsync(item))"
                            @onkeydown="@((args) => HandleCardKeyDownAsync(args, item))">
                            <td data-card-role="title">
                                @(item.IsUnmatched ? string.Empty : $"{DisplayOrdinal(item, index)}. ")@item.Title
                                @if (item.IsUnmatched)
                                {
                                    <NotMatchedTag />
                                }
                            </td>
                            <td data-card-role="subtitle">@CardSubtitle(item)</td>
                            <td data-card-role="value">@DisplayDuration(item)</td>
                            <td data-card-role="actions" class="tl-audio-item-cards__actions" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                <span @onclick:stopPropagation="true">
                                    <AppIconButton Icon="@AppMaterialIcons.Filled.PlayArrow" ButtonStyle="AppButtonStyle.Text" AriaLabel="@($"Play {item.Title}")" Tooltip="@L["Common_Play"].Value" OnClick="@(() => PlayItemAsync(item))" />
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </AppTable>

            @if (VisibleItems.Count == 0)
            {
                <div class="tl-detail-track-empty">@L["AudioItemTable_NoMatchTheCurrentView", ItemNounPlural]</div>
            }
        </section>
    }
    else
    {
        <section class="tl-embedded-audio tl-embedded-audio--audiobook" aria-label="@($"{SourceTitle} {ItemNounPlural}")">
            <BulkSelectionBar />
            @if (CompactToolbarLeadingContent is not null)
            {
                <header class="tl-embedded-audio__toolbar">
                    <div class="tl-embedded-audio__toolbar-leading">
                        @CompactToolbarLeadingContent
                    </div>
                </header>
            }

            <div class="tl-embedded-audio__scroller">
                <div class="tl-embedded-audio__table" role="table" aria-label="@($"{SourceTitle} {ItemNounPlural}")">
                    @for (var index = 0; index < VisibleItems.Count; index++)
                    {
                        var item = VisibleItems[index];
                        var isPlaying = IsCurrentItem(item);
                        @if (StartsUnnumberedGroup(VisibleItems, index))
                        {
                            <div class="tl-audio-item-table__group-heading" role="row"><span role="columnheader">@L["AudioItemTable_Unnumbered"]</span></div>
                        }
                        <div class="@CompactRowClass(item, isPlaying)"
                             role="row"
                             data-work-id="@item.Id"
                             data-asset-id="@item.AssetId">
                            <div class="tl-embedded-audio__play-cell" role="cell">
                                @if (isPlaying)
                                {
                                    <span class="tl-embedded-audio__playing" aria-label="@L["AudioItemTable_CurrentlyPlaying"].Value">
                                        <AppMaterialIcon Icon="@AppMaterialIcons.Filled.GraphicEq" Size="AppIconSize.Control20" />
                                    </span>
                                }
                                else if (item.IsOwned)
                                {
                                    <AppNativeButton Type="button"
                                                     Class="tl-embedded-audio__row-play"
                                                     AriaLabel="@($"Play {item.Title}")"
                                                     StopPropagation="true"
                                                     OnClick="@(() => PlayItemAsync(item))">
                                        <AppMaterialIcon Icon="@AppMaterialIcons.Filled.PlayArrow" Size="AppIconSize.Control20" />
                                    </AppNativeButton>
                                }
                            </div>
                            <div class="tl-embedded-audio__ordinal" role="cell">@DisplayOrdinal(item, index)</div>
                            <div class="tl-embedded-audio__title" role="cell">
                                <DetailRowSelectBox ItemId="@ItemId(item)" Title="@item.Title" Kind="@item.EntityType" ParentId="@RowParentId" MediaType="Audiobooks" />
                                <strong>@item.Title</strong>
                                @if (item.IsUnmatched)
                                {
                                    <NotMatchedTag />
                                }
                            </div>
                            <div class="tl-embedded-audio__duration" role="cell">@DisplayDuration(item)</div>
                        </div>
                    }
                </div>
            </div>

            @if (VisibleItems.Count == 0)
            {
                <div class="tl-detail-track-empty">@L["AudioItemTable_NoMatchTheCurrentView", ItemNounPlural]</div>
            }
        </section>
    }
}

@code {
    [Parameter] public IReadOnlyList<MediaGroupingViewModel> Groups { get; set; } = [];
    [Parameter] public string SourceTitle { get; set; } = "Audio";
    [Parameter] public string? AuthorName { get; set; }
    [Parameter] public string? NarratorName { get; set; }
    [Parameter] public string? Synopsis { get; set; }
    [Parameter] public IReadOnlyList<PlaybackContributorIdentity> Authors { get; set; } = [];
    [Parameter] public IReadOnlyList<PlaybackContributorIdentity> Narrators { get; set; } = [];
    [Parameter] public string? AudiobookId { get; set; }
    [Parameter] public string? ArtworkUrl { get; set; }
    [Parameter] public RenderFragment? CompactToolbarLeadingContent { get; set; }

    private const string ItemNounPlural = "audiobook tracks";

    private IReadOnlyList<MediaGroupingItemViewModel> Items =>
        Groups.SelectMany(group => group.Items)
            .Where(item => item.EntityType == DetailEntityType.Audiobook)
            .ToList();

    private IReadOnlyList<MediaGroupingItemViewModel> VisibleItems => SortItems(Items);

    // What a ticked row knows about where it sits: its audiobook, so Renumber, Match and the move step work from it.
    private Guid? RowParentId => Guid.TryParse(AudiobookId, out var parent) ? parent : null;

    // Each row of a page the person may edit gets a tick box and a ticked row is highlighted. Null outside a detail page.
    [CascadingParameter] public BulkEditSelection? BatchSelection { get; set; }

    /// <summary>The page this list sits on (its Engine edit permission). Null outside a detail page.</summary>
    [CascadingParameter] public EditorBinding? Editor { get; set; }

    private BulkEditSelection? _hookedSelection;

    private void HookBatchState()
    {
        if (!ReferenceEquals(_hookedSelection, BatchSelection))
        {
            if (_hookedSelection is not null)
            {
                _hookedSelection.ListOrder = null;
                _hookedSelection.Changed -= OnBatchStateChanged;
            }

            _hookedSelection = BatchSelection;
            if (_hookedSelection is not null)
            {
                _hookedSelection.Changed += OnBatchStateChanged;
                // "Renumber sequentially" follows the order this list shows now.
                _hookedSelection.ListOrder = () => VisibleItems.Select(ItemId).ToList();
            }
        }
    }

    private void OnBatchStateChanged() => _ = InvokeAsync(StateHasChanged);

    private bool IsRowSelected(MediaGroupingItemViewModel item)
        => Editor is { CanEdit: true } && BatchSelection?.Contains(ItemId(item)) == true;

    public void Dispose()
    {
        if (_hookedSelection is not null)
        {
            _hookedSelection.ListOrder = null;
            _hookedSelection.Changed -= OnBatchStateChanged;
        }
    }

    protected override void OnParametersSet() => HookBatchState();

    private async Task PlayItemAsync(MediaGroupingItemViewModel item)
    {
        if (!item.IsOwned)
        {
            return;
        }

        var playable = VisibleItems.Where(row => row.IsOwned).ToList();
        if (playable.Count == 0)
        {
            return;
        }

        await Playback.PlayAudiobookAsync(ToQueueItem(item), SourceTitle);
    }

    private static string CardSubtitle(MediaGroupingItemViewModel item)
        => item.ProgressPercent.HasValue ? $"{Math.Round(item.ProgressPercent.Value)}% played" : string.Empty;

    private Task HandleCardKeyDownAsync(KeyboardEventArgs args, MediaGroupingItemViewModel item)
        => args.Key is "Enter" or " " ? PlayItemAsync(item) : Task.CompletedTask;

    private ListenQueueItem ToQueueItem(MediaGroupingItemViewModel item)
        => new()
        {
            WorkId = ItemId(item),
            AudiobookWorkId = Guid.TryParse(AudiobookId, out var audiobookId) ? audiobookId : null,
            AssetId = Guid.TryParse(item.AssetId, out var assetId) ? assetId : null,
            MediaType = "Audiobooks",
            Title = SourceTitle,
            Subtitle = item.Title,
            Album = SourceTitle,
            AuthorName = AuthorName,
            NarratorName = NarratorName,
            Synopsis = Synopsis,
            Authors = Authors,
            Narrators = Narrators,
            CoverUrl = PlaybackArtworkUrl.AudiobookCover(Guid.TryParse(AudiobookId, out var coverBookId) ? coverBookId : null, ArtworkUrl ?? item.ArtworkUrl),
            Duration = DisplayDuration(item),
            InitialPositionSeconds = ResumePositionFor(item),
            Chapters = VisibleItems.Select(ToPlaybackChapter).ToList(),
            ChapterIndex = item.ChapterIndex,
        };

    private static PlaybackChapterDto ToPlaybackChapter(MediaGroupingItemViewModel item)
        => new()
        {
            AssetId = Guid.TryParse(item.AssetId, out var assetId) ? assetId : null,
            Index = Math.Max(0, item.ChapterIndex ?? 0),
            Title = string.IsNullOrWhiteSpace(item.Title)
                ? $"Track {Math.Max(1, (item.ChapterIndex ?? 0) + 1)}"
                : item.Title.Trim(),
            StartSeconds = Math.Max(0, item.StartSeconds ?? 0),
            EndSeconds = item.EndSeconds,
        };

    // Shared with the album track list: both start a track from where it was left.
    internal static double? ResumePositionFor(MediaGroupingItemViewModel item)
    {
        if (item.ResumePositionSeconds is > 0)
        {
            return item.ResumePositionSeconds;
        }

        if (item.ProgressPercent is > 0 and < 100)
        {
            var start = Math.Max(0, item.StartSeconds ?? 0);
            if (item.EndSeconds is > 0 && item.EndSeconds.Value > start)
            {
                return start + (item.EndSeconds.Value - start) * Math.Clamp(item.ProgressPercent.Value, 0, 100) / 100d;
            }
        }

        return item.StartSeconds;
    }

    private bool IsCurrentItem(MediaGroupingItemViewModel item)
    {
        var itemId = ItemId(item);
        var currentItem = Playback.CurrentItem;
        if (!Playback.IsPlaying || itemId == Guid.Empty || currentItem?.WorkId != itemId)
        {
            return false;
        }

        if (Guid.TryParse(item.AssetId, out var assetId)
            && currentItem.AssetId.HasValue
            && currentItem.AssetId.Value != assetId)
        {
            return false;
        }

        if (!item.StartSeconds.HasValue)
        {
            return true;
        }

        var start = item.StartSeconds.Value;
        var current = Playback.CurrentTimeSeconds;
        var selectedStart = currentItem.InitialPositionSeconds;
        if (current < start && selectedStart.HasValue && Math.Abs(selectedStart.Value - start) < 0.5d)
        {
            return true;
        }

        if (current < start - 0.5d)
        {
            return false;
        }

        return !item.EndSeconds.HasValue || current < item.EndSeconds.Value - 0.5d;
    }

    // Items added anyway have no number: they always sit in an Unnumbered group at the end (details overlay D13).
    private static IReadOnlyList<MediaGroupingItemViewModel> SortItems(IEnumerable<MediaGroupingItemViewModel> items)
    {
        var all = items.ToList();
        return
        [
            .. all.Where(item => !item.IsUnmatched).OrderBy(ItemSortKey).ThenBy(item => item.Title, StringComparer.OrdinalIgnoreCase),
            .. all.Where(item => item.IsUnmatched).OrderBy(item => item.Title, StringComparer.OrdinalIgnoreCase),
        ];
    }

    private static bool StartsUnnumberedGroup(IReadOnlyList<MediaGroupingItemViewModel> list, int index) =>
        list[index].IsUnmatched && (index == 0 || !list[index - 1].IsUnmatched);

    private static string DisplayDuration(MediaGroupingItemViewModel item)
    {
        if (item.DurationSeconds is > 0)
        {
            return FormatSeconds(item.DurationSeconds.Value);
        }

        if (TryParseDurationSeconds(item.Duration, out var seconds))
        {
            return FormatSeconds(seconds);
        }

        return DisplayOrDash(item.Duration);
    }

    private string RowClass(MediaGroupingItemViewModel item, bool isPlaying)
        => $"tl-detail-track-row{(isPlaying ? " is-playing" : string.Empty)}{(IsRowSelected(item) ? " is-selected" : string.Empty)}";

    private string CompactRowClass(MediaGroupingItemViewModel item, bool isPlaying)
        => $"tl-embedded-audio__row{(isPlaying ? " is-playing" : string.Empty)}{(IsRowSelected(item) ? " is-selected" : string.Empty)}";

    private static Guid ItemId(MediaGroupingItemViewModel item)
        => Guid.TryParse(item.Id, out var id) ? id : Guid.Empty;

    private static int ItemSortKey(MediaGroupingItemViewModel item)
        => int.TryParse(item.TrackNumber, out var parsed) ? parsed : item.ChapterIndex ?? int.MaxValue;

    private static string DisplayOrdinal(MediaGroupingItemViewModel item, int index)
        => item.IsUnmatched
            ? "–"
            : string.IsNullOrWhiteSpace(item.TrackNumber) ? (index + 1).ToString(CultureInfo.InvariantCulture) : item.TrackNumber;

    private static string FormatSeconds(double seconds)
    {
        var span = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return span.TotalHours >= 1
            ? $"{(int)span.TotalHours}:{span.Minutes:00}:{span.Seconds:00}"
            : $"{span.Minutes}:{span.Seconds:00}";
    }

    private static bool TryParseDurationSeconds(string? value, out double seconds)
    {
        seconds = 0;
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var parts = value.Trim().Split(':', StringSplitOptions.TrimEntries);
        if (parts.Length == 2
            && double.TryParse(parts[0], NumberStyles.Float, CultureInfo.InvariantCulture, out var minutes)
            && double.TryParse(parts[1], NumberStyles.Float, CultureInfo.InvariantCulture, out var remainingSeconds))
        {
            seconds = minutes * 60d + remainingSeconds;
            return seconds > 0;
        }

        if (parts.Length == 3
            && double.TryParse(parts[0], NumberStyles.Float, CultureInfo.InvariantCulture, out var hours)
            && double.TryParse(parts[1], NumberStyles.Float, CultureInfo.InvariantCulture, out minutes)
            && double.TryParse(parts[2], NumberStyles.Float, CultureInfo.InvariantCulture, out remainingSeconds))
        {
            seconds = hours * 3600d + minutes * 60d + remainingSeconds;
            return seconds > 0;
        }

        if (TimeSpan.TryParse(value, CultureInfo.InvariantCulture, out var span))
        {
            seconds = span.TotalSeconds;
            return seconds > 0;
        }

        if (double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var numeric))
        {
            seconds = numeric >= 60000 ? numeric / 1000d : numeric;
            return seconds > 0;
        }

        return false;
    }

    private static string DisplayOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
