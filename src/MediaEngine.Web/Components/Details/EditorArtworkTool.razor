@namespace MediaEngine.Web.Components.Details
@using System.Globalization
@using MediaEngine.Contracts.Artwork
@using MediaEngine.Web.Components.Artwork
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Formatting
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject IAppDialogService Dialogs
@inject IStringLocalizer<SharedStrings> L

@* The Artwork tool of the pop-over editor (universal editor v4, section 3b), drawn inside its window.
   Role cards across the top (Poster, Background, Logo, ... with Preferred and the number of versions), a large zoomable preview at the
   role's real shape with file facts and actions beside it, and a versions strip below. Clicking a version makes it Preferred and moves it
   to the front (D19). "Add artwork" opens Provider, Upload or Link in place of the preview, with Language and Size filters.
   Everything waits for Save changes except Delete, which asks first and happens at once. *@
@if (Picker is { ActiveSlot: { } slot } picker)
{
    var tabs = picker.Tabs;
    var preferred = picker.PreferredVersion(slot);
    var label = ArtworkPickerRules.LabelFor(slot, CoverLabel(picker));
    <section class="tl-art-picker"
             role="region"
             aria-label="@L["EditorArtworkTool_Artwork"].Value">
        <div class="tl-art-picker__body">
            @RoleCards(picker, tabs, slot)

            @if (picker.CanFetchAllStills)
            {
                @* Pulls the provider's still for every episode under this item and stages them all for Review. *@
                <div class="tl-art-picker__fetch">
                    <AppButton ButtonStyle="AppButtonStyle.Outlined"
                               Tone="AppUiTone.Neutral"
                               StartIcon="@AppMaterialIcons.Outlined.Image"
                               Class="tl-art-picker__fetch-all"
                               Disabled="@picker.Busy"
                               OnClick="@(() => picker.FetchAllStillsAsync())">
                        @L["EditorArtworkTool_FetchAllStills"]
                    </AppButton>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(picker.Message))
            {
                <AppAlert Severity="AppSeverity.Warning" Dense="true" Class="tl-art-picker__message">@picker.Message</AppAlert>
            }

            @if (_adding)
            {
                @AddPanel(picker, slot, label)
            }
            else
            {
                <div class="tl-art-picker__main">
                    @Preview(picker, slot, preferred, label)
                    @Side(picker, slot, preferred, label)
                </div>
                @Strip(picker, slot, label)
            }
        </div>
    </section>
}

@code {
    private const string SourceProviders = "providers";
    private const string SourceUpload = "upload";
    private const string SourceLink = "link";

    private static readonly double[] ZoomSteps = [1, 1.5, 2, 3];

    private static readonly IReadOnlyList<AppSelectOption> Sources =
    [
        new(SourceProviders, "Provider", AppMaterialIcons.Outlined.Search),
        new(SourceUpload, "Upload", AppMaterialIcons.Outlined.CloudUpload),
        new(SourceLink, "Link", AppMaterialIcons.Outlined.Link),
    ];

    // People, series, curated collections and universes have no provider artwork to offer, so Provider is left out for them.
    private static readonly IReadOnlyList<AppSelectOption> SourcesWithoutProviders = Sources.Where(option => option.Value != SourceProviders).ToList();

    private static readonly IReadOnlyList<AppSelectOption> SizeOptions =
    [
        new(ArtworkCandidateFilter.AnySize, "All sizes"),
        new(ArtworkCandidateFilter.LargeOnly, $"Large ({ArtworkCandidateFilter.LargeFromPixels} px or more)"),
        new(ArtworkCandidateFilter.MediumOnly, $"Medium ({ArtworkCandidateFilter.MediumFromPixels} to {ArtworkCandidateFilter.LargeFromPixels - 1} px)"),
    ];

    private bool _opened;
    private string? _lastRequestedSlot;
    private bool _adding;
    private bool _replacing;
    private bool _full;
    private int _zoomIndex;
    private bool _makePreferred = true;
    private string _source = SourceProviders;
    private string _address = string.Empty;
    private string _language = ArtworkCandidateFilter.All;
    private bool _languageSeeded;
    private string _size = ArtworkCandidateFilter.AnySize;
    private EditingModeContext? _subscribed;
    private ArtworkPickerSession? _subscribedPicker;

    [Parameter, EditorRequired] public EditingModeContext? Mode { get; set; }

    [Parameter, EditorRequired] public ArtworkPickerSession? Picker { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!ReferenceEquals(_subscribed, Mode))
        {
            if (_subscribed is not null)
            {
                _subscribed.Changed -= OnModeChanged;
            }

            _subscribed = Mode;
            if (_subscribed is not null)
            {
                _subscribed.Changed += OnModeChanged;
            }
        }

        if (!ReferenceEquals(_subscribedPicker, Picker))
        {
            if (_subscribedPicker is not null)
            {
                _subscribedPicker.Changed -= OnModeChanged;
            }

            _subscribedPicker = Picker;
            if (_subscribedPicker is not null)
            {
                _subscribedPicker.Changed += OnModeChanged;
            }
        }

        if (Picker is null)
        {
            return;
        }

        // The tool opens on the role it was asked for; a later request for another role moves the picker to that card.
        var requested = Mode?.OpenSectionArtworkSlot;
        if (!_opened)
        {
            _opened = true;
            _lastRequestedSlot = requested;
            await Picker.OpenAsync(requested);
        }
        else if (!string.Equals(requested, _lastRequestedSlot, StringComparison.OrdinalIgnoreCase))
        {
            _lastRequestedSlot = requested;
            if (requested is not null)
            {
                await Picker.OpenAsync(requested);
            }
        }
    }

    // -- Role cards -------------------------------------------------------------------------------------

    private RenderFragment RoleCards(ArtworkPickerSession picker, IReadOnlyList<ArtworkPickerTab> tabs, string active) => __builder =>
    {
        // A show has pictures at three levels (its own, its seasons', its episodes' stills): one row of cards per level.
        var groups = ArtworkPickerRules.GroupByLevel(tabs);
        <div class="tl-art-picker__levels" role="group" aria-label="@L["EditorArtworkTool_ArtworkToChange"].Value">
            @foreach (var group in groups)
            {
                <div class="tl-art-picker__level" data-level="@group.Level">
                    @if (groups.Count > 1)
                    {
                        <span class="tl-art-picker__level-name">@group.Level</span>
                    }
                    <div class="tl-art-picker__roles">
                        @foreach (var tab in group.Tabs)
                        {
                            var isActive = string.Equals(tab.Slot, active, StringComparison.OrdinalIgnoreCase);
                            var count = picker.VersionCount(tab.Slot);
                            var hasPicture = picker.PreferredVersion(tab.Slot) is not null;
                            var url = hasPicture ? picker.RolePictureUrl(tab.Slot) : null;
                            var shape = ShapeClass(tab.Slot, picker);
                            var staged = picker.IsSlotStaged(tab.Slot);
                            @ThumbButton(
                                "tl-art-picker__role",
                                $"tl-art-picker__face tl-art-picker__face--role{(isActive ? " is-active" : string.Empty)}",
                                $"{tab.Label}, {(hasPicture ? "Preferred chosen" : "No artwork")}, {VersionsText(count)}",
                                isActive,
                                picker.Busy,
                                () => SelectSlotAsync(tab.Slot),
                                @<text>
                                    <span class="@($"tl-art-picker__thumb tl-art-picker__thumb--{shape}")">
                                        @if (!string.IsNullOrWhiteSpace(url))
                                        {
                                            <img src="@MediaTileArtworkUrl.ForDrawnSize(url, 96)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(url, 96)" alt="" loading="lazy" decoding="async" />
                                        }
                                    </span>
                                    <span class="tl-art-picker__role-text">
                                        <strong>@tab.Label</strong>
                                        <span class="@(hasPicture ? "tl-art-picker__preferred" : "tl-art-picker__muted")">@(hasPicture ? "Preferred" : "No artwork")</span>
                                        <span class="tl-art-picker__muted">@VersionsText(count)@(staged ? " · Changed, not saved" : string.Empty)</span>
                                    </span>
                                </text>)
                        }
                    </div>
                </div>
            }
        </div>
    };

    // -- Preview, facts and actions ---------------------------------------------------------------------

    private RenderFragment Preview(ArtworkPickerSession picker, string slot, ArtworkPickerPicture? preferred, string label) => __builder =>
    {
        var shape = ShapeClass(slot, picker);
        var url = preferred is null ? null : picker.RolePictureUrl(slot) ?? preferred.ContentUrl;
        var zoom = ZoomSteps[_zoomIndex];
        var fit = shape is "landscape" or "wide" ? "width" : "height";
        <div class="@($"tl-art-picker__preview{(_full ? " is-full" : string.Empty)}")">
            <div class="tl-art-picker__tools" role="group" aria-label="Zoom">
                <AppIconButton Icon="@AppMaterialIcons.Outlined.Remove" Tooltip="Zoom out" Disabled="@(_zoomIndex == 0 || url is null)" OnClick="ZoomOut" />
                <span class="tl-art-picker__zoom" aria-live="polite">@((zoom * 100).ToString("0", CultureInfo.InvariantCulture))%</span>
                <AppIconButton Icon="@AppMaterialIcons.Outlined.Add" Tooltip="Zoom in" Disabled="@(_zoomIndex == ZoomSteps.Length - 1 || url is null)" OnClick="ZoomIn" />
                <AppIconButton Icon="@AppMaterialIcons.Outlined.Fullscreen" Tooltip="@(_full ? "Leave full screen" : "Full screen")" Disabled="@(url is null)" OnClick="ToggleFull" />
            </div>
            <div class="tl-art-picker__stage">
                @if (url is not null)
                {
                    <img class="@($"tl-art-picker__image tl-art-picker__image--{fit} is-zoom-{_zoomIndex}")"
                         src="@MediaTileArtworkUrl.ForDrawnSize(url, 1280)"
                         alt="@($"{label} preview")" />
                }
                else
                {
                    <span class="@($"tl-art-picker__empty tl-art-picker__thumb--{shape}")">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Image" />
                        <span>No artwork for this yet</span>
                    </span>
                }
            </div>
            <p class="tl-art-picker__reach">
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Info" />
                <span>@ArtworkPickerRules.ReachFor(slot, picker.MediaType, picker.SubjectKind)</span>
            </p>
        </div>
    };

    private RenderFragment Side(ArtworkPickerSession picker, string slot, ArtworkPickerPicture? preferred, string label) => __builder =>
    {
        <div class="tl-art-picker__side">
            <AppButton ButtonStyle="AppButtonStyle.Filled"
                       Tone="AppUiTone.Primary"
                       StartIcon="@AppMaterialIcons.Outlined.Add"
                       FullWidth="true"
                       Class="tl-art-picker__add"
                       Disabled="@picker.Busy"
                       OnClick="@(() => BeginAdd(replacing: false))">
                Add artwork
            </AppButton>
            <AppButton ButtonStyle="AppButtonStyle.Outlined"
                       Tone="AppUiTone.Neutral"
                       StartIcon="@AppMaterialIcons.Outlined.Refresh"
                       FullWidth="true"
                       Class="tl-art-picker__replace"
                       Disabled="@(picker.Busy || preferred is null)"
                       OnClick="@(() => BeginAdd(replacing: true))">
                Replace
            </AppButton>
            <AppButton ButtonStyle="AppButtonStyle.Outlined"
                       Tone="AppUiTone.Error"
                       StartIcon="@AppMaterialIcons.Outlined.Delete"
                       FullWidth="true"
                       Class="tl-art-picker__delete"
                       Disabled="@(picker.Busy || preferred is null)"
                       OnClick="@(() => DeleteAsync(preferred))">
                Delete this version
            </AppButton>
            @if (picker.IsStaged)
            {
                <AppButton ButtonStyle="AppButtonStyle.Text"
                           Tone="AppUiTone.Neutral"
                           FullWidth="true"
                           Class="tl-art-picker__undo"
                           Disabled="@picker.Busy"
                           OnClick="picker.UndoStaged">
                    @L["EditorArtworkTool_UndoThisChoice"]
                </AppButton>
            }

            <p class="tl-art-picker__status" role="status">@StatusText(picker)</p>

            @if (preferred is not null)
            {
                <dl class="tl-art-picker__facts" aria-label="File facts">
                    @Fact("File name", preferred.FileName)
                    @Fact("Source", preferred.Source)
                    @Fact("Dimensions", preferred.Width is > 0 && preferred.Height is > 0 ? $"{preferred.Width} × {preferred.Height}" : null)
                    @Fact("Shape", ShapeText(ArtworkPickerRules.ShapeFor(slot, picker.MediaType)))
                    @Fact("File size", preferred.FileSizeBytes is { } bytes ? DisplayFormat.FormatFileSize(bytes) : null)
                    @Fact("Type", TypeText(preferred.ContentType))
                </dl>
            }
        </div>
    };

    private static RenderFragment Fact(string name, string? value) => __builder =>
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            <dt>@name</dt>
            <dd>@value</dd>
        }
    };

    // -- Versions strip ---------------------------------------------------------------------------------

    private RenderFragment Strip(ArtworkPickerSession picker, string slot, string label) => __builder =>
    {
        var versions = picker.Versions(slot);
        var preferredId = picker.PreferredAssetId(slot);
        var shape = ShapeClass(slot, picker);
        <div class="@($"tl-art-picker__strip tl-art-picker__strip--{shape}")" role="group" aria-label="@($"{label} versions. Choose one to make it Preferred.")">
            @if (picker.SavedLoading && versions.Count == 0)
            {
                <AppPageState Kind="AppPageStateKind.Loading" Title="Loading saved pictures" />
            }

            @foreach (var version in versions)
            {
                var isPreferred = version.AssetId == preferredId;
                @ThumbButton(
                    "tl-art-picker__version",
                    $"tl-art-picker__face tl-art-picker__face--version tl-art-picker__thumb--{shape}{(isPreferred ? " is-preferred" : string.Empty)}",
                    $"{version.Caption}{(isPreferred ? ", Preferred" : string.Empty)}",
                    isPreferred,
                    picker.Busy,
                    () => { picker.MakePreferred(version); return Task.CompletedTask; },
                    @<text>
                        <img src="@MediaTileArtworkUrl.ForDrawnSize(version.ThumbnailUrl, 160)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(version.ThumbnailUrl, 160)" alt="" loading="lazy" decoding="async" />
                        @if (isPreferred)
                        {
                            <span class="tl-art-picker__chip">Preferred</span>
                        }
                    </text>)
            }

            @ThumbButton(
                "tl-art-picker__version tl-art-picker__add-version",
                $"tl-art-picker__face tl-art-picker__face--version tl-art-picker__face--add tl-art-picker__thumb--{shape}",
                "Add version",
                false,
                picker.Busy,
                () => { BeginAdd(replacing: false); return Task.CompletedTask; },
                @<text><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Add" /><span>Add version</span></text>)
        </div>
    };

    // -- Add artwork (Provider, Upload, Link) -------------------------------------------------------------

    private RenderFragment AddPanel(ArtworkPickerSession picker, string slot, string label) => __builder =>
    {
        var shape = ArtworkPickerRules.ShapeFor(slot, picker.MediaType);
        var shapeClass = ShapeClass(slot, picker);
        var providers = Mode?.Fields.ProvidersAvailable != false;
        <div class="tl-art-picker__add-panel">
            <div class="tl-art-picker__add-head">
                <strong>@(_replacing ? $"Replace the {label.ToLowerInvariant()}" : $"Add a {label.ToLowerInvariant()}")</strong>
                <span class="tl-art-picker__muted">@label · @ShapeText(shape)</span>
                <AppSegmentedControl Class="tl-art-picker__sources"
                                     AriaLabel="@L["EditorArtworkTool_WhereToFindArtwork"].Value"
                                     Options="@(providers ? Sources : SourcesWithoutProviders)"
                                     Value="@_source"
                                     ValueChanged="SelectSourceAsync" />
                <AppButton ButtonStyle="AppButtonStyle.Text"
                           Tone="AppUiTone.Neutral"
                           StartIcon="@AppMaterialIcons.Outlined.ArrowBack"
                           Class="tl-art-picker__back"
                           OnClick="EndAdd">
                    @($"Back to {label}")
                </AppButton>
            </div>

            @switch (_source)
            {
                case SourceUpload:
                    <p class="tl-art-picker__hint">@L["EditorArtworkTool_ChooseAJPEGOrPNG"]</p>
                    <AppFileUpload T="IBrowserFile" Accept="image/jpeg,image/png" FilesChanged="UploadAsync" Disabled="@picker.Busy" />
                    break;
                case SourceLink:
                    <AppTextField Label="@L["EditorArtworkTool_PictureWebAddress"].Value"
                                  Placeholder="https://"
                                  Value="@_address"
                                  ValueChanged="@((string? value) => _address = value ?? string.Empty)" />
                    <div>
                        <AppButton ButtonStyle="AppButtonStyle.Outlined"
                                   StartIcon="@AppMaterialIcons.Outlined.Link"
                                   Disabled="@(picker.Busy || string.IsNullOrWhiteSpace(_address))"
                                   OnClick="PasteLinkAsync">
                            @L["EditorArtworkTool_FetchPicture"]
                        </AppButton>
                    </div>
                    break;
                default:
                    @ProviderSource(picker, slot, shapeClass)
                    break;
            }

            @SelectedCard(picker, slot, label, shapeClass)
        </div>
    };

    private RenderFragment ProviderSource(ArtworkPickerSession picker, string slot, string shapeClass) => __builder =>
    {
        if (picker.ProviderLoading)
        {
            <AppPageState Kind="AppPageStateKind.Loading" Title="Finding provider artwork" />
        }
        else if (picker.Provider is null)
        {
            <p class="tl-art-picker__hint">Ask the providers this item is matched with for pictures.</p>
            <div>
                <AppButton ButtonStyle="AppButtonStyle.Outlined" StartIcon="@AppMaterialIcons.Outlined.Search" OnClick="picker.LoadProviderAsync">
                    Find provider artwork
                </AppButton>
            </div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(picker.Provider.Message))
            {
                <p class="tl-art-picker__hint">@picker.Provider.Message</p>
                @if (picker.Provider.Message == ProviderArtworkDiscoveryDto.UnmatchedTvShowMessage && Mode is { Fields.CanMatch: true } matchMode)
                {
                    <div>
                        <AppButton ButtonStyle="AppButtonStyle.Outlined" StartIcon="@AppMaterialIcons.Outlined.Search"
                                   OnClick="@(() => matchMode.ShowSectionAsync(EditingSection.Match))">
                            Open Match and Identity
                        </AppButton>
                    </div>
                }
            }

            var appLanguage = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
            var languages = ArtworkCandidateFilter.Languages(picker.Provider.Items, appLanguage);
            var hasSizes = picker.Provider.Items.Any(item => item.Width is not null || item.Height is not null);
            if (!_languageSeeded && picker.Provider.Items.Count > 0)
            {
                // The list opens on the app's language when the provider has pictures in it.
                _language = ArtworkCandidateFilter.DefaultLanguage(picker.Provider.Items, appLanguage);
                _languageSeeded = true;
            }

            var shown = ArtworkCandidateFilter.SortBySize(ArtworkCandidateFilter.Apply(picker.Provider.Items, _language, _size));
            @if (languages.Count > 1 || hasSizes)
            {
                <div class="tl-art-picker__filters">
                    @if (languages.Count > 1)
                    {
                        <AppSelect T="string"
                                   Label="Language"
                                   Value="@_language"
                                   ValueChanged="@((string value) => _language = value)"
                                   Options="@(new[] { new AppSelectOption(ArtworkCandidateFilter.All, "All languages") }.Concat(languages.Select(entry => new AppSelectOption(entry.Value, entry.Label))).ToList())" />
                    }
                    @if (hasSizes)
                    {
                        <AppSelect T="string"
                                   Label="Size"
                                   Value="@_size"
                                   ValueChanged="@((string value) => _size = value)"
                                   Options="@SizeOptions" />
                    }
                    <span class="tl-art-picker__muted tl-art-picker__count">@($"{shown.Count} pictures · largest first")</span>
                </div>
            }

            @if (shown.Count == 0)
            {
                <p class="tl-art-picker__hint">No pictures match these filters.</p>
            }

            <div class="@($"tl-art-picker__grid tl-art-picker__grid--{shapeClass}")" role="group" aria-label="Provider pictures">
                @foreach (var candidate in shown)
                {
                    var picked = picker.PickedTarget == "provider:" + candidate.Id;
                    var small = ArtworkPickerRules.IsSmall(slot, candidate.Width, candidate.Height);
                    @ThumbButton(
                        "tl-art-picker__tile",
                        $"tl-art-picker__face tl-art-picker__face--tile{(picked ? " is-picked" : string.Empty)}{(candidate.AlreadyAdded ? " is-disabled" : string.Empty)}",
                        $"{candidate.Provider} picture{(candidate.AlreadyAdded ? ", already saved" : string.Empty)}{(small ? ", small" : string.Empty)}",
                        picked,
                        candidate.AlreadyAdded || picker.Busy,
                        () => { picker.PickProvider(candidate); return Task.CompletedTask; },
                        @<text>
                            <span class="@($"tl-art-picker__thumb tl-art-picker__thumb--{shapeClass}{(small ? " is-small" : string.Empty)}")">
                                <img src="@MediaTileArtworkUrl.ForDrawnSize(candidate.ThumbnailUrl, 160)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(candidate.ThumbnailUrl, 160)" alt="" loading="lazy" decoding="async" />
                            </span>
                            <span class="tl-art-picker__caption">
                                @CandidateCaption(candidate)
                                @if (small)
                                {
                                    <span class="tl-art-picker__small">Small</span>
                                }
                            </span>
                        </text>)
                }
            </div>
        }
    };

    private RenderFragment SelectedCard(ArtworkPickerSession picker, string slot, string label, string shapeClass) => __builder =>
    {
        if (!picker.HasPick)
        {
            return;
        }

        var (url, description) = DescribePick(picker);
        <div class="tl-art-picker__selected">
            <span class="@($"tl-art-picker__thumb tl-art-picker__thumb--{shapeClass}")">
                @if (!string.IsNullOrWhiteSpace(url))
                {
                    <img src="@MediaTileArtworkUrl.ForDrawnSize(url, 96)" alt="" />
                }
            </span>
            <div class="tl-art-picker__selected-text">
                <strong>Selected: @description</strong>
                <span class="tl-art-picker__muted">@($"Added as a new version. {ArtworkPickerRules.ReachFor(slot, picker.MediaType, picker.SubjectKind)}")</span>
            </div>
            @if (!_replacing)
            {
                <AppCheckbox Value="@_makePreferred"
                             ValueChanged="@((bool value) => _makePreferred = value)"
                             Label="@($"Make it the Preferred {label.ToLowerInvariant()}")" />
            }
            <AppButton ButtonStyle="AppButtonStyle.Filled"
                       Tone="AppUiTone.Primary"
                       Class="tl-art-picker__use"
                       Disabled="@picker.Busy"
                       OnClick="AddVersionAsync">
                @(_replacing ? "Use this one" : "Add version")
            </AppButton>
        </div>
    };

    private (string? Url, string Description) DescribePick(ArtworkPickerSession picker)
    {
        var target = picker.PickedTarget;
        if (target is not null && target.StartsWith("provider:", StringComparison.Ordinal))
        {
            var candidate = picker.Provider?.Items.FirstOrDefault(item => "provider:" + item.Id == target);
            if (candidate is not null)
            {
                return (candidate.ThumbnailUrl, string.Join(", ", new[]
                {
                    Dimensions(candidate.Width, candidate.Height),
                    ArtworkCandidateFilter.LabelFor(candidate.Language) ?? "no text",
                    candidate.Provider,
                }.Where(part => !string.IsNullOrWhiteSpace(part))));
            }
        }

        var saved = picker.Saved.FirstOrDefault(picture => picture.AssetId.ToString("D") == target);
        return saved is null
            ? (picker.ShownUrl, "your picture")
            : (saved.ThumbnailUrl, string.Join(", ", new[] { Dimensions(saved.Width, saved.Height), saved.Source }.Where(part => !string.IsNullOrWhiteSpace(part))));
    }

    // -- Helpers --------------------------------------------------------------------------------------------

    // The one bare button of this tool: role cards, versions and provider tiles are all pictures you press.
    private RenderFragment ThumbButton(string cssClass, string faceClass, string ariaLabel, bool pressed, bool disabled, Func<Task> onClick, RenderFragment content) => __builder =>
    {
        <AppNativeButton Type="button"
                         Class="@($"tl-art-picker__hit {cssClass}")"
                         Disabled="@disabled"
                         AriaLabel="@ariaLabel"
                         aria-pressed="@(pressed ? "true" : "false")"
                         OnClick="@(() => onClick())">
            <span class="@faceClass">@content</span>
        </AppNativeButton>
    };

    private static string ShapeClass(string slot, ArtworkPickerSession picker) =>
        ArtworkPickerRules.ShapeFor(slot, picker.MediaType).ToString().ToLowerInvariant();

    private static string ShapeText(ArtworkRoleShape shape) => shape switch
    {
        ArtworkRoleShape.Landscape => "Landscape 16:9",
        ArtworkRoleShape.Wide => "Wide logo",
        ArtworkRoleShape.Square => "Square 1:1",
        _ => "Portrait 2:3",
    };

    private static string VersionsText(int count) => count == 1 ? "1 version" : $"{count} versions";

    private static string? Dimensions(int? width, int? height) =>
        width is > 0 && height is > 0 ? $"{width} × {height}" : null;

    private static string? TypeText(string? contentType) =>
        string.IsNullOrWhiteSpace(contentType) ? null : contentType.Split('/').Last().ToUpperInvariant();

    private static string CandidateCaption(ProviderArtworkCandidateDto candidate)
    {
        if (candidate.AlreadyAdded)
        {
            return "Already saved";
        }

        var size = Dimensions(candidate.Width, candidate.Height);
        var language = ArtworkCandidateFilter.LabelFor(candidate.Language) ?? "No text";
        return size is null ? $"{candidate.Provider} · {language}" : $"{size} · {language}";
    }

    private static string CoverLabel(ArtworkPickerSession picker) =>
        ArtworkPickerRules.TabsFor(["CoverArt"], picker.MediaType).FirstOrDefault()?.Label ?? "Poster";

    private static string StatusText(ArtworkPickerSession picker)
    {
        if (picker.IsRemoval)
        {
            return "The picture will be removed when you save. The pictures stay saved.";
        }

        return picker.IsStaged ? "Will be saved with your other changes." : "Click a version below to make it Preferred.";
    }

    private void ZoomIn() => _zoomIndex = Math.Min(_zoomIndex + 1, ZoomSteps.Length - 1);

    private void ZoomOut() => _zoomIndex = Math.Max(_zoomIndex - 1, 0);

    private void ToggleFull() => _full = !_full;

    private void BeginAdd(bool replacing)
    {
        _adding = true;
        _replacing = replacing;
        _makePreferred = true;
        _address = string.Empty;
        _languageSeeded = false;
        _source = Mode?.Fields.ProvidersAvailable == false ? SourceUpload : SourceProviders;
        if (_source == SourceProviders && Picker is { Provider: null, ProviderLoading: false } picker)
        {
            _ = picker.LoadProviderAsync();
        }
    }

    private void EndAdd()
    {
        _adding = false;
        _replacing = false;
        Picker?.DiscardPick();
    }

    private async Task SelectSlotAsync(string slot)
    {
        if (Picker is null)
        {
            return;
        }

        _address = string.Empty;
        _adding = false;
        _replacing = false;
        _full = false;
        _zoomIndex = 0;
        _languageSeeded = false;
        await Picker.SelectSlotAsync(slot);
    }

    private async Task SelectSourceAsync(string source)
    {
        _source = source;
        if (Picker is null)
        {
            return;
        }

        if (source == SourceProviders && Picker.Provider is null && !Picker.ProviderLoading)
        {
            await Picker.LoadProviderAsync();
        }
    }

    private async Task AddVersionAsync()
    {
        if (Picker is not null && await Picker.UseAsync(_replacing || _makePreferred))
        {
            _adding = false;
            _replacing = false;
        }
    }

    private async Task UploadAsync(IBrowserFile? file)
    {
        if (Picker is not null && file is not null)
        {
            await Picker.UploadAsync(file);
        }
    }

    private async Task PasteLinkAsync()
    {
        if (Picker is not null && await Picker.PasteLinkAsync(_address))
        {
            _address = string.Empty;
        }
    }

    private async Task DeleteAsync(ArtworkPickerPicture? version)
    {
        if (Picker?.ActiveSlot is not { } slot || version is null)
        {
            return;
        }

        // Delete is the one artwork action that happens at once (spec 3b), so it asks first and shows the picture that would go.
        var label = ArtworkPickerRules.LabelFor(slot, CoverLabel(Picker));
        if (await ArtworkRemoveConfirmation.AskRemoveAsync(
                Dialogs,
                label,
                version.ThumbnailUrl,
                "This takes the picture out of the item now, without waiting for Save changes. Other versions stay."))
        {
            await Picker.DeleteVersionAsync(version);
        }
    }

    private void OnModeChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnModeChanged;
        }

        if (_subscribedPicker is not null)
        {
            _subscribedPicker.Changed -= OnModeChanged;
        }

        Picker?.Close();
    }
}
