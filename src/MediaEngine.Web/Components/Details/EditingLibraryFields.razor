@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Metadata
@implements IDisposable
@inject IStringLocalizer<SharedStrings> L

@* Editing Mode on the Overview: the other single-item fields the editor's Details section edits (tags, language,
   original title and the like), each with the same pencil, and provider-owned facts with a lock and a reason. *@
@if (Mode is { ShowsPencils: true } mode && mode.Fields.Loaded && Rows(mode) is { Count: > 0 } rows)
{
    <section class="tl-editing-fields" aria-label="@L["EditingLibraryFields_FieldsYouCanEdit"].Value">
        <header class="tl-editing-fields__heading"><span>@L["EditingLibraryFields_Fields"]</span></header>
        <dl class="tl-editing-fields__list">
            @foreach (var row in rows)
            {
                var isEditing = mode.Fields.IsEditing(row.Key, Owner);
                <div class="tl-editing-fields__row @(isEditing ? "is-editing" : null)">
                    @if (!isEditing)
                    {
                        <dt>@row.Label</dt>
                        <dd>
                            <span class="tl-editing-fields__value">@(string.IsNullOrWhiteSpace(row.DisplayValue) ? "Not set" : row.DisplayValue)</span>
                            <EditableFieldPencil Keys="@(new[] { row.Key })" Owner="@Owner" />
                        </dd>
                    }
                    else
                    {
                        <dd class="tl-editing-fields__editor"><EditableFieldPencil Keys="@(new[] { row.Key })" Owner="@Owner" /></dd>
                    }
                </div>
            }
        </dl>
    </section>
}

@code {
    private const string Owner = "overview";

    private EditingModeContext? _subscribed;

    [CascadingParameter] public EditingModeContext? Mode { get; set; }

    // The title, the synopsis and the genres already carry a pencil on the hero.
    private static IReadOnlyList<MediaEditorDetailsFieldPresentation> Rows(EditingModeContext mode)
    {
        var presentation = mode.Fields.Presentation;
        var covered = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "genre" };
        if (presentation.Heading is { } heading) covered.Add(heading.Key);
        if (presentation.Synopsis is { } synopsis) covered.Add(synopsis.Key);

        var rows = mode.Fields.AllFields().Where(field => !covered.Contains(field.Key)).ToList();
        if (mode.Fields.EmptyTagsField is { } emptyTags && rows.All(row => !string.Equals(row.Key, emptyTags.Key, StringComparison.OrdinalIgnoreCase)))
        {
            rows.Add(emptyTags);
        }

        return rows;
    }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Mode))
        {
            return;
        }

        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnModeChanged;
        }

        _subscribed = Mode;
        if (_subscribed is not null)
        {
            _subscribed.Changed += OnModeChanged;
        }
    }

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnModeChanged;
        }
    }

    private void OnModeChanged() => _ = InvokeAsync(StateHasChanged);
}
