@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Services.Editing
@implements IDisposable
@inject DeviceContextService Device
@inject EditorHost Editor
@inject IAppDialogService Dialogs
@inject IServiceProvider Services
@inject IStringLocalizer<SharedStrings> L

@* The ticked rows' bar (universal editor spec D14), in the list column directly above the rows. It reads "{n} selected", then Edit, Match
   and Move to album/season where they make sense for the ticked rows, a "..." menu holding Delete from library, and Clear. It only opens
   pop-over's bulk panel (the selection says which one; the one editor host opens it over the page or list); the panel stages, and the
   one Save changes saves. Nothing renders on a device that may not edit, on a page the Engine does not let the person edit, or while no
   row is ticked. *@
@if (_notice is not null)
{
    @* A refusal, or files a delete left on disk: it stays above the rows until the next try or the close button (nothing is drawn over the page). *@
    <AppAlert Severity="@_noticeSeverity" Dense="true" ShowCloseIcon="true" CloseIconClicked="@(() => _notice = null)" data-bulk-selection-notice="true">@_notice</AppAlert>
}
@if (Active is { Count: > 0 } selection && IsAvailable)
{
    var rows = selection.Rows;
    var busy = IsBusy;
    <section class="tl-batch" aria-label="@L["BulkSelectionBar_SelectedRows"].Value">
        <div class="tl-batch__bar" role="toolbar" aria-label="@L["BulkSelectionBar_SelectedRows"].Value">
            <span class="tl-batch__count" role="status">@BulkEditRules.SelectedLabel(selection.Count)</span>
            <span class="tl-batch__actions">
                <AppButton Label="@L["Common_Edit"].Value"
                           StartIcon="@AppMaterialIcons.Outlined.Edit"
                           Class="tl-batch__edit"
                           id="@ButtonId(BulkPanelKind.Edit)"
                           ButtonStyle="@Style(selection, BulkPanelKind.Edit)"
                           Tone="@ToneOf(selection, BulkPanelKind.Edit)"
                           Disabled="@busy"
                           aria-pressed="@Pressed(selection, BulkPanelKind.Edit)"
                           OnClick="@(() => TogglePanel(BulkPanelKind.Edit))" />
                @if (BulkEditRules.CanAddToPlaylist(rows, selection.MediaType))
                {
                    @* Ticked songs and albums go into a hand-made playlist (a normal button: Tab reaches it, Enter or Space opens the list). *@
                    <AppButton Label="@L["Common_AddToPlaylist"].Value"
                               StartIcon="@AppMaterialIcons.Outlined.QueueMusic"
                               Class="tl-batch__playlist"
                               Disabled="@busy"
                               ButtonStyle="AppButtonStyle.Outlined"
                               Tone="AppUiTone.Neutral"
                               OnClick="AddToPlaylistAsync" />
                }

                @if (CanAddToCollection(selection))
                {
                    <AppButton Label="@BulkEditRules.AddToCollectionLabel(selection.Count)"
                               StartIcon="@AppMaterialIcons.Outlined.PlaylistAdd"
                               Class="tl-batch__collection"
                               Disabled="@busy"
                               ButtonStyle="AppButtonStyle.Outlined"
                               Tone="AppUiTone.Neutral"
                               OnClick="AddToCollectionAsync" />
                }

                @if (BulkEditRules.CanMatch(rows, selection.MediaType))
                {
                    <AppButton Label="@L["Common_Match"].Value"
                               StartIcon="@AppMaterialIcons.Outlined.TravelExplore"
                               Class="tl-batch__match"
                           id="@ButtonId(BulkPanelKind.Match)"
                               ButtonStyle="@Style(selection, BulkPanelKind.Match)"
                               Tone="@ToneOf(selection, BulkPanelKind.Match)"
                               Disabled="@busy"
                               aria-pressed="@Pressed(selection, BulkPanelKind.Match)"
                               OnClick="@(() => TogglePanel(BulkPanelKind.Match))" />
                }

                @if (BulkEditRules.CanPutInSeries(rows, selection.MediaType))
                {
                    <AppButton Label="@BulkEditRules.PutInSeriesLabel"
                               StartIcon="@AppMaterialIcons.Outlined.VideoLibrary"
                               Class="tl-batch__series"
                           id="@ButtonId(BulkPanelKind.Series)"
                               ButtonStyle="@Style(selection, BulkPanelKind.Series)"
                               Tone="@ToneOf(selection, BulkPanelKind.Series)"
                               Disabled="@busy"
                               aria-pressed="@Pressed(selection, BulkPanelKind.Series)"
                               OnClick="@(() => TogglePanel(BulkPanelKind.Series))" />
                }

                @if (BulkEditRules.CanMove(rows))
                {
                    <AppButton Label="@BulkEditRules.MoveLabel(rows, selection.MediaType)"
                               StartIcon="@AppMaterialIcons.Outlined.AccountTree"
                               Class="tl-batch__move"
                           id="@ButtonId(BulkPanelKind.Move)"
                               ButtonStyle="@Style(selection, BulkPanelKind.Move)"
                               Tone="@ToneOf(selection, BulkPanelKind.Move)"
                               Disabled="@busy"
                               aria-pressed="@Pressed(selection, BulkPanelKind.Move)"
                               OnClick="@(() => TogglePanel(BulkPanelKind.Move))" />
                }

                @if (MenuActions(selection) is { Count: > 0 } menu)
                {
                    <OverflowActionMenu Actions="@menu"
                                        ButtonClass="tl-batch__more"
                                        OnActionSelected="OnMenuActionAsync" />
                }

                <AppButton Label="@L["Activity_Clear"].Value"
                           ButtonStyle="AppButtonStyle.Text"
                           Disabled="@busy"
                           OnClick="ClearAsync" />
            </span>
        </div>
        @if (selection.IsFull)
        {
            @* The list is full: the bar says so, since a row that cannot be ticked would otherwise just not react. *@
            <p class="tl-batch__full" role="status" data-bulk-selection-full="true">@BulkEditSelection.FullNotice</p>
        }
    </section>
}

@code {
    /// <summary>The id of the bar's button for a panel, so focus can come back to it when that panel closes.</summary>
    public static string ButtonId(BulkPanelKind panel) => $"tl-batch-{panel.ToString().ToLowerInvariant()}";

    private BulkEditSelection? _selection;
    private bool _deleting;
    private bool _deviceHooked;
    private string? _notice;
    private AppSeverity _noticeSeverity = AppSeverity.Warning;

    /// <summary>The detail page the bar sits on (its Engine edit permission); null for a list with no page behind it, which needs only a device that may edit.</summary>
    [CascadingParameter] public EditorBinding? Binding { get; set; }

    [CascadingParameter] public BulkEditSelection? CascadedSelection { get; set; }

    /// <summary>The ticked rows of a list that is not on a detail page; a detail page cascades its own.</summary>
    [Parameter] public BulkEditSelection? Selection { get; set; }

    /// <summary>A host that is saving or asking a question greys the bar's buttons.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Raised after the ticked rows were deleted, so the host can reload what it shows.</summary>
    [Parameter] public EventCallback<IReadOnlyList<Guid>> OnDeleted { get; set; }

    /// <summary>Raised when Clear ran, so a list that keeps its own ticks can drop them.</summary>
    [Parameter] public EventCallback OnCleared { get; set; }

    private BulkEditSelection? Active => Selection ?? CascadedSelection;

    // On a detail page the bar needs the Engine's edit answer for that page; on a list it only needs a device that may edit.
    private bool IsAvailable => Binding is not null ? Binding.CanEdit : EditorDeviceRule.CanEdit(Device);

    private bool IsBusy => Busy || _deleting || Editor.Mode.IsSettling || Editor.Mode.SectionSaving;

    private static AppButtonStyle Style(BulkEditSelection selection, BulkPanelKind kind) =>
        selection.Panel == kind ? AppButtonStyle.Filled : AppButtonStyle.Outlined;

    private static AppUiTone ToneOf(BulkEditSelection selection, BulkPanelKind kind) =>
        selection.Panel == kind ? AppUiTone.Primary : AppUiTone.Neutral;

    private static string Pressed(BulkEditSelection selection, BulkPanelKind kind) => selection.Panel == kind ? "true" : "false";

    private IReadOnlyList<DetailAction> MenuActions(BulkEditSelection selection) =>
        BulkEditRules.BarMenuActions(selection.Rows, CanDelete(selection), IsBusy);

    // Any adult profile may put ticked titles in collections it may edit; the list only holds those, and the Engine checks each add.
    private bool CanAddToCollection(BulkEditSelection selection) =>
        BulkEditRules.CanAddToCollection(selection.Rows, selection.MediaType)
        && Services.GetService<DashboardSessionAccessor>() is { } session
        && CollectionAuthoringRule.CanCreate(session);

    private async Task AddToCollectionAsync()
    {
        if (Active is null || IsBusy)
        {
            return;
        }

        if (EditorDeviceRule.TryRefuse(Device))
        {
            Warn(EditorDeviceRule.Message);
            return;
        }

        if (!CanAddToCollection(Active))
        {
            return;
        }

        _notice = null;

        Warn(await CollectionMembershipFlow.RunAsync(
            Services,
            [.. Active.Rows.Select(row => new CollectionEditorSeedItem(row.Id, row.Title, row.MediaType))],
            BulkEditRules.AddToCollectionLabel(Active.Count),
            title: null));
    }

    // A refusal or a left-behind file: the amber line the bar has always shown. Null clears it.
    private void Warn(string? message)
    {
        _notice = message;
        _noticeSeverity = AppSeverity.Warning;
    }

    // Ticked songs (or every song on ticked albums) go into a hand-made playlist; the sentence says how many went in (spec D9, D15).
    private async Task AddToPlaylistAsync()
    {
        if (Active is null || IsBusy)
        {
            return;
        }

        if (EditorDeviceRule.TryRefuse(Device))
        {
            Warn(EditorDeviceRule.Message);
            return;
        }

        if (!BulkEditRules.CanAddToPlaylist(Active.Rows, Active.MediaType))
        {
            return;
        }

        Warn(null);
        var notice = await PlaylistMembershipFlow.RunAsync(Services, Active.Rows, L["Common_AddToPlaylist"].Value);
        if (notice is not null)
        {
            _notice = notice.Message;
            _noticeSeverity = notice.Severity;
        }
    }

    private bool CanDelete(BulkEditSelection selection) =>
        BulkEditRules.AreDeletable(selection.Rows)
        && LibraryItemDeletionFlow.CanDelete(Device, Services.GetService<DashboardSessionAccessor>());

    protected override void OnParametersSet()
    {
        if (!_deviceHooked)
        {
            _deviceHooked = true;
            Device.OnChanged += OnStateChanged;
            Editor.Changed += OnStateChanged;
        }

        if (!ReferenceEquals(_selection, Active))
        {
            if (_selection is not null)
            {
                _selection.Changed -= OnStateChanged;
            }

            _selection = Active;
            if (_selection is not null)
            {
                _selection.Changed += OnStateChanged;
            }
        }
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    // One panel at a time: pressing the open one again closes it. The device rule is checked here too; a hidden button is never the only protection.
    private void TogglePanel(BulkPanelKind kind)
    {
        if (Active is null)
        {
            return;
        }

        if (EditorDeviceRule.TryRefuse(Device))
        {
            Warn(EditorDeviceRule.Message);
            return;
        }

        if (Active.Panel == kind)
        {
            Active.ClosePanel();
            return;
        }

        if (kind == BulkPanelKind.Match && !BulkEditRules.CanMatch(Active.Rows, Active.MediaType))
        {
            return;
        }

        if (kind == BulkPanelKind.Move && !BulkEditRules.CanMove(Active.Rows))
        {
            return;
        }

        if (Binding is not null)
        {
            Editor.Bind(Binding);
        }

        Active.OpenPanel(kind);
    }

    private async Task OnMenuActionAsync(DetailAction action)
    {
        if (action.Key == DetailActionKeys.DeleteFromLibrary)
        {
            await DeleteAsync();
        }
    }

    // One dialog listing every file. The gate is the single Delete's own, checked again here; the Engine checks as well.
    private async Task DeleteAsync()
    {
        if (Active is null || _deleting || Active.Count == 0)
        {
            return;
        }

        if (LibraryItemDeletionFlow.Refusal(Device, Services.GetService<DashboardSessionAccessor>()) is { } refusal)
        {
            Warn(refusal);
            return;
        }

        if (!BulkEditRules.AreDeletable(Active.Rows) || Active.Count > BulkEditRules.MaxDeleteItems)
        {
            return;
        }

        _notice = null;
        _deleting = true;
        try
        {
            var ids = Active.Ids;
            var result = await LibraryItemDeletionFlow.RunAsync(Dialogs, ids);
            if (result.Outcome != LibraryItemDeletionFlowOutcome.Canceled)
            {
                Warn(result.Notice);
                Active.Clear();
                if (Active.RefreshAsync is { } refresh)
                {
                    await refresh();
                }

                await OnDeleted.InvokeAsync(ids);
            }
        }
        finally
        {
            _deleting = false;
        }
    }

    private async Task ClearAsync()
    {
        Active?.Clear();
        await OnCleared.InvokeAsync();
    }

    public void Dispose()
    {
        Device.OnChanged -= OnStateChanged;
        Editor.Changed -= OnStateChanged;
        if (_selection is not null)
        {
            _selection.Changed -= OnStateChanged;
        }
    }
}
