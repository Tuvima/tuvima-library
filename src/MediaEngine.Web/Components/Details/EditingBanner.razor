@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Services.Editing
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable

@* The Editing Mode banner (details overlay spec D4): one full-width bar at the top of the page, always in view while the page
   scrolls, shown only while Editing Mode is on. Left, what mode this is; middle, the sections that open below the hero (one at
   a time; pressing the open one again closes it); right, a "..." menu holding Delete from library (only for the person and item
   that may delete) and the one Done button. Phones and tablets never see it: editing is desktop-only. *@
@if (Mode is { IsOn: true, CanEdit: true } mode)
{
    @* Reload and tab close ask the browser's own question. Pages that are not inside the details overlay (a Universe) also ask
       "Save or discard?" for in-app navigation; inside the overlay the dismiss guard does, so a title never asks twice. *@
    <NavigationLock ConfirmExternalNavigation="@mode.HasUnsavedInput"
                    OnBeforeInternalNavigation="ConfirmNavigationAsync" />

    <div class="@(InPage ? "tl-editing-banner tl-editing-banner--page" : "tl-editing-banner")" role="region" aria-label="Editing">
        <div class="tl-editing-banner__row">
            <div class="tl-editing-banner__status">
                <span class="tl-editing-banner__dot" aria-hidden="true"></span>
                <strong class="tl-editing-banner__title">Editing</strong>
                <span class="tl-editing-banner__note">Changes stay in your library</span>
            </div>

            @if (ShowSections)
            {
                <div class="tl-editing-banner__sections" role="group" aria-label="Editing sections">
                    @foreach (var section in VisibleSections(mode))
                    {
                        var kind = section.Kind;
                        var isOpen = mode.OpenSectionKind == kind;
                        <AppButton ButtonStyle="@(isOpen ? AppButtonStyle.Filled : AppButtonStyle.Outlined)"
                                   Tone="@(isOpen ? AppUiTone.Primary : AppUiTone.Neutral)"
                                   Size="AppControlSize.Large"
                                   Class="@($"tl-editing-banner__section{(isOpen ? " is-open" : string.Empty)}")"
                                   StartIcon="@section.Icon"
                                   Disabled="@mode.Fields.HasOpenDraft"
                                   aria-pressed="@(isOpen ? "true" : "false")"
                                   OnClick="@(() => ToggleSectionAsync(kind))">
                            @section.Label
                        </AppButton>
                    }
                </div>
            }

            <div class="tl-editing-banner__end">
                @if (CanDelete)
                {
                    <OverflowActionMenu Actions="DeleteActions"
                                        ButtonClass="tl-editing-banner__more"
                                        OnActionSelected="OnActionSelected" />
                }

                <AppButton ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary"
                           Size="AppControlSize.Large"
                           Class="tl-editing-banner__done"
                           StartIcon="@AppMaterialIcons.Outlined.Check"
                           OnClick="DoneAsync">
                    Done
                </AppButton>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(mode.Fields.LoadError))
        {
            <div class="tl-editing-banner__notice" role="alert">
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ErrorOutline" />
                <span><strong>Editing is not ready.</strong> @mode.Fields.LoadError You can still use the sections above.</span>
            </div>
        }
    </div>
}

@code {
    private sealed record BannerSection(EditingSection Kind, string Label, string Icon);

    private static readonly DetailAction[] DeleteActions =
    [
        new DetailAction
        {
            Key = DetailActionKeys.DeleteFromLibrary,
            Label = "Delete from library…",
            Icon = "delete",
            IsDestructive = true,
        },
    ];

    private EditingModeContext? _subscribed;

    [Parameter, EditorRequired] public EditingModeContext? Mode { get; set; }

    /// <summary>
    /// Whether Delete from library is offered in the "..." menu: an effective administrator on a desktop, for a page that is one
    /// title. The page decides (<c>LibraryItemDeletionFlow.CanDelete</c>) and its handler checks again; with no Delete the
    /// "..." is not drawn at all.
    /// </summary>
    [Parameter] public bool CanDelete { get; set; }

    /// <summary>False for an editor that brings its own sections (the Universe editor): no Artwork, Match and Identity or History buttons.</summary>
    [Parameter] public bool ShowSections { get; set; } = true;

    /// <summary>
    /// True for a page that is not inside the details overlay (a Universe): the bar spans the page's own gutters and sticks under its
    /// fixed top bar, and, with no overlay dismiss guard above it, it asks "Save or discard?" itself when the person leaves the page.
    /// </summary>
    [Parameter] public bool InPage { get; set; }

    /// <summary>The "..." menu entry chosen (Delete from library); the page runs its own handler for it.</summary>
    [Parameter] public EventCallback<DetailAction> OnActionSelected { get; set; }

    // Match and Identity only where the editor can match the current target (the editor's own rule).
    private static IReadOnlyList<BannerSection> VisibleSections(EditingModeContext mode)
    {
        var sections = new List<BannerSection>
        {
            new(EditingSection.Artwork, "Manage Artwork", AppMaterialIcons.Outlined.PhotoLibrary),
        };
        if (mode.Fields.CanMatch)
        {
            sections.Add(new(EditingSection.Match, "Match and Identity", AppMaterialIcons.Outlined.TravelExplore));
        }

        sections.Add(new(EditingSection.History, "History", AppMaterialIcons.Outlined.History));
        return sections;
    }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Mode))
        {
            return;
        }

        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnModeChanged;
        }

        _subscribed = Mode;
        if (_subscribed is not null)
        {
            _subscribed.Changed += OnModeChanged;
        }
    }

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnModeChanged;
        }
    }

    private void OnModeChanged() => _ = InvokeAsync(StateHasChanged);

    // Done asks "Save or discard?" first when something typed is unsaved, and keeps the person in the mode when they cancel.
    private async Task DoneAsync()
    {
        if (Mode is not null)
        {
            await Mode.DoneAsync();
        }
    }

    private async Task ToggleSectionAsync(EditingSection section)
    {
        if (Mode is not null)
        {
            await Mode.ToggleSectionAsync(section);
        }
    }

    private async Task ConfirmNavigationAsync(LocationChangingContext context)
    {
        if (!InPage || Mode is not { IsOn: true, HasUnsavedInput: true } mode)
        {
            return;
        }

        if (!await mode.DoneAsync())
        {
            context.PreventNavigation();
        }
    }
}
