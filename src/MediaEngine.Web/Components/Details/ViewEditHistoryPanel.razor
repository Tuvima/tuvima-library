@namespace MediaEngine.Web.Components.Details
@using System.Globalization
@using MediaEngine.Contracts.LocalAssets
@inject IStringLocalizer<SharedStrings> L

@* History of the View editor (spec D3): read-only. It tells what Library knows about the item's life: when it was added, when it was taken or dated,
   and whether it is a favorite, hidden, archived or in the Recycle bin. Nothing here is staged or saved. *@
<div class="tl-editor-details view-edit-history">
    @if (Item is null)
    {
        <p>@L["ViewEdit_HistoryGroup"]</p>
    }
    else
    {
        <ul class="view-edit-history__list">
            <li><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Add" Size="AppSize.Small" /> <span>@L["ViewEdit_HistoryAdded", Format(Item.CreatedAt)]</span></li>
            @if (Item.CapturedAt is { } taken)
            {
                <li><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CalendarMonth" Size="AppSize.Small" /> <span>@L["ViewEdit_HistoryTaken", Format(taken)]</span></li>
            }

            @if (Item.Favorite)
            {
                <li><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Star" Size="AppSize.Small" /> <span>@L["ViewEdit_HistoryFavorite"]</span></li>
            }

            @if (Item.Hidden)
            {
                <li><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Visibility" Size="AppSize.Small" /> <span>@L["ViewEdit_HistoryHidden"]</span></li>
            }

            @if (Item.ArchivedAt is { } archived)
            {
                <li><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Folder" Size="AppSize.Small" /> <span>@L["ViewEdit_HistoryArchived", Format(archived)]</span></li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public LocalAssetDto? Item { get; set; }

    private static string Format(DateTimeOffset value) => value.LocalDateTime.ToString("MMM d, yyyy", CultureInfo.CurrentCulture);
}
