@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details

<section class="tl-audiobook-tracks" aria-labelledby="audiobook-tracks-heading">
    <header class="tl-audiobook-tracks__heading">
        <div>
            <span>Audiobook</span>
            <h2 id="audiobook-tracks-heading">Tracks</h2>
        </div>
        <span>@TrackSummary</span>
    </header>

    <MusicTrackList Groups="TrackGroups"
                    AlbumTitle="@Model.Title"
                    AlbumId="@Model.Id"
                    AudiobookId="@Model.Id"
                    AlbumArtworkUrl="@ArtworkUrl"
                    AuthorName="@string.Join("; ", Model.Facts?.Authors ?? [])"
                    NarratorName="@string.Join("; ", Model.Facts?.Narrators ?? [])"
                    Synopsis="@Model.Description"
                    Authors="@CanonicalContributors(CreditGroupType.Authors)"
                    Narrators="@CanonicalContributors(CreditGroupType.Narrators)"
                    IsAudiobook="true"
                    Compact="true" />
</section>

@code {
    [Parameter, EditorRequired] public DetailPageViewModel Model { get; set; } = default!;

    private IReadOnlyList<MediaGroupingViewModel> TrackGroups => Model.MediaGroups
        .Where(group => string.Equals(group.Key, "tracks", StringComparison.OrdinalIgnoreCase))
        .ToList();

    private IReadOnlyList<PlaybackContributorIdentity> CanonicalContributors(CreditGroupType groupType) => Model.ContributorGroups
        .Where(group => group.GroupType == groupType)
        .SelectMany(group => group.Credits)
        .Where(credit => !string.IsNullOrWhiteSpace(credit.DisplayName))
        .Select(credit => new PlaybackContributorIdentity(
            credit.DisplayName.Trim(),
            credit.EntityType == RelatedEntityType.Person && Guid.TryParse(credit.EntityId, out var personId) && personId != Guid.Empty ? personId : null))
        .ToList();

    private int TrackCount => TrackGroups.SelectMany(group => group.Items).Count();
    private string TrackSummary => $"{TrackCount} {(TrackCount == 1 ? "track" : "tracks")}";
    private string? ArtworkUrl => Model.Artwork.CoverUrl
        ?? Model.Artwork.PosterUrl
        ?? Model.Artwork.HeroArtwork.Url;
}
