@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Web.Services.Navigation
@inject IStringLocalizer<SharedStrings> L

@* Fixed-height stand-in for the detail hero and tab bar, shown only on the first load of a detail page
   (later navigations keep the previous page on screen instead). Sizes live in the scoped stylesheet so the
   skeleton does not shift when the real hero arrives. *@
<div class="tl-detail-skeleton" role="status" aria-live="polite" aria-busy="true">
    <span class="tl-detail-skeleton__label">@L["Common_LoadingDetails"]</span>

    <div class="tl-detail-skeleton__hero" aria-hidden="true">
        @if (!string.IsNullOrWhiteSpace(Preview?.CoverUrl))
        {
            <img class="tl-detail-skeleton__cover" src="@MediaTileArtworkUrl.ForDrawnSize(Preview.CoverUrl, 320)" alt="" decoding="async" />
        }
        else if (IsGroup)
        {
            @* A Series or collection: grey covers at the size the real covers take (GroupHeroCovers), three in a row. *@
            <div class="tl-detail-skeleton__group-covers">
                <div class="tl-detail-skeleton__group-cover"><AppSkeleton Width="100%" Height="100%" /></div>
                <div class="tl-detail-skeleton__group-cover"><AppSkeleton Width="100%" Height="100%" /></div>
                <div class="tl-detail-skeleton__group-cover"><AppSkeleton Width="100%" Height="100%" /></div>
            </div>
        }
        else
        {
            <AppSkeleton Class="tl-detail-skeleton__artwork" />
        }
        <div class="tl-detail-skeleton__copy">
            @if (Preview is not null)
            {
                @if (!string.IsNullOrWhiteSpace(Preview.LogoUrl))
                {
                    <img class="tl-detail-skeleton__logo" src="@MediaTileArtworkUrl.ForDrawnSize(Preview.LogoUrl, 544)" alt="@Preview.Title" decoding="async" />
                }
                else
                {
                    <h1 class="tl-detail-skeleton__heading">@Preview.Title</h1>
                }
            }
            else
            {
                <AppSkeleton Class="tl-detail-skeleton__eyebrow" />
                <AppSkeleton Class="tl-detail-skeleton__title" />
            }
            <AppSkeleton Class="tl-detail-skeleton__meta" />
            <AppSkeleton Class="tl-detail-skeleton__line" />
            <AppSkeleton Class="tl-detail-skeleton__line tl-detail-skeleton__line--short" />
            <div class="tl-detail-skeleton__actions">
                <AppSkeleton Class="tl-detail-skeleton__button" />
                <AppSkeleton Class="tl-detail-skeleton__button tl-detail-skeleton__button--secondary" />
            </div>
        </div>
    </div>

    <div class="tl-detail-skeleton__tabs" aria-hidden="true">
        <AppSkeleton Class="tl-detail-skeleton__tab" />
        <AppSkeleton Class="tl-detail-skeleton__tab" />
        <AppSkeleton Class="tl-detail-skeleton__tab" />
    </div>

    @if (IsGroup)
    {
        @* The members' grid, grey, with the cells at their final size so nothing jumps when the real grid lands. *@
        <div class="tl-detail-skeleton__members" aria-hidden="true">
            @for (var index = 0; index < 6; index++)
            {
                <div class="tl-detail-skeleton__member"><AppSkeleton Width="100%" Height="100%" /></div>
            }
        </div>
    }
</div>

@code {
    /// <summary>True for a Series or collection page: grey covers on the right and a grey grid of members under the tabs.</summary>
    [Parameter] public bool IsGroup { get; set; }

    /// <summary>What the clicked tile already knew; null on a direct address or reload.</summary>
    [Parameter] public DetailPreview? Preview { get; set; }
}
