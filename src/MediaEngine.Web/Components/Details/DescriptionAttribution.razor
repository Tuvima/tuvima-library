@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details
@inject IStringLocalizer<SharedStrings> L

@if (Attribution is not null)
{
    <p class="tl-detail-description-attribution @(Compact ? "tl-detail-description-attribution--compact" : null)">
        @if (!string.IsNullOrWhiteSpace(Attribution.SourceUrl))
        {
            <a href="@Attribution.SourceUrl" target="_blank" rel="noopener noreferrer">@SourceLabel</a>
        }
        else
        {
            <span>@SourceLabel</span>
        }
        <span>@L["DescriptionAttribution_TextIsAvailableUnder"]</span>
        @if (!string.IsNullOrWhiteSpace(Attribution.LicenseUrl))
        {
            <a href="@Attribution.LicenseUrl" target="_blank" rel="noopener noreferrer">@Attribution.LicenseName</a>
        }
        else
        {
            <span>@Attribution.LicenseName</span>
        }
        <span>;</span>
        <span>@L["DescriptionAttribution_AdditionalTermsMayApply"]</span>
        @if (Attribution.RetrievedAt is not null)
        {
            <span>Retrieved @Attribution.RetrievedAt.Value.ToString("MMM d, yyyy").</span>
        }
        @if (Attribution.IsModifiedOrSummarized)
        {
            <span>@L["DescriptionAttribution_ModifiedOrSummarizedForDisplay"]</span>
        }
    </p>
}

@code {
    [Parameter] public DescriptionAttributionViewModel? Attribution { get; set; }
    [Parameter] public bool Compact { get; set; }

    private string SourceLabel => string.IsNullOrWhiteSpace(Attribution?.SourceTitle)
        ? Attribution?.SourceName ?? "Source"
        : $"{Attribution.SourceName}: {Attribution.SourceTitle}";
}
