@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Services.MediaTiles

<AppCssElement Tag="div" Class="@StageClass" Css="@StageStyle">
    @if (IsBackdropMode && !string.IsNullOrWhiteSpace(HeroImageUrl))
    {
        <img class="tl-detail-hero__artwork tl-detail-media-stage__background"
             src="@HeroImageUrl"
             srcset="@HeroImageSrcSet"
             sizes="100vw"
             alt=""
             aria-hidden="true"
             @onerror="HandleImageError" />
        <div class="tl-detail-hero__overlays tl-detail-media-stage__overlay" aria-hidden="true"></div>
        @if (ShowAlbumForeground)
        {
            <div class="tl-detail-hero__foreground-art tl-detail-media-stage__cover-wrap tl-detail-media-stage__cover-wrap--over-backdrop">
                <div class="@ForegroundClass">
                    <span class="tl-detail-media-stage__vinyl" aria-hidden="true"></span>
                    <img class="tl-detail-media-stage__cover"
                         src="@ForegroundArtworkUrl"
                         srcset="@ForegroundArtworkSrcSet"
                         sizes="(max-width: 720px) 62vw, 34vw"
                         alt=""
                         @onerror="HandleForegroundImageError" />
                </div>
            </div>
        }
    }
    else if (IsArtworkFallbackMode && !string.IsNullOrWhiteSpace(HeroImageUrl))
    {
        <div class="tl-detail-hero__cover-atmosphere tl-detail-media-stage__cover-atmosphere" aria-hidden="true"></div>
        <div class="tl-detail-hero__overlays tl-detail-media-stage__overlay" aria-hidden="true"></div>
        <div class="tl-detail-hero__foreground-art tl-detail-media-stage__cover-wrap">
            <div class="@ForegroundClass">
                @if (ForegroundTreatment == HeroForegroundTreatment.Book)
                {
                    <span class="tl-detail-media-stage__book-pages" aria-hidden="true"></span>
                    <span class="tl-detail-media-stage__book-spine" aria-hidden="true"></span>
                }
                else if (ForegroundTreatment == HeroForegroundTreatment.Album)
                {
                    <span class="tl-detail-media-stage__vinyl" aria-hidden="true"></span>
                }

                <img class="tl-detail-media-stage__cover" src="@HeroImageUrl" srcset="@HeroImageSrcSet"
                     sizes="(max-width: 720px) 72vw, 38vw" alt="" @onerror="HandleImageError" />
            </div>
        </div>
    }
    else
    {
        <div class="tl-detail-hero__placeholder tl-detail-media-stage__placeholder" aria-hidden="true"></div>
        <div class="tl-detail-hero__overlays tl-detail-media-stage__overlay" aria-hidden="true"></div>
    }

    @if (ShouldRenderHeroBrand)
    {
        <div class="tl-detail-hero-brand">
            @if (!string.IsNullOrWhiteSpace(HeroBrand?.ImageUrl))
            {
                <img src="@HeroBrand.ImageUrl" alt="@HeroBrand.Label" />
            }
            else
            {
                <span>@HeroBrand?.Label</span>
            }
        </div>
    }
</AppCssElement>

@code {
    [Parameter, EditorRequired] public ArtworkSet Artwork { get; set; } = default!;
    [Parameter] public DetailEntityType EntityType { get; set; }
    [Parameter] public HeroBrandViewModel? HeroBrand { get; set; }
    [Parameter] public bool CenterLandscape { get; set; }
    [Parameter] public int? HeroImageWidthPx { get; set; }
    [Parameter] public int? HeroImageHeightPx { get; set; }
    [Parameter] public int? CoverWidthPx { get; set; }
    [Parameter] public int? CoverHeightPx { get; set; }

    private bool _imageFailed;
    private bool _foregroundImageFailed;
    private string? _lastHeroImageUrl;
    private string? _lastForegroundImageUrl;

    private bool ShouldRenderHeroBrand => !string.IsNullOrWhiteSpace(HeroBrand?.ImageUrl);
    private HeroArtworkViewModel HeroArtwork => Artwork.HeroArtwork;
    // Structural containers have no single truthful backdrop. Their shared
    // representative artwork cluster is rendered by DetailHero over a neutral wash.
    private bool IsStructuralContainer => EntityType is DetailEntityType.Collection
        or DetailEntityType.BookSeries
        or DetailEntityType.ComicSeries
        or DetailEntityType.MovieSeries;
    private bool IsMusicAlbumBackdrop => !CenterLandscape && EntityType == DetailEntityType.MusicAlbum
        && !string.IsNullOrWhiteSpace(Artwork.CoverUrl ?? Artwork.PosterUrl);
    private string? HeroImageCandidate => !IsStructuralContainer
        ? IsMusicAlbumBackdrop
            ? Artwork.CoverUrl ?? Artwork.PosterUrl
            : HeroArtwork.HasImage && !string.IsNullOrWhiteSpace(HeroArtwork.Url)
                ? HeroArtwork.Url
                : null
        : null;
    private string? HeroImageUrl => !_imageFailed
        ? MediaTileArtworkUrl.Sized(HeroImageCandidate, "m") ?? HeroImageCandidate : null;
    private string? HeroImageSrcSet => MediaTileArtworkUrl.SrcSet(
        HeroArtwork.SmallUrl, HeroArtwork.MediumUrl, HeroArtwork.LargeUrl,
        HeroImageWidthPx, HeroImageHeightPx);
    private HeroArtworkMode EffectiveMode => string.IsNullOrWhiteSpace(HeroImageUrl)
        ? HeroArtworkMode.Placeholder
        : HeroArtwork.Mode;
    private bool IsBackdropMode => IsMusicAlbumBackdrop
        || EffectiveMode is HeroArtworkMode.BackdropWithLogo or HeroArtworkMode.BackdropWithRenderedTitle;
    private bool IsArtworkFallbackMode => EffectiveMode == HeroArtworkMode.ArtworkFallback;
    private string? ForegroundArtworkUrl => !_foregroundImageFailed
        ? MediaTileArtworkUrl.Sized(Artwork.CoverUrl ?? Artwork.PosterUrl, "m") ?? Artwork.CoverUrl ?? Artwork.PosterUrl
        : null;
    private string? ForegroundArtworkSrcSet => MediaTileArtworkUrl.SrcSet(
        MediaTileArtworkUrl.Sized(ForegroundArtworkUrl, "s"),
        MediaTileArtworkUrl.Sized(ForegroundArtworkUrl, "m"),
        MediaTileArtworkUrl.Sized(ForegroundArtworkUrl, "l"), CoverWidthPx, CoverHeightPx);
    private bool ShowAlbumForeground => EntityType == DetailEntityType.MusicAlbum
        && !string.IsNullOrWhiteSpace(ForegroundArtworkUrl);
    private HeroForegroundTreatment ForegroundTreatment => EntityType switch
    {
        DetailEntityType.Book or DetailEntityType.Work => HeroForegroundTreatment.Book,
        DetailEntityType.Audiobook => HeroForegroundTreatment.Cover,
        DetailEntityType.MusicAlbum => HeroForegroundTreatment.Album,
        DetailEntityType.Person or DetailEntityType.Character => HeroForegroundTreatment.Portrait,
        _ => HeroForegroundTreatment.Poster,
    };
    private string ForegroundClass => $"tl-detail-media-stage__foreground tl-detail-media-stage__foreground--{ForegroundTreatment.ToString().ToLowerInvariant()}";

    private string StageClass
    {
        get
        {
            var imageClass = IsMusicAlbumBackdrop
                ? "tl-detail-media-stage--background tl-detail-media-stage--music-cover-background"
                : EffectiveMode switch
            {
                HeroArtworkMode.BackdropWithLogo => "tl-detail-media-stage--background tl-detail-media-stage--backdrop-with-logo",
                HeroArtworkMode.BackdropWithRenderedTitle => "tl-detail-media-stage--background tl-detail-media-stage--backdrop-with-rendered-title",
                HeroArtworkMode.ArtworkFallback => "tl-detail-media-stage--artwork-fallback tl-detail-media-stage--cover-fallback",
                _ => "tl-detail-media-stage--placeholder",
            };
            var entityClass = EntityType switch
            {
                DetailEntityType.Movie or DetailEntityType.TvShow or DetailEntityType.TvSeason or DetailEntityType.TvEpisode => "tl-detail-media-stage--landscape",
                DetailEntityType.MusicAlbum => "tl-detail-media-stage--square",
                DetailEntityType.Book or DetailEntityType.Work or DetailEntityType.ComicIssue or DetailEntityType.ComicSeries => "tl-detail-media-stage--book",
                DetailEntityType.Audiobook => "tl-detail-media-stage--audiobook",
                DetailEntityType.Person or DetailEntityType.Character => "tl-detail-media-stage--portrait",
                _ => "tl-detail-media-stage--poster",
            };

            return $"tl-detail-media-stage tl-detail-hero__stage {imageClass} {entityClass}";
        }
    }

    private string StageStyle
    {
        get
        {
            if (string.IsNullOrWhiteSpace(HeroImageUrl))
                return string.Empty;

            // Each surface uses a deterministic crop: Home centers landscape
            // art, while detail retains its established top-center crop.
            var position = IsMusicAlbumBackdrop
                ? "center"
                : IsBackdropMode
                ? CenterLandscape ? "center center" : "center top"
                : HeroArtwork.BackgroundPosition ?? "center";
            var mobilePosition = IsMusicAlbumBackdrop
                ? "center"
                : IsBackdropMode
                ? CenterLandscape ? "center center" : "center top"
                : HeroArtwork.MobilePosition ?? position;
            return $"--hero-image:url(\"{EscapeCssString(HeroImageUrl)}\");--hero-image-position:{position};--mobile-image-position:{mobilePosition};";
        }
    }

    protected override void OnParametersSet()
    {
        var nextUrl = HeroImageCandidate;
        if (!string.Equals(nextUrl, _lastHeroImageUrl, StringComparison.Ordinal))
        {
            _imageFailed = false;
            _lastHeroImageUrl = nextUrl;
        }

        var nextForegroundUrl = Artwork.CoverUrl ?? Artwork.PosterUrl;
        if (!string.Equals(nextForegroundUrl, _lastForegroundImageUrl, StringComparison.Ordinal))
        {
            _foregroundImageFailed = false;
            _lastForegroundImageUrl = nextForegroundUrl;
        }
    }

    private void HandleImageError() => _imageFailed = true;
    private void HandleForegroundImageError() => _foregroundImageFailed = true;

    private static string EscapeCssString(string value)
        => value.Replace("\\", "\\\\", StringComparison.Ordinal).Replace("\"", "\\\"", StringComparison.Ordinal);

    private enum HeroForegroundTreatment
    {
        Book,
        Cover,
        Poster,
        Album,
        Portrait
    }
}
