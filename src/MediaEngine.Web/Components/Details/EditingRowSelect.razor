@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Web.Services.Editing
@implements IDisposable

@* The tick on a row (episode, track or part) that picks it for a batch edit (details overlay spec D8). It exists only while Editing
   Mode is on; everywhere else (and on every device that cannot edit) it draws nothing. *@
@if (Editing is { IsOn: true, CanEdit: true } && Guid.TryParse(Id, out var guid))
{
    <span class="@(Overlay ? "tl-row-select tl-row-select--overlay" : "tl-row-select")">
        <AppCheckbox Value="@Editing.BatchSelection.Contains(guid)"
                     ValueChanged="@(_ => Editing.ToggleBatchSelection(guid))"
                     aria-label="@($"Select {Label} for batch editing")" />
    </span>
}

@code {
    private EditingModeContext? _subscribed;

    [CascadingParameter] public EditingModeContext? Editing { get; set; }

    /// <summary>The row's Work id.</summary>
    [Parameter, EditorRequired] public string? Id { get; set; }

    /// <summary>What the row is called, for the screen-reader label.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>True on a tile: the tick sits on the tile's top-left corner instead of in line.</summary>
    [Parameter] public bool Overlay { get; set; }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Editing))
        {
            return;
        }

        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnChanged;
        }

        _subscribed = Editing;
        if (_subscribed is not null)
        {
            _subscribed.Changed += OnChanged;
        }
    }

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnChanged;
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
}
