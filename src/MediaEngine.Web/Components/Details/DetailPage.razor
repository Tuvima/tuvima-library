@namespace MediaEngine.Web.Components.Details
@using System.Globalization
@using System.Text.RegularExpressions
@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Components.Collections
@using Microsoft.JSInterop
@using MediaEngine.Contracts.Progress
@using MediaEngine.Contracts.Playback
@using MediaEngine.Contracts.Realtime
@using MediaEngine.Contracts.Universe
@using MediaEngine.Domain.Enums
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Contracts.Editing
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Navigation
@using MediaEngine.Web.Services.Playback
@inject IEngineApiClient ApiClient
@inject DeviceContextService DeviceContext
@inject SavedItemService SavedItems
@inject EditorHost Editor
@inject MediaReactionService Reactions
@inject PlaybackSessionController Playback
@inject UIOrchestratorService Orchestrator
@inject NavigationManager Nav
@inject IAppDialogService Dialogs
@inject IJSRuntime JS
@inject IServiceProvider Services
@inject ILogger<DetailPage> Logger
@implements IDisposable
@inject IStringLocalizer<SharedStrings> L

@if (Model is not null && _removed)
{
    @* Someone else deleted this title while it was open: the overlay stays, with a notice in place of the page. *@
    <article class="tl-detail-page tl-detail-page--removed">
        <RemovedItemNotice InputLabel="@_removedInputLabel"
                           InputText="@_removedInputText"
                           LostSectionInput="_removedLostSectionInput"
                           Note="@_removedNote"
                           OnClose="CloseRemovedNoticeAsync" />
    </article>
}
else if (Model is not null)
{
    @* Editing opens the pop-over the layout draws (EditorPopover); this page is never put into an editing state. It only offers its
       binding, so a row's own Edit can open the pop-over for this page's item. *@
    <CascadingValue Value="_binding" IsFixed="true">
    <CascadingValue Value="_batch" IsFixed="true">
    <article class="tl-detail-page">
        @if (_notice is not null)
        {
            @* What the last action had to say (a refusal, a failure, something left out): it stays until the next action or the close button; nothing is drawn over the page. *@
            <AppAlert Tone="@_noticeTone" Dense="true" ShowCloseIcon="true" CloseIconClicked="ClearNotice" data-detail-notice="true">@_notice</AppAlert>
        }
        @* A personal status change, with Undo; it clears by itself, on the next change and when the page moves to another item. *@
        @if (_undoOffer is not null)
        {
            <AppUndoNote Offer="_undoOffer" OnCleared="ClearUndo" data-detail-undo="true" />
        }
        <section class="@DetailStageClass">
            <DetailHero Model="Model"
                        CanDelete="@CanDeleteFromLibrary"
                        CanAddToCollection="@CanAddToCollection"
                        DeleteActions="GroupDeleteMenuActions"
                        ExtraActions="SetMenuActions"
                        OnActionSelected="HandleDetailActionAsync"
                        OnTabRequested="SetActiveTabAsync"
                        ActionAttributes="@(IsAudiobook ? AudiobookActionAttributes : null)" />

            @if (ShowDetailNavigation)
            {
                <div class="tl-detail-stage__navigation">
                    <DetailTabs Tabs="VisibleTabs"
                                ActiveTab="@CurrentActiveTab"
                                ActiveTabChanged="SetActiveTabAsync" />
                </div>
            }
        </section>

        @if (ShowPrimaryModuleAfterNavigation)
        {
            <section class="tl-detail-page__primary-content">
            <DetailPrimaryModule Model="Model"
                                 SelectedSeasonId="SelectedSeasonId"
                                 OnSeasonSelected="SelectedSeasonChanged"
                                 OnContainerSelected="HandleContainerSelectedAsync" />
            </section>
        }

        <section id="@CurrentActiveTab" class="tl-detail-body">
            @if (CurrentActiveTab is "overview")
            {
                @if (IsMusicAlbum)
                {
                    <MusicAlbumOverviewContent Model="Model" />
                }
                else
                {
                    <MediaEngine.Web.Components.Details.OverviewTab Model="Model"
                                                                     OnTabRequested="SetActiveTabAsync"
                                                                     OnContainerSelected="HandleContainerSelectedAsync" />
                }
                <ExtrasSection Extras="Model.Extras" CardsPerGroup="Model.ExtrasCardsPerGroup" OnSeeAll="@(CanSeeAllExtras ? EventCallback.Factory.Create(this, OpenAllExtrasAsync) : default)" />
                <section class="tl-detail-about" aria-label="@L["DetailPage_AboutThis"].Value">
                    <DetailsTab Model="Model" />
                </section>
                @if (Model.EntityType == DetailEntityType.Collection && Model.CollectionInfo is { } collectionInfo)
                {
                    @* A set lists the collections inside it; an imported list lists what it holds that the library does not (Collections and lists 4g). *@
                    @if (collectionInfo.IsSet && Guid.TryParse(Model.Id, out var setId))
                    {
                        <CollectionSetChildren SetId="setId" />
                    }
                    @if (collectionInfo.List is { Missing.Count: > 0 } list)
                    {
                        <CollectionNotInLibrary Missing="list.Missing" />
                    }
                }
            }
            else if (CurrentActiveTab is "tracks" && IsAudiobook)
            {
                <AudiobookTracksContent Model="Model" />
            }
            else if (CurrentActiveTab is "people" or "credits" or "cast")
            {
                <PeopleTab ContributorGroups="@(Model.FullContributorGroups.Count > 0 ? Model.FullContributorGroups : Model.ContributorGroups)"
                                        EpisodeId="@(Model.EntityType == DetailEntityType.TvEpisode ? Model.Id : null)"
                                        EpisodeContributorGroups="@(Model.EntityType == DetailEntityType.TvEpisode ? Model.ContributorGroups : null)" />
            }
            else
            {
                <DetailsTab Model="Model" />
            }
        </section>
    </article>
    </CascadingValue>
    </CascadingValue>
}
