    private async Task HandleDetailActionAsync(DetailAction action)
    {
        if (Model is null) return;
        if (action.Key == DetailActionKeys.PlayFromBeginning)
        {
            if (IsAudiobook) { await PlayAudiobookAsync(preferResume: false); return; }
            if (Model.EntityType == DetailEntityType.MusicAlbum) { await PlayAlbumAsync(shuffle: false); return; }
            if (Model.EntityType is DetailEntityType.Book or DetailEntityType.ComicIssue or DetailEntityType.Work)
            { await OpenReaderAsync(action, restart: true); return; }
        }
        if (action.Key == DetailActionKeys.Read)
        {
            await OpenReaderAsync(action);
            return;
        }

        if (action.Key is DetailActionKeys.PlayNext or DetailActionKeys.AddQueue)
        {
            var tracks = Model.MediaGroups.SelectMany(g => g.Items)
                .Where(item => item.EntityType == DetailEntityType.Work && item.IsOwned)
                .OrderBy(TrackSortKey).Select(ToQueueItem).Where(item => item.WorkId != Guid.Empty).ToList();
            if (action.Key == DetailActionKeys.PlayNext) tracks.Reverse();
            foreach (var track in tracks) await Playback.AddQueueItemAsync(track, next: action.Key == DetailActionKeys.PlayNext);
            Snackbar.Add($"Added {tracks.Count} tracks to the queue.", AppSeverity.Success);
            return;
        }
        if (action.Key == DetailActionKeys.AddPlaylist)
        {
            IReadOnlyList<Guid> works = Model.MediaGroups.SelectMany(g => g.Items)
                .Where(item => item.IsOwned && Guid.TryParse(item.Id, out _))
                .OrderBy(TrackSortKey)
                .Select(item => Guid.Parse(item.Id))
                .Distinct()
                .ToList();
            await Dialogs.ShowAsync<MediaMembershipDialog>(action.Label, new AppDialogParameters<MediaMembershipDialog> {
                { d => d.Playlist, true }, { d => d.WorkIds, works },
            });
            return;
        }
        if (DetailActionKeys.IsPersonalStatus(action.Key))
        {
            await HandlePersonalStatusAsync(action);
            return;
        }
        if (DetailActionKeys.IsUnmatchedAction(action.Key))
        {
            await HandleUnmatchedActionAsync(action);
            return;
        }
        if (action.Key is DetailActionKeys.EditMedia or DetailActionKeys.Edit)
        {
            if (action.IsDisabled) return;
            if (EditorDeviceRule.TryRefuse(DeviceContext, Snackbar)) return;
            if (!CanEditMedia) return;

            // Single items edit in place; shelves, collections and people keep their own editor dialogs.
            // The menu entry only ever turns Editing Mode on; choosing it while already editing keeps it on
            // (Done is the way out).
            if (_editing is { HasPermission: true })
            {
                if (!_editing.IsOn)
                {
                    await _editing.EnterAsync();
                }

                return;
            }

            await OpenMediaEditorAsync();
            return;
        }

        if (action.Key is DetailActionKeys.Identify or DetailActionKeys.ChangeThumbnail)
        {
            await OpenEditShortcutAsync(action);
            return;
        }

        if (action.Key == DetailActionKeys.DeleteFromLibrary)
        {
            await DeleteFromLibraryAsync();
            return;
        }

        if (action.Key == DetailActionKeys.MyList)
        {
            await ToggleFavoriteAsync(action);
            return;
        }

        if (action.Key is DetailActionKeys.ReactionDislike or DetailActionKeys.ReactionLike or DetailActionKeys.ReactionLove)
        {
            await SetReactionAsync(action);
            return;
        }

        if (action.Key == DetailActionKeys.Details)
        {
            await SetActiveTabAsync("details");
            return;
        }

        if (Model?.EntityType == DetailEntityType.MusicAlbum && action.Key is DetailActionKeys.PlayAlbum or DetailActionKeys.Shuffle)
        {
            await PlayAlbumAsync(shuffle: action.Key == DetailActionKeys.Shuffle);
            return;
        }

        if (action.Key == DetailActionKeys.ShuffleCollection)
        {
            await ShuffleStructuralContainerAsync();
            return;
        }

        var isAudiobookListenAction = string.Equals(action.Key, DetailActionKeys.Listen, StringComparison.OrdinalIgnoreCase)
            || string.Equals(action.Label, "Listen", StringComparison.OrdinalIgnoreCase);
        if (Model is not null && IsAudiobook && !action.IsDisabled
            && (isAudiobookListenAction || IsContinueAction(action)))
        {
            await PlayAudiobookAsync(IsContinueAction(action));
            return;
        }

        if (!string.IsNullOrWhiteSpace(action.Route))
        {
            Nav.NavigateTo(action.Route);
            return;
        }

        await OnActionSelected.InvokeAsync(action);
    }

    private bool _changingPersonalStatus;
    private async Task HandlePersonalStatusAsync(DetailAction action)
    {
        if (Model is null || _changingPersonalStatus) return;
        _changingPersonalStatus = true;
        try
        {
            if (action.Key == DetailActionKeys.StatusHistory)
            {
                var items = await ApiClient.GetPersonalHistoryAsync(Model.EntityType, Guid.Parse(Model.Id));
                await Dialogs.ShowAsync<PersonalHistoryDialog>(action.Label,
                    new AppDialogParameters<PersonalHistoryDialog> { { d => d.Items, items } });
                return;
            }
            var command = action.Key switch {
                DetailActionKeys.StatusComplete => PersonalStatusAction.Complete,
                DetailActionKeys.StatusReset => PersonalStatusAction.Reset,
                DetailActionKeys.StatusHide => PersonalStatusAction.HideContinue,
                DetailActionKeys.StatusShow => PersonalStatusAction.ShowContinue,
                _ => throw new InvalidOperationException("Unknown personal status action."),
            };
            var status = await ApiClient.GetPersonalStatusAsync(Model.EntityType, Guid.Parse(Model.Id))
                ?? throw new InvalidOperationException("Personal status could not be loaded. Please try again.");
            var result = await ApiClient.ChangePersonalStatusAsync(new(Guid.NewGuid(), Model.EntityType,
                Guid.Parse(Model.Id), command, status.Revision));
            await RefreshCurrentDetailAsync();
            Snackbar.Add($"Status updated for {result.AffectedCount} owned item(s).", AppSeverity.Success, options => {
                options.Action = "Undo";
                options.OnClick = async _ => {
                    try { await ApiClient.UndoPersonalStatusAsync(result.CommandId); await RefreshCurrentDetailAsync(); }
                    catch (Exception ex) { Snackbar.Add(ex.Message, AppSeverity.Error); }
                };
            });
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, AppSeverity.Error); }
        finally { _changingPersonalStatus = false; }
    }

    // Retry now, Keep as is and Look up again (Library setup spec D34, D40): each calls the Engine's Unmatched item route for every
    // file on this page it applies to (not-kept files for Retry and Keep, kept files for Look up again), then refreshes the page.
    // They are administrator actions, not edits, so the device rule does not apply; the Engine sends them only to administrators.
    private bool _changingUnmatched;
    private async Task HandleUnmatchedActionAsync(DetailAction action)
    {
        if (Model is null || _changingUnmatched) return;
        var lookUpAgain = action.Key == DetailActionKeys.UnmatchedLookUpAgain;
        var targets = Model.UnmatchedAssets
            .Where(asset => asset.KeptAsIs == lookUpAgain)
            .Select(asset => asset.AssetId)
            .ToList();
        if (targets.Count == 0) return;

        _changingUnmatched = true;
        try
        {
            if (action.Key == DetailActionKeys.UnmatchedKeep
                && await AppConfirmDialog.ShowAsync(
                    Dialogs,
                    "Keep as is?",
                    "Stop trying to match this? It stays under Unmatched, marked Kept. You can look it up again later.",
                    "Keep as is",
                    "Cancel") != AppConfirmResult.Primary)
            {
                return;
            }

            var failed = 0;
            foreach (var assetId in targets)
            {
                var result = action.Key switch
                {
                    DetailActionKeys.UnmatchedRetry => await ApiClient.RetryUnmatchedItemAsync(assetId),
                    DetailActionKeys.UnmatchedKeep => await ApiClient.KeepUnmatchedItemAsync(assetId),
                    _ => await ApiClient.LookUpUnmatchedItemAgainAsync(assetId),
                };
                if (result is null) failed++;
            }

            if (failed == targets.Count)
            {
                Snackbar.Add("That could not be done. Try again in a moment.", AppSeverity.Warning);
            }
            else if (failed > 0)
            {
                Snackbar.Add($"Done for {targets.Count - failed} of {targets.Count} files; {failed} could not be changed.", AppSeverity.Warning);
            }
            else
            {
                Snackbar.Add(action.Key switch
                {
                    DetailActionKeys.UnmatchedRetry => "Looking it up again now.",
                    DetailActionKeys.UnmatchedKeep => "Kept as is.",
                    _ => "Looking it up again.",
                }, AppSeverity.Success);
            }

            await RefreshCurrentDetailAsync();
        }
        finally { _changingUnmatched = false; }
    }

    private async Task OpenMediaEditorAsync()
    {
        if (Model is null || !Guid.TryParse(Model.Id, out var entityId))
            return;

        try
        {
            var target = ResolveEditorTarget(entityId);
            var activeProfile = await Orchestrator.GetActiveProfileAsync();
            if (string.Equals(target.EntityKind, "StructuralCollection", StringComparison.OrdinalIgnoreCase))
            {
                var structuralApplied = await CollectionEditorLauncher.OpenAsync(new CollectionEditorLaunchRequest
                {
                    EditingCollection = new CollectionListItemViewModel
                    {
                        Id = target.EntityId,
                        Name = Model.Title,
                        Description = Model.Description,
                        CollectionType = "Series",
                        CoverUrl = Model.Artwork.CoverUrl ?? Model.Artwork.PosterUrl,
                        BackgroundUrl = Model.Artwork.BackdropUrl,
                        LogoUrl = Model.Artwork.LogoUrl,
                    },
                    StructuralDetail = Model,
                    StructuralEntityKind = target.ContainerMode == "Collection" ? "Collection" : "Work",
                    ActiveProfileId = activeProfile?.Id,
                });
                if (structuralApplied)
                    await RefreshCurrentDetailAsync();
                return;
            }
            if (string.Equals(target.EntityKind, "Collection", StringComparison.OrdinalIgnoreCase))
            {
                var collection = await ResolveManagedCollectionForEditorAsync(target.EntityId);
                if (collection is null)
                {
                    Snackbar.Add("Collection editor could not load this collection.", AppSeverity.Error);
                    return;
                }

                var collectionApplied = await CollectionEditorLauncher.OpenAsync(new CollectionEditorLaunchRequest
                {
                    EditingCollection = collection,
                    ActiveProfileId = activeProfile?.Id ?? collection.ProfileId,
                    Kind = ContainerEditorKind.Collection,
                });

                if (collectionApplied)
                    await RefreshCurrentDetailAsync();

                return;
            }

            var request = BuildMediaEditorRequest(entityId, target, activeProfile?.Id, target.InitialTab ?? "details", null)!;

            var applied = await MediaEditorLauncher.OpenAsync(request);
            if (applied)
            {
                await RefreshCurrentDetailAsync();
                Snackbar.Add("Media details updated.", AppSeverity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Media editor could not open: {ex.Message}", AppSeverity.Error);
        }
    }

    // One request shape for the modal (people, and any caller outside Editing Mode) and for the Editing Mode section slot.
    private MediaEditorLaunchRequest? BuildMediaEditorRequest(
        Guid entityId,
        (Guid EntityId, string EntityKind, string ContainerMode, string? InitialTab, string? InitialScope) target,
        Guid? activeProfileId,
        string initialTab,
        string? initialArtworkSlot,
        string? initialMoveResult = null)
    {
        if (Model is null)
        {
            return null;
        }

        var coverUrl = Model.Artwork.CoverUrl ?? Model.Artwork.PosterUrl ?? Model.Artwork.PortraitUrl;
        var mediaType = ResolveEditorMediaType(Model.EntityType, Model.PresentationContext);
        return new MediaEditorLaunchRequest
        {
            EntityIds = [target.EntityId],
            LaunchEntityId = target.EntityId,
            LaunchEntityKind = target.EntityKind,
            ContainerMode = target.ContainerMode,
            ActiveProfileId = activeProfileId,
            InitialMediaGroups = Model.MediaGroups,
            InitialSequencePlacement = Model.SequencePlacement,
            Mode = SharedMediaEditorMode.Normal,
            InitialTab = initialTab,
            InitialArtworkSlot = initialArtworkSlot,
            InitialScope = target.InitialScope,
            MediaType = mediaType,
            HeaderTitle = Model.Title,
            HeaderSubtitle = Model.Subtitle,
            CoverUrl = coverUrl,
            OnArtworkChanged = RefreshCurrentDetailAsync,
            OnEditedItemReplaced = FollowMovedItemAsync,
            InitialMoveResult = initialMoveResult,
            IsUnmatched = Model.IsUnmatched && Guid.TryParse(Model.Id, out var pageItemId) && pageItemId == target.EntityId,
            PreviewItems =
            [
                new MediaEditorPreviewItem
                {
                    EntityId = entityId,
                    Title = Model.Title,
                    CoverUrl = coverUrl,
                    MediaType = mediaType,
                },
            ],
        };
    }

    private (Guid EntityId, string EntityKind, string ContainerMode, string? InitialTab, string? InitialScope) ResolveEditorTarget(Guid fallbackEntityId)
    {
        var target = Model?.EditorTarget;
        if (Model?.EntityType is DetailEntityType.BookSeries or DetailEntityType.ComicSeries or DetailEntityType.MovieSeries)
            return (fallbackEntityId, "StructuralCollection", "Collection", "details", null);
        return target is not null && Guid.TryParse(target.EntityId, out var targetId)
            ? (targetId, target.EntityKind, target.ContainerMode, target.InitialTab, target.InitialScope)
            : (fallbackEntityId, Model?.EntityType.ToString() ?? "Work", "Canonical", "details", null);
    }

    private async Task<CollectionListItemViewModel?> ResolveManagedCollectionForEditorAsync(Guid collectionId)
    {
        var collections = await ApiClient.GetManagedCollectionsAsync();
        var collection = collections.FirstOrDefault(item => item.Id == collectionId);
        return collection is null ? null : ToCollectionListItem(collection);
    }

    private static CollectionListItemViewModel ToCollectionListItem(ManagedCollectionViewModel collection) =>
        new()
        {
            Id = collection.Id,
            Name = collection.Name,
            Description = collection.Description,
            IconName = collection.IconName,
            CollectionType = collection.CollectionType,
            Resolution = collection.Resolution,
            Scope = collection.Scope,
            ProfileId = collection.ProfileId,
            Visibility = collection.Visibility,
            MembershipMode = collection.MembershipMode,
            PrimaryArea = collection.PrimaryArea,
            OwnerKind = collection.OwnerKind,
            Audience = collection.Audience,
            IsEnabled = collection.IsEnabled,
            IsFeatured = collection.IsFeatured,
            ItemCount = collection.ItemCount,
            RuleJson = collection.RuleJson,
            RuleHash = collection.RuleHash,
            MatchMode = collection.MatchMode,
            SortField = collection.SortField,
            SortDirection = collection.SortDirection,
            SecondarySortField = collection.SecondarySortField,
            SecondarySortDirection = collection.SecondarySortDirection,
            CoverUrl = collection.CoverArtworkUrl,
            BackgroundUrl = collection.BackgroundArtworkUrl,
            BannerUrl = collection.BannerArtworkUrl,
            LogoUrl = collection.LogoArtworkUrl,
            CreatedAt = collection.CreatedAt,
            CanEdit = collection.CanEdit,
            CanShare = collection.CanShare,
        };

    // A move merged the title this page shows into another (or emptied the audiobook it shows), so the Work in the address is gone: the
    // address now names the Work the item lives in. In the overlay the entry is replaced with its underlay kept, so Back still returns to
    // the page beneath. The page that loads there picks Editing Mode, the Match and Identity section and the result line back up from
    // the note left here, so following the item does not end the edit. A page showing something else (an album with a song moved out of
    // it) keeps its address and answers false, so the editor re-targets itself.
    private Task<bool> FollowMovedItemAsync(Guid previousId, Guid survivingId, string? resultLine)
    {
        if (Model is null || _disposed || !Guid.TryParse(Model.Id, out var pageId) || pageId != previousId)
        {
            return Task.FromResult(false);
        }

        var store = EditResumeStore;
        store?.OfferEditResume(new DetailsEditResume(survivingId, EditingSection.Match, resultLine));
        if (!DetailsOverlayNavigation.FollowItem(Nav, Overlay, previousId, survivingId))
        {
            store?.WithdrawEditResume();
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private async Task RefreshCurrentDetailAsync()
    {
        if (Model is null || !Guid.TryParse(Model.Id, out var entityId))
            return;

        // A show page the person moved to a season asks for that season again, so the refresh keeps it (D19).
        var updated = SelectedSeasonId is { } seasonId && Model.EntityType == DetailEntityType.TvShow
            ? await ApiClient.GetDetailPageAsync(DetailEntityType.TvSeason, seasonId, Model.PresentationContext, containerId: entityId.ToString("D"), sequence: SequenceWindowQuery.Windowed)
            : await ApiClient.GetDetailPageAsync(Model.EntityType, entityId, Model.PresentationContext, containerId: Model.EntityType == DetailEntityType.TvEpisode ? Model.SequencePlacement?.ContainerId : null, sequence: SequenceWindowQuery.Windowed);
        if (updated is not null && IsStillShowing(entityId))
        {
            Model = updated;
            await ModelRefreshed.InvokeAsync(updated);
            StateHasChanged();
        }
    }

    // A refresh that lands after the person moved on (this page disposed, or a different item put in its place)
    // must not replace what they are looking at now.
    private bool IsStillShowing(Guid entityId) =>
        !_disposed && Model is not null && Guid.TryParse(Model.Id, out var currentId) && currentId == entityId;

    private async Task OpenReaderAsync(DetailAction action, bool restart = false)
    {
        if (!string.IsNullOrWhiteSpace(action.Route) && action.Route.StartsWith("/read/", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo(restart ? Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(action.Route, "restart", "true") : action.Route);
            return;
        }

        if (Model is null || !Guid.TryParse(Model.Id, out var workId))
        {
            await OnActionSelected.InvokeAsync(action);
            return;
        }

        var assetId = await ApiClient.ResolveWorkToAssetAsync(workId);
        if (assetId.HasValue)
        {
            Nav.NavigateTo($"/read/{assetId.Value:D}{(restart ? "?restart=true" : "")}");
            return;
        }

        await OnActionSelected.InvokeAsync(action);
    }

    private async Task ToggleFavoriteAsync(DetailAction action)
    {
        if (Model is null)
            return;

        var profile = await Orchestrator.GetActiveProfileAsync();
        if (!TryResolveProfileEntity(out var entityKind, out var entityId))
        {
            Snackbar.Add("This item cannot be added to My List yet.", AppSeverity.Warning);
            return;
        }

        if (profile is null)
        {
            Snackbar.Add("My List requires an active profile.", AppSeverity.Warning);
            return;
        }

        var membership = await SavedItems.ToggleAsync(entityKind, entityId);
        if (membership is null)
        {
            Snackbar.Add("My List could not be updated.", AppSeverity.Warning);
            return;
        }

        SetFavoriteSelection(Model.PrimaryActions, membership.IsSaved);
        SetFavoriteSelection(Model.SecondaryActions, membership.IsSaved);
        SetFavoriteSelection(Model.OverflowActions, membership.IsSaved);
        action.IsSelected = membership.IsSaved;
        Snackbar.Add(membership.IsSaved ? "Added to My List." : "Removed from My List.", AppSeverity.Success);
        StateHasChanged();
        await OnActionSelected.InvokeAsync(action);
    }

    private bool TryResolveProfileEntity(out ProfileEntityKind entityKind, out Guid entityId)
    {
        entityKind = Model?.EntityType switch
        {
            DetailEntityType.Movie => ProfileEntityKind.Movie,
            DetailEntityType.TvShow or DetailEntityType.TvSeason or DetailEntityType.TvEpisode => ProfileEntityKind.TvShow,
            DetailEntityType.Book or DetailEntityType.Work => ProfileEntityKind.Book,
            DetailEntityType.ComicIssue => ProfileEntityKind.Comic,
            DetailEntityType.Audiobook => ProfileEntityKind.Audiobook,
            DetailEntityType.MusicAlbum => ProfileEntityKind.Album,
            DetailEntityType.Collection => ProfileEntityKind.Collection,
            _ => default,
        };
        entityId = Guid.Empty;
        return Model is not null
               && Model.EntityType is DetailEntityType.Movie
                   or DetailEntityType.TvShow
                   or DetailEntityType.TvSeason
                   or DetailEntityType.TvEpisode
                   or DetailEntityType.Book
                   or DetailEntityType.Work
                   or DetailEntityType.ComicIssue
                   or DetailEntityType.Audiobook
                   or DetailEntityType.MusicAlbum
                   or DetailEntityType.Collection
               && Guid.TryParse(Model.Id, out entityId);
    }

    private static void SetFavoriteSelection(IEnumerable<DetailAction> actions, bool isFavorite)
    {
        foreach (var item in actions)
        {
            if (item.Key == "my-list")
                item.IsSelected = isFavorite;

            SetFavoriteSelection(item.Children, isFavorite);
        }
    }

    private async Task SetReactionAsync(DetailAction action)
    {
        if (!TryResolveProfileEntity(out var entityKind, out var workId))
        {
            Snackbar.Add("This item cannot be rated yet.", AppSeverity.Warning);
            return;
        }

        var reaction = action.Key switch
        {
            "reaction-dislike" => MediaReaction.Dislike,
            "reaction-like" => MediaReaction.Like,
            "reaction-love" => MediaReaction.Love,
            _ => MediaReaction.Neutral,
        };

        var profile = await Orchestrator.GetActiveProfileAsync();
        var current = await Reactions.GetReactionAsync(workId, profile?.Id, entityKind);
        var next = MediaReactionService.ToggleRating(current, reaction);
        await Reactions.SetReactionAsync(workId, next, profile?.Id, entityKind);
        if (Model is not null)
        {
            SetReactionSelection(Model.PrimaryActions, next);
            SetReactionSelection(Model.SecondaryActions, next);
            SetReactionSelection(Model.OverflowActions, next);
        }
        StateHasChanged();
        await OnActionSelected.InvokeAsync(action);
    }

    private static void SetReactionSelection(IEnumerable<DetailAction> actions, MediaReaction selected)
    {
        foreach (var item in actions)
        {
            item.IsSelected = item.Key switch
            {
                "reaction-menu" => selected is MediaReaction.Like or MediaReaction.Love,
                "reaction-dislike" => selected == MediaReaction.Dislike,
                "reaction-like" => selected is MediaReaction.Like or MediaReaction.Love,
                "reaction-love" => selected == MediaReaction.Love,
                _ => item.IsSelected,
            };
            SetReactionSelection(item.Children, selected);
        }
    }

    private async Task PlayAlbumAsync(bool shuffle)
    {
        if (Model is null)
            return;

        var trackGroups = Model.PrimaryModule.GroupKeys.Count == 0
            ? Model.MediaGroups
            : Model.MediaGroups.Where(group => Model.PrimaryModule.GroupKeys.Contains(group.Key, StringComparer.OrdinalIgnoreCase));
        var tracks = trackGroups
            .SelectMany(group => group.Items)
            .Where(item => item.IsOwned && Guid.TryParse(item.Id, out _))
            .OrderBy(TrackSortKey)
            .ThenBy(item => item.Title, StringComparer.OrdinalIgnoreCase)
            .Select(ToQueueItem)
            .Where(item => item.WorkId != Guid.Empty)
            .ToList();

        if (tracks.Count == 0)
        {
            Snackbar.Add("This album has no playable owned tracks.", AppSeverity.Info);
            return;
        }

        await Playback.ReplaceQueueItemsAsync(tracks, 0, Model.Title, shuffle);
    }

    private async Task ShuffleStructuralContainerAsync()
    {
        if (Model is null)
            return;

        var candidates = Model.MediaGroups
            .SelectMany(group => group.Items)
            .Where(item => item.IsOwned && Guid.TryParse(item.Id, out _))
            .DistinctBy(item => $"{item.EntityType}:{item.Id}", StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (candidates.Count == 0)
        {
            Snackbar.Add("This collection has no owned items to shuffle.", AppSeverity.Info);
            return;
        }

        var item = candidates[Random.Shared.Next(candidates.Count)];
        var workId = Guid.Parse(item.Id);
        if (item.EntityType is DetailEntityType.Movie or DetailEntityType.TvEpisode)
        {
            Nav.NavigateTo($"/watch/player/{workId:D}");
            return;
        }

        if (item.EntityType is DetailEntityType.Book or DetailEntityType.ComicIssue)
        {
            var assetId = Guid.TryParse(item.AssetId, out var parsedAssetId)
                ? parsedAssetId
                : await ApiClient.ResolveWorkToAssetAsync(workId);
            if (assetId.HasValue)
            {
                Nav.NavigateTo($"/read/{assetId.Value:D}");
                return;
            }
        }

        if (item.EntityType == DetailEntityType.Work)
        {
            await Playback.ReplaceQueueItemsAsync([ToQueueItem(item)], 0, Model.Title, shuffle: false);
            return;
        }

        var route = item.Actions.FirstOrDefault(action => !string.IsNullOrWhiteSpace(action.Route))?.Route;
        if (!string.IsNullOrWhiteSpace(route))
        {
            Nav.NavigateTo(route);
            return;
        }

        Snackbar.Add("The selected item cannot be opened yet.", AppSeverity.Warning);
    }

    private ListenQueueItem ToQueueItem(MediaGroupingItemViewModel item)
        => new()
        {
            WorkId = Guid.TryParse(item.Id, out var workId) ? workId : Guid.Empty,
            AssetId = Guid.TryParse(item.AssetId, out var assetId) ? assetId : null,
            MediaType = "Music",
            Title = item.Title,
            Subtitle = item.Artist,
            Album = Model?.Title,
            AlbumWorkId = Guid.TryParse(Model?.Id, out var albumId) ? albumId : null,
            ArtistPersonId = Guid.TryParse(Model?.MusicAlbumCompanion?.PrimaryArtistId, out var artistId) ? artistId : null,
            CoverUrl = item.ArtworkUrl ?? Model?.Artwork.CoverUrl ?? Model?.Artwork.PosterUrl,
            Duration = item.Duration,
            InitialPositionSeconds = item.StartSeconds,
        };

    private async Task PlayAudiobookAsync(bool preferResume)
    {
        if (Model is null)
            return;

        var chapters = AudiobookTracks();

        if (chapters.Count == 0)
            return;

        var totalDurationSeconds = ResolveAudiobookTotalSeconds(chapters);
        var resumePositionSeconds = preferResume
            ? ResolveAudiobookResumePosition(chapters, Model.Progress?.Percent, Playback.AudiobookNearStartGuardSeconds, totalDurationSeconds)
            : 0d;
        var startItem = preferResume
            ? ResolveAudiobookResumeItem(chapters, resumePositionSeconds)
            : chapters.FirstOrDefault();
        if (startItem is null)
            return;

        var item = ToAudiobookQueueItem(startItem, chapters, resumePositionSeconds);
        if (item.WorkId == Guid.Empty)
            return;

        await Playback.StartAudiobookAsync(
            new AudiobookStartRequest(
                item,
                preferResume ? AudiobookStartKinds.Resume : AudiobookStartKinds.Chapter,
                resumePositionSeconds,
                startItem.ChapterIndex,
                Model.Title));
    }

    private IReadOnlyDictionary<string, object>? AudiobookActionAttributes(DetailAction action)
    {
        var model = Model;
        var isListenAction = string.Equals(action.Key, "listen", StringComparison.OrdinalIgnoreCase)
            || string.Equals(action.Label, "Listen", StringComparison.OrdinalIgnoreCase);
        if (model is null || !IsAudiobook || action.IsDisabled || (!isListenAction && !IsContinueAction(action)))
        {
            return null;
        }

        var chapters = AudiobookTracks();
        if (chapters.Count == 0)
        {
            return null;
        }

        var preferResume = IsContinueAction(action);
        var totalDurationSeconds = ResolveAudiobookTotalSeconds(chapters);
        var resumePositionSeconds = preferResume
            ? ResolveAudiobookResumePosition(chapters, model.Progress?.Percent, Playback.AudiobookNearStartGuardSeconds, totalDurationSeconds)
            : null;
        var startItem = preferResume
            ? ResolveAudiobookResumeItem(chapters, resumePositionSeconds)
            : chapters.FirstOrDefault();
        if (startItem is null || !Guid.TryParse(startItem.AssetId, out var assetId))
        {
            return null;
        }

        var positionSeconds = resumePositionSeconds ?? ResumePositionFor(startItem) ?? startItem.StartSeconds ?? 0;
        if (preferResume && positionSeconds > 0)
        {
            positionSeconds = Math.Max(0, positionSeconds - Playback.ResumeRewindSeconds);
        }

        var playbackRate = Playback.IsAudiobookMode
            ? Playback.PlaybackRate
            : (double)new ListeningSettingsDto().AudiobookDefaultSpeed;

        return new Dictionary<string, object>
        {
            ["data-listen-immediate-start"] = "audiobook",
            ["data-listen-start-kind"] = preferResume ? AudiobookStartKinds.Resume : AudiobookStartKinds.Chapter,
            ["data-listen-start-url"] = $"/engine-stream/{assetId:D}",
            ["data-listen-start-position"] = positionSeconds.ToString("0.###", CultureInfo.InvariantCulture),
            ["data-listen-start-progress"] = (model.Progress?.Percent ?? 0).ToString("0.###", CultureInfo.InvariantCulture),
            ["data-listen-start-duration"] = (totalDurationSeconds ?? 0).ToString("0.###", CultureInfo.InvariantCulture),
            ["data-listen-start-rewind"] = (preferResume ? Playback.ResumeRewindSeconds : 0).ToString(CultureInfo.InvariantCulture),
            ["data-listen-start-rate"] = playbackRate.ToString("0.###", CultureInfo.InvariantCulture),
            ["data-listen-start-volume"] = Playback.Volume.ToString("0.###", CultureInfo.InvariantCulture),
            ["data-listen-start-muted"] = Playback.IsMuted ? "true" : "false",
        };
    }

    private static bool IsContinueAction(DetailAction action) =>
        string.Equals(action.Key, "continue", StringComparison.OrdinalIgnoreCase)
        || string.Equals(action.Label, "Continue", StringComparison.OrdinalIgnoreCase)
        || string.Equals(action.Label, "Continue Listening", StringComparison.OrdinalIgnoreCase);

    private static MediaGroupingItemViewModel? ResolveAudiobookResumeItem(
        IReadOnlyList<MediaGroupingItemViewModel> chapters,
        double? resumePositionSeconds)
    {
        if (resumePositionSeconds is > 0)
        {
            return ChapterAtPosition(chapters, resumePositionSeconds.Value)
                ?? chapters.FirstOrDefault(item => item.ResumePositionSeconds is > 0)
                ?? chapters.FirstOrDefault(item => item.ProgressPercent is > 0 and < 99.5)
                ?? chapters.FirstOrDefault(item => !IsCompletedChapter(item))
                ?? chapters.FirstOrDefault();
        }

        return chapters.FirstOrDefault(item => item.ResumePositionSeconds is > 0)
            ?? chapters.FirstOrDefault(item => item.ProgressPercent is > 0 and < 99.5)
            ?? chapters.FirstOrDefault(item => !IsCompletedChapter(item))
            ?? chapters.FirstOrDefault();
    }

    private static double? ResolveAudiobookResumePosition(
        IReadOnlyList<MediaGroupingItemViewModel> chapters,
        double? pageProgressPercent,
        int nearStartGuardSeconds,
        double? knownTotalSeconds = null)
    {
        double? inferredPagePosition = null;
        if (pageProgressPercent is > 0 and < 99.5)
        {
            var totalSeconds = knownTotalSeconds is > 0
                ? knownTotalSeconds
                : TotalAudiobookSeconds(chapters);
            if (totalSeconds is > 0)
            {
                inferredPagePosition = totalSeconds.Value * Math.Clamp(pageProgressPercent.Value, 0, 100) / 100d;
            }
        }

        var explicitPosition = chapters
            .Where(item => item.ResumePositionSeconds is > 0)
            .Select(item => item.ResumePositionSeconds!.Value)
            .OrderDescending()
            .FirstOrDefault();
        if (explicitPosition > 0)
        {
            if (explicitPosition <= Math.Max(0, nearStartGuardSeconds)
                && inferredPagePosition > explicitPosition + Math.Max(0, nearStartGuardSeconds))
            {
                return inferredPagePosition;
            }

            return explicitPosition;
        }

        var chapterProgressPosition = chapters
            .Where(item => item.ProgressPercent is > 0 and < 99.5)
            .Select(ResumePositionFor)
            .Where(position => position is > 0)
            .Select(position => position!.Value)
            .OrderDescending()
            .FirstOrDefault();
        if (chapterProgressPosition > 0)
        {
            return chapterProgressPosition;
        }

        if (inferredPagePosition is > 0)
        {
            return inferredPagePosition;
        }

        return null;
    }

    private double? ResolveAudiobookTotalSeconds(IReadOnlyList<MediaGroupingItemViewModel> chapters)
    {
        var total = TotalAudiobookSeconds(chapters);
        if (total is > 0)
        {
            return total;
        }

        foreach (var label in Model?.Metadata
                     .Where(item => string.Equals(item.Kind, "duration", StringComparison.OrdinalIgnoreCase))
                     .Select(item => item.Label) ?? [])
        {
            if (TryParseDurationSeconds(label) is { } seconds)
            {
                return seconds;
            }
        }

        foreach (var runtime in Model?.OwnedFormats
                     .Where(item => item.FormatType == MediaFormatType.Audiobook)
                     .Select(item => item.Runtime) ?? [])
        {
            if (TryParseDurationSeconds(runtime) is { } seconds)
            {
                return seconds;
            }
        }

        return null;
    }

    private static MediaGroupingItemViewModel? ChapterAtPosition(
        IReadOnlyList<MediaGroupingItemViewModel> chapters,
        double positionSeconds) =>
        chapters.LastOrDefault(item =>
        {
            var start = Math.Max(0, item.StartSeconds ?? 0);
            var end = item.EndSeconds ?? (item.DurationSeconds is > 0 ? start + item.DurationSeconds.Value : (double?)null);
            return positionSeconds >= start - 0.5d
                && (!end.HasValue || positionSeconds < end.Value - 0.5d);
        });

    private static double? TotalAudiobookSeconds(IReadOnlyList<MediaGroupingItemViewModel> chapters)
    {
        var maxEnd = chapters
            .Select(item => item.EndSeconds ?? (item.StartSeconds.HasValue && item.DurationSeconds.HasValue
                ? item.StartSeconds.Value + item.DurationSeconds.Value
                : item.DurationSeconds))
            .Where(seconds => seconds is > 0)
            .Select(seconds => seconds!.Value)
            .DefaultIfEmpty()
            .Max();

        if (maxEnd > 0)
        {
            return maxEnd;
        }

        var durations = chapters
            .Select(item => item.DurationSeconds)
            .Where(seconds => seconds is > 0)
            .Select(seconds => seconds!.Value)
            .ToList();
        return durations.Count == chapters.Count && durations.Count > 0
            ? durations.Sum()
            : null;
    }

    private static double? TryParseDurationSeconds(string? duration)
    {
        if (string.IsNullOrWhiteSpace(duration))
        {
            return null;
        }

        var trimmed = duration.Trim();
        var clockParts = trimmed.Split(':', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        if (clockParts.Length is 2 or 3 && clockParts.All(part => double.TryParse(part, NumberStyles.Float, CultureInfo.InvariantCulture, out _)))
        {
            var total = 0d;
            foreach (var part in clockParts)
            {
                total = total * 60d + double.Parse(part, NumberStyles.Float, CultureInfo.InvariantCulture);
            }

            return total > 0 ? total : null;
        }

        var matches = Regex.Matches(
            trimmed,
            @"(?<value>\d+(?:\.\d+)?)\s*(?<unit>hours?|hrs?|h|minutes?|mins?|m|seconds?|secs?|s)\b",
            RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
        if (matches.Count == 0)
        {
            return null;
        }

        var seconds = 0d;
        foreach (Match match in matches)
        {
            if (!double.TryParse(match.Groups["value"].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var value))
            {
                continue;
            }

            var unit = match.Groups["unit"].Value.ToLowerInvariant();
            seconds += unit[0] switch
            {
                'h' => value * 3600d,
                'm' => value * 60d,
                's' => value,
                _ => 0d,
            };
        }

        return seconds > 0 ? seconds : null;
    }

    private static bool IsCompletedChapter(MediaGroupingItemViewModel item) =>
        item.ProgressPercent is >= 99.5;

    private IReadOnlyList<MediaGroupingItemViewModel> AudiobookTracks() =>
        Model?.MediaGroups
            .Where(group => string.Equals(group.Key, "tracks", StringComparison.OrdinalIgnoreCase))
            .SelectMany(group => group.Items)
            .Where(item => item.EntityType is DetailEntityType.Audiobook or DetailEntityType.Work)
            .OrderBy(TrackSortKey)
            .ThenBy(item => item.Title, StringComparer.OrdinalIgnoreCase)
            .ToList()
        ?? [];

    private ListenQueueItem ToAudiobookQueueItem(MediaGroupingItemViewModel item, IReadOnlyList<MediaGroupingItemViewModel> chapters, double? initialPositionSeconds = null)
        => new()
        {
            WorkId = Guid.TryParse(item.Id, out var workId) ? workId : Guid.Empty,
            AssetId = Guid.TryParse(item.AssetId, out var assetId) ? assetId : null,
            MediaType = "Audiobooks",
            Title = Model?.Title ?? item.Title,
            Subtitle = item.Title,
            Album = Model?.Title,
            AudiobookWorkId = Guid.TryParse(Model?.Id, out var audiobookId) ? audiobookId : null,
            AuthorName = string.Join("; ", Model?.Facts?.Authors ?? []),
            NarratorName = string.Join("; ", Model?.Facts?.Narrators ?? []),
            Synopsis = Model?.Description,
            Authors = CanonicalAudiobookContributors(CreditGroupType.Authors),
            Narrators = CanonicalAudiobookContributors(CreditGroupType.Narrators),
            CoverUrl = item.ArtworkUrl ?? Model?.Artwork.CoverUrl ?? Model?.Artwork.PosterUrl,
            Duration = item.Duration,
            InitialPositionSeconds = initialPositionSeconds ?? ResumePositionFor(item),
            Chapters = chapters.Select(ToPlaybackChapter).ToList(),
            ChapterIndex = item.ChapterIndex,
        };

    private IReadOnlyList<PlaybackContributorIdentity> CanonicalAudiobookContributors(CreditGroupType groupType) =>
        Model?.ContributorGroups
            .Where(group => group.GroupType == groupType)
            .SelectMany(group => group.Credits)
            .Where(credit => !string.IsNullOrWhiteSpace(credit.DisplayName))
            .Select(credit => new PlaybackContributorIdentity(
                credit.DisplayName.Trim(),
                credit.EntityType == RelatedEntityType.Person && Guid.TryParse(credit.EntityId, out var personId) && personId != Guid.Empty
                    ? personId
                    : null))
            .ToList()
        ?? [];

    private static PlaybackChapterDto ToPlaybackChapter(MediaGroupingItemViewModel item)
        => new()
        {
            AssetId = Guid.TryParse(item.AssetId, out var assetId) ? assetId : null,
            Index = Math.Max(0, item.ChapterIndex ?? 0),
            Title = string.IsNullOrWhiteSpace(item.Title)
                ? $"Track {Math.Max(1, (item.ChapterIndex ?? 0) + 1)}"
                : item.Title.Trim(),
            StartSeconds = Math.Max(0, item.StartSeconds ?? 0),
            EndSeconds = item.EndSeconds,
        };

    private static double? ResumePositionFor(MediaGroupingItemViewModel item)
    {
        if (item.ResumePositionSeconds is > 0)
        {
            return item.ResumePositionSeconds;
        }

        if (item.ProgressPercent is > 0 and < 100)
        {
            var start = Math.Max(0, item.StartSeconds ?? 0);
            var end = item.EndSeconds;
            if (end is > 0 && end.Value > start)
            {
                return start + (end.Value - start) * Math.Clamp(item.ProgressPercent.Value, 0, 100) / 100d;
            }
        }

        return item.StartSeconds;
    }

    private static int TrackSortKey(MediaGroupingItemViewModel item)
        => int.TryParse(item.TrackNumber, out var parsed) ? parsed : int.MaxValue;

    private static string ResolveEditorMediaType(DetailEntityType entityType, DetailPresentationContext context)
        => entityType switch
        {
            DetailEntityType.Movie or DetailEntityType.MovieSeries => "Movies",
            DetailEntityType.TvShow or DetailEntityType.TvSeason or DetailEntityType.TvEpisode => "TV",
            DetailEntityType.Audiobook => "Audiobooks",
            DetailEntityType.ComicIssue or DetailEntityType.ComicSeries => "Comics",
            DetailEntityType.MusicAlbum => "Music",
            DetailEntityType.Book or DetailEntityType.BookSeries => "Books",
            _ when context == DetailPresentationContext.Watch => "Movies",
            _ when context == DetailPresentationContext.Listen => "Music",
            _ when context == DetailPresentationContext.Comics => "Comics",
            _ => "Books",
        };

}
