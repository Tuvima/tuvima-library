@namespace MediaEngine.Web.Components.Details
@using System.Globalization
@using System.Text.RegularExpressions
@using MediaEngine.Contracts.Details
@using Microsoft.JSInterop
@using MediaEngine.Contracts.Progress
@using MediaEngine.Contracts.Playback
@using MediaEngine.Contracts.Realtime
@using MediaEngine.Contracts.Universe
@using MediaEngine.Domain.Enums
@using MediaEngine.Web.Components.MediaEditor
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Contracts.Editing
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Navigation
@using MediaEngine.Web.Services.Playback
@inject IEngineApiClient ApiClient
@inject DeviceContextService DeviceContext
@inject SavedItemService SavedItems
@inject MediaReactionService Reactions
@inject PlaybackSessionController Playback
@inject UIOrchestratorService Orchestrator
@inject NavigationManager Nav
@inject IAppToastService Snackbar
@inject IAppDialogService Dialogs
@inject IJSRuntime JS
@inject IServiceProvider Services
@inject ILogger<DetailPage> Logger
@implements IDisposable

@if (Model is not null && _removed)
{
    @* Someone else deleted this title while it was open: the overlay stays, with a notice in place of the page. *@
    <article class="tl-detail-page tl-detail-page--removed">
        <RemovedItemNotice InputLabel="@_removedInputLabel"
                           InputText="@_removedInputText"
                           LostSectionInput="_removedLostSectionInput"
                           OnCopy="CopyRemovedInputAsync"
                           OnClose="CloseRemovedNoticeAsync" />
    </article>
}
else if (Model is not null)
{
    <CascadingValue Value="_editing" IsFixed="true">
    <CascadingValue Value="_batch" IsFixed="true">
    <CascadingValue Value="_preview" IsFixed="true">
    <article class="tl-detail-page">
        @* Editing: the bar is the first thing in the page's scroll container and sticks to its top; it is outside the
           hero because the full-bleed hero clips what overflows it. *@
        <EditingBar Mode="_editing"
                    Flow="_flow"
                    CanDelete="@CanDeleteFromLibrary"
                    GroupDeleteActions="GroupDeleteMenuActions"
                    GuardInternalNavigation="@(Overlay is null)"
                    OnActionSelected="HandleDetailActionAsync" />

        <section class="@DetailStageClass">
            @if (TemporaryArtworkSlot is { } temporarySlot)
            {
                <EditingTemporaryArtworkView Label="@ArtworkPickerRules.LabelFor(temporarySlot)"
                                             ImageUrl="@_preview.Artwork.TemporaryUrl(temporarySlot)"
                                             OnReturn="_artworkPicker.ReturnToNormalView" />
            }

            <DetailHero Model="Model"
                        CanDelete="@CanDeleteFromLibrary"
                        DeleteActions="GroupDeleteMenuActions"
                        OnActionSelected="HandleDetailActionAsync"
                        OnTabRequested="SetActiveTabAsync"
                        ActionAttributes="@(IsAudiobook ? AudiobookActionAttributes : null)" />

            @if (ShowDetailNavigation)
            {
                <div class="tl-detail-stage__navigation">
                    <DetailTabs Tabs="VisibleTabs"
                                ActiveTab="@CurrentActiveTab"
                                ActiveTabChanged="SetActiveTabAsync" />
                </div>
            }
        </section>

        @if (ShowPrimaryModuleAfterNavigation)
        {
            <section class="tl-detail-page__primary-content">
            <DetailPrimaryModule Model="Model"
                                 SelectedSeasonId="SelectedSeasonId"
                                 OnSeasonSelected="SelectedSeasonChanged"
                                 OnContainerSelected="HandleContainerSelectedAsync" />
            </section>
        }

        <section id="@CurrentActiveTab" class="tl-detail-body">
            @if (CurrentActiveTab is "overview")
            {
                @if (IsMusicAlbum)
                {
                    <MusicAlbumOverviewContent Model="Model" />
                }
                else
                {
                    <MediaEngine.Web.Components.Details.OverviewTab Model="Model"
                                                                     OnTabRequested="SetActiveTabAsync"
                                                                     OnContainerSelected="HandleContainerSelectedAsync" />
                }
                <ExtrasSection Extras="Model.Extras" />
            }
            else if (CurrentActiveTab is "tracks" && IsAudiobook)
            {
                <AudiobookTracksContent Model="Model" />
            }
            else if (CurrentActiveTab is "people" or "credits" or "cast")
            {
                <PeopleTab ContributorGroups="@(Model.FullContributorGroups.Count > 0 ? Model.FullContributorGroups : Model.ContributorGroups)"
                                        EpisodeId="@(Model.EntityType == DetailEntityType.TvEpisode ? Model.Id : null)"
                                        EpisodeContributorGroups="@(Model.EntityType == DetailEntityType.TvEpisode ? Model.ContributorGroups : null)" />
            }
            else
            {
                <DetailsTab Model="Model" />
            }
        </section>


        @* The right-hand panel of the editor: Details here (or the bulk panel while rows are ticked and the bar opened it), Match through the
           editor section it has always used. *@
        <EditSavedRibbon Flow="_flow" />
        <EditorPanelHost Mode="_editing" Flow="_flow" Picker="_artworkPicker" TitleOverride="@BulkPanelTitle" ShowHistory="true">
            @if (context == EditTool.Details)
            {
                @if (_batch.Panel != BulkPanelKind.None)
                {
                    <BulkEditPanel Selection="_batch" Pending="_flow.Session.Pending" CanEdit="@(_editing?.CanEdit == true)" />
                }
                else
                {
                    <EditorDetailsPanel Mode="_editing" Session="_flow.Session" />
                }
            }

            @if (context == EditTool.Match)
            {
                @if (_editing is { Fields.Loading: true })
                {
                    <EditorPanelBusy Label="Loading this item's match details" />
                }

                <EditorMatchPanel Subject="@(_editing is { Fields.Loading: false } ? _editing.Fields.MatchSubject() : null)"
                                  Session="_flow.Session"
                                  CanEdit="@(_editing?.CanEdit == true)"
                                  Mode="_editing"
                                  OnMatched="RefreshAfterSectionCommitAsync" />
                <EditorExtrasMovePanel Subject="@(_editing is { Fields.Loading: false } ? _editing.Fields.MatchSubject() : null)"
                                       Extras="Model.Extras"
                                       Session="_flow.Session"
                                       CanEdit="@(_editing?.CanEdit == true)" />
            }

            @if (context == EditTool.History)
            {
                <EditorHistoryTool EntityId="@(_flow.Session.ActiveItem?.EntityId ?? Guid.Empty)" />
            }
        </EditorPanelHost>
    </article>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
}

@code {
    [Parameter, EditorRequired] public DetailPageViewModel? Model { get; set; }
    [Parameter] public string? ActiveTab { get; set; }
    [Parameter] public EventCallback<string> ActiveTabChanged { get; set; }

    /// <summary>The season of a show the page address names; a refresh asks the Engine for the show on that season.</summary>
    [Parameter] public Guid? SelectedSeasonId { get; set; }
    [Parameter] public EventCallback<Guid> SelectedSeasonChanged { get; set; }

    /// <summary>Raised with each payload this page fetches itself, so the host keeps the newest one.</summary>
    [Parameter] public EventCallback<DetailPageViewModel> ModelRefreshed { get; set; }
    [Parameter] public EventCallback<DetailAction> OnActionSelected { get; set; }
    private IReadOnlyList<DetailTab> VisibleTabs =>
        Model is null ? [] : DetailTabNavigation.GetVisibleTabs(Model);

    private string CurrentActiveTab =>
        VisibleTabs.Any(tab => string.Equals(tab.Key, ActiveTab, StringComparison.OrdinalIgnoreCase))
            ? VisibleTabs.First(tab => string.Equals(tab.Key, ActiveTab, StringComparison.OrdinalIgnoreCase)).Key
            : VisibleTabs.FirstOrDefault()?.Key ?? "overview";

    private DetailPresentationCapabilities PresentationCapabilities =>
        DetailPresentationCapabilities.For(Model?.EntityType ?? DetailEntityType.Work);
    private bool IsMusicAlbum => PresentationCapabilities.IsMusicAlbum;
    private bool IsAudiobook => PresentationCapabilities.IsAudiobook
        || MediaKindClassifier.IsAudiobook(Model?.Facts?.MediaKind)
        || Model?.OwnedFormats.Any(format => format.FormatType == MediaFormatType.Audiobook) == true;
    private bool ShowDetailNavigation => Model?.EntityType != DetailEntityType.Person;
    // The Engine only offers "edit" to a person who may edit; the device rule is checked here again at the handler.
    private bool CanEditMedia => DeviceContext.CanEdit && Model?.OverflowActions.Any(action =>
        !action.IsDisabled && action.Key is "edit" or "edit-media") == true;

    // Editing Mode (the bar, side panel and floating artwork picker) serves items, people, series and curated collections.
    private EditingModeContext? _editing;

    // The universal editor on this page: the staged changes, the open tool, what the person does with them, and how the page shows them.
    private EditSessionFlow _flow = default!;
    private EditPendingPreview _preview = default!;
    private ArtworkPickerSession _artworkPicker = default!;

    // The rows ticked for the bulk panel, Move, Match and Delete (spec D14). It ends with Editing Mode; the rows ask the page to refresh through it.
    // What it stages goes into the same pending list as one item's edits, so the one Save changes (and its review) covers everything.
    private readonly BulkEditSelection _batch = new();
    private EditTool? _lastTool;
    private bool _bulkWasOpen;
    private Guid? _editingProfileId;
    private IDisposable? _overlayGuard;
    private IDisposable? _overlayEscape;

    protected override void OnInitialized()
    {
        _editing = new EditingModeContext(DeviceContext, new ItemFieldEditSession(ApiClient, DeviceContext, Logger))
        {
            Loader = LoadEditingFieldsAsync,
            AskSaveOrDiscard = () => EditingSaveOrDiscardDialog.AskAsync(Dialogs),
        };
        _editing.Changed += OnEditingChanged;
        _editing.Fields.Saved += RefreshAfterFieldSavedAsync;
        var session = new EditSessionState(new PendingEditList());
        _flow = new EditSessionFlow(session, _editing, new EditSessionSaver(ApiClient), EditTrail, () => EditingUnsavedChangesDialog.AskDiscardAsync(Dialogs))
        {
            Saved = RefreshAfterEditSavedAsync,
            MediaTypes = () => Model is null ? [] : [ResolveEditorMediaType(Model.EntityType, Model.PresentationContext)],
            OpenItem = OpenEditItemAsync,
            ItemSwitched = AfterEditItemSwitchedAsync,
        };
        _preview = new EditPendingPreview(session, _editing.Fields);
        _artworkPicker = new ArtworkPickerSession(ApiClient, session, _editing.Fields, _preview.Artwork, Logger);
        session.Changed += OnEditSessionChanged;
        _artworkPicker.Changed += OnEditSessionChanged;
        _batch.Changed += OnBatchChanged;
        _batch.RefreshAsync = RefreshAfterSectionCommitAsync;
        Orchestrator.OnLibraryItemsRemoved += OnLibraryItemsRemoved;
        UpdateEditingEligibility();
    }

    // A page that replaced one which followed its item here (a move removed the title it showed) picks Editing Mode back up: the mode
    // is on again, Match and Identity is open and the move's result line is showing, so following the surviving item does not end the edit.
    protected override async Task OnInitializedAsync() => await ResumeEditingAsync();

    private async Task ResumeEditingAsync()
    {
        if (_editing is null || Model is null || !Guid.TryParse(Model.Id, out var entityId)
            || EditResumeStore is not { } store || !store.TryTakeEditResume(entityId, out var resume))
        {
            return;
        }

        // The device or the person may no longer qualify: then the page simply opens to read, as a deep link would.
        if (!await _editing.EnterAsync() || _disposed)
        {
            return;
        }

        if (resume.Section == EditingSection.Match && !_editing.Fields.CanMatch)
        {
            // The new item cannot be matched, so there is no section to hold the line: say it here instead.
            if (!string.IsNullOrWhiteSpace(resume.ResultLine))
            {
                Snackbar.Add(resume.ResultLine, AppSeverity.Success);
            }

            return;
        }

        if (resume.SelectRow is { } row)
        {
            // A song's Edit: the song is ticked and the Edit panel opens for it, on the page it came from.
            await RowEditEntry.StartAsync(_editing, _batch, row);
            return;
        }

        _editing.OpenSection(resume.Section);
    }

    // The one-shot note lives in the overlay state: this page's own cascade when it is in the overlay, else the circuit's.
    private DetailsOverlayState? EditResumeStore => Overlay ?? Services.GetService<DetailsOverlayState>();

    protected override void OnParametersSet()
    {
        UpdateEditingCatalog();
        UpdateEditingEligibility();
        _batch.MediaType = Model is null ? null : ResolveEditorMediaType(Model.EntityType, Model.PresentationContext);
    }

    /// <summary>The details overlay this page is shown in; null when the page is rendered on its own.</summary>
    [CascadingParameter] public DetailsOverlayState? Overlay { get; set; }

    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        Orchestrator.OnLibraryItemsRemoved -= OnLibraryItemsRemoved;
        ReleaseOverlayGuards();
        if (_editing is null)
        {
            return;
        }

        _editing.Changed -= OnEditingChanged;
        _editing.Fields.Saved -= RefreshAfterFieldSavedAsync;
        _flow.Session.Changed -= OnEditSessionChanged;
        _artworkPicker.Changed -= OnEditSessionChanged;
        _batch.Changed -= OnBatchChanged;
        _flow.Dispose();
        _editing.Dispose();
    }

    // The staged changes changed (a field typed into, a tool opened): the hero, overview and bar show them. Leaving the Details tool
    // (the panel's close button, or another tool) also closes the bulk panel; the ticks and the staged changes stay.
    private void OnEditSessionChanged()
    {
        var tool = _flow.Session.ActiveTool;
        if (_lastTool == EditTool.Details && tool != EditTool.Details && _batch.Panel != BulkPanelKind.None)
        {
            _bulkWasOpen = false;
            _batch.ClosePanel();
        }

        _lastTool = tool;
        _ = InvokeAsync(StateHasChanged);
    }

    // The bar asked for a bulk panel, or the ticks ended: open the Details tool for it (settling an open section first), or close the tool
    // again when the last ticked row went and the panel was only there for them.
    private void OnBatchChanged() => _ = InvokeAsync(SyncBulkPanelAsync);

    private async Task SyncBulkPanelAsync()
    {
        if (_disposed || _editing is null)
        {
            return;
        }

        if (_batch.Panel != BulkPanelKind.None)
        {
            if (_editing is not { IsOn: true, CanEdit: true } || !_flow.Session.IsActive)
            {
                _batch.ClosePanel();
                return;
            }

            if (_editing.SectionOpen && !await _editing.CloseSectionAsync())
            {
                _batch.ClosePanel();
                return;
            }

            _bulkWasOpen = true;
            if (_flow.Session.ActiveTool != EditTool.Details)
            {
                _flow.Session.SetTool(EditTool.Details);
            }
        }
        else if (_bulkWasOpen)
        {
            _bulkWasOpen = false;
            if (_flow.Session.IsActive && _flow.Session.ActiveTool == EditTool.Details && !_editing.SectionOpen)
            {
                _flow.Session.SetTool(null);
            }
        }

        StateHasChanged();
    }

    // "Edit 4 songs", "Move to album", "Match": what the panel is called while the bulk panel is in it.
    private string? BulkPanelTitle => _batch.Panel switch
    {
        BulkPanelKind.Edit => BulkEditRules.EditTitle(_batch.Rows, _batch.MediaType),
        BulkPanelKind.Move => BulkEditRules.MoveLabel(_batch.Rows, _batch.MediaType),
        BulkPanelKind.Match => $"Match {_batch.Count} {BulkEditRules.Noun(_batch.Rows, _batch.MediaType)}",
        _ => null,
    };

    // Where the item being edited sits (spec D7): the page's own item with its parents (show > season > episode, artist > album > track), read
    // from the page the Dashboard already has. The same lists give each step of the bar the items it can switch to.
    private IReadOnlyList<EditTrailItem> EditTrail() =>
        _flow.Catalog.PageTrail.Count > 0
            ? _flow.Catalog.PageTrail
            : [new EditTrailItem(_editing?.Fields.EntityId ?? Guid.Empty, Model?.Title ?? "This item", "Item")];

    // Children found after the page loaded (the episodes of a season that was not open), kept across page refreshes.
    private readonly Dictionary<Guid, IReadOnlyList<EditTrailItem>> _lateChildren = [];
    private IReadOnlyList<EditTrailItem> _engineChain = [];
    private DetailPageViewModel? _catalogModel;

    private void UpdateEditingCatalog()
    {
        if (_flow is null || ReferenceEquals(_catalogModel, Model))
        {
            return;
        }

        _catalogModel = Model;
        var catalog = EditTrailCatalog.From(Model);
        catalog.AdoptAncestors(_engineChain);
        foreach (var (parent, children) in _lateChildren)
        {
            catalog.AddChildren(parent, children);
        }

        _flow.Catalog = catalog;
    }

    private bool IsPageItem(EditTrailItem item) =>
        _flow.Catalog.PageTrail is not { Count: > 0 } trail || trail[^1].EntityId == item.EntityId;

    // The fields of whatever the person is editing now: after a save or a section commit the editor reloads the item it is on, not the page's.
    private Task LoadEditingFieldsAsync() =>
        _flow.Session is { IsActive: true, ActiveItem: { } active } && !IsPageItem(active)
            ? LoadOtherItemFieldsAsync(active)
            : LoadPageItemFieldsAsync();

    // The person switched to an item of the page (spec D7): its fields load, the panel, the Artwork picker and Match follow, and nothing is
    // saved. Loading only asks for what the item needs; the library's genre and tag lists are reused. False keeps the person on their item.
    private async Task<bool> OpenEditItemAsync(EditTrailItem item)
    {
        if (_editing is null || Model is null || _disposed)
        {
            return false;
        }

        if (IsPageItem(item))
        {
            await LoadPageItemFieldsAsync();
        }
        else
        {
            await LoadOtherItemFieldsAsync(item);
        }

        // Another item must come back as the very item asked for: its changes are staged under that id.
        var fields = _editing.Fields;
        var ready = !_disposed && fields.Loaded && (IsPageItem(item) || fields.EntityId == item.EntityId);
        if (ready && item.Kind == EditTrailKinds.Season)
        {
            await EnsureSeasonChildrenAsync(item.EntityId);
        }

        return ready;
    }

    private async Task AfterEditItemSwitchedAsync()
    {
        // The Artwork picker keeps its tab where the new item has it; the History block rebuilds for the new item through its item key.
        if (_flow.Session.ActiveTool == EditTool.Artwork)
        {
            await _artworkPicker.FollowItemAsync();
        }
    }

    private static string? ScopeFor(EditTrailItem item) => EditTrailKinds.ScopeOf(item.Kind);

    private async Task LoadOtherItemFieldsAsync(EditTrailItem item)
    {
        if (_editing is null || Model is null)
        {
            return;
        }

        if (item.Kind == EditTrailKinds.Person)
        {
            await _editing.Fields.LoadSubjectAsync(item.EntityId);
            return;
        }

        await _editing.Fields.LoadAsync(
            item.EntityId,
            ResolveEditorMediaType(Model.EntityType, Model.PresentationContext),
            ScopeFor(item),
            _editingProfileId);
    }

    // A show page lists the episodes of the season it has open; another season's are fetched the first time the person switches to it.
    private async Task EnsureSeasonChildrenAsync(Guid seasonId)
    {
        if (Model is not { EntityType: DetailEntityType.TvShow } || !Guid.TryParse(Model.Id, out var showId) || _flow.Catalog.ChildrenOf(seasonId).Count > 0)
        {
            return;
        }

        try
        {
            var page = await ApiClient.GetDetailPageAsync(
                DetailEntityType.TvSeason, seasonId, Model.PresentationContext, containerId: showId.ToString("D"), sequence: EditTrailCatalog.SeasonWindow);
            var group = page?.SequencePlacement?.Groups.FirstOrDefault(candidate => Guid.TryParse(candidate.EntityId, out var id) && id == seasonId);
            var episodes = group is null ? [] : EditTrailCatalog.EpisodesOf(group);
            if (episodes.Count > 0 && !_disposed)
            {
                _lateChildren[seasonId] = episodes;
                _flow.Catalog.AddChildren(seasonId, episodes);
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "The episodes of season {SeasonId} could not be listed for the editing trail", seasonId);
        }
    }

    // The page's own item has loaded: the page keeps showing its staged values while another item is edited, and the Engine's chain for the
    // item fills in the parents the page does not name.
    private void RememberPageItem()
    {
        if (_editing is not { Fields.Loaded: true } editing)
        {
            return;
        }

        var fields = editing.Fields;
        _preview.PageEntityId = fields.EntityId;
        _preview.Artwork.PageArtworkEntityId = fields.ArtworkEntityId;
        var chain = fields.ScopeChain;
        if (chain.Count > 1 && chain[^1].EntityId == fields.EntityId)
        {
            _engineChain = chain;
            _flow.Catalog.AdoptAncestors(chain);
        }
    }

    private void OnEditingChanged()
    {
        if (_editing is { IsOn: false })
        {
            // Leaving Editing Mode (Done, a device change, a removed title) ends the ticks and the bulk panel with them.
            _batch.Clear();
        }

        SyncOverlayGuards();
        _ = InvokeAsync(StateHasChanged);
    }

    // While Editing Mode is on the overlay asks it before it closes (close button, Esc, backdrop, Back, a link to another
    // title): it settles unsaved input with "Save or discard?" and leaves the mode first. Esc is offered to it first too,
    // so Esc closes an open field, then an open section, and only then dismisses the overlay.
    private void SyncOverlayGuards()
    {
        if (_editing is { IsOn: true } && Overlay is not null)
        {
            _overlayGuard ??= Overlay.RegisterDismissGuard(_flow);
            _overlayEscape ??= Overlay.RegisterEscapeHandler(_flow.HandleEscapeAsync);
            return;
        }

        ReleaseOverlayGuards();
    }

    private void ReleaseOverlayGuards()
    {
        _overlayGuard?.Dispose();
        _overlayGuard = null;
        _overlayEscape?.Dispose();
        _overlayEscape = null;
    }

    /// <summary>
    /// Delete from library, in the page's "..." menu (with or without Editing Mode) and in the editing banner's "...": on a desktop
    /// for an effective administrator, and for a page that is one title (details overlay spec D18, D19). The Engine and
    /// <see cref="DeleteFromLibraryAsync"/> check again.
    /// </summary>
    private bool CanDeleteFromLibrary =>
        Model is not null
        && !_removed
        && (LibraryItemDeletionFlow.IsSingleTitle(Model.EntityType) || GroupTargets.Count > 0)
        && LibraryItemDeletionFlow.CanDelete(DeviceContext, Services.GetService<DashboardSessionAccessor>());

    /// <summary>
    /// The groups this page can delete (Delete a show, season, album or Series D2): a show page offers its show, and also the season
    /// selected in the season control, which has no page of its own; an album page its album; a book or comic Series page its Series.
    /// The season comes first so the menu reads "Delete Season 2…" above "Delete show…".
    /// </summary>
    private IReadOnlyList<LibraryGroupTarget> GroupTargets
    {
        get
        {
            if (Model is null || !Guid.TryParse(Model.Id, out var id) || !LibraryItemDeletionFlow.IsGroupPage(Model.EntityType))
            {
                return [];
            }

            var kind = Model.EntityType switch
            {
                DetailEntityType.TvShow => LibraryGroupKinds.Show,
                DetailEntityType.MusicAlbum => LibraryGroupKinds.Album,
                _ => LibraryGroupKinds.Series,
            };
            var owned = (Model.SequencePlacement?.Groups ?? [])
                .SelectMany(group => group.Items)
                .Concat(Model.SequencePlacement?.OrderedItems ?? [])
                .Where(item => item.IsOwned && Guid.TryParse(item.Id, out _))
                .Select(item => Guid.Parse(item.Id))
                .Distinct()
                .ToList();
            var targets = new List<LibraryGroupTarget>();
            if (kind == LibraryGroupKinds.Show
                && SelectedSeasonId is { } seasonId
                && Model.SequencePlacement?.Groups.FirstOrDefault(group =>
                    Guid.TryParse(group.EntityId, out var groupId) && groupId == seasonId && group.OwnedCount > 0) is { } season)
            {
                targets.Add(new LibraryGroupTarget(seasonId, LibraryGroupKinds.Season, season.Title, season.Items.Where(item => item.IsOwned && Guid.TryParse(item.Id, out _)).Select(item => Guid.Parse(item.Id)).ToList()));
            }

            targets.Add(new LibraryGroupTarget(id, kind, Model.Title, owned));
            return targets;
        }
    }

    // The "..." entries for a group page; null for a single title, whose menu keeps "Delete from library…".
    private IReadOnlyList<DetailAction>? GroupDeleteMenuActions
    {
        get
        {
            var targets = GroupTargets;
            return targets.Count == 0
                ? null
                : [.. targets.Select(target => DetailMenuGrouping.DeleteGroupAction(GroupDeleteLabel(target), target.Kind == LibraryGroupKinds.Season))];
        }
    }

    private static string GroupDeleteLabel(LibraryGroupTarget target) => target.Kind switch
    {
        LibraryGroupKinds.Season => $"Delete {target.Title}…",
        LibraryGroupKinds.Show => "Delete show…",
        LibraryGroupKinds.Album => "Delete album…",
        _ => "Delete Series…",
    };

    private void UpdateEditingEligibility()
    {
        if (_editing is null)
        {
            return;
        }

        var editAction = Model?.OverflowActions.FirstOrDefault(action => action.Key is "edit" or "edit-media");
        _editing.HasPermission = editAction is not null && SupportsEditingMode;
        _editing.UnavailableReason = editAction is { IsDisabled: true }
            ? editAction.Tooltip ?? "Editing is not available right now."
            : null;
    }

    private bool SupportsEditingMode => Model is not null && Guid.TryParse(Model.Id, out _);

    // People, series and curated collections edit through the same bar; the Engine describes what each one offers.
    private static bool IsSubjectKind(string entityKind) =>
        entityKind is "Person" or "StructuralCollection" or "Collection";

    private async Task LoadPageItemFieldsAsync()
    {
        if (_editing is null || Model is null || !Guid.TryParse(Model.Id, out var entityId))
        {
            return;
        }

        var target = ResolveEditorTarget(entityId);
        if (_editingProfileId is null)
        {
            var profile = await Orchestrator.GetActiveProfileAsync();
            _editingProfileId = profile?.Id;
        }

        if (IsSubjectKind(target.EntityKind))
        {
            await _editing.Fields.LoadSubjectAsync(target.EntityId);
            RememberPageItem();
            return;
        }

        await _editing.Fields.LoadAsync(
            target.EntityId,
            ResolveEditorMediaType(Model.EntityType, Model.PresentationContext),
            target.InitialScope,
            _editingProfileId);
        RememberPageItem();
    }

    // Save changes went through: refresh what the page shows, and reload the editor's fields so the next edit starts from the saved values.
    // A failed refresh never undoes the save; the page keeps what it had until the next load.
    private async Task RefreshAfterEditSavedAsync()
    {
        // Whatever the bulk panel read is out of date now (a change that failed stays staged and is read again on top of the saved values).
        _batch.NotifySaved();
        try
        {
            await RefreshCurrentDetailAsync();
            await LoadEditingFieldsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The detail page could not refresh after Save changes");
            Snackbar.Add("Saved, but the page could not refresh. Reload to see the change.", AppSeverity.Warning);
        }
    }

    // A field saved from a pencil: the item is already updated, so refresh what the page shows. A failed refresh
    // never undoes the save; the page simply keeps what it had until the next load.
    private async Task RefreshAfterFieldSavedAsync(string fieldKey)
    {
        try
        {
            await RefreshCurrentDetailAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The detail page could not refresh after {Field} was saved", fieldKey);
            Snackbar.Add("Saved, but the page could not refresh. Reload to see the change.", AppSeverity.Warning);
        }
    }

    private async Task RefreshAfterSectionCommitAsync()
    {
        try
        {
            await RefreshCurrentDetailAsync();
            if (_editing is { Fields.HasOpenDraft: false })
            {
                await LoadEditingFieldsAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The detail page could not refresh after an editing section saved a change");
            Snackbar.Add("Saved, but the page could not refresh. Reload to see the change.", AppSeverity.Warning);
        }
    }

    // Delete from library: the dialog is the only confirmation. While it is open (or once the page is on its way out) a live "removed"
    // event for this title must not also toast and navigate: the dialog's own answer does that.
    private bool _deleting;
    private bool _leaving;
    private bool _removedWhileDeleting;

    // Someone else deleted this title while the overlay showed it: the notice stands in for the page.
    private bool _removed;
    private string? _removedInputLabel;
    private string? _removedInputText;
    private bool _removedLostSectionInput;

    /// <summary>
    /// A video's "..." shortcuts (Videos spec D42): turn Editing Mode on if it is off, then open Match and Identity (Identify)
    /// or Manage Artwork on the cover (Change thumbnail). The device rule is checked here again, like Edit.
    /// </summary>
    private async Task OpenEditShortcutAsync(DetailAction action)
    {
        if (action.IsDisabled || EditorDeviceRule.TryRefuse(DeviceContext, Snackbar) || !CanEditMedia || _editing is not { HasPermission: true } editing)
        {
            return;
        }

        if (!editing.IsOn && !await editing.EnterAsync())
        {
            return;
        }

        if (action.Key == DetailActionKeys.Identify)
        {
            await editing.ShowSectionAsync(EditingSection.Match);
        }
        else
        {
            await editing.ShowSectionAsync(EditingSection.Artwork, "CoverArt");
        }
    }

    private async Task DeleteFromLibraryAsync(bool season = false)
    {
        if (Model is null || _deleting || _leaving || _removed || !Guid.TryParse(Model.Id, out var workId))
        {
            return;
        }

        // The entry only shows to an administrator on a desktop; a handler never trusts that.
        if (LibraryItemDeletionFlow.TryRefuse(DeviceContext, Services.GetService<DashboardSessionAccessor>(), Snackbar))
        {
            return;
        }

        if (!LibraryItemDeletionFlow.IsSingleTitle(Model.EntityType))
        {
            await DeleteGroupAsync(season);
            return;
        }

        _deleting = true;
        var outcome = LibraryItemDeletionFlowOutcome.Canceled;
        try
        {
            outcome = await LibraryItemDeletionFlow.RunAsync(Dialogs, Snackbar, [workId], Model.Title);
        }
        finally
        {
            _leaving = outcome != LibraryItemDeletionFlowOutcome.Canceled;
            _deleting = false;
        }

        if (_leaving)
        {
            await LeaveAfterRemovalAsync();
        }
        else if (_removedWhileDeleting && !_disposed)
        {
            // Cancelled, but someone else deleted this title while the dialog was open.
            await HandleRemovedByAnotherAsync();
        }
    }

    // Delete show, season, album or Series: the dialog asks the Engine for the whole group. Deleting a season leaves the show, so the page
    // stays and shows the show again; deleting anything else (or the last season) takes the page's own subject, so it closes as for a title.
    private async Task DeleteGroupAsync(bool season)
    {
        var target = GroupTargets.FirstOrDefault(candidate => (candidate.Kind == LibraryGroupKinds.Season) == season);
        if (target is null)
        {
            return;
        }

        _deleting = true;
        LibraryItemDeletionDialogResult? answer = null;
        try
        {
            answer = await LibraryItemDeletionFlow.RunGroupAsync(Dialogs, Snackbar, target);
        }
        finally
        {
            _leaving = answer is not null && (target.Kind != LibraryGroupKinds.Season || answer.RemovedParent);
            _deleting = false;
        }

        if (_leaving)
        {
            await LeaveAfterRemovalAsync();
        }
        else if (answer?.Deleted is not null && target.Kind == LibraryGroupKinds.Season && Guid.TryParse(Model?.Id, out var showId))
        {
            // The season is gone; the show page opens on its first season again.
            DetailsOverlayNavigation.ReplaceAddress(Nav, Overlay, $"/details/tvshow/{showId:D}");
        }
        else if (_removedWhileDeleting && !_disposed)
        {
            await HandleRemovedByAnotherAsync();
        }
    }

    // Another window (or another person) deleted the title this page shows.
    private void OnLibraryItemsRemoved(LibraryItemsRemovedEvent removed) => _ = InvokeAsync(async () =>
    {
        if (_disposed || _leaving || _removed || Model is null || !Guid.TryParse(Model.Id, out var id))
        {
            return;
        }

        if (!removed.WorkIds.Contains(id) && removed.GroupIds?.Contains(id) != true)
        {
            // A show, album, series or collection page that lists a deleted title refreshes so the row leaves it.
            if (!_deleting && ListsRemovedTitle(removed))
            {
                try
                {
                    await RefreshCurrentDetailAsync();
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "The detail page could not refresh after titles were deleted from the library");
                }
            }

            return;
        }

        if (_deleting)
        {
            _removedWhileDeleting = true;
            return;
        }

        await HandleRemovedByAnotherAsync();
    });

    // Not this page's own delete. In the overlay the person may have been typing, so it stays open with a notice (and a way to keep
    // the typed text); a page on its own says so in a toast and goes back, as before.
    private async Task HandleRemovedByAnotherAsync()
    {
        if (Overlay is { IsOpen: true })
        {
            ShowRemovedNotice();
            return;
        }

        _leaving = true;
        Snackbar.Add(LibraryItemDeletionText.NoLongerInLibrary, AppSeverity.Info);
        await LeaveAfterRemovalAsync();
    }

    // Editing Mode ends without asking (the item is gone, so there is nothing to save or discard); unsaved text from a pencil field
    // is kept for the notice. An open section's unsaved input lives inside the editor and cannot be read from here.
    private void ShowRemovedNotice()
    {
        if (_editing is { IsOn: true } editing)
        {
            var fields = editing.Fields;
            if (fields.IsDirty)
            {
                _removedInputText = fields.Draft;
                _removedInputLabel = fields.ActiveKey is { } key ? fields.Find(key)?.Label : null;
            }
            else
            {
                KeepStagedTextForNotice(fields);
            }

            _removedLostSectionInput = editing.SectionDirty;
            editing.Leave();
        }

        _removed = true;
        StateHasChanged();
    }

    // Changes staged in the universal editor are gone with the item; the notice offers their text so it can still be copied.
    private void KeepStagedTextForNotice(ItemFieldEditSession fields)
    {
        var staged = _flow.Session.Pending.Changes
            .Where(change => change.Kind == EditSessionChangeKinds.Details)
            .SelectMany(change => change.Fields)
            .Where(field => !string.IsNullOrWhiteSpace(field.Value))
            .ToList();
        if (staged.Count == 0)
        {
            return;
        }

        string Label(EditSessionFieldChange field) => fields.Find(field.Key)?.Label ?? field.Key;
        _removedInputLabel = staged.Count == 1 ? Label(staged[0]) : "Your changes";
        _removedInputText = staged.Count == 1
            ? staged[0].Value
            : string.Join(Environment.NewLine, staged.Select(field => $"{Label(field)}: {field.Value}"));
    }

    private async Task CopyRemovedInputAsync()
    {
        if (string.IsNullOrEmpty(_removedInputText))
        {
            return;
        }

        switch (await JS.TryCopyAsync(_removedInputText, Logger))
        {
            case ClipboardCopyResult.Copied:
                Snackbar.Add("Copied.", AppSeverity.Success);
                break;
            case ClipboardCopyResult.Failed:
                Snackbar.Add(ClipboardInterop.FailedMessage("the text"), AppSeverity.Warning);
                break;
        }
    }

    // Close is the overlay's own close path; nothing typed on a deleted title needs a guard.
    private async Task CloseRemovedNoticeAsync()
    {
        if (Overlay is { IsOpen: true } overlay)
        {
            await overlay.DismissAsync(force: true);
        }
    }

    private bool ListsRemovedTitle(LibraryItemsRemovedEvent removed) => Model is not null
        && (Model.MediaGroups.SelectMany(group => group.Items)
                .Any(item => Guid.TryParse(item.Id, out var workId) && removed.WorkIds.Contains(workId))
            || (Model.SequencePlacement?.Groups ?? []).SelectMany(group => group.Items)
                .Any(item => Guid.TryParse(item.Id, out var workId) && removed.WorkIds.Contains(workId)));

    // The title is gone: end Editing Mode (nothing typed matters now, and it must not ask) and go back to where the person came from.
    private async Task LeaveAfterRemovalAsync()
    {
        if (Model is null)
        {
            return;
        }

        var fallback = DetailOriginInterop.FallbackRoute(Model.EntityType, Model.Facts?.MediaKind);
        _editing?.Leave();
        if (Overlay is { IsOpen: true } overlay)
        {
            // In the overlay, "leave" is the close button's path: dismiss it entirely, back to the page under it.
            // Nothing typed on a deleted title matters, so no guard is asked.
            await overlay.DismissAsync(force: true);
            return;
        }

        if (!await JS.TryBackAsync(fallback, Logger) && !_disposed)
        {
            Nav.NavigateTo(fallback);
        }
    }

    private bool HasPrimaryModuleAfterNavigation => Model?.PrimaryModule.Kind is not
        (DetailPrimaryModuleKind.None or DetailPrimaryModuleKind.Tracks or DetailPrimaryModuleKind.Chapters);

    private bool ShowPrimaryModuleAfterNavigation =>
        HasPrimaryModuleAfterNavigation
        && CurrentActiveTab == "overview";

    // The slot the page is showing in its labelled temporary view (a season poster or episode still), or null in the normal view.
    private string? TemporaryArtworkSlot =>
        _flow.Session is { IsActive: true, ViewContext: EditViewContext.TemporaryArtwork } ? _preview.Artwork.TemporarySlot : null;

    private string DetailStageClass =>
        $"tl-detail-stage{(HasPrimaryModuleAfterNavigation ? " tl-detail-stage--with-primary" : " tl-detail-stage--identity-only")}" +
        $"{(TemporaryArtworkSlot is null ? string.Empty : " tl-detail-stage--temporary")}" +
        $"{(HasPrimaryModuleAfterNavigation ? " tl-detail-stage--primary-after-navigation" : string.Empty)}" +
        $"{(string.IsNullOrWhiteSpace(PresentationCapabilities.StageModifier) ? string.Empty : $" {PresentationCapabilities.StageModifier}")}" +
        $"{(Model?.EntityType == DetailEntityType.Person ? " tl-detail-stage--person" : string.Empty)}";

    private Task SetActiveTabAsync(string key) => ActiveTabChanged.InvokeAsync(key);

    private async Task HandleContainerSelectedAsync(SequenceContainerOptionViewModel option)
    {
        if (Model is null || string.IsNullOrWhiteSpace(option.ContainerId) || !Guid.TryParse(Model.Id, out var id))
            return;

        var updated = await ApiClient.GetDetailPageAsync(Model.EntityType, id, Model.PresentationContext, option.ContainerId, SequenceWindowQuery.Windowed);
        if (updated is not null && IsStillShowing(id))
        {
            Model = updated;
            await ModelRefreshed.InvokeAsync(updated);
        }
    }

    private async Task HandleDetailActionAsync(DetailAction action)
    {
        if (Model is null) return;
        if (action.Key == DetailActionKeys.PlayFromBeginning)
        {
            if (IsAudiobook) { await PlayAudiobookAsync(preferResume: false); return; }
            if (Model.EntityType == DetailEntityType.MusicAlbum) { await PlayAlbumAsync(shuffle: false); return; }
            if (Model.EntityType is DetailEntityType.Book or DetailEntityType.ComicIssue or DetailEntityType.Work)
            { await OpenReaderAsync(action, restart: true); return; }
        }
        if (action.Key == DetailActionKeys.Read)
        {
            await OpenReaderAsync(action);
            return;
        }

        if (action.Key is DetailActionKeys.PlayNext or DetailActionKeys.AddQueue)
        {
            var tracks = Model.MediaGroups.SelectMany(g => g.Items)
                .Where(item => item.EntityType == DetailEntityType.Work && item.IsOwned)
                .OrderBy(TrackSortKey).Select(ToQueueItem).Where(item => item.WorkId != Guid.Empty).ToList();
            if (action.Key == DetailActionKeys.PlayNext) tracks.Reverse();
            foreach (var track in tracks) await Playback.AddQueueItemAsync(track, next: action.Key == DetailActionKeys.PlayNext);
            Snackbar.Add($"Added {tracks.Count} tracks to the queue.", AppSeverity.Success);
            return;
        }
        if (action.Key == DetailActionKeys.AddPlaylist)
        {
            IReadOnlyList<Guid> works = Model.MediaGroups.SelectMany(g => g.Items)
                .Where(item => item.IsOwned && Guid.TryParse(item.Id, out _))
                .OrderBy(TrackSortKey)
                .Select(item => Guid.Parse(item.Id))
                .Distinct()
                .ToList();
            await Dialogs.ShowAsync<MediaMembershipDialog>(action.Label, new AppDialogParameters<MediaMembershipDialog> {
                { d => d.Playlist, true }, { d => d.WorkIds, works },
            });
            return;
        }
        if (DetailActionKeys.IsPersonalStatus(action.Key))
        {
            await HandlePersonalStatusAsync(action);
            return;
        }
        if (DetailActionKeys.IsUnmatchedAction(action.Key))
        {
            await HandleUnmatchedActionAsync(action);
            return;
        }
        if (action.Key is DetailActionKeys.EditMedia or DetailActionKeys.Edit)
        {
            if (action.IsDisabled) return;
            if (EditorDeviceRule.TryRefuse(DeviceContext, Snackbar)) return;
            if (!CanEditMedia) return;

            // Items, people, series and curated collections all edit in place. The menu entry only ever turns Editing Mode on;
            // choosing it while already editing keeps it on (Done is the way out).
            if (_editing is { HasPermission: true } && !_editing.IsOn)
            {
                await _editing.EnterAsync();
            }

            return;
        }

        if (action.Key is DetailActionKeys.Identify or DetailActionKeys.ChangeThumbnail)
        {
            await OpenEditShortcutAsync(action);
            return;
        }

        if (action.Key is DetailActionKeys.DeleteFromLibrary or DetailActionKeys.DeleteSeason)
        {
            await DeleteFromLibraryAsync(action.Key == DetailActionKeys.DeleteSeason);
            return;
        }

        if (action.Key == DetailActionKeys.MyList)
        {
            await ToggleFavoriteAsync(action);
            return;
        }

        if (action.Key is DetailActionKeys.ReactionDislike or DetailActionKeys.ReactionLike or DetailActionKeys.ReactionLove)
        {
            await SetReactionAsync(action);
            return;
        }

        if (action.Key == DetailActionKeys.Details)
        {
            await SetActiveTabAsync("details");
            return;
        }

        if (Model?.EntityType == DetailEntityType.MusicAlbum && action.Key is DetailActionKeys.PlayAlbum or DetailActionKeys.Shuffle)
        {
            await PlayAlbumAsync(shuffle: action.Key == DetailActionKeys.Shuffle);
            return;
        }

        if (action.Key == DetailActionKeys.ShuffleCollection)
        {
            await ShuffleStructuralContainerAsync();
            return;
        }

        var isAudiobookListenAction = string.Equals(action.Key, DetailActionKeys.Listen, StringComparison.OrdinalIgnoreCase)
            || string.Equals(action.Label, "Listen", StringComparison.OrdinalIgnoreCase);
        if (Model is not null && IsAudiobook && !action.IsDisabled
            && (isAudiobookListenAction || IsContinueAction(action)))
        {
            await PlayAudiobookAsync(IsContinueAction(action));
            return;
        }

        if (!string.IsNullOrWhiteSpace(action.Route))
        {
            Nav.NavigateTo(action.Route);
            return;
        }

        await OnActionSelected.InvokeAsync(action);
    }

    private bool _changingPersonalStatus;
    private async Task HandlePersonalStatusAsync(DetailAction action)
    {
        if (Model is null || _changingPersonalStatus) return;
        _changingPersonalStatus = true;
        try
        {
            if (action.Key == DetailActionKeys.StatusHistory)
            {
                var items = await ApiClient.GetPersonalHistoryAsync(Model.EntityType, Guid.Parse(Model.Id));
                await Dialogs.ShowAsync<PersonalHistoryDialog>(action.Label,
                    new AppDialogParameters<PersonalHistoryDialog> { { d => d.Items, items } });
                return;
            }
            var command = action.Key switch {
                DetailActionKeys.StatusComplete => PersonalStatusAction.Complete,
                DetailActionKeys.StatusReset => PersonalStatusAction.Reset,
                DetailActionKeys.StatusHide => PersonalStatusAction.HideContinue,
                DetailActionKeys.StatusShow => PersonalStatusAction.ShowContinue,
                _ => throw new InvalidOperationException("Unknown personal status action."),
            };
            var status = await ApiClient.GetPersonalStatusAsync(Model.EntityType, Guid.Parse(Model.Id))
                ?? throw new InvalidOperationException("Personal status could not be loaded. Please try again.");
            var result = await ApiClient.ChangePersonalStatusAsync(new(Guid.NewGuid(), Model.EntityType,
                Guid.Parse(Model.Id), command, status.Revision));
            await RefreshCurrentDetailAsync();
            Snackbar.Add($"Status updated for {result.AffectedCount} owned item(s).", AppSeverity.Success, options => {
                options.Action = "Undo";
                options.OnClick = async _ => {
                    try { await ApiClient.UndoPersonalStatusAsync(result.CommandId); await RefreshCurrentDetailAsync(); }
                    catch (Exception ex) { Snackbar.Add(ex.Message, AppSeverity.Error); }
                };
            });
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, AppSeverity.Error); }
        finally { _changingPersonalStatus = false; }
    }

    // Retry now, Keep as is and Look up again (Library setup spec D34, D40): each calls the Engine's Unmatched item route for every
    // file on this page it applies to (not-kept files for Retry and Keep, kept files for Look up again), then refreshes the page.
    // They are administrator actions, not edits, so the device rule does not apply; the Engine sends them only to administrators.
    private bool _changingUnmatched;
    private async Task HandleUnmatchedActionAsync(DetailAction action)
    {
        if (Model is null || _changingUnmatched) return;
        var lookUpAgain = action.Key == DetailActionKeys.UnmatchedLookUpAgain;
        var targets = Model.UnmatchedAssets
            .Where(asset => asset.KeptAsIs == lookUpAgain)
            .Select(asset => asset.AssetId)
            .ToList();
        if (targets.Count == 0) return;

        _changingUnmatched = true;
        try
        {
            if (action.Key == DetailActionKeys.UnmatchedKeep
                && await AppConfirmDialog.ShowAsync(
                    Dialogs,
                    "Keep as is?",
                    "Stop trying to match this? It stays under Unmatched, marked Kept. You can look it up again later.",
                    "Keep as is",
                    "Cancel") != AppConfirmResult.Primary)
            {
                return;
            }

            var failed = 0;
            foreach (var assetId in targets)
            {
                var result = action.Key switch
                {
                    DetailActionKeys.UnmatchedRetry => await ApiClient.RetryUnmatchedItemAsync(assetId),
                    DetailActionKeys.UnmatchedKeep => await ApiClient.KeepUnmatchedItemAsync(assetId),
                    _ => await ApiClient.LookUpUnmatchedItemAgainAsync(assetId),
                };
                if (result is null) failed++;
            }

            if (failed == targets.Count)
            {
                Snackbar.Add("That could not be done. Try again in a moment.", AppSeverity.Warning);
            }
            else if (failed > 0)
            {
                Snackbar.Add($"Done for {targets.Count - failed} of {targets.Count} files; {failed} could not be changed.", AppSeverity.Warning);
            }
            else
            {
                Snackbar.Add(action.Key switch
                {
                    DetailActionKeys.UnmatchedRetry => "Looking it up again now.",
                    DetailActionKeys.UnmatchedKeep => "Kept as is.",
                    _ => "Looking it up again.",
                }, AppSeverity.Success);
            }

            await RefreshCurrentDetailAsync();
        }
        finally { _changingUnmatched = false; }
    }

    private (Guid EntityId, string EntityKind, string ContainerMode, string? InitialTab, string? InitialScope) ResolveEditorTarget(Guid fallbackEntityId)
    {
        var target = Model?.EditorTarget;
        if (Model?.EntityType is DetailEntityType.BookSeries or DetailEntityType.ComicSeries or DetailEntityType.MovieSeries)
            return (fallbackEntityId, "StructuralCollection", "Collection", "details", null);
        return target is not null && Guid.TryParse(target.EntityId, out var targetId)
            ? (targetId, target.EntityKind, target.ContainerMode, target.InitialTab, target.InitialScope)
            : (fallbackEntityId, Model?.EntityType.ToString() ?? "Work", "Canonical", "details", null);
    }

    private async Task RefreshCurrentDetailAsync()
    {
        if (Model is null || !Guid.TryParse(Model.Id, out var entityId))
            return;

        // A show page the person moved to a season asks for that season again, so the refresh keeps it (D19).
        var updated = SelectedSeasonId is { } seasonId && Model.EntityType == DetailEntityType.TvShow
            ? await ApiClient.GetDetailPageAsync(DetailEntityType.TvSeason, seasonId, Model.PresentationContext, containerId: entityId.ToString("D"), sequence: SequenceWindowQuery.Windowed)
            : await ApiClient.GetDetailPageAsync(Model.EntityType, entityId, Model.PresentationContext, containerId: Model.EntityType == DetailEntityType.TvEpisode ? Model.SequencePlacement?.ContainerId : null, sequence: SequenceWindowQuery.Windowed);
        if (updated is not null && IsStillShowing(entityId))
        {
            Model = updated;
            await ModelRefreshed.InvokeAsync(updated);
            StateHasChanged();
        }
    }

    // A refresh that lands after the person moved on (this page disposed, or a different item put in its place)
    // must not replace what they are looking at now.
    private bool IsStillShowing(Guid entityId) =>
        !_disposed && Model is not null && Guid.TryParse(Model.Id, out var currentId) && currentId == entityId;

    private async Task OpenReaderAsync(DetailAction action, bool restart = false)
    {
        if (!string.IsNullOrWhiteSpace(action.Route) && action.Route.StartsWith("/read/", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo(restart ? Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(action.Route, "restart", "true") : action.Route);
            return;
        }

        if (Model is null || !Guid.TryParse(Model.Id, out var workId))
        {
            await OnActionSelected.InvokeAsync(action);
            return;
        }

        var assetId = await ApiClient.ResolveWorkToAssetAsync(workId);
        if (assetId.HasValue)
        {
            Nav.NavigateTo($"/read/{assetId.Value:D}{(restart ? "?restart=true" : "")}");
            return;
        }

        await OnActionSelected.InvokeAsync(action);
    }

    private async Task ToggleFavoriteAsync(DetailAction action)
    {
        if (Model is null)
            return;

        var profile = await Orchestrator.GetActiveProfileAsync();
        if (!TryResolveProfileEntity(out var entityKind, out var entityId))
        {
            Snackbar.Add("This item cannot be added to My List yet.", AppSeverity.Warning);
            return;
        }

        if (profile is null)
        {
            Snackbar.Add("My List requires an active profile.", AppSeverity.Warning);
            return;
        }

        var membership = await SavedItems.ToggleAsync(entityKind, entityId);
        if (membership is null)
        {
            Snackbar.Add("My List could not be updated.", AppSeverity.Warning);
            return;
        }

        SetFavoriteSelection(Model.PrimaryActions, membership.IsSaved);
        SetFavoriteSelection(Model.SecondaryActions, membership.IsSaved);
        SetFavoriteSelection(Model.OverflowActions, membership.IsSaved);
        action.IsSelected = membership.IsSaved;
        Snackbar.Add(membership.IsSaved ? "Added to My List." : "Removed from My List.", AppSeverity.Success);
        StateHasChanged();
        await OnActionSelected.InvokeAsync(action);
    }

    private bool TryResolveProfileEntity(out ProfileEntityKind entityKind, out Guid entityId)
    {
        entityKind = Model?.EntityType switch
        {
            DetailEntityType.Movie => ProfileEntityKind.Movie,
            DetailEntityType.TvShow or DetailEntityType.TvSeason or DetailEntityType.TvEpisode => ProfileEntityKind.TvShow,
            DetailEntityType.Book or DetailEntityType.Work => ProfileEntityKind.Book,
            DetailEntityType.ComicIssue => ProfileEntityKind.Comic,
            DetailEntityType.Audiobook => ProfileEntityKind.Audiobook,
            DetailEntityType.MusicAlbum => ProfileEntityKind.Album,
            DetailEntityType.Collection => ProfileEntityKind.Collection,
            _ => default,
        };
        entityId = Guid.Empty;
        return Model is not null
               && Model.EntityType is DetailEntityType.Movie
                   or DetailEntityType.TvShow
                   or DetailEntityType.TvSeason
                   or DetailEntityType.TvEpisode
                   or DetailEntityType.Book
                   or DetailEntityType.Work
                   or DetailEntityType.ComicIssue
                   or DetailEntityType.Audiobook
                   or DetailEntityType.MusicAlbum
                   or DetailEntityType.Collection
               && Guid.TryParse(Model.Id, out entityId);
    }

    private static void SetFavoriteSelection(IEnumerable<DetailAction> actions, bool isFavorite)
    {
        foreach (var item in actions)
        {
            if (item.Key == "my-list")
                item.IsSelected = isFavorite;

            SetFavoriteSelection(item.Children, isFavorite);
        }
    }

    private async Task SetReactionAsync(DetailAction action)
    {
        if (!TryResolveProfileEntity(out var entityKind, out var workId))
        {
            Snackbar.Add("This item cannot be rated yet.", AppSeverity.Warning);
            return;
        }

        var reaction = action.Key switch
        {
            "reaction-dislike" => MediaReaction.Dislike,
            "reaction-like" => MediaReaction.Like,
            "reaction-love" => MediaReaction.Love,
            _ => MediaReaction.Neutral,
        };

        var profile = await Orchestrator.GetActiveProfileAsync();
        var current = await Reactions.GetReactionAsync(workId, profile?.Id, entityKind);
        var next = MediaReactionService.ToggleRating(current, reaction);
        await Reactions.SetReactionAsync(workId, next, profile?.Id, entityKind);
        if (Model is not null)
        {
            SetReactionSelection(Model.PrimaryActions, next);
            SetReactionSelection(Model.SecondaryActions, next);
            SetReactionSelection(Model.OverflowActions, next);
        }
        StateHasChanged();
        await OnActionSelected.InvokeAsync(action);
    }

    private static void SetReactionSelection(IEnumerable<DetailAction> actions, MediaReaction selected)
    {
        foreach (var item in actions)
        {
            item.IsSelected = item.Key switch
            {
                "reaction-menu" => selected is MediaReaction.Like or MediaReaction.Love,
                "reaction-dislike" => selected == MediaReaction.Dislike,
                "reaction-like" => selected is MediaReaction.Like or MediaReaction.Love,
                "reaction-love" => selected == MediaReaction.Love,
                _ => item.IsSelected,
            };
            SetReactionSelection(item.Children, selected);
        }
    }

    private async Task PlayAlbumAsync(bool shuffle)
    {
        if (Model is null)
            return;

        var trackGroups = Model.PrimaryModule.GroupKeys.Count == 0
            ? Model.MediaGroups
            : Model.MediaGroups.Where(group => Model.PrimaryModule.GroupKeys.Contains(group.Key, StringComparer.OrdinalIgnoreCase));
        var tracks = trackGroups
            .SelectMany(group => group.Items)
            .Where(item => item.IsOwned && Guid.TryParse(item.Id, out _))
            .OrderBy(TrackSortKey)
            .ThenBy(item => item.Title, StringComparer.OrdinalIgnoreCase)
            .Select(ToQueueItem)
            .Where(item => item.WorkId != Guid.Empty)
            .ToList();

        if (tracks.Count == 0)
        {
            Snackbar.Add("This album has no playable owned tracks.", AppSeverity.Info);
            return;
        }

        await Playback.ReplaceQueueItemsAsync(tracks, 0, Model.Title, shuffle);
    }

    private async Task ShuffleStructuralContainerAsync()
    {
        if (Model is null)
            return;

        var candidates = Model.MediaGroups
            .SelectMany(group => group.Items)
            .Where(item => item.IsOwned && Guid.TryParse(item.Id, out _))
            .DistinctBy(item => $"{item.EntityType}:{item.Id}", StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (candidates.Count == 0)
        {
            Snackbar.Add("This collection has no owned items to shuffle.", AppSeverity.Info);
            return;
        }

        var item = candidates[Random.Shared.Next(candidates.Count)];
        var workId = Guid.Parse(item.Id);
        if (item.EntityType is DetailEntityType.Movie or DetailEntityType.TvEpisode)
        {
            Nav.NavigateTo($"/watch/player/{workId:D}");
            return;
        }

        if (item.EntityType is DetailEntityType.Book or DetailEntityType.ComicIssue)
        {
            var assetId = Guid.TryParse(item.AssetId, out var parsedAssetId)
                ? parsedAssetId
                : await ApiClient.ResolveWorkToAssetAsync(workId);
            if (assetId.HasValue)
            {
                Nav.NavigateTo($"/read/{assetId.Value:D}");
                return;
            }
        }

        if (item.EntityType == DetailEntityType.Work)
        {
            await Playback.ReplaceQueueItemsAsync([ToQueueItem(item)], 0, Model.Title, shuffle: false);
            return;
        }

        var route = item.Actions.FirstOrDefault(action => !string.IsNullOrWhiteSpace(action.Route))?.Route;
        if (!string.IsNullOrWhiteSpace(route))
        {
            Nav.NavigateTo(route);
            return;
        }

        Snackbar.Add("The selected item cannot be opened yet.", AppSeverity.Warning);
    }

    private ListenQueueItem ToQueueItem(MediaGroupingItemViewModel item)
        => new()
        {
            WorkId = Guid.TryParse(item.Id, out var workId) ? workId : Guid.Empty,
            AssetId = Guid.TryParse(item.AssetId, out var assetId) ? assetId : null,
            MediaType = "Music",
            Title = item.Title,
            Subtitle = item.Artist,
            Album = Model?.Title,
            AlbumWorkId = Guid.TryParse(Model?.Id, out var albumId) ? albumId : null,
            ArtistPersonId = Guid.TryParse(Model?.MusicAlbumCompanion?.PrimaryArtistId, out var artistId) ? artistId : null,
            CoverUrl = item.ArtworkUrl ?? Model?.Artwork.CoverUrl ?? Model?.Artwork.PosterUrl,
            Duration = item.Duration,
            InitialPositionSeconds = item.StartSeconds,
        };

    private async Task PlayAudiobookAsync(bool preferResume)
    {
        if (Model is null)
            return;

        var chapters = AudiobookTracks();

        if (chapters.Count == 0)
            return;

        var totalDurationSeconds = ResolveAudiobookTotalSeconds(chapters);
        var resumePositionSeconds = preferResume
            ? ResolveAudiobookResumePosition(chapters, Model.Progress?.Percent, Playback.AudiobookNearStartGuardSeconds, totalDurationSeconds)
            : 0d;
        var startItem = preferResume
            ? ResolveAudiobookResumeItem(chapters, resumePositionSeconds)
            : chapters.FirstOrDefault();
        if (startItem is null)
            return;

        var item = ToAudiobookQueueItem(startItem, chapters, resumePositionSeconds);
        if (item.WorkId == Guid.Empty)
            return;

        await Playback.StartAudiobookAsync(
            new AudiobookStartRequest(
                item,
                preferResume ? AudiobookStartKinds.Resume : AudiobookStartKinds.Chapter,
                resumePositionSeconds,
                startItem.ChapterIndex,
                Model.Title));
    }

    private IReadOnlyDictionary<string, object>? AudiobookActionAttributes(DetailAction action)
    {
        var model = Model;
        var isListenAction = string.Equals(action.Key, "listen", StringComparison.OrdinalIgnoreCase)
            || string.Equals(action.Label, "Listen", StringComparison.OrdinalIgnoreCase);
        if (model is null || !IsAudiobook || action.IsDisabled || (!isListenAction && !IsContinueAction(action)))
        {
            return null;
        }

        var chapters = AudiobookTracks();
        if (chapters.Count == 0)
        {
            return null;
        }

        var preferResume = IsContinueAction(action);
        var totalDurationSeconds = ResolveAudiobookTotalSeconds(chapters);
        var resumePositionSeconds = preferResume
            ? ResolveAudiobookResumePosition(chapters, model.Progress?.Percent, Playback.AudiobookNearStartGuardSeconds, totalDurationSeconds)
            : null;
        var startItem = preferResume
            ? ResolveAudiobookResumeItem(chapters, resumePositionSeconds)
            : chapters.FirstOrDefault();
        if (startItem is null || !Guid.TryParse(startItem.AssetId, out var assetId))
        {
            return null;
        }

        var positionSeconds = resumePositionSeconds ?? ResumePositionFor(startItem) ?? startItem.StartSeconds ?? 0;
        if (preferResume && positionSeconds > 0)
        {
            positionSeconds = Math.Max(0, positionSeconds - Playback.ResumeRewindSeconds);
        }

        var playbackRate = Playback.IsAudiobookMode
            ? Playback.PlaybackRate
            : (double)new ListeningSettingsDto().AudiobookDefaultSpeed;

        return new Dictionary<string, object>
        {
            ["data-listen-immediate-start"] = "audiobook",
            ["data-listen-start-kind"] = preferResume ? AudiobookStartKinds.Resume : AudiobookStartKinds.Chapter,
            ["data-listen-start-url"] = $"/engine-stream/{assetId:D}",
            ["data-listen-start-position"] = positionSeconds.ToString("0.###", CultureInfo.InvariantCulture),
            ["data-listen-start-progress"] = (model.Progress?.Percent ?? 0).ToString("0.###", CultureInfo.InvariantCulture),
            ["data-listen-start-duration"] = (totalDurationSeconds ?? 0).ToString("0.###", CultureInfo.InvariantCulture),
            ["data-listen-start-rewind"] = (preferResume ? Playback.ResumeRewindSeconds : 0).ToString(CultureInfo.InvariantCulture),
            ["data-listen-start-rate"] = playbackRate.ToString("0.###", CultureInfo.InvariantCulture),
            ["data-listen-start-volume"] = Playback.Volume.ToString("0.###", CultureInfo.InvariantCulture),
            ["data-listen-start-muted"] = Playback.IsMuted ? "true" : "false",
        };
    }

    private static bool IsContinueAction(DetailAction action) =>
        string.Equals(action.Key, "continue", StringComparison.OrdinalIgnoreCase)
        || string.Equals(action.Label, "Continue", StringComparison.OrdinalIgnoreCase)
        || string.Equals(action.Label, "Continue Listening", StringComparison.OrdinalIgnoreCase);

    private static MediaGroupingItemViewModel? ResolveAudiobookResumeItem(
        IReadOnlyList<MediaGroupingItemViewModel> chapters,
        double? resumePositionSeconds)
    {
        if (resumePositionSeconds is > 0)
        {
            return ChapterAtPosition(chapters, resumePositionSeconds.Value)
                ?? chapters.FirstOrDefault(item => item.ResumePositionSeconds is > 0)
                ?? chapters.FirstOrDefault(item => item.ProgressPercent is > 0 and < 99.5)
                ?? chapters.FirstOrDefault(item => !IsCompletedChapter(item))
                ?? chapters.FirstOrDefault();
        }

        return chapters.FirstOrDefault(item => item.ResumePositionSeconds is > 0)
            ?? chapters.FirstOrDefault(item => item.ProgressPercent is > 0 and < 99.5)
            ?? chapters.FirstOrDefault(item => !IsCompletedChapter(item))
            ?? chapters.FirstOrDefault();
    }

    private static double? ResolveAudiobookResumePosition(
        IReadOnlyList<MediaGroupingItemViewModel> chapters,
        double? pageProgressPercent,
        int nearStartGuardSeconds,
        double? knownTotalSeconds = null)
    {
        double? inferredPagePosition = null;
        if (pageProgressPercent is > 0 and < 99.5)
        {
            var totalSeconds = knownTotalSeconds is > 0
                ? knownTotalSeconds
                : TotalAudiobookSeconds(chapters);
            if (totalSeconds is > 0)
            {
                inferredPagePosition = totalSeconds.Value * Math.Clamp(pageProgressPercent.Value, 0, 100) / 100d;
            }
        }

        var explicitPosition = chapters
            .Where(item => item.ResumePositionSeconds is > 0)
            .Select(item => item.ResumePositionSeconds!.Value)
            .OrderDescending()
            .FirstOrDefault();
        if (explicitPosition > 0)
        {
            if (explicitPosition <= Math.Max(0, nearStartGuardSeconds)
                && inferredPagePosition > explicitPosition + Math.Max(0, nearStartGuardSeconds))
            {
                return inferredPagePosition;
            }

            return explicitPosition;
        }

        var chapterProgressPosition = chapters
            .Where(item => item.ProgressPercent is > 0 and < 99.5)
            .Select(ResumePositionFor)
            .Where(position => position is > 0)
            .Select(position => position!.Value)
            .OrderDescending()
            .FirstOrDefault();
        if (chapterProgressPosition > 0)
        {
            return chapterProgressPosition;
        }

        if (inferredPagePosition is > 0)
        {
            return inferredPagePosition;
        }

        return null;
    }

    private double? ResolveAudiobookTotalSeconds(IReadOnlyList<MediaGroupingItemViewModel> chapters)
    {
        var total = TotalAudiobookSeconds(chapters);
        if (total is > 0)
        {
            return total;
        }

        foreach (var label in Model?.Metadata
                     .Where(item => string.Equals(item.Kind, "duration", StringComparison.OrdinalIgnoreCase))
                     .Select(item => item.Label) ?? [])
        {
            if (TryParseDurationSeconds(label) is { } seconds)
            {
                return seconds;
            }
        }

        foreach (var runtime in Model?.OwnedFormats
                     .Where(item => item.FormatType == MediaFormatType.Audiobook)
                     .Select(item => item.Runtime) ?? [])
        {
            if (TryParseDurationSeconds(runtime) is { } seconds)
            {
                return seconds;
            }
        }

        return null;
    }

    private static MediaGroupingItemViewModel? ChapterAtPosition(
        IReadOnlyList<MediaGroupingItemViewModel> chapters,
        double positionSeconds) =>
        chapters.LastOrDefault(item =>
        {
            var start = Math.Max(0, item.StartSeconds ?? 0);
            var end = item.EndSeconds ?? (item.DurationSeconds is > 0 ? start + item.DurationSeconds.Value : (double?)null);
            return positionSeconds >= start - 0.5d
                && (!end.HasValue || positionSeconds < end.Value - 0.5d);
        });

    private static double? TotalAudiobookSeconds(IReadOnlyList<MediaGroupingItemViewModel> chapters)
    {
        var maxEnd = chapters
            .Select(item => item.EndSeconds ?? (item.StartSeconds.HasValue && item.DurationSeconds.HasValue
                ? item.StartSeconds.Value + item.DurationSeconds.Value
                : item.DurationSeconds))
            .Where(seconds => seconds is > 0)
            .Select(seconds => seconds!.Value)
            .DefaultIfEmpty()
            .Max();

        if (maxEnd > 0)
        {
            return maxEnd;
        }

        var durations = chapters
            .Select(item => item.DurationSeconds)
            .Where(seconds => seconds is > 0)
            .Select(seconds => seconds!.Value)
            .ToList();
        return durations.Count == chapters.Count && durations.Count > 0
            ? durations.Sum()
            : null;
    }

    private static double? TryParseDurationSeconds(string? duration)
    {
        if (string.IsNullOrWhiteSpace(duration))
        {
            return null;
        }

        var trimmed = duration.Trim();
        var clockParts = trimmed.Split(':', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        if (clockParts.Length is 2 or 3 && clockParts.All(part => double.TryParse(part, NumberStyles.Float, CultureInfo.InvariantCulture, out _)))
        {
            var total = 0d;
            foreach (var part in clockParts)
            {
                total = total * 60d + double.Parse(part, NumberStyles.Float, CultureInfo.InvariantCulture);
            }

            return total > 0 ? total : null;
        }

        var matches = Regex.Matches(
            trimmed,
            @"(?<value>\d+(?:\.\d+)?)\s*(?<unit>hours?|hrs?|h|minutes?|mins?|m|seconds?|secs?|s)\b",
            RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
        if (matches.Count == 0)
        {
            return null;
        }

        var seconds = 0d;
        foreach (Match match in matches)
        {
            if (!double.TryParse(match.Groups["value"].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var value))
            {
                continue;
            }

            var unit = match.Groups["unit"].Value.ToLowerInvariant();
            seconds += unit[0] switch
            {
                'h' => value * 3600d,
                'm' => value * 60d,
                's' => value,
                _ => 0d,
            };
        }

        return seconds > 0 ? seconds : null;
    }

    private static bool IsCompletedChapter(MediaGroupingItemViewModel item) =>
        item.ProgressPercent is >= 99.5;

    private IReadOnlyList<MediaGroupingItemViewModel> AudiobookTracks() =>
        Model?.MediaGroups
            .Where(group => string.Equals(group.Key, "tracks", StringComparison.OrdinalIgnoreCase))
            .SelectMany(group => group.Items)
            .Where(item => item.EntityType is DetailEntityType.Audiobook or DetailEntityType.Work)
            .OrderBy(TrackSortKey)
            .ThenBy(item => item.Title, StringComparer.OrdinalIgnoreCase)
            .ToList()
        ?? [];

    private ListenQueueItem ToAudiobookQueueItem(MediaGroupingItemViewModel item, IReadOnlyList<MediaGroupingItemViewModel> chapters, double? initialPositionSeconds = null)
        => new()
        {
            WorkId = Guid.TryParse(item.Id, out var workId) ? workId : Guid.Empty,
            AssetId = Guid.TryParse(item.AssetId, out var assetId) ? assetId : null,
            MediaType = "Audiobooks",
            Title = Model?.Title ?? item.Title,
            Subtitle = item.Title,
            Album = Model?.Title,
            AudiobookWorkId = Guid.TryParse(Model?.Id, out var audiobookId) ? audiobookId : null,
            AuthorName = string.Join("; ", Model?.Facts?.Authors ?? []),
            NarratorName = string.Join("; ", Model?.Facts?.Narrators ?? []),
            Synopsis = Model?.Description,
            Authors = CanonicalAudiobookContributors(CreditGroupType.Authors),
            Narrators = CanonicalAudiobookContributors(CreditGroupType.Narrators),
            CoverUrl = item.ArtworkUrl ?? Model?.Artwork.CoverUrl ?? Model?.Artwork.PosterUrl,
            Duration = item.Duration,
            InitialPositionSeconds = initialPositionSeconds ?? ResumePositionFor(item),
            Chapters = chapters.Select(ToPlaybackChapter).ToList(),
            ChapterIndex = item.ChapterIndex,
        };

    private IReadOnlyList<PlaybackContributorIdentity> CanonicalAudiobookContributors(CreditGroupType groupType) =>
        Model?.ContributorGroups
            .Where(group => group.GroupType == groupType)
            .SelectMany(group => group.Credits)
            .Where(credit => !string.IsNullOrWhiteSpace(credit.DisplayName))
            .Select(credit => new PlaybackContributorIdentity(
                credit.DisplayName.Trim(),
                credit.EntityType == RelatedEntityType.Person && Guid.TryParse(credit.EntityId, out var personId) && personId != Guid.Empty
                    ? personId
                    : null))
            .ToList()
        ?? [];

    private static PlaybackChapterDto ToPlaybackChapter(MediaGroupingItemViewModel item)
        => new()
        {
            AssetId = Guid.TryParse(item.AssetId, out var assetId) ? assetId : null,
            Index = Math.Max(0, item.ChapterIndex ?? 0),
            Title = string.IsNullOrWhiteSpace(item.Title)
                ? $"Track {Math.Max(1, (item.ChapterIndex ?? 0) + 1)}"
                : item.Title.Trim(),
            StartSeconds = Math.Max(0, item.StartSeconds ?? 0),
            EndSeconds = item.EndSeconds,
        };

    private static double? ResumePositionFor(MediaGroupingItemViewModel item)
    {
        if (item.ResumePositionSeconds is > 0)
        {
            return item.ResumePositionSeconds;
        }

        if (item.ProgressPercent is > 0 and < 100)
        {
            var start = Math.Max(0, item.StartSeconds ?? 0);
            var end = item.EndSeconds;
            if (end is > 0 && end.Value > start)
            {
                return start + (end.Value - start) * Math.Clamp(item.ProgressPercent.Value, 0, 100) / 100d;
            }
        }

        return item.StartSeconds;
    }

    private static int TrackSortKey(MediaGroupingItemViewModel item)
        => int.TryParse(item.TrackNumber, out var parsed) ? parsed : int.MaxValue;

    private static string ResolveEditorMediaType(DetailEntityType entityType, DetailPresentationContext context)
        => entityType switch
        {
            DetailEntityType.Movie or DetailEntityType.MovieSeries => "Movies",
            DetailEntityType.TvShow or DetailEntityType.TvSeason or DetailEntityType.TvEpisode => "TV",
            DetailEntityType.Audiobook => "Audiobooks",
            DetailEntityType.ComicIssue or DetailEntityType.ComicSeries => "Comics",
            DetailEntityType.MusicAlbum => "Music",
            DetailEntityType.Book or DetailEntityType.BookSeries => "Books",
            _ when context == DetailPresentationContext.Watch => "Movies",
            _ when context == DetailPresentationContext.Listen => "Music",
            _ when context == DetailPresentationContext.Comics => "Comics",
            _ => "Books",
        };

}
