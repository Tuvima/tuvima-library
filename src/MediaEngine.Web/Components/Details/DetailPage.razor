@namespace MediaEngine.Web.Components.Details
@using System.Globalization
@using System.Text.RegularExpressions
@using MediaEngine.Contracts.Details
@using Microsoft.JSInterop
@using MediaEngine.Contracts.Progress
@using MediaEngine.Contracts.Playback
@using MediaEngine.Contracts.Realtime
@using MediaEngine.Contracts.Universe
@using MediaEngine.Domain.Enums
@using MediaEngine.Web.Components.MediaEditor
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Navigation
@using MediaEngine.Web.Services.Playback
@inject IEngineApiClient ApiClient
@inject MediaEditorLauncherService MediaEditorLauncher
@inject DeviceContextService DeviceContext
@inject CollectionEditorLauncherService CollectionEditorLauncher
@inject SavedItemService SavedItems
@inject MediaReactionService Reactions
@inject PlaybackSessionController Playback
@inject UIOrchestratorService Orchestrator
@inject NavigationManager Nav
@inject IAppToastService Snackbar
@inject IAppDialogService Dialogs
@inject IJSRuntime JS
@inject IServiceProvider Services
@inject ILogger<DetailPage> Logger
@implements IDisposable

@if (Model is not null && _removed)
{
    @* Someone else deleted this title while it was open: the overlay stays, with a notice in place of the page. *@
    <article class="tl-detail-page tl-detail-page--removed">
        <RemovedItemNotice InputLabel="@_removedInputLabel"
                           InputText="@_removedInputText"
                           LostSectionInput="_removedLostSectionInput"
                           OnCopy="CopyRemovedInputAsync"
                           OnClose="CloseRemovedNoticeAsync" />
    </article>
}
else if (Model is not null)
{
    <CascadingValue Value="_editing" IsFixed="true">
    <article class="tl-detail-page">
        @* Editing Mode: the banner is the first thing in the page's scroll container and sticks to its top; it is outside the
           hero because the full-bleed hero clips what overflows it. *@
        @if (Model.EntityType != DetailEntityType.Person)
        {
            <EditingBanner Mode="_editing"
                           CanDelete="@CanDeleteFromLibrary"
                           OnActionSelected="HandleDetailActionAsync" />
        }

        <section class="@DetailStageClass">
            <DetailHero Model="Model"
                        CanDelete="@CanDeleteFromLibrary"
                        OnActionSelected="HandleDetailActionAsync"
                        OnTabRequested="SetActiveTabAsync"
                        ActionAttributes="@(IsAudiobook ? AudiobookActionAttributes : null)" />

            @if (ShowDetailNavigation)
            {
                <div class="tl-detail-stage__navigation">
                    <DetailTabs Tabs="VisibleTabs"
                                ActiveTab="@CurrentActiveTab"
                                ActiveTabChanged="SetActiveTabAsync" />
                </div>
            }
        </section>

        @* The open Editing Mode section (Artwork, Match and Identity, History): directly below the hero, one at a time. *@
        <EditingSectionSlot Mode="_editing"
                            BuildRequest="BuildSectionRequest"
                            OnCommitted="RefreshAfterSectionCommitAsync" />

        @if (ShowPrimaryModuleAfterNavigation)
        {
            <section class="tl-detail-page__primary-content">
            <DetailPrimaryModule Model="Model"
                                 SelectedSeasonId="SelectedSeasonId"
                                 OnSeasonSelected="SelectedSeasonChanged"
                                 OnContainerSelected="HandleContainerSelectedAsync"
                                 OnEditItem="OpenEpisodeEditorAsync" />
            </section>
        }

        <section id="@CurrentActiveTab" class="tl-detail-body">
            @if (CurrentActiveTab is "overview")
            {
                @if (IsMusicAlbum)
                {
                    <MusicAlbumOverviewContent Model="Model" />
                }
                else
                {
                    <MediaEngine.Web.Components.Details.OverviewTab Model="Model"
                                                                     OnTabRequested="SetActiveTabAsync"
                                                                     OnContainerSelected="HandleContainerSelectedAsync" />
                }
            }
            else if (CurrentActiveTab is "tracks" && IsAudiobook)
            {
                <AudiobookTracksContent Model="Model" />
            }
            else if (CurrentActiveTab is "people" or "credits" or "cast")
            {
                <PeopleTab ContributorGroups="@(Model.FullContributorGroups.Count > 0 ? Model.FullContributorGroups : Model.ContributorGroups)"
                                        EpisodeId="@(Model.EntityType == DetailEntityType.TvEpisode ? Model.Id : null)"
                                        EpisodeContributorGroups="@(Model.EntityType == DetailEntityType.TvEpisode ? Model.ContributorGroups : null)" />
            }
            else
            {
                <DetailsTab Model="Model" />
            }
        </section>
    </article>
    </CascadingValue>
}

@code {
    [Parameter, EditorRequired] public DetailPageViewModel? Model { get; set; }
    [Parameter] public string? ActiveTab { get; set; }
    [Parameter] public EventCallback<string> ActiveTabChanged { get; set; }

    /// <summary>The season of a show the page address names; a refresh asks the Engine for the show on that season.</summary>
    [Parameter] public Guid? SelectedSeasonId { get; set; }
    [Parameter] public EventCallback<Guid> SelectedSeasonChanged { get; set; }

    /// <summary>Raised with each payload this page fetches itself, so the host keeps the newest one.</summary>
    [Parameter] public EventCallback<DetailPageViewModel> ModelRefreshed { get; set; }
    [Parameter] public EventCallback<DetailAction> OnActionSelected { get; set; }
    private IReadOnlyList<DetailTab> VisibleTabs =>
        Model is null ? [] : DetailTabNavigation.GetVisibleTabs(Model);

    private string CurrentActiveTab =>
        VisibleTabs.Any(tab => string.Equals(tab.Key, ActiveTab, StringComparison.OrdinalIgnoreCase))
            ? VisibleTabs.First(tab => string.Equals(tab.Key, ActiveTab, StringComparison.OrdinalIgnoreCase)).Key
            : VisibleTabs.FirstOrDefault()?.Key ?? "overview";

    private DetailPresentationCapabilities PresentationCapabilities =>
        DetailPresentationCapabilities.For(Model?.EntityType ?? DetailEntityType.Work);
    private bool IsMusicAlbum => PresentationCapabilities.IsMusicAlbum;
    private bool IsAudiobook => PresentationCapabilities.IsAudiobook
        || MediaKindClassifier.IsAudiobook(Model?.Facts?.MediaKind)
        || Model?.OwnedFormats.Any(format => format.FormatType == MediaFormatType.Audiobook) == true;
    private bool ShowDetailNavigation => Model?.EntityType != DetailEntityType.Person;
    // The Engine only offers "edit" to a person who may edit; the device rule is checked here again at the handler.
    private bool CanEditMedia => DeviceContext.CanEdit && Model?.OverflowActions.Any(action =>
        !action.IsDisabled && action.Key is "edit" or "edit-media") == true;

    // Editing Mode (the banner, pencils and one section below the hero) is for single items. Collections, series shelves and
    // people keep their own editors.
    private EditingModeContext? _editing;
    private Guid? _editingProfileId;
    private IDisposable? _overlayGuard;
    private IDisposable? _overlayEscape;

    protected override void OnInitialized()
    {
        _editing = new EditingModeContext(DeviceContext, new ItemFieldEditSession(ApiClient, DeviceContext, Logger))
        {
            Loader = LoadEditingFieldsAsync,
            AskSaveOrDiscard = () => EditingSaveOrDiscardDialog.AskAsync(Dialogs),
        };
        _editing.Changed += OnEditingChanged;
        _editing.Fields.Saved += RefreshAfterFieldSavedAsync;
        Orchestrator.OnLibraryItemsRemoved += OnLibraryItemsRemoved;
        UpdateEditingEligibility();
    }

    protected override void OnParametersSet() => UpdateEditingEligibility();

    /// <summary>The details overlay this page is shown in; null when the page is rendered on its own.</summary>
    [CascadingParameter] public DetailsOverlayState? Overlay { get; set; }

    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        Orchestrator.OnLibraryItemsRemoved -= OnLibraryItemsRemoved;
        ReleaseOverlayGuards();
        if (_editing is null)
        {
            return;
        }

        _editing.Changed -= OnEditingChanged;
        _editing.Fields.Saved -= RefreshAfterFieldSavedAsync;
        _editing.Dispose();
    }

    private void OnEditingChanged()
    {
        SyncOverlayGuards();
        _ = InvokeAsync(StateHasChanged);
    }

    // While Editing Mode is on the overlay asks it before it closes (close button, Esc, backdrop, Back, a link to another
    // title): it settles unsaved input with "Save or discard?" and leaves the mode first. Esc is offered to it first too,
    // so Esc closes an open field, then an open section, and only then dismisses the overlay.
    private void SyncOverlayGuards()
    {
        if (_editing is { IsOn: true } && Overlay is not null)
        {
            _overlayGuard ??= Overlay.RegisterDismissGuard(_editing);
            _overlayEscape ??= Overlay.RegisterEscapeHandler(_editing.HandleEscapeAsync);
            return;
        }

        ReleaseOverlayGuards();
    }

    private void ReleaseOverlayGuards()
    {
        _overlayGuard?.Dispose();
        _overlayGuard = null;
        _overlayEscape?.Dispose();
        _overlayEscape = null;
    }

    /// <summary>
    /// Delete from library, in the page's "..." menu (with or without Editing Mode) and in the editing banner's "...": on a desktop
    /// for an effective administrator, and for a page that is one title (details overlay spec D18, D19). The Engine and
    /// <see cref="DeleteFromLibraryAsync"/> check again.
    /// </summary>
    private bool CanDeleteFromLibrary =>
        Model is not null
        && !_removed
        && LibraryItemDeletionFlow.IsSingleTitle(Model.EntityType)
        && LibraryItemDeletionFlow.CanDelete(DeviceContext, Services.GetService<DashboardSessionAccessor>());

    private void UpdateEditingEligibility()
    {
        if (_editing is null)
        {
            return;
        }

        var editAction = Model?.OverflowActions.FirstOrDefault(action => action.Key is "edit" or "edit-media");
        _editing.HasPermission = editAction is not null && SupportsEditingMode;
        _editing.UnavailableReason = editAction is { IsDisabled: true }
            ? editAction.Tooltip ?? "Editing is not available right now."
            : null;
    }

    private bool SupportsEditingMode =>
        Model is not null
        && Model.EntityType != DetailEntityType.Person
        && Guid.TryParse(Model.Id, out var entityId)
        && ResolveEditorTarget(entityId).EntityKind is not ("Person" or "StructuralCollection" or "Collection");

    private async Task LoadEditingFieldsAsync()
    {
        if (_editing is null || Model is null || !Guid.TryParse(Model.Id, out var entityId))
        {
            return;
        }

        var target = ResolveEditorTarget(entityId);
        var profile = await Orchestrator.GetActiveProfileAsync();
        _editingProfileId = profile?.Id;
        await _editing.Fields.LoadAsync(
            target.EntityId,
            ResolveEditorMediaType(Model.EntityType, Model.PresentationContext),
            target.InitialScope,
            _editingProfileId);
    }

    // The request for the editor hosted in the section slot: the section id (artwork, links or history) is its one tab.
    private MediaEditorLaunchRequest? BuildSectionRequest(string tab, string? artworkSlot)
    {
        if (Model is null || !Guid.TryParse(Model.Id, out var entityId))
        {
            return null;
        }

        return BuildMediaEditorRequest(entityId, ResolveEditorTarget(entityId), _editingProfileId, tab, artworkSlot);
    }

    // A field saved from a pencil: the item is already updated, so refresh what the page shows. A failed refresh
    // never undoes the save; the page simply keeps what it had until the next load.
    private async Task RefreshAfterFieldSavedAsync(string fieldKey)
    {
        try
        {
            await RefreshCurrentDetailAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The detail page could not refresh after {Field} was saved", fieldKey);
            Snackbar.Add("Saved, but the page could not refresh. Reload to see the change.", AppSeverity.Warning);
        }
    }

    private async Task RefreshAfterSectionCommitAsync()
    {
        try
        {
            await RefreshCurrentDetailAsync();
            if (_editing is { Fields.HasOpenDraft: false })
            {
                await LoadEditingFieldsAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The detail page could not refresh after an editing section saved a change");
            Snackbar.Add("Saved, but the page could not refresh. Reload to see the change.", AppSeverity.Warning);
        }
    }

    // Delete from library: the dialog is the only confirmation. While it is open (or once the page is on its way out) a live "removed"
    // event for this title must not also toast and navigate: the dialog's own answer does that.
    private bool _deleting;
    private bool _leaving;
    private bool _removedWhileDeleting;

    // Someone else deleted this title while the overlay showed it: the notice stands in for the page.
    private bool _removed;
    private string? _removedInputLabel;
    private string? _removedInputText;
    private bool _removedLostSectionInput;

    private async Task DeleteFromLibraryAsync()
    {
        if (Model is null || _deleting || _leaving || _removed || !Guid.TryParse(Model.Id, out var workId))
        {
            return;
        }

        // The entry only shows to an administrator on a desktop; a handler never trusts that.
        if (LibraryItemDeletionFlow.TryRefuse(DeviceContext, Services.GetService<DashboardSessionAccessor>(), Snackbar))
        {
            return;
        }

        if (!LibraryItemDeletionFlow.IsSingleTitle(Model.EntityType))
        {
            return;
        }

        _deleting = true;
        var outcome = LibraryItemDeletionFlowOutcome.Canceled;
        try
        {
            outcome = await LibraryItemDeletionFlow.RunAsync(Dialogs, Snackbar, [workId], Model.Title);
        }
        finally
        {
            _leaving = outcome != LibraryItemDeletionFlowOutcome.Canceled;
            _deleting = false;
        }

        if (_leaving)
        {
            await LeaveAfterRemovalAsync();
        }
        else if (_removedWhileDeleting && !_disposed)
        {
            // Cancelled, but someone else deleted this title while the dialog was open.
            await HandleRemovedByAnotherAsync();
        }
    }

    // Another window (or another person) deleted the title this page shows.
    private void OnLibraryItemsRemoved(LibraryItemsRemovedEvent removed) => _ = InvokeAsync(async () =>
    {
        if (_disposed || _leaving || _removed || Model is null || !Guid.TryParse(Model.Id, out var id))
        {
            return;
        }

        if (!removed.WorkIds.Contains(id))
        {
            // A show, album, series or collection page that lists a deleted title refreshes so the row leaves it.
            if (!_deleting && ListsRemovedTitle(removed))
            {
                try
                {
                    await RefreshCurrentDetailAsync();
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "The detail page could not refresh after titles were deleted from the library");
                }
            }

            return;
        }

        if (_deleting)
        {
            _removedWhileDeleting = true;
            return;
        }

        await HandleRemovedByAnotherAsync();
    });

    // Not this page's own delete. In the overlay the person may have been typing, so it stays open with a notice (and a way to keep
    // the typed text); a page on its own says so in a toast and goes back, as before.
    private async Task HandleRemovedByAnotherAsync()
    {
        if (Overlay is { IsOpen: true })
        {
            ShowRemovedNotice();
            return;
        }

        _leaving = true;
        Snackbar.Add(LibraryItemDeletionText.NoLongerInLibrary, AppSeverity.Info);
        await LeaveAfterRemovalAsync();
    }

    // Editing Mode ends without asking (the item is gone, so there is nothing to save or discard); unsaved text from a pencil field
    // is kept for the notice. An open section's unsaved input lives inside the editor and cannot be read from here.
    private void ShowRemovedNotice()
    {
        if (_editing is { IsOn: true } editing)
        {
            var fields = editing.Fields;
            if (fields.IsDirty)
            {
                _removedInputText = fields.Draft;
                _removedInputLabel = fields.ActiveKey is { } key ? fields.Find(key)?.Label : null;
            }

            _removedLostSectionInput = editing.SectionDirty;
            editing.Leave();
        }

        _removed = true;
        StateHasChanged();
    }

    private async Task CopyRemovedInputAsync()
    {
        if (string.IsNullOrEmpty(_removedInputText))
        {
            return;
        }

        switch (await JS.TryCopyAsync(_removedInputText, Logger))
        {
            case ClipboardCopyResult.Copied:
                Snackbar.Add("Copied.", AppSeverity.Success);
                break;
            case ClipboardCopyResult.Failed:
                Snackbar.Add(ClipboardInterop.FailedMessage("the text"), AppSeverity.Warning);
                break;
        }
    }

    // Close is the overlay's own close path; nothing typed on a deleted title needs a guard.
    private async Task CloseRemovedNoticeAsync()
    {
        if (Overlay is { IsOpen: true } overlay)
        {
            await overlay.DismissAsync(force: true);
        }
    }

    private bool ListsRemovedTitle(LibraryItemsRemovedEvent removed) => Model is not null
        && Model.MediaGroups.SelectMany(group => group.Items)
            .Any(item => Guid.TryParse(item.Id, out var workId) && removed.WorkIds.Contains(workId));

    // The title is gone: end Editing Mode (nothing typed matters now, and it must not ask) and go back to where the person came from.
    private async Task LeaveAfterRemovalAsync()
    {
        if (Model is null)
        {
            return;
        }

        var fallback = DetailOriginInterop.FallbackRoute(Model.EntityType, Model.Facts?.MediaKind);
        _editing?.Leave();
        if (Overlay is { IsOpen: true } overlay)
        {
            // In the overlay, "leave" is the close button's path: dismiss it entirely, back to the page under it.
            // Nothing typed on a deleted title matters, so no guard is asked.
            await overlay.DismissAsync(force: true);
            return;
        }

        if (!await JS.TryBackAsync(fallback, Logger) && !_disposed)
        {
            Nav.NavigateTo(fallback);
        }
    }

    private bool HasPrimaryModuleAfterNavigation => Model?.PrimaryModule.Kind is not
        (DetailPrimaryModuleKind.None or DetailPrimaryModuleKind.Tracks or DetailPrimaryModuleKind.Chapters);

    private bool ShowPrimaryModuleAfterNavigation =>
        HasPrimaryModuleAfterNavigation
        && CurrentActiveTab == "overview";

    private string DetailStageClass =>
        $"tl-detail-stage{(HasPrimaryModuleAfterNavigation ? " tl-detail-stage--with-primary" : " tl-detail-stage--identity-only")}" +
        $"{(HasPrimaryModuleAfterNavigation ? " tl-detail-stage--primary-after-navigation" : string.Empty)}" +
        $"{(string.IsNullOrWhiteSpace(PresentationCapabilities.StageModifier) ? string.Empty : $" {PresentationCapabilities.StageModifier}")}" +
        $"{(Model?.EntityType == DetailEntityType.Person ? " tl-detail-stage--person" : string.Empty)}";

    private Task SetActiveTabAsync(string key) => ActiveTabChanged.InvokeAsync(key);

    private async Task HandleContainerSelectedAsync(SequenceContainerOptionViewModel option)
    {
        if (Model is null || string.IsNullOrWhiteSpace(option.ContainerId) || !Guid.TryParse(Model.Id, out var id))
            return;

        var updated = await ApiClient.GetDetailPageAsync(Model.EntityType, id, Model.PresentationContext, option.ContainerId, SequenceWindowQuery.Windowed);
        if (updated is not null && IsStillShowing(id))
        {
            Model = updated;
            await ModelRefreshed.InvokeAsync(updated);
        }
    }

    private async Task HandleDetailActionAsync(DetailAction action)
    {
        if (Model is null) return;
        if (action.Key == DetailActionKeys.PlayFromBeginning)
        {
            if (IsAudiobook) { await PlayAudiobookAsync(preferResume: false); return; }
            if (Model.EntityType == DetailEntityType.MusicAlbum) { await PlayAlbumAsync(shuffle: false); return; }
            if (Model.EntityType is DetailEntityType.Book or DetailEntityType.ComicIssue or DetailEntityType.Work)
            { await OpenReaderAsync(action, restart: true); return; }
        }
        if (action.Key == DetailActionKeys.Read)
        {
            await OpenReaderAsync(action);
            return;
        }

        if (action.Key is DetailActionKeys.PlayNext or DetailActionKeys.AddQueue)
        {
            var tracks = Model.MediaGroups.SelectMany(g => g.Items)
                .Where(item => item.EntityType == DetailEntityType.Work && item.IsOwned)
                .OrderBy(TrackSortKey).Select(ToQueueItem).Where(item => item.WorkId != Guid.Empty).ToList();
            if (action.Key == DetailActionKeys.PlayNext) tracks.Reverse();
            foreach (var track in tracks) await Playback.AddQueueItemAsync(track, next: action.Key == DetailActionKeys.PlayNext);
            Snackbar.Add($"Added {tracks.Count} tracks to the queue.", AppSeverity.Success);
            return;
        }
        if (action.Key == DetailActionKeys.AddPlaylist)
        {
            IReadOnlyList<Guid> works = Model.MediaGroups.SelectMany(g => g.Items)
                .Where(item => item.IsOwned && Guid.TryParse(item.Id, out _))
                .OrderBy(TrackSortKey)
                .Select(item => Guid.Parse(item.Id))
                .Distinct()
                .ToList();
            await Dialogs.ShowAsync<MediaMembershipDialog>(action.Label, new AppDialogParameters<MediaMembershipDialog> {
                { d => d.Playlist, true }, { d => d.WorkIds, works },
            });
            return;
        }
        if (DetailActionKeys.IsPersonalStatus(action.Key))
        {
            await HandlePersonalStatusAsync(action);
            return;
        }
        if (action.Key is DetailActionKeys.EditMedia or DetailActionKeys.Edit)
        {
            if (action.IsDisabled) return;
            if (EditorDeviceRule.TryRefuse(DeviceContext, Snackbar)) return;
            if (!CanEditMedia) return;

            // Single items edit in place; shelves, collections and people keep their own editor dialogs.
            // The menu entry only ever turns Editing Mode on; choosing it while already editing keeps it on
            // (Done is the way out).
            if (_editing is { HasPermission: true })
            {
                if (!_editing.IsOn)
                {
                    await _editing.EnterAsync();
                }

                return;
            }

            await OpenMediaEditorAsync();
            return;
        }

        if (action.Key == DetailActionKeys.DeleteFromLibrary)
        {
            await DeleteFromLibraryAsync();
            return;
        }

        if (action.Key == DetailActionKeys.MyList)
        {
            await ToggleFavoriteAsync(action);
            return;
        }

        if (action.Key is DetailActionKeys.ReactionDislike or DetailActionKeys.ReactionLike or DetailActionKeys.ReactionLove)
        {
            await SetReactionAsync(action);
            return;
        }

        if (action.Key == DetailActionKeys.Details)
        {
            await SetActiveTabAsync("details");
            return;
        }

        if (Model?.EntityType == DetailEntityType.MusicAlbum && action.Key is DetailActionKeys.PlayAlbum or DetailActionKeys.Shuffle)
        {
            await PlayAlbumAsync(shuffle: action.Key == DetailActionKeys.Shuffle);
            return;
        }

        if (action.Key == DetailActionKeys.ShuffleCollection)
        {
            await ShuffleStructuralContainerAsync();
            return;
        }

        var isAudiobookListenAction = string.Equals(action.Key, DetailActionKeys.Listen, StringComparison.OrdinalIgnoreCase)
            || string.Equals(action.Label, "Listen", StringComparison.OrdinalIgnoreCase);
        if (Model is not null && IsAudiobook && !action.IsDisabled
            && (isAudiobookListenAction || IsContinueAction(action)))
        {
            await PlayAudiobookAsync(IsContinueAction(action));
            return;
        }

        if (!string.IsNullOrWhiteSpace(action.Route))
        {
            Nav.NavigateTo(action.Route);
            return;
        }

        await OnActionSelected.InvokeAsync(action);
    }

    private bool _changingPersonalStatus;
    private async Task HandlePersonalStatusAsync(DetailAction action)
    {
        if (Model is null || _changingPersonalStatus) return;
        _changingPersonalStatus = true;
        try
        {
            if (action.Key == DetailActionKeys.StatusHistory)
            {
                var items = await ApiClient.GetPersonalHistoryAsync(Model.EntityType, Guid.Parse(Model.Id));
                await Dialogs.ShowAsync<PersonalHistoryDialog>(action.Label,
                    new AppDialogParameters<PersonalHistoryDialog> { { d => d.Items, items } });
                return;
            }
            var command = action.Key switch {
                DetailActionKeys.StatusComplete => PersonalStatusAction.Complete,
                DetailActionKeys.StatusReset => PersonalStatusAction.Reset,
                DetailActionKeys.StatusHide => PersonalStatusAction.HideContinue,
                DetailActionKeys.StatusShow => PersonalStatusAction.ShowContinue,
                _ => throw new InvalidOperationException("Unknown personal status action."),
            };
            var status = await ApiClient.GetPersonalStatusAsync(Model.EntityType, Guid.Parse(Model.Id))
                ?? throw new InvalidOperationException("Personal status could not be loaded. Please try again.");
            var result = await ApiClient.ChangePersonalStatusAsync(new(Guid.NewGuid(), Model.EntityType,
                Guid.Parse(Model.Id), command, status.Revision));
            await RefreshCurrentDetailAsync();
            Snackbar.Add($"Status updated for {result.AffectedCount} owned item(s).", AppSeverity.Success, options => {
                options.Action = "Undo";
                options.OnClick = async _ => {
                    try { await ApiClient.UndoPersonalStatusAsync(result.CommandId); await RefreshCurrentDetailAsync(); }
                    catch (Exception ex) { Snackbar.Add(ex.Message, AppSeverity.Error); }
                };
            });
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, AppSeverity.Error); }
        finally { _changingPersonalStatus = false; }
    }

    private async Task OpenMediaEditorAsync()
    {
        if (Model is null || !Guid.TryParse(Model.Id, out var entityId))
            return;

        try
        {
            var target = ResolveEditorTarget(entityId);
            var activeProfile = await Orchestrator.GetActiveProfileAsync();
            if (string.Equals(target.EntityKind, "StructuralCollection", StringComparison.OrdinalIgnoreCase))
            {
                var structuralApplied = await CollectionEditorLauncher.OpenAsync(new CollectionEditorLaunchRequest
                {
                    EditingCollection = new CollectionListItemViewModel
                    {
                        Id = target.EntityId,
                        Name = Model.Title,
                        Description = Model.Description,
                        CollectionType = "Series",
                        CoverUrl = Model.Artwork.CoverUrl ?? Model.Artwork.PosterUrl,
                        BackgroundUrl = Model.Artwork.BackdropUrl,
                        LogoUrl = Model.Artwork.LogoUrl,
                    },
                    StructuralDetail = Model,
                    StructuralEntityKind = target.ContainerMode == "Collection" ? "Collection" : "Work",
                    ActiveProfileId = activeProfile?.Id,
                });
                if (structuralApplied)
                    await RefreshCurrentDetailAsync();
                return;
            }
            if (string.Equals(target.EntityKind, "Collection", StringComparison.OrdinalIgnoreCase))
            {
                var collection = await ResolveManagedCollectionForEditorAsync(target.EntityId);
                if (collection is null)
                {
                    Snackbar.Add("Collection editor could not load this collection.", AppSeverity.Error);
                    return;
                }

                var collectionApplied = await CollectionEditorLauncher.OpenAsync(new CollectionEditorLaunchRequest
                {
                    EditingCollection = collection,
                    ActiveProfileId = activeProfile?.Id ?? collection.ProfileId,
                    Kind = ContainerEditorKind.Collection,
                });

                if (collectionApplied)
                    await RefreshCurrentDetailAsync();

                return;
            }

            var request = BuildMediaEditorRequest(entityId, target, activeProfile?.Id, target.InitialTab ?? "details", null)!;

            var applied = await MediaEditorLauncher.OpenAsync(request);
            if (applied)
            {
                await RefreshCurrentDetailAsync();
                Snackbar.Add("Media details updated.", AppSeverity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Media editor could not open: {ex.Message}", AppSeverity.Error);
        }
    }

    // One request shape for the modal (people, and any caller outside Editing Mode) and for the Editing Mode section slot.
    private MediaEditorLaunchRequest? BuildMediaEditorRequest(
        Guid entityId,
        (Guid EntityId, string EntityKind, string ContainerMode, string? InitialTab, string? InitialScope) target,
        Guid? activeProfileId,
        string initialTab,
        string? initialArtworkSlot)
    {
        if (Model is null)
        {
            return null;
        }

        var coverUrl = Model.Artwork.CoverUrl ?? Model.Artwork.PosterUrl ?? Model.Artwork.PortraitUrl;
        var mediaType = ResolveEditorMediaType(Model.EntityType, Model.PresentationContext);
        return new MediaEditorLaunchRequest
        {
            EntityIds = [target.EntityId],
            LaunchEntityId = target.EntityId,
            LaunchEntityKind = target.EntityKind,
            ContainerMode = target.ContainerMode,
            ActiveProfileId = activeProfileId,
            InitialMediaGroups = Model.MediaGroups,
            InitialSequencePlacement = Model.SequencePlacement,
            Mode = SharedMediaEditorMode.Normal,
            InitialTab = initialTab,
            InitialArtworkSlot = initialArtworkSlot,
            InitialScope = target.InitialScope,
            MediaType = mediaType,
            HeaderTitle = Model.Title,
            HeaderSubtitle = Model.Subtitle,
            CoverUrl = coverUrl,
            OnArtworkChanged = RefreshCurrentDetailAsync,
            PreviewItems =
            [
                new MediaEditorPreviewItem
                {
                    EntityId = entityId,
                    Title = Model.Title,
                    CoverUrl = coverUrl,
                    MediaType = mediaType,
                },
            ],
        };
    }

