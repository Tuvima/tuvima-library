@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details
@inject IStringLocalizer<SharedStrings> L

@* History of several supporting files (universal editor v5 WP8, screen F): one collapsed section per file. A section reads that file's history
   from the Engine only when it is opened, so a long list of files costs nothing until one is asked for. Read-only. *@
<div class="tl-fbhistory" data-testid="files-batch-history">
    <AppExpansionPanels MultiExpansion="true">
        @foreach (var row in Rows)
        {
            var fileId = Guid.TryParse(row.Id, out var parsed) ? parsed : Guid.Empty;
            <AppExpansionPanel Text="@string.Format(L["EditorFilesBatch_HistoryFor"].Value, row.Title)" Expanded="@_open.Contains(row.Id)"
                               ExpandedChanged="@(open => Toggle(row.Id, open))">
                @if (_open.Contains(row.Id))
                {
                    <EditorHistoryTool EntityId="@fileId" SupportingFileTitleId="@TitleId" />
                }
            </AppExpansionPanel>
        }
    </AppExpansionPanels>
</div>

@code {
    private readonly HashSet<string> _open = [];

    [Parameter, EditorRequired] public IReadOnlyList<SupportingFileRowDto> Rows { get; set; } = [];

    [Parameter, EditorRequired] public Guid TitleId { get; set; }

    private void Toggle(string id, bool open)
    {
        if (open)
        {
            _open.Add(id);
        }
        else
        {
            _open.Remove(id);
        }
    }
}
