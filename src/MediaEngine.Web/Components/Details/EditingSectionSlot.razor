@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Web.Components.MediaEditor
@using MediaEngine.Web.Services.Editing
@implements IAsyncDisposable
@implements IEditingSectionHost
@inject IJSRuntime JS
@inject ILogger<EditingSectionSlot> Logger

@* The Editing Mode section slot (details overlay spec D7): the one section the banner opened (Artwork, Match and Identity or
   History; Details for the Universe editor), directly below the hero at the full width of the page. It is the existing media
   editor shell hosted in line with no header and no section rail, and with a height cap so the page below stays reachable.
   Pressing the open section's banner button again, the close button here, or Done closes it; Esc closes it from the overlay. *@
@if (Mode is { SectionOpen: true } mode && _request is not null)
{
    <section @ref="_root"
             id="tl-editing-slot"
             class="@(InPanel ? "tl-editing-slot tl-editing-slot--panel" : "tl-editing-slot")"
             aria-labelledby="tl-editing-slot-title"
             data-section="@SectionId(mode.OpenSectionKind)">
        @if (!InPanel || mode.OpenSectionKind == EditingSection.History)
        {
            @* In the universal editor's panel the panel owns the heading and the close button; History keeps its own heading as a block. *@
            <header class="tl-editing-slot__header">
                <h2 id="tl-editing-slot-title" class="tl-editing-slot__title" tabindex="-1">@Heading(mode.OpenSectionKind)</h2>
                @if (!InPanel)
                {
                    <AppIconButton Icon="@AppMaterialIcons.Outlined.Close"
                                   Size="AppControlSize.Large"
                                   Tone="AppUiTone.Neutral"
                                   Class="tl-editing-slot__close"
                                   Tooltip="@($"Close {Heading(mode.OpenSectionKind)}")"
                                   AriaLabel="@($"Close {Heading(mode.OpenSectionKind)}")"
                                   OnClick="CloseAsync" />
                }
            </header>
        }
        <div class="tl-editing-slot__body">
            <SharedMediaEditorShell @key="mode.OpenSectionKind"
                                    @ref="_shell"
                                    Request="@_request"
                                    Inline="true"
                                    Section="@SectionId(mode.OpenSectionKind)"
                                    RequestedArtworkSlot="@mode.OpenSectionArtworkSlot"
                                    RequestVersion="@mode.SectionRequestVersion"
                                    DirtyChanged="OnDirtyChanged"
                                    SavingChanged="OnSavingChanged"
                                    Committed="OnCommittedAsync"
                                    Closed="OnShellClosedAsync" />
            @if (mode.OpenSectionKind == EditingSection.Match)
            {
                <EditingVideoIdentify Mode="mode" OnMatched="OnCommitted" />
            }
        </div>
    </section>
}

@code {
    // Where focus goes when the control that opened the section is gone (Done closes the section and the banner with it):
    // the hero's own "..." button on a title, the Edit button on a Universe, and last the overlay's scroller.
    private static readonly string[] FocusFallbacks =
    [
        ".tl-detail-secondary-actions button[aria-label='More actions']",
        ".universe-hero__edit",
        ".tl-details-overlay__scroller",
    ];

    private SharedMediaEditorShell? _shell;
    private ElementReference _root;
    private IJSObjectReference? _escapeModule;
    private DotNetObjectReference<EditingSectionSlot>? _self;
    private bool _attachEscape;
    private bool _commitSeenDuringSave;
    private bool _swallowNextCommit;
    private MediaEditorLaunchRequest? _request;
    private EditingSection? _builtFor;
    private EditingModeContext? _subscribed;
    private bool _wasOpen;
    private bool _focusSlot;

    [Parameter, EditorRequired] public EditingModeContext? Mode { get; set; }

    /// <summary>Builds the editor request for the item shown on the page, opened on the given section id and artwork slot.</summary>
    [Parameter, EditorRequired] public Func<string, string?, MediaEditorLaunchRequest?> BuildRequest { get; set; } = (_, _) => null;

    /// <summary>Raised after the section saved something so the page behind it can refresh.</summary>
    [Parameter] public EventCallback OnCommitted { get; set; }

    /// <summary>What the Details section is called here (the Universe editor calls itself "Details"; a caller may name it better).</summary>
    [Parameter] public string DetailsHeading { get; set; } = "Details";

    /// <summary>
    /// True when nothing above this slot hears Esc (a page outside the details overlay): the slot then listens for Esc itself,
    /// with app-dialog.js's rules (an open popup or a control that uses Esc itself keeps the key). Inside the overlay Esc
    /// arrives through the overlay's own handler, so this stays false and Esc is never counted twice.
    /// </summary>
    [Parameter] public bool HandlesEscape { get; set; }

    /// <summary>
    /// True when the slot sits inside the universal editor's right-hand panel: no close button of its own (the panel closes it), no
    /// scrolling the page to it, and no height cap, so the panel stays the one scroll area.
    /// </summary>
    [Parameter] public bool InPanel { get; set; }

    private static string SectionId(EditingSection? section) => section switch
    {
        EditingSection.Artwork => "artwork",
        EditingSection.Match => "links",
        EditingSection.History => "history",
        _ => "details",
    };

    private string Heading(EditingSection? section) => section switch
    {
        EditingSection.Artwork => "Manage Artwork",
        EditingSection.Match => "Match and Identity",
        EditingSection.History => "History",
        _ => DetailsHeading,
    };

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_subscribed, Mode))
        {
            if (_subscribed is not null)
            {
                _subscribed.Changed -= OnModeChanged;
                if (ReferenceEquals(_subscribed.SectionHost, this))
                {
                    _subscribed.SectionHost = null;
                }
            }

            _subscribed = Mode;
            if (_subscribed is not null)
            {
                _subscribed.Changed += OnModeChanged;
            }
        }

        SyncOpenState();
    }

    private void SyncOpenState()
    {
        // The batch sections ("Edit together" and the bar's Move) live above the rows, not here: this slot only hosts the editor's own sections.
        var kind = Mode is { SectionOpen: true } && !Mode.OpenSectionKind.IsBatch() ? Mode.OpenSectionKind : null;
        if (kind is { } section && Mode is not null)
        {
            // A fresh opening, or a swap to another section, builds a fresh editor session; asking again for the section
            // that is open flows through the shell's parameters instead.
            if (_builtFor != section || _request is null)
            {
                _request = BuildRequest(SectionId(section), Mode.OpenSectionArtworkSlot);
                _builtFor = _request is null ? null : section;
                _focusSlot = _request is not null && !InPanel;
                _attachEscape = _request is not null && HandlesEscape;
                _commitSeenDuringSave = false;
                _swallowNextCommit = false;
                if (_request is not null && !_wasOpen)
                {
                    _ = RememberOpenerAsync();
                }
                else if (_request is null)
                {
                    // Nothing can be shown for this item: do not leave a section "open" (and its button pressed) with no slot.
                    _wasOpen = false;
                    Mode.CloseSection();
                    return;
                }
            }

            if (_request is not null)
            {
                Mode.SectionHost = this;
            }
        }
        else
        {
            _request = null;
            _builtFor = null;
            if (_wasOpen)
            {
                _ = RestoreOpenerAsync();
            }

            if (Mode is not null && ReferenceEquals(Mode.SectionHost, this))
            {
                Mode.SectionHost = null;
            }
        }

        _wasOpen = _request is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_attachEscape && _request is not null)
        {
            _attachEscape = false;
            try
            {
                // The listener lives on the slot's element and goes with it when the section closes.
                _escapeModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/editing-section-escape.js");
                _self ??= DotNetObjectReference.Create(this);
                if (_escapeModule is not null)
                {
                    await _escapeModule.InvokeVoidAsync("attach", _root, _self);
                }
            }
            catch (JSDisconnectedException)
            {
                // The circuit ended; there is no page left to listen on.
            }
            catch (JSException ex)
            {
                // The Esc script could not load or attach: the slot still works, Esc just is not heard here.
                Logger.LogWarning(ex, "The editing section Esc listener could not be attached.");
            }
        }

        if (_focusSlot && _request is not null)
        {
            _focusSlot = false;
            try
            {
                // Below a full-height hero, so bring it into view (it stops under the sticky banner), then name it for screen readers.
                await JS.InvokeVoidAsync("tuvimaEditorScrollTo", "#tl-editing-slot");
                await JS.InvokeVoidAsync("tuvimaFocusById", "tl-editing-slot-title");
            }
            catch (JSDisconnectedException)
            {
                // The circuit ended; there is nothing left to scroll or focus.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnModeChanged;
            if (ReferenceEquals(_subscribed.SectionHost, this))
            {
                _subscribed.SectionHost = null;
            }
        }

        if (_escapeModule is { } module)
        {
            _escapeModule = null;
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit ended; the browser already dropped the module.
            }
            catch (JSException ex)
            {
                Logger.LogWarning(ex, "The editing section Esc script could not be released.");
            }
        }
    }

    private void OnModeChanged()
    {
        SyncOpenState();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnDirtyChanged(bool dirty) => Mode?.SetSectionDirty(dirty);

    private void OnSavingChanged(bool saving) => Mode?.SetSectionSaving(saving);

    private Task OnCommittedAsync()
    {
        if (_swallowNextCommit)
        {
            // The save from the dialog already told the page; this is the editor's own report of the same commit.
            _swallowNextCommit = false;
            return Task.CompletedTask;
        }

        _commitSeenDuringSave = true;
        return OnCommitted.InvokeAsync();
    }

    // The editor closed itself (after its own Save): the section closes with it.
    private Task OnShellClosedAsync(bool applied)
    {
        Mode?.CloseSection();
        return Task.CompletedTask;
    }

    // The close button: asks "Save or discard?" first when the section holds unsaved input.
    private async Task CloseAsync()
    {
        if (Mode is not null)
        {
            await Mode.CloseSectionAsync();
        }
    }

    /// <summary>Esc heard by the slot's own listener (a page outside the overlay); the rules for whether it is ours are in the script.</summary>
    [JSInvokable]
    public async Task HandleEscapeFromBrowser()
    {
        if (Mode is not null)
        {
            await Mode.HandleEscapeAsync();
        }
    }

    // IEditingSectionHost: the page's "Save or discard?" answers for what this section holds.
    async Task<bool> IEditingSectionHost.SaveAsync()
    {
        if (_shell is null)
        {
            return true;
        }

        var hadChanges = _shell.HasUnsavedChanges;
        _commitSeenDuringSave = false;
        var saved = await _shell.SaveChangesAsync();

        // The editor reports a commit from its next render, but a save that closes the section removes it before that render,
        // so the page (the hero artwork, the fields) would never refresh: report it here instead.
        if (saved && hadChanges && !_commitSeenDuringSave)
        {
            _swallowNextCommit = true;
            await OnCommitted.InvokeAsync();
        }

        return saved;
    }

    Task IEditingSectionHost.DiscardAsync()
    {
        _shell?.DiscardChanges();
        return Task.CompletedTask;
    }

    private async Task RememberOpenerAsync()
    {
        try { await JS.InvokeVoidAsync("tuvimaFocusReturn.remember"); }
        catch (JSDisconnectedException) { /* the circuit ended; there is nothing to remember */ }
    }

    private async Task RestoreOpenerAsync()
    {
        try { await JS.InvokeVoidAsync("tuvimaFocusReturn.restore", (object)FocusFallbacks); }
        catch (JSDisconnectedException) { /* the circuit ended; focus no longer matters */ }
    }
}
