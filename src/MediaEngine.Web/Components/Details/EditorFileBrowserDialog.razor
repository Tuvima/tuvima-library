@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Ui
@implements IDisposable
@inject IAppDialogService Dialogs
@inject IAppToastService Toasts
@inject IStringLocalizer<SharedStrings> L

@* The supporting-files browser (universal editor v5 WP8, screen E): "All supporting files" and the folder button open it over the editor. A dialog
   whose body is the shared browser frame (D32, WP8a): search and two filters on top, the left list (Where, groups, the switch to Folders and files),
   the table with ticks and the bulk bar, and a footer with paging, Close and Edit selected. The "Folders and files" view is the same frame with
   folder rows (EditorFileBrowserFolders). It answers with what the editor should do next; the ticks and filters stay in the editor's
   EditorFileBrowserState, so "Back to the list" finds them again. *@
<AppDialogShell Title="@L["EditorBrowser_Title"].Value"
                Subtitle="@EditorFileBrowserRules.Subtitle(L, State.TitleName, State.List?.TotalAll ?? 0, State.MediaType)"
                Icon="@AppMaterialIcons.Outlined.Collections"
                Size="Large"
                HostClass="@AppBrowserFrame.HostClass"
                OnClose="@(() => Finish(EditorFileBrowserOutcome.Closed))">
    <ChildContent>
        <div class="tl-fbrowser" data-testid="file-browser" data-view="@State.View.ToString().ToLowerInvariant()">
            @if (State.View == EditorBrowserView.Folders)
            {
                <EditorFileBrowserFolders State="State" Session="Session" Subject="Subject" Family="Family" IsVideoSeries="IsVideoSeries" CanEdit="CanEdit" OnChoose="Finish" />
            }
            else
            {
                <AppBrowserFrame Kind="files"
                                 ToolbarSpansWindow="true"
                                 Busy="State.Loading"
                                 Search="@State.Query"
                                 SearchChanged="@(value => State.SetQueryAsync(value))"
                                 SearchPlaceholder="@L["EditorBrowser_SearchPlaceholder"].Value"
                                 SidebarLabel="@L["EditorBrowser_Filters"].Value"
                                 SidebarTestId="file-browser-sidebar"
                                 ListLabel="@L["EditorBrowser_Title"].Value"
                                 ListTestId="file-browser-table"
                                 IdPrefix="@RowIdPrefix"
                                 RowCount="State.Rows.Count"
                                 Highlight="_highlight"
                                 HighlightChanged="@(index => _highlight = index)"
                                 OnOpenRow="OpenHighlightedAsync"
                                 OnToggleRow="@(ReadOnly ? default : EventCallback.Factory.Create<int>(this, ToggleHighlighted))"
                                 ShowState="ShowState">
                    <ToolbarEnd>
                        <div class="tl-fbrowser__select">
                            <AppSelect T="string" Value="@State.Where" ValueChanged="@(value => State.SetWhereAsync(value))" Options="@WhereChoices"
                                       AriaLabel="@L["EditorBrowser_Where"].Value" />
                        </div>
                        <div class="tl-fbrowser__select">
                            <AppSelect T="string" Value="@(State.TypeFilter ?? EditorFileBrowserRules.AllTypes)" ValueChanged="@(value => State.SetTypeAsync(value))" Options="@TypeChoices"
                                       AriaLabel="@L["EditorBrowser_Type"].Value" />
                        </div>
                    </ToolbarEnd>
                    <Sidebar><EditorFileBrowserSidebar State="State" ReadOnly="ReadOnly" /></Sidebar>
                    <InsideContent>
                        @if (State.List is { Total: > 0 })
                        {
                            <div class="tl-fbrowser__count" data-testid="file-browser-count" aria-busy="@(State.Loading ? "true" : null)">@EditorFileBrowserRules.ShowingLine(L, State.List)</div>
                        }
                    </InsideContent>
                    <Columns><EditorFileBrowserColumns State="State" ReadOnly="ReadOnly" /></Columns>
                    <Rows>
                        <EditorFileBrowserTable State="State" CanEdit="CanEdit" ReadOnly="ReadOnly" Highlight="_highlight" IdPrefix="@RowIdPrefix" OnChoose="Finish" OnDeleteRow="DeleteRowAsync" />
                    </Rows>
                    <StateContent>
                        @if (State.Error is { } error && State.List is null)
                        {
                            <AppErrorState Message="@L[error].Value" Compact="true" Retry="@(() => State.ReloadAsync())" />
                        }
                        else if (State.List is null)
                        {
                            <div class="tl-fbrowser__busy" aria-busy="true" aria-label="@L["EditorBrowser_Loading"].Value" data-testid="file-browser-loading">
                                <AppSkeleton Height="3rem" Width="100%" /><AppSkeleton Height="3rem" Width="100%" /><AppSkeleton Height="3rem" Width="100%" />
                            </div>
                        }
                        else if (State.List.TotalAll == 0)
                        {
                            <AppEmptyState Title="@L["EditorBrowser_NoFiles"].Value" Message="@L["EditorBrowser_NoFilesHint"].Value" Icon="@AppMaterialIcons.Outlined.Collections" />
                        }
                        else if (State.List.Total == 0)
                        {
                            <div class="tl-fbrowser__nothing" data-testid="file-browser-nothing">
                                <AppEmptyState Title="@L["EditorBrowser_NothingMatches"].Value" Icon="@AppMaterialIcons.Outlined.Search">
                                    <Action>
                                        <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Primary" Size="AppControlSize.Compact" data-clear-filters="true"
                                                   OnClick="@(() => State.ClearFiltersAsync())">@L["EditorBrowser_ClearFilters"]</AppButton>
                                    </Action>
                                </AppEmptyState>
                            </div>
                        }
                    </StateContent>
                    <AfterContent>
                        @if (State.Error is { } reloadError && State.List is { Total: > 0 })
                        {
                            @* A list is showing but the last read failed: say so, and offer to read again. *@
                            <div class="tl-fbrowser__reload" role="alert" data-testid="file-browser-reload-error">
                                <span>@L[reloadError]</span>
                                <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary" Size="AppControlSize.Compact" data-reload="true"
                                           OnClick="@(() => State.ReloadAsync())">@L["EditorBrowser_TryAgain"]</AppButton>
                            </div>
                        }

                        @if (!ReadOnly)
                        {
                            <EditorFileBrowserBulkBar State="State" CanEdit="CanEdit" OnDelete="DeleteTickedAsync" />
                        }
                    </AfterContent>
                </AppBrowserFrame>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <span class="tl-fbrowser__hint">@(State.View == EditorBrowserView.Files ? L["EditorBrowser_UngroupedHint"].Value : L["EditorBrowser_FoldersHint"].Value)</span>
        @if (State.View == EditorBrowserView.Files && State.List is { PageCount: > 1 } list)
        {
            <div class="tl-fbrowser__pager" role="navigation" aria-label="@L["EditorBrowser_Pages"].Value" data-testid="file-browser-pager">
                <AppIconButton Icon="@AppMaterialIcons.Outlined.ChevronLeft" AriaLabel="@L["EditorBrowser_PreviousPage"].Value" Tooltip="@L["EditorBrowser_PreviousPage"].Value"
                               Disabled="@(list.Page <= 1 || State.Loading)" OnClick="@(() => State.GoToPageAsync(list.Page - 1))" data-page="previous" />
                <span class="tl-fbrowser__page">@EditorFileBrowserRules.PageLine(L, list)</span>
                <AppIconButton Icon="@AppMaterialIcons.Outlined.ChevronRight" AriaLabel="@L["EditorBrowser_NextPage"].Value" Tooltip="@L["EditorBrowser_NextPage"].Value"
                               Disabled="@(list.Page >= list.PageCount || State.Loading)" OnClick="@(() => State.GoToPageAsync(list.Page + 1))" data-page="next" />
            </div>
        }

        <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Neutral" data-browser-close="true"
                   OnClick="@(() => Finish(EditorFileBrowserOutcome.Closed))">@L["EditorBrowser_Close"]</AppButton>
        @if (State.View == EditorBrowserView.Files && !ReadOnly)
        {
            <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(State.Ticked.Count == 0 || !CanEdit)" data-browser-edit="true"
                       OnClick="@(() => Finish(new EditorFileBrowserOutcome(EditorFileBrowserAction.EditSelected)))">@L["EditorBrowser_EditSelected"]</AppButton>
        }
    </FooterContent>
</AppDialogShell>

@code {
    private const string RowIdPrefix = "efb-row";

    private int _highlight;

    [CascadingParameter] private IAppDialogContext Dialog { get; set; } = default!;

    /// <summary>The browser's filters, page and ticks; they live in the editor so they outlast this dialog.</summary>
    [Parameter, EditorRequired] public EditorFileBrowserState State { get; set; } = default!;

    /// <summary>The editor's staged changes, for the "What is this file?" answers in the Folders and files view.</summary>
    [Parameter] public EditSessionState? Session { get; set; }

    /// <summary>The item being edited (a video can move to another series from the Folders and files view) and its family.</summary>
    [Parameter] public EditorMatchSubject? Subject { get; set; }

    [Parameter] public EditorFamilyState? Family { get; set; }

    /// <summary>The title is a Videos series: the Folders and files view shows its video order.</summary>
    [Parameter] public bool IsVideoSeries { get; set; }

    /// <summary>Reading only (the details page's Extras "See all"): no ticks, no bulk bar, no Edit selected, no Folders and files view, and each row has an Open button.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>False outside a desktop editing session (EditorDeviceRule.CanEdit): the browser only shows, opens and previews.</summary>
    [Parameter] public bool CanEdit { get; set; } = true;

    private IReadOnlyList<AppSelectOption> WhereChoices =>
    [
        .. (State.List?.WhereOptions ?? []).Select(option => new AppSelectOption(
            option.Key,
            $"{(option.ParentKey is null ? string.Empty : " ")}{option.Label} ({option.FileCount})")),
    ];

    private IReadOnlyList<AppSelectOption> TypeChoices =>
    [
        new(EditorFileBrowserRules.AllTypes, L["EditorBrowser_AllTypes"].Value),
        new(SupportingFileListDefaults.TypeDocument, L["EditorBrowser_TypeDocuments"].Value),
        new(SupportingFileListDefaults.TypeClip, L["EditorBrowser_TypeVideos"].Value),
        new(SupportingFileListDefaults.TypePicture, L["EditorBrowser_TypePictures"].Value),
        new(SupportingFileListDefaults.TypeAudio, L["EditorBrowser_TypeAudio"].Value),
    ];

    // Something stands in for the list while it is read, when it failed to load, and when there is nothing to list.
    private bool ShowState => State.List is null || State.List.TotalAll == 0 || State.List.Total == 0;

    private Task Finish(EditorFileBrowserOutcome outcome) => Dialog.CloseAsync(AppDialogResult.Ok(outcome));

    // Enter on the highlighted row opens the file on its Preview, like Open in the row menu; Space ticks it.
    private Task OpenHighlightedAsync(int index) =>
        index >= 0 && index < State.Rows.Count && Guid.TryParse(State.Rows[index].Id, out var id)
            ? Finish(new EditorFileBrowserOutcome(EditorFileBrowserAction.OpenFile, id, Preview: true))
            : Task.CompletedTask;

    private void ToggleHighlighted(int index)
    {
        if (index >= 0 && index < State.Rows.Count)
        {
            State.Toggle(State.Rows[index]);
        }
    }

    // Delete asks once and then happens at once (D29); the editor drops what was staged on the files.
    private Task DeleteTickedAsync() => DeleteAsync([.. State.Ticked]);

    private Task DeleteRowAsync(SupportingFileRowDto row) => DeleteAsync([row]);

    private async Task DeleteAsync(IReadOnlyList<SupportingFileRowDto> rows)
    {
        // Every edit handler is gated, not only its buttons (CLAUDE.md Never 1): the read-only See all browser and a device that cannot
        // edit never delete, whatever calls this.
        if (rows.Count == 0 || !CanEdit || ReadOnly)
        {
            return;
        }

        await EditorFileBrowserDeleteFlow.DeleteAsync(State, rows, Dialogs, Toasts, L);
    }

    protected override void OnInitialized() => State.Changed += OnChanged;

    // A new page or filter is a new list: the highlight stays on a row that still exists.
    private void OnChanged()
    {
        _highlight = Math.Clamp(_highlight, 0, Math.Max(0, State.Rows.Count - 1));
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => State.Changed -= OnChanged;
}
