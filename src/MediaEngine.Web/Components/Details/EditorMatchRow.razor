@namespace MediaEngine.Web.Components.Details

@* The Match tab's first row (universal editor v5, 3c, mockups G1 to G4): what the tab puts at the start (the provider dropdown, then the boxes of the
   item's kind and an icon-only Search) and the "Media providers / Wikidata" switch at the end. The Match tab fills it for the plain search; the TV
   and music flows fill it with their own boxes, so every kind shows the same single row and no box is ever drawn twice. *@
<div class="tl-matchrow" data-testid="match-row">
    <div class="tl-matchrow__start">@Start</div>
    <div class="tl-matchrow__end">@End</div>
</div>

@code {
    /// <summary>What sits at the start of the row: the provider dropdown, the boxes and Search.</summary>
    [Parameter] public RenderFragment? Start { get; set; }

    /// <summary>What sits at the end of the row: the source switch.</summary>
    [Parameter] public RenderFragment? End { get; set; }
}
