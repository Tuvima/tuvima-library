@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Ui
@implements IDisposable
@inject IStringLocalizer<SharedStrings> L

@* Review changes as a small dialog, for the paths that have no Editor window (the bar, ticked rows). The Editor window shows the same
   ReviewChangesView as a page of its own (universal editor spec D8). *@
<AppDialogShell Title="@L["ReviewChangesDialog_ReviewChanges"].Value" Subtitle="@L["ReviewChangesDialog_NothingIsSavedUntilYou"].Value" Size="Medium" OnClose="BackAsync">
    <ChildContent>
        <ReviewChangesView @ref="_view" Source="Source" OnOutcome="OnOutcomeAsync" />
    </ChildContent>
</AppDialogShell>

@code {
    private ReviewChangesView? _view;
    private IDisposable? _closeGuard;

    [CascadingParameter] private IAppDialogContext Dialog { get; set; } = default!;

    [Parameter, EditorRequired] public IReviewSource Source { get; set; } = default!;

    /// <summary>Opens Review changes for the flow's pending list and returns how the person left it.</summary>
    public static async Task<ReviewChangesOutcome> ShowAsync(IAppDialogService dialogs, IReviewSource source)
    {
        ArgumentNullException.ThrowIfNull(dialogs);
        ArgumentNullException.ThrowIfNull(source);
        var dialog = await dialogs.ShowAsync<ReviewChangesDialog>(
            string.Empty,
            new AppDialogParameters<ReviewChangesDialog> { { component => component.Source, source } },
            new AppDialogOptions
            {
                MaxWidth = AppMaxWidth.Medium,
                FullWidth = true,
                CloseButton = false,
                NoHeader = true,
                CloseOnEscapeKey = true,
            });

        return await dialog.Result is { Canceled: false, Data: ReviewChangesOutcome outcome } ? outcome : ReviewChangesOutcome.Back;
    }

    protected override void OnInitialized() =>
        _closeGuard = Dialog.RegisterCloseGuard(() => Task.FromResult(_view is not { IsSaving: true }));

    private Task OnOutcomeAsync(ReviewChangesOutcome outcome) => Dialog.CloseAsync(AppDialogResult.Ok(outcome));

    private Task BackAsync() => _view is { IsSaving: true } ? Task.CompletedTask : OnOutcomeAsync(ReviewChangesOutcome.Back);

    public void Dispose() => _closeGuard?.Dispose();
}
