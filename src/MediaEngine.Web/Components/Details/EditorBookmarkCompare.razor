@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Services.Editing
@inject IStringLocalizer<SharedStrings> L

@* The compare view of an imported bookmark file (universal editor v5 D37, mockup Q): each bookmark in the file beside the nearest one in
   Everyone's, with a tick for the ones to take. "Take all new" ticks only the bookmarks nothing in Everyone's is near. Nothing is changed
   here: Add stages one import for the title, written on Save changes. *@
<section class="tl-bookmarks-compare">
    <div class="tl-bookmarks__state">
        <div class="tl-bookmarks__state-copy">
            <AppButton ButtonStyle="AppButtonStyle.Text" StartIcon="@AppMaterialIcons.Outlined.ArrowBack" OnClick="OnBack">@L["Common_Back"]</AppButton>
            <h3>@Compare.Name</h3>
            <span class="tl-bookmarks__state-text">@L["EditorBookmarks_FileCount", Compare.BookmarkCount]</span>
        </div>
        <div class="tl-bookmarks__actions">
            <AppButton ButtonStyle="AppButtonStyle.Outlined" Disabled="@(!CanTake || NewRows.Count == 0)" OnClick="TakeAllNew">@L["EditorBookmarks_TakeAllNew"]</AppButton>
            <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(!CanTake || Chosen.Count == 0)" OnClick="TakeAsync">@L["EditorBookmarks_AddChosen", Chosen.Count]</AppButton>
        </div>
    </div>

    @if (!CanTake)
    {
        <AppAlert Severity="AppSeverity.Warning" Dense="true">@(string.IsNullOrWhiteSpace(Compare.Reason) ? L["EditorBookmarks_NotThisTitle"].Value : Compare.Reason)</AppAlert>
    }

    <ul class="tl-bookmarks__list">
        @foreach (var row in Compare.Rows)
        {
            var take = ChoiceOf(row) == BookmarkRowChoices.Incoming;
            <li class="tl-bookmarks__row" data-closeness="@row.Closeness.ToLowerInvariant()">
                <AppCheckbox Value="@take" ValueChanged="@(value => Set(row, value))" Disabled="@(!CanTake)" Label="@L["EditorBookmarks_Take"].Value" HideLabel="true" />
                <span class="tl-bookmarks__place">@EditorBookmarkWording.Time(row.Incoming.PositionSeconds)</span>
                <span class="tl-bookmarks__copy">
                    <span class="tl-bookmarks__name">@(string.IsNullOrWhiteSpace(row.Incoming.Note) ? row.Incoming.ChapterTitle : row.Incoming.Note)</span>
                    <span class="tl-bookmarks__from">
                        @if (row.Yours is { } near)
                        {
                            @L["EditorBookmarks_Nearest", EditorBookmarkWording.Time(near.PositionSeconds), near.Name ?? near.Note ?? string.Empty]
                        }
                        else
                        {
                            @L["EditorBookmarks_NothingNear"]
                        }
                    </span>
                </span>
                <AppChip Text="@ClosenessText(row)" Tone="@(row.Closeness == BookmarkClosenessLabels.New ? AppUiTone.Success : AppUiTone.Neutral)" />
            </li>
        }
    </ul>
</section>

@code {
    private readonly Dictionary<int, string> _choices = [];

    [Parameter, EditorRequired] public BookmarkSetCompareDto Compare { get; set; } = null!;

    /// <summary>Raised with the bookmarks the person ticked, ready to stage as one import.</summary>
    [Parameter] public EventCallback<IReadOnlyList<EditorBookmarkImportItem>> OnTake { get; set; }

    [Parameter] public EventCallback OnBack { get; set; }

    private bool CanTake => Compare is { Match: BookmarkPackMatchResults.Match, RowsReady: true };

    private IReadOnlyList<BookmarkSetCompareRowDto> NewRows => [.. Compare.Rows.Where(row => row.Closeness == BookmarkClosenessLabels.New)];

    private IReadOnlyList<BookmarkSetCompareRowDto> Chosen => [.. Compare.Rows.Where(row => ChoiceOf(row) == BookmarkRowChoices.Incoming)];

    // A New row is ticked unless the person unticked it; a row beside a bookmark of Everyone's follows the Engine's default.
    private string ChoiceOf(BookmarkSetCompareRowDto row) => _choices.TryGetValue(row.Index, out var chosen) ? chosen : row.DefaultChoice;

    private void Set(BookmarkSetCompareRowDto row, bool take) => _choices[row.Index] = take ? BookmarkRowChoices.Incoming : BookmarkRowChoices.Yours;

    private void TakeAllNew()
    {
        foreach (var row in Compare.Rows)
        {
            _choices[row.Index] = row.Closeness == BookmarkClosenessLabels.New ? BookmarkRowChoices.Incoming : BookmarkRowChoices.Yours;
        }
    }

    private string ClosenessText(BookmarkSetCompareRowDto row) => row.Closeness switch
    {
        BookmarkClosenessLabels.SameSpot => L["EditorBookmarks_SameSpot"].Value,
        BookmarkClosenessLabels.Close => L["EditorBookmarks_Close"].Value,
        BookmarkClosenessLabels.Far => L["EditorBookmarks_Far"].Value,
        _ => L["EditorBookmarks_New"].Value,
    };

    private Task TakeAsync() => OnTake.InvokeAsync(
        [.. Chosen.Select(row => new EditorBookmarkImportItem
        {
            PositionSeconds = row.Incoming.PositionSeconds,
            EndSeconds = row.Incoming.EndSeconds,
            ChapterTitle = row.Incoming.ChapterTitle,
            Name = row.Incoming.Note,
            Description = row.Incoming.Description,
            ReplacesBookmarkId = row.Yours?.Id,
        })]);
}
