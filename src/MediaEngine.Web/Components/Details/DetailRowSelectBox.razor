@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Services.Editing
@implements IDisposable
@inject IAppToastService Toasts

@* The tick box on a child row (track, audiobook part, episode, series item) while Editing Mode is on (details overlay spec D8).
   Outside Editing Mode, on a device that may not edit, or for a row that is not one title, nothing renders. *@
@if (Visible)
{
    <span class="@RootClass" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">
        <AppCheckbox Value="@IsSelected"
                     ValueChanged="ToggleAsync"
                     aria-label="@BulkEditRules.SelectLabel(Title)" />
    </span>
}

@code {
    private EditingModeContext? _mode;
    private BulkEditSelection? _selection;

    [CascadingParameter] public EditingModeContext? Mode { get; set; }

    [CascadingParameter] public BulkEditSelection? Selection { get; set; }

    [Parameter, EditorRequired] public Guid ItemId { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired] public DetailEntityType Kind { get; set; }

    /// <summary>The album, season or audiobook the row sits in, when the list knows it (Renumber and Match need it).</summary>
    [Parameter] public Guid? ParentId { get; set; }

    /// <summary>The editor media type of the row ("Music", "TV"), when the list knows it better than the page.</summary>
    [Parameter] public string? MediaType { get; set; }

    /// <summary>True on a card: the box sits in the card's top-left corner instead of inline in a row.</summary>
    [Parameter] public bool Floating { get; set; }

    private bool Visible => Mode is { IsOn: true, CanEdit: true }
        && Selection is not null
        && ItemId != Guid.Empty
        && BulkEditRules.IsSelectableKind(Kind);

    private bool IsSelected => Selection?.Contains(ItemId) == true;

    private string RootClass => Floating ? "tl-row-select tl-row-select--floating" : "tl-row-select";

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_mode, Mode))
        {
            if (_mode is not null)
            {
                _mode.Changed -= OnStateChanged;
            }

            _mode = Mode;
            if (_mode is not null)
            {
                _mode.Changed += OnStateChanged;
            }
        }

        if (!ReferenceEquals(_selection, Selection))
        {
            if (_selection is not null)
            {
                _selection.Changed -= OnStateChanged;
            }

            _selection = Selection;
            if (_selection is not null)
            {
                _selection.Changed += OnStateChanged;
            }
        }
    }

    private void ToggleAsync(bool _)
    {
        if (Selection is null || Mode is not { IsOn: true, CanEdit: true })
        {
            return;
        }

        if (!Selection.Toggle(new BulkEditRow(ItemId, Title, Kind, ParentId, MediaType)))
        {
            Toasts.Add(BulkEditSelection.FullNotice, AppSeverity.Info);
        }
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_mode is not null)
        {
            _mode.Changed -= OnStateChanged;
        }

        if (_selection is not null)
        {
            _selection.Changed -= OnStateChanged;
        }
    }
}
