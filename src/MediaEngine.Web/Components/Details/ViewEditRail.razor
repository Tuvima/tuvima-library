@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.LocalAssets
@using MediaEngine.Web.Services.Editing
@inject IStringLocalizer<SharedStrings> L

@* The gallery and its photos in the header of the View editor (spec photos-documents-editor point 3, Shy Q8; header revision v4.1 D1): only when the
   item has a family. Opened from inside a gallery the gallery is a fixed tile at the left of the header ("Lisbon 2026") and the photo is a dropdown
   under the title ("IMG_4521"), which lists the gallery's photos with thumbnails so you can step through them without closing. What was staged on
   the other photos is kept. Opened from the Timeline, Photos, Documents or a search there is nothing to draw. The header draws the two parts (Tile,
   then Selects); on its own it draws both. It uses the library editor's classes, so it looks the same. Nothing is saved here. *@
@if (Session.Rail is { } rail)
{
    var showTile = Part != EditorFamilyRailPart.Selects;
    var showSelects = Part != EditorFamilyRailPart.Tile;
    if (showTile && !showSelects)
    {
        <div class="tl-rail-tile">
            @GalleryTile(rail)
        </div>
    }
    else
    {
        <nav class="tl-rail" aria-label="@L["EditorRail_Label"]">
            @if (showTile)
            {
                @GalleryTile(rail)
            }

            <div class="tl-rail__level">
                <AppButton ButtonStyle="AppButtonStyle.Text"
                           Class="tl-rail__crumb tl-rail__crumb--current"
                           aria-haspopup="listbox"
                           aria-expanded="@(_open ? "true" : "false")"
                           aria-current="true"
                           data-level="item"
                           Disabled="@(Session.Saving || Session.Switching)"
                           OnClick="Toggle">
                    <span class="tl-rail__thumb" aria-hidden="true">
                        @if (Session.Active.Items.Count == 1)
                        {
                            <AppImage Src="@Session.Active.Items[0].ThumbnailUrl" Alt="" Width="32" Height="32" ObjectFit="AppObjectFit.Cover" Class="tl-rail__img" />
                        }
                    </span>
                    <span class="tl-rail__text"><small>@(Session.Active.Items.Count == 1 ? Kind(Session.Active.Items[0]) : L["ViewEdit_KindPhotos"].Value)</small><span>@Session.Active.ItemLabel()</span></span>
                    @if (OthersWaiting() > 0)
                    {
                        <AppTooltip Text="@L["EditorRail_ChangesWaiting"]"><span class="tl-rail__dot" role="img" aria-label="@L["EditorRail_ChangesWaiting"]"></span></AppTooltip>
                    }
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ExpandMore" Size="AppIconSize.Control20" />
                </AppButton>
                @if (_open)
                {
                    @* Drawn through the shared popover so it sits in the top layer above the editor window. *@
                    <AppPopover Open="true" OpenChanged="PopoverChanged" Class="tl-rail__surface">
                        <div class="tl-rail__panel" role="listbox" aria-label="@rail.GalleryName">
                            <ul class="tl-rail__options">
                                @foreach (var member in rail.Members)
                                {
                                    var selected = Session.Active.Items.Count == 1 && Session.Active.Items[0].Id == member.Id;
                                    <li @key="member.Id">
                                        <AppButton ButtonStyle="AppButtonStyle.Text" role="option" aria-selected="@(selected ? "true" : "false")" Class="tl-rail__option"
                                                   OnClick="@(() => PickAsync(member))">
                                            <span class="tl-rail__thumb" aria-hidden="true"><AppImage Src="@member.ThumbnailUrl" Alt="" Width="32" Height="32" ObjectFit="AppObjectFit.Cover" Class="tl-rail__img" /></span>
                                            <span class="tl-rail__text"><span>@ViewEditStage.DisplayTitle(member)</span></span>
                                            @if (selected)
                                            {
                                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Check" Size="AppIconSize.Control20" />
                                            }
                                        </AppButton>
                                    </li>
                                }
                            </ul>
                        </div>
                    </AppPopover>
                }
            </div>
        </nav>
    }
}

@code {
    private bool _open;

    [Parameter, EditorRequired] public ViewEditSession Session { get; set; } = default!;

    /// <summary>Which part to draw: the header draws the gallery tile and the photo dropdown in two places; on its own it draws both.</summary>
    [Parameter] public EditorFamilyRailPart Part { get; set; } = EditorFamilyRailPart.All;

    /// <summary>The window moves to another photo of the gallery; the host reads it again and keeps what is staged on the others.</summary>
    [Parameter] public EventCallback<LocalAssetDto> OnPick { get; set; }

    // The gallery: a fixed tile at the left of the header. It names the gallery and does nothing when pressed.
    private RenderFragment GalleryTile(ViewEditGalleryRail rail) => __builder =>
    {
        <div class="tl-rail__level tl-rail__level--tile">
            <AppButton ButtonStyle="AppButtonStyle.Text" Class="tl-rail__crumb tl-rail__crumb--tile" aria-current="false" data-level="gallery" OnClick="@(() => { })" Disabled="true">
                <span class="tl-rail__thumb" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PhotoAlbum" Size="AppIconSize.Control20" /></span>
                <span class="tl-rail__text"><small>@L["ViewEdit_KindGallery"]</small><span>@rail.GalleryName</span></span>
            </AppButton>
        </div>
    };

    private string Kind(LocalAssetDto item) => item.MediaKind == ViewMediaKinds.Video ? L["ViewEdit_KindVideo"].Value : L["ViewEdit_KindPhoto"].Value;

    // A dot on the dropdown when some other photo of the gallery has changes waiting.
    private int OthersWaiting() => Session.ChangeCount - Session.Active.ChangeCount;

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;

    // The shared popover reports an outside click or Escape.
    private void PopoverChanged(bool open)
    {
        if (!open)
        {
            Close();
        }
    }

    private async Task PickAsync(LocalAssetDto member)
    {
        _open = false;
        await OnPick.InvokeAsync(member);
    }
}
