@namespace MediaEngine.Web.Components.Watch
@using System.Globalization
@using Microsoft.JSInterop
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Playback
@inject PlaybackSessionController Playback
@inject IEngineApiClient ApiClient
@inject ShellActivityState Activity
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ILogger<VideoPlaybackHost> Logger
@implements IAsyncDisposable

<section class="@StageClass"
         aria-label="@(Playback.IsVideoMode ? "Video player" : null)"
         aria-hidden="@(Playback.IsVideoMode ? "false" : "true")"
         tabindex="-1"
         @onkeydown="HandleVideoKeyDown">
    <video @ref="_videoRef"
           id="tuvima-video-engine"
           data-playback-asset-id="@Playback.CurrentItem?.AssetId"
           class="video-playback-host__media"
           playsinline
           preload="metadata"
           poster="@Playback.CurrentItem?.CoverUrl"
           @onloadedmetadata="HandleMetricsChangedAsync"
           @ondurationchange="HandleMetricsChangedAsync"
           @onplay="HandleStartedAsync"
           @onpause="HandlePausedAsync"
           @onerror="HandleErrorAsync"
           @onended="HandleEndedAsync">
        @foreach (var track in SubtitleTracks)
        {
            <track kind="subtitles"
                   @key="@($"{track.Index}-{track.DeliveryUrl}")"
                   data-playback-track-key="@($"manifest:{track.Index}")"
                   src="@SubtitleUrl(track)"
                   srclang="@(track.Language ?? "und")"
                   label="@SubtitleLabel(track)"
                   default="@track.IsDefault" />
        }
        @foreach (var track in ManagedSubtitleTracks)
        {
            <track kind="subtitles"
                   @key="track.Id"
                   data-playback-track-key="@($"managed:{track.Id:D}")"
                   src="@($"/engine-text-track/{Playback.CurrentItem!.AssetId!.Value:D}/{track.Id:D}")"
                   srclang="@track.Language"
                   label="@ManagedSubtitleLabel(track)" />
        }
    </video>

    @if (Playback.IsVideoMode && Playback.IsVideoExpanded && Playback.CurrentItem is not null)
    {
        <div class="video-playback-host__shade"></div>
        <header class="video-playback-host__header">
            <PlaybackControlStrip Controls="@VideoHeaderUtilityControls"
                                  Size="compact"
                                  Surface="dock"
                                  Class="video-playback-host__header-tools"
                                  AriaLabel="Video utility controls"
                                  OnControl="HandleVideoUtilityControl" />
            <AppNativeButton Type="button"
                             Class="video-playback-host__icon"
                             OnClick="ClosePlayerAsync"
                             AriaLabel="Close player"
                             title="Close player">
                <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Close" />
            </AppNativeButton>
        </header>

        @if (Playback.Phase == PlaybackPhase.Loading || !string.IsNullOrWhiteSpace(Playback.CurrentError))
        {
            <div class="video-playback-host__status" role="status">
                @(Playback.CurrentError ?? "Preparing video… Playback will begin automatically.")
            </div>
        }

        <div class="video-playback-host__stage-transport" aria-label="Video transport controls">
            <PlaybackRelativeSkipButton Seconds="@Playback.SkipBackSeconds" Direction="back" Size="large" OnClick="SkipBackAsync" />
            <PlaybackPrimaryButton IsPlaying="@VideoIsPlaying"
                                   NeedsUserGestureToStart="@Playback.NeedsUserGestureToStart"
                                   disabled="@(Playback.Phase is PlaybackPhase.Loading or PlaybackPhase.Error)"
                                   Size="large" OnClick="TogglePlayPauseAsync" />
            <PlaybackRelativeSkipButton Seconds="@Playback.SkipForwardSeconds" Direction="forward" Size="large" OnClick="SkipForwardAsync" />
        </div>

        <div class="video-playback-host__controls">
            <div class="video-playback-host__stage-identity">
                <span>@VideoContext</span>
                <strong>@(Playback.CurrentItem.EpisodeTitle ?? Playback.CurrentItem.Title)</strong>
                @if (!string.IsNullOrWhiteSpace(VideoEpisodeMetadata))
                {
                    <small>@VideoEpisodeMetadata</small>
                }
            </div>
            @if (VisibleSkipSegment is { } segment)
            {
                <AppNativeButton Type="button"
                                 Class="video-playback-host__skip-segment"
                                 OnClick="@(() => SeekOnHostAsync(segment.EndSeconds!.Value))">
                    @SkipLabel(segment.Kind)
                </AppNativeButton>
            }

            <div class="video-playback-host__timeline">
                <span>@FormatTimestamp(Playback.CurrentTimeSeconds)</span>
                <PlaybackRangeSlider Min="0" Max="@ProgressMax" Step="1"
                                     Value="@Math.Min(Playback.CurrentTimeSeconds, ProgressMax)"
                                     ShowTicks="false" CommitOnChange="true" Class="video-playback-host__progress"
                                     AriaLabel="Playback position" ValueFormatter="@(_ => ProgressValueText)"
                                     ValueChanged="SeekOnHostAsync" />
                <span>-@FormatTimestamp(Math.Max(0, Playback.DurationSeconds - Playback.CurrentTimeSeconds))</span>
            </div>

            <div class="video-playback-host__toolbar">
                <div class="video-playback-host__tools">
                    <PlaybackControlStrip Controls="@VideoPrimaryChoiceControls"
                                          Size="compact"
                                          Surface="video"
                                          Class="video-playback-host__tool-strip video-playback-host__primary-choice-row"
                                          AriaLabel="Video tools"
                                          SpeedValue="@Playback.PlaybackRate"
                                          SpeedChanged="SelectPlaybackRateAsync"
                                          SpeedMenuOpen="@_rateMenuOpen"
                                          SpeedMenuOpenChanged="HandleRateMenuOpenChanged"
                                          OnControl="HandleVideoPrimaryChoiceControl" />
                    @if (VideoSecondaryToolControls.Count > 0)
                    {
                        <PlaybackControlStrip Controls="@VideoSecondaryToolControls"
                                              Size="compact"
                                              Surface="video"
                                              Class="video-playback-host__secondary-strip"
                                              AriaLabel="More video tools"
                                              SpeedValue="@Playback.PlaybackRate"
                                              SpeedChanged="SelectPlaybackRateAsync"
                                              SpeedMenuOpen="@_rateMenuOpen"
                                              SpeedMenuOpenChanged="HandleRateMenuOpenChanged"
                                              OnControl="HandleVideoToolControl" />
                    }
                    <PlaybackRangeSlider Min="0" Max="1" Step="0.05" InputStep="0.05"
                                         Value="@Playback.Volume" ValueChanged="SetVolumeOnHostAsync"
                                         ShowTicks="false" Surface="video" Class="video-playback-host__volume"
                                         AriaLabel="Volume" ValueFormatter="FormatVolume" />
                </div>
            </div>
        </div>

        @if (_activeToolSheet is not null)
        {
            <div class="video-playback-host__tool-backdrop" role="presentation" aria-hidden="true" @onclick="CloseToolSheet"></div>
            <PlaybackToolSheet Title="@VideoToolTitle"
                               Subtitle="@VideoToolSubtitle"
                               Icon="@VideoToolIcon"
                               Surface="popup"
                               Modal="true"
                               Class="video-playback-host__tool-sheet"
                               OnClose="CloseToolSheet">
                @switch (_activeToolSheet)
                {
                    case "chapters":
                        <PlaybackSheetList>
                            @foreach (var chapter in VideoChapters)
                            {
                                var isActive = IsCurrentVideoChapter(chapter);
                                <PlaybackSheetRow Variant="chapter" IsActive="@isActive" OnClick="@(() => PlayVideoChapterAsync(chapter))" AriaLabel="@($"Play {chapter.Title}")">
                                    <span class="playback-sheet-row__copy"><strong>@chapter.Title</strong></span>
                                    <span class="playback-sheet-row__duration">@FormatTimestamp(Math.Max(0, (chapter.EndSeconds ?? chapter.StartSeconds) - chapter.StartSeconds))</span>
                                </PlaybackSheetRow>
                            }
                        </PlaybackSheetList>
                        break;
                    case "queue":
                        <PlaybackSheetList>
                            @for (var index = Playback.CurrentIndex + 1; index < Playback.Queue.Count; index++)
                            {
                                var queueIndex = index;
                                var item = Playback.Queue[index];
                                <PlaybackContextRow Class="video-playback-host__next-up-row"
                                                    Title="@(item.EpisodeTitle ?? item.Title)"
                                                    Subtitle="@VideoQueueSubtitle(item)"
                                                    Duration="@VideoQueueRuntime(item)"
                                                    OnClick="@(() => PlayVideoQueueItemAsync(queueIndex))"
                                                    AriaLabel="@($"Play {item.EpisodeTitle ?? item.Title}")" />
                            }
                        </PlaybackSheetList>
                        break;
                    case "history":
                        <PlaybackSheetList>
                            @foreach (var item in Playback.History)
                            {
                                <PlaybackSheetRow IsButton="false">
                                    <span class="playback-sheet-row__copy"><strong>@item.Title</strong><span>@item.Subtitle</span></span>
                                    <span class="playback-sheet-row__duration">@item.Duration</span>
                                </PlaybackSheetRow>
                            }
                        </PlaybackSheetList>
                        break;
                    case "captions":
                        <PlaybackSheetList>
                            <PlaybackSheetRow OnClick="@(() => SelectCaptionAsync(null))" IsActive="@(!_captionTracks.Any(track => track.Selected))" AriaLabel="Turn captions off">
                                <span class="playback-sheet-row__copy"><strong>Off</strong></span>
                            </PlaybackSheetRow>
                            @foreach (var track in _captionTracks)
                            {
                                <PlaybackSheetRow OnClick="@(() => SelectCaptionAsync(track.Key))" IsActive="@track.Selected" AriaLabel="@($"Select {track.Label} captions")">
                                    <span class="playback-sheet-row__copy"><strong>@track.Label</strong><span>@CaptionChoiceSubtitle(track)</span></span>
                                </PlaybackSheetRow>
                            }
                            @if (_selectedCaptionKey?.StartsWith("managed:", StringComparison.Ordinal) == true)
                            {
                                <PlaybackSheetRow OnClick="SetPreferredSubtitleAsync" AriaLabel="Set selected subtitles as preferred">
                                    <span class="playback-sheet-row__copy"><strong>Set preferred version</strong></span>
                                </PlaybackSheetRow>
                            }
                            <PlaybackSheetRow OnClick="RefreshSubtitlesAsync" AriaLabel="Find better subtitles">
                                <span class="playback-sheet-row__copy"><strong>Find better subtitles</strong><span>@(_textTrackLoading ? "Searching…" : "Search available providers")</span></span>
                            </PlaybackSheetRow>
                            @if (!string.IsNullOrWhiteSpace(_textTrackStatus))
                            {
                                <p role="status" class="video-playback-host__track-status">@_textTrackStatus</p>
                            }
                        </PlaybackSheetList>
                        break;
                    case "audio-track":
                        <PlaybackSheetList>
                            @for (var index = 0; index < AudioTracks.Count; index++)
                            {
                                var trackIndex = index;
                                var track = AudioTracks[index];
                                <PlaybackSheetRow OnClick="@(() => SelectAudioTrackAsync(trackIndex))"
                                                  IsActive="@(_selectedAudioTrackIndex == trackIndex || (_selectedAudioTrackIndex is null && track.IsDefault))"
                                                  AriaLabel="@($"Select {AudioTrackLabel(track, trackIndex)}")">
                                    <span class="playback-sheet-row__copy"><strong>@AudioTrackLabel(track, trackIndex)</strong><span>@track.Codec</span></span>
                                </PlaybackSheetRow>
                            }
                        </PlaybackSheetList>
                        break;
                    case "quality":
                        <PlaybackSheetList>
                            <PlaybackSheetRow IsButton="false" IsActive="true">
                                <span class="playback-sheet-row__copy"><strong>@QualityLabel</strong><span>Current source quality</span></span>
                            </PlaybackSheetRow>
                        </PlaybackSheetList>
                        break;
                }
            </PlaybackToolSheet>
        }
    }
</section>

@if (Playback.HasQueue && Playback.IsVideoMode && !Playback.IsVideoExpanded && Playback.CurrentItem is not null)
{
    <section class="video-playback-restore" aria-label="Video playback">
        <span>@Playback.CurrentItem.Title</span>
        @if (!string.IsNullOrWhiteSpace(_continuationStatus))
        {
            <small role="status">@_continuationStatus</small>
        }
        <AppNativeButton Type="button" Class="video-playback-restore__button" OnClick="RestoreVideoAsync" AriaLabel="Restore video player">
            <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Expand" /> Restore
        </AppNativeButton>
        <AppNativeButton Type="button" Class="video-playback-restore__button" OnClick="ClosePlayerAsync" AriaLabel="Stop video playback">
            <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Close" />
        </AppNativeButton>
    </section>
}

@code {
    private ElementReference _videoRef;
    private DotNetObjectReference<VideoPlaybackHost>? _selfReference;
    private bool _observerRegistered;
    private string? _lastAppliedStreamUrl;
    private long _lastAppliedStartVersion = -1;
    private bool? _lastAppliedPlayingState;
    private double? _lastAppliedVolume;
    private bool? _lastAppliedMuteState;
    private double? _lastAppliedPlaybackRate;
    private Guid? _activeAssetId;
    private int _availableSubtitleCount;
    private int _availableAudioTrackCount;
    private int? _selectedAudioTrackIndex;
    private bool _canPictureInPicture;
    private string? _continuationStatus;
    private string? _activeToolSheet;
    private bool _rateMenuOpen;
    private Guid? _loadedSubtitleAssetId;
    private IReadOnlyList<TextTrackDto> _managedSubtitleTracks = [];
    private IReadOnlyList<CaptionTrackMetric> _captionTracks = [];
    private string? _selectedCaptionKey;
    private string? _textTrackStatus;
    private bool _textTrackLoading;

    private string StageClass =>
        Playback.IsVideoMode && Playback.IsVideoExpanded
            ? "video-playback-host is-expanded"
            : "video-playback-host";
    private double ProgressMax => Playback.DurationSeconds > 0 ? Playback.DurationSeconds : 1d;
    private string ProgressValueText => $"{FormatTimestamp(Playback.CurrentTimeSeconds)} of {FormatTimestamp(ProgressMax)}";
    private IReadOnlyList<PlaybackSubtitleTrackDto> SubtitleTracks =>
        (Playback.CurrentManifest?.SubtitleTracks ?? [])
            .Where(track => !string.IsNullOrWhiteSpace(track.DeliveryUrl))
            .ToList();
    private IReadOnlyList<PlaybackTrackDto> AudioTracks => Playback.CurrentManifest?.AudioTracks ?? [];
    private IReadOnlyList<PlaybackChapterDto> VideoChapters => Playback.CurrentItem?.Chapters ?? [];
    private IReadOnlyList<TextTrackDto> ManagedSubtitleTracks => _managedSubtitleTracks
        .Where(track => track.Kind.Equals("Subtitle", StringComparison.OrdinalIgnoreCase) || track.Kind.Equals("Subtitles", StringComparison.OrdinalIgnoreCase))
        .ToList();
    private bool VideoIsPlaying => Playback.IsPlaying && Playback.Phase is not (PlaybackPhase.Loading or PlaybackPhase.Error);
    private PlaybackControlState VideoControlState => new(
                ActiveSheet: _activeToolSheet,
                PlaybackRate: Playback.PlaybackRate,
                SkipBackSeconds: Playback.SkipBackSeconds,
                SkipForwardSeconds: Playback.SkipForwardSeconds,
                HasChapters: VideoChapters.Count > 0,
                HasQueue: Playback.CurrentIndex < Playback.Queue.Count - 1,
                IsTvEpisode: !string.IsNullOrWhiteSpace(Playback.CurrentItem?.EpisodeNumber),
                HasCaptions: SubtitleTracks.Count > 0 || ManagedSubtitleTracks.Count > 0 || _captionTracks.Count > 0 || _availableSubtitleCount > 0,
                HasAudioTracks: AudioTracks.Count > 1 && _availableAudioTrackCount == AudioTracks.Count,
                HasQualityOptions: false,
                CanFindCaptions: Playback.CurrentItem?.AssetId is not null,
                CanPictureInPicture: _canPictureInPicture,
                CanFullscreen: true,
                IsMuted: Playback.IsMuted || Playback.Volume <= 0);
    private IReadOnlyList<PlaybackControlDefinition> VideoToolControls =>
        PlaybackControlCatalog.BuildPrimaryToolStrip(
            PlaybackExperience.Video,
            PlaybackControlSurface.Fullscreen,
            VideoControlState);
    private IReadOnlyList<PlaybackControlDefinition> VideoSecondaryToolControls =>
        PlaybackControlCatalog.BuildSecondaryToolStrip(
            PlaybackExperience.Video,
            PlaybackControlSurface.Fullscreen,
            VideoControlState);
    private IReadOnlyList<PlaybackControlDefinition> VideoPrimaryChoiceControls =>
        VideoToolControls.Concat(VideoUtilityControls.Where(control => control.Key == PlaybackControlKey.Fullscreen)).ToList();
    private IReadOnlyList<PlaybackControlDefinition> VideoUtilityControls =>
        PlaybackControlCatalog.BuildUtilityControls(
                PlaybackExperience.Video,
                PlaybackControlSurface.Fullscreen,
                VideoControlState)
            .Where(control => control.Key != PlaybackControlKey.Volume)
            .ToList();
    private IReadOnlyList<PlaybackControlDefinition> VideoHeaderUtilityControls =>
        VideoUtilityControls.Where(control => control.Key != PlaybackControlKey.Fullscreen).ToList();
    private string VideoToolTitle => _activeToolSheet switch
    {
        "chapters" => "Chapters",
        "queue" => "Next Up",
        "history" => "Watching history",
        "captions" => "Captions",
        "audio-track" => "Audio track",
        "quality" => "Quality",
        _ => "Video tools",
    };
    private string VideoToolSubtitle => _activeToolSheet switch
    {
        "chapters" => VideoChapters.FirstOrDefault(IsCurrentVideoChapter) is { } chapter ? $"Current chapter · {chapter.Title}" : string.Empty,
        "queue" => "Continue through the current queue",
        "history" => "Played during this session",
        "captions" => "Available subtitle tracks",
        "quality" => "Current delivery quality",
        _ => string.Empty,
    };
    private string VideoToolIcon => _activeToolSheet switch
    {
        "chapters" => Icons.Material.Outlined.FormatListBulleted,
        "queue" => Icons.Material.Outlined.QueuePlayNext,
        "history" => Icons.Material.Outlined.History,
        "captions" => Icons.Material.Outlined.ClosedCaption,
        "audio-track" => Icons.Material.Outlined.RecordVoiceOver,
        "quality" => Icons.Material.Outlined.HighQuality,
        _ => Icons.Material.Outlined.Tune,
    };
    private string QualityLabel => StringHelpers.FirstNonBlankOr(
        "Source",
        Playback.CurrentItem?.Quality,
        Playback.CurrentManifest?.Technical.QualityLabel,
        "Source");
    private string VideoContext
    {
        get
        {
            var item = Playback.CurrentItem;
            if (item is null)
            {
                return "Now playing";
            }

            return StringHelpers.FirstNonBlankOr("Now playing", item.Album, item.Year, "Now playing");
        }
    }
    private string? VideoEpisodeMetadata => Playback.CurrentItem is { SeasonNumber: not null, EpisodeNumber: not null } item
        ? $"S{item.SeasonNumber} E{item.EpisodeNumber}"
        : null;
    private static string? VideoQueueSubtitle(ListenQueueItem item) =>
        item.SeasonNumber is not null && item.EpisodeNumber is not null
            ? $"S{item.SeasonNumber} E{item.EpisodeNumber}"
            : item.Year;
    private static string? VideoQueueRuntime(ListenQueueItem item) =>
        PlaybackVideoRuntime.FormatQueueRuntime(item.Duration);
    private PlaybackSegmentDto? VisibleSkipSegment =>
        (Playback.CurrentManifest?.Segments ?? [])
            .Where(segment => segment.IsSkippable
                && segment.EndSeconds.HasValue
                && segment.StartSeconds <= Playback.CurrentTimeSeconds + 1
                && segment.EndSeconds.Value > Playback.CurrentTimeSeconds)
            .OrderBy(segment => segment.StartSeconds)
            .FirstOrDefault();

    protected override void OnInitialized()
    {
        Playback.Changed += HandlePlaybackChanged;
        Playback.TransportCommandRequested += HandleTransportCommandAsync;
        Nav.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        if (!Playback.IsVideoMode || !Playback.IsVideoExpanded ||
            Nav.ToAbsoluteUri(args.Location).AbsolutePath.StartsWith("/watch/player/", StringComparison.OrdinalIgnoreCase)) return;
        _ = InvokeAsync(ContinueVideoOutsidePlayerAsync);
    }

    private async Task ContinueVideoOutsidePlayerAsync()
    {
        if (!Playback.IsVideoMode || !Playback.IsVideoExpanded) return;
        var videoWorkId = Playback.CurrentItem?.WorkId;
        var requestVersion = Playback.PlaybackRequestVersion;
        bool IsCurrentVideo() => Playback.IsVideoMode
            && Playback.CurrentItem?.WorkId == videoWorkId
            && Playback.PlaybackRequestVersion == requestVersion;

        if (_canPictureInPicture && await JS.InvokeAsync<bool>("listenPlayback.togglePictureInPicture", _videoRef))
        {
            if (!IsCurrentVideo()) return;
            _continuationStatus = null;
            Playback.SetVideoExpanded(false);
            return;
        }

        if (!IsCurrentVideo()) return;
        await PauseAsync();
        if (!IsCurrentVideo()) return;
        _continuationStatus = "Playback paused. Restore to continue.";
        Playback.SetPresentationSurface(PlaybackPresentationSurface.RestorableVideo);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _canPictureInPicture = await JS.InvokeAsync<bool>("listenPlayback.canPictureInPicture", _videoRef);
            _selfReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync(
                "listenPlayback.registerAudioStateObserver",
                _videoRef,
                _selfReference,
                Playback.ClientSettings.AudioObserverIntervalMilliseconds);
            _observerRegistered = true;
        }

        if (Playback.IsVideoMode && !string.IsNullOrWhiteSpace(Playback.CurrentBrowserStreamUrl))
        {
            await SyncVideoAsync();
        }
        if (Playback.IsVideoMode && Playback.CurrentItem?.AssetId is Guid assetId && _loadedSubtitleAssetId != assetId)
        {
            _ = LoadSubtitleTracksAsync(assetId);
        }
    }

    private void HandlePlaybackChanged(PlaybackChangeKind changeKind)
    {
        _ = InvokeAsync(async () =>
        {
            if (!Playback.IsVideoMode && _lastAppliedStreamUrl is not null)
            {
                await JS.InvokeVoidAsync("listenPlayback.pauseAudio", _videoRef);
                if (_activeAssetId.HasValue)
                {
                    Activity.ClearVideoPlayback(_activeAssetId.Value);
                    _activeAssetId = null;
                }
                _lastAppliedPlayingState = false;
            }

            if (Playback.CurrentItem?.AssetId != _loadedSubtitleAssetId)
            {
                _selectedCaptionKey = null;
                _captionTracks = [];
                _selectedAudioTrackIndex = null;
                _textTrackStatus = null;
            }

            StateHasChanged();
        });
    }

    private async Task HandleStartFailureAsync()
    {
        var failure = await JS.InvokeAsync<string>("listenPlayback.startFailure", _videoRef);
        if (failure == "AbortError") return; // A superseding source/start owns the result.
        if (failure == "NotAllowedError") Playback.MarkNeedsUserGestureToStart();
        else Playback.MarkCurrentFailed("The media source could not start playback. Retry playback or check the source.");
    }

    private async Task SyncVideoAsync()
    {
        var streamUrl = Playback.CurrentBrowserStreamUrl;
        if (!string.Equals(_lastAppliedStreamUrl, streamUrl, StringComparison.Ordinal))
        {
            _lastAppliedStreamUrl = streamUrl;
            _lastAppliedPlayingState = null;
            await JS.InvokeVoidAsync("listenPlayback.ensureAudioSource", _videoRef, streamUrl);
        }

        if (_lastAppliedVolume != Playback.Volume)
        {
            await JS.InvokeVoidAsync("listenPlayback.setVolume", _videoRef, Playback.Volume);
            _lastAppliedVolume = Playback.Volume;
        }

        if (_lastAppliedMuteState != Playback.IsMuted)
        {
            await JS.InvokeVoidAsync("listenPlayback.setMuted", _videoRef, Playback.IsMuted);
            _lastAppliedMuteState = Playback.IsMuted;
        }

        if (_lastAppliedPlaybackRate != Playback.PlaybackRate)
        {
            await JS.InvokeVoidAsync("listenPlayback.setPlaybackRate", _videoRef, Playback.PlaybackRate);
            _lastAppliedPlaybackRate = Playback.PlaybackRate;
        }

        if (_lastAppliedStartVersion != Playback.PlaybackStartVersion)
        {
            _lastAppliedStartVersion = Playback.PlaybackStartVersion;
            if (Playback.CurrentTimeSeconds > 0)
            {
                await JS.InvokeVoidAsync("listenPlayback.seekAudio", _videoRef, Playback.CurrentTimeSeconds);
            }
            _lastAppliedPlayingState = null;
        }

        if (_lastAppliedPlayingState == Playback.IsPlaying)
        {
            return;
        }

        if (Playback.IsPlaying)
        {
            var started = await JS.InvokeAsync<bool>("listenPlayback.playAudio", _videoRef);
            if (!started)
            {
                await HandleStartFailureAsync();
            }
        }
        else
        {
            await JS.InvokeVoidAsync("listenPlayback.pauseAudio", _videoRef);
        }

        _lastAppliedPlayingState = Playback.IsPlaying;
    }

    [JSInvokable]
    public Task HandleObservedAudioState(VideoMetrics state) =>
        ApplyMetricsAsync(state, expectedRateSelectionVersion: null);

    private async Task HandleMetricsChangedAsync()
    {
        var rateSelectionVersion = Playback.PlaybackRateSelectionVersion;
        var state = await JS.InvokeAsync<VideoMetrics>("listenPlayback.readAudioState", _videoRef);
        await ApplyMetricsAsync(state, rateSelectionVersion);
    }

    private async Task ApplyMetricsAsync(VideoMetrics state, long? expectedRateSelectionVersion)
    {
        if (Guid.TryParse(state.AssetId, out var observedAssetId)
            && Playback.CurrentItem?.AssetId != observedAssetId)
        {
            return;
        }

        if (!Playback.IsVideoMode)
        {
            return;
        }

        if (_availableSubtitleCount != state.SubtitleCount)
        {
            _availableSubtitleCount = state.SubtitleCount;
            await InvokeAsync(StateHasChanged);
        }
        var updatedCaptionTracks = state.CaptionTracks ?? [];
        if (!_captionTracks.SequenceEqual(updatedCaptionTracks))
        {
            _captionTracks = updatedCaptionTracks;
            _selectedCaptionKey = updatedCaptionTracks.FirstOrDefault(track => track.Selected)?.Key;
            await InvokeAsync(StateHasChanged);
        }
        if (_availableAudioTrackCount != state.AudioTrackCount)
        {
            _availableAudioTrackCount = state.AudioTrackCount;
            await InvokeAsync(StateHasChanged);
        }
        Playback.UpdateTransportState(
            currentTimeSeconds: state.CurrentTime,
            durationSeconds: state.Duration,
            isPlaying: state.Paused && Playback.Phase == PlaybackPhase.Loading ? null : !state.Paused,
            volume: state.Volume,
            isMuted: state.Muted,
            playbackRate: state.PlaybackRate,
            expectedPlaybackRateSelectionVersion: expectedRateSelectionVersion);

        if (Playback.CurrentItem?.AssetId is Guid assetId)
        {
            _activeAssetId = assetId;
            Activity.ReportVideoPlayback(
                assetId,
                Playback.CurrentItem.Title,
                state.CurrentTime,
                Playback.DurationSeconds,
                isPlaying: !state.Paused,
                ended: Playback.DurationSeconds > 0 && state.CurrentTime >= Playback.DurationSeconds - 0.5d);
        }

        await Playback.ReportHeartbeatAsync();
    }

    private async Task HandleStartedAsync()
    {
        if (!Playback.IsVideoMode)
        {
            return;
        }

        Playback.MarkPlaybackStarted();
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task HandlePausedAsync()
    {
        if (!Playback.IsVideoMode || Playback.Phase == PlaybackPhase.Loading)
        {
            return;
        }

        Playback.UpdateTransportState(isPlaying: false);
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task HandleEndedAsync()
    {
        if (Playback.IsVideoMode)
        {
            await Playback.CompleteCurrentAsync();
        }
    }

    private Task HandleErrorAsync()
    {
        if (Playback.IsVideoMode)
        {
            Playback.MarkCurrentFailed("This video source failed to load or play.");
        }

        return Task.CompletedTask;
    }

    private async Task HandleTransportCommandAsync(PlaybackTransportCommand command)
    {
        if (!Playback.IsVideoMode)
        {
            return;
        }

        switch (command.Action)
        {
            case "toggle-play":
                await TogglePlayPauseAsync();
                break;
            case "pause":
                await PauseAsync();
                break;
            case "play-next":
                await Playback.SkipNextAsync();
                break;
            case "play-previous":
                await Playback.SkipPreviousAsync();
                break;
            case "skip-back":
                await SkipBackAsync();
                break;
            case "skip-forward":
                await SkipForwardAsync();
                break;
            case "seek" when command.Value.HasValue:
                await SeekOnHostAsync(command.Value.Value);
                break;
            case "start":
                await StartVideoAsync(command);
                break;
            case "set-volume" when command.Value.HasValue:
                await SetVolumeOnHostAsync(command.Value.Value);
                break;
            case "set-speed" when command.Value.HasValue:
                await ApplyPlaybackRateAsync(command.Value.Value);
                break;
            case "toggle-mute":
                await ToggleMuteAsync();
                break;
            case "close-player":
                await ClosePlayerAsync();
                break;
        }
    }

    private async Task TogglePlayPauseAsync()
    {
        if (Playback.IsPlaying && !Playback.NeedsUserGestureToStart)
        {
            await PauseAsync();
            return;
        }

        await StartVideoAsync(new PlaybackTransportCommand(
            "start",
            StreamUrl: Playback.CurrentBrowserStreamUrl,
            PositionSeconds: Playback.CurrentTimeSeconds,
            PlaybackRate: Playback.PlaybackRate,
            RequestId: Playback.PlaybackStartVersion));
    }

    private async Task StartVideoAsync(PlaybackTransportCommand command)
    {
        var requestVersion = Playback.PlaybackRequestVersion;
        var streamUrl = command.StreamUrl ?? Playback.CurrentBrowserStreamUrl;
        var position = Math.Max(0, command.PositionSeconds ?? command.Value ?? Playback.CurrentTimeSeconds);
        var started = await JS.InvokeAsync<bool>(
            "listenPlayback.startAudio",
            _videoRef,
            new
            {
                streamUrl,
                positionSeconds = position,
                playbackRate = command.PlaybackRate ?? Playback.PlaybackRate,
                volume = Playback.Volume,
                muted = Playback.IsMuted,
            });

        _lastAppliedStreamUrl = streamUrl;
        _lastAppliedStartVersion = Playback.PlaybackStartVersion;
        _lastAppliedPlayingState = started;
        if (requestVersion != Playback.PlaybackRequestVersion) return;
        if (started)
        {
            Playback.UpdateTransportState(currentTimeSeconds: position, isPlaying: true, needsUserGestureToStart: false);
            Playback.MarkPlaybackStarted();
            await Playback.ReportHeartbeatAsync(force: true);
        }
        else
        {
            await HandleStartFailureAsync();
        }
    }

    private async Task PauseAsync()
    {
        var requestVersion = Playback.PlaybackRequestVersion;
        await JS.InvokeVoidAsync("listenPlayback.pauseAudio", _videoRef);
        _lastAppliedPlayingState = false;
        if (!Playback.IsVideoMode || Playback.PlaybackRequestVersion != requestVersion) return;
        Playback.UpdateTransportState(isPlaying: false);
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private Task SkipBackAsync() => SeekOnHostAsync(Playback.CurrentTimeSeconds - Playback.SkipBackSeconds);
    private Task SkipForwardAsync() => SeekOnHostAsync(Playback.CurrentTimeSeconds + Playback.SkipForwardSeconds);

    private async Task SeekAsync(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var seconds))
        {
            await SeekOnHostAsync(seconds);
        }
    }

    private async Task SeekOnHostAsync(double seconds)
    {
        var max = Playback.DurationSeconds > 0 ? Playback.DurationSeconds : double.MaxValue;
        var next = Math.Clamp(seconds, 0, max);
        await JS.InvokeVoidAsync("listenPlayback.seekAudio", _videoRef, next);
        Playback.UpdateTransportState(currentTimeSeconds: next);
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task SetVolumeAsync(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var volume))
        {
            await SetVolumeOnHostAsync(volume);
        }
    }

    private async Task SetVolumeOnHostAsync(double volume)
    {
        var next = Math.Clamp(volume, 0, 1);
        await JS.InvokeVoidAsync("listenPlayback.setVolume", _videoRef, next);
        var muted = next <= 0d;
        await JS.InvokeVoidAsync("listenPlayback.setMuted", _videoRef, muted);
        Playback.UpdateTransportState(volume: next, isMuted: muted);
        _lastAppliedVolume = next;
        _lastAppliedMuteState = muted;
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task ToggleMuteAsync()
    {
        await SetVolumeOnHostAsync(Playback.GetMuteToggleTargetVolume());
    }

    private Task SelectPlaybackRateAsync(double value) =>
        Playback.SetPlaybackRateAsync(value);

    private async Task ApplyPlaybackRateAsync(double value)
    {
        if (!PlaybackRateOptions.IsValid(value) || Playback.CurrentItem?.AssetId is not Guid assetId) return;
        var playbackRequestVersion = Playback.PlaybackRequestVersion;
        var rateSelectionVersion = Playback.PlaybackRateSelectionVersion;
        await JS.InvokeVoidAsync("listenPlayback.setPlaybackRate", _videoRef, value);
        if (Playback.PlaybackRateSelectionVersion != rateSelectionVersion
            || !Playback.TrySetPlaybackRateFromHost(value, assetId, playbackRequestVersion)) return;
        _lastAppliedPlaybackRate = value;
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task LoadSubtitleTracksAsync(Guid assetId)
    {
        _loadedSubtitleAssetId = assetId;
        _managedSubtitleTracks = [];
        var tracks = await ApiClient.GetTextTracksAsync(assetId);
        if (Playback.CurrentItem?.AssetId != assetId) return;
        _managedSubtitleTracks = tracks;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectCaptionAsync(string? key)
    {
        if (await JS.InvokeAsync<bool>("listenPlayback.selectCaptionTrack", _videoRef, key))
        {
            await HandleMetricsChangedAsync();
        }
    }

    private async Task SetPreferredSubtitleAsync()
    {
        if (Playback.CurrentItem?.AssetId is not Guid assetId ||
            !Guid.TryParse(_selectedCaptionKey?.Replace("managed:", "", StringComparison.Ordinal), out var trackId)) return;
        if (await ApiClient.SetPreferredTextTrackAsync(assetId, trackId))
        {
            _textTrackStatus = "Preferred subtitles saved.";
            await LoadSubtitleTracksAsync(assetId);
        }
        else _textTrackStatus = "Could not save the preferred subtitles.";
    }

    private async Task RefreshSubtitlesAsync()
    {
        if (_textTrackLoading || Playback.CurrentItem?.AssetId is not Guid assetId) return;
        _textTrackLoading = true;
        _textTrackStatus = null;
        try
        {
            var result = await ApiClient.RefreshTextTracksAsync(assetId, "subtitles");
            if (Playback.CurrentItem?.AssetId != assetId) return;
            _textTrackStatus = result?.message ?? "Subtitle search could not start.";
            await LoadSubtitleTracksAsync(assetId);
        }
        finally { _textTrackLoading = false; }
    }

    private static string ManagedSubtitleLabel(TextTrackDto track) =>
        $"{track.Language.ToUpperInvariant()}{(track.IsHearingImpaired ? " SDH" : "")}";

    private string CaptionChoiceSubtitle(CaptionTrackMetric track)
    {
        if (track.Key.StartsWith("managed:", StringComparison.Ordinal)
            && Guid.TryParse(track.Key[8..], out var id)
            && ManagedSubtitleTracks.FirstOrDefault(candidate => candidate.Id == id) is { } managed)
        {
            return $"{managed.Provider} · {(managed.IsHearingImpaired ? "SDH" : managed.TimingMode)}{(managed.IsPreferred ? " · Preferred" : "")}";
        }
        if (track.Key.StartsWith("manifest:", StringComparison.Ordinal)
            && int.TryParse(track.Key[9..], out var index)
            && SubtitleTracks.FirstOrDefault(candidate => candidate.Index == index) is { } manifest)
        {
            return manifest.IsForced ? "Forced" : "Embedded";
        }
        return string.IsNullOrWhiteSpace(track.Language) ? "Available track" : track.Language;
    }

    private async Task SelectAudioTrackAsync(int index)
    {
        if (await JS.InvokeAsync<bool>("listenPlayback.selectAudioTrack", _videoRef, index))
        {
            _selectedAudioTrackIndex = index;
            CloseToolSheet();
        }
    }

    private static string AudioTrackLabel(PlaybackTrackDto track, int index) =>
        StringHelpers.FirstNonBlankOr(
            $"Audio {index + 1}",
            track.DisplayName,
            track.Language?.ToUpperInvariant(),
            $"Audio {index + 1}");

    private Task ToggleFullscreenAsync()
        => JS.InvokeVoidAsync("listenPlayback.toggleFullscreen", _videoRef).AsTask();

    private async Task EnterPictureInPictureAsync()
    {
        if (!_canPictureInPicture) return;
        if (await JS.InvokeAsync<bool>("listenPlayback.togglePictureInPicture", _videoRef))
        {
            Playback.SetVideoExpanded(false);
        }
    }

    private async Task RestoreVideoAsync()
    {
        if (!Playback.HasQueue || !Playback.IsVideoMode) return;
        await JS.InvokeVoidAsync("listenPlayback.exitPictureInPicture");
        _continuationStatus = null;
        Playback.SetVideoExpanded(true);
    }

    private void HandleVideoToolControl(PlaybackControlDefinition control)
    {
        if (control.IsDisabled || string.IsNullOrWhiteSpace(control.Sheet))
        {
            return;
        }

        CloseRateMenu();

        _activeToolSheet = string.Equals(_activeToolSheet, control.Sheet, StringComparison.Ordinal)
            ? null
            : control.Sheet;
    }

    private Task HandleVideoUtilityControl(PlaybackControlDefinition control) => control.Command switch
    {
        "toggle-mute" => ToggleMuteAsync(),
        "fullscreen" => ToggleFullscreenAsync(),
        "picture-in-picture" => EnterPictureInPictureAsync(),
        _ => Task.CompletedTask,
    };

    private Task HandleVideoPrimaryChoiceControl(PlaybackControlDefinition control) =>
        control.Key == PlaybackControlKey.Fullscreen
            ? HandleVideoUtilityControl(control)
            : OpenVideoTool(control);

    private Task OpenVideoTool(PlaybackControlDefinition control)
    {
        HandleVideoToolControl(control);
        return Task.CompletedTask;
    }

    private void CloseToolSheet() => _activeToolSheet = null;

    private void HandleRateMenuOpenChanged(PlaybackSpeedMenuState state)
    {
        _rateMenuOpen = state.IsOpen;
        if (state.IsOpen) CloseToolSheet();
    }

    private void CloseRateMenu() => _rateMenuOpen = false;

    private async Task HandleVideoKeyDown(KeyboardEventArgs args)
    {
        if (await JS.InvokeAsync<bool>("playbackTools.isEditableFocus")) return;
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            CloseToolSheet();
        }
        else if (args.Key is " " or "k" or "K") await TogglePlayPauseAsync();
        else if (args.Key == "ArrowLeft") await SkipBackAsync();
        else if (args.Key == "ArrowRight") await SkipForwardAsync();
        else if (args.Key.Equals("m", StringComparison.OrdinalIgnoreCase)) await ToggleMuteAsync();
        else if (args.Key.Equals("f", StringComparison.OrdinalIgnoreCase)) await ToggleFullscreenAsync();
    }

    private bool IsCurrentVideoChapter(PlaybackChapterDto chapter) =>
        chapter.StartSeconds <= Playback.CurrentTimeSeconds
        && (!chapter.EndSeconds.HasValue || Playback.CurrentTimeSeconds < chapter.EndSeconds.Value);

    private async Task PlayVideoChapterAsync(PlaybackChapterDto chapter)
    {
        await SeekOnHostAsync(chapter.StartSeconds);
        CloseToolSheet();
    }

    private async Task PlayVideoQueueItemAsync(int index)
    {
        await Playback.PlayIndexAsync(index);
        CloseToolSheet();
    }

    private async Task ClosePlayerAsync()
    {
        if (!Playback.HasQueue || !Playback.IsVideoMode) return;
        var workId = Playback.CurrentItem?.WorkId;
        await JS.InvokeVoidAsync("listenPlayback.releaseMedia", _videoRef);
        if (Playback.CurrentItem?.AssetId is Guid assetId)
        {
            Activity.ClearVideoPlayback(assetId);
        }
        _activeAssetId = null;
        Playback.ClosePlayer();
        Nav.NavigateTo(workId is Guid id && id != Guid.Empty
            ? $"/details/work/{id}?context=watch"
            : "/watch");
    }

    private string? AbsoluteUrl(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : ApiClient.ToAbsoluteEngineUrl(value);

    private string? SubtitleUrl(PlaybackSubtitleTrackDto track) =>
        !string.IsNullOrWhiteSpace(track.DeliveryUrl) && Playback.CurrentItem?.AssetId is { } assetId
            ? $"/engine-subtitles/{assetId:D}?language={Uri.EscapeDataString(track.Language ?? "en")}" : null;

    private static string SubtitleLabel(PlaybackSubtitleTrackDto track)
        => StringHelpers.FirstNonBlankOr(
            "Subtitles",
            track.DisplayName,
            track.Language?.ToUpperInvariant(),
            "Subtitles");

    private static string SkipLabel(string kind) => kind.ToLowerInvariant() switch
    {
        "intro" => "Skip Intro",
        "commercial" => "Skip Commercial",
        "credits" => "Skip Credits",
        "recap" => "Skip Recap",
        "post_credits" => "Skip Post-Credits",
        _ => "Skip Segment",
    };

    private static string FormatTimestamp(double seconds)
    {
        var span = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return span.TotalHours >= 1
            ? span.ToString(@"h\:mm\:ss", CultureInfo.InvariantCulture)
            : span.ToString(@"m\:ss", CultureInfo.InvariantCulture);
    }

    private static string FormatVolume(double value) => $"{Math.Clamp((int)Math.Round(value * 100), 0, 100)}%";

    public async ValueTask DisposeAsync()
    {
        Playback.Changed -= HandlePlaybackChanged;
        Playback.TransportCommandRequested -= HandleTransportCommandAsync;
        Nav.LocationChanged -= HandleLocationChanged;
        if (_observerRegistered)
        {
            try
            {
                await JS.InvokeVoidAsync("listenPlayback.unregisterAudioStateObserver", _videoRef);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException ex)
            {
                Logger.LogDebug(ex, "Could not unregister the video playback observer.");
            }
        }

        _selfReference?.Dispose();
    }

    public sealed class VideoMetrics
    {
        public double CurrentTime { get; set; }
        public string AssetId { get; set; } = string.Empty;
        public int SubtitleCount { get; set; }
        public List<CaptionTrackMetric> CaptionTracks { get; set; } = [];
        public int AudioTrackCount { get; set; }
        public double Duration { get; set; }
        public double Volume { get; set; }
        public bool Muted { get; set; }
        public bool Paused { get; set; }
        public double PlaybackRate { get; set; } = 1d;
    }

    public sealed record CaptionTrackMetric
    {
        public string Key { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string Language { get; set; } = string.Empty;
        public bool Selected { get; set; }
        public int? HlsIndex { get; set; }
    }
}
