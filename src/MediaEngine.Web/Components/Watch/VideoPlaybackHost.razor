@namespace MediaEngine.Web.Components.Watch
@using System.Globalization
@using Microsoft.JSInterop
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Web.Services.MediaTiles
@inject PlaybackSessionController Playback
@inject VideoPresentationResolver Presentation
@inject PlaybackTransientToolCoordinator Tools
@inject IEngineApiClient ApiClient
@inject ShellActivityState Activity
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ILogger<VideoPlaybackHost> Logger
@implements IAsyncDisposable

<section @ref="_hostRef" class="@StageClass"
         aria-label="@(Playback.IsVideoMode ? "Video player" : null)"
         aria-hidden="@(Playback.IsVideoMode ? "false" : "true")"
         tabindex="-1" @onkeydown="HandleVideoKeyDown">
    <video @ref="_videoRef" id="tuvima-video-engine"
           data-playback-asset-id="@Playback.CurrentItem?.AssetId"
           data-playback-request-version="@Playback.PlaybackRequestVersion"
           class="video-playback-host__media" playsinline preload="metadata"
           poster="@Playback.CurrentItem?.CoverUrl" @onclick="TogglePlayPauseAsync"
           @onloadedmetadata="HandleMetricsChangedAsync" @ondurationchange="HandleMetricsChangedAsync"
           @onplay="HandleStartedAsync" @onpause="HandlePausedAsync"
           @onerror="HandleErrorAsync">
        @foreach (var track in SubtitleTracks)
        {
            <track kind="subtitles" @key="@($"{track.Index}-{track.DeliveryUrl}")"
                   data-playback-track-key="@($"manifest:{track.Index}")"
                   src="@SubtitleUrl(track)" srclang="@(track.Language ?? "und")"
                   label="@SubtitleLabel(track)" default="@track.IsDefault" />
        }
        @if (Playback.IsVideoMode && Playback.CurrentItem?.AssetId is Guid subtitleAssetId)
        {
            @foreach (var track in ManagedSubtitleTracks)
            {
                <track kind="subtitles" @key="track.Id" data-playback-track-key="@($"managed:{track.Id:D}")"
                       data-playback-preferred="@(track.IsPreferred ? "true" : "false")"
                       src="@($"/engine-text-track/{subtitleAssetId:D}/{track.Id:D}")"
                       srclang="@track.Language" label="@ManagedSubtitleLabel(track)" />
            }
        }
    </video>
    @if (Playback.IsVideoMode && Playback.IsVideoExpanded && Playback.CurrentItem is not null)
    {
        @if (Playback.Phase == PlaybackPhase.Loading || !string.IsNullOrWhiteSpace(Playback.CurrentError))
        {
            <div class="video-playback-host__status" role="status">@(Playback.CurrentError ?? "Preparing video… Playback will begin automatically.")</div>
        }
        <PlaybackVideoChrome>
            <HeaderContent>            <AppTooltip Text="Back to details">
                <AppNativeButton Type="button" Class="video-playback-host__icon" OnClick="ClosePlayerAsync" AriaLabel="Back to details">
                    <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" />
                </AppNativeButton>
            </AppTooltip>
</HeaderContent>

            <BottomContent>
            @if (VisibleSkipSegment is { } segment)
            {
                <div class="video-playback-host__skip-segment">
                    <span>@SegmentDescription(segment.Kind)</span>
                    <AppTooltip Text="@SkipLabel(segment.Kind)"><AppNativeButton Type="button" Class="video-playback-host__icon"
                        AriaLabel="@SkipLabel(segment.Kind)" OnClick="@(() => SeekOnHostAsync(segment.EndSeconds!.Value))"><MudIcon Icon="@Icons.Material.Outlined.SkipNext" /></AppNativeButton></AppTooltip>
                </div>
            }
            <PlaybackSeekRail Position="@Playback.CurrentTimeSeconds" Duration="@Playback.DurationSeconds" ValueChanged="SeekOnHostAsync" ChapterTicks="@ChapterTicks" ChapterLabel="ChapterTickLabel" Surface="video" />
            <div class="playback-video-controls">
                <div class="playback-video-controls__left">            <PlaybackRelativeSkipButton Seconds="@Playback.SkipBackSeconds" Direction="back" Size="compact" OnClick="SkipBackAsync" />
            <PlaybackPrimaryButton Appearance="video" IsPlaying="@VideoIsPlaying" NeedsUserGestureToStart="@Playback.NeedsUserGestureToStart"
                                   disabled="@(Playback.Phase is PlaybackPhase.Loading or PlaybackPhase.Error)"
                                   Size="compact" OnClick="TogglePlayPauseAsync" />
            <PlaybackRelativeSkipButton Seconds="@Playback.SkipForwardSeconds" Direction="forward" Size="compact" OnClick="SkipForwardAsync" />

                <div class="playback-video-controls__volume">
                    <PlaybackIconButton Control="@MuteControl" Surface="video" OnClick="ToggleMuteAsync" />
                    <AppRangeSlider Min="0" Max="1" Step="0.05" InputStep="0.05" Value="@Playback.Volume"
                        ValueChanged="SetVolumeOnHostAsync" ShowTicks="false" Surface="video" Class="video-playback-host__volume"
                        AriaLabel="Volume" ValueFormatter="FormatVolume" />
                </div>
                </div>
                <div class="playback-video-controls__identity">@(_presentationContext?.ShowTitle ?? VideoContext) @VideoEpisodeMetadata @(Playback.CurrentItem.EpisodeTitle ?? Playback.CurrentItem.Title)</div>
                <div class="playback-video-controls__right">
                    @if (EligibleNextEpisode is not null) { <AppTooltip Text="Next episode"><AppNativeButton AriaLabel="Next episode" OnClick="AdvanceCurrentVideoAsync"><MudIcon Icon="@Icons.Material.Outlined.SkipNext" /></AppNativeButton></AppTooltip> }
                    @if (ContextKind is not null)
                    {
                        <PlaybackPopover Title="Up Next" ToolId="video-context" Kind="video" Surface="video" ItemKey="@VideoInstanceKey">
                            <TriggerContent><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Queue" /></TriggerContent>
                            <ChildContent><VideoContextPanel Context="@ContextKind" Episodes="@(_presentationContext?.Episodes ?? [])"
                                Chapters="@VideoChapters" Upcoming="@UpcomingVideo" NextEpisode="@EligibleNextEpisode" CurrentWorkId="@Playback.CurrentItem.WorkId"
                                Position="@Playback.CurrentTimeSeconds" IsPlaying="@VideoIsPlaying"
                                EpisodeSelected="PlayOwnedEpisodeAsync" ChapterSelected="PlayVideoChapterAsync" QueueSelected="PlayVideoQueueEntryAsync" /></ChildContent>
                        </PlaybackPopover>
                    }
                    <PlaybackPopover Title="Captions" ToolId="video-captions" Kind="video" Surface="video" ItemKey="@VideoInstanceKey">
                        <TriggerContent><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Captions" /></TriggerContent>
                        <ChildContent>
                            <PlaybackSheetList>
                                <PlaybackSheetRow Appearance="outlined" OnClick="@(() => SelectCaptionAsync(null))" IsActive="@(!_captionTracks.Any(track => track.Selected))" AriaLabel="Turn captions off">
                                    <span class="playback-sheet-row__copy"><strong>Off</strong></span>
                                    @if (!_captionTracks.Any(track => track.Selected)) { <MudIcon Icon="@Icons.Material.Filled.Check" /> }
                                </PlaybackSheetRow>
                                @foreach (var track in _captionTracks)
                                {
                                    <PlaybackSheetRow Appearance="outlined" OnClick="@(() => SelectCaptionAsync(track.Key))" IsActive="@track.Selected" AriaLabel="@($"Select {track.Label} captions")">
                                        <span class="playback-sheet-row__copy"><strong>@track.Label</strong><span>@CaptionChoiceSubtitle(track)</span></span>
                                        @if (track.Selected) { <MudIcon Icon="@Icons.Material.Filled.Check" /> }
                                    </PlaybackSheetRow>
                                }
                                @if (_selectedCaptionKey?.StartsWith("managed:", StringComparison.Ordinal) == true)
                                {
                                    <PlaybackSheetRow Appearance="outlined" OnClick="SetPreferredSubtitleAsync" AriaLabel="Set selected subtitles as preferred"><span class="playback-sheet-row__copy"><strong>Set preferred version</strong></span></PlaybackSheetRow>
                                }
                                <PlaybackSheetRow Appearance="outlined" OnClick="RefreshSubtitlesAsync" AriaLabel="Find better subtitles"><span class="playback-sheet-row__copy"><strong>Find better subtitles</strong><span>@(_textTrackLoading ? "Searching…" : "Search available providers")</span></span></PlaybackSheetRow>
                                @if (!string.IsNullOrWhiteSpace(_textTrackStatus)) { <p role="status" class="video-playback-host__track-status">@_textTrackStatus</p> }
                            </PlaybackSheetList>
                        </ChildContent>
                    </PlaybackPopover>
                    @if (VideoControlState.HasAudioTracks)
                    {
                        <PlaybackPopover Title="Audio" ToolId="video-audio" Kind="video" Surface="video" ItemKey="@VideoInstanceKey">
                            <TriggerContent><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.AudioTrack" /></TriggerContent>
                            <ChildContent>
                                <PlaybackSheetList>
                                    @for (var index = 0; index < AudioTracks.Count; index++)
                                    {
                                        var trackIndex = index;
                                        var track = AudioTracks[index];
                                        <PlaybackSheetRow Appearance="outlined" OnClick="@(() => SelectAudioTrackAsync(trackIndex))"
                                            IsActive="@(_selectedAudioTrackIndex == trackIndex || (_selectedAudioTrackIndex is null && track.IsDefault))"
                                            AriaLabel="@($"Select {AudioTrackLabel(track, trackIndex)}")">
                                            <span class="playback-sheet-row__copy"><strong>@AudioTrackLabel(track, trackIndex)</strong><span>@track.Codec</span></span>
                                            @if (_selectedAudioTrackIndex == trackIndex || (_selectedAudioTrackIndex is null && track.IsDefault)) { <MudIcon Icon="@Icons.Material.Filled.Check" /> }
                                        </PlaybackSheetRow>
                                    }
                                </PlaybackSheetList>
                            </ChildContent>
                        </PlaybackPopover>
                    }
                    <PlaybackSpeedControl Value="@Playback.PlaybackRate" ValueChanged="SelectPlaybackRateAsync" Open="@_rateMenuOpen" MenuOpenChanged="HandleRateMenuOpenChanged" Surface="video" />
                    <PlaybackControlStrip Controls="@VideoHeaderUtilityControls" Size="compact" Surface="video" OnControl="HandleVideoUtilityControl" />
                    <PlaybackIconButton Control="@FullscreenControl" Surface="video" OnClick="ToggleFullscreenAsync" />
                </div>
            </div>
        </BottomContent>
        </PlaybackVideoChrome>
        @if (_endCard.Visible && EligibleNextEpisode is { } nextEpisode)
        {
            <aside class="video-playback-host__end-card" aria-label="Next episode" data-playback-chrome data-chrome-hold>
                <strong>Up next</strong>
                <div class="video-playback-host__end-card-content">
                    @if (MediaTileArtworkUrl.Sized(nextEpisode.StillUrl, "s") is { } still) { <img src="@still" srcset="@VideoContextPanel.EpisodeArtworkSrcSet(nextEpisode)" width="112" height="63" sizes="112px" data-artwork-purpose="episode-still" alt="" /> }
                    else { <span class="video-playback-host__end-card-placeholder" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.Movie" /></span> }
                    <span><strong>@nextEpisode.Title</strong><span role="status">Starts in @((int)Math.Ceiling(_endCard.RemainingSeconds)) seconds</span></span>
                </div>
                <div class="video-playback-host__end-card-actions">
                    <AppTooltip Text="Play next episode now"><AppNativeButton Class="video-playback-host__icon" AriaLabel="Play next episode now" OnClick="AdvanceCurrentVideoAsync"><MudIcon Icon="@Icons.Material.Filled.PlayArrow" /></AppNativeButton></AppTooltip>
                    <AppTooltip Text="Dismiss next episode"><AppNativeButton Class="video-playback-host__icon" AriaLabel="Dismiss next episode" OnClick="DismissEndCard"><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Close" /></AppNativeButton></AppTooltip>
                </div>
            </aside>
        }
    }
</section>
@if (Playback.HasQueue && Playback.IsVideoMode && !Playback.IsVideoExpanded && Playback.CurrentItem is not null)
{
    <section class="video-playback-restore" aria-label="Video playback">
        <span>@Playback.CurrentItem.Title</span>
        @if (!string.IsNullOrWhiteSpace(_continuationStatus))
        {
            <small role="status">@_continuationStatus</small>
        }
        <AppTooltip Text="Restore video player"><AppNativeButton Type="button" Class="video-playback-restore__button" OnClick="RestoreVideoAsync" AriaLabel="Restore video player">
            <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Expand" />
        </AppNativeButton></AppTooltip>
        <AppNativeButton Type="button" Class="video-playback-restore__button" OnClick="ClosePlayerAsync" AriaLabel="Stop video playback">
            <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Close" />
        </AppNativeButton>
    </section>
}

@code {
    private ElementReference _hostRef;
    private IJSObjectReference? _chromeModule, _presentationModule;
    private VideoPlaybackIdentity? _observedIdentity;
    private VideoPresentationContext? _presentationContext;
    private CancellationTokenSource? _metadataCancellation;
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private readonly VideoEndCardState _endCard = new();
    private bool _disposed;
    private bool _isFullscreen;
    private ElementReference _videoRef;
    private DotNetObjectReference<VideoPlaybackHost>? _selfReference;
    private bool _observerRegistered;
    private string? _lastAppliedStreamUrl;
    private long _lastAppliedStartVersion = -1;
    private bool? _lastAppliedPlayingState;
    private double? _lastAppliedVolume;
    private bool? _lastAppliedMuteState;
    private double? _lastAppliedPlaybackRate;
    private Guid? _activeAssetId;
    private int _availableSubtitleCount;
    private int _availableAudioTrackCount;
    private int? _selectedAudioTrackIndex;
    private bool _canPictureInPicture;
    private string? _continuationStatus;

    private bool _rateMenuOpen;
    private Guid? _loadedSubtitleAssetId;
    private IReadOnlyList<TextTrackDto> _managedSubtitleTracks = [];
    private IReadOnlyList<CaptionTrackMetric> _captionTracks = [];
    private string? _selectedCaptionKey;
    private string? _textTrackStatus;
    private bool _textTrackLoading;

    private string StageClass =>
        Playback.IsVideoMode && Playback.IsVideoExpanded
            ? "video-playback-host is-expanded"
            : "video-playback-host";
    private double ProgressMax => Playback.DurationSeconds > 0 ? Playback.DurationSeconds : 1d;
    private string ProgressValueText => Playback.DurationSeconds > 0 ? $"{FormatTimestamp(Playback.CurrentTimeSeconds)} of {FormatTimestamp(ProgressMax)}" : "Duration unavailable";
    private string VideoInstanceKey => $"{Playback.ActiveProfileId}:{Playback.CurrentItem?.AssetId}:{Playback.PlaybackRequestVersion}";
    private IReadOnlyList<ListenQueueItem> UpcomingVideo => Playback.Queue.Skip(Playback.CurrentIndex + 1).Where(item => MediaKindClassifier.IsVideo(item.MediaType)).ToList();
    private string? ContextKind => VideoPresentationResolver.ContextKind(VideoPresentationResolver.IsTvEpisode(Playback.CurrentItem),
        Playback.CurrentItem?.MediaType.Contains("movie", StringComparison.OrdinalIgnoreCase) == true,
        _presentationContext?.Episodes.Count ?? 0, VideoChapters.Count, UpcomingVideo.Count);
    private string ContextTitle => ContextKind switch { "episodes" => "Episodes", "chapters" => "Chapters", _ => "Up Next" };
    private string ChapterTickLabel(double seconds) => VideoChapters.Where(chapter => chapter.StartSeconds <= seconds).OrderByDescending(chapter => chapter.StartSeconds).FirstOrDefault() is { } chapter
        ? $"Chapter {chapter.Index + 1:00} · {chapter.Title} · {FormatTimestamp(chapter.StartSeconds)}" : FormatTimestamp(seconds);
    private IReadOnlyList<double> ChapterTicks => Playback.DurationSeconds > 0 ? VideoChapters.Select(chapter => chapter.StartSeconds).Where(time => time >= 0 && time < Playback.DurationSeconds).Distinct().Order().ToList() : [];
    private IReadOnlyList<PlaybackSegmentDto> VerifiedSegments => (Playback.CurrentManifest?.Segments ?? [])
        .Where(segment => segment.Kind.ToLowerInvariant() is "intro" or "recap" or "credits" && VideoEndCardState.IsVerifiedRange(segment, Playback.DurationSeconds)).ToList();
    private string SegmentStyle(PlaybackSegmentDto segment) => $"left:{(segment.StartSeconds / ProgressMax * 100).ToString("0.###", CultureInfo.InvariantCulture)}%;width:{((segment.EndSeconds!.Value - segment.StartSeconds) / ProgressMax * 100).ToString("0.###", CultureInfo.InvariantCulture)}%;";
    private VideoOwnedEpisode? EligibleNextEpisode => _presentationContext is { NextEpisode: { } next } context
        && context.Identity.IsCurrent(Playback) && Playback.Queue.Skip(Playback.CurrentIndex + 1).FirstOrDefault()?.WorkId == next.WorkId ? next : null;
    private PlaybackControlDefinition MuteControl => VideoUtilityControls.First(control => control.Key == PlaybackControlKey.Mute);
    private PlaybackControlDefinition FullscreenControl => VideoUtilityControls.First(control => control.Key == PlaybackControlKey.Fullscreen)
        with { AriaLabel = _isFullscreen ? "Exit fullscreen" : "Fullscreen" };
    [JSInvokable] public Task HandleFullscreenChanged(bool fullscreen) { _isFullscreen = fullscreen; return InvokeAsync(StateHasChanged); }
    private IReadOnlyList<PlaybackSubtitleTrackDto> SubtitleTracks =>
        (Playback.CurrentManifest?.SubtitleTracks ?? [])
            .Where(track => !string.IsNullOrWhiteSpace(track.DeliveryUrl))
            .ToList();
    private IReadOnlyList<PlaybackTrackDto> AudioTracks => Playback.CurrentManifest?.AudioTracks ?? [];
    private IReadOnlyList<PlaybackChapterDto> VideoChapters => Playback.CurrentItem?.Chapters ?? [];
    private IReadOnlyList<TextTrackDto> ManagedSubtitleTracks => _managedSubtitleTracks
        .Where(track => track.Kind.Equals("Subtitle", StringComparison.OrdinalIgnoreCase) || track.Kind.Equals("Subtitles", StringComparison.OrdinalIgnoreCase))
        .ToList();
    private bool VideoIsPlaying => Playback.IsPlaying && Playback.Phase is not (PlaybackPhase.Loading or PlaybackPhase.Error);
    private PlaybackControlState VideoControlState => new(
                ActiveSheet: Tools.OpenToolId,
                PlaybackRate: Playback.PlaybackRate,
                SkipBackSeconds: Playback.SkipBackSeconds,
                SkipForwardSeconds: Playback.SkipForwardSeconds,
                HasChapters: VideoChapters.Count > 0,
                HasQueue: Playback.CurrentIndex < Playback.Queue.Count - 1,
                IsTvEpisode: VideoPresentationResolver.IsTvEpisode(Playback.CurrentItem),
                HasCaptions: SubtitleTracks.Count > 0 || ManagedSubtitleTracks.Count > 0 || _captionTracks.Count > 0 || _availableSubtitleCount > 0,
                HasAudioTracks: AudioTracks.Count > 1 && _availableAudioTrackCount == AudioTracks.Count,
                HasQualityOptions: false,
                CanFindCaptions: Playback.CurrentItem?.AssetId is not null,
                CanPictureInPicture: _canPictureInPicture,
                CanFullscreen: true,
                IsMuted: Playback.IsMuted || Playback.Volume <= 0);
    private IReadOnlyList<PlaybackControlDefinition> VideoUtilityControls =>
        PlaybackControlCatalog.BuildUtilityControls(
                PlaybackExperience.Video,
                PlaybackControlSurface.Fullscreen,
                VideoControlState)
            .Where(control => control.Key != PlaybackControlKey.Volume)
            .ToList();
    private IReadOnlyList<PlaybackControlDefinition> VideoHeaderUtilityControls =>
        VideoUtilityControls.Where(control => control.Key == PlaybackControlKey.PictureInPicture).ToList();
    private string VideoContext
    {
        get
        {
            var item = Playback.CurrentItem;
            if (item is null)
            {
                return "Now playing";
            }

            return StringHelpers.FirstNonBlankOr("Now playing", item.Album, item.Year, "Now playing");
        }
    }
    private string? VideoEpisodeMetadata => Playback.CurrentItem is { SeasonNumber: not null, EpisodeNumber: not null } item
        ? $"S{item.SeasonNumber} E{item.EpisodeNumber}"
        : null;
    private PlaybackSegmentDto? VisibleSkipSegment =>
        (Playback.CurrentManifest?.Segments ?? [])
            .Where(segment => segment.IsSkippable
                && segment.EndSeconds.HasValue
                && segment.StartSeconds <= Playback.CurrentTimeSeconds + 1
                && segment.EndSeconds.Value > Playback.CurrentTimeSeconds)
            .OrderBy(segment => segment.StartSeconds)
            .FirstOrDefault();

    protected override void OnInitialized()
    {
        Playback.Changed += HandlePlaybackChanged;
        Playback.PlaybackRequestChanged += HandleRequestChanged;
        Playback.TransportCommandRequested += HandleTransportCommandAsync;
        Nav.LocationChanged += HandleLocationChanged;
        Tools.Changed += HandleToolsChanged;
        ObservePresentationIdentity();
    }

    private void HandleToolsChanged() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private void HandleRequestChanged()
    {
        if (!_disposed) _ = InvokeAsync(() => { ObservePresentationIdentity(); ObserveEndCard(); StateHasChanged(); });
    }
    private void ObservePresentationIdentity()
    {
        var identity = VideoPlaybackIdentity.Capture(Playback);
        if (_observedIdentity == identity) return;
        _observedIdentity = identity;
        _metadataCancellation?.Cancel(); _metadataCancellation?.Dispose();
        _metadataCancellation = null;
        _presentationContext = null;
        _loadedSubtitleAssetId = null;
        _managedSubtitleTracks = []; _captionTracks = []; _selectedCaptionKey = null;
        _selectedAudioTrackIndex = null; _textTrackStatus = null; _textTrackLoading = false;
        Tools.Close(); _rateMenuOpen = false;
        if (identity is null) return;
        var request = _metadataCancellation = new();
        _ = ResolvePresentationAsync(identity, request.Token);
    }
    private async Task ResolvePresentationAsync(VideoPlaybackIdentity identity, CancellationToken ct)
    {
        try
        {
            var context = await Presentation.ResolveAsync(identity, ct);
            if (_disposed || ct.IsCancellationRequested || !identity.IsCurrent(Playback)) return;
            _presentationContext = context;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Logger.LogDebug(ex, "Owned video context could not be loaded."); }
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        if (!Playback.IsVideoMode || !Playback.IsVideoExpanded ||
            Nav.ToAbsoluteUri(args.Location).AbsolutePath.StartsWith("/watch/player/", StringComparison.OrdinalIgnoreCase)) return;
        _ = InvokeAsync(ContinueVideoOutsidePlayerAsync);
    }

    private async Task ContinueVideoOutsidePlayerAsync()
    {
        if (!Playback.IsVideoMode || !Playback.IsVideoExpanded) return;
        var videoWorkId = Playback.CurrentItem?.WorkId;
        var requestVersion = Playback.PlaybackRequestVersion;
        bool IsCurrentVideo() => Playback.IsVideoMode
            && Playback.CurrentItem?.WorkId == videoWorkId
            && Playback.PlaybackRequestVersion == requestVersion;

        if (_canPictureInPicture && await JS.InvokeAsync<bool>("listenPlayback.togglePictureInPicture", _videoRef))
        {
            if (!IsCurrentVideo()) return;
            _continuationStatus = null;
            Playback.SetVideoExpanded(false);
            return;
        }

        if (!IsCurrentVideo()) return;
        await PauseAsync();
        if (!IsCurrentVideo()) return;
        _continuationStatus = "Playback paused. Restore to continue.";
        Playback.SetPresentationSurface(PlaybackPresentationSurface.RestorableVideo);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _canPictureInPicture = await JS.InvokeAsync<bool>("listenPlayback.canPictureInPicture", _videoRef);
            _selfReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync(
                "listenPlayback.registerAudioStateObserver",
                _videoRef,
                _selfReference,
                Playback.ClientSettings.AudioObserverIntervalMilliseconds);
            _observerRegistered = true;
        }

        _chromeModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-chrome.js");
        _presentationModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/video-presentation.js");
        if (_chromeModule is not null)
        {
            await _chromeModule.InvokeVoidAsync("attach", _hostRef, _videoRef);
            await _chromeModule.InvokeVoidAsync("update", _hostRef, new { inactive = !Playback.IsVideoExpanded,
                loading = Playback.Phase == PlaybackPhase.Loading, error = Playback.Phase == PlaybackPhase.Error,
                tool = Tools.OpenToolId is not null || _rateMenuOpen, endCard = _endCard.Visible });
        }
        if (_presentationModule is not null)
        {
            await _presentationModule.InvokeVoidAsync("attach", _hostRef, _videoRef, _selfReference);
            await _presentationModule.InvokeVoidAsync("update", _hostRef, _endCard.Visible);
        }

        if (Playback.IsVideoMode && !string.IsNullOrWhiteSpace(Playback.CurrentBrowserStreamUrl))
        {
            await SyncVideoAsync();
            if (_presentationModule is not null && VideoPlaybackIdentity.Capture(Playback) is { } identity)
                await _presentationModule.InvokeVoidAsync("bindSource", _hostRef, identity.ProfileId, identity.WorkId, identity.AssetId, identity.RequestVersion);
        }
        if (Playback.IsVideoMode && Playback.CurrentItem?.AssetId is Guid assetId && _loadedSubtitleAssetId != assetId)
        {
            _ = LoadSubtitleTracksAsync(assetId);
        }
    }

    private void HandlePlaybackChanged(PlaybackChangeKind changeKind)
    {
        _ = InvokeAsync(async () =>
        {
            if (!Playback.IsVideoMode && _lastAppliedStreamUrl is not null)
            {
                await JS.InvokeVoidAsync("listenPlayback.pauseAudio", _videoRef);
                if (_activeAssetId.HasValue)
                {
                    Activity.ClearVideoPlayback(_activeAssetId.Value);
                    _activeAssetId = null;
                }
                _lastAppliedPlayingState = false;
            }

            ObservePresentationIdentity();
            ObserveEndCard();

            if (Playback.CurrentItem?.AssetId != _loadedSubtitleAssetId)
            {
                _selectedCaptionKey = null;
                _captionTracks = [];
                _selectedAudioTrackIndex = null;
                _textTrackStatus = null;
            }

            StateHasChanged();
        });
    }

    private async Task HandleStartFailureAsync()
    {
        var failure = await JS.InvokeAsync<string>("listenPlayback.startFailure", _videoRef);
        if (failure == "AbortError") return; // A superseding source/start owns the result.
        if (failure == "NotAllowedError") Playback.MarkNeedsUserGestureToStart();
        else Playback.MarkCurrentFailed("The media source could not start playback. Retry playback or check the source.");
    }

    private async Task SyncVideoAsync()
    {
        var streamUrl = Playback.CurrentBrowserStreamUrl;
        if (!string.Equals(_lastAppliedStreamUrl, streamUrl, StringComparison.Ordinal))
        {
            _lastAppliedStreamUrl = streamUrl;
            _lastAppliedPlayingState = null;
            await JS.InvokeVoidAsync("listenPlayback.ensureAudioSource", _videoRef, streamUrl);
        }

        if (_lastAppliedVolume != Playback.Volume)
        {
            await JS.InvokeVoidAsync("listenPlayback.setVolume", _videoRef, Playback.Volume);
            _lastAppliedVolume = Playback.Volume;
        }

        if (_lastAppliedMuteState != Playback.IsMuted)
        {
            await JS.InvokeVoidAsync("listenPlayback.setMuted", _videoRef, Playback.IsMuted);
            _lastAppliedMuteState = Playback.IsMuted;
        }

        if (_lastAppliedPlaybackRate != Playback.PlaybackRate)
        {
            await JS.InvokeVoidAsync("listenPlayback.setPlaybackRate", _videoRef, Playback.PlaybackRate);
            _lastAppliedPlaybackRate = Playback.PlaybackRate;
        }

        if (_lastAppliedStartVersion != Playback.PlaybackStartVersion)
        {
            _lastAppliedStartVersion = Playback.PlaybackStartVersion;
            if (Playback.CurrentTimeSeconds > 0)
            {
                await JS.InvokeVoidAsync("listenPlayback.seekAudio", _videoRef, Playback.CurrentTimeSeconds);
            }
            _lastAppliedPlayingState = null;
        }

        if (_lastAppliedPlayingState == Playback.IsPlaying)
        {
            return;
        }

        if (Playback.IsPlaying)
        {
            var started = await JS.InvokeAsync<bool>("listenPlayback.playAudio", _videoRef);
            if (!started)
            {
                await HandleStartFailureAsync();
            }
        }
        else
        {
            await JS.InvokeVoidAsync("listenPlayback.pauseAudio", _videoRef);
        }

        _lastAppliedPlayingState = Playback.IsPlaying;
    }

    [JSInvokable]
    public Task HandleObservedAudioState(VideoMetrics state) =>
        ApplyMetricsAsync(state, expectedRateSelectionVersion: null);

    private async Task HandleMetricsChangedAsync()
    {
        var rateSelectionVersion = Playback.PlaybackRateSelectionVersion;
        var state = await JS.InvokeAsync<VideoMetrics>("listenPlayback.readAudioState", _videoRef);
        await ApplyMetricsAsync(state, rateSelectionVersion);
    }

    private async Task ApplyMetricsAsync(VideoMetrics state, long? expectedRateSelectionVersion)
    {
        if (state.RequestVersion != Playback.PlaybackRequestVersion) return;
        if (Guid.TryParse(state.AssetId, out var observedAssetId)
            && Playback.CurrentItem?.AssetId != observedAssetId)
        {
            return;
        }

        if (!Playback.IsVideoMode)
        {
            return;
        }

        if (_availableSubtitleCount != state.SubtitleCount)
        {
            _availableSubtitleCount = state.SubtitleCount;
            await InvokeAsync(StateHasChanged);
        }
        var updatedCaptionTracks = state.CaptionTracks ?? [];
        if (!_captionTracks.SequenceEqual(updatedCaptionTracks))
        {
            _captionTracks = updatedCaptionTracks;
            _selectedCaptionKey = updatedCaptionTracks.FirstOrDefault(track => track.Selected)?.Key;
            await InvokeAsync(StateHasChanged);
        }
        if (_availableAudioTrackCount != state.AudioTrackCount)
        {
            _availableAudioTrackCount = state.AudioTrackCount;
            await InvokeAsync(StateHasChanged);
        }
        Playback.UpdateTransportState(
            currentTimeSeconds: state.CurrentTime,
            durationSeconds: state.Duration,
            isPlaying: state.Paused && Playback.Phase == PlaybackPhase.Loading ? null : !state.Paused,
            volume: state.Volume,
            isMuted: state.Muted,
            playbackRate: state.PlaybackRate,
            expectedPlaybackRateSelectionVersion: expectedRateSelectionVersion);

        if (Playback.CurrentItem?.AssetId is Guid assetId)
        {
            _activeAssetId = assetId;
            Activity.ReportVideoPlayback(
                assetId,
                Playback.CurrentItem.Title,
                state.CurrentTime,
                Playback.DurationSeconds,
                isPlaying: !state.Paused,
                ended: Playback.DurationSeconds > 0 && state.CurrentTime >= Playback.DurationSeconds - 0.5d);
        }

        await Playback.ReportHeartbeatAsync();
    }

    private async Task HandleStartedAsync()
    {
        if (!Playback.IsVideoMode)
        {
            return;
        }

        Playback.MarkPlaybackStarted();
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task HandlePausedAsync()
    {
        if (!Playback.IsVideoMode || Playback.Phase == PlaybackPhase.Loading)
        {
            return;
        }

        Playback.UpdateTransportState(isPlaying: false);
        await Playback.ReportHeartbeatAsync(force: true);
    }

    [JSInvokable] public Task HandleNativeVideoEnded(Guid profileId, Guid workId, Guid assetId, long requestVersion)
    {
        return AdvanceVideoAsync(new(profileId, workId, assetId, requestVersion));
    }

    private void ObserveEndCard() => _endCard.Observe(VideoPlaybackIdentity.Capture(Playback), EligibleNextEpisode?.WorkId,
        Playback.CurrentTimeSeconds, Playback.DurationSeconds, Playback.CurrentManifest?.Segments ?? []);
    [JSInvokable] public async Task HandleEndCardTick(Guid profileId, Guid workId, Guid assetId, long requestVersion, double elapsedSeconds)
    {
        if (!new VideoPlaybackIdentity(profileId, workId, assetId, requestVersion).IsCurrent(Playback)) return;
        ObserveEndCard();
        if (_endCard.Tick(new(profileId, workId, assetId, requestVersion), elapsedSeconds, VideoIsPlaying)) await AdvanceCurrentVideoAsync();
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }
    private Task AdvanceCurrentVideoAsync() => VideoPlaybackIdentity.Capture(Playback) is { } identity
        ? AdvanceVideoAsync(identity) : Task.CompletedTask;
    private async Task AdvanceVideoAsync(VideoPlaybackIdentity identity)
    {
        if (!await Playback.CompleteVideoOnceAsync(identity) && identity.IsCurrent(Playback))
        {
            if (_presentationContext is not null) _presentationContext = _presentationContext with { NextEpisode = null };
            ObserveEndCard();
        }
    }
    private void DismissEndCard() => _endCard.Dismiss();
    private async Task PlayOwnedEpisodeAsync(Guid workId)
    {
        if (_disposed || _observedIdentity is not { } identity) return;
        try { if (await Presentation.PlayEpisodeAsync(identity, workId, _metadataCancellation?.Token ?? CancellationToken.None,
            _lifetimeCancellation.Token) && !_disposed) Tools.Close(); }
        catch (OperationCanceledException) { }
    }
    private async Task PlayVideoQueueEntryAsync(Guid entryId)
    {
        var identity = VideoPlaybackIdentity.Capture(Playback);
        if (identity is null) return;
        var index = Playback.Queue.ToList().FindIndex(item => item.QueueEntryId == entryId);
        if (index <= Playback.CurrentIndex || !identity.IsCurrent(Playback)) return;
        await Playback.PlayIndexAsync(index);
        Tools.Close();
    }

    private Task HandleErrorAsync()
    {
        if (Playback.IsVideoMode)
        {
            Playback.MarkCurrentFailed("This video source failed to load or play.");
        }

        return Task.CompletedTask;
    }

    private async Task HandleTransportCommandAsync(PlaybackTransportCommand command)
    {
        if (!Playback.IsVideoMode)
        {
            return;
        }

        switch (command.Action)
        {
            case "toggle-play":
                await TogglePlayPauseAsync();
                break;
            case "pause":
                await PauseAsync();
                break;
            case "play-next":
                await Playback.SkipNextAsync();
                break;
            case "play-previous":
                await Playback.SkipPreviousAsync();
                break;
            case "skip-back":
                await SkipBackAsync();
                break;
            case "skip-forward":
                await SkipForwardAsync();
                break;
            case "seek" when command.Value.HasValue:
                await SeekOnHostAsync(command.Value.Value);
                break;
            case "start":
                await StartVideoAsync(command);
                break;
            case "set-volume" when command.Value.HasValue:
                await SetVolumeOnHostAsync(command.Value.Value);
                break;
            case "set-speed" when command.Value.HasValue:
                await ApplyPlaybackRateAsync(command.Value.Value);
                break;
            case "toggle-mute":
                await ToggleMuteAsync();
                break;
            case "close-player":
                await ClosePlayerAsync();
                break;
        }
    }

    private async Task TogglePlayPauseAsync()
    {
        if (Playback.IsPlaying && !Playback.NeedsUserGestureToStart)
        {
            await PauseAsync();
            return;
        }

        await StartVideoAsync(new PlaybackTransportCommand(
            "start",
            StreamUrl: Playback.CurrentBrowserStreamUrl,
            PositionSeconds: Playback.CurrentTimeSeconds,
            PlaybackRate: Playback.PlaybackRate,
            RequestId: Playback.PlaybackStartVersion));
    }

    private async Task StartVideoAsync(PlaybackTransportCommand command)
    {
        var requestVersion = Playback.PlaybackRequestVersion;
        var streamUrl = command.StreamUrl ?? Playback.CurrentBrowserStreamUrl;
        var position = Math.Max(0, command.PositionSeconds ?? command.Value ?? Playback.CurrentTimeSeconds);
        var started = await JS.InvokeAsync<bool>(
            "listenPlayback.startAudio",
            _videoRef,
            new
            {
                streamUrl,
                positionSeconds = position,
                playbackRate = command.PlaybackRate ?? Playback.PlaybackRate,
                volume = Playback.Volume,
                muted = Playback.IsMuted,
            });

        _lastAppliedStreamUrl = streamUrl;
        _lastAppliedStartVersion = Playback.PlaybackStartVersion;
        _lastAppliedPlayingState = started;
        if (requestVersion != Playback.PlaybackRequestVersion) return;
        if (_presentationModule is not null && VideoPlaybackIdentity.Capture(Playback) is { } loadedIdentity)
            await _presentationModule.InvokeVoidAsync("bindSource", _hostRef, loadedIdentity.ProfileId, loadedIdentity.WorkId, loadedIdentity.AssetId, loadedIdentity.RequestVersion);
        if (started)
        {
            Playback.UpdateTransportState(currentTimeSeconds: position, isPlaying: true, needsUserGestureToStart: false);
            Playback.MarkPlaybackStarted();
            await Playback.ReportHeartbeatAsync(force: true);
        }
        else
        {
            await HandleStartFailureAsync();
        }
    }

    private async Task PauseAsync()
    {
        var requestVersion = Playback.PlaybackRequestVersion;
        await JS.InvokeVoidAsync("listenPlayback.pauseAudio", _videoRef);
        _lastAppliedPlayingState = false;
        if (!Playback.IsVideoMode || Playback.PlaybackRequestVersion != requestVersion) return;
        Playback.UpdateTransportState(isPlaying: false);
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private Task SkipBackAsync() => SeekOnHostAsync(Playback.CurrentTimeSeconds - Playback.SkipBackSeconds);
    private Task SkipForwardAsync() => SeekOnHostAsync(Playback.CurrentTimeSeconds + Playback.SkipForwardSeconds);

    private async Task SeekAsync(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var seconds))
        {
            await SeekOnHostAsync(seconds);
        }
    }

    private async Task SeekOnHostAsync(double seconds)
    {
        if (Playback.DurationSeconds <= 0 || !double.IsFinite(seconds)) return;
        var identity = VideoPlaybackIdentity.Capture(Playback);
        var max = Playback.DurationSeconds > 0 ? Playback.DurationSeconds : double.MaxValue;
        var next = Math.Clamp(seconds, 0, max);
        await JS.InvokeVoidAsync("listenPlayback.seekAudio", _videoRef, next);
        if (identity is not null && !identity.IsCurrent(Playback)) return;
        Playback.UpdateTransportState(currentTimeSeconds: next);
        ObserveEndCard();
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task SetVolumeAsync(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var volume))
        {
            await SetVolumeOnHostAsync(volume);
        }
    }

    private async Task SetVolumeOnHostAsync(double volume)
    {
        var next = Math.Clamp(volume, 0, 1);
        await JS.InvokeVoidAsync("listenPlayback.setVolume", _videoRef, next);
        var muted = next <= 0d;
        await JS.InvokeVoidAsync("listenPlayback.setMuted", _videoRef, muted);
        Playback.UpdateTransportState(volume: next, isMuted: muted);
        _lastAppliedVolume = next;
        _lastAppliedMuteState = muted;
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task ToggleMuteAsync()
    {
        await SetVolumeOnHostAsync(Playback.GetMuteToggleTargetVolume());
    }

    private Task SelectPlaybackRateAsync(double value) =>
        Playback.SetPlaybackRateAsync(value);

    private async Task ApplyPlaybackRateAsync(double value)
    {
        if (!PlaybackRateOptions.IsValid(value) || Playback.CurrentItem?.AssetId is not Guid assetId) return;
        var playbackRequestVersion = Playback.PlaybackRequestVersion;
        var rateSelectionVersion = Playback.PlaybackRateSelectionVersion;
        await JS.InvokeVoidAsync("listenPlayback.setPlaybackRate", _videoRef, value);
        if (Playback.PlaybackRateSelectionVersion != rateSelectionVersion
            || !Playback.TrySetPlaybackRateFromHost(value, assetId, playbackRequestVersion)) return;
        _lastAppliedPlaybackRate = value;
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task LoadSubtitleTracksAsync(Guid assetId)
    {
        var identity = VideoPlaybackIdentity.Capture(Playback);
        _loadedSubtitleAssetId = assetId;
        _managedSubtitleTracks = [];
        var tracks = await ApiClient.GetTextTracksAsync(assetId);
        if (Playback.CurrentItem?.AssetId != assetId || identity is not null && !identity.IsCurrent(Playback)) return;
        _managedSubtitleTracks = tracks;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectCaptionAsync(string? key)
    {
        var identity = VideoPlaybackIdentity.Capture(Playback);
        if (identity is null) return;
        if (await JS.InvokeAsync<bool>("listenPlayback.selectCaptionTrack", _videoRef, key, identity.AssetId, identity.RequestVersion, identity.ProfileId)
            && identity.IsCurrent(Playback))
        {
            await HandleMetricsChangedAsync();
        }
    }

    private async Task SetPreferredSubtitleAsync()
    {
        var identity = VideoPlaybackIdentity.Capture(Playback);
        if (Playback.CurrentItem?.AssetId is not Guid assetId ||
            !Guid.TryParse(_selectedCaptionKey?.Replace("managed:", "", StringComparison.Ordinal), out var trackId)) return;
        if (await ApiClient.SetPreferredTextTrackAsync(assetId, trackId))
        {
            if (identity is not null && !identity.IsCurrent(Playback)) return;
            _textTrackStatus = "Preferred subtitles saved.";
            await LoadSubtitleTracksAsync(assetId);
        }
        else if (identity is null || identity.IsCurrent(Playback)) _textTrackStatus = "Could not save the preferred subtitles.";
    }

    private async Task RefreshSubtitlesAsync()
    {
        var identity = VideoPlaybackIdentity.Capture(Playback);
        if (_textTrackLoading || Playback.CurrentItem?.AssetId is not Guid assetId) return;
        _textTrackLoading = true;
        _textTrackStatus = null;
        try
        {
            var result = await ApiClient.RefreshTextTracksAsync(assetId, "subtitles");
            if (Playback.CurrentItem?.AssetId != assetId || identity is not null && !identity.IsCurrent(Playback)) return;
            _textTrackStatus = result?.message ?? "Subtitle search could not start.";
            await LoadSubtitleTracksAsync(assetId);
        }
        finally { if (identity is null || identity.IsCurrent(Playback)) _textTrackLoading = false; }
    }

    private static string ManagedSubtitleLabel(TextTrackDto track) =>
        $"{track.Language.ToUpperInvariant()}{(track.IsHearingImpaired ? " SDH" : "")}";

    private string CaptionChoiceSubtitle(CaptionTrackMetric track)
    {
        if (track.Key.StartsWith("managed:", StringComparison.Ordinal)
            && Guid.TryParse(track.Key[8..], out var id)
            && ManagedSubtitleTracks.FirstOrDefault(candidate => candidate.Id == id) is { } managed)
        {
            return $"{managed.Provider} · {(managed.IsHearingImpaired ? "SDH" : managed.TimingMode)}{(managed.IsPreferred ? " · Preferred" : "")}";
        }
        if (track.Key.StartsWith("manifest:", StringComparison.Ordinal)
            && int.TryParse(track.Key[9..], out var index)
            && SubtitleTracks.FirstOrDefault(candidate => candidate.Index == index) is { } manifest)
        {
            return manifest.IsForced ? "Forced" : "Embedded";
        }
        return string.IsNullOrWhiteSpace(track.Language) ? "Available track" : track.Language;
    }

