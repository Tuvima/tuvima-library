@namespace MediaEngine.Web.Components.Watch
@using Microsoft.AspNetCore.Components.Forms
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Shared
@inject IStringLocalizer<SharedStrings> L

@* The video player's bookmark pane (player-controls-v3 D10): a tall pane above the control bar. One click adds a personal bookmark at the
   time the pane opened; the title's bookmarks sit below in time order, filtered Mine or Global. Global bookmarks are read-only here for
   everybody: making, renaming, moving, removing, importing and exporting Everyone's bookmarks is an administrator's job in the editor's
   Bookmarks tab (universal editor v5 D37), not in the player. *@
<div class="video-bookmark-pane">
    <header class="video-bookmark-pane__header">
        <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Bookmark" Class="video-bookmark-pane__header-icon" />
        <h3>@L["Glossary_Bookmarks"]</h3>
        <span class="video-bookmark-pane__count" aria-label="@(TotalCount.ToString(System.Globalization.CultureInfo.InvariantCulture))">@TotalCount</span>
        @if (OnClose.HasDelegate)
        {
            <AppIconButton Icon="@AppMaterialIcons.Outlined.Close" Class="video-bookmark-pane__close" AriaLabel="@L["Common_Close"].Value" OnClick="OnClose" />
        }
    </header>
    <AppSwitchRow T="bool" Label="@L["VideoBookmarkPane_ShowOnTimeline"].Value" Value="@ShowOnBar" ValueChanged="@(value => ShowOnBarChanged.InvokeAsync(value))" Color="AppColor.Primary" />
    <AppNativeButton Type="button" Class="video-bookmark-pane__add" OnClick="AddAsync" Disabled="@_saving"
                     AriaLabel="@($"Add bookmark here at {PlaybackSeekRail.Time(Position)}")">
        <span>@(_failed ? L["VideoBookmarkPane_AddFailed"].Value : L["VideoBookmarkPane_AddHere", PlaybackSeekRail.Time(Position)].Value)</span>
    </AppNativeButton>
    <div @onkeydown="NoteKeyDown" @onkeydown:stopPropagation="true">
        <InputText @bind-Value="_note" class="video-bookmark-pane__note" maxlength="200" placeholder="@L["VideoBookmarkQuickList_AddANoteOptional"].Value" aria-label="@L["VideoBookmarkQuickList_BookmarkNote"].Value" />
    </div>
    @if (ShowFilter)
    {
        <div class="video-bookmark-pane__filter" role="tablist" aria-label="@L["VideoBookmarkPane_Show"].Value">
            @foreach (var tab in Tabs)
            {
                <AppButton ButtonStyle="AppButtonStyle.Text" Size="AppControlSize.Compact" role="tab" Class="@($"video-bookmark-pane__tab {(tab.Value == EffectiveFilter ? "is-selected" : null)}")" aria-selected="@(tab.Value == EffectiveFilter ? "true" : "false")"
                           Label="@tab.Label" OnClick="@(() => FilterChanged.InvokeAsync(tab.Value))" />
            }
        </div>
    }
    @if (Bookmarks.Count > 0)
    {
        <div @onkeydown:stopPropagation="true">
            <InputText @bind-Value="_search" class="video-bookmark-pane__search" type="search" placeholder="@L["VideoBookmarkPane_Search"].Value" aria-label="@L["VideoBookmarkPane_Search"].Value" />
        </div>
    }
    <ul class="video-bookmark-pane__list" aria-label="@L["Glossary_Bookmarks"].Value">
        @{ var rows = Rows(); var nearest = NearestId(rows); }
        @if (rows.Count == 0)
        {
            <li class="video-bookmark-pane__empty">@L["VideoBookmarkPane_Empty"]</li>
        }
        @foreach (var bookmark in rows)
        {
            <li class="video-bookmark-pane__row @(bookmark.Id == nearest ? "is-near" : null)" @key="bookmark.Id">
                {
                    <AppNativeButton Type="button" Class="@($"video-bookmark-pane__time {(bookmark.IsGlobal ? "is-global" : null)}")" OnClick="@(() => Play.InvokeAsync(bookmark.Seconds))" AriaLabel="@($"Play from {PlaybackSeekRail.Time(bookmark.Seconds)}")">@PlaybackSeekRail.Time(bookmark.Seconds)</AppNativeButton>
                    <span class="video-bookmark-pane__copy">
                        <strong>@(string.IsNullOrWhiteSpace(bookmark.DisplayName) ? PlaybackSeekRail.Time(bookmark.Seconds) : bookmark.DisplayName)</strong>
                        <span>@Owner(bookmark)</span>
                    </span>
                    @if (_confirmId == bookmark.Id)
                    {
                        <AppNativeButton Type="button" Class="video-bookmark-pane__action is-danger" OnClick="@(() => DeleteAsync(bookmark))" AriaLabel="@L["Common_ConfirmDelete"].Value">@L["Common_Delete3"]</AppNativeButton>
                        <AppNativeButton Type="button" Class="video-bookmark-pane__action" OnClick="@(() => _confirmId = null)" AriaLabel="@L["VideoBookmarkQuickList_KeepBookmark"].Value">@L["VideoBookmarkQuickList_Keep"]</AppNativeButton>
                    }
                    else
                    {
                        @if (CanDelete(bookmark))
                        {
                            <AppNativeButton Type="button" Class="video-bookmark-pane__action video-bookmark-pane__action--icon" OnClick="@(() => _confirmId = bookmark.Id)" AriaLabel="@($"Delete bookmark at {PlaybackSeekRail.Time(bookmark.Seconds)}")">
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Delete" /><span class="sr-only">@L["Common_Delete"]</span>
                            </AppNativeButton>
                        }
                    }
                }
            </li>
        }
    </ul>
    <p class="video-bookmark-pane__hint">@L["VideoBookmarkPane_Hint"]</p>
</div>

@code {
    /// <summary>Where the video was when the pane opened (the add row saves this time).</summary>
    [Parameter] public double Position { get; set; }
    /// <summary>Where the video is now, used only to highlight the nearest row.</summary>
    [Parameter] public double Current { get; set; }
    /// <summary>The person's own bookmarks and the Global ones on this title.</summary>
    [Parameter] public IReadOnlyList<PlaybackRailBookmark> Bookmarks { get; set; } = [];
    /// <summary>The remembered filter: All, Mine or Global.</summary>
    [Parameter] public string Filter { get; set; } = PlaybackPreferenceValues.All;
    [Parameter] public EventCallback<string> FilterChanged { get; set; }
    /// <summary>Closes the whole panel (the header's close button; not drawn when no handler is set).</summary>
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool ShowOnBar { get; set; }
    [Parameter] public EventCallback<bool> ShowOnBarChanged { get; set; }
    /// <summary>Saves a personal bookmark at the time with an optional note; true when it was saved.</summary>
    [Parameter] public Func<double, string?, Task<bool>>? Add { get; set; }
    [Parameter] public EventCallback<double> Play { get; set; }
    [Parameter] public Func<PlaybackRailBookmark, Task<bool>>? Delete { get; set; }

    private string? _note, _search;
    private bool _saving, _failed;
    private Guid? _confirmId;

    private bool HasMine => Bookmarks.Any(bookmark => !bookmark.IsGlobal);
    private bool HasGlobal => Bookmarks.Any(bookmark => bookmark.IsGlobal);

    /// <summary>The filter only appears when there is a choice to make: both kinds are present.</summary>
    private bool ShowFilter => HasMine && HasGlobal;

    // Unified player D9a: Mine and Global tabs; the old "All" view is gone. A title with only Global bookmarks opens on Global.
    private string EffectiveFilter => Filter switch
    {
        PlaybackPreferenceValues.Global when HasGlobal => PlaybackPreferenceValues.Global,
        _ when !HasMine && HasGlobal => PlaybackPreferenceValues.Global,
        _ => PlaybackPreferenceValues.Mine,
    };

    private int TotalCount => Bookmarks.Count;

    private IReadOnlyList<AppSelectOption> Tabs
    {
        get
        {
            return new List<AppSelectOption>
            {
                new(PlaybackPreferenceValues.Mine, $"{L["VideoBookmarkPane_Mine"].Value} ({Bookmarks.Count(bookmark => !bookmark.IsGlobal)})"),
                new(PlaybackPreferenceValues.Global, $"{L["VideoBookmarkPane_Global"].Value} ({Bookmarks.Count(bookmark => bookmark.IsGlobal)})"),
            };
        }
    }

    private IReadOnlyList<PlaybackRailBookmark> Rows()
    {
        IEnumerable<PlaybackRailBookmark> rows = EffectiveFilter switch
        {
            PlaybackPreferenceValues.Global => Bookmarks.Where(bookmark => bookmark.IsGlobal),
            _ => Bookmarks.Where(bookmark => !bookmark.IsGlobal),
        };
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            rows = rows.Where(bookmark => (bookmark.DisplayName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || PlaybackSeekRail.Time(bookmark.Seconds).Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        return rows.ToList();
    }

    private string Owner(PlaybackRailBookmark bookmark) =>
        bookmark.IsGlobal ? L["VideoBookmarkPane_Global"].Value : L["VideoBookmarkPane_Mine"].Value;

    /// <summary>Anyone deletes their own. A Global bookmark is changed or removed in the editor's Bookmarks tab, never here.</summary>
    private bool CanDelete(PlaybackRailBookmark bookmark) => Delete is not null && !bookmark.IsGlobal;

    private Guid? NearestId(IReadOnlyList<PlaybackRailBookmark> rows) => rows.Count == 0 ? null : rows.OrderBy(item => Math.Abs(item.Seconds - Current)).First().Id;

    private async Task NoteKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await AddAsync();
    }

    private async Task AddAsync()
    {
        if (_saving || Add is null) return;
        _saving = true;
        try
        {
            _failed = !await Add(Position, _note);
            if (!_failed) _note = null;
        }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(PlaybackRailBookmark bookmark)
    {
        _confirmId = null;
        if (Delete is not null) await Delete(bookmark);
    }

}
