@namespace MediaEngine.Web.Components.Watch
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Playback
@inject IStringLocalizer<SharedStrings> L

@* The video player's one Settings menu (unified player D9, D10; replaces the two-column layout of player-controls-v3 D3). The main page is one
   column under a "Settings" title row with a close: each row has its label on the left and the current choice on the right (Audio, Subtitles,
   Subtitle style). A row opens its own page with a back arrow and a close. The panel is as tall as its content. *@
<div class="video-settings-menu" data-settings-page="@(ShowStyling ? "styling" : "main")">
    @if (ShowStyling)
    {
        <header class="video-settings-menu__header">
            @if (!StylingOnly)
            {
                <AppIconButton Icon="@AppMaterialIcons.Outlined.ArrowBack" Class="video-settings-menu__nav" AriaLabel="@L["Common_Back"].Value" OnClick="@(() => _styling = false)" />
            }
            <h3>@L["PlayerSettings_StylingTitle"]</h3>
            <AppIconButton Icon="@AppMaterialIcons.Outlined.Close" Class="video-settings-menu__nav" AriaLabel="@L["Common_Close"].Value" OnClick="OnClose" />
        </header>
        <div class="video-settings-menu__styling">
            <AppCssElement Tag="p" Class="video-settings-menu__preview" Css="@PreviewStyle" aria-live="polite"><span>@L["PlayerSettings_PreviewLine"]</span></AppCssElement>
            <VideoSettingsChoiceGroup Title="@L["PlayerSettings_Size"].Value" Options="@SizeOptions" Current="@NormalizedSize" ValueSelected="@(value => Change(s => s.SubtitleSize = value))" />
            <VideoSettingsChoiceGroup Title="@L["PlayerSettings_Font"].Value" Options="@FontOptions" Current="@(Look?.SubtitleFont ?? PlaybackPreferenceValues.FontDefault)" ValueSelected="@(value => Change(s => s.SubtitleFont = value))" />
            <VideoSettingsChoiceGroup Title="@L["PlayerSettings_Shadow"].Value" Options="@OnOffOptions" Current="@(Look?.SubtitleShadow == true ? "on" : "off")" ValueSelected="@(value => Change(s => s.SubtitleShadow = value == "on"))" />
            <VideoSettingsChoiceGroup Swatches="true" Title="@L["PlayerSettings_Colour"].Value" Options="@ColourOptions" Current="@(Look?.SubtitleColor ?? PlaybackPreferenceValues.ColorWhite)" ValueSelected="@(value => Change(s => s.SubtitleColor = value))" />
            <VideoSettingsSliderGroup Title="@L["PlayerSettings_TextOpacity"].Value" Stops="@PlaybackPreferenceValues.TextOpacityStops" Value="@((int)Math.Round(SubtitleStyleCss.TextOpacity(Look) * 100))" ValueSelected="@(value => Change(s => s.SubtitleTextOpacity = value))" />
            <VideoSettingsChoiceGroup Swatches="true" Title="@L["PlayerSettings_BackgroundColour"].Value" Options="@ColourOptions" Current="@(Look?.SubtitleBackgroundColor ?? PlaybackPreferenceValues.ColorBlack)" ValueSelected="@(value => Change(s => s.SubtitleBackgroundColor = value))" />
            <VideoSettingsSliderGroup Title="@L["PlayerSettings_BackgroundOpacity"].Value" Stops="@PlaybackPreferenceValues.BackgroundOpacityStops" Value="@((int)Math.Round(SubtitleStyleCss.BackgroundOpacity(Look) * 100))" ValueSelected="@ChangeBackgroundOpacity" />
            <AppButton ButtonStyle="AppButtonStyle.Text" Size="AppControlSize.Compact" Label="@L["PlayerSettings_Reset"].Value" OnClick="ResetAsync" />
        </div>
    }
    else if (_page is "audio" or "subtitles")
    {
        <header class="video-settings-menu__header">
            <AppIconButton Icon="@AppMaterialIcons.Outlined.ArrowBack" Class="video-settings-menu__nav" AriaLabel="@L["Common_Back"].Value" OnClick="@(() => _page = null)" />
            <h3>@(_page == "audio" ? L["PlayerSettings_Audio"] : L["Common_Subtitles"])</h3>
            <AppIconButton Icon="@AppMaterialIcons.Outlined.Close" Class="video-settings-menu__nav" AriaLabel="@L["Common_Close"].Value" OnClick="OnClose" />
        </header>
        <section class="video-settings-menu__page" aria-label="@(_page == "audio" ? L["PlayerSettings_Audio"].Value : L["Common_Subtitles"].Value)">
            @if (_page == "audio")
            {
                @Audio
            }
            else
            {
                @Subtitles
                @if (NoSubtitleSource)
                {
                    <p class="video-settings-menu__notice" role="status" data-subtitles-state="no-source">
                        <span>@L["PlayerSettings_NoSubtitleSource"]</span>
                        @if (IsAdministrator) { <a href="/settings/plugins">@L["PlayerSettings_Plugins"]</a> }
                    </p>
                }
            }
        </section>
    }
    else
    {
        <header class="video-settings-menu__header">
            <h3>@L["PlayerSettings_Title"]</h3>
            <AppIconButton Icon="@AppMaterialIcons.Outlined.Close" Class="video-settings-menu__nav" AriaLabel="@L["Common_Close"].Value" OnClick="OnClose" />
        </header>
        <div class="video-settings-menu__rows">
            <AppNativeButton Type="button" Class="video-settings-menu__row" OnClick="@(() => _page = "audio")" AriaLabel="@L["PlayerSettings_Audio"].Value">
                <span class="video-settings-menu__row-label">@L["PlayerSettings_Audio"]</span>
                <span class="video-settings-menu__row-value">@AudioSummary<AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" /></span>
            </AppNativeButton>
            <AppNativeButton Type="button" Class="video-settings-menu__row" OnClick="@(() => _page = "subtitles")" AriaLabel="@L["Common_Subtitles"].Value">
                <span class="video-settings-menu__row-label">@L["Common_Subtitles"]</span>
                <span class="video-settings-menu__row-value">@SubtitlesSummary<AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" /></span>
            </AppNativeButton>
            <AppNativeButton Type="button" Class="video-settings-menu__row" OnClick="@(() => _styling = true)" AriaLabel="@L["PlayerSettings_StylingTitle"].Value">
                <span class="video-settings-menu__row-label">@L["PlayerSettings_Styling"]</span>
                <span class="video-settings-menu__row-value"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" /></span>
            </AppNativeButton>
        </div>
    }
</div>

@code {
    [Parameter] public RenderFragment? Audio { get; set; }
    [Parameter] public RenderFragment? Subtitles { get; set; }

    /// <summary>The current audio choice shown on the right of the Audio row (for example "English 5.1").</summary>
    [Parameter] public string? AudioSummary { get; set; }

    /// <summary>The current subtitle choice shown on the right of the Subtitles row ("Off" or a language).</summary>
    [Parameter] public string? SubtitlesSummary { get; set; }

    private string? _page;

    /// <summary>True when the Engine says no subtitle source is switched on. The Subtitles column then says so instead of offering a search.</summary>
    [Parameter] public bool NoSubtitleSource { get; set; }

    /// <summary>Administrators also see the Plugins link in the "no source" line.</summary>
    [Parameter] public bool IsAdministrator { get; set; }

    /// <summary>The profile's subtitle look (null until it has loaded).</summary>
    [Parameter] public SubtitleLanguageSettingsDto? Look { get; set; }

    /// <summary>Asks the host to change one styling field and save it.</summary>
    [Parameter] public Func<Action<SubtitleLanguageSettingsDto>, Task>? StyleChanged { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private bool _styling;

    /// <summary>Unified player D12: the style page as its own menu (the "Aa" button), with no back arrow.</summary>
    [Parameter] public bool StylingOnly { get; set; }

    private bool ShowStyling => StylingOnly || _styling;

    private Task ResetAsync() => Change(s =>
    {
        s.SubtitleSize = PlaybackPreferenceValues.Medium;
        s.SubtitleFont = PlaybackPreferenceValues.FontDefault;
        s.SubtitleShadow = false;
        s.SubtitleColor = PlaybackPreferenceValues.ColorWhite;
        s.SubtitleTextOpacity = PlaybackPreferenceValues.DefaultTextOpacity;
        s.SubtitleBackground = true;
        s.SubtitleBackgroundColor = PlaybackPreferenceValues.ColorBlack;
        s.SubtitleBackgroundOpacity = PlaybackPreferenceValues.DefaultBackgroundOpacity;
    });

    // The background slider's first stop (0) is "no background": it turns the switch off but remembers the last opacity, so sliding back up restores a visible backing.
    private Task ChangeBackgroundOpacity(int percent) => Change(s =>
    {
        s.SubtitleBackground = percent > 0;
        if (percent > 0) s.SubtitleBackgroundOpacity = percent;
    });

    // The live preview line changes as each choice changes, so the person sees the result before closing the menu.
    private string PreviewStyle
    {
        get
        {
            var size = NormalizedSize == PlaybackPreferenceValues.Small ? "0.9rem" : NormalizedSize == PlaybackPreferenceValues.Large ? "1.5rem" : "1.15rem";
            var family = (Look?.SubtitleFont ?? PlaybackPreferenceValues.FontDefault) switch
            {
                var f when string.Equals(f, PlaybackPreferenceValues.FontSerif, StringComparison.OrdinalIgnoreCase) => "serif",
                var f when string.Equals(f, PlaybackPreferenceValues.FontMono, StringComparison.OrdinalIgnoreCase) => "monospace",
                _ => "inherit",
            };
            var color = SubtitleStyleCss.TextColor(Look);
            var shadow = Look?.SubtitleShadow == true ? "0 2px 4px #000" : "none";
            var background = SubtitleStyleCss.BackgroundColor(Look);
            return $"font-size:{size};font-family:{family};color:{color};text-shadow:{shadow};--preview-bg:{background}";
        }
    }

    private string NormalizedSize => Look?.SubtitleSize switch
    {
        var size when string.Equals(size, PlaybackPreferenceValues.Small, StringComparison.OrdinalIgnoreCase) => PlaybackPreferenceValues.Small,
        var size when string.Equals(size, PlaybackPreferenceValues.Large, StringComparison.OrdinalIgnoreCase)
            || string.Equals(size, PlaybackPreferenceValues.ExtraLarge, StringComparison.OrdinalIgnoreCase) => PlaybackPreferenceValues.Large,
        _ => PlaybackPreferenceValues.Medium,
    };

    private Task Change(Action<SubtitleLanguageSettingsDto> change) => StyleChanged is null ? Task.CompletedTask : StyleChanged(change);

    private IReadOnlyList<(string Label, string Value)> SizeOptions => [(L["PlayerSettings_Small"].Value, PlaybackPreferenceValues.Small), (L["PlayerSettings_Medium"].Value, PlaybackPreferenceValues.Medium), (L["PlayerSettings_Large"].Value, PlaybackPreferenceValues.Large)];
    private IReadOnlyList<(string Label, string Value)> FontOptions => [(L["PlayerSettings_Default"].Value, PlaybackPreferenceValues.FontDefault), (L["PlayerSettings_Serif"].Value, PlaybackPreferenceValues.FontSerif), (L["PlayerSettings_Mono"].Value, PlaybackPreferenceValues.FontMono)];
    private IReadOnlyList<(string Label, string Value)> ColourOptions => [
        (L["PlayerSettings_White"].Value, PlaybackPreferenceValues.ColorWhite), (L["PlayerSettings_Black"].Value, PlaybackPreferenceValues.ColorBlack),
        (L["PlayerSettings_Blue"].Value, PlaybackPreferenceValues.ColorBlue), (L["PlayerSettings_Teal"].Value, PlaybackPreferenceValues.ColorTeal),
        (L["PlayerSettings_Green"].Value, PlaybackPreferenceValues.ColorGreen), (L["PlayerSettings_Yellow"].Value, PlaybackPreferenceValues.ColorYellow),
        (L["PlayerSettings_Red"].Value, PlaybackPreferenceValues.ColorRed), (L["PlayerSettings_Magenta"].Value, PlaybackPreferenceValues.ColorMagenta)];
    private IReadOnlyList<(string Label, string Value)> OnOffOptions => [(L["Common_Off"].Value, "off"), (L["PlayerSettings_On"].Value, "on")];
}
