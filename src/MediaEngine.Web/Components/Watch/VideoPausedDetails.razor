@namespace MediaEngine.Web.Components.Watch
@using MediaEngine.Web.Services.Playback

@* The paused details of the video overlay (unified player v2 D25; mockup screen 14): the title, the "S1 E1 · The First Wish · 22 min" line and a short
   description at the bottom-left above the bar, on a soft gradient that stays in that corner. The rest of the picture is not dimmed. They hide while a
   panel is open and come back when it closes. The bar already says the same thing to a screen reader, so this is for the eye only. *@
@if (Content is { } content)
{
    <div class="video-paused-details" data-paused-details data-visible="@(Visible ? "true" : "false")" aria-hidden="true">
        <div class="video-paused-details__shade"></div>
        <div class="video-paused-details__text">
            <h2 class="video-paused-details__title">@content.Title</h2>
            @if (!string.IsNullOrWhiteSpace(content.Line)) { <div class="video-paused-details__line">@content.Line</div> }
            @if (!string.IsNullOrWhiteSpace(content.Description)) { <p class="video-paused-details__description">@content.Description</p> }
        </div>
    </div>
}

@code {
    /// <summary>What to say; nothing is drawn without it.</summary>
    [Parameter] public VideoPausedDetailsContent? Content { get; set; }

    /// <summary>True while the video is paused with no panel open.</summary>
    [Parameter] public bool Visible { get; set; }
}
