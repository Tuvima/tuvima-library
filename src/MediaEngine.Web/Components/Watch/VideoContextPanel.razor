@namespace MediaEngine.Web.Components.Watch
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Web.Services.MediaTiles

<div class="video-context-panel" data-playback-context-scroll-key="@($"{CurrentWorkId}:{_season}")">
<div class="playback-context-tabs" role="tablist" aria-label="Video context">
    <AppNativeButton Type="button" role="tab" aria-label="Up Next" aria-selected="@(_tab == "queue")" OnClick="@(() => _tab = "queue")">Up Next · @(Upcoming.Count + (NextEpisode is not null && !Upcoming.Any(item => item.WorkId == NextEpisode.WorkId) ? 1 : 0))</AppNativeButton>
    @if (Episodes.Count > 0) { <AppNativeButton Type="button" role="tab" aria-label="Episodes" aria-selected="@(_tab == "episodes")" OnClick="@(() => _tab = "episodes")">Episodes · @Episodes.Count</AppNativeButton> }
    @if (Chapters.Count > 0) { <AppNativeButton Type="button" role="tab" aria-label="Chapters" aria-selected="@(_tab == "chapters")" OnClick="@(() => _tab = "chapters")">Chapters · @Chapters.Count</AppNativeButton> }
</div>
@if (_tab == "episodes")
{
    @if (Seasons.Count > 1)
    {
        <AppSelect Value="@_season" ValueChanged="SelectSeason" Options="@Seasons" AriaLabel="Season" />
    }
    <PlaybackSheetList>
        @foreach (var episode in Episodes.Where(item => item.SeasonKey == _season))
        {
            var current = episode.WorkId == CurrentWorkId;
            <PlaybackSheetRow Appearance="outlined" Class="video-context-episode" IsActive="@current" OnClick="@(() => EpisodeSelected.InvokeAsync(episode.WorkId))" AriaLabel="@($"Play {EpisodeName(episode)}")">
                @if (MediaTileArtworkUrl.Sized(episode.StillUrl, "s") is { } still)
                {
                    <img class="video-context-episode__still" src="@still" srcset="@EpisodeArtworkSrcSet(episode)" width="128" height="72" sizes="(max-width:400px) 96px, 128px" data-artwork-purpose="episode-still" alt="" loading="lazy" />
                }
                else { <span class="video-context-episode__still video-context-episode__placeholder" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Movie" /></span> }
                <span class="playback-sheet-row__copy"><strong>@EpisodeName(episode)</strong><span>@(episode.EpisodeNumber is int number ? $"E{number}" : null)</span>
                    @if (current && !string.IsNullOrWhiteSpace(episode.Synopsis)) { <span class="video-context-episode__synopsis">@episode.Synopsis</span> }
                </span>
                <span class="playback-sheet-row__duration">@episode.Runtime</span>
                <span class="video-context-current">@if (current) { <PlaybackActivityMark IsPlaying="IsPlaying" Size="compact" AriaLabel="@(IsPlaying ? "Playing" : "Paused")" /> }</span>
            </PlaybackSheetRow>
        }
    </PlaybackSheetList>
}
else if (_tab == "chapters")
{
    <PlaybackSheetList>
        @foreach (var chapter in Chapters)
        {
            var active = chapter.StartSeconds <= Position && (!chapter.EndSeconds.HasValue || Position < chapter.EndSeconds.Value);
            <PlaybackSheetRow Appearance="outlined" Class="video-context-chapter" Variant="chapter" IsActive="@active" OnClick="@(() => ChapterSelected.InvokeAsync(chapter))" AriaLabel="@($"Play {chapter.Title}")">
                <span class="video-context-number">@((chapter.Index + 1).ToString("00"))</span>
                <span class="playback-sheet-row__copy"><strong>@chapter.Title</strong></span>
                <span class="playback-sheet-row__duration">@Timestamp(chapter.StartSeconds)</span>
                <span class="video-context-current">@if (active) { <PlaybackActivityMark IsPlaying="IsPlaying" Size="compact" AriaLabel="@(IsPlaying ? "Playing" : "Paused")" /> }</span>
            </PlaybackSheetRow>
        }
    </PlaybackSheetList>
}
else if (_tab == "queue")
{
    @if (NextEpisode is { } next)
    {
        <div class="video-context-panel__featured">
            @if (!string.IsNullOrWhiteSpace(next.StillUrl)) { <img src="@MediaTileArtworkUrl.Sized(next.StillUrl, "m")" srcset="@EpisodeArtworkSrcSet(next)" sizes="(max-width:400px) calc(100vw - 48px), 368px" data-artwork-purpose="video-context-preview" alt="" /> }
            <strong>@($"S{next.SeasonNumber} E{next.EpisodeNumber} · {next.Title}")</strong>
            <p>@next.Synopsis</p><span>@next.Runtime</span>
            <AppNativeButton Type="button" AriaLabel="@($"Play {next.Title}")" OnClick="@(() => EpisodeSelected.InvokeAsync(next.WorkId))">Play</AppNativeButton>
        </div>
    }
    else if (Upcoming.FirstOrDefault() is { } first)
    {
        <div class="video-context-panel__featured">
            @if (!string.IsNullOrWhiteSpace(first.CoverUrl)) { <img src="@MediaTileArtworkUrl.Sized(first.CoverUrl, "m")" data-artwork-purpose="video-context-preview" alt="" /> }
            <strong>@(first.EpisodeTitle ?? first.Title)</strong><span>@PlaybackVideoRuntime.FormatQueueRuntime(first.Duration)</span>
            <AppNativeButton Type="button" AriaLabel="@($"Play {first.Title}")" OnClick="@(() => QueueSelected.InvokeAsync(first.QueueEntryId))">Play</AppNativeButton>
        </div>
    }
    else { <p>Nothing up next</p> }
    <PlaybackSheetList>
        @foreach (var item in Upcoming.Where(item => NextEpisode is null ? item != Upcoming.FirstOrDefault() : item.WorkId != NextEpisode.WorkId))
        {
            <PlaybackContextRow Title="@(item.EpisodeTitle ?? item.Title)" Subtitle="@item.Year" Duration="@PlaybackVideoRuntime.FormatQueueRuntime(item.Duration)"
                OnClick="@(() => QueueSelected.InvokeAsync(item.QueueEntryId))" AriaLabel="@($"Play {item.EpisodeTitle ?? item.Title}")" />
        }
    </PlaybackSheetList>
}
</div>

@code {
    [Parameter] public string Context { get; set; } = "queue";
    [Parameter] public IReadOnlyList<VideoOwnedEpisode> Episodes { get; set; } = [];
    [Parameter] public IReadOnlyList<PlaybackChapterDto> Chapters { get; set; } = [];
    [Parameter] public IReadOnlyList<ListenQueueItem> Upcoming { get; set; } = [];
    [Parameter] public Guid? CurrentWorkId { get; set; }
    [Parameter] public double Position { get; set; }
    [Parameter] public bool IsPlaying { get; set; }
    [Parameter] public EventCallback<Guid> EpisodeSelected { get; set; }
    [Parameter] public EventCallback<PlaybackChapterDto> ChapterSelected { get; set; }
    [Parameter] public EventCallback<Guid> QueueSelected { get; set; }
    [Parameter] public VideoOwnedEpisode? NextEpisode { get; set; }
    private string _tab = "queue";
    private string? _season;
    private Guid? _lastWork;
    private IReadOnlyList<AppSelectOption> Seasons => Episodes.DistinctBy(item => item.SeasonKey).Select(item => new AppSelectOption(item.SeasonKey, item.SeasonTitle)).ToList();
    protected override void OnParametersSet()
    {
        if (_lastWork != CurrentWorkId || !Episodes.Any(item => item.SeasonKey == _season))
            _season = Episodes.FirstOrDefault(item => item.WorkId == CurrentWorkId)?.SeasonKey ?? Episodes.FirstOrDefault()?.SeasonKey;
        if (_lastWork != CurrentWorkId) _tab = NextEpisode is not null || Upcoming.Count > 0 ? "queue" : Episodes.Count > 0 ? "episodes" : Chapters.Count > 0 ? "chapters" : "queue";
        if (_tab == "episodes" && Episodes.Count == 0 || _tab == "chapters" && Chapters.Count == 0) _tab = "queue";
        _lastWork = CurrentWorkId;
    }
    private void SelectSeason(string? value) => _season = value;
    private static string EpisodeName(VideoOwnedEpisode episode) => episode.Title;
    public static string? EpisodeArtworkSrcSet(VideoOwnedEpisode episode) => MediaTileArtworkUrl.SrcSet(
        MediaTileArtworkUrl.Sized(episode.StillUrl, "s"), MediaTileArtworkUrl.Sized(episode.StillUrl, "m"),
        MediaTileArtworkUrl.Sized(episode.StillUrl, "l"), episode.StillWidthPx, episode.StillHeightPx);
    private static string Timestamp(double seconds) => TimeSpan.FromSeconds(Math.Max(0, seconds)).ToString(seconds >= 3600 ? @"h\:mm\:ss" : @"m\:ss");
}
