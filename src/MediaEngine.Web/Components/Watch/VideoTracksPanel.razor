@namespace MediaEngine.Web.Components.Watch
@inject IStringLocalizer<SharedStrings> L
@* The video player's Subtitles & Audio panel (video-player-controls-and-bookmarks D10): audio on the left, subtitles on the right.
   Subtitle size and background stay in Settings; the panel links there. *@
<div class="video-tracks-panel">
    <section class="video-tracks-panel__column" aria-label="@L["VideoTracksPanel_Audio"].Value">
        <h3>@L["VideoTracksPanel_Audio"]</h3>
        @Audio
    </section>
    <section class="video-tracks-panel__column" aria-label="@L["Common_Subtitles"].Value">
        <h3>@L["Common_Subtitles"]</h3>
        @Subtitles
    </section>
    <p class="video-tracks-panel__footer"><a href="@SettingsHref">@L["VideoTracksPanel_SubtitleSizeAndBackgroundIn"]</a></p>
</div>

@code {
    [Parameter] public RenderFragment? Audio { get; set; }
    [Parameter] public RenderFragment? Subtitles { get; set; }

    /// <summary>Where the profile's playback preferences live.</summary>
    [Parameter] public string SettingsHref { get; set; } = "/settings/profiles";
}
