@using MediaEngine.Web.Models.ViewDTOs
@inject IStringLocalizer<SharedStrings> L

<div class="media-status-pill">
    <AppStatusBadge Text="@_label"
                    Icon="@_icon"
                    Tone="@_tone"
                    Class="@(Status == LibraryStatus.Unowned ? "media-status-badge--muted" : null)" />
    @if (Status == LibraryStatus.Quarantined && QuarantineDays.HasValue)
    {
        <span class="media-quarantine-timer">@L["StatusPill_DeletesIn", QuarantineDays]</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public LibraryStatus Status { get; set; }
    [Parameter] public int? QuarantineDays { get; set; }

    private AppUiTone _tone => Status switch
    {
        LibraryStatus.Verified => AppUiTone.Success,
        LibraryStatus.Provisional => AppUiTone.Warning,
        LibraryStatus.NeedsReview => AppUiTone.Warning,
        LibraryStatus.Quarantined => AppUiTone.Error,
        LibraryStatus.WaitingForProvider => AppUiTone.Info,
        LibraryStatus.RetailMatched => AppUiTone.Success,
        _ => AppUiTone.Neutral,
    };

    private string _icon => Status switch
    {
        LibraryStatus.Verified => AppMaterialIcons.Outlined.CheckCircle,
        LibraryStatus.Provisional => AppMaterialIcons.Outlined.Info,
        LibraryStatus.NeedsReview => AppMaterialIcons.Outlined.WarningAmber,
        LibraryStatus.Quarantined => AppMaterialIcons.Outlined.Block,
        LibraryStatus.WaitingForProvider => AppMaterialIcons.Outlined.Schedule,
        LibraryStatus.RetailMatched => AppMaterialIcons.Outlined.AutoAwesome,
        LibraryStatus.Unowned => AppMaterialIcons.Outlined.ShoppingBag,
        _ => AppMaterialIcons.Outlined.Info,
    };

    private string _label => Status switch
    {
        LibraryStatus.Verified => L["StatusPill_Verified"],
        LibraryStatus.Provisional => L["StatusPill_Provisional"],
        LibraryStatus.NeedsReview => L["StatusPill_NeedsReview"],
        LibraryStatus.Quarantined => L["StatusPill_Quarantined"],
        LibraryStatus.WaitingForProvider => L["StatusPill_WaitingForProvider"],
        LibraryStatus.RetailMatched => L["StatusPill_RetailMatched"],
        LibraryStatus.Unowned => L["StatusPill_Unowned"],
        _ => L["StatusPill_Unknown"],
    };
}
