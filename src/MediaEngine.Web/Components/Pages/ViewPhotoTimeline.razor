@using System.Globalization
@using MediaEngine.Contracts.LocalAssets
@using MediaEngine.Domain.PersonalMedia
@using MediaEngine.Web.Services.Editing
@namespace MediaEngine.Web.Components.Pages
@implements IDisposable
@inject DeviceContextService DeviceContext
@inject IStringLocalizer<SharedStrings> L
<main class="view-timeline view-density--@Density.ToString().ToLowerInvariant()" aria-label="@L["ViewPhotoTimeline_PhotosTimeline"].Value">
@foreach (var month in Months)
{
    <section class="view-month" data-year="@month.Key.Year" data-month="@month.Key.Month" aria-labelledby="@MonthId(month.Key)"><h2 id="@MonthId(month.Key)" tabindex="-1">@month.Key.ToString("MMMM yyyy", CultureInfo.CurrentCulture)</h2>
    @foreach (var day in Days(month))
    {
        var ids = day.Select(item => item.Id).ToList();
        var selectedCount = ids.Count(Selected.Contains);
        var groupState = selectedCount == 0 ? "false" : selectedCount == ids.Count ? "true" : "mixed";
        <section class="view-date-group" aria-labelledby="@DayId(day.Key)"><div class="view-date-group__heading"><AppNativeButton Type="button" Class="@($"view-date-group__select is-{groupState}")" role="checkbox" aria-checked="@groupState" AriaLabel="@($"{(selectedCount == ids.Count ? "Clear" : "Select")} all {(SelectEntireDate ? "matching" : $"{ids.Count} loaded")} items from {day.Key:MMMM d}")" OnClick="@(_ => OnSelectDateGroup.InvokeAsync(ids))"><span aria-hidden="true"></span></AppNativeButton><h3 id="@DayId(day.Key)">@day.Key.ToString("dddd, MMM d", CultureInfo.CurrentCulture)</h3></div><div class="view-grid"><JustifiedGalleryLayout />
        @foreach (var item in day)
        {
            <article @key="item.Id" class="@TileClass(item)" @attributes="@TileAttributes(item)" @ondragstart="@(_ => OnDragStarted.InvokeAsync(item.Id))" @ondragend="@(_ => OnDragEnded.InvokeAsync())">
                @if (SelectMode)
                {
                    @* Select mode: the whole tile is the control. A tap toggles it and Space does the same on the focused tile, because it is a native button. *@
                    <AppNativeButton Type="button" Class="view-tile__surface" aria-pressed="@(Selected.Contains(item.Id) ? "true" : "false")" AriaLabel="@($"Select {Title(item)}")" OnClick="@(args => ToggleAsync(item.Id, args))">
                        @TileFace(item)
                        <span class="view-tile__check" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Filled.Check" Size="AppSize.Small" /></span>
                    </AppNativeButton>
                }
                else
                {
                <AppNativeButton Type="button" Class="view-tile__select-control" role="checkbox" aria-checked="@(Selected.Contains(item.Id) ? "true" : "false")" AriaLabel="@($"Select {Title(item)}")" OnClick="@(args => ToggleAsync(item.Id, args))" StopPropagation="true"><span aria-hidden="true"></span></AppNativeButton>
                <AppNativeButton Type="button" Class="view-tile__surface" AriaLabel="@($"Open {Title(item)}")" OnClick="@(_ => OnOpen.InvokeAsync(item))">
                    @TileFace(item)
                </AppNativeButton>
                }
                @if (!SelectMode && ActionsFor(item) is var actions && actions != ViewActions.None)
                {
                    @* The tile's own menu: the same action list as the selection bar and the viewer (one shared rule, ViewActionPolicy), for one photo, without selecting it first. *@
                    <span class="view-tile__menu"><AppOverflowMenu AriaLabel="@($"More for {Title(item)}")" AnchorOrigin="AppOrigin.BottomRight" TransformOrigin="AppOrigin.TopRight">
                        @if (actions.HasFlag(ViewActions.Favorite) && OnFavoriteItem.HasDelegate)
                        {
                            <AppMenuItem Label="@(item.Favorite ? "Remove from Favorites" : L["Glossary_Favorite"].Value)" Icon="@(item.Favorite ? AppMaterialIcons.Filled.Favorite : AppMaterialIcons.Outlined.FavoriteBorder)" OnClick="@(() => OnFavoriteItem.InvokeAsync(item))" />
                        }
                        @if (actions.HasFlag(ViewActions.AddToGallery) && OnAddItemToGallery.HasDelegate)
                        {
                            @foreach (var gallery in ManualGalleries.Take(5))
                            {
                                <AppMenuItem Label="@($"Add to {gallery.Name}")" Icon="@AppMaterialIcons.Outlined.PhotoAlbum" OnClick="@(() => OnAddItemToGallery.InvokeAsync(new GalleryAdd(item, gallery.Id)))" />
                            }
                        }
                        @if (actions.HasFlag(ViewActions.Download) && OnDownloadItem.HasDelegate)
                        {
                            <AppMenuItem Label="Download" Icon="@AppMaterialIcons.Outlined.Download" OnClick="@(() => OnDownloadItem.InvokeAsync(item))" />
                        }
                        @if (actions.HasFlag(ViewActions.Edit) && OnEditItem.HasDelegate)
                        {
                            <AppMenuItem Label="@L["Common_Edit"].Value" Icon="@AppMaterialIcons.Outlined.Edit" DividerBefore="true" OnClick="@(() => OnEditItem.InvokeAsync(item))" />
                        }
                        @if (actions.HasFlag(ViewActions.Archive) && OnArchiveItem.HasDelegate)
                        {
                            <AppMenuItem Label="Archive" Icon="@AppMaterialIcons.Outlined.Inventory2" OnClick="@(() => OnArchiveItem.InvokeAsync(item))" />
                        }
                        @if (actions.HasFlag(ViewActions.Hide) && OnHideItem.HasDelegate)
                        {
                            <AppMenuItem Label="Hide" Icon="@AppMaterialIcons.Outlined.VisibilityOff" OnClick="@(() => OnHideItem.InvokeAsync(item))" />
                        }
                        @if (actions.HasFlag(ViewActions.Restore) && OnRestoreItem.HasDelegate)
                        {
                            <AppMenuItem Label="@L["Common_Restore"].Value" Icon="@AppMaterialIcons.Outlined.Restore" OnClick="@(() => OnRestoreItem.InvokeAsync(item))" />
                        }
                        @if (actions.HasFlag(ViewActions.Trash) && OnTrashItem.HasDelegate)
                        {
                            <AppMenuItem Label="@L["Common_Trash"].Value" Icon="@AppMaterialIcons.Outlined.DeleteOutline" Tone="AppUiTone.Error" DividerBefore="true" OnClick="@(() => OnTrashItem.InvokeAsync(item))" />
                        }
                    </AppOverflowMenu></span>
                }
                @if (NoteFor(item) is { Length: > 0 } note)
                {
                    <small class="view-tile__note" role="note">@note</small>
                }
            </article>
        }
        </div></section>
    }
    </section>
}
</main>
@code {
    private RenderFragment TileFace(LocalAssetDto item) => @<text>
        @if (Visual(item)) { <img src="@ThumbnailUrl(item)" alt="" width="@item.Width" height="@item.Height" loading="lazy" decoding="async" /> } else { <span class="view-tile__file-icon"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Description" /><strong>@Title(item)</strong><small>@item.MimeType</small></span> }
        @if (IsLive(item)) { <span class="view-tile__motion"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.MotionPhotosOn" /> Live</span> }
        @if (IsVideo(item)) { <span class="view-tile__duration"><AppMaterialIcon Icon="@AppMaterialIcons.Filled.Videocam" />@(item.DurationSeconds is > 0 ? Duration(item.DurationSeconds.Value) : "Video")</span> }
    </text>;

    /// <summary>True while tiles select on a tap instead of opening the viewer. The page owns the mode and its Select button.</summary>
    [Parameter] public bool SelectMode { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<LocalAssetDto> Items { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlySet<Guid> Selected { get; set; } = new HashSet<Guid>();
    [Parameter] public ViewTimelineDensity Density { get; set; } = ViewTimelineDensity.Comfortable;
    [Parameter] public bool SelectEntireDate { get; set; }
    [Parameter, EditorRequired] public Func<LocalAssetDto, string> ThumbnailUrl { get; set; } = _ => string.Empty;
    [Parameter] public EventCallback<LocalAssetDto> OnOpen { get; set; }

    /// <summary>Which actions each tile's menu offers: the one shared rule (ViewActionPolicy). A tile with none shows no menu.</summary>
    [Parameter] public Func<LocalAssetDto, ViewActions> ActionsFor { get; set; } = _ => ViewActions.None;

    /// <summary>The person's own Galleries the menu can add a photo to (the first few are listed).</summary>
    [Parameter] public IReadOnlyList<ViewGalleryDto> ManualGalleries { get; set; } = [];

    /// <summary>Opens the editor on one photo from its tile menu (when the policy offers Edit).</summary>
    [Parameter] public EventCallback<LocalAssetDto> OnEditItem { get; set; }

    /// <summary>Moves one photo to Trash from its tile menu (when the policy offers Trash).</summary>
    [Parameter] public EventCallback<LocalAssetDto> OnTrashItem { get; set; }
    [Parameter] public EventCallback<LocalAssetDto> OnFavoriteItem { get; set; }
    [Parameter] public EventCallback<LocalAssetDto> OnDownloadItem { get; set; }
    [Parameter] public EventCallback<LocalAssetDto> OnArchiveItem { get; set; }
    [Parameter] public EventCallback<LocalAssetDto> OnRestoreItem { get; set; }
    [Parameter] public EventCallback<LocalAssetDto> OnHideItem { get; set; }
    [Parameter] public EventCallback<GalleryAdd> OnAddItemToGallery { get; set; }

    /// <summary>One photo and the Gallery its menu asked to add it to.</summary>
    public sealed record GalleryAdd(LocalAssetDto Item, Guid GalleryId);
    [Parameter] public EventCallback<Guid> OnToggleSelection { get; set; }
    [Parameter] public EventCallback<SelectionRequest> OnToggleSelectionRequested { get; set; }
    [Parameter] public EventCallback<IReadOnlyCollection<Guid>> OnSelectDateGroup { get; set; }
    [Parameter] public EventCallback<Guid> OnDragStarted { get; set; }
    [Parameter] public EventCallback OnDragEnded { get; set; }

    /// <summary>A short note drawn over a tile ("Couldn't delete: the file is in use"); null or empty for none.</summary>
    [Parameter] public Func<LocalAssetDto, string?> NoteFor { get; set; } = _ => null;
    private IEnumerable<IGrouping<DateTimeOffset, LocalAssetDto>> Months => Items.OrderByDescending(Date).GroupBy(i => StartOfMonth(Date(i)));
    private static IEnumerable<IGrouping<DateTimeOffset, LocalAssetDto>> Days(IEnumerable<LocalAssetDto> month) => month.GroupBy(i => StartOfDay(Date(i))).OrderByDescending(g => g.Key);
    private static DateTimeOffset Date(LocalAssetDto item) => item.CapturedAt ?? item.CreatedAt;
    private static DateTimeOffset StartOfMonth(DateTimeOffset d) => new(d.Year, d.Month, 1, 0, 0, 0, TimeSpan.Zero);
    private static DateTimeOffset StartOfDay(DateTimeOffset d) => new(d.Year, d.Month, d.Day, 0, 0, 0, TimeSpan.Zero);
    private static string MonthId(DateTimeOffset date) => $"view-{date:yyyy-MM}";
    private static string DayId(DateTimeOffset date) => $"view-{date:yyyy-MM-dd}";
    private static string Title(LocalAssetDto item) => string.IsNullOrWhiteSpace(item.Title) ? item.FileName : item.Title;
    private static bool Visual(LocalAssetDto item) => item.MimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) || item.MimeType.StartsWith("video/", StringComparison.OrdinalIgnoreCase);
    private static bool IsVideo(LocalAssetDto item) => item.MimeType.StartsWith("video/", StringComparison.OrdinalIgnoreCase);
    private static bool IsLive(LocalAssetDto item) => item.Files.Any(file => string.Equals(file.Role, "live_photo_video", StringComparison.OrdinalIgnoreCase));
    private static string Kind(LocalAssetDto item) => item.MediaKind.ToLowerInvariant();
    private static string Orientation(LocalAssetDto item) => item.Width is > 0 && item.Height is > 0 ? item.Width > item.Height * 1.15 ? "landscape" : item.Height > item.Width * 1.15 ? "portrait" : "square" : "standard";
    private static string Duration(double seconds) => TimeSpan.FromSeconds(seconds).TotalHours >= 1 ? TimeSpan.FromSeconds(seconds).ToString(@"h\:mm\:ss", CultureInfo.InvariantCulture) : TimeSpan.FromSeconds(seconds).ToString(@"m\:ss", CultureInfo.InvariantCulture);
    private static double Aspect(LocalAssetDto item) => item.Width is > 0 && item.Height is > 0
        ? item.Width.Value / (double)item.Height.Value
        : 16d / 11d;
    private static string AspectStyle(LocalAssetDto item) => FormattableString.Invariant($"--view-aspect:{Aspect(item):0.####}");
    // Dragging a tile into a Gallery is a mouse gesture; nothing on a touch device depends on it (Select mode replaces it).
    private IReadOnlyDictionary<string, object> TileAttributes(LocalAssetDto item) => DeviceContext.IsTouch
        ? new Dictionary<string, object> { ["style"] = AspectStyle(item) }
        : new Dictionary<string, object> { ["style"] = AspectStyle(item), ["draggable"] = "true" };

    protected override void OnInitialized() => DeviceContext.OnChanged += DeviceChanged;
    public void Dispose() => DeviceContext.OnChanged -= DeviceChanged;
    private void DeviceChanged() => _ = InvokeAsync(StateHasChanged);
    private string TileClass(LocalAssetDto item) => $"view-tile view-tile--{Kind(item)} view-tile--{Orientation(item)}{(Aspect(item) > 3 ? " view-tile--panorama" : string.Empty)}{(Selected.Contains(item.Id) ? " is-selected" : string.Empty)}{(item.FileMissing ? " is-missing" : string.Empty)}";
    private Task ToggleAsync(Guid id, MouseEventArgs args) => OnToggleSelectionRequested.HasDelegate
        ? OnToggleSelectionRequested.InvokeAsync(new SelectionRequest(id, args.ShiftKey))
        : OnToggleSelection.InvokeAsync(id);

    public sealed record SelectionRequest(Guid ItemId, bool ExtendRange);
}
