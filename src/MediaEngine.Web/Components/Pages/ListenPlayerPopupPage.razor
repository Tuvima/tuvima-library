    private async Task OpenBookmarkDialogAsync(ElementReference trigger = default)
    {
        CloseRateMenu();
        if (_disposed || _bookmarkDialogOpening || _bookmarkDialogContext is not null) return;
        _bookmarkDialogError = null;
        if (!IsAudiobookMode || CurrentItem is not { AssetId: { } assetId, WorkId: { } workId }
            || _snapshot.AudiobookBookSessionLeaseId is not { } sessionLeaseId
            || !Guid.TryParse(OwnerRecipientId, out var ownerRecipientId) || ownerRecipientId == Guid.Empty)
        {
            _bookmarkDialogError = "Bookmarks are unavailable for this playback session.";
            return;
        }

        _bookmarkDialogOpening = true;
        var openGeneration = ++_bookmarkOpenGeneration;
        var requestVersion = _snapshot.PlaybackRequestVersion;
        var sessionGeneration = _snapshot.AudiobookBookSessionGeneration;
        ListenPlaybackCommandActionsClient? actions = null;
        AudiobookBookmarkActionContext? context = null;
        try
        {
            var profile = await ActiveProfiles.GetActiveProfileAsync();
            if (!IsCurrentBookmarkOpen(openGeneration))
                throw new OperationCanceledException("The popup bookmark open was superseded.");
            if (profile is null || profile.Id == Guid.Empty)
                throw new InvalidOperationException("The active profile could not be confirmed.");

            context = new AudiobookBookmarkActionContext(Guid.NewGuid(), profile.Id, workId, sessionLeaseId,
                sessionGeneration, assetId);
            actions = new ListenPlaybackCommandActionsClient(ownerRecipientId, _popupRecipientId, BookmarkCommandChannel);
            await actions.OpenAsync(context);

            if (!IsCurrentBookmarkOpen(openGeneration))
                throw new OperationCanceledException("The popup bookmark open was superseded.");
            if (!IsSameBookmarkSubject(profile.Id, assetId, workId, sessionLeaseId, sessionGeneration, requestVersion))
                throw new InvalidOperationException("Playback changed before bookmarks could be opened.");

            var authorizedAssetIds = actions.GetAuthorizedAssetIds(context);
            if (!authorizedAssetIds.Contains(assetId))
                throw new InvalidOperationException("The playback owner did not confirm access to this audiobook.");

            var snapshot = await actions.GetSnapshotAsync(context);
            if (!IsCurrentBookmarkOpen(openGeneration))
                throw new OperationCanceledException("The popup bookmark open was superseded.");
            if (!IsSameBookmarkSubject(profile.Id, assetId, workId, sessionLeaseId, sessionGeneration, requestVersion))
                throw new InvalidOperationException("Playback changed before bookmarks could be opened.");
            if (snapshot.Draft is null)
                throw new InvalidOperationException(snapshot.Message ?? "The playback owner did not capture a bookmark position.");

            _bookmarkAuthorizedAssetIds = authorizedAssetIds;
            _bookmarkDialogActions = actions;
            _bookmarkDialogContext = context;
            _bookmarkTrigger = trigger;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "The popup could not open its owner-authorized audiobook bookmark dialog.");
            if (IsCurrentBookmarkOpen(openGeneration))
            {
                _bookmarkDialogError = exception is InvalidOperationException
                    ? exception.Message
                    : "Bookmarks could not be opened. Check that the main player is still connected.";
            }
            if (actions is not null && context is not null)
            {
                try { await actions.CloseAsync(context); }
                catch (Exception closeException) { Logger.LogDebug(closeException, "The stale popup bookmark lease could not be released after open failed."); }
            }
        }
        finally
        {
            if (IsCurrentBookmarkOpen(openGeneration)) _bookmarkDialogOpening = false;
        }
    }

    private bool IsCurrentBookmarkOpen(long generation) =>
        !_disposed && _bookmarkDialogOpening && _bookmarkOpenGeneration == generation;

    private void InvalidatePendingBookmarkOpen()
    {
        _bookmarkOpenGeneration++;
        _bookmarkDialogOpening = false;
        _bookmarkDialogError = null;
    }

    private bool IsSameBookmarkSubject(Guid profileId, Guid assetId, Guid workId, Guid sessionLeaseId,
        long sessionGeneration, long requestVersion) =>
        IsAudiobookMode && ActiveProfiles.CurrentProfile?.Id == profileId
        && CurrentItem?.AssetId == assetId && CurrentItem.WorkId == workId
        && _snapshot.AudiobookBookSessionLeaseId == sessionLeaseId
        && _snapshot.AudiobookBookSessionGeneration == sessionGeneration
        && _snapshot.PlaybackRequestVersion == requestVersion;

    private async Task CloseBookmarkDialogAsync()
    {
        var actions = _bookmarkDialogActions;
        var context = _bookmarkDialogContext;
        DismissBookmarkDialogPresentation();
        if (actions is null || context is null) return;
        try { await actions.CloseAsync(context); }
        catch (Exception exception) { Logger.LogDebug(exception, "The popup bookmark dialog lease was already released or the owner disconnected."); }
    }

    private Task DismissBookmarkDialogAsync()
    {
        DismissBookmarkDialogPresentation();
        return InvokeAsync(StateHasChanged);
    }

    private void DismissBookmarkDialogPresentation()
    {
        _bookmarkOpenGeneration++;
        _bookmarkDialogOpening = false;
        _bookmarkDialogError = null;
        _bookmarkDialogActions = null;
        _bookmarkDialogContext = null;
        _bookmarkAuthorizedAssetIds = new HashSet<Guid>();
    }

    private async Task EnsureLyricsLoadedAsync()
    {
        var assetId = CurrentItem?.AssetId;
        var workId = CurrentItem?.WorkId;
        var requestVersion = _snapshot.PlaybackRequestVersion;
        if (IsVideoMode || _activeSheet != "music-lyrics" || assetId is null
            || (assetId == _lyricsAssetId && workId == _lyricsWorkId && requestVersion == _lyricsRequestVersion)) return;
        _lyricsAssetId = assetId;
        _lyricsWorkId = workId;
        _lyricsRequestVersion = requestVersion;
        _lyricsLoading = true;
        _lyricsLines = [];
        _lyricTracks = [];
        _selectedLyricTrackId = null;
        _lyricsStatus = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var tracks = await Api.GetTextTracksAsync(assetId.Value);
            if (!IsCurrentLyricsRequest(assetId, workId, requestVersion)) return;
            var content = await Api.GetLyricsAsync(assetId.Value);
            if (IsCurrentLyricsRequest(assetId, workId, requestVersion))
            {
                _lyricTracks = tracks.Where(track => track.Kind.Equals("Lyrics", StringComparison.OrdinalIgnoreCase)).ToList();
                _selectedLyricTrackId = _lyricTracks.FirstOrDefault(track => track.IsPreferred)?.Id
                    ?? _lyricTracks.FirstOrDefault()?.Id;
                _lyricsLines = ParseLyrics(content).ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not load lyrics in listen popup.");
            if (IsCurrentLyricsRequest(assetId, workId, requestVersion))
            {
                _lyricsStatus = "Lyrics could not be loaded.";
            }
        }
        finally
        {
            if (IsCurrentLyricsRequest(assetId, workId, requestVersion))
            {
                _lyricsLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private bool IsCurrentLyricsRequest(Guid? assetId, Guid? workId, long requestVersion) =>
        !IsVideoMode
        && _activeSheet == "music-lyrics"
        && CurrentItem?.AssetId == assetId
        && CurrentItem?.WorkId == workId
        && _snapshot.PlaybackRequestVersion == requestVersion;

    private async Task SelectLyricVersionAsync(ChangeEventArgs args)
    {
        if (CurrentItem?.AssetId is not Guid assetId || !Guid.TryParse(args.Value?.ToString(), out var trackId))
        {
            return;
        }

        try
        {
            var content = await Api.GetTextTrackContentAsync(assetId, trackId);
            if (CurrentItem?.AssetId != assetId)
            {
                return;
            }

            if (content is null)
            {
                _lyricsStatus = "That lyrics version is unavailable.";
                return;
            }

            _selectedLyricTrackId = trackId;
            _lyricsLines = ParseLyrics(content).ToList();
            _lyricsStatus = null;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not select a lyrics version in listen popup.");
            _lyricsStatus = "That lyrics version is unavailable.";
        }
    }

    private async Task SetPreferredLyricsAsync()
    {
        if (CurrentItem?.AssetId is not Guid assetId || _selectedLyricTrackId is not Guid trackId)
        {
            return;
        }

        try
        {
            if (await Api.SetPreferredTextTrackAsync(assetId, trackId))
            {
                _lyricTracks = (await Api.GetTextTracksAsync(assetId))
                    .Where(track => track.Kind.Equals("Lyrics", StringComparison.OrdinalIgnoreCase)).ToList();
                _lyricsStatus = "Preferred lyrics saved.";
            }
            else
            {
                _lyricsStatus = "Could not save preferred lyrics.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not save the preferred lyrics version in listen popup.");
            _lyricsStatus = "Could not save preferred lyrics.";
        }
    }

    private async Task RefreshLyricsAsync()
    {
        if (_lyricsRefreshing || CurrentItem?.AssetId is not Guid assetId)
        {
            return;
        }

        _lyricsRefreshing = true;
        _lyricsStatus = null;
        try
        {
            var result = await Api.RefreshTextTracksAsync(assetId, "lyrics");
            if (CurrentItem?.AssetId != assetId)
            {
                return;
            }

            var outcome = result?.message ?? "Lyrics search could not start.";
            _lyricsAssetId = null;
            await EnsureLyricsLoadedAsync();
            _lyricsStatus = outcome;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not find better lyrics in listen popup.");
            if (CurrentItem?.AssetId == assetId)
            {
                _lyricsStatus = "Lyrics search could not start.";
            }
        }
        finally
        {
            if (CurrentItem?.AssetId == assetId)
            {
                _lyricsRefreshing = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

