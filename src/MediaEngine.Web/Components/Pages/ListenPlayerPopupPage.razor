@page "/listen/player-popup"
@layout MediaEngine.Web.Shared.PopupLayout
@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@using System.Threading
@using Microsoft.JSInterop
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Listen
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Web.Services.MediaTiles
@inject IJSRuntime JS
@inject IEngineApiClient Api
@inject IStringLocalizer<SharedStrings> L
@inject ILogger<ListenPlayerPopupPage> Logger
@inject ListenPlaybackClientSettings PlaybackClientSettings
@inject ActiveProfileSessionService ActiveProfiles
@inject IListenPlaybackCommandChannel BookmarkCommandChannel
@implements IAsyncDisposable

<PageTitle>@L["Listen_MiniPlayerTitle"]</PageTitle>

<PlaybackPopoutShell Experience="@CurrentExperience"
                     Class="@PopupClass"
                     Css="@BackdropStyle"
                     IsSheetOpen="@(_activeSheet is not null || _rateMenuOpen || _sleepMenuOpen)"
                     OnKeyDown="HandlePopupKeyDown"
                     tabindex="-1">
    @if (CurrentItem is null && !IsVideoMode)
    {
        <div class="listen-popup__empty">
            <MudIcon Icon="@Icons.Material.Outlined.QueueMusic" Class="tl-u-font-size-42px tl-u-opacity-0-34" />
            <p>@L["Listen_NothingPlaying"]</p>
        </div>
    }
    else if (IsVideoMode)
    {
        <div class="listen-popup__video-return">
            <MudIcon Icon="@Icons.Material.Outlined.OndemandVideo" Class="tl-u-font-size-42px" />
            <h1>Video is playing in the main window</h1>
            <p>This popup controls music and audiobook playback. Your video remains in its original player.</p>
            <AppNativeButton Type="button" Class="listen-popup__return-video" OnClick="ReturnToVideoAsync" AriaLabel="Return to video player">
                <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Popup" /> Return to video
            </AppNativeButton>
        </div>
    }
    else
    {
        var current = CurrentItem!;
        <div class="listen-popup__composition @(ShowContextPanel ? "listen-popup__composition--with-context" : null)">
        <main class="listen-popup__stage" aria-label="@PopoutAriaLabel">
            <div class="listen-popup__cover">
                @if (!string.IsNullOrWhiteSpace(current.CoverUrl))
                {
                    <img src="@(MediaTileArtworkUrl.Sized(current.CoverUrl, "m") ?? current.CoverUrl)"
                         srcset="@(MediaTileArtworkUrl.SrcSet(MediaTileArtworkUrl.Sized(current.CoverUrl, "s"), MediaTileArtworkUrl.Sized(current.CoverUrl, "m"), MediaTileArtworkUrl.Sized(current.CoverUrl, "l")))"
                         sizes="@(IsAudiobookMode ? "(max-width: 900px) min(70vw, 220px), 220px" : "(max-width: 900px) min(76vw, 330px), 330px")"
                         alt="@current.Title" data-image-display="playback-popup-artwork" />
                }
                else
                {
                    <MudIcon Icon="@(IsAudiobookMode ? Icons.Material.Outlined.Headphones : Icons.Material.Outlined.Album)" Class="tl-u-font-size-72px" />
                }
            </div>

            <section class="listen-popup__identity">
                @if (IsAudiobookMode && ListenPlaybackIdentityRoutes.Audiobook(current) is { } audiobookRoute)
                {
                    <h1><a href="@audiobookRoute">@current.Title</a></h1>
                }
                else { <h1>@current.Title</h1> }
                @if (IsAudiobookMode)
                {
                    <p>@PlayerSubtitle(current)</p>
                    @if (current.Authors.Count > 0)
                    {
                        <div class="listen-popup__contributors">
                            <span>By</span>
                            @for (var contributorIndex = 0; contributorIndex < current.Authors.Count; contributorIndex++)
                            {
                                var contributor = current.Authors[contributorIndex];
                                if (contributorIndex > 0) { <span>; </span> }
                                if (ListenPlaybackIdentityRoutes.Contributor(contributor) is { } contributorRoute)
                                {
                                    <a href="@contributorRoute">@contributor.Name</a>
                                }
                                else
                                {
                                    <span>@contributor.Name</span>
                                }
                            }
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(current.AuthorName)) { <span class="listen-popup__contributor">By @current.AuthorName</span> }
                    @if (current.Narrators.Count > 0)
                    {
                        <div class="listen-popup__contributors">
                            <span>Narrated by</span>
                            @for (var contributorIndex = 0; contributorIndex < current.Narrators.Count; contributorIndex++)
                            {
                                var contributor = current.Narrators[contributorIndex];
                                if (contributorIndex > 0) { <span>; </span> }
                                if (ListenPlaybackIdentityRoutes.Contributor(contributor) is { } contributorRoute)
                                {
                                    <a href="@contributorRoute">@contributor.Name</a>
                                }
                                else
                                {
                                    <span>@contributor.Name</span>
                                }
                            }
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(current.NarratorName)) { <span class="listen-popup__contributor">Narrated by @current.NarratorName</span> }
                }
                else
                {
                    @if (ListenPlaybackIdentityRoutes.Artist(current) is { } artistRoute)
                    {
                        <p><a href="@artistRoute">@PlayerSubtitle(current)</a></p>
                    }
                    else { <p>@PlayerSubtitle(current)</p> }
                    @if (ListenPlaybackIdentityRoutes.Album(current) is { } albumRoute)
                    {
                        <a class="listen-popup__album-link" href="@albumRoute">@current.Album</a>
                    }
                    else if (!string.IsNullOrWhiteSpace(current.Album)) { <span class="listen-popup__album-link">@current.Album</span> }
                }
                @if (ListenPlaybackIdentityRoutes.Playlist(current) is { } playlistRoute && !string.IsNullOrWhiteSpace(_snapshot.SourceLabel))
                {
                    <a class="listen-popup__source-link" href="@playlistRoute">From @_snapshot.SourceLabel</a>
                }
                else if (!string.IsNullOrWhiteSpace(_snapshot.SourceLabel))
                {
                    <span class="listen-popup__source-link">@_snapshot.SourceLabel</span>
                }
            </section>

            <section class="listen-popup__timeline" aria-label="Playback progress">
                @if (IsAudiobookMode && !string.IsNullOrWhiteSpace(CurrentChapterProgressLabel))
                {
                    <PlaybackTimelineMetaRow Icon="@Icons.Material.Outlined.MenuBook"
                                             Label="@CurrentChapterProgressLabel"
                                             TrailingText="@ProgressPercentLabel"
                                             Size="large"
                                             Class="listen-popup__chapter-row" />
                }
                <PlaybackRangeSlider Min="0" Max="@ProgressMax" Step="1"
                                     Value="@Math.Min(_snapshot.CurrentTimeSeconds, ProgressMax)"
                                     ShowTicks="false" CommitOnChange="true"
                                     Class="listen-popup__progress-slider"
                                     AriaLabel="Playback position"
                                     ValueFormatter="@(_ => ProgressValueText)"
                                     ValueChanged="SeekAsync" />
                <div class="listen-popup__time-row">
                    <span>@FormatTimestamp(_snapshot.CurrentTimeSeconds)</span>
                    <span>@RemainingLabel</span>
                    <span>@FormatTimestamp(ProgressMax)</span>
                </div>
                @if (IsAudiobookMode && AudiobookProgress is { } audiobookProgress)
                {
                    <div class="listen-popup__book-progress" aria-label="@audiobookProgress.Label">
                        <PlaybackRangeSlider Min="0" Max="@audiobookProgress.Total" Value="@audiobookProgress.Position"
                                             ShowTicks="false" ReadOnly="true" SnapValueToStep="false"
                                             AriaLabel="@audiobookProgress.Label"
                                             ValueFormatter="@(value => $"{Math.Clamp((int)Math.Round(value / audiobookProgress.Total * 100d), 0, 100)}%")" />
                        <span>@audiobookProgress.Label</span>
                    </div>
                }
            </section>

            <ListenTransportControls Variant="popup"
                                     IsAudiobookMode="@IsAudiobookMode"
                                     IsPlaying="@_snapshot.IsPlaying"
                                     NeedsUserGestureToStart="@_snapshot.NeedsUserGestureToStart"
                                     IsMuted="@_snapshot.IsMuted"
                                     HasChapters="@HasChapters"
                                     CanPreviousTrack="@(_snapshot.CurrentIndex > 0)"
                                     CanNextTrack="@CanPlayNext"
                                     SkipBackSeconds="@_snapshot.SkipBackSeconds"
                                     SkipForwardSeconds="@_snapshot.SkipForwardSeconds"
                                     CurrentBrowserStreamUrl="@CurrentBrowserStreamUrl"
                                     CurrentTimeSeconds="@_snapshot.CurrentTimeSeconds"
                                     PlaybackRate="@_snapshot.PlaybackRate"
                                     Volume="@_snapshot.Volume"
                                     OnTogglePlay="TogglePlayAsync"
                                     OnPreviousTrack="PreviousAsync"
                                     OnNextTrack="NextAsync"
                                     OnPreviousChapter="PlayPreviousChapterAsync"
                                     OnNextChapter="PlayNextChapterAsync"
                                     OnSkipBack="SkipBackAsync"
                                     OnSkipForward="SkipForwardAsync" />

            @if (IsAudiobookMode)
            {
                <PlaybackControlStrip Controls="@AudiobookToolControls"
                                      Surface="popup"
                                      Size="standard"
                                      Class="listen-popup__actions"
                                      AriaLabel="Audiobook tools"
                                      SpeedValue="@_snapshot.PlaybackRate"
                                      SpeedChanged="SetSpeedAsync"
                                      SpeedMenuOpen="@(_rateMenuOpen && _rateMenuSurface == "popup")"
                                      SpeedMenuOpenChanged="HandleRateMenuOpenChanged"
                                      SleepTimerState="@_snapshot.SleepTimerState"
                                      SleepTimerAvailability="@_snapshot.SleepTimerAvailability"
                                      SleepTimerOptionsMinutes="@_snapshot.SleepTimerOptionsMinutes"
                                      SleepTimerChanged="SetSleepTimerSelectionAsync"
                                      SleepMenuOpen="@(_sleepMenuOpen && _sleepMenuSurface == "popup")"
                                      SleepMenuOpenChanged="HandleSleepMenuOpenChanged"
                                      OnControlActivation="HandleAudiobookToolActivationAsync" />
            }
            else
            {
                <PlaybackControlStrip Controls="@MusicToolControls"
                                      Surface="popup"
                                      Size="standard"
                                      Class="listen-popup__actions listen-popup__music-actions"
                                      AriaLabel="Music tools"
                                      SpeedValue="@_snapshot.PlaybackRate"
                                      SpeedChanged="SetSpeedAsync"
                                      SpeedMenuOpen="@(_rateMenuOpen && _rateMenuSurface == "popup")"
                                      SpeedMenuOpenChanged="HandleRateMenuOpenChanged"
                                      OnControl="HandleMusicToolControl" />
                <section class="listen-popup__volume-control" aria-label="Volume control">
                    <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Volume" />
                    <PlaybackRangeSlider Min="0" Max="1" Step="@PlaybackClientSettings.VolumeStep" InputStep="@PlaybackClientSettings.VolumeStep"
                                         Value="@_snapshot.Volume" ValueChanged="SetVolumeAsync" ShowTicks="false"
                                         Surface="popup" Class="listen-popup__volume-slider" AriaLabel="Volume"
                                         ValueFormatter="FormatVolumeValue" />
                    <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Volume" />
                </section>
            }
        </main>
        @if (ShowContextPanel)
        {
            <aside class="listen-popup__context" aria-label="Listening history">
                <header class="listen-popup__context-header">
                    <nav class="listen-popup__context-tabs" role="tablist" aria-label="Playback context">
                        <AppNativeButton Type="button" role="tab" aria-selected="@(_contextPanelTab == "history" ? "true" : "false")" Class="@(_contextPanelTab == "history" ? "is-active" : null)" OnClick="@(() => SetContextPanelTab("history"))">History</AppNativeButton>
                    </nav>
                    <AppNativeButton Type="button" AriaLabel="Close playback context panel" OnClick="ToggleHistoryPanel"><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Close" /></AppNativeButton>
                </header>
                <div class="listen-popup__context-list">
                    @if (IsAudiobookMode)
                    {
                        @if (AudiobookHistory.Count == 0) { <p class="listen-popup__context-empty">Recent listening positions appear here.</p> }
                        @foreach (var group in AudiobookHistory.GroupBy(item => item.EndedAt.LocalDateTime.Date).OrderByDescending(group => group.Key))
                        {
                            <h2>@group.Key.ToString("D", CultureInfo.CurrentCulture)</h2>
                            @foreach (var entry in group)
                            {
                                <PlaybackContextRow Variant="history" LeadingText="@entry.EndedAt.LocalDateTime.ToString("t", CultureInfo.CurrentCulture)" Title="@(entry.ChapterTitle ?? entry.Title)" Subtitle="@AudiobookHistorySubtitle(entry)" Duration="@AudiobookHistoryDuration(entry)" OnClick="@(() => PlayAudiobookHistoryAsync(entry))" AriaLabel="@($"Resume {entry.ChapterTitle ?? entry.Title} at {FormatTimestamp(entry.PositionSeconds)}")">
                                    <Actions><AppNativeButton Type="button" Class="listen-popup__replay" AriaLabel="@($"Resume {entry.ChapterTitle ?? entry.Title}")" title="Resume" OnClick="@(() => PlayAudiobookHistoryAsync(entry))"><MudIcon Icon="@Icons.Material.Outlined.Replay" /></AppNativeButton></Actions>
                                </PlaybackContextRow>
                            }
                        }
                    }
                    else
                    {
                        @if (MusicHistory.Count == 0) { <p class="listen-popup__context-empty">Played tracks appear here during this session.</p> }
                        @foreach (var item in MusicHistory)
                        {
                            <PlaybackContextRow Variant="history" LeadingText="@item.PlayedAt?.LocalDateTime.ToString("t", CultureInfo.CurrentCulture)" Title="@item.Title" Subtitle="@PlayerSubtitle(item)" Duration="@item.Duration" OnClick="@(() => PlayMusicHistoryItemAsync(item))" AriaLabel="@($"Play {item.Title}")">
                                <Actions><AppNativeButton Type="button" Class="listen-popup__replay" AriaLabel="@($"Play {item.Title}")" title="Play" OnClick="@(() => PlayMusicHistoryItemAsync(item))"><MudIcon Icon="@Icons.Material.Outlined.PlayArrow" /></AppNativeButton></Actions>
                            </PlaybackContextRow>
                        }
                    }
                </div>
            </aside>
        }
        </div>

        @if (_activeSheet is not null)
        {
            <div class="listen-popup-sheet__backdrop" role="presentation" aria-hidden="true" @onclick="CloseSheet"></div>
            <PlaybackToolSheet Title="@SheetTitle"
                               Subtitle="@SheetSubtitle"
                               Icon="@SheetIcon"
                               Surface="popup"
                               Presentation="full-overlay"
                               Modal="true"
                               Class="listen-popup-sheet"
                               OnClose="CloseSheet">
                @switch (_activeSheet)
                {
                    case "chapters":
                        <PlaybackSheetList Class="listen-popup-sheet__list">
                            @if (CurrentChapters.Count == 0)
                            {
                                <div class="listen-popup-sheet__empty">No timed chapters were found for this audiobook.</div>
                            }
                            else
                            {
                                @for (var index = 0; index < CurrentChapters.Count; index++)
                                {
                                    var chapter = CurrentChapters[index];
                                    var isActive = IsCurrentChapter(chapter);
                                    <PlaybackContextRow Class="listen-popup-sheet__chapter-context"
                                                        LeadingWidth="80px"
                                                        Title="@chapter.Title"
                                                        Duration="@ChapterDuration(chapter)"
                                                        IsCurrent="@isActive"
                                                        IsPlaying="@_snapshot.IsPlaying"
                                                        OnClick="@(() => PlayChapterAsync(chapter.Index))"
                                                        AriaLabel="@($"Play {chapter.Title}")"
                                                        data-playback-active-chapter="@(isActive ? "true" : null)">
                                        <LeadingContent><span class="listen-popup-sheet__chapter-number">@(chapter.Index + 1)</span></LeadingContent>
                                    </PlaybackContextRow>
                                }
                            }
                        </PlaybackSheetList>
                        break;
                    case "history":
                        <PlaybackSheetList Class="listen-popup-sheet__list">
                            @if (AudiobookHistory.Count == 0)
                            {
                                <div class="listen-popup-sheet__empty">Recent listening positions will appear here.</div>
                            }
                            else
                            {
                                @foreach (var group in AudiobookHistory.GroupBy(item => item.EndedAt.LocalDateTime.Date).OrderByDescending(group => group.Key))
                                {
                                    <h2>@group.Key.ToString("D", CultureInfo.CurrentCulture)</h2>
                                    @foreach (var item in group)
                                    {
                                        <PlaybackContextRow Variant="history" LeadingText="@item.EndedAt.LocalDateTime.ToString("t", CultureInfo.CurrentCulture)"
                                                            Title="@(item.ChapterTitle ?? item.Title)" Subtitle="@AudiobookHistorySubtitle(item)"
                                                            Duration="@AudiobookHistoryDuration(item)" OnClick="@(() => PlayAudiobookHistoryAsync(item))"
                                                            AriaLabel="@($"Resume {item.ChapterTitle ?? item.Title} from {FormatTimestamp(item.PositionSeconds)}")">
                                            <Actions><AppNativeButton Type="button" Class="listen-popup__replay" AriaLabel="@($"Resume {item.ChapterTitle ?? item.Title}")" title="Resume" OnClick="@(() => PlayAudiobookHistoryAsync(item))"><MudIcon Icon="@Icons.Material.Outlined.Replay" /></AppNativeButton></Actions>
                                        </PlaybackContextRow>
                                    }
                                }
                            }
                        </PlaybackSheetList>
                        break;
                    case "music-queue":
                        <div class="listen-popup-sheet__music-list">
                            @if (_snapshot.CurrentIndex >= _snapshot.Queue.Count - 1)
                            {
                                <div class="listen-popup-sheet__empty">The queue ends with the current track.</div>
                            }
                            else
                            {
                                @for (var index = _snapshot.CurrentIndex + 1; index < _snapshot.Queue.Count; index++)
                                {
                                    var queueIndex = index;
                                    var item = _snapshot.Queue[index];
                                    <AppNativeButton Type="button" Class="listen-popup-sheet__music-row" OnClick="@(() => PlayQueueIndexAsync(queueIndex))">
                                        <span class="listen-popup-sheet__music-thumb">
                                            @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                                            {
                                                <img src="@(MediaTileArtworkUrl.Sized(item.CoverUrl, "s") ?? item.CoverUrl)"
                                                     srcset="@(MediaTileArtworkUrl.SrcSet(MediaTileArtworkUrl.Sized(item.CoverUrl, "s"), MediaTileArtworkUrl.Sized(item.CoverUrl, "m")))"
                                                     sizes="64px" alt="" data-image-display="playback-queue-thumbnail" />
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Outlined.MusicNote" />
                                            }
                                        </span>
                                        <span class="listen-popup-sheet__music-copy">
                                            <strong>@item.Title</strong>
                                            <span>@PlayerSubtitle(item)</span>
                                        </span>
                                        <span class="listen-popup-sheet__duration">@item.Duration</span>
                                    </AppNativeButton>
                                }
                            }
                        </div>
                        break;
                    case "music-lyrics":
                        <div class="listen-popup-sheet__lyrics-actions">
                            @if (_lyricTracks.Count > 1)
                            {
                                <AppNativeSelect Value="@(_selectedLyricTrackId?.ToString("D") ?? string.Empty)" OnChange="SelectLyricVersionAsync" aria-label="Lyrics version">
                                    @foreach (var track in _lyricTracks)
                                    {
                                        <option value="@track.Id">@track.Provider · @track.Language · @track.TimingMode @(track.IsPreferred ? "· Preferred" : "")</option>
                                    }
                                </AppNativeSelect>
                            }
                            @if (_selectedLyricTrackId.HasValue)
                            {
                                <AppNativeButton Type="button" Class="listen-popup-sheet__lyrics-action" OnClick="SetPreferredLyricsAsync">Set preferred version</AppNativeButton>
                            }
                            <AppNativeButton Type="button" Class="listen-popup-sheet__lyrics-action" OnClick="RefreshLyricsAsync" Disabled="@_lyricsRefreshing">@(_lyricsRefreshing ? "Finding lyrics…" : "Find better lyrics")</AppNativeButton>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_lyricsStatus))
                        {
                            <p role="status" class="listen-popup-sheet__empty listen-popup-sheet__empty--compact">@_lyricsStatus</p>
                        }
                        @if (_lyricsLoading)
                        {
                            <div class="listen-popup-sheet__empty">Loading lyrics…</div>
                        }
                        else if (_lyricsLines.Count == 0)
                        {
                            <div class="listen-popup-sheet__empty">No lyrics are available for this track.</div>
                        }
                        else
                        {
                            <div class="listen-popup-sheet__lyrics">
                                @foreach (var line in _lyricsLines)
                                {
                                    @if (line.StartSeconds.HasValue)
                                    {
                                        <AppNativeButton Type="button" Class="@($"listen-popup-sheet__lyric-line {(line == ActiveLyricLine ? "is-active" : string.Empty)}")" OnClick="@(() => SeekAsync(line.StartSeconds.Value))" AriaLabel="@($"Jump to {line.Text}")">@line.Text</AppNativeButton>
                                    }
                                    else
                                    {
                                        <div class="listen-popup-sheet__lyric-line">@line.Text</div>
                                    }
                                }
                            </div>
                        }
                        break;
                    case "music-history":
                        <div class="listen-popup-sheet__music-list">
                            @if (MusicHistory.Count == 0)
                            {
                                <div class="listen-popup-sheet__empty">Played tracks will appear here for this session.</div>
                            }
                            else
                            {
                                @foreach (var item in MusicHistory)
                                {
                                    <AppNativeButton Type="button" Class="listen-popup-sheet__music-row" OnClick="@(() => PlayMusicHistoryItemAsync(item))">
                                        <span class="listen-popup-sheet__music-thumb">
                                            @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                                            {
                                                <img src="@(MediaTileArtworkUrl.Sized(item.CoverUrl, "s") ?? item.CoverUrl)"
                                                     srcset="@(MediaTileArtworkUrl.SrcSet(MediaTileArtworkUrl.Sized(item.CoverUrl, "s"), MediaTileArtworkUrl.Sized(item.CoverUrl, "m")))"
                                                     sizes="64px" alt="" data-image-display="playback-history-thumbnail" />
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Outlined.History" />
                                            }
                                        </span>
                                        <span class="listen-popup-sheet__music-copy">
                                            <strong>@item.Title</strong>
                                            <span>@PlayerSubtitle(item)</span>
                                        </span>
                                        <span class="listen-popup-sheet__duration">@item.Duration</span>
                                    </AppNativeButton>
                                }
                            }
                        </div>
                        break;
                }
            </PlaybackToolSheet>
        }

        @if (_bookmarkDialogContext is { } bookmarkContext && _bookmarkDialogActions is { } bookmarkActions)
        {
            <AudiobookBookmarkDialog Context="bookmarkContext"
                                     Actions="bookmarkActions"
                                     AuthorizedAssetIds="_bookmarkAuthorizedAssetIds"
                                     WorkTitle="@(CurrentItem?.Title ?? "Audiobook")"
                                     Surface="popup"
                                     Trigger="@_bookmarkTrigger"
                                     OnClose="DismissBookmarkDialogAsync" />
        }
        @if (!string.IsNullOrWhiteSpace(_bookmarkDialogError))
        {
            <div class="listen-popup__status" role="status">@_bookmarkDialogError</div>
        }
        else if (_bookmarkDialogOpening)
        {
            <div class="listen-popup__status" role="status">Opening saved bookmarks…</div>
        }
        @if (!string.IsNullOrWhiteSpace(_popupCommandError))
        {
            <div class="listen-popup__status" role="status">@_popupCommandError</div>
        }
    }
    @if (!string.IsNullOrWhiteSpace(_playbackStateError))
    {
        <div class="listen-popup__status" role="status">
            @_playbackStateError
            <AppNativeButton Type="button" Class="listen-popup__retry-state" OnClick="RetryPlaybackStateAsync" AriaLabel="Retry playback state sync">Retry</AppNativeButton>
        </div>
    }
</PlaybackPopoutShell>

@code {
    private readonly JsonSerializerOptions _jsonOptions = MediaEngineJson.Web;
    private ListenPlaybackSnapshot _snapshot = new();
    private DotNetObjectReference<ListenPlayerPopupPage>? _selfReference;
    private string? _activeSheet;
    private bool _rateMenuOpen;
    private string? _rateMenuSurface;
    private bool _sleepMenuOpen;
    private string? _sleepMenuSurface;
    private bool _scrollActiveChapterPending;
    private bool _showContextPanel = true;
    private string _contextPanelTab = "history";
    private readonly Guid _popupRecipientId = Guid.NewGuid();
    private AudiobookBookmarkActionContext? _bookmarkDialogContext;
    private ElementReference _bookmarkTrigger;
    private ListenPlaybackCommandActionsClient? _bookmarkDialogActions;
    private IReadOnlySet<Guid> _bookmarkAuthorizedAssetIds = new HashSet<Guid>();
    private bool _bookmarkDialogOpening;
    private string? _bookmarkDialogError;
    private string? _popupCommandError;
    private string? _playbackStateError;
    private long _playbackStateReceiveGeneration;
    private long _bookmarkOpenGeneration;
    private bool _disposed;

    [SupplyParameterFromQuery(Name = "owner")]
    public string? OwnerRecipientId { get; set; }
    private Guid? _lyricsAssetId;
    private Guid? _lyricsWorkId;
    private long _lyricsRequestVersion = -1;
    private List<LrcDisplayLine> _lyricsLines = [];
    private IReadOnlyList<TextTrackDto> _lyricTracks = [];
    private Guid? _selectedLyricTrackId;
    private bool _lyricsLoading;
    private bool _lyricsRefreshing;
    private string? _lyricsStatus;

    private ListenQueueItem? CurrentItem =>
        _snapshot.CurrentIndex >= 0 && _snapshot.CurrentIndex < _snapshot.Queue.Count
            ? _snapshot.Queue[_snapshot.CurrentIndex]
            : null;

    private IReadOnlyList<AudiobookListenHistoryItemDto> AudiobookHistory => PlaybackSessionController.ScopeAudiobookHistory(
        _snapshot.AudiobookHistory,
        CurrentItem,
        _snapshot.Queue);

    private bool IsVideoMode => string.Equals(_snapshot.Experience, PlayerExperienceModes.Video, StringComparison.OrdinalIgnoreCase);
    private bool IsAudiobookMode => string.Equals(_snapshot.Experience, PlayerExperienceModes.Audiobook, StringComparison.OrdinalIgnoreCase);
    private IReadOnlyList<ListenQueueItem> MusicHistory => _snapshot.History
        .Where(item => MediaKindClassifier.TryClassifyKnown(item.MediaType, out var experience)
            && experience == PlaybackExperience.Music)
        .ToArray();
    private bool ShowContextPanel => _showContextPanel && !IsVideoMode;
    private double ProgressMax => _snapshot.DurationSeconds > 0 ? _snapshot.DurationSeconds : TryParseDurationSeconds(CurrentItem?.Duration) ?? 1;
    private string ProgressValueText => $"{FormatTimestamp(_snapshot.CurrentTimeSeconds)} of {FormatTimestamp(ProgressMax)}";
    private static string FormatVolumeValue(double volume) => $"{Math.Clamp((int)Math.Round(volume * 100d), 0, 100)}%";
    private bool CanPlayNext =>
        _snapshot.CurrentIndex < _snapshot.Queue.Count - 1
        || _snapshot.Queue.Count > 1 && _snapshot.ShuffleEnabled
