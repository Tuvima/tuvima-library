@page "/listen/player-popup"
@layout MediaEngine.Web.Shared.PopupLayout
@using System.Text.Json
@using System.Threading
@using Microsoft.JSInterop
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Listen
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Domain.Enums
@using Microsoft.Extensions.DependencyInjection
@inject IJSRuntime JS
@inject IStringLocalizer<SharedStrings> L
@inject ILogger<ListenPlayerPopupPage> Logger
@inject ListenPlaybackClientSettings PlaybackClientSettings
@inject ActiveProfileSessionService ActiveProfiles
@inject IListenPlaybackCommandChannel BookmarkCommandChannel
@inject PlaybackLyricsPresenter LyricsPresenter
@inject IServiceProvider Services
@implements IAsyncDisposable

<PageTitle>@L["Listen_MiniPlayerTitle"]</PageTitle>

<div class="listen-popup" tabindex="-1">
    @if (IsVideoMode)
    {
        <div class="listen-popup__video-return">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.OndemandVideo" />
            <h1>Video is playing in the main window</h1>
            <p>Your video remains in its original player.</p>
            <AppNativeButton Type="button" OnClick="ReturnToVideoAsync" AriaLabel="Return to video player">Return to main window</AppNativeButton>
        </div>
    }
    else if (CurrentItem is null || _snapshot.IsDismissed)
    { <div class="listen-popup__empty"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.QueueMusic" /><p>@L["Listen_NothingPlaying"]</p></div> }
    else
    {
        <PlaybackFullPlayer @ref="_fullPlayer" Snapshot="@_snapshot" Commands="@PopupPanelCommands" IsPopup="true"
                            IsFavorite="@_isFavorite" FavoriteChanged="@(CanFavorite ? EventCallback.Factory.Create(this, ToggleFavoriteAsync) : default)"
                            BookmarkRequested="OpenBookmarkDialogAsync" SelectedPanelKey="@_fullPanelKey" PanelChanged="SelectFullPanelAsync"
                            NavigationCompleted="HandleNavigationCompletedAsync" ModeChanged="FullModeChangedAsync">
            <BookmarksContent>
                @if (_bookmarkDialogContext is { } inlineContext && _bookmarkDialogActions is { } inlineActions) {
                    <AudiobookBookmarkDialog Context="inlineContext" Actions="inlineActions" AuthorizedAssetIds="_bookmarkAuthorizedAssetIds"
                        WorkTitle="@(CurrentItem?.Title ?? "Audiobook")" Surface="popup" Embedded="true" Trigger="_bookmarkTrigger" OnClose="DismissEmbeddedBookmarksAsync" />
                } else { <p role="status">@(_bookmarkDialogError ?? "Loading saved bookmarks…")</p> }
            </BookmarksContent>
        </PlaybackFullPlayer>
    }
    @if (_bookmarkDialogContext is { } bookmarkContext && _bookmarkDialogActions is { } bookmarkActions && _fullPlayer?.ActiveMode != "bookmarks")
    {
        <AudiobookBookmarkDialog Context="bookmarkContext" Actions="bookmarkActions" AuthorizedAssetIds="_bookmarkAuthorizedAssetIds"
                                 WorkTitle="@(CurrentItem?.Title ?? "Audiobook")" Surface="popup" Trigger="@_bookmarkTrigger" OnClose="DismissBookmarkDialogAsync" />
    }
    @if (!string.IsNullOrWhiteSpace(_bookmarkDialogError)) { <div class="listen-popup__status" role="status">@_bookmarkDialogError</div> }
    else if (_bookmarkDialogOpening) { <div class="listen-popup__status" role="status">Opening saved bookmarks…</div> }
    @if (!string.IsNullOrWhiteSpace(_popupCommandError)) { <div class="listen-popup__status" role="status">@_popupCommandError</div> }
    @if (!string.IsNullOrWhiteSpace(_playbackStateError))
    {
        <div class="listen-popup__status" role="status">@_playbackStateError
            <AppNativeButton Type="button" Class="listen-popup__retry-state" OnClick="RetryPlaybackStateAsync" AriaLabel="Retry playback state sync">Retry</AppNativeButton>
        </div>
    }
</div>

@code {
    private readonly JsonSerializerOptions _jsonOptions = MediaEngineJson.Web;
    private ListenPlaybackSnapshot _snapshot = new();
    private DotNetObjectReference<ListenPlayerPopupPage>? _selfReference;
    private readonly Guid _popupRecipientId = Guid.NewGuid();
    private async Task FullModeChangedAsync(string? mode) { if (mode != "bookmarks" && _bookmarkDialogContext is not null) await CloseBookmarkDialogAsync(); }
    private async Task DismissEmbeddedBookmarksAsync() { await DismissBookmarkDialogAsync(); if (_fullPlayer is not null) await _fullPlayer.DismissToolsAsync(); }
    private PlaybackFullPlayer? _fullPlayer;
    private string? _fullPanelKey;
    private bool _isFavorite;
    private long _favoriteGeneration;
    private AudiobookBookmarkActionContext? _bookmarkDialogContext;
    private ElementReference _bookmarkTrigger;
    private ListenPlaybackCommandActionsClient? _bookmarkDialogActions;
    private IReadOnlySet<Guid> _bookmarkAuthorizedAssetIds = new HashSet<Guid>();
    private bool _bookmarkDialogOpening;
    private string? _bookmarkDialogError;
    private string? _popupCommandError;
    private string? _playbackStateError;
    private long _playbackStateReceiveGeneration;
    private long _bookmarkOpenGeneration;
    private bool _disposed;

    [SupplyParameterFromQuery(Name = "owner")] public string? OwnerRecipientId { get; set; }
    [SupplyParameterFromQuery(Name = "window")] public string? WindowRegistrationId { get; set; }
    private IPlaybackCommandSink PopupPanelCommands => new BroadcastPlaybackCommandSink(
        Guid.TryParse(OwnerRecipientId, out var owner) ? owner : Guid.Empty, _popupRecipientId, BookmarkCommandChannel);
    private ListenQueueItem? CurrentItem => _snapshot.CurrentIndex >= 0 && _snapshot.CurrentIndex < _snapshot.Queue.Count ? _snapshot.Queue[_snapshot.CurrentIndex] : null;
    private bool IsVideoMode => _snapshot.Experience == PlayerExperienceModes.Video;
    private bool IsAudiobookMode => _snapshot.Experience == PlayerExperienceModes.Audiobook;
    private bool CanFavorite => !IsAudiobookMode && !IsVideoMode && Services.GetService<MediaReactionService>() is not null;
    private Task SelectFullPanelAsync(string key) { _fullPanelKey = key; return Task.CompletedTask; }

    private async Task HandleNavigationCompletedAsync(string? error)
    {
        _popupCommandError = error;
        if (error is null)
        {
            try { await JS.InvokeVoidAsync("listenPlayback.focusMainWindow"); }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }
    }

    private async Task LoadFavoriteAsync()
    {
        var generation = ++_favoriteGeneration;
        var snapshot = _snapshot;
        var item = CurrentItem;
        _isFavorite = false;
        if (!CanFavorite || item is null || snapshot.ProfileId is not Guid profile || profile == Guid.Empty) return;
        MediaReaction reaction;
        try { reaction = await Services.GetRequiredService<MediaReactionService>().GetReactionAsync(item.WorkId, profile, ProfileEntityKind.Song); }
        catch (Exception exception) { Logger.LogDebug(exception, "Favorite state is unavailable in the popup."); return; }
        if (!_disposed && generation == _favoriteGeneration && SameFavoriteSubject(snapshot, item))
            _isFavorite = reaction is MediaReaction.Like or MediaReaction.Love;
    }

    private bool SameFavoriteSubject(ListenPlaybackSnapshot snapshot, ListenQueueItem item) => _snapshot.ProfileId == snapshot.ProfileId
        && _snapshot.PlaybackRequestVersion == snapshot.PlaybackRequestVersion && CurrentItem?.WorkId == item.WorkId
        && CurrentItem?.AssetId == item.AssetId && !IsAudiobookMode && !IsVideoMode;

    private async Task ToggleFavoriteAsync()
    {
        var snapshot = _snapshot;
        var item = CurrentItem;
        if (!CanFavorite || item is null || snapshot.ProfileId is not Guid profileId || profileId == Guid.Empty) return;
        try
        {
            var profile = await ActiveProfiles.GetActiveProfileAsync();
            if (_disposed || profile?.Id != profileId || !SameFavoriteSubject(snapshot, item)) return;
            await Services.GetRequiredService<MediaReactionService>().SetReactionAsync(item.WorkId,
                _isFavorite ? MediaReaction.Neutral : MediaReaction.Like, profileId, ProfileEntityKind.Song);
            if (!_disposed && SameFavoriteSubject(snapshot, item)) await LoadFavoriteAsync();
        }
        catch (Exception exception)
        {
            Logger.LogDebug(exception, "Favorite could not be updated in the popup.");
            if (!_disposed && SameFavoriteSubject(snapshot, item)) _popupCommandError = "Favorites could not be updated. Try again when the Engine reconnects.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return;

        _selfReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("listenPlayback.configure", PlaybackClientSettings);
        if (_disposed) return;
        await JS.InvokeVoidAsync("listenPlayback.registerStateHandler", _selfReference);
        if (_disposed) return;
        await JS.InvokeVoidAsync("listenPlayback.registerPopupWindow", OwnerRecipientId, _popupRecipientId.ToString("D"), WindowRegistrationId);
        if (_disposed) return;
        await JS.InvokeVoidAsync("listenPlayback.focusPopup");
        if (_disposed) return;

        try
        {
            await RestorePlaybackStateStreamAsync();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not restore listen popup playback state from browser storage.");
            _playbackStateError = "Playback state could not be loaded. Retry to reconnect.";
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task HandlePlaybackState(IJSStreamReference? reference) =>
        ReceivePlaybackStateAsync(reference, Interlocked.Increment(ref _playbackStateReceiveGeneration));

    private async Task ReceivePlaybackStateAsync(IJSStreamReference? reference, long receiveGeneration)
    {
        if (_disposed)
        {
            if (reference is not null) await DisposeUnusedPlaybackStreamAsync(reference);
            return;
        }
        ListenPlaybackSnapshot incoming;
        if (reference is null)
        {
            incoming = new ListenPlaybackSnapshot();
        }
        else
        {
            ListenPlaybackSnapshot? snapshot;
            try
            {
                snapshot = await PlaybackSnapshotStream.ReadAsync(reference, _jsonOptions);
            }
            catch (Exception ex)
            {
                if (_disposed || receiveGeneration != Volatile.Read(ref _playbackStateReceiveGeneration)) return;
                Logger.LogDebug(ex, "Could not read synchronized listen playback state in the popup.");
                _playbackStateError = "Playback state could not be read. Your current player state is still shown.";
                await InvokeAsync(StateHasChanged);
                return;
            }
            if (_disposed || receiveGeneration != Volatile.Read(ref _playbackStateReceiveGeneration)) return;
            if (snapshot is null)
            {
                incoming = new ListenPlaybackSnapshot();
            }
            else
            {
                incoming = snapshot;
            }
        }
        if (_disposed || receiveGeneration != Volatile.Read(ref _playbackStateReceiveGeneration)) return;
        _playbackStateError = null;
        var previousAssetId = CurrentItem?.AssetId;
        var previousWorkId = CurrentItem?.WorkId;
        var previousProfileId = _snapshot.ProfileId;
        var previousSessionLeaseId = _snapshot.AudiobookBookSessionLeaseId;
        var previousSessionGeneration = _snapshot.AudiobookBookSessionGeneration;
        var previousVersion = _snapshot.PlaybackRequestVersion;
        var wasVideo = IsVideoMode;
        var wasAudiobook = IsAudiobookMode;
        _snapshot = incoming;
        LyricsPresenter.Observe(_snapshot, PopupPanelCommands);

        var changedSubject = CurrentItem?.AssetId != previousAssetId
            || CurrentItem?.WorkId != previousWorkId
            || _snapshot.PlaybackRequestVersion != previousVersion
            || IsVideoMode != wasVideo || _snapshot.ProfileId != previousProfileId;
        var bookmarkSubjectChanged = wasAudiobook && (!IsAudiobookMode
            || CurrentItem?.WorkId != previousWorkId
            || _snapshot.AudiobookBookSessionLeaseId != previousSessionLeaseId
            || _snapshot.AudiobookBookSessionGeneration != previousSessionGeneration
            || _snapshot.ProfileId != previousProfileId);
        if (_bookmarkDialogContext is null && _bookmarkDialogOpening
            && (changedSubject || bookmarkSubjectChanged))
        {
            InvalidatePendingBookmarkOpen();
        }
        if (changedSubject)
        {
            if (bookmarkSubjectChanged) await CloseBookmarkDialogAsync();
            if (_fullPlayer is not null) await _fullPlayer.DismissToolsAsync();
            if (_snapshot.ProfileId != previousProfileId) _fullPanelKey = null;
            await LoadFavoriteAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task RetryPlaybackStateAsync()
    {
        await RestorePlaybackStateStreamAsync();
    }

    private async Task RestorePlaybackStateStreamAsync()
    {
        if (_disposed) return;
        var receiveGeneration = Interlocked.Increment(ref _playbackStateReceiveGeneration);
        try
        {
            var hasStoredState = await JS.InvokeAsync<bool>("listenPlayback.hasState");
            if (_disposed || receiveGeneration != Volatile.Read(ref _playbackStateReceiveGeneration)) return;
            if (!hasStoredState)
            {
                await ReceivePlaybackStateAsync(null, receiveGeneration);
                return;
            }

            var stream = await JS.InvokeAsync<IJSStreamReference>("listenPlayback.getStateStream");
            if (_disposed || receiveGeneration != Volatile.Read(ref _playbackStateReceiveGeneration))
            {
                await DisposeUnusedPlaybackStreamAsync(stream);
                return;
            }
            await ReceivePlaybackStateAsync(stream, receiveGeneration);
        }
        catch (Exception ex)
        {
            if (_disposed || receiveGeneration != Volatile.Read(ref _playbackStateReceiveGeneration)) return;
            Logger.LogDebug(ex, "Could not retry popup playback state synchronization.");
            _playbackStateError = "Playback state could not be loaded. Retry to reconnect.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private static async Task DisposeUnusedPlaybackStreamAsync(IJSStreamReference reference)
    {
        try { await reference.DisposeAsync(); }
        catch (Exception) { }
    }

    private Task ReturnToVideoAsync() => JS.InvokeVoidAsync("listenPlayback.returnToVideo").AsTask();

    private async Task OpenBookmarkDialogAsync(ElementReference trigger = default)
    {
        if (_fullPlayer is not null && _fullPlayer.ActiveMode != "bookmarks") await _fullPlayer.DismissToolsAsync();
        if (_disposed || _bookmarkDialogOpening || _bookmarkDialogContext is not null) return;
        _bookmarkDialogError = null;
        if (!IsAudiobookMode || CurrentItem is not { AssetId: { } assetId, WorkId: { } workId }
            || _snapshot.AudiobookBookSessionLeaseId is not { } sessionLeaseId
            || !Guid.TryParse(OwnerRecipientId, out var ownerRecipientId) || ownerRecipientId == Guid.Empty)
        {
            _bookmarkDialogError = "Bookmarks are unavailable for this playback session.";
            return;
        }

        _bookmarkDialogOpening = true;
        var openGeneration = ++_bookmarkOpenGeneration;
        var requestVersion = _snapshot.PlaybackRequestVersion;
        var sessionGeneration = _snapshot.AudiobookBookSessionGeneration;
        ListenPlaybackCommandActionsClient? actions = null;
        AudiobookBookmarkActionContext? context = null;
        try
        {
            var profile = await ActiveProfiles.GetActiveProfileAsync();
            if (!IsCurrentBookmarkOpen(openGeneration))
                throw new OperationCanceledException("The popup bookmark open was superseded.");
            if (profile is null || profile.Id == Guid.Empty)
                throw new InvalidOperationException("The active profile could not be confirmed.");

            context = new AudiobookBookmarkActionContext(Guid.NewGuid(), profile.Id, workId, sessionLeaseId,
                sessionGeneration, assetId);
            actions = new ListenPlaybackCommandActionsClient(ownerRecipientId, _popupRecipientId, BookmarkCommandChannel);
            await actions.OpenAsync(context);

            if (!IsCurrentBookmarkOpen(openGeneration))
                throw new OperationCanceledException("The popup bookmark open was superseded.");
            if (!IsSameBookmarkSubject(profile.Id, assetId, workId, sessionLeaseId, sessionGeneration, requestVersion))
                throw new InvalidOperationException("Playback changed before bookmarks could be opened.");

            var authorizedAssetIds = actions.GetAuthorizedAssetIds(context);
            if (!authorizedAssetIds.Contains(assetId))
                throw new InvalidOperationException("The playback owner did not confirm access to this audiobook.");

            var snapshot = await actions.GetSnapshotAsync(context);
            if (!IsCurrentBookmarkOpen(openGeneration))
                throw new OperationCanceledException("The popup bookmark open was superseded.");
            if (!IsSameBookmarkSubject(profile.Id, assetId, workId, sessionLeaseId, sessionGeneration, requestVersion))
                throw new InvalidOperationException("Playback changed before bookmarks could be opened.");
            if (snapshot.Draft is null)
                throw new InvalidOperationException(snapshot.Message ?? "The playback owner did not capture a bookmark position.");

            _bookmarkAuthorizedAssetIds = authorizedAssetIds;
            _bookmarkDialogActions = actions;
            _bookmarkDialogContext = context;
            _bookmarkTrigger = trigger;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "The popup could not open its owner-authorized audiobook bookmark dialog.");
            if (IsCurrentBookmarkOpen(openGeneration))
            {
                _bookmarkDialogError = exception is InvalidOperationException
                    ? exception.Message
                    : "Bookmarks could not be opened. Check that the main player is still connected.";
            }
            if (actions is not null && context is not null)
            {
                try { await actions.CloseAsync(context); }
                catch (Exception closeException) { Logger.LogDebug(closeException, "The stale popup bookmark lease could not be released after open failed."); }
            }
        }
        finally
        {
            if (IsCurrentBookmarkOpen(openGeneration)) _bookmarkDialogOpening = false;
        }
    }

    private bool IsCurrentBookmarkOpen(long generation) =>
        !_disposed && _bookmarkDialogOpening && _bookmarkOpenGeneration == generation;

    private void InvalidatePendingBookmarkOpen()
    {
        _bookmarkOpenGeneration++;
        _bookmarkDialogOpening = false;
        _bookmarkDialogError = null;
    }

    private bool IsSameBookmarkSubject(Guid profileId, Guid assetId, Guid workId, Guid sessionLeaseId,
        long sessionGeneration, long requestVersion) =>
        IsAudiobookMode && _snapshot.ProfileId == profileId && ActiveProfiles.CurrentProfile?.Id == profileId
        && CurrentItem?.AssetId == assetId && CurrentItem.WorkId == workId
        && _snapshot.AudiobookBookSessionLeaseId == sessionLeaseId
        && _snapshot.AudiobookBookSessionGeneration == sessionGeneration
        && _snapshot.PlaybackRequestVersion == requestVersion;

    private async Task CloseBookmarkDialogAsync()
    {
        var actions = _bookmarkDialogActions;
        var context = _bookmarkDialogContext;
        DismissBookmarkDialogPresentation();
        if (actions is null || context is null) return;
        try { await actions.CloseAsync(context); }
        catch (Exception exception) { Logger.LogDebug(exception, "The popup bookmark dialog lease was already released or the owner disconnected."); }
    }

    private Task DismissBookmarkDialogAsync()
    {
        DismissBookmarkDialogPresentation();
        return InvokeAsync(StateHasChanged);
    }

    private void DismissBookmarkDialogPresentation()
    {
        _bookmarkOpenGeneration++;
        _bookmarkDialogOpening = false;
        _bookmarkDialogError = null;
        _bookmarkDialogActions = null;
        _bookmarkDialogContext = null;
        _bookmarkAuthorizedAssetIds = new HashSet<Guid>();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Interlocked.Increment(ref _playbackStateReceiveGeneration);
        _bookmarkOpenGeneration++;
        await CloseBookmarkDialogAsync();
        try
        {
            await JS.InvokeVoidAsync("listenPlayback.unregisterStateHandler", _selfReference);
            await JS.InvokeVoidAsync("listenPlayback.unregisterPopupWindow");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogDebug(ex, "Failed to unregister listen popup JavaScript handlers.");
        }

        _selfReference?.Dispose();
    }

}
