    private static IEnumerable<LrcDisplayLine> ParseLyrics(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            yield break;
        }

        var pattern = new Regex(@"\[(?<min>\d{1,3}):(?<sec>\d{2})(?:[.:](?<frac>\d{1,3}))?\]");
        var lines = content.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n');
        var isTimed = lines.Any(pattern.IsMatch);
        foreach (var rawLine in lines)
        {
            if (!isTimed)
            {
                if (!string.IsNullOrWhiteSpace(rawLine))
                {
                    yield return new LrcDisplayLine(null, rawLine.Trim());
                }

                continue;
            }

            var matches = pattern.Matches(rawLine);
            if (matches.Count == 0)
            {
                continue;
            }

            var text = pattern.Replace(rawLine, string.Empty).Trim();
            if (string.IsNullOrWhiteSpace(text))
            {
                continue;
            }

            foreach (Match match in matches)
            {
                if (!int.TryParse(match.Groups["min"].Value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var minutes)
                    || !int.TryParse(match.Groups["sec"].Value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var seconds))
                {
                    continue;
                }

                var fraction = match.Groups["frac"].Success ? match.Groups["frac"].Value : "0";
                var fractionalSeconds = fraction.Length switch
                {
                    1 => int.Parse(fraction, CultureInfo.InvariantCulture) / 10d,
                    2 => int.Parse(fraction, CultureInfo.InvariantCulture) / 100d,
                    _ => int.Parse(fraction.PadRight(3, '0')[..3], CultureInfo.InvariantCulture) / 1000d,
                };
                yield return new LrcDisplayLine(minutes * 60d + seconds + fractionalSeconds, text);
            }
        }
    }

    private static string FormatTimestamp(double seconds)
    {
        var safe = Math.Max(0, seconds);
        var span = TimeSpan.FromSeconds(safe);
        return span.TotalHours >= 1
            ? span.ToString(@"h\:mm\:ss", CultureInfo.InvariantCulture)
            : span.ToString(@"m\:ss", CultureInfo.InvariantCulture);
    }

    private static double? TryParseDurationSeconds(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var parts = value.Split(':', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length is not (2 or 3))
        {
            return null;
        }

        var total = 0d;
        var multiplier = 1d;
        for (var index = parts.Length - 1; index >= 0; index--)
        {
            if (!double.TryParse(parts[index], NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed))
            {
                return null;
            }

            total += parsed * multiplier;
            multiplier *= 60d;
        }

        return total;
    }

    private static string FirstDistinctFrom(string? primary, params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)
            && !string.Equals(value, primary, StringComparison.OrdinalIgnoreCase)) ?? "Audiobook";

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("listenPlayback.unregisterStateHandler", _selfReference);
            await JS.InvokeVoidAsync("listenPlayback.unregisterPopupWindow");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogDebug(ex, "Failed to unregister listen popup JavaScript handlers.");
        }

        _selfReference?.Dispose();
    }

