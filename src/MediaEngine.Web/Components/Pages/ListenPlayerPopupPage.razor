@page "/listen/player-popup"
@layout MediaEngine.Web.Shared.PopupLayout
@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.JSInterop
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Listen
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Playback
@inject IJSRuntime JS
@inject IEngineApiClient Api
@inject IStringLocalizer<SharedStrings> L
@inject ILogger<ListenPlayerPopupPage> Logger
@inject ListenPlaybackClientSettings PlaybackClientSettings
@implements IAsyncDisposable

<PageTitle>@L["Listen_MiniPlayerTitle"]</PageTitle>

<PlaybackPopoutShell Experience="@CurrentExperience"
                     Class="@PopupClass"
                     Css="@BackdropStyle"
                     IsSheetOpen="@(_activeSheet is not null)"
                     OnKeyDown="HandlePopupKeyDown"
                     tabindex="-1">
    @if (CurrentItem is null)
    {
        <div class="listen-popup__empty">
            <MudIcon Icon="@Icons.Material.Outlined.QueueMusic" Class="tl-u-font-size-42px tl-u-opacity-0-34" />
            <p>@L["Listen_NothingPlaying"]</p>
        </div>
    }
    else
    {
        var current = CurrentItem;
        <div class="listen-popup__topbar">
            <AppNativeButton Type="button" Class="listen-popup__top-icon" OnClick="ClosePopupWindowAsync" AriaLabel="Collapse player" title="Collapse player">
                <MudIcon Icon="@Icons.Material.Outlined.KeyboardArrowDown" Class="tl-u-font-size-34px" />
            </AppNativeButton>
        </div>

        <main class="listen-popup__stage" aria-label="@PopoutAriaLabel">
            <div class="listen-popup__cover">
                @if (!string.IsNullOrWhiteSpace(current.CoverUrl))
                {
                    <img src="@current.CoverUrl" alt="@current.Title" />
                }
                else
                {
                    <MudIcon Icon="@(IsAudiobookMode ? Icons.Material.Outlined.Headphones : Icons.Material.Outlined.Album)" Class="tl-u-font-size-72px" />
                }
            </div>

            <section class="listen-popup__identity">
                <h1>@current.Title</h1>
                @if (!IsAudiobookMode)
                {
                    <p>@PlayerSubtitle(current)</p>
                }
            </section>

            <section class="listen-popup__timeline" aria-label="Playback progress">
                @if (IsAudiobookMode && !string.IsNullOrWhiteSpace(CurrentChapterProgressLabel))
                {
                    <PlaybackTimelineMetaRow Icon="@Icons.Material.Outlined.MenuBook"
                                             Label="@CurrentChapterProgressLabel"
                                             TrailingText="@ProgressPercentLabel"
                                             Size="large"
                                             Class="listen-popup__chapter-row" />
                }
                <PlaybackRangeSlider Min="0" Max="@ProgressMax" Step="1"
                                     Value="@Math.Min(_snapshot.CurrentTimeSeconds, ProgressMax)"
                                     ShowTicks="false" CommitOnChange="true"
                                     Class="listen-popup__progress-slider"
                                     AriaLabel="Playback position"
                                     ValueFormatter="@(_ => ProgressValueText)"
                                     ValueChanged="SeekAsync" />
                <div class="listen-popup__time-row">
                    <span>@FormatTimestamp(_snapshot.CurrentTimeSeconds)</span>
                    <span>@RemainingLabel</span>
                    <span>@FormatTimestamp(ProgressMax)</span>
                </div>
            </section>

            <ListenTransportControls Variant="popup"
                                     IsAudiobookMode="@IsAudiobookMode"
                                     IsPlaying="@_snapshot.IsPlaying"
                                     NeedsUserGestureToStart="@_snapshot.NeedsUserGestureToStart"
                                     IsMuted="@_snapshot.IsMuted"
                                     HasChapters="@HasChapters"
                                     CanPreviousTrack="@(_snapshot.CurrentIndex > 0)"
                                     CanNextTrack="@CanPlayNext"
                                     SkipBackSeconds="@_snapshot.SkipBackSeconds"
                                     SkipForwardSeconds="@_snapshot.SkipForwardSeconds"
                                     CurrentBrowserStreamUrl="@CurrentBrowserStreamUrl"
                                     CurrentTimeSeconds="@_snapshot.CurrentTimeSeconds"
                                     PlaybackRate="@_snapshot.PlaybackRate"
                                     Volume="@_snapshot.Volume"
                                     OnTogglePlay="TogglePlayAsync"
                                     OnPreviousTrack="PreviousAsync"
                                     OnNextTrack="NextAsync"
                                     OnPreviousChapter="PlayPreviousChapterAsync"
                                     OnNextChapter="PlayNextChapterAsync"
                                     OnSkipBack="SkipBackAsync"
                                     OnSkipForward="SkipForwardAsync" />

            @if (IsAudiobookMode)
            {
                <PlaybackControlStrip Controls="@AudiobookToolControls"
                                      Size="standard"
                                      Class="listen-popup__actions"
                                      AriaLabel="Audiobook tools"
                                      OnControl="HandleAudiobookToolControl" />
            }
            else
            {
                <PlaybackControlStrip Controls="@MusicToolControls"
                                      Size="standard"
                                      Class="listen-popup__actions listen-popup__music-actions"
                                      AriaLabel="Music tools"
                                      OnControl="HandleMusicToolControl" />
                <section class="listen-popup__volume-control" aria-label="Volume control">
                    <MudIcon Icon="@Icons.Material.Outlined.VolumeDown" Class="listen-popup__volume-glyph" />
                    <AppNativeInput Type="range" Min="0" Max="1" Step="@VolumeStep" Value="@_snapshot.Volume" Class="listen-popup__volume-slider" OnChange="SetVolumeAsync" AriaLabel="Volume" aria-valuetext="@VolumeValueText" />
                    <MudIcon Icon="@Icons.Material.Outlined.VolumeUp" Class="listen-popup__volume-glyph" />
                </section>
            }
        </main>

        @if (_activeSheet is not null)
        {
            <div class="listen-popup-sheet__backdrop" role="presentation" aria-hidden="true" @onclick="CloseSheet"></div>
            <PlaybackToolSheet Title="@SheetTitle"
                               Subtitle="@SheetSubtitle"
                               Icon="@SheetIcon"
                               Surface="popup"
                               Presentation="full-overlay"
                               Modal="true"
                               Class="listen-popup-sheet"
                               OnClose="CloseSheet">
                @switch (_activeSheet)
                {
                    case "speed":
                        <PlaybackSpeedControl Value="@_snapshot.PlaybackRate"
                                              ValueChanged="SetSpeedAsync"
                                              Class="listen-popup-sheet__speed-control" />
                        break;
                    case "chapters":
                        <PlaybackSheetList Class="listen-popup-sheet__list">
                            @if (CurrentChapters.Count == 0)
                            {
                                <div class="listen-popup-sheet__empty">No timed chapters were found for this audiobook.</div>
                            }
                            else
                            {
                                @for (var index = 0; index < CurrentChapters.Count; index++)
                                {
                                    var chapter = CurrentChapters[index];
                                    var isActive = IsCurrentChapter(chapter);
                                    <PlaybackSheetRow Variant="chapter" Class="listen-popup-sheet__row listen-popup-sheet__row--chapter" IsActive="@isActive" OnClick="@(() => PlayChapterAsync(chapter.Index))" AriaLabel="@($"Play {chapter.Title}")" data-playback-active-chapter="@(isActive ? "true" : null)">
                                        <span class="playback-sheet-row__copy listen-popup-sheet__copy">
                                            <strong>@chapter.Title</strong>
                                        </span>
                                        <span class="playback-sheet-row__duration listen-popup-sheet__duration">@ChapterDuration(chapter)</span>
                                    </PlaybackSheetRow>
                                }
                            }
                        </PlaybackSheetList>
                        break;
                    case "history":
                        <PlaybackSheetList Class="listen-popup-sheet__list">
                            @if (_snapshot.AudiobookHistory.Count == 0)
                            {
                                <div class="listen-popup-sheet__empty">Recent listening positions will appear here.</div>
                            }
                            else
                            {
                                <PlaybackPositionList Class="listen-popup-sheet__position-list">
                                    @foreach (var item in _snapshot.AudiobookHistory)
                                    {
                                        <PlaybackPositionRow Class="listen-popup-sheet__history-row"
                                                             Presentation="list"
                                                             Title="@HistoryTitle(item)"
                                                             PositionText="@HistoryPositionText(item)"
                                                             TimestampText="@HistorySubtitle(item)"
                                                             OnClick="@(() => PlayAudiobookHistoryAsync(item))"
                                                             AriaLabel="@($"Resume {HistoryTitle(item)} from {HistoryPositionText(item)}")" />
                                    }
                                </PlaybackPositionList>
                            }
                        </PlaybackSheetList>
                        break;
                    case "bookmarks":
                        <div class="listen-popup-sheet__toolbar">
                            <PlaybackPositionRow Class="listen-popup-sheet__bookmark-add"
                                                 Kind="add"
                                                 Size="compact"
                                                 Title="@($"Add bookmark at {FormatTimestamp(_snapshot.CurrentTimeSeconds)}")"
                                                 LeadingIcon="@Icons.Material.Outlined.BookmarkAdd"
                                                 ActionIcon="@Icons.Material.Outlined.ChevronRight"
                                                 ActionLabel=""
                                                 ActionVariant="plain"
                                                 OnClick="AddBookmarkAsync"
                                                 AriaLabel="Add bookmark at current position" />
                        </div>
                        <PlaybackSheetList Class="listen-popup-sheet__list">
                            @if (_snapshot.AudiobookBookmarks.Count == 0)
                            {
                                <div class="listen-popup-sheet__empty">No bookmarks yet.</div>
                            }
                            else
                            {
                                <PlaybackPositionList Class="listen-popup-sheet__position-list">
                                    @foreach (var bookmark in _snapshot.AudiobookBookmarks)
                                    {
                                        <PlaybackPositionRow Class="listen-popup-sheet__bookmark-row"
                                                             Presentation="list"
                                                             Title="@BookmarkTitle(bookmark)"
                                                             PositionText="@BookmarkPositionText(bookmark)"
                                                             TimestampText="@BookmarkSubtitle(bookmark)"
                                                             LeadingIcon="@Icons.Material.Outlined.BookmarkBorder"
                                                             ActionLabel="Go to"
                                                             OnClick="@(() => PlayBookmarkAsync(bookmark))"
                                                             AriaLabel="@($"Go to bookmark {BookmarkTitle(bookmark)} at {BookmarkPositionText(bookmark)}")" />
                                    }
                                </PlaybackPositionList>
                            }
                        </PlaybackSheetList>
                        break;
                    case "sleep":
                        <PlaybackSleepTimerControl OptionsMinutes="@_snapshot.SleepTimerOptionsMinutes"
                                                   Mode="@_snapshot.SleepTimerMode"
                                                   TimerMode="@ListenSleepTimerModes.Timer"
                                                   OffMode="@ListenSleepTimerModes.Off"
                                                   EndOfSectionMode="@ListenSleepTimerModes.EndOfChapter"
                                                   EndsAtUtc="@_snapshot.SleepTimerEndsAtUtc"
                                                   AllowEndOfSection="@_snapshot.AllowEndOfChapterSleepTimer"
                                                   TimerMinutesChanged="SetTimerMinutesAsync"
                                                   EndOfSectionChanged="SetTimerEndOfChapterAsync"
                                                   Class="listen-popup-sheet__sleep-control" />
                        break;
                    case "music-queue":
                        <div class="listen-popup-sheet__music-list">
                            @if (_snapshot.CurrentIndex >= _snapshot.Queue.Count - 1)
                            {
                                <div class="listen-popup-sheet__empty">The queue ends with the current track.</div>
                            }
                            else
                            {
                                @for (var index = _snapshot.CurrentIndex + 1; index < _snapshot.Queue.Count; index++)
                                {
                                    var queueIndex = index;
                                    var item = _snapshot.Queue[index];
                                    <AppNativeButton Type="button" Class="listen-popup-sheet__music-row" OnClick="@(() => PlayQueueIndexAsync(queueIndex))">
                                        <span class="listen-popup-sheet__music-thumb">
                                            @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                                            {
                                                <img src="@item.CoverUrl" alt="" />
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Outlined.MusicNote" />
                                            }
                                        </span>
                                        <span class="listen-popup-sheet__music-copy">
                                            <strong>@item.Title</strong>
                                            <span>@PlayerSubtitle(item)</span>
                                        </span>
                                        <span class="listen-popup-sheet__duration">@item.Duration</span>
                                    </AppNativeButton>
                                }
                            }
                        </div>
                        break;
                    case "music-lyrics":
                        <div class="listen-popup-sheet__lyrics-actions">
                            @if (_lyricTracks.Count > 1)
                            {
                                <AppNativeSelect Value="@(_selectedLyricTrackId?.ToString("D") ?? string.Empty)" OnChange="SelectLyricVersionAsync" aria-label="Lyrics version">
                                    @foreach (var track in _lyricTracks)
                                    {
                                        <option value="@track.Id">@track.Provider · @track.Language · @track.TimingMode @(track.IsPreferred ? "· Preferred" : "")</option>
                                    }
                                </AppNativeSelect>
                            }
                            @if (_selectedLyricTrackId.HasValue)
                            {
                                <AppNativeButton Type="button" Class="listen-popup-sheet__lyrics-action" OnClick="SetPreferredLyricsAsync">Set preferred version</AppNativeButton>
                            }
                            <AppNativeButton Type="button" Class="listen-popup-sheet__lyrics-action" OnClick="RefreshLyricsAsync" Disabled="@_lyricsRefreshing">@(_lyricsRefreshing ? "Finding lyrics…" : "Find better lyrics")</AppNativeButton>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_lyricsStatus))
                        {
                            <p role="status" class="listen-popup-sheet__empty listen-popup-sheet__empty--compact">@_lyricsStatus</p>
                        }
                        @if (_lyricsLoading)
                        {
                            <div class="listen-popup-sheet__empty">Loading lyrics…</div>
                        }
                        else if (_lyricsLines.Count == 0)
                        {
                            <div class="listen-popup-sheet__empty">No lyrics are available for this track.</div>
                        }
                        else
                        {
                            <div class="listen-popup-sheet__lyrics">
                                @foreach (var line in _lyricsLines)
                                {
                                    @if (line.StartSeconds.HasValue)
                                    {
                                        <AppNativeButton Type="button" Class="@($"listen-popup-sheet__lyric-line {(line == ActiveLyricLine ? "is-active" : string.Empty)}")" OnClick="@(() => SeekAsync(line.StartSeconds.Value))" AriaLabel="@($"Jump to {line.Text}")">@line.Text</AppNativeButton>
                                    }
                                    else
                                    {
                                        <div class="listen-popup-sheet__lyric-line">@line.Text</div>
                                    }
                                }
                            </div>
                        }
                        break;
                    case "music-history":
                        <div class="listen-popup-sheet__music-list">
                            @if (_snapshot.History.Count == 0)
                            {
                                <div class="listen-popup-sheet__empty">Played tracks will appear here for this session.</div>
                            }
                            else
                            {
                                @foreach (var item in _snapshot.History)
                                {
                                    <AppNativeButton Type="button" Class="listen-popup-sheet__music-row" OnClick="@(() => PlayMusicHistoryItemAsync(item))">
                                        <span class="listen-popup-sheet__music-thumb">
                                            @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                                            {
                                                <img src="@item.CoverUrl" alt="" />
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Outlined.History" />
                                            }
                                        </span>
                                        <span class="listen-popup-sheet__music-copy">
                                            <strong>@item.Title</strong>
                                            <span>@PlayerSubtitle(item)</span>
                                        </span>
                                        <span class="listen-popup-sheet__duration">@item.Duration</span>
                                    </AppNativeButton>
                                }
                            }
                        </div>
                        break;
                }
            </PlaybackToolSheet>
        }

    }
</PlaybackPopoutShell>

@code {
    private readonly JsonSerializerOptions _jsonOptions = MediaEngineJson.Web;
    private ListenPlaybackSnapshot _snapshot = new();
    private DotNetObjectReference<ListenPlayerPopupPage>? _selfReference;
    private string? _activeSheet;
    private bool _scrollActiveChapterPending;
    private Guid? _lyricsAssetId;
    private List<LrcDisplayLine> _lyricsLines = [];
    private IReadOnlyList<TextTrackDto> _lyricTracks = [];
    private Guid? _selectedLyricTrackId;
    private bool _lyricsLoading;
    private bool _lyricsRefreshing;
    private string? _lyricsStatus;

    private ListenQueueItem? CurrentItem =>
        _snapshot.CurrentIndex >= 0 && _snapshot.CurrentIndex < _snapshot.Queue.Count
            ? _snapshot.Queue[_snapshot.CurrentIndex]
            : null;

    private bool IsAudiobookMode => string.Equals(_snapshot.Experience, PlayerExperienceModes.Audiobook, StringComparison.OrdinalIgnoreCase);
    private double ProgressMax => _snapshot.DurationSeconds > 0 ? _snapshot.DurationSeconds : TryParseDurationSeconds(CurrentItem?.Duration) ?? 1;
    private string VolumeStep => PlaybackClientSettings.VolumeStep.ToString("0.###", CultureInfo.InvariantCulture);
    private string ProgressValueText => $"{FormatTimestamp(_snapshot.CurrentTimeSeconds)} of {FormatTimestamp(ProgressMax)}";
    private string VolumeValueText => $"{Math.Clamp((int)Math.Round(_snapshot.Volume * 100d), 0, 100)}%";
    private bool CanPlayNext =>
        _snapshot.CurrentIndex < _snapshot.Queue.Count - 1
        || _snapshot.Queue.Count > 1 && _snapshot.ShuffleEnabled
        || _snapshot.Queue.Count > 0 && _snapshot.RepeatMode == PlayerRepeatModes.All;
    private IReadOnlyList<PlaybackChapterDto> CurrentChapters =>
        CurrentItem is { Chapters.Count: > 1 } item ? item.Chapters : [];
    private bool HasChapters => CurrentChapters.Count > 0;
    private string? CurrentBrowserStreamUrl =>
        !string.IsNullOrWhiteSpace(_snapshot.CurrentBrowserStreamUrl)
            ? _snapshot.CurrentBrowserStreamUrl
            : CurrentItem?.StreamUrl;
    private PlaybackExperience CurrentExperience => IsAudiobookMode ? PlaybackExperience.Audiobook : PlaybackExperience.Music;
    private string PopoutAriaLabel => IsAudiobookMode ? "Audiobook player" : "Music player";
    private string PopupClass => IsAudiobookMode ? "listen-popup listen-popup--audiobook" : "listen-popup listen-popup--music";
    private string BackdropStyle => string.IsNullOrWhiteSpace(CurrentItem?.CoverUrl)
        ? string.Empty
        : $"--listen-popup-cover:url('{CurrentItem.CoverUrl.Replace("'", "%27", StringComparison.Ordinal)}');";
    private string RemainingLabel => $"{FormatTimestamp(Math.Max(0, ProgressMax - _snapshot.CurrentTimeSeconds))} left";
    private PlaybackChapterDto? ActiveChapter =>
        CurrentChapters.LastOrDefault(chapter =>
            chapter.StartSeconds <= _snapshot.CurrentTimeSeconds
            && (!chapter.EndSeconds.HasValue || _snapshot.CurrentTimeSeconds < chapter.EndSeconds.Value));
    private string CurrentChapterProgressLabel =>
        ActiveChapter is { } chapter
                ? $"{chapter.Title} of {CurrentChapters.Count}"
                : string.Empty;
    private string ProgressPercentLabel =>
        $"{Math.Clamp((int)Math.Round(_snapshot.CurrentTimeSeconds / ProgressMax * 100d, MidpointRounding.AwayFromZero), 0, 100)}%";
    private LrcDisplayLine? ActiveLyricLine =>
        _lyricsLines.LastOrDefault(line => line.StartSeconds.HasValue && line.StartSeconds.Value <= _snapshot.CurrentTimeSeconds + 0.25d);
    private string SheetTitle => _activeSheet switch
    {
        "speed" => "Speed",
        "chapters" => "Chapters",
        "history" => "History",
        "bookmarks" => "Bookmarks",
        "sleep" => "Sleep Timer",
        "music-queue" => "Playing Next",
        "music-lyrics" => "Lyrics",
        "music-history" => "History",
        _ => string.Empty,
    };
    private string SheetSubtitle => _activeSheet switch
    {
        "speed" => "Adjust playback speed",
        "chapters" => ActiveChapter is { } chapter ? $"Current chapter · {chapter.Title}" : "Choose a chapter",
        "history" => "Recent listening positions",
        "bookmarks" => "Saved audiobook positions",
        "sleep" => "Stop playback automatically",
        "music-queue" => "Your current music queue",
        "music-lyrics" => CurrentItem?.Title ?? string.Empty,
        "music-history" => "Played during this session",
        _ => string.Empty,
    };
    private string SheetIcon => _activeSheet switch
    {
        "speed" => Icons.Material.Outlined.Speed,
        "chapters" => Icons.Material.Outlined.FormatListBulleted,
        "history" or "music-history" => Icons.Material.Outlined.History,
        "bookmarks" => Icons.Material.Outlined.BookmarkBorder,
        "sleep" => Icons.Material.Outlined.Bedtime,
        "music-queue" => Icons.Material.Outlined.QueueMusic,
        "music-lyrics" => Icons.Material.Outlined.Lyrics,
        _ => Icons.Material.Outlined.Tune,
    };
    private IReadOnlyList<PlaybackControlDefinition> AudiobookToolControls =>
        PlaybackControlCatalog.BuildToolStrip(
            PlaybackExperience.Audiobook,
            PlaybackControlSurface.Popup,
            new PlaybackControlState(
                ActiveSheet: _activeSheet,
                PlaybackRate: _snapshot.PlaybackRate,
                HasChapters: HasChapters,
                IsSleepTimerActive: _snapshot.SleepTimerMode != ListenSleepTimerModes.Off,
                HistoryCount: _snapshot.AudiobookHistory.Count,
                BookmarkCount: _snapshot.AudiobookBookmarks.Count));
    private IReadOnlyList<PlaybackControlDefinition> MusicToolControls =>
        PlaybackControlCatalog.BuildToolStrip(
            PlaybackExperience.Music,
            PlaybackControlSurface.Popup,
            new PlaybackControlState(
                ActiveSheet: _activeSheet switch
                {
                    "music-queue" => "queue",
                    "music-lyrics" => "lyrics",
                    "music-history" => "history",
                    _ => null,
                },
                HasQueue: _snapshot.Queue.Count > 0,
                HasLyrics: _lyricsLines.Count > 0,
                CanFindLyrics: CurrentItem?.AssetId is not null,
                IsShuffleEnabled: _snapshot.ShuffleEnabled,
                IsRepeatEnabled: _snapshot.RepeatMode != PlayerRepeatModes.Off));
    private string RepeatLabel => _snapshot.RepeatMode switch
    {
        PlayerRepeatModes.One => "Repeat one",
        PlayerRepeatModes.All => "Repeat queue",
        _ => "Repeat off",
    };
    private string RepeatShortLabel => _snapshot.RepeatMode switch
    {
        PlayerRepeatModes.One => "Repeat 1",
        PlayerRepeatModes.All => "Repeat all",
        _ => "Repeat",
    };
    private static string MusicActionClass(bool active) =>
        $"listen-popup__sheet-action {(active ? "is-active" : string.Empty)}".Trim();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (_scrollActiveChapterPending)
            {
                _scrollActiveChapterPending = false;
                await JS.InvokeVoidAsync("playbackTools.scrollActiveChapter");
            }
            return;
        }

        _selfReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("listenPlayback.configure", PlaybackClientSettings);
        await JS.InvokeVoidAsync("listenPlayback.registerStateHandler", _selfReference);
        await JS.InvokeVoidAsync("listenPlayback.registerPopupWindow");
        await JS.InvokeVoidAsync("listenPlayback.focusPopup");

        try
        {
            var json = await JS.InvokeAsync<string?>("listenPlayback.getState");
            if (!string.IsNullOrWhiteSpace(json))
            {
                var snapshot = JsonSerializer.Deserialize<ListenPlaybackSnapshot>(json, _jsonOptions);
                if (snapshot is not null)
                {
                    _snapshot = snapshot;
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not restore listen popup playback state from browser storage.");
        }
    }

    [JSInvokable]
    public async Task HandlePlaybackState(string json)
    {
        var previousAssetId = CurrentItem?.AssetId;
        try
        {
            _snapshot = string.IsNullOrWhiteSpace(json)
                ? new ListenPlaybackSnapshot()
                : JsonSerializer.Deserialize<ListenPlaybackSnapshot>(json, _jsonOptions) ?? new ListenPlaybackSnapshot();
        }
        catch (JsonException ex)
        {
            Logger.LogDebug(ex, "Could not read a synchronized listen playback state in the popup.");
            return;
        }

        if (CurrentItem?.AssetId != previousAssetId)
        {
            _lyricsAssetId = null;
            _lyricsLines = [];
            _lyricTracks = [];
            _selectedLyricTrackId = null;
            _lyricsStatus = null;
            _lyricsLoading = false;
            await EnsureLyricsLoadedAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private void HandleAudiobookToolControl(PlaybackControlDefinition control)
    {
        if (control.IsDisabled || string.IsNullOrWhiteSpace(control.Sheet))
        {
            return;
        }

        ToggleSheet(control.Sheet);
    }

    private async Task HandleMusicToolControl(PlaybackControlDefinition control)
    {
        if (control.IsDisabled)
        {
            return;
        }

        switch (control.Key)
        {
            case PlaybackControlKey.Queue:
                ToggleSheet("music-queue");
                break;
            case PlaybackControlKey.Lyrics:
                ToggleSheet("music-lyrics");
                await EnsureLyricsLoadedAsync();
                break;
            case PlaybackControlKey.History:
                ToggleSheet("music-history");
                break;
            case PlaybackControlKey.Shuffle:
                await ToggleShuffleAsync();
                break;
            case PlaybackControlKey.Repeat:
                await CycleRepeatAsync();
                break;
        }
    }

    private void ToggleSheet(string sheet)
    {
        _activeSheet = _activeSheet == sheet ? null : sheet;
        _scrollActiveChapterPending = string.Equals(_activeSheet, "chapters", StringComparison.Ordinal);
    }

    private async Task EnsureLyricsLoadedAsync()
    {
        var assetId = CurrentItem?.AssetId;
        if (_activeSheet != "music-lyrics" || assetId is null || assetId == _lyricsAssetId) return;
        _lyricsAssetId = assetId;
        _lyricsLoading = true;
        _lyricsLines = [];
        _lyricTracks = [];
        _selectedLyricTrackId = null;
        _lyricsStatus = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var tracks = await Api.GetTextTracksAsync(assetId.Value);
            var content = await Api.GetLyricsAsync(assetId.Value);
            if (CurrentItem?.AssetId == assetId)
            {
                _lyricTracks = tracks.Where(track => track.Kind.Equals("Lyrics", StringComparison.OrdinalIgnoreCase)).ToList();
                _selectedLyricTrackId = _lyricTracks.FirstOrDefault(track => track.IsPreferred)?.Id
                    ?? _lyricTracks.FirstOrDefault()?.Id;
                _lyricsLines = ParseLyrics(content).ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not load lyrics in listen popup.");
            if (CurrentItem?.AssetId == assetId)
            {
                _lyricsStatus = "Lyrics could not be loaded.";
            }
        }
        finally
        {
            if (CurrentItem?.AssetId == assetId)
            {
                _lyricsLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task SelectLyricVersionAsync(ChangeEventArgs args)
    {
        if (CurrentItem?.AssetId is not Guid assetId || !Guid.TryParse(args.Value?.ToString(), out var trackId))
        {
            return;
        }

        try
        {
            var content = await Api.GetTextTrackContentAsync(assetId, trackId);
            if (CurrentItem?.AssetId != assetId)
            {
                return;
            }

            if (content is null)
            {
                _lyricsStatus = "That lyrics version is unavailable.";
                return;
            }

            _selectedLyricTrackId = trackId;
            _lyricsLines = ParseLyrics(content).ToList();
            _lyricsStatus = null;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not select a lyrics version in listen popup.");
            _lyricsStatus = "That lyrics version is unavailable.";
        }
    }

    private async Task SetPreferredLyricsAsync()
    {
        if (CurrentItem?.AssetId is not Guid assetId || _selectedLyricTrackId is not Guid trackId)
        {
            return;
        }

        try
        {
            if (await Api.SetPreferredTextTrackAsync(assetId, trackId))
            {
                _lyricTracks = (await Api.GetTextTracksAsync(assetId))
                    .Where(track => track.Kind.Equals("Lyrics", StringComparison.OrdinalIgnoreCase)).ToList();
                _lyricsStatus = "Preferred lyrics saved.";
            }
            else
            {
                _lyricsStatus = "Could not save preferred lyrics.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not save the preferred lyrics version in listen popup.");
            _lyricsStatus = "Could not save preferred lyrics.";
        }
    }

    private async Task RefreshLyricsAsync()
    {
        if (_lyricsRefreshing || CurrentItem?.AssetId is not Guid assetId)
        {
            return;
        }

        _lyricsRefreshing = true;
        _lyricsStatus = null;
        try
        {
            var result = await Api.RefreshTextTracksAsync(assetId, "lyrics");
            if (CurrentItem?.AssetId != assetId)
            {
                return;
            }

            var outcome = result?.message ?? "Lyrics search could not start.";
            _lyricsAssetId = null;
            await EnsureLyricsLoadedAsync();
            _lyricsStatus = outcome;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not find better lyrics in listen popup.");
            if (CurrentItem?.AssetId == assetId)
            {
                _lyricsStatus = "Lyrics search could not start.";
            }
        }
        finally
        {
            if (CurrentItem?.AssetId == assetId)
            {
                _lyricsRefreshing = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void CloseSheet() => _activeSheet = null;

    private Task HandlePopupKeyDown(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            return Task.CompletedTask;
        }

        if (_activeSheet is not null)
        {
            CloseSheet();
            return Task.CompletedTask;
        }

        return Task.CompletedTask;
    }
