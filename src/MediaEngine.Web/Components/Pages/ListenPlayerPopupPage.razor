    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (_scrollActiveChapterPending)
            {
                _scrollActiveChapterPending = false;
                await JS.InvokeVoidAsync("playbackTools.scrollActiveChapter");
            }
            return;
        }

        _selfReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("listenPlayback.configure", PlaybackClientSettings);
        await JS.InvokeVoidAsync("listenPlayback.registerStateHandler", _selfReference);
        await JS.InvokeVoidAsync("listenPlayback.registerPopupWindow");
        await JS.InvokeVoidAsync("listenPlayback.focusPopup");

        try
        {
            await RestorePlaybackStateStreamAsync();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not restore listen popup playback state from browser storage.");
            _playbackStateError = "Playback state could not be loaded. Retry to reconnect.";
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task HandlePlaybackState(IJSStreamReference? reference) =>
        ReceivePlaybackStateAsync(reference, Interlocked.Increment(ref _playbackStateReceiveGeneration));

    private async Task ReceivePlaybackStateAsync(IJSStreamReference? reference, long receiveGeneration)
    {
        if (_disposed)
        {
            if (reference is not null) await DisposeUnusedPlaybackStreamAsync(reference);
            return;
        }
        ListenPlaybackSnapshot incoming;
        if (reference is null)
        {
            incoming = new ListenPlaybackSnapshot();
        }
        else
        {
            ListenPlaybackSnapshot? snapshot;
            try
            {
                snapshot = await PlaybackSnapshotStream.ReadAsync(reference, _jsonOptions);
            }
            catch (Exception ex)
            {
                if (_disposed || receiveGeneration != Volatile.Read(ref _playbackStateReceiveGeneration)) return;
                Logger.LogDebug(ex, "Could not read synchronized listen playback state in the popup.");
                _playbackStateError = "Playback state could not be read. Your current player state is still shown.";
                await InvokeAsync(StateHasChanged);
                return;
            }
            if (_disposed || receiveGeneration != Volatile.Read(ref _playbackStateReceiveGeneration)) return;
            if (snapshot is null)
            {
                incoming = new ListenPlaybackSnapshot();
            }
            else
            {
                incoming = snapshot;
            }
        }
        if (_disposed || receiveGeneration != Volatile.Read(ref _playbackStateReceiveGeneration)) return;
        _playbackStateError = null;
        var previousAssetId = CurrentItem?.AssetId;
        var previousWorkId = CurrentItem?.WorkId;
        var previousProfileId = ActiveProfiles.CurrentProfile?.Id;
        var previousSessionLeaseId = _snapshot.AudiobookBookSessionLeaseId;
        var previousSessionGeneration = _snapshot.AudiobookBookSessionGeneration;
        var previousVersion = _snapshot.PlaybackRequestVersion;
        var wasVideo = IsVideoMode;
        var wasAudiobook = IsAudiobookMode;
        _snapshot = incoming;

        var changedSubject = CurrentItem?.AssetId != previousAssetId
            || CurrentItem?.WorkId != previousWorkId
            || _snapshot.PlaybackRequestVersion != previousVersion
            || IsVideoMode != wasVideo;
        var bookmarkSubjectChanged = wasAudiobook && (!IsAudiobookMode
            || CurrentItem?.WorkId != previousWorkId
            || _snapshot.AudiobookBookSessionLeaseId != previousSessionLeaseId
            || _snapshot.AudiobookBookSessionGeneration != previousSessionGeneration
            || ActiveProfiles.CurrentProfile?.Id != previousProfileId);
        if (_bookmarkDialogContext is null && _bookmarkDialogOpening
            && (changedSubject || bookmarkSubjectChanged))
        {
            InvalidatePendingBookmarkOpen();
        }
        if (changedSubject)
        {
            if (bookmarkSubjectChanged) await CloseBookmarkDialogAsync();
            CloseRateMenu();
            CloseSleepMenu();
            _activeSheet = null;
            _showContextPanel = !IsVideoMode;
            if (!IsAudiobookMode) _contextPanelTab = "history";
            _lyricsAssetId = null;
            _lyricsWorkId = CurrentItem?.WorkId;
            _lyricsRequestVersion = _snapshot.PlaybackRequestVersion;
            _lyricsLines = [];
            _lyricTracks = [];
            _selectedLyricTrackId = null;
            _lyricsStatus = null;
            _lyricsLoading = false;
            if (!IsVideoMode && _activeSheet == "music-lyrics") await EnsureLyricsLoadedAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task RetryPlaybackStateAsync()
    {
        await RestorePlaybackStateStreamAsync();
    }

    private async Task RestorePlaybackStateStreamAsync()
    {
        if (_disposed) return;
        var receiveGeneration = Interlocked.Increment(ref _playbackStateReceiveGeneration);
        try
        {
            var hasStoredState = await JS.InvokeAsync<bool>("listenPlayback.hasState");
            if (_disposed || receiveGeneration != Volatile.Read(ref _playbackStateReceiveGeneration)) return;
            if (!hasStoredState)
            {
                await ReceivePlaybackStateAsync(null, receiveGeneration);
                return;
            }

            var stream = await JS.InvokeAsync<IJSStreamReference>("listenPlayback.getStateStream");
            if (_disposed || receiveGeneration != Volatile.Read(ref _playbackStateReceiveGeneration))
            {
                await DisposeUnusedPlaybackStreamAsync(stream);
                return;
            }
            await ReceivePlaybackStateAsync(stream, receiveGeneration);
        }
        catch (Exception ex)
        {
            if (_disposed || receiveGeneration != Volatile.Read(ref _playbackStateReceiveGeneration)) return;
            Logger.LogDebug(ex, "Could not retry popup playback state synchronization.");
            _playbackStateError = "Playback state could not be loaded. Retry to reconnect.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private static async Task DisposeUnusedPlaybackStreamAsync(IJSStreamReference reference)
    {
        try { await reference.DisposeAsync(); }
        catch (Exception) { }
    }

    private async Task HandleAudiobookToolActivationAsync(PlaybackControlActivation activation)
    {
        if (activation.Control.Sheet == "bookmarks")
        {
            await OpenBookmarkDialogAsync(activation.Trigger);
            return;
        }
        await HandleAudiobookToolControl(activation.Control);
    }

    private async Task HandleAudiobookToolControl(PlaybackControlDefinition control)
    {
        if (control.IsDisabled || string.IsNullOrWhiteSpace(control.Sheet))
        {
            return;
        }

        CloseRateMenu();

        if (control.Sheet == "bookmarks")
        {
            await OpenBookmarkDialogAsync();
            return;
        }

        if (control.Sheet == "history")
        {
            SetContextPanelTab(control.Sheet);
            return;
        }
        ToggleSheet(control.Sheet);
    }

    private async Task HandleMusicToolControl(PlaybackControlDefinition control)
    {
        if (control.IsDisabled)
        {
            return;
        }

        CloseRateMenu();

        switch (control.Key)
        {
            case PlaybackControlKey.Queue:
                ToggleSheet("music-queue");
                break;
            case PlaybackControlKey.Lyrics:
                ToggleSheet("music-lyrics");
                await EnsureLyricsLoadedAsync();
                break;
            case PlaybackControlKey.History:
                SetContextPanelTab("history");
                break;
            case PlaybackControlKey.Shuffle:
                await ToggleShuffleAsync();
                break;
            case PlaybackControlKey.Repeat:
                await CycleRepeatAsync();
                break;
        }
    }

