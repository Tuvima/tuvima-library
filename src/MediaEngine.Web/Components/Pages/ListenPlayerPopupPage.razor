    private async Task ToggleShuffleAsync()
    {
        _snapshot = _snapshot with { ShuffleEnabled = !_snapshot.ShuffleEnabled };
        await SendCommandAsync(new ListenPlaybackCommandDto { Action = "toggle-shuffle" });
    }

    private async Task CycleRepeatAsync()
    {
        _snapshot = _snapshot with
        {
            RepeatMode = _snapshot.RepeatMode switch
            {
                PlayerRepeatModes.Off => PlayerRepeatModes.All,
                PlayerRepeatModes.All => PlayerRepeatModes.One,
                _ => PlayerRepeatModes.Off,
            },
        };
        await SendCommandAsync(new ListenPlaybackCommandDto { Action = "cycle-repeat" });
    }

    private async Task PlayQueueIndexAsync(int index)
    {
        await SendCommandAsync(new ListenPlaybackCommandDto { Action = "play-index", Index = index });
        CloseSheet();
    }

    private async Task PlayMusicHistoryItemAsync(ListenQueueItem item)
    {
        await SendCommandAsync(new ListenPlaybackCommandDto
        {
            Action = "play-history",
            WorkId = item.WorkId,
            ExpectedAssetId = item.AssetId,
            QueueItem = ToPlayerQueueItem(item),
        });
        CloseSheet();
    }

    private static PlayerQueueItemDto ToPlayerQueueItem(ListenQueueItem item) => new()
    {
        WorkId = item.WorkId,
        AssetId = item.AssetId,
        CollectionId = item.CollectionId,
        MediaType = item.MediaType,
        Title = item.Title,
        Subtitle = item.Subtitle,
        Album = item.Album,
        Author = MediaKindClassifier.IsAudiobook(item.MediaType) ? null : item.Subtitle,
        Artist = MediaKindClassifier.IsMusic(item.MediaType) ? item.Subtitle : null,
        Narrator = item.NarratorName,
        Year = item.Year,
        ContentRating = item.ContentRating,
        SeasonNumber = item.SeasonNumber,
        EpisodeNumber = item.EpisodeNumber,
        EpisodeTitle = item.EpisodeTitle,
        Quality = item.Quality,
        CoverUrl = item.CoverUrl,
        DurationSeconds = TryParseDurationSeconds(item.Duration),
        PositionSeconds = item.InitialPositionSeconds,
        StreamUrl = item.StreamUrl,
        Chapters = item.Chapters,
        Manifest = item.Manifest,
    };
    private async Task SetSpeedAsync(double rate)
    {
        if (!PlaybackRateOptions.IsValid(rate) || CurrentItem is not { } item || item.AssetId is not Guid assetId
            || ActiveProfiles.CurrentProfile?.Id is not Guid profileId)
        {
            return;
        }

        await SendCommandAsync(new ListenPlaybackCommandDto
        {
            Action = "set-speed",
            Value = rate,
            ProfileId = profileId,
            WorkId = item.WorkId,
            ExpectedAssetId = assetId,
            ExpectedPlaybackRequestVersion = _snapshot.PlaybackRequestVersion,
        });
    }

    private async Task HandleRateMenuOpenChanged(PlaybackSpeedMenuState state)
    {
        if (state.IsOpen)
        {
            _rateMenuOpen = true;
            _rateMenuSurface = state.Surface;
            CloseSleepMenu();
        }
        else if (_rateMenuSurface == state.Surface)
        {
            _rateMenuOpen = false;
            _rateMenuSurface = null;
        }
        if (!state.IsOpen) return;

        _activeSheet = null;
        if (_bookmarkDialogContext is not null)
        {
            await CloseBookmarkDialogAsync();
        }
    }

    private void CloseRateMenu()
    {
        _rateMenuOpen = false;
        _rateMenuSurface = null;
    }

    private async Task HandleSleepMenuOpenChanged(PlaybackSpeedMenuState state)
    {
        if (!state.IsOpen)
        {
            if (_sleepMenuSurface == state.Surface) CloseSleepMenu();
            return;
        }

        _sleepMenuOpen = true;
        _sleepMenuSurface = state.Surface;
        CloseRateMenu();
        _activeSheet = null;
        if (_bookmarkDialogContext is not null)
        {
            await CloseBookmarkDialogAsync();
        }
    }

    private void CloseSleepMenu()
    {
        _sleepMenuOpen = false;
        _sleepMenuSurface = null;
    }

    private async Task SetSleepTimerSelectionAsync(AudiobookSleepTimerSelectionDto selection)
    {
        if (!IsAudiobookMode || CurrentItem is not { AssetId: { } assetId } item
            || ActiveProfiles.CurrentProfile?.Id is not { } profileId)
        {
            return;
        }

        var requestVersion = _snapshot.PlaybackRequestVersion;
        var sessionGeneration = _snapshot.AudiobookBookSessionGeneration;
        var priorTimerGeneration = _snapshot.SleepTimerState.TimerGeneration;
        var workId = item.AudiobookWorkId ?? item.WorkId;
        var reply = await SendCommandAsync(new ListenPlaybackCommandDto
        {
            Action = ListenPlaybackCommandActions.SetSleepTimer,
            ProfileId = profileId,
            WorkId = workId,
            ExpectedAssetId = assetId,
            ExpectedPlaybackRequestVersion = requestVersion,
            SleepTimer = selection,
        });

        if (reply?.SleepTimerState is { } authoritativeState
            && _snapshot.PlaybackRequestVersion == requestVersion
            && _snapshot.AudiobookBookSessionGeneration == sessionGeneration
            && ActiveProfiles.CurrentProfile?.Id == profileId
            && CurrentItem?.AssetId == assetId
            && CurrentItem?.WorkId == item.WorkId
            && authoritativeState.TimerGeneration >= _snapshot.SleepTimerState.TimerGeneration
            && authoritativeState.TimerGeneration >= priorTimerGeneration
            && (authoritativeState.Mode == AudiobookSleepTimerModes.Off
                || (authoritativeState.ProfileId == profileId
                    && authoritativeState.WorkId == workId
                    && authoritativeState.BoundAssetId == assetId
                    && authoritativeState.PlaybackRequestVersion == requestVersion)))
        {
            _snapshot = _snapshot with
            {
                SleepTimerState = authoritativeState,
                SleepTimerAvailability = reply.SleepTimerAvailability ?? _snapshot.SleepTimerAvailability,
            };
        }
    }

    private Task SeekAsync(double seconds)
        => SendCommandAsync(new ListenPlaybackCommandDto { Action = "seek", Value = seconds });

    private Task SetVolumeAsync(double volume) =>
        SendCommandAsync(new ListenPlaybackCommandDto { Action = "set-volume", Value = volume });

    private async Task<ListenPlaybackCommandReplyDto?> SendCommandAsync(ListenPlaybackCommandDto command)
    {
        if (_disposed) return null;
        if (!Guid.TryParse(OwnerRecipientId, out var ownerRecipientId) || ownerRecipientId == Guid.Empty)
        {
            _popupCommandError = "The main player connection is unavailable. Reopen this popup from the player.";
            return null;
        }

        var request = command with
        {
            CommandId = Guid.NewGuid(),
            SenderId = _popupRecipientId,
            RecipientId = ownerRecipientId
        };

        try
        {
            var reply = await BookmarkCommandChannel.SendAsync(ownerRecipientId, request);
            if (reply is null || reply.CommandId != request.CommandId || reply.RecipientId != _popupRecipientId)
            {
                _popupCommandError = "The main player did not confirm this control action.";
                return null;
            }

            if (!string.Equals(reply.Outcome, AudiobookBookmarkOperationOutcomes.Success, StringComparison.Ordinal))
            {
                _popupCommandError = reply.Message ?? "The main player could not complete this control action.";
                return null;
            }

            _popupCommandError = null;
            return reply;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "The popup playback command could not reach its owner.");
            _popupCommandError = "The main player connection was interrupted. Reopen the popup from the player.";
            return null;
        }
    }

    private bool IsCurrentChapter(PlaybackChapterDto chapter) => AudiobookProgress?.ActiveChapter == chapter;

    private string PlayerSubtitle(ListenQueueItem item)
    {
        if (IsAudiobookMode)
        {
            return FirstDistinctFrom(item.Title, item.Subtitle, item.Album, _snapshot.SourceLabel, "Audiobook");
        }

        return StringHelpers.FirstNonBlankOr("Library audio", item.Subtitle, item.Album, _snapshot.SourceLabel);
    }

    private static string ChapterDuration(PlaybackChapterDto chapter) =>
        chapter.EndSeconds is > 0 && chapter.EndSeconds.Value > chapter.StartSeconds
            ? FormatTimestamp(chapter.EndSeconds.Value - chapter.StartSeconds)
            : string.Empty;

    private static IEnumerable<LrcDisplayLine> ParseLyrics(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            yield break;
        }

        var pattern = new Regex(@"\[(?<min>\d{1,3}):(?<sec>\d{2})(?:[.:](?<frac>\d{1,3}))?\]");
        var lines = content.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n');
        var isTimed = lines.Any(pattern.IsMatch);
        foreach (var rawLine in lines)
        {
            if (!isTimed)
            {
                if (!string.IsNullOrWhiteSpace(rawLine))
                {
                    yield return new LrcDisplayLine(null, rawLine.Trim());
                }

                continue;
            }

            var matches = pattern.Matches(rawLine);
            if (matches.Count == 0)
            {
                continue;
            }

            var text = pattern.Replace(rawLine, string.Empty).Trim();
            if (string.IsNullOrWhiteSpace(text))
            {
                continue;
            }

            foreach (Match match in matches)
            {
                if (!int.TryParse(match.Groups["min"].Value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var minutes)
                    || !int.TryParse(match.Groups["sec"].Value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var seconds))
                {
                    continue;
                }

                var fraction = match.Groups["frac"].Success ? match.Groups["frac"].Value : "0";
                var fractionalSeconds = fraction.Length switch
                {
                    1 => int.Parse(fraction, CultureInfo.InvariantCulture) / 10d,
                    2 => int.Parse(fraction, CultureInfo.InvariantCulture) / 100d,
                    _ => int.Parse(fraction.PadRight(3, '0')[..3], CultureInfo.InvariantCulture) / 1000d,
                };
                yield return new LrcDisplayLine(minutes * 60d + seconds + fractionalSeconds, text);
            }
        }
    }

    private static string FormatTimestamp(double seconds)
    {
        var safe = Math.Max(0, seconds);
        var span = TimeSpan.FromSeconds(safe);
        return span.TotalHours >= 1
            ? span.ToString(@"h\:mm\:ss", CultureInfo.InvariantCulture)
            : span.ToString(@"m\:ss", CultureInfo.InvariantCulture);
    }

    private static double? TryParseDurationSeconds(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var parts = value.Split(':', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length is not (2 or 3))
        {
            return null;
        }

        var total = 0d;
        var multiplier = 1d;
        for (var index = parts.Length - 1; index >= 0; index--)
        {
            if (!double.TryParse(parts[index], NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed))
            {
                return null;
            }

            total += parsed * multiplier;
            multiplier *= 60d;
        }

        return total;
    }

    private static string FirstDistinctFrom(string? primary, params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)
            && !string.Equals(value, primary, StringComparison.OrdinalIgnoreCase)) ?? "Audiobook";

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Interlocked.Increment(ref _playbackStateReceiveGeneration);
        _bookmarkOpenGeneration++;
        await CloseBookmarkDialogAsync();
        try
        {
            await JS.InvokeVoidAsync("listenPlayback.unregisterStateHandler", _selfReference);
            await JS.InvokeVoidAsync("listenPlayback.unregisterPopupWindow");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogDebug(ex, "Failed to unregister listen popup JavaScript handlers.");
        }

        _selfReference?.Dispose();
    }

    private sealed record LrcDisplayLine(double? StartSeconds, string Text);
}
