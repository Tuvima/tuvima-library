@using MediaEngine.Contracts.LocalAssets
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Editing
@namespace MediaEngine.Web.Components.Pages
@inject IEngineApiClient ApiClient
@inject ViewEditorHost EditorHost
@inject ViewRibbonState Ribbon
@inject ViewWorkspaceService Workspace
@inject DeviceContextService DeviceContext
@inject IStringLocalizer<SharedStrings> L

<MediaViewerShell Item="@ViewerItem"
                  Capabilities="@ViewerCapabilities"
                  IsViewPlayback="true"
                  HasPrevious="@HasPrevious"
                  HasNext="@HasNext"
                  Galleries="@ManualGalleries"
                  OnClose="@OnClose"
                  OnPrevious="@OnPrevious"
                  OnNext="@OnNext"
                  OnFavorite="@OnFavorite"
                  OnArchive="@OnArchive"
                  OnRestore="@OnRestore"
                  OnTrash="@OnTrash"
                  OnAddToGallery="@OnAddToGallery"
                  OnCreateGallery="@OnCreateGallery"
                  InfoInitiallyOpen="@(Workspace.ViewerInfoOpen || Item.FileMissing)"
                  InfoOpenChanged="InfoOpenChangedAsync">
    <ContextActions>
        @if (CanEditHere)
        {
            <AppIconButton Icon="@AppMaterialIcons.Outlined.Edit" Tooltip="@L["ViewEdit_Edit"].Value" AriaLabel="@L["ViewEdit_Edit"].Value" OnClick="EditAsync" />
        }
        @if (!string.IsNullOrWhiteSpace(MotionUrl))
        {
            <AppIconButton Icon="@(_showMotion ? AppMaterialIcons.Outlined.Photo : AppMaterialIcons.Outlined.MotionPhotosOn)"
                           Tooltip="@(_showMotion ? "Show still" : "Play motion")"
                           AriaLabel="@(_showMotion ? "Show Live Photo still" : "Play Live Photo motion")"
                           OnClick="ToggleMotion" />
        }
    </ContextActions>
    <InfoContent>
        @if (Item.FileMissing)
        {
            <section class="view-viewer-info__section view-viewer-info__missing" role="status"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Warning" /><span><strong>@L["ViewImmersiveViewer_FileMissing"]</strong><small>@L["ViewImmersiveViewer_TheFileWasDeletedOr"]</small></span></section>
        }
        @* The side panel only shows (spec photos-documents-editor D6): the same facts the editor's Quick Facts card shows, with one Edit button. Nothing here is edited or saved. *@
        @if (CanEditHere)
        {
            <section class="view-viewer-info__section"><AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" StartIcon="@AppMaterialIcons.Outlined.Edit" OnClick="EditAsync">@L["ViewEdit_Edit"]</AppButton></section>
        }
        @if (!string.IsNullOrWhiteSpace(Item.Description))
        {
            <section class="view-viewer-info__section view-viewer-info__description"><div class="view-viewer-info__description-card"><span>@Item.Description</span></div></section>
        }
        <section class="view-viewer-info__section">
            <div class="view-viewer-info__heading"><h3>@L["Common_Details"]</h3></div>
            <div class="view-viewer-info__detail-list">
                <div class="view-viewer-info__detail-row"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CalendarMonth" /><span><strong><time datetime="@Captured.ToString("O")">@CapturedLocal.ToString("MMM d, yyyy 'at' h:mm:ss tt")</time></strong><small>@($"{CapturedLocal:dddd}, GMT{CapturedLocal:zzz}")</small></span></div>
                <div class="view-viewer-info__detail-row"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.InsertPhoto" /><span><strong>@Item.FileName</strong><small>@FileSummary</small></span></div>
                @if (!string.IsNullOrWhiteSpace(Device))
                {
                    <div class="view-viewer-info__detail-row"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PhotoCamera" /><span><strong>@Device</strong>@if (!string.IsNullOrWhiteSpace(CameraSummary)) { <small>@CameraSummary</small> }</span></div>
                }
            </div>
        </section>
        @if (!string.IsNullOrWhiteSpace(LocationLabel) || HasLocation)
        {
            <section class="view-viewer-info__section">
                <div class="view-viewer-info__heading"><h3>@L["Common_Location"]</h3></div>
                @if (!string.IsNullOrWhiteSpace(LocationLabel)) { <div class="view-viewer-info__detail-row"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.LocationOn" /><span><strong>@LocationLabel</strong></span></div> }
                @if (HasLocation)
                {
                    <div class="view-viewer-info__map"><ViewMap Latitude="@Item.Latitude" Longitude="@Item.Longitude" Interactive="false" ShowNavigation="false" AriaLabel="@($"Map showing {LocationLabel}")" /></div>
                }
            </section>
        }
        @if (Item.People is { Count: > 0 })
        {
            <section class="view-viewer-info__section"><div class="view-viewer-info__heading"><h3>@L["Wikidata_PeopleGroupTitle"]</h3></div><div class="view-viewer-info__tags">@foreach (var person in Item.People) { <span>@person</span> }</div></section>
        }
        @if (Item.Tags.Count > 0)
        {
            <section class="view-viewer-info__section"><div class="view-viewer-info__heading"><h3>@L["Common_Tags"]</h3></div><div class="view-viewer-info__tags">@foreach (var tag in Item.Tags) { <span>@tag</span> }</div></section>
        }
        <section class="view-viewer-info__section"><div class="view-viewer-info__heading"><h3>@L["Common_Files"]</h3></div><div class="view-viewer-info__files">@foreach (var file in DisplayFiles) { <div><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.InsertPhoto" /><span><strong>@(file.FileName ?? Item.FileName)</strong>@if (DisplayFiles.Count > 1) { <small>@FileRole(file.Role)</small> }</span><small>@FormatBytes(file.ByteSize)</small></div> }</div></section>
    </InfoContent>
</MediaViewerShell>

@code {
    [Parameter, EditorRequired] public LocalAssetDto Item { get; set; } = default!;
    [Parameter] public bool HasPrevious { get; set; }
    [Parameter] public bool HasNext { get; set; }
    [Parameter] public string ContentUrl { get; set; } = "";
    [Parameter] public string OriginalUrl { get; set; } = "";
    [Parameter] public string ThumbnailUrl { get; set; } = "";
    [Parameter] public string? MotionUrl { get; set; }
    [Parameter] public string? PositionLabel { get; set; }
    [Parameter] public IReadOnlyList<ViewGalleryDto> ManualGalleries { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnFavorite { get; set; }
    [Parameter] public EventCallback OnArchive { get; set; }
    [Parameter] public EventCallback OnRestore { get; set; }
    [Parameter] public EventCallback OnTrash { get; set; }
    [Parameter] public EventCallback<Guid> OnAddToGallery { get; set; }

    /// <summary>Starts a new Gallery with this photo in it (computers only; the page leaves it unset elsewhere).</summary>
    [Parameter] public EventCallback OnCreateGallery { get; set; }
    [Parameter] public EventCallback<LocalAssetDto> OnItemUpdated { get; set; }
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>Set when the viewer was opened from a gallery: Edit then shows "Gallery > Photo" in the editor's rail so the person can step through the gallery's photos.</summary>
    [Parameter] public ViewEditGalleryRail? EditRail { get; set; }
    // Editing is desktop-only (EditorDeviceRule): phones and tablets only view photo details.
    private bool CanEditHere => CanEdit && DeviceContext.CanEdit && !Item.FileMissing;
    [Parameter] public bool CanManage { get; set; }

    /// <summary>The actions this item offers, from the one shared rule (ViewActionPolicy). Left unset, the viewer works it out from CanManage.</summary>
    [Parameter] public ViewActions? Actions { get; set; }
    private bool _showMotion;
    private string Title => string.IsNullOrWhiteSpace(Item.Title) ? Item.FileName : Item.Title;
    private DateTimeOffset Captured => Item.CapturedAt ?? Item.CreatedAt;
    private DateTimeOffset CapturedLocal => Captured.ToLocalTime();
    private long TotalBytes => DisplayFiles.Sum(file => file.ByteSize);
    private IReadOnlyList<LocalAssetFileDto> DisplayFiles
    {
        get
        {
            var sourceFiles = Item.Files.Where(file => !string.Equals(file.Role, "derivative", StringComparison.OrdinalIgnoreCase))
                .DistinctBy(file => file.Id).ToList();
            var compound = sourceFiles.Any(file => file.Role is "live_photo_video" or "raw" or "jpeg" or "sidecar" or "audio_companion");
            return compound ? sourceFiles : sourceFiles.Take(1).ToList();
        }
    }
    private string Device => string.Join(' ', new[] { Item.DeviceMake, Item.DeviceModel }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private string FileSummary => string.Join("  ·  ", new[]
    {
        Item.Width is > 0 && Item.Height is > 0 ? $"{Item.Width} × {Item.Height}" : null,
        (Item.MimeType.StartsWith("video/", StringComparison.OrdinalIgnoreCase) || Item.MimeType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase)) && Item.DurationSeconds is > 0 ? FormatDuration(Item.DurationSeconds.Value) : null,
        TotalBytes > 0 ? FormatBytes(TotalBytes) : null,
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private string CameraSummary => string.Join("  ·  ", new[]
    {
        Item.ExposureTime,
        Item.Iso is > 0 ? $"ISO {Item.Iso}" : null,
        Item.Aperture is > 0 ? $"ƒ/{Item.Aperture.Value:0.#}" : null,
        Item.FocalLengthMm is > 0 ? $"{Item.FocalLengthMm.Value:0.#} mm" : null,
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private string LocationLabel => string.Join(", ", new[] { Item.LocationName, Item.LocationCity, Item.LocationRegion, Item.LocationCountry }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private bool HasLocation => Item.Latitude.HasValue && Item.Longitude.HasValue;

    // Edit opens the one editor window over the viewer (spec photos-documents-editor D6); when it closes after a save, the item is read again.
    private async Task EditAsync()
    {
        if (!CanEditHere || !await EditorHost.OpenItemsAsync([Item], EditRail))
        {
            return;
        }

        var closed = await EditorHost.WhenClosedAsync();
        if (closed.Changed && await ApiClient.GetViewItemAsync(Item.Id, Workspace.ScopeKind, Workspace.ScopeProfileId) is { } refreshed)
        {
            await OnItemUpdated.InvokeAsync(refreshed);
        }

        // The photo was deleted from the editor (it is in the Recycle bin now): the viewer has nothing left to show.
        if (closed.DeletedIds.Contains(Item.Id))
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task InfoOpenChangedAsync(bool open)
    {
        if (!await Workspace.SetViewerInfoOpenAsync(open))
            Ribbon.Show(L["ViewImmersiveViewer_TheViewerPreferenceCouldNot"].Value, isError: true);
    }
    private void ToggleMotion() => _showMotion = !_showMotion;
    private MediaViewerItem ViewerItem => new(
        Item.Id.ToString("D"),
        _showMotion ? MediaViewerKind.Video
            : Item.MimeType.StartsWith("video/", StringComparison.OrdinalIgnoreCase) ? MediaViewerKind.Video
            : Item.MimeType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase) ? MediaViewerKind.Audio
            : Item.MimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) ? MediaViewerKind.Image
            : MediaViewerKind.Document,
        Title,
        Captured.ToLocalTime().ToString("f"),
        _showMotion ? MotionUrl! : Item.MimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) ? ContentUrl : OriginalUrl,
        OriginalUrl,
        ThumbnailUrl,
        PositionLabel,
        Title);
    // The same action list as the selection bar and the tile menu (ViewActionPolicy). A page that passes Actions gets exactly that; one that does not keeps the older CanManage rule.
    private ViewActions Allowed => Actions ?? ViewActionPolicy.For(new ViewActionContext(
        CanManage ? ViewItemOwnership.Own : string.Equals(Item.ScopeKind, "shared", StringComparison.OrdinalIgnoreCase) ? ViewItemOwnership.SharedByOther : ViewItemOwnership.OtherPerson, DeviceContext.IsPhone, CanEdit, Item.FileMissing, Item.CanTrash,
        Item.ArchivedAt.HasValue, Item.TrashedAt.HasValue, Item.Hidden));
    private MediaViewerCapabilities ViewerCapabilities => new(
        CanFavorite: Allowed.HasFlag(ViewActions.Favorite),
        IsFavorite: Item.Favorite,
        CanAddToGallery: Allowed.HasFlag(ViewActions.AddToGallery) && (ManualGalleries.Count > 0 || OnCreateGallery.HasDelegate),
        CanDownload: Allowed.HasFlag(ViewActions.Download),
        CanArchive: Allowed.HasFlag(ViewActions.Archive),
        CanRestore: Allowed.HasFlag(ViewActions.Restore),
        CanTrash: Allowed.HasFlag(ViewActions.Trash),
        CanShowInfo: true,
        CanZoom: Item.MimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase),
        CanPlay: Item.MimeType.StartsWith("video/", StringComparison.OrdinalIgnoreCase),
        CanSlideshow: HasNext);
    private static string FileRole(string role) => role.Replace('_', ' ').ToUpperInvariant();
    private static string FormatDuration(double seconds) => TimeSpan.FromSeconds(seconds).TotalHours >= 1 ? TimeSpan.FromSeconds(seconds).ToString(@"h\:mm\:ss") : TimeSpan.FromSeconds(seconds).ToString(@"m\:ss");
    private static string FormatBytes(long bytes) { string[] units = ["B", "KB", "MB", "GB", "TB"]; var value = (double)bytes; var unit = 0; while (value >= 1024 && unit < units.Length - 1) { value /= 1024; unit++; } return $"{value:0.#} {units[unit]}"; }
}
