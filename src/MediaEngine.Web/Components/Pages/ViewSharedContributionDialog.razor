@using MediaEngine.Contracts.LocalAssets
@inject IEngineApiClient ApiClient
@namespace MediaEngine.Web.Components.Pages
@implements IDisposable

<AppDialogShell Title="Submit to Shared Library" Subtitle="Send selected Personal Space items to a Shared Library curator." Size="Medium" OnClose="@(() => Dialog.Cancel())">
    <ChildContent>
        @if (_loading) { <AppProgressBar Indeterminate="true" /> }
        else if (!string.IsNullOrWhiteSpace(_error)) { <AppAlert Tone="AppUiTone.Error">@_error</AppAlert> }
        else
        {
            <AppAlert Tone="AppUiTone.Info">@Summary</AppAlert>
            <div role="radiogroup" aria-label="Shared Library destination">
                <AppNativeButton Type="button" role="radio" aria-checked="@(_kind == "timeline")" Class="@(_kind == "timeline" ? "is-selected" : null)" OnClick="@(_ => SelectKindAsync("timeline"))"><strong>Shared Timeline</strong><span>Organize by capture year and month.</span></AppNativeButton>
                <AppNativeButton Type="button" role="radio" aria-checked="@(_kind == "folder")" Class="@(_kind == "folder" ? "is-selected" : null)" OnClick="@(_ => SelectKindAsync("folder"))"><strong>Named Shared folder</strong><span>Keep these files together under Shared/Folders.</span></AppNativeButton>
            </div>
            @if (_kind == "folder") { <AppTextField Label="Shared folder name" Value="@_folderName" ValueChanged="FolderNameChangedAsync" /> }
            <AppTextField Label="Note for curators (optional)" Value="@_note" ValueChanged="@(value => _note = value ?? string.Empty)" />
            @if (_preview is not null)
            {
                <div><strong>Destination preview</strong>@foreach (var path in _preview.Items.Select(value => value.DestinationRoot).Distinct(StringComparer.OrdinalIgnoreCase)) { <code>@path</code> }</div>
            }
            <p>Nothing moves while the contribution is pending. If accepted, managed originals move after verification; linked originals are copied and remain at their source.</p>
        }
    </ChildContent>
    <FooterContent>
        <AppButton Label="Cancel" ButtonStyle="AppButtonStyle.Text" OnClick="@(() => Dialog.Cancel())" />
        <AppButton Label="Submit for review" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(_loading || _error is not null || _preview is null || (_kind == "folder" && string.IsNullOrWhiteSpace(_folderName)))" OnClick="Complete" />
    </FooterContent>
</AppDialogShell>

@code {
    [CascadingParameter] private IAppDialogContext Dialog { get; set; } = default!;
    [Parameter] public IReadOnlyCollection<Guid> ItemIds { get; set; } = [];
    private ViewSharedContributionPreviewDto? _preview;
    private bool _loading = true;
    private string _kind = "timeline", _folderName = string.Empty, _note = string.Empty;
    private string? _error;
    private CancellationTokenSource? _previewCts;
    protected override async Task OnInitializedAsync() => await LoadPreviewsAsync();
    private async Task LoadPreviewsAsync(CancellationToken ct = default)
    {
        _loading = true;
        _error = null;
        _preview = await ApiClient.PreviewViewSharedContributionAsync(new ViewSharedContributionPreviewRequest(
            ItemIds.ToList(), _kind, _kind == "folder" ? _folderName.Trim() : null), ct);
        if (_preview is null) _error = ApiClient.LastError ?? "The contribution could not be previewed.";
        _loading = false;
    }
    private async Task SelectKindAsync(string kind)
    {
        _kind = kind;
        if (kind == "folder" && string.IsNullOrWhiteSpace(_folderName)) { _preview = null; _error = null; return; }
        await LoadPreviewsAsync();
    }
    private async Task FolderNameChangedAsync(string? value)
    {
        _folderName = value ?? string.Empty;
        _previewCts?.Cancel(); _previewCts?.Dispose();
        if (string.IsNullOrWhiteSpace(_folderName)) { _preview = null; _error = null; return; }
        var pending = _previewCts = new CancellationTokenSource();
        try { await Task.Delay(250, pending.Token); await LoadPreviewsAsync(pending.Token); }
        catch (OperationCanceledException) { }
    }
    private string Summary => _preview is null ? string.Empty : $"{_preview.Items.Count} items · {_preview.FileCount} files · {FormatBytes(_preview.TotalBytes)}. {_preview.MoveCount} move if accepted; {_preview.CopyCount} copy if accepted.";
    private void Complete()
    {
        if (_preview is null) return;
        Dialog.Close(AppDialogResult.Ok(new ViewSharedContributionSubmitRequest(ItemIds.ToList(), _kind,
            _kind == "folder" ? _folderName.Trim() : null, string.IsNullOrWhiteSpace(_note) ? null : _note.Trim(),
            _preview.PreviewRevision, Guid.NewGuid().ToString("N"))));
    }
    private static string FormatBytes(long value) => value >= 1_073_741_824 ? $"{value / 1_073_741_824d:0.##} GB" : value >= 1_048_576 ? $"{value / 1_048_576d:0.##} MB" : $"{value / 1024d:0.##} KB";
    public void Dispose() { _previewCts?.Cancel(); _previewCts?.Dispose(); }
}
