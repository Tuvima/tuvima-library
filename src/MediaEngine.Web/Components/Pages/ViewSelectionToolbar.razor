@using MediaEngine.Contracts.LocalAssets
@namespace MediaEngine.Web.Components.Pages

<section class="view-selection-toolbar" role="toolbar" aria-label="Selected photo actions">
    <div class="view-selection-toolbar__count">
        <strong>@Count selected</strong>
    </div>
    <span class="view-selection-toolbar__divider" aria-hidden="true"></span>
    <div class="view-selection-toolbar__actions">
        @if (OnAddToGallery.HasDelegate || OnCreateGallery.HasDelegate)
        {
        <AppOverflowMenu Label="Add to Gallery"
                         Icon="@AppMaterialIcons.Outlined.PhotoLibrary"
                         AriaLabel="Add selected items to a Gallery"
                         Class="view-selection-toolbar__gallery"
                         AnchorOrigin="AppOrigin.BottomLeft"
                         TransformOrigin="AppOrigin.TopLeft">
            @foreach (var gallery in ManualGalleries)
            {
                <AppMenuItem Label="@gallery.Name"
                             Icon="@AppMaterialIcons.Outlined.PhotoAlbum"
                             OnClick="@(() => OnAddToGallery.InvokeAsync(gallery.Id))" />
            }
            <AppMenuItem Label="New Gallery"
                         Icon="@AppMaterialIcons.Outlined.Add"
                         DividerBefore="@(ManualGalleries.Count > 0)"
                         OnClick="@(() => OnCreateGallery.InvokeAsync())" />
        </AppOverflowMenu>
        }
        @if (ShowSharedLibrary)
        {
            <AppNativeButton Type="button" Class="view-selection-toolbar__action" OnClick="@(_ => OnSharedLibrary.InvokeAsync())"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.GroupWork" />Submit to Shared Library</AppNativeButton>
        }
        @if (OnFavorite.HasDelegate) { <AppNativeButton Type="button" Class="view-selection-toolbar__action" OnClick="@(_ => OnFavorite.InvokeAsync())"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FavoriteBorder" />Favorite</AppNativeButton> }
        @if (ShowRestore)
        {
            <AppNativeButton Type="button" Class="view-selection-toolbar__action" OnClick="@(_ => OnRestore.InvokeAsync())"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Restore" />Restore</AppNativeButton>
        }
        else if (OnArchive.HasDelegate)
        {
            <AppNativeButton Type="button" Class="view-selection-toolbar__action" OnClick="@(_ => OnArchive.InvokeAsync())"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Inventory2" />Archive</AppNativeButton>
        }
        @if (ShowTrash && OnTrash.HasDelegate)
        {
            <AppNativeButton Type="button" Class="view-selection-toolbar__action" OnClick="@(_ => OnTrash.InvokeAsync())"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.DeleteOutline" />Trash</AppNativeButton>
        }
        @if (OnRemoveFromGallery.HasDelegate) { <AppNativeButton Type="button" Class="view-selection-toolbar__action" OnClick="@(_ => OnRemoveFromGallery.InvokeAsync())"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.RemoveCircleOutline" />Remove from Gallery</AppNativeButton> }
    </div>
    <span class="view-selection-toolbar__divider" aria-hidden="true"></span>
    <AppNativeButton Type="button" Class="view-selection-toolbar__close" AriaLabel="Clear photo selection" OnClick="@(_ => OnClear.InvokeAsync())"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Close" /></AppNativeButton>
</section>

@code {
    [Parameter] public int Count { get; set; }
    [Parameter] public IReadOnlyList<ViewGalleryDto> ManualGalleries { get; set; } = [];
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public EventCallback OnFavorite { get; set; }
    [Parameter] public EventCallback OnSharedLibrary { get; set; }
    [Parameter] public bool ShowSharedLibrary { get; set; }
    [Parameter] public bool ShowRestore { get; set; }
    [Parameter] public EventCallback OnRestore { get; set; }
    [Parameter] public bool ShowTrash { get; set; } = true;
    [Parameter] public EventCallback OnArchive { get; set; }
    [Parameter] public EventCallback OnTrash { get; set; }
    [Parameter] public EventCallback<Guid> OnAddToGallery { get; set; }
    [Parameter] public EventCallback OnCreateGallery { get; set; }
    [Parameter] public EventCallback OnRemoveFromGallery { get; set; }
}
