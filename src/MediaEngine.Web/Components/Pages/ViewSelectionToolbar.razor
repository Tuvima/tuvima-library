@using MediaEngine.Contracts.LocalAssets
@namespace MediaEngine.Web.Components.Pages
@inject IStringLocalizer<SharedStrings> L

<section class="view-selection-toolbar@(Phone ? " view-selection-toolbar--phone" : string.Empty)" role="toolbar" aria-label="@AriaLabel">
    <div class="view-selection-toolbar__count">
        <strong>@Count selected</strong>
    </div>
    <span class="view-selection-toolbar__divider" aria-hidden="true"></span>
    <div class="view-selection-toolbar__actions">
        @ChildContent
        @if ((OnAddToGallery.HasDelegate && ManualGalleries.Count > 0) || OnCreateGallery.HasDelegate)
        {
        <AppOverflowMenu Label="@L["ViewSelectionToolbar_AddToGallery"].Value"
                         Icon="@AppMaterialIcons.Outlined.PhotoLibrary"
                         AriaLabel="@L["ViewSelectionToolbar_AddSelectedItemsToA"].Value"
                         Class="view-selection-toolbar__gallery"
                         AnchorOrigin="AppOrigin.BottomLeft"
                         TransformOrigin="AppOrigin.TopLeft">
            @foreach (var gallery in ManualGalleries)
            {
                <AppMenuItem Label="@gallery.Name"
                             Icon="@AppMaterialIcons.Outlined.PhotoAlbum"
                             OnClick="@(() => OnAddToGallery.InvokeAsync(gallery.Id))" />
            }
            @if (OnCreateGallery.HasDelegate)
            {
            <AppMenuItem Label="@L["Common_NewGallery"].Value"
                         Icon="@AppMaterialIcons.Outlined.Add"
                         DividerBefore="@(ManualGalleries.Count > 0)"
                         OnClick="@(() => OnCreateGallery.InvokeAsync())" />
            }
        </AppOverflowMenu>
        }
        @if (ShowSharedLibrary)
        {
            <AppNativeButton Type="button" Class="view-selection-toolbar__action" AriaLabel="@L["Common_SubmitToSharedLibrary"].Value" OnClick="@(_ => OnSharedLibrary.InvokeAsync())"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.GroupWork" />@(Phone ? "Share" : "Submit to Shared Library")</AppNativeButton>
        }
        @if (OnDownload.HasDelegate)
        {
            <AppNativeButton Type="button" Class="view-selection-toolbar__action" AriaLabel="@L["ViewSelectionToolbar_DownloadSelectedItems"].Value" OnClick="@(_ => OnDownload.InvokeAsync())"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Download" />@L["Models_Download"]</AppNativeButton>
        }
        @if (Phone)
        {
            @* Phones keep the bar to Add to gallery, Share, Download and Cancel; the rest sit behind one three-dot menu (a bottom sheet). *@
            @if (SecondaryItems.Count > 0)
            {
                <AppRowMenu AriaLabel="@L["ViewSelectionToolbar_MoreActionsForTheSelected"].Value" Title="@($"{Count} selected")" Items="@SecondaryItems" Class="view-selection-toolbar__more" />
            }
        }
        else
        {
            @if (OnFavorite.HasDelegate) { <AppNativeButton Type="button" Class="view-selection-toolbar__action" OnClick="@(_ => OnFavorite.InvokeAsync())"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FavoriteBorder" />@L["Glossary_Favorite"]</AppNativeButton> }
            @if (ShowRestore)
            {
                <AppNativeButton Type="button" Class="view-selection-toolbar__action" OnClick="@(_ => OnRestore.InvokeAsync())"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Restore" />@L["Common_Restore"]</AppNativeButton>
            }
            else if (OnArchive.HasDelegate)
            {
                <AppNativeButton Type="button" Class="view-selection-toolbar__action" OnClick="@(_ => OnArchive.InvokeAsync())"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Inventory2" />@L["ViewSelectionToolbar_Archive"]</AppNativeButton>
            }
            @if (ShowTrash && OnTrash.HasDelegate)
            {
                <AppNativeButton Type="button" Class="view-selection-toolbar__action" OnClick="@(_ => OnTrash.InvokeAsync())"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.DeleteOutline" />@L["Common_Trash"]</AppNativeButton>
            }
            @if (OnRemoveFromGallery.HasDelegate) { <AppNativeButton Type="button" Class="view-selection-toolbar__action" OnClick="@(_ => OnRemoveFromGallery.InvokeAsync())"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.RemoveCircleOutline" />@L["ViewSelectionToolbar_RemoveFromGallery"]</AppNativeButton> }
        }
    </div>
    <span class="view-selection-toolbar__divider" aria-hidden="true"></span>
    @if (Phone)
    {
        <AppNativeButton Type="button" Class="view-selection-toolbar__close" AriaLabel="@L["ViewSelectionToolbar_CancelPhotoSelection"].Value" OnClick="@(_ => OnClear.InvokeAsync())"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Close" />@L["Search_Cancel"]</AppNativeButton>
    }
    else
    {
        <AppNativeButton Type="button" Class="view-selection-toolbar__close" AriaLabel="@L["ViewSelectionToolbar_ClearPhotoSelection"].Value" OnClick="@(_ => OnClear.InvokeAsync())"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Close" /></AppNativeButton>
    }
</section>

@code {
    [Parameter] public int Count { get; set; }

    /// <summary>What a screen reader calls the bar; the Documents page says "documents" instead of "photo".</summary>
    [Parameter] public string AriaLabel { get; set; } = "Selected photo actions";

    /// <summary>Extra actions for a screen with its own kind of selection (the Documents bulk edit).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public IReadOnlyList<ViewGalleryDto> ManualGalleries { get; set; } = [];
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public EventCallback OnFavorite { get; set; }
    [Parameter] public EventCallback OnSharedLibrary { get; set; }
    [Parameter] public bool ShowSharedLibrary { get; set; }
    [Parameter] public bool ShowRestore { get; set; }
    [Parameter] public EventCallback OnRestore { get; set; }
    [Parameter] public bool ShowTrash { get; set; } = true;
    [Parameter] public EventCallback OnArchive { get; set; }
    [Parameter] public EventCallback OnTrash { get; set; }
    [Parameter] public EventCallback<Guid> OnAddToGallery { get; set; }
    [Parameter] public EventCallback OnCreateGallery { get; set; }
    [Parameter] public EventCallback OnRemoveFromGallery { get; set; }

    /// <summary>Downloads the selected originals. Left unset, the Download action does not render.</summary>
    [Parameter] public EventCallback OnDownload { get; set; }

    /// <summary>The phone bar: fixed above the dock, four primary actions, and the secondary ones behind a three-dot menu.</summary>
    [Parameter] public bool Phone { get; set; }

    private IReadOnlyList<AppRowMenuItem> SecondaryItems
    {
        get
        {
            var items = new List<AppRowMenuItem>();
            if (OnFavorite.HasDelegate) { items.Add(new() { Label = "Favorite", Icon = AppMaterialIcons.Outlined.FavoriteBorder, OnClick = OnFavorite }); }
            if (ShowRestore) { items.Add(new() { Label = "Restore", Icon = AppMaterialIcons.Outlined.Restore, OnClick = OnRestore }); }
            else if (OnArchive.HasDelegate) { items.Add(new() { Label = "Archive", Icon = AppMaterialIcons.Outlined.Inventory2, OnClick = OnArchive }); }
            if (ShowTrash && OnTrash.HasDelegate) { items.Add(new() { Label = "Trash", Icon = AppMaterialIcons.Outlined.DeleteOutline, Destructive = true, OnClick = OnTrash }); }
            if (OnRemoveFromGallery.HasDelegate) { items.Add(new() { Label = "Remove from Gallery", Icon = AppMaterialIcons.Outlined.RemoveCircleOutline, OnClick = OnRemoveFromGallery }); }
            return items;
        }
    }
}
