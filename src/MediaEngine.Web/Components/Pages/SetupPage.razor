@page "/setup"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@implements IDisposable
@layout MediaEngine.Web.Shared.SetupWizardLayout
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Contracts.Setup
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Components.Setup
@using MediaEngine.Web.Services.Navigation
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IEngineApiClient ApiClient
@inject ProtectedLocalStorage Storage
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IAppToastService Snackbar
@inject SignInAttemptLimiter SignInLimiter
@inject MediaEngine.Web.Services.Vault.NsfwModeState Nsfw
@inject Microsoft.JSInterop.IJSRuntime JS
@inject ILogger<SetupPage> Logger
@inject MediaEngine.Web.Services.Integration.SetupSignInHandoff SignInHandoff
@inject MediaEngine.Web.Services.Integration.DashboardSessionAccessor DashboardSession
@inject MediaEngine.Web.Services.Integration.DashboardIdentityClient Identity
@inject MediaEngine.Web.Services.Theming.DeviceContextService DeviceContext

<PageTitle>Set up Library</PageTitle>

<main class="setup-page">
    @if (_loading)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="Loading setup" Message="Checking this server's durable setup state." />
    }
    else if (ClientSignInRefusal is not null && _status?.RequiresSetupStart == true && !_authenticated && !_setupSessionReadyForCircuit)
    {
        <AppPageState Kind="AppPageStateKind.Error" Title="Setup is not available from here" Message="@ClientSignInRefusal" />
    }
    else if (_status is null)
    {
        <AppPageState Kind="AppPageStateKind.Error" Title="Setup is unavailable" Message="The Engine did not return setup status. Check the container logs and retry." />
    }
    else if (_codeRequired || _remoteRefused)
    {
        <section class="setup-stage" aria-labelledby="setup-stage-title">
            <SetupCodeStage Remote="@_remoteRefused" Message="@_codeMessage" Code="@_setupCode"
                            CodeChanged="@((string? value) => _setupCode = value ?? string.Empty)"
                            Busy="@_codeBusy" Submit="SubmitSetupCodeAsync" />
        </section>
    }
    else
    {
        <div class="setup-shell">
        <aside class="setup-sidebar">
            <div class="setup-brand"><img src="/images/tuvima-icon.svg" alt="" width="32" height="32" /><span>Library</span></div>
            <SetupStepper Steps="@_status.Steps" CurrentStep="@CurrentStep" WorkflowStep="@WorkflowStep" ShowVault="@ShowVault" StepSelected="GoToStepAsync" />
        </aside>
        <section class="setup-stage" aria-labelledby="setup-stage-title">
            @switch (CurrentStep)
            {
                case "welcome":
                    <SetupWelcomeStage Locale="@_locale" LocaleChanged="@((SetupLocaleDto value) => _locale = value)"
                                      ServerName="@_serverName" ServerNameChanged="@((string value) => _serverName = value)"
                                      HostName="@_hostName" HostNameChanged="@((string value) => _hostName = value)"
                                      Busy="@_busy" Save="SaveWelcomeAsync"
                                      Backup="@_backup" BackupError="@_backupError" ShowRestore="@_showRestore" OpenRestore="@(() => _showRestore = true)" CancelRestore="CancelRestore"
                                      UploadBackup="UploadBackupAsync" ConfirmRestore="ConfirmRestoreAsync"
                                      ShowReturnToCurrentStep="@(CurrentStep != WorkflowStep)" ReturnToCurrentStep="ReturnToCurrentStep" />
                    break;
                case "tools":
                    <SetupToolsStage Preflight="@_preflight" Error="@_preflightError" Busy="@_busy" Retry="RunPreflightManualAsync" Continue="ContinuePastToolsAsync"
                                     Skipped="@_skippedDownloads" DownloadChanged="DownloadChanged" RunInstaller="RunToolInstallerAsync"
                                     Back="GoBackAsync" ShowReturnToCurrentStep="@(CurrentStep != WorkflowStep)" ReturnToCurrentStep="ReturnToCurrentStep" />
                    break;
                case "profile":
                    <SetupProfileStage DisplayName="@_displayName" DisplayNameChanged="@((string? value) => _displayName = value ?? string.Empty)"
                                             Email="@_email" EmailChanged="@((string? value) => _email = value ?? string.Empty)"
                                             Password="@_password" PasswordChanged="@((string? value) => _password = value ?? string.Empty)"
                                             PasswordConfirmation="@_passwordConfirmation" PasswordConfirmationChanged="@((string? value) => _passwordConfirmation = value ?? string.Empty)"
                                             Pin="@_pin" PinChanged="@((string? value) => _pin = value ?? string.Empty)"
                                             PinConfirmation="@_pinConfirmation" PinConfirmationChanged="@((string? value) => _pinConfirmation = value ?? string.Empty)"
                                             RecoveryCodes="@_recoveryCodes"
                                             AdministratorConfigured="@(_status.AdministratorConfigured)" Busy="@_busy" CreateAdministrator="CreateAdministratorAsync"
                                             ThisComputerAvailable="@ThisComputerAvailable" SignInMode="@_signInMode" SignInModeChanged="SignInModeChangedAsync" Notice="@_signInNotice"
                                             Continue="ContinueAfterProfileAsync" Back="GoBackAsync" ShowReturnToCurrentStep="@(CurrentStep != WorkflowStep)" ReturnToCurrentStep="ReturnToCurrentStep" />
                    break;
                case "libraries":
                    <SetupLibrariesStage Media="@_media" SetupSession="@_setupSession" Busy="@_busy"
                                     LibraryCreated="LibraryCreatedAsync" ValidateMedia="ValidateMediaAsync" HasLibraries="@(_setupLibraries?.Libraries.Any(library => library.Sources.Count > 0) == true)" DeferMedia="DeferMediaAsync"
                                     Back="GoBackAsync" ShowReturnToCurrentStep="@(CurrentStep != WorkflowStep)" ReturnToCurrentStep="ReturnToCurrentStep" />
                    break;
                case "vault" when _vaultProfileId is { } vaultProfileId:
                    <SetupVaultOffer ProfileId="@vaultProfileId" AdministratorHasPin="@_vaultProfileHasPin" SetupSession="@_setupSession" Finished="VaultFinishedAsync" />
                    break;
                case "metadata":
                    <SetupMetadataStage Catalogue="@_providerCatalogue" LibraryMediaTypes="@LibraryMediaTypes" SetupSession="@_setupSession" Busy="@_busy"
                                         Locale="@_locale" LocaleChanged="@((SetupLocaleDto value) => _locale = value)"
                                         RefreshRequested="RefreshProvidersAsync" Continue="SaveProviderResultAsync" Defer="DeferProviderResultAsync"
                                         Back="GoBackAsync" ShowReturnToCurrentStep="@(CurrentStep != WorkflowStep)" ReturnToCurrentStep="ReturnToCurrentStep" />
                    break;
                default:
                    <SetupReadinessStage Readiness="@_readiness" Failed="@_readinessFailed" Retry="RetryReadinessAsync" InstallTool="InstallOptionalToolAsync" RunInstaller="RunToolInstallerAsync" Tools="@_preflight?.Tools" SampleScanDetail="@_sampleScanDetail" Busy="@_busy" SampleScan="SampleScanAsync" Complete="CompleteAsync"
                                         Back="GoBackAsync" ShowReturnToCurrentStep="@(CurrentStep != WorkflowStep)" ReturnToCurrentStep="ReturnToCurrentStep" />
                    break;
            }
        </section>
        </div>
    }
</main>

@code {
    private const string SetupSessionKey = "tuvima.setup.session.v2";
    private SetupStatusDto? _status;
    private SetupPreflightDto? _preflight;
    private string? _preflightError;
    private SetupBackupInspectionDto? _backup;
    private string? _backupError;
    private SetupMediaLocationsDto? _media;
    private LibrariesConfigurationDto? _setupLibraries;
    private SetupReadinessDto? _readiness;
    private bool _readinessFailed;
    private string? _setupSession;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _pin = string.Empty, _pinConfirmation = string.Empty;
    private string _passwordConfirmation = string.Empty;
    private string _displayName = "Administrator";
    private IReadOnlyList<string> _recoveryCodes = [];
    private IReadOnlyList<ProviderCatalogueDto> _providerCatalogue = [];

    // The media types of the libraries that have at least one folder; the Metadata step lists the sources that fit them.
    private IReadOnlyCollection<string> LibraryMediaTypes => _setupLibraries?.Libraries
        .Where(library => library.Sources.Count > 0)
        .SelectMany(library => library.MediaTypes)
        .ToList() ?? [];
    private string? _sampleScanDetail;
    private bool _loading = true;
    private bool _busy;
    private bool _showRestore;
    private bool _authenticated;
    private bool _setupSessionReadyForCircuit;
    private bool _codeRequired, _remoteRefused;
    private string _setupCode = string.Empty;
    private string? _codeMessage;
    private bool _codeBusy; // separate from _busy: the wizard loads its first step only while _busy is false
    private string? _selectedStep;
    private bool _providersLoaded;
    private SetupLocaleDto? _locale;
    private string _serverName = string.Empty, _hostName = string.Empty;
    private bool _serverIdentityLoaded;

    // The Dashboard's own classification of this visitor, set by the host page. Never read from the browser.
    [CascadingParameter(Name = "ClientIngress")]
    public string? ClientIngress { get; set; }

    // True when the visitor's request carried forwarding headers (a tunnel or proxy on this computer may be relaying them).
    [CascadingParameter(Name = "ClientForwarded")]
    public bool ClientForwarded { get; set; }

    // The visitor's connection address, set by the host page. Used only to limit setup-code and password guesses.
    [CascadingParameter(Name = "ClientAddress")]
    public string? ClientAddress { get; set; }

    // Set by the host page when sign-in and setup cannot work from where this visitor is (no usable address, or a
    // reverse proxy pointed at the main port). Never read from the browser.
    [CascadingParameter(Name = "ClientSignInRefusal")]
    public string? ClientSignInRefusal { get; set; }

    // Why the last guess was refused, so the visitor is told the real reason (wait, versus not available from here).
    private string _guessRefusal = SignInAttemptLimiter.TooManyAttemptsMessage;

    // Counts one guess for this visitor's address. A remote visitor without a usable address is refused, because
    // there is no fair bucket to count it in; a visitor on this computer or the home network without one is allowed.
    private bool TryCountGuess()
    {
        var kind = MediaEngine.Web.Services.Configuration.IngressClassifierExtensions.FromWireValue(ClientIngress);
        var address = System.Net.IPAddress.TryParse(ClientAddress, out var parsed) ? parsed : null;
        var outcome = SignInLimiter.Acquire(address, kind, out _);
        _guessRefusal = outcome == SignInAttemptResult.AddressUnknown
            ? SignInAttemptLimiter.AddressUnknownMessage
            : SignInAttemptLimiter.TooManyAttemptsMessage;
        return outcome == SignInAttemptResult.Allowed;
    }

    // The address this page was routed with (see RoutedPageQuery).
    [CascadingParameter(Name = RoutedPageQuery.CascadingName)]
    public string? RoutedUri { get; set; }

    public string? RequestedStep => RoutedPageQuery.From(RoutedUri ?? Navigation.Uri).String("step");

    private string WorkflowStep => NormalizeStep(_status?.CurrentStep);
    private string CurrentStep => _selectedStep ?? WorkflowStep;
    // The Vault entry is wired in with the Libraries step; until then Back, Next and the sidebar pass over it.
    // The Vault is an optional step: it is walked only while it is being offered, and its entry is drawn only until the person says Not now.
    private string[] NavigableSteps => SetupWorkflow.StepKeys.Where(key => key != "vault" || VaultOpen).ToArray();
    private bool VaultOpen => _vaultProfileId is not null && StepState("vault") is not ("passed" or "deferred");
    private bool ShowVault => _vaultProfileId is not null && StepState("vault") != "deferred";
    private Guid? _vaultProfileId;
    private bool _vaultProfileHasPin;
    private int CurrentIndex => Math.Max(0, Array.IndexOf(NavigableSteps, CurrentStep));
    private bool PasswordsMatch => string.Equals(_password, _passwordConfirmation, StringComparison.Ordinal);
    private string PageTitleText => CurrentStep == "welcome" ? "Welcome to your library" : Friendly(CurrentStep);
    private string PageSubtitle => CurrentStep switch
    {
        "welcome" => "Choose your language and give this server a name.",
        "tools" => "Check the tools Library needs on this server.",
        "profile" => "Create the first authenticated administrator and household profile.",
        "libraries" => "Connect read-only sources separately from storage Library may manage.",
        "metadata" => "Connect the metadata services that make each media lane useful.",
        _ => "Review what passed, what was deferred, and anything that still needs repair.",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var stored = await Storage.GetAsync<string>(SetupSessionKey);
            _setupSession = stored.Success ? stored.Value : null;
        }
        catch { _setupSession = null; }
        _authenticated = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true;
        await ReloadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_status is not null
            && SetupWorkflow.StepKeys.Contains(RequestedStep, StringComparer.Ordinal)
            && CanNavigateTo(RequestedStep!))
        {
            _selectedStep = RequestedStep;
            if (RequestedStep == "done") _readiness = null;
            await EnsureCurrentStageDataAsync();
        }
    }

    private async Task ReloadAsync()
    {
        _status = await ApiClient.GetSetupStatusAsync();
        if (_status?.RequiresSetupStart == true && !_authenticated && !_setupSessionReadyForCircuit)
        {
            if (!string.IsNullOrWhiteSpace(_setupSession)
                && await ApiClient.GetSetupLocaleAsync(_setupSession) is not null)
            {
                // The session kept in this browser is still valid, so no new code is needed.
                _setupSessionReadyForCircuit = true;
            }
            else
            {
                var submittedCode = _setupCode.Trim();
                if (ClientSignInRefusal is not null)
                {
                    // Nothing to count or send: setup cannot start from this address. The page explains why.
                    _loading = false;
                    StateHasChanged();
                    return;
                }

                if (MediaEngine.Web.Services.Configuration.IngressClassifierExtensions.FromWireValue(ClientIngress)
                    == MediaEngine.Web.Services.Configuration.IngressKind.Remote)
                {
                    // The Engine refuses setup from anywhere remote, with or without a code. Saying so here means a
                    // remote visitor never spends the Engine's shared Dashboard allowance that home setup relies on.
                    _remoteRefused = true;
                    _codeRequired = false;
                    _codeMessage = null;
                    _loading = false;
                    StateHasChanged();
                    return;
                }

                // Only a submitted code is a guess. Loading the page, or starting with no code, checks nothing the
                // visitor could be guessing at, so it must not use up their allowance.
                if (submittedCode.Length > 0 && !TryCountGuess())
                {
                    // Distinct from "could not be reached": the visitor is told to wait, and the code step stays open.
                    _codeMessage = _guessRefusal;
                    _preflightError = _codeRequired ? null : _guessRefusal;
                    _loading = false;
                    StateHasChanged();
                    return;
                }

                var outcome = await ApiClient.BeginSetupAsync(new SetupBeginRequest
                {
                    OriginalClientIngress = ClientIngress ?? ClientIngressValues.Remote,
                    SetupCode = submittedCode.Length == 0 ? null : submittedCode,
                });
                if (outcome.Started is { } started)
                {
                    _setupSession = started.SetupSessionToken;
                    await Storage.SetAsync(SetupSessionKey, _setupSession);
                    _status = started.Status;
                    _setupSessionReadyForCircuit = true;
                    _codeRequired = _remoteRefused = false;
                    _codeMessage = null;
                    _setupCode = string.Empty;
                }
                else if (outcome.Refusal is { } refusal)
                {
                    _remoteRefused = refusal.Reason == SetupBeginRefusalReasons.RemoteRefused;
                    _codeRequired = !_remoteRefused;
                    _codeMessage = submittedCode.Length == 0 ? null : refusal.Message;
                    _loading = false;
                    StateHasChanged();
                    return;
                }
                else
                {
                    _preflightError = "Setup could not start. The server rejected the request or could not be reached. Retry the checks.";
                    _loading = false;
                    StateHasChanged();
                    return;
                }
            }
        }
        _loading = false;
        if (_status?.State == "complete")
        {
            Navigation.NavigateTo(_authenticated ? "/" : "/auth/login", forceLoad: true, replace: true);
            return;
        }
        if (_status?.RequiresAuthentication == true && !_authenticated && _status.CurrentStep != "profile")
        {
            Navigation.NavigateTo("/auth/login?returnUrl=%2Fsetup", forceLoad: true);
            return;
        }
        if (_selectedStep is null && SetupWorkflow.StepKeys.Contains(RequestedStep, StringComparer.Ordinal) && CanNavigateTo(RequestedStep!))
            _selectedStep = RequestedStep;
        StateHasChanged();
        await EnsureCurrentStageDataAsync();
        StateHasChanged();
    }

    private async Task SubmitSetupCodeAsync()
    {
        _codeBusy = true;
        try { await ReloadAsync(); }
        finally { _codeBusy = false; }
    }

    private async Task EnsureCurrentStageDataAsync()
    {
        if (CurrentStep == "welcome" && !_serverIdentityLoaded && !_busy)
        {
            var identity = await ApiClient.GetSetupServerIdentityAsync(_setupSession);
            if (identity is not null)
            {
                _serverName = identity.ServerName;
                _hostName = identity.HostName;
                _serverIdentityLoaded = true;
            }
            _locale ??= await ApiClient.GetSetupLocaleAsync(_setupSession);
        }
        if (CurrentStep == "tools" && _preflight is null && _preflightError is null && !_showRestore && !_busy)
        {
            await RunPreflightAsync();
            return;
        }
        if (CurrentStep == "libraries" && _setupLibraries is null)
            _setupLibraries = await ApiClient.GetSetupLibrariesAsync(_setupSession);
        if (CurrentStep == "metadata" && !_providersLoaded && !_busy)
        {
            _locale = await ApiClient.GetSetupLocaleAsync(_setupSession);
            _setupLibraries = await ApiClient.GetSetupLibrariesAsync(_setupSession);
            await LoadProvidersAsync();
            _providersLoaded = true;
        }
        if (CurrentStep == "done" && _readiness is null && !_busy)
            await LoadReadinessAsync();
    }

    // Welcome saves the display language, the region and the server name together: the language first, so a failure there leaves
    // the step open, then the name, which is what passes the step.
    private async Task SaveWelcomeAsync()
    {
        _busy = true;
        try
        {
            if (_locale is null || await ApiClient.SaveSetupLocaleAsync(_locale, _setupSession) is null)
            {
                Snackbar.Add("Language settings could not be saved. Please retry.", AppSeverity.Error);
                return;
            }

            var saved = await ApiClient.SaveSetupServerIdentityAsync(new SetupServerIdentityDto(_serverName, _hostName), _setupSession);
            if (saved is null) { Snackbar.Add("The server name could not be saved. Use 1 to 64 characters.", AppSeverity.Error); return; }
            _serverName = saved.ServerName;
            _hostName = saved.HostName;
        }
        finally { _busy = false; }
        _selectedStep = null;
        _ = StartBackgroundCheckAsync();
        await ReloadAsync();
    }

    private async Task RunPreflightAsync()
    {
        _busy = true;
        StateHasChanged();
        _preflightError = null;
        try
        {
            _preflight = await ApiClient.RunSetupPreflightAsync(_setupSession);
            if (_preflight is null)
                _preflightError = "Library could not get ready. The server did not answer the request. Check that it is running, then try again.";
        }
        catch (Exception)
        {
            _preflightError = "Library could not finish getting ready. Try again.";
        }
        finally { _busy = false; }
        // A missing Required tool the Library can fetch (FFmpeg) is already downloading; show its progress until it ends.
        if (_preflight is { Passed: true } && SetupToolRules.IsDownloadingRequiredTool(_preflight.Tools))
        {
            StateHasChanged();
            await FollowToolDownloadsAsync();
        }
    }

    // The Tools step is always shown, even when every tool is ready; Continue is what passes it, and a missing tool never blocks it.
    // Every missing optional tool still ticked "Download now" starts its download here; the downloads finish in the background.
    private async Task ContinuePastToolsAsync()
    {
        foreach (var tool in SetupToolRules.ListedTools(_preflight?.Tools))
        {
            if (SetupToolRules.Action(tool) != SetupToolAction.Download || _skippedDownloads.Contains(tool.Id)) continue;
            try { await ApiClient.InstallToolAsync(tool.Id); }
            catch (Exception ex) { Logger.LogWarning(ex, "Setup could not start the {Tool} download", tool.Id); }
        }
        await DecideStepAsync("tools", "passed", "Tools reviewed during first-run setup.");
    }

    private readonly HashSet<string> _skippedDownloads = new(StringComparer.Ordinal);

    private Task DownloadChanged((string ToolId, bool Download) change)
    {
        if (change.Download) _skippedDownloads.Remove(change.ToolId); else _skippedDownloads.Add(change.ToolId);
        return Task.CompletedTask;
    }

    // Welcome starts the server check in the background so the Tools step already has its answers; a failure here just leaves the
    // check to run again when the Tools step opens.
    private async Task StartBackgroundCheckAsync()
    {
        try
        {
            var result = await ApiClient.RunSetupPreflightAsync(_setupSession);
            if (result is not null && _preflight is null) _preflight = result;
        }
        catch (Exception ex) { Logger.LogWarning(ex, "The background server check could not run"); }
        await InvokeAsync(StateHasChanged);
    }

    private static readonly TimeSpan ToolPollInterval = TimeSpan.FromSeconds(1.5);
    private readonly CancellationTokenSource _closed = new();

    // Reads the tools list every moment or so while a download runs. It stops when the download ends, the Engine cannot be
    // reached (Check again tries once more) or the person leaves the page.
    private async Task FollowToolDownloadsAsync()
    {
        var token = _closed.Token;
        try
        {
            while (true)
            {
                var current = _preflight;
                if (current is null || !SetupToolRules.IsDownloadingRequiredTool(current.Tools))
                {
                    return;
                }

                await Task.Delay(ToolPollInterval, token);
                var fresh = await ApiClient.GetSetupToolRequirementsAsync(_setupSession, token);
                if (fresh is null)
                {
                    return;
                }

                _preflight = current with { Tools = fresh };
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // The person left the page; nothing is waiting on the result.
        }
    }

    public void Dispose()
    {
        _closed.Cancel();
        _closed.Dispose();
    }
    private async Task RunPreflightManualAsync()
    {
        _preflightError = null;
        if (!_setupSessionReadyForCircuit && !_authenticated)
            await ReloadAsync();
        else
            await RunPreflightAsync();
    }
    private void CancelRestore() { _showRestore = false; _backup = null; _backupError = null; }
    private async Task UploadBackupAsync(InputFileChangeEventArgs args) { _busy = true; try { await using var stream = args.File.OpenReadStream(2L * 1024 * 1024 * 1024); _backupError = null; _backup = await ApiClient.UploadSetupBackupAsync(stream, args.File.Name, _setupSession ?? string.Empty); if (_backup is null) { _backupError = ApiClient.LastError is { Length: > 0 } sentence ? sentence : "The backup failed validation."; Snackbar.Add(_backupError, AppSeverity.Error); } } finally { _busy = false; } }
    private async Task ConfirmRestoreAsync() { if (_backup is null || _setupSession is null) return; _busy = true; var result = await ApiClient.ConfirmSetupRestoreAsync(_backup.OperationId, _setupSession); _busy = false; if (result is null) Snackbar.Add("The restore could not be scheduled.", AppSeverity.Error); else Snackbar.Add("Restore scheduled. Library is restarting.", AppSeverity.Info); }
    // The no-password start is offered to a visitor on this computer or the home network, never to one a tunnel or
    // proxy may be relaying. The Engine checks all of this again.
    private bool ThisComputerAvailable =>
        MediaEngine.Web.Services.Configuration.IngressClassifierExtensions.FromWireValue(ClientIngress) != MediaEngine.Web.Services.Configuration.IngressKind.Remote
        && !ClientForwarded;
    // "Just my name" is the recommended default on this computer; anywhere else the password choice is the only one.
    private bool UsesThisComputer => ThisComputerAvailable && _signInMode != SetupSignInModes.Password;
    private string _signInMode = string.Empty;
    private string? _signInNotice;
    private Task SignInModeChangedAsync(string mode) { _signInMode = mode; _signInNotice = null; return Task.CompletedTask; }
    private async Task CreateAdministratorAsync()
    {
        if (_setupSession is null || !PasswordsMatch) { Snackbar.Add("Enter the same password twice.", AppSeverity.Error); return; }
        if (!TryCountGuess()) { Snackbar.Add(_guessRefusal, AppSeverity.Error); return; }
        _busy = true;
        var outcome = await ApiClient.CreateSetupAdministratorAsync(new SetupAdministratorRequest
        {
            SignIn = UsesThisComputer ? SetupSignInModes.ThisComputer : SetupSignInModes.Password,
            OriginalClientIngress = ClientForwarded ? ClientIngressValues.Remote : (ClientIngress ?? ClientIngressValues.Remote),
            Email = _email, Password = UsesThisComputer ? string.Empty : _password,
            Pin = UsesThisComputer || string.IsNullOrEmpty(_pin) ? null : _pin,
            DisplayName = _displayName, DeviceId = Guid.NewGuid().ToString("D"), DeviceName = "Setup browser",
        }, _setupSession);
        _busy = false;
        var result = outcome.Created;
        if (result is null)
        {
            if (UsesThisComputer && outcome.Code == SetupAdministratorRefusalCodes.NotAvailableHere) _signInNotice = "Starting without a password only works on the computer that runs Library. Choose another way to set a password instead.";
            else Snackbar.Add("The administrator could not be created.", AppSeverity.Error);
        }
        else
        {
            await ClearSetupSessionAsync();
            var signedIn = await SignInInlineAsync(result);
            if (!signedIn) { SignIn(); return; }
            if (result.RecoveryCodes.Count > 0) _recoveryCodes = result.RecoveryCodes;
            else await ContinueAfterProfileAsync();
        }
    }

    // Signs the person in without leaving this page: the circuit takes the Engine's session for its own calls, and the browser's
    // cookie is set by redeeming a one-time code (SetupSignInHandoff), so a reload or a later visit is signed in too.
    private async Task<bool> SignInInlineAsync(SetupAdministratorResponse created)
    {
        if (created.Session is not { } issued) return false;
        try
        {
            var code = SignInHandoff.Issue(issued);
            await using var module = await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import", "./js/setup-signin.js");
            if (!await module.InvokeAsync<bool>("redeem", code)) return false;
        }
        catch (Exception) { return false; }
        DashboardSession.Set(issued.SessionToken, issued.AccountId, issued.ActiveProfileId, issued.SessionId, issued.Authority);
        _authenticated = true;
        return true;
    }

    private async Task ContinueAfterProfileAsync()
    {
        _recoveryCodes = [];
        _selectedStep = null;
        await ReloadAsync();
    }
    private async Task ClearSetupSessionAsync() { _setupSession = null; try { await Storage.DeleteAsync(SetupSessionKey); } catch { _setupSession = null; } }
    private void SignIn() => Navigation.NavigateTo("/auth/login?returnUrl=%2Fsetup", forceLoad: true);
    private async Task ValidateMediaAsync()
    {
        _busy = true;
        _media = await ApiClient.ValidateSetupMediaLocationsAsync(_setupSession);
        _busy = false;
        if (_media?.Passed != true) return;
        _readiness = null;
        await ReloadAsync();
        await OfferVaultAsync();
    }

    // After Libraries, the first administrator on a desktop or tablet with no Vault yet is offered it once, as its own step; everyone else sees nothing about it.
    private async Task OfferVaultAsync()
    {
        if (StepState("vault") is "passed" or "deferred") return;
        var profile = await SetupVaultEligibility.FindProfileAsync(ApiClient, DashboardSession, Identity, Nsfw, DeviceContext, AuthenticationStateProvider);
        if (profile is null) return;
        _vaultProfileId = profile.Id;
        _vaultProfileHasPin = profile.HasPin;
        _selectedStep = "vault";
    }

    private Task VaultFinishedAsync(bool turnedOn) => DecideStepAsync("vault", turnedOn ? "passed" : "deferred", turnedOn ? "The Vault was turned on during setup." : "The Vault was left for later.");
    // The Libraries panel saves each folder as it is added; the person moves on with Continue.
    private async Task LibraryCreatedAsync() { _setupLibraries = await ApiClient.GetSetupLibrariesAsync(_setupSession); }
    private async Task LoadProvidersAsync() { _busy = true; _providerCatalogue = await ApiClient.GetProviderCatalogueAsync(); _busy = false; }
    private async Task RefreshProvidersAsync() { _providerCatalogue = await ApiClient.GetProviderCatalogueAsync(); }
    private async Task SaveProviderResultAsync()
    {
        if (_locale is null || await ApiClient.SaveSetupLocaleAsync(_locale, _setupSession) is null)
        {
            Snackbar.Add("Language settings could not be saved. Please retry.", AppSeverity.Error);
            return;
        }
        await DecideStepAsync("metadata", "passed", "Language and provider setup reviewed.");
    }
    private Task DeferMediaAsync() => DecideStepAsync("libraries", "deferred", "Media folders can be added later in Settings · Libraries.");
    private async Task DeferProviderResultAsync()
    {
        if (_locale is null || await ApiClient.SaveSetupLocaleAsync(_locale, _setupSession) is null)
        {
            Snackbar.Add("Language settings could not be saved. Please retry.", AppSeverity.Error);
            return;
        }
        await DecideStepAsync("metadata", "deferred", "Languages saved; optional provider credentials deferred.");
    }
    private async Task DecideStepAsync(string step, string status, string detail) { _status = await ApiClient.DecideSetupStepAsync(step, status, detail, _setupSession); _selectedStep = null; _readiness = null; if (_status is null) Snackbar.Add("The setup choice could not be saved.", AppSeverity.Error); else await EnsureCurrentStageDataAsync(); }
    private async Task LoadReadinessAsync()
    {
        _busy = true;
        _readinessFailed = false;
        try
        {
            // The notes about optional tools come from the check setup ran at the start; look again if the page was reloaded since.
            _preflight ??= await ApiClient.RunSetupPreflightAsync(_setupSession);
            _readiness = await ApiClient.GetSetupReadinessAsync(_setupSession);
        }
        catch (Exception)
        {
            _readiness = null;
        }
        finally { _busy = false; }

        // Without an answer (a browser that is not signed in, or an Engine that did not reply) the page says so and offers a retry, never a spinner.
        _readinessFailed = _readiness is null;
    }
    private async Task RetryReadinessAsync()
    {
        _readiness = null;
        await LoadReadinessAsync();
    }
    private async Task InstallOptionalToolAsync(ToolRequirementDto tool)
    {
        bool started;
        try { started = (await ApiClient.InstallToolAsync(tool.Id)).Success; }
        catch (Exception) { started = false; }
        if (started) Snackbar.Add($"Downloading {tool.Name}. Library finishes this in the background.", AppSeverity.Info);
        else Snackbar.Add($"The download of {tool.Name} could not start. You can try again from Settings, System, Configuration.", AppSeverity.Warning);
        _preflight = await ApiClient.RunSetupPreflightAsync(_setupSession) ?? _preflight;
    }
    private async Task RunToolInstallerAsync(ToolRequirementDto tool)
    {
        bool started;
        try { started = (await ApiClient.RunToolInstallerAsync(tool.Id)).Success; }
        catch (Exception) { started = false; }
        if (started) Snackbar.Add($"The {tool.Name} installer is running. Finish it, then check again.", AppSeverity.Info);
        else Snackbar.Add($"The {tool.Name} installer could not start from here. After setup, open Settings, System, Configuration and choose Run installer.", AppSeverity.Warning);
        _preflight = await ApiClient.RunSetupPreflightAsync(_setupSession) ?? _preflight;
    }
    private async Task SampleScanAsync() { _busy = true; var result = await ApiClient.TriggerScanAsync(); _busy = false; _sampleScanDetail = result is null ? "The dry-run scan could not start. Use the media-location repair link to check the configured source." : $"Dry run found {result.TotalCount} pending file operation{(result.TotalCount == 1 ? string.Empty : "s")}. No files were changed."; }
    private async Task CompleteAsync() { _busy = true; var result = await ApiClient.CompleteSetupAsync(_setupSession); _busy = false; if (result?.State == "complete") { await Nsfw.LockAsync(); try { await Storage.DeleteAsync(SetupSessionKey); } catch { _setupSession = null; } Navigation.NavigateTo(_authenticated ? "/" : "/auth/login", forceLoad: true); } else Snackbar.Add("Required setup checks are still blocked.", AppSeverity.Error); }
    private string StepState(string key) => _status?.Steps.FirstOrDefault(step => step.Key == key)?.Status ?? "not_started";
    private bool CanNavigateTo(string key) => (key != "vault" || VaultOpen)
        && (Array.IndexOf(SetupWorkflow.StepKeys, key) <= Array.IndexOf(SetupWorkflow.StepKeys, WorkflowStep) || StepState(key) is "passed" or "deferred");
    private async Task GoToStepAsync(string key)
    {
        if (CanNavigateTo(key)) { _selectedStep = key; if (key == "done") _readiness = null; await EnsureCurrentStageDataAsync(); }
    }
    private async Task GoNextAsync() { var index = Math.Min(NavigableSteps.Length - 1, CurrentIndex + 1); _selectedStep = NavigableSteps[index]; await EnsureCurrentStageDataAsync(); }
    private async Task GoBackAsync() { var index = Math.Max(0, CurrentIndex - 1); _selectedStep = NavigableSteps[index]; await EnsureCurrentStageDataAsync(); }
    private void ReturnToCurrentStep() => _selectedStep = null;
    private static string NormalizeStep(string? step) => SetupWorkflow.StepKeys.Contains(step, StringComparer.Ordinal) ? step! : "welcome";
    private static string Friendly(string value) => string.Join(' ', value.Replace('_', '-').Split('-', StringSplitOptions.RemoveEmptyEntries).Select(part => char.ToUpperInvariant(part[0]) + part[1..]));
}
