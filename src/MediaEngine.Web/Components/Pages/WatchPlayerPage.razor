@page "/watch/player/{WorkId:guid}"
@implements IDisposable
@using MediaEngine.Contracts.Details
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Web.Components.Watch

@namespace MediaEngine.Web.Components.Pages

@inject IEngineApiClient ApiClient
@inject UIOrchestratorService Orchestrator
@inject PlaybackSessionController Playback

<PageTitle>@((_detail?.Title ?? "Player")) - Tuvima Library</PageTitle>

@if (_loading)
{
    <AppPageState Kind="AppPageStateKind.Loading"
                  Title="Preparing playback"
                  Class="watch-player-state" />
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="watch-player-state">
        <AppErrorState Title="Playable video not found"
                       Message="Tuvima Library could not prepare this title for playback."
                       Details="@_loadError"
                       Retry="LoadPlayerAsync"
                       Icon="@AppMaterialIcons.Outlined.Movie" />
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "restart")] public bool Restart { get; set; }
    [Parameter] public Guid WorkId { get; set; }
    [SupplyParameterFromQuery(Name = "collectionId")] public Guid? CollectionId { get; set; }

    private LibraryItemDetailViewModel? _detail;
    private string? _loadError;
    private bool _loading = true;
    private CancellationTokenSource? _loadCancellation;
    public void Dispose() => _loadCancellation?.Cancel();

    protected override async Task OnParametersSetAsync()
        => await LoadPlayerAsync();

    private async Task LoadPlayerAsync()
    {
        _loadCancellation?.Cancel();
        using var request = new CancellationTokenSource();
        _loadCancellation = request;
        var ct = request.Token;
        Playback.ReservePlaybackRequest();
        var version = Playback.PlaybackRequestVersion;
        void CheckCurrent()
        {
            ct.ThrowIfCancellationRequested();
            if (version != Playback.PlaybackRequestVersion) throw new OperationCanceledException();
        }
        try
        {
        _loading = true;
        _loadError = null;
        StateHasChanged();

        if (!Restart && Playback.IsVideoMode && Playback.CurrentItem?.WorkId == WorkId)
        {
            _detail = await ApiClient.GetLibraryItemDetailAsync(WorkId, ct);
        CheckCurrent();
            Playback.SetVideoExpanded(true);
            _loading = false;
            return;
        }

        var detailTask = ApiClient.GetLibraryItemDetailAsync(WorkId, ct);
        var assetTask = Orchestrator.ResolveWorkToAssetAsync(WorkId, ct);
        await Task.WhenAll(detailTask, assetTask);
        CheckCurrent();

        _detail = detailTask.Result;
        var assetId = assetTask.Result;
        if (_detail is null || !assetId.HasValue)
        {
            _loadError = ApiClient.LastError ?? Orchestrator.LastApiError ?? "No playable local video asset is linked to this item.";
            _loading = false;
            return;
        }

        var item = CreateVideoItem(WorkId, _detail, assetId.Value, Restart);
        _loading = false;
        StateHasChanged();
        await Playback.PlayVideoAsync(item, _detail.ShowName ?? _detail.Series ?? _detail.Title, ct);
        var activeRequestVersion = Playback.PlaybackRequestVersion;
        if (!string.IsNullOrWhiteSpace(_detail.EpisodeNumber))
        {
            try
            {
                var episodePage = await ApiClient.GetDetailPageAsync(
                    DetailEntityType.TvEpisode, WorkId, DetailPresentationContext.Watch, ct: ct);
                ct.ThrowIfCancellationRequested();
                if (Playback.CurrentItem?.WorkId == WorkId && Playback.PlaybackRequestVersion == activeRequestVersion)
                {
                    Playback.TrySetCurrentVideoEpisodeTitle(WorkId, activeRequestVersion, episodePage?.Title);
                }
                var added = 0;
                foreach (var nextId in OwnedEpisodeQueuePlanner.NextPlayableCandidates(episodePage?.SequencePlacement, WorkId, limit: 12))
                {
                    if (Playback.CurrentItem?.WorkId != WorkId || Playback.PlaybackRequestVersion != activeRequestVersion) break;
                    var nextAssetId = await Orchestrator.ResolveWorkToAssetAsync(nextId, ct);
                    ct.ThrowIfCancellationRequested();
                    if (nextAssetId is not Guid playableAssetId) continue;
                    // Episodes covered by the file now playing share its asset; queueing them would replay it.
                    if (playableAssetId == assetId.Value) continue;
                    var nextDetail = await ApiClient.GetLibraryItemDetailAsync(nextId, ct);
                    ct.ThrowIfCancellationRequested();
                    if (nextDetail is null || string.IsNullOrWhiteSpace(nextDetail.EpisodeNumber)) continue;
                    if (!await Playback.AppendVideoNextUpAsync(
                        CreateVideoItem(nextId, nextDetail, playableAssetId, restart: false), WorkId, activeRequestVersion, ct))
                        break;
                    if (++added == 3) break;
                }
            }
            catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
            catch (Exception) { /* Next Up enrichment is optional after playback has started. */ }
        }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { if (!ct.IsCancellationRequested) _loadError = ex.Message; }
        finally
        {
            if (ReferenceEquals(_loadCancellation, request)) { _loading = false; _loadCancellation = null; }
        }
    }

    private ListenQueueItem CreateVideoItem(Guid workId, LibraryItemDetailViewModel detail, Guid assetId, bool restart) => new()
    {
        WorkId = workId,
        CollectionId = CollectionId,
        MediaType = MediaKindClassifier.IsVideo(detail.MediaType) ? detail.MediaType : "Movie",
        Title = StringHelpers.FirstNonBlankOr("Video", detail.EpisodeTitle, detail.Title, detail.ShowName, "Video"),
        Subtitle = StringHelpers.FirstNonBlank(detail.EpisodeTitle, detail.Director, detail.Year),
        Album = StringHelpers.FirstNonBlank(detail.ShowName, detail.Series),
        Year = detail.Year,
        ContentRating = detail.Rating,
        SeasonNumber = detail.SeasonNumber,
        EpisodeNumber = detail.EpisodeNumber,
        EpisodeTitle = detail.EpisodeTitle,
        Quality = detail.PlaybackSummary?.VideoResolutionLabel,
        CoverUrl = detail.CoverUrl,
        Duration = PlaybackVideoRuntime.NormalizeLibraryDetailRuntime(detail.Runtime),
        AssetId = assetId,
        InitialPositionSeconds = restart ? 0 : null,
        StartAtExactPosition = restart,
    };
}
