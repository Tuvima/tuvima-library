@page "/watch/player/{WorkId:guid}"
@implements IDisposable
@using MediaEngine.Contracts.Details
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Playback

@namespace MediaEngine.Web.Components.Pages

@inject IEngineApiClient ApiClient
@inject UIOrchestratorService Orchestrator
@inject PlaybackSessionController Playback
@inject NavigationManager Nav

<PageTitle>@((_detail?.Title ?? "Player")) - Tuvima Library</PageTitle>

@if (_loading)
{
    <AppPageState Kind="AppPageStateKind.Loading"
                  Title="Preparing playback"
                  Class="watch-player-state" />
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="watch-player-state">
        <AppErrorState Title="Playable video not found"
                       Message="Tuvima Library could not prepare this title for playback."
                       Details="@_loadError"
                       Retry="LoadPlayerAsync"
                       Icon="@Icons.Material.Outlined.Movie" />
    </div>
}
else
{
    <section class="watch-player-launch">
        @if (!string.IsNullOrWhiteSpace(LaunchArtworkUrl))
        {
            <img class="watch-player-launch__artwork"
                 src="@LaunchArtworkUrl"
                 alt=""
                 aria-hidden="true" />
        }
        <div class="watch-player-launch__scrim"></div>
        <div class="watch-player-launch__content">
            <span>@VideoContext</span>
            <h1>@(_detail?.ShowName ?? _detail?.Title ?? "Now playing")</h1>
            @if (!string.IsNullOrWhiteSpace(_detail?.EpisodeTitle))
            {
                <p>@_detail.EpisodeTitle</p>
            }
            <div class="watch-player-launch__actions">
                <AppNativeButton Type="button" Class="watch-player-button watch-player-button--primary" OnClick="@(() => Playback.SetVideoExpanded(true))">
                    <MudIcon Icon="@Icons.Material.Filled.PlayArrow" />
                    <span>Return to video</span>
                </AppNativeButton>
                <AppNativeButton Type="button" Class="watch-player-button watch-player-button--secondary" OnClick="GoBack">
                    <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" />
                    <span>Back to details</span>
                </AppNativeButton>
            </div>
        </div>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "restart")] public bool Restart { get; set; }
    [Parameter] public Guid WorkId { get; set; }
    [SupplyParameterFromQuery(Name = "collectionId")] public Guid? CollectionId { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private LibraryItemDetailViewModel? _detail;
    private string? _loadError;
    private bool _loading = true;
    private CancellationTokenSource? _loadCancellation;
    public void Dispose() => _loadCancellation?.Cancel();

    private string VideoContext
    {
        get
        {
            if (_detail is null)
            {
                return "Now playing";
            }

            if (!string.IsNullOrWhiteSpace(_detail.SeasonNumber)
                && !string.IsNullOrWhiteSpace(_detail.EpisodeNumber))
            {
                return $"S{_detail.SeasonNumber} E{_detail.EpisodeNumber}";
            }

            return StringHelpers.FirstNonBlankOr("Now playing", _detail.Year, _detail.MediaType, "Now playing");
        }
    }

    private string? LaunchArtworkUrl
        => _detail?.BackgroundUrl ?? _detail?.BannerUrl ?? _detail?.HeroUrl ?? _detail?.CoverUrl;

    protected override async Task OnParametersSetAsync()
        => await LoadPlayerAsync();

    private async Task LoadPlayerAsync()
    {
        _loadCancellation?.Cancel();
        using var request = new CancellationTokenSource();
        _loadCancellation = request;
        var ct = request.Token;
        Playback.ReservePlaybackRequest();
        var version = Playback.PlaybackRequestVersion;
        void CheckCurrent()
        {
            ct.ThrowIfCancellationRequested();
            if (version != Playback.PlaybackRequestVersion) throw new OperationCanceledException();
        }
        try
        {
        _loading = true;
        _loadError = null;
        StateHasChanged();

        if (!Restart && Playback.IsVideoMode && Playback.CurrentItem?.WorkId == WorkId)
        {
            _detail = await ApiClient.GetLibraryItemDetailAsync(WorkId, ct);
        CheckCurrent();
            Playback.SetVideoExpanded(true);
            _loading = false;
            return;
        }

        var detailTask = ApiClient.GetLibraryItemDetailAsync(WorkId, ct);
        var assetTask = Orchestrator.ResolveWorkToAssetAsync(WorkId, ct);
        await Task.WhenAll(detailTask, assetTask);
        CheckCurrent();

        _detail = detailTask.Result;
        var playerCoverUrl = _detail?.CoverUrl;
        var assetId = assetTask.Result;
        if (_detail is null || !assetId.HasValue)
        {
            _loadError = ApiClient.LastError ?? Orchestrator.LastApiError ?? "No playable local video asset is linked to this item.";
            _loading = false;
            return;
        }

        var mediaType = MediaKindClassifier.IsVideo(_detail.MediaType)
            ? _detail.MediaType
            : "Movie";
        var item = new ListenQueueItem
        {
            WorkId = WorkId,
            CollectionId = CollectionId,
            MediaType = mediaType,
            Title = StringHelpers.FirstNonBlankOr("Video", _detail.ShowName, _detail.Title, "Video"),
            Subtitle = StringHelpers.FirstNonBlank(_detail.EpisodeTitle, _detail.Director, _detail.Year),
            Album = StringHelpers.FirstNonBlank(_detail.ShowName, _detail.Series),
            Year = _detail.Year,
            ContentRating = _detail.Rating,
            SeasonNumber = _detail.SeasonNumber,
            EpisodeNumber = _detail.EpisodeNumber,
            EpisodeTitle = _detail.EpisodeTitle ?? (_detail.ShowName is not null ? _detail.Title : null),
            Quality = _detail.PlaybackSummary?.VideoResolutionLabel,
            CoverUrl = playerCoverUrl,
            Duration = _detail.Runtime,
            AssetId = assetId,
            StreamUrl = null,
            InitialPositionSeconds = Restart ? 0 : null,
            StartAtExactPosition = Restart,
        };

        _loading = false;
        StateHasChanged();
        await Playback.PlayVideoAsync(item, _detail.ShowName ?? _detail.Series ?? _detail.Title, ct);
        _loading = false;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { if (!ct.IsCancellationRequested) _loadError = ex.Message; }
        finally
        {
            if (ReferenceEquals(_loadCancellation, request)) { _loading = false; _loadCancellation = null; }
        }
    }

    private void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            Nav.NavigateTo(ReturnUrl);
            return;
        }

        if (CollectionId.HasValue)
        {
            Nav.NavigateTo($"/details/tvshow/{CollectionId.Value:D}?context=watch");
            return;
        }

        var entityType = !string.IsNullOrWhiteSpace(_detail?.SeasonNumber)
            || !string.IsNullOrWhiteSpace(_detail?.EpisodeNumber)
                ? "tvepisode"
                : "movie";
        Nav.NavigateTo($"/details/{entityType}/{WorkId:D}?context=watch");
    }
}
