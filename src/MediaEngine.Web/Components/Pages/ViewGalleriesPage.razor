@page "/view/galleries"
@using MediaEngine.Domain.PersonalMedia
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Navigation
@inject GalleryEditorLauncherService GalleryEditorLauncher
@inject NavigationManager Nav
@inject DeviceContextService DeviceContext
@inject ViewWorkspaceService Workspace
@namespace MediaEngine.Web.Components.Pages
@inject IStringLocalizer<SharedStrings> L

<PageTitle>@L["ViewGalleriesPage_GalleriesLibrary"]</PageTitle>
<ViewSectionShell>
    <ViewContentPage Title="@L["Common_Galleries"].Value" Subtitle="@L["ViewGalleriesPage_OrganizePersonalPhotosAndVideos"].Value">
        <HeaderActions>
            @if (DeviceContext.CanEdit)
            {
                <AppButton ButtonStyle="AppButtonStyle.Outlined" OnClick='@(() => OpenEditorAsync("Smart"))'><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.AutoAwesome" /> @L["ViewGalleriesPage_SmartGallery"]</AppButton>
                <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick='@(() => OpenEditorAsync("Manual"))'><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Add" /> @L["Common_NewGallery"]</AppButton>
            }
        </HeaderActions>
        <ChildContent>
        @if (_loading)
        {
            <AppPageState Kind="AppPageStateKind.Loading" Title="@L["ViewGalleriesPage_LoadingGalleries"].Value" Message="@L["ViewGalleriesPage_OpeningYourGalleries"].Value" />
        }
        else if (Workspace.OwnedGalleries.Count == 0 && Workspace.SharedGalleries.Count == 0)
        {
            <AppPageState Kind="AppPageStateKind.Empty" Title="@L["ViewGalleriesPage_NoGalleriesYet"].Value" Message="@L["ViewGalleriesPage_CreateAManualGalleryOr"].Value" />
        }
        else
        {
            @if (Workspace.OwnedGalleries.Count > 0)
            {
                <section><h2>@L["ViewGalleriesPage_MyGalleries"]</h2><div class="view-gallery-grid">@foreach (var gallery in Workspace.OwnedGalleries) { <a class="view-gallery-card" href="@($"/view/galleries/{gallery.Id:D}")"><AppMaterialIcon Icon="@(gallery.Kind == ViewGalleryKind.Smart ? AppMaterialIcons.Outlined.AutoAwesome : AppMaterialIcons.Outlined.PhotoAlbum)" /><strong>@gallery.Name</strong><span>@L["ViewGalleriesPage_Items", gallery.ItemCount, gallery.Kind]</span></a> }</div></section>
            }
            @if (Workspace.SharedGalleries.Count > 0)
            {
                <section><h2>@L["ViewGalleriesPage_SharedWithYou"]</h2><div class="view-gallery-grid">@foreach (var gallery in Workspace.SharedGalleries) { <a class="view-gallery-card" href="@($"/view/galleries/{gallery.Id:D}")"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.People" /><strong>@gallery.Name</strong><span>@gallery.ItemCount items</span></a> }</div></section>
            }
        }
        </ChildContent>
    </ViewContentPage>
</ViewSectionShell>

@code {
    // The address this page was routed with (see RoutedPageQuery).
    [CascadingParameter(Name = RoutedPageQuery.CascadingName)] public string? RoutedUri { get; set; }

    private RoutedPageQuery Query => RoutedPageQuery.From(RoutedUri ?? Nav.Uri);
    public bool CreateRequested => Query.Bool("create");
    public string? RequestedKind => Query.String("kind");
    private bool _loading = true;
    private bool _handledCreateRequest;

    protected override async Task OnInitializedAsync()
    {
        await Workspace.LoadGalleriesAsync(force: true);
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !CreateRequested || _handledCreateRequest) return;
        _handledCreateRequest = true;
        await OpenEditorAsync(string.Equals(RequestedKind, "smart", StringComparison.OrdinalIgnoreCase) ? "Smart" : "Manual");
    }

    private async Task OpenEditorAsync(string membershipMode)
    {
        if (await GalleryEditorLauncher.OpenAsync(new GalleryEditorLaunchRequest { InitialMembershipMode = membershipMode }))
        {
            await Workspace.LoadGalleriesAsync(force: true);
            StateHasChanged();
        }
    }
}
