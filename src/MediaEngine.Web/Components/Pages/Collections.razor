@page "/collections"
@page "/collections/{Section}"
@namespace MediaEngine.Web.Components.Pages
@using MediaEngine.Web.Services.Navigation
@inject NavigationManager Nav

<PageTitle>Collections  -  Library</PageTitle>
<CollectionsPage Section="@Section"
                 SearchQuery="@SearchQuery"
                 LaneQuery="@LaneQuery"
                 KindQuery="@KindQuery"
                 MembershipQuery="@MembershipQuery"
                 RoleQuery="@RoleQuery"
                 SortQuery="@SortQuery"
                 TileQuery="@TileQuery" />

@code {
    [Parameter] public string? Section { get; set; }

    // The address this page was routed with (see RoutedPageQuery): the page under the details overlay keeps its own query.
    [CascadingParameter(Name = RoutedPageQuery.CascadingName)] public string? RoutedUri { get; set; }

    private RoutedPageQuery Query => RoutedPageQuery.From(RoutedUri ?? Nav.Uri);
    public string? SearchQuery => Query.String("q");
    public string? LaneQuery => Query.String("lane");
    public string? KindQuery => Query.String("kind");
    public string? MembershipQuery => Query.String("membership");
    public string? RoleQuery => Query.String("role");
    public string? SortQuery => Query.String("sort");
    public int? TileQuery => Query.Int("tile");
}
