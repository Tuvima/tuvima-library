@page "/vault"
@page "/vault/{View}"
@page "/vault/{View}/{Id}"
@namespace MediaEngine.Web.Components.Pages
@implements IDisposable
@inject NsfwModeState Nsfw
@inject NavigationManager Nav
@inject NsfwModeSwitching Switching
@inject IStringLocalizer<SharedStrings> L

@* The Vault area (Videos spec D45). The page title is deliberately plain: nothing in the browser tab or history names the area.
   Anyone the Engine says cannot use Vault mode is sent to the same "not found" page an unknown address gets. A profile that has
   access but has not switched Vault mode on yet (for instance one that opened this from the navigation bar or from Settings) sees
   only the usual unlock step, the PIN when its profile asks for one (Library pages D20). *@
<PageTitle>@L["Nav_Library"]</PageTitle>

@if (Nsfw.Unlocked)
{
    <MediaEngine.Web.Components.Vault.VaultArea View="@View" Id="@Id" />
}
else if (Nsfw.IsAvailable)
{
    <div class="vault-unlock" data-vault-unlock>
        <h1>@L["Nav_Vault"]</h1>
        <p>@(Nsfw.NeedsPin ? "Enter your profile PIN to open the Vault." : "Open the Vault for this session.")</p>
        <AppButton Label="@L["Common_OpenTheVault"].Value" OnClick="UnlockAsync" />
    </div>
}

@code {
    /// <summary>The view named in the address, or none for Recently added.</summary>
    [Parameter] public string? View { get; set; }

    /// <summary>A performer, studio, tag or folder named in the address; its scenes are listed.</summary>
    [Parameter] public string? Id { get; set; }

    protected override void OnInitialized()
    {
        Nsfw.Changed += OnChanged;
        LeaveIfNotAllowed();
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        LeaveIfNotAllowed();
        StateHasChanged();
    });

    // Wait for the Engine's answer before deciding: until it has answered nothing is drawn and nothing is redirected.
    private void LeaveIfNotAllowed()
    {
        if (Nsfw.Resolved && !Nsfw.IsAvailable)
        {
            VaultExit.Leave(Nav, VaultExit.NotFound);
        }
    }

    private Task UnlockAsync() => Switching.SetAsync(true);

    public void Dispose() => Nsfw.Changed -= OnChanged;
}
