@page "/listen"
@page "/listen/{Tab}"
@using MediaEngine.Web.Components.Browse
@using MediaEngine.Web.Components.MediaHub
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.MediaTiles
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Navigation
@inject IEngineApiClient ApiClient
@inject BrowseLibrariesState LibraryList
@inject UIOrchestratorService Orchestrator
@inject MediaTileComposerService MediaTiles
@inject ListenAudioDragService AudioDrag
@inject CollectionEditorLauncherService CollectionEditorLauncher
@inject NavigationManager Nav
@inject IAppToastService Snackbar
@inject ILogger<ListenBrowsePage> Logger

@namespace MediaEngine.Web.Components.Pages
@inject IStringLocalizer<SharedStrings> L

<MediaLanePage Title="@L["Nav_Listen"].Value"
               RouteBase="/listen"
               Subtitle="@L["Common_MusicAndAudiobooksFromYour"].Value"
               SearchPlaceholder="Search music and audiobooks..."
               SectionType="MediaHubSectionType.Listen"
               Preset="@Preset"
               Modes="@Modes"
               NavigationGroups="@ListenNavigationGroups"
               ActiveMode="@ActiveListenMode"
               Tab="@Tab"
               TabsLoading="@(!_tabsLoaded)"
               LandingPage="@_landingPage"
               Shelves="@ListenHubShelves"
               Loading="@_loading"
               LoadFailed="@_loadFailed"
               LoadFailedTitle="Listen failed to load"
               LoadFailedMessage="The Dashboard could not load the Listen landing from the Engine."
               EmptyTitle="@L["ListenBrowsePage_NothingToListenToYet"].Value"
               EmptyMessage="@L["ListenBrowsePage_AddMusicOrAudiobooksTo"].Value"
               IsSupportedBrowseTab="@IsSupportedBrowseTab"
               UnsupportedTitle="Listen page not found"
               UnsupportedMessage="Choose Music, Audiobooks, or Playlists to browse your library."
               Retry="LoadLandingAsync"
               OnNavigationItemDrop="AddDraggedSongsToPlaylistAsync"
               OnNavigationCreateDrop="StageDraggedSongsForPlaylistAsync"
               OnNavigationCreateCanceled="CancelPlaylistCreateAsync"
               OnNavigationCreate="CreatePlaylistAsync"
               OnNavigationSmartCreate="OpenSmartPlaylistAsync"
               OnNavigationItemRename="RenamePlaylistAsync"
               OnNavigationItemDelete="DeletePlaylistAsync"
               OnNavigationItemReorder="ReorderPlaylistAsync" />

@code {
    /// <summary>The details overlay state, cascaded by the route view; null where this is shown on its own.</summary>
    [CascadingParameter] public DetailsOverlayState? Overlay { get; set; }

    [Parameter] public string? Tab { get; set; }

    private DiscoveryPageViewModel? _landingPage;
    private IReadOnlyList<ManagedCollectionViewModel> _playlists = [];
    private ProfileViewModel? _activeProfile;
    private Guid? _activeProfileId;
    private string? _playlistNavigationConfig;
    private List<Guid> _playlistOrder = [];
    private List<Guid> _pendingPlaylistWorkIds = [];
    private bool _loading = true;
    private bool _loadFailed;
    private bool _playlistsLoaded;

    // The tabs follow the Engine's library list (one per library with folders, then Playlists); the fixed tabs stand in when it cannot be read.
    private LibraryBrowsePreset Preset = ListenBrowseConfiguration.Preset;
    private IReadOnlyList<MediaHubModeViewModel> Modes = ListenBrowseConfiguration.LaneModes;
    private bool _tabsLoaded;
    private bool _landingAttempted;

    private string ActiveListenMode => BrowseQueryBuilder.FindTab(Preset, Tab)?.Id ?? "all";

    private bool IsSupportedBrowseTab => BrowseQueryBuilder.FindTab(Preset, Tab) is not null;

    // The tab whose shortcuts the rail lists (Songs, Albums and Artists, Recently Played, Recently Added): the first music-type library tab
    // (Playlists is its own group); none when this profile has no music-type library.
    private BrowseTabPreset? MusicTab => Preset.Tabs.FirstOrDefault(tab =>
        string.Equals(tab.MediaType, "Music", StringComparison.OrdinalIgnoreCase)
        && !ListenBrowseConfiguration.FixedTabIds.Contains(tab.Id));

    // The tab "Continue Listening" opens: the first Audiobooks tab; none when this profile has no audiobook library.
    private BrowseTabPreset? AudiobookTab => Preset.Tabs.FirstOrDefault(tab =>
        string.Equals(tab.MediaType, "Audiobooks", StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<MediaSectionNavigationGroup> ListenNavigationGroups
    {
        get
        {
            var playlistItems = new List<MediaSectionNavigationItem>
            {
                new("Favorites", "/for-me?view=favorites&area=listen", AppMaterialIcons.Outlined.FavoriteBorder),
                new("All Playlists", "/listen/playlists", AppMaterialIcons.Outlined.QueueMusic, Exact: true),
            };
            playlistItems.AddRange(_playlists
                .Take(12)
                .Select(playlist => new MediaSectionNavigationItem(
                    playlist.Name,
                    $"/listen/music/playlists/{playlist.Id:D}",
                    IsSmartPlaylist(playlist) ? AppMaterialIcons.Outlined.AutoAwesome : AppMaterialIcons.Outlined.PlaylistPlay,
                    playlist.ItemCount.ToString(System.Globalization.CultureInfo.InvariantCulture),
                    DropTarget: IsManualPlaylist(playlist) ? new PlaylistNavigationDropTarget(playlist.Id) : null,
                    Management: new MediaSectionNavigationItemManagement(
                        playlist.Id,
                        "playlist",
                        IsSmart: IsSmartPlaylist(playlist)))));

            var musicTab = MusicTab;
            var navigationGroups = new List<MediaSectionNavigationGroup>
            {
                MediaLaneConfigurationBuilder.BuildLibraryGroup(
                    Preset,
                    Preset.Tabs.Where(tab => !ListenBrowseConfiguration.FixedTabIds.Contains(tab.Id)).Select(tab => tab.Id).ToHashSet(StringComparer.OrdinalIgnoreCase)),
                new("Listen next",
                [
                    .. AudiobookTab is { } audiobookTab
                        ? new MediaSectionNavigationItem[]
                        {
                            new("Continue Listening", $"/listen/{audiobookTab.Id}?status=in-progress", AppMaterialIcons.Outlined.PlayCircle, Exact: true),
                        }
                        : [],
                    .. musicTab is not null
                        ? new MediaSectionNavigationItem[]
                        {
                            new("Recently Played", $"/listen/{musicTab.Id}?sort=recently-played", AppMaterialIcons.Outlined.History, Exact: true),
                            new("Recently Added", $"/listen/{musicTab.Id}?sort=newest", AppMaterialIcons.Outlined.Schedule, Exact: true),
                        }
                        : [],
                ]),
            };
            if (musicTab is not null)
            {
                navigationGroups.Add(MediaBrowseNavigationBuilder.BuildBrowseGroup(
                    Preset,
                    "Music",
                    new HashSet<string>(StringComparer.OrdinalIgnoreCase) { musicTab.Id }));
            }

            navigationGroups.Add(new("Playlists", playlistItems,
                new MediaSectionNavigationCreateOptions(
                    "New Playlist",
                    "New Smart Playlist",
                    "Playlist name",
                    new ManualPlaylistCreateTarget(),
                    new SmartPlaylistCreateTarget(),
                    new NewPlaylistNavigationDropTarget())));
            return navigationGroups;
        }
    }

    private IReadOnlyList<MediaHubShelfViewModel> ListenHubShelves
    {
        get
        {
            var shelves = _landingPage?.Shelves
                .Select(shelf => MediaHubShelfViewModel.FromShelf(shelf))
                .ToList() ?? [];
            var playlistTiles = _playlists.Take(12).Select(MediaTileComposerService.FromPlaylist).ToList();
            if (playlistTiles.Count == 0)
            {
                return shelves;
            }

            var playlistShelf = new MediaHubShelfViewModel
            {
                Key = "your-playlists",
                Title = "Your Playlists",
                Subtitle = "Manual and smart playlists from your library",
                Items = playlistTiles,
                SeeAllRoute = "/listen/playlists",
                ShapeOverride = MediaTileShape.Square,
            };
            var seriesIndex = shelves.FindIndex(
                shelf => string.Equals(shelf.Key, "audiobook-series", StringComparison.OrdinalIgnoreCase));
            if (seriesIndex >= 0)
            {
                shelves.Insert(seriesIndex, playlistShelf);
            }
            else
            {
                shelves.Add(playlistShelf);
            }

            return shelves;
        }
    }

    // The page draws its header and a tab-strip skeleton at once; the library list is read while the playlists and the landing load.
    protected override async Task OnInitializedAsync()
    {
        var tabs = LoadTabsAsync();
        await EnsurePlaylistNavigationAsync();
        var landing = string.IsNullOrWhiteSpace(Tab) ? LoadLandingAsync() : Task.CompletedTask;
        await Task.WhenAll(tabs, landing);
    }

    private async Task LoadTabsAsync()
    {
        Preset = BrowseLibraryTabs.Build(
            ListenBrowseConfiguration.Preset, "listen", await LibraryList.GetAsync(), ListenBrowseConfiguration.FixedTabIds);
        Modes = MediaLaneConfigurationBuilder.BuildModes(Preset);
        _tabsLoaded = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        await EnsurePlaylistNavigationAsync();

        if (!string.IsNullOrWhiteSpace(Tab) || _landingPage is not null)
        {
            _loading = false;
            return;
        }

        if (!_landingAttempted)
        {
            await LoadLandingAsync();
        }
    }

    private async Task EnsurePlaylistNavigationAsync()
    {
        if (_playlistsLoaded)
        {
            return;
        }

        try
        {
            _activeProfile = await Orchestrator.GetActiveProfileAsync();
            _activeProfileId = _activeProfile?.Id;
            _playlistNavigationConfig = _activeProfile?.NavigationConfig;
            _playlistOrder = ListenPlaylistOrderState.Read(_playlistNavigationConfig);
            _playlists = (await ApiClient.GetManagedCollectionsAsync(_activeProfileId))
                .Where(MediaTileComposerService.IsUserVisiblePlaylist)
                .OrderBy(GetPlaylistOrderIndex)
                .ThenByDescending(playlist => playlist.ModifiedAt ?? playlist.CreatedAt)
                .ThenBy(playlist => playlist.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load Listen playlist shortcuts.");
            _playlists = [];
        }
        finally
        {
            _playlistsLoaded = true;
        }
    }

    private async Task LoadLandingAsync()
    {
        _landingAttempted = true;
        _loading = true;
        _loadFailed = false;

        try
        {
            _landingPage = await MediaTiles.BuildListenAsync(_activeProfileId);
        }
        catch (Exception ex)
        {
            _loadFailed = true;
            Logger.LogError(ex, "Failed to load the Listen landing page.");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddDraggedSongsToPlaylistAsync(MediaSectionNavigationDropEvent dropEvent)
    {
        if (dropEvent.Target is not PlaylistNavigationDropTarget playlistTarget)
        {
            return;
        }

        var playlistId = playlistTarget.PlaylistId;
        if (!AudioDrag.HasItems)
        {
            return;
        }

        var playlist = _playlists.FirstOrDefault(item => item.Id == playlistId);
        if (playlist is null || !IsManualPlaylist(playlist))
        {
            return;
        }

        var workIds = AudioDrag.WorkIds.ToList();
        var added = 0;
        foreach (var workId in workIds)
        {
            if (await ApiClient.AddCollectionItemAsync(playlistId, workId, _activeProfileId))
            {
                added++;
            }
        }

        AudioDrag.Clear();
        if (added == 0)
        {
            Snackbar.Add("Those songs are already in the playlist or could not be added.", AppSeverity.Info);
            return;
        }

        playlist.ItemCount += added;
        Snackbar.Add(
            added == 1 ? $"Added a song to {playlist.Name}." : $"Added {added} songs to {playlist.Name}.",
            AppSeverity.Success);
    }

    private Task StageDraggedSongsForPlaylistAsync(MediaSectionNavigationCreateDropEvent createEvent)
    {
        if (createEvent.Target is ManualPlaylistCreateTarget && AudioDrag.HasItems)
        {
            _pendingPlaylistWorkIds = AudioDrag.WorkIds.Distinct().ToList();
            AudioDrag.Clear();
        }
        return Task.CompletedTask;
    }

    private Task CancelPlaylistCreateAsync(MediaSectionNavigationCreateTarget target)
    {
        if (target is ManualPlaylistCreateTarget)
            _pendingPlaylistWorkIds.Clear();
        return Task.CompletedTask;
    }

    private async Task<bool> CreatePlaylistAsync(MediaSectionNavigationCreateEvent createEvent)
    {
        if (createEvent.Target is not ManualPlaylistCreateTarget || _activeProfileId is null)
            return false;
        var playlistId = await ApiClient.CreateCollectionWithItemsAsync(
            createEvent.Name,
            null,
            AppMaterialIcons.Outlined.QueueMusic,
            "Playlist",
            new CollectionRuleDefinitionViewModel(),
            "title",
            "asc",
            "private",
            _pendingPlaylistWorkIds,
            _activeProfileId);
        if (playlistId is null)
        {
            Snackbar.Add("The Playlist could not be created.", AppSeverity.Error);
            return false;
        }
        var addedCount = _pendingPlaylistWorkIds.Count;
        _pendingPlaylistWorkIds.Clear();
        await ReloadPlaylistsAsync();
        Snackbar.Add(addedCount > 0
            ? $"Created {createEvent.Name} with {addedCount} song(s)."
            : $"Created {createEvent.Name}.", AppSeverity.Success);
        return true;
    }

    private async Task OpenSmartPlaylistAsync(MediaSectionNavigationCreateTarget target)
    {
        if (target is not SmartPlaylistCreateTarget || _activeProfileId is null)
            return;
        var changed = await CollectionEditorLauncher.OpenAsync(new CollectionEditorLaunchRequest
        {
            ActiveProfileId = _activeProfileId,
            Kind = ContainerEditorKind.Playlist,
            InitialMembershipMode = "Smart",
        });
        if (changed)
            await ReloadPlaylistsAsync();
    }

    private async Task<bool> RenamePlaylistAsync(MediaSectionNavigationRenameEvent renameEvent)
    {
        var succeeded = await ApiClient.UpdateCollectionAsync(
            renameEvent.Management.ContainerId,
            renameEvent.Name,
            null,
            null,
            null,
            null,
            null,
            null,
            null,
            null,
            _activeProfileId);
        if (!succeeded)
        {
            Snackbar.Add("The Playlist could not be renamed.", AppSeverity.Error);
            return false;
        }
        await ReloadPlaylistsAsync();
        return true;
    }

    private async Task<bool> DeletePlaylistAsync(MediaSectionNavigationManageEvent manageEvent)
    {
        if (!await ApiClient.DeleteCollectionAsync(manageEvent.Management.ContainerId, _activeProfileId))
        {
            Snackbar.Add("The Playlist could not be deleted.", AppSeverity.Error);
            return false;
        }
        await ReloadPlaylistsAsync();
        if (new Uri(RoutedPageAddress.AbsoluteFor(Nav, Overlay)).AbsolutePath.Contains(manageEvent.Management.ContainerId.ToString("D"), StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo("/listen/playlists");
        Snackbar.Add($"Deleted {manageEvent.Item.Label}.", AppSeverity.Success);
        return true;
    }

    private async Task<bool> ReorderPlaylistAsync(MediaSectionNavigationReorderEvent reorderEvent)
    {
        var orderedIds = _playlists.Select(playlist => playlist.Id).ToList();
        List<Guid> updatedOrder;
        var moved = reorderEvent.BeforeContainerId is { } targetId
            ? ListenPlaylistOrderState.TryMoveBefore(orderedIds, reorderEvent.Management.ContainerId, targetId, out updatedOrder!)
            : ListenPlaylistOrderState.TryMoveByOffset(orderedIds, reorderEvent.Management.ContainerId, reorderEvent.Direction, out updatedOrder!);
        if (!moved || _activeProfile is null)
            return false;
        var updatedConfig = ListenPlaylistOrderState.Write(_playlistNavigationConfig, updatedOrder);
        if (!await Orchestrator.UpdateProfileAsync(
                _activeProfile.Id,
                _activeProfile.DisplayName,
                _activeProfile.AvatarColor,
                updatedConfig))
        {
            Snackbar.Add("The Playlist order could not be saved.", AppSeverity.Error);
            return false;
        }
        _playlistOrder = updatedOrder;
        _playlistNavigationConfig = updatedConfig;
        _playlists = _playlists.OrderBy(GetPlaylistOrderIndex).ToList();
        return true;
    }

    private async Task ReloadPlaylistsAsync()
    {
        _playlistsLoaded = false;
        await EnsurePlaylistNavigationAsync();
        await InvokeAsync(StateHasChanged);
    }

    private int GetPlaylistOrderIndex(ManagedCollectionViewModel playlist)
    {
        var index = _playlistOrder.IndexOf(playlist.Id);
        return index < 0 ? int.MaxValue : index;
    }

    private static bool IsManualPlaylist(ManagedCollectionViewModel playlist) =>
        string.Equals(playlist.CollectionType, "Playlist", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(playlist.MembershipMode, "Smart", StringComparison.OrdinalIgnoreCase);

    private static bool IsSmartPlaylist(ManagedCollectionViewModel playlist) =>
        string.Equals(playlist.MembershipMode, "Smart", StringComparison.OrdinalIgnoreCase)
        || string.Equals(playlist.CollectionType, "Smart", StringComparison.OrdinalIgnoreCase);

}
