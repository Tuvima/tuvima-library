@page "/not-found"
@layout MediaEngine.Web.Shared.MainLayout

<PageTitle>Not Found  -  Tuvima Library</PageTitle>

<AppContainer MaxWidth="AppMaxWidth.Small" Class="mt-16 text-center">
    <AppMaterialIcon Icon="@AppMaterialIcons.Filled.SearchOff" Size="AppSize.Large" Color="AppColor.Secondary" Class="mb-4" />
    <AppText Typo="AppTypo.h4" Class="mb-2">Page Not Found</AppText>
    <AppText Typo="AppTypo.body1" Color="AppColor.Secondary" Class="mb-6">
        The content you are looking for doesn't exist.
    </AppText>
    <AppButton Href="/" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" StartIcon="@AppMaterialIcons.Filled.Home">
        Back to Library
    </AppButton>
</AppContainer>
