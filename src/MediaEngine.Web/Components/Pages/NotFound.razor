@page "/not-found"
@layout MediaEngine.Web.Shared.MainLayout
@inject IStringLocalizer<SharedStrings> L

<PageTitle>@L["NotFound_NotFoundLibrary"]</PageTitle>

<AppContainer MaxWidth="AppMaxWidth.Small" Class="tl-sp-mt-16 tl-text-center">
    <AppMaterialIcon Icon="@AppMaterialIcons.Filled.SearchOff" Size="AppSize.Large" Color="AppColor.Secondary" Class="tl-sp-mb-4" />
    <AppText Typo="AppTypo.h4" Class="tl-sp-mb-2">@L["NotFound_PageNotFound"]</AppText>
    <AppText Typo="AppTypo.body1" Color="AppColor.Secondary" Class="tl-sp-mb-6">
        @L["NotFound_TheContentYouAreLooking"]
    </AppText>
    <AppButton Href="/" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" StartIcon="@AppMaterialIcons.Filled.Home">
        @L["NotFound_BackToLibrary"]
    </AppButton>
</AppContainer>
