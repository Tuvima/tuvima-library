@page "/view/artwork"
@page "/view/artwork/media"
@page "/view/artwork/people"
@page "/view/artwork/universes"
@page "/view/artwork/assets"
@using MediaEngine.Contracts.Artwork
@using MediaEngine.Web.Components.Artwork
@inject UIOrchestratorService Orchestrator
@inject IAppDialogService DialogService
@inject NavigationManager Navigation
@inject IAppToastService Snackbar
@namespace MediaEngine.Web.Components.Pages

<PageTitle>Artwork Library - Tuvima Library</PageTitle>

<ViewSectionShell>
    <ViewContentPage Title="Artwork Library"
                     Subtitle="Search and reuse artwork stored across your Tuvima library."
                     Class="view-artwork-page">
        <HeaderActions>
            <span class="view-artwork-header__count">@_total.ToString("N0") @(_total == 1 ? "image" : "images")</span>
            @if (_selected is not null)
            {
                <AppButton ButtonStyle="AppButtonStyle.Outlined" StartIcon="@AppMaterialIcons.Outlined.Edit" OnClick="ManageSelectedAsync">Manage usage</AppButton>
            }
        </HeaderActions>
        <ChildContent>
            <ArtworkAssetBrowser InitialQuery="@InitialQuery" SelectionChanged="SelectedAsync" ResultsChanged="ResultsChangedAsync" ManageRequested="ManageAssetAsync" />
        </ChildContent>
    </ViewContentPage>
</ViewSectionShell>

@code {
    private ArtworkAssetDto? _selected;
    private int _total;

    private ArtworkAssetQuery InitialQuery => LegacyQuery(Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath);

    private static ArtworkAssetQuery LegacyQuery(string path) => path.EndsWith("/people", StringComparison.OrdinalIgnoreCase)
        ? new ArtworkAssetQuery(Roles: ["Portrait"], EntityTypes: ["Person"], Sort: ArtworkAssetSort.Newest)
        : new ArtworkAssetQuery(Sort: ArtworkAssetSort.Newest);

    private Task SelectedAsync(ArtworkAssetDto? asset) { _selected = asset; return Task.CompletedTask; }
    private Task ResultsChangedAsync(int total) { _total = total; return Task.CompletedTask; }

    private Task ManageSelectedAsync() => _selected is null ? Task.CompletedTask : ManageAssetAsync(_selected);

    private async Task ManageAssetAsync(ArtworkAssetDto asset)
    {
        var context = asset.DisplayContext ?? asset.Contexts.FirstOrDefault();
        if (context is null)
        {
            Snackbar.Add("This image has no accessible artwork assignment to manage.", AppSeverity.Info);
            return;
        }

        var item = new ArtworkLibraryItemDto(
            context.EntityId,
            context.EntityType,
            context.EntityLabel,
            context.MediaType,
            context.Year,
            context.Role,
            asset.ContentUrl,
            context.Role,
            [context.Role ?? "Primary"],
            asset.LinkCount,
            0,
            false)
        {
            ResolutionMode = ArtworkResolutionMode.Explicit,
            GroupKind = context.EntityType.Equals("FictionalEntity", StringComparison.OrdinalIgnoreCase) ? "Character" : null,
        };
        try
        {
            var profile = await Orchestrator.GetActiveProfileAsync();
            var dialog = await DialogService.ShowAsync<ArtworkWorkspaceDialog>(string.Empty,
                new AppDialogParameters
                {
                    { nameof(ArtworkWorkspaceDialog.Item), item },
                    { nameof(ArtworkWorkspaceDialog.ActiveProfileId), profile?.Id },
                    { nameof(ArtworkWorkspaceDialog.InitialAssetId), asset.Id },
                    { nameof(ArtworkWorkspaceDialog.InitialRole), context.Role },
                },
                new AppDialogOptions { CloseButton = false, NoHeader = true, MaxWidth = AppMaxWidth.ExtraLarge, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = true });
            if (dialog is not null) await dialog.Result;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Artwork editor could not open: {ex.Message}", AppSeverity.Error);
        }
    }
}
