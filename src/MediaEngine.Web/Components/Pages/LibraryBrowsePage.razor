@page "/"
@using MediaEngine.Contracts.Realtime
@inject MediaTileComposerService MediaTiles
@inject PlaybackSessionController Playback
@inject ILogger<LibraryBrowsePage> Logger
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject UniverseStateContainer State
@inject UserProgressChangeNotifier ProgressChanges
@inject IWebHostEnvironment Env
@inject IStringLocalizer<SharedStrings> L
@inject IAppToastService Snackbar
@implements IDisposable

<PageTitle>Tuvima Library</PageTitle>

@if (_loading) { <AppProgressBar Indeterminate="true" Color="AppColor.Primary" Class="home-discovery-loading mb-4" Rounded="false" /> }
@if (!_loading || _hasLoadedOnce)
{
    <GlobalBackground Color="#05070C" />
    @if (IsEmpty)
    {

    <div class="home-discovery-empty">
        <img src="/images/tuvima-icon.svg" alt="Tuvima Library" class="home-discovery-empty-icon" />
        <h2 class="home-discovery-empty-title">Set up your first library</h2>
        <p class="home-discovery-empty-subtitle">
            Add a catalogued, personal, or photo folder, choose how metadata should be handled, then start a scan.
        </p>

        <div class="home-discovery-empty-actions">
            <AppButton ButtonStyle="AppButtonStyle.Outlined"
                       Tone="AppUiTone.Neutral"
                       Size="AppControlSize.Large"
                       StartIcon="@AppMaterialIcons.Outlined.FolderOpen"
                       Href="/settings/libraries">
                Configure folders
            </AppButton>
            @if (_canScan)
            {
                <AppButton ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary"
                           Size="AppControlSize.Large"
                           StartIcon="@AppMaterialIcons.Outlined.PlayArrow"
                           Disabled="@_scanStarting"
                           OnClick="HandleScanNowAsync">
                    @if (_scanStarting)
                    {
                        <AppSpinner Size="AppSize.Small" Indeterminate="true" Class="mr-2" />
                        <text>Starting scan...</text>
                    }
                    else
                    {
                        <text>Scan now</text>
                    }
                </AppButton>
            }
            <AppButton ButtonStyle="AppButtonStyle.Text"
                       Tone="AppUiTone.Neutral"
                       Size="AppControlSize.Large"
                       StartIcon="@AppMaterialIcons.Outlined.PendingActions"
                       Href="/settings/ingestion">
                Open ingestion activity
            </AppButton>
        </div>

        @if (Env.IsDevelopment())
        {
            <div class="home-discovery-dev-tools">
                <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">Development tools</AppText>
                <AppButton ButtonStyle="AppButtonStyle.Outlined"
                           Tone="AppUiTone.Warning"
                           StartIcon="@AppMaterialIcons.Filled.AutoStories"
                           Size="AppControlSize.Normal"
                           OnClick="HandleSeedLibraryAsync"
                           Disabled="@_seeding"
                           Class="home-discovery-seed-button">
                    @if (_seeding)
                    {
                        <AppSpinner Size="AppSize.Small" Indeterminate="true" Class="mr-2" />
                        <text>@L["Home_Seeding"]</text>
                    }
                    else
                    {
                        <text>@L["Home_SeedLibrary"]</text>
                    }
                </AppButton>
            </div>
        }
    </div>

    }


    <div class="home-discovery-page @(_page.Hero is not null ? "home-discovery-page--with-hero" : null)">
        @if (HomeHeroCandidates.Count > 0)
        {
            <CinematicHeroCarousel Items="@HomeHeroCandidates"
                                  SectionTitle="Home"
                                  SectionSubtitle="A cross-media view of your local library"
                                  AriaLabel="Home featured media" />
        }

        <div class="home-discovery-content-shell">
            <div class="home-discovery-shelves">
                @foreach (var shelf in VisibleShelves.Where(s => s.Kind == MediaTileShelfKind.Continue))
                {
                    <ContinueAcrossMediaSection Shelf="@shelf" @key="shelf.Key" />
                }
                <RecentMediaFeed Type="@_recentType" TypeChanged="RecentTypeChanged" RefreshKey="@_recentRefreshKey" HasItemsChanged="RecentItemsChanged" />
                @foreach (var shelf in VisibleShelves.Where(s => s.Kind != MediaTileShelfKind.Continue))
                {
                    <MediaTileShelf Shelf="@shelf" IsHomeSurface="true" HideMediaKindBadges="true" HideSourceBadges="true" HideGroupIndicators="true" @key="shelf.Key" />
                }
            </div>
        </div>
    </div>
}

@code {
    private static readonly TimeSpan StateReloadDebounce = TimeSpan.FromMilliseconds(750);

    private CancellationTokenSource? _stateReloadCts;
    private bool _loading = true;
    private bool _hasLoadedOnce;
    private bool _loadInProgress;
    private HomeRefreshReason _queuedRefreshReasons;
    private HomeRefreshReason _pendingRefreshReasons;
    private DateTimeOffset _scheduledReloadAt;
    private DateTimeOffset _lastProgressRefresh, _lastLibraryRefresh;
    private (Guid? Asset, bool Playing, bool Dismissed) _observedPlayback;
    [Flags]
    private enum HomeRefreshReason { Progress = 1, LibraryState = 2, MediaAdded = 4, Profile = 8, Initial = 16, PlaybackTransition = 32 }
    private bool _disposed;
    private bool _seeding;
    private bool _scanStarting;
    private bool _canScan;
    private string _recentType = "all";
    private long _recentRefreshKey;
    private bool _hasRecentItems;
    private void RecentTypeChanged(string type) => _recentType = type;
    private void RecentItemsChanged(bool hasItems) { if (_recentType == "all") _hasRecentItems = hasItems; }
    private DiscoveryPageViewModel _page = new() { Key = "home" };
    private IReadOnlyList<MediaTileShelfViewModel> _visibleShelves = [];
    private IReadOnlyList<DiscoveryHeroViewModel> _homeHeroCandidates = [];

    private IReadOnlyList<MediaTileShelfViewModel> VisibleShelves => _visibleShelves;

    private IReadOnlyList<DiscoveryHeroViewModel> HomeHeroCandidates => _homeHeroCandidates;

    private bool IsEmpty =>
        !_hasRecentItems && _page.Hero is null
        && _page.Hubs.Count == 0
        && _page.Shelves.Count == 0
        && _page.Catalog.Count == 0;

    protected override async Task OnInitializedAsync()
    {
        State.OnStateChanged += OnStateChanged;
        State.MediaAddedReceived += OnMediaAdded;
        Orchestrator.OnProfileChanged += OnProfileChanged;
        ProgressChanges.Changed += OnProgressChanged;
        Playback.Changed += OnPlaybackChanged;
        _observedPlayback = (Playback.CurrentItem?.AssetId, Playback.IsPlaying, Playback.IsDismissed);
        await Orchestrator.StartSignalRAsync();
        await LoadAsync();
    }

    private static DiscoveryHeroViewModel HeroFromTile(MediaTileViewModel item) => new()
    {
        Eyebrow = item.ProgressPct is > 0 ? "Jump back in" : "From your library",
        Title = item.Title,
        Subtitle = item.Subtitle,
        Tagline = item.Tagline,
        Description = item.Description,
        BackgroundImageUrl = item.BackgroundUrl,
        HeroBackgroundImageUrl = item.HeroBackgroundImageUrl ?? item.BackgroundUrl,
        BannerImageUrl = item.BannerUrl,
        PreviewImageUrl = item.PreviewImageUrl ?? item.CoverUrl,
        PreviewSurfaceKind = item.SurfaceKind,
        SurfaceKind = item.SurfaceKind,
        LogoUrl = item.LogoUrl,
        AccentColor = item.AccentColor,
        MetaPills = item.HoverFacts,
        ProgressPct = item.ProgressPct,
        StatusText = item.ProgressLabel,
        RepresentativeEntityId = item.Id,
        WorkId = item.WorkId,
        CollectionId = item.CollectionId,
        MediaKind = item.MediaKind,
        Presentation = item.Presentation.ToString(),
        Genres = item.Genres,
        PreviewItems = item.ArtworkStackItems,
        PreviewTotalCount = item.PreviewTotalCount,
        PrimaryActionLabel = item.PrimaryActionLabel,
        PrimaryNavigationUrl = item.PrimaryNavigationUrl ?? item.NavigationUrl,
        SecondaryActionLabel = "Details",
        SecondaryNavigationUrl = item.DetailsNavigationUrl,
    };

    private async Task LoadAsync(HomeRefreshReason reason = HomeRefreshReason.Initial)
    {
        if (_loadInProgress) { _queuedRefreshReasons |= reason; return; }
        _loadInProgress = true;
        try
        {
            for (var attempt = 0; attempt < 2 && !_disposed; attempt++)
            {
                _queuedRefreshReasons = 0;
                _loading = !_hasLoadedOnce;
                await InvokeAsync(StateHasChanged);
                try
                {
                    var requestedProfile = (await Orchestrator.GetActiveProfileAsync())?.Id;
                    var nextPage = await MediaTiles.BuildHomeAsync(requestedProfile);
                    if (_disposed) return;
                    if (Orchestrator.ActivePlaybackProfileId != requestedProfile)
                    {
                        Logger.LogDebug("Home refresh profile changed while loading; bounded retry {Attempt}", attempt);
                        reason = HomeRefreshReason.Profile;
                        continue;
                    }
                    var progressOnly = (reason & ~(HomeRefreshReason.Progress | HomeRefreshReason.PlaybackTransition)) == 0;
                    _page = progressOnly && _hasLoadedOnce ? new DiscoveryPageViewModel
                    {
                        Key = _page.Key, AccentColor = _page.AccentColor,
                        Hero = nextPage.Hero, Spotlights = nextPage.Spotlights,
                        Hubs = _page.Hubs, Catalog = _page.Catalog,
                        EmptyTitle = _page.EmptyTitle, EmptySubtitle = _page.EmptySubtitle,
                        Shelves = nextPage.Shelves.Where(shelf => shelf.Kind == MediaTileShelfKind.Continue)
                            .Concat(_page.Shelves.Where(shelf => shelf.Kind != MediaTileShelfKind.Continue)).ToList(),
                    } : nextPage;
                    var now = DateTimeOffset.UtcNow;
                    _lastProgressRefresh = now;
                    if (!progressOnly) _lastLibraryRefresh = now;
                    if ((reason & (HomeRefreshReason.Initial | HomeRefreshReason.Profile | HomeRefreshReason.MediaAdded)) != 0)
                        _recentRefreshKey++;
                    UpdatePresentationCaches();
                    _canScan = IsEmpty && await CanStartScanAsync();
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Home refresh failed; retaining the current page");
                    _canScan = await CanStartScanAsync();
                }
                finally
                {
                    _loading = false; _hasLoadedOnce = true;
                    await InvokeAsync(StateHasChanged);
                }
                if (_queuedRefreshReasons == 0) break;
                reason = _queuedRefreshReasons;
            }
        }
        finally
        {
            _loadInProgress = false;
            if (_queuedRefreshReasons != 0 && !_disposed)
                ScheduleRefresh(_queuedRefreshReasons);
        }
    }

    private void UpdatePresentationCaches()
    {
        _visibleShelves = _page.Shelves
            .Where(shelf => shelf.Items.Count > 0)
            .Select(shelf => new MediaTileShelfViewModel
            {
                Key = shelf.Key,
                Title = shelf.Title,
                Subtitle = shelf.Subtitle,
                Items = shelf.Items,
                SeeAllRoute = shelf.SeeAllRoute,
            })
            .ToList();

        var explicitHeroes = _page.Spotlights.Count > 0
            ? _page.Spotlights
            : _page.Hero is null ? [] : [_page.Hero];
        _homeHeroCandidates = explicitHeroes.Take(5).ToList();
    }

    private async Task HandleScanNowAsync()
    {
        _scanStarting = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var started = await Orchestrator.TriggerRescanAsync();
            if (started)
            {
                Snackbar.Add("Scan started. Open Ingestion to watch progress.", AppSeverity.Success);
                _canScan = false;
            }
            else
            {
                Snackbar.Add(Orchestrator.LastApiError ?? "Scan could not be started.", AppSeverity.Error);
            }
        }
        finally
        {
            _scanStarting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> CanStartScanAsync()
    {
        try
        {
            var status = await Orchestrator.GetSystemStatusAsync();
            if (status?.IsHealthy != true)
            {
                return false;
            }

            var libraries = await Orchestrator.GetLibrariesAsync();
            var libraryFolders = libraries?.Libraries
                .SelectMany(library => library.Sources)
                .Select(source => source.Path)
                .Where(path => !string.IsNullOrWhiteSpace(path))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList() ?? [];
            if (libraryFolders.Count == 0)
                return false;

            foreach (var libraryFolder in libraryFolders)
            {
                if (!await IsReadyFolderAsync(libraryFolder))
                    return false;
            }

            var operations = await ApiClient.GetIngestionOperationsSnapshotAsync();
            return (operations?.ActiveJobs.Count ?? 0) == 0;
        }
        catch
        {
            // Empty-state scan eligibility is best-effort; Libraries and Ingestion remain visible when the Engine cannot answer.
            return false;
        }
    }

    private async Task<bool> IsReadyFolderAsync(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return false;
        }

        var result = await Orchestrator.TestPathAsync(path);
        return result is { Exists: true, HasRead: true, HasWrite: true };
    }

    private async Task HandleSeedLibraryAsync()
    {
        _seeding = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Orchestrator.SeedLibraryAsync();
            await LoadAsync();
        }
        finally
        {
            _seeding = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnStateChanged()
    {
        if (!_disposed && (!State.IsLoaded || State.LastStateChangeRequiresSnapshotRefresh))
            QueueRefresh(HomeRefreshReason.LibraryState);
    }
    private void OnProgressChanged(Guid profileId, Guid assetId)
    {
        if (Orchestrator.ActivePlaybackProfileId == profileId) QueueRefresh(HomeRefreshReason.Progress);
    }
    private void OnPlaybackChanged(PlaybackChangeKind kind)
    {
        if (kind == PlaybackChangeKind.TransportTick) return;
        var state = (Playback.CurrentItem?.AssetId, Playback.IsPlaying, Playback.IsDismissed);
        if (state == _observedPlayback) return;
        var previous = _observedPlayback; _observedPlayback = state;
        QueueRefresh(HomeRefreshReason.PlaybackTransition,
            state.Item1 is null || state.IsDismissed ? TimeSpan.Zero : previous.Item2 && !state.IsPlaying ? TimeSpan.FromSeconds(5) : StateReloadDebounce);
    }
    private void OnProfileChanged()
    {
        _recentType = "all"; _hasRecentItems = false;
        _page = new() { Key = "home" }; UpdatePresentationCaches();
        QueueRefresh(HomeRefreshReason.Profile);
    }
    private void OnMediaAdded(MediaAddedEvent ev) => QueueRefresh(HomeRefreshReason.MediaAdded);
    private void QueueRefresh(HomeRefreshReason reason, TimeSpan? delay = null)
    {
        if (!_disposed) _ = InvokeAsync(() => ScheduleRefresh(reason, delay));
    }
    private void ScheduleRefresh(HomeRefreshReason reason, TimeSpan? delay = null)
    {
        if (_disposed) return;
        _pendingRefreshReasons |= reason;
        var now = DateTimeOffset.UtcNow;
        var due = now + (delay ?? (reason == HomeRefreshReason.MediaAdded ? TimeSpan.FromSeconds(2) : StateReloadDebounce));
        if (reason == HomeRefreshReason.Progress) due = Max(due, _lastProgressRefresh + TimeSpan.FromSeconds(60));
        if (reason == HomeRefreshReason.LibraryState) due = Max(due, _lastLibraryRefresh + TimeSpan.FromSeconds(15));
        if (_stateReloadCts is not null && _scheduledReloadAt <= due) return;
        _stateReloadCts?.Cancel(); _stateReloadCts?.Dispose();
        _stateReloadCts = new(); _scheduledReloadAt = due;
        var token = _stateReloadCts.Token;
        _ = ReloadAfterDelayAsync(due - now, token);
    }
    private static DateTimeOffset Max(DateTimeOffset left, DateTimeOffset right) => left > right ? left : right;
    private async Task ReloadAfterDelayAsync(TimeSpan delay, CancellationToken token)
    {
        try
        {
            await Task.Delay(delay, token);
            await InvokeAsync(async () =>
            {
                if (_disposed || token.IsCancellationRequested) return;
                var reasons = _pendingRefreshReasons; _pendingRefreshReasons = 0;
                _stateReloadCts?.Dispose(); _stateReloadCts = null;
                await LoadAsync(reasons);
            });
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    public void Dispose()
    {
        _disposed = true;
        State.OnStateChanged -= OnStateChanged;
        State.MediaAddedReceived -= OnMediaAdded;
        Orchestrator.OnProfileChanged -= OnProfileChanged;
        ProgressChanges.Changed -= OnProgressChanged;
        Playback.Changed -= OnPlaybackChanged;
        _stateReloadCts?.Cancel();
        _stateReloadCts?.Dispose();
    }
}
