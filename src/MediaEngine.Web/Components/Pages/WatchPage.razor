@page "/watch"
@page "/watch/{Tab}"
@using MediaEngine.Web.Components.Browse
@using MediaEngine.Web.Components.MediaHub
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.MediaTiles
@inject MediaTileComposerService MediaTiles
@inject BrowseLibrariesState LibraryList
@inject ILogger<WatchPage> Logger

@namespace MediaEngine.Web.Components.Pages

<MediaLanePage Title="Watch"
               RouteBase="/watch"
               Subtitle="Movies, shows and videos from your local library"
               SearchPlaceholder="Search movies, TV and videos..."
               SectionType="MediaHubSectionType.Watch"
               Preset="@Preset"
               Modes="@WatchModes"
               NavigationGroups="@WatchNavigationGroups"
               ActiveMode="@ActiveWatchMode"
               Tab="@Tab"
               TabsLoading="@(!_tabsLoaded)"
               LandingPage="@_landingPage"
               Shelves="@WatchHubShelves"
               Loading="@_loading"
               LoadFailed="@_loadFailed"
               LoadFailedTitle="Watch failed to load"
               LoadFailedMessage="The Dashboard could not load the Watch landing from the Engine."
               EmptyTitle="No movies or shows yet"
               EmptyMessage="Add video to your library to populate this lane."
               Retry="LoadLandingAsync" />

@code {
    [Parameter] public string? Tab { get; set; }

    private DiscoveryPageViewModel? _landingPage;
    private bool _loading = true;
    private bool _loadFailed;
    private Task? _landingLoadTask;

    // The tabs follow the Engine's library list (one per library with folders); the fixed tabs stand in when it cannot be read, and the
    // page draws its header and a tab-strip skeleton while the list and the landing load side by side.
    private LibraryBrowsePreset Preset = StaticPreset;
    private bool _tabsLoaded;
    private bool _landingAttempted;

    private string ActiveWatchMode => BrowseQueryBuilder.FindTab(Preset, Tab)?.Id ?? "all";

    private IReadOnlyList<MediaSectionNavigationGroup> WatchNavigationGroups =>
    [
        MediaLaneConfigurationBuilder.BuildLibraryGroup(Preset),
        new("Watch next",
        [
            .. ShortcutTab is { } tab
                ? new MediaSectionNavigationItem[]
                {
                    new("Continue Watching", $"/watch/{tab.Id}?status=in-progress", AppMaterialIcons.Outlined.PlayCircle, Exact: true),
                    new("Unwatched", $"/watch/{tab.Id}?status=not-started", AppMaterialIcons.Outlined.VisibilityOff, Exact: true),
                    new("Recently Added", $"/watch/{tab.Id}?sort=newest", AppMaterialIcons.Outlined.Schedule, Exact: true),
                }
                : [],
        ]),
    ];

    // The tab the "Watch next" shortcuts open: the Movies tab, or the first tab when this profile has none.
    private BrowseTabPreset? ShortcutTab => BrowseQueryBuilder.FindTab(Preset, "movies") ?? Preset.Tabs.FirstOrDefault();

    private IReadOnlyList<MediaHubModeViewModel> WatchModes =>
        MediaLaneConfigurationBuilder.BuildModes(Preset);

    private IReadOnlyList<MediaHubShelfViewModel> WatchHubShelves => _landingPage?.Shelves
        .Select(shelf => MediaHubShelfViewModel.FromShelf(shelf))
        .ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        var tabs = LoadTabsAsync();
        var landing = string.IsNullOrWhiteSpace(Tab) ? LoadLandingAsync() : Task.CompletedTask;
        await Task.WhenAll(tabs, landing);
    }

    private async Task LoadTabsAsync()
    {
        Preset = BrowseLibraryTabs.Build(StaticPreset, "watch", await LibraryList.GetAsync());
        _tabsLoaded = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Tab) || _landingPage is not null)
        {
            _loading = false;
            return;
        }

        if (!_landingAttempted)
        {
            await LoadLandingAsync();
        }
    }

    private Task LoadLandingAsync()
    {
        if (_landingLoadTask is { IsCompleted: false })
        {
            return _landingLoadTask;
        }

        _landingLoadTask = LoadLandingCoreAsync();
        return _landingLoadTask;
    }

    private async Task LoadLandingCoreAsync()
    {
        _landingAttempted = true;
        _loading = true;
        _loadFailed = false;

        try
        {
            _landingPage = await MediaTiles.BuildWatchAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Watch landing failed after bounded display API retries.");
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private static readonly LibraryBrowsePreset StaticPreset = new()
    {
        RouteBase = "/watch",
        Title = "Watch",
        HeroVariant = BrowseHeroVariant.Watch,
        UseExplicitDefaultTabRoute = true,
        Tabs =
        [
            new BrowseTabPreset
            {
                Id = "movies",
                Label = "Movies",
                MediaType = "Movies",
                GroupingOptions =
                [
                    new("all", "Movies", AppMaterialIcons.Outlined.LocalMovies),
                    new("series", "Movie Series", AppMaterialIcons.Outlined.Collections),
                    new("directors", "Directors", AppMaterialIcons.Outlined.MovieFilter),
                    new("timeline", "Timeline", AppMaterialIcons.Outlined.Timeline),
                ],
                DefaultGrouping = "all",
                DefaultLayout = LibraryLayoutMode.Card,
                YearSemantic = "Original release year",
            },
            new BrowseTabPreset
            {
                Id = "tv",
                Label = "TV",
                MediaType = "TV",
                GroupingOptions =
                [
                    new("shows", "Shows", AppMaterialIcons.Outlined.LiveTv),
                    new("networks", "Networks", AppMaterialIcons.Outlined.Podcasts),
                    new("timeline", "Timeline", AppMaterialIcons.Outlined.Timeline),
                ],
                DefaultGrouping = "shows",
                DefaultLayout = LibraryLayoutMode.Card,
                YearSemantic = "Show premiere year",
                TimelineAggregation = TimelineAggregation.TvShows,
                TimelineItemNoun = "show",
            },
            new BrowseTabPreset
            {
                Id = "videos",
                Label = "Videos",
                MediaType = "Videos",
                GroupingOptions =
                [
                    new("videos", "Series and videos", AppMaterialIcons.Outlined.VideoLibrary),
                    new("all", "All videos", AppMaterialIcons.Outlined.PlayCircle),
                ],
                DefaultGrouping = "videos",
                DefaultLayout = LibraryLayoutMode.Card,
                YearSemantic = "Upload or release year",
            },
        ],
    };
}
