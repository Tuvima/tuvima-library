@namespace MediaEngine.Web.Components.Pages

@using System.Diagnostics
@using MediaEngine.Contracts.Reading
@using MediaEngine.Domain.Constants
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Navigation
@using MediaEngine.Web.Services.Playback

@inject IEngineApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<BookReader> Logger
@inject UIOrchestratorService Orchestrator
@inject IAppToastService Toast
@inject IUserPlaybackPreferencesAccessor PreferencesAccessor

@implements IAsyncDisposable
@inject IStringLocalizer<SharedStrings> L

@* The foliate-js based book reader (packet BR2), opened by the /read/{AssetId} route (EpubReader.razor) for every EPUB.
   This component owns the chrome and the saved position;
   wwwroot/js/book-reader.js owns everything that touches the book. *@

<PageTitle>@L["Common_Library", string.IsNullOrWhiteSpace(_title) ? L["BookReader_Reader"].Value : _title]</PageTitle>

<link href="css/book-reader.css" rel="stylesheet" />

<div class="br-shell br-theme-@ThemeClass" data-state="@_state">

    @* The script mounts the book view in here; Blazor never puts children in it. *@
    <div class="br-stage" @ref="_host"></div>

    <header class="br-bar br-bar--top @(_chromeVisible ? "" : "br-bar--hidden")" aria-hidden="@(_chromeVisible ? null : "true")">
        <AppNativeButton Class="br-icon-btn" OnClick="ExitReader" Title="@L["BookReader_BackToLibrary"].Value" AriaLabel="@L["BookReader_BackToLibrary"].Value">
            <AppMaterialIcon Icon="@AppMaterialIcons.Filled.ArrowBack" Size="AppSize.Small" />
        </AppNativeButton>
        <div class="br-title">
            <div class="br-title-book">@_title</div>
            @if (!string.IsNullOrWhiteSpace(_author))
            {
                <div class="br-title-author">@_author</div>
            }
        </div>
        @if (_state == "ready")
        {
            <div class="br-actions" role="toolbar" aria-label="@L["BookReader_ReaderTools"].Value">
                <AppNativeButton Class="@($"br-icon-btn {(_panel == "search" ? "br-icon-btn--on" : "")}")" OnClick="@(() => TogglePanel("search"))" Title="@L["BookReader_SearchInThisBook"].Value" AriaLabel="@L["BookReader_SearchInThisBook"].Value">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Search" Size="AppSize.Small" />
                </AppNativeButton>
                <AppNativeButton Class="br-icon-btn" OnClick="@(() => TogglePanel("contents"))" Title="@L["BookReader_Contents"].Value" AriaLabel="@L["BookReader_Contents"].Value">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Toc" Size="AppSize.Small" />
                </AppNativeButton>
                <AppNativeButton Class="br-icon-btn" OnClick="AddBookmarkAsync" Title="@L["BookReader_BookmarkThisPage"].Value" AriaLabel="@L["BookReader_BookmarkThisPage"].Value">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Filled.BookmarkAdd" Size="AppSize.Small" />
                </AppNativeButton>
                <AppNativeButton Class="@($"br-icon-btn {(_panel == "saved" ? "br-icon-btn--on" : "")}")" OnClick="@(() => TogglePanel("saved"))" Title="@L["BookReader_BookmarksAndHighlights"].Value" AriaLabel="@L["BookReader_BookmarksAndHighlights"].Value">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Bookmark" Size="AppSize.Small" />
                </AppNativeButton>
                <AppNativeButton Class="@($"br-icon-btn {(_panel == "settings" ? "br-icon-btn--on" : "")}")" OnClick="@(() => TogglePanel("settings"))" Title="@L["BookReader_ReadingSettings"].Value" AriaLabel="@L["BookReader_ReadingSettings"].Value">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Tune" Size="AppSize.Small" />
                </AppNativeButton>
            </div>
        }
    </header>

    <footer class="br-bar br-bar--bottom @(_chromeVisible ? "" : "br-bar--hidden")" aria-hidden="@(_chromeVisible ? null : "true")">
        <span class="br-section">@_sectionLabel</span>
        <span class="br-percent" aria-label="@L["Common_Progress"].Value">@Percent%</span>
    </footer>

    @if (_state == "ready" && _selection is { } selected && _editing is null && _panel is null)
    {
        <AppCssElement Tag="div" Class="br-float br-float--bar" Css="@FloatCss(selected.Anchor)" role="toolbar" aria-label="@L["BookReader_HighlightTheSelectedText"].Value">
            @foreach (var color in HighlightColor.All)
            {
                <AppNativeButton Class="br-swatch" Css="@SwatchCss(color)" OnClick="@(() => CreateHighlightAsync(color, false))"
                                 Title="@($"Highlight in {ColorName(color)}")" AriaLabel="@($"Highlight in {ColorName(color)}")" />
            }
            <AppNativeButton Class="br-icon-btn br-icon-btn--small" OnClick="@(() => CreateHighlightAsync(HighlightColor.Yellow, true))" Title="@L["BookReader_HighlightAndAddANote"].Value" AriaLabel="@L["BookReader_HighlightAndAddANote"].Value">
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.EditNote" Size="AppSize.Small" />
            </AppNativeButton>
        </AppCssElement>
    }

    @if (_state == "ready" && _editing is { } editing)
    {
        <div class="br-scrim br-scrim--clear" role="presentation" @onclick="CloseEditorAsync"></div>
        <AppCssElement Tag="div" Class="br-float br-float--card" Css="@FloatCss(_editAnchor)" role="dialog" aria-label="@L["BookReader_Highlight"].Value">
            <div class="br-quote">@editing.SelectedText</div>
            <div class="br-swatches" role="group" aria-label="@L["BookReader_HighlightColour"].Value">
                @foreach (var color in HighlightColor.All)
                {
                    <AppNativeButton Class="@($"br-swatch {(string.Equals(editing.Color, color, StringComparison.OrdinalIgnoreCase) ? "br-swatch--on" : "")}")" Css="@SwatchCss(color)"
                                     OnClick="@(() => RecolorHighlightAsync(color))" Title="@ColorName(color)" AriaLabel="@ColorName(color)"
                                     aria-pressed="@(string.Equals(editing.Color, color, StringComparison.OrdinalIgnoreCase) ? "true" : "false")" />
                }
            </div>
            <AppTextField Label="@L["Common_Note"].Value" Value="@_noteDraft" ValueChanged="@(value => _noteDraft = value)" Lines="3" MaxLength="2000" Placeholder="@L["BookReader_AddANote"].Value" />
            <div class="br-card-actions">
                <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Error" OnClick="DeleteHighlightAsync">@L["Common_Delete"]</AppButton>
                <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="CloseEditorAsync">@L["Common_Done"]</AppButton>
            </div>
        </AppCssElement>
    }

    @if (_state == "ready" && _panel is not null)
    {
        <div class="br-scrim" role="presentation" @onclick="ClosePanelAsync"></div>
        <aside class="br-panel" role="dialog" aria-label="@PanelTitle">
            <div class="br-panel-head">
                <h2 class="br-panel-title">@PanelTitle</h2>
                <AppNativeButton Class="br-icon-btn" OnClick="ClosePanelAsync" Title="@L["Common_Close"].Value" AriaLabel="@($"Close {PanelTitle}")">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Close" Size="AppSize.Small" />
                </AppNativeButton>
            </div>
            <div class="br-panel-body">
                @if (_panel == "contents")
                {
                    @if (_toc.Count == 0)
                    {
                        <p class="br-empty">@L["BookReader_ThisBookHasNoContents"]</p>
                    }
                    else
                    {
                        <ul class="br-list">
                            @foreach (var item in _toc)
                            {
                                <li>
                                    <AppNativeButton Class="@($"br-row br-row--level{Math.Min(item.Level, 3)} {(IsCurrentSection(item) ? "br-row--current" : "")}")"
                                                     OnClick="@(() => OpenTocItemAsync(item))" AriaLabel="@item.Label">
                                        @item.Label
                                    </AppNativeButton>
                                </li>
                            }
                        </ul>
                    }
                }
                else if (_panel == "search")
                {
                    <div class="br-search">
                        <AppNativeInput @ref="_searchInput" Type="search" Class="br-search-input" Placeholder="@L["BookReader_SearchInThisBook"].Value" AriaLabel="@L["BookReader_SearchInThisBook"].Value"
                                        Value="@_searchQuery" OnInput="OnSearchInputAsync" OnKeyDown="OnSearchKeyDown" />
                        <AppNativeButton Class="br-icon-btn" OnClick="RunSearchAsync" Title="@L["Nav_Search"].Value" AriaLabel="@L["Nav_Search"].Value" Disabled="@(_searching || _searchQuery.Trim().Length < 2)">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Search" Size="AppSize.Small" />
                        </AppNativeButton>
                    </div>
                    @if (_searching)
                    {
                        <p class="br-hint" role="status">@L["BookReader_SearchingTheBook"]</p>
                    }
                    else if (_searchResult is null)
                    {
                        <p class="br-hint">@L["BookReader_TypeAtLeastTwoLetters"]</p>
                    }
                    else if (_searchResult.Failed && _searchResult.Hits.Count == 0)
                    {
                        <p class="br-empty" role="status">@L["BookReader_TheSearchCouldNotFinish"]</p>
                    }
                    else if (_searchResult.Hits.Count == 0)
                    {
                        <p class="br-empty" role="status">@L["BookReader_NothingInThisBookMatches", _searchedFor]</p>
                    }
                    else
                    {
                        <p class="br-hint" role="status">@(_searchResult.Truncated ? $"Showing the first {_searchResult.Hits.Count} places. Search for more words to narrow it down." : _searchResult.Hits.Count == 1 ? "1 place found." : $"{_searchResult.Hits.Count} places found.")</p>
                        <ul class="br-list">
                            @foreach (var hit in _searchResult.Hits)
                            {
                                <li>
                                    <AppNativeButton Class="br-row" OnClick="@(() => OpenSearchHitAsync(hit))">
                                        @if (!string.IsNullOrWhiteSpace(hit.Label))
                                        {
                                            <span class="br-row-sub">@hit.Label</span>
                                        }
                                        <span class="br-row-main">@hit.Pre<mark class="br-search-match">@hit.Match</mark>@hit.Post</span>
                                    </AppNativeButton>
                                </li>
                            }
                        </ul>
                    }
                }
                else if (_panel == "saved")
                {
                    <AppSegmentedControl Options="SavedTabs" Value="@_savedTab" ValueChanged="@(value => { _savedTab = value; })" AriaLabel="@L["BookReader_SavedPlaces"].Value" />
                    @if (_savedTab == "bookmarks")
                    {
                        <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Primary" OnClick="AddBookmarkAsync" StartIcon="@AppMaterialIcons.Filled.BookmarkAdd">
                            @L["BookReader_BookmarkThisPage"]
                        </AppButton>
                        @if (_bookmarks.Count == 0)
                        {
                            <p class="br-empty">@L["BookReader_NoBookmarksYet"]</p>
                        }
                        else
                        {
                            <ul class="br-list">
                                @foreach (var mark in _bookmarks)
                                {
                                    <li class="br-item">
                                        <AppNativeButton Class="br-row br-row--grow" OnClick="@(() => OpenBookmarkAsync(mark))" AriaLabel="@($"Go to bookmark {mark.Label}")">
                                            <span class="br-row-main">@(string.IsNullOrWhiteSpace(mark.Label) ? "Bookmark" : mark.Label)</span>
                                            <span class="br-row-sub">@mark.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</span>
                                        </AppNativeButton>
                                        <AppNativeButton Class="br-icon-btn br-icon-btn--small" OnClick="@(() => DeleteBookmarkAsync(mark))" Title="@L["Common_DeleteBookmark"].Value" AriaLabel="@L["Common_DeleteBookmark"].Value">
                                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.DeleteOutline" Size="AppSize.Small" />
                                        </AppNativeButton>
                                    </li>
                                }
                            </ul>
                        }
                    }
                    else if (_highlights.Count == 0)
                    {
                        <p class="br-empty">@L["BookReader_NoHighlightsYetSelectSome"]</p>
                    }
                    else
                    {
                        <ul class="br-list">
                            @foreach (var mark in _highlights)
                            {
                                <li class="br-item">
                                    <AppNativeButton Class="br-row br-row--grow" OnClick="@(() => OpenHighlightAsync(mark))" AriaLabel="@($"Go to highlight {mark.SelectedText}")">
                                        <span class="br-row-main br-row-main--quote" data-color="@mark.Color">@mark.SelectedText</span>
                                        @if (!string.IsNullOrWhiteSpace(mark.NoteText))
                                        {
                                            <span class="br-row-sub">@mark.NoteText</span>
                                        }
                                    </AppNativeButton>
                                </li>
                            }
                        </ul>
                    }
                }
                else
                {
                    <div class="br-field">
                        <div class="br-field-label">@L["Common_Theme"]</div>
                        <AppSegmentedControl Options="ThemeOptions" Value="@_settings.Theme" ValueChanged="SetThemeAsync" AriaLabel="@L["BookReader_ReadingTheme"].Value" />
                    </div>
                    <div class="br-field">
                        <div class="br-field-label">@L["Common_TextSize"]</div>
                        <AppSlider Value="@_settings.FontSize" ValueChanged="SetFontSizeAsync" Min="12" Max="32" Step="1" Immediate="false" Label="@L["Common_TextSize"].Value" />
                    </div>
                    <div class="br-field">
                        <div class="br-field-label">@L["Common_LineSpacing"]</div>
                        <AppSlider Value="@((int)Math.Round(_settings.LineHeight * 10))" ValueChanged="SetLineHeightAsync" Min="12" Max="24" Step="1" Immediate="false" Label="@L["Common_LineSpacing"].Value" />
                    </div>
                    <div class="br-field">
                        <div class="br-field-label">@L["Common_Typeface"]</div>
                        <AppSegmentedControl Options="FontOptions" Value="@_settings.Font" ValueChanged="SetFontAsync" AriaLabel="@L["Common_Typeface"].Value" />
                    </div>
                    <div class="br-field">
                        <div class="br-field-label">@L["Common_PageWidth"]</div>
                        <AppSegmentedControl Options="WidthOptions" Value="@_settings.PageWidth" ValueChanged="SetPageWidthAsync" AriaLabel="@L["Common_PageWidth"].Value" />
                    </div>
                    <div class="br-field">
                        <div class="br-field-label">@L["Common_Layout"]</div>
                        <AppSegmentedControl Options="FlowOptions" Value="@_settings.Flow" ValueChanged="SetFlowAsync" AriaLabel="@L["Common_Layout"].Value" />
                    </div>
                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Primary" OnClick="ResetToProfileDefaultsAsync">
                        @L["BookReader_ResetToMyDefaults"]
                    </AppButton>
                    <p class="br-hint">@L["BookReader_TheseChoicesAreRememberedOn"]</p>
                }
            </div>
        </aside>
    }

    @if (!string.IsNullOrEmpty(_notice))
    {
        <div class="br-notice" role="status" aria-live="polite">@_notice</div>
    }

    @if (_state == "loading")
    {
        <div class="br-overlay">
            <AppPageState Kind="AppPageStateKind.Loading" Title="@L["BookReader_OpeningBook"].Value" />
        </div>
    }
    else if (_state == "error")
    {
        <div class="br-overlay">
            <AppPageState Kind="AppPageStateKind.Unavailable"
                          Title="@ErrorTitle"
                          Message="@_errorMessage"
                          Icon="@AppMaterialIcons.Filled.ErrorOutline">
                <Actions>
                    @if (_canRetry)
                    {
                        <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="RetryAsync">
                            @L["Common_TryAgain"]
                        </AppButton>
                    }
                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Primary" OnClick="ExitReader">
                        @L["BookReader_ReturnToLibrary"]
                    </AppButton>
                </Actions>
            </AppPageState>
        </div>
    }
</div>

@code {
    private static readonly TimeSpan SaveInterval = TimeSpan.FromSeconds(5);
    private static readonly TimeSpan ProfileSaveDelay = TimeSpan.FromMilliseconds(600);

    [Parameter] public Guid AssetId { get; set; }
    [Parameter] public Guid? ReturnCollectionId { get; set; }
    [Parameter] public bool Restart { get; set; }

    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<BookReader>? _dotNetRef;
    private System.Threading.Timer? _saveTimer;
    private readonly Stopwatch _sinceSave = Stopwatch.StartNew();
    private readonly Stopwatch _reading = new();
    private readonly string _readerSessionId = Guid.NewGuid().ToString("D");
    private BookReaderOpenOptions _settings = new();
    private BookReaderOpenOptions _profileBase = new();   // the profile's reading defaults; device choices are merged on top
    private CancellationTokenSource? _profileSaveCts;
    private readonly HashSet<string> _pendingProfileKeys = new(StringComparer.Ordinal);   // settings changed in the reader and not yet saved to the profile
    private readonly object _pendingProfileLock = new();
    private readonly SemaphoreSlim _profileSaveGate = new(1, 1);   // one profile write at a time, so an older save never lands after a newer one

    private string _state = "loading";          // loading | ready | error
    private string _title = string.Empty;
    private string? _author;
    private string _sectionLabel = string.Empty;
    private string? _errorCode;
    private string? _errorMessage;
    private bool _canRetry;
    private bool _chromeVisible = true;
    private bool _opened;
    private bool _exited;
    private bool _removed; // the title was deleted from the library: nothing more is saved for it
    private bool _disposing;
    private bool _disposed;
    private double _fraction;
    private double _baseReadingSeconds;
    private string? _latestCfi;
    private string? _savedCfi;

    // Panels, saved places and the highlight tools.
    private string? _panel;                     // null | search | contents | saved | settings
    private AppNativeInput? _searchInput;
    private string _searchQuery = string.Empty;
    private string _searchedFor = string.Empty;
    private BookReaderSearchResult? _searchResult;
    private bool _searching;
    private bool _focusSearch;
    private string _savedTab = "bookmarks";     // bookmarks | highlights
    private List<BookReaderTocItem> _toc = [];
    private List<ReaderBookmarkDto> _bookmarks = [];
    private List<ReaderHighlightDto> _highlights = [];
    private PendingSelection? _selection;
    private ReaderHighlightDto? _editing;
    private Anchor _editAnchor = new(0, 0, 0, 0);
    private string? _noteDraft;
    private string? _notice;
    private System.Threading.Timer? _noticeTimer;

    private sealed record Anchor(double X, double Y, double W, double H);
    private sealed record PendingSelection(string Cfi, string Text, Anchor Anchor);

    private static readonly IReadOnlyList<AppSelectOption> SavedTabs =
    [
        new("bookmarks", "Bookmarks"),
        new("highlights", "Highlights"),
    ];
    private static readonly IReadOnlyList<AppSelectOption> ThemeOptions =
    [
        new("light", "Light"),
        new("dark", "Dark"),
        new("sepia", "Sepia"),
        new("system", "Auto"),
    ];
    private static readonly IReadOnlyList<AppSelectOption> FontOptions =
    [
        new("book", "Book's own"),
        new("serif", "Serif"),
        new("sans", "Sans"),
    ];
    private static readonly IReadOnlyList<AppSelectOption> WidthOptions =
    [
        new("narrow", "Narrow"),
        new("standard", "Standard"),
        new("wide", "Wide"),
    ];
    private static readonly IReadOnlyList<AppSelectOption> FlowOptions =
    [
        new("paginated", "Pages"),
        new("scrolled", "Scroll"),
    ];

    private string PanelTitle => _panel switch
    {
        "search" => "Search",
        "contents" => "Contents",
        "saved" => "Bookmarks and highlights",
        _ => "Reading settings",
    };

    private string ThemeClass => _settings.Theme is "dark" or "sepia" or "system" ? _settings.Theme : "light";
    private int Percent => (int)Math.Round(Math.Clamp(_fraction, 0, 1) * 100);
    private string ErrorTitle => _errorCode switch
    {
        "unsupported" => "Not supported yet",
        "changed" => "This book was updated",
        _ => "Book failed to load",
    };

    protected override void OnInitialized() => Orchestrator.OnLibraryItemsRemoved += OnLibraryItemsRemoved;

    // The title being read was deleted from the library (here or in another window): stop reading, say why, and leave. Nothing is saved
    // for it, because its progress went with it.
    private void OnLibraryItemsRemoved(MediaEngine.Contracts.Realtime.LibraryItemsRemovedEvent removed)
    {
        if (!removed.AssetIds.Contains(AssetId))
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (_exited || _disposed || _disposing)
            {
                return;
            }

            _exited = true;
            _removed = true;
            Toast.Add(MediaEngine.Web.Components.Shared.LibraryItemDeletionText.NoLongerInLibrary, AppSeverity.Info);
            Nav.NavigateTo("/", replace: true);
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusSearch && _panel == "search" && _searchInput is not null)
        {
            _focusSearch = false;
            try
            {
                await _searchInput.FocusAsync();
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
            {
                Logger.LogDebug(ex, "The search box could not take focus.");
            }
        }

        if (!firstRender || _opened)
        {
            return;
        }

        _opened = true;
        await OpenAsync();
    }

    private async Task OpenAsync()
    {
        _state = "loading";
        _errorMessage = null;
        StateHasChanged();

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/book-reader.js");
            await LoadSettingsAsync();

            // Saved places load while the book opens; both calls answer with an empty list when they fail.
            var bookmarksTask = Api.GetBookmarksAsync(AssetId);
            var highlightsTask = Api.GetHighlightsAsync(AssetId);

            // A book that was never read has no saved position (the Engine answers 404, which comes back as null here).
            var progress = Restart ? null : await Api.GetProgressAsync(AssetId);
            string? lastLocation = null;
            if (progress is not null)
            {
                if (progress.ExtendedProperties.TryGetValue("cfi", out var cfi) && !string.IsNullOrWhiteSpace(cfi))
                {
                    lastLocation = cfi;
                }

                if (progress.ExtendedProperties.TryGetValue("position_seconds", out var seconds)
                    && double.TryParse(seconds, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
                {
                    _baseReadingSeconds = Math.Max(0, parsed);
                }
            }

            _dotNetRef ??= DotNetObjectReference.Create(this);
            if (_saveTimer is { } previousTimer)
            {
                await previousTimer.DisposeAsync();
                _saveTimer = null;
            }

            var options = new BookReaderOpenOptions
            {
                LastLocation = lastLocation,
                Theme = ThemeClass,
                FontSize = _settings.FontSize,
                LineHeight = _settings.LineHeight,
                Font = _settings.Font,
                PageWidth = _settings.PageWidth,
                Flow = _settings.Flow,
            };
            var result = await _module.InvokeAsync<BookReaderOpenResult>(
                "open", _host, EngineBookProxyPath.ToBrowserUrl(AssetId), options, _dotNetRef);

            if (_disposing || _disposed || result.Code == "cancelled")
            {
                return;
            }

            if (!result.Ok)
            {
                ShowError(result.Code, result.Message);
                return;
            }

            _title = result.Title ?? string.Empty;
            _author = result.Author;
            _fraction = result.Fraction;
            // Bookmarks from the retired reader are character offsets, highlights have no range: only positions this reader can use are shown.
            _bookmarks = (await bookmarksTask)
                .Where(mark => mark.CfiPosition?.StartsWith("epubcfi(", StringComparison.Ordinal) == true)
                .OrderByDescending(mark => mark.CreatedAt).ToList();
            _highlights = (await highlightsTask)
                .Where(mark => !string.IsNullOrWhiteSpace(mark.CfiRange))
                .OrderBy(mark => mark.CreatedAt).ToList();
            await LoadContentsAndHighlightsAsync();
            _state = "ready";
            _reading.Restart();
            if (_disposing || _disposed)
            {
                return;
            }

            _saveTimer = new System.Threading.Timer(_ => _ = InvokeAsync(FlushIfDirtyAsync), null, SaveInterval, SaveInterval);
        }
        catch (Exception ex)
        {
            // Anything that goes wrong while starting (script, network, a closed connection) ends in the error
            // screen with a working Try again, never in a crashed page.
            if (_disposing || _disposed)
            {
                return;
            }

            Logger.LogWarning(ex, "The book reader could not start for {AssetId}.", AssetId);
            ShowError("unavailable", "The reader could not start. Try again, or reload the page.");
            return;
        }

        StateHasChanged();
    }

    private void ShowError(string? code, string? message)
    {
        _errorCode = code;
        _errorMessage = string.IsNullOrWhiteSpace(message) ? "This book could not be opened." : message;
        _canRetry = code is "busy" or "offline" or "unavailable" or "changed";
        _state = "error";
        StateHasChanged();
    }

    private async Task RetryAsync()
    {
        // Keep the place the reader reached before it stopped; a changed book simply falls back to the start.
        await SaveProgressAsync();
        await OpenAsync();
    }

    // ---- Calls from the script -------------------------------------------------------------------------------

    [JSInvokable]
    public async Task OnRelocated(string cfi, double fraction, string label)
    {
        if (_disposed || _state != "ready")
        {
            return;
        }

        _latestCfi = cfi;
        _fraction = fraction;
        _sectionLabel = label ?? string.Empty;
        // The page moved under any floating tool.
        _selection = null;
        if (_editing is not null)
        {
            _ = InvokeAsync(CloseEditorAsync);
        }

        StateHasChanged();

        if (_sinceSave.Elapsed >= SaveInterval)
        {
            await SaveProgressAsync();
        }
    }

    // The book could not be read any further (it was replaced on disk, or the sign-in ended). Show the error screen.
    [JSInvokable]
    public Task OnFailed(string code, string message)
    {
        if (!_disposing && !_disposed && _state == "ready")
        {
            // Nothing more to save while the error screen is up; Try again saves the place first and starts over.
            _saveTimer?.Dispose();
            _saveTimer = null;
            _reading.Stop();
            ShowError(code, message);
        }

        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnToggleChrome()
    {
        _chromeVisible = !_chromeVisible;
        StateHasChanged();
        return Task.CompletedTask;
    }

    // Ctrl or Cmd + F inside the book: the browser's Find cannot see inside the book's pages, so the reader's own search opens.
    [JSInvokable]
    public async Task OnOpenSearch()
    {
        if (_disposed || _state != "ready" || _editing is not null)
        {
            return;
        }

        if (_panel != "search")
        {
            await TogglePanel("search");
        }
        else
        {
            _focusSearch = true;
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnEscape()
    {
        // Escape closes the innermost thing first and leaves the book last.
        if (_editing is not null)
        {
            await CloseEditorAsync();
        }
        else if (_selection is not null)
        {
            _selection = null;
            await CallScriptAsync("clearSelection");
            StateHasChanged();
        }
        else if (_panel is not null)
        {
            await ClosePanelAsync();
        }
        else
        {
            await ExitReader();
        }
    }

    [JSInvokable]
    public Task OnSelection(string cfi, string text, double x, double y, double w, double h)
    {
        if (_disposed || _state != "ready" || _editing is not null || _panel is not null)
        {
            return Task.CompletedTask;
        }

        _selection = new PendingSelection(cfi, text, new Anchor(x, y, w, h));
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnSelectionCleared()
    {
        if (_selection is not null)
        {
            _selection = null;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnHighlightTapped(string id, double x, double y, double w, double h)
    {
        if (_disposed || _state != "ready" || _panel is not null || !Guid.TryParse(id, out var highlightId))
        {
            return;
        }

        var highlight = _highlights.FirstOrDefault(mark => mark.Id == highlightId);
        if (highlight is null)
        {
            return;
        }

        _selection = null;
        _editing = highlight;
        _editAnchor = new Anchor(x, y, w, h);
        _noteDraft = highlight.NoteText;
        await CallScriptAsync("setInputPaused", true);
        StateHasChanged();
    }

    // ---- Saving the place ---------------------------------------------------------------------------------------

    private async Task FlushIfDirtyAsync()
    {
        if (!_disposed && _latestCfi is not null && _latestCfi != _savedCfi)
        {
            await SaveProgressAsync();
        }
    }

    private async Task SaveProgressAsync()
    {
        var cfi = _latestCfi;
        if (_removed || string.IsNullOrWhiteSpace(cfi))
        {
            return;
        }

        _sinceSave.Restart();
        _savedCfi = cfi;
        try
        {
            var properties = new Dictionary<string, string>
            {
                ["reader_session_id"] = _readerSessionId,
                ["reader"] = "foliate",
                ["cfi"] = cfi,
                ["position_seconds"] = Math.Max(0, _baseReadingSeconds + _reading.Elapsed.TotalSeconds).ToString("0", System.Globalization.CultureInfo.InvariantCulture),
                ["media_kind"] = "reading",
            };
            await Api.SaveProgressAsync(AssetId, progressPct: Math.Clamp(_fraction, 0, 1) * 100.0, extendedProperties: properties);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to save book reader progress.");
        }
    }

    // ---- Settings (the profile's defaults, with this device's choices on top) -----------------------------------

    private async Task LoadSettingsAsync()
    {
        // The profile's reading defaults are the base. Without them (not signed in, Engine unreachable) the reader's own defaults apply.
        try
        {
            var profile = await PreferencesAccessor.GetAsync();
            _profileBase = ReaderProfileSettings.ToOpenOptions(profile?.Reading);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The profile's reading defaults could not be loaded; the reader's own defaults apply.");
            _profileBase = new BookReaderOpenOptions();
        }

        try
        {
            // The script merges this device's saved choices onto the profile base (device wins per key) and validates
            // them, so no stored-JSON shape is parsed on this side.
            _settings = await _module!.InvokeAsync<BookReaderOpenOptions>("loadSettings", _profileBase);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            Logger.LogDebug(ex, "Failed to load reader settings from local storage.");
            _settings = _profileBase;
        }
    }

    private async Task ApplySettingsAsync(BookReaderOpenOptions next)
    {
        // Only the setting(s) the person just changed are remembered on this device and saved to the profile; every
        // other setting stays with whichever of the two owns it, so the profile's values keep reaching this device.
        var changed = ReaderProfileSettings.ChangedKeys(_settings, next);
        await ShowSettingsAsync(next);
        if (changed.Count == 0)
        {
            return;
        }

        await CallScriptAsync("saveSettings", ReaderProfileSettings.SelectKeys(next, changed));
        QueueProfileSave(changed);
    }

    private async Task ShowSettingsAsync(BookReaderOpenOptions next)
    {
        _settings = next;
        await CallScriptAsync("setAppearance", SettingsArgument(next));
    }

    private static object SettingsArgument(BookReaderOpenOptions next) =>
        new { theme = next.Theme, fontSize = next.FontSize, lineHeight = next.LineHeight, font = next.Font, pageWidth = next.PageWidth, flow = next.Flow };

    /// <summary>Forgets this device's choices and shows the profile's reading defaults again.</summary>
    private async Task ResetToProfileDefaultsAsync()
    {
        CancelProfileSaveDelay();
        lock (_pendingProfileLock)
        {
            _pendingProfileKeys.Clear();
        }

        await CallScriptAsync("clearSettings");

        // Pick up what the profile holds now (it may have been changed on another device or in Settings). A save that is
        // already on its way finishes first, so what is shown is what the profile ends up holding.
        await _profileSaveGate.WaitAsync();
        try
        {
            PreferencesAccessor.Invalidate();
            var profile = await PreferencesAccessor.GetAsync();
            if (profile is not null)
            {
                _profileBase = ReaderProfileSettings.ToOpenOptions(profile.Reading);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The profile's reading defaults could not be refreshed; the last known defaults are used.");
        }
        finally
        {
            _profileSaveGate.Release();
        }

        await ShowSettingsAsync(_profileBase);
    }

    // ---- Saving the reader's choices to the profile (debounced, one at a time, in the background) ----------------

    private void QueueProfileSave(IEnumerable<string> changedKeys)
    {
        lock (_pendingProfileLock)
        {
            _pendingProfileKeys.UnionWith(changedKeys);
        }

        CancelProfileSaveDelay();
        var cts = _profileSaveCts = new CancellationTokenSource();
        _ = SaveProfileAfterDelayAsync(cts.Token);
    }

    private void CancelProfileSaveDelay()
    {
        if (_profileSaveCts is { } cts)
        {
            _profileSaveCts = null;
            cts.Cancel();
            cts.Dispose();
        }
    }

    private async Task SaveProfileAfterDelayAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(ProfileSaveDelay, ct);
        }
        catch (OperationCanceledException)
        {
            // A newer change (or a reset, or closing the reader) replaced this wait; it is not a failure.
            return;
        }

        await SavePendingToProfileAsync();
    }

    private async Task SavePendingToProfileAsync()
    {
        // Saves run one at a time. What is pending is taken only once this save has its turn, so a save that waited
        // writes the newest values of everything changed so far and an older save can never overwrite a newer one.
        await _profileSaveGate.WaitAsync();
        try
        {
            string[] keys;
            lock (_pendingProfileLock)
            {
                keys = [.. _pendingProfileKeys];
                _pendingProfileKeys.Clear();
            }

            if (keys.Length == 0)
            {
                return;
            }

            // Read the profile's current settings and change only the reader settings the person changed, so nothing else is overwritten.
            var current = await Orchestrator.GetPlaybackSettingsAsync();
            if (current is null)
            {
                Logger.LogWarning("The reader's choices could not be saved to the profile: the profile's settings were unavailable.");
                return;
            }

            ReaderProfileSettings.ApplyTo(current.Reading, _settings, keys);
            var saved = await Orchestrator.SavePlaybackSettingsAsync(current);
            if (saved is null)
            {
                Logger.LogWarning("The reader's choices could not be saved to the profile.");
                return;
            }

            PreferencesAccessor.UpdateCache(saved);
            _profileBase = ReaderProfileSettings.ToOpenOptions(saved.Reading);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The reader's choices could not be saved to the profile.");
        }
        finally
        {
            _profileSaveGate.Release();
        }
    }

    private Task SetThemeAsync(string value) => ApplySettingsAsync(_settings with { Theme = value });
    private Task SetFontSizeAsync(int value) => ApplySettingsAsync(_settings with { FontSize = Math.Clamp(value, 12, 32) });
    private Task SetLineHeightAsync(int value) => ApplySettingsAsync(_settings with { LineHeight = Math.Clamp(value, 12, 24) / 10.0 });
    private Task SetFontAsync(string value) => ApplySettingsAsync(_settings with { Font = value });
    private Task SetPageWidthAsync(string value) => ApplySettingsAsync(_settings with { PageWidth = value });
    private Task SetFlowAsync(string value) => ApplySettingsAsync(_settings with { Flow = value });

    // ---- Panels --------------------------------------------------------------------------------------------------

    private async Task TogglePanel(string panel)
    {
        if (_panel == panel)
        {
            await ClosePanelAsync();
            return;
        }

        _panel = panel;
        _focusSearch = panel == "search";
        _selection = null;
        await CallScriptAsync("setInputPaused", true);
        await CallScriptAsync("clearSelection");
    }

    private async Task ClosePanelAsync()
    {
        _panel = null;
        await CallScriptAsync("setInputPaused", false);
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await RunSearchAsync();
        }
    }

    // Emptying the box takes the outlines off the page and the list away.
    private async Task OnSearchInputAsync(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        if (_searchQuery.Length == 0 && _searchResult is not null)
        {
            _searchResult = null;
            await CallScriptAsync("clearSearch");
        }
    }

    private int _searchRun;

    private async Task RunSearchAsync()
    {
        var query = _searchQuery.Trim();
        if (_module is null || _disposed || query.Length < 2)
        {
            return;
        }

        var run = ++_searchRun;
        _searching = true;
        StateHasChanged();
        try
        {
            var result = await _module.InvokeAsync<BookReaderSearchResult>("search", query);
            if (!result.Cancelled && run == _searchRun)
            {
                _searchResult = result;
                _searchedFor = query;
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            Logger.LogDebug(ex, "The book search failed.");
            ShowNotice("The search could not finish. Try again.");
        }
        finally
        {
            if (run == _searchRun)
            {
                _searching = false;
            }
        }
    }

    // A found place: close the list and go there; its matches stay outlined on the page until the next search.
    private async Task OpenSearchHitAsync(BookReaderSearchHit hit)
    {
        await ClosePanelAsync();
        await CallScriptAsync("goTo", hit.Cfi);
    }

    private bool IsCurrentSection(BookReaderTocItem item) =>
        !string.IsNullOrEmpty(_sectionLabel) && string.Equals(item.Label, _sectionLabel, StringComparison.Ordinal);

    private async Task OpenTocItemAsync(BookReaderTocItem item)
    {
        await ClosePanelAsync();
        await CallScriptAsync("goToHref", item.Href);
    }

    private async Task LoadContentsAndHighlightsAsync()
    {
        try
        {
            var module = _module!;
            _toc = await module.InvokeAsync<List<BookReaderTocItem>>("getToc");
            var marks = _highlights.Select(mark => new BookReaderHighlightMark(mark.Id.ToString("D"), mark.CfiRange!, mark.Color)).ToList();
            await module.InvokeVoidAsync("setHighlights", marks);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            Logger.LogDebug(ex, "Could not hand the contents and highlights to the book reader script.");
        }
    }

    // A script call that must never take the page down: the reader keeps working without the tool that failed.
    private async Task CallScriptAsync(string method, params object?[] args)
    {
        if (_module is null || _disposed)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync(method, args);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            Logger.LogDebug(ex, "The book reader script call {Method} failed.", method);
        }
    }

    private void ShowNotice(string message)
    {
        _notice = message;
        _noticeTimer?.Dispose();
        _noticeTimer = new System.Threading.Timer(_ => _ = InvokeAsync(() =>
        {
            _notice = null;
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(2.5), System.Threading.Timeout.InfiniteTimeSpan);
    }

    // ---- Bookmarks ---------------------------------------------------------------------------------------------

    private async Task AddBookmarkAsync()
    {
        await CaptureLatestLocationAsync();
        var cfi = _latestCfi;
        if (string.IsNullOrWhiteSpace(cfi))
        {
            return;
        }

        if (_bookmarks.Any(mark => string.Equals(mark.CfiPosition, cfi, StringComparison.Ordinal)))
        {
            ShowNotice("This page is already bookmarked.");
            return;
        }

        var where = string.IsNullOrWhiteSpace(_sectionLabel) ? "Page" : _sectionLabel;
        var label = $"{where} · {Percent}%";
        var created = await Api.CreateBookmarkAsync(AssetId, 0, cfi, label.Length > 200 ? label[..200] : label);
        if (created is null)
        {
            ShowNotice("The bookmark could not be saved. Try again.");
            return;
        }

        _bookmarks.Insert(0, created);
        ShowNotice("Bookmark added.");
    }

    private async Task OpenBookmarkAsync(ReaderBookmarkDto mark)
    {
        await ClosePanelAsync();
        await GoToPlaceAsync(mark.CfiPosition);
    }

    private async Task DeleteBookmarkAsync(ReaderBookmarkDto mark)
    {
        if (await Api.DeleteBookmarkAsync(mark.Id))
        {
            _bookmarks.Remove(mark);
        }
        else
        {
            ShowNotice("The bookmark could not be deleted. Try again.");
        }
    }

    private async Task GoToPlaceAsync(string? cfi)
    {
        if (_module is null || string.IsNullOrWhiteSpace(cfi))
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("goTo", cfi);
        }
        catch (JSException ex)
        {
            // A saved place the book no longer has (the file was replaced) just says so.
            Logger.LogDebug(ex, "A saved place could not be opened.");
            ShowNotice("That place could not be found in this book.");
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException)
        {
            Logger.LogDebug(ex, "The book reader script was not available to open a saved place.");
        }
    }

    // ---- Highlights --------------------------------------------------------------------------------------------

    private async Task CreateHighlightAsync(string color, bool withNote)
    {
        var selection = _selection;
        if (selection is null)
        {
            return;
        }

        _selection = null;
        if (_highlights.Any(mark => string.Equals(mark.CfiRange, selection.Cfi, StringComparison.Ordinal)))
        {
            ShowNotice("That text is already highlighted.");
            await CallScriptAsync("clearSelection");
            return;
        }

        var created = await Api.CreateHighlightAsync(AssetId, selection.Cfi, selection.Text, color, null);
        if (created is null)
        {
            ShowNotice("The highlight could not be saved. Try again.");
            return;
        }

        _highlights.Add(created);
        await CallScriptAsync("addHighlight", new BookReaderHighlightMark(created.Id.ToString("D"), selection.Cfi, color));
        await CallScriptAsync("clearSelection");
        if (withNote)
        {
            _editing = created;
            _editAnchor = selection.Anchor;
            _noteDraft = null;
            await CallScriptAsync("setInputPaused", true);
        }
    }

    private async Task RecolorHighlightAsync(string color)
    {
        if (_editing is not { } current || string.Equals(current.Color, color, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        // The update call replaces the note, so the note being typed travels along with the colour.
        var note = string.IsNullOrWhiteSpace(_noteDraft) ? null : _noteDraft;
        if (!await Api.UpdateHighlightAsync(current.Id, color, note))
        {
            ShowNotice("The colour could not be changed. Try again.");
            return;
        }

        // The card may have been closed (the page turned) while the call was out; only an open card for this highlight is refreshed.
        var updated = ReplaceHighlight(_highlights.FirstOrDefault(mark => mark.Id == current.Id) ?? current, color, note);
        if (_editing?.Id == current.Id)
        {
            _editing = updated;
        }

        await CallScriptAsync("recolorHighlight", current.Id.ToString("D"), color);
    }

    private async Task CloseEditorAsync()
    {
        if (_editing is not { } current)
        {
            return;
        }

        _editing = null;
        var note = string.IsNullOrWhiteSpace(_noteDraft) ? null : _noteDraft.Trim();
        // Compare with the stored copy, which a colour change made while the card was open may have refreshed.
        var stored = _highlights.FirstOrDefault(mark => mark.Id == current.Id) ?? current;
        if (!string.Equals(note, stored.NoteText, StringComparison.Ordinal))
        {
            if (await Api.UpdateHighlightAsync(stored.Id, null, note))
            {
                ReplaceHighlight(stored, _highlights.FirstOrDefault(mark => mark.Id == stored.Id)?.Color ?? stored.Color, note);
            }
            else
            {
                ShowNotice("The note could not be saved. Try again.");
            }
        }

        await CallScriptAsync("setInputPaused", _panel is not null);
        StateHasChanged();
    }

    private async Task DeleteHighlightAsync()
    {
        if (_editing is not { } current)
        {
            return;
        }

        _editing = null;
        if (!await Api.DeleteHighlightAsync(current.Id))
        {
            ShowNotice("The highlight could not be deleted. Try again.");
            await CallScriptAsync("setInputPaused", _panel is not null);
            return;
        }

        _highlights.RemoveAll(mark => mark.Id == current.Id);
        await CallScriptAsync("removeHighlight", current.Id.ToString("D"));
        await CallScriptAsync("setInputPaused", _panel is not null);
    }

    private async Task OpenHighlightAsync(ReaderHighlightDto mark)
    {
        await ClosePanelAsync();
        await GoToPlaceAsync(mark.CfiRange);
    }

    private ReaderHighlightDto ReplaceHighlight(ReaderHighlightDto current, string color, string? note)
    {
        var updated = new ReaderHighlightDto
        {
            Id = current.Id,
            UserId = current.UserId,
            AssetId = current.AssetId,
            ChapterIndex = current.ChapterIndex,
            StartOffset = current.StartOffset,
            EndOffset = current.EndOffset,
            CfiRange = current.CfiRange,
            SelectedText = current.SelectedText,
            Color = color,
            NoteText = note,
            CreatedAt = current.CreatedAt,
        };
        var index = _highlights.FindIndex(mark => mark.Id == current.Id);
        if (index >= 0)
        {
            _highlights[index] = updated;
        }

        return updated;
    }

    private static string ColorName(string color) => color.ToUpperInvariant() switch
    {
        "#EAB308" => "yellow",
        "#60A5FA" => "blue",
        "#34D399" => "green",
        "#F472B6" => "pink",
        "#A78BFA" => "purple",
        _ => "this colour",
    };

    private static string SwatchCss(string color) => $"--br-swatch: {color};";

    // The floating tools sit under the first line of the selection, centred on it. The page keeps them on screen.
    private static string FloatCss(Anchor anchor) => FormattableString.Invariant(
        $"--br-fx: {anchor.X + anchor.W / 2:0}px; --br-fy: {anchor.Y + anchor.H + 10:0}px;");

    // ---- Leaving ---------------------------------------------------------------------------------------------------

    /// <summary>The details overlay state, cascaded by the route view; null where the reader is shown on its own.</summary>
    [CascadingParameter] public DetailsOverlayState? Overlay { get; set; }

    private async Task ExitReader()
    {
        if (_exited)
        {
            return;
        }

        _exited = true;
        await CaptureLatestLocationAsync();
        await SaveProgressAsync();

        // What the title's page needs from this exit (where reading stopped) is handed over in memory, not through the address.
        if (ReturnCollectionId.HasValue)
        {
            Overlay?.OfferLastAsset(ReturnCollectionId.Value, AssetId);
        }

        var returnUrl = ReturnCollectionId.HasValue
            ? $"/details/collection/{ReturnCollectionId.Value}"
            : "/";
        await DetailsOverlayNavigation.ExitToTitleAsync(Nav, Overlay, returnUrl);
    }

    // The script reports positions after a short pause; ask it for the very latest one before saving on exit.
    private async Task CaptureLatestLocationAsync()
    {
        if (_module is null || _state != "ready")
        {
            return;
        }

        try
        {
            var latest = await _module.InvokeAsync<BookReaderLocation?>("getLocation");
            if (latest is not null && !string.IsNullOrWhiteSpace(latest.Cfi))
            {
                _latestCfi = latest.Cfi;
                _fraction = latest.Fraction;
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            Logger.LogDebug(ex, "Could not read the latest book position before leaving.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed || _disposing)
        {
            return;
        }

        // From here an open that is still in flight must not start a new save timer.
        _disposing = true;
        Orchestrator.OnLibraryItemsRemoved -= OnLibraryItemsRemoved;

        if (_saveTimer is { } timer)
        {
            await timer.DisposeAsync();
        }

        if (_noticeTimer is { } noticeTimer)
        {
            await noticeTimer.DisposeAsync();
        }

        // A choice made in the last moments is saved now rather than lost with the debounce (after any save already under way).
        CancelProfileSaveDelay();
        await SavePendingToProfileAsync();

        if (!_exited)
        {
            await CaptureLatestLocationAsync();
            await SaveProgressAsync();
        }

        _disposed = true;
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or InvalidOperationException)
        {
            Logger.LogDebug(ex, "Failed to dispose the book reader script.");
        }

        // An open that was in flight when disposal began may have created its timer in the meantime.
        if (_saveTimer is { } lateTimer)
        {
            await lateTimer.DisposeAsync();
            _saveTimer = null;
        }

        _dotNetRef?.Dispose();
    }
}
