@page "/listen/music/playlists/{CollectionId:guid}"
@page "/listen/music/playlists/system/{PlaylistKey}"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Components.Browse
@using MediaEngine.Web.Components.Details
@using MediaEngine.Web.Components.Library
@using MediaEngine.Web.Components.Listen
@using MediaEngine.Web.Components.MediaHub
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Ui
@namespace MediaEngine.Web.Components.Pages
@inject IStringLocalizer<SharedStrings> L

<PageTitle>@PageTitleText</PageTitle>

@if (_redirecting)
{
    <div class="listen-state">
        <AppSpinner Indeterminate="true" Size="AppSize.Large" Class="tl-u-color-rgba-255-255-255-0-32" />
    </div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="listen-state listen-state--error">
        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.LibraryMusic" Class="tl-u-font-size-56px tl-u-opacity-0-22" />
        <h3>@L["ListenPage_ListenCouldNotLoad"]</h3>
        <p>@_error</p>
        <AppNativeButton Type="button" Class="listen-button listen-button--secondary" OnClick="ReloadAsync">@L["Common_TryAgain"]</AppNativeButton>
    </div>
}
else
{
    <div class="@ListenPageClass">
        <aside class="listen-rail-shell">
            <div class="listen-rail">
                <ListenNavigationSection Label="@L["Nav_Library"].Value"
                                         Items="@ListenLibraryItems"
                                         IsRouteActive="IsRouteActive"
                                         OnNavigate="NavigateRailLink" />

                <ListenNavigationSection Label="@L["Common_Formats"].Value"
                                         Items="@ListenFormatItems"
                                         IsRouteActive="IsRouteActive"
                                         OnNavigate="NavigateRailLink" />

                <ListenNavigationSection Label="@L["ListenPage_YourLibrary"].Value"
                                         Items="@ListenYourLibraryItems"
                                         IsRouteActive="IsRouteActive"
                                         OnNavigate="NavigateRailLink" />

                <section class="listen-rail__section" @onclick:stopPropagation="true">
                    <div class="listen-rail__section-heading">
                        <AppNativeButton Type="button" Class="listen-rail__section-toggle" aria-expanded="@_playlistsExpanded" OnClick="@(() => _playlistsExpanded = !_playlistsExpanded)">
                            <span>@L["Glossary_Playlists"]</span>
                            <AppMaterialIcon Icon="@(_playlistsExpanded ? AppMaterialIcons.Outlined.ExpandLess : AppMaterialIcons.Outlined.ExpandMore)" Class="tl-u-font-size-18px" />
                        </AppNativeButton>
                        <AppOverflowMenu Icon="@AppMaterialIcons.Outlined.Add"
                                         AriaLabel="@L["ListenPage_AddPlaylist"].Value"
                                         Size="AppControlSize.Compact"
                                         Class="listen-rail__add-menu"
                                         TriggerClass="listen-rail__add"
                                         PopoverClass="listen-rail__context-popover">
                            <AppMenuItem Label="@L["ListenPage_NewPlaylist"].Value"
                                         Icon="@AppMaterialIcons.Outlined.PlaylistAdd"
                                         OnClick="BeginPlaylistInlineCreate" />
                            @if (!DeviceContext.IsPhone)
                            {
                                <AppMenuItem Label="@L["ListenPage_NewSmartPlaylist"].Value"
                                             Icon="@AppMaterialIcons.Outlined.AutoAwesome"
                                             OnClick='@(() => OpenPlaylistCreateDialog("Smart"))' />
                            }
                        </AppOverflowMenu>
                    </div>

                    @if (_playlistsExpanded)
                    {
                        @if (_creatingPlaylistInline)
                        {
                            <div class="listen-rail__inline-create" @onclick:stopPropagation="true">
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Add" Class="tl-u-font-size-18px" />
                                <AppNativeInput Value="@_newPlaylistName"
                                                ValueChanged="@(value => _newPlaylistName = value?.ToString() ?? string.Empty)"
                                                OnKeyDown="CreatePlaylistOnKeyDownAsync"
                                                Placeholder="@L["ListenPage_PlaylistName"].Value"
                                                AriaLabel="@L["ListenPage_PlaylistName"].Value" />
                            </div>
                        }
                        @foreach (var item in ListenPinnedPlaylistItems)
                        {
                            <a @key="item.Route" href="@item.Route" target="_top" data-enhance-nav="false" class='@($"listen-rail__item {(IsRouteActive(item.Route) ? " is-active" : null)}")' aria-current="@(IsRouteActive(item.Route) ? "page" : null)" @onclick="@(() => NavigateRailLink(item.Route))" @onclick:preventDefault="true">
                                <AppMaterialIcon Icon="@item.Icon" Class="tl-u-font-size-18px" />
                                <span>@item.Label</span>
                            </a>
                        }

                        @foreach (var playlist in PlaylistCollections)
                        {
                            var playlistRoute = $"/listen/music/playlists/{playlist.Id}";
                            <div class="listen-rail__playlist-row @(playlist.Id == _draggingPlaylistId ? "is-dragging" : null)"
                                 @ondragover:preventDefault="true"
                                 @ondrop="@(() => DropPlaylistReorderAsync(playlist.Id))">
                                <AppNativeButton Type="button" Class="listen-rail__drag" draggable="true" AriaLabel="@($"Drag to reorder {playlist.Name}")" @ondragstart="@(() => BeginPlaylistReorder(playlist.Id))" @ondragend="EndPlaylistReorder">
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.DragIndicator" Class="tl-u-font-size-18px" />
                                </AppNativeButton>
                                @if (_deletingPlaylistId == playlist.Id)
                                {
                                    <div class="listen-rail__delete-confirm" role="group" aria-label="@($"Confirm deletion of {playlist.Name}")">
                                        <span>@L["Common_Delete2", playlist.Name]</span>
                                        <AppNativeButton Type="button" Class="is-confirm" AriaLabel="@($"Confirm deletion of {playlist.Name}")" OnClick="@(_ => DeletePlaylistAsync(playlist))"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Check" /></AppNativeButton>
                                        <AppNativeButton Type="button" Class="is-cancel" AriaLabel="@($"Cancel deletion of {playlist.Name}")" OnClick="@(_ => _deletingPlaylistId = null)"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Close" /></AppNativeButton>
                                    </div>
                                }
                                else if (_renamingPlaylistId == playlist.Id)
                                {
                                    <AppNativeInput Class="listen-rail__rename-input"
                                                    Value="@_renamePlaylistName"
                                                    ValueChanged="@(value => _renamePlaylistName = value?.ToString() ?? string.Empty)"
                                                    OnKeyDown="@(args => RenamePlaylistOnKeyDownAsync(playlist, args))"
                                                    AriaLabel="@($"Rename {playlist.Name}")" />
                                }
                                else
                                {
                                    <a href="@playlistRoute" target="_top" data-enhance-nav="false" class='@($"listen-rail__item is-child {(IsRouteActive(playlistRoute) ? "is-active" : null)}")' aria-current="@(IsRouteActive(playlistRoute) ? "page" : null)" @onclick="@(() => NavigateRailLink(playlistRoute))" @onclick:preventDefault="true" @ondragover:preventDefault="@CanAcceptPlaylistItems(playlist)" @ondrop="@(() => CanAcceptPlaylistItems(playlist) ? HandlePlaylistDropAsync(playlist.Id) : Task.CompletedTask)">
                                        @if (!string.IsNullOrWhiteSpace(playlist.CoverArtworkUrl))
                                        {
                                            <span class="listen-rail__thumb"><img src="@MediaTileArtworkUrl.ForDrawnSize(playlist.CoverArtworkUrl, 20)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(playlist.CoverArtworkUrl, 20)" alt="" loading="lazy" decoding="async" /></span>
                                        }
                                        else
                                        {
                                            <AppMaterialIcon Icon="@PlaylistIconFor(playlist)" Class="tl-u-font-size-18px" />
                                        }
                                        <span>@playlist.Name</span>
                                        @if (!CanAcceptPlaylistItems(playlist))
                                        {
                                            <small class="listen-rail__smart-badge">@L["Common_Smart"]</small>
                                        }
                                    </a>
                                }
                                <AppOverflowMenu Icon="@AppMaterialIcons.Outlined.MoreVert"
                                                 AriaLabel="@($"{playlist.Name} options")"
                                                 Size="AppControlSize.Compact"
                                                 Class="listen-rail__more-menu"
                                                 TriggerClass="listen-rail__more"
                                                 PopoverClass="listen-rail__context-popover">
                                    <AppMenuItem Label="@L["Common_Rename"].Value"
                                                 Icon="@AppMaterialIcons.Outlined.DriveFileRenameOutline"
                                                 OnClick="@(() => BeginPlaylistRename(playlist))" />
                                    <AppMenuItem Label="@L["Common_Delete"].Value"
                                                 Icon="@AppMaterialIcons.Outlined.DeleteOutline"
                                                 Tone="AppUiTone.Error"
                                                 DividerBefore="true"
                                                 OnClick="@(() => BeginPlaylistDelete(playlist))" />
                                </AppOverflowMenu>
                            </div>
                        }
                    }
                </section>
            </div>
        </aside>

        <main class="listen-content">
            @if (!IsAudioDetailSurface)
            {
                <div class="listen-lane-header">
                    <LibrarySectionHeader Title="@L["Nav_Listen"].Value"
                                          Modes="@ListenHubModes"
                                          ActiveMode="@ActiveListenMode" />
                </div>
            }

            @if (IsMusicBrowseNavigationVisible)
            {
                <div class="listen-browse-mode">
                    <span>@L["Common_BrowseAs"]</span>
                    <AppBrowseModeSelector Options="@MusicBrowseOptions"
                                           Value="@MusicBrowseMode"
                                           ValueChanged="SetMusicBrowseMode"
                                           AriaLabel="@L["ListenPage_BrowseMusicAs"].Value" />
                </div>
            }

            @if (_loading)
            {
                <div class="listen-state listen-state--content">
                    <AppSpinner Indeterminate="true" Size="AppSize.Large" Class="tl-u-color-rgba-255-255-255-0-32" />
                </div>
            }
            else if (IsListenHub)
            {
                <MediaHubPage SectionType="MediaHubSectionType.Listen"
                              Title="@L["Nav_Listen"].Value"
                              Subtitle="@L["Common_MusicAndAudiobooksFromYour"].Value"
                              SelectedMode="all"
                              AvailableModes="@ListenHubModes"
                              Shelves="@ListenHubShelves"
                              SearchPlaceholder="Search music and audiobooks..."
                              RouteBase="/listen"
                              SupportsHero="false"
                              SupportsHeader="false"
                              SupportsNavigation="false" />
            }
            else if (IsMusicTimelineView)
            {
                <section class="listen-section">
                    <AppTimelineResults Items="@MusicTimelineTiles"
                                        TileSizePx="@_albumTileSizePx"
                                        YearSemantic="Original album release year" />
                </section>
            }
            else if (IsAlbumsView)
            {
                <section class="listen-section">
                    <div class="listen-filter-bar listen-filter-bar--surface">
                        <label class="listen-filter-search">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Search" />
                            <AppNativeInput Class="listen-filter-input"
                                            @bind="_albumSearch"
                                            @bind:event="oninput"
                                            Placeholder="@L["ListenPage_SearchAlbumsOrArtists"].Value"
                                            AriaLabel="@L["ListenPage_SearchAlbumsOrArtists2"].Value" />
                        </label>
                        <label class="listen-filter-field listen-filter-field--genre">
                            <span>@L["Common_Genres"]</span>
                            <AppSelect T="string" Class="listen-filter-select" @bind-Value="_albumGenreFilter" aria-label="@L["ListenPage_FilterAlbumsByGenre"].Value">
                                <AppSelectItem T="string" Value="@("all")">@L["ListenPage_AllGenres"]</AppSelectItem>
                                @foreach (var genre in SongGenres)
                                {
                                    <AppSelectItem T="string" Value="@genre">@genre</AppSelectItem>
                                }
                            </AppSelect>
                        </label>
                        <label class="listen-filter-field">
                            <span>@L["ListenPage_Artist"]</span>
                            <AppSelect T="string" Class="listen-filter-select" @bind-Value="_albumArtistFilter" aria-label="@L["ListenPage_FilterAlbumsByArtist"].Value">
                                <AppSelectItem T="string" Value="@("all")">@L["ListenPage_AllArtists"]</AppSelectItem>
                                @foreach (var artist in AlbumArtists)
                                {
                                    <AppSelectItem T="string" Value="@artist">@artist</AppSelectItem>
                                }
                            </AppSelect>
                        </label>
                        <div class="listen-filter-toggle-stack">
                            <AppQuickFilterToggle Label="@L["Glossary_Favorites"].Value" @bind-Selected="_albumFavoriteOnly" />
                            <AppQuickFilterToggle Label="@L["ListenPage_CompleteAlbums"].Value" @bind-Selected="_albumArtOnly" />
                        </div>
                        <div class="listen-display-group" aria-label="@L["ListenPage_AlbumDisplayControls"].Value">
                            <span class="listen-display-group__eyebrow">@L["Common_Display"]</span>
                            <label class="listen-filter-field listen-filter-field--sort">
                                <span>@L["Common_SortBy"]</span>
                                <AppSelect T="string" Class="listen-filter-select" @bind-Value="_albumSort" aria-label="@L["ListenPage_SortAlbums"].Value">
                                    <AppSelectItem T="string" Value="@("recent")">@L["Nav_RecentlyAdded"]</AppSelectItem>
                                    <AppSelectItem T="string" Value="@("title")">@L["Common_Title"]</AppSelectItem>
                                    <AppSelectItem T="string" Value="@("artist")">@L["ListenPage_Artist"]</AppSelectItem>
                                    <AppSelectItem T="string" Value="@("year")">@L["Common_Year"]</AppSelectItem>
                                </AppSelect>
                            </label>
                            <label class="listen-tile-size" title="@L["ListenPage_AdjustAlbumTileSize"].Value">
                                <span>@L["Common_TileSize"]</span>
                                <span class="listen-tile-size__control">
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PhotoSizeSelectSmall" />
                                    <AppNativeInput Type="range"
                                                    Value="@_albumTileSizePx"
                                                    Min="96"
                                                    Max="208"
                                                    Step="8"
                                                    AriaLabel="@L["ListenPage_AlbumTileSize"].Value"
                                                    OnInput="UpdateAlbumTileSize" />
                                </span>
                            </label>
                        </div>
                    </div>

                    <div class="listen-section__header listen-section__header--results">
                        <div>
                            <h2>@L["ListenPage_Albums"]</h2>
                            <p class="listen-section__summary">@Pluralize(FilteredAlbumGroups.Count, "album") ready to browse.</p>
                        </div>
                        <AppNativeButton Type="button" Class="listen-button listen-button--secondary" OnClick="@(() => PlayTracksAsync(_musicWorks, null, " All Music", true))" Disabled="@(_musicWorks.Count == 0)">@L["ListenPage_ShuffleLibrary"]</AppNativeButton>
                    </div>

                    @if (FilteredAlbumGroups.Count == 0)
                    {
                        <div class="listen-empty">
                            <div>
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Album" Class="tl-u-font-size-56px tl-u-opacity-0-22" />
                                <p>@L["ListenPage_NoAlbumsAreReadyTo"]</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <MediaTileGrid Items="@AlbumTiles"
                                       ShowCompactCaptions="true"
                                       TileSizePx="@_albumTileSizePx"
                                       Class="listen-card-grid listen-card-grid--albums" />
                    }
                </section>
            }
            else if (IsAlbumDetail && _albumDetail is not null)
            {
                <section class="listen-detail listen-detail--album">
                    <div class="listen-detail__art">
                        @if (!string.IsNullOrWhiteSpace(_albumDetail.CoverUrl))
                        {
                            <img src="@MediaTileArtworkUrl.ForDrawnSize(_albumDetail.CoverUrl, 320)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(_albumDetail.CoverUrl, 320)" alt="@_albumDetail.DisplayName" decoding="async" />
                        }
                        else
                        {
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Album" Class="tl-u-font-size-64px" />
                        }
                    </div>
                    <div class="listen-detail__copy">
                        <div class="listen-kicker">@L["ListenPage_Album"]</div>
                        <h2>@_albumDetail.DisplayName</h2>
                        <div class="listen-detail__meta">
                            <span>@StringHelpers.FirstNonBlankOr("-", _albumDetail.Creator, _albumDetail.YearRange, _albumDetail.ReleaseDate)</span>
                            <span>@Pluralize(_albumDetail.TotalItems, "track")</span>
                            @if (!string.IsNullOrWhiteSpace(_albumDetail.TotalDuration))
                            {
                                <span>@_albumDetail.TotalDuration</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_albumDetail.Description))
                        {
                            <p>@_albumDetail.Description</p>
                        }
                        <div class="listen-actions">
                            <AppNativeButton Type="button" Class="listen-button listen-button--secondary" OnClick="@(() => NavigateTo(AlbumsRoute))">@L["ListenPage_BackToAlbums"]</AppNativeButton>
                            <AppNativeButton Type="button" Class="listen-button listen-button--primary" OnClick="@(() => PlayTracksAsync(AlbumTracks, null, _albumDetail.DisplayName))" Disabled="@(AlbumTracks.Count == 0)">
                                <AppMaterialIcon Icon="@AppMaterialIcons.Filled.PlayArrow" Size="AppSize.Small" />
                                <span>@L["Common_Play"]</span>
                            </AppNativeButton>
                            <AppNativeButton Type="button" Class="listen-button listen-button--secondary" OnClick="@(() => PlayTracksAsync(AlbumTracks, null, _albumDetail.DisplayName, true))" Disabled="@(AlbumTracks.Count == 0)">
                                <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Shuffle" Size="AppSize.Small" />
                                <span>@L["Common_Shuffle"]</span>
                            </AppNativeButton>
                            @if (!string.IsNullOrWhiteSpace(_albumDetail.Creator))
                            {
                                <AppNativeButton Type="button" Class="listen-button listen-button--secondary" OnClick="@(() => OpenArtist(_albumDetail.Creator!))">@L["ListenPage_Artist"]</AppNativeButton>
                            }
                        </div>
                    </div>
                </section>

                <section class="listen-section">
                    <div class="listen-section__header">
                        <div>
                            <div class="listen-kicker">@L["Common_Tracks"]</div>
                            <h2>@Pluralize(AlbumTracks.Count, "track")</h2>
                        </div>
                    </div>
                    <ListenSongTable Tracks="@AlbumTracks"
                                     FavoriteIds="@_favoriteWorkIds"
                                     SourceLabel="@_albumDetail.DisplayName"
                                     AriaLabel="@($"{_albumDetail.DisplayName} songs")"
                                     ShowArtwork="false"
                                     ShowAlbum="false"
                                     ShowGenre="false"
                                     ShowDateAdded="false"
                                     DefaultSortColumn="track"
                                     DefaultSortDescending="false"
                                     OnPlayRequested="PlayTracksAsync"
                                     OnFavoriteToggled="ToggleFavoriteAsync"
                                     OnQueueRequested="QueueTrackAsync"
                                     OnPlayNextRequested="PlayNextTrackAsync"
                                     OnTracksChanged="RefreshSongsAsync"
                                     OnDragStarted="OnTrackDragStarted"
                                     OnDragEnded="OnTrackDragEnded" />
                </section>
            }
            else if (IsArtistsSurface)
            {
                @if (string.IsNullOrWhiteSpace(ArtistKey))
                {
                    <section class="listen-section listen-section--people">
                        <div class="listen-section__header">
                            <div>
                                <div class="listen-kicker">@L["Nav_Music"]</div>
                                <h2>@L["ListenPage_Artists"]</h2>
                                <p class="listen-section__summary">@Pluralize(ArtistPersonTiles.Count, "artist") in your library.</p>
                            </div>
                        </div>

                        <div class="listen-filter-bar listen-filter-bar--compact">
                            <AppNativeInput Class="listen-filter-input" @bind="_artistSearch" @bind:event="oninput" Placeholder="@L["ListenPage_SearchArtists"].Value" />
                            <AppSelect T="string" Class="listen-filter-select" @bind-Value="_artistSort">
                                <AppSelectItem T="string" Value="@("name")">@L["ListenPage_ArtistName"]</AppSelectItem>
                                <AppSelectItem T="string" Value="@("tracks")">@L["ListenPage_MostTracks"]</AppSelectItem>
                            </AppSelect>
                        </div>

                        @if (ArtistPersonTiles.Count == 0)
                        {
                            <div class="listen-empty">
                                <div>
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PersonOutline" Class="tl-u-font-size-56px tl-u-opacity-0-22" />
                                    <p>@L["ListenPage_NoArtistsMatchTheseFilters"]</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="listen-artist-grid">
                                @foreach (var artistTile in ArtistPersonTiles)
                                {
                                    <PersonTile Item="@artistTile" />
                                }
                            </div>
                        }
                    </section>
                }
                else
                {
                    <section class="listen-artists">
                    <div class="listen-artists__list">
                        <div class="listen-section__header">
                            <div>
                                <div class="listen-kicker">@L["Nav_Music"]</div>
                                <h2>@L["ListenPage_Artists"]</h2>
                                <p class="listen-section__summary">@Pluralize(FilteredArtistGroups.Count, "artist") in your library.</p>
                            </div>
                        </div>

                        <div class="listen-filter-bar listen-filter-bar--compact">
                            <AppNativeInput Class="listen-filter-input" @bind="_artistSearch" @bind:event="oninput" Placeholder="@L["ListenPage_SearchArtists"].Value" />
                            <AppSelect T="string" Class="listen-filter-select" @bind-Value="_artistSort">
                                <AppSelectItem T="string" Value="@("name")">@L["ListenPage_ArtistName"]</AppSelectItem>
                                <AppSelectItem T="string" Value="@("tracks")">@L["ListenPage_MostTracks"]</AppSelectItem>
                            </AppSelect>
                        </div>

                        <div class="listen-artists__list-body">
                            @foreach (var artist in FilteredArtistGroups)
                            {
                                <AppNativeButton Type="button" Class='@($"listen-list-item {(string.Equals(artist.DisplayName, SelectedArtistName, StringComparison.OrdinalIgnoreCase) ? " is-active" : null)}")' OnClick="@(() => SelectArtistAsync(artist.DisplayName))">
                                    <div class="listen-list-item__thumb">
                                        @if (!string.IsNullOrWhiteSpace(artist.ArtistPhotoUrl))
                                        {
                                            <img src="@MediaTileArtworkUrl.ForDrawnSize(artist.ArtistPhotoUrl, 54)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(artist.ArtistPhotoUrl, 54)" alt="@artist.DisplayName" loading="lazy" decoding="async" />
                                        }
                                        else
                                        {
                                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PersonOutline" Class="tl-u-font-size-20px" />
                                        }
                                    </div>
                                    <div>
                                        <div class="listen-card__title">@artist.DisplayName</div>
                                        <div class="listen-card__meta">@Pluralize(artist.WorkCount, "track")</div>
                                    </div>
                                </AppNativeButton>
                            }
                        </div>
                    </div>

                    <div class="listen-artists__detail">
                        @if (_artistLoading)
                        {
                            <div class="listen-empty">
                                <div>
                                    <AppSpinner Indeterminate="true" Size="AppSize.Large" Class="tl-u-color-rgba-255-255-255-0-32" />
                                    <p>@L["ListenPage_LoadingArtistDetails"]</p>
                                </div>
                            </div>
                        }
                        else if (_artistDetail is null)
                        {
                            <div class="listen-empty">
                                <div>
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PersonOutline" Class="tl-u-font-size-56px tl-u-opacity-0-22" />
                                    <p>@L["ListenPage_ChooseAnArtistToView"]</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <section class="listen-detail listen-detail--artist">
                                <div class="listen-detail__art">
                                    @if (!string.IsNullOrWhiteSpace(_artistDetail.ArtistPhotoUrl))
                                    {
                                        <img src="@MediaTileArtworkUrl.ForDrawnSize(_artistDetail.ArtistPhotoUrl, 320)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(_artistDetail.ArtistPhotoUrl, 320)" alt="@_artistDetail.DisplayName" decoding="async" />
                                    }
                                    else
                                    {
                                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PersonOutline" Class="tl-u-font-size-64px" />
                                    }
                                </div>
                                <div class="listen-detail__copy">
                                    <div class="listen-kicker">@L["ListenPage_Artist"]</div>
                                    <h2>@_artistDetail.DisplayName</h2>
                                    <div class="listen-detail__meta">
                                        <span>@Pluralize(ArtistAlbums.Count, "album")</span>
                                        <span>@Pluralize(ArtistTracks.Count, "track")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(_artistDetail.Description))
                                    {
                                        <p>@_artistDetail.Description</p>
                                    }
                                    <div class="listen-actions">
                                        <AppNativeButton Type="button" Class="listen-button listen-button--primary" OnClick="@(() => PlayTracksAsync(ArtistTracks, null, _artistDetail.DisplayName))" Disabled="@(ArtistTracks.Count == 0)">
                                            <AppMaterialIcon Icon="@AppMaterialIcons.Filled.PlayArrow" Size="AppSize.Small" />
                                            <span>@L["Common_Play"]</span>
                                        </AppNativeButton>
                                        <AppNativeButton Type="button" Class="listen-button listen-button--secondary" OnClick="@(() => PlayTracksAsync(ArtistTracks, null, _artistDetail.DisplayName, true))" Disabled="@(ArtistTracks.Count == 0)">
                                            <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Shuffle" Size="AppSize.Small" />
                                            <span>@L["Common_Shuffle"]</span>
                                        </AppNativeButton>
                                        @if (_artistDetail.ArtistPersonId.HasValue)
                                        {
                                            <AppNativeButton Type="button" Class="listen-button listen-button--secondary" OnClick="@(() => Nav.NavigateTo($"/details/person/{_artistDetail.ArtistPersonId.Value}"))">@L["ListenPage_ViewArtistPage"]</AppNativeButton>
                                        }
                                    </div>
                                </div>
                            </section>

                            @if (ArtistAlbums.Count > 0)
                            {
                                <section class="listen-section">
                                    <div class="listen-section__header">
                                        <div>
                                            <div class="listen-kicker">@L["ListenPage_Albums"]</div>
                                            <h2>@L["ListenPage_Discography"]</h2>
                                            <p class="listen-section__summary">@L["ListenPage_OpenAnAlbumToView"]</p>
                                        </div>
                                    </div>
                                    <MediaTileGrid Items="@ArtistAlbumTiles"
                                                   ShowCompactCaptions="true"
                                                   TileSizePx="@_albumTileSizePx"
                                                   Class="listen-card-grid listen-card-grid--albums" />
                                </section>
                            }

                            <section class="listen-section">
                                <div class="listen-section__header">
                                    <div>
                                        <div class="listen-kicker">@L["Common_Songs"]</div>
                                        <h2>@Pluralize(ArtistTracks.Count, "track")</h2>
                                    </div>
                                </div>

                                @if (ArtistTracks.Count == 0)
                                {
                                    <div class="listen-empty">
                                        <div>
                                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.MusicNote" Class="tl-u-font-size-56px tl-u-opacity-0-22" />
                                            <p>@L["ListenPage_NoSongsAreReadyFor"]</p>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <ListenSongTable Tracks="@ArtistTracks"
                                                     FavoriteIds="@_favoriteWorkIds"
                                                     SourceLabel="@_artistDetail!.DisplayName"
                                                     AriaLabel="@($"{_artistDetail!.DisplayName} songs")"
                                                     ShowArtist="false"
                                                     ShowGenre="false"
                                                     ShowDateAdded="false"
                                                     DefaultSortColumn="album"
                                                     DefaultSortDescending="false"
                                                     OnPlayRequested="PlayTracksAsync"
                                                     OnFavoriteToggled="ToggleFavoriteAsync"
                                                     OnQueueRequested="QueueTrackAsync"
                                                     OnPlayNextRequested="PlayNextTrackAsync"
                                                     OnTracksChanged="RefreshSongsAsync"
                                                     OnDragStarted="OnTrackDragStarted"
                                                     OnDragEnded="OnTrackDragEnded" />
                                }
                            </section>
                        }
                    </div>
                    </section>
                }
            }
            else if (IsSongsView)
            {
                <section class="listen-section">
                    <div class="listen-section__header">
                        <div>
                            <div class="listen-kicker">@L["Nav_Music"]</div>
                            <h2>@L["Common_Songs"]</h2>
                        </div>
                        <div class="listen-actions">
                            <AppNativeButton Type="button" Class="listen-button listen-button--primary" OnClick='@(() => PlayTracksAsync(FilteredSongs, null, "All Music"))' Disabled="@(FilteredSongs.Count == 0)">
                                <AppMaterialIcon Icon="@AppMaterialIcons.Filled.PlayArrow" Size="AppSize.Small" />
                                <span>@L["Common_Play"]</span>
                            </AppNativeButton>
                            <AppNativeButton Type="button" Class="listen-button listen-button--secondary" OnClick='@(() => PlayTracksAsync(FilteredSongs, null, "All Music", true))' Disabled="@(FilteredSongs.Count == 0)">
                                <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Shuffle" Size="AppSize.Small" />
                                <span>@L["Common_Shuffle"]</span>
                            </AppNativeButton>
                        </div>
                    </div>

                    <div class="listen-filter-bar listen-filter-bar--quick">
                        <AppNativeInput Class="listen-filter-input" @bind="_songSearch" @bind:event="oninput" Placeholder="@L["ListenPage_SearchSongsArtistsOrAlbums"].Value" />
                    </div>

                    @if (FilteredSongs.Count == 0)
                    {
                        <div class="listen-empty">
                            <div>
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.MusicNote" Class="tl-u-font-size-56px tl-u-opacity-0-22" />
                                <p>@L["ListenPage_NoSongsAreReadyTo"]</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <ListenSongTable Tracks="@FilteredSongs"
                                         FavoriteIds="@_favoriteWorkIds"
                                         SourceLabel="All Music"
                                         AriaLabel="@L["Common_Songs"].Value"
                                         OnPlayRequested="PlayTracksAsync"
                                         OnFavoriteToggled="ToggleFavoriteAsync"
                                         OnQueueRequested="QueueTrackAsync"
                                         OnPlayNextRequested="PlayNextTrackAsync"
                                         OnTracksChanged="RefreshSongsAsync"
                                         OnDragStarted="OnTrackDragStarted"
                                         OnDragEnded="OnTrackDragEnded" />
                    }
                </section>
            }
            else if (IsPlaylistsView)
            {
                <section class="listen-section">
                    <div class="listen-section__header">
                        <div>
                            <div class="listen-kicker">@L["Nav_Music"]</div>
                            <h2>@L["Glossary_Playlists"]</h2>
                            <p class="listen-section__summary">@L["ListenPage_SavedPlaylistsCreatedFromYour"]</p>
                        </div>
                    </div>

                    @if (PlaylistCollections.Count == 0)
                    {
                        <div class="listen-empty">
                            <div>
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.QueueMusic" Class="tl-u-font-size-56px tl-u-opacity-0-22" />
                                <p>@L["ListenPage_NoSavedPlaylistsYetFavorites"]</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <MediaTileGrid Items="@PlaylistTiles"
                                       ShowCompactCaptions="true"
                                       TileSizePx="@_albumTileSizePx"
                                       Class="listen-card-grid" />
                    }
                </section>
            }
            else if (IsPlaylistSurface)
            {
                <section class="listen-detail listen-detail--collection">
                    <div class="listen-detail__collage">
                        @if (!string.IsNullOrWhiteSpace(ActivePlaylistCollection?.CoverArtworkUrl))
                        {
                            <img class="listen-detail__custom-art" src="@MediaTileArtworkUrl.ForDrawnSize(ActivePlaylistCollection.CoverArtworkUrl, 320)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(ActivePlaylistCollection.CoverArtworkUrl, 320)" alt="" decoding="async" />
                        }
                        else if (PlaylistCoverUrls.Count == 0)
                        {
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.QueueMusic" Class="tl-u-font-size-64px" />
                        }
                        else
                        {
                            @foreach (var cover in PlaylistCoverUrls)
                            {
                                <div class="listen-detail__collage-tile">
                                    <img src="@MediaTileArtworkUrl.ForDrawnSize(cover, 160)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(cover, 160)" alt="" loading="lazy" decoding="async" />
                                </div>
                            }
                        }
                    </div>
                    <div class="listen-detail__copy">
                        <h2>@ActivePlaylistTitle</h2>
                        <div class="listen-actions">
                            <AppNativeButton Type="button" Class="listen-button listen-button--primary" OnClick="@(() => PlayTracksAsync(ActivePlaylistTracks, null, ActivePlaylistTitle))" Disabled="@(ActivePlaylistTracks.Count == 0)">
                                <AppMaterialIcon Icon="@AppMaterialIcons.Filled.PlayArrow" Size="AppSize.Small" />
                                <span>@L["Common_Play"]</span>
                            </AppNativeButton>
                            <AppNativeButton Type="button" Class="listen-button listen-button--secondary" OnClick="@(() => PlayTracksAsync(ActivePlaylistTracks, null, ActivePlaylistTitle, true))" Disabled="@(ActivePlaylistTracks.Count == 0)">
                                <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Shuffle" Size="AppSize.Small" />
                                <span>@L["Common_Shuffle"]</span>
                            </AppNativeButton>
                            @if (CanSaveActivePlaylist)
                            {
                                <AppNativeButton Type="button"
                                                 Class="listen-button listen-button--secondary"
                                                 aria-pressed="@_activePlaylistSaved"
                                                 OnClick="ToggleActivePlaylistSavedAsync">
                                    <AppMaterialIcon Icon="@(_activePlaylistSaved ? AppMaterialIcons.Filled.Favorite : AppMaterialIcons.Outlined.FavoriteBorder)" Size="AppSize.Small" />
                                    <span>@(_activePlaylistSaved ? "In My List" : "Add to My List")</span>
                                </AppNativeButton>
                            }
                        </div>
                    </div>
                    @if (ActivePlaylistCollection is not null)
                    {
                        <AppOverflowMenu Icon="@AppMaterialIcons.Outlined.MoreVert"
                                         AriaLabel="@L["ListenPage_PlaylistDisplayOptions"].Value"
                                         Size="AppControlSize.Compact"
                                         Class="listen-detail__more-menu"
                                         TriggerClass="listen-detail__edit"
                                         PopoverClass="listen-detail__context-popover">
                            <div class="app-menu-section-label" role="presentation">@L["ListenPage_Columns"]</div>
                            @foreach (var column in PlaylistColumns)
                            {
                                <AppMenuItem Label="@column.Label"
                                             Icon="@(IsPlaylistColumnVisible(column.Key) ? AppMaterialIcons.Outlined.Check : AppMaterialIcons.Outlined.VisibilityOff)"
                                             OnClick="@(() => TogglePlaylistColumn(column.Key))" />
                            }
                        </AppOverflowMenu>
                    }
                </section>

                <section class="listen-section">
                    @if (ActivePlaylistTracks.Count == 0)
                    {
                        <div class="listen-empty">
                            <div>
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.QueueMusic" Class="tl-u-font-size-56px tl-u-opacity-0-22" />
                                <p>@L["ListenPage_ThisPlaylistIsEmpty"]</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (DeviceContext.IsPhone)
                        {
                            <AppTable CardsOn="AppTableCardsMode.Phone" Hover="true" Class="listen-playlist-cards">
                                <caption class="sr-only">@ActivePlaylistTitle songs</caption>
                                <thead>
                                    <tr>
                                        <th data-card-role="title">@L["Common_Song"]</th>
                                        <th data-card-role="subtitle">@L["Common_ArtistAndAlbum"]</th>
                                        <th data-card-role="value">@L["Common_Time"]</th>
                                        <th data-card-role="actions"><span class="sr-only">@L["ApiKeys_Actions"]</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in ActivePlaylistTrackRows)
                                    {
                                        var track = row.Work;
                                        <tr @key="@(row.Item?.Id ?? track.Id)"
                                            id="@(row.Item is { } rowItem ? PlaylistRowDomId(rowItem.Id) : null)"
                                            tabindex="0"
                                            @onclick="@(() => PlayTracksAsync(ActivePlaylistTracks, track.Id, ActivePlaylistTitle))"
                                            @onkeydown="@((KeyboardEventArgs args) => HandlePlaylistRowKeyDownAsync(args, row.Item, track))">
                                            <td data-card-role="title">@track.Title</td>
                                            <td data-card-role="subtitle">@PlaylistCardSubtitle(track)</td>
                                            <td data-card-role="value">@GetTrackDuration(track)</td>
                                            <td data-card-role="actions" class="listen-playlist-cards__actions" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                                <AppNativeButton Type="button" Class='@($"listen-track-grid__favorite {(_favoriteWorkIds.Contains(track.Id) ? " is-active" : null)}")' AriaLabel="@($"Toggle favorite for {track.Title}")" Title="@L["Common_ToggleFavorite"].Value" aria-pressed="@(_favoriteWorkIds.Contains(track.Id) ? "true" : "false")" StopPropagation="true" OnClick="@(() => ToggleFavoriteAsync(track))">
                                                    <AppMaterialIcon Icon="@(_favoriteWorkIds.Contains(track.Id) ? AppMaterialIcons.Filled.Favorite : AppMaterialIcons.Outlined.FavoriteBorder)" Size="AppSize.Small" />
                                                </AppNativeButton>
                                                <AppRowMenu AriaLabel="@($"Actions for {track.Title}")" Title="@track.Title" Items="@PlaylistRowMenuItems(row)" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </AppTable>
                        }
                        else
                        {
                            <div class="listen-playlist-track-list" role="table" aria-label="@($"{ActivePlaylistTitle} songs")">
                                <AppCssElement Tag="div" Class="listen-playlist-track-list__head"
                                     Css="@($"grid-template-columns: {PlaylistGridTemplate}")"
                                     role="row"
                                     @onmousemove="@(args => ResizeColumn(args.ClientX))"
                                     @onmouseup="EndColumnResize"
                                     @onmouseleave="EndColumnResize">
                                    <span class="listen-playlist-track-list__song-head" role="columnheader">
                                        Song
                                        @if (!DeviceContext.IsTouch)
                                        {
                                            <span class="listen-column-resizer" @onmousedown:stopPropagation="true" @onmousedown="@((args) => BeginColumnResize("playlist", "song", args.ClientX))"></span>
                                        }
                                    </span>
                                    @if (IsPlaylistColumnVisible("favorite"))
                                    {
                                        <span class="listen-playlist-track-list__favorite-head" role="columnheader">
                                            Favorite
                                            @if (!DeviceContext.IsTouch)
                                            {
                                                <span class="listen-column-resizer" @onmousedown:stopPropagation="true" @onmousedown="@((args) => BeginColumnResize("playlist", "favorite", args.ClientX))"></span>
                                            }
                                        </span>
                                    }
                                    @if (IsPlaylistColumnVisible("artist"))
                                    {
                                        <span role="columnheader">
                                            Artist
                                            @if (!DeviceContext.IsTouch)
                                            {
                                                <span class="listen-column-resizer" @onmousedown:stopPropagation="true" @onmousedown="@((args) => BeginColumnResize("playlist", "artist", args.ClientX))"></span>
                                            }
                                        </span>
                                    }
                                    @if (IsPlaylistColumnVisible("album"))
                                    {
                                        <span role="columnheader">
                                            Album
                                            @if (!DeviceContext.IsTouch)
                                            {
                                                <span class="listen-column-resizer" @onmousedown:stopPropagation="true" @onmousedown="@((args) => BeginColumnResize("playlist", "album", args.ClientX))"></span>
                                            }
                                        </span>
                                    }
                                    @if (IsPlaylistColumnVisible("time"))
                                    {
                                        <span role="columnheader">
                                            Time
                                            @if (!DeviceContext.IsTouch)
                                            {
                                                <span class="listen-column-resizer" @onmousedown:stopPropagation="true" @onmousedown="@((args) => BeginColumnResize("playlist", "time", args.ClientX))"></span>
                                            }
                                        </span>
                                    }
                                    <span role="columnheader" class="listen-playlist-track-list__actions-label">@L["ListenPage_QueueEditRemove"]</span>
                                </AppCssElement>
                                @foreach (var row in ActivePlaylistTrackRows)
                                {
                                    var track = row.Work;
                                    var item = row.Item;
                                    <AppCssElement Tag="div" Class='@($"listen-playlist-track-row {(item is not null && item.Id == _draggingPlaylistTrackItemId ? "is-dragging" : null)} {(item is not null && item.Id == _playlistTrackDropTargetItemId && !_playlistTrackDropAfter ? "is-drop-before" : null)}")'
                                         Css="@($"grid-template-columns: {PlaylistGridTemplate}")"
                                         role="row"
                                         id="@(item is null ? null : PlaylistRowDomId(item.Id))"
                                         draggable="@(!DeviceContext.IsTouch)"
                                         tabindex="0"
                                         OnKeyDown="@((KeyboardEventArgs args) => HandlePlaylistRowKeyDownAsync(args, item))"
                                         OnDragStart="@((DragEventArgs _) => item is null ? Task.CompletedTask : BeginPlaylistTrackReorderAsync(item.Id))"
                                         OnDragEnd="@((DragEventArgs _) => EndPlaylistTrackReorder())"
                                         OnClick="@((MouseEventArgs _) => DeviceContext.IsTouch ? PlayTracksAsync(ActivePlaylistTracks, track.Id, ActivePlaylistTitle) : Task.CompletedTask)"
                                         OnDoubleClick="@((MouseEventArgs _) => PlayTracksAsync(ActivePlaylistTracks, track.Id, ActivePlaylistTitle))"
                                         PreventDragOverDefault="true"
                                         OnDragOver="@((DragEventArgs _) => item is null ? Task.CompletedTask : SetPlaylistTrackDropTargetAsync(item.Id, false))"
                                         OnDrop="@((DragEventArgs _) => item is null ? Task.CompletedTask : DropPlaylistTrackReorderAsync(item.Id))">
                                        <div class="listen-playlist-track-row__song listen-playlist-track-row__song--no-handle" role="cell">
                                            <div class="listen-playlist-track-row__art">
                                                @if (!string.IsNullOrWhiteSpace(track.CoverUrl))
                                                {
                                                    <img src="@MediaTileArtworkUrl.ForDrawnSize(track.CoverUrl, 36)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(track.CoverUrl, 36)" alt="" loading="lazy" decoding="async" />
                                                }
                                                else
                                                {
                                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.MusicNote" Size="AppSize.Small" />
                                                }
                                                <AppNativeButton Type="button" Class="listen-playlist-track-row__art-play" Title="@L["Common_PlaySong"].Value" AriaLabel="@($" Play {track.Title}")" StopPropagation="true" OnClick="@(() => PlayTracksAsync(ActivePlaylistTracks, track.Id, ActivePlaylistTitle))">
                                                    <AppMaterialIcon Icon="@AppMaterialIcons.Filled.PlayArrow" Size="AppSize.Small" />
                                                </AppNativeButton>
                                            </div>
                                            <span class="listen-playlist-track-row__title">@track.Title</span>
                                        </div>
                                        @if (IsPlaylistColumnVisible("favorite"))
                                        {
                                            <div class="listen-playlist-track-row__favorite" role="cell">
                                                <AppNativeButton Type="button" Class='@($"listen-track-grid__favorite {(_favoriteWorkIds.Contains(track.Id) ? " is-active" : null)}")' AriaLabel="@L["Common_ToggleFavorite"].Value" Title="@L["Common_ToggleFavorite"].Value" StopPropagation="true" OnClick="@(() => ToggleFavoriteAsync(track))">
                                                    <AppMaterialIcon Icon="@(_favoriteWorkIds.Contains(track.Id) ? AppMaterialIcons.Filled.Favorite : AppMaterialIcons.Outlined.FavoriteBorder)" Size="AppSize.Small" />
                                                </AppNativeButton>
                                            </div>
                                        }
                                        @if (IsPlaylistColumnVisible("artist"))
                                        {
                                            <span class="listen-playlist-track-row__meta" role="cell">@StringHelpers.FirstNonBlankOr("-", track.Artist, track.Author)</span>
                                        }
                                        @if (IsPlaylistColumnVisible("album"))
                                        {
                                            <span class="listen-playlist-track-row__meta" role="cell">@StringHelpers.FirstNonBlankOr("-", track.Album)</span>
                                        }
                                        @if (IsPlaylistColumnVisible("time"))
                                        {
                                            <span class="listen-playlist-track-row__time" role="cell">@GetTrackDuration(track)</span>
                                        }
                                        <div class="listen-playlist-track-row__actions" role="cell">
                                            <AppNativeButton Type="button" Class="listen-icon-button" Title="@L["Common_AddToQueue"].Value" AriaLabel="@($" Add {track.Title} to queue")" StopPropagation="true" OnClick="@(() => QueueTrackAsync(track))">
                                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PlaylistAdd" Size="AppSize.Small" />
                                            </AppNativeButton>
                                            @if (!DeviceContext.IsPhone)
                                            {
                                                <AppNativeButton Type="button" Class="listen-icon-button" Title="@L["ListenPage_EditSong"].Value" AriaLabel="@($" Edit {track.Title}")" StopPropagation="true" OnClick="@(() => EditTrackAsync(track))">
                                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Edit" Size="AppSize.Small" />
                                                </AppNativeButton>
                                            }
                                            @if (DeviceContext.IsTouch)
                                            {
                                                <AppRowMenu AriaLabel="@($"Actions for {track.Title}")" Title="@track.Title" Items="@PlaylistRowMenuItems(row)" />
                                            }
                                            <AppNativeButton Type="button" Class="listen-icon-button listen-icon-button--danger" Title="@L["ListenPage_RemoveFromPlaylist"].Value" AriaLabel="@($" Remove {track.Title} from playlist")" Disabled="@(item is null)" StopPropagation="true" OnClick="@(() => item is null ? Task.CompletedTask : RemovePlaylistTrackAsync(item.Id))">
                                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Delete" Size="AppSize.Small" />
                                            </AppNativeButton>
                                        </div>
                                    </AppCssElement>
                                }
                                <div class="listen-playlist-track-end-zone @(_draggingPlaylistTrackItemId.HasValue ? "is-active" : null)"
                                     @ondragover:preventDefault="true"
                                     @ondragover="@(() => SetPlaylistTrackEndDropTargetAsync())"
                                     @ondrop="DropPlaylistTrackAtEndAsync"></div>
                            </div>
                        }
                        <div class="sr-only" role="status" aria-live="polite">@_playlistAnnouncement</div>
                    }
                </section>
            }
            else if (IsAudiobooksView)
            {
                <section class="audiobooks-dashboard" aria-label="@L["ListenPage_AudiobooksDashboard"].Value">
                    <div class="audiobooks-toolbar" aria-label="@L["Common_AudiobookControls"].Value">
                        <label class="audiobooks-search">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Search" Class="tl-u-font-size-20px" />
                            <AppNativeInput Value="@_audiobookSearch"
                                            OnInput="UpdateAudiobookSearch"
                                            Placeholder="@L["ListenPage_SearchAudiobooks"].Value"
                                            AriaLabel="@L["ListenPage_SearchAudiobooks"].Value" />
                        </label>

                        <div class="audiobooks-toolbar__controls">
                            <div class="audiobooks-segmented">
                                <span>@L["Common_BrowseAs"]</span>
                                <AppBrowseModeSelector Options="@AudiobookBrowseOptions"
                                                       Value="@_audiobookView"
                                                       ValueChanged="SetAudiobookView"
                                                       AriaLabel="@L["ListenPage_BrowseAudiobooksAs"].Value" />
                            </div>

                            <div class="audiobooks-filter-group">
                                <span>@L["Common_FilterBy"]</span>
                                <div class="audiobooks-filters" aria-label="@L["ListenPage_AudiobookFilters"].Value">
                                    <AppQuickFilterToggle Label="@L["ListenPage_InProgress"].Value"
                                                          Selected="@_audiobookInProgressOnly"
                                                          SelectedChanged="SetAudiobookInProgress" />
                                    <AppQuickFilterToggle Label="@L["ListenPage_Unread"].Value"
                                                          Selected="@_audiobookUnreadOnly"
                                                          SelectedChanged="SetAudiobookUnread" />
                                    <AppSelect T="string" Class="audiobooks-select" @bind-Value="_audiobookLengthFilter" aria-label="@L["ListenPage_FilterByLength"].Value">
                                        <AppSelectItem T="string" Value="@("all")">@L["Common_Length"]</AppSelectItem>
                                        <AppSelectItem T="string" Value="@("short")">@L["ListenPage_Under6h"]</AppSelectItem>
                                        <AppSelectItem T="string" Value="@("medium")">6-14h</AppSelectItem>
                                        <AppSelectItem T="string" Value="@("long")">14h+</AppSelectItem>
                                    </AppSelect>
                                </div>
                            </div>
                        </div>

                        <div class="audiobooks-toolbar__display" aria-label="@L["ListenPage_AudiobookDisplayControls"].Value">
                            <span class="audiobooks-toolbar__eyebrow">@L["Common_Display"]</span>
                            <label class="audiobooks-sort">
                                <span>@L["Common_SortBy"]</span>
                                <AppSelect T="string" Class="audiobooks-select" @bind-Value="_audiobookSort" aria-label="@L["ListenPage_SortAudiobooks"].Value">
                                    <AppSelectItem T="string" Value="@("recent")">@L["Glossary_RecentlyAdded"]</AppSelectItem>
                                    <AppSelectItem T="string" Value="@("title")">@L["Common_Title"]</AppSelectItem>
                                    <AppSelectItem T="string" Value="@("author")">@L["ListenPage_Author"]</AppSelectItem>
                                    <AppSelectItem T="string" Value="@("length")">@L["Common_Length"]</AppSelectItem>
                                </AppSelect>
                            </label>

                            <div class="audiobooks-view-controls">
                                @if (_audiobookLayout == LibraryLayoutMode.Card)
                                {
                                    <label class="audiobooks-tile-size" title="@L["ListenPage_AdjustAudiobookTileSize"].Value">
                                        <span>@L["Common_TileSize"]</span>
                                        <AppNativeInput Type="range"
                                                        Value="@_audiobookTileSizePx"
                                                        Min="128"
                                                        Max="248"
                                                        Step="8"
                                                        AriaLabel="@L["ListenPage_AudiobookTileSize"].Value"
                                                        OnInput="UpdateAudiobookTileSize" />
                                    </label>
                                }
                                <div class="audiobooks-layout-toggle" role="group" aria-label="@L["ListenPage_AudiobookLayout"].Value">
                                    <AppNativeButton Type="button" Class="@AudiobookLayoutToggleClass(LibraryLayoutMode.Card)" aria-pressed="@(_audiobookLayout == LibraryLayoutMode.Card ? "true" : "false")" OnClick="@(() => _audiobookLayout = LibraryLayoutMode.Card)">
                                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.GridView" />
                                        <span>@L["Common_Cards"]</span>
                                    </AppNativeButton>
                                    <AppNativeButton Type="button" Class="@AudiobookLayoutToggleClass(LibraryLayoutMode.List)" aria-pressed="@(_audiobookLayout == LibraryLayoutMode.List ? "true" : "false")" OnClick="@(() => _audiobookLayout = LibraryLayoutMode.List)">
                                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ViewList" />
                                        <span>@L["Common_List"]</span>
                                    </AppNativeButton>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_audiobookSeriesFocus))
                    {
                        <div class="audiobooks-active-filter">
                            <span>@L["ListenPage_Showing", _audiobookSeriesFocus]</span>
                            <AppNativeButton Type="button" OnClick="ClearAudiobookSeriesFocus">@L["Activity_Clear"]</AppNativeButton>
                        </div>
                    }

                    <section class="audiobooks-section audiobooks-section--continue">
                        <div class="audiobooks-section__header">
                            <h2>@L["ListenPage_ContinueListening"]</h2>
                        </div>

                        @if (AudiobookContinueCards.Count == 0)
                        {
                            <div class="audiobooks-empty">@L["ListenPage_NoAudiobookListeningProgressYet"]</div>
                        }
                        else
                        {
                            <div class="audiobooks-continue-grid">
                                @foreach (var item in AudiobookContinueCards)
                                {
                                    var audiobook = item.Item;
                                    var title = AudiobookTitle(audiobook);
                                    var route = AudiobookRoute(audiobook);
                                    var coverUrl = AudiobookCoverUrl(audiobook);
                                    var progress = AudiobookProgressPercent(item);
                                    <article class="audiobooks-continue-card">
                                        <a class="audiobooks-continue-card__cover" href="@route">
                                            @if (!string.IsNullOrWhiteSpace(coverUrl))
                                            {
                                                <img src="@MediaTileArtworkUrl.ForDrawnSize(coverUrl, 160)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(coverUrl, 160)" alt="@title" loading="lazy" decoding="async" />
                                            }
                                            else
                                            {
                                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.MenuBook" Class="tl-u-font-size-48px" />
                                            }
                                        </a>
                                        <div class="audiobooks-continue-card__copy">
                                            <a class="audiobooks-card-title" href="@route">@title</a>
                                            <span>@AudiobookCreatorLine(audiobook)</span>
                                            <span>@AudiobookSecondaryLine(audiobook)</span>
                                            <progress class="audiobooks-progress" value="@progress" max="100" aria-label="@AudiobookProgressLabel(item)"></progress>
                                            <div class="audiobooks-continue-card__meta">
                                                <span>@AudiobookProgressLabel(item)</span>
                                                <span>@AudiobookRemainingLabel(item)</span>
                                            </div>
                                        </div>
                                        <AppNativeButton Type="button" Class="audiobooks-play-button" AriaLabel="@($"Play {title}")" OnClick='@(() => PlayAudiobookItemAsync(audiobook))'>
                                            <AppMaterialIcon Icon="@AppMaterialIcons.Filled.PlayArrow" Class="tl-u-font-size-28px" />
                                        </AppNativeButton>
                                    </article>
                                }
                            </div>
                        }
                    </section>

                    <section class="audiobooks-section">
                        <div class="audiobooks-section__header">
                            <div>
                                <h2>@AudiobookBrowseTitle</h2>
                                <p>@AudiobookBrowseSummary</p>
                            </div>
                        </div>

                        @if (_audiobookView == "series")
                        {
                            @if (AudiobookSeriesGroups.Count == 0)
                            {
                                <div class="audiobooks-empty">@L["ListenPage_NoAudiobookSeriesMatchThese"]</div>
                            }
                            else
                            {
                                <div class="audiobooks-series-grid">
                                    @foreach (var series in AudiobookSeriesGroups)
                                    {
                                        <article class="audiobooks-series-card">
                                            <div class="audiobooks-series-card__covers">
                                                <span>
                                                    @if (!string.IsNullOrWhiteSpace(series.CoverUrl))
                                                    {
                                                        <img src="@MediaTileArtworkUrl.ForDrawnSize(series.CoverUrl, 160)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(series.CoverUrl, 160)" alt="@series.DisplayName" loading="lazy" decoding="async" />
                                                    }
                                                    else
                                                    {
                                                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.MenuBook" Class="tl-u-font-size-38px" />
                                                    }
                                                </span>
                                            </div>
                                            <div class="audiobooks-series-card__copy">
                                                <h3>@series.DisplayName</h3>
                                                <span>@AudiobookSeriesMeta(series)</span>
                                                <p>@AudiobookSeriesDescription(series)</p>
                                                <AppNativeButton Type="button" Class="audiobooks-series-card__action" OnClick="@(() => ViewAudiobookSeries(series))">@L["ListenPage_ViewSeries"]</AppNativeButton>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                        }
                        else if (_audiobookView == "authors")
                        {
                            @if (AudiobookAuthorPersonTiles.Count == 0)
                            {
                                <div class="audiobooks-empty">@L["ListenPage_NoAudiobookAuthorsMatchThese"]</div>
                            }
                            else
                            {
                                <MediaTileGrid Items="@AudiobookAuthorPersonTiles"
                                               ShowCompactCaptions="true"
                                               HideGroupIndicators="true"
                                               TileSizePx="300"
                                               Class="listen-card-grid listen-card-grid--people" />
                            }
                        }
                        else if (_audiobookView == "narrators")
                        {
                            @if (AudiobookNarratorPersonTiles.Count == 0)
                            {
                                <div class="audiobooks-empty">@L["ListenPage_NoAudiobookNarratorsMatchThese"]</div>
                            }
                            else
                            {
                                <MediaTileGrid Items="@AudiobookNarratorPersonTiles"
                                               ShowCompactCaptions="true"
                                               HideGroupIndicators="true"
                                               TileSizePx="300"
                                               Class="listen-card-grid listen-card-grid--people" />
                            }
                        }
                        else if (_audiobookView == "timeline")
                        {
                            <AppTimelineResults Items="@AudiobookBrowseTiles"
                                                TileSizePx="@_audiobookTileSizePx"
                                                YearSemantic="Original work publication year" />
                        }
                        else if (AudiobookBrowseItems.Count == 0)
                        {
                            <div class="audiobooks-empty">@L["ListenPage_NoAudiobooksMatchTheseFilters"]</div>
                        }
                        else
                        {
                            @if (_audiobookLayout == LibraryLayoutMode.Card)
                            {
                                <MediaTileGrid Items="@AudiobookBrowseTiles"
                                               ShowCompactCaptions="true"
                                               TileSizePx="@_audiobookTileSizePx"
                                               Class="listen-card-grid listen-card-grid--audiobooks" />
                            }
                            else
                            {
                                <div class="@AudiobookBooksLayoutClass">
                                    @foreach (var audiobook in AudiobookBrowseItems)
                                    {
                                        var title = AudiobookTitle(audiobook);
                                        var route = AudiobookRoute(audiobook);
                                        var coverUrl = AudiobookCoverUrl(audiobook);
                                        var progress = AudiobookProgressPercent(audiobook);
                                        <article class="audiobooks-book-card">
                                            <a class="audiobooks-book-card__cover" href="@route">
                                                @if (!string.IsNullOrWhiteSpace(coverUrl))
                                                {
                                                    <img src="@MediaTileArtworkUrl.ForDrawnSize(coverUrl, 160)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(coverUrl, 160)" alt="@title" loading="lazy" decoding="async" />
                                                }
                                                else
                                                {
                                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.MenuBook" Class="tl-u-font-size-42px" />
                                                }
                                            </a>
                                            <div class="audiobooks-book-card__copy">
                                                <a class="audiobooks-card-title" href="@route">@title</a>
                                                <span>@AudiobookCreatorLine(audiobook)</span>
                                                <span>@AudiobookSecondaryLine(audiobook)</span>
                                                <div class="audiobooks-book-card__badges">
                                                    <span>@AudiobookBadge(audiobook)</span>
                                                    <span>@AudiobookDurationLabel(audiobook)</span>
                                                </div>
                                                <div class="audiobooks-book-card__progress-row">
                                                    <progress class="audiobooks-progress" value="@progress" max="100" aria-label="@AudiobookProgressLabel(audiobook)"></progress>
                                                    <span>@AudiobookProgressLabel(audiobook)</span>
                                                </div>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                        }
                    </section>

                    <section class="audiobooks-section audiobooks-section--featured">
                        <div class="audiobooks-section__header">
                            <h2>@L["ListenPage_FeaturedSeries"]</h2>
                        </div>

                        @if (FeaturedAudiobookSeries.Count == 0)
                        {
                            <div class="audiobooks-empty">@L["ListenPage_NoAudiobookSeriesWithMultiple"]</div>
                        }
                        else
                        {
                            <div class="audiobooks-featured-grid">
                                @foreach (var series in FeaturedAudiobookSeries)
                                {
                                    <article class="audiobooks-series-card audiobooks-series-card--featured">
                                        <div class="audiobooks-series-card__covers">
                                            <span>
                                                @if (!string.IsNullOrWhiteSpace(series.CoverUrl))
                                                {
                                                    <img src="@MediaTileArtworkUrl.ForDrawnSize(series.CoverUrl, 160)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(series.CoverUrl, 160)" alt="@series.DisplayName" loading="lazy" decoding="async" />
                                                }
                                                else
                                                {
                                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.MenuBook" Class="tl-u-font-size-38px" />
                                                }
                                            </span>
                                        </div>
                                        <div class="audiobooks-series-card__copy">
                                            <h3>@series.DisplayName</h3>
                                            <span>@AudiobookSeriesMeta(series)</span>
                                            <p>@AudiobookSeriesDescription(series)</p>
                                            <AppNativeButton Type="button" Class="audiobooks-series-card__action" OnClick="@(() => ViewAudiobookSeries(series))">@L["ListenPage_ViewSeries"]</AppNativeButton>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                </section>
            }
        </main>
    </div>
}
