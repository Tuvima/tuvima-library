@page "/listen/music/playlists/{CollectionId:guid}"
@page "/listen/music/playlists/system/{PlaylistKey}"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Components.Browse
@using MediaEngine.Web.Components.Collections
@using MediaEngine.Web.Components.Details
@using MediaEngine.Web.Components.Library
@using MediaEngine.Web.Components.Listen
@using MediaEngine.Web.Components.MediaHub
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Ui
@namespace MediaEngine.Web.Components.Pages
@inject IStringLocalizer<SharedStrings> L

<PageTitle>@PageTitleText</PageTitle>

@if (_redirecting)
{
    <div class="listen-state">
        <AppSpinner Indeterminate="true" Size="AppSize.Large" Class="tl-u-color-rgba-255-255-255-0-32" />
    </div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="listen-state listen-state--error">
        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.LibraryMusic" Class="tl-u-font-size-56px tl-u-opacity-0-22" />
        <h3>@L["ListenPage_ListenCouldNotLoad"]</h3>
        <p>@_error</p>
        <AppButton ButtonStyle="AppButtonStyle.Outlined" Label="@L["Common_TryAgain"].Value" OnClick="ReloadAsync" />
    </div>
}
else
{
    <div class="@ListenPageClass">
        <aside class="listen-rail-shell">
            <div class="listen-rail">
                <ListenNavigationSection Label="@L["Nav_Library"].Value"
                                         Items="@ListenLibraryItems"
                                         IsRouteActive="IsRouteActive"
                                         OnNavigate="NavigateRailLink" />

                <ListenNavigationSection Label="@L["Common_Formats"].Value"
                                         Items="@ListenFormatItems"
                                         IsRouteActive="IsRouteActive"
                                         OnNavigate="NavigateRailLink" />

                <ListenNavigationSection Label="@L["ListenPage_YourLibrary"].Value"
                                         Items="@ListenYourLibraryItems"
                                         IsRouteActive="IsRouteActive"
                                         OnNavigate="NavigateRailLink" />

                <section class="listen-rail__section" @onclick:stopPropagation="true">
                    <div class="listen-rail__section-heading" data-song-drop="new-playlist" @ondragover:preventDefault="true" @ondrop="DropSongsOnNewPlaylist">
                        <AppNativeButton Type="button" Class="listen-rail__section-toggle" aria-expanded="@_playlistsExpanded" OnClick="@(() => _playlistsExpanded = !_playlistsExpanded)">
                            <span>@L["Glossary_Playlists"]</span>
                            <AppMaterialIcon Icon="@(_playlistsExpanded ? AppMaterialIcons.Outlined.ExpandLess : AppMaterialIcons.Outlined.ExpandMore)" Class="tl-u-font-size-18px" />
                        </AppNativeButton>
                        <AppOverflowMenu Icon="@AppMaterialIcons.Outlined.Add"
                                         AriaLabel="@L["ListenPage_AddPlaylist"].Value"
                                         Size="AppControlSize.Compact"
                                         Class="listen-rail__add-menu"
                                         TriggerClass="listen-rail__add"
                                         PopoverClass="listen-rail__context-popover">
                            <AppMenuItem Label="@L["ListenPage_NewPlaylist"].Value"
                                         Icon="@AppMaterialIcons.Outlined.PlaylistAdd"
                                         OnClick="BeginPlaylistInlineCreate" />
                            @if (!DeviceContext.IsPhone)
                            {
                                <AppMenuItem Label="@L["ListenPage_NewSmartPlaylist"].Value"
                                             Icon="@AppMaterialIcons.Outlined.AutoAwesome"
                                             OnClick='@(() => OpenPlaylistCreateDialog("Smart"))' />
                            }
                        </AppOverflowMenu>
                    </div>

                    @if (_playlistsExpanded)
                    {
                        @if (_creatingPlaylistInline)
                        {
                            <div class="listen-rail__inline-create" @onclick:stopPropagation="true">
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Add" Class="tl-u-font-size-18px" />
                                <AppNativeInput Value="@_newPlaylistName"
                                                ValueChanged="@(value => _newPlaylistName = value?.ToString() ?? string.Empty)"
                                                OnKeyDown="CreatePlaylistOnKeyDownAsync"
                                                Placeholder="@L["ListenPage_PlaylistName"].Value"
                                                AriaLabel="@L["ListenPage_PlaylistName"].Value" />
                            </div>
                        }
                        @foreach (var item in ListenPinnedPlaylistItems)
                        {
                            <a @key="item.Route" href="@item.Route" target="_top" data-enhance-nav="false" class='@($"listen-rail__item {(IsRouteActive(item.Route) ? " is-active" : null)}")' aria-current="@(IsRouteActive(item.Route) ? "page" : null)" @onclick="@(() => NavigateRailLink(item.Route))" @onclick:preventDefault="true">
                                <AppMaterialIcon Icon="@item.Icon" Class="tl-u-font-size-18px" />
                                <span>@item.Label</span>
                            </a>
                        }

                        @foreach (var playlist in PlaylistCollections)
                        {
                            var playlistRoute = $"/listen/music/playlists/{playlist.Id}";
                            <div class="listen-rail__playlist-row @(playlist.Id == _draggingPlaylistId ? "is-dragging" : null)"
                                 @ondragover:preventDefault="true"
                                 @ondrop="@(() => DropPlaylistReorderAsync(playlist.Id))">
                                <AppNativeButton Type="button" Class="listen-rail__drag" draggable="true" AriaLabel="@($"Drag to reorder {playlist.Name}")" @ondragstart="@(() => BeginPlaylistReorder(playlist.Id))" @ondragend="EndPlaylistReorder">
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.DragIndicator" Class="tl-u-font-size-18px" />
                                </AppNativeButton>
                                @if (_renamingPlaylistId == playlist.Id)
                                {
                                    <AppNativeInput Class="listen-rail__rename-input"
                                                    Value="@_renamePlaylistName"
                                                    ValueChanged="@(value => _renamePlaylistName = value?.ToString() ?? string.Empty)"
                                                    OnKeyDown="@(args => RenamePlaylistOnKeyDownAsync(playlist, args))"
                                                    AriaLabel="@($"Rename {playlist.Name}")" />
                                }
                                else
                                {
                                    <a href="@playlistRoute" target="_top" data-enhance-nav="false" class='@($"listen-rail__item is-child {(IsRouteActive(playlistRoute) ? "is-active" : null)}")' aria-current="@(IsRouteActive(playlistRoute) ? "page" : null)" @onclick="@(() => NavigateRailLink(playlistRoute))" @onclick:preventDefault="true" data-song-drop="@(AcceptsSongDrops(playlist) ? "playlist" : null)" @ondragover:preventDefault="@AcceptsSongDrops(playlist)" @ondrop="@(() => DropSongsOnPlaylistAsync(playlist))">
                                        @if (!string.IsNullOrWhiteSpace(playlist.CoverArtworkUrl))
                                        {
                                            <span class="listen-rail__thumb"><img src="@MediaTileArtworkUrl.ForDrawnSize(playlist.CoverArtworkUrl, 20)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(playlist.CoverArtworkUrl, 20)" alt="" loading="lazy" decoding="async" /></span>
                                        }
                                        else
                                        {
                                            <AppMaterialIcon Icon="@PlaylistIconFor(playlist)" Class="tl-u-font-size-18px" />
                                        }
                                        <span>@playlist.Name</span>
                                        @if (!CanAcceptPlaylistItems(playlist))
                                        {
                                            <AppChip Text="@L["Common_Smart"].Value" />
                                        }
                                    </a>
                                }
                                <AppOverflowMenu Icon="@AppMaterialIcons.Outlined.MoreVert"
                                                 AriaLabel="@($"{playlist.Name} options")"
                                                 Size="AppControlSize.Compact"
                                                 Class="listen-rail__more-menu"
                                                 TriggerClass="listen-rail__more"
                                                 PopoverClass="listen-rail__context-popover">
                                    <AppMenuItem Label="@L["Common_Rename"].Value"
                                                 Icon="@AppMaterialIcons.Outlined.DriveFileRenameOutline"
                                                 OnClick="@(() => BeginPlaylistRename(playlist))" />
                                    <AppMenuItem Label="@L["Common_Delete"].Value"
                                                 Icon="@AppMaterialIcons.Outlined.DeleteOutline"
                                                 Tone="AppUiTone.Error"
                                                 DividerBefore="true"
                                                 OnClick="@(() => BeginPlaylistDeleteAsync(playlist))" />
                                </AppOverflowMenu>
                            </div>
                        }
                    }
                </section>
            </div>
        </aside>

        <main class="listen-content">
            @if (_notice is not null)
            {
                <AppAlert Tone="_noticeTone" Urgent="_noticeUrgent" ShowCloseIcon="true" CloseIconClicked="@(() => { _notice = null; })" data-listen-notice>@_notice</AppAlert>
            }

            @if (!IsAudioDetailSurface)
            {
                <div class="listen-lane-header">
                    <LibrarySectionHeader Title="@L["Nav_Listen"].Value"
                                          Modes="@ListenHubModes"
                                          ActiveMode="@ActiveListenMode" />
                </div>
            }

            <CollectionSavedNote Count="@_savedCollectionCount" />

            @if (IsMusicBrowseNavigationVisible)
            {
                <div class="listen-browse-mode">
                    <span>@L["Common_BrowseAs"]</span>
                    <AppBrowseModeSelector Options="@MusicBrowseOptions"
                                           Value="@MusicBrowseMode"
                                           ValueChanged="SetMusicBrowseMode"
                                           AriaLabel="@L["ListenPage_BrowseMusicAs"].Value" />
                </div>
            }

            @if (_loading)
            {
                <div class="listen-state listen-state--content">
                    <AppSpinner Indeterminate="true" Size="AppSize.Large" Class="tl-u-color-rgba-255-255-255-0-32" />
                </div>
            }
            else if (IsListenHub)
            {
                <MediaHubPage SectionType="MediaHubSectionType.Listen"
                              Title="@L["Nav_Listen"].Value"
                              Subtitle="@L["Common_MusicAndAudiobooksFromYour"].Value"
                              SelectedMode="all"
                              AvailableModes="@ListenHubModes"
                              Shelves="@ListenHubShelves"
                              SearchPlaceholder="Search music and audiobooks..."
                              RouteBase="/listen"
                              SupportsHero="false"
                              SupportsHeader="false"
                              SupportsNavigation="false" />
            }
            else if (IsMusicTimelineView)
            {
                <section class="listen-section">
                    <AppTimelineResults Items="@MusicTimelineTiles"

                                        YearSemantic="Original album release year" />
                </section>
            }
            else if (IsAlbumsView)
            {
                <section class="listen-section">
                    <div class="listen-filter-bar listen-filter-bar--surface">
                        <label class="listen-filter-search">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Search" />
                            <AppNativeInput Class="listen-filter-input"
                                            @bind="_albumSearch"
                                            @bind:event="oninput"
                                            Placeholder="@L["ListenPage_SearchAlbumsOrArtists"].Value"
                                            AriaLabel="@L["ListenPage_SearchAlbumsOrArtists2"].Value" />
                        </label>
                        <label class="listen-filter-field listen-filter-field--genre">
                            <span class="sr-only">@L["Common_Genres"]</span>
                            <AppSelect T="string" Class="listen-filter-select" @bind-Value="_albumGenreFilter" aria-label="@L["ListenPage_FilterAlbumsByGenre"].Value">
                                <AppSelectItem T="string" Value="@("all")">@L["ListenPage_AllGenres"]</AppSelectItem>
                                @foreach (var genre in SongGenres)
                                {
                                    <AppSelectItem T="string" Value="@genre">@genre</AppSelectItem>
                                }
                            </AppSelect>
                        </label>
                        <label class="listen-filter-field">
                            <span class="sr-only">@L["ListenPage_Artist"]</span>
                            <AppSelect T="string" Class="listen-filter-select" @bind-Value="_albumArtistFilter" aria-label="@L["ListenPage_FilterAlbumsByArtist"].Value">
                                <AppSelectItem T="string" Value="@("all")">@L["ListenPage_AllArtists"]</AppSelectItem>
                                @foreach (var artist in AlbumArtists)
                                {
                                    <AppSelectItem T="string" Value="@artist">@artist</AppSelectItem>
                                }
                            </AppSelect>
                        </label>
                        <div class="listen-filter-toggle-stack">
                            <AppQuickFilterToggle Label="@L["Glossary_Favorites"].Value" @bind-Selected="_albumFavoriteOnly" />
                            <AppQuickFilterToggle Label="@L["ListenPage_CompleteAlbums"].Value" @bind-Selected="_albumArtOnly" />
                        </div>
                        <div class="listen-display-group" aria-label="@L["ListenPage_AlbumDisplayControls"].Value">
                            <span class="sr-only">@L["Common_Display"]</span>
                            <label class="listen-filter-field listen-filter-field--sort">
                                <span class="sr-only">@L["Common_SortBy"]</span>
                                <AppSelect T="string" Class="listen-filter-select" @bind-Value="_albumSort" aria-label="@L["ListenPage_SortAlbums"].Value">
                                    <AppSelectItem T="string" Value="@("recent")">@L["Nav_RecentlyAdded"]</AppSelectItem>
                                    <AppSelectItem T="string" Value="@("title")">@L["Common_Title"]</AppSelectItem>
                                    <AppSelectItem T="string" Value="@("artist")">@L["ListenPage_Artist"]</AppSelectItem>
                                    <AppSelectItem T="string" Value="@("year")">@L["Common_Year"]</AppSelectItem>
                                </AppSelect>
                            </label>

                        </div>
                    </div>

                    <div class="listen-section__header listen-section__header--results">
                        <div>
                            <h2>@L["ListenPage_Albums"]</h2>
                            <p class="listen-section__summary">@Pluralize(FilteredAlbumGroups.Count, "album") ready to browse.</p>
                        </div>
                        <AppButton ButtonStyle="AppButtonStyle.Outlined" Label="@L["ListenPage_ShuffleLibrary"].Value" OnClick="@(() => PlayTracksAsync(_musicWorks, null, " All Music", true))" Disabled="@(_musicWorks.Count == 0)" />
                    </div>

                    @if (FilteredAlbumGroups.Count == 0)
                    {
                        <div class="listen-empty">
                            <div>
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Album" Class="tl-u-font-size-56px tl-u-opacity-0-22" />
                                <p>@L["ListenPage_NoAlbumsAreReadyTo"]</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <MediaTileGrid Items="@AlbumTiles" SquaresOnly="true" />
                    }
                </section>
            }
            else if (IsAlbumDetail && _albumDetail is not null)
            {
                <section class="listen-detail listen-detail--album">
                    <div class="listen-detail__art">
                        @if (!string.IsNullOrWhiteSpace(_albumDetail.CoverUrl))
                        {
                            <img src="@MediaTileArtworkUrl.ForDrawnSize(_albumDetail.CoverUrl, 320)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(_albumDetail.CoverUrl, 320)" alt="@_albumDetail.DisplayName" decoding="async" />
                        }
                        else
                        {
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Album" Class="tl-u-font-size-64px" />
                        }
                    </div>
                    <div class="listen-detail__copy">
                        <div class="listen-kicker">@L["ListenPage_Album"]</div>
                        <h2>@_albumDetail.DisplayName</h2>
                        <div class="listen-detail__meta">
                            <span>@StringHelpers.FirstNonBlankOr("-", _albumDetail.Creator, _albumDetail.YearRange, _albumDetail.ReleaseDate)</span>
                            <span>@Pluralize(_albumDetail.TotalItems, "track")</span>
                            @if (!string.IsNullOrWhiteSpace(_albumDetail.TotalDuration))
                            {
                                <span>@_albumDetail.TotalDuration</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_albumDetail.Description))
                        {
                            <p>@_albumDetail.Description</p>
                        }
                        <div class="listen-actions">
                            <AppButton ButtonStyle="AppButtonStyle.Outlined" Label="@L["ListenPage_BackToAlbums"].Value" OnClick="@(() => NavigateTo(AlbumsRoute))" />
                            <AppButton ButtonStyle="AppButtonStyle.Filled" StartIcon="@AppMaterialIcons.Filled.PlayArrow" Label="@L["Common_Play"].Value" OnClick="@(() => PlayTracksAsync(AlbumTracks, null, _albumDetail.DisplayName))" Disabled="@(AlbumTracks.Count == 0)" />
                            <AppButton ButtonStyle="AppButtonStyle.Outlined" StartIcon="@AppMaterialIcons.Filled.Shuffle" Label="@L["Common_Shuffle"].Value" OnClick="@(() => PlayTracksAsync(AlbumTracks, null, _albumDetail.DisplayName, true))" Disabled="@(AlbumTracks.Count == 0)" />
                            @if (!string.IsNullOrWhiteSpace(_albumDetail.Creator))
                            {
                                <AppButton ButtonStyle="AppButtonStyle.Outlined" Label="@L["ListenPage_Artist"].Value" OnClick="@(() => OpenArtist(_albumDetail.Creator!))" />
                            }
                        </div>
                    </div>
                </section>

                <section class="listen-section">
                    <div class="listen-section__header">
                        <div>
                            <div class="listen-kicker">@L["Common_Tracks"]</div>
                            <h2>@Pluralize(AlbumTracks.Count, "track")</h2>
                        </div>
                    </div>
                    @* An album's own songs in track order; its cover is at the top of the page, so the rows carry none. *@
                    <SongList Place="SongTablePlace.Albums"
                              Tracks="@AlbumTracks"
                              FavoriteIds="@_favoriteWorkIds"
                              SourceLabel="@_albumDetail.DisplayName"
                              AriaLabel="@($"{_albumDetail.DisplayName} songs")"
                              ShowCovers="false"
                              ProfileId="@_activeProfileId"
                              Sort="@AlbumTrackOrder"
                              CurrentWorkId="@Playback.CurrentItem?.WorkId"
                              IsPlaying="@Playback.IsPlaying"
                              OnPlayRequested="PlayTracksAsync"
                              OnFavoriteToggled="ToggleFavoriteAsync"
                              OnQueueRequested="QueueTrackAsync"
                              OnPlayNextRequested="PlayNextTrackAsync"
                              OnTracksChanged="RefreshSongsAsync"
                              OnDragStarted="OnTrackDragStarted"
                              OnDragEnded="OnTrackDragEnded" />
                </section>
            }
            else if (IsArtistsSurface)
            {
                    <section class="listen-section listen-section--people">
                        <div class="listen-section__header">
                            <div>
                                <div class="listen-kicker">@L["Nav_Music"]</div>
                                <h2>@L["ListenPage_Artists"]</h2>
                                <p class="listen-section__summary">@Pluralize(ArtistPersonTiles.Count, "artist") in your library.</p>
                            </div>
                        </div>

                        <div class="listen-filter-bar listen-filter-bar--compact">
                            <AppNativeInput Class="listen-filter-input" @bind="_artistSearch" @bind:event="oninput" Placeholder="@L["ListenPage_SearchArtists"].Value" />
                            <AppSelect T="string" Class="listen-filter-select" @bind-Value="_artistSort">
                                <AppSelectItem T="string" Value="@("name")">@L["ListenPage_ArtistName"]</AppSelectItem>
                                <AppSelectItem T="string" Value="@("tracks")">@L["ListenPage_MostTracks"]</AppSelectItem>
                            </AppSelect>
                        </div>

                        @if (ArtistPersonTiles.Count == 0)
                        {
                            <div class="listen-empty">
                                <div>
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PersonOutline" Class="tl-u-font-size-56px tl-u-opacity-0-22" />
                                    <p>@L["ListenPage_NoArtistsMatchTheseFilters"]</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <PersonTileGrid Items="@ArtistPersonTiles" />
                        }
                    </section>
            }
            else if (IsSongsView)
            {
                <section class="listen-section">
                    <div class="listen-section__header">
                        <div>
                            <div class="listen-kicker">@L["Nav_Music"]</div>
                            <h2>@L["Common_Songs"]</h2>
                        </div>
                        <div class="listen-actions">
                            <AppButton ButtonStyle="AppButtonStyle.Filled" StartIcon="@AppMaterialIcons.Filled.PlayArrow" Label="@L["Common_Play"].Value" OnClick='@(() => PlayTracksAsync(FilteredSongs, null, "All Music"))' Disabled="@(FilteredSongs.Count == 0)" />
                            <AppButton ButtonStyle="AppButtonStyle.Outlined" StartIcon="@AppMaterialIcons.Filled.Shuffle" Label="@L["Common_Shuffle"].Value" OnClick='@(() => PlayTracksAsync(FilteredSongs, null, "All Music", true))' Disabled="@(FilteredSongs.Count == 0)" />
                        </div>
                    </div>

                    <div class="listen-filter-bar listen-filter-bar--quick">
                        <AppNativeInput Class="listen-filter-input" @bind="_songSearch" @bind:event="oninput" Placeholder="@L["ListenPage_SearchSongsArtistsOrAlbums"].Value" />
                    </div>

                    @if (FilteredSongs.Count == 0)
                    {
                        <div class="listen-empty">
                            <div>
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.MusicNote" Class="tl-u-font-size-56px tl-u-opacity-0-22" />
                                <p>@L["ListenPage_NoSongsAreReadyTo"]</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <SongList Place="SongTablePlace.Songs"
                                  Tracks="@FilteredSongs"
                                  FavoriteIds="@_favoriteWorkIds"
                                  SourceLabel="All Music"
                                  AriaLabel="@L["Common_Songs"].Value"
                                  ProfileId="@_activeProfileId"
                                  CurrentWorkId="@Playback.CurrentItem?.WorkId"
                                  IsPlaying="@Playback.IsPlaying"
                                  OnPlayRequested="PlayTracksAsync"
                                  OnFavoriteToggled="ToggleFavoriteAsync"
                                  OnQueueRequested="QueueTrackAsync"
                                  OnPlayNextRequested="PlayNextTrackAsync"
                                  OnTracksChanged="RefreshSongsAsync"
                                  OnDragStarted="OnTrackDragStarted"
                                  OnDragEnded="OnTrackDragEnded" />
                    }
                </section>
            }
            else if (IsPlaylistsView)
            {
                <section class="listen-section">
                    <div class="listen-section__header">
                        <div>
                            <div class="listen-kicker">@L["Nav_Music"]</div>
                            <h2>@L["Glossary_Playlists"]</h2>
                            <p class="listen-section__summary">@L["ListenPage_SavedPlaylistsCreatedFromYour"]</p>
                        </div>
                    </div>

                    @if (PlaylistCollections.Count == 0)
                    {
                        <div class="listen-empty">
                            <div>
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.QueueMusic" Class="tl-u-font-size-56px tl-u-opacity-0-22" />
                                <p>@L["ListenPage_NoSavedPlaylistsYetFavorites"]</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <MediaTileGrid Items="@PlaylistTiles" SquaresOnly="true" />
                    }
                </section>
            }
            else if (IsPlaylistSurface)
            {
                <section class="listen-detail listen-detail--collection">
                    <div class="listen-detail__collage">
                        @if (!string.IsNullOrWhiteSpace(ActivePlaylistCollection?.CoverArtworkUrl))
                        {
                            <img class="listen-detail__custom-art" src="@MediaTileArtworkUrl.ForDrawnSize(ActivePlaylistCollection.CoverArtworkUrl, 320)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(ActivePlaylistCollection.CoverArtworkUrl, 320)" alt="" decoding="async" />
                        }
                        else if (PlaylistCoverUrls.Count == 0)
                        {
                            <AppMaterialIcon Icon="@(IsFavoritesPlaylist ? AppMaterialIcons.Filled.Favorite : AppMaterialIcons.Outlined.QueueMusic)" Class="tl-u-font-size-64px" />
                        }
                        else
                        {
                            @foreach (var cover in PlaylistCoverUrls)
                            {
                                <div class="listen-detail__collage-tile">
                                    <img src="@MediaTileArtworkUrl.ForDrawnSize(cover, 160)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(cover, 160)" alt="" loading="lazy" decoding="async" />
                                </div>
                            }
                        }
                    </div>
                    <div class="listen-detail__copy">
                        <h2>@ActivePlaylistTitle</h2>
                        @if (IsFavoritesPlaylist)
                        {
                            <p class="listen-detail__meta">@(ActivePlaylistTracks.Count == 1 ? L["ListenPage_FavoritesOneSong"].Value : L["ListenPage_FavoritesSongCount", ActivePlaylistTracks.Count].Value)</p>
                        }
                        <div class="listen-actions">
                            <AppButton ButtonStyle="AppButtonStyle.Filled" StartIcon="@AppMaterialIcons.Filled.PlayArrow" Label="@L["Common_Play"].Value" OnClick="@(() => PlayTracksAsync(ActivePlaylistTracks, null, ActivePlaylistTitle))" Disabled="@(ActivePlaylistTracks.Count == 0)" />
                            <AppButton ButtonStyle="AppButtonStyle.Outlined" StartIcon="@AppMaterialIcons.Filled.Shuffle" Label="@L["Common_Shuffle"].Value" OnClick="@(() => PlayTracksAsync(ActivePlaylistTracks, null, ActivePlaylistTitle, true))" Disabled="@(ActivePlaylistTracks.Count == 0)" />
                            @if (CanSaveActivePlaylist)
                            {
                                <AppButton ButtonStyle="AppButtonStyle.Outlined"
                                           StartIcon="@(_activePlaylistSaved ? AppMaterialIcons.Filled.Favorite : AppMaterialIcons.Outlined.FavoriteBorder)"
                                           Label="@(_activePlaylistSaved ? "In My List" : "Add to My List")"
                                           aria-pressed="@(_activePlaylistSaved ? "true" : "false")"
                                           OnClick="ToggleActivePlaylistSavedAsync" />
                            }
                        </div>
                    </div>
                </section>

                <section class="listen-section">
                    @if (ActivePlaylistTracks.Count == 0)
                    {
                        <div class="listen-empty">
                            <div>
                                <AppMaterialIcon Icon="@(IsFavoritesPlaylist ? AppMaterialIcons.Outlined.FavoriteBorder : AppMaterialIcons.Outlined.QueueMusic)" Class="tl-u-font-size-56px tl-u-opacity-0-22" />
                                <p>@(IsFavoritesPlaylist ? L["ListenPage_FavoritesEmpty"].Value : L["ListenPage_ThisPlaylistIsEmpty"].Value)</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        @* The playlist's songs are the one SongTable in its Playlist mode (spec music-table-and-reader-frame WP5): the shared Columns menu,
                           drag handle with a purple drop line, Alt+Up and Alt+Down, Remove in "..." and Move up and Move down on a phone. The page keeps the
                           saved order and every action; reordering is offered only on a playlist this profile owns. *@
                        <SongTable Place="SongTablePlace.Playlist"
                                   Rows="@PlaylistSongRows"
                                   AriaLabel="@($"{ActivePlaylistTitle} songs")"
                                   ProfileId="@_activeProfileId"
                                   CurrentRowId="@PlaylistCurrentRowId"
                                   IsPlaying="@Playback.IsPlaying"
                                   FavoriteIds="@PlaylistFavoriteIds"
                                   CanEdit="true"
                                   CanReorder="@CanReorderActivePlaylist"
                                   SortableOwnOrder="@IsFavoritesPlaylist"
                                   RemoveLabel="@(IsFavoritesPlaylist ? L["ListenPage_RemoveFromFavorites"].Value : null)"
                                   OnPlay="@PlayPlaylistRowAsync"
                                   OnPlayNext="@PlayNextPlaylistRowAsync"
                                   OnQueue="@QueuePlaylistRowAsync"
                                   OnOpenAlbum="@OpenPlaylistRowAlbumAsync"
                                   OnToggleFavorite="@ToggleFavoritePlaylistRowAsync"
                                   OnEdit="@EditPlaylistRowAsync"
                                   OnRemoveFromPlaylist="@RemovePlaylistRowAsync"
                                   OnReorder="@ReorderPlaylistRowAsync" />
                    }
                </section>
            }
            else if (IsAudiobooksView)
            {
                <section class="audiobooks-dashboard" aria-label="@L["ListenPage_AudiobooksDashboard"].Value">
                    <div class="audiobooks-toolbar" aria-label="@L["Common_AudiobookControls"].Value">
                        <label class="audiobooks-search">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Search" Class="tl-u-font-size-20px" />
                            <AppNativeInput Value="@_audiobookSearch"
                                            OnInput="UpdateAudiobookSearch"
                                            Placeholder="@L["ListenPage_SearchAudiobooks"].Value"
                                            AriaLabel="@L["ListenPage_SearchAudiobooks"].Value" />
                        </label>

                        <div class="audiobooks-toolbar__controls">
                            <div class="audiobooks-segmented">
                                <span class="sr-only">@L["Common_BrowseAs"]</span>
                                <AppBrowseModeSelector Options="@AudiobookBrowseOptions"
                                                       Value="@_audiobookView"
                                                       ValueChanged="SetAudiobookView"
                                                       AriaLabel="@L["ListenPage_BrowseAudiobooksAs"].Value" />
                            </div>

                            <div class="audiobooks-filter-group">
                                <span class="sr-only">@L["Common_FilterBy"]</span>
                                <div class="audiobooks-filters" aria-label="@L["ListenPage_AudiobookFilters"].Value">
                                    <AppQuickFilterToggle Label="@L["ListenPage_InProgress"].Value"
                                                          Selected="@_audiobookInProgressOnly"
                                                          SelectedChanged="SetAudiobookInProgress" />
                                    <AppQuickFilterToggle Label="@L["ListenPage_Unread"].Value"
                                                          Selected="@_audiobookUnreadOnly"
                                                          SelectedChanged="SetAudiobookUnread" />
                                    <AppSelect T="string" Class="audiobooks-select" @bind-Value="_audiobookLengthFilter" aria-label="@L["ListenPage_FilterByLength"].Value">
                                        <AppSelectItem T="string" Value="@("all")">@L["Common_Length"]</AppSelectItem>
                                        <AppSelectItem T="string" Value="@("short")">@L["ListenPage_Under6h"]</AppSelectItem>
                                        <AppSelectItem T="string" Value="@("medium")">6-14h</AppSelectItem>
                                        <AppSelectItem T="string" Value="@("long")">14h+</AppSelectItem>
                                    </AppSelect>
                                </div>
                            </div>
                        </div>

                        <div class="audiobooks-toolbar__display" aria-label="@L["ListenPage_AudiobookDisplayControls"].Value">
                            <span class="sr-only">@L["Common_Display"]</span>
                            <label class="audiobooks-sort">
                                <span class="sr-only">@L["Common_SortBy"]</span>
                                <AppSelect T="string" Class="audiobooks-select" @bind-Value="_audiobookSort" aria-label="@L["ListenPage_SortAudiobooks"].Value">
                                    <AppSelectItem T="string" Value="@("recent")">@L["Glossary_RecentlyAdded"]</AppSelectItem>
                                    <AppSelectItem T="string" Value="@("title")">@L["Common_Title"]</AppSelectItem>
                                    <AppSelectItem T="string" Value="@("author")">@L["ListenPage_Author"]</AppSelectItem>
                                    <AppSelectItem T="string" Value="@("length")">@L["Common_Length"]</AppSelectItem>
                                </AppSelect>
                            </label>

                            <div class="audiobooks-view-controls">
                                @if (_audiobookLayout == LibraryLayoutMode.Card)
                                {

                                }
                                <div class="audiobooks-layout-toggle" role="group" aria-label="@L["ListenPage_AudiobookLayout"].Value">
                                    <AppNativeButton Type="button" Class="@AudiobookLayoutToggleClass(LibraryLayoutMode.Card)" aria-pressed="@(_audiobookLayout == LibraryLayoutMode.Card ? "true" : "false")" OnClick="@(() => _audiobookLayout = LibraryLayoutMode.Card)">
                                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.GridView" />
                                        <span>@L["Common_Cards"]</span>
                                    </AppNativeButton>
                                    <AppNativeButton Type="button" Class="@AudiobookLayoutToggleClass(LibraryLayoutMode.List)" aria-pressed="@(_audiobookLayout == LibraryLayoutMode.List ? "true" : "false")" OnClick="@(() => _audiobookLayout = LibraryLayoutMode.List)">
                                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ViewList" />
                                        <span>@L["Common_List"]</span>
                                    </AppNativeButton>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_audiobookSeriesFocus))
                    {
                        <div class="audiobooks-active-filter">
                            <span>@L["ListenPage_Showing", _audiobookSeriesFocus]</span>
                            <AppButton ButtonStyle="AppButtonStyle.Text" Size="AppControlSize.Compact" Label="@L["Activity_Clear"].Value" OnClick="ClearAudiobookSeriesFocus" />
                        </div>
                    }

                    <section class="audiobooks-section audiobooks-section--continue">
                        <div class="audiobooks-section__header">
                            <h2>@L["ListenPage_ContinueListening"]</h2>
                        </div>

                        @if (AudiobookContinueCards.Count == 0)
                        {
                            <div class="audiobooks-empty">@L["ListenPage_NoAudiobookListeningProgressYet"]</div>
                        }
                        else
                        {
                            <div class="audiobooks-continue-grid">
                                @foreach (var item in AudiobookContinueCards)
                                {
                                    @* The same Continue tile as Home (issue 891): square cover on a soft copy of itself, Resume, one progress bar. *@
                                    <ContinueLandscapeTile Item="@ToAudiobookTile(item.Item)" @key="item.Item" />
                                }
                            </div>
                        }
                    </section>

                    <section class="audiobooks-section">
                        <div class="audiobooks-section__header">
                            <div>
                                <h2>@AudiobookBrowseTitle</h2>
                                <p>@AudiobookBrowseSummary</p>
                            </div>
                        </div>

                        @if (_audiobookView == "series")
                        {
                            @if (AudiobookSeriesGroups.Count == 0)
                            {
                                <div class="audiobooks-empty">@L["ListenPage_NoAudiobookSeriesMatchThese"]</div>
                            }
                            else
                            {
                                <div class="audiobooks-series-grid">
                                    @foreach (var series in AudiobookSeriesGroups)
                                    {
                                        <article class="audiobooks-series-card">
                                            <div class="audiobooks-series-card__covers">
                                                <span>
                                                    @if (!string.IsNullOrWhiteSpace(series.CoverUrl))
                                                    {
                                                        <img src="@MediaTileArtworkUrl.ForDrawnSize(series.CoverUrl, 160)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(series.CoverUrl, 160)" alt="@series.DisplayName" loading="lazy" decoding="async" />
                                                    }
                                                    else
                                                    {
                                                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.MenuBook" Class="tl-u-font-size-38px" />
                                                    }
                                                </span>
                                            </div>
                                            <div class="audiobooks-series-card__copy">
                                                <h3>@series.DisplayName</h3>
                                                <span>@AudiobookSeriesMeta(series)</span>
                                                <p>@AudiobookSeriesDescription(series)</p>
                                                <AppButton Tone="AppUiTone.Primary" Size="AppControlSize.Compact" Label="@L["ListenPage_ViewSeries"].Value" OnClick="@(() => ViewAudiobookSeries(series))" />
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                        }
                        else if (_audiobookView == "authors")
                        {
                            @if (AudiobookAuthorPersonTiles.Count == 0)
                            {
                                <div class="audiobooks-empty">@L["ListenPage_NoAudiobookAuthorsMatchThese"]</div>
                            }
                            else
                            {
                                <PersonTileGrid Items="@AudiobookAuthorPersonTiles" />
                            }
                        }
                        else if (_audiobookView == "narrators")
                        {
                            @if (AudiobookNarratorPersonTiles.Count == 0)
                            {
                                <div class="audiobooks-empty">@L["ListenPage_NoAudiobookNarratorsMatchThese"]</div>
                            }
                            else
                            {
                                <PersonTileGrid Items="@AudiobookNarratorPersonTiles" />
                            }
                        }
                        else if (_audiobookView == "timeline")
                        {
                            <AppTimelineResults Items="@AudiobookBrowseTiles"

                                                YearSemantic="Original work publication year" />
                        }
                        else if (AudiobookBrowseItems.Count == 0)
                        {
                            <div class="audiobooks-empty">@L["ListenPage_NoAudiobooksMatchTheseFilters"]</div>
                        }
                        else
                        {
                            @if (_audiobookLayout == LibraryLayoutMode.Card)
                            {
                                <MediaTileGrid Items="@AudiobookBrowseTiles" SquaresOnly="true" />
                            }
                            else
                            {
                                <div class="@AudiobookBooksLayoutClass">
                                    @foreach (var audiobook in AudiobookBrowseItems)
                                    {
                                        var title = AudiobookTitle(audiobook);
                                        var route = AudiobookRoute(audiobook);
                                        var coverUrl = AudiobookCoverUrl(audiobook);
                                        var progress = AudiobookProgressPercent(audiobook);
                                        <article class="audiobooks-book-card">
                                            <a class="audiobooks-book-card__cover" href="@route">
                                                @if (!string.IsNullOrWhiteSpace(coverUrl))
                                                {
                                                    <img src="@MediaTileArtworkUrl.ForDrawnSize(coverUrl, 160)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(coverUrl, 160)" alt="@title" loading="lazy" decoding="async" />
                                                }
                                                else
                                                {
                                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.MenuBook" Class="tl-u-font-size-42px" />
                                                }
                                            </a>
                                            <div class="audiobooks-book-card__copy">
                                                <a class="audiobooks-card-title" href="@route">@title</a>
                                                <span>@AudiobookCreatorLine(audiobook)</span>
                                                <span>@AudiobookSecondaryLine(audiobook)</span>
                                                <div class="audiobooks-book-card__badges">
                                                    <span>@AudiobookBadge(audiobook)</span>
                                                    <span>@AudiobookDurationLabel(audiobook)</span>
                                                </div>
                                                <div class="audiobooks-book-card__progress-row">
                                                    <progress class="audiobooks-progress" value="@progress" max="100" aria-label="@AudiobookProgressLabel(audiobook)"></progress>
                                                    <span>@AudiobookProgressLabel(audiobook)</span>
                                                </div>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                        }
                    </section>

                    <section class="audiobooks-section audiobooks-section--featured">
                        <div class="audiobooks-section__header">
                            <h2>@L["ListenPage_FeaturedSeries"]</h2>
                        </div>

                        @if (FeaturedAudiobookSeries.Count == 0)
                        {
                            <div class="audiobooks-empty">@L["ListenPage_NoAudiobookSeriesWithMultiple"]</div>
                        }
                        else
                        {
                            <div class="audiobooks-featured-grid">
                                @foreach (var series in FeaturedAudiobookSeries)
                                {
                                    <article class="audiobooks-series-card audiobooks-series-card--featured">
                                        <div class="audiobooks-series-card__covers">
                                            <span>
                                                @if (!string.IsNullOrWhiteSpace(series.CoverUrl))
                                                {
                                                    <img src="@MediaTileArtworkUrl.ForDrawnSize(series.CoverUrl, 160)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(series.CoverUrl, 160)" alt="@series.DisplayName" loading="lazy" decoding="async" />
                                                }
                                                else
                                                {
                                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.MenuBook" Class="tl-u-font-size-38px" />
                                                }
                                            </span>
                                        </div>
                                        <div class="audiobooks-series-card__copy">
                                            <h3>@series.DisplayName</h3>
                                            <span>@AudiobookSeriesMeta(series)</span>
                                            <p>@AudiobookSeriesDescription(series)</p>
                                            <AppButton Tone="AppUiTone.Primary" Size="AppControlSize.Compact" Label="@L["ListenPage_ViewSeries"].Value" OnClick="@(() => ViewAudiobookSeries(series))" />
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                </section>
            }
        </main>
    </div>
}
