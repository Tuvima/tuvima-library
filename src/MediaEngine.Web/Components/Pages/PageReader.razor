@namespace MediaEngine.Web.Components.Pages

@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.MediaTiles
@using MediaEngine.Web.Services.Navigation
@using MediaEngine.Web.Services.Playback

@inject IEngineApiClient Api
@inject UIOrchestratorService Orchestrator
@inject IUserPlaybackPreferencesAccessor PreferencesAccessor
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<PageReader> Logger
@inject IStringLocalizer<SharedStrings> L
@inject IAppDialogService Dialogs

@implements IAsyncDisposable

@* The page reader (PDF and comic reader spec D1): comics (CBZ, CBR, CB7) and PDFs, opened by the /read/{AssetId} route
   (EpubReader.razor) for every title that is not an EPUB. This component owns the top line, the slider, the panels and the
   words; wwwroot/js/page-reader.js owns the pages themselves. *@

<PageTitle>@(string.IsNullOrWhiteSpace(_title) ? L["PageReader_Library"].Value : L["PageReader_TitleInLibrary", _title].Value)</PageTitle>

<link href="css/book-reader.css" rel="stylesheet" />
<link href="css/page-reader.css" rel="stylesheet" />

<AppViewer Class="pr-shell" Role="" Surface="AppViewerSurface.Page" data-state="@_state">

    @* The script mounts the pages in here; Blazor never puts children in it. *@
    <div class="pr-host" @ref="_host"></div>

    <header class="pr-bar pr-bar--top" aria-label="@(string.IsNullOrWhiteSpace(_title) ? L["PageReader_Reader"].Value : _title)">
        <AppNativeButton Class="pr-ib" OnClick="ExitReader" Tooltip="@L["PageReader_BackToLibrary"].Value" AriaLabel="@L["PageReader_BackToLibrary"].Value">
            <AppMaterialIcon Icon="@AppMaterialIcons.Filled.ArrowBack" Size="AppIconSize.Control20" />
        </AppNativeButton>
        <div class="pr-title">
            <b>@_title</b>
            @if (!string.IsNullOrWhiteSpace(_subtitle))
            {
                <span>@_subtitle</span>
            }
        </div>
        @if (_state == "ready")
        {
            <div class="pr-tools" role="toolbar" aria-label="@L["PageReader_ReaderTools"].Value">
                @if (_kind == "pdf")
                {
                    <AppNativeButton Class="@($"pr-ib {(_panel == "search" ? "pr-ib--on" : "")}")" OnClick="@(() => TogglePanel("search"))" Tooltip="@L["PageReader_SearchInFile"].Value" AriaLabel="@L["PageReader_SearchInFile"].Value">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Search" Size="AppIconSize.Control20" />
                    </AppNativeButton>
                    @if (_outline.Count > 0)
                    {
                        <AppNativeButton Class="@($"pr-ib {(_panel == "contents" ? "pr-ib--on" : "")}")" OnClick="@(() => TogglePanel("contents"))" Tooltip="@L["PageReader_Contents"].Value" AriaLabel="@L["PageReader_Contents"].Value">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Toc" Size="AppIconSize.Control20" />
                        </AppNativeButton>
                    }
                }
                <AppNativeButton Class="@($"pr-ib {(MyBookmarkOnPage is not null ? "pr-ib--on" : "")}")" OnClick="ToggleBookmarkAsync"
                                 Tooltip="@(MyBookmarkOnPage is null ? L["PageReader_BookmarkThisPage"].Value : L["PageReader_RemoveBookmark"].Value)"
                                 AriaLabel="@(MyBookmarkOnPage is null ? L["PageReader_BookmarkThisPage"].Value : L["PageReader_RemoveBookmark"].Value)" aria-pressed="@(MyBookmarkOnPage is not null ? "true" : "false")">
                    <AppMaterialIcon Icon="@(MyBookmarkOnPage is null ? AppMaterialIcons.Outlined.BookmarkBorder : AppMaterialIcons.Filled.Bookmark)" Size="AppIconSize.Control20" />
                </AppNativeButton>
                <AppNativeButton Class="@($"pr-ib {(_panel == "bookmarks" ? "pr-ib--on" : "")}")" OnClick="@(() => TogglePanel("bookmarks"))" Tooltip="@L["PageReader_Bookmarks"].Value" AriaLabel="@L["PageReader_Bookmarks"].Value">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Bookmarks" Size="AppIconSize.Control20" />
                </AppNativeButton>
                <AppNativeButton Class="@($"pr-ib {(_panel == "pages" ? "pr-ib--on" : "")}")" OnClick="@(() => TogglePanel("pages"))" Tooltip="@L["PageReader_Pages"].Value" AriaLabel="@L["PageReader_Pages"].Value">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.GridView" Size="AppIconSize.Control20" />
                </AppNativeButton>
                <AppNativeButton Class="@($"pr-ib {(_panel == "settings" ? "pr-ib--on" : "")}")" OnClick="@(() => TogglePanel("settings"))" Tooltip="@L["PageReader_ReadingSettings"].Value" AriaLabel="@L["PageReader_ReadingSettings"].Value">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Tune" Size="AppIconSize.Control20" />
                </AppNativeButton>
            </div>
        }
    </header>

    <footer class="pr-bar pr-bar--bottom">
        @if (_state == "ready" && _pageCount > 0)
        {
            <span class="pr-count">@CountText</span>
            <div class="pr-track">
                <AppRangeSlider Class="@($"pr-slider{(_rtl ? " pr-slider--rtl" : "")}")" Min="1" Max="@_pageCount" Step="1" Value="@_page" ShowTicks="false"
                                AriaLabel="@L["PageReader_Page"].Value" CommitOnChange="true" ValueChanged="OnSliderChanged" />
                @if (_showBookmarksOnBar && _pageCount > 1)
                {
                    <div class="pr-marks" aria-hidden="true">
                        @foreach (var markedPage in MarkedPages)
                        {
                            <i class="pr-mark" data-left="@MarkLeft(markedPage)"></i>
                        }
                    </div>
                }
            </div>
        }
    </footer>

    <div class="pr-live" role="status" aria-live="polite">@(_state == "ready" ? CountText : string.Empty)<span>@_announcement</span></div>

    @if (_state == "ready" && _panel is not null)
    {
        <div class="br-scrim" role="presentation" @onclick="ClosePanelAsync"></div>
        <AppPopout Class="br-panel" Role="dialog" AriaLabel="@PanelTitle">
            <div class="br-panel-head">
                <h2 class="br-panel-title">@PanelTitle</h2>
                <AppNativeButton Class="br-icon-btn" OnClick="ClosePanelAsync" Tooltip="@L["PageReader_Close"].Value" AriaLabel="@L["PageReader_ClosePanel", PanelTitle].Value">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Close" Size="AppIconSize.Control20" />
                </AppNativeButton>
            </div>
            <div class="br-panel-body">
                @if (_panel == "pages")
                {
                    <div class="pr-grid-host" @ref="_gridHost"></div>
                }
                else if (_panel == "bookmarks")
                {
                    <AppSegmentedControl Options="BookmarkTabOptions" Value="@_bookmarkTab" ValueChanged="SetBookmarkTabAsync" AriaLabel="@L["PageReader_Bookmarks"].Value" />
                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Primary" OnClick="AddBookmarkAsync" StartIcon="@AppMaterialIcons.Filled.BookmarkAdd" Disabled="@(MyBookmarkOnPage is not null)">
                        @L["PageReader_BookmarkThisPage"]
                    </AppButton>
                    @if (!string.IsNullOrEmpty(_bookmarkProblem))
                    {
                        <p class="br-empty" role="alert">@_bookmarkProblem</p>
                    }
                    @if (ShownBookmarks.Count == 0)
                    {
                        <p class="br-empty">@(_bookmarkTab == "everyone" ? L["PageReader_NoBookmarksEveryone"].Value : L["PageReader_NoBookmarksMine"].Value)</p>
                    }
                    else
                    {
                        <ul class="br-list">
                            @foreach (var mark in ShownBookmarks)
                            {
                                <li class="br-item" @key="mark.Id">
                                    <AppNativeButton Class="br-row br-row--grow pr-bm-row" OnClick="@(() => OpenPageFromPanelAsync(mark.Page))">
                                        <span class="pr-bm-pic pr-page--loading" data-page="@mark.Page" aria-hidden="true"></span>
                                        <span class="pr-bm-text">
                                            <span class="br-row-main">@L["PageReader_OnPage", mark.Page]</span>
                                            <span class="br-row-sub">@BookmarkSub(mark)</span>
                                        </span>
                                    </AppNativeButton>
                                    @if (mark.IsYours && !mark.IsGlobal)
                                    {
                                        <AppNativeButton Class="br-icon-btn br-icon-btn--small" OnClick="@(() => DeleteBookmarkAsync(mark))" Tooltip="@L["PageReader_DeleteBookmark"].Value" AriaLabel="@L["PageReader_DeleteBookmark"].Value">
                                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.DeleteOutline" Size="AppIconSize.Control20" />
                                        </AppNativeButton>
                                    }
                                </li>
                            }
                        </ul>
                    }
                }
                else if (_panel == "contents")
                {
                    <ul class="br-list">
                        @foreach (var item in _outline)
                        {
                            <li>
                                <AppNativeButton Class="@($"br-row br-row--level{Math.Min(item.Level, 3)} {(IsCurrentOutline(item) ? "br-row--current" : "")}")"
                                                 OnClick="@(() => OpenPageFromPanelAsync(item.Page))" AriaLabel="@item.Title">
                                    @item.Title
                                </AppNativeButton>
                            </li>
                        }
                    </ul>
                }
                else if (_panel == "search")
                {
                    <div class="br-search">
                        <AppNativeInput @ref="_searchInput" Type="search" Class="br-search-input" Placeholder="@L["PageReader_SearchInFile"].Value" AriaLabel="@L["PageReader_SearchInFile"].Value"
                                        Value="@_searchQuery" OnInput="OnSearchInputAsync" OnKeyDown="OnSearchKeyDown" />
                        <AppNativeButton Class="br-icon-btn" OnClick="RunSearchAsync" Tooltip="@L["PageReader_Search"].Value" AriaLabel="@L["PageReader_Search"].Value" Disabled="@(_searching || _searchQuery.Trim().Length < 2)">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Search" Size="AppIconSize.Control20" />
                        </AppNativeButton>
                    </div>
                    @if (_searching && _searchHits.Count == 0)
                    {
                        <p class="br-hint" role="status">@L["PageReader_Searching"]</p>
                    }
                    else if (!_searchStarted)
                    {
                        <p class="br-hint">@L["PageReader_SearchHint"]</p>
                    }
                    else if (_searchNoText)
                    {
                        <p class="br-empty" role="status">@L["PageReader_NoText"]</p>
                    }
                    else if (_searchHits.Count == 0)
                    {
                        <p class="br-empty" role="status">@L["PageReader_NothingMatches", _searchedFor]</p>
                    }
                    else
                    {
                        <p class="br-hint" role="status">@(_searchHits.Count >= SearchHitLimit ? L["PageReader_PlacesTruncated", _searchHits.Count].Value : L["PageReader_PlacesFound", _searchHits.Count].Value)</p>
                        <ul class="br-list">
                            @foreach (var hit in _searchHits)
                            {
                                <li>
                                    <AppNativeButton Class="br-row" OnClick="@(() => OpenPageFromPanelAsync(hit.Page))">
                                        <span class="br-row-sub">@L["PageReader_OnPage", hit.Page]</span>
                                        <span class="br-row-main">@hit.Before<mark class="br-search-match">@hit.Match</mark>@hit.After</span>
                                    </AppNativeButton>
                                </li>
                            }
                        </ul>
                    }
                }
                else
                {
                <div class="br-field">
                    <div class="br-field-label">@L["PageReader_Layout"]</div>
                    <AppSegmentedControl Options="LayoutOptions" Value="@_layout" ValueChanged="SetLayoutAsync" AriaLabel="@L["PageReader_Layout"].Value" />
                </div>
                <div class="br-field">
                    <div class="br-field-label">@L["PageReader_Fit"]</div>
                    <AppSegmentedControl Options="FitOptions" Value="@_fit" ValueChanged="SetFitAsync" AriaLabel="@L["PageReader_Fit"].Value" />
                </div>
                @if (_kind == "comic")
                {
                    <div class="br-field">
                        <div class="br-field-label">@L["PageReader_Direction"]</div>
                        <AppSegmentedControl Options="DirectionOptions" Value="@_direction" ValueChanged="SetDirectionAsync" AriaLabel="@L["PageReader_Direction"].Value" />
                    </div>
                }
                <div class="br-field">
                    <div class="br-field-label">@L["PageReader_Background"]</div>
                    <AppSegmentedControl Options="BackgroundOptions" Value="@_background" ValueChanged="SetBackgroundAsync" AriaLabel="@L["PageReader_Background"].Value" />
                </div>
                <AppSwitchRow Label="@L["PageReader_ShowBookmarksOnBar"].Value" Value="@_showBookmarksOnBar" ValueChanged="SetShowBookmarksOnBarAsync" />
                <p class="br-hint">@L["PageReader_RememberedOnProfile"]</p>
                }
            </div>
        </AppPopout>
    }

    @if (_state == "ready" && _endCard && _next is { } next)
    {
        <div class="pr-overlay pr-overlay--card">
            <div class="pr-endcard" role="region" aria-label="@L["PageReader_NextIn", next.Series ?? _title].Value">
                <div class="pr-endcard-pic">
                    <img src="@MediaTileArtworkUrl.ForDrawnSize($"/engine-image/stream/entity/work/{next.WorkId:D}/cover", 130)" alt="" />
                </div>
                <div>
                    <small>@L["PageReader_NextIn", next.Series ?? _title]</small>
                    <h3>@(next.Title ?? next.Series)</h3>
                    <div class="pr-endcard-actions">
                        <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="ReadNextAsync">@L["PageReader_ReadNext"]</AppButton>
                        <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Primary" OnClick="BackToSeriesAsync">@L["PageReader_BackToSeries", next.Series ?? _title]</AppButton>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_state == "loading")
    {
        <div class="pr-overlay">
            <div class="pr-spinner" role="status" aria-label="@L["PageReader_Opening"].Value"></div>
        </div>
    }
    else if (_state == "error")
    {
        <div class="pr-overlay">
            <div class="pr-state" role="alert">
                <p>@_errorMessage</p>
                <div class="pr-state-actions">
                    @if (_canRetry)
                    {
                        <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="RetryAsync">@L["PageReader_TryAgain"]</AppButton>
                    }
                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Primary" OnClick="ExitReader">@L["PageReader_BackToLibrary"]</AppButton>
                </div>
            </div>
        </div>
    }
</AppViewer>

@code {
    private IReadOnlyList<AppSelectOption> LayoutOptions => [
        new("auto", L["PageReader_LayoutAuto"].Value),
        new("one", L["PageReader_LayoutOne"].Value),
        new("two", L["PageReader_LayoutTwo"].Value),
        new("scroll", L["PageReader_LayoutScroll"].Value),
    ];
    private IReadOnlyList<AppSelectOption> FitOptions => [new("page", L["PageReader_FitPage"].Value), new("width", L["PageReader_FitWidth"].Value)];
    private IReadOnlyList<AppSelectOption> DirectionOptions => [
        new("auto", L["PageReader_DirectionAuto"].Value),
        new("ltr", L["PageReader_DirectionLtr"].Value),
        new("rtl", L["PageReader_DirectionRtl"].Value),
    ];
    private IReadOnlyList<AppSelectOption> BackgroundOptions => [
        new("black", L["PageReader_BackgroundBlack"].Value),
        new("dark", L["PageReader_BackgroundDark"].Value),
        new("light", L["PageReader_BackgroundLight"].Value),
    ];

    [Parameter] public Guid AssetId { get; set; }
    [Parameter] public string Kind { get; set; } = "comic";
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Series { get; set; }
    [Parameter] public Guid? ReturnCollectionId { get; set; }
    [Parameter] public bool Restart { get; set; }

    [CascadingParameter] public DetailsOverlayState? Overlay { get; set; }

    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PageReader>? _dotNetRef;
    private string _state = "loading";
    private string? _errorMessage;
    private bool _canRetry;
    private string _kind = "comic";
    private string _title = string.Empty;
    private string? _subtitle;
    private string? _panel;
    private int _page = 1;
    private int _lastPage = 1;
    private int _pageCount;
    private bool _rtl;
    private bool _opened;
    private bool _exited;
    private bool _disposing;
    private bool _disposed;

    private string _layout = "auto";
    private string _fit = "page";
    private string _direction = "auto";
    private string _background = "black";
    private bool _showBookmarksOnBar;

    // Page bookmarks (spec D14): the person's own and Everyone's, loaded once the pages are up.
    private List<MediaEngine.Contracts.Reading.PageBookmarkDto> _bookmarks = [];
    private string _bookmarkTab = "mine";
    private string? _bookmarkProblem;
    private string _announcement = string.Empty;
    private bool _drawBookmarkPictures;

    private IReadOnlyList<AppSelectOption> BookmarkTabOptions => [
        new("everyone", L["PageReader_BookmarksEveryone"].Value),
        new("mine", L["PageReader_BookmarksMine"].Value),
    ];

    private MediaEngine.Contracts.Reading.PageBookmarkDto? MyBookmarkOnPage => _bookmarks.FirstOrDefault(mark => mark.IsYours && !mark.IsGlobal && mark.Page == _page);

    private IReadOnlyList<MediaEngine.Contracts.Reading.PageBookmarkDto> ShownBookmarks => _bookmarks
        .Where(mark => _bookmarkTab == "everyone" ? mark.IsGlobal : mark.IsYours)
        .OrderBy(mark => mark.Page)
        .ToList();

    private IEnumerable<int> MarkedPages => _bookmarks.Select(mark => mark.Page).Distinct();

    private string MarkLeft(int page)
    {
        var fraction = (page - 1d) / Math.Max(1, _pageCount - 1) * 100d;
        return (_rtl ? 100d - fraction : fraction).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }

    private string BookmarkSub(MediaEngine.Contracts.Reading.PageBookmarkDto mark)
    {
        var date = mark.CreatedAt.ToLocalTime().ToString("d MMM yyyy", System.Globalization.CultureInfo.CurrentCulture);
        var who = _bookmarkTab == "everyone" && !string.IsNullOrWhiteSpace(mark.OwnerName)
            ? (string.IsNullOrWhiteSpace(mark.Label) ? mark.OwnerName : $"{mark.Label} · {mark.OwnerName}")
            : mark.Label;
        return string.IsNullOrWhiteSpace(who) ? date : L["PageReader_BookmarkRowSub", who, date].Value;
    }

    // The Pages panel (the grid is built by the script) and the end-of-issue card
    private ElementReference _gridHost;
    private bool _gridMounted;
    private MediaEngine.Contracts.Reading.ReaderNextIssueDto? _next;
    private bool _endCard;

    // PDF contents and search
    private const int SearchHitLimit = 200;
    private IReadOnlyList<PdfOutlineItem> _outline = [];
    private readonly List<PdfSearchHit> _searchHits = [];
    private AppNativeInput? _searchInput;
    private string _searchQuery = string.Empty;
    private string _searchedFor = string.Empty;
    private bool _searching;
    private bool _searchStarted;
    private bool _searchNoText;
    private bool _focusSearch;

    private string PanelTitle => _panel switch
    {
        "search" => L["PageReader_Search"].Value,
        "contents" => L["PageReader_Contents"].Value,
        "pages" => L["PageReader_Pages"].Value,
        "bookmarks" => L["PageReader_Bookmarks"].Value,
        _ => L["PageReader_ReadingSettings"].Value,
    };

    // Saved page (spec D12): the page is saved a few seconds after the last turn and when the reader closes.
    private static readonly TimeSpan SaveDelay = TimeSpan.FromSeconds(5);
    private readonly SemaphoreSlim _profileSaveGate = new(1, 1);
    private Timer? _saveTimer;
    private int _savedFirst;
    private int _savedLast;
    private int _startPage = 1;

    private string CountText => _pageCount == 0
        ? string.Empty
        : _lastPage > _page ? L["PageReader_PagesOf", _page, _lastPage, _pageCount].Value : L["PageReader_PageOf", _page, _pageCount].Value;

    protected override void OnInitialized()
    {
        _kind = Kind;
        _title = Title ?? string.Empty;
        _subtitle = Subtitle;
    }

    private async Task OpenAsync()
    {
        _state = "loading";
        _errorMessage = null;
        StateHasChanged();
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/page-reader.js");
            await LoadSettingsAsync();
            await LoadSavedPageAsync();
            _dotNetRef ??= DotNetObjectReference.Create(this);
            var result = await _module.InvokeAsync<PageReaderOpenResult>(
                "open",
                _host,
                EngineBookProxyPath.ToBookBase(AssetId),
                new { kind = _kind, startPage = _startPage, layout = _layout, fit = _fit, direction = _direction, background = _background },
                _dotNetRef);

            if (_disposing || _disposed)
            {
                return;
            }

            if (!result.Ok)
            {
                ShowError(result.Code, result.Message);
                return;
            }

            _pageCount = result.PageCount;
            _page = Math.Clamp(_startPage, 1, Math.Max(1, _pageCount));
            _lastPage = _page;
            _rtl = _direction == "rtl" || (_direction == "auto" && result.RightToLeft);
            _state = "ready";
            _bookmarks = await Api.GetPageBookmarksAsync(AssetId);
            if (_kind == "pdf")
            {
                _outline = await _module.InvokeAsync<List<PdfOutlineItem>>("getOutline");
            }
            else if (!string.IsNullOrWhiteSpace(Series))
            {
                // Only a comic in a Series can show the next-issue card; the Engine answers 404 when no later issue is owned.
                _next = await Api.GetReaderNextIssueAsync(AssetId);
            }
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException)
        {
            if (_disposing || _disposed)
            {
                return;
            }

            Logger.LogWarning(ex, "The page reader could not start for {AssetId}.", AssetId);
            ShowError("unavailable", L["PageReader_CantReachEngine"].Value);
            return;
        }

        StateHasChanged();
    }

    private void ShowError(string? code, string? message)
    {
        _errorMessage = string.IsNullOrWhiteSpace(message) ? L["PageReader_CantOpenFile"].Value : message;
        _canRetry = code is "offline" or "unavailable";
        _state = "error";
        StateHasChanged();
    }

    private Task RetryAsync() => OpenAsync();

    // ---- Calls from the script ----------------------------------------------------------------------------------

    [JSInvokable]
    public Task OnPageChanged(int first, int pageCount, int last)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        _page = first;
        _lastPage = last;
        _pageCount = pageCount;
        ScheduleSave();
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnSearchResults(int token, List<PdfSearchHit> hits, bool done)
    {
        if (_disposed || !_searching)
        {
            return Task.CompletedTask;
        }

        _searchHits.AddRange(hits.Take(Math.Max(0, SearchHitLimit - _searchHits.Count)));
        if (done)
        {
            _searching = false;
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnEndReached()
    {
        // One more turn past the last page shows the next owned issue; with none, the last turn does nothing.
        if (_disposed || _next is null || _endCard)
        {
            return;
        }

        _endCard = true;
        await CallScriptAsync("setInputPaused", true);
        await SavePageAsync();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnGridPick(int page)
    {
        await ClosePanelAsync();
        await CallScriptAsync("goTo", page);
    }

    [JSInvokable]
    public async Task OnEscape()
    {
        // Escape closes the innermost thing first and leaves the reader last.
        if (_endCard)
        {
            _endCard = false;
            await CallScriptAsync("setInputPaused", false);
            StateHasChanged();
        }
        else if (_panel is not null)
        {
            await ClosePanelAsync();
        }
        else
        {
            await ExitReader();
        }
    }

    // ---- Settings (kept on the profile) -------------------------------------------------------------------------

    private async Task LoadSettingsAsync()
    {
        try
        {
            var profile = await PreferencesAccessor.GetAsync();
            var choices = PageReaderProfileSettings.ChoicesFor(profile?.Reading, AssetId, Series);
            _layout = choices.Layout is "auto" or "one" or "two" or "scroll" ? choices.Layout : "auto";
            _fit = choices.Fit is "page" or "width" ? choices.Fit : "page";
            _direction = _kind == "comic" && choices.Direction is "ltr" or "rtl" ? choices.Direction : "auto";
            _background = choices.Background is "black" or "dark" or "light" ? choices.Background : "black";
            _showBookmarksOnBar = choices.ShowBookmarksOnBar;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "The profile's page reader choices could not be loaded; the reader's own defaults apply.");
        }
    }

    private async Task SetLayoutAsync(string value)
    {
        _layout = value;
        await CallScriptAsync("setLayout", value);
        await SaveChoiceAsync(reading => PageReaderProfileSettings.SetLayout(reading, AssetId, value));
    }

    private async Task SetFitAsync(string value)
    {
        _fit = value;
        await CallScriptAsync("setFit", value);
        await SaveChoiceAsync(reading => reading.PageFit = value);
    }

    private async Task SetDirectionAsync(string value)
    {
        _direction = value;
        await CallScriptAsync("setDirection", value);
        await SaveChoiceAsync(reading => PageReaderProfileSettings.SetDirection(reading, Series, value));
        _rtl = value == "rtl" || (value == "auto" && _rtl);
    }

    private async Task SetBackgroundAsync(string value)
    {
        _background = value;
        await CallScriptAsync("setBackground", value);
        await SaveChoiceAsync(reading => reading.PageBackground = value);
    }

    // Reads the profile's current settings and changes only the reader choice, so nothing else is overwritten.
    private async Task SaveChoiceAsync(Action<MediaEngine.Contracts.Playback.ReadingSettingsDto> change)
    {
        await _profileSaveGate.WaitAsync();
        try
        {
            var current = await Orchestrator.GetPlaybackSettingsAsync();
            if (current is null)
            {
                Logger.LogWarning("The page reader's choice could not be saved: the profile's settings were unavailable.");
                return;
            }

            change(current.Reading);
            var saved = await Orchestrator.SavePlaybackSettingsAsync(current);
            if (saved is null)
            {
                Logger.LogWarning("The page reader's choice could not be saved to the profile.");
                return;
            }

            PreferencesAccessor.UpdateCache(saved);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "The page reader's choice could not be saved to the profile.");
        }
        finally
        {
            _profileSaveGate.Release();
        }
    }

    // ---- Saved page ---------------------------------------------------------------------------------------------

    private async Task LoadSavedPageAsync()
    {
        _startPage = 1;
        if (Restart)
        {
            return;
        }

        try
        {
            // A title that was never read has no saved position (the Engine answers 404, which comes back as null here).
            var progress = await Api.GetProgressAsync(AssetId);
            if (progress is not null
                && progress.ExtendedProperties.TryGetValue("page", out var pageText) && int.TryParse(pageText, out var saved) && saved >= 1)
            {
                // A finished title opens at the start again; anything else returns to its page.
                var savedCount = progress.ExtendedProperties.TryGetValue("page_count", out var countText) && int.TryParse(countText, out var c) ? c : 0;
                _startPage = savedCount > 0 && saved >= savedCount ? 1 : saved;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            Logger.LogDebug(ex, "The saved page could not be read; the reader opens at the start.");
        }
    }

    private void ScheduleSave()
    {
        if (_disposing || _disposed || _pageCount == 0)
        {
            return;
        }

        // One timer, pushed back on every turn: the page is saved when the person pauses, not on every turn.
        _saveTimer ??= new Timer(_ => _ = InvokeAsync(SavePageAsync), null, Timeout.Infinite, Timeout.Infinite);
        _saveTimer.Change(SaveDelay, Timeout.InfiniteTimeSpan);
    }

    private async Task SavePageAsync()
    {
        if (_pageCount == 0 || (_savedFirst == _page && _savedLast == _lastPage))
        {
            return;
        }

        var first = _page;
        var last = Math.Max(_lastPage, _page);
        try
        {
            var properties = new Dictionary<string, string>
            {
                ["reader"] = "page",
                ["page"] = first.ToString(System.Globalization.CultureInfo.InvariantCulture),
                ["page_count"] = _pageCount.ToString(System.Globalization.CultureInfo.InvariantCulture),
                ["media_kind"] = "reading",
            };

            // Percent is the page over the pages; the last page counts as finished (100).
            var pct = last >= _pageCount ? 100.0 : Math.Clamp((double)last / _pageCount * 100.0, 0, 100);
            await Api.SaveProgressAsync(AssetId, progressPct: pct, extendedProperties: properties);
            _savedFirst = first;
            _savedLast = last;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            Logger.LogDebug(ex, "Failed to save page reader progress.");
        }
    }

    // ---- Panels and slider --------------------------------------------------------------------------------------

    private async Task TogglePanel(string panel)
    {
        if (_panel == panel)
        {
            await ClosePanelAsync();
            return;
        }

        if (_gridMounted)
        {
            _gridMounted = false;
            await CallScriptAsync("unmountPageGrid");
        }

        _panel = panel;
        _drawBookmarkPictures = panel == "bookmarks";
        _focusSearch = panel == "search";
        await CallScriptAsync("setInputPaused", true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_opened)
        {
            _opened = true;
            await OpenAsync();
        }

        if (_panel == "pages" && !_gridMounted)
        {
            _gridMounted = true;
            await CallScriptAsync("mountPageGrid", _gridHost, MarkedPages.ToArray());
        }

        if (_showBookmarksOnBar && _state == "ready")
        {
            await CallScriptAsync("placeMarks");
        }

        if (_drawBookmarkPictures && _panel == "bookmarks")
        {
            _drawBookmarkPictures = false;
            await CallScriptAsync("drawBookmarkPictures");
        }

        if (_focusSearch && _panel == "search" && _searchInput is not null)
        {
            _focusSearch = false;
            try
            {
                await _searchInput.FocusAsync();
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
            {
                Logger.LogDebug(ex, "The search box could not be focused.");
            }
        }
    }

    private bool IsCurrentOutline(PdfOutlineItem item)
    {
        // The current section is the last contents entry at or before the page being read.
        PdfOutlineItem? current = null;
        foreach (var entry in _outline)
        {
            if (entry.Page <= _page)
            {
                current = entry;
            }
        }

        return ReferenceEquals(current, item);
    }

    private async Task OpenPageFromPanelAsync(int page)
    {
        await ClosePanelAsync();
        await CallScriptAsync("goTo", page);
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await RunSearchAsync();
        }
    }

    private Task OnSearchInputAsync(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        return Task.CompletedTask;
    }

    private async Task RunSearchAsync()
    {
        var query = _searchQuery.Trim();
        if (query.Length < 2 || _module is null)
        {
            return;
        }

        await CallScriptAsync("cancelSearch");
        _searchHits.Clear();
        _searchedFor = query;
        _searchStarted = true;
        _searchNoText = false;
        _searching = true;
        StateHasChanged();
        try
        {
            var outcome = await _module.InvokeAsync<PdfSearchOutcome>("searchText", query);
            _searchNoText = !outcome.HasText;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            Logger.LogDebug(ex, "The PDF search could not finish.");
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task ClosePanelAsync()
    {
        if (_gridMounted)
        {
            _gridMounted = false;
            await CallScriptAsync("unmountPageGrid");
        }

        _panel = null;
        await CallScriptAsync("setInputPaused", false);
    }

    // ---- Page bookmarks -----------------------------------------------------------------------------------------

    private Task SetBookmarkTabAsync(string value)
    {
        _bookmarkTab = value is "everyone" ? "everyone" : "mine";
        _drawBookmarkPictures = true;
        return Task.CompletedTask;
    }

    private async Task ToggleBookmarkAsync()
    {
        if (MyBookmarkOnPage is { } existing)
        {
            await RemoveBookmarkAsync(existing, announce: true);
            return;
        }

        await AddBookmarkAsync();
    }

    private async Task AddBookmarkAsync()
    {
        _bookmarkProblem = null;
        var page = _page;
        var created = await Api.CreatePageBookmarkAsync(AssetId, page, label: null);
        if (created is null)
        {
            _bookmarkProblem = L["PageReader_BookmarkCouldNotSave"].Value;
            _announcement = _bookmarkProblem;
            return;
        }

        _bookmarks.Add(created);
        _bookmarkTab = "mine";
        _drawBookmarkPictures = true;
        _announcement = L["PageReader_BookmarkAdded", page].Value;
    }

    private async Task DeleteBookmarkAsync(MediaEngine.Contracts.Reading.PageBookmarkDto mark)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["PageReader_DeleteBookmarkTitle", mark.Page].Value,
            L["PageReader_DeleteBookmarkBody"].Value,
            yesText: L["Common_Delete"].Value,
            cancelText: L["PageReader_KeepBookmark"].Value,
            options: AppDialogOptions.DestructiveConfirm);
        if (confirmed == true)
        {
            await RemoveBookmarkAsync(mark, announce: true);
        }
    }

    private async Task RemoveBookmarkAsync(MediaEngine.Contracts.Reading.PageBookmarkDto mark, bool announce)
    {
        _bookmarkProblem = null;
        if (!await Api.DeletePageBookmarkAsync(mark.Id))
        {
            _bookmarkProblem = L["PageReader_BookmarkCouldNotSave"].Value;
            _announcement = _bookmarkProblem;
            return;
        }

        _bookmarks.RemoveAll(other => other.Id == mark.Id);
        _drawBookmarkPictures = true;
        if (announce)
        {
            _announcement = L["PageReader_BookmarkRemoved", mark.Page].Value;
        }
    }

    private async Task SetShowBookmarksOnBarAsync(bool value)
    {
        _showBookmarksOnBar = value;
        await SaveChoiceAsync(reading => reading.ShowBookmarksOnBar = value);
    }

    private async Task OnSliderChanged(double value)
    {
        await CallScriptAsync("goTo", (int)Math.Round(value));
    }

    private async Task CallScriptAsync(string method, params object?[] args)
    {
        if (_module is null || _disposed || _disposing)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync(method, args);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            Logger.LogDebug(ex, "The page reader script call {Method} failed.", method);
        }
    }

    // ---- Leaving ------------------------------------------------------------------------------------------------

    private async Task ReadNextAsync()
    {
        if (_next is not { } next || _exited)
        {
            return;
        }

        _exited = true;
        await SavePageAsync();
        // The next issue opens with the same layout; its direction comes from the Series.
        if (_layout != PageReaderProfileSettings.Auto)
        {
            await SaveChoiceAsync(reading => PageReaderProfileSettings.SetLayout(reading, next.AssetId, _layout));
        }

        var query = ReturnCollectionId.HasValue ? $"?ReturnCollectionId={ReturnCollectionId.Value}" : string.Empty;
        Nav.NavigateTo($"/read/{next.AssetId}{query}");
    }

    private async Task BackToSeriesAsync()
    {
        if (_next is not { } next || _exited)
        {
            return;
        }

        _exited = true;
        await SavePageAsync();
        await DetailsOverlayNavigation.ExitToTitleAsync(Nav, Overlay, $"/details/collection/{next.CollectionId}");
    }

    private async Task ExitReader()
    {
        if (_exited)
        {
            return;
        }

        _exited = true;
        await SavePageAsync();
        if (ReturnCollectionId.HasValue)
        {
            Overlay?.OfferLastAsset(ReturnCollectionId.Value, AssetId);
        }

        var returnUrl = ReturnCollectionId.HasValue
            ? $"/details/collection/{ReturnCollectionId.Value}"
            : "/";
        await DetailsOverlayNavigation.ExitToTitleAsync(Nav, Overlay, returnUrl);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed || _disposing)
        {
            return;
        }

        _disposing = true;
        if (_saveTimer is { } timer)
        {
            await timer.DisposeAsync();
            _saveTimer = null;
        }

        if (!_exited)
        {
            await SavePageAsync();
        }

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
            {
                Logger.LogDebug(ex, "The page reader script was already gone.");
            }
        }

        _dotNetRef?.Dispose();
        _disposed = true;
    }

