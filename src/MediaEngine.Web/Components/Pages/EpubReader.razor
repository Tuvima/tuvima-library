@page "/read/{AssetId:guid}"
@layout MediaEngine.Web.Shared.ReaderLayout

@namespace MediaEngine.Web.Components.Pages
@using MediaEngine.Web.Services.Navigation

@inject NavigationManager Nav

@* The route for reading an EPUB. Every book opens in the foliate-js reader (BookReader), which reads the book file in the
   browser and unpacks the pictures itself, so no separate picture requests ever need a sign-in. *@
<BookReader @key="AssetId" AssetId="AssetId" ReturnCollectionId="ReturnCollectionId" Restart="Restart" />

@code {
    [Parameter] public Guid AssetId { get; set; }

    // The address this page was routed with (see RoutedPageQuery).
    [CascadingParameter(Name = RoutedPageQuery.CascadingName)] public string? RoutedUri { get; set; }

    private RoutedPageQuery Query => RoutedPageQuery.From(RoutedUri ?? Nav.Uri);
    public Guid? ReturnCollectionId => Query.Guid("ReturnCollectionId");
    public bool Restart => Query.Bool("Restart");
}
