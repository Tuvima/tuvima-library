    private string GetMetadataDescription()
    {
        if (!string.IsNullOrWhiteSpace(Detail))
        {
            return "Configure this provider and review every place it participates in ingestion.";
        }

        return _activeSubsection switch
        {
            "ingestion-flow" => "See which providers run at each stage and what they add to every media type.",
            _ => "Manage every metadata, canonical identity, and enrichment provider in one place.",
        };
    }

