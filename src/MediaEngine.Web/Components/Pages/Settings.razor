@page "/settings"
@page "/settings/{Section}"
@page "/settings/{Section}/{Subsection}"
@page "/settings/{Section}/{Subsection}/{Detail}"
@rendermode InteractiveServer
@namespace MediaEngine.Web.Components.Pages
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Navigation
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject DeviceContextService DeviceContext
@inject UIOrchestratorService Orchestrator
@inject MediaEngine.Web.Services.Settings.LibraryKindsState LibraryKinds
@inject DashboardSessionAccessor Session
@inject MediaEngine.Web.Services.Vault.NsfwModeState Nsfw
@inject DashboardIdentityClient Identity
@inject AccountNoticeState Notices
@inject SettingsAttentionState Attention
@inject DevelopmentToolsState DevelopmentTools
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject ILogger<Settings> Logger
@inject MediaEngine.Web.Services.Integration.ProviderCatalogueService ProviderNames
@implements IAsyncDisposable
@inject IStringLocalizer<SharedStrings> L

<PageTitle>@BrowserTitle</PageTitle>

@if (_leavingSettings)
{
    @* A Kids profile reaches Profile and nothing else in Settings. The move to Home is already under way, so nothing is drawn meanwhile. *@
}
else if (!_profileRoleLoaded)
{
    @* Neutral loading state: the section, navigation and permissions are unknown until the session resolves. *@
    <MediaSectionShell Title="@L["Nav_Settings"].Value"
                       NavigationGroups="@(Array.Empty<MediaSectionNavigationGroup>())"
                       ShowMobileNavigation="false">
        <div class="settings-shell-content" aria-busy="true" aria-label="@L["Settings_LoadingSettings"].Value">
            <div class="settings-loading-skeleton">
                <AppSkeleton Width="40%" Height="28px" />
                <AppSkeleton Width="100%" Height="120px" />
                <AppSkeleton Width="100%" Height="120px" />
            </div>
        </div>
    </MediaSectionShell>
}
else
{
<MediaSectionShell Title="@L["Nav_Settings"].Value"
                   NavigationGroups="@SettingsNavigationGroups"
                   FixedColumnTree="true"
                   ShowMobileNavigation="false">
    <div class="settings-shell-content" @ref="_contentElement">
        <nav class="settings-mobile-navigation" aria-label="@L["Settings_SettingsPageSelector"].Value">
            <label class="settings-mobile-navigation__label" for="settings-mobile-page">@L["Settings_SettingsPage"]</label>
            <div class="settings-mobile-navigation__control">
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Tune" aria-hidden="true" />
                <AppNativeSelect @key="MobileNavigationValue"
                                 id="settings-mobile-page"
                                 Value="@MobileNavigationValue"
                                 OnChange="@OnMobilePageChanged"
                                 aria-label="@L["Settings_SettingsPage"].Value">
                    @foreach (var group in PhoneMenuGroups)
                    {
                        <optgroup label="@group.Label">
                            @foreach (var option in group.Options)
                            {
                                <option value="@option.Route" selected="@IsMobileNavigationOptionSelected(option.Route)">@option.Label</option>
                            }
                        </optgroup>
                    }
                </AppNativeSelect>
            </div>
        </nav>

        <MediaEngine.Web.Components.Vault.VaultHiddenReminder />

        <SettingsPageFrame Breadcrumbs="@Breadcrumbs"
                           Eyebrow="@GetHeroEyebrow()"
                           Title="@GetHeroTitle()"
                           Description="@GetSectionDescription(_activeSection)"
                           Notices="@(ShowAttentionBanner ? AttentionBanner : null)"
                           PageNotice="@PageNoticeFragment"
                           Tabs="@PageTabsFragment">
            <div @key="DeviceContext.DeviceClass" class="@PageCanvasClass">
                <AdministratorSurfaceGate Required="@(_profileRoleLoaded && RequiresAdministratorSurface)">
                @if (ShouldDeferForRoleResolution)
                {
                    <AppPageState Kind="AppPageStateKind.Loading"
                                  Title="@L["Settings_CheckingProfilePermissions"].Value"
                                  Class="tl-sp-py-8" />
                }
                else if (IsMobileRouteUnavailable)
                {
                    <AppPageState Kind="AppPageStateKind.Unavailable"
                                  Icon="@AppMaterialIcons.Outlined.DesktopWindows"
                                  Title="@L["Settings_UseALargerScreenFor"].Value"
                                  Message="@MobileUnavailableMessage">
                        <Actions>
                            <AppButton Href="@MobileFallbackRoute"
                                       Label="@L["Settings_BackToMobileSettings"].Value"
                                       StartIcon="@AppMaterialIcons.Outlined.ArrowBack" />
                        </Actions>
                    </AppPageState>
                }
                else if (IsDevelopmentOnlyPageLoading)
                {
                    <AppPageState Kind="AppPageStateKind.Loading"
                                  Title="@L["Settings_CheckingWhatThisEngineOffers"].Value"
                                  Class="tl-sp-py-8" />
                }
                else if (IsDevelopmentOnlyPageUnavailable)
                {
                    <AppPageState Kind="AppPageStateKind.Unavailable"
                                  Icon="@AppMaterialIcons.Outlined.Construction"
                                  Title="@L["Settings_NotAvailableInThisBuild"].Value"
                                  Message="@L["Settings_ThisPageOnlyExistsIn"].Value" />
                }
                else
                {
                    @if (IsEngineUnavailableForCurrentSection)
                    {
                        <AppAlert Severity="AppSeverity.Error"
                                  Variant="AppVariant.Outlined"
                                  Icon="@AppMaterialIcons.Outlined.CloudOff"
                                  Class="tl-sp-mb-4">
                            @L["Settings_EngineStateCouldNotBe"]
                        </AppAlert>
                    }
                    @switch (_activeSection)
                    {
                            case SettingsSection.Overview:
                                @if (_activeSubsection == SettingsNav.AppsSubsection)
                                {
                                    <OverviewAppsPage />
                                }
                                else if (_activeSubsection == SettingsNav.ActivitySubsection)
                                {
                                    <ActivityPage Scope="@ActivityScope" />
                                }
                                else if (_activeSubsection == SettingsNav.TasteSubsection)
                                {
                                    <OverviewTastePage />
                                }
                                else if (_activeSubsection == SettingsNav.ImportSubsection)
                                {
                                    <OverviewImportPage />
                                }
                                else
                                {
                                    <OverviewPage />
                                }
                                break;
                            case SettingsSection.Profiles:
                                @if (IsProfileDetailRoute)
                                {
                                    <ProfileDetailPage ProfileId="@ProfileDetailId" Tab="@ProfileTab" NameChanged="OnProfileNameChanged" />
                                }
                                else
                                {
                                    <ProfilesTab />
                                }
                                break;
                            case SettingsSection.Security:
                                @if (_activeSubsection == SettingsNav.DevicesSubsection)
                                {
                                    <DevicesTab />
                                }
                                else
                                {
                                    <SecuritySettingsPage />
                                }
                                break;
                            case SettingsSection.AdminOverview:
                                @if (_activeSubsection == SettingsNav.LogsSubsection)
                                {
                                    <LogsPage Tab="@LogsTab" Filter="@LogsFilter" />
                                }
                                else if (_activeSubsection == SettingsNav.ScheduledTasksSubsection)
                                {
                                    <ScheduledTasksPage />
                                }
                                else
                                {
                                    <SystemSummaryPage />
                                }
                                break;
                            case SettingsSection.Libraries:
                                <LibrariesTab Subsection="@_activeSubsection" Detail="@Detail" />
                                break;
                            case SettingsSection.Ingestion:
                                <IngestionTasksTab View="@IngestionView" />
                                break;
                            case SettingsSection.RecentlyAdded:
                                <RecentlyAddedPageContent InitialSearch="@RecentSearch" />
                                break;
                            case SettingsSection.Review:
                                <NeedsReviewPageContent InitialSearch="@RecentSearch" Library="@Query.String("library")" />
                                break;
                            case SettingsSection.DevHarness:
                                @RenderInternalTool(
                                    "MediaEngine.Web.Components.Settings.DevHarnessTab",
                                    new Dictionary<string, object?> { ["Subsection"] = _activeSubsection })
                                break;
                            case SettingsSection.Providers:
                                <MetadataSettingsPage Subsection="@_activeSubsection" Detail="@Detail" />
                                break;
                            case SettingsSection.LocalAi:
                                <LocalAiSettingsTab Subsection="@_activeSubsection" />
                                break;
                            case SettingsSection.Plugins:
                                <PluginSettingsTab FocusPluginId="@PluginFocusId" DetailPluginId="@PluginDetailId" DetailTab="@PluginDetailTab" NameChanged="OnPluginNameChanged" />
                                break;
                            case SettingsSection.Delivery:
                                <PlaybackDeliverySettingsTab Subsection="@_activeSubsection" />
                                break;
                            case SettingsSection.Tools:
                            case SettingsSection.Notifications:
                                <ConfigurationPage />
                                break;
                            case SettingsSection.Network:
                                <NetworkRemoteAccessSettings Subsection="@_activeSubsection" RemoteAccessOffChanged="OnRemoteAccessOffChanged" />
                                break;
                            case SettingsSection.Access:
                                @if (_activeSubsection == SettingsNav.HouseholdsSubsection)
                                {
                                    <HouseholdsTab />
                                }
                                else
                                {
                                    <UsersAccessSettingsTab Subsection="@_activeSubsection" />
                                }
                                break;
                            case SettingsSection.Integrations:
                                <UsersAccessSettingsTab Subsection="applications" IntegrationId="@IntegrationDetailId" DetailTab="@IntegrationDetailTab" NameChanged="OnIntegrationNameChanged" />
                                break;
                            case SettingsSection.Server:
                                <BackupRecoveryPanel />
                                break;
                            case SettingsSection.ProviderTester:
                                @RenderInternalTool("MediaEngine.Web.Components.Settings.ProviderTesterToolTab")
                                break;
                            case SettingsSection.EnrichmentTester:
                                @RenderInternalTool("MediaEngine.Web.Components.Settings.EnrichmentTesterToolTab")
                                break;
                    }
                }
                </AdministratorSurfaceGate>
            </div>
        </SettingsPageFrame>
    </div>
</MediaSectionShell>
}

@code {
    [Parameter] public string? Section { get; set; }
    [Parameter] public string? Subsection { get; set; }
    [Parameter] public string? Detail { get; set; }
    private string? _profileBreadcrumbName;
    private string? _pluginBreadcrumbName;
    private void OnPluginNameChanged(string name)
    {
        if (_pluginBreadcrumbName != name)
        {
            _pluginBreadcrumbName = name;
            StateHasChanged();
        }
    }

    private string? _integrationBreadcrumbName;
    private void OnIntegrationNameChanged(string name)
    {
        if (_integrationBreadcrumbName != name)
        {
            _integrationBreadcrumbName = name;
            StateHasChanged();
        }
    }

    // An integration's own page (Plugins and Integrations screens v3 D24): /settings/integrations/{id}/{tab}.
    private bool IsIntegrationDetailRoute => _activeSection == SettingsSection.Integrations && !string.IsNullOrWhiteSpace(_activeSubsection);
    private string? IntegrationDetailId => IsIntegrationDetailRoute ? _activeSubsection : null;
    private string IntegrationDetailTab => (Detail ?? string.Empty).Trim().ToLowerInvariant();

    // A plugin's own page (Plugins and Integrations screens v3 D17): /settings/plugins/{id}/{tab}. Providers use the same page.
    private bool IsPluginDetailRoute => _activeSection == SettingsSection.Plugins && !string.IsNullOrWhiteSpace(_activeSubsection);
    private string? PluginDetailId => IsPluginDetailRoute ? _activeSubsection : null;
    private string PluginDetailTab => (Detail ?? string.Empty).Trim().ToLowerInvariant();
    private void OnProfileNameChanged(string name)
    {
        if (_profileBreadcrumbName != name)
        {
            _profileBreadcrumbName = name;
            StateHasChanged();
        }
    }

    // The address this page was routed with (see RoutedPageQuery): the page under the details overlay keeps its own query.
    [CascadingParameter(Name = RoutedPageQuery.CascadingName)] public string? RoutedUri { get; set; }

    [CascadingParameter] public DetailsOverlayState? Overlay { get; set; }

    private RoutedPageQuery Query => RoutedPageQuery.From(RoutedUri ?? Nav.Uri);
    public string? IngestionView => Query.String("view");
    public string? ReviewState => Query.String("review");
    public string? LogsTab => Query.String("tab");
    public string? LogsFilter => Query.String("filter");

    /// <summary>Opens the Plugins page scrolled to this plugin's card (<c>/settings/plugins?plugin={id}</c>); an unknown id changes nothing.</summary>
    public string? PluginFocusId => Query.String("plugin");

    /// <summary>Opens the Activity page already narrowed to one person, household or everyone (for example from a person's page).</summary>
    public string? ActivityScope => Query.String("scope");
    public string? RecentSearch => Query.String("q");
    /// <summary>The profile an old Playback, Listening or Reading link names (<c>?profile={id}</c>); yours when it names none.</summary>

    private SettingsSection _activeSection = SettingsSection.Profiles;
    private string _activeSubsection = string.Empty;
    private ProfileViewModel? _activeProfile;
    private bool _profileRoleLoaded;
    // A Kids profile reaches Profile and nothing else in Settings; every other address sends it Home.
    private bool _restricted;
    private bool _leavingSettings;

    private bool _legacyRedirectIssued;
    private SystemStatusViewModel? _systemStatus;
    private bool _shellStateLoading = true;
    private bool _developmentToolsLoading = true;

    private ElementReference _contentElement;
    private bool _scrollToTopPending;
    private bool _wasAdministrationRoute;
    // A this-computer-only account has no password yet: its Security entry carries the attention dot until the person
    // chooses Not now on the Secure your account card (remembered with the account); Security then shows a quiet note instead.
    private bool _thisComputerOnly;
    private bool ShowSecurityAttentionDot => _thisComputerOnly && !Notices.IsDismissed(AccountNoticeKeys.SecureAccount);
    private void OnNoticesChanged() => _ = InvokeAsync(StateHasChanged);
    private SettingsMenuContext MenuContext => new(
        CanManageAdministration,
        DeviceContext.IsMobile,
        Attention.ReviewCount,
        ShowSecurityAttentionDot,
        IsSectionOffered,
        Attention.LocalAiBlocked,
        Attention.PluginsBroken,
        Attention.AiFeaturesOn,
        Attention.IntegrationsBroken,
        ToolsMissingReason,
        _restricted);

    // Red on Tools and requirements only for a required tool that is missing or broken; one being downloaded is not a problem.
    private string? ToolsMissingReason => Attention.MissingTools switch
    {
        { Count: 0 } => null,
        { Count: 1 } one => $"{one[0].Name} missing",
        var many => $"{many.Count} missing",
    };

    // One flat menu: the desktop rail, the phone page selector and the tab strip are all built from it.
    private IReadOnlyList<MediaSectionNavigationGroup> SettingsNavigationGroups => SettingsMenuBuilder.Build(MenuContext);

    private IReadOnlyList<SettingsPhoneMenuGroup> PhoneMenuGroups => SettingsMenuBuilder.BuildPhoneSelector(SettingsNavigationGroups);

    // The page this person is on, with only the tabs they may open; null for a page the menu does not place.
    private SettingsMenuLocation? CurrentLocation
    {
        get
        {
            var location = SettingsNav.FindMenuLocation(_activeSection, _activeSubsection);
            if (location is null)
            {
                return null;
            }

            var visible = SettingsMenuBuilder.FilteredGroups(MenuContext)
                .SelectMany(group => group.Nodes)
                .FirstOrDefault(node => node.Label == location.Page.Label);
            return visible is null
                ? location
                : location with { Page = visible, Tab = location.Tab is null ? null : visible.TabFor(_activeSection, _activeSubsection) };
        }
    }

    private SettingsGroupDef CurrentGroup => CurrentLocation is { } location
        ? SettingsNav.AllGroups.First(group => group.Key == location.Group.Key)
        : SettingsNav.GetGroup(_activeSection);

    // The one row of tabs under the page title: the page's own tabs, or a profile's three tabs on a profile's page.
    private RenderFragment? PageTabsFragment => IsProfileDetailRoute
        ? ProfileTabsFragment
        : CurrentLocation is { Tab: not null, Page.HasTabs: true } location && !IsMobileRouteUnavailable
            ? RenderPageTabs(location)
            : null;

    private RenderFragment ProfileTabsFragment => @<ProfileTabs ProfileId="@ProfileDetailId" Active="@ProfileTab" />;

    private RenderFragment RenderPageTabs(SettingsMenuLocation location) =>
        @<SettingsPageTabs Tabs="@location.Page.Tabs" Active="@location.Tab" PageLabel="@location.Page.Label" />;
    private IReadOnlyList<SettingsBreadcrumb> Breadcrumbs => BuildBreadcrumbs();
    private bool IsProfileDetailRoute => _activeSection == SettingsSection.Profiles && ProfileDetailId != Guid.Empty;
    private Guid ProfileDetailId => Guid.TryParse(_activeSubsection, out var id) ? id : Guid.Empty;

    /// <summary>The tab of a person's page: empty for Profile, otherwise <c>preferences</c> or <c>access</c>.</summary>
    private string ProfileTab => (Detail ?? string.Empty).Trim().ToLowerInvariant();

    private string BrowserTitle => IsProfileDetailRoute
        ? $"{_profileBreadcrumbName ?? "Profile"} - Manage Profiles - Library"
        : _activeSection == SettingsSection.Libraries
        ? LibrariesBrowserTitle
        : CurrentLocation?.Tab is { } tab && !string.Equals(tab.Label, GetHeroTitle(), StringComparison.Ordinal)
        ? $"{tab.Label} - {GetHeroTitle()} - Library"
        : $"{GetHeroTitle()} - Library";
    // The Vault's title and breadcrumb follow the same rule as the Libraries page itself (an administrator with Vault mode on).
    private LibraryLevelDescription LibrariesLevel => LibraryAddress.Describe(
        LibraryKinds.Catalog, _activeSubsection, Detail, LibraryVaultAccess.CanShow(Nsfw, Session, _restricted), _libraryAddressConfiguration);
    // A library's own page is titled with its name, so the libraries are read for it (once per library address).
    private LibrariesConfigurationDto? _libraryAddressConfiguration;
    private string? _libraryAddressConfigurationFor;
    // "Movies - Watch - Library", "Watch - Library" or "Libraries - Library".
    private string LibrariesBrowserTitle =>
        LibrariesLevel.Crumbs.Count >= 3
            ? $"{LibrariesLevel.Title} - {LibrariesLevel.Crumbs[^2].Label} - Library"
            : $"{LibrariesLevel.Title} - Library";
    private bool ShouldDeferForRoleResolution =>
        SettingsNav.GetItem(_activeSection).AdminOnly
        && !_profileRoleLoaded;
    private bool IsEngineUnavailableForCurrentSection =>
        !_shellStateLoading
        && _systemStatus is null
        && SettingsNav.GetItem(_activeSection).AdminOnly;
    private bool IsMobileRouteUnavailable =>
        DeviceContext.IsMobile
        && !SettingsNav.IsMobileRouteAvailable(_activeSection, _activeSubsection, Detail);
    private string PageCanvasClass => string.Join(" ", new[]
    {
        "settings-page-canvas",
        "settings-admin-panel",
        DeviceContext.IsMobile && SettingsNav.GetMobileAvailability(_activeSection) == SettingsMobileAvailability.SummaryOnly
            ? "settings-mobile-summary"
            : null,
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private string MobileNavigationValue => IsMobileRouteUnavailable
        ? MobileFallbackRoute
        : SettingsNavigationGroups
            .SelectMany(group => group.Items)
            .FirstOrDefault(item => item.ActiveRoutes?.Contains(SettingsNav.BaseRouteFor(_activeSection), StringComparer.OrdinalIgnoreCase) == true)?.Route
          ?? SettingsNav.RouteFor(_activeSection);
    private bool IsMobileNavigationOptionSelected(string route) =>
        string.Equals(route, MobileNavigationValue, StringComparison.OrdinalIgnoreCase);

    private string MobileUnavailableMessage => SettingsNav.GetMobileAvailability(_activeSection) == SettingsMobileAvailability.DesktopOnly
        ? $"{GetHeroTitle()} is intentionally withheld from mobile because it contains complex configuration or diagnostic tools. Use a desktop or tablet for this workflow."
        : $"This part of {GetHeroTitle()} contains configuration or diagnostic tools that are safer and easier to use on a desktop or tablet. The mobile overview remains available.";
    private string MobileFallbackRoute => SettingsNav.GetMobileAvailability(_activeSection) == SettingsMobileAvailability.DesktopOnly
        ? SettingsNav.RouteFor(SettingsSection.AdminOverview)
        : SettingsNav.RouteFor(_activeSection);

    // The administrator banner sits above the breadcrumb on every Settings page; it draws nothing for anyone else or on a phone.
    private bool ShowAttentionBanner => Attention.IsServerAdministrator && !DeviceContext.IsMobile;
    private RenderFragment AttentionBanner => @<SettingsAttentionBanner />;

    // Permanent page notices cannot be dismissed. Local AI shows its notice on every sub-page while it is blocked; Network
    // shows its notice while remote access is not set up (reported by the Network page, which already reads that setting).
    // Like the banner, neither is drawn on a phone.
    private RenderFragment LocalAiNotice => @<LocalAiBlockedNotice />;
    private RenderFragment RemoteAccessNotice => @<RemoteAccessOffNotice />;
    private bool _remoteAccessOff;
    private RenderFragment? PageNoticeFragment => DeviceContext.IsMobile ? null : _activeSection switch
    {
        SettingsSection.LocalAi => LocalAiNotice,
        SettingsSection.Network when _remoteAccessOff => RemoteAccessNotice,
        _ => null,
    };

    private void OnRemoteAccessOffChanged(bool off)
    {
        if (_remoteAccessOff != off)
        {
            _remoteAccessOff = off;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (DeviceContext.IsPageDisabled("settings")
            || (DeviceContext.IsPageDisabled("preferences")
                && DeviceContext.IsPageDisabled("server_settings")))
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        await LoadAuthorityAsync();
        ResolveSectionAndNormalize();
        if (_leavingSettings)
        {
            return;
        }

        var developmentTools = LoadDevelopmentToolsAsync();
        await LoadShellStateAsync();
        await developmentTools;

        Attention.Changed += OnAttentionChanged;
        LibraryKinds.Changed += OnAttentionChanged;
        Nsfw.Changed += OnAttentionChanged;
        Notices.Changed += OnNoticesChanged;
        Orchestrator.OnProfileChanged += OnProfileChanged;
        DeviceContext.OnChanged += OnDeviceContextChanged;

        // The frame draws now; the banner and menu shading appear together when the first read has finished.
        _ = Attention.StartAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var leavingAdministration = (_wasAdministrationRoute
            || SettingsNav.GetItem(_activeSection).AdminOnly)
            && !IsAdministrationRoute(Section);
        if (leavingAdministration && Session.ShouldLockOnLeave)
        {
            await ExitAdministrationAsync();
        }
        _wasAdministrationRoute = IsAdministrationRoute(Section);
        ResolveSectionAndNormalize();
        if (!IsProfileDetailRoute)
        {
            _profileBreadcrumbName = null;
        }

        if (!IsPluginDetailRoute)
        {
            _pluginBreadcrumbName = null;
        }

        if (!IsIntegrationDetailRoute)
        {
            _integrationBreadcrumbName = null;
        }

        _scrollToTopPending = true;

        // The title and breadcrumb of a Libraries page name its group and kind, which come from the Engine's list of library kinds.
        if (_activeSection == SettingsSection.Libraries && !LibraryKinds.Loaded)
        {
            await LibraryKinds.EnsureLoadedAsync();
        }

        if (_activeSection == SettingsSection.Libraries && Guid.TryParse(_activeSubsection, out _)
            && !string.Equals(_libraryAddressConfigurationFor, _activeSubsection, StringComparison.OrdinalIgnoreCase))
        {
            _libraryAddressConfigurationFor = _activeSubsection;
            _libraryAddressConfiguration = await Orchestrator.GetLibrariesAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollToTopPending)
        {
            return;
        }

        _scrollToTopPending = false;
        await JS.InvokeVoidAsync("scrollElementToTop", _contentElement);
    }

    public async ValueTask DisposeAsync()
    {
        Notices.Changed -= OnNoticesChanged;
        Attention.Changed -= OnAttentionChanged;
        LibraryKinds.Changed -= OnAttentionChanged;
        Nsfw.Changed -= OnAttentionChanged;
        Attention.Stop();
        Orchestrator.OnProfileChanged -= OnProfileChanged;
        DeviceContext.OnChanged -= OnDeviceContextChanged;
        if (Session.ShouldLockOnLeave)
            await ExitAdministrationAsync();
    }

    private static bool IsAdministrationRoute(string? section)
    {
        var resolution = SettingsNav.ResolveRoute(section, administrationAllowed: true);
        return resolution.IsKnownRoute && SettingsNav.GetItem(resolution.Section).AdminOnly;
    }

    private async Task ExitAdministrationAsync()
    {
        Session.ClearAdministratorActions();
        try
        {
            await Identity.ExitAdministratorAsync();
            await Identity.RevalidateAuthorityAsync(Session);
        }
        catch (Exception)
        {
            // The bounded server unlock lease handles a disconnected Dashboard.
        }
    }

    private async Task LoadShellStateAsync()
    {
        _shellStateLoading = true;

        try
        {
            _systemStatus = await Orchestrator.GetSystemStatusAsync();
        }
        catch
        {
            _systemStatus = null;
        }

        _shellStateLoading = false;
    }

    // Only a server administrator is shown the Developer group, so only then is the Engine asked what it offers there.
    // It is asked beside the slower system status read, so the menu and the two development pages never wait for it.
    private async Task LoadDevelopmentToolsAsync()
    {
        try
        {
            if (CanManageAdministration)
            {
                await DevelopmentTools.EnsureLoadedAsync();
            }
        }
        finally
        {
            _developmentToolsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadAuthorityAsync()
    {
        try
        {
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            _thisComputerOnly = SecureAccountPrompt.IsThisComputerOnly(principal);
            if (_thisComputerOnly) await Notices.EnsureLoadedAsync();
            Session.InitializeFromPrincipal(principal);
            await Identity.EnsureInitialAuthorityAsync(Session);
            _activeProfile = await Orchestrator.GetActiveProfileAsync();
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Settings authority initialization failed.");
            _activeProfile = null;
        }
        finally
        {
            _profileRoleLoaded = true;
            // A Kids profile never reaches Settings; a typed address must not open it.
            _restricted = _activeProfile?.IsRestricted == true;
        }
    }

    private bool CanManageAdministration => Session.HasNavigation("settings.administration");

    // Administration pages need the administrator gate.
    private bool RequiresAdministratorSurface => SettingsNav.GetItem(_activeSection).AdminOnly;

    private void ResolveSectionAndNormalize()
    {
        // A profile or authority change can reach this while the router has already moved to another settings page (or another tab of the same page) but has not
        // handed this component the new Section, Subsection and Detail yet. Redirecting from that stale Section sends the page to the old address, and the
        // same mistake then sends it back, flipping between two pages as fast as ingestion events arrive. The router's own parameter
        // update runs this again with matching ones.
        if (!RoutedSectionMatchesAddress())
        {
            return;
        }

        if (!_legacyRedirectIssued
            && Section is not null
            && (Section.Equals("activity", StringComparison.OrdinalIgnoreCase)
                || Section.Equals("timeline", StringComparison.OrdinalIgnoreCase)))
        {
            _legacyRedirectIssued = true;
            Nav.NavigateTo("/settings/recently-added", replace: true);
            return;
        }

        // Needs Review has its own page now; the old Recently Added link that opened its collapsed block lands there.
        if (!_legacyRedirectIssued
            && Section is not null
            && Section.Equals("recently-added", StringComparison.OrdinalIgnoreCase)
            && string.Equals(ReviewState, "expanded", StringComparison.OrdinalIgnoreCase))
        {
            _legacyRedirectIssued = true;
            Nav.NavigateTo(SettingsNav.RouteFor(SettingsSection.Review), replace: true);
            return;
        }

        var resolution = SettingsNav.ResolveRoute(Section, CanManageAdministration, _restricted);
        _activeSection = resolution.Section;

        if (_restricted)
        {
            // A Kids profile never reaches Settings (its own pages are My profile and My activity). Any Settings address goes Home.
            _leavingSettings = true;
            Nav.NavigateTo("/", replace: true);
            return;
        }

        if (!resolution.IsKnownRoute)
        {
            Nav.NavigateTo("/not-found", replace: true);
            return;
        }

        if (!resolution.RequestedSectionAllowed)
        {
            Nav.NavigateTo(resolution.CanonicalRoute, replace: true);
            return;
        }

        if (_activeSection == SettingsSection.Libraries && IsLibraryRouteSegment(Subsection))
        {
            _activeSubsection = Subsection!.Trim();
        }
        else if (_activeSection == SettingsSection.Profiles && Guid.TryParse(Subsection, out _))
        {
            _activeSubsection = Subsection!.Trim();
        }
        else if (_activeSection is SettingsSection.Plugins or SettingsSection.Integrations && !string.IsNullOrWhiteSpace(Subsection))
        {
            _activeSubsection = Subsection!.Trim();
        }
        else if (_activeSection == SettingsSection.Providers && string.IsNullOrWhiteSpace(Subsection))
        {
            _activeSubsection = SettingsNav.IngestionFlowSubsection;
        }
        else if (string.IsNullOrWhiteSpace(Subsection))
        {
            _activeSubsection = string.Empty;
        }
        else
        {
            var subsection = SettingsNav.ResolveSubsection(_activeSection, Subsection);
            if (subsection is null)
            {
                Nav.NavigateTo("/not-found", replace: true);
                return;
            }

            _activeSubsection = subsection.Slug;
        }

        if (!IsValidDetailRoute(_activeSection, _activeSubsection, Detail))
        {
            Nav.NavigateTo("/not-found", replace: true);
            return;
        }

        var currentPath = NormalizePath(Nav.ToBaseRelativePath(RoutedPageAddress.AbsoluteFor(Nav, Overlay)));
        var targetRoute = _activeSection == SettingsSection.Libraries && IsLibraryRouteSegment(Subsection)
            ? $"/settings/libraries/{_activeSubsection}{(string.IsNullOrWhiteSpace(Detail) ? string.Empty : "/" + Detail.Trim().ToLowerInvariant())}"
            : IsProfileDetailRoute
            ? $"/settings/profiles/{_activeSubsection}{(ProfileTab.Length == 0 ? string.Empty : "/" + ProfileTab)}"
            : IsIntegrationDetailRoute
            ? $"/settings/integrations/{Uri.EscapeDataString(_activeSubsection)}{(IntegrationDetailTab.Length == 0 ? string.Empty : "/" + IntegrationDetailTab)}"
            : IsPluginDetailRoute
            ? $"/settings/plugins/{Uri.EscapeDataString(_activeSubsection)}{(PluginDetailTab.Length == 0 ? string.Empty : "/" + PluginDetailTab)}"
            : string.IsNullOrWhiteSpace(Subsection)
            ? resolution.CanonicalRoute
            : SettingsNav.RouteFor(_activeSection, _activeSubsection);
        var targetPath = NormalizePath(targetRoute);

        if (!string.Equals(currentPath, targetPath, StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo(targetRoute, replace: true);
        }
    }

    private bool _sawSettingsAddress;

    private bool RoutedSectionMatchesAddress()
    {
        var segments = NormalizePath(Nav.ToBaseRelativePath(RoutedPageAddress.AbsoluteFor(Nav, Overlay)))
            .Trim('/')
            .Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length == 0 || !string.Equals(segments[0], "settings", StringComparison.OrdinalIgnoreCase))
        {
            // Once this page has been at a Settings address, an address that is no longer one means a top-bar link or the logo has
            // moved the router away: there is nothing left for this page to correct, and redirecting from here would drag the person
            // back into Settings. A page that never saw a Settings address has nothing to wait for and resolves as usual.
            return !_sawSettingsAddress;
        }

        _sawSettingsAddress = true;

        string? SegmentAt(int index) => segments.Length > index ? segments[index] : null;
        return string.Equals(SegmentAt(1), Section, StringComparison.OrdinalIgnoreCase)
            && string.Equals(SegmentAt(2), Subsection, StringComparison.OrdinalIgnoreCase)
            && string.Equals(SegmentAt(3), Detail, StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizePath(string path)
    {
        var relative = path.Split('?', '#')[0].Trim();
        if (string.IsNullOrWhiteSpace(relative))
        {
            return "/";
        }

        return "/" + relative.Trim('/').TrimEnd('/');
    }

    // Libraries has its own levels: /settings/libraries/{group}, /settings/libraries/{group}/{type} and /settings/libraries/import.
    private static bool IsLibraryRouteSegment(string? value) => SettingsNav.IsLibraryRouteSegment(value);

    private static bool IsValidDetailRoute(SettingsSection section, string subsection, string? detail)
    {
        if (string.IsNullOrWhiteSpace(detail)) return true;
        // A person's page has two more tabs beside Profile: Preferences and Access & safety.
        if (section == SettingsSection.Profiles) return Guid.TryParse(subsection, out _) && detail.Trim().ToLowerInvariant() is "preferences" or "access";
        if (section == SettingsSection.Libraries) return SettingsNav.IsLibraryRouteSegment(subsection) && IsProviderRouteKey(detail);
        if (section == SettingsSection.Integrations) return Guid.TryParse(subsection, out _) && detail.Trim().ToLowerInvariant() is "access" or "keys" or "deliveries" or "activity";
        if (section == SettingsSection.Plugins) return !string.IsNullOrWhiteSpace(subsection) && detail.Trim().ToLowerInvariant() is "settings" or "access" or "activity";
        return false;
    }

    private static bool IsProviderRouteKey(string value) => value.All(character =>
        char.IsLetterOrDigit(character) || character is '_' or '-');

    private void OnAttentionChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnProfileChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAuthorityAsync();
            await LoadDevelopmentToolsAsync();
            ResolveSectionAndNormalize();
            StateHasChanged();
        });
    }

    private void OnDeviceContextChanged() => InvokeAsync(StateHasChanged);

    // The Developer group is for server administrators only (the menu's own rule). Beyond that, its two sub-pages exist only
    // when the running Engine is a development build that offers their actions; Provider Tester uses ordinary search
    // actions, so it needs nothing more. A release Engine drops them from the menu and the phone selector, and their
    // addresses show the not-available state.
    private bool IsSectionOffered(SettingsSection section) => section switch
    {
        SettingsSection.EnrichmentTester => DevelopmentTools.EnrichmentTester,
        SettingsSection.DevHarness => DevelopmentTools.DevelopmentData,
        _ => true,
    };

    private bool IsDevelopmentOnlyPage => _activeSection is SettingsSection.EnrichmentTester or SettingsSection.DevHarness;

    private bool IsDevelopmentOnlyPageLoading => IsDevelopmentOnlyPage && _developmentToolsLoading;

    private bool IsDevelopmentOnlyPageUnavailable => IsDevelopmentOnlyPage && !IsSectionOffered(_activeSection);

    private RenderFragment RenderInternalTool(
        string typeName,
        IReadOnlyDictionary<string, object?>? parameters = null) => builder =>
    {
        var componentType = typeof(Settings).Assembly.GetType(typeName, throwOnError: false);
        if (componentType is null)
        {
            builder.OpenComponent<AppText>(0);
            builder.AddAttribute(1, nameof(AppText.Typo), AppTypo.body1);
            builder.AddContent(2, "This internal tool is not included in this build.");
            builder.CloseComponent();
            return;
        }

        builder.OpenComponent(0, componentType);
        if (parameters is not null)
        {
            var sequence = 1;
            foreach (var parameter in parameters)
                builder.AddAttribute(sequence++, parameter.Key, parameter.Value);
        }
        builder.CloseComponent();
    };

    private void OnMobilePageChanged(ChangeEventArgs args)
    {
        var route = args.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(route))
        {
            Nav.NavigateTo(route);
        }
    }

    private IReadOnlyList<SettingsBreadcrumb> BuildBreadcrumbs()
    {
        var breadcrumbs = new List<SettingsBreadcrumb>
        {
            new("Settings", SettingsNav.RouteFor(SettingsSection.Overview)),
        };

        // Settings > Group > Page > Tab, straight from the menu. Every step is a link except the last, which is where you are.
        var location = CurrentLocation;
        var pageLabel = location?.Page.Label ?? GetHeroTitle();
        // A group with one page of the same name (System, Developer) is not said twice.
        if (!string.Equals(CurrentGroup.Label, pageLabel, StringComparison.Ordinal))
        {
            breadcrumbs.Add(new SettingsBreadcrumb(
                CurrentGroup.Label,
                SettingsNav.RouteFor(CurrentGroup.DefaultSection)));
        }

        var pageRoute = location?.Page.Route ?? SettingsNav.RouteFor(_activeSection);
        var steps = new List<SettingsBreadcrumb> { new(pageLabel, pageRoute) };

        if (_activeSection == SettingsSection.Libraries)
        {
            // Library & Ingestion > Libraries > Watch > Movies: the frame carries the level, so Libraries is a link once the page is deeper.
            var levels = LibrariesLevel.Crumbs;
            steps.Add(new SettingsBreadcrumb("Libraries", SettingsNav.RouteFor(SettingsSection.Libraries)));
            foreach (var level in levels.Skip(1))
                steps.Add(new SettingsBreadcrumb(level.Label, level.Href));
        }
        else if (IsPluginDetailRoute)
        {
            steps.Add(new SettingsBreadcrumb(_pluginBreadcrumbName ?? "Plugin", null));
        }
        else if (IsIntegrationDetailRoute)
        {
            steps.Add(new SettingsBreadcrumb(_integrationBreadcrumbName ?? "Integration", null));
        }
        else if (IsProfileDetailRoute)
        {
            steps.Add(new SettingsBreadcrumb(_profileBreadcrumbName ?? "Profile", $"/settings/profiles/{ProfileDetailId:D}"));
            if (ProfileTab.Length > 0)
                steps.Add(new SettingsBreadcrumb(ProfileTab == "access" ? "Access & safety" : "Preferences", null));
        }
        else
        {
            var leaf = location?.Tab?.Label ?? location?.Leaf;
            if (leaf is not null && !string.Equals(leaf, pageLabel, StringComparison.Ordinal))
                steps.Add(new SettingsBreadcrumb(leaf, location?.Tab?.Route ?? SettingsNav.RouteFor(_activeSection)));
            if (!string.IsNullOrWhiteSpace(Detail))
                steps.Add(new SettingsBreadcrumb(GetDetailBreadcrumbLabel(), null));
        }

        steps[^1] = steps[^1] with { Href = null };
        breadcrumbs.AddRange(steps);
        return breadcrumbs;
    }

    private string GetDetailBreadcrumbLabel() => _activeSection switch
    {
        SettingsSection.Libraries => "Libraries",
        _ => FormatRouteLabel(Detail!),
    };

    private static string FormatRouteLabel(string value) =>
        System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(value.Replace('-', ' '));

    private string GetHeroEyebrow() => CurrentGroup.Label;

    private string GetHeroTitle()
    {
        if (_activeSection == SettingsSection.Libraries)
            return LibrariesLevel.Title;
        return CurrentLocation?.Page.Label ?? SettingsNav.GetItem(_activeSection).Label;
    }

