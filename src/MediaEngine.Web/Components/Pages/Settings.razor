@page "/settings"
@page "/settings/{Section}"
@page "/settings/{Section}/{Subsection}"
@page "/settings/{Section}/{Subsection}/{Detail}"
@rendermode InteractiveServer
@namespace MediaEngine.Web.Components.Pages
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Navigation
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject DeviceContextService DeviceContext
@inject UIOrchestratorService Orchestrator
@inject DashboardSessionAccessor Session
@inject DashboardIdentityClient Identity
@inject AccountNoticeState Notices
@inject SettingsAttentionState Attention
@inject DevelopmentToolsState DevelopmentTools
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject ILogger<Settings> Logger
@implements IAsyncDisposable

<PageTitle>@BrowserTitle</PageTitle>

@if (_kidsBlocked)
{
    @* A Kids profile never reaches Settings. The move to Home is already under way, so nothing is drawn meanwhile. *@
}
else if (!_profileRoleLoaded)
{
    @* Neutral loading state: the section, navigation and permissions are unknown until the session resolves. *@
    <MediaSectionShell Title="Settings"
                       NavigationGroups="@(Array.Empty<MediaSectionNavigationGroup>())"
                       ShowMobileNavigation="false">
        <div class="settings-shell-content" aria-busy="true" aria-label="Loading settings">
            <div class="settings-loading-skeleton">
                <AppSkeleton Width="40%" Height="28px" />
                <AppSkeleton Width="100%" Height="120px" />
                <AppSkeleton Width="100%" Height="120px" />
            </div>
        </div>
    </MediaSectionShell>
}
else
{
<MediaSectionShell Title="Settings"
                   NavigationGroups="@SettingsNavigationGroups"
                   AccordionNavigation="true"
                   FixedColumnTree="true"
                   ShowMobileNavigation="false">
    <div class="settings-shell-content" @ref="_contentElement">
        <nav class="settings-mobile-navigation" aria-label="Settings page selector">
            <label class="settings-mobile-navigation__label" for="settings-mobile-page">Settings page</label>
            <div class="settings-mobile-navigation__control">
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Tune" aria-hidden="true" />
                <AppNativeSelect @key="MobileNavigationValue"
                                 id="settings-mobile-page"
                                 Value="@MobileNavigationValue"
                                 OnChange="@OnMobilePageChanged"
                                 aria-label="Settings page">
                    @foreach (var group in PhoneMenuGroups)
                    {
                        <optgroup label="@group.Label">
                            @foreach (var option in group.Options)
                            {
                                <option value="@option.Route" selected="@IsMobileNavigationOptionSelected(option.Route)">@PhoneOptionLabel(option)</option>
                            }
                        </optgroup>
                    }
                </AppNativeSelect>
            </div>
        </nav>

        <SettingsPageFrame Breadcrumbs="@Breadcrumbs"
                           Eyebrow="@GetHeroEyebrow()"
                           Title="@GetHeroTitle()"
                           Description="@(IsEditingOtherPlaybackProfile ? null : GetSectionDescription(_activeSection))"
                           Notices="@(ShowAttentionBanner ? AttentionBanner : null)"
                           PageNotice="@PageNoticeFragment">
            <div @key="DeviceContext.DeviceClass" class="@PageCanvasClass">
                <AdministratorSurfaceGate Required="@(_profileRoleLoaded && RequiresAdministratorSurface)">
                @if (ShouldDeferForRoleResolution)
                {
                    <AppPageState Kind="AppPageStateKind.Loading"
                                  Title="Checking profile permissions"
                                  Class="tl-sp-py-8" />
                }
                else if (IsMobileRouteUnavailable)
                {
                    <AppPageState Kind="AppPageStateKind.Unavailable"
                                  Icon="@AppMaterialIcons.Outlined.DesktopWindows"
                                  Title="Use a larger screen for this setting"
                                  Message="@MobileUnavailableMessage">
                        <Actions>
                            <AppButton Href="@MobileFallbackRoute"
                                       Label="Back to mobile settings"
                                       StartIcon="@AppMaterialIcons.Outlined.ArrowBack" />
                        </Actions>
                    </AppPageState>
                }
                else if (IsDevelopmentOnlyPageLoading)
                {
                    <AppPageState Kind="AppPageStateKind.Loading"
                                  Title="Checking what this Engine offers"
                                  Class="tl-sp-py-8" />
                }
                else if (IsDevelopmentOnlyPageUnavailable)
                {
                    <AppPageState Kind="AppPageStateKind.Unavailable"
                                  Icon="@AppMaterialIcons.Outlined.Construction"
                                  Title="Not available in this build"
                                  Message="This page only exists in development builds of the Library." />
                }
                else
                {
                    @if (IsEngineUnavailableForCurrentSection)
                    {
                        <AppAlert Severity="AppSeverity.Error"
                                  Variant="AppVariant.Outlined"
                                  Icon="@AppMaterialIcons.Outlined.CloudOff"
                                  Class="tl-sp-mb-4">
                            Engine state could not be loaded. This page is read-only, and saved values have not been replaced with sample defaults.
                        </AppAlert>
                    }
                    @switch (_activeSection)
                    {
                            case SettingsSection.Overview:
                                @if (_activeSubsection == SettingsNav.AppsSubsection)
                                {
                                    <OverviewAppsPage />
                                }
                                else if (_activeSubsection == SettingsNav.ActivitySubsection)
                                {
                                    <ActivityPage Scope="@ActivityScope" />
                                }
                                else if (_activeSubsection == SettingsNav.TasteSubsection)
                                {
                                    <OverviewTastePage />
                                }
                                else
                                {
                                    <OverviewPage />
                                }
                                break;
                            case SettingsSection.Profiles:
                                @if (IsProfileDetailRoute)
                                {
                                    <ProfileDetailPage ProfileId="@ProfileDetailId" NameChanged="OnProfileNameChanged" />
                                }
                                else if (_activeSubsection == SettingsNav.HouseholdsSubsection)
                                {
                                    <HouseholdsTab />
                                }
                                else
                                {
                                    <ProfilesTab />
                                }
                                break;
                            case SettingsSection.Security:
                                @if (_activeSubsection == "devices")
                                {
                                    <DevicesTab />
                                }
                                else
                                {
                                    <SecuritySettingsPage />
                                }
                                break;
                            case SettingsSection.AdminOverview:
                                @if (_activeSubsection == SettingsNav.LogsSubsection)
                                {
                                    <LogsPage Tab="@LogsTab" Filter="@LogsFilter" />
                                }
                                else
                                {
                                    <SystemSummaryPage />
                                }
                                break;
                            case SettingsSection.Preferences:
                                <PreferencesSummaryPage />
                                break;
                            case SettingsSection.Playback:
                                <PlaybackSettingsPage @key="@PlaybackProfileId"
                                                      ProfileId="@PlaybackProfileId"
                                                      TargetNameChanged="OnPlaybackTargetNameChanged" />
                                break;
                            case SettingsSection.Listening:
                                <ListeningSettingsPage @key="@PlaybackProfileId"
                                                       ProfileId="@PlaybackProfileId"
                                                       TargetNameChanged="OnPlaybackTargetNameChanged" />
                                break;
                            case SettingsSection.Reading:
                                <ReadingSettingsPage @key="@PlaybackProfileId"
                                                     ProfileId="@PlaybackProfileId"
                                                     TargetNameChanged="OnPlaybackTargetNameChanged" />
                                break;
                            case SettingsSection.Libraries:
                                <LibrariesTab Subsection="@_activeSubsection" />
                                break;
                            case SettingsSection.Ingestion:
                                <IngestionTasksTab View="@IngestionView" RunId="@IngestionRunId" ItemId="@IngestionItemId" />
                                break;
                            case SettingsSection.RecentlyAdded:
                                <RecentlyAddedPageContent ReviewState="@ReviewState" InitialSearch="@RecentSearch" />
                                break;
                            case SettingsSection.DevHarness:
                                @RenderInternalTool(
                                    "MediaEngine.Web.Components.Settings.DevHarnessTab",
                                    new Dictionary<string, object?> { ["Subsection"] = _activeSubsection })
                                break;
                            case SettingsSection.Providers:
                                <MetadataSettingsPage Subsection="@_activeSubsection" Detail="@Detail" />
                                break;
                            case SettingsSection.LocalAi:
                                <LocalAiSettingsTab Subsection="@_activeSubsection" />
                                break;
                            case SettingsSection.Plugins:
                                <PluginSettingsTab />
                                break;
                            case SettingsSection.Delivery:
                                <PlaybackDeliverySettingsTab Subsection="@_activeSubsection" />
                                break;
                            case SettingsSection.Tools:
                                <ToolsRequirementsTab />
                                break;
                            case SettingsSection.Network:
                                <NetworkRemoteAccessSettings Subsection="@_activeSubsection" RemoteAccessOffChanged="OnRemoteAccessOffChanged" />
                                break;
                            case SettingsSection.Access:
                                <UsersAccessSettingsTab Subsection="@_activeSubsection" />
                                break;
                            case SettingsSection.Server:
                                <BackupRecoveryPanel />
                                break;
                            case SettingsSection.ProviderTester:
                                @RenderInternalTool("MediaEngine.Web.Components.Settings.ProviderTesterToolTab")
                                break;
                            case SettingsSection.EnrichmentTester:
                                @RenderInternalTool("MediaEngine.Web.Components.Settings.EnrichmentTesterToolTab")
                                break;
                    }
                }
                </AdministratorSurfaceGate>
            </div>
        </SettingsPageFrame>
    </div>
</MediaSectionShell>
}

<CuratorsDrawer Open="@_drawerOpen"
                OpenChanged="@OnDrawerOpenChanged"
                EntityId="@_drawerEntityId"
                CurrentTitle="@_drawerTitle"
                OnCorrected="@OnDrawerCorrected" />

@code {
    [Parameter] public string? Section { get; set; }
    [Parameter] public string? Subsection { get; set; }
    [Parameter] public string? Detail { get; set; }
    private string? _profileBreadcrumbName;
    private void OnProfileNameChanged(string name)
    {
        if (_profileBreadcrumbName != name)
        {
            _profileBreadcrumbName = name;
            StateHasChanged();
        }
    }
    [SupplyParameterFromQuery(Name = "view")] public string? IngestionView { get; set; }
    [SupplyParameterFromQuery(Name = "itemId")] public Guid? IngestionItemId { get; set; }
    [SupplyParameterFromQuery(Name = "runId")] public Guid? IngestionRunId { get; set; }
    [SupplyParameterFromQuery(Name = "review")] public string? ReviewState { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? LogsTab { get; set; }
    [SupplyParameterFromQuery(Name = "filter")] public string? LogsFilter { get; set; }

    /// <summary>Opens the Activity page already narrowed to one person, household or everyone (for example from a person's page).</summary>
    [SupplyParameterFromQuery(Name = "scope")] public string? ActivityScope { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? RecentSearch { get; set; }
    [SupplyParameterFromQuery(Name = "profile")] public Guid? PlaybackProfileId { get; set; }
    private string? _playbackTargetName;
    private void OnPlaybackTargetNameChanged(string? name)
    {
        _playbackTargetName = name;
        StateHasChanged();
    }

    /// <summary>An administrator is editing another household profile's playback settings.</summary>
    private bool IsEditingOtherPlaybackProfile => _activeSection is SettingsSection.Playback or SettingsSection.Listening or SettingsSection.Reading
        && PlaybackProfileId is { } id && id != Guid.Empty && id != _activeProfile?.Id;

    private SettingsSection _activeSection = SettingsSection.Profiles;
    private string _activeSubsection = string.Empty;
    private ProfileViewModel? _activeProfile;
    private bool _profileRoleLoaded;
    private bool _kidsBlocked;

    private bool _legacyRedirectIssued;
    private SystemStatusViewModel? _systemStatus;
    private bool _shellStateLoading = true;
    private bool _developmentToolsLoading = true;

    private bool _drawerOpen;
    private Guid _drawerEntityId;
    private string _drawerTitle = string.Empty;
    private ElementReference _contentElement;
    private bool _scrollToTopPending;
    private bool _wasAdministrationRoute;
    // A this-computer-only account has no password yet: its Security entry carries the attention dot until the person
    // chooses Not now on the Secure your account card (remembered with the account); Security then shows a quiet note instead.
    private bool _thisComputerOnly;
    private bool ShowSecurityAttentionDot => _thisComputerOnly && !Notices.IsDismissed(AccountNoticeKeys.SecureAccount);
    private void OnNoticesChanged() => _ = InvokeAsync(StateHasChanged);
    private Guid? _loadedBreadcrumbBatchId;
    private string? _batchBreadcrumbLabel;
    private int _breadcrumbLoadRevision;
    private SettingsMenuContext MenuContext => new(
        CanManageAdministration,
        CanManageHousehold,
        DeviceContext.IsMobile,
        Attention.ReviewCount,
        ShowSecurityAttentionDot,
        IsSectionOffered,
        Attention.LocalAiBlocked,
        Attention.PluginsBroken);

    // One menu tree: the desktop rail and the phone page selector are both built from it.
    private IReadOnlyList<MediaSectionNavigationGroup> SettingsNavigationGroups => SettingsMenuBuilder.Build(MenuContext);

    private IReadOnlyList<SettingsPhoneMenuGroup> PhoneMenuGroups => SettingsMenuBuilder.BuildPhoneSelector(SettingsNavigationGroups);

    private SettingsMenuLocation? CurrentLocation => SettingsNav.FindMenuLocation(_activeSection, _activeSubsection);

    private SettingsGroupDef CurrentGroup => CurrentLocation is { } location
        ? SettingsNav.AllGroups.First(group => group.Key == location.Group.Key)
        : SettingsNav.GetGroup(_activeSection);
    private IReadOnlyList<SettingsBreadcrumb> Breadcrumbs => BuildBreadcrumbs();
    private bool IsProfileDetailRoute => _activeSection == SettingsSection.Profiles && ProfileDetailId != Guid.Empty;
    private Guid ProfileDetailId => Guid.TryParse(_activeSubsection, out var id) ? id : Guid.Empty;
    private string BrowserTitle => IsProfileDetailRoute
        ? $"{_profileBreadcrumbName ?? "Profile"} - Profiles - Tuvima Library"
        : _activeSection == SettingsSection.Libraries
        ? $"{(_activeSubsection == "view" ? "View" : "Libraries")} - Tuvima Library"
        : CurrentLocation?.Parent is { } parent
        ? $"{GetHeroTitle()} - {parent.Label} - Tuvima Library"
        : $"{GetHeroTitle()} - Tuvima Library";
    private bool ShouldDeferForRoleResolution =>
        SettingsNav.GetItem(_activeSection).AdminOnly
        && !_profileRoleLoaded;
    private bool IsEngineUnavailableForCurrentSection =>
        !_shellStateLoading
        && _systemStatus is null
        && SettingsNav.GetItem(_activeSection).AdminOnly;
    private bool IsMobileRouteUnavailable =>
        DeviceContext.IsMobile
        && !SettingsNav.IsMobileRouteAvailable(_activeSection, _activeSubsection, Detail);
    private string PageCanvasClass => string.Join(" ", new[]
    {
        "settings-page-canvas",
        "settings-admin-panel",
        DeviceContext.IsMobile && SettingsNav.GetMobileAvailability(_activeSection) == SettingsMobileAvailability.SummaryOnly
            ? "settings-mobile-summary"
            : null,
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private string MobileNavigationValue => IsMobileRouteUnavailable
        ? MobileFallbackRoute
        : CurrentLocation?.Node.Route ?? SettingsNav.RouteFor(_activeSection);
    private bool IsMobileNavigationOptionSelected(string route) =>
        string.Equals(route, MobileNavigationValue, StringComparison.OrdinalIgnoreCase);

    // Indents a sub-page under its parent in the native phone selector, which cannot nest rows.
    private static string PhoneOptionLabel(SettingsPhoneMenuOption option) =>
        option.Depth == 0 ? option.Label : new string('\u00A0', option.Depth * 3) + option.Label;
    private string MobileUnavailableMessage => SettingsNav.GetMobileAvailability(_activeSection) == SettingsMobileAvailability.DesktopOnly
        ? $"{GetHeroTitle()} is intentionally withheld from mobile because it contains complex configuration or diagnostic tools. Use a desktop or tablet for this workflow."
        : $"This part of {GetHeroTitle()} contains configuration or diagnostic tools that are safer and easier to use on a desktop or tablet. The mobile overview remains available.";
    private string MobileFallbackRoute => SettingsNav.GetMobileAvailability(_activeSection) == SettingsMobileAvailability.DesktopOnly
        ? SettingsNav.RouteFor(SettingsSection.AdminOverview)
        : SettingsNav.RouteFor(_activeSection);

    // The administrator banner sits above the breadcrumb on every Settings page; it draws nothing for anyone else or on a phone.
    private bool ShowAttentionBanner => Attention.IsServerAdministrator && !DeviceContext.IsMobile;
    private RenderFragment AttentionBanner => @<SettingsAttentionBanner />;

    // Permanent page notices cannot be dismissed. Local AI shows its notice on every sub-page while it is blocked; Network
    // shows its notice while remote access is not set up (reported by the Network page, which already reads that setting).
    // Like the banner, neither is drawn on a phone.
    private RenderFragment LocalAiNotice => @<LocalAiBlockedNotice />;
    private RenderFragment RemoteAccessNotice => @<RemoteAccessOffNotice />;
    private bool _remoteAccessOff;
    private RenderFragment? PageNoticeFragment => DeviceContext.IsMobile ? null : _activeSection switch
    {
        SettingsSection.LocalAi => LocalAiNotice,
        SettingsSection.Network when _remoteAccessOff => RemoteAccessNotice,
        _ => null,
    };

    private void OnRemoteAccessOffChanged(bool off)
    {
        if (_remoteAccessOff != off)
        {
            _remoteAccessOff = off;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (DeviceContext.IsPageDisabled("settings")
            || (DeviceContext.IsPageDisabled("preferences")
                && DeviceContext.IsPageDisabled("server_settings")))
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        await LoadAuthorityAsync();
        ResolveSectionAndNormalize();
        if (_kidsBlocked)
        {
            return;
        }

        var developmentTools = LoadDevelopmentToolsAsync();
        await LoadShellStateAsync();
        await developmentTools;

        Attention.Changed += OnAttentionChanged;
        Notices.Changed += OnNoticesChanged;
        Orchestrator.OnProfileChanged += OnProfileChanged;
        DeviceContext.OnChanged += OnDeviceContextChanged;

        // The frame draws now; the banner and menu shading appear together when the first read has finished.
        _ = Attention.StartAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var leavingAdministration = (_wasAdministrationRoute
            || SettingsNav.GetItem(_activeSection).AdminOnly)
            && !IsAdministrationRoute(Section);
        if (leavingAdministration && Session.ShouldLockOnLeave)
        {
            await ExitAdministrationAsync();
        }
        _wasAdministrationRoute = IsAdministrationRoute(Section);
        ResolveSectionAndNormalize();
        if (!IsProfileDetailRoute)
        {
            _profileBreadcrumbName = null;
        }

        _scrollToTopPending = true;
        await LoadBatchBreadcrumbAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollToTopPending)
        {
            return;
        }

        _scrollToTopPending = false;
        await JS.InvokeVoidAsync("scrollElementToTop", _contentElement);
    }

    public async ValueTask DisposeAsync()
    {
        Notices.Changed -= OnNoticesChanged;
        Attention.Changed -= OnAttentionChanged;
        Attention.Stop();
        Orchestrator.OnProfileChanged -= OnProfileChanged;
        DeviceContext.OnChanged -= OnDeviceContextChanged;
        if (Session.ShouldLockOnLeave)
            await ExitAdministrationAsync();
    }

    private static bool IsAdministrationRoute(string? section)
    {
        var resolution = SettingsNav.ResolveRoute(section, administrationAllowed: true);
        return resolution.IsKnownRoute && SettingsNav.GetItem(resolution.Section).AdminOnly;
    }

    private async Task ExitAdministrationAsync()
    {
        Session.ClearAdministratorActions();
        try
        {
            await Identity.ExitAdministratorAsync();
            await Identity.RevalidateAuthorityAsync(Session);
        }
        catch (Exception)
        {
            // The bounded server unlock lease handles a disconnected Dashboard.
        }
    }

    public void OpenCuratorsDrawer(Guid entityId, string title)
    {
        _drawerEntityId = entityId;
        _drawerTitle = title;
        _drawerOpen = true;
        StateHasChanged();
    }

    private async Task LoadShellStateAsync()
    {
        _shellStateLoading = true;

        try
        {
            _systemStatus = await Orchestrator.GetSystemStatusAsync();
        }
        catch
        {
            _systemStatus = null;
        }

        _shellStateLoading = false;
    }

    // Only a server administrator is shown the Developer group, so only then is the Engine asked what it offers there.
    // It is asked beside the slower system status read, so the menu and the two development pages never wait for it.
    private async Task LoadDevelopmentToolsAsync()
    {
        try
        {
            if (CanManageAdministration)
            {
                await DevelopmentTools.EnsureLoadedAsync();
            }
        }
        finally
        {
            _developmentToolsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadAuthorityAsync()
    {
        try
        {
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            _thisComputerOnly = SecureAccountPrompt.IsThisComputerOnly(principal);
            if (_thisComputerOnly) await Notices.EnsureLoadedAsync();
            Session.InitializeFromPrincipal(principal);
            await Identity.EnsureInitialAuthorityAsync(Session);
            _activeProfile = await Orchestrator.GetActiveProfileAsync();
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Settings authority initialization failed.");
            _activeProfile = null;
        }
        finally
        {
            _profileRoleLoaded = true;
            // The links to Settings are hidden for a Kids profile, but a typed address or old link must not reach it either.
            _kidsBlocked = _activeProfile?.IsRestricted == true;
        }
    }

    private bool CanManageAdministration => Session.HasNavigation("settings.administration");

    // A household administrator who is not the server administrator reaches the administration pages marked for them.
    private bool CanManageHousehold => Session.HasAction("household.manage");

    // Administration pages need the administrator gate, except the page a household administrator reaches without being the server administrator.
    private bool RequiresAdministratorSurface
    {
        get
        {
            var item = SettingsNav.GetItem(_activeSection);
            return item.AdminOnly && !(item.HouseholdAdminAccess && !CanManageAdministration && CanManageHousehold);
        }
    }

    private void ResolveSectionAndNormalize()
    {
        if (_kidsBlocked)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        if (!_legacyRedirectIssued
            && Section is not null
            && (Section.Equals("review", StringComparison.OrdinalIgnoreCase)
                || Section.Equals("activity", StringComparison.OrdinalIgnoreCase)
                || Section.Equals("timeline", StringComparison.OrdinalIgnoreCase)))
        {
            _legacyRedirectIssued = true;
            Nav.NavigateTo(Section.Equals("review", StringComparison.OrdinalIgnoreCase)
                ? "/settings/recently-added?review=expanded"
                : "/settings/recently-added", replace: true);
            return;
        }

        var resolution = SettingsNav.ResolveRoute(Section, CanManageAdministration, CanManageHousehold);
        _activeSection = resolution.Section;

        if (!resolution.IsKnownRoute)
        {
            Nav.NavigateTo("/not-found", replace: true);
            return;
        }

        if (!resolution.RequestedSectionAllowed)
        {
            Nav.NavigateTo(resolution.CanonicalRoute, replace: true);
            return;
        }

        if (_activeSection == SettingsSection.Libraries && Guid.TryParse(Subsection, out _))
        {
            // The per-library settings page is gone; old links land on the single Libraries screen.
            Nav.NavigateTo("/settings/libraries", replace: true);
            return;
        }

        if (_activeSection == SettingsSection.Libraries && IsLibraryRouteSegment(Subsection))
        {
            _activeSubsection = Subsection!.Trim();
        }
        else if (_activeSection == SettingsSection.Profiles && Guid.TryParse(Subsection, out _))
        {
            _activeSubsection = Subsection!.Trim();
        }
        else if (_activeSection == SettingsSection.Providers && string.IsNullOrWhiteSpace(Subsection))
        {
            _activeSubsection = "providers";
        }
        else if (string.IsNullOrWhiteSpace(Subsection))
        {
            _activeSubsection = string.Empty;
        }
        else
        {
            var subsection = SettingsNav.ResolveSubsection(_activeSection, Subsection);
            if (subsection is null)
            {
                Nav.NavigateTo("/not-found", replace: true);
                return;
            }

            _activeSubsection = subsection.Slug;
        }

        if (!IsValidDetailRoute(_activeSection, _activeSubsection, Detail))
        {
            Nav.NavigateTo("/not-found", replace: true);
            return;
        }

        var currentPath = NormalizePath(Nav.ToBaseRelativePath(Nav.Uri));
        var targetRoute = _activeSection == SettingsSection.Libraries && IsLibraryRouteSegment(Subsection)
            ? $"/settings/libraries/{_activeSubsection}"
            : IsProfileDetailRoute
            ? $"/settings/profiles/{_activeSubsection}"
            : _activeSection == SettingsSection.Providers && !string.IsNullOrWhiteSpace(Detail)
            ? $"{SettingsNav.RouteFor(_activeSection, _activeSubsection)}/{Detail!.Trim().ToLowerInvariant()}"
            : string.IsNullOrWhiteSpace(Subsection)
            ? resolution.CanonicalRoute
            : SettingsNav.RouteFor(_activeSection, _activeSubsection);
        var targetPath = NormalizePath(targetRoute);

        if (!string.Equals(currentPath, targetPath, StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo(targetRoute, replace: true);
        }
    }

    private static string NormalizePath(string path)
    {
        var relative = path.Split('?', '#')[0].Trim();
        if (string.IsNullOrWhiteSpace(relative))
        {
            return "/";
        }

        return "/" + relative.Trim('/').TrimEnd('/');
    }

    private static bool IsLibraryRouteSegment(string? value) =>
        string.Equals(value, "view", StringComparison.OrdinalIgnoreCase);

    private static bool IsValidDetailRoute(SettingsSection section, string subsection, string? detail)
    {
        if (string.IsNullOrWhiteSpace(detail)) return true;
        if (section != SettingsSection.Providers) return false;
        return subsection == "providers" && IsProviderRouteKey(detail);
    }

    private static bool IsProviderRouteKey(string value) => value.All(character =>
        char.IsLetterOrDigit(character) || character is '_' or '-');

    private void OnAttentionChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnProfileChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAuthorityAsync();
            await LoadDevelopmentToolsAsync();
            ResolveSectionAndNormalize();
            StateHasChanged();
        });
    }

    private async Task OnDrawerOpenChanged(bool open)
    {
        _drawerOpen = open;
        await Task.CompletedTask;
    }

    private void OnDrawerCorrected()
    {
        _drawerOpen = false;
        StateHasChanged();
    }

    private void OnDeviceContextChanged() => InvokeAsync(StateHasChanged);

    // The Developer group is for server administrators only (the menu's own rule). Beyond that, its two sub-pages exist only
    // when the running Engine is a development build that offers their actions; Provider Tester uses ordinary search
    // actions, so it needs nothing more. A release Engine drops them from the menu and the phone selector, and their
    // addresses show the not-available state.
    private bool IsSectionOffered(SettingsSection section) => section switch
    {
        SettingsSection.EnrichmentTester => DevelopmentTools.EnrichmentTester,
        SettingsSection.DevHarness => DevelopmentTools.DevelopmentData,
        _ => true,
    };

    private bool IsDevelopmentOnlyPage => _activeSection is SettingsSection.EnrichmentTester or SettingsSection.DevHarness;

    private bool IsDevelopmentOnlyPageLoading => IsDevelopmentOnlyPage && _developmentToolsLoading;

    private bool IsDevelopmentOnlyPageUnavailable => IsDevelopmentOnlyPage && !IsSectionOffered(_activeSection);

    private RenderFragment RenderInternalTool(
        string typeName,
        IReadOnlyDictionary<string, object?>? parameters = null) => builder =>
    {
        var componentType = typeof(Settings).Assembly.GetType(typeName, throwOnError: false);
        if (componentType is null)
        {
            builder.OpenComponent<AppText>(0);
            builder.AddAttribute(1, nameof(AppText.Typo), AppTypo.body1);
            builder.AddContent(2, "This internal tool is not included in this build.");
            builder.CloseComponent();
            return;
        }

        builder.OpenComponent(0, componentType);
        if (parameters is not null)
        {
            var sequence = 1;
            foreach (var parameter in parameters)
                builder.AddAttribute(sequence++, parameter.Key, parameter.Value);
        }
        builder.CloseComponent();
    };

    private void OnMobilePageChanged(ChangeEventArgs args)
    {
        var route = args.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(route))
        {
            Nav.NavigateTo(route);
        }
    }

    private IReadOnlyList<SettingsBreadcrumb> BuildBreadcrumbs()
    {
        var breadcrumbs = new List<SettingsBreadcrumb>
        {
            new("Settings", SettingsNav.RouteFor(SettingsSection.Overview)),
        };

        if (IsEditingOtherPlaybackProfile)
        {
            breadcrumbs.Add(new SettingsBreadcrumb("Profiles", SettingsNav.RouteFor(SettingsSection.Profiles)));
            breadcrumbs.Add(new SettingsBreadcrumb(_playbackTargetName ?? "Profile", $"/settings/profiles/{PlaybackProfileId}"));
            breadcrumbs.Add(new SettingsBreadcrumb(_activeSection switch
            {
                SettingsSection.Listening => "Listening",
                SettingsSection.Reading => "Reading",
                _ => "Playback",
            }, null));
            return breadcrumbs;
        }

        breadcrumbs.Add(new SettingsBreadcrumb(
            CurrentGroup.Label,
            SettingsNav.RouteFor(CurrentGroup.DefaultSection)));

        // Group > parent > page, straight from the menu tree.
        var trail = CurrentLocation?.Trail ?? [];
        foreach (var ancestor in trail.Take(Math.Max(trail.Count - 1, 0)))
            breadcrumbs.Add(new SettingsBreadcrumb(ancestor.Label, ancestor.Route));

        var pageLabel = trail.Count > 0 ? trail[^1].Label : GetHeroTitle();
        var pageRoute = trail.Count > 0 ? trail[^1].Route : SettingsNav.RouteFor(_activeSection);

        if (_activeSection == SettingsSection.Libraries)
        {
            var hasView = !string.IsNullOrWhiteSpace(_activeSubsection);
            breadcrumbs.Add(new SettingsBreadcrumb(pageLabel, hasView ? pageRoute : null));
            if (hasView)
                breadcrumbs.Add(new SettingsBreadcrumb(_activeSubsection == "view" ? "View" : "Library", null));
            return breadcrumbs;
        }

        if (IsProfileDetailRoute)
        {
            breadcrumbs.Add(new SettingsBreadcrumb(pageLabel, pageRoute));
            breadcrumbs.Add(new SettingsBreadcrumb(_profileBreadcrumbName ?? "Profile", null));
            return breadcrumbs;
        }

        var hasDetail = !string.IsNullOrWhiteSpace(Detail);
        breadcrumbs.Add(new SettingsBreadcrumb(pageLabel, hasDetail ? pageRoute : null));
        if (hasDetail)
            breadcrumbs.Add(new SettingsBreadcrumb(GetDetailBreadcrumbLabel(), null));

        return breadcrumbs;
    }

    private async Task LoadBatchBreadcrumbAsync()
    {
        if (_activeSection != SettingsSection.Ingestion || IngestionRunId is not { } batchId)
        {
            _loadedBreadcrumbBatchId = null;
            _batchBreadcrumbLabel = null;
            return;
        }

        if (_loadedBreadcrumbBatchId == batchId)
            return;

        var revision = ++_breadcrumbLoadRevision;
        _loadedBreadcrumbBatchId = batchId;
        _batchBreadcrumbLabel = "Selected batch";
        try
        {
            var batch = await Orchestrator.GetActivityBatchAsync(batchId);
            if (revision != _breadcrumbLoadRevision || batch is null)
                return;

            var started = batch.StartedAt.ToLocalTime();
            _batchBreadcrumbLabel = $"{IngestionBatchDisplay.Title(batch)} · {started:MMM d, yyyy, h:mm tt}";
        }
        catch
        {
            // The detail view owns its unavailable state; retain a stable breadcrumb fallback.
        }
    }

    private string GetDetailBreadcrumbLabel() => _activeSection switch
    {
        SettingsSection.Providers => Detail!.ToUpperInvariant(),
        SettingsSection.Libraries => "Libraries",
        _ => FormatRouteLabel(Detail!),
    };

    private static string FormatRouteLabel(string value) =>
        System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(value.Replace('-', ' '));

    private string GetHeroEyebrow() => CurrentGroup.Label;

    private string GetHeroTitle()
    {
        if (_activeSection == SettingsSection.Providers && !string.IsNullOrWhiteSpace(Detail))
            return "Provider Configuration";
        return CurrentLocation?.Node.Label ?? SettingsNav.GetItem(_activeSection).Label;
    }

