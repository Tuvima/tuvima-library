@page "/universe/{Qid}/explore"
@using MediaEngine.Web.Components.Details
@using MediaEngine.Web.Components.Universe
@using MediaEngine.Web.Services.Theming
@using SharedEntityEditorTargetDto = MediaEngine.Contracts.Universe.SharedEntityEditorTargetDto
@using SharedEntityEditorTargetKinds = MediaEngine.Contracts.Universe.SharedEntityEditorTargetKinds
@using SharedEntitySelectorItemDto = MediaEngine.Contracts.Universe.SharedEntitySelectorItemDto
@using SharedEntitySelectorPageDto = MediaEngine.Contracts.Universe.SharedEntitySelectorPageDto
@using MediaEngine.Web.Services.Editing
@inject IAdministratorSurfaceAccessService AdministratorAccess
@inject IAppDialogService Dialogs
@inject DashboardIdentityClient Identity
@inject DashboardSessionAccessor Session
@inject IAppToastService Snackbar
@inject IEngineApiClient ApiClient
@inject IJSRuntime JS
@inject ILogger<ChronicleExplorer> Logger
@inject DeviceContextService DeviceContext
@implements IAsyncDisposable
@inject IStringLocalizer<SharedStrings> L

<PageTitle>@L["ChronicleExplorer_ChronicleExplorer", _graph?.universe.label ?? Qid]</PageTitle>

<AppContainer MaxWidth="AppMaxWidth.False" Class="tl-sp-pa-4">
@* Editing the Universe, or one character, place or organisation in it, uses the same bar, side panel and floating artwork picker as every
   other page (Name, Description and pictures; nothing is saved until Save changes shows Review changes). The graph, appearances and
   relationships stay read-only. Desktop administrators only. *@
<EditingBar Mode="_editing" Flow="_flow" CanDelete="false" GuardInternalNavigation="true" />
@if (_loading)
{
    <AppPanel Class="chronicle-explorer-empty tl-sp-pa-6">
        <AppSpinner Indeterminate="true" Color="AppColor.Primary" />
        <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">@L["ChronicleExplorer_LoadingUniverseGraphData"]</AppText>
    </AppPanel>
}
else if (_graph is null)
{
    <AppPanel Class="chronicle-explorer-empty tl-sp-pa-6">
        <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Hub" Size="AppSize.Large" Color="AppColor.Default" />
        <AppText Typo="AppTypo.h5">@L["ChronicleExplorer_UniverseGraphUnavailable"]</AppText>
        <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">
            @L["ChronicleExplorer_LibraryHasNotFoundEnough"]
        </AppText>
    </AppPanel>
}
else
{
<div class="chronicle-heading">
<AppText Typo="AppTypo.h4" Class="chronicle-explorer-title tl-sp-mb-2">
        @(_graph?.universe.label ?? "Loading...")
    </AppText>
    @if (_canEditUniverse && DeviceContext.CanEdit)
    {
        <AppButton ButtonStyle="AppButtonStyle.Outlined" StartIcon="@AppMaterialIcons.Outlined.Edit" Disabled="@(_openingEditor || _editing.IsOn)" OnClick="@(() => EditUniverseAsync(null))">@L["ChronicleExplorer_EditUniverse"]</AppButton>
    }
</div>

    <EditSavedRibbon Flow="_flow" />
    <EditorPanelHost Mode="_editing" Flow="_flow" Picker="_artworkPicker">
        @if (context == EditTool.Details)
        {
            <EditorDetailsPanel Mode="_editing" Session="_flow.Session" />
        }
    </EditorPanelHost>

    <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="2" Class="tl-sp-mb-3">
        <AppChip T="string" Color="AppColor.Primary" Size="AppSize.Small">
            @(_graph?.nodes.Count ?? 0) entities
        </AppChip>
        <AppChip T="string" Color="AppColor.Secondary" Size="AppSize.Small">
            @(_graph?.edges.Count ?? 0) relationships
        </AppChip>
        @if (_characterCount > 0)
        {
            <AppChip T="string" Size="AppSize.Small" Variant="AppVariant.Outlined">
                @_characterCount characters
            </AppChip>
        }
        @if (_locationCount > 0)
        {
            <AppChip T="string" Size="AppSize.Small" Variant="AppVariant.Outlined">
                @_locationCount locations
            </AppChip>
        }
        @if (_orgCount > 0)
        {
            <AppChip T="string" Size="AppSize.Small" Variant="AppVariant.Outlined">
                @_orgCount organizations
            </AppChip>
        }
    </AppStack>
@if (_loreDeltaChanges > 0)
    {
        <AppAlert Severity="AppSeverity.Warning" Class="tl-sp-mb-3"
                  CloseIconClicked="@(() => _loreDeltaChanges = 0)">
            @L["ChronicleExplorer_NewLoreDiscoveredEntitiesHave", _loreDeltaChanges]
        </AppAlert>
    }
<AppTabs @bind-ActivePanelIndex="_activeMode" Class="chronicle-explorer-tabs tl-sp-mb-3"
             ApplyEffectsToContainer="false"
             SliderColor="AppColor.Warning"
             Rounded="false">
        <AppTabPanel Text="@L["Universe_ModeWeb"].Value" Icon="@AppMaterialIcons.Filled.Collections"
                     ToolTip="Full relationship graph" />
        <AppTabPanel Text="@L["Universe_ModePaths"].Value" Icon="@AppMaterialIcons.Filled.Route"
                     ToolTip="Six Degrees pathfinder" />
        <AppTabPanel Text="@L["Universe_ModeFamily"].Value" Icon="@AppMaterialIcons.Filled.AccountTree"
                     ToolTip="Family tree view" />
        <AppTabPanel Text="@L["Universe_ModeCast"].Value" Icon="@AppMaterialIcons.Filled.People"
                     ToolTip="Character to performer mapping" />
        <AppTabPanel Text="@L["Universe_ModeAdaptations"].Value" Icon="@AppMaterialIcons.Filled.Merge"
                     ToolTip="Adaptation chain" />
        <AppTabPanel Text="@L["Common_Sources"].Value" Icon="@AppMaterialIcons.Filled.FactCheck"
                     ToolTip="Supplemental lore sources" />
    </AppTabs>
@if (_activeMode == 0 || _activeMode == 1 || _activeMode == 2)
    {
@if (!_hasGraphData)
        {
            <AppPanel Class="chronicle-explorer-empty tl-sp-pa-6">
                <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Hub" Size="AppSize.Large" Color="AppColor.Default" />
                <AppText Typo="AppTypo.h5">@L["ChronicleExplorer_UniverseGraphUnavailable"]</AppText>
                <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">
                    @L["ChronicleExplorer_LibraryHasNotFoundEnough"]
                </AppText>
            </AppPanel>
        }
        else
        {
@if (_activeMode == 0)
        {
            <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="3" Class="chronicle-explorer-controls tl-sp-mb-3">
                @if (_hasTemporalData && !DeviceContext.IsTelevision)
                {
                    <div class="chronicle-explorer-timeline">
                        <AppRangeSlider AriaLabel="@L["ChronicleExplorer_TimelineYear"].Value" ShowTicks="false" Value="@_timelineYear" ValueChanged="@(value => OnTimelineYearChanged((int)value))" Min="@_minYear" Max="@_maxYear" />
                        <span>@L["ChronicleExplorer_Timeline", _timelineYear]</span>
                    </div>
                }
                else if (_hasTemporalData && DeviceContext.IsTelevision)
                {
                    <AppChip T="string" Size="AppSize.Small" Variant="AppVariant.Outlined">
                        @L["ChronicleExplorer_TimelineAvailableOnDesktop"]
                    </AppChip>
                }

                <AppStack Row="true" Spacing="1" AlignItems="AppAlignItems.Center">
                    <AppChip T="string" Color="@(_showCharacters ? AppColor.Primary : AppColor.Default)"
                             Variant="@(_showCharacters ? AppVariant.Filled : AppVariant.Outlined)"
                             OnClick="@(() => ToggleTypeFilter("Character"))">
                        @L["Universe_GuideFilterCharacters"]
                    </AppChip>
                    <AppChip T="string" Color="@(_showLocations ? AppColor.Success : AppColor.Default)"
                             Variant="@(_showLocations ? AppVariant.Filled : AppVariant.Outlined)"
                             OnClick="@(() => ToggleTypeFilter("Location"))">
                        @L["Universe_GuideFilterLocations"]
                    </AppChip>
                    <AppChip T="string" Color="@(_showOrganizations ? AppColor.Warning : AppColor.Default)"
                             Variant="@(_showOrganizations ? AppVariant.Filled : AppVariant.Outlined)"
                             OnClick="@(() => ToggleTypeFilter("Organization"))">
                        @L["Universe_GuideFilterOrgs"]
                    </AppChip>
                </AppStack>

                <AppSelect T="string" Value="@_layout" ValueChanged="OnLayoutChanged"
                           Label="@L["Common_Layout"].Value" Variant="AppVariant.Outlined" Margin="AppMargin.Dense"
                           Class="chronicle-explorer-layout">
                    <AppSelectItem T="string" Value="@("cose")">@L["ChronicleExplorer_ForceDirected"]</AppSelectItem>
                    <AppSelectItem T="string" Value="@("concentric")">@L["ChronicleExplorer_Concentric"]</AppSelectItem>
                    <AppSelectItem T="string" Value="@("grid")">@L["ChronicleExplorer_Grid"]</AppSelectItem>
                    <AppSelectItem T="string" Value="@("dagre")">@L["ChronicleExplorer_Hierarchical"]</AppSelectItem>
                </AppSelect>
            </AppStack>
        }
<AppGrid>
            <AppItem xs="12" md="@(_activeMode == 0 ? 7 : 8)">
                <div class="chronicle-explorer-zoom" role="group" aria-label="@L["ChronicleExplorer_GraphViewControls"].Value">
                    <AppIconButton Icon="@AppMaterialIcons.Outlined.Add" Tooltip="@L["Common_ZoomIn"].Value" AriaLabel="@L["Common_ZoomIn"].Value"
                                   OnClick="@(() => InvokeGraphViewAsync("CytoscapeInterop.zoomIn"))" />
                    <AppIconButton Icon="@AppMaterialIcons.Outlined.Remove" Tooltip="@L["Common_ZoomOut"].Value" AriaLabel="@L["Common_ZoomOut"].Value"
                                   OnClick="@(() => InvokeGraphViewAsync("CytoscapeInterop.zoomOut"))" />
                    <AppIconButton Icon="@AppMaterialIcons.Outlined.FitScreen" Tooltip="@L["ChronicleExplorer_FitGraphToView"].Value" AriaLabel="@L["ChronicleExplorer_FitGraphToView"].Value"
                                   OnClick="@(() => InvokeGraphViewAsync("CytoscapeInterop.fit"))" />
                    <AppIconButton Icon="@AppMaterialIcons.Outlined.RestartAlt" Tooltip="@L["ChronicleExplorer_ResetView"].Value" AriaLabel="@L["ChronicleExplorer_ResetView"].Value"
                                   OnClick="@(() => InvokeGraphViewAsync("CytoscapeInterop.resetView"))" />
                </div>
                <div id="cytoscape-container"
                     class="chronicle-explorer-graph">
                </div>
            </AppItem>
            <AppItem xs="12" md="@(_activeMode == 0 ? 5 : 4)">
                <AppPanel Class="chronicle-explorer-panel tl-sp-pa-3">
                    @if (_activeMode == 0)
                    {
                        @* Mode 1: entity list *@
                        <AppTextField T="string" @bind-Value="_entitySearch" Placeholder="@L["ChronicleExplorer_SearchEntities"].Value"
                                      Variant="AppVariant.Outlined"
                                      Adornment="AppAdornment.Start"
                                      AdornmentIcon="@AppMaterialIcons.Filled.Search"
                                      Immediate="true" Class="chronicle-explorer-search tl-sp-mb-3" />
                        @* Keyboard, remote and screen-reader path to every node: each row is a real button. *@
                        <AppList T="UniverseGraphNodeDto" Dense="true" Class="chronicle-node-list" aria-label="@L["ChronicleExplorer_EntitiesInThisUniverse"].Value">
                            @foreach (var entry in NodeListEntries)
                            {
                                var entity = entry.Node;
                                <AppListItem T="UniverseGraphNodeDto" OnClick="@(() => OnEntityClick(entity))">
                                    <span class="chronicle-node-list__row">
                                        <AppMaterialIcon Icon="@GetEntityIcon(entity.type)"
                                                 Color="@GetEntityColor(entity.type)"
                                                 Size="AppSize.Small" />
                                        <span class="chronicle-node-list__text">
                                            <span class="chronicle-node-list__label">@entity.label</span>
                                            <span class="chronicle-node-list__meta">@entity.type · @RelationshipText(entry.RelationshipCount)</span>
                                        </span>
                                    </span>
                                </AppListItem>
                            }
                        </AppList>
                    }
                    else if (_activeMode == 1)
                    {
                        @* Mode 2: PathFinder *@
                        <PathFinderPanel @ref="_pathFinderRef"
                                         UniverseQid="@Qid"
                                         Graph="@_graph"
                                         OnPathRequested="OnPathPairSet" />
                    }
                    else if (_activeMode == 2)
                    {
                        @* Mode 3: Family Tree *@
                        <FamilyTreeView UniverseQid="@Qid" Graph="@_graph" />
                    }
                </AppPanel>
            </AppItem>
        </AppGrid>
        }
    }
    else if (_activeMode == 3)
    {
<AppPanel Class="chronicle-explorer-full-panel tl-sp-pa-4">
            <CastComparison UniverseQid="@Qid" Graph="@_graph" />
        </AppPanel>
    }
    else if (_activeMode == 4)
    {
<AppPanel Class="chronicle-explorer-full-panel tl-sp-pa-4">
            <AdaptationTree UniverseQid="@Qid" />
        </AppPanel>
    }
    else if (_activeMode == 5)
    {
<AppPanel Class="chronicle-explorer-full-panel tl-sp-pa-4">
            <AppStack Spacing="3">
                <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="2">
                    <AppText Typo="AppTypo.h6">@L["ChronicleExplorer_SupplementalLoreSources"]</AppText>
                    <AppSpacer />
                    <AppButton Label="@L["ChronicleExplorer_Discover"].Value"
                               ButtonStyle="AppButtonStyle.Outlined"
                               Tone="AppUiTone.Primary"
                               StartIcon="@AppMaterialIcons.Filled.TravelExplore"
                               Disabled="@_loreActionBusy"
                               OnClick="@DiscoverLoreSourcesAsync" />
                    <AppButton Label="@L["ChronicleExplorer_Enrich"].Value"
                               ButtonStyle="AppButtonStyle.Filled"
                               Tone="AppUiTone.Primary"
                               StartIcon="@AppMaterialIcons.Filled.AutoFixHigh"
                               Disabled="@(_loreActionBusy || !HasApprovedLoreSource)"
                               OnClick="@EnrichLoreSourcesAsync" />
                </AppStack>

                @if (!string.IsNullOrWhiteSpace(_loreMessage))
                {
                    <AppAlert Severity="@_loreMessageSeverity" Class="tl-sp-mb-1"
                              CloseIconClicked="@(() => _loreMessage = string.Empty)">
                        @_loreMessage
                    </AppAlert>
                }

                <AppGrid>
                    <AppItem xs="12" md="5">
                        <AppTextField T="string" @bind-Value="_manualSourceName"
                                      Label="@L["ChronicleExplorer_SourceName"].Value"
                                      Variant="AppVariant.Outlined"
                                      Margin="AppMargin.Dense" />
                    </AppItem>
                    <AppItem xs="12" md="5">
                        <AppTextField T="string" @bind-Value="_manualSourceUrl"
                                      Label="@L["ChronicleExplorer_FandomURL"].Value"
                                      Variant="AppVariant.Outlined"
                                      Margin="AppMargin.Dense" />
                    </AppItem>
                    <AppItem xs="12" md="2" Class="tl-flex tl-items-center">
                        <AppButton Label="@L["Vibes_Add"].Value"
                                   ButtonStyle="AppButtonStyle.Outlined"
                                   Tone="AppUiTone.Primary"
                                   StartIcon="@AppMaterialIcons.Filled.Add"
                                   Disabled="@(_loreActionBusy || string.IsNullOrWhiteSpace(_manualSourceUrl))"
                                   OnClick="@AddManualLoreSourceAsync" />
                    </AppItem>
                </AppGrid>

                @if (_loreSourcesLoading)
                {
                    <AppProgressBar Indeterminate="true" Color="AppColor.Primary" />
                }
                else if (_loreSources.Count == 0)
                {
                    <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">
                        @L["ChronicleExplorer_NoSupplementalLoreSourcesHave"]
                    </AppText>
                }
                else
                {
                    <AppTable Class="chronicle-source-table">
                        <thead>
                        <tr>
                            <th>@L["Common_Source"]</th>
                            <th>@L["Models_Status"]</th>
                            <th>@L["ChronicleExplorer_Confidence"]</th>
                            <th>@L["ChronicleExplorer_LastEnriched"]</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var source in _loreSources)
                        {
                            <tr>
                                <td>
                                    <AppStack Spacing="0">
                                        <AppLink Href="@source.base_url" Target="_blank">@source.source_name</AppLink>
                                        <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">@source.plugin_id</AppText>
                                    </AppStack>
                                </td>
                                <td>
                                    <AppChip T="string" Size="AppSize.Small"
                                             Color="@GetSourceStatusColor(source.status)"
                                             Variant="@GetSourceStatusVariant(source.status)">
                                        @source.status
                                    </AppChip>
                                </td>
                                <td>@source.confidence.ToString("P0")</td>
                                <td>@(source.last_enriched_at?.ToLocalTime().ToString("g") ?? "-")</td>
                                <td>
                                    <AppStack Row="true" AlignItems="AppAlignItems.Center" Justify="AppJustify.FlexEnd" Spacing="1">
                                        @if (!source.status.Equals("Approved", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <AppIconButton Icon="@AppMaterialIcons.Filled.Check"
                                                           Tooltip="@L["ChronicleExplorer_Approve"].Value"
                                                           AriaLabel="@L["ChronicleExplorer_ApproveSource"].Value"
                                                           Tone="AppUiTone.Success"
                                                           Size="AppControlSize.Compact"
                                                           Disabled="@_loreActionBusy"
                                                           OnClick="@(() => ApproveLoreSourceAsync(source.id))" />
                                        }
                                        @if (!source.status.Equals("Rejected", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <AppIconButton Icon="@AppMaterialIcons.Filled.Close"
                                                           Tooltip="@L["ChronicleExplorer_Reject"].Value"
                                                           AriaLabel="@L["ChronicleExplorer_RejectSource"].Value"
                                                           Tone="AppUiTone.Error"
                                                           Size="AppControlSize.Compact"
                                                           Disabled="@_loreActionBusy"
                                                           OnClick="@(() => RejectLoreSourceAsync(source.id))" />
                                        }
                                    </AppStack>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </AppTable>
                }
            </AppStack>
        </AppPanel>
    }
}
</AppContainer>
<AppDrawer @bind-Open="_drawerOpen" Anchor="AppAnchor.End" Width="400px"
           Elevation="2" Variant="@AppDrawerVariant.Temporary">
    @if (_selectedEntity is not null)
    {
        <AppDrawerHeader>
            <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="2">
                <AppMaterialIcon Icon="@GetEntityIcon(_selectedEntity.type)"
                         Color="@GetEntityColor(_selectedEntity.type)" />
                <AppText Typo="AppTypo.h6">@_selectedEntity.label</AppText>
            </AppStack>
        </AppDrawerHeader>
        <div class="tl-sp-pa-4">
            <AppText Typo="AppTypo.body2" Class="tl-sp-mb-3">
                @(_selectedEntity.description ?? "No description available.")
            </AppText>
            <AppText Typo="AppTypo.caption" Class="chronicle-explorer-qid">
                @L["ChronicleExplorer_QID", _selectedEntity.id]
            </AppText>

            @if (_canEditUniverse && !_selectedEntity.supplemental && DeviceContext.CanEdit)
            {
                <AppButton ButtonStyle="AppButtonStyle.Outlined" StartIcon="@AppMaterialIcons.Outlined.Edit" Disabled="@(_openingEditor || _editing.IsOn)" OnClick="@(() => EditUniverseAsync(_selectedEntity))">@L["ChronicleExplorer_Edit", _selectedEntity.label]</AppButton>
            }

            @if (_selectedEntity.works.Any())
            {
                <AppText Typo="AppTypo.subtitle2" Class="tl-sp-mt-4 tl-sp-mb-2">@L["ChronicleExplorer_AppearsIn"]</AppText>
                @foreach (var work in _selectedEntity.works)
                {
                    <AppChip T="string" Size="AppSize.Small" Variant="AppVariant.Outlined">
                        @work.label
                    </AppChip>
                }
            }

            @if (_selectedEntityEdges.Count > 0)
            {
                <AppText Typo="AppTypo.subtitle2" Class="tl-sp-mt-4 tl-sp-mb-2">@L["ChronicleExplorer_Relationships"]</AppText>
                @foreach (var edge in _selectedEntityEdges)
                {
                    <AppText Typo="AppTypo.body2" Class="tl-sp-mb-1">
                        @edge.label
                        @GetNodeLabel(edge.source == _selectedEntity.id ? edge.target : edge.source)
                    </AppText>
                }
            }
        </div>
    }
</AppDrawer>

@code {
    [Parameter] public string Qid { get; set; } = string.Empty;

    private UniverseGraphResponse? _graph;
    private bool _canEditUniverse;
    private bool _openingEditor;
    private SharedEntityEditorTargetDto UniverseTarget => new(SharedEntityEditorTargetKinds.Universe, Qid, null, Qid);

    private readonly CancellationTokenSource _lifetime = new();
    private EditingModeContext _editing = default!;
    private EditSessionFlow _flow = default!;
    private EditPendingPreview _preview = default!;
    private ArtworkPickerSession _artworkPicker = default!;

    // What the editor is open on: the Universe itself (no id), or one character, place or organisation by its id.
    private Guid? _editEntityId;
    private string? _editEntityTitle;
    private string? _editEntityKind;

    protected override void OnInitialized()
    {
        _editing = new EditingModeContext(DeviceContext, new ItemFieldEditSession(ApiClient, DeviceContext, Logger))
        {
            Loader = LoadEditingFieldsAsync,
            AskSaveOrDiscard = () => EditingSaveOrDiscardDialog.AskAsync(Dialogs),
        };
        _editing.Changed += OnEditingChanged;
        var session = new EditSessionState(new PendingEditList());
        _flow = new EditSessionFlow(session, _editing, new EditSessionSaver(ApiClient), EditTrail, () => EditingUnsavedChangesDialog.AskDiscardAsync(Dialogs))
        {
            Saved = RefreshAfterEditSavedAsync,
        };
        _preview = new EditPendingPreview(session, _editing.Fields);
        _artworkPicker = new ArtworkPickerSession(ApiClient, session, _editing.Fields, _preview.Artwork, Logger);
        session.Changed += OnEditingChanged;
        _artworkPicker.Changed += OnEditingChanged;
    }

    private Task LoadEditingFieldsAsync() => _editEntityId is { } id
        ? _editing.Fields.LoadSubjectAsync(id, _lifetime.Token)
        : _editing.Fields.LoadUniverseSubjectAsync(Qid, _lifetime.Token);

    private IReadOnlyList<EditTrailItem> EditTrail() =>
        [new EditTrailItem(_editing.Fields.EntityId, _editEntityTitle ?? _graph?.universe.label ?? "Universe", _editEntityKind ?? "Universe")];

    private void OnEditingChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task EditUniverseAsync(UniverseGraphNodeDto? entity)
    {
        if (_openingEditor || !_canEditUniverse || _editing.IsOn) return;
        // Every edit handler asks the device rule again; a hidden button is never the only protection.
        if (EditorDeviceRule.TryRefuse(DeviceContext, Snackbar)) return;
        _openingEditor = true;
        try
        {
            Guid? entityId = null;
            if (entity is not null)
            {
                SharedEntitySelectorItemDto? selected = null;
                var offset = 0;
                SharedEntitySelectorPageDto? page;
                do
                {
                    page = await ApiClient.GetSharedEntitySelectorPageAsync(Qid, category: null, search: entity.id, offset: offset, limit: 100);
                    selected = page?.items.FirstOrDefault(item => item.qid == entity.id);
                    offset += 100;
                } while (selected is null && page?.has_more == true);
                if (selected is null) { Snackbar.Add(L["ChronicleExplorer_ThisEntityIsNotAvailable"].Value, AppSeverity.Warning); return; }
                entityId = selected.id;
            }
            if (!await AdministratorAccess.EnsureUnlockedAsync(_lifetime.Token)) return;
            _editEntityId = entityId;
            _editEntityTitle = entity?.label;
            _editEntityKind = entity?.type;
            _editing.HasPermission = true;
            if (await _editing.EnterAsync() && _editing.Fields.Loaded)
                await _flow.SelectToolAsync(EditTool.Details);
        }
        catch (OperationCanceledException) { /* the page was left while the unlock prompt was open */ }
        catch (Exception ex) { Logger.LogWarning(ex, "Could not open Universe editor for {UniverseQid}", Qid); Snackbar.Add(L["Common_UniverseEditingIsUnavailablePlease"].Value, AppSeverity.Error); }
        finally { _openingEditor = false; }
    }

    // Save changes went through: show the new names and pictures in the graph and start the next edit from the saved values.
    private async Task RefreshAfterEditSavedAsync()
    {
        try
        {
            var selectedId = _selectedEntity?.id;
            _graph = await ApiClient.GetUniverseGraphAsync(Qid, includeSupplementalLore: true);
            if (selectedId is not null) _selectedEntity = _graph?.nodes.FirstOrDefault(node => node.id == selectedId);
            if (_cytoscapeReady && _graph is not null)
                await JS.InvokeVoidAsync("CytoscapeInterop.updateGraph", System.Text.Json.JsonSerializer.Serialize(_graph.nodes), System.Text.Json.JsonSerializer.Serialize(_graph.edges));
            await LoadEditingFieldsAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The Universe graph could not refresh after an edit for {UniverseQid}", Qid);
            Snackbar.Add(L["ChronicleExplorer_SavedButTheGraphCould"].Value, AppSeverity.Warning);
        }
    }

    private int _loreDeltaChanges;
    private bool _hasTemporalData;
    private int _minYear = 1900;
    private int _maxYear = 2030;
    private int _timelineYear = 2030;
    private string _layout = "cose";
    private string _entitySearch = string.Empty;
    private bool _drawerOpen;
    private UniverseGraphNodeDto? _selectedEntity;
    private List<UniverseGraphEdgeDto> _selectedEntityEdges = [];
    private DotNetObjectReference<ChronicleExplorer>? _dotNetRef;
    private int _characterCount;
    private int _locationCount;
    private int _orgCount;
    private int _activeMode = 0;  // 0=Web, 1=Paths, 2=Family, 3=Cast, 4=Adaptations, 5=Sources
    private int _previousMode = 0;
    private PathFinderPanel? _pathFinderRef;
    private bool _cytoscapeReady;
    private bool _showCharacters = true;
    private bool _showLocations = true;
    private bool _showOrganizations = true;
    private bool _loading = true;
    private bool _hasGraphData;
    private bool _loreSourcesLoading;
    private bool _loreActionBusy;
    private string _manualSourceName = string.Empty;
    private string _manualSourceUrl = string.Empty;
    private string _loreMessage = string.Empty;
    private AppSeverity _loreMessageSeverity = AppSeverity.Info;
    private List<UniverseLoreSourceResponse> _loreSources = [];

    private sealed record NodeListEntry(UniverseGraphNodeDto Node, int RelationshipCount);

    private UniverseGraphResponse? _nodeListSource;
    private IReadOnlyList<NodeListEntry> _nodeListAll = [];

    /// <summary>
    /// Every graph node sorted by label with its relationship count, optionally narrowed by the search box.
    /// The sorted list is rebuilt only when the graph response changes.
    /// </summary>
    private IEnumerable<NodeListEntry> NodeListEntries
    {
        get
        {
            if (!ReferenceEquals(_nodeListSource, _graph))
            {
                _nodeListSource = _graph;
                _nodeListAll = BuildNodeList(_graph);
            }

            return string.IsNullOrWhiteSpace(_entitySearch)
                ? _nodeListAll
                : _nodeListAll.Where(entry => entry.Node.label.Contains(_entitySearch, StringComparison.OrdinalIgnoreCase));
        }
    }

    private static List<NodeListEntry> BuildNodeList(UniverseGraphResponse? graph)
    {
        if (graph is null)
        {
            return [];
        }

        var counts = new Dictionary<string, int>(StringComparer.Ordinal);
        foreach (var edge in graph.edges)
        {
            counts[edge.source] = counts.GetValueOrDefault(edge.source) + 1;
            if (!string.Equals(edge.source, edge.target, StringComparison.Ordinal))
            {
                counts[edge.target] = counts.GetValueOrDefault(edge.target) + 1;
            }
        }

        return graph.nodes
            .OrderBy(node => node.label, StringComparer.OrdinalIgnoreCase)
            .Select(node => new NodeListEntry(node, counts.GetValueOrDefault(node.id)))
            .ToList();
    }

    private static string RelationshipText(int count) =>
        count == 1 ? "1 relationship" : $"{count} relationships";

    private bool HasApprovedLoreSource =>
        _loreSources.Any(source => source.status.Equals("Approved", StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _graph is not null && _hasGraphData)
        {
            await EnsureCytoscapeLoadedAsync();
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("CytoscapeInterop.initGraph",
                "cytoscape-container",
                System.Text.Json.JsonSerializer.Serialize(_graph.nodes),
                System.Text.Json.JsonSerializer.Serialize(_graph.edges),
                _layout,
                _dotNetRef);
        }
        var needsGraph = _activeMode is 0 or 1 or 2;
        var prevNeedsGraph = _previousMode is 0 or 1 or 2;
        if (!firstRender && needsGraph && !prevNeedsGraph && _graph is not null && _hasGraphData)
        {
            _previousMode = _activeMode;
            await EnsureCytoscapeLoadedAsync();
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("CytoscapeInterop.initGraph",
                "cytoscape-container",
                System.Text.Json.JsonSerializer.Serialize(_graph.nodes),
                System.Text.Json.JsonSerializer.Serialize(_graph.edges),
                _layout,
                _dotNetRef);
        }
        else if (!firstRender)
        {
            _previousMode = _activeMode;
        }
    }

    /// <summary>
    /// Cytoscape.js (368 KB) and its Blazor interop bridge are only needed on this route,
    /// so they are lazy-loaded here instead of via a global &lt;script&gt; tag in App.razor.
    /// Idempotent: subsequent calls after the first successful load are no-ops.
    /// </summary>
    private async Task EnsureCytoscapeLoadedAsync()
    {
        if (_cytoscapeReady) return;
        await JS.InvokeVoidAsync("lazyLoad.loadScript", "lib/cytoscape/cytoscape.min.js");
        await JS.InvokeVoidAsync("lazyLoad.loadScript", "js/cytoscape-interop.js");
        _cytoscapeReady = true;
    }

    private string? _loadedQid;

    protected override async Task OnInitializedAsync()
    {
        _loadedQid = Qid;
        await LoadUniverseAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedQid is null || string.Equals(_loadedQid, Qid, StringComparison.Ordinal))
        {
            return;
        }

        // A different Universe in the same circuit starts over: an open edit belongs to the old one, so close it first.
        _loadedQid = Qid;
        _editing.Leave();
        _editEntityId = null;
        _editEntityTitle = null;
        _editEntityKind = null;
        _selectedEntity = null;
        _selectedEntityEdges = [];
        _canEditUniverse = false;
        await LoadUniverseAsync();
        if (_cytoscapeReady && _graph is not null)
        {
            await JS.InvokeVoidAsync("CytoscapeInterop.updateGraph", System.Text.Json.JsonSerializer.Serialize(_graph.nodes), System.Text.Json.JsonSerializer.Serialize(_graph.edges));
        }
    }

    private async Task LoadUniverseAsync()
    {
        _loading = true;
        _graph = await ApiClient.GetUniverseGraphAsync(Qid, includeSupplementalLore: true);
        if ((await Identity.RevalidateAuthorityAsync(Session))?.EffectiveAdministrator == true && _graph is not null)
        {
            var editContext = await ApiClient.GetSharedEntityEditorContextAsync(UniverseTarget);
            _canEditUniverse = editContext?.capabilities.Any(capability => capability.editable) == true;
        }
        if (_graph is not null)
        {
            _hasGraphData = _graph.nodes.Count > 0 && _graph.edges.Count > 0;
            _characterCount = _graph.nodes.Count(n =>
                string.Equals(n.type, "Character", StringComparison.OrdinalIgnoreCase));
            _locationCount = _graph.nodes.Count(n =>
                string.Equals(n.type, "Location", StringComparison.OrdinalIgnoreCase));
            _orgCount = _graph.nodes.Count(n =>
                string.Equals(n.type, "Organization", StringComparison.OrdinalIgnoreCase));
            _hasTemporalData = _graph.edges.Any(e => !string.IsNullOrWhiteSpace(e.start_time));
            if (_hasTemporalData)
            {
                var years = _graph.edges
                    .Where(e => !string.IsNullOrWhiteSpace(e.start_time))
                    .Select(e =>
                    {
                        var span = e.start_time!.AsSpan(0, Math.Min(4, e.start_time!.Length));
                        int.TryParse(span, out var y);
                        return y;
                    })
                    .Where(y => y > 0)
                    .ToList();
                if (years.Count > 0)
                {
                    _minYear = years.Min();
                    _maxYear = Math.Max(years.Max(), DateTime.UtcNow.Year);
                    _timelineYear = _maxYear;
                }
            }
        }
        try
        {
            await LoadLoreSourcesAsync();
            var deltas = await ApiClient.CheckLoreDeltaAsync(Qid);
            _loreDeltaChanges = deltas.Count(d => d.has_changed);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not check lore delta for universe {Qid}.", Qid);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnTimelineYearChanged(int year)
    {
        _timelineYear = year;
        await EnsureCytoscapeLoadedAsync();
        await JS.InvokeVoidAsync("CytoscapeInterop.filterByTimelineYear", year);
    }

    private async Task ToggleTypeFilter(string type)
    {
        switch (type)
        {
            case "Character":    _showCharacters = !_showCharacters; break;
            case "Location":     _showLocations = !_showLocations; break;
            case "Organization": _showOrganizations = !_showOrganizations; break;
        }

        var activeTypes = new List<string>();
        if (_showCharacters) activeTypes.Add("Character");
        if (_showLocations) activeTypes.Add("Location");
        if (_showOrganizations) activeTypes.Add("Organization");

        var types = string.Join(",", activeTypes);
        _graph = await ApiClient.GetUniverseGraphAsync(Qid, types: types, includeSupplementalLore: true);
        if (_graph is not null)
        {
            _hasGraphData = _graph.nodes.Count > 0 && _graph.edges.Count > 0;
            _characterCount = _graph.nodes.Count(n =>
                string.Equals(n.type, "Character", StringComparison.OrdinalIgnoreCase));
            _locationCount = _graph.nodes.Count(n =>
                string.Equals(n.type, "Location", StringComparison.OrdinalIgnoreCase));
            _orgCount = _graph.nodes.Count(n =>
                string.Equals(n.type, "Organization", StringComparison.OrdinalIgnoreCase));

            if (_hasGraphData)
            {
                await EnsureCytoscapeLoadedAsync();
                await JS.InvokeVoidAsync("CytoscapeInterop.updateGraph",
                    System.Text.Json.JsonSerializer.Serialize(_graph.nodes),
                    System.Text.Json.JsonSerializer.Serialize(_graph.edges));
            }
        }
    }

    /// <summary>Zoom in/out, fit and reset buttons: the pinch-free path for remotes, keyboards and screen readers.</summary>
    private async Task InvokeGraphViewAsync(string method)
    {
        await EnsureCytoscapeLoadedAsync();
        await JS.InvokeVoidAsync(method);
    }

    private async Task OnLayoutChanged(string layout)
    {
        _layout = layout;
        await EnsureCytoscapeLoadedAsync();
        await JS.InvokeVoidAsync("CytoscapeInterop.setLayout", layout);
    }

    private async Task OnEntityClick(UniverseGraphNodeDto entity)
    {
        _selectedEntity = entity;
        _selectedEntityEdges = _graph?.edges
            .Where(e => e.source == entity.id || e.target == entity.id)
            .ToList() ?? [];
        _drawerOpen = true;
        await EnsureCytoscapeLoadedAsync();
        await JS.InvokeVoidAsync("CytoscapeInterop.focusNode", entity.id);
    }
    [JSInvokable]
    public void OnNodeClick(string nodeQid)
    {
        var entity = _graph?.nodes.FirstOrDefault(n => n.id == nodeQid);
        if (entity is null) return;

        _selectedEntity = entity;
        _selectedEntityEdges = _graph?.edges
            .Where(e => e.source == entity.id || e.target == entity.id)
            .ToList() ?? [];
        if (_activeMode == 1 && _pathFinderRef is not null)
        {
            _pathFinderRef.SetNode(nodeQid, entity.label);
        }
        else
        {
            _drawerOpen = true;
        }

        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnEdgeClick(string sourceQid, string targetQid, string type)
    {
        OnNodeClick(sourceQid);
    }

    private async Task OnPathPairSet((string From, string To) pair)
    {
        await Task.CompletedTask;
    }

