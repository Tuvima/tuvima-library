@page "/universe/{Qid}/explore"
@using MediaEngine.Web.Components.Universe
@using MediaEngine.Web.Services.Theming
@using SharedEntityEditorTargetDto = MediaEngine.Contracts.Universe.SharedEntityEditorTargetDto
@using SharedEntityEditorTargetKinds = MediaEngine.Contracts.Universe.SharedEntityEditorTargetKinds
@using SharedEntitySelectorItemDto = MediaEngine.Contracts.Universe.SharedEntitySelectorItemDto
@using SharedEntitySelectorPageDto = MediaEngine.Contracts.Universe.SharedEntitySelectorPageDto
@using MediaEngine.Web.Services.Editing
@inject MediaEditorLauncherService MediaEditorLauncher
@inject DashboardIdentityClient Identity
@inject DashboardSessionAccessor Session
@inject IAppToastService Snackbar
@inject IEngineApiClient ApiClient
@inject IJSRuntime JS
@inject ILogger<ChronicleExplorer> Logger
@inject DeviceContextService DeviceContext
@implements IAsyncDisposable

<PageTitle>Chronicle Explorer - @(_graph?.Universe.Label ?? Qid)</PageTitle>

<AppContainer MaxWidth="AppMaxWidth.False" Class="pa-4">
@if (DeviceContext.IsMobile)
{
    <AppPanel Class="chronicle-explorer-empty pa-6" Elevation="0">
        <AppMaterialIcon Icon="@AppMaterialIcons.Filled.AccountTree" Size="AppSize.Large" Color="AppColor.Default" />
        <AppText Typo="AppTypo.h5">Chronicle Explorer is unavailable on mobile</AppText>
        <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">
            The relationship graph needs a larger workspace. Open this Universe from a desktop or tablet-sized web view.
        </AppText>
    </AppPanel>
}
else if (_loading)
{
    <AppPanel Class="chronicle-explorer-empty pa-6" Elevation="0">
        <AppSpinner Indeterminate="true" Color="AppColor.Primary" />
        <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">Loading Universe Graph data...</AppText>
    </AppPanel>
}
else if (_graph is null)
{
    <AppPanel Class="chronicle-explorer-empty pa-6" Elevation="0">
        <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Hub" Size="AppSize.Large" Color="AppColor.Default" />
        <AppText Typo="AppTypo.h5">Universe Graph unavailable</AppText>
        <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">
            Tuvima has not found enough real character, location, organization, event, or relationship data for this Universe yet.
        </AppText>
    </AppPanel>
}
else
{
<div class="chronicle-heading">
<AppText Typo="AppTypo.h4" Class="chronicle-explorer-title mb-2">
        @(_graph?.Universe.Label ?? "Loading...")
    </AppText>
    @if (_canEditUniverse)
    {
        <AppButton ButtonStyle="AppButtonStyle.Outlined" StartIcon="@AppMaterialIcons.Outlined.Edit" Disabled="@_openingEditor" OnClick="@(() => EditUniverseAsync(null))">Edit Universe</AppButton>
    }
</div>
    <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="2" Class="mb-3">
        <AppChip T="string" Color="AppColor.Primary" Size="AppSize.Small">
            @(_graph?.Nodes.Count ?? 0) entities
        </AppChip>
        <AppChip T="string" Color="AppColor.Secondary" Size="AppSize.Small">
            @(_graph?.Edges.Count ?? 0) relationships
        </AppChip>
        @if (_characterCount > 0)
        {
            <AppChip T="string" Size="AppSize.Small" Variant="AppVariant.Outlined">
                @_characterCount characters
            </AppChip>
        }
        @if (_locationCount > 0)
        {
            <AppChip T="string" Size="AppSize.Small" Variant="AppVariant.Outlined">
                @_locationCount locations
            </AppChip>
        }
        @if (_orgCount > 0)
        {
            <AppChip T="string" Size="AppSize.Small" Variant="AppVariant.Outlined">
                @_orgCount organizations
            </AppChip>
        }
    </AppStack>
@if (_loreDeltaChanges > 0)
    {
        <AppAlert Severity="AppSeverity.Warning" Class="mb-3"
                  CloseIconClicked="@(() => _loreDeltaChanges = 0)">
            New Lore Discovered: @_loreDeltaChanges entities have been updated on Wikidata since last enrichment.
        </AppAlert>
    }
<AppTabs @bind-ActivePanelIndex="_activeMode" Class="mb-3"
             ApplyEffectsToContainer="false"
             SliderColor="AppColor.Warning"
             Rounded="false">
        <AppTabPanel Text="Web" Icon="@AppMaterialIcons.Filled.Collections"
                     ToolTip="Full relationship graph" />
        <AppTabPanel Text="Paths" Icon="@AppMaterialIcons.Filled.Route"
                     ToolTip="Six Degrees pathfinder" />
        <AppTabPanel Text="Family" Icon="@AppMaterialIcons.Filled.AccountTree"
                     ToolTip="Family tree view" />
        <AppTabPanel Text="Cast" Icon="@AppMaterialIcons.Filled.People"
                     ToolTip="Character to performer mapping" />
        <AppTabPanel Text="Adaptations" Icon="@AppMaterialIcons.Filled.Merge"
                     ToolTip="Adaptation chain" />
        <AppTabPanel Text="Sources" Icon="@AppMaterialIcons.Filled.FactCheck"
                     ToolTip="Supplemental lore sources" />
    </AppTabs>
@if (_activeMode == 0 || _activeMode == 1 || _activeMode == 2)
    {
@if (!_hasGraphData)
        {
            <AppPanel Class="chronicle-explorer-empty pa-6" Elevation="0">
                <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Hub" Size="AppSize.Large" Color="AppColor.Default" />
                <AppText Typo="AppTypo.h5">Universe Graph unavailable</AppText>
                <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">
                    Tuvima has not found enough real character, location, organization, event, or relationship data for this Universe yet.
                </AppText>
            </AppPanel>
        }
        else
        {
@if (_activeMode == 0)
        {
            <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="3" Class="chronicle-explorer-controls mb-3">
                @if (_hasTemporalData && !DeviceContext.IsTelevision)
                {
                    <div class="chronicle-explorer-timeline">
                        <AppRangeSlider AriaLabel="Timeline year" ShowTicks="false" Value="@_timelineYear" ValueChanged="@(value => OnTimelineYearChanged((int)value))" Min="@_minYear" Max="@_maxYear" />
                        <span>Timeline: @_timelineYear</span>
                    </div>
                }
                else if (_hasTemporalData && DeviceContext.IsTelevision)
                {
                    <AppChip T="string" Size="AppSize.Small" Variant="AppVariant.Outlined">
                        Timeline available on desktop
                    </AppChip>
                }

                <AppStack Row="true" Spacing="1" AlignItems="AppAlignItems.Center">
                    <AppChip T="string" Color="@(_showCharacters ? AppColor.Primary : AppColor.Default)"
                             Variant="@(_showCharacters ? AppVariant.Filled : AppVariant.Outlined)"
                             OnClick="@(() => ToggleTypeFilter("Character"))">
                        Characters
                    </AppChip>
                    <AppChip T="string" Color="@(_showLocations ? AppColor.Success : AppColor.Default)"
                             Variant="@(_showLocations ? AppVariant.Filled : AppVariant.Outlined)"
                             OnClick="@(() => ToggleTypeFilter("Location"))">
                        Locations
                    </AppChip>
                    <AppChip T="string" Color="@(_showOrganizations ? AppColor.Warning : AppColor.Default)"
                             Variant="@(_showOrganizations ? AppVariant.Filled : AppVariant.Outlined)"
                             OnClick="@(() => ToggleTypeFilter("Organization"))">
                        Organizations
                    </AppChip>
                </AppStack>

                <AppSelect T="string" Value="@_layout" ValueChanged="OnLayoutChanged"
                           Label="Layout" Variant="AppVariant.Outlined" Margin="AppMargin.Dense"
                           Class="chronicle-explorer-layout">
                    <AppSelectItem T="string" Value="@("cose")">Force-directed</AppSelectItem>
                    <AppSelectItem T="string" Value="@("concentric")">Concentric</AppSelectItem>
                    <AppSelectItem T="string" Value="@("grid")">Grid</AppSelectItem>
                    <AppSelectItem T="string" Value="@("dagre")">Hierarchical</AppSelectItem>
                </AppSelect>
            </AppStack>
        }
<AppGrid>
            <AppItem xs="12" md="@(_activeMode == 0 ? 7 : 8)">
                <div id="cytoscape-container"
                     class="chronicle-explorer-graph">
                </div>
            </AppItem>
            <AppItem xs="12" md="@(_activeMode == 0 ? 5 : 4)">
                <AppPanel Class="chronicle-explorer-panel pa-3">
                    @if (_activeMode == 0)
                    {
                        @* Mode 1: entity list *@
                        <AppTextField T="string" @bind-Value="_entitySearch" Placeholder="Search entities..."
                                      Variant="AppVariant.Outlined"
                                      Adornment="AppAdornment.Start"
                                      AdornmentIcon="@AppMaterialIcons.Filled.Search"
                                      Immediate="true" Class="mb-3" />
                        <AppList T="GraphNodeDto" Dense="true">
                            @foreach (var entity in FilteredEntities)
                            {
                                <AppListItem T="GraphNodeDto" OnClick="@(() => OnEntityClick(entity))">
                                    <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="2">
                                        <AppMaterialIcon Icon="@GetEntityIcon(entity.Type)"
                                                 Color="@GetEntityColor(entity.Type)"
                                                 Size="AppSize.Small" />
                                        <AppText>@entity.Label</AppText>
                                        <AppSpacer />
                                        <AppText Typo="AppTypo.caption" Class="chronicle-explorer-entity-type">
                                            @entity.Type
                                        </AppText>
                                    </AppStack>
                                </AppListItem>
                            }
                        </AppList>
                    }
                    else if (_activeMode == 1)
                    {
                        @* Mode 2: PathFinder *@
                        <PathFinderPanel @ref="_pathFinderRef"
                                         UniverseQid="@Qid"
                                         Graph="@_graph"
                                         OnPathRequested="OnPathPairSet" />
                    }
                    else if (_activeMode == 2)
                    {
                        @* Mode 3: Family Tree *@
                        <FamilyTreeView UniverseQid="@Qid" Graph="@_graph" />
                    }
                </AppPanel>
            </AppItem>
        </AppGrid>
        }
    }
    else if (_activeMode == 3)
    {
<AppPanel Class="chronicle-explorer-full-panel pa-4">
            <CastComparison UniverseQid="@Qid" />
        </AppPanel>
    }
    else if (_activeMode == 4)
    {
<AppPanel Class="chronicle-explorer-full-panel pa-4">
            <AdaptationTree UniverseQid="@Qid" />
        </AppPanel>
    }
    else if (_activeMode == 5)
    {
<AppPanel Class="chronicle-explorer-full-panel pa-4">
            <AppStack Spacing="3">
                <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="2">
                    <AppText Typo="AppTypo.h6">Supplemental lore sources</AppText>
                    <AppSpacer />
                    <AppButton Label="Discover"
                               ButtonStyle="AppButtonStyle.Outlined"
                               Tone="AppUiTone.Primary"
                               StartIcon="@AppMaterialIcons.Filled.TravelExplore"
                               Disabled="@_loreActionBusy"
                               OnClick="@DiscoverLoreSourcesAsync" />
                    <AppButton Label="Enrich"
                               ButtonStyle="AppButtonStyle.Filled"
                               Tone="AppUiTone.Primary"
                               StartIcon="@AppMaterialIcons.Filled.AutoFixHigh"
                               Disabled="@(_loreActionBusy || !HasApprovedLoreSource)"
                               OnClick="@EnrichLoreSourcesAsync" />
                </AppStack>

                @if (!string.IsNullOrWhiteSpace(_loreMessage))
                {
                    <AppAlert Severity="@_loreMessageSeverity" Class="mb-1"
                              CloseIconClicked="@(() => _loreMessage = string.Empty)">
                        @_loreMessage
                    </AppAlert>
                }

                <AppGrid>
                    <AppItem xs="12" md="5">
                        <AppTextField T="string" @bind-Value="_manualSourceName"
                                      Label="Source name"
                                      Variant="AppVariant.Outlined"
                                      Margin="AppMargin.Dense" />
                    </AppItem>
                    <AppItem xs="12" md="5">
                        <AppTextField T="string" @bind-Value="_manualSourceUrl"
                                      Label="Fandom URL"
                                      Variant="AppVariant.Outlined"
                                      Margin="AppMargin.Dense" />
                    </AppItem>
                    <AppItem xs="12" md="2" Class="d-flex align-center">
                        <AppButton Label="Add"
                                   ButtonStyle="AppButtonStyle.Outlined"
                                   Tone="AppUiTone.Primary"
                                   StartIcon="@AppMaterialIcons.Filled.Add"
                                   Disabled="@(_loreActionBusy || string.IsNullOrWhiteSpace(_manualSourceUrl))"
                                   OnClick="@AddManualLoreSourceAsync" />
                    </AppItem>
                </AppGrid>

                @if (_loreSourcesLoading)
                {
                    <AppProgressBar Indeterminate="true" Color="AppColor.Primary" />
                }
                else if (_loreSources.Count == 0)
                {
                    <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">
                        No supplemental lore sources have been found or added for this Universe.
                    </AppText>
                }
                else
                {
                    <AppTable Class="chronicle-source-table">
                        <thead>
                        <tr>
                            <th>Source</th>
                            <th>Status</th>
                            <th>Confidence</th>
                            <th>Last enriched</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var source in _loreSources)
                        {
                            <tr>
                                <td>
                                    <AppStack Spacing="0">
                                        <AppLink Href="@source.BaseUrl" Target="_blank">@source.SourceName</AppLink>
                                        <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">@source.PluginId</AppText>
                                    </AppStack>
                                </td>
                                <td>
                                    <AppChip T="string" Size="AppSize.Small"
                                             Color="@GetSourceStatusColor(source.Status)"
                                             Variant="@GetSourceStatusVariant(source.Status)">
                                        @source.Status
                                    </AppChip>
                                </td>
                                <td>@source.Confidence.ToString("P0")</td>
                                <td>@(source.LastEnrichedAt?.ToLocalTime().ToString("g") ?? "-")</td>
                                <td>
                                    <AppStack Row="true" AlignItems="AppAlignItems.Center" Justify="AppJustify.FlexEnd" Spacing="1">
                                        @if (!source.Status.Equals("Approved", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <AppIconButton Icon="@AppMaterialIcons.Filled.Check"
                                                           Tooltip="Approve"
                                                           AriaLabel="Approve source"
                                                           Tone="AppUiTone.Success"
                                                           Size="AppControlSize.Compact"
                                                           Disabled="@_loreActionBusy"
                                                           OnClick="@(() => ApproveLoreSourceAsync(source.Id))" />
                                        }
                                        @if (!source.Status.Equals("Rejected", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <AppIconButton Icon="@AppMaterialIcons.Filled.Close"
                                                           Tooltip="Reject"
                                                           AriaLabel="Reject source"
                                                           Tone="AppUiTone.Error"
                                                           Size="AppControlSize.Compact"
                                                           Disabled="@_loreActionBusy"
                                                           OnClick="@(() => RejectLoreSourceAsync(source.Id))" />
                                        }
                                    </AppStack>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </AppTable>
                }
            </AppStack>
        </AppPanel>
    }
}
</AppContainer>
<AppDrawer @bind-Open="_drawerOpen" Anchor="AppAnchor.End" Width="400px"
           Elevation="2" Variant="@AppDrawerVariant.Temporary">
    @if (_selectedEntity is not null)
    {
        <AppDrawerHeader>
            <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="2">
                <AppMaterialIcon Icon="@GetEntityIcon(_selectedEntity.Type)"
                         Color="@GetEntityColor(_selectedEntity.Type)" />
                <AppText Typo="AppTypo.h6">@_selectedEntity.Label</AppText>
            </AppStack>
        </AppDrawerHeader>
        <div class="pa-4">
            <AppText Typo="AppTypo.body2" Class="mb-3">
                @(_selectedEntity.Description ?? "No description available.")
            </AppText>
            <AppText Typo="AppTypo.caption" Class="chronicle-explorer-qid">
                QID: @_selectedEntity.Id
            </AppText>

            @if (_canEditUniverse && !_selectedEntity.Supplemental)
            {
                <AppButton ButtonStyle="AppButtonStyle.Outlined" StartIcon="@AppMaterialIcons.Outlined.Edit" Disabled="@_openingEditor" OnClick="@(() => EditUniverseAsync(_selectedEntity))">Edit @_selectedEntity.Label</AppButton>
            }

            @if (_selectedEntity.Works?.Count > 0)
            {
                <AppText Typo="AppTypo.subtitle2" Class="mt-4 mb-2">Appears in</AppText>
                @foreach (var work in _selectedEntity.Works)
                {
                    <AppChip T="string" Size="AppSize.Small" Variant="AppVariant.Outlined">
                        @work.Label
                    </AppChip>
                }
            }

            @if (_selectedEntityEdges.Count > 0)
            {
                <AppText Typo="AppTypo.subtitle2" Class="mt-4 mb-2">Relationships</AppText>
                @foreach (var edge in _selectedEntityEdges)
                {
                    <AppText Typo="AppTypo.body2" Class="mb-1">
                        @edge.Label
                        @GetNodeLabel(edge.Source == _selectedEntity.Id ? edge.Target : edge.Source)
                    </AppText>
                }
            }
        </div>
    }
</AppDrawer>

@code {
    [Parameter] public string Qid { get; set; } = string.Empty;

    private UniverseGraphResponse? _graph;
    private bool _canEditUniverse;
    private bool _openingEditor;
    private SharedEntityEditorTargetDto UniverseTarget => new(SharedEntityEditorTargetKinds.Universe, Qid, null, Qid);

    private async Task EditUniverseAsync(GraphNodeDto? entity)
    {
        if (_openingEditor || !_canEditUniverse) return;
        _openingEditor = true;
        try
        {
            var target = UniverseTarget;
            if (entity is not null)
            {
                SharedEntitySelectorItemDto? selected = null;
                var offset = 0;
                SharedEntitySelectorPageDto? page;
                do
                {
                    page = await ApiClient.GetSharedEntitySelectorPageAsync(Qid, category: null, search: entity.Id, offset: offset, limit: 100);
                    selected = page?.items.FirstOrDefault(item => item.qid == entity.Id);
                    offset += 100;
                } while (selected is null && page?.has_more == true);
                if (selected is null) { Snackbar.Add("This entity is not available for editing.", AppSeverity.Warning); return; }
                target = new(SharedEntityEditorTargetKinds.FictionalEntity, Qid, selected.id, selected.qid);
            }
            if (await MediaEditorLauncher.OpenAsync(new MediaEditorLaunchRequest
                { SharedEntityTarget = target, HeaderTitle = _graph?.Universe.Label, Mode = SharedMediaEditorMode.Normal }))
            {
                _graph = await ApiClient.GetUniverseGraphAsync(Qid, includeSupplementalLore: true);
                if (entity is not null) _selectedEntity = _graph?.Nodes.FirstOrDefault(node => node.Id == entity.Id);
                if (_cytoscapeReady && _graph is not null)
                    await JS.InvokeVoidAsync("CytoscapeInterop.updateGraph", System.Text.Json.JsonSerializer.Serialize(_graph.Nodes), System.Text.Json.JsonSerializer.Serialize(_graph.Edges));
            }
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Could not open Universe editor for {UniverseQid}", Qid); Snackbar.Add("Universe editing is unavailable. Please try again.", AppSeverity.Error); }
        finally { _openingEditor = false; }
    }

    private int _loreDeltaChanges;
    private bool _hasTemporalData;
    private int _minYear = 1900;
    private int _maxYear = 2030;
    private int _timelineYear = 2030;
    private string _layout = "cose";
    private string _entitySearch = string.Empty;
    private bool _drawerOpen;
    private GraphNodeDto? _selectedEntity;
    private List<GraphEdgeDto> _selectedEntityEdges = [];
    private DotNetObjectReference<ChronicleExplorer>? _dotNetRef;
    private int _characterCount;
    private int _locationCount;
    private int _orgCount;
    private int _activeMode = 0;  // 0=Web, 1=Paths, 2=Family, 3=Cast, 4=Adaptations, 5=Sources
    private int _previousMode = 0;
    private PathFinderPanel? _pathFinderRef;
    private bool _cytoscapeReady;
    private bool _showCharacters = true;
    private bool _showLocations = true;
    private bool _showOrganizations = true;
    private bool _loading = true;
    private bool _hasGraphData;
    private bool _loreSourcesLoading;
    private bool _loreActionBusy;
    private string _manualSourceName = string.Empty;
    private string _manualSourceUrl = string.Empty;
    private string _loreMessage = string.Empty;
    private AppSeverity _loreMessageSeverity = AppSeverity.Info;
    private List<UniverseLoreSourceViewModel> _loreSources = [];

    private IEnumerable<GraphNodeDto> FilteredEntities =>
        _graph?.Nodes.Where(n =>
            string.IsNullOrWhiteSpace(_entitySearch) ||
            n.Label.Contains(_entitySearch, StringComparison.OrdinalIgnoreCase)) ?? [];

    private bool HasApprovedLoreSource =>
        _loreSources.Any(source => source.Status.Equals("Approved", StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _graph is not null && _hasGraphData && !DeviceContext.IsMobile)
        {
            await EnsureCytoscapeLoadedAsync();
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("CytoscapeInterop.initGraph",
                "cytoscape-container",
                System.Text.Json.JsonSerializer.Serialize(_graph.Nodes),
                System.Text.Json.JsonSerializer.Serialize(_graph.Edges),
                _layout,
                _dotNetRef);
        }
        var needsGraph = _activeMode is 0 or 1 or 2;
        var prevNeedsGraph = _previousMode is 0 or 1 or 2;
        if (!firstRender && needsGraph && !prevNeedsGraph && _graph is not null && _hasGraphData && !DeviceContext.IsMobile)
        {
            _previousMode = _activeMode;
            await EnsureCytoscapeLoadedAsync();
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("CytoscapeInterop.initGraph",
                "cytoscape-container",
                System.Text.Json.JsonSerializer.Serialize(_graph.Nodes),
                System.Text.Json.JsonSerializer.Serialize(_graph.Edges),
                _layout,
                _dotNetRef);
        }
        else if (!firstRender)
        {
            _previousMode = _activeMode;
        }
    }

    /// <summary>
    /// Cytoscape.js (368 KB) and its Blazor interop bridge are only needed on this route,
    /// so they are lazy-loaded here instead of via a global &lt;script&gt; tag in App.razor.
    /// Idempotent: subsequent calls after the first successful load are no-ops.
    /// </summary>
    private async Task EnsureCytoscapeLoadedAsync()
    {
        if (_cytoscapeReady) return;
        await JS.InvokeVoidAsync("lazyLoad.loadScript", "lib/cytoscape/cytoscape.min.js");
        await JS.InvokeVoidAsync("lazyLoad.loadScript", "js/cytoscape-interop.js");
        _cytoscapeReady = true;
    }

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _graph = await ApiClient.GetUniverseGraphAsync(Qid, includeSupplementalLore: true);
        if ((await Identity.RevalidateAuthorityAsync(Session))?.EffectiveAdministrator == true && _graph is not null)
        {
            var editContext = await ApiClient.GetSharedEntityEditorContextAsync(UniverseTarget);
            _canEditUniverse = editContext?.capabilities.Any(capability => capability.editable) == true;
        }
        if (_graph is not null)
        {
            _hasGraphData = _graph.Nodes.Count > 0 && _graph.Edges.Count > 0;
            _characterCount = _graph.Nodes.Count(n =>
                string.Equals(n.Type, "Character", StringComparison.OrdinalIgnoreCase));
            _locationCount = _graph.Nodes.Count(n =>
                string.Equals(n.Type, "Location", StringComparison.OrdinalIgnoreCase));
            _orgCount = _graph.Nodes.Count(n =>
                string.Equals(n.Type, "Organization", StringComparison.OrdinalIgnoreCase));
            _hasTemporalData = _graph.Edges.Any(e => !string.IsNullOrWhiteSpace(e.StartTime));
            if (_hasTemporalData)
            {
                var years = _graph.Edges
                    .Where(e => !string.IsNullOrWhiteSpace(e.StartTime))
                    .Select(e =>
                    {
                        var span = e.StartTime!.AsSpan(0, Math.Min(4, e.StartTime!.Length));
                        int.TryParse(span, out var y);
                        return y;
                    })
                    .Where(y => y > 0)
                    .ToList();
                if (years.Count > 0)
                {
                    _minYear = years.Min();
                    _maxYear = Math.Max(years.Max(), DateTime.UtcNow.Year);
                    _timelineYear = _maxYear;
                }
            }
        }
        try
        {
            await LoadLoreSourcesAsync();
            var deltas = await ApiClient.CheckLoreDeltaAsync(Qid);
            _loreDeltaChanges = deltas.Count(d => d.HasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not check lore delta for universe {Qid}.", Qid);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnTimelineYearChanged(int year)
    {
        _timelineYear = year;
        await EnsureCytoscapeLoadedAsync();
        await JS.InvokeVoidAsync("CytoscapeInterop.filterByTimelineYear", year);
    }

    private async Task ToggleTypeFilter(string type)
    {
        switch (type)
        {
            case "Character":    _showCharacters = !_showCharacters; break;
            case "Location":     _showLocations = !_showLocations; break;
            case "Organization": _showOrganizations = !_showOrganizations; break;
        }

        var activeTypes = new List<string>();
        if (_showCharacters) activeTypes.Add("Character");
        if (_showLocations) activeTypes.Add("Location");
        if (_showOrganizations) activeTypes.Add("Organization");

        var types = string.Join(",", activeTypes);
        _graph = await ApiClient.GetUniverseGraphAsync(Qid, types: types, includeSupplementalLore: true);
        if (_graph is not null)
        {
            _hasGraphData = _graph.Nodes.Count > 0 && _graph.Edges.Count > 0;
            _characterCount = _graph.Nodes.Count(n =>
                string.Equals(n.Type, "Character", StringComparison.OrdinalIgnoreCase));
            _locationCount = _graph.Nodes.Count(n =>
                string.Equals(n.Type, "Location", StringComparison.OrdinalIgnoreCase));
            _orgCount = _graph.Nodes.Count(n =>
                string.Equals(n.Type, "Organization", StringComparison.OrdinalIgnoreCase));

            if (_hasGraphData)
            {
                await EnsureCytoscapeLoadedAsync();
                await JS.InvokeVoidAsync("CytoscapeInterop.updateGraph",
                    System.Text.Json.JsonSerializer.Serialize(_graph.Nodes),
                    System.Text.Json.JsonSerializer.Serialize(_graph.Edges));
            }
        }
    }

    private async Task OnLayoutChanged(string layout)
    {
        _layout = layout;
        await EnsureCytoscapeLoadedAsync();
        await JS.InvokeVoidAsync("CytoscapeInterop.setLayout", layout);
    }

    private async Task OnEntityClick(GraphNodeDto entity)
    {
        _selectedEntity = entity;
        _selectedEntityEdges = _graph?.Edges
            .Where(e => e.Source == entity.Id || e.Target == entity.Id)
            .ToList() ?? [];
        _drawerOpen = true;
        await EnsureCytoscapeLoadedAsync();
        await JS.InvokeVoidAsync("CytoscapeInterop.focusNode", entity.Id);
    }
    [JSInvokable]
    public void OnNodeClick(string nodeQid)
    {
        var entity = _graph?.Nodes.FirstOrDefault(n => n.Id == nodeQid);
        if (entity is null) return;

        _selectedEntity = entity;
        _selectedEntityEdges = _graph?.Edges
            .Where(e => e.Source == entity.Id || e.Target == entity.Id)
            .ToList() ?? [];
        if (_activeMode == 1 && _pathFinderRef is not null)
        {
            _pathFinderRef.SetNode(nodeQid, entity.Label);
        }
        else
        {
            _drawerOpen = true;
        }

        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnEdgeClick(string sourceQid, string targetQid, string type)
    {
        OnNodeClick(sourceQid);
    }

    private async Task OnPathPairSet((string From, string To) pair)
    {
        await Task.CompletedTask;
    }

    private string GetNodeLabel(string qid) =>
        _graph?.Nodes.FirstOrDefault(n => n.Id == qid)?.Label ?? qid;

    private static string GetEntityIcon(string type) => type switch
    {
        "Character"    => AppMaterialIcons.Filled.Person,
        "Location"     => AppMaterialIcons.Filled.Place,
        "Organization" => AppMaterialIcons.Filled.Business,
        _              => AppMaterialIcons.Filled.Category,
    };

    private static AppColor GetEntityColor(string type) => type switch
    {
        "Character"    => AppColor.Primary,
        "Location"     => AppColor.Success,
        "Organization" => AppColor.Warning,
        _              => AppColor.Default,
    };

    private async Task LoadLoreSourcesAsync()
    {
        _loreSourcesLoading = true;
        try
        {
            _loreSources = (await ApiClient.GetUniverseLoreSourcesAsync(Qid)).ToList();
        }
        finally
        {
            _loreSourcesLoading = false;
        }
    }

    private async Task DiscoverLoreSourcesAsync()
    {
        _loreActionBusy = true;
        try
        {
            _loreSources = (await ApiClient.DiscoverUniverseLoreSourcesAsync(Qid)).ToList();
            SetLoreMessage("Source discovery completed.", AppSeverity.Success);
        }
        finally
        {
            _loreActionBusy = false;
        }
    }

    private async Task AddManualLoreSourceAsync()
    {
        _loreActionBusy = true;
        try
        {
            var added = await ApiClient.AddUniverseLoreSourceAsync(
                Qid,
                new UniverseLoreManualSourceRequest
                {
                    SourceName = _manualSourceName,
                    BaseUrl = _manualSourceUrl,
                });
            if (added is null)
            {
                SetLoreMessage("The source could not be added.", AppSeverity.Error);
                return;
            }

            _manualSourceName = string.Empty;
            _manualSourceUrl = string.Empty;
            await LoadLoreSourcesAsync();
            SetLoreMessage("Source added for approval.", AppSeverity.Success);
        }
        finally
        {
            _loreActionBusy = false;
        }
    }

    private async Task ApproveLoreSourceAsync(Guid sourceId)
    {
        _loreActionBusy = true;
        try
        {
            _loreSources = (await ApiClient.ApproveUniverseLoreSourceAsync(Qid, sourceId)).ToList();
            SetLoreMessage("Source approved.", AppSeverity.Success);
        }
        finally
        {
            _loreActionBusy = false;
        }
    }

    private async Task RejectLoreSourceAsync(Guid sourceId)
    {
        _loreActionBusy = true;
        try
        {
            _loreSources = (await ApiClient.RejectUniverseLoreSourceAsync(Qid, sourceId)).ToList();
            SetLoreMessage("Source rejected.", AppSeverity.Info);
        }
        finally
        {
            _loreActionBusy = false;
        }
    }

    private async Task EnrichLoreSourcesAsync()
    {
        _loreActionBusy = true;
        try
        {
            var summary = await ApiClient.EnrichUniverseLoreAsync(Qid);
            if (summary is null)
            {
                SetLoreMessage("Lore enrichment did not complete.", AppSeverity.Error);
                return;
            }

            await LoadLoreSourcesAsync();
            _graph = await ApiClient.GetUniverseGraphAsync(Qid, includeSupplementalLore: true);
            if (_graph is not null)
            {
                _hasGraphData = _graph.Nodes.Count > 0 && _graph.Edges.Count > 0;
                _characterCount = _graph.Nodes.Count(n =>
                    string.Equals(n.Type, "Character", StringComparison.OrdinalIgnoreCase));
                _locationCount = _graph.Nodes.Count(n =>
                    string.Equals(n.Type, "Location", StringComparison.OrdinalIgnoreCase));
                _orgCount = _graph.Nodes.Count(n =>
                    string.Equals(n.Type, "Organization", StringComparison.OrdinalIgnoreCase));
            }

            SetLoreMessage(
                $"Enriched {summary.EntitiesWritten} entities from {summary.SourcesEnriched} source(s).",
                AppSeverity.Success);
        }
        finally
        {
            _loreActionBusy = false;
        }
    }

    private void SetLoreMessage(string message, AppSeverity severity)
    {
        _loreMessage = message;
        _loreMessageSeverity = severity;
    }

    private static AppColor GetSourceStatusColor(string status) => status switch
    {
        "Approved" => AppColor.Success,
        "Rejected" => AppColor.Error,
        _ => AppColor.Warning,
    };

    private static AppVariant GetSourceStatusVariant(string status) => status switch
    {
        "Approved" => AppVariant.Filled,
        _ => AppVariant.Outlined,
    };

    public async ValueTask DisposeAsync()
    {
        if (_cytoscapeReady)
        {
            try
            {
                await JS.InvokeVoidAsync("CytoscapeInterop.destroy");
            }
            catch (JSDisconnectedException)
            {
            }
        }
        _dotNetRef?.Dispose();
    }
}
