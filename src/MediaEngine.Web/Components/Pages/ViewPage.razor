@page "/view"
@using MediaEngine.Contracts.LocalAssets
@using MediaEngine.Domain.PersonalMedia
@inject IEngineApiClient ApiClient
@inject UIOrchestratorService Orchestrator
@inject IAppToastService Snackbar
@inject ViewWorkspaceService Workspace
@inject ViewAssetDragService AssetDrag
@inject ViewMediaGrantService MediaGrants
@inject IJSRuntime JS
@inject IAppDialogService DialogService
@implements IDisposable
@implements IAsyncDisposable
@namespace MediaEngine.Web.Components.Pages

<PageTitle>Photos - Tuvima Library</PageTitle>
<ViewSectionShell @ref="_viewSectionShell">
<ViewContentPage Title="Photos"
                 Subtitle="@ScopeDescription"
                 Class="@($"view-page view-density--{Workspace.Density.ToString().ToLowerInvariant()}")">
<HeaderActions>
    @if (!_initializing && Workspace.Scopes is not null)
    {
        <label><span>Scope</span><AppNativeSelect Value="@SelectedScopeValue" OnChange="ScopeChangedAsync" aria-label="Authorized photo scope"><ViewScopeOptions Scopes="@Workspace.Scopes.AvailableScopes" /></AppNativeSelect></label>
        <label><span>Density</span><AppNativeSelect Value="@Workspace.Density.ToString()" OnChange="DensityChangedAsync" aria-label="Timeline density">@foreach (var density in Enum.GetValues<ViewTimelineDensity>()) { <option value="@density">@density</option> }</AppNativeSelect></label>
        <AppButton Href="/view/contributions" Label="Contributions" StartIcon="@AppMaterialIcons.Outlined.MoveToInbox" ButtonStyle="AppButtonStyle.Text" />
        @if (Workspace.ScopeKind != ViewScopeKind.Profile) { <label class="view-add-media@(_uploading ? " is-busy" : string.Empty)" aria-disabled="@_uploading"><InputFile class="view-add-media__input" OnChange="UploadMediaAsync" disabled="@_uploading" accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt" /><span class="view-add-media__label"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Add" />@(_uploading ? "Uploading…" : "Add media")</span></label> }
    }
</HeaderActions>
<ChildContent>
@if (_initializing) { <AppPageState Kind="AppPageStateKind.Loading" Title="Loading Photos" Message="Opening your personal space." /> }
else if (Workspace.Scopes is null) { <AppErrorState Title="Photos could not be loaded" Message="The Dashboard could not resolve an authorized View scope." Retry="InitializeAsync" /> }
else
{
    @if (_uploading) { <section class="view-upload-status" role="status" aria-live="polite"><span>Uploading @_uploadFileName…</span><AppProgressBar Color="AppColor.Primary" Indeterminate="true" /></section> }
    @if (!string.IsNullOrWhiteSpace(_uploadError)) { <section class="view-upload-status is-error" role="alert">@_uploadError</section> }
    <AppDiscoveryFilterBar AriaLabel="View filters"
                           SearchValue="@_search"
                           SearchChanged="SearchChanged"
                           SearchPlaceholder="Search photos, dates, devices, locations, and tags"
                           SearchAriaLabel="Search Photos"
                           QuickFilterAriaLabel="Photos quick filters"
                           AdvancedFilterAriaLabel="More photo filters"
                           HasActiveAdvancedFilters="@(_filter is "hidden" or "trash" or "documents")">
        <QuickFilters>
            @foreach (var filter in PrimaryFilters)
            {
                <AppNativeButton Type="button" Class="@FilterClass(filter.Key)" AriaLabel="@filter.Value" OnClick="@(_ => SetFilterAsync(filter.Key))">@filter.Value</AppNativeButton>
            }
        </QuickFilters>
        <AdvancedFilters>
            <AppNativeButton Type="button" Class="@FilterClass("hidden")" OnClick="@(_ => SetFilterAsync("hidden"))">Hidden</AppNativeButton>
            <AppNativeButton Type="button" Class="@FilterClass("trash")" OnClick="@(_ => SetFilterAsync("trash"))">Trash</AppNativeButton>
            <AppNativeButton Type="button" Class="@FilterClass("documents")" OnClick="@(_ => SetFilterAsync("documents"))">Documents</AppNativeButton>
        </AdvancedFilters>
    </AppDiscoveryFilterBar>
    @if (_selected.Count > 0) { <ViewSelectionToolbar Count="@_selected.Count" ManualGalleries="@Workspace.OwnedGalleries.Where(g => g.Kind == ViewGalleryKind.Manual).ToList()" OnClear="ClearSelection" OnAddToGallery="AddSelectionToGalleryAsync" OnCreateGallery="CreateGalleryFromSelectionAsync" OnSharedLibrary="SubmitSelectionToSharedAsync" ShowSharedLibrary="@(Workspace.ScopeKind == ViewScopeKind.Mine)" OnFavorite="FavoriteSelectionAsync" OnArchive="ArchiveSelectionAsync" OnRestore="RestoreSelectionAsync" ShowRestore="@(_filter is "archive" or "trash")" OnTrash="TrashSelectionAsync" ShowTrash="@(_filter != "trash")" /> }
    @if (_loading) { <AppPageState Kind="AppPageStateKind.Loading" Title="Loading Photos" Message="Building your personal timeline." /> }
    else if (_page is null) { <AppErrorState Title="Photos could not be loaded" Message="The Engine did not return a timeline." Retry="@(() => LoadAsync())" /> }
    else if (_page.Items.Count == 0) { <AppPageState Kind="AppPageStateKind.Empty" Title="@EmptyTitle" Message="@EmptyMessage" /> }
    else
    {
        @if (_olderWindow) { <AppButton Label="Back to newest photos" OnClick="@(() => LoadAsync(preserveSelection: true))" /> }
        <div class="view-timeline-layout">
            <ViewPhotoTimeline Items="@_page.Items" Selected="@_selected" SelectEntireDate="true" Density="@Workspace.Density" ThumbnailUrl="@(item => AssetUrl(item, ViewMediaResourceKind.Thumbnail))" OnOpen="OpenItem" OnToggleSelection="ToggleSelection" OnToggleSelectionRequested="ToggleSelectionRequested" OnSelectDateGroup="SelectDateGroup" OnDragStarted="BeginDrag" OnDragEnded="EndDrag" />
            <ViewTimelineScrubber Buckets="@(_timelineIndex?.Buckets ?? [])" ActiveYear="@_activeYear" ActiveMonth="@_activeMonth" OnJump="JumpToBucketAsync" />
        </div>
        <span class="view-timeline-observer-anchor" @ref="_timelineSentinel" aria-hidden="true"></span>
        @if (_page.HasMore)
        {
            <div class="view-load-more" aria-live="polite"><span class="view-load-more__status">@(_loadingMore ? "Loading more photos…" : _page.Items.Count >= MaximumWindowItems ? "Continue into an older window, or use the date navigator. Your selection is kept." : "More photos load as you scroll")</span><AppButton ButtonStyle="AppButtonStyle.Text" Disabled="@_loadingMore" OnClick="LoadMoreAsync">@(_loadingMore ? "Loading…" : _page.Items.Count >= MaximumWindowItems ? "Continue to older photos" : "Load more")</AppButton></div>
        }
    }
}
</ChildContent>
</ViewContentPage>
</ViewSectionShell>
@if (_activeItem is not null) { <ViewImmersiveViewer Item="@_activeItem" HasPrevious="@HasPrevious" HasNext="@HasNext" PositionLabel="@ViewerPosition" ContentUrl="@AssetUrl(_activeItem, ViewMediaResourceKind.Preview)" OriginalUrl="@AssetUrl(_activeItem, ViewMediaResourceKind.Content)" MotionUrl="@MotionUrl(_activeItem)" ThumbnailUrl="@AssetUrl(_activeItem, ViewMediaResourceKind.Thumbnail)" OnClose="CloseItem" OnPrevious="PreviousItem" OnNext="NextItem" OnFavorite="ToggleFavoriteAsync" OnArchive="ArchiveActiveAsync" OnRestore="RestoreActiveAsync" OnTrash="TrashActiveAsync" ManualGalleries="@Workspace.OwnedGalleries.Where(g => g.Kind == ViewGalleryKind.Manual).ToList()" OnAddToGallery="AddActiveToGalleryAsync" CanEdit="@(Workspace.ScopeKind == ViewScopeKind.Mine)" CanManage="@(ItemScope(_activeItem).Kind == ViewScopeKind.Mine)" OnItemUpdated="Replace" /> }

@code {
    private static readonly IReadOnlyDictionary<string, string> PrimaryFilters = new Dictionary<string, string> { ["all"] = "All", ["favorites"] = "Favorites", ["videos"] = "Videos", ["archive"] = "Archive" };
    private ViewSectionShell? _viewSectionShell; private ViewAssetTimelinePageDto? _page; private ViewTimelineIndexDto? _timelineIndex; private LocalAssetDto? _activeItem; private readonly HashSet<Guid> _selected = []; private readonly Dictionary<(Guid, Guid, ViewMediaResourceKind, ViewMediaResourceRole, ViewScopeKind, Guid?), CachedMediaGrant> _grants = [];
    private CancellationTokenSource? _searchCts; private Guid? _profileId; private string _search = ""; private string _filter = "all"; private bool _initializing = true, _loading, _loadingMore, _uploading; private string? _uploadFileName, _uploadError;
    private DateTimeOffset? _anchorBefore; private Guid? _selectionAnchor; private int? _activeYear, _activeMonth; private ElementReference _timelineSentinel; private IJSObjectReference? _timelineModule; private DotNetObjectReference<ViewPage>? _timelineReference; private bool _observeTimeline, _focusAnchoredPeriod;
    protected override async Task OnInitializedAsync() { Orchestrator.OnProfileChanged += OnProfileChanged; await InitializeAsync(); }
    private async Task InitializeAsync() { _initializing = true; _profileId = (await Orchestrator.GetActiveProfileAsync())?.Id; await Workspace.InitializeAsync(); await Workspace.LoadGalleriesAsync(); _initializing = false; await LoadAsync(); }
    private ViewAssetQueryOptions Query(string? cursor = null, DateTimeOffset? anchorBefore = null) => new(Workspace.ScopeKind, Workspace.ScopeProfileId, cursor, _search, _filter switch { "videos" => ["video"], "documents" => ["document"], _ => null }, _filter == "favorites", _filter == "hidden", _filter switch { "archive" => "archived", "trash" => "trashed", _ => "active" }, AnchorBefore: anchorBefore);
    private int _loadVersion;
    private const int MaximumWindowItems = 600;
    private bool _olderWindow;
    private async Task LoadAsync(DateTimeOffset? anchorBefore = null, bool preserveSelection = false)
    {
        var version = ++_loadVersion;
        _observeTimeline = false;
        _focusAnchoredPeriod = false;
        if (_timelineModule is not null) await _timelineModule.InvokeVoidAsync("disconnectTimeline", _timelineSentinel);
        _loading = true;
        _loadingMore = false;
        _anchorBefore = anchorBefore;
        var pageTask = ApiClient.GetViewAssetsAsync(Query(anchorBefore: anchorBefore));
        var indexTask = ApiClient.GetViewTimelineIndexAsync(Query());
        await Task.WhenAll(pageTask, indexTask);
        if (version != _loadVersion) return;
        _page = pageTask.Result;
        _timelineIndex = indexTask.Result;
        if (!preserveSelection) _selected.Clear();
        _olderWindow = anchorBefore.HasValue;
        _selectionAnchor = null;
        SetActiveFromFirstItem();
        _observeTimeline = _page?.Items.Count > 0;
        _focusAnchoredPeriod = _observeTimeline && anchorBefore.HasValue;
        _loading = false;
    }
    private async Task LoadMoreAsync()
    {
        if (_page?.NextCursor is null || _loadingMore || _loading) return;
        var version = _loadVersion;
        _loadingMore = true;
        var next = await ApiClient.GetViewAssetsAsync(Query(_page.NextCursor));
        if (version != _loadVersion) return;
        if (next is not null)
        {
            if (_page.Items.Count >= MaximumWindowItems)
            {
                if (_timelineModule is not null) await _timelineModule.InvokeVoidAsync("disconnectTimeline", _timelineSentinel);
                _page = next; _olderWindow = true; _focusAnchoredPeriod = true;
            }
            else _page = next with { Items = [.. _page.Items, .. next.Items] };
        }
        _loadingMore = false;
        _observeTimeline = _page.Items.Count > 0;
    }
    private async Task ScopeChangedAsync(ChangeEventArgs args) { var parts = args.Value?.ToString()?.Split(':', 2) ?? []; if (parts.Length == 0 || !Enum.TryParse<ViewScopeKind>(parts[0], true, out var kind)) return; Guid? profile = parts.Length == 2 && Guid.TryParse(parts[1], out var parsed) ? parsed : null; if (await Workspace.SelectScopeAsync(kind, profile)) await LoadAsync(); }
    private async Task DensityChangedAsync(ChangeEventArgs args) { if (Enum.TryParse<ViewTimelineDensity>(args.Value?.ToString(), out var density) && !await Workspace.SetDensityAsync(density)) Snackbar.Add("Timeline density could not be saved.", AppSeverity.Error); }
    private async Task SearchChanged(object? value)
    {
        _search = value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        var search = new CancellationTokenSource();
        _searchCts = search;
        try
        {
            await Task.Delay(250, search.Token);
            await LoadAsync();
        }
        catch (OperationCanceledException) { }
    }
    private async Task SetFilterAsync(string filter) { _filter = filter; await LoadAsync(); } private string FilterClass(string filter) => $"app-discovery-filter__tab{(_filter == filter ? " is-active" : "")}"; private string SelectedScopeValue => ScopeValue(Workspace.ScopeKind, Workspace.ScopeProfileId); private static string ScopeValue(ViewScopeKind kind, Guid? profile) => $"{kind}:{(kind == ViewScopeKind.Profile ? profile?.ToString("D") : null)}";
    private string ScopeDescription => Workspace.ScopeKind switch
    {
        ViewScopeKind.Mine => "Your private photo and video timeline.",
        ViewScopeKind.Profile => $"Photos and videos shared by {SelectedScopeLabel}.",
        _ => "Photos and videos in the Shared Library."
    };
    private string SelectedScopeLabel => Workspace.Scopes?.AvailableScopes.FirstOrDefault(scope =>
        scope.Kind == Workspace.ScopeKind && (scope.Kind != ViewScopeKind.Profile || scope.ProfileId == Workspace.ScopeProfileId))?.Label ?? "this profile";
    private async Task UploadMediaAsync(InputFileChangeEventArgs args) { if (_uploading) return; var file = args.File; _uploadFileName = file.Name; _uploadError = null; _uploading = true; try { await using var stream = file.OpenReadStream(file.Size); var result = await ApiClient.UploadViewMediaAsync(stream, file.Name, file.ContentType); if (!result.Success) { _uploadError = result.ErrorMessage ?? "The Engine rejected this upload."; return; } Snackbar.Add($"Added {file.Name} to Photos.", AppSeverity.Success); await LoadAsync(); } catch (Exception ex) { _uploadError = $"The file could not be uploaded: {ex.Message}"; } finally { _uploading = false; _uploadFileName = null; } }
    private void OpenItem(LocalAssetDto item) => _activeItem = item; private void CloseItem() => _activeItem = null; private IReadOnlyList<LocalAssetDto> VisibleItems => _page?.Items ?? []; private int ActiveIndex => _activeItem is null ? -1 : VisibleItems.ToList().FindIndex(i => i.Id == _activeItem.Id); private bool HasPrevious => ActiveIndex > 0; private bool HasNext => ActiveIndex >= 0 && ActiveIndex < VisibleItems.Count - 1; private void PreviousItem() { if (HasPrevious) _activeItem = VisibleItems[ActiveIndex - 1]; } private void NextItem() { if (HasNext) _activeItem = VisibleItems[ActiveIndex + 1]; }
    private string? ViewerPosition => ActiveIndex >= 0 ? $"{ActiveIndex + 1} of {VisibleItems.Count}" : null;
    private void ToggleSelection(Guid id) { if (!_selected.Add(id)) _selected.Remove(id); _selectionAnchor = id; }
    private void ToggleSelectionRequested(ViewPhotoTimeline.SelectionRequest request)
    {
        if (request.ExtendRange && _selectionAnchor is { } anchor)
        {
            var items = VisibleItems;
            var start = items.ToList().FindIndex(item => item.Id == anchor);
            var end = items.ToList().FindIndex(item => item.Id == request.ItemId);
            if (start >= 0 && end >= 0)
            {
                foreach (var item in items.Skip(Math.Min(start, end)).Take(Math.Abs(end - start) + 1)) _selected.Add(item.Id);
                _selectionAnchor = request.ItemId;
                return;
            }
        }
        ToggleSelection(request.ItemId);
    }
    private bool _selectingDate;
    private async Task SelectDateGroup(IReadOnlyCollection<Guid> ids)
    {
        if (_selectingDate || _page is null || ids.Count == 0) return;
        var item = _page.Items.FirstOrDefault(item => ids.Contains(item.Id));
        if (item is null) return;
        var date = (item.CapturedAt ?? item.CreatedAt).Date;
        var version = _loadVersion;
        var select = ids.Any(id => !_selected.Contains(id));
        var matching = new HashSet<Guid>();
        string? cursor = null;
        _selectingDate = true;
        try
        {
            do
            {
                var query = Query(cursor) with { From = new DateTimeOffset(date, TimeSpan.Zero).AddHours(-14),
                    To = new DateTimeOffset(date.AddDays(1), TimeSpan.Zero).AddHours(14), Limit = 500 };
                var page = await ApiClient.GetViewAssetsAsync(query);
                if (version != _loadVersion) return;
                if (page is null) { Snackbar.Add("The full date could not be selected. Please retry.", AppSeverity.Error); return; }
                matching.UnionWith(page.Items.Where(value => (value.CapturedAt ?? value.CreatedAt).Date == date).Select(value => value.Id));
                cursor = page.NextCursor;
            } while (cursor is not null);
            if (select) _selected.UnionWith(matching); else _selected.ExceptWith(matching);
            _selectionAnchor = ids.LastOrDefault();
        }
        finally { _selectingDate = false; }
    }
    private void ClearSelection() { _selected.Clear(); _selectionAnchor = null; }
    private void BeginDrag(Guid id) => AssetDrag.Begin(_selected.Contains(id) ? _selected : [id]); private void EndDrag() => AssetDrag.Clear();
    private async Task AddSelectionToGalleryAsync(Guid id) { var result = await ApiClient.AddViewGalleryItemsAsync(id, _selected); if (result is null) { Snackbar.Add("The selected items could not be added to the Gallery.", AppSeverity.Error); return; } Snackbar.Add(GalleryResult(result), AppSeverity.Success); ClearSelection(); await Workspace.LoadGalleriesAsync(force: true); }
    private async Task CreateGalleryFromSelectionAsync() { if (_viewSectionShell is null) return; await _viewSectionShell.BeginManualGalleryCreateAsync(_selected); ClearSelection(); }
    private async Task AddActiveToGalleryAsync(Guid id) { if (_activeItem is null) return; var result = await ApiClient.AddViewGalleryItemsAsync(id, [_activeItem.Id]); if (result is not null) Snackbar.Add(GalleryResult(result), AppSeverity.Success); }
    private static string GalleryResult(AddViewGalleryItemsResponseDto result) => result.AlreadyPresent > 0 ? $"{result.Added} added · {result.AlreadyPresent} already in Gallery" : $"{result.Added} added";
    private Task ArchiveSelectionAsync() => MutateSelectionAsync(ApiClient.ArchiveViewItemAsync, "Archived selected items."); private Task TrashSelectionAsync() => MutateSelectionAsync(ApiClient.TrashViewItemAsync, "Moved selected items to Trash.");
    private bool _mutatingSelection;
    private async Task MutateSelectionAsync(Func<Guid, CancellationToken, Task<bool>> action, string message)
    {
        if (_mutatingSelection) return;
        _mutatingSelection = true;
        var failed = new HashSet<Guid>();
        try
        {
            foreach (var id in _selected.ToArray()) if (!await action(id, default)) failed.Add(id);
            await LoadAsync();
            _selected.UnionWith(failed);
            Snackbar.Add(failed.Count == 0 ? message : $"{failed.Count} items could not be updated and remain selected. Please retry.", failed.Count == 0 ? AppSeverity.Success : AppSeverity.Error);
        }
        finally { _mutatingSelection = false; }
    }
    private Task FavoriteSelectionAsync() => MutateSelectionAsync((id, ct) => ApiClient.SetViewItemFavoriteAsync(id, true, ct), "Favorited selected items.");
    private async Task SubmitSelectionToSharedAsync()
    {
        var ids = _selected.ToList();
        var dialog = await DialogService.ShowAsync<ViewSharedContributionDialog>(string.Empty,
            new AppDialogParameters<ViewSharedContributionDialog> { { component => component.ItemIds, ids } },
            new AppDialogOptions { NoHeader = true, FullWidth = true, MaxWidth = AppMaxWidth.Medium });
        if (await dialog.Result is not { Canceled: false, Data: ViewSharedContributionSubmitRequest request }) return;
        var contribution = await ApiClient.SubmitViewSharedContributionAsync(request);
        if (contribution is null) { Snackbar.Add(ApiClient.LastError ?? "The contribution could not be submitted.", AppSeverity.Error); return; }
        Snackbar.Add($"{contribution.Items.Count} items submitted to the Shared Library.", AppSeverity.Success);
        ClearSelection();
    }
    private Task RestoreSelectionAsync() => MutateSelectionAsync(ApiClient.RestoreViewItemAsync, "Restored selected items to Photos.");
    private async Task ToggleFavoriteAsync() { if (_activeItem is null) return; var value = !_activeItem.Favorite; if (await ApiClient.SetViewItemFavoriteAsync(_activeItem.Id, value)) Replace(_activeItem with { Favorite = value }); } private async Task ArchiveActiveAsync() { if (_activeItem is not null && await ApiClient.ArchiveViewItemAsync(_activeItem.Id)) await RemoveActiveAsync(); } private async Task RestoreActiveAsync() { if (_activeItem is not null && await ApiClient.RestoreViewItemAsync(_activeItem.Id)) await RemoveActiveAsync(); } private async Task TrashActiveAsync() { if (_activeItem is not null && await ApiClient.TrashViewItemAsync(_activeItem.Id)) await RemoveActiveAsync(); } private async Task RemoveActiveAsync() { _activeItem = null; await LoadAsync(); } private void Replace(LocalAssetDto updated) { _activeItem = updated; if (_page is not null) _page = _page with { Items = _page.Items.Select(i => i.Id == updated.Id ? updated : i).ToList() }; }
    private string AssetUrl(LocalAssetDto item, ViewMediaResourceKind kind, ViewMediaResourceRole role = ViewMediaResourceRole.Primary)
    {
        if (!_profileId.HasValue) return "";
        var (scopeKind, scopeProfileId) = ItemScope(item);
        var key = (item.LibraryId, item.Id, kind, role, scopeKind, scopeProfileId);
        if (!_grants.TryGetValue(key, out var cached) || cached.ExpiresAt <= DateTimeOffset.UtcNow.AddSeconds(30))
        {
            var grant = MediaGrants.Create(_profileId.Value, item.LibraryId, item.Id, kind, role, scopeKind, scopeProfileId);
            cached = new($"/view-media/{grant.Value}", grant.ExpiresAt);
            _grants[key] = cached;
        }
        return cached.Url;
    }
    private string? MotionUrl(LocalAssetDto item) => item.Files.Any(file => file.Role == "live_photo_video")
        ? AssetUrl(item, ViewMediaResourceKind.Content, ViewMediaResourceRole.LivePhotoVideo) : null;
    private (ViewScopeKind Kind, Guid? ProfileId) ItemScope(LocalAssetDto item) =>
        string.Equals(item.ScopeKind, "shared", StringComparison.OrdinalIgnoreCase)
            ? (ViewScopeKind.Shared, null)
            : item.OwnerProfileId.HasValue && item.OwnerProfileId != _profileId
                ? (ViewScopeKind.Profile, item.OwnerProfileId)
                : (ViewScopeKind.Mine, null);
    private string EmptyTitle => !string.IsNullOrWhiteSpace(_search) ? "No matching items" : _filter switch { "favorites" => "No favorites yet", "videos" => "No videos yet", "archive" => "Archive is empty", "trash" => "Trash is empty", "hidden" => "No hidden items", "documents" => "No documents yet", _ => "No personal media yet" }; private string EmptyMessage => !string.IsNullOrWhiteSpace(_search) ? "Try a different search." : "Items matching this View filter will appear here.";
    private async Task JumpToBucketAsync(ViewTimelineBucketDto bucket)
    {
        if (_timelineModule is not null && await _timelineModule.InvokeAsync<bool>("jumpToPeriod", bucket.Year, bucket.Month)) return;
        var anchor = new DateTimeOffset(bucket.Year, bucket.Month, 1, 0, 0, 0, TimeSpan.Zero).AddMonths(1);
        await LoadAsync(anchor, preserveSelection: true);
    }
    private void SetActiveFromFirstItem()
    {
        if (_page?.Items.FirstOrDefault() is not { } first) return;
        var date = first.CapturedAt ?? first.CreatedAt;
        _activeYear = date.Year; _activeMonth = date.Month;
    }
    [JSInvokable] public Task SetActiveTimelinePeriod(int year, int month) { _activeYear = year; _activeMonth = month; return InvokeAsync(StateHasChanged); }
    [JSInvokable] public Task LoadMoreFromObserverAsync() => InvokeAsync(async () =>
    {
        if (_page?.Items.Count >= MaximumWindowItems) return;
        await LoadMoreAsync();
        StateHasChanged(); // JS callbacks do not get Blazor's automatic event-handler render.
    });
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || _page?.Items.Count is not > 0 || (!_observeTimeline && !_focusAnchoredPeriod)) return;
        _timelineModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/view-timeline.js");
        if (_observeTimeline) { _timelineReference ??= DotNetObjectReference.Create(this); await _timelineModule.InvokeVoidAsync("observeTimeline", _timelineSentinel, _timelineReference, _page?.HasMore == true && _page.Items.Count < MaximumWindowItems); }
        _observeTimeline = false;
        if (_focusAnchoredPeriod) { _focusAnchoredPeriod = false; await _timelineModule.InvokeVoidAsync("focusFirstPeriod"); }
    }
    private void OnProfileChanged() => _ = InvokeAsync(async () => { _grants.Clear(); Workspace.Reset(); await InitializeAsync(); StateHasChanged(); }); public void Dispose() { Orchestrator.OnProfileChanged -= OnProfileChanged; _searchCts?.Cancel(); _searchCts?.Dispose(); }
    public async ValueTask DisposeAsync() { Dispose(); if (_timelineModule is not null) { try { await _timelineModule.InvokeVoidAsync("disconnectTimeline", _timelineSentinel); await _timelineModule.DisposeAsync(); } catch (JSDisconnectedException) { } } _timelineReference?.Dispose(); }
    private sealed record CachedMediaGrant(string Url, DateTimeOffset ExpiresAt);
}
