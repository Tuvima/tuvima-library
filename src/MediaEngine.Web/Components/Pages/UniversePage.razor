@page "/universe/{Qid}"
@namespace MediaEngine.Web.Components.Pages
@using MediaEngine.Contracts.Universe
@using MediaEngine.Web.Components.Details
@using MediaEngine.Web.Components.MediaTiles
@using MediaEngine.Web.Components.Universe
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.MediaTiles
@using MediaEngine.Web.Services.Theming
@implements IDisposable
@inject IEngineApiClient ApiClient
@inject UniverseStateContainer State
@inject DeviceContextService DeviceContext
@inject DashboardSessionAccessor Session
@inject DashboardIdentityClient Identity
@inject IAdministratorSurfaceAccessService AdministratorAccess
@inject IAppToastService Snackbar
@inject IAppDialogService Dialogs
@inject ILogger<UniversePage> Logger
@inject IStringLocalizer<SharedStrings> L

<PageTitle>@L["Common_Library", PageTitleText]</PageTitle>

@* A Universe: what the Library holds of one fictional world across every format, as a page to read, not a screen to manage.
   Hero, then each Series in order, then the Universe's own standalone works, then Connections. Editing a Universe uses the
   same bar, side panel and floating artwork picker as every other page (spec D17a), for desktop administrators only. Its name
   and description are local overrides (the Wikidata values stay untouched and come back with "Reset to canonical value"), it
   has Artwork, and it lists its Series read-only. A Universe has no Match tool. *@
<div class="universe-page">
    <EditingBar Mode="_editing"
                Flow="_flow"
                CanDelete="false"
                GuardInternalNavigation="true" />

    @switch (_state.Status)
    {
        case UniversePageStatus.Loading:
            <div class="universe-page__loading" aria-busy="true" aria-label="@L["UniversePage_LoadingThisUniverse"].Value">
                <AppSkeleton Height="14rem" Width="100%" />
                <AppSkeleton Height="2rem" Width="40%" />
                <AppSkeleton Height="18rem" Width="100%" />
            </div>
            break;

        case UniversePageStatus.Unavailable:
            <AppErrorState Title="@L["Common_CanTReachTheEngine"].Value"
                           Message="@L["UniversePage_TheUniverseCouldNotBe"].Value"
                           Retry="RetryAsync" />
            break;

        case UniversePageStatus.NotFound:
            <AppEmptyState Title="@L["UniversePage_ThisUniverseIsnTAvailable"].Value"
                           Message="@L["UniversePage_ItMayHaveBeenRemoved"].Value">
                <Action>
                    <AppButton Label="@L["UniversePage_BackToCollections"].Value" Href="/collections" ButtonStyle="AppButtonStyle.Outlined" />
                </Action>
            </AppEmptyState>
            break;

        default:
            if (_state.Page is { } overview)
            {
                <UniverseHero Detail="@overview.Detail"
                              Name="@_preview.Title(overview.Detail.Name)"
                              Description="@_preview.Description(overview.Detail.Description)"
                              CoverUrl="@(_preview.Artwork.Url("CoverArt") ?? overview.Detail.CoverUrl)"
                              BackgroundUrl="@(_preview.Artwork.Url("Background") ?? overview.Detail.BackgroundUrl)"
                              StandaloneCards="@(overview.Standalone?.Items ?? [])"
                              CanEdit="@CanShowEdit"
                              EditBusy="@_openingEditor"
                              OnEdit="EditUniverseAsync"
                              EnrichmentRunning="@(overview.Enrichment.State == UniverseEnrichmentStateDto.Running)" />


                <EditSavedRibbon Flow="_flow" />
                <EditorPanelHost Mode="_editing" Flow="_flow" Picker="_artworkPicker">
                    @if (context == EditTool.Details)
                    {
                        <EditorDetailsPanel Mode="_editing" Session="_flow.Session">
                            @if (overview.Detail.Shelves.Count > 0)
                            {
                                <section class="tl-editor-details__group" aria-label="@L["UniversePage_SeriesInThisUniverse"].Value">
                                    <h3 class="tl-editor-details__heading">@L["Common_Series"]</h3>
                                    @foreach (var shelf in overview.Detail.Shelves)
                                    {
                                        <div class="tl-editor-field tl-editor-field--locked" @key="shelf.CollectionId">
                                            <div class="tl-editor-field__label"><span>@shelf.Shelf.Title</span></div>
                                            <div class="tl-editor-field__value">@(shelf.ItemCount == 1 ? "1 item" : $"{shelf.ItemCount} items")</div>
                                        </div>
                                    }
                                    <small class="tl-editor-field__count">@L["UniversePage_SeriesAreGroupedByWikidata"]</small>
                                </section>
                            }
                        </EditorDetailsPanel>
                    }
                </EditorPanelHost>

                <div class="universe-page__series">
                    @foreach (var shelf in overview.Detail.Shelves)
                    {
                        <UniverseSeriesShelf Shelf="@shelf"
                                             Missing="@overview.Missing.FirstOrDefault(entry => entry.CollectionId == shelf.CollectionId)"
                                             @key="shelf.CollectionId" />
                    }
                </div>

                if (StandaloneShelf is { } standalone)
                {
                    <MediaTileShelf Shelf="@standalone" ShowCompactCaptions="true" KeepCurrentTileSize="true" />
                }

                <UniverseConnections Page="@overview"
                                     FandomLine="@_showFandomLine"
                                     OnCastMemberSelected="OpenAlsoAppearsInAsync"
                                     OnCharacterSelected="OpenCharacterAppearsInAsync" />
            }
            break;
    }
</div>

@code {
    [Parameter] public string Qid { get; set; } = string.Empty;

    private readonly CancellationTokenSource _lifetime = new();
    private UniversePageState _state = default!;
    private EditingModeContext _editing = default!;
    private EditSessionFlow _flow = default!;
    private EditPendingPreview _preview = default!;
    private ArtworkPickerSession _artworkPicker = default!;
    private string? _loadedQid;
    private bool _canEditUniverse;
    private bool _showFandomLine;
    private bool _openingEditor;
    private bool _disposed;

    private string PageTitleText => _state.Page?.Detail.Name is { Length: > 0 } name ? name : "Universe";

    private bool _isAdministrator;

    private bool IsAdministrator => _isAdministrator;

    // Desktop administrators who may edit this Universe: the same checks the explorer makes, and the Engine decides again.
    private bool CanShowEdit => IsAdministrator && DeviceContext.CanEdit && _canEditUniverse;

    private string CurrentQid => _state.Page?.Detail.Qid ?? Qid;

    private MediaTileShelfViewModel? StandaloneShelf => _state.Page?.Standalone is { Items.Count: > 0 } shelf
        ? new MediaTileShelfViewModel
        {
            Key = shelf.Key,
            Title = shelf.Title,
            Subtitle = shelf.Subtitle,
            Items = shelf.Items.Select(MediaTileComposerService.FromDisplayCard).ToList(),
        }
        : null;

    // A cast row opens "Also appears in": every owned Work that shares one of this person's characters, then more of
    // their own work in the Library. Matching is by Wikidata item, so nothing here is guessed from a name.
    private Task OpenAlsoAppearsInAsync(UniverseClientCastMemberDto member) =>
        AlsoAppearsInPanel.OpenAsync(
            Dialogs,
            CurrentQid,
            member.Characters.Select(character => (character.Qid, character.Label)).ToList(),
            member.PersonId,
            member.Name);

    // A character row opens the same panel for that one character, with no person. There is no character page.
    private Task OpenCharacterAppearsInAsync(UniverseCharacterDto character) =>
        AlsoAppearsInPanel.OpenAsync(Dialogs, CurrentQid, [(character.Qid, character.Label)]);

    protected override void OnInitialized()
    {
        _state = new UniversePageState(ApiClient);
        _editing = new EditingModeContext(DeviceContext, new ItemFieldEditSession(ApiClient, DeviceContext, Logger))
        {
            Loader = LoadEditingFieldsAsync,
            AskSaveOrDiscard = () => EditingSaveOrDiscardDialog.AskAsync(Dialogs),
        };
        _editing.Changed += OnEditingChanged;
        var session = new EditSessionState(new PendingEditList());
        _flow = new EditSessionFlow(session, _editing, new EditSessionSaver(ApiClient), EditTrail, () => EditingUnsavedChangesDialog.AskDiscardAsync(Dialogs))
        {
            Saved = RefreshAfterEditSavedAsync,
        };
        _preview = new EditPendingPreview(session, _editing.Fields);
        _artworkPicker = new ArtworkPickerSession(ApiClient, session, _editing.Fields, _preview.Artwork, Logger);
        session.Changed += OnEditSessionChanged;
        _artworkPicker.Changed += OnEditSessionChanged;
        State.OnStateChanged += OnEngineStateChanged;
        DeviceContext.OnChanged += OnAccessContextChanged;
        Session.OnAuthorityChanged += OnAccessContextChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedQid, Qid, StringComparison.Ordinal))
        {
            return;
        }

        // A different Universe in the same circuit starts over: close any editor and show the loading state.
        _loadedQid = Qid;
        _canEditUniverse = false;
        _showFandomLine = false;
        _editing.Leave();
        await LoadAsync(quiet: false);
    }

    private async Task LoadAsync(bool quiet)
    {
        await _state.LoadAsync(Qid, quiet, _lifetime.Token);
        if (_disposed || _state.Page is null)
        {
            return;
        }

        await LoadAdministratorExtrasAsync(confirmWithEngine: true);
    }

    // Administrators get two extras: whether this Universe is editable, and the quiet "Add Fandom details" line when the
    // lore plugin is off. Both ask the Engine, which decides again for any action taken.
    private async Task LoadAdministratorExtrasAsync(bool confirmWithEngine)
    {
        // On a fresh page load the sign-in details may not have reached this screen yet, so when they don't already say
        // "administrator" the page asks the Engine once, as the explorer does (the answer is cached for the open screen).
        // A recheck started by a sign-in or device notice reads the session only, so asking can never start another notice.
        _isAdministrator = Session.Authority?.EffectiveAdministrator == true
            || (confirmWithEngine
                && (await Identity.RevalidateAuthorityAsync(Session, _lifetime.Token))?.EffectiveAdministrator == true);
        if (!IsAdministrator)
        {
            _canEditUniverse = false;
            _showFandomLine = false;
            return;
        }

        // Administrators on a desktop may edit; the Engine decides again when the editor loads and for every save.
        _canEditUniverse = DeviceContext.CanEdit;
        _editing.HasPermission = _canEditUniverse;

        // An unreadable plugin list hides the line (the client logs it); an empty list means there is nothing to say.
        var plugins = await ApiClient.GetPluginsAsync(_lifetime.Token);
        _showFandomLine = plugins.Count > 0
            && !plugins.Any(plugin => string.Equals(plugin.Id, FandomPluginId, StringComparison.Ordinal) && plugin.Enabled);
    }

    private const string FandomPluginId = "tuvima.fandom-lore";

    private async Task RetryAsync()
    {
        await LoadAsync(quiet: false);
    }

    private async Task EditUniverseAsync()
    {
        if (_openingEditor || !CanShowEdit)
        {
            return;
        }

        // Every edit handler asks the device rule again; a hidden button is never the only protection.
        if (EditorDeviceRule.TryRefuse(DeviceContext, Snackbar))
        {
            return;
        }

        _openingEditor = true;
        try
        {
            if (!await AdministratorAccess.EnsureUnlockedAsync(_lifetime.Token))
            {
                return;
            }

            _editing.HasPermission = true;
            if (await _editing.EnterAsync() && _editing.Fields.Loaded)
            {
                await _flow.SelectToolAsync(EditTool.Details);
            }
        }
        catch (OperationCanceledException)
        {
            // The page was left while the unlock prompt was open; nothing else to do.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not open the Universe editor for {UniverseQid}", Qid);
            Snackbar.Add("Universe editing is unavailable. Please try again.", AppSeverity.Error);
        }
        finally
        {
            _openingEditor = false;
        }
    }

    // The Universe is a subject of its own: the Engine describes its fields, artwork slots and permissions by its Wikidata id.
    private Task LoadEditingFieldsAsync() => _editing.Fields.LoadUniverseSubjectAsync(CurrentQid);

    private IReadOnlyList<EditTrailItem> EditTrail() =>
        [new EditTrailItem(_editing.Fields.EntityId, _state.Page?.Detail.Name ?? "Universe", "Universe")];

    // Save changes went through: show the page's new values and reload the editor's fields so the next edit starts from them.
    private async Task RefreshAfterEditSavedAsync()
    {
        await ReloadAfterEditAsync();
        await LoadEditingFieldsAsync();
    }

    private void OnEditSessionChanged() => _ = InvokeAsync(StateHasChanged);

    // The editor saved something: read the page again without blanking it.
    private async Task ReloadAfterEditAsync()
    {
        try
        {
            await _state.LoadAsync(Qid, quiet: true, _lifetime.Token);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // The page was left while the read was running.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The Universe page could not refresh after an edit for {UniverseQid}", Qid);
            Snackbar.Add("Saved, but the page could not refresh. Reload to see the change.", AppSeverity.Warning);
        }
    }

    private void OnEditingChanged() => _ = InvokeAsync(StateHasChanged);

    // Enrichment events carry no Universe, so the page reads its own overview again: at most once per ten seconds.
    // The container raises this on the SignalR thread, so the work moves onto the component's own context first.
    private void OnEngineStateChanged() => _ = InvokeAsync(() =>
    {
        if (_disposed || _state.RequestEnrichmentRefresh(State.UniverseEnrichmentProgressReceivedAt) is not { } wait)
        {
            return;
        }

        _ = RefreshAfterAsync(wait);
    });

    // The sign-in details and the device are often only known after the first render (unknown means "not an
    // administrator" and "can't edit"), so when either arrives the page checks the administrator extras again.
    private void OnAccessContextChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed || _state.Page is null || _canEditUniverse)
        {
            return;
        }

        try
        {
            await LoadAdministratorExtrasAsync(confirmWithEngine: false);
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // The page was left before the check finished.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The Universe page could not check whether {UniverseQid} is editable", Qid);
        }
    });

    private async Task RefreshAfterAsync(TimeSpan wait)
    {
        try
        {
            if (wait > TimeSpan.Zero)
            {
                await Task.Delay(wait, _lifetime.Token);
            }

            _state.RefreshStarted();
            await _state.LoadAsync(Qid, quiet: true, _lifetime.Token);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // The page was left before the refresh ran.
        }
        catch (Exception ex)
        {
            _state.RefreshStarted();
            Logger.LogWarning(ex, "The Universe page could not refresh its enrichment state for {UniverseQid}", Qid);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        State.OnStateChanged -= OnEngineStateChanged;
        DeviceContext.OnChanged -= OnAccessContextChanged;
        Session.OnAuthorityChanged -= OnAccessContextChanged;
        _editing.Changed -= OnEditingChanged;
        _flow.Session.Changed -= OnEditSessionChanged;
        _artworkPicker.Changed -= OnEditSessionChanged;
        _flow.Dispose();
        _lifetime.Cancel();
        _lifetime.Dispose();
        _editing.Dispose();
    }
}
