@page "/view/people"
@using MediaEngine.Contracts.LocalAssets
@using MediaEngine.Domain.PersonalMedia
@using MediaEngine.Web.Components.View
@using MediaEngine.Web.Services.Ui
@implements IDisposable
@inject IEngineApiClient ApiClient
@inject ViewWorkspaceService Workspace
@inject UIOrchestratorService Orchestrator
@inject ViewMediaGrantService MediaGrants
@inject ViewRibbonVoice Ribbon
@inject IAppDialogService DialogService
@inject ViewEditorHost EditorHost
@namespace MediaEngine.Web.Components.Pages
@inject IStringLocalizer<SharedStrings> L
<PageTitle>@L["ViewPeoplePage_PeopleLibrary"]</PageTitle>
<ViewSectionShell><ViewContentPage Title="@L["Wikidata_PeopleGroupTitle"].Value" Subtitle="@L["ViewPeoplePage_BrowseNamedAndReviewedPeople"].Value">
@if (_person is null && _progress is { State: ViewFaceStates.Off })
{
    <AppPageState Kind="AppPageStateKind.Empty" Title="@ViewPeopleText.OffTitle" Message="@ViewPeopleText.OffMessage" />
    <AppButton Label="@ViewPeopleText.SwitchOn" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="TurnOnAsync" />
}
else if (_person is null)
{
    @if (_progress is { State: ViewFaceStates.GettingTools }) { <p class="view-face-status">@ViewPeopleText.GettingTools</p> }
    else if (_progress is { State: ViewFaceStates.Looking }) { <p class="view-face-status">@ViewPeopleText.Looking(_progress.PhotosLooked, _progress.PhotosTotal)</p> }
    <ViewWhosThisRow Groups="@_unnamed" ProfileId="@_profileId" OnOpen="NameGroupAsync" />
}
<label class="view-search"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Search" /><AppNativeInput Type="search" Value="@_search" ValueChanged="SearchChanged" Placeholder="@L["ViewPeoplePage_SearchPeople"].Value" AriaLabel="@L["ViewPeoplePage_SearchPeople"].Value" /></label>
@if (_loading) { <AppPageState Kind="AppPageStateKind.Loading" Title="@L["ViewPeoplePage_LoadingPeople"].Value" Message="@L["ViewPeoplePage_LookingAtIndexedLocalMetadata"].Value" /> }
else if (_page is null) { <AppErrorState Title="@L["ViewPeoplePage_PeopleCouldNotBeLoaded"].Value" Message="@L["ViewPeoplePage_NoResult"].Value" Retry="LoadAsync" /> }
else if (_page.Items.Count == 0 && _unnamed.Count == 0 && _progress is { State: ViewFaceStates.Looking or ViewFaceStates.GettingTools }) { <AppPageState Kind="AppPageStateKind.Empty" Title="@ViewPeopleText.EmptyTitle" Message="@ViewPeopleText.EmptyLooking" /> }
else if (_page.Items.Count == 0 && _unnamed.Count == 0 && _progress is not { State: ViewFaceStates.Off }) { <AppPageState Kind="AppPageStateKind.Empty" Title="@(_page.Capability.State == ViewDiscoveryCapabilityStates.NoMatches ? L["ViewPeoplePage_NoMatch"].Value : L["ViewPeoplePage_NoPeople"].Value)" Message="@_page.Capability.Message" /> }
else if (_page.Items.Count == 0 && _person is null) { }
else if (_person is not null)
{
    <AppButton Label="@L["ViewPeoplePage_AllPeople"].Value" OnClick="ClosePerson" />
    <div class="view-person-header">
        <ViewFaceImage FaceId="@_group?.CoverFaceId" ProfileId="@_profileId" />
        <div class="view-person-header__text">
            <h2>@_person.DisplayName</h2>
            <small>@ViewPeopleText.Photos(_person.AssetCount)</small>
        </div>
        @if (_group is not null && Workspace.ScopeKind == ViewScopeKind.Mine && EditorHost.CanEdit)
        {
            <AppOverflowMenu AriaLabel="@_person.DisplayName" SheetTitle="@_person.DisplayName">
                <AppMenuItem Label="@ViewPeopleText.Rename" Icon="@AppMaterialIcons.Outlined.Edit" OnClick="RenamePersonAsync" />
                <AppMenuItem Label="@ViewPeopleText.MergeWith" OnClick="MergePersonAsync" />
                <AppMenuItem Label="@ViewPeopleText.ChooseCover" OnClick="ChooseCoverAsync" />
                <AppMenuItem Label="@(_group.Hidden ? ViewPeopleText.Unhide : ViewPeopleText.Hide)" OnClick="ToggleHiddenAsync" DividerBefore="true" />
                <AppMenuItem Label="@ViewPeopleText.RemoveEverywhere" Icon="@AppMaterialIcons.Outlined.Delete" OnClick="RemovePersonAsync" />
            </AppOverflowMenu>
        }
    </div>
    @if (_mediaLoading) { <AppPageState Kind="AppPageStateKind.Loading" Title="@L["ViewPeoplePage_LoadingPhotos"].Value" /> }
    else if (_media is null) { <AppErrorState Title="@L["Common_PhotosCouldNotBeLoaded"].Value" Retry="@(() => OpenPersonAsync(_person))" /> }
    else
    {
        <ViewPhotoTimeline Items="@_media.Items" Selected="@_selected" ThumbnailUrl="@(item => Thumbnail(item.LibraryId, item.Id))" OnOpen="@(item => _active = item)" OnToggleSelection="ToggleSelection" OnSelectDateGroup="SelectGroup" />
        @if (_selected.Count > 0) { <ViewSelectionToolbar Count="@_selected.Count" OnClear="@(() => _selected.Clear())" OnFavorite="FavoriteSelectionAsync" FavoriteRemoves="@AllSelectedFavorite" /> }
        @if (_media.HasMore) { <AppButton Label="@L["ViewPeoplePage_LoadMorePhotos"].Value" Disabled="@_mediaLoadingMore" OnClick="LoadMoreMediaAsync" /> }
    }
}
else { <section class="view-discovery-grid" aria-label="@L["Wikidata_PeopleGroupTitle"].Value">@foreach (var person in _page.Items) { <AppNativeButton Class="view-discovery-card" AriaLabel="@($"View photos of {person.DisplayName}")" OnClick="@(_ => OpenPersonAsync(person))"><img src="@Thumbnail(person.RepresentativeLibraryId, person.RepresentativeAssetId)" alt="" loading="lazy" /><strong>@person.DisplayName</strong><span>@L["ViewPeoplePage_MediaItems", person.AssetCount]</span>@if (person.HasReviewedEvidence) { <small>@L["ViewPeoplePage_ReviewedIdentity"]</small> }</AppNativeButton> }</section>@if (_page.HasMore) { <AppButton ButtonStyle="AppButtonStyle.Outlined" OnClick="LoadMoreAsync">@L["Common_LoadMore"]</AppButton> } }
@if (_person is null && _hiddenGroups.Count > 0)
{
    <div class="view-people-hidden">
        <AppCheckbox Value="@_showHidden" ValueChanged="@(value => _showHidden = value)" Label="@ViewPeopleText.ShowHidden" />
        @if (_showHidden)
        {
            <ul class="view-face-grid">
                @foreach (var hidden in _hiddenGroups)
                {
                    <li @key="hidden.PersonId">
                        <AppNativeButton Type="button" Class="view-face-tile" AriaLabel="@ViewPeopleText.Unhide" OnClick="@(_ => UnhideAsync(hidden))">
                            <ViewFaceImage FaceId="@hidden.CoverFaceId" ProfileId="@_profileId" />
                            <span>@hidden.Name</span>
                        </AppNativeButton>
                    </li>
                }
            </ul>
        }
    </div>
}
@if (_person is null && _progress is not null && Workspace.ScopeKind == ViewScopeKind.Mine && EditorHost.CanEdit)
{
    <ViewPeopleSettings Progress="@_progress" OnChanged="ReloadAfterChangeAsync" />
}
</ViewContentPage></ViewSectionShell>
@if (_active is not null)
{
    <ViewImmersiveViewer Item="@_active" ContentUrl="@Resource(_active, ViewMediaResourceKind.Preview)" OriginalUrl="@Resource(_active, ViewMediaResourceKind.Content)"
        ThumbnailUrl="@Thumbnail(_active.LibraryId, _active.Id)" OnClose="@(() => _active = null)" MotionUrl="@MotionUrl(_active)"
        HasPrevious="@(ActiveIndex > 0)" HasNext="@(ActiveIndex >= 0 && (ActiveIndex < (_media?.Items.Count ?? 0) - 1 || _media?.HasMore == true))"
        OnPrevious="PreviousItem" OnNext="NextItemAsync" PositionLabel="@($"{ActiveIndex + 1} of {_media?.Items.Count ?? 0}{(_media?.HasMore == true ? "+" : "")}")"
        CanEdit="@(Workspace.ScopeKind == ViewScopeKind.Mine)" OnItemUpdated="UpdateItem"
        Actions="@ActionsFor(_active)" OnFavorite="ToggleFavoriteAsync" OnArchive="ArchiveActiveAsync" OnTrash="TrashActiveAsync" />
}
@code {
    private ViewPersonDto? _person;
    private ViewAssetTimelinePageDto? _media;
    private LocalAssetDto? _active;
    private bool _mediaLoading;
    private bool _mediaLoadingMore;
    private int _mediaVersion;
    private int ActiveIndex => _active is null ? -1 : _media?.Items.ToList().FindIndex(item => item.Id == _active.Id) ?? -1;
    private void ClosePerson() { ++_mediaVersion; _person = null; _group = null; _active = null; _selected.Clear(); }
    private void PreviousItem() { if (ActiveIndex > 0) _active = _media!.Items[ActiveIndex - 1]; }
    private async Task NextItemAsync()
    {
        var index = ActiveIndex; var version = _mediaVersion; var id = _active?.Id;
        if (index < 0) return;
        if (index == (_media?.Items.Count ?? 0) - 1 && _media?.HasMore == true) await LoadMoreMediaAsync();
        if (version == _mediaVersion && _active?.Id == id && index + 1 < (_media?.Items.Count ?? 0)) _active = _media!.Items[index + 1];
    }
    private string? MotionUrl(LocalAssetDto item) => item.Files.Any(file => file.Role == "live_photo_video") && _profileId.HasValue
        ? $"/view-media/{MediaGrants.Create(_profileId.Value, item.LibraryId, item.Id, ViewMediaResourceKind.Content, ViewMediaResourceRole.LivePhotoVideo, Workspace.ScopeKind, Workspace.ScopeProfileId).Value}" : null;
    private readonly HashSet<Guid> _selected = [];
    private IEnumerable<LocalAssetDto> SelectedItems => _media?.Items.Where(item => _selected.Contains(item.Id)) ?? [];
    private bool AllSelectedFavorite => SelectedItems.Any() && SelectedItems.All(item => item.Favorite);
    private ViewActions ActionsFor(LocalAssetDto item) => ViewActionPolicy.For(new ViewActionContext(
        ViewActionPolicy.OwnershipOf(Workspace.ScopeKind, item.AddedByProfileId, _profileId),
        EditorHost.CanEdit, item.FileMissing, item.CanTrash,
        item.ArchivedAt.HasValue, item.TrashedAt.HasValue, item.Hidden, DeviceMayEditItems: EditorHost.CanEdit));
    private async Task FavoriteSelectionAsync()
    {
        var value = !AllSelectedFavorite;
        foreach (var item in SelectedItems.ToArray())
        {
            if (await ApiClient.SetViewItemFavoriteAsync(item.Id, value)) { _selected.Remove(item.Id); ReplaceItem(item with { Favorite = value }); }
            else Ribbon.Add(L["ViewPage_ChangeFailed"].Value, AppSeverity.Error);
        }
    }
    private void ReplaceItem(LocalAssetDto item) { if (_active?.Id == item.Id) _active = item; if (_media is not null) _media = _media with { Items = _media.Items.Select(value => value.Id == item.Id ? item : value).ToList() }; }
    private async Task ToggleFavoriteAsync()
    {
        if (_active is not { } item) return;
        var value = !item.Favorite;
        if (await ApiClient.SetViewItemFavoriteAsync(item.Id, value)) { ReplaceItem(item with { Favorite = value }); Ribbon.Add(L[value ? "ViewPage_FavoriteAdded" : "ViewPage_FavoriteRemoved"].Value, AppSeverity.Success); }
        else Ribbon.Add(L["ViewPage_ChangeFailed"].Value, AppSeverity.Error);
    }
    private async Task ArchiveActiveAsync()
    {
        if (_active is not { } item || !await ViewTrashConfirmation.AskArchiveAsync(DialogService)) return;
        if (await ApiClient.ArchiveViewItemAsync(item.Id)) { RemoveItem(item); Ribbon.Add(L["ViewPage_ItemArchived"].Value, AppSeverity.Success); }
        else Ribbon.Add(L["ViewPage_ArchiveFailed"].Value, AppSeverity.Error);
    }
    private async Task TrashActiveAsync()
    {
        // Move to Trash is offered only where the device may edit items (never a TV), and never for an item in a read-only folder.
        if (!EditorHost.CanEdit) { Ribbon.Add(EditorDeviceRule.ItemMessage, AppSeverity.Warning); return; }
        if (_active is not { CanTrash: true } item || !await ViewTrashConfirmation.AskTrashAsync(DialogService)) return;
        if (await ApiClient.TrashViewItemAsync(item.Id, default)) { RemoveItem(item); Ribbon.Add(L["ViewPage_MovedToTrash"].Value, AppSeverity.Success); }
        else Ribbon.Add(L["ViewPage_ItemCouldNotBeMovedToTrash"].Value, AppSeverity.Error);
    }
    private void RemoveItem(LocalAssetDto item) { _active = null; _selected.Remove(item.Id); if (_media is not null) _media = _media with { Items = _media.Items.Where(value => value.Id != item.Id).ToList() }; }
    private void ToggleSelection(Guid id) { if (!_selected.Add(id)) _selected.Remove(id); }
    private void SelectGroup(IReadOnlyCollection<Guid> ids) { if (ids.All(_selected.Contains)) _selected.ExceptWith(ids); else _selected.UnionWith(ids); }
    private void UpdateItem(LocalAssetDto item) { _active = item; if (_media is not null) _media = _media with { Items = _media.Items.Select(value => value.Id == item.Id ? item : value).ToList() }; }
    private string Resource(LocalAssetDto item, ViewMediaResourceKind kind) => _profileId.HasValue ? $"/view-media/{MediaGrants.Create(_profileId.Value, item.LibraryId, item.Id, kind, scopeKind: Workspace.ScopeKind, scopeProfileId: Workspace.ScopeProfileId).Value}" : "";
    private async Task OpenPersonAsync(ViewPersonDto person)
    {
        var version = ++_mediaVersion;
        _person = person; _group = GroupFor(person); _mediaLoading = true; _selected.Clear();
        var page = await ApiClient.GetViewAssetsAsync(new(Workspace.ScopeKind, Workspace.ScopeProfileId, PersonKey: person.Key));
        if (version != _mediaVersion) return;
        _media = page; _mediaLoading = false;
    }
    private async Task LoadMoreMediaAsync()
    {
        if (_media?.NextCursor is null || _person is null || _mediaLoadingMore) return;
        var version = _mediaVersion;
        _mediaLoadingMore = true;
        try
        {
            var page = await ApiClient.GetViewAssetsAsync(new(Workspace.ScopeKind, Workspace.ScopeProfileId, Cursor: _media.NextCursor, PersonKey: _person.Key));
            if (version == _mediaVersion && page is not null) _media = page with { Items = [.. _media.Items, .. page.Items] };
        }
        finally { _mediaLoadingMore = false; }
    }
    private ViewFaceProgressDto? _progress;
    private IReadOnlyList<ViewFaceGroupDto> _unnamed = [];
    private IReadOnlyList<ViewFaceGroupDto> _namedGroups = [];
    private ViewFaceGroupDto? _group;
    private bool _showHidden;
    private IReadOnlyList<ViewFaceGroupDto> _hiddenGroups => _namedGroups.Where(group => group.Hidden).ToList();
    private async Task UnhideAsync(ViewFaceGroupDto group)
    {
        if (await ApiClient.HideViewFacePersonAsync(group.PersonId, false)) { await ReloadAfterChangeAsync(); }
        else Ribbon.Add(ViewPeopleText.CouldNotSave, AppSeverity.Error);
    }
    private async Task LoadFacesAsync()
    {
        _progress = await ApiClient.GetViewFaceProgressAsync();
        await Workspace.RefreshPeopleWaitingAsync();
        if (_progress is null or { State: ViewFaceStates.Off } || Workspace.ScopeKind != ViewScopeKind.Mine)
        {
            _unnamed = [];
            _namedGroups = [];
            return;
        }

        var unnamed = await ApiClient.GetViewFaceGroupsAsync(false, false, 12);
        var named = await ApiClient.GetViewFaceGroupsAsync(true, true, 200);
        _unnamed = unnamed?.Items ?? [];
        _namedGroups = named?.Items ?? [];
        if (_person is not null) { _group = GroupFor(_person); }
    }
    private ViewFaceGroupDto? GroupFor(ViewPersonDto person) =>
        _namedGroups.FirstOrDefault(group => string.Equals(group.Name, person.DisplayName, StringComparison.OrdinalIgnoreCase));
    private async Task TurnOnAsync()
    {
        if (!await ApiClient.SetViewRecognizePeopleAsync(true)) { Ribbon.Add(ViewPeopleText.CouldNotSave, AppSeverity.Error); return; }
        await LoadFacesAsync();
    }
    private async Task NameGroupAsync(ViewFaceGroupDto group)
    {
        var dialog = await DialogService.ShowAsync<ViewNamePersonDialog>(string.Empty,
            new AppDialogParameters<ViewNamePersonDialog> { { component => component.PersonId, group.PersonId }, { component => component.ProfileId, _profileId } },
            new AppDialogOptions { NoHeader = true, FullWidth = true, MaxWidth = AppMaxWidth.Medium, Sheet = AppDialogSheetMode.PhoneAndTablet });
        if ((await dialog.Result) is { Canceled: false }) { await LoadFacesAsync(); await LoadAsync(); }
    }
    private async Task RenamePersonAsync()
    {
        if (_group is not { } group || _person is null) return;
        var dialog = await DialogService.ShowAsync<ViewNamePersonDialog>(string.Empty,
            new AppDialogParameters<ViewNamePersonDialog> { { component => component.PersonId, group.PersonId }, { component => component.CurrentName, group.Name }, { component => component.ProfileId, _profileId }, { component => component.OfferSuggestions, false } },
            new AppDialogOptions { NoHeader = true, FullWidth = true, MaxWidth = AppMaxWidth.Small, Sheet = AppDialogSheetMode.PhoneAndTablet });
        if ((await dialog.Result) is { Canceled: false }) { await ReloadAfterChangeAsync(); }
    }
    private async Task MergePersonAsync()
    {
        if (_group is not { } group) return;
        var others = _namedGroups.Where(other => other.PersonId != group.PersonId && !other.Hidden).Select(other => new ViewPickItem(other.PersonId, other.CoverFaceId, other.Name)).ToList();
        var chosen = await PickAsync(ViewPeopleText.PickMergeTitle, ViewPeopleText.NoOthers, others);
        if (chosen is not { } target) return;
        if (await ApiClient.MergeViewFacePeopleAsync(group.PersonId, target)) { await ReloadAfterChangeAsync(); }
        else Ribbon.Add(ViewPeopleText.CouldNotSave, AppSeverity.Error);
    }
    private async Task ChooseCoverAsync()
    {
        if (_group is not { } group) return;
        var faces = await ApiClient.GetViewFaceGroupFacesAsync(group.PersonId, 40);
        var items = faces?.Items.Select(face => new ViewPickItem(face.FaceId, face.FaceId, null)).ToList() ?? [];
        var chosen = await PickAsync(ViewPeopleText.PickCoverTitle, string.Empty, items);
        if (chosen is not { } faceId) return;
        if (await ApiClient.SetViewFacePersonCoverAsync(group.PersonId, faceId)) { await LoadFacesAsync(); }
        else Ribbon.Add(ViewPeopleText.CouldNotSave, AppSeverity.Error);
    }
    private async Task ToggleHiddenAsync()
    {
        if (_group is not { } group) return;
        if (await ApiClient.HideViewFacePersonAsync(group.PersonId, !group.Hidden)) { await LoadFacesAsync(); }
        else Ribbon.Add(ViewPeopleText.CouldNotSave, AppSeverity.Error);
    }
    private async Task RemovePersonAsync()
    {
        if (_group is not { } group || _person is null) return;
        var answer = await AppConfirmDialog.ShowAsync(DialogService, ViewPeopleText.RemoveTitle(_person.DisplayName), ViewPeopleText.RemoveMessage, ViewPeopleText.Remove, ViewPeopleText.Cancel, primaryDestructive: true);
        if (answer != AppConfirmResult.Primary) return;
        if (await ApiClient.DeleteViewFacePersonAsync(group.PersonId)) { ClosePerson(); await ReloadAfterChangeAsync(); }
        else Ribbon.Add(ViewPeopleText.CouldNotSave, AppSeverity.Error);
    }
    private async Task ReloadAfterChangeAsync()
    {
        await LoadAsync();
        await LoadFacesAsync();
        if (_person is not null)
        {
            _group = GroupFor(_person);
            if (_group is null) { ClosePerson(); }
        }
    }
    private async Task<Guid?> PickAsync(string title, string empty, IReadOnlyList<ViewPickItem> items)
    {
        var dialog = await DialogService.ShowAsync<ViewPickDialog>(string.Empty,
            new AppDialogParameters<ViewPickDialog> { { component => component.Title, title }, { component => component.Empty, empty }, { component => component.Items, items }, { component => component.ProfileId, _profileId } },
            new AppDialogOptions { NoHeader = true, FullWidth = true, MaxWidth = AppMaxWidth.Medium, Sheet = AppDialogSheetMode.PhoneAndTablet });
        return (await dialog.Result) is { Canceled: false, Data: Guid id } ? id : null;
    }
    private ViewPeoplePageDto? _page; private string _search = ""; private bool _loading = true; private Guid? _profileId;
    protected override async Task OnInitializedAsync() { Workspace.ScopeChanged += ScopeSwitchedAsync; await Workspace.InitializeAsync(); _profileId = (await Orchestrator.GetActiveProfileAsync())?.Id; await LoadAsync(); await LoadFacesAsync(); }
    private ViewDiscoveryQueryOptions Query(string? cursor = null) => new(Workspace.ScopeKind, Workspace.ScopeProfileId, _search, cursor);
    private int _peopleVersion;
    private bool _loadingMore;
    public void Dispose() => Workspace.ScopeChanged -= ScopeSwitchedAsync;
    private async Task ScopeSwitchedAsync() { await InvokeAsync(async () => { ++_mediaVersion; _person = null; _active = null; await LoadAsync(); await LoadFacesAsync(); StateHasChanged(); }); }
    private async Task LoadAsync() { var version = ++_peopleVersion; _loading = true; var page = await ApiClient.GetViewPeopleAsync(Query()); if (version != _peopleVersion) return; _page = page; _loading = false; }
    private async Task SearchChanged(object? value) { _search = value?.ToString() ?? ""; ++_mediaVersion; _person = null; _active = null; await LoadAsync(); }
    private async Task LoadMoreAsync() { if (_page?.NextCursor is null || _loadingMore) return; var version = _peopleVersion; _loadingMore = true; try { var next = await ApiClient.GetViewPeopleAsync(Query(_page.NextCursor)); if (version == _peopleVersion && next is not null) _page = next with { Items = [.. _page.Items, .. next.Items] }; } finally { _loadingMore = false; } }
    private string Thumbnail(Guid libraryId, Guid assetId) => _profileId.HasValue ? $"/view-media/{MediaGrants.Create(_profileId.Value, libraryId, assetId, ViewMediaResourceKind.Thumbnail, scopeKind: Workspace.ScopeKind, scopeProfileId: Workspace.ScopeProfileId).Value}" : "";
}
