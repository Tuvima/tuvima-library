@page "/read"
@page "/read/{Tab}"
@using MediaEngine.Web.Components.Browse
@using MediaEngine.Web.Components.MediaHub
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.MediaTiles
@inject MediaTileComposerService MediaTiles
@inject BrowseLibrariesState LibraryList

@namespace MediaEngine.Web.Components.Pages

<MediaLanePage Title="Read"
               RouteBase="/read"
               Subtitle="Books and comics from your local library"
               SearchPlaceholder="Search books and comics..."
               SectionType="MediaHubSectionType.Read"
               Preset="@Preset"
               Modes="@ReadModes"
               NavigationGroups="@ReadNavigationGroups"
               ActiveMode="@ActiveReadMode"
               Tab="@Tab"
               TabsLoading="@(!_tabsLoaded)"
               LandingPage="@_landingPage"
               Shelves="@ReadHubShelves"
               Loading="@_loading"
               LoadFailed="@_loadFailed"
               LoadFailedTitle="Read failed to load"
               LoadFailedMessage="The Dashboard could not load the Read landing from the Engine."
               EmptyTitle="No books or comics yet"
               EmptyMessage="Add reading material to your library to populate this lane."
               Retry="LoadLandingAsync" />

@code {
    [Parameter] public string? Tab { get; set; }

    private DiscoveryPageViewModel? _landingPage;
    private bool _loading = true;
    private bool _loadFailed;

    // The tabs follow the Engine's library list (one per library with folders); the fixed tabs stand in when it cannot be read, and the
    // page draws its header and a tab-strip skeleton while the list and the landing load side by side.
    private LibraryBrowsePreset Preset = StaticPreset;
    private bool _tabsLoaded;
    private bool _landingAttempted;

    private string ActiveReadMode => BrowseQueryBuilder.FindTab(Preset, Tab)?.Id ?? "all";

    private IReadOnlyList<MediaSectionNavigationGroup> ReadNavigationGroups =>
    [
        MediaLaneConfigurationBuilder.BuildLibraryGroup(Preset),
        new("Reading",
        [
            .. ShortcutTab is { } tab
                ? new MediaSectionNavigationItem[]
                {
                    new("In Progress", $"/read/{tab.Id}?status=in-progress", AppMaterialIcons.Outlined.Timelapse, Exact: true),
                    new("Unread", $"/read/{tab.Id}?status=not-started", AppMaterialIcons.Outlined.MarkEmailUnread, Exact: true),
                    new("Recently Added", $"/read/{tab.Id}?sort=newest", AppMaterialIcons.Outlined.Schedule, Exact: true),
                }
                : [],
        ]),
    ];

    // The tab the "Reading" shortcuts open: the Books tab, or the first tab when this profile has none.
    private BrowseTabPreset? ShortcutTab => BrowseQueryBuilder.FindTab(Preset, "books") ?? Preset.Tabs.FirstOrDefault();

    private IReadOnlyList<MediaHubModeViewModel> ReadModes =>
        MediaLaneConfigurationBuilder.BuildModes(Preset);

    private IReadOnlyList<MediaHubShelfViewModel> ReadHubShelves => _landingPage?.Shelves
        .Select(shelf => MediaHubShelfViewModel.FromShelf(shelf))
        .ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        var tabs = LoadTabsAsync();
        var landing = string.IsNullOrWhiteSpace(Tab) ? LoadLandingAsync() : Task.CompletedTask;
        await Task.WhenAll(tabs, landing);
    }

    private async Task LoadTabsAsync()
    {
        Preset = BrowseLibraryTabs.Build(StaticPreset, "read", await LibraryList.GetAsync());
        _tabsLoaded = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Tab) || _landingPage is not null)
        {
            _loading = false;
            return;
        }

        if (!_landingAttempted)
        {
            await LoadLandingAsync();
        }
    }

    private async Task LoadLandingAsync()
    {
        _landingAttempted = true;
        _loading = true;
        _loadFailed = false;

        try
        {
            _landingPage = await MediaTiles.BuildReadAsync();
        }
        catch
        {
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private static readonly LibraryBrowsePreset StaticPreset = new()
    {
        RouteBase = "/read",
        Title = "Read",
        HeroVariant = BrowseHeroVariant.Read,
        UseExplicitDefaultTabRoute = true,
        Tabs =
        [
            new BrowseTabPreset
            {
                Id = "books",
                Label = "Books",
                MediaType = "Books",
                GroupingOptions =
                [
                    new("all", "Books", AppMaterialIcons.Outlined.AutoStories),
                    new("authors", "Authors", AppMaterialIcons.Outlined.PersonOutline),
                    new("series", "Series", AppMaterialIcons.Outlined.CollectionsBookmark),
                    new("timeline", "Timeline", AppMaterialIcons.Outlined.Timeline),
                ],
                DefaultGrouping = "all",
                DefaultLayout = LibraryLayoutMode.Card,
                YearSemantic = "Original publication year",
            },
            new BrowseTabPreset
            {
                Id = "comics",
                Label = "Comics",
                MediaType = "Comics",
                GroupingOptions =
                [
                    new("series", "Volumes", AppMaterialIcons.Outlined.CollectionsBookmark),
                    new("all", "Issues", AppMaterialIcons.Outlined.ViewAgenda),
                    new("creators", "Creators", AppMaterialIcons.Outlined.PeopleOutline),
                    new("publishers", "Publishers", AppMaterialIcons.Outlined.Business),
                    new("timeline", "Timeline", AppMaterialIcons.Outlined.Timeline),
                ],
                DefaultGrouping = "series",
                DefaultLayout = LibraryLayoutMode.Card,
                YearSemantic = "Issue publication year",
            },
        ],
    };
}
