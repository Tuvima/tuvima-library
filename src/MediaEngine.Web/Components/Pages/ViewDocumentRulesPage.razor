@page "/view/documents/rules"
@using MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Services.Theming
@inject ViewWorkspaceService Workspace
@inject DeviceContextService Device
@implements IDisposable
@namespace MediaEngine.Web.Components.Pages
@inject IStringLocalizer<SharedStrings> L

<PageTitle>@L["ViewDocumentRulesPage_AutoFilingRulesLibrary"]</PageTitle>
<ViewSectionShell>
    <ViewContentPage Title="@L["Common_AutoFilingRules"].Value" Subtitle="@L["ViewDocumentRulesPage_FileNewDocumentsForYou"].Value" Class="view-documents-page">
        <HeaderActions>
            <AppButton Label="@L["Common_BackToDocuments"].Value" StartIcon="@AppMaterialIcons.Outlined.ArrowBack" ButtonStyle="AppButtonStyle.Outlined" Href="/view/documents" />
        </HeaderActions>
        <ChildContent>
            @if (!_ready)
            {
                <AppPageState Kind="AppPageStateKind.Loading" Title="@L["ViewDocumentRulesPage_LoadingRules"].Value" Message="@L["ViewDocumentRulesPage_ReadingYourAutoFilingRules"].Value" />
            }
            else if (Workspace.Scopes?.CanViewDocuments == false)
            {
                <AppPageState Kind="AppPageStateKind.Unavailable" Icon="@AppMaterialIcons.Outlined.Lock" Title="@L["Common_DocumentsAreNotAvailableFor"].Value" Message="@L["Common_AskAnAdministratorOfThis"].Value" Class="view-documents-denied" />
            }
            else if (Device.IsTv)
            {
                <AppPageState Kind="AppPageStateKind.Unavailable" Icon="@AppMaterialIcons.Outlined.DesktopAccessDisabled" Title="@L["ViewDocumentRulesPage_RulesAreNotAvailableHere"].Value" Message="@L["ViewDocumentRulesPage_UseAComputerOrTablet"].Value" />
            }
            else
            {
                @* Everyone with Documents reaches their own rules here; Settings > Libraries > View shows the same list to administrators. *@
                <DocumentRulesSettings ReadOnly="@(!Device.CanEdit)" />
            }
        </ChildContent>
    </ViewContentPage>
</ViewSectionShell>

@code {
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        Device.OnChanged += DeviceChanged;
        // The View shell owns loading the View settings; this page only waits for them.
        await Workspace.WhenReadyAsync();
        _ready = true;
    }

    private void DeviceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Device.OnChanged -= DeviceChanged;
}
