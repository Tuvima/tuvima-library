@page "/my-activity"
@namespace MediaEngine.Web.Components.Pages
@inject IStringLocalizer<SharedStrings> L

<PageTitle>@L["MyActivity_MyActivityLibrary"]</PageTitle>

@* The Activity page outside Settings (D16): a Kids profile has no Settings, and anyone can open their own list from the profile
   menu. It shows the signed-in person's own activity only, in the normal app layout, with no Scope and no delete. *@
<div class="my-activity-page">
    <header class="my-activity-page__header">
        <h1 class="my-activity-page__title">@L["MyActivity_MyActivity"]</h1>
        <p class="my-activity-page__lead">@L["MyActivity_EverythingYouHaveWatchedListened"]</p>
        <a class="my-activity-page__back" href="@ShellDock.MyLibraryPath">@L["Common_BackToMyLibrary"]</a>
    </header>
    <ActivityPage Standalone="true" />
</div>
