@page "/Error"
@using System.Diagnostics
@inject IStringLocalizer<SharedStrings> L

<PageTitle>@L["Error_Error"]</PageTitle>

<h1 class="text-danger">@L["Error_Error2"]</h1>
<h2 class="text-danger">@L["Error_AnErrorOccurredWhileProcessing"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@L["Error_RequestID"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@L["Error_DevelopmentMode"]</h3>
<p>
    @L["Error_SwappingTo"] <strong>@L["Error_Development"]</strong> @L["Error_EnvironmentWillDisplayMoreDetailed"]
</p>
<p>
    <strong>@L["Error_TheDevelopmentEnvironmentShouldnT"]</strong>
    @L["Error_ItCanResultInDisplaying"] <strong>@L["Error_Development"]</strong> @L["Error_EnvironmentBySettingThe"] <strong>@L["Error_ASPNETCOREENVIRONMENT"]</strong> @L["Error_EnvironmentVariableTo"] <strong>@L["Error_Development"]</strong>
    @L["Error_AndRestartingTheApp"]
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
