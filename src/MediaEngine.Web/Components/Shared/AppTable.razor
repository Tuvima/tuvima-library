@namespace MediaEngine.Web.Components.Shared

@inject IJSRuntime JS

<div class="@RootClass" @attributes="AdditionalAttributes">
    <table @ref="_table" class="app-table tl-table-root">
        @ChildContent
    </table>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Dense { get; set; }
    [Parameter] public bool Hover { get; set; }
    [Parameter] public bool Striped { get; set; }
    /// <summary>Stack rows as cards on phones (or phones and tablets). Cells declare their part with data-card-role.</summary>
    [Parameter] public AppTableCardsMode CardsOn { get; set; } = AppTableCardsMode.Never;
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _table;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (CardsOn == AppTableCardsMode.Never) return;
        try
        {
            // Cards mode re-lays rows out with display:block/grid; explicit roles keep the table semantics.
            await JS.InvokeVoidAsync("tuvimaTableCards.apply", _table);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; there is no page left to annotate.
        }
    }

    private string? CardsClass => CardsOn switch
    {
        AppTableCardsMode.Phone => "app-table-shell--cards",
        AppTableCardsMode.PhoneAndTablet => "app-table-shell--cards app-table-shell--cards-tablet",
        _ => null,
    };

    private string RootClass =>
        string.Join(" ", new[] { "app-table-shell", Dense ? "tl-table-dense" : null, Hover ? "tl-table-hover" : null, Striped ? "tl-table-striped" : null, CardsClass, Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
