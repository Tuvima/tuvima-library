@namespace MediaEngine.Web.Components.Shared
@using System.Linq

@if (HasContent)
{
    <div class="@RootClass">
        <span class="playback-timeline-meta-row__main">
            @if (!string.IsNullOrWhiteSpace(Icon))
            {
                <AppMaterialIcon Icon="@Icon" Class="playback-timeline-meta-row__icon" />
            }
            <strong>@Label</strong>
        </span>
        @if (!string.IsNullOrWhiteSpace(TrailingText))
        {
            <span class="playback-timeline-meta-row__trailing">@TrailingText</span>
        }
    </div>
}

@code {
    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? TrailingText { get; set; }

    [Parameter]
    public string Size { get; set; } = "standard";

    [Parameter]
    public string? Class { get; set; }

    // The audiobook's timeline labels (unified player v2 D9). The bar draws them in the mockup's order (elapsed, label, rail, time left) through
    // PlaybackSeekRail; Summary is the same line as one sentence ("Chapter 8 · 12:08 · −18:32"), which is what a screen reader hears
    // and what this row prints where there is no rail beside it.
    private const string Separator = " \u00B7 ";

    /// <summary>"Chapter 8" (chapter mode).</summary>
    public static string ChapterLabel(int number) => $"Chapter {number}";

    /// <summary>"Chapter 8 · 12:08 · −18:32" (chapter mode): the chapter, the time into it, and the time left in it.</summary>
    public static string ChapterSummary(int number, double elapsedSeconds, double remainingSeconds) =>
        string.Join(Separator, ChapterLabel(number), PlaybackSeekRail.Time(elapsedSeconds), PlaybackSeekRail.RemainingTime(remainingSeconds));

    /// <summary>"Book · 32%" (whole-book mode). The percentage rounds down, so it reads 100% only when the book is done.</summary>
    public static string BookLabel(double positionSeconds, double durationSeconds) =>
        $"Book{Separator}{BookPercent(positionSeconds, durationSeconds)}%";

    /// <summary>"Book · 32% · 6h 12m left" (whole-book mode).</summary>
    public static string BookSummary(double positionSeconds, double durationSeconds) =>
        string.Join(Separator, BookLabel(positionSeconds, durationSeconds), TimeLeft(durationSeconds - positionSeconds));

    /// <summary>"6h 12m left", "42m left" or "Less than a minute left".</summary>
    public static string TimeLeft(double seconds)
    {
        var total = (int)Math.Max(0, double.IsFinite(seconds) ? seconds : 0);
        var hours = total / 3600;
        var minutes = total / 60 % 60;
        return hours > 0 ? $"{hours}h {minutes}m left" : minutes > 0 ? $"{minutes}m left" : "Less than a minute left";
    }

    private static int BookPercent(double positionSeconds, double durationSeconds) =>
        durationSeconds > 0 && double.IsFinite(durationSeconds) && double.IsFinite(positionSeconds)
            ? (int)Math.Clamp(Math.Floor(positionSeconds / durationSeconds * 100d), 0d, 100d)
            : 0;

    private bool HasContent => !string.IsNullOrWhiteSpace(Label) || !string.IsNullOrWhiteSpace(TrailingText);

    private string NormalizedSize => Size switch
    {
        "compact" => "compact",
        "large" => "large",
        _ => "standard"
    };

    private string RootClass => string.Join(
        " ",
        new[]
        {
            "playback-timeline-meta-row",
            $"playback-timeline-meta-row--{NormalizedSize}",
            Class
        }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
