@namespace MediaEngine.Web.Components.Shared
@using System.Linq
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Services.Playback
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IStringLocalizer<SharedStrings> L
@inject IServiceProvider Services
@inject IJSRuntime JS

@* The body of the Sleep timer panel (unified player v2 D16; mockup screen 6). The top block is the countdown ("Stopping in" / 14:32 / "Playback will
   pause automatically."), or "Stopping at the end of chapter 8" for an end-of-chapter timer, or one quiet line while no timer runs. Under it come the
   four presets in a row (the running preset is filled), a hairline, and the End of chapter and Custom duration rows, each with a chevron. The countdown
   is worked out from the deadline the session holds and redrawn every second while the panel is open; it never keeps a clock of its own. *@
<div class="stv" data-sleep-timer-view>
    <div class="stv__status" data-sleep-status>
        @if (Remaining is { } remaining)
        {
            <span class="stv__caption">@L["SleepTimer_StoppingIn"]</span>
            <span class="stv__countdown" role="timer" data-sleep-countdown>@PlaybackSleepTimerChoices.FormatCountdown(remaining)</span>
            <span class="stv__caption stv__caption--after">@L["SleepTimer_PausesAutomatically"]</span>
        }
        else if (PlaybackSleepTimerChoices.IsEndOfChapter(State))
        {
            <span class="stv__stop" data-sleep-stop>@StopAtChapterText</span>
            <span class="stv__caption stv__caption--after">@L["SleepTimer_PausesAutomatically"]</span>
        }
        else if (PlaybackSleepTimerChoices.IsRunning(State))
        {
            <span class="stv__caption stv__caption--after">@L["SleepTimer_PausesAutomatically"]</span>
        }
        else
        {
            <span class="stv__caption stv__caption--after" data-sleep-idle>@L["SleepTimer_ChooseWhen"]</span>
        }
    </div>
    <div class="stv__presets" role="radiogroup" aria-label="@L["SleepTimer_Presets"].Value" @ref="_presets">
        @foreach (var preset in PlaybackSleepTimerChoices.Presets)
        {
            var minutes = preset;
            var chosen = PlaybackSleepTimerChoices.RunningPreset(State) == minutes;
            <AppNativeButton Type="button" Class="@(chosen ? "stv__preset is-selected" : "stv__preset")" role="radio" aria-checked="@(chosen ? "true" : "false")"
                             tabindex="@(minutes == TabStop ? 0 : -1)" data-sleep-preset="@minutes" OnClick="@(() => SelectionChanged.InvokeAsync(PlaybackSleepTimerChoices.ForMinutes(minutes)))">
                @L["SleepTimer_PresetMinutes", minutes]
            </AppNativeButton>
        }
    </div>
    <div class="stv__divider" role="separator"></div>
    @if (OffersEndOfChapter && Chapters.Count > 0)
    {
        <AppNativeButton Type="button" Class="stv__row" data-sleep-row="end-of-chapter" Disabled="@(!Availability.CanEndCurrent)" Tooltip="@EndOfChapterReason"
                         AriaLabel="@EndOfChapterLabel" OnClick="@(() => SelectionChanged.InvokeAsync(PlaybackSleepTimerChoices.ForEndOfChapter()))">
            <span class="stv__label">@L["SleepTimer_EndOfChapter"]</span>
            <span class="stv__value"><span class="stv__chevron"><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.ChevronRight" /></span></span>
        </AppNativeButton>
    }
    <AppNativeButton Type="button" Class="stv__row" data-sleep-row="custom" OnClick="OpenCustom">
        <span class="stv__label">@L["SleepTimer_Custom"]</span>
        <span class="stv__value"><span class="stv__chevron"><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.ChevronRight" /></span></span>
    </AppNativeButton>
</div>

@code {
    [Parameter, EditorRequired] public AudiobookSleepTimerStateDto State { get; set; } = new();
    [Parameter] public AudiobookSleepTimerAvailabilityDto Availability { get; set; } = new();
    [Parameter] public IReadOnlyList<PlaybackChapterDto> Chapters { get; set; } = [];
    [Parameter] public bool OffersEndOfChapter { get; set; } = true;
    [Parameter] public EventCallback<AudiobookSleepTimerSelectionDto> SelectionChanged { get; set; }

    [CascadingParameter] private PlaybackPanelNavigator? Navigator { get; set; }

    private ElementReference _presets;
    private IJSObjectReference? _roving;
    private ITimer? _tick;
    private bool _disposed;

    private TimeProvider Clock => Services.GetService<TimeProvider>() ?? TimeProvider.System;
    private TimeSpan? Remaining => PlaybackSleepTimerChoices.Remaining(State, Clock.GetUtcNow());

    // One Tab stop for the presets: the running one, or the first when none is; the arrow keys move between them (roving-focus.js).
    private int TabStop => PlaybackSleepTimerChoices.RunningPreset(State) ?? PlaybackSleepTimerChoices.Presets[0];

    private string StopAtChapterText => PlaybackSleepTimerChoices.TargetChapterNumber(State, Chapters) is { } number
        ? L["SleepTimer_StoppingAtChapter", number].Value
        : L["SleepTimer_StoppingAtChapterUnnumbered"].Value;

    private string? EndOfChapterReason => Availability.CanEndCurrent ? null : Availability.CurrentUnavailableReason ?? L["SleepTimer_NoChapterBoundary"].Value;

    private string EndOfChapterLabel => Availability.CanEndCurrent
        ? L["SleepTimer_EndOfChapter"].Value
        : L["SleepTimer_EndOfChapterUnavailable", EndOfChapterReason ?? string.Empty].Value;

    protected override void OnInitialized()
    {
        // The countdown redraws each second from the session's deadline; the timer exists only while the panel body does, so a closed panel costs nothing.
        _tick = Clock.CreateTimer(_ => _ = InvokeAsync(Tick), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void Tick()
    {
        if (!_disposed && State.Mode == AudiobookSleepTimerModes.Timer)
        {
            StateHasChanged();
        }
    }

    private Task OpenCustom()
    {
        Navigator?.Push(L["SleepTimer_CustomTitle"].Value, CustomBody);
        return Task.CompletedTask;
    }

    private RenderFragment CustomBody => @<SleepTimerCustomView OnSet="SetCustomAsync" />;

    private async Task SetCustomAsync(int minutes)
    {
        await SelectionChanged.InvokeAsync(PlaybackSleepTimerChoices.ForMinutes(minutes));
        Navigator?.Pop();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || !firstRender) return;
        try
        {
            _roving = await JS.InvokeAsync<IJSObjectReference>("import", "./js/roving-focus.js");
            await _roving.InvokeVoidAsync("attach", _presets, "[role=radio]");
        }
        catch (InvalidOperationException)
        {
            // Prerendering has no browser yet; the presets are ordinary buttons until the arrow keys attach.
        }
        catch (JSDisconnectedException)
        {
            // The circuit closed while the panel was drawing; there is nothing left to attach to.
        }
        catch (JSException)
        {
            // The arrow keys are a nicety (for example a stale cached module); Tab and Enter still reach every preset.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _tick?.Dispose();
        if (_roving is null) return;
        try { await _roving.DisposeAsync(); }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone, so the browser has dropped the listeners with the page.
        }
    }
}
