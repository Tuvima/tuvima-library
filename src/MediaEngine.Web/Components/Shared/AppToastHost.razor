@namespace MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Ui
@implements IAsyncDisposable
@inject AppToastService Toasts
@inject AppDialogService Dialogs
@inject IJSRuntime JS
<div @ref="_host" popover="manual" hidden="@(!Visible)" class="app-toast-host tl-snackbar-container" aria-label="Notifications">
    @if (Visible)
    {
    @foreach (var toast in Toasts.Toasts.Take(AppToastService.MaximumDisplayedToasts))
    {
        <div @key="toast.Id" class="app-toast tl-snackbar app-toast--@toast.Severity.ToString().ToLowerInvariant() @(toast.Hiding ? "app-toast--hiding" : null)" style="@ToastStyle(toast)" role="@(toast.Severity is AppSeverity.Error or AppSeverity.Warning ? "alert" : "status")" aria-atomic="true"
             @onmouseenter="() => Toasts.Pause(toast, true, true)" @onmouseleave="() => Toasts.Pause(toast, true, false)" @onfocusin="() => Toasts.Pause(toast, false, true)" @onfocusout="() => Toasts.Pause(toast, false, false)">
            <AppMaterialIcon Icon="@SeverityIcon(toast.Severity)" Class="app-toast__icon" />
            <span class="app-toast__message">@toast.Message</span>
            @if (!string.IsNullOrWhiteSpace(toast.Options.Action)) { <button class="app-toast__action" type="button" disabled="@toast.Busy" @onclick="() => Toasts.InvokeActionAsync(toast)">@toast.Options.Action</button> }
            @if (toast.Options.ShowCloseIcon) { <button class="app-toast__close" type="button" aria-label="Dismiss notification" @onclick="() => Toasts.Remove(toast)">×</button> }
        </div>
    }
    }
</div>
@code {
    [Parameter] public Guid? OwnerId { get; set; }
    private bool Visible => Toasts.Toasts.Count > 0 && Dialogs.ActiveFrameId == OwnerId;
    private ElementReference _host;
    private IJSObjectReference? _module;
    private static string ToastStyle(AppToast toast) => FormattableString.Invariant($"--toast-opacity:{Math.Clamp(toast.Options.MaximumOpacity, 0, 100) / 100d};--toast-show-duration:{Math.Max(0, toast.Options.ShowTransitionDuration)}ms;--toast-hide-duration:{Math.Max(0, toast.Options.HideTransitionDuration)}ms");
    private static string SeverityIcon(AppSeverity severity) => severity switch {
        AppSeverity.Success => AppMaterialIcons.Uncategorized.AlertSuccess,
        AppSeverity.Warning => AppMaterialIcons.Outlined.ReportProblem,
        AppSeverity.Error => AppMaterialIcons.Filled.ErrorOutline,
        AppSeverity.Info => AppMaterialIcons.Outlined.Info,
        _ => AppMaterialIcons.Outlined.EventNote,
    };
    protected override void OnInitialized() { Toasts.Changed += Refresh; Dialogs.Changed += Refresh; }
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/app-dialog.js"); await _module.InvokeVoidAsync("updateToastHost", _host, Visible); }
        catch (JSDisconnectedException) { }
    }
    public async ValueTask DisposeAsync()
    {
        Toasts.Changed -= Refresh; Dialogs.Changed -= Refresh;
        if (_module is not null) { try { await _module.InvokeVoidAsync("updateToastHost", _host, false); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
    }
}
