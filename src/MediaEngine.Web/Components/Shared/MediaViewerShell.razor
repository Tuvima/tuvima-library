@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Contracts.LocalAssets
@inject IJSRuntime JS
@inject MediaEngine.Web.Services.Playback.PlaybackSessionController Playback
@implements IAsyncDisposable
@namespace MediaEngine.Web.Components.Shared

<MudFocusTrap DefaultFocus="DefaultFocus.FirstChild">
<div class="media-viewer" role="dialog" aria-modal="true" aria-label="Media viewer" tabindex="-1" @ref="_root" @onkeydown="HandleKeyAsync">
    <header class="media-viewer__bar">
        <div class="media-viewer__identity">
            @if (!string.IsNullOrWhiteSpace(Item.PositionLabel)) { <span>@Item.PositionLabel</span> }
            <strong>@Item.Title</strong>
            @if (!string.IsNullOrWhiteSpace(Item.Subtitle)) { <small>@Item.Subtitle</small> }
        </div>
        <div class="media-viewer__actions" role="toolbar" aria-label="Media actions">
            @if (Capabilities.CanFavorite) { <AppIconButton Icon="@(Capabilities.IsFavorite ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)" Tooltip="Favorite" AriaLabel="Toggle favorite" OnClick="OnFavorite" /> }
            @if (Capabilities.CanAddToGallery) { <AppNativeSelect Value="@string.Empty" OnChange="GalleryChanged" aria-label="Add item to Gallery"><option value="">Gallery…</option>@foreach (var gallery in Galleries) { <option value="@gallery.Id">@gallery.Name</option> }</AppNativeSelect> }
            @ContextActions
            @if (Capabilities.CanSlideshow) { <AppIconButton Icon="@(_slideshow ? Icons.Material.Filled.PauseCircle : Icons.Material.Outlined.Slideshow)" Tooltip="@(_slideshow ? "Pause slideshow" : "Start slideshow")" AriaLabel="@(_slideshow ? "Pause slideshow" : "Start slideshow")" OnClick="ToggleSlideshow" /> }
            @if (Capabilities.CanDownload) { <a class="media-viewer__icon-action" href="@Item.OriginalUrl" download aria-label="Download original" title="Download original"><MudIcon Icon="@Icons.Material.Outlined.Download" /></a> }
            @if (Capabilities.CanArchive) { <AppIconButton Icon="@Icons.Material.Outlined.Inventory2" Tooltip="Archive" AriaLabel="Archive item" OnClick="OnArchive" /> }
            @if (Capabilities.CanRestore) { <AppIconButton Icon="@Icons.Material.Outlined.Restore" Tooltip="Restore" AriaLabel="Restore item" OnClick="OnRestore" /> }
            @if (Capabilities.CanTrash) { <AppIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Tooltip="Move to Trash" AriaLabel="Move item to Trash" Tone="AppUiTone.Error" OnClick="OnTrash" /> }
            @if (Capabilities.CanShowInfo) { <AppIconButton Icon="@Icons.Material.Outlined.Info" Tooltip="Information" AriaLabel="Toggle information panel" OnClick="ToggleInfo" /> }
            <AppIconButton Icon="@Icons.Material.Outlined.Close" Tooltip="Close" AriaLabel="Close viewer" OnClick="CloseAsync" />
        </div>
    </header>
    <div class="media-viewer__body@(ShowInfo ? " has-info" : string.Empty)">
        <main class="media-viewer__canvas" @onclick:stopPropagation="true">
            @if (HasPrevious) { <AppIconButton Class="media-viewer__navigate media-viewer__navigate--previous" Icon="@Icons.Material.Outlined.ChevronLeft" Tooltip="Previous" AriaLabel="Previous item" OnClick="PreviousAsync" /> }
            <div class="media-viewer__stage" @ref="_stage">
                @if (Item.Kind == MediaViewerKind.Video)
                {
                    <video @key="Item.PreviewUrl" @ref="_video" autoplay playsinline src="@Item.PreviewUrl" poster="@Item.PosterUrl" preload="metadata"
                           @onloadedmetadata="UpdateVideoStateAsync" @ontimeupdate="UpdateVideoStateAsync" @onplay="UpdateVideoStateAsync" @onpause="UpdateVideoStateAsync"></video>
                    <div class="media-viewer__video-controls" role="group" aria-label="Personal video controls">
                        <div class="media-viewer__video-timeline">
                            <span>@FormatVideoTime(_videoPosition)</span>
                            <PlaybackRangeSlider Value="@_videoPosition" Min="0" Max="@Math.Max(1, _videoDuration)" Step="1" ShowTicks="false" AriaLabel="Video position" ValueFormatter="FormatVideoTime" ValueChanged="SeekVideoAsync" />
                            <span>@FormatVideoTime(_videoDuration)</span>
                        </div>
                        <div class="media-viewer__video-tools">
                            <PlaybackRelativeSkipButton Seconds="10" Direction="back" Size="compact" OnClick="@(() => SkipVideoAsync(-10))" />
                            <PlaybackPrimaryButton IsPlaying="@_videoIsPlaying" Size="standard" OnClick="ToggleVideoAsync" AriaLabel="@(_videoIsPlaying ? "Pause" : "Play")" />
                            <PlaybackRelativeSkipButton Seconds="10" Direction="forward" Size="compact" OnClick="@(() => SkipVideoAsync(10))" />
                            <AppNativeButton Type="button" OnClick="ToggleVideoMuteAsync" AriaLabel="@(_videoIsMuted ? "Unmute" : "Mute")"><MudIcon Icon="@(_videoIsMuted ? Icons.Material.Outlined.VolumeOff : Icons.Material.Outlined.VolumeUp)" /></AppNativeButton>
                            <PlaybackRangeSlider Value="@_videoVolume" Min="0" Max="1" Step="0.05" ShowTicks="false" AriaLabel="Volume" ValueChanged="SetVideoVolumeAsync" />
                            <AppNativeSelect Value="@_videoSpeed.ToString(System.Globalization.CultureInfo.InvariantCulture)" OnChange="SetVideoSpeedAsync" aria-label="Playback speed">
                                @foreach (var rate in new[] { 0.75, 1d, 1.25, 1.5, 2d })
                                {
                                    <option value="@rate.ToString(System.Globalization.CultureInfo.InvariantCulture)">@rate.ToString("0.##")×</option>
                                }
                            </AppNativeSelect>
                            @if (_videoTextTracks.Count > 0)
                            {
                                <AppNativeSelect Value="@(_videoTextTracks.FirstOrDefault(track => track.Selected)?.Index.ToString() ?? "-1")" OnChange="SelectVideoTextTrackAsync" aria-label="Subtitles">
                                    <option value="-1">Subtitles off</option>
                                    @foreach (var track in _videoTextTracks)
                                    {
                                        <option value="@track.Index">@track.Label</option>
                                    }
                                </AppNativeSelect>
                            }
                            @if (_videoAudioTracks.Count > 1)
                            {
                                <AppNativeSelect Value="@(_videoAudioTracks.FirstOrDefault(track => track.Selected)?.Index.ToString() ?? "0")" OnChange="SelectVideoAudioTrackAsync" aria-label="Audio track">
                                    @foreach (var track in _videoAudioTracks)
                                    {
                                        <option value="@track.Index">@track.Label</option>
                                    }
                                </AppNativeSelect>
                            }
                            @if (_videoCanPiP)
                            {
                                <AppNativeButton Type="button" OnClick="ToggleVideoPiPAsync" AriaLabel="Picture in picture"><MudIcon Icon="@Icons.Material.Outlined.PictureInPictureAlt" /></AppNativeButton>
                            }
                            @if (_videoCanFullscreen)
                            {
                                <AppNativeButton Type="button" OnClick="FullscreenAsync" AriaLabel="Fullscreen"><MudIcon Icon="@Icons.Material.Outlined.Fullscreen" /></AppNativeButton>
                            }
                        </div>
                    </div>
                }
                else if (Item.Kind == MediaViewerKind.Audio) { <div class="media-viewer__fallback"><MudIcon Icon="@Icons.Material.Outlined.AudioFile" /><audio @key="Item.PreviewUrl" autoplay src="@Item.PreviewUrl" controls preload="metadata"></audio></div> }
                else if (Item.Kind == MediaViewerKind.Document) { <div class="media-viewer__fallback"><MudIcon Icon="@Icons.Material.Outlined.Description" /><p>Download the original document to view it.</p></div> }
                else { <img src="@Item.PreviewUrl" alt="@(Item.AltText ?? Item.Title)" draggable="false" /> }
            </div>
            @if (HasNext) { <AppIconButton Class="media-viewer__navigate media-viewer__navigate--next" Icon="@Icons.Material.Outlined.ChevronRight" Tooltip="Next" AriaLabel="Next item" OnClick="NextAsync" /> }
            @if (Item.Kind == MediaViewerKind.Image && Capabilities.CanZoom)
            {
                <div class="media-viewer__zoom" role="toolbar" aria-label="Image zoom controls">
                    <AppIconButton Icon="@Icons.Material.Outlined.Remove" Tooltip="Zoom out" AriaLabel="Zoom out" OnClick="ZoomOutAsync" />
                    <span aria-live="polite">@ZoomLabel</span>
                    <AppIconButton Icon="@Icons.Material.Outlined.Add" Tooltip="Zoom in" AriaLabel="Zoom in" OnClick="ZoomInAsync" />
                    <AppIconButton Icon="@Icons.Material.Outlined.FitScreen" Tooltip="Fit to window" AriaLabel="Fit image to window" OnClick="FitAsync" />
                    <AppIconButton Icon="@Icons.Material.Outlined.Fullscreen" Tooltip="Fullscreen" AriaLabel="Enter fullscreen" OnClick="FullscreenAsync" />
                </div>
            }
        </main>
        @if (ShowInfo)
        {
            <aside class="media-viewer__info" aria-label="Media information">
                <header><h2>Info</h2><AppIconButton Icon="@Icons.Material.Outlined.Close" Tooltip="Close info" AriaLabel="Close information panel" OnClick="ToggleInfo" /></header>
                @InfoContent
            </aside>
        }
    </div>
</div>
</MudFocusTrap>

@code {
    [Parameter, EditorRequired] public MediaViewerItem Item { get; set; } = default!;
    [Parameter] public MediaViewerCapabilities Capabilities { get; set; } = new();
    [Parameter] public bool HasPrevious { get; set; }
    [Parameter] public bool HasNext { get; set; }
    [Parameter] public bool InfoInitiallyOpen { get; set; }
    [Parameter] public EventCallback<bool> InfoOpenChanged { get; set; }
    [Parameter] public IReadOnlyList<ViewGalleryDto> Galleries { get; set; } = [];
    [Parameter] public RenderFragment? InfoContent { get; set; }
    [Parameter] public RenderFragment? ContextActions { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnFavorite { get; set; }
    [Parameter] public EventCallback OnArchive { get; set; }
    [Parameter] public EventCallback OnRestore { get; set; }
    [Parameter] public EventCallback OnTrash { get; set; }
    [Parameter] public EventCallback<Guid> OnAddToGallery { get; set; }
    private ElementReference _root, _stage, _video; private IJSObjectReference? _module; private bool _initialized, _showInfo, _slideshow; private double _zoom = 1; private CancellationTokenSource? _slideshowCts;
    private string? _observedVideoUrl; private double _videoPosition, _videoDuration, _videoVolume = 1, _videoSpeed = 1; private bool _videoIsPlaying, _videoIsMuted, _videoCanPiP, _videoCanFullscreen;
    private IReadOnlyList<ViewerVideoTrack> _videoTextTracks = [], _videoAudioTracks = [];
    private string? _activeViewerMediaKey;
    private bool ShowInfo => _showInfo && Capabilities.CanShowInfo;
    private string ZoomLabel => _zoom <= 1 ? "Fit" : $"{_zoom * 100:0}%";
    protected override void OnInitialized() => _showInfo = InfoInitiallyOpen;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_initialized)
        {
            _initialized = true;
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/media-viewer.js");
            await _module.InvokeVoidAsync("initialize", _root, _stage);
        }
        if (Item.Kind == MediaViewerKind.Video && _observedVideoUrl != Item.PreviewUrl && _module is not null)
        {
            _observedVideoUrl = Item.PreviewUrl;
            _videoCanPiP = await _module.InvokeAsync<bool>("canVideoPiP", _video);
            _videoCanFullscreen = await _module.InvokeAsync<bool>("canVideoFullscreen", _root);
            await UpdateVideoStateAsync();
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        _zoom = 1;
        if (Item.Kind is MediaViewerKind.Video or MediaViewerKind.Audio && _activeViewerMediaKey != Item.Key)
        {
            _activeViewerMediaKey = Item.Key;
            if (Playback.IsVideoMode) Playback.ClosePlayer();
            else if (Playback.IsPlaying) await Playback.DispatchAsync(MediaEngine.Web.Services.Playback.PlaybackCommand.Pause());
        }
        if (_module is not null) await _module.InvokeVoidAsync("fit", _stage);
    }
    private async Task ToggleInfo()
    {
        _showInfo = !_showInfo;
        if (InfoOpenChanged.HasDelegate)
            await InfoOpenChanged.InvokeAsync(_showInfo);
    }
    private Task GalleryChanged(ChangeEventArgs args) => Guid.TryParse(args.Value?.ToString(), out var id) ? OnAddToGallery.InvokeAsync(id) : Task.CompletedTask;
    private async Task PreviousAsync() { await FitAsync(); await OnPrevious.InvokeAsync(); }
    private async Task NextAsync() { await FitAsync(); await OnNext.InvokeAsync(); }
    private async Task ZoomInAsync() { _zoom = Math.Min(4, _zoom <= 1 ? 1.25 : _zoom + .25); if (_module is not null) await _module.InvokeVoidAsync("setZoom", _stage, _zoom); }
    private async Task ZoomOutAsync() { _zoom = Math.Max(1, _zoom - .25); if (_module is not null) await _module.InvokeVoidAsync("setZoom", _stage, _zoom); }
    private async Task FitAsync() { _zoom = 1; if (_module is not null) await _module.InvokeVoidAsync("fit", _stage); }
    private async Task FullscreenAsync() { if (_module is not null) await _module.InvokeVoidAsync("fullscreen", _root); }
    private async Task UpdateVideoStateAsync()
    {
        if (_module is null || Item.Kind != MediaViewerKind.Video) return;
        var state = await _module.InvokeAsync<ViewerVideoState>("readVideoState", _video);
        _videoPosition = state.Position;
        _videoDuration = state.Duration;
        _videoIsPlaying = !state.Paused;
        _videoIsMuted = state.Muted;
        _videoVolume = state.Volume;
        _videoSpeed = state.Speed;
        _videoTextTracks = state.TextTracks ?? [];
        _videoAudioTracks = state.AudioTracks ?? [];
        await InvokeAsync(StateHasChanged);
    }
    private async Task ToggleVideoAsync() { if (_module is not null) await _module.InvokeVoidAsync("toggleVideo", _video); await UpdateVideoStateAsync(); }
    private async Task SeekVideoAsync(double position) { if (_module is not null) await _module.InvokeVoidAsync("seekVideo", _video, position); await UpdateVideoStateAsync(); }
    private Task SkipVideoAsync(double seconds) => SeekVideoAsync(_videoPosition + seconds);
    private async Task ToggleVideoMuteAsync() { if (_module is not null) await _module.InvokeVoidAsync("setVideoMuted", _video, !_videoIsMuted); await UpdateVideoStateAsync(); }
    private async Task SetVideoVolumeAsync(double volume) { if (_module is not null) await _module.InvokeVoidAsync("setVideoVolume", _video, volume); await UpdateVideoStateAsync(); }
    private async Task SetVideoSpeedAsync(ChangeEventArgs args) { if (double.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var speed) && _module is not null) await _module.InvokeVoidAsync("setVideoSpeed", _video, speed); await UpdateVideoStateAsync(); }
    private async Task SelectVideoTextTrackAsync(ChangeEventArgs args) { if (int.TryParse(args.Value?.ToString(), out var index) && _module is not null) await _module.InvokeAsync<bool>("selectVideoTextTrack", _video, index); await UpdateVideoStateAsync(); }
    private async Task SelectVideoAudioTrackAsync(ChangeEventArgs args) { if (int.TryParse(args.Value?.ToString(), out var index) && _module is not null) await _module.InvokeAsync<bool>("selectVideoAudioTrack", _video, index); await UpdateVideoStateAsync(); }
    private async Task ToggleVideoPiPAsync() { if (_module is not null) await _module.InvokeVoidAsync("toggleVideoPiP", _video); }
    private static string FormatVideoTime(double seconds) { var span = TimeSpan.FromSeconds(Math.Max(0, seconds)); return span.TotalHours >= 1 ? span.ToString(@"h\:mm\:ss") : span.ToString(@"m\:ss"); }
    private sealed record ViewerVideoTrack(int Index, string Label, string Language, bool Selected);
    private sealed record ViewerVideoState(double Position, double Duration, bool Paused, bool Muted, double Volume, double Speed,
        IReadOnlyList<ViewerVideoTrack>? TextTracks, IReadOnlyList<ViewerVideoTrack>? AudioTracks);
    private async Task CloseAsync() { if (_module is not null) await _module.InvokeVoidAsync("restoreFocus"); await OnClose.InvokeAsync(); }
    private void ToggleSlideshow()
    {
        if (_slideshow) { StopSlideshow(); return; }
        _slideshow = true; _slideshowCts = new CancellationTokenSource(); _ = RunSlideshowAsync(_slideshowCts.Token);
    }
    private async Task RunSlideshowAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(5), ct);
                if (!HasNext) { await InvokeAsync(StopSlideshow); return; }
                await InvokeAsync(NextAsync);
            }
        }
        catch (OperationCanceledException) { }
    }
    private void StopSlideshow() { _slideshow = false; _slideshowCts?.Cancel(); _slideshowCts?.Dispose(); _slideshowCts = null; }
    private async Task HandleKeyAsync(KeyboardEventArgs args)
    {
        if (_module is not null && await _module.InvokeAsync<bool>("isEditableFocus")) return;
        if (args.Key == "Escape") await CloseAsync();
        else if (Item.Kind == MediaViewerKind.Video && args.Key == "ArrowLeft") await SkipVideoAsync(-10);
        else if (Item.Kind == MediaViewerKind.Video && args.Key == "ArrowRight") await SkipVideoAsync(10);
        else if (args.Key == "ArrowLeft" && HasPrevious) await PreviousAsync();
        else if (args.Key == "ArrowRight" && HasNext) await NextAsync();
        else if (args.Key is "+" or "=") await ZoomInAsync();
        else if (args.Key == "-") await ZoomOutAsync();
        else if (args.Key == "0") await FitAsync();
        else if (args.Key.Equals("f", StringComparison.OrdinalIgnoreCase)) await FullscreenAsync();
        else if (Item.Kind == MediaViewerKind.Video && args.Key is " " or "k" or "K") await ToggleVideoAsync();
        else if (Item.Kind == MediaViewerKind.Video && args.Key.Equals("m", StringComparison.OrdinalIgnoreCase)) await ToggleVideoMuteAsync();
    }
    public async ValueTask DisposeAsync() { StopSlideshow(); if (_module is not null) { try { await _module.InvokeVoidAsync("dispose", _stage); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } } }
}
