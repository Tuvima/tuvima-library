@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Contracts.LocalAssets
@using MediaEngine.Web.Services.Playback
@inject IJSRuntime JS
@inject MediaEngine.Web.Services.Playback.PlaybackSessionController Playback
@inject MediaEngine.Web.Services.Playback.IUserPlaybackPreferencesAccessor PlaybackPreferences
@implements IAsyncDisposable
@namespace MediaEngine.Web.Components.Shared

<AppFocusTrap DefaultFocus="true">
<div class="media-viewer@(Item.Kind == MediaViewerKind.Video ? " media-viewer--video" : "")" role="dialog" aria-modal="true" aria-label="Media viewer" tabindex="-1" @ref="_root" @onkeydown="HandleKeyAsync"
     data-view-playback-asset="@ViewPlaybackAssetLabel" data-view-playback-surface="@ViewPlaybackSurfaceLabel" data-view-playback-playing="@ViewPlaybackPlayingLabel">
    <header class="media-viewer__bar" data-playback-chrome="@(Item.Kind == MediaViewerKind.Video ? "header" : null)" data-chrome-hold="@(Item.Kind == MediaViewerKind.Video ? "header" : null)">
        <div class="media-viewer__identity">
            @if (!string.IsNullOrWhiteSpace(Item.PositionLabel)) { <span>@Item.PositionLabel</span> }
            <strong>@Item.Title</strong>
            @if (!string.IsNullOrWhiteSpace(Item.Subtitle)) { <small>@Item.Subtitle</small> }
        </div>
            @ViewerActions
    </header>
    <div class="media-viewer__body@(ShowInfo ? " has-info" : string.Empty)">
        <main class="media-viewer__canvas" @onclick:stopPropagation="true">
            @if (HasPrevious) { <AppIconButton Class="media-viewer__navigate media-viewer__navigate--previous" Icon="@AppMaterialIcons.Outlined.ChevronLeft" Tooltip="Previous" AriaLabel="Previous item" OnClick="PreviousAsync" /> }
            <div class="media-viewer__stage" @ref="_stage">
                @if (Item.Kind == MediaViewerKind.Video)
                {
                    <video @key="Item.PreviewUrl" @ref="_video" autoplay playsinline src="@Item.PreviewUrl" poster="@Item.PosterUrl" preload="metadata"
                           @onclick="ToggleVideoAsync" @onloadedmetadata="UpdateVideoStateAsync" @ontimeupdate="UpdateVideoStateAsync" @onplay="UpdateVideoStateAsync" @onpause="UpdateVideoStateAsync"
                           @onended="UpdateVideoStateAsync" @onvolumechange="UpdateVideoStateAsync" @onratechange="UpdateVideoStateAsync"></video>
                    <PlaybackVideoChrome>

                        <BottomContent>
                            <PlaybackSeekRail Position="@_videoPosition" Duration="@_videoDuration" ValueChanged="SeekVideoAsync" Surface="video" />
                            <div class="playback-video-controls">
                            <div class="playback-video-controls__left">                            <PlaybackRelativeSkipButton Seconds="@_videoSkipBackSeconds" Direction="back" Size="compact" Class="media-viewer__video-skip" OnClick="@(() => SkipVideoAsync(-_videoSkipBackSeconds))" />
                            <PlaybackPrimaryButton Appearance="video" IsPlaying="@_videoIsPlaying" Size="standard" Class="media-viewer__video-play" OnClick="ToggleVideoAsync" AriaLabel="@(_videoIsPlaying ? "Pause" : "Play")" />
                            <PlaybackRelativeSkipButton Seconds="@_videoSkipForwardSeconds" Direction="forward" Size="compact" Class="media-viewer__video-skip" OnClick="@(() => SkipVideoAsync(_videoSkipForwardSeconds))" />

                            <span class="playback-video-controls__volume"><AppNativeButton Type="button" OnClick="ToggleVideoMuteAsync" AriaLabel="@(_videoIsMuted ? "Unmute" : "Mute")"><PlaybackUtilityGlyph Glyph="@(_videoIsMuted ? PlaybackUtilityGlyphKind.Mute : PlaybackUtilityGlyphKind.Volume)" /></AppNativeButton>
                            <AppRangeSlider Value="@_videoVolume" Min="0" Max="1" Step="0.05" ShowTicks="false" AriaLabel="Volume" ValueChanged="SetVideoVolumeAsync" /></span></div>
                            <div class="playback-video-controls__identity">@Item.Title</div>
                            <div class="playback-video-controls__right">
                            @if (_videoTextTracks.Count > 0)
                            {
                                <PlaybackPopover Title="Subtitles" ToolId="view-subtitles" Kind="video" Surface="video" ItemKey="@Item.PreviewUrl">
                                    <TriggerContent><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Captions" /></TriggerContent>
                                    <ChildContent><PlaybackSheetList>
                                        <PlaybackSheetRow IsActive="@(!_videoTextTracks.Any(track => track.Selected))" OnClick="@(() => SelectVideoTextTrackAsync(new ChangeEventArgs { Value = "-1" }))" AriaLabel="Subtitles off"><strong>Off</strong></PlaybackSheetRow>
                                        @foreach (var track in _videoTextTracks)
                                        {
                                            <PlaybackSheetRow IsActive="@track.Selected" OnClick="@(() => SelectVideoTextTrackAsync(new ChangeEventArgs { Value = track.Index.ToString() }))" AriaLabel="@($"Select {track.Label} subtitles")"><strong>@track.Label</strong></PlaybackSheetRow>
                                        }
                                    </PlaybackSheetList></ChildContent>
                                </PlaybackPopover>
                            }
                            <PlaybackSpeedControl Value="@_videoSpeed" ValueChanged="SetVideoSpeedAsync" Surface="video" />
                            @if (_videoAudioTracks.Count > 1)
                            {
                                <AppNativeSelect Value="@(_videoAudioTracks.FirstOrDefault(track => track.Selected)?.Index.ToString() ?? "0")" OnChange="SelectVideoAudioTrackAsync" aria-label="Audio track">
                                    @foreach (var track in _videoAudioTracks)
                                    {
                                        <option value="@track.Index">@track.Label</option>
                                    }
                                </AppNativeSelect>
                            }
                            @if (_videoCanPiP)
                            {
                                <AppNativeButton Type="button" OnClick="ToggleVideoPiPAsync" AriaLabel="Picture in picture"><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.PictureInPicture" /></AppNativeButton>
                            }
                            @if (_videoCanFullscreen)
                            {
                                <AppNativeButton Type="button" OnClick="FullscreenAsync" AriaLabel="Fullscreen"><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Fullscreen" /></AppNativeButton>
                            }
                            </div></div>
</BottomContent>
                    </PlaybackVideoChrome>
                }
                else if (Item.Kind == MediaViewerKind.Audio) { <div class="media-viewer__fallback"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.AudioFile" /><audio @key="Item.PreviewUrl" @ref="_audio" autoplay src="@Item.PreviewUrl" controls preload="metadata" @onloadedmetadata="UpdateAudioStateAsync" @ontimeupdate="UpdateAudioStateAsync" @onplay="UpdateAudioStateAsync" @onpause="UpdateAudioStateAsync" @onended="UpdateAudioStateAsync" @onvolumechange="UpdateAudioStateAsync" @onratechange="UpdateAudioStateAsync"></audio></div> }
                else if (Item.Kind == MediaViewerKind.Document) { <div class="media-viewer__fallback"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Description" /><p>Download the original document to view it.</p></div> }
                else { <img src="@Item.PreviewUrl" alt="@(Item.AltText ?? Item.Title)" draggable="false" /> }
            </div>
            @if (HasNext) { <AppIconButton Class="media-viewer__navigate media-viewer__navigate--next" Icon="@AppMaterialIcons.Outlined.ChevronRight" Tooltip="Next" AriaLabel="Next item" OnClick="NextAsync" /> }
            @if (Item.Kind == MediaViewerKind.Image && Capabilities.CanZoom)
            {
                <div class="media-viewer__zoom" role="toolbar" aria-label="Image zoom controls">
                    <AppIconButton Icon="@AppMaterialIcons.Outlined.Remove" Tooltip="Zoom out" AriaLabel="Zoom out" OnClick="ZoomOutAsync" />
                    <span aria-live="polite">@ZoomLabel</span>
                    <AppIconButton Icon="@AppMaterialIcons.Outlined.Add" Tooltip="Zoom in" AriaLabel="Zoom in" OnClick="ZoomInAsync" />
                    <AppIconButton Icon="@AppMaterialIcons.Outlined.FitScreen" Tooltip="Fit to window" AriaLabel="Fit image to window" OnClick="FitAsync" />
                    <AppIconButton Icon="@AppMaterialIcons.Outlined.Fullscreen" Tooltip="Fullscreen" AriaLabel="Enter fullscreen" OnClick="FullscreenAsync" />
                </div>
            }
        </main>
        @if (ShowInfo)
        {
            <aside class="media-viewer__info" aria-label="Media information">
                <header><h2>Info</h2></header>
                @InfoContent
            </aside>
        }
    </div>
</div>
</AppFocusTrap>

@code {
    private RenderFragment ViewerActions => @<div class="media-viewer__actions" role="toolbar" aria-label="Media actions">
            @if (Capabilities.CanFavorite) { <AppIconButton Icon="@(Capabilities.IsFavorite ? AppMaterialIcons.Filled.Favorite : AppMaterialIcons.Outlined.FavoriteBorder)" Tooltip="Favorite" AriaLabel="Toggle favorite" OnClick="OnFavorite" /> }
            @if (Capabilities.CanAddToGallery) { <AppNativeSelect Value="@string.Empty" OnChange="GalleryChanged" aria-label="Add item to Gallery"><option value="">Gallery…</option>@foreach (var gallery in Galleries) { <option value="@gallery.Id">@gallery.Name</option> }</AppNativeSelect> }
            @ContextActions
            @if (Capabilities.CanSlideshow) { <AppIconButton Icon="@(_slideshow ? AppMaterialIcons.Filled.PauseCircle : AppMaterialIcons.Outlined.Slideshow)" Tooltip="@(_slideshow ? "Pause slideshow" : "Start slideshow")" AriaLabel="@(_slideshow ? "Pause slideshow" : "Start slideshow")" OnClick="ToggleSlideshow" /> }
            @if (Capabilities.CanDownload) { <a class="media-viewer__icon-action" href="@Item.OriginalUrl" download aria-label="Download original" title="Download original"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Download" /></a> }
            @if (Capabilities.CanArchive) { <AppIconButton Icon="@AppMaterialIcons.Outlined.Inventory2" Tooltip="Archive" AriaLabel="Archive item" OnClick="OnArchive" /> }
            @if (Capabilities.CanRestore) { <AppIconButton Icon="@AppMaterialIcons.Outlined.Restore" Tooltip="Restore" AriaLabel="Restore item" OnClick="OnRestore" /> }
            @if (Capabilities.CanTrash) { <AppIconButton Icon="@AppMaterialIcons.Outlined.DeleteOutline" Tooltip="Move to Trash" AriaLabel="Move item to Trash" Tone="AppUiTone.Error" OnClick="OnTrash" /> }
            @if (Capabilities.CanShowInfo) { <AppIconButton Icon="@AppMaterialIcons.Outlined.Info" Tooltip="@(ShowInfo ? "Hide information" : "Show information")" AriaLabel="Toggle information panel" aria-pressed="@(ShowInfo ? "true" : "false")" OnClick="ToggleInfo" /> }
            <AppIconButton Icon="@AppMaterialIcons.Outlined.Close" Tooltip="Close" AriaLabel="Close viewer" OnClick="CloseAsync" />
        </div>;

    [Parameter, EditorRequired] public MediaViewerItem Item { get; set; } = default!;
    [Parameter] public MediaViewerCapabilities Capabilities { get; set; } = new();
    [Parameter] public bool IsViewPlayback { get; set; }
    [Parameter] public bool HasPrevious { get; set; }
    [Parameter] public bool HasNext { get; set; }
    [Parameter] public bool InfoInitiallyOpen { get; set; }
    [Parameter] public EventCallback<bool> InfoOpenChanged { get; set; }
    [Parameter] public IReadOnlyList<ViewGalleryDto> Galleries { get; set; } = [];
    [Parameter] public RenderFragment? InfoContent { get; set; }
    [Parameter] public RenderFragment? ContextActions { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnFavorite { get; set; }
    [Parameter] public EventCallback OnArchive { get; set; }
    [Parameter] public EventCallback OnRestore { get; set; }
    [Parameter] public EventCallback OnTrash { get; set; }
    [Parameter] public EventCallback<Guid> OnAddToGallery { get; set; }
    private IJSObjectReference? _chromeModule;
    private ElementReference _root, _stage, _video, _audio; private IJSObjectReference? _module; private DotNetObjectReference<MediaViewerShell>? _videoPresentationReference; private bool _initialized, _showInfo, _slideshow; private double _zoom = 1; private CancellationTokenSource? _slideshowCts;
    private string? _observedVideoUrl; private double _videoPosition, _videoDuration, _videoVolume = 1, _videoSpeed = 1; private bool _videoIsPlaying, _videoIsMuted, _videoCanPiP, _videoCanFullscreen;
    private int _videoSkipBackSeconds = 10, _videoSkipForwardSeconds = 30;
    private IReadOnlyList<ViewerVideoTrack> _videoTextTracks = [], _videoAudioTracks = [];
    private string? _activeViewerMediaKey;
    private MediaViewerKind? _activeViewerKind;
    private bool _activeViewerIsVideo;
    private Guid? _activeViewAssetId;
    private double _lastViewPosition = double.NaN;
    private double _lastViewVolume = double.NaN, _lastViewSpeed = double.NaN;
    private bool? _lastViewIsPlaying;
    private bool? _lastViewIsMuted;
    private PlaybackPresentationSurface? _lastViewPresentationSurface;
    private bool ShowInfo => _showInfo && Capabilities.CanShowInfo;
    private ViewPlaybackSessionState? ActiveViewSession =>
        IsViewPlayback && _activeViewAssetId is { } assetId && Playback.ViewSession?.AssetId == assetId
            ? Playback.ViewSession
            : null;
    private string? ViewPlaybackAssetLabel => ActiveViewSession?.AssetId.ToString("D");
    private string? ViewPlaybackSurfaceLabel => ActiveViewSession?.PresentationSurface.ToString();
    private string? ViewPlaybackPlayingLabel => ActiveViewSession?.IsPlaying.ToString().ToLowerInvariant();
    private string ZoomLabel => _zoom <= 1 ? "Fit" : $"{_zoom * 100:0}%";
    protected override async Task OnInitializedAsync()
    {
        _showInfo = InfoInitiallyOpen;
        Playback.Changed += HandlePlaybackChanged;
        var preferences = await PlaybackPreferences.GetAsync();
        _videoSkipBackSeconds = preferences?.Watching.SkipBackSeconds ?? _videoSkipBackSeconds;
        _videoSkipForwardSeconds = preferences?.Watching.SkipForwardSeconds ?? _videoSkipForwardSeconds;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_initialized)
        {
            _initialized = true;
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/media-viewer.js");
            await _module.InvokeVoidAsync("initialize", _root, _stage);
        }
        if (Item.Kind == MediaViewerKind.Video && _observedVideoUrl != Item.PreviewUrl && _module is not null)
        {
            _chromeModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-chrome.js");
            await _chromeModule.InvokeVoidAsync("detach", _root);
            await _chromeModule.InvokeVoidAsync("attach", _root, _video);
            _observedVideoUrl = Item.PreviewUrl;
            _videoCanPiP = await _module.InvokeAsync<bool>("canVideoPiP", _video);
            _videoCanFullscreen = await _module.InvokeAsync<bool>("canVideoFullscreen", _root);
            _videoPresentationReference ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("observeVideoPresentation", _video, _root, _videoPresentationReference);
            await UpdateVideoStateAsync();
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        _zoom = 1;
        var isViewerPlayback = Item.Kind is MediaViewerKind.Video or MediaViewerKind.Audio;
        var viewAssetId = ViewAssetId;
        if (isViewerPlayback && (_activeViewerMediaKey != Item.Key || _activeViewerKind != Item.Kind))
        {
            await ReleaseActiveViewerTransportAsync();

            EndActiveViewSession();

            _activeViewerMediaKey = Item.Key;
            _activeViewerKind = Item.Kind;
            _activeViewerIsVideo = Item.Kind == MediaViewerKind.Video;
            if (_activeViewerIsVideo)
                ResetVideoState();
            else
                ResetViewTransportReporting();

            if (viewAssetId.HasValue)
            {
                _activeViewAssetId = viewAssetId;
                await Playback.BeginViewSessionAsync(viewAssetId.Value, _activeViewerIsVideo ? ViewPlaybackKind.Video : ViewPlaybackKind.Audio);
            }
            else if (Playback.IsVideoMode) Playback.ClosePlayer();
            else if (Playback.IsPlaying) await Playback.DispatchAsync(PlaybackCommand.Pause());
        }
        else if (!isViewerPlayback && _activeViewerMediaKey is not null)
        {
            await ReleaseActiveViewerTransportAsync();

            EndActiveViewSession();
            _activeViewerMediaKey = null;
            _activeViewerKind = null;
            _activeViewerIsVideo = false;
        }
        if (_module is not null) await _module.InvokeVoidAsync("fit", _stage);
    }
    private async Task ToggleInfo()
    {
        _showInfo = !_showInfo;
        if (InfoOpenChanged.HasDelegate)
            await InfoOpenChanged.InvokeAsync(_showInfo);
    }
    private Task GalleryChanged(ChangeEventArgs args) => Guid.TryParse(args.Value?.ToString(), out var id) ? OnAddToGallery.InvokeAsync(id) : Task.CompletedTask;
    private async Task PreviousAsync() { await FitAsync(); await OnPrevious.InvokeAsync(); }
    private async Task NextAsync() { await FitAsync(); await OnNext.InvokeAsync(); }
    private async Task ZoomInAsync() { _zoom = Math.Min(4, _zoom <= 1 ? 1.25 : _zoom + .25); if (_module is not null) await _module.InvokeVoidAsync("setZoom", _stage, _zoom); }
    private async Task ZoomOutAsync() { _zoom = Math.Max(1, _zoom - .25); if (_module is not null) await _module.InvokeVoidAsync("setZoom", _stage, _zoom); }
    private async Task FitAsync() { _zoom = 1; if (_module is not null) await _module.InvokeVoidAsync("fit", _stage); }
    private async Task FullscreenAsync()
    {
        if (_module is not null) await _module.InvokeVoidAsync("fullscreen", _root);
        if (Item.Kind == MediaViewerKind.Video) await UpdateVideoStateAsync();
    }
    private async Task UpdateVideoStateAsync()
    {
        if (_module is null || Item.Kind != MediaViewerKind.Video) return;
        var state = await _module.InvokeAsync<ViewerVideoState>("readVideoState", _video);
        _videoPosition = state.Position;
        _videoDuration = state.Duration;
        _videoIsPlaying = !state.Paused;
        _videoIsMuted = state.Muted;
        _videoVolume = state.Volume;
        _videoSpeed = state.Speed;
        _videoTextTracks = state.TextTracks ?? [];
        _videoAudioTracks = state.AudioTracks ?? [];
        UpdateViewSession(state, await GetViewPresentationSurfaceAsync(_video));
        await InvokeAsync(StateHasChanged);
    }
    private async Task UpdateAudioStateAsync()
    {
        if (_module is null || Item.Kind != MediaViewerKind.Audio || _activeViewAssetId is null) return;
        var state = await _module.InvokeAsync<ViewerVideoState>("readVideoState", _audio);
        UpdateViewSession(state);
        await InvokeAsync(StateHasChanged);
    }
    private async Task ToggleVideoAsync()
    {
        await EnsureViewSessionAsync();
        if (_module is not null) await _module.InvokeVoidAsync("toggleVideo", _video);
        await UpdateVideoStateAsync();
    }
    private async Task SeekVideoAsync(double position) { if (_module is not null) await _module.InvokeVoidAsync("seekVideo", _video, position); await UpdateVideoStateAsync(); }
    private Task SkipVideoAsync(double seconds) => SeekVideoAsync(_videoPosition + seconds);
    private async Task ToggleVideoMuteAsync() { if (_module is not null) await _module.InvokeVoidAsync("setVideoMuted", _video, !_videoIsMuted); await UpdateVideoStateAsync(); }
    private async Task SetVideoVolumeAsync(double volume) { if (_module is not null) await _module.InvokeVoidAsync("setVideoVolume", _video, volume); await UpdateVideoStateAsync(); }
    private async Task SetVideoSpeedAsync(double speed) { if (PlaybackRateOptions.IsValid(speed) && _module is not null) await _module.InvokeVoidAsync("setVideoSpeed", _video, speed); await UpdateVideoStateAsync(); }
    private async Task SelectVideoTextTrackAsync(ChangeEventArgs args) { if (int.TryParse(args.Value?.ToString(), out var index) && _module is not null) await _module.InvokeAsync<bool>("selectVideoTextTrack", _video, index); await UpdateVideoStateAsync(); }
    private async Task SelectVideoAudioTrackAsync(ChangeEventArgs args) { if (int.TryParse(args.Value?.ToString(), out var index) && _module is not null) await _module.InvokeAsync<bool>("selectVideoAudioTrack", _video, index); await UpdateVideoStateAsync(); }
    private async Task ToggleVideoPiPAsync() { if (_module is not null) await _module.InvokeVoidAsync("toggleVideoPiP", _video); await UpdateVideoStateAsync(); }
    private static string FormatVideoTime(double seconds) { var span = TimeSpan.FromSeconds(Math.Max(0, seconds)); return span.TotalHours >= 1 ? span.ToString(@"h\:mm\:ss") : span.ToString(@"m\:ss"); }
    private sealed record ViewerVideoTrack(int Index, string Label, string Language, bool Selected);
    private sealed record ViewerVideoState(double Position, double Duration, bool Paused, bool Muted, double Volume, double Speed,
        IReadOnlyList<ViewerVideoTrack>? TextTracks, IReadOnlyList<ViewerVideoTrack>? AudioTracks);
    private void ResetVideoState()
    {
        _observedVideoUrl = null;
        _videoPosition = _videoDuration = 0;
        _videoIsPlaying = _videoIsMuted = false;
        _videoVolume = _videoSpeed = 1;
        _videoCanPiP = _videoCanFullscreen = false;
        _videoTextTracks = _videoAudioTracks = [];
        ResetViewTransportReporting();
    }
    private void ResetViewTransportReporting()
    {
        _lastViewPosition = _lastViewVolume = _lastViewSpeed = double.NaN;
        _lastViewIsPlaying = _lastViewIsMuted = null;
        _lastViewPresentationSurface = null;
    }
    private Guid? ViewAssetId => IsViewPlayback && Guid.TryParse(Item.Key, out var assetId) && assetId != Guid.Empty ? assetId : null;
    private async Task EnsureViewSessionAsync()
    {
        if (ViewAssetId is not { } assetId) return;
        _activeViewAssetId = assetId;
        if (Playback.ViewSession?.AssetId != assetId)
            await Playback.BeginViewSessionAsync(assetId, _activeViewerIsVideo ? ViewPlaybackKind.Video : ViewPlaybackKind.Audio);
    }
    private async Task<PlaybackPresentationSurface?> GetViewPresentationSurfaceAsync(ElementReference media)
    {
        if (_module is null || _activeViewAssetId is null || !_activeViewerIsVideo) return null;
        var value = await _module.InvokeAsync<string>("getMediaPresentation", media, _root);
        return Enum.TryParse<PlaybackPresentationSurface>(value, out var surface) ? surface : null;
    }
    private void UpdateViewSession(ViewerVideoState state, PlaybackPresentationSurface? surface = null)
    {
        if (_activeViewAssetId is not { } assetId) return;
        var isPlaying = !state.Paused;
        if (_lastViewIsPlaying == isPlaying &&
            _lastViewIsMuted == state.Muted &&
            _lastViewPresentationSurface == surface &&
            Math.Abs(_lastViewPosition - state.Position) < 1 &&
            Math.Abs(_lastViewVolume - state.Volume) < .01 &&
            Math.Abs(_lastViewSpeed - state.Speed) < .01) return;

        _lastViewPosition = state.Position;
        _lastViewIsPlaying = isPlaying;
        _lastViewVolume = state.Volume;
        _lastViewIsMuted = state.Muted;
        _lastViewSpeed = state.Speed;
        _lastViewPresentationSurface = surface;
        Playback.UpdateViewSession(assetId, new AudioTransportState(
            state.Position,
            state.Duration,
            isPlaying,
            state.Volume,
            state.Muted,
            state.Speed), surface);
    }
    private void EndActiveViewSession()
    {
        if (_activeViewAssetId is not { } assetId) return;
        Playback.EndViewSession(assetId);
        _activeViewAssetId = null;
    }
    private void HandlePlaybackChanged(PlaybackChangeKind change)
    {
        if (change == PlaybackChangeKind.View && _activeViewAssetId is { } assetId && Playback.ViewSession?.AssetId != assetId)
            _ = InvokeAsync(async () => { await PauseInactiveViewTransportAsync(); StateHasChanged(); });
    }
    private async Task PauseInactiveViewTransportAsync()
    {
        if (_activeViewAssetId is not { } assetId || Playback.ViewSession?.AssetId == assetId || _module is null) return;
        if (_activeViewerIsVideo) await ReleaseViewerVideoAsync();
        else await _module.InvokeVoidAsync("pauseMedia", _audio);
    }
    private async Task ReleaseViewerVideoAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("stopObservingVideoPresentation", _video);
            await _module.InvokeVoidAsync("releaseVideo", _video);
        }
    }
    [JSInvokable]
    public Task HandleVideoPresentationChanged() => UpdateVideoStateAsync();
    private async Task ReleaseActiveViewerTransportAsync()
    {
        if (_activeViewerIsVideo) await ReleaseViewerVideoAsync();
        else if (_activeViewAssetId.HasValue && _module is not null) await _module.InvokeVoidAsync("pauseMedia", _audio);
    }
    private async Task CloseAsync()
    {
        if (_activeViewerIsVideo)
            await ReleaseViewerVideoAsync();
        else if (_activeViewAssetId.HasValue && _module is not null)
            await _module.InvokeVoidAsync("pauseMedia", _audio);
        EndActiveViewSession();
        if (_module is not null) await _module.InvokeVoidAsync("restoreFocus");
        await OnClose.InvokeAsync();
    }
    private void ToggleSlideshow()
    {
        if (_slideshow) { StopSlideshow(); return; }
        _slideshow = true; _slideshowCts = new CancellationTokenSource(); _ = RunSlideshowAsync(_slideshowCts.Token);
    }
    private async Task RunSlideshowAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(5), ct);
                if (!HasNext) { await InvokeAsync(StopSlideshow); return; }
                await InvokeAsync(NextAsync);
            }
        }
        catch (OperationCanceledException) { }
    }
    private void StopSlideshow() { _slideshow = false; _slideshowCts?.Cancel(); _slideshowCts?.Dispose(); _slideshowCts = null; }
    private async Task HandleKeyAsync(KeyboardEventArgs args)
    {
        if (_module is not null && await _module.InvokeAsync<bool>("isEditableFocus")) return;
        if (args.Key == "Escape") await CloseAsync();
        else if (Item.Kind == MediaViewerKind.Video && args.Key == "ArrowLeft") await SkipVideoAsync(-_videoSkipBackSeconds);
        else if (Item.Kind == MediaViewerKind.Video && args.Key == "ArrowRight") await SkipVideoAsync(_videoSkipForwardSeconds);
        else if (args.Key == "ArrowLeft" && HasPrevious) await PreviousAsync();
        else if (args.Key == "ArrowRight" && HasNext) await NextAsync();
        else if (args.Key is "+" or "=") await ZoomInAsync();
        else if (args.Key == "-") await ZoomOutAsync();
        else if (args.Key == "0") await FitAsync();
        else if (args.Key.Equals("f", StringComparison.OrdinalIgnoreCase)) await FullscreenAsync();
        else if (Item.Kind == MediaViewerKind.Video && args.Key is " " or "k" or "K") await ToggleVideoAsync();
        else if (Item.Kind == MediaViewerKind.Video && args.Key.Equals("m", StringComparison.OrdinalIgnoreCase)) await ToggleVideoMuteAsync();
    }
    public async ValueTask DisposeAsync()
    {
        StopSlideshow();
        Playback.Changed -= HandlePlaybackChanged;
        if (_module is not null)
        {
            try
            {
                if (_activeViewerIsVideo)
                    await ReleaseViewerVideoAsync();
                else if (_activeViewAssetId.HasValue)
                    await _module.InvokeVoidAsync("pauseMedia", _audio);
                await _module.InvokeVoidAsync("dispose", _stage);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
