@namespace MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Playback
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IServiceProvider Services

<span @ref="_root" class="playback-popover-owner" data-playback-popover-kind="@Kind" data-playback-popover-surface="@Surface" data-chrome-hold>
    @if (TriggerContent is not null)
    {
        <PlaybackTooltip Text="@Title" Suppressed="@IsOpen">
            <AppNativeButton @ref="_triggerButton" Class="playback-popover-trigger" AriaLabel="@Title" Disabled="@Disabled"
                             aria-haspopup="dialog" aria-expanded="@(IsOpen ? "true" : "false")" aria-controls="@PanelId">
                @TriggerContent
            </AppNativeButton>
        </PlaybackTooltip>
    }
    @if (_renderOpen)
    {
        <div @ref="_panel" id="@PanelId" class="@PanelClass" data-playback-popover-panel data-chrome-hold tabindex="-1">
            @if (_mobile)
            {
                <div class="playback-popover-backdrop" data-playback-popover-backdrop></div>
                <PlaybackToolSheet Title="@Title" Surface="@Surface" Presentation="full-overlay" Modal="true" OnClose="CloseAsync">
                    <CascadingValue Name="PlaybackPopoverOwner" Value="@PanelId">@ChildContent</CascadingValue>
                </PlaybackToolSheet>
            }
            else
            {
                <section class="playback-popover-surface" role="dialog" aria-label="@Title">
                    @if (ShowHeading) { <h2 class="playback-popover-heading">@Title</h2> }
                    <div class="playback-popover-content"><CascadingValue Name="PlaybackPopoverOwner" Value="@PanelId">@ChildContent</CascadingValue></div>
                </section>
            }
        </div>
    }
</span>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "Playback tools";
    [Parameter] public string? ToolId { get; set; }
    [Parameter] public string Kind { get; set; } = "ordinary";
    [Parameter] public string Surface { get; set; } = "panel";
    [Parameter] public bool ShowHeading { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? ItemKey { get; set; }
    [Parameter] public ElementReference? Trigger { get; set; }
    [Parameter] public RenderFragment? TriggerContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public bool? Open { get; set; }
    private bool? _lastControlledOpen;
    private readonly string _instanceId = $"playback-tool-{Guid.NewGuid():N}";
    private string PanelId => $"{_instanceId}-panel";
    private string EffectiveToolId => ToolId ?? _instanceId;
    private string PanelClass => $"playback-popover playback-popover--{(Kind is "lyrics" or "video" or "volume" or "menu" ? Kind : "ordinary")} {(_mobile ? "playback-popover--sheet" : "")}";
    private bool IsOpen => _tools?.IsOpen(EffectiveToolId) == true;
    private ElementReference _root, _panel;
    private AppNativeButton? _triggerButton;
    public ElementReference? TriggerElement => Trigger ?? _triggerButton?.Element;
    private PlaybackTransientToolCoordinator? _tools;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PlaybackPopover>? _reference;
    private string? _lastItemKey;
    private bool _mobile, _reportedOpen, _renderOpen, _disposed;
    private readonly SemaphoreSlim _lifecycle = new(1, 1);

    protected override void OnInitialized()
    {
        _tools = Services.GetService<PlaybackTransientToolCoordinator>() ?? new();
        _tools.Changed += ToolChanged;
        _lastItemKey = ItemKey;
    }
    protected override void OnParametersSet()
    {
        if (Open != _lastControlledOpen)
        {
            _lastControlledOpen = Open;
            if (Open == true && !Disabled) _tools?.Open(EffectiveToolId, pinned: true);
            else if (Open == false) _tools?.Close(EffectiveToolId);
        }
        if (_lastItemKey == ItemKey) return;
        _lastItemKey = ItemKey;
        _tools?.Close(EffectiveToolId);
    }
    private void ToolChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () => {
            await _lifecycle.WaitAsync();
            try
            {
                if (_disposed) return;
                if (!IsOpen) await ReleasePanelAsync();
                _renderOpen = IsOpen;
                if (_reportedOpen != IsOpen) { _reportedOpen = IsOpen; await OpenChanged.InvokeAsync(IsOpen); }
                StateHasChanged();
            }
            finally { _lifecycle.Release(); }
        });
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        await _lifecycle.WaitAsync();
        try
        {
            if (_disposed) return;
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-popover.js");
            if (_module is null) return;
            _reference ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _root, Trigger, _reference);
            await _module.InvokeVoidAsync("update", _root, IsOpen ? _panel : null, IsOpen, _tools?.IsPinned == true);
        }
        catch (InvalidOperationException) { }
        catch (JSDisconnectedException) { }
        finally { _lifecycle.Release(); }
    }
    private async Task ReleasePanelAsync(bool restoreFocus = false)
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("update", _root, null, false, false, restoreFocus); }
        catch (JSDisconnectedException) { }
    }
    [JSInvokable] public async Task SetViewport(bool mobile)
    {
        mobile = mobile && Kind is not ("volume" or "menu");
        if (_mobile == mobile || _disposed) return;
        await _lifecycle.WaitAsync();
        try
        {
            if (_disposed) return;
            await ReleasePanelAsync();
            _mobile = mobile;
            await InvokeAsync(StateHasChanged);
        }
        finally { _lifecycle.Release(); }
    }
    [JSInvokable] public Task OpenAsync(bool pinned)
    {
        if (!_disposed && !Disabled) _tools?.Open(EffectiveToolId, pinned);
        return Task.CompletedTask;
    }
    public Task CloseAsync() => ClosePanelAsync(restoreFocus: true);
    [JSInvokable] public Task CloseFromBrowserAsync(bool restoreFocus) => ClosePanelAsync(restoreFocus);
    private async Task ClosePanelAsync(bool restoreFocus)
    {
        await _lifecycle.WaitAsync();
        try
        {
            if (_disposed) return;
            // Restore a portaled panel before Blazor removes its conditional node.
            await ReleasePanelAsync(restoreFocus);
            _tools?.Close(EffectiveToolId);
            _renderOpen = false;
        }
        finally { _lifecycle.Release(); }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_tools is not null) { _tools.Changed -= ToolChanged; _tools.Close(EffectiveToolId); }
        await _lifecycle.WaitAsync();
        try
        {
            if (_module is not null)
            {
                try { await _module.InvokeVoidAsync("detach", _root); await _module.DisposeAsync(); }
                catch (JSDisconnectedException) { }
            }
            _reference?.Dispose();
        }
        finally { _lifecycle.Release(); }
    }
}
