@namespace MediaEngine.Web.Components.Shared
@inject IJSRuntime JS
@inject IAppToastService Snackbar
@inject ILogger<RecoveryCodesDisplay> Logger
@inject IStringLocalizer<SharedStrings> L

<div class="recovery-codes-display" aria-live="polite">
    <AppAlert Tone="AppUiTone.Warning">
        <strong>@L["RecoveryCodesDisplay_SaveTheseRecoveryCodesNow"]</strong> @L["RecoveryCodesDisplay_TheyCannotBeViewedAgain"]
    </AppAlert>
    <label class="recovery-codes-display__label" for="@_fieldId">@L["RecoveryCodesDisplay_RecoveryCodes"]</label>
    <textarea id="@_fieldId"
              class="recovery-codes-display__field"
              aria-describedby="@_helpId"
              readonly
              spellcheck="false">@CodesOnlyText</textarea>
    <small id="@_helpId">@L["RecoveryCodesDisplay_CopyOrDownloadTheseOne"]</small>
    <div class="recovery-codes-display__actions">
        <AppButton Label="@L["RecoveryCodesDisplay_CopyAll"].Value"
                   StartIcon="@AppMaterialIcons.Outlined.ContentCopy"
                   OnClick="CopyAsync" />
        <AppButton Label="@L["RecoveryCodesDisplay_DownloadTxt"].Value"
                   StartIcon="@AppMaterialIcons.Outlined.Download"
                   Href="@DownloadUri"
                   download="@FileName" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Codes { get; set; } = [];
    [Parameter] public string Heading { get; set; } = "Library recovery codes";
    [Parameter] public string FileName { get; set; } = "tuvima-recovery-codes.txt";

    private readonly string _fieldId = $"recovery-codes-{Guid.NewGuid():N}";
    private readonly string _helpId = $"recovery-codes-help-{Guid.NewGuid():N}";
    private string CodesOnlyText => string.Join(Environment.NewLine, Codes);
    private string CodesText => $"{Heading}{Environment.NewLine}Created: {DateTimeOffset.Now:g}{Environment.NewLine}{Environment.NewLine}{string.Join(Environment.NewLine, Codes)}{Environment.NewLine}";
    private string DownloadUri => $"data:text/plain;charset=utf-8,{Uri.EscapeDataString(CodesText)}";

    private async Task CopyAsync()
    {
        switch (await JS.TryCopyAsync(CodesText, Logger))
        {
            case ClipboardCopyResult.Copied:
                Snackbar.Add("Recovery codes copied.", AppSeverity.Success);
                break;
            case ClipboardCopyResult.Failed:
                Snackbar.Add(ClipboardInterop.FailedMessage("the codes"), AppSeverity.Warning);
                break;
        }
    }
}
