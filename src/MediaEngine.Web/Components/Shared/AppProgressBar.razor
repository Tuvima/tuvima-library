@namespace MediaEngine.Web.Components.Shared

<div class="@RootClass" title="@Title" @attributes="AdditionalAttributes" style="@AccentStyle">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <div class="app-progress-bar__label">@Label</div>
    }
    <div class="app-progress-bar__track" role="@(Decorative ? null : "progressbar")" aria-label="@(Decorative ? null : Label ?? Title ?? "Progress")" aria-valuemin="@(Decorative ? null : "0")" aria-valuemax="@(Decorative ? null : "100")" aria-valuenow="@(Decorative || Indeterminate ? null : (double?)ClampedValue)">
        <div class="app-progress-bar__fill" style="@FillStyle"></div>
    </div>
    @if (ShowValue)
    {
        <div class="app-progress-bar__value">@ClampedValue.ToString("F0")%</div>
    }
</div>

@code {
    [Parameter] public double? Value { get; set; }
    [Parameter] public Color Color { get; set; } = Color.Primary;
    [Parameter] public bool Rounded { get; set; }
    [Parameter] public bool Decorative { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? AccentColor { get; set; }
    [Parameter] public bool ShowValue { get; set; }
    [Parameter] public bool Indeterminate { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private string AccentStyle => $"{Style};--app-progress-accent: {(AccentColor ?? $"var(--mud-palette-{Color.ToString().ToLowerInvariant()})")};";
    private double ClampedValue => Math.Clamp(Value ?? 0, 0, 100);

    private string? FillStyle =>
        Indeterminate ? null :
        string.IsNullOrWhiteSpace(AccentColor)
            ? $"width: {ClampedValue:F0}%;"
            : $"width: {ClampedValue:F0}%; --app-progress-accent: {AccentColor};";

    private string RootClass =>
        string.Join(" ", new[]
        {
            "app-progress-bar",
            Indeterminate ? "app-progress-bar--indeterminate" : null,
            Class,
        }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
