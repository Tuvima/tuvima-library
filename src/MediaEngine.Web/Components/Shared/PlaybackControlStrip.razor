@namespace MediaEngine.Web.Components.Shared
@using System.Linq

<div class="@RootClass" role="toolbar" aria-label="@AriaLabel">
    @foreach (var control in Controls)
    {
        @if (control.Key == PlaybackControlKey.Settings && SettingsContent is not null)
        {
            @SettingsContent(control)
        }
        else
        {
            <PlaybackIconButton Control="@control"
                                Size="@Size"
                                Surface="@Surface"
                                Appearance="@Appearance"
                                OnActivated="@(trigger => HandleControlActivatedAsync(control, trigger))" />
        }
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<PlaybackControlDefinition> Controls { get; set; } = [];

    [Parameter]
    public string Size { get; set; } = "standard";

    [Parameter]
    public string Surface { get; set; } = "panel";

    [Parameter]
    public string Appearance { get; set; } = "standard";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = "Playback tools";

    [Parameter]
    public EventCallback<PlaybackControlDefinition> OnControl { get; set; }

    /// <summary>
    /// Draws the Settings gear where the catalog puts it (audiobook: after Chapters, before Bookmarks). The host supplies the menu behind it,
    /// because what it lists depends on the player (unified player D10). Without it the gear is an ordinary button that reports through OnControl.
    /// </summary>
    [Parameter]
    public RenderFragment<PlaybackControlDefinition>? SettingsContent { get; set; }

    private string NormalizedSize => Size switch
    {
        "compact" => "compact",
        "large" => "large",
        _ => "standard",
    };

    private string RootClass => string.Join(" ", new[]
    {
        "playback-control-strip",
        $"playback-control-strip--{NormalizedSize}",
        $"playback-control-strip--surface-{NormalizedSurface}",
        $"playback-control-strip--appearance-{NormalizedAppearance}",
        Class,
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private string NormalizedSurface => Surface switch
    {
        "dock" or "expanded" or "phone" or "popup" or "video" => Surface,
        _ => "panel",
    };

    private string NormalizedAppearance => Appearance == "bare" ? "bare" : "standard";

    private Task HandleControlActivatedAsync(PlaybackControlDefinition control, ElementReference trigger) =>
        OnControlActivation.HasDelegate
            ? OnControlActivation.InvokeAsync(new PlaybackControlActivation(control, trigger))
            : OnControl.InvokeAsync(control);

    [Parameter] public EventCallback<PlaybackControlActivation> OnControlActivation { get; set; }
}
