@namespace MediaEngine.Web.Components.Shared

<AppTextField Value="@Value"
              ValueChanged="OnValueChanged"
              Placeholder="@Placeholder"
              Label="@Label"
              HideLabel="@HideLabel"
              HelpText="@HelpText"
              Disabled="@Disabled"
              FullWidth="@FullWidth"
              Size="@Size"
              DebounceInterval="@DebounceInterval"
              Adornment="AppAdornment.Start"
              AdornmentIcon="@AppMaterialIcons.Outlined.Search"
              Class="@($"app-search-field {Class}".Trim())" />

@code {
    [Parameter] public string? Label { get; set; }
    /// <summary>Keeps <see cref="Label"/> as the field's accessible name without showing it.</summary>
    [Parameter] public bool HideLabel { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search...";
    [Parameter] public string? HelpText { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool FullWidth { get; set; } = true;
    [Parameter] public AppControlSize Size { get; set; } = AppControlSize.Normal;
    /// <summary>When above zero, <see cref="ValueChanged"/> fires this many milliseconds after the last keystroke instead of on blur or Enter.</summary>
    [Parameter] public double DebounceInterval { get; set; }
    [Parameter] public string? Class { get; set; }

    private Task OnValueChanged(string? value) => ValueChanged.InvokeAsync(string.IsNullOrWhiteSpace(value) ? null : value);
}
