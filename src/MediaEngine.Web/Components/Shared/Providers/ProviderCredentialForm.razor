@namespace MediaEngine.Web.Components.Shared.Providers

<div class="provider-credential-form">
    @foreach (var field in Fields.Where(IsUserSupplied))
    {
        var fieldKey = field.Key;
        <AppTextField Label="@field.Label"
                      Value="@Values.GetValueOrDefault(fieldKey)"
                      ValueChanged="@(value => SetValueAsync(fieldKey, value))"
                      Placeholder="@Placeholder(field)"
                      HelpText="@HelpText(field)"
                      InputType="@InputTypeFor(field)"
                      MaxLength="@(field.MaximumLength ?? 524288)"
                      autocomplete="off"
                      aria-invalid="@(FieldErrors.ContainsKey(fieldKey) ? "true" : null)" />
        @if (FieldErrors.TryGetValue(fieldKey, out var error))
        {
            <div class="provider-credential-form__error" role="alert">@error</div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ProviderCredentialFieldDto> Fields { get; set; } = [];
    [Parameter, EditorRequired] public Dictionary<string, string> Values { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public IReadOnlyDictionary<string, string> FieldErrors { get; set; } = new Dictionary<string, string>();
    [Parameter] public EventCallback ValuesChanged { get; set; }
    [Parameter] public bool Replacing { get; set; }

    private async Task SetValueAsync(string key, string? value)
    {
        Values[key] = value ?? string.Empty;
        await ValuesChanged.InvokeAsync();
    }

    private string Placeholder(ProviderCredentialFieldDto field) =>
        Replacing && field.Configured
            ? $"Enter a replacement {field.Label.ToLowerInvariant()}"
            : $"Enter {field.Label.ToLowerInvariant()}";

    private static string HelpText(ProviderCredentialFieldDto field) =>
        field.FormatHint ?? "The stored value is encrypted and is never returned to the Dashboard.";

    private static AppInputType InputTypeFor(ProviderCredentialFieldDto field) =>
        string.Equals(field.InputType, "password", StringComparison.OrdinalIgnoreCase)
            ? AppInputType.Password
            : AppInputType.Text;

    private static bool IsUserSupplied(ProviderCredentialFieldDto field) =>
        string.Equals(field.Ownership, "user_supplied", StringComparison.OrdinalIgnoreCase);
}
