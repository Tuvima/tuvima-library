@namespace MediaEngine.Web.Components.Shared

@if (ChildContent is null)
{
    <AppChip Text="@Text"
             Icon="@Icon"
             Title="@Title"
             Tone="@Tone"
             Size="@Size"
             Class="@RootClass" />
}
else
{
    <AppChip Text="@Text"
             Icon="@Icon"
             Title="@Title"
             Tone="@Tone"
             Size="@Size"
             Class="@RootClass">@ChildContent</AppChip>
}

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    [Parameter] public AppUiTone Tone { get; set; }
    [Parameter] public AppControlSize Size { get; set; } = AppControlSize.Compact;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Class { get; set; }

    /// <summary>Replaces the text, for a pill that needs its own mark (the Tuvima icon in the Official pill).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string RootClass =>
        string.Join(" ", new[]
        {
            "app-status-badge",
            $"app-status-badge--{Tone.ToString().ToLowerInvariant()}",
            Class,
        }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
