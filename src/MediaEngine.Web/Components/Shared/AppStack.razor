@namespace MediaEngine.Web.Components.Shared
<div class="tl-stack @Class" style="@RootStyle" @attributes="AdditionalAttributes">@ChildContent</div>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Row { get; set; }
    [Parameter] public bool Reverse { get; set; }
    [Parameter] public int Spacing { get; set; } = 3;
    [Parameter] public AppAlignItems AlignItems { get; set; } = AppAlignItems.Stretch;
    [Parameter] public AppJustify Justify { get; set; } = AppJustify.FlexStart;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private static string CssValue(object value) => System.Text.RegularExpressions.Regex.Replace(value.ToString()!, "([a-z])([A-Z])", "$1-$2").ToLowerInvariant();
    private string RootStyle => $"flex-direction:{(Row ? "row" : "column")}{(Reverse ? "-reverse" : "")};gap:{Math.Max(0,Spacing)*4}px;align-items:{CssValue(AlignItems)};justify-content:{CssValue(Justify)};{Style}";
}
