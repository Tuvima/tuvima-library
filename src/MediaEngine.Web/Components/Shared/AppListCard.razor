@namespace MediaEngine.Web.Components.Shared

@* The card every Developer-area grid uses (plugins, integrations): an icon, a name and one line about it, then ONE row of
   pills (the status pill first, then the category and any badges), a switch beside the name and a footer of actions.
   Cards in a row are the same height: one-line name, two-line description (spec: one-shared-look D3/D4;
   plugins-and-integrations-screens-v3 D19/D23: the status pill lives in the pill row so names never truncate). *@
<article class="@RootClass" aria-label="@Title" @attributes="AdditionalAttributes">
    <div class="app-list-card__top">
        <span class="app-list-card__icon" aria-hidden="true"><AppMaterialIcon Icon="@(Icon ?? AppMaterialIcons.Outlined.Extension)" /></span>
        <div class="app-list-card__copy">
            <strong class="app-list-card__title" title="@Title">@Title</strong>
        </div>
        @if (Aside is not null)
        {
            <div class="app-list-card__aside">@Aside</div>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="app-list-card__description">@Description</p>
    }
    @if (Status is not null || !string.IsNullOrWhiteSpace(Kind) || Badges is not null || Warning is not null)
    {
        @* One row of small pills: status first, then category, trust level and media. *@
        <div class="app-list-card__badges">
            @Status
            @if (!string.IsNullOrWhiteSpace(Kind))
            {
                <AppStatusBadge Text="@Kind" Tone="AppUiTone.Neutral" />
            }
            @Badges
            @if (Warning is not null)
            {
                <span class="app-list-card__warning">@Warning</span>
            }
        </div>
    }
    @ChildContent
    @if (Footer is not null)
    {
        <div class="app-list-card__footer">@Footer</div>
    }
</article>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Description { get; set; }

    /// <summary>The small category or kind label under the name.</summary>
    [Parameter] public string? Kind { get; set; }
    [Parameter] public RenderFragment? Badges { get; set; }

    /// <summary>The status pill, drawn first in the pill row (never beside the name).</summary>
    [Parameter] public RenderFragment? Status { get; set; }

    /// <summary>Top-right content: a switch only.</summary>
    [Parameter] public RenderFragment? Aside { get; set; }
    [Parameter] public RenderFragment? Warning { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string RootClass => string.Join(" ", new[] { "app-list-card", Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
