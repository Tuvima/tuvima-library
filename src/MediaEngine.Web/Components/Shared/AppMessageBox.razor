@namespace MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Ui
@* The service's generic alert / question. It is the one confirmation dialog (AppConfirmDialog, Look pass 4.3): the caller's
   title, the message, and the buttons bottom right: the neutral outlined safe choice first and focused, a solid red destructive choice last. *@
<AppConfirmDialog Title="@Title"
                  PrimaryLabel="@YesText"
                  SecondaryLabel="@(CancelText ?? NoText ?? string.Empty)"
                  PrimaryDestructive="@IsDestructive"
                  Tone="@(IsDestructive ? AppUiTone.Error : AppUiTone.Info)"
                  Preview="@(HasMessage ? MessageContent : null)" />
@code {
    [CascadingParameter] public IAppDialogContext Dialog { get; set; } = default!;
    [Parameter] public object? Message { get; set; }
    [Parameter] public string YesText { get; set; } = "OK";
    [Parameter] public string? NoText { get; set; }
    [Parameter] public string? CancelText { get; set; }
    [Parameter] public bool Destructive { get; set; }
    // The caller says when the main button removes or discards something (AppDialogOptions.DestructiveConfirm): drawn solid red,
    // last and not focused, with the safe button neutral outlined, first and focused (Look v3.1 D4).
    private bool IsDestructive => Destructive && !string.IsNullOrEmpty(CancelText ?? NoText);
    private string Title => Dialog.Title ?? string.Empty;
    // A question that is all in its title (Delete "Road Trip"?) passes no message and gets no empty body.
    private bool HasMessage => !string.IsNullOrEmpty(Message?.ToString());
    private RenderFragment MessageContent => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "app-message-box__message");
        if (Message is MarkupString markup) builder.AddContent(2, markup); else builder.AddContent(2, Message?.ToString());
        builder.CloseElement();
    };
}
