@namespace MediaEngine.Web.Components.Shared
@using System.Linq
@using Microsoft.AspNetCore.Components.Web
@using MediaEngine.Web.Services.MediaTiles

@if (IsChapterVariant && OnClick.HasDelegate)
{
    <button type="button" class="@RootClass" style="@LeadingStyle"
            aria-current="@(IsCurrent ? "true" : null)"
            data-playback-current="@(IsCurrent ? "true" : null)"
            aria-label="@ResolvedAriaLabel"
            @onclick="HandleClickAsync"
            @attributes="AdditionalAttributes">
        <span class="playback-context-row__leading">
            @if (LeadingContent is not null)
            {
                @LeadingContent
            }
            else if (!string.IsNullOrWhiteSpace(ArtworkUrl))
            {
                <img src="@MediaTileArtworkUrl.ForDrawnSize(ArtworkUrl, LeadingArtworkPx)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(ArtworkUrl, LeadingArtworkPx)" alt="" loading="lazy" decoding="async" data-image-display="playback-context-thumbnail" />
            }
            else if (!string.IsNullOrWhiteSpace(LeadingText))
            {
                <span class="playback-context-row__leading-text">@LeadingText</span>
            }
        </span>
        <span class="playback-context-row__activity playback-context-row__activity--chapter" aria-hidden="true">
            @if (IsCurrent)
            {
                <PlaybackActivityMark IsPlaying="@IsPlaying" Size="compact" />
            }
        </span>
        <span class="playback-context-row__identity">
            <strong>@Title</strong>
            @if (!string.IsNullOrWhiteSpace(Subtitle)) { <span>@Subtitle</span> }
        </span>
        @if (!string.IsNullOrWhiteSpace(Duration))
        {
            <span class="playback-context-row__duration">@Duration</span>
        }
    </button>
}
else
{
<div class="@RootClass" style="@LeadingStyle" aria-current="@(IsCurrent ? "true" : null)" data-playback-current="@(IsCurrent ? "true" : null)" @attributes="AdditionalAttributes">
    @if (Handle is not null)
    {
        <div class="playback-context-row__handle">@Handle</div>
    }
    <div class="playback-context-row__leading">
        @if (LeadingContent is not null)
        {
            @LeadingContent
        }
        else if (!string.IsNullOrWhiteSpace(ArtworkUrl))
        {
            <img src="@MediaTileArtworkUrl.ForDrawnSize(ArtworkUrl, LeadingArtworkPx)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(ArtworkUrl, LeadingArtworkPx)" alt="" loading="lazy" decoding="async" data-image-display="playback-context-thumbnail" />
        }
        else if (!string.IsNullOrWhiteSpace(LeadingText))
        {
            <span class="playback-context-row__leading-text">@LeadingText</span>
        }
        @if (IsCurrent && !IsChapterVariant)
        {
            <span class="playback-context-row__activity"><PlaybackActivityMark IsPlaying="@IsPlaying" /></span>
        }
    </div>
    @if (IsChapterVariant)
    {
        <span class="playback-context-row__activity playback-context-row__activity--chapter" aria-hidden="true">
            @if (IsCurrent)
            {
                <PlaybackActivityMark IsPlaying="@IsPlaying" Size="compact" />
            }
        </span>
    }
    @if (OnClick.HasDelegate)
    {
        <AppNativeButton Type="button" Class="playback-context-row__identity" OnClick="@HandleClickAsync" AriaLabel="@ResolvedAriaLabel" title="@ResolvedAriaLabel">
            <strong>@Title</strong>
            @if (!string.IsNullOrWhiteSpace(Subtitle)) { <span>@Subtitle</span> }
        </AppNativeButton>
    }
    else
    {
        <div class="playback-context-row__identity">
            <strong>@Title</strong>
            @if (!string.IsNullOrWhiteSpace(Subtitle)) { <span>@Subtitle</span> }
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Duration))
    {
        <span class="playback-context-row__duration">@Duration</span>
    }
    @if (Actions is not null && !IsChapterVariant)
    {
        <div class="playback-context-row__actions">@Actions</div>
    }
</div>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? ArtworkUrl { get; set; }
    [Parameter] public string LeadingWidth { get; set; } = string.Empty;
    [Parameter] public string? LeadingText { get; set; }
    [Parameter] public string? Duration { get; set; }
    [Parameter] public bool IsCurrent { get; set; }
    [Parameter] public bool IsPlaying { get; set; }
    [Parameter] public RenderFragment? LeadingContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    /// <summary>A drag handle drawn in its own column at the far left, so it never sits on the time.</summary>
    [Parameter] public RenderFragment? Handle { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter] public string Variant { get; set; } = "default";

    private string RootClass => string.Join(" ", new[] { "playback-context-row", $"playback-context-row--{NormalizedVariant}", IsCurrent ? "is-current" : null, Handle is not null && !IsChapterVariant ? "playback-context-row--handled" : null, Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private string NormalizedVariant => Variant switch { "chapter" => "chapter", "history" => "history", "history-duration" => "history-duration", "history-played" => "history-played", _ => "default" };
    private bool IsChapterVariant => NormalizedVariant == "chapter";
    private string LeadingStyle => $"--playback-context-leading-width:{(string.IsNullOrWhiteSpace(LeadingWidth) ? IsChapterVariant ? "20px" : NormalizedVariant.StartsWith("history", StringComparison.Ordinal) ? "80px" : "56px" : LeadingWidth)};";
    // The thumbnail is drawn 56px square (PlaybackContextRow.razor.css).
    private const int LeadingArtworkPx = 56;
    private string ResolvedAriaLabel => string.IsNullOrWhiteSpace(AriaLabel) ? string.Join(" ", new[] { Title, Subtitle }.Where(value => !string.IsNullOrWhiteSpace(value))) : AriaLabel;
    private Task HandleClickAsync(MouseEventArgs _) => OnClick.InvokeAsync();
}
