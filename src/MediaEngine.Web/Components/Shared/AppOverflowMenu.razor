@namespace MediaEngine.Web.Components.Shared
@inject IJSRuntime JS
@implements IDisposable

<div class="@TriggerRootClass"
     data-app-dismissible="@(_open ? "open" : null)"
     data-app-popover-id="@(_open ? _popoverId : null)"
     @onkeydown="HandleKeyDown"
     @onclick:stopPropagation="true"
     @onpointerdown:stopPropagation="true">
    <button type="button" hidden data-app-dismiss @onclick="Close"></button>
    <button type="button" hidden data-app-dismiss-restore @onclick="CloseAndRestoreAsync"></button>

    @AnchorContent
    <button @ref="_trigger"
            type="button" disabled="@Disabled"
            class="@ActivatorClass"
            aria-label="@EffectiveAriaLabel"
            aria-haspopup="menu"
            aria-expanded="@(_open ? "true" : "false")"
            aria-controls="@(_open ? _popoverId : null)"
            @onclick="Toggle">
        @if (TriggerContent is not null)
        {
            @TriggerContent
        }
        else if (ShowIcon)
        {
            <AppMaterialIcon Icon="@Icon" />
        }
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <span>@Label</span>
        }
        @if (!string.IsNullOrWhiteSpace(EndIcon))
        {
            <AppMaterialIcon Icon="@EndIcon" Class="app-overflow-menu__end-icon" />
        }
    </button>

    @if (_open)
    {
        <AppPopover Open="true" OpenChanged="PopoverChanged" Anchor="_trigger" FocusOnOpen="@FocusOnOpen"
                    AnchorOrigin="@AnchorOrigin"
                    TransformOrigin="@TransformOrigin"
                    MatchAnchorWidth="@MatchAnchorWidth"
                    Class="@EffectivePopoverClass">
            <CascadingValue Value="@this" IsFixed="true">
                <div id="@_popoverId" class="app-overflow-menu__content" role="menu" aria-label="@EffectiveAriaLabel" @onclick="Close">
                    @ChildContent
                </div>
            </CascadingValue>
        </AppPopover>
    }
</div>

@code {
    private bool _open;
    private bool _focusMenu;
    private bool _disposed;
    private TaskCompletionSource<bool>? _actionCloseRendered;
    private ElementReference _trigger;
    [Parameter] public RenderFragment? AnchorContent { get; set; }
    [Parameter] public RenderFragment? TriggerContent { get; set; }
    [Parameter] public bool MatchAnchorWidth { get; set; }
    [Parameter] public bool FocusOnOpen { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private readonly string _popoverId = $"app-context-menu-{Guid.NewGuid():N}";

    [Parameter] public string Icon { get; set; } = AppMaterialIcons.Outlined.MoreVert;
    [Parameter] public string? EndIcon { get; set; }
    [Parameter] public bool ShowIcon { get; set; } = true;
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public AppControlSize Size { get; set; } = AppControlSize.Compact;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? TriggerClass { get; set; }
    [Parameter] public string? PopoverClass { get; set; }
    [Parameter] public AppOrigin AnchorOrigin { get; set; } = AppOrigin.BottomRight;
    [Parameter] public AppOrigin TransformOrigin { get; set; } = AppOrigin.TopRight;

    private string EffectiveAriaLabel => AriaLabel ?? Label ?? "More actions";
    private string TriggerRootClass =>
        string.Join(" ", new[] { "app-overflow-menu", AppUiMaps.SizeClass(Size), Class }
            .Where(value => !string.IsNullOrWhiteSpace(value)));
    private string ActivatorClass =>
        string.Join(" ", new[]
        {
            "app-overflow-menu__trigger",
            string.IsNullOrWhiteSpace(Label) ? "app-overflow-menu__trigger--icon" : "app-overflow-menu__trigger--labeled",
            TriggerClass,
        }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private string EffectivePopoverClass =>
        string.Join(" ", new[]
        {
            "app-menu-popover",
            "app-overflow-menu__popover",
            MatchAnchorWidth ? "app-overflow-menu__popover--match-anchor" : null,
            AnchorOrigin == AppOrigin.BottomLeft ? "app-overflow-menu__popover--left" : null,
            PopoverClass,
        }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private void Toggle()
    {
        if (Disabled) return;
        _open = !_open;
        _focusMenu = _open && FocusOnOpen;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_open && _actionCloseRendered is not null)
        {
            var rendered = _actionCloseRendered;
            _actionCloseRendered = null;
            rendered.TrySetResult(true);
        }
        if (_focusMenu)
        {
            _focusMenu = false;
            await JS.InvokeVoidAsync("tuvimaFocusMenu", _popoverId);
        }
    }

    private void Close() => _open = false;
    private void PopoverChanged(bool open) => _open = open;

    private async Task CloseAndRestoreAsync()
    {
        _open = false;
        await InvokeAsync(StateHasChanged);
        await _trigger.FocusAsync();
    }

    internal async Task<bool> PrepareActionAsync()
    {
        if (_disposed) return false;
        if (_open || _actionCloseRendered is not null)
        {
            _actionCloseRendered ??= new(TaskCreationOptions.RunContinuationsAsynchronously);
            var rendered = _actionCloseRendered.Task;
            _open = false;
            _focusMenu = false;
            await InvokeAsync(StateHasChanged);
            if (!await rendered) return false;
        }
        if (_disposed) return false;
        await _trigger.FocusAsync();
        return true;
    }

    public void Dispose()
    {
        _disposed = true;
        _actionCloseRendered?.TrySetResult(false);
        _actionCloseRendered = null;
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
            _ = CloseAndRestoreAsync();
    }
}
