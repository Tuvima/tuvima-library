@namespace MediaEngine.Web.Components.Shared
@typeparam TItem
<div class="app-data-table tl-table @(Dense ? "tl-table-dense" : "") @(Hover ? "tl-table-hover" : "") @Class" @attributes="AdditionalAttributes">
    @if (ToolBarContent is not null) { <div class="tl-table-toolbar">@ToolBarContent</div> }
    <div class="tl-table-container">
        <table class="tl-table-root">
            @if (HeaderContent is not null) { <thead class="tl-table-head"><tr class="tl-table-row">@HeaderContent</tr></thead> }
            <tbody class="tl-table-body">
                @if (Rows.Count > 0)
                {
                    @foreach (var item in Rows) { <tr class="tl-table-row">@if (RowTemplate is not null) { @RowTemplate(item) }</tr> }
                }
                else { <tr class="tl-table-row"><td class="tl-table-cell" colspan="100">@NoRecordsContent</td></tr> }
            </tbody>
        </table>
    </div>
    @if (PagerContent is not null) { <div class="tl-table-pagination">@PagerContent</div> }
</div>
@code {
    [Parameter] public IEnumerable<TItem>? Items { get; set; }
    [Parameter] public bool Dense { get; set; }
    [Parameter] public bool Hover { get; set; }
    [Parameter] public AppBreakpoint Breakpoint { get; set; } = AppBreakpoint.Sm;
    [Parameter] public RenderFragment? ToolBarContent { get; set; }
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment<TItem>? RowTemplate { get; set; }
    [Parameter] public RenderFragment? NoRecordsContent { get; set; }
    [Parameter] public RenderFragment? PagerContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private IReadOnlyList<TItem> Rows => Items as IReadOnlyList<TItem> ?? Items?.ToArray() ?? [];
}
