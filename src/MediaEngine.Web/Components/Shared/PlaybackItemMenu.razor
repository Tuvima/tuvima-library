@namespace MediaEngine.Web.Components.Shared
@using MediaEngine.Contracts.Details
@using MediaEngine.Contracts.Progress
@using MediaEngine.Web.Components.Details
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IServiceProvider Services
@inject NavigationManager Nav

@* The "..." beside the title (unified player v2 D23; mockup screen 12): a 272 px PlaybackPanel menu with the item's name above 44 px rows, each a 24 px
   stroke glyph and a 16 / 500 label, separated into groups by hairlines. Add to playlist, Mark as listened / unlistened, history, the "Go to"
   rows and Playback settings change with the media (PlaybackItemMenuCatalog); Favorite and ratings are not repeated here. The More button shows
   selected while the menu is open, and opening it closes any other panel (the panel system allows one at a time). *@
<PlaybackPanel Kind="menu" Title="@MoreLabel" ToolId="@_toolId" ItemKey="@ItemKey" Surface="@Surface" ShowHeading="false" HeaderLine="@Item?.Title"
               TriggerClass="playback-item-more" OpenChanged="HandleOpenChangedAsync">
    <TriggerContent><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.More" /></TriggerContent>
    <ChildContent>
        <div class="playback-item-menu" role="menu" aria-label="@MoreLabel" data-playback-item-menu>
            @foreach (var row in Rows)
            {
                @if (row.DividerBefore)
                {
                    <div class="playback-item-menu__divider" role="separator"></div>
                }
                <AppNativeButton Type="button" Class="playback-item-menu__row" role="menuitem" data-playback-item-action="@row.Key"
                                 OnClick="@(() => ActivateAsync(row))">
                    <PlaybackUtilityGlyph Glyph="@row.Glyph" />
                    <span class="playback-item-menu__label">@row.Label</span>
                </AppNativeButton>
            }
            @* The hook for "Play on another device..." (unified player v2 D15, packet 15): rows the host adds after the item's own. *@
            @ExtraRows
        </div>
    </ChildContent>
</PlaybackPanel>

@code {
    [Parameter, EditorRequired] public PlaybackBarMedia Media { get; set; }
    [Parameter, EditorRequired] public ListenQueueItem? Item { get; set; }

    /// <summary>"dock" (the music and audiobook bar) or "video".</summary>
    [Parameter] public string Surface { get; set; } = "dock";

    /// <summary>A TV episode's show and season, once the presentation context has loaded (the Go to show and Go to season rows need them).</summary>
    [Parameter] public Guid? ShowWorkId { get; set; }
    [Parameter] public Guid? SeasonId { get; set; }

    [Parameter] public ListenPlaybackSnapshot? Snapshot { get; set; }
    [Parameter] public IPlaybackCommandSink? Commands { get; set; }
    [Parameter] public Func<bool>? IsCurrent { get; set; }
    [Parameter] public EventCallback<string?> NavigationCompleted { get; set; }

    /// <summary>Opens the Playback settings of this player. Without a handler the row opens Settings, Playback.</summary>
    [Parameter] public EventCallback OnPlaybackSettings { get; set; }

    /// <summary>Extra rows the host adds at the end of the menu (the hook packet 15 uses for "Play on another device...").</summary>
    [Parameter] public RenderFragment? ExtraRows { get; set; }

    private readonly string _toolId = $"item-actions-{Guid.NewGuid():N}";
    private PersonalStatusInfo? _status;
    private (DetailEntityType Type, Guid Id)? _statusSubject;
    private string MoreLabel => Media == PlaybackBarMedia.Music ? "More song actions" : "More actions";

    private Guid? Profile => Snapshot?.ProfileId ?? Services.GetService<PlaybackSessionController>()?.ActiveProfileId;
    private string ItemKey => $"{Item?.WorkId}:{Profile}";
    private IEngineApiClient? Api => Services.GetService<IEngineApiClient>();
    private IAppToastService? Toasts => Services.GetService<IAppToastService>();
    private bool Current() => IsCurrent?.Invoke() != false;

    /// <summary>The page type the Engine keeps listening, reading and watching status under for this item.</summary>
    private (DetailEntityType Type, Guid Id)? StatusSubject => Item is null || Item.WorkId == Guid.Empty ? null : Media switch
    {
        // A song's work id scopes descendants only; its album and siblings stay outside the target.
        PlaybackBarMedia.Music => (DetailEntityType.MusicAlbum, Item.WorkId),
        PlaybackBarMedia.Audiobook => (DetailEntityType.Audiobook, Item.AudiobookWorkId ?? Item.WorkId),
        PlaybackBarMedia.Tv => (DetailEntityType.TvEpisode, Item.WorkId),
        _ => (DetailEntityType.Movie, Item.WorkId),
    };

    private IReadOnlyList<PlaybackItemAction> Rows => Item is null ? [] : PlaybackItemMenuCatalog.Build(new(
        Media, Item,
        IsDone: _status is { OwnedCount: > 0 } status ? status.CompletedCount >= status.OwnedCount : null,
        CanMark: _status is null || _status.OwnedCount > 0,
        ShowWorkId: ShowWorkId, SeasonId: SeasonId));

    protected override void OnParametersSet()
    {
        if (_statusSubject != StatusSubject)
        {
            _status = null;
            _statusSubject = StatusSubject;
        }
    }

    private async Task HandleOpenChangedAsync(bool open)
    {
        if (open) await LoadStatusAsync();
    }

    private async Task LoadStatusAsync()
    {
        if (StatusSubject is not { } subject || Api is not { } api) return;
        try
        {
            var status = await api.GetPersonalStatusAsync(subject.Type, subject.Id);
            if (!Current() || subject != StatusSubject) return;
            _status = status;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Toasts?.Add(ex.Message, AppSeverity.Error);
        }
    }

    private void CloseMenu() => Services.GetService<PlaybackTransientToolCoordinator>()?.Close(_toolId);

    private Task ActivateAsync(PlaybackItemAction row)
    {
        if (!Current()) return Task.CompletedTask;
        CloseMenu();
        return row.Key switch
        {
            PlaybackItemActionKey.AddToPlaylist => AddToPlaylistAsync(),
            PlaybackItemActionKey.MarkDone => ChangeStatusAsync(PersonalStatusAction.Complete),
            PlaybackItemActionKey.MarkNotDone => ChangeStatusAsync(PersonalStatusAction.Reset),
            PlaybackItemActionKey.History => ShowHistoryAsync(),
            PlaybackItemActionKey.PlaybackSettings => OpenPlaybackSettingsAsync(),
            _ => row.Route is { } route ? NavigateAsync(row.Key, route) : Task.CompletedTask,
        };
    }

    private async Task AddToPlaylistAsync()
    {
        if (StatusSubject is not { } subject || Services.GetService<IAppDialogService>() is not { } dialogs) return;
        await dialogs.ShowAsync<MediaMembershipDialog>("Add to playlist", new AppDialogParameters<MediaMembershipDialog>
        {
            { d => d.Playlist, true }, { d => d.WorkIds, new[] { subject.Id } },
        });
    }

    private async Task ChangeStatusAsync(PersonalStatusAction action)
    {
        if (StatusSubject is not { } subject || Api is not { } api) return;
        try
        {
            var status = _status ?? await api.GetPersonalStatusAsync(subject.Type, subject.Id);
            if (status is null || !Current() || subject != StatusSubject) return;
            var result = await api.ChangePersonalStatusAsync(new(Guid.NewGuid(), subject.Type, subject.Id, action, status.Revision));
            _status = await api.GetPersonalStatusAsync(subject.Type, subject.Id);
            Toasts?.Add("Status updated.", AppSeverity.Success, options =>
            {
                options.Action = "Undo";
                options.OnClick = async _ =>
                {
                    try { await api.UndoPersonalStatusAsync(result.CommandId); }
                    catch (Exception ex) { Toasts?.Add(ex.Message, AppSeverity.Error); }
                };
            });
        }
        catch (Exception ex)
        {
            Toasts?.Add(ex.Message, AppSeverity.Error);
        }
    }

    private async Task ShowHistoryAsync()
    {
        if (StatusSubject is not { } subject || Api is not { } api || Services.GetService<IAppDialogService>() is not { } dialogs) return;
        try
        {
            var items = await api.GetPersonalHistoryAsync(subject.Type, subject.Id);
            if (!Current() || subject != StatusSubject) return;
            await dialogs.ShowAsync<PersonalHistoryDialog>(Media is PlaybackBarMedia.Tv or PlaybackBarMedia.Movie ? "Watch history" : "Listening history",
                new AppDialogParameters<PersonalHistoryDialog> { { d => d.Items, items } });
        }
        catch (Exception ex)
        {
            Toasts?.Add(ex.Message, AppSeverity.Error);
        }
    }

    private async Task OpenPlaybackSettingsAsync()
    {
        if (OnPlaybackSettings.HasDelegate)
        {
            await OnPlaybackSettings.InvokeAsync();
            return;
        }
        await NavigationCompleted.InvokeAsync(null);
        Nav.NavigateTo(PlaybackItemRoutes.PlaybackSettings);
    }

    private async Task NavigateAsync(PlaybackItemActionKey key, string route)
    {
        if (Item is not { } item) return;
        // The pop-out window hands album and artist navigation to the main player window; everything else opens in this window.
        var identity = key switch
        {
            PlaybackItemActionKey.GoToAlbum => ("album", item.AlbumWorkId),
            PlaybackItemActionKey.GoToArtist => ("artist", item.ArtistPersonId),
            _ => (string.Empty, (Guid?)null),
        };
        if (Snapshot is { } displayed && Commands is IPlaybackIdentityNavigationSink navigation && identity.Item2 is Guid id)
        {
            string? error;
            try
            {
                var reply = await navigation.NavigateIdentityAsync(displayed, identity.Item1, id);
                error = reply?.BooleanResult == true ? null : "That identity is no longer available in the main player.";
            }
            catch (Exception ex)
            {
                error = ex.Message;
            }
            if (Current() && Item?.AssetId == item.AssetId) await NavigationCompleted.InvokeAsync(error);
            return;
        }
        await NavigationCompleted.InvokeAsync(null);
        Nav.NavigateTo(route);
    }

    public void Dispose() => CloseMenu();
}
