@namespace MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Ui
@if (Context is not null)
{
    <div class="@ResolvedClass" @attributes="AdditionalAttributes">@Content</div>
}
else
{
    <AppDialogFrame Title="@Title" Open="@Visible" DialogOptions="@ResolvedOptions" Class="@ResolvedClass" OnCancel="CloseAsync">@Content</AppDialogFrame>
}
@code {
    [CascadingParameter] public IAppDialogContext? Context { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string Size { get; set; } = "Large";
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public AppDialogOptions? Options { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public RenderFragment? TitleContent { get; set; }
    [Parameter] public RenderFragment? DialogContent { get; set; }
    [Parameter] public RenderFragment? DialogActions { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private AppDialogOptions ResolvedOptions => Options ?? new() { MaxWidth = AppMaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, NoHeader = true };
    private string ResolvedClass => $"app-dialog-host {Class}";
    protected override async Task OnParametersSetAsync()
    {
        if (Context is not null) await Context.SetPresentationClassAsync(ResolvedClass);
    }
    private RenderFragment Content => @<text>
        @if (DialogContent is not null || DialogActions is not null || TitleContent is not null)
        {
            @if (TitleContent is not null) { <header class="app-dialog-title tl-dialog-title">@TitleContent</header> }
            <div class="app-dialog-content tl-dialog-content">@DialogContent</div>
            @if (DialogActions is not null) { <footer class="app-dialog-actions tl-dialog-actions">@DialogActions</footer> }
        }
        else
        {
            <AppDialogShell Modal="false" Title="@Title" Subtitle="@Subtitle" Eyebrow="@Eyebrow" Icon="@Icon" Size="@Size" OnClose="CloseAsync">
                <ChildContent>@ChildContent</ChildContent><FooterContent>@FooterContent</FooterContent>
            </AppDialogShell>
        }
    </text>;
    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate) { await OnClose.InvokeAsync(); return; }
        if (Context is not null) { await Context.CancelAsync(); return; }
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }
}
