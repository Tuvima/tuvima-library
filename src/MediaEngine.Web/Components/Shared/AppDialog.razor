@namespace MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Ui
@if (Context is not null)
{
    <div class="@ResolvedClass" @attributes="AdditionalAttributes">@Content</div>
}
else
{
    <AppDialogFrame Title="@Title" Open="@Visible" DialogOptions="@ResolvedOptions" Class="@ResolvedClass" OnCancel="CloseAsync">@Content</AppDialogFrame>
}
@code {
    [CascadingParameter] public IAppDialogContext? Context { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Icon { get; set; }
    /// <summary>The popup's icon tone (see <see cref="AppDialogShell.Tone"/>).</summary>
    [Parameter] public AppUiTone? Tone { get; set; }
    [Parameter] public string Size { get; set; } = "Large";
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public AppDialogOptions? Options { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public RenderFragment? TitleContent { get; set; }
    [Parameter] public RenderFragment? DialogContent { get; set; }
    [Parameter] public RenderFragment? DialogActions { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private AppDialogOptions ResolvedOptions => Options ?? new() { MaxWidth = AppMaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, NoHeader = true };
    private string ResolvedTitle => !string.IsNullOrWhiteSpace(Title) ? Title : Context?.Title ?? string.Empty;
    private string ResolvedSize => (Options ?? Context?.Options)?.MaxWidth switch
    {
        AppMaxWidth.Small or AppMaxWidth.ExtraSmall => "Small",
        AppMaxWidth.Medium => "Medium",
        null => Size == "Large" ? "Medium" : Size,
        _ => Size,
    };
    private string ResolvedClass => $"app-dialog-host {Class}";
    protected override async Task OnParametersSetAsync()
    {
        if (Context is null) return;
        await Context.SetPresentationClassAsync(ResolvedClass);
        // The shared card draws its own title, so the frame's plain header would repeat it.
        if (DialogActions is not null && Context.Options.NoHeader != true)
            await Context.SetOptionsAsync(Context.Options with { NoHeader = true });
    }
    private RenderFragment Content => @<text>
        @if (DialogActions is not null)
        {
            @* The words-and-buttons popup: the same card as every other popup (one-look spec WP2), with the caller's buttons in the footer. *@
            <AppDialogShell Modal="false" Title="@ResolvedTitle" Subtitle="@Subtitle" Tone="@Tone" Size="@ResolvedSize" OnClose="CloseAsync">
                <ChildContent><div class="app-dialog-content tl-dialog-content">@DialogContent</div></ChildContent>
                <FooterContent>@DialogActions</FooterContent>
            </AppDialogShell>
        }
        else if (DialogContent is not null || TitleContent is not null)
        {
            @if (TitleContent is not null) { <header class="app-dialog-title tl-dialog-title">@TitleContent</header> }
            <div class="app-dialog-content tl-dialog-content">@DialogContent</div>
        }
        else
        {
            <AppDialogShell Modal="false" Title="@Title" Subtitle="@Subtitle" Eyebrow="@Eyebrow" Icon="@Icon" Size="@Size" OnClose="CloseAsync">
                <ChildContent>@ChildContent</ChildContent><FooterContent>@FooterContent</FooterContent>
            </AppDialogShell>
        }
    </text>;
    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate) { await OnClose.InvokeAsync(); return; }
        if (Context is not null) { await Context.CancelAsync(); return; }
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }
}
