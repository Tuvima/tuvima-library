@namespace MediaEngine.Web.Components.Shared
@using Microsoft.JSInterop
@using MediaEngine.Contracts.Playback
@inject IJSRuntime JS
@implements IAsyncDisposable
@inject IStringLocalizer<SharedStrings> L
<div class="playback-seek-rail playback-seek-rail--@Surface" @ref="_root" data-playback-seek-rail data-duration="@Duration.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-chapters="@ChapterJson" data-scrub-index-url="@(HasPreview ? PreviewIndexUrl : null)" data-scrub-index="@PreviewJson"
     role="@(string.IsNullOrWhiteSpace(Summary) ? null : "group")" aria-label="@(string.IsNullOrWhiteSpace(Summary) ? null : Summary)">
    <output class="playback-seek-rail__start" aria-live="off" aria-label="@L["PlaybackSeekRail_ElapsedTime", Time(Position)].Value">@Time(Position)</output>
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        @* The audiobook's chapter or whole-book label sits between the elapsed time and the rail (mockup screen 1). Until the Chapters panel
           carries the Chapter | Whole book choice, the label itself switches it when the host listens. *@
        @if (LabelClick.HasDelegate)
        {
            <AppNativeButton Type="button" Class="playback-seek-rail__label playback-seek-rail__label--action" OnClick="@(() => LabelClick.InvokeAsync())" AriaLabel="@($"{Label}. {LabelAction}")"
                             data-overflow-tooltip="@Label">@Label</AppNativeButton>
        }
        else
        {
            <span class="playback-seek-rail__label" data-overflow-tooltip="@Label">@Label</span>
        }
    }
    <div class="playback-seek-rail__track">
        @if (!string.IsNullOrWhiteSpace(Notice)) { <output class="playback-seek-rail__notice" role="status">@Notice</output> }
        <AppRangeSlider Value="@Position" Min="0" Max="@Math.Max(1, Duration)" Step="1" SnapValueToStep="false" CommitOnChange="true"
                             ShowTicks="@(ChapterTicks is { Count: > 0 })" TickValues="@ChapterTicks" ShowTickText="false" Surface="player"
                             AriaLabel="@L["PlaybackSeekRail_PlaybackPosition"].Value" ValueFormatter="@(value => $"{Time(value)} of {Time(Duration)}")" ValueChanged="SeekAsync" disabled="@(Duration <= 0)" />
        <output class="playback-seek-rail__bubble" data-seek-time aria-hidden="true"></output>
        @if (HasPreview) { <div class="playback-seek-rail__tile" data-scrub-tile aria-hidden="true"></div> }
        @if (Bookmarks is { Count: > 0 } && Duration > 0)
        {
            <div class="playback-seek-rail__bookmarks" data-playback-bookmark-ticks>
                @foreach (var bookmark in Bookmarks)
                {
                    var open = _quickLookId == bookmark.Id;
                    <span class="playback-seek-rail__bookmark-wrap" style="left:@Percent(bookmark.Seconds)%"
                          @onmouseenter="@(() => HoverBookmark(bookmark.Id))" @onmouseleave="@(() => LeaveBookmark(bookmark.Id))">
                        <button type="button" class="playback-seek-rail__bookmark @(bookmark.IsGlobal ? "is-global" : null)"
                                aria-label="@BookmarkLabel(bookmark)" aria-expanded="@(open ? "true" : "false")" data-bookmark-id="@bookmark.Id"
                                @onclick="@(() => ToggleBookmark(bookmark.Id))" @onfocus="@(() => HoverBookmark(bookmark.Id))"></button>
                        @if (open)
                        {
                            <div class="playback-seek-rail__quicklook" role="group" aria-label="@L["PlaybackSeekRail_Bookmark"].Value" style="@CardStyle(bookmark.Seconds)">
                                <strong>@Time(bookmark.Seconds)@if (!bookmark.IsYours && !string.IsNullOrWhiteSpace(bookmark.OwnerName)) { <span> · @bookmark.OwnerName</span> }</strong>
                                @if (!string.IsNullOrWhiteSpace(bookmark.Label)) { <p><b>@bookmark.Label</b></p> }
                                @if (!string.IsNullOrWhiteSpace(bookmark.Note)) { <p>@bookmark.Note</p> }
                                @if (!string.IsNullOrWhiteSpace(bookmark.Description))
                                {
                                    @if (_moreId == bookmark.Id) { <p>@bookmark.Description</p> }
                                    else { <button type="button" class="playback-seek-rail__more" @onclick="@(() => _moreId = bookmark.Id)">@L["Common_More"]</button> }
                                }
                                <span>
                                    <button type="button" class="playback-seek-rail__more" @onclick="@(() => JumpAsync(bookmark))">@L["Common_Play"]</button>
                                    @if (BookmarkDelete.HasDelegate && bookmark.IsYours && !bookmark.IsGlobal)
                                    {
                                        @if (_deleteId == bookmark.Id) { <button type="button" class="playback-seek-rail__more" @onclick="@(() => DeleteAsync(bookmark))">@L["Common_Delete3"]</button> }
                                        else { <button type="button" class="playback-seek-rail__more" @onclick="@(() => _deleteId = bookmark.Id)">@L["Common_Delete"]</button> }
                                    }
                                    @if (_pinnedId == bookmark.Id) { <button type="button" class="playback-seek-rail__more" @onclick="CloseQuickLook">@L["Common_Close"]</button> }
                                </span>
                            </div>
                        }
                    </span>
                }
            </div>
        }
    </div>
    <output class="playback-seek-rail__end" aria-live="off" aria-label="@EndAriaLabel">@EndTime</output>
</div>
@code {
    [Parameter] public double Position { get; set; }
    [Parameter] public double Duration { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<double>? ChapterTicks { get; set; }
    [Parameter] public Func<double, string>? ChapterLabel { get; set; }
    /// <summary>The title's saved bookmarks. Each gets a tick beside the chapters and a quick-look card (hover, or a tap on touch).</summary>
    [Parameter] public IReadOnlyList<PlaybackRailBookmark>? Bookmarks { get; set; }
    /// <summary>Raised when "Jump here" is chosen in a quick-look card.</summary>
    [Parameter] public EventCallback<PlaybackRailBookmark> BookmarkJump { get; set; }
    /// <summary>Raised when "Delete?" is confirmed in a quick-look card (the person's own bookmarks only; the Engine says which are theirs).</summary>
    [Parameter] public EventCallback<PlaybackRailBookmark> BookmarkDelete { get; set; }
    /// <summary>A short line shown over the rail, such as "Bookmark added 13:42".</summary>
    [Parameter] public string? Notice { get; set; }
    private Guid? _quickLookId, _pinnedId, _moreId, _deleteId;
    private async Task DeleteAsync(PlaybackRailBookmark bookmark) { CloseQuickLook(); await BookmarkDelete.InvokeAsync(bookmark); }
    private string Percent(double seconds) => (Math.Clamp(seconds / Math.Max(1, Duration), 0, 1) * 100).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    private string CardStyle(double seconds)
    {
        var fraction = seconds / Math.Max(1, Duration);
        return fraction < .25 ? "left:-6px;transform:none" : fraction > .75 ? "right:-6px;left:auto;transform:none" : string.Empty;
    }
    private string BookmarkLabel(PlaybackRailBookmark bookmark) =>
        $"Bookmark at {Time(bookmark.Seconds)}";
    private void HoverBookmark(Guid id) { if (_pinnedId is null) { _quickLookId = id; _moreId = null; } }
    private void LeaveBookmark(Guid id) { if (_pinnedId is null && _quickLookId == id) { _quickLookId = null; _moreId = null; } }
    private void ToggleBookmark(Guid id)
    {
        if (_pinnedId == id) { CloseQuickLook(); return; }
        _pinnedId = id; _quickLookId = id; _moreId = null;
    }
    private void CloseQuickLook() { _pinnedId = null; _quickLookId = null; _moreId = null; _deleteId = null; }
    private async Task JumpAsync(PlaybackRailBookmark bookmark) { CloseQuickLook(); await BookmarkJump.InvokeAsync(bookmark); }
    [Parameter] public string Surface { get; set; } = "video";
    /// <summary>
    /// Where the Dashboard serves the video's scrub-preview index (see <see cref="PreviewIndexAddress"/>), or null when it has none.
    /// While scrubbing, the picture for the target time shows above the timestamp. Video only; audio never has one.
    /// </summary>
    [Parameter] public string? PreviewIndexUrl { get; set; }
    /// <summary>The index already read, when the page has it. Otherwise the rail reads <see cref="PreviewIndexUrl"/> once, on the first scrub.</summary>
    [Parameter] public ScrubPreviewIndexDto? Preview { get; set; }
    private bool HasPreview => string.Equals(Surface, "video", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(PreviewIndexUrl);
    private string? PreviewJson => HasPreview && Preview is not null ? System.Text.Json.JsonSerializer.Serialize(Preview, PreviewJsonOptions) : null;
    private static readonly System.Text.Json.JsonSerializerOptions PreviewJsonOptions = new(System.Text.Json.JsonSerializerDefaults.Web);
    /// <summary>The Dashboard address of a playback item's preview index, from the Engine address the manifest carries; null when there is none.</summary>
    public static string? PreviewIndexAddress(string? engineIndexUrl)
    {
        // "/stream/{asset}/scrub/index.json" on the Engine is "/engine-scrub/{asset}/index.json" on the Dashboard.
        var parts = (engineIndexUrl ?? string.Empty).Split('/', StringSplitOptions.RemoveEmptyEntries);
        return parts is ["stream", var asset, "scrub", var file] && Guid.TryParse(asset, out var id) && file.EndsWith(".json", StringComparison.Ordinal)
            ? $"/engine-scrub/{id:D}/{file}"
            : null;
    }
    /// <summary>What the right end shows: the time left with a real minus sign ("−1:49"), unless the host passes its own text (the whole-book "6h 12m left").</summary>
    [Parameter] public string? EndText { get; set; }
    private string EndTime => !string.IsNullOrWhiteSpace(EndText) ? EndText : Duration <= 0 ? "—" : RemainingTime(Math.Max(0, Duration - Position));
    private string EndAriaLabel => !string.IsNullOrWhiteSpace(EndText) ? EndText : Duration <= 0 ? L["PlaybackSeekRail_RemainingUnknown"].Value : L["PlaybackSeekRail_RemainingTime", Time(Math.Max(0, Duration - Position))].Value;

    /// <summary>The audiobook label between the elapsed time and the rail: "Chapter 8", or "Book · 32%" in whole-book mode (see <see cref="PlaybackTimelineLabels"/>).</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>The whole line as one sentence for assistive technology: "Chapter 8 · 12:08 · −18:32".</summary>
    [Parameter] public string? Summary { get; set; }

    /// <summary>Raised when the label is pressed (switches the audiobook between the chapter and the whole book).</summary>
    [Parameter] public EventCallback LabelClick { get; set; }
    /// <summary>What the label does when pressed, for assistive technology. Left unset, it reads "Switch between the chapter and the whole book".</summary>
    [Parameter] public string? LabelActionText { get; set; }
    private string LabelAction => string.IsNullOrWhiteSpace(LabelActionText) ? L["PlaybackSeekRail_SwitchChapterOrBook"].Value : LabelActionText;

    /// <summary>A seek never goes outside the loaded duration (unified player v2 D9).</summary>
    public static double ClampSeek(double seconds, double duration) =>
        double.IsFinite(seconds) ? Math.Clamp(seconds, 0d, double.IsFinite(duration) ? Math.Max(0d, duration) : 0d) : 0d;

    private Task SeekAsync(double seconds) => ValueChanged.InvokeAsync(ClampSeek(seconds, Duration));
    private string ChapterJson => System.Text.Json.JsonSerializer.Serialize(ChapterTicks?.Select(time => new { time, title = ChapterLabel?.Invoke(time) }) ?? []);
    private ElementReference _root;
    private IJSObjectReference? _module;
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        try { _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-seek-rail.js"); if (_module is not null) await _module.InvokeVoidAsync("attach", _root); }
        catch (InvalidOperationException) { } catch (JSDisconnectedException) { }
    }
    public async ValueTask DisposeAsync() {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("detach", _root); await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
    /// <summary>The time left, with the real minus sign: "−1:49".</summary>
    public static string RemainingTime(double seconds) => $"\u2212{Time(seconds)}";
    public static string Time(double value) { var seconds = (int)Math.Max(0, double.IsFinite(value) ? value : 0); return seconds >= 3600 ? $"{seconds / 3600}:{seconds / 60 % 60:00}:{seconds % 60:00}" : $"{seconds / 60}:{seconds % 60:00}"; }
}
