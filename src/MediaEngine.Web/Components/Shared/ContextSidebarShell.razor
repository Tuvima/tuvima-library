@namespace MediaEngine.Web.Components.Shared
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="context-sidebar-shell @Class @(IsOpen ? "is-open" : null) @(IsModal ? "is-modal" : null) @(IsPlaybackAppearance ? "context-sidebar-shell--playback" : null)" style="--context-sidebar-width: @(EffectiveWidth)px" @ref="_shell">
    <div class="context-sidebar-shell__main">@MainContent</div>
    @if (IsOpen)
    {
        @if (IsModal)
        {
            <div class="context-sidebar-shell__backdrop" aria-hidden="true" @onclick="CloseAsync" @onclick:stopPropagation="true"></div>
        }
        <aside class="context-sidebar-shell__aside" role="@(IsModal ? "dialog" : "complementary")"
               aria-label="@(string.IsNullOrWhiteSpace(Title) ? AriaLabel : Title)"
               aria-modal="@(IsModal ? "true" : null)" tabindex="@(IsModal ? "-1" : null)" @ref="_aside">
            <div class="context-sidebar-shell__resize" @ref="_resize"
                 role="separator" tabindex="@(IsModal ? "-1" : "0")" aria-label="Resize @AriaLabel"
                 aria-orientation="vertical" aria-valuemin="@MinWidth"
                 aria-valuemax="@MaxWidth" aria-valuenow="@EffectiveWidth"
                 @onkeydown="HandleResizeKeyDown"></div>
            @if (!string.IsNullOrWhiteSpace(Title) || OnClose.HasDelegate)
            {
                <header class="context-sidebar-shell__header">
                    <h2>@(string.IsNullOrWhiteSpace(Title) ? AriaLabel : Title)</h2>
                    @if (OnClose.HasDelegate)
                    {
                        <AppNativeButton Type="button" Class="context-sidebar-shell__close playback-tool-sheet__close" AriaLabel="@($"Close {AriaLabel}")"
                                         title="@($"Close {AriaLabel}")" OnClick="@(_ => CloseAsync())">
                            @if (IsPlaybackAppearance)
                            {
                                <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Close" />
                            }
                            else
                            {
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Close" aria-hidden="true" />
                            }
                        </AppNativeButton>
                    }
                </header>
            }
            <div class="context-sidebar-shell__content">@ChildContent</div>
        </aside>
    }
</div>

@code {
    [Parameter] public RenderFragment? MainContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public int Width { get; set; } = 340;
    [Parameter] public int MinWidth { get; set; } = 320;
    [Parameter] public int MaxWidth { get; set; } = 480;
    [Parameter] public string AriaLabel { get; set; } = "Context sidebar";
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool IsModal { get; set; }
    [Parameter] public string Appearance { get; set; } = "default";
    [Parameter] public Guid? OwnerLeaseId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> WidthChanged { get; set; }

    private ElementReference _shell;
    private ElementReference _resize;
    private ElementReference _aside;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ContextSidebarShell>? _self;
    private bool _resizeAttached;
    private bool _modalAttached;
    private string? _modalAttachmentKey;
    private bool _modalAttachPending;
    private bool _disposed;
    private bool _closing;
    private bool _hasObservedPresentation;
    private bool _observedIsOpen;
    private bool _observedIsModal;
    private string? _observedTitle;
    private Guid? _observedOwnerLeaseId;
    private long _presentationGeneration;
    private int EffectiveWidth => Math.Clamp(Width, MinWidth, MaxWidth);
    private bool IsPlaybackAppearance => string.Equals(Appearance, "playback", StringComparison.OrdinalIgnoreCase);
    private string CurrentModalAttachmentKey => $"{OwnerLeaseId?.ToString("N") ?? "unowned"}:{_presentationGeneration}";

    protected override void OnParametersSet()
    {
        if (!_hasObservedPresentation
            || _observedIsOpen != IsOpen
            || _observedIsModal != IsModal
            || !string.Equals(_observedTitle, Title, StringComparison.Ordinal)
            || _observedOwnerLeaseId != OwnerLeaseId)
        {
            _hasObservedPresentation = true;
            _observedIsOpen = IsOpen;
            _observedIsModal = IsModal;
            _observedTitle = Title;
            _observedOwnerLeaseId = OwnerLeaseId;
            _presentationGeneration++;
            _closing = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _closing)
        {
            return;
        }

        if (!IsOpen)
        {
            await DetachInteractionsAsync();
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/context-sidebar.js");
        if (_disposed || _closing || !IsOpen) return;

        if (!_resizeAttached)
        {
            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attachContextSidebarResize", _shell, _resize, _self, MinWidth, MaxWidth);
            _resizeAttached = true;
            if (_disposed || _closing || !IsOpen)
            {
                await DetachInteractionsAsync();
                return;
            }
        }

        var desiredModalKey = CurrentModalAttachmentKey;
        var replaceModalAttachment = IsModal && (_modalAttached || _modalAttachPending)
            && !string.Equals(_modalAttachmentKey, desiredModalKey, StringComparison.Ordinal);
        if (replaceModalAttachment)
        {
            _modalAttachPending = true;
            _modalAttachmentKey = desiredModalKey;
            try
            {
                await _module.InvokeVoidAsync("attachContextSidebarModal", _shell, _aside, desiredModalKey);
                if (!_disposed && !_closing && IsOpen && IsModal
                    && string.Equals(CurrentModalAttachmentKey, desiredModalKey, StringComparison.Ordinal)
                    && string.Equals(_modalAttachmentKey, desiredModalKey, StringComparison.Ordinal))
                    _modalAttached = true;
            }
            finally
            {
                if (string.Equals(_modalAttachmentKey, desiredModalKey, StringComparison.Ordinal))
                    _modalAttachPending = false;
            }

            if (_disposed || _closing || !IsOpen || !IsModal
                || !string.Equals(CurrentModalAttachmentKey, desiredModalKey, StringComparison.Ordinal))
                await DetachInteractionsAsync(desiredModalKey);
        }
        else if (IsModal && !_modalAttached && !_modalAttachPending)
        {
            _modalAttachPending = true;
            _modalAttachmentKey = desiredModalKey;
            try
            {
                await _module.InvokeVoidAsync("attachContextSidebarModal", _shell, _aside, desiredModalKey);
                if (!_disposed && !_closing && IsOpen && IsModal
                    && string.Equals(CurrentModalAttachmentKey, desiredModalKey, StringComparison.Ordinal)
                    && string.Equals(_modalAttachmentKey, desiredModalKey, StringComparison.Ordinal))
                    _modalAttached = true;
            }
            catch
            {
                if (string.Equals(_modalAttachmentKey, desiredModalKey, StringComparison.Ordinal))
                {
                    _modalAttached = false;
                    _modalAttachmentKey = null;
                }
                throw;
            }
            finally
            {
                if (string.Equals(_modalAttachmentKey, desiredModalKey, StringComparison.Ordinal))
                    _modalAttachPending = false;
            }

            if (_disposed || _closing || !IsOpen || !IsModal
                || !string.Equals(CurrentModalAttachmentKey, desiredModalKey, StringComparison.Ordinal))
                await DetachInteractionsAsync(desiredModalKey);
        }
        else if (!IsModal && (_modalAttached || _modalAttachPending))
        {
            await DetachInteractionsAsync(_modalAttachmentKey);
        }
    }

    private Task HandleResizeKeyDown(KeyboardEventArgs args)
    {
        var delta = args.Key switch
        {
            "ArrowLeft" => 16,
            "ArrowRight" => -16,
            "Home" => MinWidth - EffectiveWidth,
            "End" => MaxWidth - EffectiveWidth,
            _ => 0,
        };
        return delta == 0 ? Task.CompletedTask : WidthChanged.InvokeAsync(Math.Clamp(EffectiveWidth + delta, MinWidth, MaxWidth));
    }

    private async Task CloseAsync()
    {
        if (_disposed || _closing || !IsOpen || !OnClose.HasDelegate) return;

        _closing = true;
        var generation = _presentationGeneration;
        var ownerLeaseId = OwnerLeaseId;
        var callback = OnClose;
        var modalAttachmentKey = _modalAttachmentKey;
        try
        {
            await DetachInteractionsAsync(modalAttachmentKey);
            if (_disposed || !IsOpen) return;
            if (generation != _presentationGeneration || ownerLeaseId != OwnerLeaseId
                || !callback.Equals(OnClose))
            {
                await InvokeAsync(StateHasChanged);
                return;
            }

            await callback.InvokeAsync();
        }
        finally
        {
            if (!_disposed && generation == _presentationGeneration && IsOpen)
                _closing = false;
        }
    }

    private async Task DetachInteractionsAsync(string? modalAttachmentKey = null, bool restorePreviousFocus = true)
    {
        if (_module is null) return;
        var attachmentKey = modalAttachmentKey ?? _modalAttachmentKey;
        if (attachmentKey is not null && (_modalAttached || _modalAttachPending))
        {
            try { await _module.InvokeVoidAsync("restoreContextSidebarModal", _shell, attachmentKey, restorePreviousFocus); }
            catch (JSDisconnectedException) { }
            finally
            {
                if (string.Equals(_modalAttachmentKey, attachmentKey, StringComparison.Ordinal))
                {
                    _modalAttached = false;
                    _modalAttachPending = false;
                    _modalAttachmentKey = null;
                }
            }
        }
        if (_resizeAttached)
        {
            try { await _module.InvokeVoidAsync("detachContextSidebarResize", _resize); }
            catch (JSDisconnectedException) { }
            finally { _resizeAttached = false; }
        }
    }

    [JSInvokable]
    public Task CommitWidthAsync(int width) => WidthChanged.InvokeAsync(Math.Clamp(width, MinWidth, MaxWidth));

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { await DetachInteractionsAsync(); }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
