@namespace MediaEngine.Web.Components.Shared
<label class="@RootClass">
    <span class="app-checkbox-row__copy"><span class="app-checkbox-row__label">@Label</span>@if (!string.IsNullOrWhiteSpace(Description)) { <span class="app-checkbox-row__description">@Description</span> }</span>
    <span class="app-checkbox__control">
        <input type="checkbox" class="tl-checkbox-input" checked="@Value" disabled="@Disabled" @onchange="ChangedAsync" />
        <AppMaterialIcon Icon="@(Value ? AppMaterialIcons.Filled.CheckBox : AppMaterialIcons.Outlined.CheckBoxOutlineBlank)" Size="AppSize.Medium" Class="app-checkbox__glyph" />
    </span>
</label>
@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public AppUiTone Tone { get; set; } = AppUiTone.Primary;
    [Parameter] public string? Class { get; set; }
    private string RootClass => string.Join(" ", new[] { "app-checkbox-row", AppUiMaps.ToneClass(Tone), Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private Task ChangedAsync(ChangeEventArgs args) => !Disabled ? ValueChanged.InvokeAsync(args.Value is true) : Task.CompletedTask;
}
