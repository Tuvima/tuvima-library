@namespace MediaEngine.Web.Components.Shared
@inject IJSRuntime JS

@if (DividerBefore)
{
    <hr class="app-menu-divider" />
}
<button type="button"
        role="@(Checked.HasValue ? "menuitemcheckbox" : "menuitem")" aria-checked="@(Checked?.ToString().ToLowerInvariant())" @ref="_button" @onkeydown="KeyAsync"
        class="@RootClass"
        disabled="@Disabled"
        @onpointerdown:stopPropagation="true"
        @onclick="HandleClick">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <AppMaterialIcon Icon="@Icon" />
    }
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Label
    }
    @if (Checked == true) { <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Check" Class="app-menu-item__check" /> }
</button>

@code {
    private ElementReference _button;
    [CascadingParameter] private AppOverflowMenu? OwnerMenu { get; set; }
    [Parameter] public bool? Checked { get; set; }
    private Task KeyAsync(KeyboardEventArgs e) => e.Key is "ArrowDown" or "ArrowUp" or "Home" or "End" ? JS.InvokeVoidAsync("tuvimaMenu.move", _button, e.Key).AsTask() : Task.CompletedTask;
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool DividerBefore { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public AppUiTone Tone { get; set; } = AppUiTone.Neutral;
    [Parameter] public string? Class { get; set; }

    private string RootClass => string.Join(" ", new[] { "app-menu-item", AppUiMaps.ToneClass(Tone), Class }
        .Where(value => !string.IsNullOrWhiteSpace(value)));

    private async Task HandleClick(MouseEventArgs _)
    {
        if (OwnerMenu is not null && !await OwnerMenu.PrepareActionAsync()) return;
        await OnClick.InvokeAsync();
    }
}
