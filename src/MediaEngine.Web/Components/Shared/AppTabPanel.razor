@namespace MediaEngine.Web.Components.Shared
@implements IDisposable
<section role="tabpanel" id="@PanelId" aria-labelledby="@HeaderId" hidden="@(Parent is not null && !Parent.IsActive(this))" class="tl-tab-panel" tabindex="0">
    @if (Parent is null || Parent.IsActive(this) || Parent.KeepPanelsAlive) { @ChildContent }
</section>
@code {
    [CascadingParameter] internal AppTabs? Parent { get; set; }
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? ToolTip { get; set; }
    /// <summary>Gives the tab its own address; the tab then renders as a link instead of a button.</summary>
    [Parameter] public string? Href { get; set; }
    /// <summary>Optional small muted number shown after the label.</summary>
    [Parameter] public int? Count { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    internal ElementReference HeaderElement;
    internal string HeaderId { get; } = $"tab-{Guid.NewGuid():N}";
    internal string PanelId => $"{HeaderId}-panel";
    protected override void OnInitialized() => Parent?.Register(this);
    protected override void OnParametersSet() { if (Parent is not null) Parent.Register(this); }
    public void Dispose() => Parent?.Unregister(this);
}
