@namespace MediaEngine.Web.Components.Shared

<svg class="playback-utility-glyph" data-playback-glyph="@Glyph" data-filled="@(Filled ? "true" : null)" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    @switch (Glyph)
    {
        case PlaybackUtilityGlyphKind.Previous:
            <path d="M6 5v14M18 6l-9 6 9 6z" />
            break;
        case PlaybackUtilityGlyphKind.Next:
            <path d="M18 5v14M6 6l9 6-9 6z" />
            break;
        case PlaybackUtilityGlyphKind.Play:
            <path d="M7 4.5v15l12-7.5z" fill="currentColor" />
            break;
        case PlaybackUtilityGlyphKind.Pause:
            <path d="M7 5v14M17 5v14" stroke-width="3" />
            break;
        case PlaybackUtilityGlyphKind.NowPlaying:
            <path d="M5 14v-4M9 18V6M13 15V9M17 19V5M21 13v-2" />
            break;
        case PlaybackUtilityGlyphKind.Episodes:
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="M3 10h18M9 10v9" />
            break;
        case PlaybackUtilityGlyphKind.AudioSubtitles:
            <path d="M3 5h18v12H9l-4 3v-3H3z" />
            <path d="M14 9.5a4 4 0 0 1 0 3M16.5 8a6 6 0 0 1 0 6" />
            <path d="M7 11h4M7 14h3" />
            break;
        case PlaybackUtilityGlyphKind.Add:
            <path d="M12 5v14M5 12h14" />
            break;
        case PlaybackUtilityGlyphKind.Check:
            <path d="m5 12 4 4L19 6" />
            break;
        case PlaybackUtilityGlyphKind.Queue:
        case PlaybackUtilityGlyphKind.NextUp:
            <path d="M4 6h16M4 12h16M4 18h10" />
            break;
        case PlaybackUtilityGlyphKind.History:
            <path d="M3.5 8a9 9 0 1 1-.5 4" />
            <path d="M3 3.5V8h4.5M12 7v5l3.5 2" />
            break;
        case PlaybackUtilityGlyphKind.Lyrics:
            <path d="M4 5h16v11H9l-4 3.5V16H4z" />
            <path d="M8 9h8M8 12h5" />
            break;
        case PlaybackUtilityGlyphKind.Chapters:
            <path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01" stroke-width="2.2" />
            break;
        case PlaybackUtilityGlyphKind.Bookmark:
            <path d="M6 3h12v18l-6-4-6 4z" />
            break;
        case PlaybackUtilityGlyphKind.Sleep:
            <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" />
            break;
        case PlaybackUtilityGlyphKind.Speed:
            <path d="M4.2 17a9 9 0 1 1 15.6 0" />
            <path d="m12 13 4-4M7 18h10" />
            break;
        case PlaybackUtilityGlyphKind.Mute:
            <path d="M4 9h3l5-4v14l-5-4H4z" />
            <path d="M16 9l5 6M21 9l-5 6" />
            break;
        case PlaybackUtilityGlyphKind.Volume:
            <path d="M4 9h3l5-4v14l-5-4H4z" />
            <path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" />
            break;
        case PlaybackUtilityGlyphKind.VolumeLow:
            <path d="M4 9h3l5-4v14l-5-4H4z" />
            <path d="M15.5 8.5a5 5 0 0 1 0 7" />
            break;
        case PlaybackUtilityGlyphKind.Shuffle:
            <path d="M3 7h3l4 5-4 5H3M21 7h-3l-8 10H3M18 4l3 3-3 3M18 14l3 3-3 3" />
            break;
        case PlaybackUtilityGlyphKind.Repeat:
            <path d="M17 3l4 4-4 4" />
            <path d="M3 11V9a4 4 0 0 1 4-4h14M7 21l-4-4 4-4" />
            <path d="M21 13v2a4 4 0 0 1-4 4H3" />
            break;
        case PlaybackUtilityGlyphKind.Captions:
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="M10 10a2 2 0 1 0 0 4M17 10a2 2 0 1 0 0 4" />
            break;
        case PlaybackUtilityGlyphKind.Settings:
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" />
            break;
        case PlaybackUtilityGlyphKind.AudioTrack:
            <path d="M4 10v4M8 7v10M12 4v16M16 7v10M20 10v4" />
            break;
        case PlaybackUtilityGlyphKind.Quality:
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="M7 10h2a2 2 0 0 1 0 4H7zM13 14v-4h2.3a2 2 0 0 1 0 4H13z" />
            break;
        case PlaybackUtilityGlyphKind.Fullscreen:
            <path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" />
            break;
        case PlaybackUtilityGlyphKind.PictureInPicture:
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <rect x="12" y="11" width="7" height="5" rx="1" />
            break;
        case PlaybackUtilityGlyphKind.Cast:
            <path d="M4 18a2 2 0 0 1 2 2M4 14a6 6 0 0 1 6 6M4 10a10 10 0 0 1 10 10M4 5h16v13h-4" />
            break;
        case PlaybackUtilityGlyphKind.Favorite:
            <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" />
            break;
        case PlaybackUtilityGlyphKind.Popup:
            <rect x="3" y="5" width="14" height="14" rx="2" />
            <path d="M13 3h8v8M21 3l-9 9" />
            break;
        case PlaybackUtilityGlyphKind.Like:
            <path d="M7 10v10H3V10zM7 10l4-7a2 2 0 0 1 2 2v5h5a2 2 0 0 1 2 2.3l-1.2 7A2 2 0 0 1 16.8 21H7" />
            break;
        case PlaybackUtilityGlyphKind.Dislike:
            <path d="M17 14V4h4v10zM17 14l-4 7a2 2 0 0 1-2-2v-5H6a2 2 0 0 1-2-2.3l1.2-7A2 2 0 0 1 7.2 3H17" />
            break;
        case PlaybackUtilityGlyphKind.Expand:
            <path d="M9 3H3v6M15 3h6v6M3 15v6h6M21 15v6h-6" />
            break;
        case PlaybackUtilityGlyphKind.Restore:
            <rect x="3" y="7" width="13" height="12" rx="1.5" />
            <path d="M8 7V5.5A1.5 1.5 0 0 1 9.5 4H19a2 2 0 0 1 2 2v9.5a1.5 1.5 0 0 1-1.5 1.5H16" />
            break;
        case PlaybackUtilityGlyphKind.Collapse:
            <path d="m5 9 7 7 7-7" />
            break;
        case PlaybackUtilityGlyphKind.Close:
            <path d="M6 6l12 12M18 6L6 18" />
            break;
        case PlaybackUtilityGlyphKind.Back:
            <path d="M15 5l-7 7 7 7" />
            break;
        case PlaybackUtilityGlyphKind.Playlist:
            <path d="M4 6h12M4 11h12M4 16h7M17 13v8M13 17h8" />
            break;
        case PlaybackUtilityGlyphKind.Clock:
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
            break;
        case PlaybackUtilityGlyphKind.Disc:
            <rect x="3" y="3" width="18" height="18" rx="3" />
            <circle cx="12" cy="12" r="3.5" />
            break;
        case PlaybackUtilityGlyphKind.Person:
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21a8 8 0 0 1 16 0" />
            break;
        case PlaybackUtilityGlyphKind.Reset:
            <path d="M4 12a8 8 0 1 0 2.3-5.7L4 8.5" />
            <path d="M4 3.5v5h5" />
            break;
        case PlaybackUtilityGlyphKind.Book:
            <path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z" />
            <path d="M4 5v16" />
            break;
        case PlaybackUtilityGlyphKind.Film:
            <rect x="4" y="4" width="16" height="16" rx="2" />
            <path d="M8 4v16M16 4v16M4 9h4M4 15h4M16 9h4M16 15h4" />
            break;
        case PlaybackUtilityGlyphKind.SubtitleAppearance:
            <path d="M3 18L8 6l5 12M5 14h6M14 18l3-7 3 7M15.5 15.5h3" />
            break;
        case PlaybackUtilityGlyphKind.Search:
            <circle cx="11" cy="11" r="6" />
            <path d="M20 20l-4.5-4.5" />
            break;
        case PlaybackUtilityGlyphKind.ChevronRight:
            <path d="M9 6l6 6-6 6" />
            break;
        case PlaybackUtilityGlyphKind.ChevronUp:
            <path d="M6 15l6-6 6 6" />
            break;
        case PlaybackUtilityGlyphKind.Drag:
            <circle cx="9" cy="6" r="1.3" fill="currentColor" />
            <circle cx="15" cy="6" r="1.3" fill="currentColor" />
            <circle cx="9" cy="12" r="1.3" fill="currentColor" />
            <circle cx="15" cy="12" r="1.3" fill="currentColor" />
            <circle cx="9" cy="18" r="1.3" fill="currentColor" />
            <circle cx="15" cy="18" r="1.3" fill="currentColor" />
            break;
        case PlaybackUtilityGlyphKind.ChevronDown:
            <path d="M6 9l6 6 6-6" />
            break;
        case PlaybackUtilityGlyphKind.SkipBack:
            <path d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3L4.5 8.9" />
            <path d="M4.5 4v5h5" />
            break;
        case PlaybackUtilityGlyphKind.SkipForward:
            <path d="M19.5 12a7.5 7.5 0 1 1-2.2-5.3l2.2 2.2" />
            <path d="M19.5 4v5h-5" />
            break;
        case PlaybackUtilityGlyphKind.Info:
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5M12 8h.01" stroke-width="2.2" />
            break;
        case PlaybackUtilityGlyphKind.OpenExternal:
            <path d="M14 4h6v6M20 4l-9 9M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" />
            break;
        case PlaybackUtilityGlyphKind.More:
            <circle cx="5" cy="12" r="1.1" fill="currentColor" />
            <circle cx="12" cy="12" r="1.1" fill="currentColor" />
            <circle cx="19" cy="12" r="1.1" fill="currentColor" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public PlaybackUtilityGlyphKind Glyph { get; set; }

    /// <summary>Fills the outline, for a toggle that is on (a saved My List heart).</summary>
    [Parameter] public bool Filled { get; set; }
}
