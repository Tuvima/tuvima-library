@namespace MediaEngine.Web.Components.Shared

<svg class="playback-utility-glyph" data-playback-glyph="@Glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    @switch (Glyph)
    {
        case PlaybackUtilityGlyphKind.Add:
            <path d="M12 5v14M5 12h14" />
            break;
        case PlaybackUtilityGlyphKind.Check:
            <path d="m5 12 4 4L19 6" />
            break;
        case PlaybackUtilityGlyphKind.Queue:
        case PlaybackUtilityGlyphKind.NextUp:
            <path d="M4 6h12M4 10h12M4 14h8" />
            <path d="m15 15 5 3-5 3z" />
            break;
        case PlaybackUtilityGlyphKind.History:
            <path d="M3.5 8a9 9 0 1 1-.5 4" />
            <path d="M3 3.5V8h4.5M12 7v5l3.5 2" />
            break;
        case PlaybackUtilityGlyphKind.Lyrics:
            <path d="M5 3h14a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2h-8l-6 4v-4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" />
            <path d="M8 8h2v3H8l-1 2M14 8h2v3h-2l-1 2" />
            break;
        case PlaybackUtilityGlyphKind.Chapters:
            <path d="M9 5h11M9 12h11M9 19h11M4 5h.01M4 12h.01M4 19h.01" />
            break;
        case PlaybackUtilityGlyphKind.Bookmark:
            <path d="M6 4.5h12v16l-6-4-6 4zM12 7v6M9 10h6" />
            break;
        case PlaybackUtilityGlyphKind.Sleep:
            <path d="M19.5 14.2A8 8 0 0 1 9.8 4.5a8.5 8.5 0 1 0 9.7 9.7z" />
            break;
        case PlaybackUtilityGlyphKind.Speed:
            <path d="M4.2 17a9 9 0 1 1 15.6 0" />
            <path d="m12 13 4-4M7 18h10" />
            break;
        case PlaybackUtilityGlyphKind.Mute:
            <path d="M4 9v6h4l5 4V5L8 9zM17 9l4 6M21 9l-4 6" />
            break;
        case PlaybackUtilityGlyphKind.Volume:
            <path d="M4 9v6h4l5 4V5L8 9zM16 9a4 4 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11" />
            break;
        case PlaybackUtilityGlyphKind.Shuffle:
            <path d="M4 7h2.5a5 5 0 0 1 4 2l7 8a5 5 0 0 0 4 2H22" />
            <path d="m18 16 4 3-4 3M4 19h2.5a5 5 0 0 0 4-2l7-8a5 5 0 0 1 4-2H22" />
            <path d="m18 4 4 3-4 3" />
            break;
        case PlaybackUtilityGlyphKind.Repeat:
            <path d="M17 2l4 4-4 4M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4M21 13v2a3 3 0 0 1-3 3H3" />
            break;
        case PlaybackUtilityGlyphKind.Captions:
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="M10 10a2 2 0 1 0 0 4M17 10a2 2 0 1 0 0 4" />
            break;
        case PlaybackUtilityGlyphKind.AudioTrack:
            <path d="M4 10v4M8 7v10M12 4v16M16 7v10M20 10v4" />
            break;
        case PlaybackUtilityGlyphKind.Quality:
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="M7 10h2a2 2 0 0 1 0 4H7zM13 14v-4h2.3a2 2 0 0 1 0 4H13z" />
            break;
        case PlaybackUtilityGlyphKind.Fullscreen:
            <path d="M8 3H3v5M16 3h5v5M3 16v5h5M21 16v5h-5" />
            break;
        case PlaybackUtilityGlyphKind.PictureInPicture:
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <rect x="12" y="11" width="7" height="5" rx="1" />
            break;
        case PlaybackUtilityGlyphKind.Cast:
            <path d="M4 18a2 2 0 0 1 2 2M4 14a6 6 0 0 1 6 6M4 10a10 10 0 0 1 10 10M4 5h16v13h-4" />
            break;
        case PlaybackUtilityGlyphKind.Favorite:
            <path d="M20.5 8.8c0 5.2-8.5 10.2-8.5 10.2S3.5 14 3.5 8.8A4.3 4.3 0 0 1 12 7a4.3 4.3 0 0 1 8.5 1.8z" />
            break;
        case PlaybackUtilityGlyphKind.Popup:
            <rect x="3" y="5" width="14" height="14" rx="2" />
            <path d="M13 3h8v8M21 3l-9 9" />
            break;
        case PlaybackUtilityGlyphKind.Like:
            <path d="M8 10 12 3a2.5 2.5 0 0 1 2 3l-1 4h6a2 2 0 0 1 2 2.4l-1.2 6A2 2 0 0 1 17.8 20H8zM3 10h5v10H3z" />
            break;
        case PlaybackUtilityGlyphKind.Dislike:
            <path transform="rotate(180 12 12)" d="M8 10 12 3a2.5 2.5 0 0 1 2 3l-1 4h6a2 2 0 0 1 2 2.4l-1.2 6A2 2 0 0 1 17.8 20H8zM3 10h5v10H3z" />
            break;
        case PlaybackUtilityGlyphKind.Expand:
            <path d="M9 3H3v6M15 3h6v6M3 15v6h6M21 15v6h-6" />
            break;
        case PlaybackUtilityGlyphKind.Restore:
            <rect x="3" y="7" width="13" height="12" rx="1.5" />
            <path d="M8 7V5.5A1.5 1.5 0 0 1 9.5 4H19a2 2 0 0 1 2 2v9.5a1.5 1.5 0 0 1-1.5 1.5H16" />
            break;
        case PlaybackUtilityGlyphKind.Collapse:
            <path d="m5 9 7 7 7-7" />
            break;
        case PlaybackUtilityGlyphKind.Close:
            <path d="m5 5 14 14M19 5 5 19" />
            break;
        case PlaybackUtilityGlyphKind.More:
            <circle cx="5" cy="12" r="1.1" fill="currentColor" />
            <circle cx="12" cy="12" r="1.1" fill="currentColor" />
            <circle cx="19" cy="12" r="1.1" fill="currentColor" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public PlaybackUtilityGlyphKind Glyph { get; set; }
}
