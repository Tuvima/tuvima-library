@namespace MediaEngine.Web.Components.Shared
@using System.Linq
@using MediaEngine.Web.Services.Playback
@implements IDisposable
@inject IServiceProvider Services
@inject IStringLocalizer<SharedStrings> L

@* The one persistent bar for music, audiobooks, TV and movies (unified player v2 D1 to D6). Three zones in a grid whose outer columns are equal
   (1fr auto 1fr), so Play sits at the exact centre whatever the title or the tools take: identity on the left, transport in the middle, the
   tools of D4 on the right. The shell draws the bar from PlaybackControlCatalog and the playing item; the two hosts (ListenNowPlayingBar and
   VideoPlaybackHost) keep the playback wiring, the media elements and the panels, and slot their own pieces in (the timeline, the identity
   links and actions, and any tool whose panel they own through HostedTools and ToolContent). *@
<section class="@RootClass" aria-label="@AriaLabel" data-playback-shell data-playback-media="@MediaName" data-playback-surface="@NormalizedSurface" @attributes="AdditionalAttributes">
    @if (TimelineContent is not null)
    {
        <div class="playback-shell__timeline" data-playback-zone="timeline">@TimelineContent</div>
    }
    <div class="playback-shell__row">
        @* The video overlay on a phone has its title and "..." menu in the header above, so the bar repeats neither. *@
        @if (!Phone)
        {
            <PlaybackIdentity @ref="_identity" Media="@Media" Compact="@Compact" Identity="@Identity" LinkContent="@LinkContent"
                              ArtworkSrc="@ArtworkSrc" ArtworkSrcSet="@ArtworkSrcSet" ArtworkAlt="@ArtworkAlt" ArtworkDisplay="@ArtworkDisplay" ArtworkIsPoster="@ArtworkIsPoster"
                              ArtworkClick="@ArtworkClick" ArtworkLabel="@ArtworkLabel" Actions="@IdentityActions" ErrorText="@ErrorText" RemoteLine="@RemoteLine" />
        }

        <div class="playback-shell__transport" role="group" aria-label="@TransportLabel" data-playback-zone="transport">
            @foreach (var control in TransportControls)
            {
                @switch (control.Key)
                {
                    case PlaybackControlKey.PlayPause:
                        <PlaybackPrimaryButton Size="bar" IsPlaying="@State.IsPlaying" NeedsUserGestureToStart="@State.NeedsUserGestureToStart"
                                               Disabled="@control.IsDisabled" AriaLabel="@control.AriaLabel"
                                               OnClick="@(() => OnTransport.InvokeAsync(control))" @attributes="PlayButtonAttributes" />
                        break;
                    case PlaybackControlKey.SkipBack:
                    case PlaybackControlKey.SkipForward:
                        <PlaybackRelativeSkipButton Size="bar" Direction="@(control.Key == PlaybackControlKey.SkipBack ? "back" : "forward")"
                                                    Seconds="@(control.Key == PlaybackControlKey.SkipBack ? State.SkipBackSeconds : State.SkipForwardSeconds)"
                                                    Disabled="@control.IsDisabled" OnClick="@(() => OnTransport.InvokeAsync(control))" />
                        break;
                    default:
                        <PlaybackIconButton Control="@control" Surface="@IconSurface" Appearance="bare"
                                            OnClick="@(() => OnTransport.InvokeAsync(control))" />
                        break;
                }
            }
        </div>

        @if (!Compact)
        {
        <div class="playback-shell__tools" role="toolbar" aria-label="@ToolsLabel" data-playback-zone="tools" data-playback-tools-zone>
            @foreach (var tool in ToolControls)
            {
                @if (OmittedTools.Contains(tool.Key) || (tool.Key == PlaybackControlKey.Volume && _remote?.IsRemote == true))
                {
                    @* While a receiver plays, its own remote owns the volume, so the bar has none (unified player v2 D28). *@
                }
                else if (HostedTools.Contains(tool.Key) && ToolContent is not null)
                {
                    @ToolContent(tool)
                }
                else if (tool.Key == PlaybackControlKey.Volume)
                {
                    <PlaybackVolumeControl Surface="@IconSurface" Size="standard" Appearance="bare" CommitOnChange="@CommitVolumeOnChange" Step="@VolumeStep"
                                           Volume="@Volume" IsMuted="@IsMuted" Supported="@VolumeSupported"
                                           OnToggleMute="OnToggleMute" OnVolumeChanged="OnVolumeChanged" />
                }
                else if (tool.Key == PlaybackControlKey.Speed)
                {
                    <AppTooltip Text="@tool.AriaLabel">
                        <AppNativeButton Type="button" Class="@($"playback-popover-trigger playback-shell__chip{(tool.IsActive ? " is-on" : null)}")" AriaLabel="@tool.AriaLabel"
                                         OnClick="@(() => OnTool.InvokeAsync(new PlaybackControlActivation(tool, default)))">@tool.ValueText</AppNativeButton>
                    </AppTooltip>
                }
                else
                {
                    <PlaybackIconButton Control="@tool" Surface="@IconSurface" Appearance="bare"
                                        OnActivated="@(trigger => OnTool.InvokeAsync(new PlaybackControlActivation(tool, trigger)))" />
                }
            }
        </div>
        }
    </div>
</section>

@code {
    /// <summary>Which of the four media the bar is drawn for.</summary>
    [Parameter] public PlaybackBarMedia Media { get; set; }

    /// <summary>"dock" (the bar over the library, on the shell color) or "video" (over the picture: hover is 12% white instead of 8%).</summary>
    [Parameter] public string Surface { get; set; } = "dock";

    /// <summary>The phone's collapsed bar (unified player v2 D26): Play and Next (Skip forward for audiobooks) and the one tool that opens Now playing.</summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>
    /// A video player on a phone (unified player v2 D26): the same five transport buttons and one row of Audio &amp; subtitles, Episodes (Lessons), Bookmarks and
    /// Fullscreen; Playback settings and Close move to the header the host draws. Not the collapsed audio bar, which is <see cref="Compact"/>.
    /// </summary>
    [Parameter] public bool Phone { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public string AriaLabel { get; set; } = "Player";

    /// <summary>What the transport and tools are drawn from.</summary>
    [Parameter] public PlaybackBarState State { get; set; } = new();

    /// <summary>The title and second line (see <see cref="PlaybackBarIdentity.Build"/>).</summary>
    [Parameter] public PlaybackBarIdentity Identity { get; set; } = new(string.Empty, null, null, []);

    /// <summary>Draws a title or name that links to its page; without it every name is plain text.</summary>
    [Parameter] public RenderFragment<PlaybackIdentityLinkRequest>? LinkContent { get; set; }

    [Parameter] public string? ArtworkSrc { get; set; }
    [Parameter] public string? ArtworkSrcSet { get; set; }
    [Parameter] public string? ArtworkAlt { get; set; }
    [Parameter] public string? ArtworkDisplay { get; set; }

    /// <summary>True when the picture is a portrait poster in a landscape slot: it is drawn whole on a blurred fill (see <see cref="PlaybackArtworkUrl.ForBarSlot"/>).</summary>
    [Parameter] public bool ArtworkIsPoster { get; set; }

    /// <summary>The artwork becomes a button (it opens Now playing) when the host listens.</summary>
    [Parameter] public EventCallback ArtworkClick { get; set; }
    [Parameter] public string ArtworkLabel { get; set; } = "Open Now playing";

    /// <summary>Favorite, Like, Dislike and More for music; Favorite and More for the other media. Drawn beside the text (see <see cref="PlaybackIdentityActions"/>).</summary>
    [Parameter] public RenderFragment? IdentityActions { get; set; }

    /// <summary>Shown under the second line in the error color when playback failed.</summary>
    [Parameter] public string? ErrorText { get; set; }

    /// <summary>The thin timeline above the row (the host passes its PlaybackSeekRail; the shell does not restyle it).</summary>
    [Parameter] public RenderFragment? TimelineContent { get; set; }

    [Parameter] public EventCallback<PlaybackControlDefinition> OnTransport { get; set; }
    /// <summary>A tool that has no panel of the host's own was pressed; carries the button so the host can anchor a panel to it.</summary>
    [Parameter] public EventCallback<PlaybackControlActivation> OnTool { get; set; }

    /// <summary>Tools whose panel the host owns; the shell asks <see cref="ToolContent"/> to draw them in their place in the order.</summary>
    [Parameter] public IReadOnlySet<PlaybackControlKey> HostedTools { get; set; } = new HashSet<PlaybackControlKey>();
    [Parameter] public RenderFragment<PlaybackControlDefinition>? ToolContent { get; set; }

    /// <summary>Tools the host has no panel for yet; the shell leaves them out rather than draw a button that does nothing.</summary>
    [Parameter] public IReadOnlySet<PlaybackControlKey> OmittedTools { get; set; } = new HashSet<PlaybackControlKey>();

    /// <summary>Extra attributes for the Play button (the audio bar's start-on-gesture data).</summary>
    [Parameter] public IReadOnlyDictionary<string, object>? PlayButtonAttributes { get; set; }

    [Parameter] public double Volume { get; set; }
    [Parameter] public bool IsMuted { get; set; }
    [Parameter] public bool VolumeSupported { get; set; } = true;
    [Parameter] public double VolumeStep { get; set; } = 0.05;
    /// <summary>True sends the volume once the slider is released (the audio bar); false follows the drag (the video).</summary>
    [Parameter] public bool CommitVolumeOnChange { get; set; } = true;
    [Parameter] public EventCallback OnToggleMute { get; set; }
    [Parameter] public EventCallback<double> OnVolumeChanged { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private PlaybackIdentity? _identity;
    private PlaybackRemoteController? _remote;

    protected override void OnInitialized()
    {
        // Optional: a page that has no remote controller (a test host, a pop-out) draws the bar as it always did.
        _remote = Services.GetService(typeof(PlaybackRemoteController)) as PlaybackRemoteController;
        if (_remote is not null)
        {
            _remote.Changed += OnRemoteChanged;
        }
    }

    private void OnRemoteChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>"Playing on Living room TV" while a receiver plays; the name is "another device" when the browser does not give one.</summary>
    private string? RemoteLine => _remote is { IsRemote: true } remote
        ? L["PlaybackRemote_PlayingOn", remote.DeviceName ?? L["PlaybackRemote_AnotherDevice"].Value].Value
        : null;

    public void Dispose()
    {
        if (_remote is not null)
        {
            _remote.Changed -= OnRemoteChanged;
        }
    }

    /// <summary>The artwork button, so a host can anchor a panel to it or return focus to it.</summary>
    public ElementReference? ArtworkElement => _identity?.ArtworkElement;

    private string NormalizedSurface => Surface == "video" ? "video" : "dock";
    private string IconSurface => NormalizedSurface == "video" ? "video" : "dock";
    private string MediaName => Media.ToString().ToLowerInvariant();
    private string TransportLabel => Media switch
    {
        PlaybackBarMedia.Music => "Music playback controls",
        PlaybackBarMedia.Audiobook => "Audiobook playback controls",
        _ => "Video playback controls",
    };
    private string ToolsLabel => "Playback tools";

    private string RootClass => string.Join(" ", new[]
    {
        "playback-shell",
        $"playback-shell--{MediaName}",
        $"playback-shell--surface-{NormalizedSurface}",
        Compact ? "playback-shell--compact" : null,
        Phone ? "playback-shell--phone" : null,
        Class,
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    /// <summary>The transport, trimmed for the phone's collapsed bar: Play and Next (Skip forward for audiobooks), nothing else.</summary>
    private IReadOnlyList<PlaybackControlDefinition> TransportControls
    {
        get
        {
            return Compact ? PlaybackControlCatalog.BuildCollapsedTransport(Media, State) : PlaybackControlCatalog.BuildBarTransport(Media, State);
        }
    }

    /// <summary>The tools of D4. The phone's collapsed bar has none: a tap on its art or text expands the player, whose own row holds the tools (D26).</summary>
    private IReadOnlyList<PlaybackControlDefinition> ToolControls =>
        Compact ? [] : Phone ? PlaybackControlCatalog.BuildPhoneTools(Media, State) : PlaybackControlCatalog.BuildBarTools(Media, State);
}
