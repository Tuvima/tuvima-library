@namespace MediaEngine.Web.Components.Shared
@using System.Linq
@using Microsoft.AspNetCore.Components.Web

<span class="@RootClass">
    <AppTooltip Text="@ResolvedAriaLabel">
    <AppNativeButton Type="button"
                     Class="@ButtonClass"
                     Css="@Css"
                     Disabled="@Disabled"
                     OnClick="@HandleClickAsync"
                     AriaLabel="@ResolvedAriaLabel"
                     @attributes="AdditionalAttributes">
        @if (IsBar || IsPhone)
        {
            <PlaybackUtilityGlyph Glyph="@(ShowsPause ? PlaybackUtilityGlyphKind.Pause : PlaybackUtilityGlyphKind.Play)" />
        }
        else
        {
            <AppMaterialIcon Icon="@Icon" Class="playback-primary-button__icon" />
        }
    </AppNativeButton>
    </AppTooltip>
</span>

@code {
    [Parameter]
    public bool IsPlaying { get; set; }

    [Parameter]
    public bool NeedsUserGestureToStart { get; set; }

    [Parameter]
    public string Size { get; set; } = "standard";

    [Parameter]
    public string Appearance { get; set; } = "standard";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Css { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; } = "Play or pause";

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string NormalizedSize => Size switch
    {
        "compact" => "compact",
        "large" => "large",
        "bar" => "bar",
        "phone" => "phone",
        _ => "standard"
    };

    /// <summary>The persistent bar's Play button (unified player v2 D6): a 32 px stroke glyph in a 48 px target, no ring, the shared state set.</summary>
    private bool IsBar => NormalizedSize == "bar";
    /// <summary>The phone's expanded player (unified player v2 D26, mockup screen 15): a 64 px white disc with a black glyph.</summary>
    private bool IsPhone => NormalizedSize == "phone";
    private bool ShowsPause => IsPlaying && !NeedsUserGestureToStart;
    // The bar does not wear the ring button's class, so none of the ring button's state rules can reach it.
    private string ButtonClass => IsPhone ? "playback-phone-play" : IsBar ? "playback-bar-play" : "playback-primary-button";

    private string NormalizedAppearance => Appearance is "dock" or "video" ? Appearance : "standard";

    private string Icon => IsPlaying && !NeedsUserGestureToStart
        ? AppMaterialIcons.Filled.Pause
        : AppMaterialIcons.Filled.PlayArrow;

    private string ResolvedAriaLabel => string.IsNullOrWhiteSpace(AriaLabel) || AriaLabel == "Play or pause"
        ? IsPlaying && !NeedsUserGestureToStart ? "Pause" : "Play"
        : AriaLabel;

    private string RootClass => string.Join(
        " ",
        new[]
        {
            "playback-primary-button-shell",
            $"playback-primary-button-shell--{NormalizedSize}",
            $"playback-primary-button-shell--appearance-{NormalizedAppearance}",
            ShowsPause ? "is-playing" : null,
            Disabled ? "is-disabled" : null,
            Class
        }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private Task HandleClickAsync(MouseEventArgs _)
    {
        return OnClick.InvokeAsync();
    }
}
