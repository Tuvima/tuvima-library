@namespace MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Ui
<div class="app-dialog-host @Class">
    <AppDialogShell Modal="false" Title="@Title" Subtitle="@Subtitle" Eyebrow="@Eyebrow" Icon="@Icon" HeaderArt="@HeaderArt" Size="@Size" OnClose="CloseAsync">
        <ChildContent>@ChildContent</ChildContent><FooterContent>@FooterContent</FooterContent>
    </AppDialogShell>
</div>
@code {
    [CascadingParameter] public IAppDialogContext? Context { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string Size { get; set; } = "Large";
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? HeaderArt { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    protected override Task OnParametersSetAsync() => Context?.SetPresentationClassAsync($"app-dialog-host {Class}") ?? Task.CompletedTask;
    private Task CloseAsync() => OnClose.HasDelegate ? OnClose.InvokeAsync() : Context?.CancelAsync() ?? Task.CompletedTask;
}
