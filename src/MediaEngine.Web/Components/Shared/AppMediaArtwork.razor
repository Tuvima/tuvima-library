@namespace MediaEngine.Web.Components.Shared

@using MediaEngine.Web.Services.MediaTiles

<div class="@RootClass" style="@RootStyle">
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img src="@MediaTileArtworkUrl.ForDrawnSize(ImageUrl, ResolvedDrawnPx)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(ImageUrl, ResolvedDrawnPx)" alt="@Alt" class="app-media-artwork__image" loading="lazy" decoding="async" />
    }
    else
    {
        <div class="app-media-artwork__fallback">
            <AppMaterialIcon Icon="@FallbackIcon" />
            @if (!string.IsNullOrWhiteSpace(FallbackText))
            {
                <span>@FallbackText</span>
            }
        </div>
    }
    @if (Badge is not null)
    {
        <div class="app-media-artwork__badge">@Badge</div>
    }
    @if (Progress is > 0)
    {
        <AppProgressBar Value="@Progress" AccentColor="@AccentColor" Class="app-media-artwork__progress" />
    }
</div>

@code {
    [Parameter] public string? ImageUrl { get; set; }
    /// <summary>How wide the picture is drawn, for example "148px". Used as the drawn size when <see cref="DrawnPx"/> is not set.</summary>
    [Parameter] public string Sizes { get; set; } = "96px";

    /// <summary>The long side the picture is drawn at, in CSS pixels. 0 reads it from <see cref="Sizes"/> (96 by default: the tiny copy).</summary>
    [Parameter] public int DrawnPx { get; set; }
    [Parameter] public string? Alt { get; set; }
    [Parameter] public string? FallbackText { get; set; }
    [Parameter] public string FallbackIcon { get; set; } = AppMaterialIcons.Outlined.Image;
    [Parameter] public string AspectRatio { get; set; } = "2 / 3";
    [Parameter] public string? AccentColor { get; set; }
    [Parameter] public double? Progress { get; set; }
    [Parameter] public RenderFragment? Badge { get; set; }
    [Parameter] public string? Class { get; set; }

    private int ResolvedDrawnPx => DrawnPx > 0
        ? DrawnPx
        : int.TryParse(Sizes.Trim().Replace("px", string.Empty, StringComparison.OrdinalIgnoreCase), out var fromSizes) && fromSizes > 0
            ? fromSizes
            : ArtworkSize.TinyPx;

    private string RootStyle =>
        string.IsNullOrWhiteSpace(AccentColor)
            ? $"--app-media-artwork-aspect: {AspectRatio};"
            : $"--app-media-artwork-aspect: {AspectRatio}; --app-media-accent: {AccentColor};";

    private string RootClass =>
        string.Join(" ", new[]
        {
            "app-media-artwork",
            string.IsNullOrWhiteSpace(ImageUrl) ? "app-media-artwork--empty" : null,
            Class,
        }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
