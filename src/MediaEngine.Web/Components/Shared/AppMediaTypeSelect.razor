@using MudBlazor

<AppSelect Value="@Value" ValueChanged="OnValueChanged" Options="@SelectOptions" Class="@($"app-media-type-select {Class}".Trim())" PopoverClass="app-media-type-select__popover" />

@code {
    private static readonly IReadOnlyList<(string Value, string Label)> Options =
    [
        ("Books", "Books"),
        ("Audiobooks", "Audiobooks"),
        ("Movies", "Movies"),
        ("TV", "TV"),
        ("Music", "Music"),
        ("Comics", "Comics"),
    ];

    [Parameter] public string Value { get; set; } = "Books";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Class { get; set; }

    private static readonly IReadOnlyList<AppSelectOption> SelectOptions = Options.Select(option => new AppSelectOption(option.Value, option.Label)).ToArray();
    private Task OnValueChanged(string? value) => ValueChanged.InvokeAsync(value ?? Value);
}
