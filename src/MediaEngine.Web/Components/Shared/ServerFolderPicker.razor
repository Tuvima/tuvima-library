@namespace MediaEngine.Web.Components.Shared
@inject IEngineApiClient ApiClient
@using Microsoft.JSInterop
@using MediaEngine.Web.Services.Formatting
@implements IDisposable
@inject IStringLocalizer<SharedStrings> L


@if (Inline)
{
    <div class="server-folder-picker__inline">
        @BodyContent
        <div class="server-folder-picker__inline-footer">@FooterContent</div>
    </div>
}
else
{
    <AppDialogShell Title="@Title"
                     Subtitle="@HelpText"
                     Icon="@AppMediaPresentation.IconFor(MediaType, outlined: true)"
                     Size="Large"
                     Modal="false"
                     HostClass="@HostClass"
                     OnClose="Cancel">
        <ChildContent>@BodyContent</ChildContent>
        <FooterContent>@FooterContent</FooterContent>
    </AppDialogShell>
}

@code {
    // The picker body and footer are shared by the dialog and the inline (embedded) form. The body is the shared browser frame (Editor v5 D32, screen N):
    // Locations on the left, the toolbar, the folder you are inside named above the list, and folder rows. The folder you are inside IS the selection.
    private RenderFragment BodyContent => @<text>
        <div class="server-folder-picker">
            <AppBrowserFrame @ref="_frame"
                             Kind="folders"
                             Inline="Inline"
                             ShowToolbar="ShowBrowser"
                             Busy="_loadingBrowse"
                             SidebarLabel="@L["FolderPicker_PickALocation"].Value"
                             ListLabel="@L["FolderPicker_ServerFolders"].Value"
                             OnBack="BackAsync"
                             CanGoBack="CanGoBack"
                             OnUp="NavigateUpAsync"
                             CanGoUp="@(_browse?.ParentRelativePath is not null)"
                             OnRefresh="RefreshAsync"
                             Search="@_search"
                             SearchChanged="SearchChangedAsync"
                             SearchDebounce="275"
                             SearchPlaceholder="@L["FolderPicker_SearchFolders"].Value"
                             IdPrefix="@FolderIdPrefix"
                             RowCount="@(_browse?.Directories.Count ?? 0)"
                             Highlight="_highlight"
                             HighlightChanged="@(index => _highlight = index)"
                             OnOpenRow="OpenHighlightedAsync"
                             ShowState="@ShowListState">
                <TopContent>
                    @if (ShowFolderName || TopContent is not null || !string.IsNullOrWhiteSpace(TargetLabel))
                    {
                        @* One row above the list: the friendly name with its hint beside it, and the host's own context (the area and kind chips) at the far end. *@
                        <div class="server-folder-picker__head">
                            @if (ShowFolderName)
                            {
                                @* The folder's friendly name, first thing in the folder step (Libraries v3 D18): it names the folder, never the library. It is the only text box. *@
                                <div class="server-folder-picker__name-row">
                                    <div class="server-folder-picker__name" data-folder-name>
                                        <AppTextField Label="@L["LibraryEditDialog_FriendlyName"].Value"
                                                      Size="AppControlSize.Compact"
                                                      Value="@_folderName"
                                                      ValueChanged="FolderNameEdited"
                                                      MaxLength="@FolderHandlingWords.MaxFolderNameLength" />
                                    </div>
                                    <span class="server-folder-picker__name-hint">@L["ServerFolderPicker_FriendlyNameHint"]</span>
                                </div>
                            }
                            @if (TopContent is not null)
                            {
                                @* The host's own context (Add library puts the area and kind here). *@
                                <div class="server-folder-picker__top" data-picker-top>@TopContent</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(TargetLabel) && TopContent is null)
                            {
                                @* Says what this pick is for, so a folder meant for one library is not chosen for another by accident. *@
                                <p class="server-folder-picker__target" data-picker-target>Choose the folder that holds your <strong>@TargetLabel</strong></p>
                            }
                        </div>
                    }
                </TopContent>
                <Sidebar>
                    @if (_loadingRoots)
                    {
                        <AppProgressBar Indeterminate="true" />
                    }
                    else
                    {
                        @foreach (var group in LocationGroups)
                        {
                            <AppBrowserSideSection Heading="@group.Heading" RuleAbove="@(group.Position > 0)">
                                @foreach (var location in group.Locations)
                                {
                                    <AppBrowserSideItem Label="@DisplayName(location)"
                                                        Detail="@(ShowLocationPath(location) ? location.Path : null)"
                                                        Icon="@(IsMachineLocation(location) ? AppMaterialIcons.Outlined.Storage : AppMaterialIcons.Outlined.FolderOpen)"
                                                        Selected="@(_activeLocation?.Id == location.Id)"
                                                        aria-label="@($"Browse {DisplayName(location)}")"
                                                        OnClick="@(() => SelectLocationAsync(location))" />
                                }
                            </AppBrowserSideSection>
                        }

                        @if (ShowBrowser)
                        {
                            @* "Type a path..." is for what a list cannot reach (a network share, a hidden folder, a deep tree): it opens a small box, and Go lists that folder. *@
                            <AppBrowserSideSection RuleAbove="true">
                                <AppBrowserSideItem Label="@L["FolderPicker_TypeAPath"].Value" Icon="@AppMaterialIcons.Outlined.Edit" Link="true" Selected="_typingPath"
                                                    aria-expanded="@(_typingPath ? "true" : "false")" data-picker-type-path="true"
                                                    OnClick="ToggleTypedPathAsync" />
                            </AppBrowserSideSection>
                            @if (_typingPath)
                            {
                                <div class="server-folder-picker__typed" data-picker-typed data-app-escape-owner="field">
                                    <input type="text"
                                           class="server-folder-picker__typed-input"
                                           aria-label="Folder path"
                                           aria-invalid="@(_pathMessage is not null ? "true" : null)"
                                           aria-describedby="@(_pathMessage is not null ? _pathErrorId : null)"
                                           autocomplete="off"
                                           spellcheck="false"
                                           value="@_pathText"
                                           placeholder="@L["FolderPicker_PathPlaceholder"].Value"
                                           @oninput="PathInput"
                                           @onkeydown="PathKeyDownAsync"
                                           @ref="_typedInput" />
                                    <AppButton Label="Go" ButtonStyle="AppButtonStyle.Outlined" Size="AppControlSize.Compact" Disabled="@(_loadingBrowse || string.IsNullOrWhiteSpace(_pathText))" OnClick="GoToTypedPathAsync" data-picker-go />
                                    @if (_pathMessage is not null)
                                    {
                                        <div id="@_pathErrorId" class="app-field__help tl-field-error" role="alert">@_pathMessage</div>
                                    }
                                </div>
                            }
                        }
                    }
                </Sidebar>
                <InsideContent>
                    @if (ShowBrowser)
                    {
                        @* The folder you are inside is the selection, named here; the list below shows what is in it. *@
                        <span data-picker-selected>
                            @if (string.IsNullOrWhiteSpace(_selectedPathText))
                            {
                                @L["FolderPicker_NoFolderChosen"]
                            }
                            else
                            {
                                <b class="server-folder-picker__selected">@_selectedPathText</b>
                                @if (_browse is not null && !_loadingBrowse && _browse.RelativePath == _selectedRelativePath)
                                {
                                    <span> &middot; @InsideText</span>
                                }
                            }
                        </span>
                    }
                </InsideContent>
                <Columns>
                    <AppBrowserColumn Label="@L["FolderPicker_Name"].Value" MinWidth="12rem" />
                    <AppBrowserColumn Label="@L["FolderPicker_Modified"].Value" Width="12.5rem" WideOnly="true" />
                    <AppBrowserColumn Label="@L["FolderPicker_Open"].Value" HideLabel="true" Width="3rem" />
                </Columns>
                <Rows>
                    @if (_browse is not null)
                    {
                        @for (var index = 0; index < _browse.Directories.Count; index++)
                        {
                            var position = index;
                            var folder = _browse.Directories[index];
                            <AppBrowserFolderRow @key="folder.RelativePath"
                                                 Id="@FolderId(position)"
                                                 Name="@folder.Name"
                                                 Modified="@FormatModified(folder.ModifiedAt)"
                                                 WideOnlyMiddle="true"
                                                 Highlighted="@(position == _highlight)"
                                                 OnOpen="@(() => OpenFolderAsync(folder))" />
                        }
                    }
                </Rows>
                <StateContent>
                    @if (_rootsFailed)
                    {
                        <AppErrorState Title="Could not reach the server"
                                       Message="Library could not load the folders on this server. Check that the server is online, then try again."
                                       Retry="RetryRootsAsync" />
                    }
                    else if (_locations.Count == 0 && !_loadingRoots)
                    {
                        <AppPageState Kind="AppPageStateKind.Empty"
                                      Icon="@AppMaterialIcons.Outlined.FolderOff"
                                      Title="No folders to browse"
                                      Message="This server has no drives or folders available for Library to browse." />
                    }
                    else if (_loadingBrowse)
                    {
                        <div class="server-folder-picker__state"><AppProgressBar Indeterminate="true" /></div>
                    }
                    else if (_browseFailed)
                    {
                        @* A folder Library cannot open says so and offers Back (D9); the last folder that opened is still the selection. *@
                        <div class="server-folder-picker__state server-folder-picker__state--cant-open" data-picker-cant-open role="alert">
                            <span>@L["FolderPicker_CantOpen"]</span>
                            <AppButton Label="@L["Common_Back"].Value" ButtonStyle="AppButtonStyle.Text" Size="AppControlSize.Compact" OnClick="LeaveUnreadableFolderAsync" data-picker-cant-open-back />
                        </div>
                    }
                    else if (_browse is null)
                    {
                        <div class="server-folder-picker__state">Pick a location to see its folders.</div>
                    }
                    else
                    {
                        @* A folder with nothing inside is still a folder you can choose (D9). *@
                        <div class="server-folder-picker__state" data-picker-empty>@(string.IsNullOrWhiteSpace(_search) ? L["FolderPicker_NoFoldersInside"].Value : "No folders match your search in this location.")</div>
                    }
                </StateContent>
            </AppBrowserFrame>
        </div>
    </text>;

    // The footer carries, top to bottom: the handling choice, the one message line, and the buttons (D7). Messages have one home and nothing is drawn behind the buttons.
    private RenderFragment FooterContent => @<text>
        <div class="server-folder-picker__footer">
            @if (OfferManagedChoice)
            {
                <AppSwitchRow Label="Let Library manage this folder"
                              Description="Needed to move items into the Vault. Library may add and remove files in a managed folder. Left off, the folder is read-only and your files are never changed."
                              Value="@_managedChoice"
                              ValueChanged="SetManagedChoiceAsync" />
            }
            @if (OfferHandling)
            {
                <div class="server-folder-picker__handling" role="group" aria-label="How Library uses this folder" data-folder-handling>
                    <AppChoiceRow Title="@FolderHandlingWords.ReadOnly" Description="@FolderHandlingWords.ReadOnlyExplainer" Compact="true"
                                  Selected="@(!_handlingManaged)" OnClick="@(() => SetHandlingAsync(false))" />
                    @if (ManagedAllowed)
                    {
                        <AppChoiceRow Title="@FolderHandlingWords.Managed" Description="@FolderHandlingWords.ManagedExplainer" Compact="true"
                                      Selected="@_handlingManaged" OnClick="@(() => SetHandlingAsync(true))" />
                    }
                </div>
            }
            @if (MessageLine is { } message)
            {
                <div class="server-folder-picker__message" data-picker-message>@message</div>
            }
            @if (!OfferHandling)
            {
                @* The Read-only choice says the same thing in its own words, so the grey line is only for a window with no handling choice. *@
                <p class="server-folder-picker__safety" data-picker-safety>@SafetyLine</p>
            }
            @if (!(Inline && HideConfirm))
            {
                <AppActionBar Align="AppHorizontalAlignment.End">
                    @if (!Inline)
                    {
                        <AppButton Label="Cancel" ButtonStyle="AppButtonStyle.Outlined" OnClick="Cancel" />
                    }
                    @if (!HideConfirm)
                    {
                        <AppButton Label="@ConfirmButtonLabel"
                                   ButtonStyle="AppButtonStyle.Filled"
                                   Tone="AppUiTone.Primary"
                                   Disabled="@(_validating || _loadingBrowse || string.IsNullOrWhiteSpace(_selectedPathText) || IsBlocked)"
                                   OnClick="Confirm" />
                    }
                </AppActionBar>
            }
        </div>
    </text>;

    // The one message line (D7): the picker's own error, then the check in progress, then its answer (a Managed folder that holds files says so instead of "Looks right"),
    // then whatever the host wants said under the choice. Only one is ever drawn.
    private RenderFragment? MessageLine
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_error))
            {
                return @<AppAlert Tone="AppUiTone.Error" Dense="true">@_error</AppAlert>;
            }

            if (_validating)
            {
                return @<div class="server-folder-picker__validation-progress" aria-live="polite"><span>Checking…</span><AppProgressBar Indeterminate="true" /></div>;
            }

            var managedWarning = ShowManagedWarning && _handlingManaged && _validation is { SupportedFileCount: > 0 };
            if (_validation is { } checkedFolder && !(managedWarning && ResultKind(checkedFolder) == "looks-right"))
            {
                // The one check, run when the folder was chosen: Looks right, Heads up or Already used (D7). Already used blocks Add.
                return @<div class="server-folder-picker__result" data-result="@ResultKind(checkedFolder)" role="status" aria-live="polite">
                    <AppMaterialIcon Icon="@ResultIcon(checkedFolder)" />
                    <div><strong>@ResultTitle(checkedFolder)</strong><p>@ResultText(checkedFolder)</p></div>
                </div>;
            }

            if (managedWarning)
            {
                return @<AppAlert Tone="AppUiTone.Warning" Dense="true" data-managed-warning>@FolderHandlingWords.ManagedOnFilesWarning</AppAlert>;
            }

            return Message;
        }
    }


    [Parameter] public string? SetupSession { get; set; }
    /// <summary>Shows the folder's friendly name at the top (pre-filled from the last part of the path, editable); every folder window that adds a folder turns it on.</summary>
    [Parameter] public bool ShowFolderName { get; set; }
    /// <summary>The friendly name as the host last knew it; the picker fills it from the path until the person types their own.</summary>
    [Parameter] public string? FolderName { get; set; }
    [Parameter] public EventCallback<string> FolderNameChanged { get; set; }
    /// <summary>Shows the Read-only / Managed choice (Libraries v3 D19); Read-only is selected until the person picks Managed.</summary>
    [Parameter] public bool OfferHandling { get; set; }
    /// <summary>False when the kind's rules do not allow Library to manage the folder; the choice then offers only Read-only.</summary>
    [Parameter] public bool ManagedAllowed { get; set; } = true;
    /// <summary>True when the choice opens on Managed instead of Read-only (a host that was asked for a Managed folder).</summary>
    [Parameter] public bool InitialManaged { get; set; }
    /// <summary>Whether Managed on a folder that already holds files shows the "will move and rename files" warning (off where Managed means a new folder, as in View).</summary>
    [Parameter] public bool ShowManagedWarning { get; set; } = true;
    /// <summary>The handling the person chose: <see cref="FolderHandlingWords.ReadOnlyKey"/> or <see cref="FolderHandlingWords.ManagedKey"/>.</summary>
    [Parameter] public EventCallback<string> OnHandlingChanged { get; set; }
    /// <summary>A host's own fields drawn above the folder list (Add library puts the library name here, large and focused).</summary>
    [Parameter] public RenderFragment? TopContent { get; set; }
    /// <summary>The host's own message, drawn on the one message line under the handling choice when the picker has nothing to say itself (the View upload line, the scan line, the host's own error). Null draws no line.</summary>
    [Parameter] public RenderFragment? Message { get; set; }
    [CascadingParameter] private IAppDialogContext DialogInstance { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "Choose a folder";
    [Parameter] public string HelpText { get; set; } = "Choose a folder on the Library server.";
    [Parameter] public string SelectionMode { get; set; } = ServerFolderSelectionModes.ExistingLibrary;
    [Parameter] public string ConfirmLabel { get; set; } = "Add";
    [Parameter] public string? CurrentSourceId { get; set; }
    [Parameter] public string? InitialPath { get; set; }
    [Parameter] public IReadOnlyCollection<string>? AllowedStorageLocationIds { get; set; }
    /// <summary>The media type being added to (for example Movies); the title-bar icon follows it. Empty means the generic folder icon.</summary>
    [Parameter] public string? MediaType { get; set; }
    /// <summary>What the folder is for in the person's words (for example Movies); shown at the top of the picker. Falls back to <see cref="MediaType"/>.</summary>
    [Parameter] public string? KindLabel { get; set; }
    private string? TargetLabel => string.IsNullOrWhiteSpace(KindLabel) ? MediaType : KindLabel;
    /// <summary>Render only the body (locations, folder list and the selected-folder line) with no dialog title or Cancel, so a host dialog can embed the picker.</summary>
    [Parameter] public bool Inline { get; set; }
    /// <summary>Called with the validated folder when the person confirms while <see cref="Inline"/> is true; the dialog form closes with the same result instead.</summary>
    [Parameter] public EventCallback<ServerFolderValidationResultDto> OnConfirmed { get; set; }
    /// <summary>Leaves out the confirm button, for a host (the Create library dialog) that has its own button and reads <see cref="OnPathChanged"/> instead.</summary>
    [Parameter] public bool HideConfirm { get; set; }
    /// <summary>Called whenever the selected folder's path changes (a plain choice, nothing is checked); empty when nothing is selected. A host with its own button reads it and runs the one check itself.</summary>
    [Parameter] public EventCallback<string> OnPathChanged { get; set; }

    /// <summary>The one folder window (Libraries v3 D21, Editor v5 D32): Add library, Add folder, the Folders tab, the View folder dialog and setup all open with exactly these options and the host class below (Look v3 Window size L, a fixed height), so it never changes size between steps or callers.</summary>
    public static AppDialogOptions DialogOptions { get; } = new() { MaxWidth = AppMaxWidth.ExtraExtraLarge, FullWidth = false, CloseButton = false, CloseOnEscapeKey = true };

    /// <summary>The host class that gives every browser window (this one and the supporting-files browser) the same fixed height (see app.css).</summary>
    public const string HostClass = AppBrowserFrame.HostClass;

    /// <summary>Draws one switch above the buttons, "Let Library manage this folder": on, the folder is checked for write access (a Vault library's managed folder, which Move to Vault needs).</summary>
    [Parameter] public bool OfferManagedChoice { get; set; }
    /// <summary>Called when the managed switch changes, so the host can read the choice after the pop-up closes.</summary>
    [Parameter] public EventCallback<bool> OnManagedChoiceChanged { get; set; }

    private const string FolderIdPrefix = "server-folder-picker-folder";

    private AppBrowserFrame? _frame;
    private ElementReference _typedInput;
    private bool _typingPath;
    private bool _managedChoice;
    private bool _handlingManaged;
    private string _folderName = string.Empty;
    private bool _folderNameTouched;

    private async Task SetHandlingAsync(bool managed)
    {
        if (_handlingManaged == managed) return;
        _handlingManaged = managed;
        await OnHandlingChanged.InvokeAsync(managed ? FolderHandlingWords.ManagedKey : FolderHandlingWords.ReadOnlyKey);
        // The earlier check was for the other handling, so it no longer stands.
        InvalidateValidation();
    }

    private async Task FolderNameEdited(string? value)
    {
        _folderName = value ?? string.Empty;
        _folderNameTouched = true;
        await FolderNameChanged.InvokeAsync(_folderName);
    }
    private string EffectiveMode => _managedChoice || _handlingManaged ? ServerFolderSelectionModes.ManagedLibrary : SelectionMode;

    private async Task SetManagedChoiceAsync(bool value)
    {
        if (_managedChoice == value) return;
        _managedChoice = value;
        await OnManagedChoiceChanged.InvokeAsync(value);
        // The earlier check was for the other handling, so it no longer stands; the next choice checks again.
        InvalidateValidation();
    }

    private const string CantOpenMessage = "Library can't open this folder. Pick another or check its permissions.";
    private const string NotFoundMessage = "That folder doesn't exist.";
    private const string UnreachableMessage = "Can't reach your Library server";

    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _browseRequest;
    private CancellationTokenSource? _validationRequest;
    private long _browseGeneration;
    private long _validationGeneration;
    private List<ServerStorageLocationDto> _locations = [];
    private BrowseServerFoldersResultDto? _browse;
    private ServerStorageLocationDto? _activeLocation;
    // The one check's answer; null until Add / Choose is pressed, and dropped again as soon as the selection changes.
    private ServerFolderValidationResultDto? _validation;
    // The folders visited in this dialog, as (location id, relative path); Back walks it.
    private readonly List<(string LocationId, string RelativePath)> _history = [];
    private int _historyIndex = -1;
    private string _selectedRelativePath = string.Empty;
    // Always the path exactly as the Engine reports it (inside the container when the Engine runs in Docker); never translated.
    private string _selectedPathText = string.Empty;
    private string? _pathMessage;
    private readonly string _pathErrorId = $"server-folder-picker-path-error-{Guid.NewGuid():N}";
    private string _search = string.Empty;
    // What is in the small "Type a path..." box; it is not the selection, only what Go will list.
    private string _pathText = string.Empty;
    private int _highlight;
    private bool _focusList;
    private bool _focusTyped;
    private string? _error;
    private bool _loadingRoots = true;
    private bool _rootsFailed;
    private bool _loadingBrowse;
    // The folder the person tried to open could not be listed (D9): the list says so and offers Back.
    private bool _browseFailed;
    private bool _validating;
    // A Heads up is acknowledged by pressing the button a second time, which then reads "Add anyway".
    private bool _headsUpShown;
    private string _reportedPath = string.Empty;

    // Drives and the server root are discovered automatically; anything else in the list is a configured media location.
    // Tuvima's own folders are never sent by the Engine, so there is nothing to hide or rename here.
    private static bool IsMachineLocation(ServerStorageLocationDto location) =>
        location.Id.StartsWith("drive-", StringComparison.Ordinal)
        || string.Equals(location.Id, "server-root", StringComparison.Ordinal);

    private IEnumerable<(string Heading, int Position, IReadOnlyList<ServerStorageLocationDto> Locations)> LocationGroups
    {
        get
        {
            var machine = VisibleLocations.Where(IsMachineLocation).ToList();
            var machineHeading = machine.Any(location => location.Id.StartsWith("drive-", StringComparison.Ordinal)) ? "Drives on this server" : "This server";
            return new (string Heading, IReadOnlyList<ServerStorageLocationDto> Locations)[]
            {
                ("Media locations", VisibleLocations.Where(location => !IsMachineLocation(location)).ToList()),
                (machineHeading, machine),
            }.Where(group => group.Locations.Count > 0).Select((group, position) => (Heading: group.Heading, Position: position, Locations: group.Locations));
        }
    }

    private static string DisplayName(ServerStorageLocationDto location) => location.Label;

    // A drive reports the same text as its label and its path ("C:" and "C:\"); show it once.
    private static bool ShowLocationPath(ServerStorageLocationDto location) =>
        !string.Equals(location.Label.TrimEnd('\\', '/'), location.Path.TrimEnd('\\', '/'), StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<ServerStorageLocationDto> VisibleLocations => _locations
        .Where(location => AllowedStorageLocationIds is null
            || AllowedStorageLocationIds.Contains(location.Id, StringComparer.OrdinalIgnoreCase))
        .ToList();

    private bool ShowBrowser => !_rootsFailed && !(_locations.Count == 0 && !_loadingRoots);

    // Something stands in for the folder rows while the server cannot be reached, when there is nothing to browse, while a folder is read and when it is empty.
    private bool ShowListState => !ShowBrowser || _loadingBrowse || _browseFailed || _browse is null || _browse.Directories.Count == 0;

    private string InsideText => _browse is null
        ? string.Empty
        : string.IsNullOrWhiteSpace(_search)
            ? (_browse.Directories.Count == 1 ? L["FolderPicker_OneFolderInside"].Value : string.Format(L["FolderPicker_FoldersInside"].Value, _browse.Directories.Count))
            : _browse.Directories.Count == 1 ? L["FolderPicker_OneFolderMatches"].Value : string.Format(L["FolderPicker_FoldersMatch"].Value, _browse.Directories.Count);

    protected override Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(FolderName))
        {
            _folderName = FolderName;
            _folderNameTouched = true;
        }

        _handlingManaged = InitialManaged && OfferHandling && ManagedAllowed;
        return LoadAsync();
    }

    private async Task RetryRootsAsync()
    {
        _rootsFailed = false;
        _loadingRoots = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var roots = string.IsNullOrWhiteSpace(SetupSession)
            ? await ApiClient.GetServerFolderRootsAsync(_lifetime.Token)
            : await ApiClient.GetSetupServerFolderRootsAsync(SetupSession, _lifetime.Token);
        _loadingRoots = false;
        if (roots is null)
        {
            // The Engine could not be reached: say so and offer Retry, rather than claiming there are no folders.
            _rootsFailed = true;
            _locations = [];
            return;
        }

        _locations = roots.ToList();
        var first = VisibleLocations.FirstOrDefault(location => !IsMachineLocation(location)) ?? VisibleLocations.FirstOrDefault();
        if (first is null) return;

        // A folder to start on is found among the listed locations by its path; nothing is checked for it (browsing is dumb, D6).
        if (!string.IsNullOrWhiteSpace(InitialPath) && ResolveTyped(InitialPath) is { } start)
        {
            _selectedPathText = InitialPath;
            _pathText = InitialPath;
            _activeLocation = start.Location;
            _selectedRelativePath = start.Relative;
            if (!await TryBrowseAsync(start.Location, start.Relative, selectBrowsed: false))
            {
                // The folder does not exist yet: keep it as the selection and show the location's root beside it.
                await TryBrowseAsync(start.Location, string.Empty, selectBrowsed: false);
            }

            return;
        }

        await SelectLocationAsync(first);
    }

    private async Task SelectLocationAsync(ServerStorageLocationDto location)
    {
        _activeLocation = location;
        _search = string.Empty;
        _selectedRelativePath = string.Empty;
        _pathMessage = null;
        await NavigateAsync(string.Empty);
    }

    private Task NavigateAsync(string relativePath, bool preserveSelection = false, bool fromHistory = false)
    {
        return _activeLocation is null
            ? Task.CompletedTask
            : TryBrowseAsync(_activeLocation, relativePath, selectBrowsed: !preserveSelection, fromHistory: fromHistory);
    }

    // Lists a folder's names. This is the only call browsing makes: no check of any kind runs here.
    private async Task<bool> TryBrowseAsync(ServerStorageLocationDto location, string relativePath, bool selectBrowsed, bool fromHistory = false)
    {
        _activeLocation = location;
        var generation = ++_browseGeneration;
        _browseRequest?.Cancel();
        _browseRequest?.Dispose();
        _browseRequest = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        var token = _browseRequest.Token;
        _loadingBrowse = true;
        if (selectBrowsed) InvalidateValidation();
        _error = null;
        _browseFailed = false;
        var request = new BrowseServerFoldersRequest
        {
            StorageLocationId = location.Id,
            RelativePath = relativePath,
            Search = _search,
        };
        BrowseServerFoldersResultDto? browse;
        try
        {
            browse = string.IsNullOrWhiteSpace(SetupSession)
                ? await ApiClient.BrowseServerFoldersAsync(request, token)
                : await ApiClient.BrowseSetupServerFoldersAsync(request, SetupSession, token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            return false;
        }
        finally
        {
            if (generation == _browseGeneration) _loadingBrowse = false;
        }

        if (generation != _browseGeneration) return false;
        if (browse is null)
        {
            // The list says "Library can't open this folder." and offers Back; the selection stays on the last folder that opened.
            _browseFailed = true;
            return false;
        }

        _browse = browse;
        _highlight = 0;
        if (!fromHistory) RecordHistory(location.Id, browse.RelativePath);
        if (selectBrowsed)
        {
            // The folder you are inside is the selection.
            _selectedRelativePath = browse.RelativePath;
            _selectedPathText = browse.DisplayPath;
            _pathMessage = null;
        }

        return true;
    }

    private void RecordHistory(string locationId, string relativePath)
    {
        var entry = (locationId, relativePath);
        if (_historyIndex >= 0 && _history[_historyIndex] == entry) return;
        if (_historyIndex < _history.Count - 1) _history.RemoveRange(_historyIndex + 1, _history.Count - _historyIndex - 1);
        _history.Add(entry);
        _historyIndex = _history.Count - 1;
    }

    private bool CanGoBack => _historyIndex > 0;
    private Task BackAsync() => GoThroughHistoryAsync(-1);

    private async Task GoThroughHistoryAsync(int step)
    {
        var target = _historyIndex + step;
        if (target < 0 || target >= _history.Count) return;
        var (locationId, relativePath) = _history[target];
        var location = VisibleLocations.FirstOrDefault(item => string.Equals(item.Id, locationId, StringComparison.OrdinalIgnoreCase));
        if (location is null) return;

        _historyIndex = target;
        if (_activeLocation?.Id != location.Id)
        {
            _activeLocation = location;
            _search = string.Empty;
        }

        _focusList = true;
        await NavigateAsync(relativePath, fromHistory: true);
    }

    // Back from a folder Library could not open: the last folder that opened is listed again and is the selection.
    private async Task LeaveUnreadableFolderAsync()
    {
        _browseFailed = false;
        if (_historyIndex < 0 || _historyIndex >= _history.Count) return;
        var (locationId, relativePath) = _history[_historyIndex];
        var location = VisibleLocations.FirstOrDefault(item => string.Equals(item.Id, locationId, StringComparison.OrdinalIgnoreCase));
        if (location is null) return;

        _activeLocation = location;
        _focusList = true;
        await NavigateAsync(relativePath, fromHistory: true);
    }

    private Task NavigateUpAsync()
    {
        _focusList = true;
        return _browse?.ParentRelativePath is { } parent
            ? NavigateAsync(parent)
            : Task.CompletedTask;
    }

    private async Task RefreshAsync()
    {
        await NavigateAsync(_browse?.RelativePath ?? string.Empty, preserveSelection: true);
    }

    // The frame's search box waits for the person to stop typing (275 ms) before it reports, so this lists straight away.
    private async Task SearchChangedAsync(string? value)
    {
        _search = value ?? string.Empty;
        await NavigateAsync(_browse?.RelativePath ?? string.Empty, preserveSelection: true);
    }

    // A click on a folder row, its chevron or Enter opens it, and the folder you are then inside is the selection. Nothing is checked.
    private async Task OpenFolderAsync(ServerFolderEntryDto folder)
    {
        _focusList = true;
        await NavigateAsync(folder.RelativePath);
    }

    private Task OpenHighlightedAsync(int index) =>
        _browse is not null && index >= 0 && index < _browse.Directories.Count
            ? OpenFolderAsync(_browse.Directories[index])
            : Task.CompletedTask;

    // The listed location a typed path sits under (the longest match wins), and the path below it; null when the path is outside every listed location.
    private (ServerStorageLocationDto Location, string Relative)? ResolveTyped(string typed)
    {
        var path = typed.Trim();
        (ServerStorageLocationDto Location, string Relative)? best = null;
        var bestLength = -1;
        foreach (var location in VisibleLocations)
        {
            var root = location.Path.TrimEnd('\\', '/');
            if (path.Length < root.Length || !path.StartsWith(root, StringComparison.OrdinalIgnoreCase)) continue;
            var rest = path[root.Length..];
            if (rest.Length > 0 && rest[0] is not ('\\' or '/')) continue;
            if (root.Length > bestLength)
            {
                bestLength = root.Length;
                best = (location, rest.Trim('\\', '/'));
            }
        }

        return best;
    }

    // "Type a path..." opens or closes the small box under it; the box takes focus when it opens.
    private Task ToggleTypedPathAsync()
    {
        _typingPath = !_typingPath;
        _pathMessage = null;
        _focusTyped = _typingPath;
        return Task.CompletedTask;
    }

    // Go: lists the typed path's folders. The box takes a full path; the folders are read, nothing is checked.
    private async Task GoToTypedPathAsync()
    {
        if (string.IsNullOrWhiteSpace(_pathText)) return;
        _pathMessage = null;
        _error = null;
        if (ResolveTyped(_pathText) is not { } target)
        {
            RejectTypedPath(CantOpenMessage);
            return;
        }

        _search = string.Empty;
        if (!await TryBrowseAsync(target.Location, target.Relative, selectBrowsed: true))
        {
            // The last list stays; the person is told beside the box, not in the list.
            RejectTypedPath(_browseFailed ? CantOpenMessage : NotFoundMessage);
            _browseFailed = false;
            return;
        }

        // The folder is listed and selected: the small box has done its job.
        _typingPath = false;
        _focusList = true;
    }

    // A path that cannot be used says so beside the box and leaves nothing selected.
    private void RejectTypedPath(string message)
    {
        _pathMessage = message;
        InvalidateValidation();
        _selectedRelativePath = string.Empty;
        _selectedPathText = string.Empty;
    }

    private async Task PathKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await GoToTypedPathAsync();
        else if (args.Key == "Escape") _typingPath = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Each focus request is a flag set while handling an event; it runs here, once the elements have rendered.
        if (_lifetime.IsCancellationRequested) return;
        if (!string.Equals(_reportedPath, _selectedPathText, StringComparison.Ordinal))
        {
            _reportedPath = _selectedPathText;
            if (ShowFolderName && !_folderNameTouched)
            {
                _folderName = FolderHandlingWords.NameFromPath(_selectedPathText);
                await FolderNameChanged.InvokeAsync(_folderName);
                StateHasChanged();
            }

            await OnPathChanged.InvokeAsync(_selectedPathText);
        }

        if (_focusTyped && _typingPath)
        {
            _focusTyped = false;
            await TryFocusAsync(_typedInput);
        }

        if (!_focusList || _loadingBrowse || _frame is null) return;
        _focusList = false;
        await _frame.FocusListAsync();
    }

    private Task TryFocusAsync(ElementReference element) => element.Id is null ? Task.CompletedTask : TryAsync(async () => await element.FocusAsync());

    private static async Task TryAsync(Func<Task> focus)
    {
        try { await focus(); }
        catch (JSDisconnectedException) { /* The circuit closed while focus was moving; nothing to restore. */ }
        catch (JSException) { /* Focus is a convenience; the element may have gone away between the render and this call. */ }
    }

    private void InvalidateValidation()
    {
        ++_validationGeneration;
        _validationRequest?.Cancel();
        _validationRequest?.Dispose();
        _validationRequest = null;
        _validation = null;
        _validating = false;
        _headsUpShown = false;
    }

    private void PathInput(ChangeEventArgs args) { _pathText = args.Value?.ToString() ?? string.Empty; _pathMessage = null; }

    // The one check (D6, D7): run when Add / Choose is pressed, capped by the Engine (10,000 files or a few seconds), and it never blocks Cancel.
    private async Task CheckSelectedAsync()
    {
        if (_activeLocation is null) return;
        var generation = ++_validationGeneration;
        _validationRequest?.Cancel();
        _validationRequest?.Dispose();
        _validationRequest = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        var token = _validationRequest.Token;
        _validating = true;
        _validation = null;
        _error = null;
        var request = new ValidateServerFolderRequest
        {
            StorageLocationId = _activeLocation.Id,
            RelativePath = _selectedRelativePath,
            SelectionMode = EffectiveMode,
            CurrentSourceId = CurrentSourceId,
        };
        ServerFolderValidationResultDto? validation;
        try
        {
            validation = string.IsNullOrWhiteSpace(SetupSession)
                ? await ApiClient.ValidateServerFolderAsync(request, token)
                : await ApiClient.ValidateSetupServerFolderAsync(request, SetupSession, token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            if (generation == _validationGeneration) _validating = false;
        }

        if (generation != _validationGeneration) return;
        _validation = validation;
        if (validation is null) _error = L["ServerFolderPicker_LibraryCouldNotValidateThis"].Value;
        else if (!string.IsNullOrWhiteSpace(validation.Path)) _selectedPathText = validation.Path;
    }

    // Looks right closes at once; Heads up waits for a second press ("Add anyway"); Already used and a folder that cannot be opened block.
    private async Task Confirm()
    {
        if (_validating || _loadingBrowse || string.IsNullOrWhiteSpace(_selectedPathText)) return;
        if (_validation is null || !_headsUpShown)
        {
            if (_validation is null) await CheckSelectedAsync();
            if (_validation is null) return;
            if (ResultKind(_validation) == "heads-up" && !_headsUpShown)
            {
                _headsUpShown = true;
                return;
            }
        }

        if (_validation is not { CanSelect: true } || ResultKind(_validation) is "already-used" or "refused") return;
        if (Inline) await OnConfirmed.InvokeAsync(_validation);
        else DialogInstance.Close(AppDialogResult.Ok(_validation));
    }

    private void Cancel() => DialogInstance.Cancel();

    private bool IsBlocked => _validation is { } checkedFolder && ResultKind(checkedFolder) is "already-used" or "refused";

    private string ConfirmButtonLabel => _headsUpShown ? "Add anyway" : ConfirmLabel;

    private string SafetyLine => EffectiveMode == ServerFolderSelectionModes.ManagedLibrary
        ? "Library keeps this folder organized."
        : "Your files are never changed.";

    private static string ResultKind(ServerFolderValidationResultDto result)
    {
        if (result.Issues.Any(issue => issue.Code == "already_configured")) return "already-used";
        if (!result.CanSelect || (result.Exists && !result.HasRead)) return "refused";
        if (result.Issues.Any(issue => issue.Code is "looks_like_other_kind" or "no_matching_files")) return "heads-up";
        return "looks-right";
    }

    private static string ResultIcon(ServerFolderValidationResultDto result) => ResultKind(result) switch
    {
        "looks-right" => AppMaterialIcons.Outlined.CheckCircle,
        "heads-up" => AppMaterialIcons.Outlined.WarningAmber,
        _ => AppMaterialIcons.Outlined.ErrorOutline,
    };

    private static string ResultTitle(ServerFolderValidationResultDto result) => ResultKind(result) switch
    {
        "looks-right" => "Looks right",
        "heads-up" => "Heads up",
        "already-used" => "Already used",
        _ => "Can't use this folder",
    };

    private string ResultText(ServerFolderValidationResultDto result) => ResultKind(result) switch
    {
        "looks-right" => ServerFolderResultText.For(result) ?? "Folder accessible",
        "already-used" or "heads-up" => result.Issues.FirstOrDefault(issue => issue.Code is "already_configured" or "looks_like_other_kind" or "no_matching_files")?.Message ?? string.Empty,
        _ => result.Exists && !result.HasRead
            ? "Library can't read this folder."
            : result.Issues.FirstOrDefault()?.Message ?? CantOpenMessage,
    };

    private string FolderId(int index) => $"{FolderIdPrefix}-{index}";

    private static string FormatModified(DateTimeOffset? value) => value?.ToLocalTime().ToString("MMM d, yyyy h:mm tt") ?? "\u2014";

    public void Dispose()
    {
        _browseRequest?.Cancel();
        _browseRequest?.Dispose();
        _validationRequest?.Cancel();
        _validationRequest?.Dispose();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
