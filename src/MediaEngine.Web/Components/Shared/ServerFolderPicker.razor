@namespace MediaEngine.Web.Components.Shared
@inject IEngineApiClient ApiClient
@implements IDisposable

<AppHostedDialog Title="@Title"
                 Subtitle="@HelpText"
                 Icon="@AppMaterialIcons.Outlined.FolderOpen"
                 Size="FullscreenEditor"
                 Class="server-folder-picker-host"
                 OnClose="Cancel">
    <ChildContent>
        <div class="server-folder-picker">
            <aside class="server-folder-picker__locations" aria-label="Approved server storage locations">
                <h3>Storage locations</h3>
                @if (_loadingRoots)
                {
                    <AppProgressBar Indeterminate="true" />
                }
                else
                {
                    @foreach (var location in VisibleLocations)
                    {
                        <AppNativeButton Type="button"
                                         Class="@LocationClass(location)"
                                         AriaLabel="@($"Browse {location.Label}")"
                                         OnClick="@(_ => SelectLocationAsync(location))">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Storage" />
                            <span><strong>@location.Label</strong><small>@location.Path</small></span>
                        </AppNativeButton>
                    }
                }

                @if (AllowManualPath)
                {
                    <div class="server-folder-picker__manual-callout">
                        <strong>Can't find your folder?</strong>
                        <span>Enter a path visible to the Tuvima Library server.</span>
                        <AppButton Label="Enter path manually"
                                   ButtonStyle="AppButtonStyle.Text"
                                   EndIcon="@AppMaterialIcons.Outlined.ArrowForward"
                                   OnClick="ToggleManualPath" />
                    </div>
                }
            </aside>

            <section class="server-folder-picker__browser" aria-busy="@_loadingBrowse">
                @if (_showManualPath)
                {
                    <div class="server-folder-picker__manual">
                        <div>
                            <h3>Enter a server path</h3>
                            <p>The path must be inside an approved storage location and is evaluated on the Tuvima Library server.</p>
                        </div>
                        <div class="server-folder-picker__manual-controls">
                            <AppTextField Label="Server path"
                                          Value="@_manualPath"
                                          ValueChanged="ManualPathChanged"
                                          Placeholder="/media/movies" />
                            <AppButton Label="Validate path"
                                       ButtonStyle="AppButtonStyle.Outlined"
                                       Disabled="@string.IsNullOrWhiteSpace(_manualPath)"
                                       OnClick="ValidateManualPathAsync" />
                        </div>
                    </div>
                }
                else if (_locations.Count == 0 && !_loadingRoots)
                {
                    <AppPageState Kind="AppPageStateKind.Empty"
                                  Icon="@AppMaterialIcons.Outlined.FolderOff"
                                  Title="No approved storage locations"
                                  Message="Add at least one server storage location to libraries.json before browsing folders." />
                }
                else
                {
                    <div class="server-folder-picker__toolbar">
                        <nav class="server-folder-picker__breadcrumbs" aria-label="Folder breadcrumbs">
                            <AppNativeButton Type="button"
                                             Class="server-folder-picker__breadcrumb"
                                             AriaLabel="Storage location root"
                                             OnClick="@(_ => NavigateAsync(string.Empty))">
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Storage" /><span>@_activeLocation?.Label</span>
                            </AppNativeButton>
                            @foreach (var crumb in Breadcrumbs)
                            {
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" />
                                <AppNativeButton Type="button"
                                                 Class="server-folder-picker__breadcrumb"
                                                 OnClick="@(_ => NavigateAsync(crumb.RelativePath))">
                                    @crumb.Label
                                </AppNativeButton>
                            }
                        </nav>
                        <AppIconButton Icon="@AppMaterialIcons.Outlined.ArrowUpward"
                                       Tooltip="Up one level"
                                       AriaLabel="Up one level"
                                       Disabled="@(_browse?.ParentRelativePath is null || _loadingBrowse)"
                                       OnClick="NavigateUpAsync" />
                        <AppIconButton Icon="@AppMaterialIcons.Outlined.Refresh"
                                       Tooltip="Refresh"
                                       AriaLabel="Refresh folders"
                                       Disabled="@_loadingBrowse"
                                       OnClick="RefreshAsync" />
                        <label class="server-folder-picker__search">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Search" />
                            <AppNativeInput Type="search"
                                            Value="@_search"
                                            ValueChanged="SearchChangedAsync"
                                            Placeholder="Search folders"
                                            AriaLabel="Search folders" />
                        </label>
                    </div>

                    <div class="server-folder-picker__list" role="listbox" aria-label="Server folders">
                        <div class="server-folder-picker__list-header" aria-hidden="true">
                            <span>Name</span><span>Type</span><span>Modified</span><span></span>
                        </div>
                        @if (_loadingBrowse)
                        {
                            <div class="server-folder-picker__state"><AppProgressBar Indeterminate="true" /></div>
                        }
                        else if (_browse is null)
                        {
                            <div class="server-folder-picker__state">Choose an approved storage location.</div>
                        }
                        else if (_browse.Directories.Count == 0)
                        {
                            <div class="server-folder-picker__state">@(string.IsNullOrWhiteSpace(_search) ? "No accessible subfolders are available here." : "No folders match your search in this location.")</div>
                        }
                        else
                        {
                            @foreach (var folder in _browse.Directories)
                            {
                                <div class="@FolderClass(folder)"
                                     role="option"
                                     aria-selected="@(folder.RelativePath == _selectedRelativePath)">
                                    <AppNativeButton Type="button"
                                                     Class="server-folder-picker__folder-select"
                                                     AriaLabel="@($"Select folder {folder.Name}")"
                                                     OnClick="@(_ => SelectFolderAsync(folder))">
                                        <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Folder" />
                                        <strong>@folder.Name</strong>
                                    </AppNativeButton>
                                    <span>Folder</span>
                                    <span>@FormatModified(folder.ModifiedAt)</span>
                                    <AppIconButton Icon="@AppMaterialIcons.Outlined.ChevronRight"
                                                   Tooltip="Open folder"
                                                   AriaLabel="@($"Open folder {folder.Name}")"
                                                   OnClick="@(() => NavigateAsync(folder.RelativePath))" />
                                </div>
                            }
                        }
                    </div>

                    <div class="server-folder-picker__selection" aria-live="polite">
                        <div class="server-folder-picker__selected-path">
                            <span>Selected folder</span>
                            <strong><AppMaterialIcon Icon="@AppMaterialIcons.Filled.Folder" />@SelectedDisplayPath</strong>
                        </div>
                        @if (_validating)
                        {
                            <div class="server-folder-picker__validation-progress"><AppProgressBar Indeterminate="true" /></div>
                        }
                        else if (_validation is not null)
                        {
                            <div class="server-folder-picker__fact"><span>Read access</span><strong class="@AccessClass(_validation.HasRead)">@YesNo(_validation.HasRead)</strong></div>
                            <div class="server-folder-picker__fact"><span>Write access</span><strong class="@AccessClass(_validation.HasWrite)">@YesNo(_validation.HasWrite)</strong></div>
                            @if (_validation.AvailableBytes.HasValue)
                            {
                                <div class="server-folder-picker__fact"><span>Space available</span><strong>@FormatBytes(_validation.AvailableBytes.Value)</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_validation.FileSystem))
                            {
                                <div class="server-folder-picker__fact"><span>File system</span><strong>@_validation.FileSystem</strong></div>
                            }
                        }
                    </div>
                }

                @if (_validation is { CanSelect: true, Exists: false }) { <AppAlert Tone="AppUiTone.Info">This View folder will be created when storage is saved.</AppAlert> }
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <AppAlert Tone="AppUiTone.Error">@_error</AppAlert>
                }
                @if (_validation?.Issues.Count > 0)
                {
                    <div class="server-folder-picker__issues" aria-live="assertive">
                        @if (_validation.Issues.Any(issue => issue.LibraryName is not null))
                        {
                            <strong>Already used by other libraries</strong>
                            <p>Choose a folder that does not overlap these configured sources.</p>
                            <div class="server-folder-picker__conflicts">
                                @foreach (var name in _validation.Issues.Where(issue => issue.LibraryName is not null).Select(issue => issue.LibraryName).Distinct())
                                { <span>@name</span> }
                            </div>
                        }
                        @foreach (var issue in _validation.Issues.Where(issue => issue.LibraryName is null))
                        {
                            <div><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.WarningAmber" /><span>@issue.Message</span></div>
                        }
                    </div>
                }
            </section>
        </div>
    </ChildContent>
    <FooterContent>
        <AppActionBar Align="AppHorizontalAlignment.End">
            <AppButton Label="Cancel" ButtonStyle="AppButtonStyle.Outlined" OnClick="Cancel" />
            <AppButton Label="Select this folder"
                       ButtonStyle="AppButtonStyle.Filled"
                       Tone="AppUiTone.Primary"
                       Disabled="@(_validation?.CanSelect != true || _validating || _loadingBrowse)"
                       OnClick="Confirm" />
        </AppActionBar>
    </FooterContent>
</AppHostedDialog>

@code {
    [Parameter] public string? SetupSession { get; set; }
    [CascadingParameter] private IAppDialogContext DialogInstance { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "Select Folder";
    [Parameter] public string HelpText { get; set; } = "Choose a folder on the Tuvima Library server.";
    [Parameter] public string SelectionMode { get; set; } = ServerFolderSelectionModes.ExistingLibrary;
    [Parameter] public string? CurrentSourceId { get; set; }
    [Parameter] public string? InitialPath { get; set; }
    [Parameter] public bool AllowManualPath { get; set; } = true;
    [Parameter] public IReadOnlyCollection<string>? AllowedStorageLocationIds { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _browseRequest;
    private CancellationTokenSource? _validationRequest;
    private CancellationTokenSource? _searchDebounce;
    private long _browseGeneration;
    private long _validationGeneration;
    private List<ServerStorageLocationDto> _locations = [];
    private BrowseServerFoldersResultDto? _browse;
    private ServerStorageLocationDto? _activeLocation;
    private ServerFolderValidationResultDto? _validation;
    private string _selectedRelativePath = string.Empty;
    private string _search = string.Empty;
    private string _manualPath = string.Empty;
    private string? _error;
    private bool _loadingRoots = true;
    private bool _loadingBrowse;
    private bool _validating;
    private bool _showManualPath;

    private IReadOnlyList<ServerStorageLocationDto> VisibleLocations => _locations
        .Where(location => AllowedStorageLocationIds is null
            || AllowedStorageLocationIds.Contains(location.Id, StringComparer.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        _locations = (string.IsNullOrWhiteSpace(SetupSession)
            ? await ApiClient.GetServerFolderRootsAsync(_lifetime.Token)
            : await ApiClient.GetSetupServerFolderRootsAsync(SetupSession, _lifetime.Token)).ToList();
        _loadingRoots = false;
        var first = VisibleLocations.FirstOrDefault();
        if (first is null) return;

        if (!string.IsNullOrWhiteSpace(InitialPath))
        {
            var request = new ValidateServerFolderRequest
            {
                ManualPath = InitialPath,
                SelectionMode = SelectionMode,
                CurrentSourceId = CurrentSourceId,
            };
            var initial = string.IsNullOrWhiteSpace(SetupSession)
                ? await ApiClient.ValidateServerFolderAsync(request, _lifetime.Token)
                : await ApiClient.ValidateSetupServerFolderAsync(request, SetupSession, _lifetime.Token);
            if (initial is not null)
            {
                first = VisibleLocations.FirstOrDefault(location =>
                    string.Equals(location.Id, initial.StorageLocationId, StringComparison.OrdinalIgnoreCase)) ?? first;
                _selectedRelativePath = initial.RelativePath;
                _validation = initial;
                if (initial is { CanSelect: true, Exists: false })
                {
                    _activeLocation = first;
                    _showManualPath = true;
                    _manualPath = initial.Path;
                    return;
                }
            }
        }

        await SelectLocationAsync(first, string.IsNullOrWhiteSpace(_selectedRelativePath) ? null : _selectedRelativePath);
    }

    private async Task SelectLocationAsync(ServerStorageLocationDto location, string? relativePath = null)
    {
        CancelSearchDebounce();
        _activeLocation = location;
        _search = string.Empty;
        _showManualPath = false;
        _selectedRelativePath = relativePath ?? string.Empty;
        _validation = null;
        await NavigateAsync(_selectedRelativePath, preserveSelection: false);
    }

    private async Task NavigateAsync(string relativePath, bool preserveSelection = false)
    {
        if (_activeLocation is null) return;
        var generation = ++_browseGeneration;
        _browseRequest?.Cancel();
        _browseRequest?.Dispose();
        _browseRequest = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        var token = _browseRequest.Token;
        _loadingBrowse = true;
        if (!preserveSelection) InvalidateValidation();
        _error = null;
        var request = new BrowseServerFoldersRequest
        {
            StorageLocationId = _activeLocation.Id,
            RelativePath = relativePath,
            Search = _search,
        };
        BrowseServerFoldersResultDto? browse;
        try
        {
            browse = string.IsNullOrWhiteSpace(SetupSession)
                ? await ApiClient.BrowseServerFoldersAsync(request, token)
                : await ApiClient.BrowseSetupServerFoldersAsync(request, SetupSession, token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            if (generation == _browseGeneration) _loadingBrowse = false;
        }

        if (generation != _browseGeneration) return;
        if (browse is null)
        {
            _error = "Tuvima Library could not reach this server folder. Check that the location is online and try again.";
            return;
        }

        _browse = browse;
        if (!preserveSelection)
        {
            _selectedRelativePath = browse.RelativePath;
            await ValidateSelectedAsync();
        }
    }

    private Task NavigateUpAsync() => _browse?.ParentRelativePath is { } parent
        ? NavigateAsync(parent)
        : Task.CompletedTask;

    private async Task RefreshAsync()
    {
        InvalidateValidation();
        await NavigateAsync(_browse?.RelativePath ?? string.Empty, preserveSelection: true);
        await ValidateSelectedAsync();
    }

    private async Task SearchChangedAsync(object? value)
    {
        _search = value?.ToString() ?? string.Empty;
        CancelSearchDebounce();
        _searchDebounce = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        var token = _searchDebounce.Token;
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(275), token);
            await NavigateAsync(_browse?.RelativePath ?? string.Empty, preserveSelection: true);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // A newer search value superseded this request.
        }
    }

    private async Task SelectFolderAsync(ServerFolderEntryDto folder)
    {
        _selectedRelativePath = folder.RelativePath;
        await ValidateSelectedAsync();
    }

    private async Task ValidateSelectedAsync()
    {
        if (_activeLocation is null) return;
        _validation = null;
        var generation = ++_validationGeneration;
        _validationRequest?.Cancel();
        _validationRequest?.Dispose();
        _validationRequest = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        var token = _validationRequest.Token;
        _validating = true;
        _error = null;
        var request = new ValidateServerFolderRequest
        {
            StorageLocationId = _activeLocation.Id,
            RelativePath = _selectedRelativePath,
            SelectionMode = SelectionMode,
            CurrentSourceId = CurrentSourceId,
        };
        ServerFolderValidationResultDto? validation;
        try
        {
            validation = string.IsNullOrWhiteSpace(SetupSession)
                ? await ApiClient.ValidateServerFolderAsync(request, token)
                : await ApiClient.ValidateSetupServerFolderAsync(request, SetupSession, token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            if (generation == _validationGeneration) _validating = false;
        }
        if (generation != _validationGeneration) return;
        _validation = validation;
        if (_validation is null) _error = "Tuvima Library could not validate this server folder. Check that the location is online and try again.";
    }

    private async Task ValidateManualPathAsync()
    {
        InvalidateValidation();
        var generation = _validationGeneration;
        _validationRequest = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        var token = _validationRequest.Token;
        _validating = true;
        _error = null;
        var request = new ValidateServerFolderRequest { ManualPath = _manualPath, SelectionMode = SelectionMode, CurrentSourceId = CurrentSourceId };
        try
        {
            var validation = string.IsNullOrWhiteSpace(SetupSession)
                ? await ApiClient.ValidateServerFolderAsync(request, token)
                : await ApiClient.ValidateSetupServerFolderAsync(request, SetupSession, token);
            if (generation != _validationGeneration) return;
            _validation = validation;
            if (validation is null) { _error = "The server path could not be validated."; return; }
            _activeLocation = VisibleLocations.FirstOrDefault(location => string.Equals(location.Id, validation.StorageLocationId, StringComparison.OrdinalIgnoreCase));
            if (_activeLocation is null) { _validation = null; _error = "Choose an approved storage location."; return; }
            _selectedRelativePath = validation.RelativePath;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // A changed path or closed dialog superseded this request.
        }
        finally { if (generation == _validationGeneration) _validating = false; }
    }

    private void InvalidateValidation()
    {
        ++_validationGeneration;
        _validationRequest?.Cancel();
        _validationRequest?.Dispose();
        _validationRequest = null;
        _validation = null;
        _validating = false;
    }
    private void ManualPathChanged(string? value) { _manualPath = value ?? string.Empty; InvalidateValidation(); }
    private void ToggleManualPath()
    {
        CancelSearchDebounce();
        ++_browseGeneration;
        _browseRequest?.Cancel();
        _loadingBrowse = false;
        _showManualPath = !_showManualPath;
        _manualPath = _validation?.Path ?? _browse?.DisplayPath ?? "";
        InvalidateValidation();
    }
    private void CancelSearchDebounce()
    {
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
        _searchDebounce = null;
    }
    private async Task Confirm()
    {
        if (_validating || _loadingBrowse || _validation?.CanSelect != true) return;
        if (_showManualPath) await ValidateManualPathAsync(); else await ValidateSelectedAsync();
        if (_validation?.CanSelect == true) DialogInstance.Close(AppDialogResult.Ok(_validation));
    }
    private void Cancel() => DialogInstance.Cancel();

    private IReadOnlyList<BreadcrumbItem> Breadcrumbs
    {
        get
        {
            var relative = _browse?.RelativePath;
            if (string.IsNullOrWhiteSpace(relative)) return [];
            var separator = relative.Contains('\\') ? '\\' : '/';
            var segments = relative.Split(separator, StringSplitOptions.RemoveEmptyEntries);
            var current = string.Empty;
            var result = new List<BreadcrumbItem>();
            foreach (var segment in segments)
            {
                current = string.IsNullOrEmpty(current) ? segment : $"{current}{separator}{segment}";
                result.Add(new BreadcrumbItem(segment, current));
            }
            return result;
        }
    }

    private string SelectedDisplayPath => _validation?.Path ?? _browse?.DisplayPath ?? "No folder selected";
    private string LocationClass(ServerStorageLocationDto location) => $"server-folder-picker__location{(_activeLocation?.Id == location.Id ? " is-active" : string.Empty)}";
    private string FolderClass(ServerFolderEntryDto folder) => $"server-folder-picker__folder{(_selectedRelativePath == folder.RelativePath ? " is-selected" : string.Empty)}";
    private static string YesNo(bool value) => value ? "Yes" : "No";
    private static string AccessClass(bool value) => value ? "is-available" : "is-unavailable";
    private static string FormatModified(DateTimeOffset? value) => value?.ToLocalTime().ToString("MMM d, yyyy h:mm tt") ?? "—";
    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var value = (double)Math.Max(0, bytes);
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1) { value /= 1024; unit++; }
        return $"{value:0.#} {units[unit]}";
    }

    public void Dispose()
    {
        CancelSearchDebounce();
        _browseRequest?.Cancel();
        _browseRequest?.Dispose();
        _validationRequest?.Cancel();
        _validationRequest?.Dispose();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private sealed record BreadcrumbItem(string Label, string RelativePath);
}
