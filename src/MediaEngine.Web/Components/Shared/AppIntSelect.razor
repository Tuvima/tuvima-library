@namespace MediaEngine.Web.Components.Shared

<AppTypedSelect TValue="int"
           Value="@Value"
           ValueChanged="@ValueChanged"
           Variant="@Variant"
           Margin="@Margin"
           Dense="@Dense"
           Disabled="@Disabled"
           FullWidth="@FullWidth"
           PopoverClass="@EffectivePopoverClass"
           Class="@RootClass"
           @attributes="AdditionalAttributes">
    @ChildContent
</AppTypedSelect>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public AppVariant Variant { get; set; } = AppVariant.Outlined;
    [Parameter] public AppMargin Margin { get; set; } = AppMargin.Dense;
    [Parameter] public bool Dense { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool FullWidth { get; set; } = true;
    [Parameter] public AppControlSize Size { get; set; } = AppControlSize.Normal;
    [Parameter] public string? PopoverClass { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string RootClass => string.Join(" ", new[] { "app-control", "app-select", AppUiMaps.SizeClass(Size), Class }
        .Where(value => !string.IsNullOrWhiteSpace(value)));

    private string EffectivePopoverClass => string.Join(
        " ",
        new[] { "app-select__popover", PopoverClass }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .SelectMany(value => value!.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            .Distinct(StringComparer.Ordinal));
}
