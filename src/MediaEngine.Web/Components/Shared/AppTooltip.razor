@namespace MediaEngine.Web.Components.Shared

@* Markup only. The one tooltip controller in wwwroot/js/playback-tooltip.js listens on the whole document and reads these data
   attributes, so a tooltip costs no script import, no attach call and no listener of its own. *@
<span class="@($"playback-tooltip-owner {Class}".Trim())" data-playback-tooltip="@Text" data-playback-tooltip-placement="@Placement.ToString().ToLowerInvariant()" data-playback-tooltip-suppressed="@(Suppressed ? "true" : "false")" @attributes="AdditionalAttributes">
    @ChildContent
</span>

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public AppPlacement Placement { get; set; } = AppPlacement.Top;
    [Parameter] public bool Arrow { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Suppressed { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
