@namespace MediaEngine.Web.Components.Shared.Tools
@inject IStringLocalizer<SharedStrings> L

@* "5 tools detected · 4 ready · 1 needs setup" drawn as coloured chips (green ready, amber needs setup, blue downloading), counted from the same rows the
   list draws so the line and the rows never disagree. The dots between chips are hidden on screen and kept for screen readers and copied text. *@
<p class="tools-summary" data-testid="tools-summary">@foreach (var part in Parts){<span class="tools-summary__part" data-tone="@part.Tone">@part.Text</span>}</p>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ToolRequirementDto> Tools { get; set; } = [];

    private sealed record Part(string Text, string Tone);

    /// <summary>The counts the line shows: every row, the ready ones, and the rest (a download in progress counts as the rest here).</summary>
    public static (int Detected, int Ready, int NeedsSetup) Count(IReadOnlyList<ToolRequirementDto> tools)
    {
        var ready = tools.Count(tool => tool.State == ToolRequirementStates.Ready);
        return (tools.Count, ready, tools.Count - ready);
    }

    private IEnumerable<Part> Parts
    {
        get
        {
            var (detected, ready, _) = Count(Tools);
            var downloading = Tools.Count(tool => tool.State == ToolRequirementStates.Downloading);
            var needsSetup = detected - ready - downloading;
            yield return new Part(detected == 1 ? L["ToolsSummaryLine_DetectedOne"].Value : L["ToolsSummaryLine_DetectedMany", detected].Value, "neutral");
            yield return new Part(" · " + L["ToolsSummaryLine_Ready", ready].Value, "ready");
            if (needsSetup > 0)
            {
                yield return new Part(" · " + (needsSetup == 1 ? L["ToolsSummaryLine_NeedsSetupOne"].Value : L["ToolsSummaryLine_NeedsSetupMany", needsSetup].Value), "attention");
            }

            if (downloading > 0)
            {
                yield return new Part(" · " + L["ToolsSummaryLine_Downloading", downloading].Value, "busy");
            }
        }
    }
}
