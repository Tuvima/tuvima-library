@namespace MediaEngine.Web.Components.Shared.Tools

@* One tool or download from the Engine's tools list, worded the same on the setup screen and in Settings.
   Buttons appear only when the row allows the action and the host handles it, so setup (which handles none) is read-only. *@
<article class="tool-row" data-tool-id="@Tool.Id" data-state="@Tool.State">
    <div class="tool-row__main">
        <div class="tool-row__title">
            <strong>@Tool.Name</strong>
            <AppStatusBadge Text="@StatusLabel" Tone="@StatusTone" />
        </div>

        @if (IsReady)
        {
            @if (!string.IsNullOrWhiteSpace(Tool.Version))
            {
                <small class="tool-row__detail">Version @Tool.Version</small>
            }
        }
        else
        {
            <span class="tool-row__effect">@Tool.Effect</span>
            @if (!string.IsNullOrWhiteSpace(Tool.StateReason))
            {
                <small class="tool-row__detail">@Tool.StateReason</small>
            }
            @if (!string.IsNullOrWhiteSpace(Tool.Fix))
            {
                <small class="tool-row__detail tool-row__fix">@Tool.Fix</small>
            }
            @if (Tool.WaitingFiles > 0)
            {
                <small class="tool-row__detail tool-row__waiting">@WaitingText</small>
            }
        }

        @if (Tool.State == ToolRequirementStates.Downloading)
        {
            <AppProgressBar Value="@(Tool.DownloadPercent ?? 0)" ShowValue="true" Class="tool-row__progress" />
        }
    </div>

    @if (HasActions)
    {
        <div class="tool-row__actions">
            @if (Tool.CanLocate && OnLocate.HasDelegate)
            {
                <AppButton Label="Locate it" Size="AppControlSize.Compact" Disabled="Busy" OnClick="@(() => OnLocate.InvokeAsync(Tool))" />
            }
            @if (Tool.CanInstall && OnInstall.HasDelegate)
            {
                <AppButton Label="Install for me" Size="AppControlSize.Compact" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="Busy" OnClick="@(() => OnInstall.InvokeAsync(Tool))" />
            }
            @if (Tool.CanDownloadAgain && OnDownloadAgain.HasDelegate)
            {
                <AppButton Label="@(Tool.State == ToolRequirementStates.Problem ? "Download again" : "Download")" Size="AppControlSize.Compact" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="Busy" OnClick="@(() => OnDownloadAgain.InvokeAsync(Tool))" />
            }
            @Actions
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public ToolRequirementDto Tool { get; set; } = default!;

    /// <summary>True while the host is busy with an action on this row; the buttons wait.</summary>
    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback<ToolRequirementDto> OnLocate { get; set; }
    [Parameter] public EventCallback<ToolRequirementDto> OnInstall { get; set; }
    [Parameter] public EventCallback<ToolRequirementDto> OnDownloadAgain { get; set; }

    /// <summary>Extra buttons the host owns, such as Cancel, Load and Unload for a model.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    private bool IsReady => Tool.State == ToolRequirementStates.Ready;
    private bool IsOptional => Tool.Requirement == ToolRequirementLevels.Optional;

    private bool HasActions => Actions is not null
        || (Tool.CanLocate && OnLocate.HasDelegate)
        || (Tool.CanInstall && OnInstall.HasDelegate)
        || (Tool.CanDownloadAgain && OnDownloadAgain.HasDelegate);

    private string StatusLabel => Tool.State switch
    {
        ToolRequirementStates.Ready => "Ready",
        ToolRequirementStates.Missing when IsOptional => "Optional",
        ToolRequirementStates.Missing => "Missing",
        ToolRequirementStates.Downloading => Tool.DownloadPercent is { } percent ? $"Downloading {percent}%" : "Downloading",
        ToolRequirementStates.InstallerReady => "Installer ready",
        _ => "Problem",
    };

    private AppUiTone StatusTone => Tool.State switch
    {
        ToolRequirementStates.Ready => AppUiTone.Success,
        ToolRequirementStates.Missing when IsOptional => AppUiTone.Neutral,
        ToolRequirementStates.Missing => AppUiTone.Warning,
        ToolRequirementStates.Downloading or ToolRequirementStates.InstallerReady => AppUiTone.Info,
        _ => AppUiTone.Warning,
    };

    private string WaitingText => Tool.WaitingFiles == 1
        ? $"1 file is waiting for {Tool.Name}."
        : $"{Tool.WaitingFiles} files are waiting for {Tool.Name}.";
}
