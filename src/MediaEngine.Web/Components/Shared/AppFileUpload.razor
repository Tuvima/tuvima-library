@namespace MediaEngine.Web.Components.Shared
@typeparam T
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable
<div class="tl-file-upload @Class">
    <InputFile @ref="_input" id="@_inputId" class="tl-file-upload__input" OnChange="ChangedAsync" accept="@Accept" disabled="@Disabled" multiple="@(MaximumFileCount > 1)" @attributes="AdditionalAttributes" />
    @if (CustomContent is not null) { @CustomContent(this) }
    else { <label for="@_inputId" class="app-button app-button--outlined">Choose file</label> }
    @if (SelectedTemplate is not null) { @SelectedTemplate(_files) }
</div>
@code {
    private readonly string _inputId = $"app-file-{Guid.NewGuid():N}";
    private InputFile? _input;
    private T? _files;
    private IJSObjectReference? _module;
    [Parameter] public string? Accept { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int MaximumFileCount { get; set; } = 1;
    [Parameter] public EventCallback<T?> FilesChanged { get; set; }
    [Parameter] public RenderFragment<AppFileUpload<T>>? CustomContent { get; set; }
    [Parameter] public RenderFragment<T?>? SelectedTemplate { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    public async Task OpenFilePickerAsync()
    {
        if (Disabled || _input?.Element is not { } element) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/app-fields.js");
        await _module.InvokeVoidAsync("openFilePicker", element);
    }
    private async Task ChangedAsync(InputFileChangeEventArgs args)
    {
        if (Disabled) return;
        object value = MaximumFileCount > 1 ? args.GetMultipleFiles(MaximumFileCount) : args.File;
        if (value is T files) { _files = files; await FilesChanged.InvokeAsync(files); }
    }
    public async ValueTask DisposeAsync() { if (_module is not null) { try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { } } }
}
