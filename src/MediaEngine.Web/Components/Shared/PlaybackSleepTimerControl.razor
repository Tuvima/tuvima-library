@namespace MediaEngine.Web.Components.Shared
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Services.Playback

<div class="@RootClass">
    <AppSelect @ref="_select"
               Value="@SelectedValue"
               ValueChanged="HandleSelectionAsync"
               Open="@Open"
               OpenChanged="OpenChanged"
               Options="@Options"
               ToStringFunc="FormatSelected"
               Appearance="playback-flat"
               Variant="AppVariant.Text"
               Margin="AppMargin.None"
               Dense="true"
               FullWidth="false"
               Size="AppControlSize.Compact"
               PopoverClass="@ScopedPopoverClass"
               AriaLabel="@AriaLabel"
               Disabled="@Disabled"
               Class="playback-sleep-timer__select">
        <TriggerContent>
            <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Sleep" />
        </TriggerContent>
    </AppSelect>
</div>

@code {
    private readonly string ScopedPopoverClass = $"app-select__popover--playback-sleep app-select__playback-menu-{Guid.NewGuid():N}";
    private AppSelect? _select;

    [Parameter, EditorRequired] public AudiobookSleepTimerStateDto State { get; set; } = new();
    [Parameter] public IReadOnlyList<int> OptionsMinutes { get; set; } = [];
    /// <summary>The profile's default length, pre-selected while no timer is running. Null means Off.</summary>
    [Parameter] public int? DefaultMinutes { get; set; }
    /// <summary>False hides the end-of-chapter choices for profiles that turned them off.</summary>
    [Parameter] public bool OffersEndOfChapter { get; set; } = true;
    [Parameter] public AudiobookSleepTimerAvailabilityDto Availability { get; set; } = new();
    [Parameter] public string Surface { get; set; } = "dock";
    [Parameter] public bool Open { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public EventCallback<AudiobookSleepTimerSelectionDto> SelectionChanged { get; set; }
    [Parameter] public string? Class { get; set; }

    private string RootClass => string.Join(" ", new[]
    {
        "playback-sleep-timer",
        $"playback-sleep-timer--surface-{NormalizedSurface}",
        State.Mode != AudiobookSleepTimerModes.Off ? "playback-sleep-timer--active" : null,
        Class,
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private string NormalizedSurface => Surface is "dock" or "expanded" or "phone" or "popup" or "video" ? Surface : "panel";
    private string SelectedValue => PlaybackSleepTimerChoices.SelectedValue(State, DefaultMinutes);

    private IReadOnlyList<AppSelectOption> Options => PlaybackSleepTimerChoices.Options(State, OptionsMinutes, DefaultMinutes, OffersEndOfChapter, Availability);
    private string AriaLabel => $"Sleep timer: {PlaybackSleepTimerChoices.StatusText(State)}. Choose when playback stops.";

    private string FormatSelected(string? _) => string.Empty;

    private async Task HandleSelectionAsync(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;

        var selection = PlaybackSleepTimerChoices.SelectionFor(value, Availability);

        if (selection is null) return;
        try
        {
            await OpenChanged.InvokeAsync(false);
            await SelectionChanged.InvokeAsync(selection);
        }
        finally
        {
            // AppTypedSelect tracks its own selected item. Reconcile that internal value
            // from the authoritative State while returning focus to this trigger.
            if (_select is not null)
            {
                await _select.ReconcileValueAsync();
            }
        }
    }
}
