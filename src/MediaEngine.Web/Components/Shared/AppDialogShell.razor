@namespace MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Ui

<div class="app-dialog-shell app-dialog-shell--@SizeClass"
     role="@(Modal && Context is null ? "dialog" : "region")"
     aria-modal="@(Modal && Context is null ? "true" : null)"
     aria-labelledby="@TitleId">
    <header class="@HeaderClass">
        @if (OnBack.HasDelegate)
        {
            <AppIconButton Icon="@AppMaterialIcons.Outlined.ArrowBack"
                           Size="AppControlSize.Compact"
                           Tone="AppUiTone.Neutral"
                           Class="app-dialog-shell__back"
                           aria-label="Go back"
                           OnClick="OnBack" />
        }
        @if (HeaderArt is not null)
        {
            <div class="app-dialog-shell__art">@HeaderArt</div>
        }
        else if (!string.IsNullOrWhiteSpace(ResolvedIcon))
        {
            <div class="@IconClass">
                <AppMaterialIcon Icon="@ResolvedIcon" />
            </div>
        }

        <div class="app-dialog-shell__copy">
            @if (!string.IsNullOrWhiteSpace(Eyebrow))
            {
                <div class="app-dialog-shell__eyebrow">@Eyebrow</div>
            }
            <h2 id="@TitleId" class="app-dialog-shell__title">@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <div class="app-dialog-shell__subtitle">@Subtitle</div>
            }
        </div>

        @if (OnClose.HasDelegate)
        {
            <AppIconButton Icon="@AppMaterialIcons.Outlined.Close"
                           Size="AppControlSize.Compact"
                           Tone="AppUiTone.Neutral"
                           Class="app-dialog-shell__close"
                           aria-label="Close dialog"
                           OnClick="OnClose" />
        }
    </header>

    <div class="app-dialog-shell__body">
        @ChildContent
    </div>

    @if (FooterContent is not null)
    {
        <footer class="app-dialog-shell__footer">
            @FooterContent
        </footer>
    }
</div>

@code {
    [CascadingParameter] public IAppDialogContext? Context { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Icon { get; set; }

    /// <summary>
    /// The popup's tone (one popup style, one-look spec WP1): Warning is the amber "unsaved or risky" icon, Info the blue notice
    /// icon, Error the red danger icon. A tone with no <see cref="Icon"/> supplies its own icon; no tone keeps the plain icon.
    /// </summary>
    [Parameter] public AppUiTone? Tone { get; set; }
    [Parameter] public string Size { get; set; } = "Large";
    [Parameter] public RenderFragment? HeaderArt { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool CenterTitle { get; set; }
    [Parameter] public bool Modal { get; set; } = true;
    private string TitleId { get; } = $"dialog-title-{Guid.NewGuid():N}";
    private string HeaderClass => $"app-dialog-shell__header{(CenterTitle ? " app-dialog-shell__header--centered" : string.Empty)}";

    protected override Task OnParametersSetAsync() => Context is not null && Context.PresentationClass is null
        ? Context.SetPresentationClassAsync("app-dialog-host") : Task.CompletedTask;

    private string? ResolvedIcon => !string.IsNullOrWhiteSpace(Icon)
        ? Icon
        : Tone switch
        {
            AppUiTone.Warning => AppMaterialIcons.Outlined.WarningAmber,
            AppUiTone.Info => AppMaterialIcons.Outlined.Info,
            AppUiTone.Error => AppMaterialIcons.Outlined.ErrorOutline,
            _ => null,
        };

    private string IconClass => Tone is null or AppUiTone.Neutral or AppUiTone.Primary
        ? "app-dialog-shell__icon"
        : $"app-dialog-shell__icon app-dialog-shell__icon--{Tone.ToString()!.ToLowerInvariant()}";

    private string SizeClass => Size.Trim().ToLowerInvariant() switch
    {
        "small" => "small",
        "medium" => "medium",
        "provider" => "provider",
        "fullscreeneditor" => "fullscreen-editor",
        "fullscreen-editor" => "fullscreen-editor",
        _ => "large",
    };
}
