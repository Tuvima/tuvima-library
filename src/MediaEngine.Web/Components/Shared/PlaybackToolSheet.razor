@namespace MediaEngine.Web.Components.Shared
@using System.Linq
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable

<section id="@(Modal ? _sheetId : null)" @ref="_root" class="@RootClass" role="@(Modal ? "dialog" : "region")" aria-label="@Title" aria-modal="@(Modal ? "true" : null)" tabindex="@(Modal ? "-1" : null)" @attributes="AdditionalAttributes">
    <PlaybackSheetHandleButton Class="playback-tool-sheet__handle" Label="@CloseLabel" OnClick="@CloseAsync" />
    <div class="playback-tool-sheet__header">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <AppMaterialIcon Icon="@Icon" Class="playback-tool-sheet__header-icon" />
        }
        <div class="playback-tool-sheet__heading">
            <h2>@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p>@Subtitle</p>
            }
        </div>
        <AppNativeButton Type="button"
                         Class="playback-tool-sheet__close"
                         OnClick="@CloseAsync"
                         AriaLabel="@CloseAriaLabel"
                         title="@CloseAriaLabel">
            <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Close" />
        </AppNativeButton>
    </div>
    <div class="playback-tool-sheet__content">
        <CascadingValue Name="PlaybackPopoverOwner" Value="@(Modal ? _sheetId : PlaybackPopoverOwner)">@ChildContent</CascadingValue>
    </div>
</section>

@code {
    [Parameter]
    public string Title { get; set; } = "Playback tools";

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string Surface { get; set; } = "panel";

    [Parameter]
    public string Presentation { get; set; } = "inline";

    [Parameter]
    public bool Modal { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;
    [CascadingParameter(Name = "PlaybackPopoverOwner")] public string? PlaybackPopoverOwner { get; set; }
    private readonly string _sheetId = $"playback-sheet-{Guid.NewGuid():N}";
    private ElementReference _root;
    private IJSObjectReference? _module;
    private bool _focusAttached;

    private string CloseLabel => Surface == "popup" || Presentation == "full-overlay"
        ? "Collapse sheet"
        : "Close sheet";
    private string CloseAriaLabel => $"Close {Title}";

    private string NormalizedSurface => Surface switch
    {
        "popup" => "popup",
        "fullscreen" => "fullscreen",
        _ => "panel",
    };

    private string NormalizedPresentation => Presentation switch
    {
        "full-overlay" => "full-overlay",
        "rollup" => "full-overlay",
        _ => "inline",
    };

    private string RootClass => string.Join(" ", new[]
    {
        "playback-tool-sheet",
        $"playback-tool-sheet--{NormalizedSurface}",
        $"playback-tool-sheet--{NormalizedPresentation}",
        Class,
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Modal)
        {
            await RestoreFocusAsync();
            return;
        }
        if (_focusAttached) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-tool-sheet.js");
            await _module.InvokeVoidAsync("attachModal", _root);
            _focusAttached = true;
        }
        catch (InvalidOperationException) { }
        catch (JSDisconnectedException) { }
    }

    private async Task CloseAsync()
    {
        await RestoreFocusAsync();
        await OnClose.InvokeAsync();
    }

    private async Task RestoreFocusAsync()
    {
        if (!_focusAttached || _module is null) return;
        try { await _module.InvokeVoidAsync("restoreFocus", _root); }
        catch (JSDisconnectedException) { }
        _focusAttached = false;
    }

    public async ValueTask DisposeAsync()
    {
        await RestoreFocusAsync();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
