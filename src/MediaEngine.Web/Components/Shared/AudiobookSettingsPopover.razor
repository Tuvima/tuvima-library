@namespace MediaEngine.Web.Components.Shared
@using System.Linq
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Services.Playback
@inject IStringLocalizer<SharedStrings> L

@* The audiobook player's gear (unified player D10): one Settings button in the dock, the More menu and the phone and pop-out full player, in
   place of the separate Speed and Sleep buttons. It opens the shared PlayerSettingsMenu (Playback speed, Sleep timer, Show bookmarks on the bar)
   in the shared popover, so it draws in the top layer like the video player's Settings. The gear is underlined while the speed is not 1x or a
   sleep timer is running. *@
<span class="audiobook-settings @Class" data-audiobook-settings>
    <PlaybackPanel @ref="_popover" Title="@(Title ?? L["PlayerSettings_Title"].Value)" ToolId="@_id" Kind="settings" Surface="@Surface" ShowHeading="false"
                     Open="@Open" OpenChanged="HandleOpenChangedAsync" TriggerClass="@TriggerClassValue">
        <TriggerContent>
            @if (!string.IsNullOrWhiteSpace(TriggerText)) { <span>@TriggerText</span> }
            else { <PlaybackUtilityGlyph Glyph="@TriggerGlyph" /> }
        </TriggerContent>
        <ChildContent>
            <PlayerSettingsMenu Experience="PlaybackExperience.Audiobook" OnClose="CloseAsync"
                                PlaybackRate="@PlaybackRate" PlaybackRateChanged="@PlaybackRateChanged"
                                SleepTimerState="@SleepTimerState" SleepTimerAvailability="@SleepTimerAvailability" SleepTimerOptionsMinutes="@SleepTimerOptionsMinutes"
                                SleepTimerDefaultMinutes="@SleepTimerDefaultMinutes" SleepTimerOffersEndOfChapter="@SleepTimerOffersEndOfChapter" SleepTimerChanged="@SleepTimerChanged"
                                ShowBookmarksOnBar="@ShowBookmarksOnBar" ShowBookmarksOnBarChanged="@ShowBookmarksOnBarChanged" />
        </ChildContent>
    </PlaybackPanel>
</span>

@code {
    private readonly string _id = $"audiobook-settings-{Guid.NewGuid():N}";
    private PlaybackPanel? _popover;

    /// <summary>The tooltip and accessible name of the gear. Defaults to "Settings".</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>"dock", "panel" or "phone": the surface the gear sits on, reported back with open and close.</summary>
    [Parameter] public string Surface { get; set; } = "dock";

    [Parameter] public string? Class { get; set; }

    /// <summary>The icon on the trigger (the gear by default; the persistent bar passes the sleep-timer glyph).</summary>
    [Parameter] public PlaybackUtilityGlyphKind TriggerGlyph { get; set; } = PlaybackUtilityGlyphKind.Settings;

    /// <summary>Text drawn instead of an icon, such as the speed value on the persistent bar's chip.</summary>
    [Parameter] public string? TriggerText { get; set; }

    /// <summary>Extra class on the trigger button (the bar's speed chip).</summary>
    [Parameter] public string? TriggerClass { get; set; }

    private string? TriggerClassValue => string.Join(" ", new[] { IsOn ? "is-on" : null, TriggerClass }.Where(value => !string.IsNullOrWhiteSpace(value))) is { Length: > 0 } value ? value : null;

    /// <summary>True draws the accent underline: the speed is not 1x or a sleep timer is running.</summary>
    [Parameter] public bool IsOn { get; set; }

    /// <summary>Lets the host open or close the menu (for example when the book changes).</summary>
    [Parameter] public bool? Open { get; set; }

    [Parameter] public EventCallback<PlaybackSpeedMenuState> OpenChanged { get; set; }

    [Parameter] public double PlaybackRate { get; set; } = 1d;
    [Parameter] public EventCallback<double> PlaybackRateChanged { get; set; }

    [Parameter] public AudiobookSleepTimerStateDto? SleepTimerState { get; set; }
    [Parameter] public AudiobookSleepTimerAvailabilityDto SleepTimerAvailability { get; set; } = new();
    [Parameter] public IReadOnlyList<int> SleepTimerOptionsMinutes { get; set; } = [];
    [Parameter] public int? SleepTimerDefaultMinutes { get; set; }
    [Parameter] public bool SleepTimerOffersEndOfChapter { get; set; } = true;
    [Parameter] public EventCallback<AudiobookSleepTimerSelectionDto> SleepTimerChanged { get; set; }

    [Parameter] public bool ShowBookmarksOnBar { get; set; }
    [Parameter] public EventCallback<bool> ShowBookmarksOnBarChanged { get; set; }

    private Task HandleOpenChangedAsync(bool open) => OpenChanged.InvokeAsync(new PlaybackSpeedMenuState(Surface, open));

    private async Task CloseAsync()
    {
        if (_popover is not null)
        {
            await _popover.CloseAsync();
        }
    }
}
