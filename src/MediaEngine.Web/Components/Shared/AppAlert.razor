@namespace MediaEngine.Web.Components.Shared
<div class="@RootClass" style="@(InlineStyle ?? Style)" role="@(ResolvedSeverity == AppSeverity.Error ? "alert" : "status")" @attributes="AdditionalAttributes">
    @if (!NoIcon)
    {
        <AppMaterialIcon Icon="@ResolvedIcon" Class="tl-alert-icon" />
    }
    <div class="tl-alert-message">@ChildContent</div>
    @if (ShowCloseIcon)
    {
        <button type="button" class="tl-alert-close" aria-label="Dismiss notification" @onclick="() => CloseIconClicked.InvokeAsync()">
            <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Close" Size="AppSize.Small" />
        </button>
    }
</div>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public AppUiTone Tone { get; set; } = AppUiTone.Info;
    [Parameter] public AppSeverity? Severity { get; set; }
    [Parameter] public AppVariant Variant { get; set; } = AppVariant.Outlined;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool NoIcon { get; set; }
    [Parameter] public bool Dense { get; set; }
    [Parameter] public bool ShowCloseIcon { get; set; }
    [Parameter] public EventCallback CloseIconClicked { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? InlineStyle { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private AppSeverity ResolvedSeverity => Severity ?? Tone switch { AppUiTone.Success => AppSeverity.Success, AppUiTone.Warning => AppSeverity.Warning, AppUiTone.Error => AppSeverity.Error, _ => AppSeverity.Info };
    private string ResolvedIcon => Icon ?? ResolvedSeverity switch { AppSeverity.Success => AppMaterialIcons.Filled.CheckCircle, AppSeverity.Warning => AppMaterialIcons.Filled.Warning, AppSeverity.Error => AppMaterialIcons.Filled.ErrorOutline, _ => AppMaterialIcons.Filled.Info };
    private AppUiTone ResolvedTone => Severity is null ? Tone : ResolvedSeverity switch { AppSeverity.Success => AppUiTone.Success, AppSeverity.Warning => AppUiTone.Warning, AppSeverity.Error => AppUiTone.Error, AppSeverity.Normal => AppUiTone.Neutral, _ => AppUiTone.Info };
    private string RootClass => $"app-alert tl-alert tl-alert-{Variant.ToString().ToLowerInvariant()} tl-alert-{ResolvedSeverity.ToString().ToLowerInvariant()} {(Dense ? "tl-alert-dense" : "")} {AppUiMaps.ToneClass(ResolvedTone)} {Class}";
}
