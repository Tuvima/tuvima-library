@namespace MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Playback
<span class="playback-speed-control @Class">
<PlaybackPopover Title="@(PlaybackRateOptions.IsValid(Value) ? $"Playback speed {PlaybackRateOptions.FormatLabel(Value)}" : "Playback speed unavailable")" ToolId="@_id" Surface="@Surface" Disabled="@(!PlaybackRateOptions.IsValid(Value))" OpenChanged="MenuOpenChanged" Open="Open">
    <TriggerContent><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Speed" /></TriggerContent>
    <ChildContent>
        <div class="playback-speed-control__slider">
            <output aria-live="polite">@PlaybackRateOptions.FormatLabel(Value)</output>
            <PlaybackRangeSlider Value="@Value" Min="0.5" Max="3" Step="0.05" SnapValueToStep="false" InputStep="0.05" ShowTicks="false" Surface="@Surface" AriaLabel="Playback speed" ValueFormatter="PlaybackRateOptions.FormatLabel" ValueChanged="ValueChanged" />
            <AppNativeButton Type="button" OnClick="@(() => ValueChanged.InvokeAsync(1d))" AriaLabel="Reset playback speed to 1×">Reset to 1×</AppNativeButton>
        </div>
    </ChildContent>
</PlaybackPopover>
</span>
@code {
    private readonly string _id = $"speed-{Guid.NewGuid():N}";
    [Parameter] public double Value { get; set; } = 1;
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public EventCallback<bool> MenuOpenChanged { get; set; }
    [Parameter] public bool? Open { get; set; }
    [Parameter] public string Surface { get; set; } = "panel";
    [Parameter] public string? Class { get; set; }
}
