@namespace MediaEngine.Web.Components.Shared

@* The body of the list panels (unified player v2 D18 to D20; mockup screens 8 to 10), drawn inside a PlaybackPanel: an optional header strip (the Queue tabs, the
   Season line), an optional identity row (the book), the one scrolling list, and a fixed footer. Only the list scrolls, so the header, identity and footer stay
   put while 200 rows go by. The scrolling region carries the scroll key the panel script uses to bring the current row to the middle when the panel opens. *@
<div class="playback-list-panel" data-playback-list-panel @ref="_root">
    @if (Header is not null)
    {
        <div class="playback-list-panel__header">@Header</div>
    }
    @if (Identity is not null)
    {
        <div class="playback-list-panel__identity">@Identity</div>
    }
    <div class="playback-sheet-list playback-list-panel__scroll" id="@PanelId" role="@(string.IsNullOrWhiteSpace(PanelId) ? null : "tabpanel")" aria-labelledby="@LabelledBy"
         data-playback-context-scroll-key="@ScrollKey" data-playback-list-scroll>
        @ChildContent
    </div>
    @if (Footer is not null)
    {
        <div class="playback-list-panel__footer">@Footer</div>
    }
</div>

@code {
    private ElementReference _root;

    /// <summary>The panel's outer element (the Queue attaches its drag script to it).</summary>
    public ElementReference Element => _root;

    /// <summary>Fixed above the list: the tabs of the Queue, the Season line of Episodes.</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>Fixed under the header: the book's cover, title and author.</summary>
    [Parameter] public RenderFragment? Identity { get; set; }

    /// <summary>The rows, and anything that scrolls with them (the "Up next" heading).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Fixed under the list: "Playing from ...", the Autoplay switch, the Timeline control.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>Set when the list is a tab panel: its id (the tab's aria-controls) and the id of the tab that labels it.</summary>
    [Parameter] public string? PanelId { get; set; }
    [Parameter] public string? LabelledBy { get; set; }

    /// <summary>Changes when the list shows something else (the playing item, the tab, the season), so the current row is brought to the middle again.</summary>
    [Parameter] public string? ScrollKey { get; set; }
}
