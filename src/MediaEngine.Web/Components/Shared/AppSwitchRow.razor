@namespace MediaEngine.Web.Components.Shared
<label class="@RootClass" @onclick:stopPropagation="@StopClickPropagation">
    @if (!string.IsNullOrWhiteSpace(Icon)) { <AppMaterialIcon Icon="@Icon" Size="AppSize.Small" Class="app-switch-row__icon" /> }
    @if (!string.IsNullOrWhiteSpace(ImageIcon)) { <img class="app-official-pill__icon" src="@ImageIcon" alt="" width="14" height="14" /> }
    @if (HasCopy) { <span class="app-switch-row__copy">@if (!string.IsNullOrWhiteSpace(Label)) { <span class="app-switch-row__label">@Label</span> }@if (!string.IsNullOrWhiteSpace(Description)) { <span class="app-switch-row__description">@Description</span> }</span> }
    <span class="app-switch-row__control tl-switch tl-switch--@Size.ToString().ToLowerInvariant()">
        <input type="checkbox" role="switch" @bind:get="Value" @bind:set="ChangedAsync" disabled="@Disabled" aria-label="@EffectiveAriaLabel" />
        <span class="tl-switch-track" aria-hidden="true"><span class="tl-switch-thumb"></span></span>
        @if (!string.IsNullOrWhiteSpace(SwitchLabel)) { <span>@SwitchLabel</span> }
    </span>
</label>
@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Icon { get; set; }

    /// <summary>An image mark instead of a material icon (the Tuvima icon on the Official switch).</summary>
    [Parameter] public string? ImageIcon { get; set; }
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool StopClickPropagation { get; set; }
    [Parameter] public AppUiTone Tone { get; set; } = AppUiTone.Primary;
    [Parameter] public AppColor? Color { get; set; }
    [Parameter] public AppSize Size { get; set; } = AppSize.Medium;
    [Parameter] public string? T { get; set; }
    [Parameter] public string? SwitchLabel { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    private string? EffectiveAriaLabel => AriaLabel ?? SwitchLabel ?? Label;
    private bool HasCopy => !string.IsNullOrWhiteSpace(Label) || !string.IsNullOrWhiteSpace(Description);
    private string RootClass => string.Join(" ", new[] { "app-switch-row", AppUiMaps.ToneClass(Tone), HasCopy ? null : "app-switch-row--control-only", Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
    // Bound (not a bare onchange) so the renderer tracks what the box shows: when the owner keeps the old value, for
    // example after a confirmation is cancelled, the next render puts the switch back instead of leaving it flipped.
    private Task ChangedAsync(bool value) => !Disabled ? ValueChanged.InvokeAsync(value) : Task.CompletedTask;
}
