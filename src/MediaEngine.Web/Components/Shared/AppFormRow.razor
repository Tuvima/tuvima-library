@namespace MediaEngine.Web.Components.Shared
<div @attributes="AdditionalAttributes" class="@RootClass" data-alignment-row data-form-row>
    <div class="app-form-row__fields" style="@FieldsStyle">@ChildContent</div>
    @if (Message is not null || ReserveMessage)
    {
        <div class="app-form-row__message @(ReserveMessage ? "app-form-row__message--reserved" : null)" data-control-text role="status">@Message</div>
    }
</div>
@code {
    /// <summary>The fields and controls of the row, in order. Each one sits in its own column. A field (<c>app-field</c>) joins the row's three lines (label, control, help); anything else sits on the control line.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>An optional CSS grid-template-columns value, one entry per child (for example "220px 1.3fr auto"). Without it every child takes an equal column. The row does not wrap by itself.</summary>
    [Parameter] public string? Columns { get; set; }
    /// <summary>Helper, status or error text for the whole row. It sits on its own full-width line under the row, never beside a control.</summary>
    [Parameter] public RenderFragment? Message { get; set; }
    /// <summary>Keeps the message line one text line tall even while it is empty, so text that appears later never moves what is below.</summary>
    [Parameter] public bool ReserveMessage { get; set; }
    /// <summary>One column: each child's label, control and help stack in order, children one under another.</summary>
    [Parameter] public bool Stack { get; set; }
    /// <summary>When the nearest size container the row sits in is narrower than 1280 px (the editor window is one) the row wraps as whole fields, each keeping a usable width and sharing one control line with its neighbours on the same visual line; wider, it is the grid of <see cref="Columns"/>. Every child of a wrapping row is a field, or a <c>data-form-row-field</c> wrapper (<c>="fit"</c> keeps its own width) with a blank label line above a button, so a button lines up with the controls.</summary>
    [Parameter] public bool Wrap { get; set; }
    /// <summary>The grid of <see cref="Columns"/> at every width, except that when the nearest size container is narrower than 380 px (a phone-width card) the row stacks like <see cref="Stack"/>, one field under another. For a row that must stay on one line down to a narrow column and has no use for the 12 rem wrap of <see cref="Wrap"/>. Every child is a field, or a <c>data-form-row-field</c> wrapper, or a direct control that sits on the control line.</summary>
    [Parameter] public bool StackNarrow { get; set; }
    [Parameter] public string? Class { get; set; }
    /// <summary>Other attributes go on the row's root element, including a <c>style</c> (the columns are set on an inner element, so nothing is replaced).</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string RootClass => string.Join(" ", new[] { "app-form-row", Stack ? "app-form-row--stack" : null, Wrap ? "app-form-row--wrap" : null, StackNarrow ? "app-form-row--stack-narrow" : null, Class }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private string? FieldsStyle => string.IsNullOrWhiteSpace(Columns) ? null : $"--tl-form-row-columns: {Columns}";
}
