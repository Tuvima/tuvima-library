@namespace MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Ui
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AppPopoverService Popovers
<span @ref="_marker" class="app-popover-marker" aria-hidden="true"></span>
<div @ref="_surface" popover="manual" class="tl-popover app-popover @(Open ? "tl-popover-open" : null) @Class" style="@Style" hidden="@(!Open)">
    @ChildContent
</div>
@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public AppOrigin AnchorOrigin { get; set; } = AppOrigin.BottomLeft;
    [Parameter] public AppOrigin TransformOrigin { get; set; } = AppOrigin.TopLeft;
    [Parameter] public bool MatchAnchorWidth { get; set; }
    [Parameter] public bool FocusOnOpen { get; set; }
    [Parameter] public ElementReference? Anchor { get; set; }
    private ElementReference _marker, _surface;
    private IJSObjectReference? _module;
    private DotNetObjectReference<AppPopover>? _self;
    private bool _disposed;
    // The marker and surface exist in the page only after the first render has been applied, so every browser call
    // happens here. A reload can replace or remove this popover while its script is still loading; the component
    // is then disposed and the browser has nothing left to position, so stop instead of failing the whole screen.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        try
        {
            var module = _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/app-popover.js");
            if (_disposed)
            {
                await ReleaseModuleAsync();
                return;
            }
            _self ??= DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("update", _marker, _surface, Anchor, _self, Open, AnchorOrigin.ToString(), TransformOrigin.ToString(), MatchAnchorWidth, FocusOnOpen, Popovers.HostId);
        }
        catch (JSDisconnectedException)
        {
            // The browser connection is gone, so there is no popover left to position.
        }
        catch (Exception ex) when (_disposed && ex is ObjectDisposedException or JSException or TaskCanceledException)
        {
            // Disposed while the call was in flight: the popover left the page before the browser handled it.
        }
    }
    [JSInvokable] public async Task Dismiss() { Open = false; await OpenChanged.InvokeAsync(false); await InvokeAsync(StateHasChanged); }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await ReleaseModuleAsync();
        _self?.Dispose();
    }
    private async Task ReleaseModuleAsync()
    {
        var module = _module;
        _module = null;
        if (module is null) return;
        try
        {
            await module.InvokeVoidAsync("detach", _surface);
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser connection is gone, so the module is already released.
        }
        catch (Exception ex) when (ex is ObjectDisposedException or JSException or TaskCanceledException)
        {
            // The element or module left the page first; there is nothing left to detach.
        }
    }
}
