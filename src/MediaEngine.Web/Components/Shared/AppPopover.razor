@namespace MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Ui
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AppPopoverService Popovers
<span @ref="_marker" class="app-popover-marker" aria-hidden="true"></span>
<div @ref="_surface" popover="manual" class="tl-popover app-popover @SizeClass @(Open ? "tl-popover-open" : null) @Class" data-popout-size="@SizeName" data-list-width="@(ListWidth ? "true" : null)" data-list-sheet="@(SheetOnPhone ? "true" : null)" style="@Style" hidden="@(!Open)" role="@Role" aria-label="@(string.IsNullOrWhiteSpace(Role) ? null : AriaLabel)">
    @ChildContent
</div>
@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    /// <summary>The Pop-out size (Look v3 D14): Menu 272 px or Panel 400 px, on phones a Sheet. Left empty, the popover keeps its caller's own width (a typed select, an autocomplete).</summary>
    /// <summary>The surface's own role, for a tool panel that is a small dialog ("dialog") with its <see cref="AriaLabel"/>.</summary>
    [Parameter] public string? Role { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public AppPopoutSize Size { get; set; } = AppPopoutSize.None;
    [Parameter] public string? Style { get; set; }
    [Parameter] public AppOrigin AnchorOrigin { get; set; } = AppOrigin.BottomLeft;
    [Parameter] public AppOrigin TransformOrigin { get; set; } = AppOrigin.TopLeft;
    [Parameter] public bool MatchAnchorWidth { get; set; }
    /// <summary>The one sizing rule for dropdown lists (Look v3.1 D3): at least as wide as the anchor, as wide as the longest option, up to 480 px or the window less 16 px each side. Wins over <see cref="MatchAnchorWidth"/> and <see cref="Size"/>.</summary>
    [Parameter] public bool ListWidth { get; set; }
    /// <summary>Under 600 px the list opens as the bottom Sheet with 52 px rows instead of beside its anchor (Look v3.1 D13). Left off for a list that sits under a text box with the keyboard open.</summary>
    [Parameter] public bool SheetOnPhone { get; set; }
    [Parameter] public bool FocusOnOpen { get; set; }
    [Parameter] public ElementReference? Anchor { get; set; }
    private string? SizeName => Size == AppPopoutSize.None ? null : Size.ToString().ToLowerInvariant();
    private string? SizeClass => Size == AppPopoutSize.None ? null : $"app-popout app-popout--{SizeName}";
    private ElementReference _marker, _surface;
    private IJSObjectReference? _module;
    private DotNetObjectReference<AppPopover>? _self;
    private bool _disposed;
    // The marker and surface exist in the page only after the first render has been applied, so every browser call
    // happens here. A reload can replace or remove this popover while its script is still loading; the component
    // is then disposed and the browser has nothing left to position, so stop instead of failing the whole screen.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        try
        {
            var module = _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/app-popover.js");
            if (_disposed)
            {
                await ReleaseModuleAsync();
                return;
            }
            _self ??= DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("update", _marker, _surface, Anchor, _self, Open, AnchorOrigin.ToString(), TransformOrigin.ToString(), MatchAnchorWidth, FocusOnOpen, Popovers.HostId);
        }
        catch (JSDisconnectedException)
        {
            // The browser connection is gone, so there is no popover left to position.
        }
        catch (Exception ex) when (_disposed && ex is ObjectDisposedException or JSException or TaskCanceledException)
        {
            // Disposed while the call was in flight: the popover left the page before the browser handled it.
        }
    }
    [JSInvokable] public async Task Dismiss() { Open = false; await OpenChanged.InvokeAsync(false); await InvokeAsync(StateHasChanged); }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await ReleaseModuleAsync();
        _self?.Dispose();
    }
    private async Task ReleaseModuleAsync()
    {
        var module = _module;
        _module = null;
        if (module is null) return;
        try
        {
            await module.InvokeVoidAsync("detach", _surface);
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser connection is gone, so the module is already released.
        }
        catch (Exception ex) when (ex is ObjectDisposedException or JSException or TaskCanceledException)
        {
            // The element or module left the page first; there is nothing left to detach.
        }
    }
}
