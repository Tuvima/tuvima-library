@namespace MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Ui
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AppPopoverService Popovers
<span @ref="_marker" class="app-popover-marker" aria-hidden="true"></span>
<div @ref="_surface" popover="manual" class="tl-popover app-popover @(Open ? "tl-popover-open" : null) @Class" style="@Style" hidden="@(!Open)">
    @ChildContent
</div>
@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public AppOrigin AnchorOrigin { get; set; } = AppOrigin.BottomLeft;
    [Parameter] public AppOrigin TransformOrigin { get; set; } = AppOrigin.TopLeft;
    [Parameter] public bool MatchAnchorWidth { get; set; }
    [Parameter] public bool FocusOnOpen { get; set; }
    [Parameter] public ElementReference? Anchor { get; set; }
    private ElementReference _marker, _surface;
    private IJSObjectReference? _module;
    private DotNetObjectReference<AppPopover>? _self;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/app-popover.js");
            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("update", _marker, _surface, Anchor, _self, Open, AnchorOrigin.ToString(), TransformOrigin.ToString(), MatchAnchorWidth, FocusOnOpen, Popovers.HostId);
        } catch (JSDisconnectedException) { }
    }
    [JSInvokable] public async Task Dismiss() { Open = false; await OpenChanged.InvokeAsync(false); await InvokeAsync(StateHasChanged); }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null) { try { await _module.InvokeVoidAsync("detach", _surface); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
        _self?.Dispose();
    }
}
