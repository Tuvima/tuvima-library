@namespace MediaEngine.Web.Components.Shared

@* A compact amber warning badge ("Requires FFmpeg") for a card or row. The full sentence is the accessible name, and the tooltip
   when the visible words are the short form; pressing it opens where the problem is fixed. The icon and words say it is a warning, never colour alone. *@
<AppTooltip Text="@Text" Suppressed="@string.IsNullOrWhiteSpace(ShortText)">
    <button type="button" class="app-warning-strip" aria-label="@Text" @onclick="OnClick">
        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Warning" />
        <span class="app-warning-strip__text">@(ShortText ?? Text)</span>
    </button>
</AppTooltip>

@code {
    /// <summary>The full sentence: shown as the tooltip and read out by screen readers.</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;

    /// <summary>The few words shown in the badge; the full text when null.</summary>
    [Parameter] public string? ShortText { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
