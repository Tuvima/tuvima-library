@namespace MediaEngine.Web.Components.Rules
@using MediaEngine.Contracts.Collections
@implements IDisposable
@inject IStringLocalizer<SharedStrings> L

<section class="collection-rule-builder @($"collection-rule-builder--{Density}") @(Layout == RuleBuilderLayout.Sentence ? "collection-rule-builder--sentence" : null)" data-rule-domain="@Catalog.Domain">
    @if (ShowHeader)
    {
        <header class="collection-rule-builder__header">
            <div>
                <span class="collection-rule-builder__eyebrow">@Catalog.Eyebrow</span>
                <h3>@Catalog.Title</h3>
                <p>@Catalog.Description</p>
            </div>
        </header>
    }

    <div class="collection-rule-builder__workspace">
        @if (Layout == RuleBuilderLayout.Sentence)
        {
            @RenderSentence()
        }
        else
        {
            <div class="collection-rule-builder__conditions">
            @for (var groupIndex = 0; groupIndex < Definition.Groups.Count; groupIndex++)
            {
                var group = Definition.Groups[groupIndex];
                var capturedGroupIndex = groupIndex;

                @if (groupIndex > 0)
                {
                    <div class="collection-rule-builder__join" role="group" aria-label="@L["SharedRuleBuilder_RelationshipToPrecedingGroup"].Value">
                        <span>@L["SharedRuleBuilder_CombineGroupsWith"]</span>
                        <AppNativeButton Type="button" Class="@(group.JoinWithPrevious == "and" ? "is-selected" : null)"
                                         OnClick="@(() => SetGroupJoinAsync(group, "and"))">@L["SharedRuleBuilder_AND"]</AppNativeButton>
                        <AppNativeButton Type="button" Class="@(group.JoinWithPrevious != "and" ? "is-selected" : null)"
                                         OnClick="@(() => SetGroupJoinAsync(group, "or"))">@L["SharedRuleBuilder_OR"]</AppNativeButton>
                    </div>
                }

                <article class="collection-rule-builder__group" @key="group.Id"
                         @ondragover:preventDefault @ondrop="@(() => DropGroupAsync(group.Id))">
                    <header class="collection-rule-builder__group-header">
                        <div class="collection-rule-builder__group-identity">
                            <span class="collection-rule-builder__drag" draggable="true" title="@L["SharedRuleBuilder_DragToReorderGroup"].Value"
                                  @ondragstart="@(() => BeginGroupDrag(group.Id))">
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.DragIndicator" />
                            </span>
                            <strong>@L["SharedRuleBuilder_Group", groupIndex + 1]</strong>
                        </div>
                        <div class="collection-rule-builder__group-mode" role="group" aria-label="@L["SharedRuleBuilder_GroupMatchMode"].Value">
                            <AppNativeButton Type="button" Class="@(group.MatchMode == "all" ? "is-selected" : null)"
                                             OnClick="@(() => SetGroupModeAsync(group, "all"))">@L["SharedRuleBuilder_MatchALL"]</AppNativeButton>
                            <AppNativeButton Type="button" Class="@(group.MatchMode == "any" ? "is-selected" : null)"
                                             OnClick="@(() => SetGroupModeAsync(group, "any"))">@L["SharedRuleBuilder_MatchANY"]</AppNativeButton>
                        </div>
                        @if (Definition.Groups.Count > 1)
                        {
                            <AppIconButton Icon="@AppMaterialIcons.Outlined.DeleteOutline" Size="AppControlSize.Compact"
                                           Tooltip="@L["SharedRuleBuilder_RemoveGroup"].Value" AriaLabel="@L["SharedRuleBuilder_RemoveRuleGroup"].Value"
                                           OnClick="@(() => RemoveGroupAsync(capturedGroupIndex))" />
                        }
                    </header>

                    <div class="collection-rule-builder__rows">
                        @for (var conditionIndex = 0; conditionIndex < group.Conditions.Count; conditionIndex++)
                        {
                            var condition = group.Conditions[conditionIndex];
                            var capturedConditionIndex = conditionIndex;
                            <div class="collection-rule-builder__row" @key="condition">
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.DragIndicator" Class="collection-rule-builder__condition-drag" />
                                @RenderRowControls(condition, negated: false)
                                <AppIconButton Icon="@AppMaterialIcons.Outlined.DeleteOutline" Size="AppControlSize.Compact"
                                               Tooltip="@L["Common_RemoveCondition"].Value" AriaLabel="@L["Common_RemoveCondition"].Value"
                                               OnClick="@(() => RemoveConditionAsync(group, capturedConditionIndex))" />
                            </div>
                        }
                    </div>
                    <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary" StartIcon="@AppMaterialIcons.Outlined.Add"
                               Class="collection-rule-builder__add-condition"
                               OnClick="@(() => OpenConditionPicker(group.Id))">@L["Common_AddCondition"]</AppButton>

                    @if (string.Equals(_pickerTarget, group.Id, StringComparison.Ordinal))
                    {
                        @RenderPicker()
                    }
                </article>
            }

            <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Primary" StartIcon="@AppMaterialIcons.Outlined.Add"
                       Class="collection-rule-builder__add-group" OnClick="AddGroupAsync">@L["SharedRuleBuilder_AddGroup"]</AppButton>

            @if (Catalog.ShowSortControls && ShowSort)
            {
                <div class="collection-rule-builder__ordering">
                    <div class="collection-rule-builder__ordering-header">
                        <div><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.SwapVert" /><strong>@L["SharedRuleBuilder_SortResults"]</strong><span>@L["SharedRuleBuilder_SortingControlsTheDisplayOrder"]</span></div>
                        <small><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Info" /> @L["SharedRuleBuilder_SortingAffectsOrderNotMembership"]</small>
                    </div>
                    <div class="collection-rule-builder__sort">
                        <span>@L["Common_SortBy"]</span>
                        @RenderSortFieldSelect(SortField ?? Catalog.SortFields.First().Key, OnSortFieldChangedAsync)
                        @RenderSortDirectionSelect(SortField ?? Catalog.SortFields.First().Key, SortDirection, OnSortDirectionChangedAsync)
                    </div>
                    @if (string.IsNullOrWhiteSpace(SecondarySortField))
                    {
                        <AppButton ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Primary" StartIcon="@AppMaterialIcons.Outlined.Add"
                                   Class="collection-rule-builder__add-secondary" OnClick="AddSecondarySortAsync">@L["SharedRuleBuilder_AddThenBy"]</AppButton>
                    }
                    else
                    {
                        <div class="collection-rule-builder__sort">
                            <span>@L["SharedRuleBuilder_ThenBy"]</span>
                            @RenderSortFieldSelect(SecondarySortField, OnSecondarySortFieldChangedAsync)
                            @RenderSortDirectionSelect(SecondarySortField, SecondarySortDirection ?? "asc", OnSecondarySortDirectionChangedAsync)
                            <AppIconButton Icon="@AppMaterialIcons.Outlined.Close" Size="AppControlSize.Compact"
                                           Tooltip="@L["SharedRuleBuilder_RemoveSecondarySort"].Value" AriaLabel="@L["SharedRuleBuilder_RemoveSecondarySort"].Value"
                                           OnClick="RemoveSecondarySortAsync" />
                        </div>
                    }
                </div>
            }
            </div>
        }
    </div>
</section>


@code {
    [Parameter, EditorRequired] public RuleBuilderCatalog Catalog { get; set; } = null!;
    [Parameter, EditorRequired] public CollectionRuleDefinitionViewModel Definition { get; set; } = new();
    [Parameter] public EventCallback<CollectionRuleDefinitionViewModel> DefinitionChanged { get; set; }
    [Parameter] public string? SortField { get; set; }
    [Parameter] public EventCallback<string?> SortFieldChanged { get; set; }
    [Parameter] public string SortDirection { get; set; } = "asc";
    [Parameter] public EventCallback<string> SortDirectionChanged { get; set; }
    [Parameter] public string? SecondarySortField { get; set; }
    [Parameter] public EventCallback<string?> SecondarySortFieldChanged { get; set; }
    [Parameter] public string? SecondarySortDirection { get; set; }
    [Parameter] public EventCallback<string?> SecondarySortDirectionChanged { get; set; }
    [Parameter] public CollectionPreviewResult? Preview { get; set; }
    [Parameter] public EventCallback<CollectionPreviewResult?> PreviewChanged { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public string Density { get; set; } = "editor";
    [Parameter] public Func<RuleBuilderPreviewRequest, CancellationToken, Task<CollectionPreviewResult?>>? PreviewLoader { get; set; }

    /// <summary>The groups layout (today's) or the plain-sentence layout: rules joined by "and" with a "but never when" list.</summary>
    [Parameter] public RuleBuilderLayout Layout { get; set; } = RuleBuilderLayout.Groups;

    /// <summary>False when the owner draws its own title (the collection editor does).</summary>
    [Parameter] public bool ShowHeader { get; set; } = true;

    /// <summary>False when the owner draws its own order and limit controls.</summary>
    [Parameter] public bool ShowSort { get; set; } = true;

    private const string IncludeTarget = "\u0001include";
    private const string ExceptionTarget = "\u0001exceptions";

    private string _pickerCategory = string.Empty;
    private string _pickerSearch = string.Empty;
    private string? _pickerTarget;
    private string? _draggedGroupId;
    private bool _initialPreviewQueued;
    private CancellationTokenSource? _previewCts;

    private IReadOnlyList<RuleFieldDefinition> Fields => Catalog.Fields.Where(IsCapabilityEnabled).ToList();
    private List<CollectionRulePredicateViewModel> CompleteConditions => Definition.AllConditions.Where(IsComplete).ToList();
    private IReadOnlyList<RuleFieldDefinition> PickerFields => Fields
        .Where(item => _pickerTarget != ExceptionTarget || CollectionRuleSentence.CanBeException(item))
        .Where(item => _pickerTarget != IncludeTarget || item.Key != CollectionRuleSentence.MediaField)
        .Where(item => !string.IsNullOrWhiteSpace(_pickerSearch) || item.Category == _pickerCategory)
        .Where(item => string.IsNullOrWhiteSpace(_pickerSearch)
            || item.Label.Contains(_pickerSearch, StringComparison.OrdinalIgnoreCase)
            || item.Key.Replace('_', ' ').Contains(_pickerSearch, StringComparison.OrdinalIgnoreCase)
            || item.Description.Contains(_pickerSearch, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override void OnParametersSet()
    {
        _pickerCategory = string.IsNullOrWhiteSpace(_pickerCategory) ? Catalog.DefaultCategory : _pickerCategory;
        if (Layout == RuleBuilderLayout.Sentence)
            CollectionRuleSentence.IncludeGroup(Definition);
        else if (Definition.Groups.Count == 0)
            Definition.Groups.Add(NewGroup());
        foreach (var condition in Definition.AllConditions.Where(condition => Fields.All(field => field.Key != condition.Field)))
        {
            condition.Field = Fields[0].Key;
            condition.Op = Fields[0].Operators[0].Key;
            ClearValue(condition);
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialPreviewQueued && PreviewLoader is not null)
        {
            _initialPreviewQueued = true;
            _ = SchedulePreviewAsync(true);
        }
        return Task.CompletedTask;
    }

    private static CollectionRuleGroupViewModel NewGroup() => new() { Conditions = [] };
    private RuleFieldDefinition FieldFor(string key) => Fields.FirstOrDefault(field => field.Key == key) ?? Fields[0];
    private bool IsComplete(CollectionRulePredicateViewModel condition) =>
        !string.IsNullOrWhiteSpace(condition.Field)
        && (IsValueFreeOperator(condition.Op)
            || (RuleOperators.TakesRange(condition.Op)
                ? condition.Values is { Length: >= 2 } range && range.All(value => !string.IsNullOrWhiteSpace(value))
                : !string.IsNullOrWhiteSpace(condition.Value) || condition.Values?.Length > 0));

    /// <summary>A date picker for date fields, a whole-number box for "within the last N days", plain text otherwise.</summary>
    private static AppInputType InputTypeFor(RuleFieldDefinition field, string op) =>
        RuleOperators.TakesWholeNumber(op) ? AppInputType.Number
        : field.ValueProvider.Kind == RuleValueProviderKind.Date ? AppInputType.Date
        : AppInputType.Text;

    private static string RangeValue(CollectionRulePredicateViewModel condition, int index) =>
        condition.Values is { } values && index < values.Length ? values[index] : string.Empty;

    private async Task OnRangeValueChangedAsync(CollectionRulePredicateViewModel condition, int index, string? value)
    {
        var pair = new[] { RangeValue(condition, 0), RangeValue(condition, 1) };
        pair[index] = value ?? string.Empty;
        condition.Value = null;
        condition.DisplayValue = null;
        condition.DisplayValues = null;
        condition.Values = pair.All(string.IsNullOrWhiteSpace) ? null : pair;
        await NotifyChangedAsync();
    }

    private bool IsCapabilityEnabled(RuleFieldDefinition field) => field.RequiredCapability switch
    {
        null => true,
        "people-metadata" => Catalog.Capabilities.PeopleMetadata,
        "place-metadata" => Catalog.Capabilities.PlaceMetadata,
        "face-recognition" => Catalog.Capabilities.FaceRecognition,
        "semantic-search" => Catalog.Capabilities.SemanticSearch,
        "ocr" => Catalog.Capabilities.Ocr,
        _ => false,
    };

    private void OpenConditionPicker(string target)
    {
        if (string.Equals(_pickerTarget, target, StringComparison.Ordinal))
        {
            _pickerTarget = null;
            return;
        }
        _pickerTarget = target;
        _pickerCategory = Catalog.DefaultCategory;
        _pickerSearch = string.Empty;
    }

    private Task OnPickerSearchChanged(string? value) { _pickerSearch = value ?? string.Empty; return Task.CompletedTask; }
    private void SelectPickerCategory(string category) { _pickerCategory = category; _pickerSearch = string.Empty; }

    private async Task SelectFieldAsync(RuleFieldDefinition field)
    {
        if (_pickerTarget == ExceptionTarget)
        {
            var exception = new CollectionRulePredicateViewModel { Field = field.Key };
            CollectionRuleSentence.ApplyDisplayedCondition(exception, field, CollectionRuleSentence.ExceptionConditions(field)[0].Key);
            CollectionRuleSentence.EnsureExceptionsGroup(Definition).Conditions.Add(exception);
        }
        else if (_pickerTarget == IncludeTarget)
        {
            CollectionRuleSentence.IncludeGroup(Definition).Conditions.Add(new() { Field = field.Key, Op = field.Operators[0].Key });
        }
        else
        {
            var group = Definition.Groups.FirstOrDefault(candidate => candidate.Id == _pickerTarget);
            group?.Conditions.Add(new() { Field = field.Key, Op = field.Operators[0].Key });
        }

        _pickerTarget = null;
        await NotifyChangedAsync();
    }

    private async Task AddGroupAsync()
    {
        var group = NewGroup();
        group.JoinWithPrevious = "or";
        Definition.Groups.Add(group);
        OpenConditionPicker(group.Id);
        await NotifyChangedAsync();
    }

    private async Task RemoveGroupAsync(int index) { Definition.Groups.RemoveAt(index); await NotifyChangedAsync(); }
    private async Task RemoveConditionAsync(CollectionRuleGroupViewModel group, int index)
    {
        group.Conditions.RemoveAt(index);
        if (Layout == RuleBuilderLayout.Sentence && CollectionRuleSentence.IsExceptionsGroup(group) && group.Conditions.Count == 0)
            Definition.Groups.Remove(group);
        await NotifyChangedAsync();
    }
    private async Task SetGroupModeAsync(CollectionRuleGroupViewModel group, string mode) { group.MatchMode = mode; await NotifyChangedAsync(); }
    private async Task SetGroupJoinAsync(CollectionRuleGroupViewModel group, string join) { group.JoinWithPrevious = join; await NotifyChangedAsync(); }
    private void BeginGroupDrag(string groupId) => _draggedGroupId = groupId;

    private async Task DropGroupAsync(string targetGroupId)
    {
        if (string.IsNullOrWhiteSpace(_draggedGroupId) || _draggedGroupId == targetGroupId)
            return;
        var sourceIndex = Definition.Groups.FindIndex(group => group.Id == _draggedGroupId);
        var targetIndex = Definition.Groups.FindIndex(group => group.Id == targetGroupId);
        if (sourceIndex < 0 || targetIndex < 0)
            return;
        var moved = Definition.Groups[sourceIndex];
        Definition.Groups.RemoveAt(sourceIndex);
        if (sourceIndex < targetIndex)
            targetIndex--;
        Definition.Groups.Insert(targetIndex, moved);
        _draggedGroupId = null;
        await NotifyChangedAsync();
    }

    private async Task OnFieldChangedAsync(CollectionRulePredicateViewModel condition, string fieldKey, bool negated)
    {
        var field = FieldFor(fieldKey);
        condition.Field = field.Key;
        if (negated)
            CollectionRuleSentence.ApplyDisplayedCondition(condition, field, CollectionRuleSentence.ExceptionConditions(field)[0].Key);
        else
            condition.Op = field.Operators[0].Key;
        ClearValue(condition);
        await NotifyChangedAsync();
    }

    private async Task OnOperatorChangedAsync(CollectionRulePredicateViewModel condition, string op, bool negated)
    {
        // A day count and a date are different kinds of value, so switching between them starts the value fresh.
        var previous = negated ? CollectionRuleSentence.DisplayedCondition(condition, FieldFor(condition.Field)) : condition.Op;
        var changesKind = RuleOperators.TakesWholeNumber(previous) != RuleOperators.TakesWholeNumber(op);
        if (negated)
            CollectionRuleSentence.ApplyDisplayedCondition(condition, FieldFor(condition.Field), op);
        else
            condition.Op = op;
        if (IsValueFreeOperator(condition.Op) || changesKind)
            ClearValue(condition);
        else if (RuleOperators.TakesRange(op))
        {
            if (condition.Values is not { Length: >= 2 } && !string.IsNullOrWhiteSpace(condition.Value))
            {
                condition.Values = [condition.Value, string.Empty];
                condition.Value = null;
                condition.DisplayValue = null;
            }
        }
        else if (op != "in" && condition.Values is { Length: > 0 })
        {
            condition.Value = condition.Values[0];
            condition.DisplayValue = condition.DisplayValues?.FirstOrDefault() ?? condition.Value;
            condition.Values = null;
            condition.DisplayValues = null;
        }
        await NotifyChangedAsync();
    }

    private async Task OnTextValueChangedAsync(CollectionRulePredicateViewModel condition, string? value, bool negated = false)
    {
        condition.Value = negated && FieldFor(condition.Field).ValueProvider.Kind == RuleValueProviderKind.Boolean
            ? CollectionRuleSentence.StoredBoolean(value)
            : value;
        condition.DisplayValue = null;
        condition.Values = null;
        condition.DisplayValues = null;
        await NotifyChangedAsync();
    }

    private async Task OnOptionsChangedAsync(CollectionRulePredicateViewModel condition, IReadOnlyList<CollectionRuleValueDto> options, bool negated = false)
    {
        ClearValue(condition);
        if (options.Count == 1)
        {
            condition.Value = options[0].Value;
            condition.DisplayValue = options[0].Label;
            if (condition.Op == "in") condition.Op = "eq";
            // An exception stores "is not"; one value or several, it reads the same, and several are written one by one on save.
            if (negated && condition.Op == "eq") condition.Op = "neq";
        }
        else if (options.Count > 1)
        {
            condition.Values = options.Select(option => option.Value).ToArray();
            condition.DisplayValues = options.Select(option => option.Label).ToArray();
            condition.Op = negated ? "neq" : "in";
        }
        await NotifyChangedAsync();
    }

    private static void ClearValue(CollectionRulePredicateViewModel condition)
    {
        condition.Value = null;
        condition.DisplayValue = null;
        condition.Values = null;
        condition.DisplayValues = null;
    }

    private static IReadOnlyList<CollectionRuleValueDto> SelectedOptions(CollectionRulePredicateViewModel condition, RuleFieldDefinition field)
    {
        if (condition.Values is { Length: > 0 })
            return condition.Values.Select((value, index) => new CollectionRuleValueDto(value,
                condition.DisplayValues is { Length: > 0 } && index < condition.DisplayValues.Length ? condition.DisplayValues[index] : value,
                0, field.ValueProvider.OptionGroup)).ToList();
        return string.IsNullOrWhiteSpace(condition.Value)
            ? []
            : [new(condition.Value, condition.DisplayValue ?? condition.Value, 0, field.ValueProvider.OptionGroup)];
    }

    private async Task OnSortFieldChangedAsync(string value) { SortField = value; await SortFieldChanged.InvokeAsync(value); await Changed.InvokeAsync(); await SchedulePreviewAsync(); }
    private async Task OnSortDirectionChangedAsync(string value) { SortDirection = value; await SortDirectionChanged.InvokeAsync(value); await Changed.InvokeAsync(); await SchedulePreviewAsync(); }
    private async Task OnSecondarySortFieldChangedAsync(string value) { SecondarySortField = value; await SecondarySortFieldChanged.InvokeAsync(value); await Changed.InvokeAsync(); await SchedulePreviewAsync(); }
    private async Task OnSecondarySortDirectionChangedAsync(string value) { SecondarySortDirection = value; await SecondarySortDirectionChanged.InvokeAsync(value); await Changed.InvokeAsync(); await SchedulePreviewAsync(); }

    private async Task AddSecondarySortAsync()
    {
        SecondarySortField = Catalog.SortFields.First(option => option.Key != SortField).Key;
        SecondarySortDirection = "asc";
        await SecondarySortFieldChanged.InvokeAsync(SecondarySortField);
        await SecondarySortDirectionChanged.InvokeAsync(SecondarySortDirection);
        await Changed.InvokeAsync();
        await SchedulePreviewAsync();
    }

    private async Task RemoveSecondarySortAsync()
    {
        SecondarySortField = null;
        SecondarySortDirection = null;
        await SecondarySortFieldChanged.InvokeAsync(null);
        await SecondarySortDirectionChanged.InvokeAsync(null);
        await Changed.InvokeAsync();
        await SchedulePreviewAsync();
    }

    private async Task NotifyChangedAsync()
    {
        await DefinitionChanged.InvokeAsync(Definition);
        await Changed.InvokeAsync();
        await SchedulePreviewAsync();
    }

    private RenderFragment RenderSentence() => @<div class="collection-rule-builder__sentence">
        @{
            var include = CollectionRuleSentence.IncludeGroup(Definition);
            var exceptions = CollectionRuleSentence.ExceptionsGroup(Definition);
            var joinWord = include.MatchMode == "any" ? "or" : "and";
        }
        <section class="collection-rule-builder__block" aria-label="Include titles where">
            <span class="collection-rule-builder__label">Include titles where</span>
            @if (include.Conditions.Count == 0)
            {
                <p class="collection-rule-builder__hint">No rules yet. Add one, for example “Director is Denis Villeneuve”.</p>
            }
            @for (var index = 0; index < include.Conditions.Count; index++)
            {
                var condition = include.Conditions[index];
                var capturedIndex = index;
                @if (index > 0)
                {
                    <span class="collection-rule-builder__and">@joinWord</span>
                }
                <div class="collection-rule-builder__row collection-rule-builder__row--sentence" @key="condition">
                    <div class="collection-rule-builder__sentence-fields">
                        @RenderRowControls(condition, negated: false)
                    </div>
                    <AppIconButton Icon="@AppMaterialIcons.Outlined.RemoveCircleOutline" Size="AppControlSize.Compact"
                                   Tooltip="Remove rule" AriaLabel="Remove rule"
                                   OnClick="@(() => RemoveConditionAsync(include, capturedIndex))" />
                </div>
            }
            <div class="collection-rule-builder__actions">
                <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" StartIcon="@AppMaterialIcons.Outlined.Add"
                           Class="collection-rule-builder__add-rule"
                           OnClick="@(() => OpenConditionPicker(IncludeTarget))">Add rule</AppButton>
                <AppSwitchRow Label="Match any of these instead" Value="@(include.MatchMode == "any")"
                              ValueChanged="SetMatchAnyAsync" Size="AppSize.Small" Class="collection-rule-builder__match-any" />
            </div>
            @if (_pickerTarget == IncludeTarget)
            {
                @RenderPicker()
            }
        </section>

        <section class="collection-rule-builder__block collection-rule-builder__block--exceptions" aria-label="But never when">
            <span class="collection-rule-builder__label collection-rule-builder__label--exceptions">But never when</span>
            @for (var index = 0; exceptions is not null && index < exceptions.Conditions.Count; index++)
            {
                var condition = exceptions.Conditions[index];
                var capturedIndex = index;
                var capturedGroup = exceptions;
                @if (index > 0)
                {
                    <span class="collection-rule-builder__and">or</span>
                }
                <div class="collection-rule-builder__row collection-rule-builder__row--sentence" @key="condition">
                    <div class="collection-rule-builder__sentence-fields">
                        @RenderRowControls(condition, negated: true)
                    </div>
                    <AppIconButton Icon="@AppMaterialIcons.Outlined.RemoveCircleOutline" Size="AppControlSize.Compact"
                                   Tooltip="Remove exception" AriaLabel="Remove exception"
                                   OnClick="@(() => RemoveConditionAsync(capturedGroup, capturedIndex))" />
                </div>
            }
            <div class="collection-rule-builder__actions">
                <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral" StartIcon="@AppMaterialIcons.Outlined.Add"
                           Class="collection-rule-builder__add-rule"
                           OnClick="@(() => OpenConditionPicker(ExceptionTarget))">Add exception</AppButton>
            </div>
            @if (_pickerTarget == ExceptionTarget)
            {
                @RenderPicker()
            }
        </section>
    </div>;

    private async Task SetMatchAnyAsync(bool any)
    {
        CollectionRuleSentence.SetMatchAny(Definition, any);
        await NotifyChangedAsync();
    }

    private IReadOnlyList<AppSelectOption> FieldOptions(bool negated)
    {
        var order = Catalog.Categories.Select((category, index) => (category.Key, index)).ToDictionary(pair => pair.Key, pair => pair.index);
        var options = new List<AppSelectOption>();
        string? previous = null;
        foreach (var field in Fields.Where(field => !negated || CollectionRuleSentence.CanBeException(field))
                     .OrderBy(field => order.GetValueOrDefault(field.Category, int.MaxValue)))
        {
            options.Add(new AppSelectOption(field.Key, field.Label, SeparatorBefore: previous is not null && previous != field.Category));
            previous = field.Category;
        }

        return options;
    }

    /// <summary>The field, condition and value controls of one rule. An exception reads in positive words and is stored as the opposite.</summary>
    private RenderFragment RenderRowControls(CollectionRulePredicateViewModel condition, bool negated) => @<text>
        @{
            var field = FieldFor(condition.Field);
            var conditions = negated ? CollectionRuleSentence.ExceptionConditions(field) : field.Operators;
            var shownOp = negated ? CollectionRuleSentence.DisplayedCondition(condition, field) : condition.Op;
        }
        @if (Layout == RuleBuilderLayout.Sentence)
        {
            <AppSelect T="string" Value="@condition.Field"
                       ValueChanged="@(value => OnFieldChangedAsync(condition, value ?? condition.Field, negated))"
                       Options="@FieldOptions(negated)"
                       Label="Field" HideLabel="true" Variant="AppVariant.Outlined" Dense="true" Class="app-dialog-select" />
        }
        else
        {
            <AppSelect T="string" Value="@condition.Field"
                       ValueChanged="@(value => OnFieldChangedAsync(condition, value ?? condition.Field, negated))"
                       Label="Field" Variant="AppVariant.Outlined" Dense="true" Class="app-dialog-select">
                @foreach (var option in Fields)
                {
                    <AppSelectItem T="string" Value="@option.Key">@option.Label</AppSelectItem>
                }
            </AppSelect>
        }
        <AppSelect T="string" Value="@shownOp"
                   ValueChanged="@(value => OnOperatorChangedAsync(condition, value ?? shownOp, negated))"
                   Label="Condition" HideLabel="@(Layout == RuleBuilderLayout.Sentence)" Variant="AppVariant.Outlined" Dense="true" Class="app-dialog-select">
            @foreach (var op in conditions)
            {
                <AppSelectItem T="string" Value="@op.Key">@op.Label</AppSelectItem>
            }
        </AppSelect>
        @if (IsValueFreeOperator(condition.Op))
        {
            <div class="collection-rule-builder__no-value">No value needed</div>
        }
        else if (field.ValueProvider.Kind == RuleValueProviderKind.Boolean)
        {
            <AppSelect T="string" Value="@(negated ? CollectionRuleSentence.DisplayedBoolean(condition.Value) : condition.Value)"
                       ValueChanged="@(value => OnTextValueChangedAsync(condition, value, negated))"
                       Label="Value" HideLabel="@(Layout == RuleBuilderLayout.Sentence)" Variant="AppVariant.Outlined" Dense="true">
                <AppSelectItem T="string" Value="@("true")">Yes</AppSelectItem>
                <AppSelectItem T="string" Value="@("false")">No</AppSelectItem>
            </AppSelect>
        }
        else if (field.ValueProvider.Kind == RuleValueProviderKind.StaticOptions)
        {
            <AppSelect T="string" Value="@condition.Value"
                       ValueChanged="@(value => OnTextValueChangedAsync(condition, value))"
                       Label="Value" HideLabel="@(Layout == RuleBuilderLayout.Sentence)" Variant="AppVariant.Outlined" Dense="true">
                @foreach (var option in field.ValueProvider.Options ?? [])
                {
                    <AppSelectItem T="string" Value="@option.Value">@option.Label</AppSelectItem>
                }
            </AppSelect>
        }
        else if (field.ValueProvider.Kind == RuleValueProviderKind.CollectionLibrary)
        {
            <CollectionRuleValuePicker Field="@condition.Field"
                                       EntityField="@field.ValueProvider.ResolvesEntities"
                                       OptionGroup="@field.ValueProvider.OptionGroup"
                                       SelectedOptions="@SelectedOptions(condition, field)"
                                       SelectedOptionsChanged="@(options => OnOptionsChangedAsync(condition, options, negated))"
                                       SearchPlaceholder="@field.ValueProvider.SearchPlaceholder" />
        }
        else if (RuleOperators.TakesRange(condition.Op))
        {
            <div class="collection-rule-builder__range" data-value-provider="@field.ValueProvider.ProviderKey">
                <AppTextField T="string" Value="@RangeValue(condition, 0)"
                              ValueChanged="@(value => OnRangeValueChangedAsync(condition, 0, value))"
                              Label="From" InputType="@InputTypeFor(field, condition.Op)"
                              Variant="AppVariant.Outlined" Immediate="true"
                              DebounceInterval="300" Class="app-dialog-field" />
                <AppTextField T="string" Value="@RangeValue(condition, 1)"
                              ValueChanged="@(value => OnRangeValueChangedAsync(condition, 1, value))"
                              Label="To" InputType="@InputTypeFor(field, condition.Op)"
                              Variant="AppVariant.Outlined" Immediate="true"
                              DebounceInterval="300" Class="app-dialog-field" />
            </div>
        }
        else
        {
            <div data-value-provider="@field.ValueProvider.ProviderKey">
                <AppTextField T="string" Value="@condition.Value"
                              ValueChanged="@(value => OnTextValueChangedAsync(condition, value))"
                              Label="@(RuleOperators.TakesWholeNumber(condition.Op) ? L["Common_Number"].Value : L["Common_Value"].Value)"
                              Placeholder="@field.ValueProvider.SearchPlaceholder"
                              InputType="@InputTypeFor(field, condition.Op)"
                              Variant="AppVariant.Outlined" Immediate="true"
                              DebounceInterval="300" Class="app-dialog-field" />
            </div>
        }
    </text>;

    private RenderFragment RenderPicker() => @<div class="collection-rule-builder__picker">
        <div class="collection-rule-builder__picker-title"><strong>@(_pickerTarget == ExceptionTarget ? "Add exception" : "Add condition")</strong></div>
        <AppTextField T="string" Value="@_pickerSearch" ValueChanged="OnPickerSearchChanged"
                      Placeholder="Search rule types..." Adornment="AppAdornment.Start"
                      AdornmentIcon="@AppMaterialIcons.Outlined.Search" Immediate="true"
                      Class="collection-rule-builder__picker-search" />
        <nav class="collection-rule-builder__picker-families" aria-label="Rule families">
            @foreach (var category in Catalog.Categories)
            {
                <AppNativeButton Type="button" Class="@(category.Key == _pickerCategory ? "is-selected" : null)"
                                 OnClick="@(() => SelectPickerCategory(category.Key))">
                    <AppMaterialIcon Icon="@category.Icon" /><span>@category.Label</span>
                </AppNativeButton>
            }
        </nav>
        <div class="collection-rule-builder__picker-options">
            @foreach (var option in PickerFields)
            {
                <AppNativeButton Type="button" Class="collection-rule-builder__picker-option"
                                 OnClick="@(() => SelectFieldAsync(option))">
                    <AppMaterialIcon Icon="@option.Icon" />
                    <span><strong>@option.Label</strong><small>@option.Description</small></span>
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" />
                </AppNativeButton>
            }
        </div>
    </div>;

    private RenderFragment RenderSortFieldSelect(string value, Func<string, Task> changed) => @<AppSelect T="string" Value="@value" ValueChanged="@changed" Dense="true">
        @foreach (var option in Catalog.SortFields)
        {
            <AppSelectItem T="string" Value="@option.Key">@option.Label</AppSelectItem>
        }
    </AppSelect>;

    private RenderFragment RenderSortDirectionSelect(string field, string value, Func<string, Task> changed) => @<AppSelect T="string" Value="@value" ValueChanged="@changed" Dense="true">
        <AppSelectItem T="string" Value="@("asc")">@DirectionLabel(field, "asc")</AppSelectItem>
        <AppSelectItem T="string" Value="@("desc")">@DirectionLabel(field, "desc")</AppSelectItem>
    </AppSelect>;

    internal static string DirectionLabel(string field, string direction) => (field, direction) switch
    {
        ("provider_rating", "asc") => "Lowest first",
        ("provider_rating", _) => "Highest first",
        ("year" or "added_at" or "captured_date", "asc") => "Oldest first",
        ("year" or "added_at" or "captured_date", _) => "Newest first",
        ("duration", "asc") => "Shortest first",
        ("duration", _) => "Longest first",
        (_, "asc") => "A–Z",
        _ => "Z–A",
    };

    private async Task SchedulePreviewAsync(bool immediate = false)
    {
        if (PreviewLoader is null)
            return;
        _previewCts?.Cancel();
        _previewCts?.Dispose();
        _previewCts = new();
        try
        {
            if (!immediate) await Task.Delay(350, _previewCts.Token);
            await RunPreviewAsync(_previewCts.Token);
        }
        catch (OperationCanceledException) { }
    }

    public async Task RefreshAsync()
    {
        if (PreviewLoader is null)
            return;
        _previewCts?.Cancel();
        _previewCts?.Dispose();
        _previewCts = new();
        await RunPreviewAsync(_previewCts.Token);
    }

    private async Task RunPreviewAsync(CancellationToken token)
    {
        if (CompleteConditions.Count == 0)
        {
            Preview = null;
            await PreviewChanged.InvokeAsync(null);
            await InvokeAsync(StateHasChanged);
            return;
        }
        try
        {
            Preview = await PreviewLoader!(new(Definition, SortField, SortDirection, SecondarySortField, SecondarySortDirection), token);
            await PreviewChanged.InvokeAsync(Preview);
        }
        catch (OperationCanceledException) { throw; }
        catch
        {
            Preview = null;
            await PreviewChanged.InvokeAsync(null);
        }
        finally { await InvokeAsync(StateHasChanged); }
    }

    private static bool IsValueFreeOperator(string op) => op is "known" or "unknown" or "has_any_value" or "has_no_known_value";

    public void Dispose()
    {
        _previewCts?.Cancel();
        _previewCts?.Dispose();
    }
}
