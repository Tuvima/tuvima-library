@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Ui
@using MediaEngine.Contracts.Reports

@inject UIOrchestratorService Orchestrator

<AppDialog>
    <TitleContent>
        <div class="rpd-title">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Warning" Class="rpd-title-icon" />
            <span>Report a problem</span>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="rpd-content">
            @if (!string.IsNullOrEmpty(ItemTitle))
            {
                <div class="rpd-item-label">
                    <span class="rpd-item-eyebrow">Reporting issue with:</span>
                    <span class="rpd-item-title">@ItemTitle</span>
                </div>
            }

            <AppSelect T="string" @bind-Value="_category" Label="Category" Variant="AppVariant.Outlined"
                       Dense="true" Margin="AppMargin.Dense">
                <AppSelectItem Value="@("Wrong title or author")">Wrong title or author</AppSelectItem>
                <AppSelectItem Value="@("Wrong cover art")">Wrong cover art</AppSelectItem>
                <AppSelectItem Value="@("Wrong media type")">Wrong media type</AppSelectItem>
                <AppSelectItem Value="@("Duplicate entry")">Duplicate entry</AppSelectItem>
                <AppSelectItem Value="@("Missing metadata")">Missing metadata</AppSelectItem>
                <AppSelectItem Value="@("Wrong match")">Wrong Wikidata match</AppSelectItem>
                <AppSelectItem Value="@("Other")">Other</AppSelectItem>
            </AppSelect>

            <AppTextField T="string" @bind-Value="_note" Label="Details (optional)"
                          Variant="AppVariant.Outlined" Lines="3"
                          Placeholder="Describe the problem..."
                          Margin="AppMargin.Dense" />
        </div>
    </DialogContent>
    <DialogActions>
        <AppButton OnClick="Cancel" ButtonStyle="AppButtonStyle.Text" Size="AppControlSize.Compact"
                   Class="rpd-cancel">Cancel</AppButton>
        <AppButton OnClick="Submit" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Warning" Size="AppControlSize.Compact"
                   Disabled="@(string.IsNullOrEmpty(_category) || _submitting)">
            @if (_submitting)
            {
                <AppSpinner Size="AppSize.Small" Indeterminate="true"
                                     Class="rpd-spinner" />
            }
            Submit Report
        </AppButton>
    </DialogActions>
</AppDialog>

@code {
    [CascadingParameter] private IAppDialogContext DialogContext { get; set; } = default!;

    [Parameter] public Guid EntityId { get; set; }
    [Parameter] public string? ItemTitle { get; set; }

    private string _category = "Wrong title or author";
    private string _note = "";
    private bool _submitting;

    private void Cancel() => DialogContext.Cancel();

    private async Task Submit()
    {
        if (string.IsNullOrEmpty(_category)) return;

        _submitting = true;
        StateHasChanged();

        var request = new SubmitReportRequest
        {
            EntityId = EntityId,
            ItemTitle = ItemTitle,
            Category = _category,
            Note = _note,
        };

        var result = await Orchestrator.SubmitReportAsync(request);
        _submitting = false;

        if (result?.Success == true)
            DialogContext.Close(AppDialogResult.Ok(true));
        else
            DialogContext.Close(AppDialogResult.Cancel());
    }
}
