@namespace MediaEngine.Web.Components.Profiles
@using MediaEngine.Web.Components.Shared
@* Asks for the household's administrator PIN when a change was refused until it is entered. It only gathers the PIN; the page that opens it checks it with the Engine. *@
@if (Open)
{
    <div class="admin-unlock__backdrop">
        <div class="admin-unlock">
            <AppDialogShell Title="Enter your administrator PIN" Size="Small" Tone="AppUiTone.Info" OnClose="Cancel">
                <ChildContent>
                    <div class="app-dialog-shell__pad">
                        <p class="admin-unlock__hint">This is only asked for when administrator protection is turned on.</p>
                        <PinPad @bind-Value="_pin" Disabled="@Busy" MaxLength="12" OnSubmit="SubmitAsync" OnCancel="Cancel" />
                        @if (!string.IsNullOrWhiteSpace(Error))
                        {
                            <p class="admin-unlock__error" role="alert">@Error</p>
                        }
                    </div>
                </ChildContent>
                <FooterContent>
                    <AppButton Label="Cancel" ButtonStyle="AppButtonStyle.Outlined" Disabled="@Busy" OnClick="Cancel" />
                    <AppButton Label="@(Busy ? "Checking…" : "Continue")" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(Busy || _pin.Length < 4)" OnClick="SubmitAsync" />
                </FooterContent>
            </AppDialogShell>
        </div>
    </div>
}

@code {
    private string _pin = string.Empty;

    [Parameter] public bool Open { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback<string> OnUnlock { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task SubmitAsync()
    {
        if (_pin.Length < 4 || Busy)
        {
            return;
        }

        var pin = _pin;
        _pin = string.Empty;
        await OnUnlock.InvokeAsync(pin);
    }

    private async Task Cancel()
    {
        _pin = string.Empty;
        await OnCancel.InvokeAsync();
    }
}
