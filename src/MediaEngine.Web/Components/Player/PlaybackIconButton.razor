@namespace MediaEngine.Web.Components.Player
@using System.Linq
@using Microsoft.AspNetCore.Components.Web

<span class="@RootClass">
    <AppTooltip Text="@Control.AriaLabel" Suppressed="@Control.IsSelected">
    <AppNativeButton @ref="_button" Type="button"
                     Class="@ButtonClass"
                     Disabled="@Control.IsDisabled"
                     OnClick="@HandleClickAsync"
                     AriaLabel="@Control.AriaLabel"
                     aria-pressed="@AriaPressed"
                     aria-expanded="@AriaExpanded"
                     @attributes="AdditionalAttributes">
        <span class="playback-icon-button__visual" aria-hidden="true">
            @* The speaker shows its loud form until the sound is muted (unified player v2 D10); the crossed form means muted. *@
            <PlaybackUtilityGlyph Glyph="@(GlyphOverride ?? (Control.Key == PlaybackControlKey.Mute && !Control.IsActive ? PlaybackUtilityGlyphKind.Volume : Control.Glyph))" />
            @if (!string.IsNullOrWhiteSpace(Control.BadgeText) && Control.Key == PlaybackControlKey.Repeat)
            {
                <span class="playback-icon-button__badge">@Control.BadgeText</span>
            }
        </span>
    </AppNativeButton>
    </AppTooltip>
</span>

@code {
    [Parameter, EditorRequired]
    public PlaybackControlDefinition Control { get; set; } = null!;

    [Parameter]
    public string Size { get; set; } = "standard";

    [Parameter]
    public string Surface { get; set; } = "panel";

    [Parameter]
    public string Appearance { get; set; } = "standard";

    [Parameter]
    public string? Class { get; set; }

    /// <summary>Draws this glyph instead of the one the control's key maps to (the speaker's quiet form, unified player v2 D10).</summary>
    [Parameter]
    public PlaybackUtilityGlyphKind? GlyphOverride { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public EventCallback<ElementReference> OnActivated { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string NormalizedSize => Size switch
    {
        "compact" => "compact",
        "large" => "large",
        _ => "standard",
    };

    private string RootClass => string.Join(" ", new[]
    {
        "playback-icon-button-shell",
        $"playback-icon-button-shell--{NormalizedSize}",
        $"playback-icon-button-shell--surface-{NormalizedSurface}",
        $"playback-icon-button-shell--appearance-{NormalizedAppearance}",
        $"playback-icon-button-shell--{ControlClassKey}",
        Control.IsActive ? "is-active" : null,
        Control.IsSelected ? "is-selected" : null,
        Control.IsDisabled ? "is-disabled" : null,
        Class,
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private string ButtonClass => string.Join(" ", new[]
    {
        "playback-icon-button",
        $"playback-icon-button--{NormalizedSize}",
        $"playback-icon-button--surface-{NormalizedSurface}",
        $"playback-icon-button--appearance-{NormalizedAppearance}",
        $"playback-icon-button--{ControlClassKey}",
        Control.IsActive ? "is-active" : null,
        Control.IsSelected ? "is-selected" : null,
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private string? AriaPressed => Control.Key is PlaybackControlKey.Mute or PlaybackControlKey.Shuffle or PlaybackControlKey.Repeat or PlaybackControlKey.Favorite or PlaybackControlKey.Like or PlaybackControlKey.Dislike
        ? Control.IsActive ? "true" : "false"
        // Now playing is a page, not a panel that opens: it is pressed while the page is open (unified player v2 D24).
        : Control.Key == PlaybackControlKey.NowPlaying ? Control.IsSelected ? "true" : "false" : null;
    private string? AriaExpanded => (Control.Sheet is not null || Control.Key == PlaybackControlKey.More) && Control.Key != PlaybackControlKey.NowPlaying
        ? Control.IsSelected ? "true" : "false" : null;
    private AppNativeButton? _button;

    private string NormalizedSurface => Surface switch
    {
        "dock" or "expanded" or "phone" or "popup" or "video" => Surface,
        _ => "panel",
    };

    private string NormalizedAppearance => Appearance == "bare" ? "bare" : "standard";

    private string ControlClassKey => Control.Key.ToString()
        .Aggregate(string.Empty, (current, character) =>
            current.Length == 0
                ? char.ToLowerInvariant(character).ToString()
                : char.IsUpper(character)
                    ? $"{current}-{char.ToLowerInvariant(character)}"
                    : $"{current}{character}");

    private Task HandleClickAsync(MouseEventArgs _)
    {
        return OnActivated.HasDelegate
            ? OnActivated.InvokeAsync(_button?.Element ?? default)
            : OnClick.InvokeAsync();
    }
}
