@namespace MediaEngine.Web.Components.Player
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Web.Components.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using MediaEngine.Web.Services.Integration
@inject IServiceProvider Services
@implements IAsyncDisposable
@inject PlaybackLyricsPresenter Presenter
@inject IJSRuntime JS
@inject PlaybackSessionController Playback
@inject IStringLocalizer<SharedStrings> L

@* The lyrics themselves (unified player v2 D17; mockup screen 7), without any panel around them, so the lyrics panel and the Now playing page place
   the same part. Five states: Synced (the current line bold with a purple edge, the list follows the song, a hand scroll shows "Resume following"
   with "Select a line to jump to that moment" and selecting a timed line jumps there), Unsynced (plain scrolling text), Loading, Unavailable (one line
   with "Find lyrics" and "Add a lyrics file"; "Still looking" while a queued lookup is slow), Unreachable ("Lyrics could not be looked up right now"
   with "Try again", which asks again) and Error (the message with "Try again"). The identity row (small art, song, artist) is for hosts that do
   not already show the song; the footer (source and the "..." menu) is PlaybackLyricsFooter, drawn here unless the panel supplies its own. *@
<div class="playback-lyrics" @ref="_root" role="region" data-playback-lyrics data-lyrics-view="@View" aria-label="@L["Common_Lyrics"].Value">
    @if (ShowIdentity && CurrentItem is { } item)
    {
        <div class="playback-lyrics__identity" data-lyrics-identity>
            @if (PlaybackArtworkUrl.ForDrawnSize(item, 44) is not null)
            {
                <img class="playback-lyrics__art" src="@PlaybackArtworkUrl.ForDrawnSize(item, 44)" srcset="@PlaybackArtworkUrl.SrcSetForDrawnSize(item, 44)" data-image-display="audio-panel-identity" alt="" />
            }
            else
            {
                <span class="playback-lyrics__art" aria-hidden="true"></span>
            }
            <div class="playback-lyrics__identity-text">
                <div class="playback-lyrics__track">@item.Title</div>
                @if (!string.IsNullOrWhiteSpace(item.Subtitle)) { <div class="playback-lyrics__artist">@item.Subtitle</div> }
            </div>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Presenter.Status) && View is not "error")
    {
        <p class="playback-lyrics__status" role="status">@Presenter.Status</p>
    }
    <div class="playback-lyrics__stage">
        <div class="playback-lyrics__lines" role="@(HasLines ? "group" : null)" tabindex="@(HasLines ? 0 : null)" aria-label="@(HasLines ? L["PlaybackLyrics_LyricLines"].Value : null)">
            @switch (View)
            {
                case "alternatives":
                    <PlaybackLyricsAlternatives />
                    break;
                case "about":
                    <div class="playback-lyrics__state" data-lyrics-state="about">
                        <PlaybackLyricsAbout />
                        <AppNativeButton Type="button" Class="playback-lyrics__link" OnClick="CloseAbout">@L["Common_GoBack"]</AppNativeButton>
                    </div>
                    break;
                case "loading":
                    <p class="playback-lyrics__message" role="status" data-lyrics-state="loading">@L["PlaybackLyrics_LookingForLyrics"]</p>
                    break;
                case "error":
                    <div class="playback-lyrics__state" data-lyrics-state="error">
                        <p class="playback-lyrics__message" role="alert">@Presenter.Status</p>
                        <AppButton Label="@L["Common_TryAgain"].Value" ButtonStyle="AppButtonStyle.Outlined" OnClick="Presenter.RetryAsync" />
                    </div>
                    break;
                case "unreachable":
                    <div class="playback-lyrics__state" data-lyrics-state="unreachable">
                        <p class="playback-lyrics__message" role="alert">@L["PlaybackLyrics_CouldNotBeLookedUp"]</p>
                        <AppButton Label="@L["Common_TryAgain"].Value" ButtonStyle="AppButtonStyle.Outlined" OnClick="Presenter.RefreshAsync" />
                    </div>
                    break;
                case "unavailable":
                    <div class="playback-lyrics__state" data-lyrics-state="@(Presenter.NoSourceOn ? "no-source" : "unavailable")">
                        @if (Presenter.NoSourceOn)
                        {
                            <p class="playback-lyrics__message">@L["PlaybackLyrics_NoLyricsSourceIsSwitched"]</p>
                            <p class="playback-lyrics__hint">@(IsAdministrator ? L["PlaybackLyrics_SwitchOneOn"] : L["PlaybackLyrics_AskAnAdministrator"])</p>
                            @if (IsAdministrator) { <a class="playback-lyrics__link" href="/settings/plugins">@L["PlaybackLyrics_OpenPlugins"]</a> }
                        }
                        else
                        {
                            <p class="playback-lyrics__message">@(StillLooking ? L["PlaybackLyrics_StillLooking"] : L["PlaybackLyrics_NoLyricsFoundForThis"])</p>
                        }
                        <div class="playback-lyrics__actions">
                            @if (Presenter.Offers("find_lyrics") && !Presenter.NoSourceOn)
                            {
                                <AppButton Label="@L["PlaybackLyrics_FindLyrics"].Value" ButtonStyle="AppButtonStyle.Outlined" Disabled="@(Presenter.Refreshing || StillLooking)" OnClick="Presenter.RefreshAsync" />
                            }
                            <AppButton Label="@L["PlaybackLyrics_AddFile"].Value" ButtonStyle="AppButtonStyle.Outlined" Disabled="@Presenter.Refreshing" OnClick="OpenFilePickerAsync" />
                        </div>
                    </div>
                    break;
                default:
                    @for (var index = 0; index < Timeline.Count; index++)
                    {
                        var line = Timeline[index];
                        var renderedSnapshot = Snapshot;
                        @if (line.IsInstrumental)
                        {
                            <div class="playback-lyrics__line playback-lyrics__gap" data-lyric-index="@index" aria-label="@L["PlaybackLyrics_Instrumental"].Value">
                                <span class="playback-lyrics__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                            </div>
                        }
                        else if (line.StartSeconds is double time)
                        {
                            <AppNativeButton Type="button" Class="playback-lyrics__line"
                                             data-lyric-index="@index"
                                             AriaLabel="@L["PlaybackLyrics_SeekToLine", line.Text].Value" OnClick="@(() => SelectLineAsync(renderedSnapshot, time))">
                                @if (line.Words is { Count: > 0 } words)
                                {
                                    @for (var wordIndex = 0; wordIndex < words.Count; wordIndex++)
                                    { <span class="playback-lyrics__word" data-word-index="@wordIndex">@words[wordIndex].Text</span> }
                                }
                                else { @line.Text }
                            </AppNativeButton>
                        }
                        else { <p class="playback-lyrics__line playback-lyrics__line--static">@line.Text</p> }
                    }
                    break;
            }
        </div>
        @if (_needsReturn && View is "synced")
        {
            <div class="playback-lyrics__resume" data-lyrics-resume>
                <AppNativeButton Type="button" Class="playback-lyrics__resume-chip" OnClick="FollowAsync">
                    <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Play" />
                    <span>@L["PlaybackLyrics_ResumeFollowing"]</span>
                </AppNativeButton>
                <p class="playback-lyrics__resume-hint">@L["PlaybackLyrics_SelectALine"]</p>
            </div>
        }
    </div>
    <PlaybackLyricsFilePicker @ref="_picker" />
    @if (ShowFooter)
    {
        <div class="playback-lyrics__footer">
            <PlaybackLyricsFooter Snapshot="@Snapshot" AboutRequested="OpenAbout" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ListenPlaybackSnapshot Snapshot { get; set; } = new();
    [Parameter, EditorRequired] public IPlaybackCommandSink Commands { get; set; } = null!;

    /// <summary>True draws the song's small art, title and artist above the lines (the lyrics panel); the Now playing page already shows the song.</summary>
    [Parameter] public bool ShowIdentity { get; set; }

    /// <summary>True draws the source line and "..." menu under the lines. The lyrics panel passes false and puts <see cref="PlaybackLyricsFooter"/> in its own fixed footer.</summary>
    [Parameter] public bool ShowFooter { get; set; } = true;

    private ListenPlaybackSnapshot? _clockSnapshot;
    private IReadOnlyList<PlaybackLyricLine>? _clockLines;
    private string? _clockKey;
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PlaybackLyrics>? _self;
    private PlaybackLyricsFilePicker? _picker;
    private bool _needsReturn, _aboutOpen, _disposed;
    private string? _focusKey;
    private PlaybackLyricsIdentity? _identity;
    private IReadOnlyList<PlaybackLyricLine>? _sourceLines;
    private IReadOnlyList<PlaybackLyricLine> _timeline = [];
    private double _timelineDuration;
    private IReadOnlyList<PlaybackLyricLine> Timeline
    {
        get
        {
            if (!ReferenceEquals(_sourceLines, Presenter.Lines) || _timelineDuration != Snapshot.DurationSeconds)
            {
                _sourceLines = Presenter.Lines; _timelineDuration = Snapshot.DurationSeconds;
                _timeline = PlaybackLyricsTimeline.Build(Presenter.Lines, Snapshot.DurationSeconds, Playback.ClientSettings);
            }
            return _timeline;
        }
    }
    private bool IsAdministrator => Services.GetService<DashboardSessionAccessor>()?.Authority?.EffectiveAdministrator == true;
    private ListenQueueItem? CurrentItem => Snapshot.CurrentIndex >= 0 && Snapshot.CurrentIndex < Snapshot.Queue.Count ? Snapshot.Queue[Snapshot.CurrentIndex] : null;
    private bool HasLines => View is "synced" or "unsynced";

    // The queued lookup is still going after 30 seconds: the empty state says so, and Find lyrics waits for it.
    private bool StillLooking => Presenter.Lookup == PlaybackLyricsLookupState.StillLooking;

    // Which of the five states (or the two lists that replace the lines for a moment) the panel is in.
    private string View => Presenter.AlternativesOpen ? "alternatives"
        : _aboutOpen ? "about"
        : Presenter.Loading || Presenter.Refreshing ? "loading"
        : Presenter.Lines.Count > 0 ? (Presenter.IsSynced ? "synced" : "unsynced")
        : Presenter.LoadFailed ? "error"
        : Presenter.Lookup == PlaybackLyricsLookupState.Unreachable ? "unreachable"
        : "unavailable";

    protected override void OnInitialized() => Presenter.Changed += Changed;
    protected override async Task OnParametersSetAsync()
    {
        var identity = PlaybackLyricsIdentity.From(Snapshot);
        if (identity != _identity) { _identity = identity; _needsReturn = false; _aboutOpen = false; _clockSnapshot = null; _clockKey = null; }
        await Presenter.EnsureAsync(Snapshot, Commands);
        await Presenter.EnsureActionsAsync();
        await Presenter.ProbeSourcesAsync();
    }
    private void Changed() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private Task OpenFilePickerAsync() => _picker?.OpenAsync() ?? Task.CompletedTask;
    private void OpenAbout() { _aboutOpen = true; StateHasChanged(); }
    private void CloseAbout() { _aboutOpen = false; StateHasChanged(); }

    // Selecting a timed line jumps there, and the list follows the song again from that moment.
    private async Task SelectLineAsync(ListenPlaybackSnapshot snapshot, double seconds)
    {
        await Commands.SendAsync(snapshot,
            new MediaEngine.Contracts.Playback.ListenPlaybackCommandDto { Action = MediaEngine.Contracts.Playback.ListenPlaybackCommandActions.Seek, Value = seconds });
        await FollowAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (_module is null)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-lyrics.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _root, _self);
        }
        await MoveFocusAsync();
        var key = $"{_identity}:{Presenter.SelectedTrackId}";
        if (_clockKey != key || !ReferenceEquals(_clockLines, Timeline))
        {
            _clockKey = key; _clockLines = Timeline;
            await _module.InvokeVoidAsync("setTimes", _root, Timeline.Select(line => new { start = line.StartSeconds, end = line.EndSeconds, instrumental = line.IsInstrumental, words = line.Words?.Select(word => new { start = word.StartSeconds, end = word.EndSeconds }).ToArray() }).ToArray(), key);
        }
        if (!ReferenceEquals(_clockSnapshot, Snapshot))
        {
            _clockSnapshot = Snapshot;
            await _module.InvokeVoidAsync("setClock", _root, new { time = Snapshot.CurrentTimeSeconds, playing = Snapshot.IsPlaying && !Snapshot.NeedsUserGestureToStart,
                rate = Snapshot.PlaybackRate, asset = _identity?.AssetId.ToString("D"), request = Snapshot.PlaybackRequestVersion,
                lead = Playback.ClientSettings.LyricsLeadMilliseconds });
        }
    }

    // Find another and About lyrics sources replace the lines for a moment; focus goes into them and comes back to the "..." button, never to the page.
    private async Task MoveFocusAsync()
    {
        var view = View;
        var focusKey = view == "alternatives" ? $"alternatives:{Presenter.AlternativesLoading}" : view;
        if (focusKey == _focusKey || _module is null) return;
        var previous = _focusKey;
        _focusKey = focusKey;
        if (previous is null) return;
        if (view is "alternatives" or "about")
            await _module.InvokeVoidAsync("focusView", _root, view, previous is not null && previous.StartsWith("alternatives:", StringComparison.Ordinal) && view == "alternatives");
        else if (previous is not null && (previous.StartsWith("alternatives:", StringComparison.Ordinal) || previous == "about"))
            await _module.InvokeVoidAsync("focusMore", _root);
    }

    /// <summary>Called by the browser module when the list stops following the song (a hand scroll) or follows it again.</summary>
    [JSInvokable] public Task FollowChanged(bool needsReturn) { _needsReturn = needsReturn; return InvokeAsync(StateHasChanged); }
    private Task FollowAsync() => _module?.InvokeVoidAsync("follow", _root).AsTask() ?? Task.CompletedTask;
    public async ValueTask DisposeAsync()
    {
        _disposed = true; Presenter.Changed -= Changed;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("detach", _root); await _module.DisposeAsync(); }
            // The circuit has already gone, so the browser dropped the page with its listeners; there is nothing left to detach and nobody to tell.
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
