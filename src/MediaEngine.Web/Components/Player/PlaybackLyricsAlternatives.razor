@namespace MediaEngine.Web.Components.Player
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Playback
@implements IDisposable
@inject PlaybackLyricsPresenter Presenter
@inject IStringLocalizer<SharedStrings> L

@* "Find another" for lyrics (unified player v2 D17, review mock-ups 2026-11-18 D7): the shared pick-a-result window, with the song's art, a search box that
   starts as "Artist Title" (the album artist when the song has none), what the lyrics sources offer with the best match selected, and Use this.
   Searching again with other words asks the sources again; the Library's own pick (the normal case) never opens this. *@
<AppPickResultDialog Title="@L["PlaybackLyrics_FindLyrics"].Value" Visible="true" CoverShape="AppPickCoverShape.Square"
                     SearchText="@SearchText" Results="@Results" Loading="@Presenter.AlternativesLoading"
                     LoadingText="@L["PlaybackLyrics_LookingForOtherLyrics"].Value" Busy="@Presenter.Choosing"
                     Message="@EmptyMessage" OnSearch="SearchAsync" OnUse="UseAsync" OnCancel="Presenter.CloseAlternatives" />

@code {
    /// <summary>The song being played, for the box's starting text and the small art on each result.</summary>
    [Parameter] public ListenQueueItem? Item { get; set; }

    private bool _disposed;
    private string _searchText = string.Empty;
    private IReadOnlyList<AppPickResult> _results = [];
    private TextTrackAlternativesResponse? _mapped;

    // The starting text is worked out once as the window opens, so typing is never overwritten by a later draw.
    private string SearchText => _searchText;

    private IReadOnlyList<AppPickResult> Results
    {
        get
        {
            if (!ReferenceEquals(_mapped, Presenter.Alternatives))
            {
                _mapped = Presenter.Alternatives;
                // No album art: a lyrics result does not say which album it belongs to.
                _results = Presenter.Alternatives?.items.Select(offer => ToResult(offer, null)).ToList() ?? [];
            }
            return _results;
        }
    }

    private string EmptyMessage => Presenter.Alternatives?.message is { Length: > 0 } message ? message : L["PlaybackLyrics_NoOtherLyrics"].Value;

    protected override void OnInitialized()
    {
        // The box starts with the song's artist and title; with no artist on the song, the other name it carries (the album's artist).
        _searchText = Item is null ? string.Empty : FindDialogSearchText.ForSong(Item.Title, Item.Subtitle, Item.AuthorName);
        Presenter.Changed += Changed;
    }

    private void Changed() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }

    private AppPickResult ToResult(TextTrackAlternativeDto offer, string? cover) => FindAnotherResultMapper.ForLyrics(offer, L);

    // Search again with the box's text; only text the person changed is sent, so an untouched box is the Engine's own lookup.
    private Task SearchAsync(string text) => Presenter.OpenAlternativesAsync(FindDialogSearchText.EditedOrNull(_searchText, text));

    private Task UseAsync(AppPickResult pick) =>
        Presenter.Alternatives?.items.FirstOrDefault(offer => $"{offer.provider}:{offer.source_id}" == pick.Key) is { } offer
            ? Presenter.ChooseAsync(offer)
            : Task.CompletedTask;

    public void Dispose()
    {
        _disposed = true;
        Presenter.Changed -= Changed;
    }
}
