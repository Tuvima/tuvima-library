@namespace MediaEngine.Web.Components.Player
@using System.Linq
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Services.Playback
@using Microsoft.Extensions.DependencyInjection
@inject IStringLocalizer<SharedStrings> L
@inject IServiceProvider Services

@* The Sleep timer panel (unified player v2 D16; mockup screen 6). The moon tool of the audiobook bar (and of the music bar while a timer is running)
   opens it straight, with the header "Sleep timer" and the moon before it. While a timer runs the body leads with "Stopping in 14:32" and
   "Playback will pause automatically." (an end-of-chapter timer says "Stopping at the end of chapter 8" instead); under it the presets 15 / 30 / 45 /
   60 min, End of chapter (audiobooks with chapters only) and Custom duration... (a nested view). The fixed footer, only while a timer runs, holds
   "+5 minutes" and "Cancel timer". Every choice goes to the host as a selection (the session's one set-sleep-timer action); the timer itself lives in
   that session, so the bar, Now playing and a reload all show the same countdown. *@
<PlaybackPanel @ref="_panel" Title="@L["SleepTimer_Title"].Value" TriggerLabel="@TriggerLabel" ToolId="@EffectiveToolId" Kind="sleep" Surface="@Surface" ItemKey="@ItemKey"
               TriggerClass="@TriggerClassValue" Disabled="@Disabled" Open="@Open" OpenChanged="HandleOpenChangedAsync"
               TitleAdornment="@MoonContent" Footer="@(IsRunning ? FooterContent : null)">
    <TriggerContent><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Sleep" /></TriggerContent>
    <ChildContent>
        <SleepTimerView State="@State" Availability="@Availability" Chapters="@Chapters" OffersEndOfChapter="@OffersEndOfChapter" SelectionChanged="SelectionChanged" />
    </ChildContent>
</PlaybackPanel>

@code {
    private readonly string _generatedId = $"sleep-timer-{Guid.NewGuid():N}";
    private PlaybackPanel? _panel;

    /// <summary>The timer the session holds. Every number the panel shows comes from it.</summary>
    [Parameter, EditorRequired] public AudiobookSleepTimerStateDto State { get; set; } = new();

    /// <summary>Whether the current chapter can be a stop point (the session verifies the chapter boundary).</summary>
    [Parameter] public AudiobookSleepTimerAvailabilityDto Availability { get; set; } = new();

    /// <summary>The book's chapters: End of chapter is offered only when there are some, and they number the chapter a timer stops at.</summary>
    [Parameter] public IReadOnlyList<PlaybackChapterDto> Chapters { get; set; } = [];

    /// <summary>False hides End of chapter for profiles that turned chapter stops off.</summary>
    [Parameter] public bool OffersEndOfChapter { get; set; } = true;

    /// <summary>Asks the host to set, change or cancel (Off) the timer. Every preset, Custom duration, End of chapter, "+5 minutes" and "Cancel timer" call it.</summary>
    [Parameter] public EventCallback<AudiobookSleepTimerSelectionDto> SelectionChanged { get; set; }

    /// <summary>The surface the trigger sits on ("dock", "phone", "panel"), reported back with open and close.</summary>
    [Parameter] public string Surface { get; set; } = "panel";

    [Parameter] public string? ToolId { get; set; }

    /// <summary>The trigger's accessible name and tooltip; defaults to "Sleep timer".</summary>
    [Parameter] public string? Title { get; set; }

    [Parameter] public string? TriggerClass { get; set; }

    /// <summary>True draws the on-state of the moon: a timer is running. Defaults to the state of the timer.</summary>
    [Parameter] public bool? IsOn { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Lets the host open or close the panel (for example when the book changes).</summary>
    [Parameter] public bool? Open { get; set; }
    [Parameter] public EventCallback<PlaybackToolOpenState> OpenChanged { get; set; }

    /// <summary>Closes the panel when this key changes (the item that is playing).</summary>
    [Parameter] public string? ItemKey { get; set; }

    private string EffectiveToolId => ToolId ?? _generatedId;
    private bool IsRunning => PlaybackSleepTimerChoices.IsRunning(State);
    private TimeProvider Clock => Services.GetService<TimeProvider>() ?? TimeProvider.System;

    private string TriggerLabel => Title ?? (IsRunning ? L["SleepTimer_TriggerOn"].Value : L["SleepTimer_Title"].Value);

    private string? TriggerClassValue => string.Join(" ", new[] { IsOn ?? IsRunning ? "is-on" : null, TriggerClass }.Where(value => !string.IsNullOrWhiteSpace(value))) is { Length: > 0 } value ? value : null;

    private Task HandleOpenChangedAsync(bool open) => OpenChanged.InvokeAsync(new PlaybackToolOpenState(Surface, open));

    // The moon before the title (mockup screen 6). The panel header lays the title and this side by side; "order" puts the moon first.
    private RenderFragment MoonContent => @<span class="stp__moon" aria-hidden="true"><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Sleep" /></span>;

    // The footer (mockup screen 6): "+5 minutes" at the left, "Cancel timer" at the right. An end-of-chapter timer has no time to add to, so it has only Cancel.
    private RenderFragment FooterContent =>
        @<div class="stp__footer" data-sleep-footer>
            @if (State.Mode == AudiobookSleepTimerModes.Timer)
            {
                <AppNativeButton Type="button" Class="stp__extend" data-sleep-extend OnClick="ExtendAsync">@L["SleepTimer_AddFive"]</AppNativeButton>
            }
            <span class="stp__spacer"></span>
            <AppNativeButton Type="button" Class="stp__cancel" data-sleep-cancel OnClick="CancelAsync">@L["SleepTimer_Cancel"]</AppNativeButton>
        </div>;

    // "+5 minutes" sets a new timer at what is left plus five minutes through the same set action as every other choice.
    private async Task ExtendAsync()
    {
        if (PlaybackSleepTimerChoices.Extension(State, Clock.GetUtcNow()) is { } selection)
        {
            await SelectionChanged.InvokeAsync(selection);
        }
    }

    // Cancelling removes the footer button that had focus, so the panel closes and focus goes back to the moon.
    private async Task CancelAsync()
    {
        await SelectionChanged.InvokeAsync(PlaybackSleepTimerChoices.ForOff());
        if (_panel is not null)
        {
            await _panel.CloseAsync();
        }
    }
}
