@namespace MediaEngine.Web.Components.Player
@using MediaEngine.Web.Components.Shared
@inject IStringLocalizer<SharedStrings> L

@* Find subtitles, nested in Audio & subtitles (unified player v2 D12): asks the subtitle sources that are switched on for other versions of this
   title's subtitles. New versions appear in the Subtitles column. With no source switched on it says so (administrators also get the Plugins link). *@
<div class="sfv" data-subtitle-find>
    @if (NoSource)
    {
        <p class="sfv__notice" role="status" data-subtitles-state="no-source">
            <span>@L["PlayerSettings_NoSubtitleSource"]</span>
            @if (IsAdministrator) { <a href="/settings/plugins">@L["PlayerSettings_Plugins"]</a> }
        </p>
    }
    else
    {
        <p class="sfv__intro">@L["SubtitleFind_Intro"]</p>
        <AppNativeButton Type="button" Class="sfv__search" Disabled="@Loading" data-sfv-action="search" OnClick="OnSearch">
            @(Loading ? L["PlayerSettings_Searching"].Value : L["VideoPlaybackHost_FindBetterSubtitles"].Value)
        </AppNativeButton>
        @if (CanSetPreferred)
        {
            <AppNativeButton Type="button" Class="sfv__preferred" data-sfv-action="preferred" OnClick="OnSetPreferred">@L["VideoPlaybackHost_SetPreferredVersion"]</AppNativeButton>
        }
        @if (!string.IsNullOrWhiteSpace(Status)) { <p class="sfv__status" role="status">@Status</p> }
    }
</div>

@code {
    /// <summary>True when the Engine says no subtitle source is switched on.</summary>
    [Parameter] public bool NoSource { get; set; }
    [Parameter] public bool IsAdministrator { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Status { get; set; }

    /// <summary>True while a downloaded version is the chosen subtitle track, so it can be set as the title's preferred version.</summary>
    [Parameter] public bool CanSetPreferred { get; set; }
    [Parameter] public EventCallback OnSearch { get; set; }
    [Parameter] public EventCallback OnSetPreferred { get; set; }
}
