@namespace MediaEngine.Web.Components.Player
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Formatting
@using MediaEngine.Web.Services.Playback
@implements IDisposable
@inject IStringLocalizer<SharedStrings> L

@* Find subtitles (video player follow-ups D9 to D12; review mock-ups 2026-11-18 D7): the shared pick-a-result window, opened from "Find subtitles…" in
   Audio & subtitles. The search box starts as "Title Year", the search runs once as the window opens in the profile's subtitle language, and the sources'
   results list the best match first and selected, with "Use this". The Library's own pick (the normal case) never opens this. The one in use says
   "In use now" with "This one is wrong". Whenever there is nothing, a plain sentence says why; the sentences are written here, never taken from the
   Engine's own message. With no source switched on (checked once without contacting a source) nothing is searched. *@
<AppPickResultDialog Title="@L["AudioSubtitles_FindTitle"].Value" Visible="true" CoverShape="AppPickCoverShape.Portrait"
                     SearchText="@SearchText" Results="@Results" Loading="@(!NoSource && Presenter.Loading)" LoadingText="@SearchingText"
                     Busy="@(Presenter.ChoosingSourceId is not null)" Problem="@ProblemText"
                     OnSearch="SearchAsync" OnUse="UseAsync" OnSelect="SelectAsync" OnCancel="CloseAsync">
    <Filters>
        @if (!NoSource && ShowsLanguage)
        {
            @* The one visible language control is the standard app dropdown; no drawn copy of it sits beside it (issue 1002). *@
            <div class="sfv__lang" data-sfv-language>
                <AppNativeSelect Class="sfv__select" Value="@Presenter.Language" OnChange="ChooseLanguageAsync" Disabled="@(Presenter.ChoosingSourceId is not null)" aria-label="@L["SubtitleFind_Language"].Value">
                    @foreach (var language in Presenter.Languages)
                    {
                        <option value="@language">@language</option>
                    }
                </AppNativeSelect>
            </div>
        }
    </Filters>
    <Empty>
        @if (NoSource)
        {
            @ReasonBlock("NoSourceOn", L["SubtitleFind_NoSource"].Value, null)
        }
        else if (Presenter.Failed || Presenter.Response is null)
        {
            @ReasonBlock("Failed", L["SubtitleFind_Failed"].Value, null, tryAgain: true)
        }
        else
        {
            @Reason(Presenter.Response)
        }
    </Empty>
    <AfterResults>
        @if (Results.Count > 0)
        {
            @if (Presenter.Response?.items.FirstOrDefault(item => item.is_current) is { } current)
            {
                <AppButton Class="sfv__wrong" ButtonStyle="AppButtonStyle.Text" Disabled="@(Presenter.ChoosingSourceId is not null)" data-sfv-action="wrong"
                           OnClick="@(() => Presenter.MarkWrongAsync(current))">@L["SubtitleFind_ThisOneIsWrong"]</AppButton>
            }
            <p class="sfv__note" data-sfv-note>@L["SubtitleFind_Applies"]</p>
        }
    </AfterResults>
</AppPickResultDialog>

@code {
    /// <summary>The search state, owned by the player host so it survives the window closing and opening.</summary>
    [Parameter, EditorRequired] public SubtitleFindPresenter Presenter { get; set; } = default!;

    /// <summary>The profile's subtitle settings, for the language the search starts in.</summary>
    [Parameter] public SubtitleLanguageSettingsDto? Profile { get; set; }

    /// <summary>True when the Engine says no subtitle source is switched on (checked without contacting a source); nothing is searched.</summary>
    [Parameter] public bool NoSource { get; set; }

    [Parameter] public bool IsAdministrator { get; set; }

    /// <summary>True for an episode, so the sentences say "episode" and name what an episode search needs.</summary>
    [Parameter] public bool IsEpisode { get; set; }

    /// <summary>What the search box starts with: the title and year ("Ferrari 2023").</summary>
    [Parameter] public string SearchText { get; set; } = string.Empty;

    /// <summary>The video's cover, drawn small on each result (the results are other subtitles for this one video).</summary>
    [Parameter] public string? CoverUrl { get; set; }

    /// <summary>The window was cancelled or a result was used.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    // The Engine's confidence is the source's base score plus how much of the release name matches the file's own, so a high one reads as the same release.
    private const double SameReleaseConfidence = 0.9;

    private Action? _changed;
    private TextTrackAlternativesResponse? _mapped;
    private int _mappedVersion;
    private IReadOnlyList<AppPickResult> _results = [];

    protected override async Task OnInitializedAsync()
    {
        _changed = () => _ = InvokeAsync(StateHasChanged);
        Presenter.Changed += _changed;
        if (!NoSource)
        {
            await Presenter.OpenAsync(Profile, SearchText);
        }
    }

    private IReadOnlyList<AppPickResult> Results
    {
        get
        {
            var response = Presenter.Response is { status: "Found", items.Count: > 0 } found ? found : null;
            if (!ReferenceEquals(_mapped, response) || _mappedVersion != Presenter.PreviewVersion)
            {
                _mapped = response;
                _mappedVersion = Presenter.PreviewVersion;
                var mixedLanguages = response?.items.Select(item => item.language ?? string.Empty).Distinct(StringComparer.OrdinalIgnoreCase).Count() > 1;
                _results = response?.items.Select(item => ToResult(item, mixedLanguages == true)).ToList() ?? [];
            }
            return _results;
        }
    }

    private static string KeyOf(TextTrackAlternativeDto item) => FindAnotherResultMapper.Key(item);

    // Title: the release name. Under it: the language (when the list mixes them) and "Hearing impaired" as plain text, then two checks (made for
    // your file, and once read, whether the timing fits the film) and the first lines (Find another results v2).
    private AppPickResult ToResult(TextTrackAlternativeDto item, bool mixedLanguages)
    {
        var preview = Presenter.PreviewFailedSourceId == item.source_id ? AppPickPreview.Failed
            : Presenter.IsReading(item.source_id) ? AppPickPreview.Reading
            : AppPickPreview.Available;
        return FindAnotherResultMapper.ForSubtitle(item, L, mixedLanguages, LanguageName(item), SameReleaseConfidence, preview);
    }

    // A row that has not been read is read when it is selected (the best match was read with the list).
    private Task SelectAsync(AppPickResult row) =>
        Presenter.Response?.items.FirstOrDefault(item => KeyOf(item) == row.Key) is { } item ? Presenter.PreviewAsync(item) : Task.CompletedTask;

    private string Kind => IsEpisode ? L["SubtitleFind_Episode"].Value : L["SubtitleFind_Movie"].Value;

    // The language choice is no use when the sentence is about a switch, a key, an item that cannot be matched or a profile that may not search.
    private bool ShowsLanguage => Presenter.Loading || Presenter.Failed || Presenter.Response is null
        || Presenter.Response.status is not ("NoSourceOn" or "SourceKeyRequired" or "Blocked" or "NotAllowed" or "IdentityUnverified" or "Unsupported" or "AssetMissing");

    private string SearchingText => Presenter.StillSearching
        ? L["SubtitleFind_StillSearching"].Value
        : Presenter.SourceName is { Length: > 0 } source ? L["SubtitleFind_SearchingSource", source].Value : L["SubtitleFind_Searching"].Value;

    private string? ProblemText => Presenter.FailedSourceId is null
        ? null
        : Presenter.FailedAction == "remove" ? L["SubtitleFind_CouldNotRemove"].Value : L["SubtitleFind_CouldNotDownload"].Value;

    private string LanguageName(TextTrackAlternativeDto item) => DisplayFormat.FormatLanguageName(item.language) ?? Presenter.Language;

    private string SourceOrFallback(TextTrackAlternativesResponse response) =>
        string.IsNullOrWhiteSpace(response.source_name) ? (Presenter.SourceName ?? L["SubtitleFind_SourceFallback"].Value) : response.source_name;

    private Task ChooseLanguageAsync(ChangeEventArgs args) => Presenter.ChangeLanguageAsync(args.Value?.ToString() ?? string.Empty);

    // Search was pressed: the sources are asked again with the box's text (only text the person changed is sent).
    private Task SearchAsync(string text) => NoSource ? Task.CompletedTask : Presenter.SearchTextAsync(text);

    private async Task UseAsync(AppPickResult pick)
    {
        if (Presenter.Response?.items.FirstOrDefault(item => KeyOf(item) == pick.Key) is not { } item)
        {
            return;
        }
        await Presenter.ChooseAsync(item);
        // A download that worked closes the window; one that failed keeps it open with the sentence under the list.
        if (Presenter.Response?.items.Any(other => other.is_current && KeyOf(other) == pick.Key) == true)
        {
            await OnClose.InvokeAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    // One sentence per outcome (follow-ups D11). The status decides; the Engine's own message is never shown.
    private RenderFragment Reason(TextTrackAlternativesResponse response)
    {
        var name = Presenter.Language;
        return response.status switch
        {
            "NoSourceOn" => ReasonBlock(response.status, L["SubtitleFind_NoSource"].Value, null),
            "SourceKeyRequired" => ReasonBlock(response.status, L["SubtitleFind_KeyRefused", SourceOrFallback(response)].Value, null),
            "IdentityUnverified" => ReasonBlock(response.status, L["SubtitleFind_Unmatched", Kind].Value,
                IsEpisode ? L["SubtitleFind_UnmatchedEpisodeHint"].Value : L["SubtitleFind_UnmatchedMovieHint"].Value),
            "LimitReached" => ReasonBlock(response.status, L["SubtitleFind_Limit", SourceOrFallback(response)].Value, null),
            "Unavailable" => ReasonBlock(response.status, L["SubtitleFind_Unreachable", SourceOrFallback(response)].Value, null, tryAgain: true),
            "Blocked" => ReasonBlock(response.status, L["SubtitleFind_Blocked"].Value, null),
            "NotAllowed" => ReasonBlock(response.status, L["SubtitleFind_NotAllowed"].Value, null),
            "LanguageUnknown" => ReasonBlock(response.status, L["SubtitleFind_LanguageUnknown"].Value, null),
            "TextSearchUnsupported" => ReasonBlock(response.status, L["SubtitleFind_TextSearchUnsupported", SourceOrFallback(response)].Value,
                L["SubtitleFind_TextSearchUnsupportedHint", Kind].Value),
            "NoneFound" or "Found" => ReasonBlock("NoneFound", L["SubtitleFind_NoneFound", name, Kind].Value, L["SubtitleFind_NoneFoundHint"].Value),
            _ => ReasonBlock(response.status, L["SubtitleFind_Failed"].Value, null, tryAgain: true),
        };
    }

    private RenderFragment ReasonBlock(string state, string headline, string? detail, bool tryAgain = false) =>
        @<div class="sfv__why-wrap">
            <p class="sfv__why" role="status" data-subtitles-state="@state">
                <b>@headline</b>
                @if (!string.IsNullOrWhiteSpace(detail)) { <span>@detail</span> }
            </p>
            @if (tryAgain)
            {
                <AppButton Label="@L["SubtitleFind_TryAgain"].Value" data-sfv-action="retry" OnClick="Presenter.SearchAsync" />
            }
            @if (IsAdministrator && state is "NoSourceOn" or "SourceKeyRequired")
            {
                <a class="sfv__plugins" href="/settings/plugins" data-sfv-plugins>@L["PlayerSettings_Plugins"]</a>
            }
        </div>;

    public void Dispose()
    {
        if (_changed is not null)
        {
            Presenter.Changed -= _changed;
        }
    }
}
