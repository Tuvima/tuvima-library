@namespace MediaEngine.Web.Components.Player
@using MediaEngine.Web.Services.Playback
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IServiceProvider Services
@inject IStringLocalizer<SharedStrings> L

@* Unified player v2 D11: the one panel system. A trigger button plus a panel drawn in the browser top layer (playback-popover.js moves it into the
   fullscreen element when there is one, places it above the bar, right-aligned to the tools zone, and keeps it 12 px inside the viewport).
   Menu (272 wide) and Panel (360 to 420 wide, at most 80% of the player's height) are the two sizes; Wide (560) is Panel for Audio & subtitles.
   Content learns it is drawn as a phone bottom sheet from the cascading value "PlaybackPanelSheet" (Audio & subtitles becomes two tabs there).
   Header (back, title, close) and footer are fixed; only the body scrolls. There is no arrow and nothing opens on hover. The open state has one
   owner, PlaybackTransientToolCoordinator, so exactly one top-level panel is open at a time. Phones draw the same panel as a bottom sheet. *@
<span @ref="_root" class="playback-popover-owner" data-playback-popover-kind="@Kind" data-playback-popover-surface="@Surface" data-chrome-hold>
    @if (TriggerContent is not null)
    {
        <AppTooltip Text="@(TriggerLabel ?? Title)" Suppressed="@IsOpen">
            <AppNativeButton @ref="_triggerButton" Class="@($"playback-popover-trigger {TriggerClass}")" AriaLabel="@(TriggerLabel ?? Title)" Disabled="@Disabled"
                             aria-haspopup="dialog" aria-expanded="@(IsOpen ? "true" : "false")" aria-controls="@PanelId">
                @TriggerContent
            </AppNativeButton>
        </AppTooltip>
    }
    @if (_renderOpen)
    {
        <div @ref="_panel" id="@PanelId" popover="manual" class="@PanelClass" data-playback-popover-panel data-playback-popover-surface="@Surface"
             data-playback-owned-menu="@ParentPanel" data-chrome-hold tabindex="-1">
            <CascadingValue Name="PlaybackPopoverOwner" Value="@PanelId">
                <CascadingValue Value="@Navigator" IsFixed="true">
                <CascadingValue Name="PlaybackPanelSheet" Value="@_mobile">
                    @if (_mobile)
                    {
                        <div class="playback-panel__backdrop" data-playback-popover-backdrop></div>
                        <PlaybackToolSheet Title="@CurrentTitle" Surface="@Surface" Presentation="full-overlay" Modal="true" Class="@SheetClass"
                                           OnClose="CloseAsync" OnBack="@SheetBack" Footer="@CurrentFooter"
                                           TitleAdornment="@(Navigator.Depth == 0 ? TitleAdornment : null)" HeaderActions="@(Navigator.Depth == 0 ? HeaderActions : null)">
                            @CurrentBody
                        </PlaybackToolSheet>
                    }
                    else
                    {
                        <AppPopout Class="playback-panel__frame" Role="dialog" AriaLabel="@Title">
                            @if (ShowHeader)
                            {
                                <header class="playback-panel__header">
                                    @if (Navigator.Depth > 0 || OnBack.HasDelegate)
                                    {
                                        @HeaderButton(PlaybackUtilityGlyphKind.Back, L["Common_Back"].Value, "playback-panel__icon-button playback-panel__back", EventCallback.Factory.Create(this, BackAsync))
                                    }
                                    @if (TitleAdornment is not null && Navigator.Depth == 0)
                                    {
                                        <div class="playback-panel__heading">
                                            <h2 class="playback-panel__title">@CurrentTitle@if (!string.IsNullOrWhiteSpace(Subtitle) && Navigator.Depth == 0) { <span class="playback-panel__subtitle">@Subtitle</span> }</h2>
                                            @TitleAdornment
                                        </div>
                                    }
                                    else
                                    {
                                        <h2 class="playback-panel__title">@CurrentTitle@if (!string.IsNullOrWhiteSpace(Subtitle) && Navigator.Depth == 0) { <span class="playback-panel__subtitle">@Subtitle</span> }</h2>
                                    }
                                    @if (HeaderActions is not null && Navigator.Depth == 0)
                                    {
                                        @HeaderActions
                                    }
                                    @HeaderButton(PlaybackUtilityGlyphKind.Close, $"Close {Title}", "playback-panel__icon-button playback-panel__close", EventCallback.Factory.Create(this, CloseAsync))
                                </header>
                            }
                            else if (!string.IsNullOrWhiteSpace(HeaderLine))
                            {
                                <div class="playback-panel__header-line">@HeaderLine</div>
                            }
                            else if (Kind == "lyrics")
                            {
                                @HeaderButton(PlaybackUtilityGlyphKind.Close, $"Close {Title}", "playback-panel__icon-button playback-panel__dismiss", EventCallback.Factory.Create(this, CloseAsync))
                            }
                            <div @key="Navigator.Depth" class="@($"playback-panel__body {BodyClass}".Trim())" data-playback-panel-body>@CurrentBody</div>
                            @if (CurrentFooter is not null)
                            {
                                <footer class="playback-panel__footer">@CurrentFooter</footer>
                            }
                        </AppPopout>
                    }
                </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </div>
    }
</span>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "Playback tools";
    [CascadingParameter(Name = "PlaybackPopoverOwner")] public string? ParentPanel { get; set; }
    [Parameter] public string? ToolId { get; set; }

    /// <summary>What the panel holds ("lyrics", "video", "menu", "speed", "settings", "queue", "episodes", "chapters" or ordinary). Also picks the default <see cref="Size"/>.</summary>
    [Parameter] public string Kind { get; set; } = "ordinary";

    /// <summary>"menu" (272 px, 44 px rows), "panel" (360 to 420 px) or "wide" (560 px, Audio &amp; subtitles). Defaults from <see cref="Kind"/>.</summary>
    [Parameter] public string? Size { get; set; }

    /// <summary>"panel", "dock", "phone", "expanded", "popup" or "video". Over video the surface is the same color at 96% opacity.</summary>
    [Parameter] public string Surface { get; set; } = "panel";
    [Parameter] public string? TriggerClass { get; set; }

    /// <summary>The trigger's accessible name and tooltip when they differ from the panel's title (the Speed chip is named "Playback speed 1.25×" so its visible text is in its name).</summary>
    [Parameter] public string? TriggerLabel { get; set; }

    /// <summary>The small line under the header title on the panel's main view (Episodes names its show there).</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>True draws the fixed header (back, title, close). False leaves the heading to the content (menus, and panels not rebuilt yet).</summary>
    [Parameter] public bool ShowHeading { get; set; } = true;

    /// <summary>The small line above a menu's rows (the item's name).</summary>
    [Parameter] public string? HeaderLine { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? ItemKey { get; set; }
    [Parameter] public ElementReference? Trigger { get; set; }
    [Parameter] public RenderFragment? TriggerContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Small content that sits right after the title in the header of the main view (the Lyrics panel's Synced chip).</summary>
    [Parameter] public RenderFragment? TitleAdornment { get; set; }

    /// <summary>Icon buttons the header draws before Close on the main view (the Lyrics panel's Open Now playing).</summary>
    [Parameter] public RenderFragment? HeaderActions { get; set; }

    /// <summary>The fixed footer actions. Only the body between header and footer scrolls.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>Shows a back arrow in the header and runs this when it is used (a panel that drives its own nested view).</summary>
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public bool? Open { get; set; }

    /// <summary>The nested views of this panel; content reaches it as a cascading value.</summary>
    public PlaybackPanelNavigator Navigator { get; } = new();

    private bool? _lastControlledOpen;
    private readonly string _instanceId = $"playback-tool-{Guid.NewGuid():N}";
    private string PanelId => $"{_instanceId}-panel";
    private string EffectiveToolId => ToolId ?? _instanceId;
    private string EffectiveSize => Size is "menu" or "panel" or "wide" ? Size : Kind == "menu" ? "menu" : "panel";
    private string PanelClass => $"playback-panel playback-panel--{EffectiveSize} playback-panel--{(Kind is "lyrics" or "video" or "menu" or "speed" or "sleep" or "settings" or "queue" or "episodes" or "chapters" or "bookmarks" ? Kind : "ordinary")}{(_mobile ? " playback-panel--sheet" : "")}";
    private string BodyClass => string.Join(" ", new[] { EffectiveSize == "menu" ? "playback-panel__body--menu" : null, !ShowHeading && EffectiveSize != "menu" && Kind != "settings" ? "playback-panel__body--padded" : null, Navigator.Depth > 0 ? "playback-panel__body--nested" : null }.Where(value => value is not null));
    private string SheetClass => Kind == "lyrics" ? "playback-tool-sheet--framed playback-tool-sheet--lyrics" : "playback-tool-sheet--framed";
    private bool ShowHeader => ShowHeading && EffectiveSize != "menu";
    private string CurrentTitle => Navigator.Current?.Title ?? Title;
    private RenderFragment? CurrentBody => Navigator.Current?.Body ?? ChildContent;
    private RenderFragment? CurrentFooter => Navigator.Current is { } view ? view.Footer : Footer;
    private RenderFragment HeaderButton(PlaybackUtilityGlyphKind glyph, string label, string cssClass, EventCallback onClick) =>
        @<AppTooltip Text="@label">
            <AppNativeButton Type="button" Class="@cssClass" AriaLabel="@label" OnClick="onClick">
                <PlaybackUtilityGlyph Glyph="glyph" />
            </AppNativeButton>
        </AppTooltip>;
    private EventCallback SheetBack => Navigator.Depth > 0 || OnBack.HasDelegate ? EventCallback.Factory.Create(this, BackAsync) : default;
    private bool IsOpen => _tools?.IsOpen(EffectiveToolId) == true;
    private ElementReference _root, _panel;
    private AppNativeButton? _triggerButton;
    public ElementReference? TriggerElement => Trigger ?? _triggerButton?.Element;
    private PlaybackTransientToolCoordinator? _tools;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PlaybackPanel>? _reference;
    private string? _lastItemKey;
    private bool _mobile, _reportedOpen, _renderOpen, _disposed;
    private int _pendingNavigation, _lastDepth;
    private readonly SemaphoreSlim _lifecycle = new(1, 1);

    protected override void OnInitialized()
    {
        _tools = Services.GetService<PlaybackTransientToolCoordinator>() ?? new();
        _tools.RegisterPanel(PanelId, EffectiveToolId);
        _tools.Changed += ToolChanged;
        Navigator.Changed += NavigatorChanged;
        _lastItemKey = ItemKey;
    }

    protected override void OnParametersSet()
    {
        if (Open != _lastControlledOpen)
        {
            _lastControlledOpen = Open;
            // A controlled Open that only echoes this panel's own report must not open it a second time.
            if (Open == true && !Disabled && !IsOpen) _tools?.Open(EffectiveToolId, pinned: true, parentPanel: ParentPanel);
            else if (Open == false && !_reportedOpen) _tools?.Close(EffectiveToolId);
        }
        if (_lastItemKey == ItemKey) return;
        _lastItemKey = ItemKey;
        _tools?.Close(EffectiveToolId);
    }

    // Opening or leaving a nested view removes the control that had focus; after the next draw focus goes into the new view, or back to the control that opened it.
    private void NavigatorChanged()
    {
        var depth = Navigator.Depth;
        if (IsOpen) _pendingNavigation = depth > _lastDepth ? 1 : -1;
        _lastDepth = depth;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToolChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () => {
            await _lifecycle.WaitAsync();
            try
            {
                if (_disposed) return;
                if (!IsOpen)
                {
                    await ReleasePanelAsync();
                    Navigator.Reset();
                }
                _renderOpen = IsOpen;
                if (_reportedOpen != IsOpen) { _reportedOpen = IsOpen; await OpenChanged.InvokeAsync(IsOpen); }
                StateHasChanged();
            }
            finally { _lifecycle.Release(); }
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        await _lifecycle.WaitAsync();
        try
        {
            if (_disposed) return;
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-popover.js");
            if (_module is null) return;
            _reference ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _root, Trigger, _reference);
            await _module.InvokeVoidAsync("update", _root, IsOpen ? _panel : null, IsOpen);
            if (_pendingNavigation != 0)
            {
                var push = _pendingNavigation > 0;
                _pendingNavigation = 0;
                if (IsOpen) await _module.InvokeVoidAsync("navigated", _root, _panel, push);
            }
        }
        catch (InvalidOperationException) { }
        catch (JSDisconnectedException) { }
        finally { _lifecycle.Release(); }
    }

    private async Task ReleasePanelAsync(bool restoreFocus = false)
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("update", _root, null, false, restoreFocus); }
        catch (JSDisconnectedException) { }
    }

    [JSInvokable] public async Task SetViewport(bool mobile)
    {
        if (_mobile == mobile || _disposed) return;
        await _lifecycle.WaitAsync();
        try
        {
            if (_disposed) return;
            await ReleasePanelAsync();
            _mobile = mobile;
            await InvokeAsync(StateHasChanged);
        }
        finally { _lifecycle.Release(); }
    }

    /// <summary>Opens this panel; any other top-level panel closes. The flag is kept for callers: a panel is only ever opened by an explicit action, so it is always pinned.</summary>
    [JSInvokable] public Task OpenAsync(bool pinned = true)
    {
        if (!_disposed && !Disabled) _tools?.Open(EffectiveToolId, pinned: true, ParentPanel);
        return Task.CompletedTask;
    }

    public Task CloseAsync() => ClosePanelAsync(restoreFocus: true);
    [JSInvokable] public Task CloseFromBrowserAsync(bool restoreFocus) => ClosePanelAsync(restoreFocus);

    private async Task BackAsync()
    {
        if (!Navigator.Pop()) await OnBack.InvokeAsync();
    }

    private async Task ClosePanelAsync(bool restoreFocus)
    {
        await _lifecycle.WaitAsync();
        try
        {
            if (_disposed) return;
            // Restore a portaled panel before Blazor removes its conditional node.
            await ReleasePanelAsync(restoreFocus);
            _tools?.Close(EffectiveToolId);
            _renderOpen = false;
        }
        finally { _lifecycle.Release(); }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Navigator.Changed -= NavigatorChanged;
        if (_tools is not null) { _tools.Changed -= ToolChanged; _tools.Close(EffectiveToolId); _tools.UnregisterPanel(PanelId); }
        await _lifecycle.WaitAsync();
        try
        {
            if (_module is not null)
            {
                try { await _module.InvokeVoidAsync("detach", _root); await _module.DisposeAsync(); }
                catch (JSDisconnectedException) { }
            }
            _reference?.Dispose();
        }
        finally { _lifecycle.Release(); }
    }
}
