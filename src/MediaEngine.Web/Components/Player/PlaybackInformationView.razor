@namespace MediaEngine.Web.Components.Player
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Services.Playback
@implements IAsyncDisposable
@inject IStringLocalizer<SharedStrings> L
@inject IJSRuntime JS
@inject ILogger<PlaybackInformationView> Logger

@* The Playback information view of Playback settings (video-player follow-ups D13): sections (File, Video, Audio, Subtitles, How it is playing), each a
   muted 12 px heading over label-and-value lines (mockup .kvh and .kv, 15 px). Read-only; a line with nothing to say is left out. When the player holds no
   manifest for what is playing, the view asks for it ("Loading details…") instead of staying blank. The buffer and the browser's own name come from the
   browser (playback-information.js); the buffer is read once a second while the view is open. *@
<div class="piv" data-playback-information>
    @if (_sections.Count == 0)
    {
        <p class="piv__empty" role="status" data-info-empty="@(_loading ? "loading" : "none")">@(_loading ? L["PlaybackInformation_Loading"] : L["PlaybackInformation_None"])</p>
    }
    else
    {
        @foreach (var section in _sections)
        {
            <section class="piv__section" data-info-section="@section.Key">
                <h3 class="piv__heading">@section.Heading</h3>
                <dl class="piv__list">
                    @foreach (var row in section.Rows)
                    {
                        <div class="piv__row" data-info-row="@row.Key">
                            <dt>@row.Label</dt>
                            <dd>@row.Value</dd>
                        </div>
                    }
                </dl>
            </section>
        }
    }
</div>

@code {
    /// <summary>The manifest the player holds for what is playing; when it is null the view asks <see cref="LoadManifest"/>.</summary>
    [Parameter] public PlaybackManifestDto? Manifest { get; set; }

    /// <summary>Video shows the Video and Subtitles sections; music and audiobooks show File, Audio and How it is playing.</summary>
    [Parameter] public bool Video { get; set; }

    /// <summary>The audio track in use (its manifest index); the default track when not told.</summary>
    [Parameter] public int? AudioTrackIndex { get; set; }

    /// <summary>The subtitle track showing and where it came from; the Subtitles section is left out when not told.</summary>
    [Parameter] public PlaybackInformationSubtitle? Subtitle { get; set; }

    /// <summary>The id of the playing video or audio element, for the buffer line.</summary>
    [Parameter] public string? ElementId { get; set; }

    /// <summary>Fetches the manifest of what is playing when the player holds none.</summary>
    [Parameter] public Func<CancellationToken, Task<PlaybackManifestDto?>>? LoadManifest { get; set; }

    /// <summary>Receives the lines on screen so the footer's Copy details copies the same text.</summary>
    [Parameter] public PlaybackInformationState? State { get; set; }

    private IReadOnlyList<PlaybackInformationSection> _sections = [];
    private PlaybackManifestDto? _loaded;
    private bool _loading, _disposed;
    private int? _bufferAhead;
    private string? _clientName;
    private IJSObjectReference? _module;
    private readonly CancellationTokenSource _closed = new();

    private PlaybackManifestDto? EffectiveManifest => Manifest ?? _loaded;

    protected override void OnInitialized()
    {
        if (Manifest is null && LoadManifest is not null)
        {
            _loading = true;
            _ = LoadAsync();
        }
    }

    protected override void OnParametersSet()
    {
        if (Manifest is not null)
        {
            _loading = false;
        }

        Recompute();
    }

    private async Task LoadAsync()
    {
        PlaybackManifestDto? manifest = null;
        try
        {
            manifest = await LoadManifest!(_closed.Token);
        }
        catch (OperationCanceledException)
        {
            // The view closed before the Engine answered; nobody is waiting for the lines.
            return;
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Playback information could not load the manifest of what is playing.");
        }

        await InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            _loaded = manifest;
            _loading = false;
            Recompute();
            StateHasChanged();
        });
    }

    private void Recompute()
    {
        _sections = PlaybackInformationRows.Build(L, EffectiveManifest, Video, new(AudioTrackIndex, Subtitle, _bufferAhead, _clientName));
        State?.Update(_sections);
    }

    // The browser is asked once for its own name and then, about once a second, how much picture is buffered ahead. A page without a browser yet
    // (prerendering) simply has neither line.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-information.js");
            _clientName = await _module.InvokeAsync<string?>("clientName");
            await RefreshBufferAsync();
        }
        catch (InvalidOperationException)
        {
            // Prerendering has no browser yet; the lines that come from the file are enough.
            return;
        }
        catch (JSDisconnectedException)
        {
            // The circuit closed while the view was opening; there is nothing left to draw on.
            return;
        }
        catch (JSException exception)
        {
            Logger.LogDebug(exception, "Playback information could not read the browser's name or buffer.");
            return;
        }

        if (_disposed)
        {
            return;
        }

        Recompute();
        StateHasChanged();
        _ = PollBufferAsync(_closed.Token);
    }

    private async Task PollBufferAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                var before = _bufferAhead;
                await RefreshBufferAsync();
                if (before != _bufferAhead)
                {
                    await InvokeAsync(() =>
                    {
                        if (_disposed)
                        {
                            return;
                        }

                        Recompute();
                        StateHasChanged();
                    });
                }
            }
        }
        catch (OperationCanceledException)
        {
            // The view closed; the reading stops with it.
        }
        catch (JSDisconnectedException)
        {
            // The circuit closed, so the browser is gone and there is nothing left to read.
        }
        catch (JSException exception)
        {
            Logger.LogDebug(exception, "Playback information stopped reading the buffer.");
        }
    }

    private async Task RefreshBufferAsync()
    {
        _bufferAhead = _module is null || string.IsNullOrWhiteSpace(ElementId)
            ? null
            : await _module.InvokeAsync<int?>("bufferAhead", ElementId);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _closed.Cancel();
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone, so the browser dropped the module with the page.
        }
    }
}
