    {
        Tools.Close();
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>Applies a subtitle styling choice to the playing video at once, then saves it on the profile.</summary>
    private async Task ChangeSubtitleStyleAsync(Action<SubtitleLanguageSettingsDto> change)
    {
        _profileSubtitles ??= new SubtitleLanguageSettingsDto();
        change(_profileSubtitles);
        await InvokeAsync(StateHasChanged);
        var preferences = Services.GetService<PlayerPreferenceService>();
        if (preferences is null) return;
        try { await preferences.UpdateAsync(settings => change(settings.Subtitles), _lifetimeCancellation.Token); }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Logger.LogWarning(ex, "The subtitle styling choice could not be saved."); }
    }

    private async Task HandleVideoKeyDown(KeyboardEventArgs args)
    {
        if (await JS.InvokeAsync<bool>("playbackTools.isEditableFocus")) return;
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            CloseToolSheet();
        }
        else if (args.Key is " " or "k" or "K") await TogglePlayPauseAsync();
        else if (args.Key == "ArrowLeft") await SkipBackAsync();
        else if (args.Key == "ArrowRight") await SkipForwardAsync();
        else if (args.Key.Equals("m", StringComparison.OrdinalIgnoreCase)) await ToggleMuteAsync();
        else if (args.Key.Equals("f", StringComparison.OrdinalIgnoreCase)) await ToggleFullscreenAsync();
    }

    private Task RetryPreparationAsync() => Playback.RetryPreparationAsync(_lifetimeCancellation.Token);

    private async Task ClosePlayerAsync()
    {
        if (!Playback.HasQueue || !Playback.IsVideoMode) return;
        var capturedProfile = Playback.ActiveProfileId;
        var capturedAsset = Playback.CurrentItem?.AssetId;
        var capturedRequest = Playback.PlaybackRequestVersion;
        var workId = Playback.CurrentItem?.WorkId;
        bool IsCurrentClose() => Playback.IsVideoMode && Playback.CurrentItem?.AssetId == capturedAsset
            && Playback.CurrentItem?.WorkId == workId && Playback.PlaybackRequestVersion == capturedRequest && Playback.ActiveProfileId == capturedProfile;
        // A receiver that is playing this title is let go first, so the element being released is the browser's own again (unified player v2 D28).
        if (Services.GetService(typeof(PlaybackRemoteController)) is PlaybackRemoteController remote)
        {
            await remote.EndAsync();
            if (!IsCurrentClose()) return;
        }
        // Close may be pressed before the owned episode metadata has arrived.
        // Wait for that identity's existing read so its show-scoped destination is retained.
        if (VideoPresentationResolver.HasOwnedSequence(Playback.CurrentItem) && _presentationResolution is { } resolution)
        {
            await resolution;
            if (!IsCurrentClose()) return;
        }
        var detailUrl = _presentationContext is { ShowWorkId: Guid showId } context && context.Identity.IsCurrent(Playback)
            && workId is Guid episodeId
            ? TvEpisodeDetailRoute.Build(showId, episodeId, "watch")
            : workId is Guid id && id != Guid.Empty ? $"/details/work/{id}?context=watch" : "/watch";
        var native = await JS.InvokeAsync<VideoMetrics>("listenPlayback.readAudioState", _videoRef);
        if (!IsCurrentClose()) return;
        if (native is not null && native.RequestVersion == capturedRequest && Guid.TryParse(native.AssetId, out var nativeAsset) && nativeAsset == capturedAsset)
            Playback.UpdateTransportState(currentTimeSeconds: native.CurrentTime, durationSeconds: native.Duration, isPlaying: false);
        else
            Playback.UpdateTransportState(isPlaying: false);
        await Playback.ReportHeartbeatAsync(force: true);
        if (!IsCurrentClose()) return;
        if (!await JS.InvokeAsync<bool>("listenPlayback.releaseMedia", _videoRef, capturedAsset, capturedRequest) || !IsCurrentClose()) return;
        if (Playback.CurrentItem?.AssetId is Guid assetId)
        {
            Activity.ClearVideoPlayback(assetId);
        }
        _activeAssetId = null;
        _isPictureInPicture = false;
        Playback.ClosePlayer();
        // Back over the page the title was opened from, so closing the title afterwards returns there instead of to the (now empty) player address.
        await DetailsOverlayNavigation.ExitToTitleAsync(Nav, Services.GetService(typeof(DetailsOverlayState)) as DetailsOverlayState, detailUrl);
    }

    private string? AbsoluteUrl(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : ApiClient.ToAbsoluteEngineUrl(value);

    private string? SubtitleUrl(PlaybackSubtitleTrackDto track) =>
        !string.IsNullOrWhiteSpace(track.DeliveryUrl) && Playback.CurrentItem?.AssetId is { } assetId
            ? $"/engine-subtitles/{assetId:D}?language={Uri.EscapeDataString(track.Language ?? "en")}" : null;

    private static string SubtitleLabel(PlaybackSubtitleTrackDto track)
        => StringHelpers.FirstNonBlankOr(
            "Subtitles",
            track.DisplayName,
            track.Language?.ToUpperInvariant(),
            "Subtitles");

    private static string SkipLabel(string kind) => kind.ToLowerInvariant() switch
    {
        "intro" => "Skip Intro",
        "commercial" => "Skip Commercial",
        "credits" => "Skip Credits",
        "recap" => "Skip Recap",
        "post_credits" => "Skip Post-Credits",
        _ => "Skip Segment",
    };
    private static string SegmentDescription(string kind) => kind.ToLowerInvariant() switch
    {
        "intro" => "Intro", "recap" => "Recap", "credits" => "Credits", "commercial" => "Commercial",
        "post_credits" => "Post-credits", _ => "Segment",
    };

    private static string FormatTimestamp(double seconds)
    {
        var span = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return span.TotalHours >= 1
            ? span.ToString(@"h\:mm\:ss", CultureInfo.InvariantCulture)
            : span.ToString(@"m\:ss", CultureInfo.InvariantCulture);
    }


    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _find?.Dispose();
        _lifetimeCancellation.Cancel();
        _newBookmarkCancellation?.Cancel();
        _metadataCancellation?.Cancel(); _metadataCancellation?.Dispose();
        Tools.Changed -= HandleToolsChanged;
        if (_deviceContext is not null) _deviceContext.OnChanged -= HandleDeviceContextChanged;
        Playback.Changed -= HandlePlaybackChanged;
        Playback.PlaybackRequestChanged -= HandleRequestChanged;
        Playback.TransportCommandRequested -= HandleTransportCommandAsync;
        Nav.LocationChanged -= HandleLocationChanged;
        await ReleaseBrowserClientAsync();
        _lifetimeCancellation.Dispose();
    }

    // Safe to call more than once and before the browser client was ever registered.
    private async Task ReleaseBrowserClientAsync()
    {
        if (_observerRegistered)
        {
            _observerRegistered = false;
            try
            {
                await JS.InvokeVoidAsync("listenPlayback.unregisterAudioStateObserver", _videoRef);
            }
            catch (JSDisconnectedException)
            {
                // The browser connection is gone, so the observer went with it.
            }
            catch (Exception ex) when (ex is InvalidOperationException or ObjectDisposedException or JSException or TaskCanceledException)
            {
                Logger.LogDebug(ex, "Could not unregister the video playback observer.");
            }
        }

        var chrome = _chromeModule;
        var presentation = _presentationModule;
        var touch = _touchModule;
        var mediaSession = _mediaSessionModule;
        _chromeModule = null;
        _presentationModule = null;
        _touchModule = null;
        _mediaSessionModule = null;
        _mediaSessionSubject = null;
        foreach (var (module, detach, element) in new[] { (chrome, "detach", _hostRef), (presentation, "detach", _hostRef),
            (touch, "detach", _hostRef), (mediaSession, "detachVideo", _videoRef) })
        {
            if (module is null) continue;
            try { await module.InvokeVoidAsync(detach, element); await module.DisposeAsync(); }
            catch (JSDisconnectedException)
            {
                // The browser connection is gone, so the module is already released.
            }
            catch (Exception ex) when (ex is ObjectDisposedException or JSException or TaskCanceledException)
            {
                Logger.LogDebug(ex, "Could not detach a video playback module.");
            }
        }
        _selfReference?.Dispose();
        _selfReference = null;
    }

    public sealed class VideoMetrics
    {
        public long? RequestVersion { get; set; }
        public double CurrentTime { get; set; }
        public string AssetId { get; set; } = string.Empty;
        public int SubtitleCount { get; set; }
        public List<CaptionTrackMetric> CaptionTracks { get; set; } = [];
        public int AudioTrackCount { get; set; }
        public double Duration { get; set; }
        public double Volume { get; set; }
        public bool Muted { get; set; }
        public bool Paused { get; set; }
        public double PlaybackRate { get; set; } = 1d;
    }

    public sealed record CaptionTrackMetric
    {
        public string Key { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string Language { get; set; } = string.Empty;
        public bool Selected { get; set; }
        public int? HlsIndex { get; set; }
    }
