    private async Task ApplyProfileAudioDefaultAsync()
    {
        // Once per playback, and never over a track the viewer already picked in the Audio sheet.
        if (_profileSubtitles is null || _selectedAudioTrackIndex is not null || !CanSwitchAudio
            || _profileAudioAppliedFor == VideoInstanceKey) return;
        _profileAudioAppliedFor = VideoInstanceKey;
        var identity = VideoPlaybackIdentity.Capture(Playback);
        var wanted = TrackDefaults.AudioTrackIndex;
        var defaultIndex = Math.Max(0, AudioTracks.ToList().FindIndex(track => track.IsDefault));
        if (identity is null || wanted is not int index || index == defaultIndex) return;
        if (await JS.InvokeAsync<bool>("listenPlayback.selectAudioTrack", _videoRef, index) && identity.IsCurrent(Playback) && _selectedAudioTrackIndex is null)
        {
            _selectedAudioTrackIndex = index;
            await InvokeAsync(StateHasChanged);
        }
    }
    private async Task ResolvePresentationAsync(VideoPlaybackIdentity identity, CancellationToken ct)
    {
        try
        {
            var context = await Presentation.ResolveAsync(identity, ct);
            if (_disposed || ct.IsCancellationRequested || !identity.IsCurrent(Playback)) return;
            _presentationContext = context;
            await InvokeAsync(StateHasChanged);
