    private async Task RestoreVideoAsync()
    {
        if (!Playback.HasQueue || !Playback.IsVideoMode) return;
        await JS.InvokeVoidAsync("listenPlayback.exitPictureInPicture");
        _continuationStatus = null;
        Playback.SetVideoExpanded(true);
    }

    private void CloseToolSheet() => Tools.Close();

    // Audio & subtitles (follow-ups D12). Whether a subtitle source is switched on is asked once per video, the first time the panel opens, from the
    // Engine's settings alone: no source is contacted and no search runs until Find subtitles opens.
    private bool _noSubtitleSource;
    private Guid? _subtitleSourceProbedFor;

    private async Task HandleSettingsOpenChangedAsync(bool open)
    {
        if (!open || Playback.CurrentItem?.AssetId is not Guid assetId || _subtitleSourceProbedFor == assetId) return;
        _subtitleSourceProbedFor = assetId;
        Find.Bind(assetId);
        var identity = VideoPlaybackIdentity.Capture(Playback);
        try
        {
            var result = await ApiClient.GetTextTrackSourcesAsync(assetId, "subtitles", _lifetimeCancellation.Token);
            if (_disposed || identity is not null && !identity.IsCurrent(Playback)) return;
            _noSubtitleSource = string.Equals(result?.status, "NoSourceOn", StringComparison.OrdinalIgnoreCase);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Logger.LogDebug(ex, "Whether a subtitle source is switched on could not be checked."); }
    }

