    private void HandleToolsChanged() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private void HandleRequestChanged()
    {
        if (!_disposed) _ = InvokeAsync(() => { ObservePresentationIdentity(); ObserveEndCard(); StateHasChanged(); });
    }
    private void ObservePresentationIdentity()
    {
        var identity = VideoPlaybackIdentity.Capture(Playback);
        if (_observedIdentity == identity) return;
        _observedIdentity = identity;
        _metadataCancellation?.Cancel(); _metadataCancellation?.Dispose();
        _metadataCancellation = null;
        _presentationContext = null;
        _loadedSubtitleAssetId = null;
        _managedSubtitleTracks = []; _captionTracks = []; _selectedCaptionKey = null;
        _selectedAudioTrackIndex = null; _pendingAudioIndex = null; _switchingAudio = false; _trackNotice = null;
        _find?.Bind(identity?.AssetId);
        _profileAudioAppliedFor = null;
        _savedRail = [];
        _railSaved = [];
        ClearNewBookmark();
        if (identity?.ProfileId != _profileSubtitlesProfile) { _profileSubtitles = null; _profileSettings = null; _profileSubtitlesProfile = identity?.ProfileId; }
        Tools.Close();
        if (identity is null) return;
        var request = _metadataCancellation = new();
        _presentationResolution = ResolvePresentationAsync(identity, request.Token);
        _profileSubtitlesLoad = LoadProfileSubtitlesAsync(identity, request.Token);
        _railBookmarksLoad = LoadRailBookmarksAsync(identity, request.Token);
    }

    private async Task LoadRailBookmarksAsync(VideoPlaybackIdentity identity, CancellationToken ct)
    {
        try
        {
            var result = await ApiClient.GetAudiobookBookmarksWithOutcomeAsync(identity.WorkId, identity.ProfileId, ct);
            if (_disposed || ct.IsCancellationRequested || !identity.IsCurrent(Playback)) return;
            if (result is { Outcome: AudiobookBookmarkOperationOutcome.Success, Value: { } saved })
            {
                _railSaved = saved.Where(bookmark => bookmark.AssetId == identity.AssetId).ToList();
                RebuildRail();
            }
        }
        catch (OperationCanceledException)
        {
            // The video changed or the player closed while the list was loading; the next video loads its own.
            Logger.LogDebug("Loading the bookmark ticks was cancelled.");
        }
    }

    private void RebuildRail()
    {
        _savedRail = PlaybackRailBookmark.From(_railSaved, Playback.DurationSeconds);
        if (!_disposed) _ = InvokeAsync(StateHasChanged);
    }

    private Task HandleBookmarksSaved(IReadOnlyList<AudiobookBookmarkDto> saved)
    {
        if (Playback.CurrentItem?.AssetId is Guid assetId)
        {
            _railSaved = saved.Where(bookmark => bookmark.AssetId == assetId).ToList();
            RebuildRail();
        }

        return Task.CompletedTask;
    }

    /// <summary>Goes to a bookmark's time (preview, Replay or Jump) and plays from there.</summary>
    private async Task JumpToBookmarkAsync(double seconds, bool play)
    {
        await SeekOnHostAsync(seconds);
        if (play && !Playback.IsPlaying) await TogglePlayPauseAsync();
    }

    private string? _bookmarkNotice;
    private CancellationTokenSource? _noticeCancellation;

    /// <summary>Saves a personal bookmark at the given time (one click in the panel, or the B key). True when saved.</summary>
    private async Task<bool> AddBookmarkAsync(double seconds, string? note)
    {
        if (Playback.CurrentItem is not { WorkId: var workId, AssetId: Guid assetId } || workId == Guid.Empty) return false;
        var profileId = Playback.ActiveProfileId ?? Guid.Empty;
        var result = await ApiClient.CreateAudiobookBookmarkWithOutcomeAsync(workId, new CreateAudiobookBookmarkRequestDto
        {
            ProfileId = profileId == Guid.Empty ? null : profileId,
            AssetId = assetId,
            PositionSeconds = Math.Max(0, seconds),
            DurationSeconds = Playback.DurationSeconds > 0 ? Playback.DurationSeconds : null,
            Note = string.IsNullOrWhiteSpace(note) ? null : note.Trim(),
        }, profileId);
        if (result.Outcome != AudiobookBookmarkOperationOutcome.Success) return false;
        await ReloadSavedBookmarksAsync(workId, profileId);
        if (result.Value is { } created) MarkNewBookmark(created.Id);
        await ShowBookmarkNoticeAsync($"Bookmark added {PlaybackSeekRail.Time(seconds)}");
        return true;
    }

    // The bead of the bookmark just added pulses once (video player follow-ups D4); the flag is cleared a few seconds later and when the item changes.
    private Guid? _newBookmarkId;
    private CancellationTokenSource? _newBookmarkCancellation;

    private void MarkNewBookmark(Guid id)
    {
        ClearNewBookmark();
        var cancellation = _newBookmarkCancellation = new CancellationTokenSource();
        _newBookmarkId = id;
        _ = InvokeAsync(StateHasChanged);
        _ = ClearNewBookmarkLaterAsync(id, cancellation.Token);
    }

    private async Task ClearNewBookmarkLaterAsync(Guid id, CancellationToken ct)
    {
        try { await Task.Delay(TimeSpan.FromSeconds(4), ct); }
        catch (OperationCanceledException) { return; }
        if (_disposed || _newBookmarkId != id) return;
        _newBookmarkId = null;
        await InvokeAsync(StateHasChanged);
    }

    private void ClearNewBookmark()
    {
        _newBookmarkCancellation?.Cancel();
        _newBookmarkCancellation?.Dispose();
        _newBookmarkCancellation = null;
        _newBookmarkId = null;
    }

    /// <summary>Renames the person's own bookmark and changes its note. True when saved.</summary>
    private async Task<bool> EditBookmarkAsync(PlaybackRailBookmark bookmark, string? name, string? note)
    {
        if (Playback.CurrentItem is not { WorkId: var workId }) return false;
        var profileId = Playback.ActiveProfileId ?? Guid.Empty;
        var result = await ApiClient.UpdateAudiobookBookmarkWithOutcomeAsync(bookmark.Id, new UpdateAudiobookBookmarkRequestDto { Label = name, Note = note }, profileId);
        if (result.Outcome != AudiobookBookmarkOperationOutcome.Success) return false;
        await ReloadSavedBookmarksAsync(workId, profileId);
        return true;
    }

    private async Task<bool> DeleteBookmarkAsync(PlaybackRailBookmark bookmark)
    {
        if (Playback.CurrentItem is not { WorkId: var workId }) return false;
        var profileId = Playback.ActiveProfileId ?? Guid.Empty;
        var result = await ApiClient.DeleteAudiobookBookmarkWithOutcomeAsync(bookmark.Id, profileId);
        if (result.Outcome != AudiobookBookmarkOperationOutcome.Success) return false;
        await ReloadSavedBookmarksAsync(workId, profileId);
        return true;
    }

    private async Task ReloadSavedBookmarksAsync(Guid workId, Guid profileId)
    {
        var reload = await ApiClient.GetAudiobookBookmarksWithOutcomeAsync(workId, profileId);
        if (reload.Outcome == AudiobookBookmarkOperationOutcome.Success && reload.Value is { } saved) await HandleBookmarksSaved(saved);
    }

    /// <summary>A two-second line on the rail instead of a toast.</summary>
    private async Task ShowBookmarkNoticeAsync(string text)
    {
        _noticeCancellation?.Cancel();
        var cancellation = _noticeCancellation = new CancellationTokenSource();
        _bookmarkNotice = text;
        await InvokeAsync(StateHasChanged);
        try { await Task.Delay(TimeSpan.FromSeconds(2), cancellation.Token); }
        catch (OperationCanceledException) { return; }
        if (_disposed) return;
        _bookmarkNotice = null;
        await InvokeAsync(StateHasChanged);
    }

