    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        if (!Playback.IsVideoMode || !Playback.IsVideoExpanded ||
            Nav.ToAbsoluteUri(args.Location).AbsolutePath.StartsWith("/watch/player/", StringComparison.OrdinalIgnoreCase)) return;
        _ = InvokeAsync(ContinueVideoOutsidePlayerAsync);
    }

    private async Task ContinueVideoOutsidePlayerAsync()
    {
        if (!Playback.IsVideoMode || !Playback.IsVideoExpanded) return;
        var videoWorkId = Playback.CurrentItem?.WorkId;
        var requestVersion = Playback.PlaybackRequestVersion;
        bool IsCurrentVideo() => Playback.IsVideoMode
            && Playback.CurrentItem?.WorkId == videoWorkId
            && Playback.PlaybackRequestVersion == requestVersion;

        if (_canPictureInPicture && await JS.InvokeAsync<bool>("listenPlayback.togglePictureInPicture", _videoRef))
        {
            if (!IsCurrentVideo()) return;
            _continuationStatus = null;
            Playback.SetVideoExpanded(false);
            return;
        }

        if (!IsCurrentVideo()) return;
        await PauseAsync();
        if (!IsCurrentVideo()) return;
        _continuationStatus = L["VideoPlaybackHost_PlaybackPausedRestoreToContinue"].Value;
        Playback.SetPresentationSurface(PlaybackPresentationSurface.RestorableVideo);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A reload can replace this host while its first render is still waiting on the browser. Once disposed it
        // must not register anything new, because nothing would ever unregister it.
        if (_disposed) return;
        try
        {
            await RunAfterRenderAsync(firstRender);
        }
        catch (JSDisconnectedException)
        {
            // The browser connection is gone, so there is nothing left to synchronise.
        }
        catch (Exception exception) when (_disposed && exception is ObjectDisposedException or JSException or TaskCanceledException or InvalidOperationException)
        {
            Logger.LogDebug(exception, "The video playback host was disposed while its browser calls were still running.");
        }
    }

    private async Task RunAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _canPictureInPicture = await JS.InvokeAsync<bool>("listenPlayback.canPictureInPicture", _videoRef);
            if (_disposed) return;
            _selfReference = DotNetObjectReference.Create(this);
            _observerRegistered = true;
            await JS.InvokeVoidAsync(
                "listenPlayback.registerAudioStateObserver",
                _videoRef,
                _selfReference,
                Playback.ClientSettings.AudioObserverIntervalMilliseconds);
            if (_disposed)
            {
                await ReleaseBrowserClientAsync();
                return;
            }
        }

        // The Space and arrow keys only reach the player once it holds the keyboard, so take it when the video opens.
        if (Playback.IsVideoMode && !_keyboardFocused)
        {
            _keyboardFocused = true;
            await _hostRef.FocusAsync(preventScroll: true);
        }
        else if (!Playback.IsVideoMode)
        {
            _keyboardFocused = false;
        }
        _chromeModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-chrome.js");
        _presentationModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/video-presentation.js");
        _touchModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/video-touch.js");
        _mediaSessionModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/playback-media-session.js");
        if (_disposed)
        {
            await ReleaseBrowserClientAsync();
            return;
        }
        if (_chromeModule is not null)
        {
            await _chromeModule.InvokeVoidAsync("attach", _hostRef, _videoRef);
            await _chromeModule.InvokeVoidAsync("update", _hostRef, new { inactive = !Playback.IsVideoExpanded,
                loading = Playback.Phase == PlaybackPhase.Loading, error = Playback.Phase == PlaybackPhase.Error,
                tool = Tools.OpenToolId is not null, endCard = _endCard.Visible });
        }
        if (_presentationModule is not null)
        {
            await _presentationModule.InvokeVoidAsync("attach", _hostRef, _videoRef, _selfReference);
            await _presentationModule.InvokeVoidAsync("update", _hostRef, _endCard.Visible);
        }
        if (_touchModule is not null) await _touchModule.InvokeVoidAsync("attach", _hostRef, _videoRef, _selfReference);
        if (_mediaSessionModule is not null)
        {
            await _mediaSessionModule.InvokeVoidAsync("attachVideo", _videoRef, _selfReference);
            await SyncMediaSessionAsync();
        }

        if (Playback.IsVideoMode && !string.IsNullOrWhiteSpace(Playback.CurrentBrowserStreamUrl))
        {
            await SyncVideoAsync();
            if (_presentationModule is not null && VideoPlaybackIdentity.Capture(Playback) is { } identity)
                await _presentationModule.InvokeVoidAsync("bindSource", _hostRef, identity.ProfileId, identity.WorkId, identity.AssetId, identity.RequestVersion);
        }
        if (Playback.IsVideoMode && Playback.CurrentItem?.AssetId is Guid assetId && _loadedSubtitleAssetId != assetId)
        {
            _ = LoadSubtitleTracksAsync(assetId);
        }
    }

    private void HandlePlaybackChanged(PlaybackChangeKind changeKind)
    {
        _ = InvokeAsync(async () =>
        {
            if (!Playback.IsVideoMode && _lastAppliedStreamUrl is not null)
            {
                await JS.InvokeVoidAsync("listenPlayback.pauseAudio", _videoRef);
                if (_activeAssetId.HasValue)
                {
                    Activity.ClearVideoPlayback(_activeAssetId.Value);
                    _activeAssetId = null;
                }
                _lastAppliedPlayingState = false;
            }

            ObservePresentationIdentity();
            ObserveEndCard();

            if (Playback.CurrentItem?.AssetId != _loadedSubtitleAssetId)
            {
                _selectedCaptionKey = null;
                _captionTracks = [];
                _selectedAudioTrackIndex = null;
            }

            StateHasChanged();
        });
    }

    private async Task HandleStartFailureAsync()
    {
        var failure = await JS.InvokeAsync<string>("listenPlayback.startFailure", _videoRef);
        if (failure == "AbortError") return; // A superseding source/start owns the result.
        if (failure == "NotAllowedError") Playback.MarkNeedsUserGestureToStart();
        else Playback.MarkCurrentFailed("The media source could not start playback. Retry playback or check the source.");
    }

    private async Task SyncVideoAsync()
    {
        var streamUrl = Playback.CurrentBrowserStreamUrl;
        if (!string.Equals(_lastAppliedStreamUrl, streamUrl, StringComparison.Ordinal))
        {
            _lastAppliedStreamUrl = streamUrl;
            _lastAppliedPlayingState = null;
            await JS.InvokeVoidAsync("listenPlayback.ensureAudioSource", _videoRef, streamUrl);
        }

        if (_lastAppliedVolume != Playback.Volume)
        {
            await JS.InvokeVoidAsync("listenPlayback.setVolume", _videoRef, Playback.Volume);
            _lastAppliedVolume = Playback.Volume;
        }

        if (_lastAppliedMuteState != Playback.IsMuted)
        {
            await JS.InvokeVoidAsync("listenPlayback.setMuted", _videoRef, Playback.IsMuted);
            _lastAppliedMuteState = Playback.IsMuted;
        }

        if (_lastAppliedPlaybackRate != Playback.PlaybackRate)
        {
            await JS.InvokeVoidAsync("listenPlayback.setPlaybackRate", _videoRef, Playback.PlaybackRate);
            _lastAppliedPlaybackRate = Playback.PlaybackRate;
        }

        if (_lastAppliedStartVersion != Playback.PlaybackStartVersion)
        {
            _lastAppliedStartVersion = Playback.PlaybackStartVersion;
            if (Playback.CurrentTimeSeconds > 0)
            {
                await JS.InvokeVoidAsync("listenPlayback.seekAudio", _videoRef, Playback.CurrentTimeSeconds);
            }
            _lastAppliedPlayingState = null;
        }

        if (_lastAppliedPlayingState == Playback.IsPlaying)
        {
            return;
        }

        if (Playback.IsPlaying)
        {
            var started = await JS.InvokeAsync<bool>("listenPlayback.playAudio", _videoRef);
            if (!started)
            {
                await HandleStartFailureAsync();
            }
        }
        else
        {
            await JS.InvokeVoidAsync("listenPlayback.pauseAudio", _videoRef);
        }

        _lastAppliedPlayingState = Playback.IsPlaying;
    }

    [JSInvokable]
    public Task HandleObservedAudioState(VideoMetrics state) =>
        ApplyMetricsAsync(state, expectedRateSelectionVersion: null);

    private async Task HandleMetricsChangedAsync()
    {
        var rateSelectionVersion = Playback.PlaybackRateSelectionVersion;
        var state = await JS.InvokeAsync<VideoMetrics>("listenPlayback.readAudioState", _videoRef);
        await ApplyMetricsAsync(state, rateSelectionVersion);
    }

    private async Task ApplyMetricsAsync(VideoMetrics state, long? expectedRateSelectionVersion)
    {
        if (state.RequestVersion != Playback.PlaybackRequestVersion) return;
        if (Guid.TryParse(state.AssetId, out var observedAssetId)
            && Playback.CurrentItem?.AssetId != observedAssetId)
        {
            return;
        }

        if (!Playback.IsVideoMode)
        {
            return;
        }

        if (_availableSubtitleCount != state.SubtitleCount)
        {
            _availableSubtitleCount = state.SubtitleCount;
            await InvokeAsync(StateHasChanged);
        }
        var updatedCaptionTracks = state.CaptionTracks ?? [];
        if (!_captionTracks.SequenceEqual(updatedCaptionTracks))
        {
            _captionTracks = updatedCaptionTracks;
            _selectedCaptionKey = updatedCaptionTracks.FirstOrDefault(track => track.Selected)?.Key;
            await InvokeAsync(StateHasChanged);
        }
        if (_availableAudioTrackCount != state.AudioTrackCount)
        {
            _availableAudioTrackCount = state.AudioTrackCount;
            await InvokeAsync(StateHasChanged);
        }
        await ApplyPendingAudioAsync(state.AudioTrackCount);
        await ApplyProfileAudioDefaultAsync();
        Playback.UpdateTransportState(
            currentTimeSeconds: state.CurrentTime,
            durationSeconds: state.Duration,
            isPlaying: state.Paused && Playback.Phase == PlaybackPhase.Loading ? null : !state.Paused,
            volume: state.Volume,
            isMuted: state.Muted,
            playbackRate: state.PlaybackRate,
            expectedPlaybackRateSelectionVersion: expectedRateSelectionVersion);

        if (Playback.CurrentItem?.AssetId is Guid assetId)
        {
            _activeAssetId = assetId;
            // The shell's notice never names a Vault video, and a Vault video that is playing keeps Vault mode awake: the idle lock
            // must not cut in on it (Videos spec D33). The keepalive is throttled inside NsfwModeState.
            if (VaultPrivacy.ShouldKeepAwake(Playback.CurrentItem, isPlaying: !state.Paused))
            {
                await Nsfw.KeepAliveAsync();
            }

            Activity.ReportVideoPlayback(
                assetId,
                Playback.CurrentItem.DeviceTitle,
                state.CurrentTime,
                Playback.DurationSeconds,
                isPlaying: !state.Paused,
                ended: Playback.DurationSeconds > 0 && state.CurrentTime >= Playback.DurationSeconds - 0.5d);
        }

        await Playback.ReportHeartbeatAsync();
    }

    private async Task HandleStartedAsync()
    {
        if (!Playback.IsVideoMode)
        {
            return;
        }

        Playback.MarkPlaybackStarted();
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task HandlePausedAsync()
    {
        if (!Playback.IsVideoMode || Playback.Phase == PlaybackPhase.Loading)
        {
            return;
        }

        Playback.UpdateTransportState(isPlaying: false);
        await Playback.ReportHeartbeatAsync(force: true);
    }

    // Touch gestures reuse the visible controls' seek and play paths, so resume, heartbeat and the end-card clock behave the same.
    [JSInvokable] public async Task HandleTouchSeek(string assetId, long requestVersion, double targetSeconds)
    {
        if (_disposed || !Playback.IsVideoMode || !Playback.IsVideoExpanded || !double.IsFinite(targetSeconds)) return;
        // A tap that lands after the queue moved on must not seek the next item.
        if (requestVersion != Playback.PlaybackRequestVersion || !Guid.TryParse(assetId, out var asset) || Playback.CurrentItem?.AssetId != asset) return;
        await SeekOnHostAsync(targetSeconds);
    }
    [JSInvokable] public async Task HandleTouchTogglePlay()
    {
        if (_disposed || !Playback.IsVideoMode || !Playback.IsVideoExpanded) return;
        await TogglePlayPauseAsync();
    }
    [JSInvokable] public async Task MediaSessionActionAsync(string action, double? value)
    {
        if (_disposed || !Playback.IsVideoMode || Playback.IsDismissed || Playback.CurrentItem is null) return;
        switch (action)
        {
            case "play" when !Playback.IsPlaying || Playback.NeedsUserGestureToStart: await TogglePlayPauseAsync(); break;
            case "pause" when Playback.IsPlaying: await PauseAsync(); break;
            case "previoustrack": await Playback.SkipPreviousAsync(); break;
            case "nexttrack": await Playback.SkipNextAsync(); break;
            case "seekbackward": await SeekOnHostAsync(Playback.CurrentTimeSeconds - (value ?? Playback.SkipBackSeconds)); break;
            case "seekforward": await SeekOnHostAsync(Playback.CurrentTimeSeconds + (value ?? Playback.SkipForwardSeconds)); break;
            case "seekto" when value.HasValue: await SeekOnHostAsync(value.Value); break;
        }
    }
    private async Task SyncMediaSessionAsync()
    {
        if (_mediaSessionModule is null || _disposed) return;
        var item = Playback.CurrentItem;
        var shown = Playback.IsVideoMode && !Playback.IsDismissed && item is not null;
        var showTitle = _presentationContext?.ShowTitle;
        var subject = shown ? $"{Playback.ActiveProfileId}:{item!.WorkId}:{item.AssetId}:{Playback.PlaybackRequestVersion}:{showTitle}:{item.IsVault}:{Nsfw.Unlocked}:{Playback.SkipBackSeconds}:{Playback.SkipForwardSeconds}:{EligibleNextEpisode?.WorkId}" : null;
        if (_mediaSessionSubject == subject) return;
        _mediaSessionSubject = subject;
        // One builder serves the audio bar and the video player (unified player v2 D27): the same lines as the bar, the actions that work, and no
        // metadata at all for a Vault video while Vault mode is locked.
        var metadata = shown
            ? PlaybackSessionMetadata.Create(new PlaybackSessionContext(BarMedia, item!, new Uri(Nav.BaseUri), ShowTitle: showTitle,
                SkipBackSeconds: Playback.SkipBackSeconds, SkipForwardSeconds: Playback.SkipForwardSeconds,
                HasNextEpisode: EligibleNextEpisode is not null, VaultLocked: !Nsfw.Unlocked))
            : null;
        await _mediaSessionModule.InvokeVoidAsync("videoMetadata", metadata);
    }
