    private async Task ApplyPlaybackRateAsync(double value)
    {
        if (!PlaybackRateOptions.IsValid(value) || Playback.CurrentItem?.AssetId is not Guid assetId) return;
        var playbackRequestVersion = Playback.PlaybackRequestVersion;
        var rateSelectionVersion = Playback.PlaybackRateSelectionVersion;
        await JS.InvokeVoidAsync("listenPlayback.setPlaybackRate", _videoRef, value);
        if (Playback.PlaybackRateSelectionVersion != rateSelectionVersion
            || !Playback.TrySetPlaybackRateFromHost(value, assetId, playbackRequestVersion)) return;
        _lastAppliedPlaybackRate = value;
        await Playback.ReportHeartbeatAsync(force: true);
    }

    private async Task LoadSubtitleTracksAsync(Guid assetId)
    {
        var identity = VideoPlaybackIdentity.Capture(Playback);
        _loadedSubtitleAssetId = assetId;
        _managedSubtitleTracks = [];
        var tracks = await ApiClient.GetTextTracksAsync(assetId);
        if (Playback.CurrentItem?.AssetId != assetId || identity is not null && !identity.IsCurrent(Playback)) return;
        _managedSubtitleTracks = tracks;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectCaptionAsync(string? key)
    {
        var identity = VideoPlaybackIdentity.Capture(Playback);
        if (identity is null) return;
        if (await JS.InvokeAsync<bool>("listenPlayback.selectCaptionTrack", _videoRef, key, identity.AssetId, identity.RequestVersion, identity.ProfileId)
            && identity.IsCurrent(Playback))
        {
            await HandleMetricsChangedAsync();
        }
    }

    // "Use this" or "This one is wrong" changed the title's subtitles: reload them and show the new one at once, without restarting the picture.
    private async Task SubtitleTracksChangedAsync(Guid? trackId)
    {
        if (Playback.CurrentItem?.AssetId is not Guid assetId) return;
        await LoadSubtitleTracksAsync(assetId);
        if (trackId is Guid id) await ShowManagedSubtitleAsync(id);
    }

    private async Task ShowManagedSubtitleAsync(Guid trackId)
    {
        var identity = VideoPlaybackIdentity.Capture(Playback);
        if (identity is null) return;
        var key = $"managed:{trackId:D}";
        try
        {
            // The new <track> element is drawn by the reload above; give the browser a moment to know it.
            for (var attempt = 0; attempt < 5 && !_disposed; attempt++)
            {
                if (await JS.InvokeAsync<bool>("listenPlayback.selectCaptionTrack", _videoRef, key, identity.AssetId, identity.RequestVersion, identity.ProfileId))
                {
                    if (identity.IsCurrent(Playback)) await HandleMetricsChangedAsync();
                    return;
                }
                await Task.Delay(60, _lifetimeCancellation.Token);
            }
        }
        catch (OperationCanceledException) { /* The player was closed while waiting; nothing to show. */ }
        catch (JSException ex) { Logger.LogWarning(ex, "The chosen subtitle could not be shown; it stays in the list to pick."); }
        catch (JSDisconnectedException) { /* The browser went away while the subtitle was being shown; nothing to show. */ }
    }

    private static string ManagedSubtitleLabel(TextTrackDto track) =>
        $"{track.Language.ToUpperInvariant()}{(track.IsHearingImpaired ? " SDH" : "")}";

    // A subtitle row keeps what kind of track it is: "English", "English · SDH", "English · Forced".
    private string CaptionChoiceLabel(CaptionTrackMetric track)
    {
        if (track.Key.StartsWith("managed:", StringComparison.Ordinal)
            && Guid.TryParse(track.Key[8..], out var id)
            && ManagedSubtitleTracks.FirstOrDefault(candidate => candidate.Id == id) is { } managed)
        {
            return AudioSubtitlesChoices.SubtitleLabel(L, managed.Language, track.Label, isForced: false, managed.IsHearingImpaired);
        }
        if (track.Key.StartsWith("manifest:", StringComparison.Ordinal)
            && int.TryParse(track.Key[9..], out var index)
            && SubtitleTracks.FirstOrDefault(candidate => candidate.Index == index) is { } manifest)
        {
            return AudioSubtitlesChoices.SubtitleLabel(L, manifest.Language, manifest.DisplayName ?? track.Label, manifest.IsForced, AudioSubtitlesChoices.NamesHearingImpaired(manifest.DisplayName));
        }
        return AudioSubtitlesChoices.SubtitleLabel(L, track.Language, track.Label, isForced: false, AudioSubtitlesChoices.NamesHearingImpaired(track.Label));
    }

    // One choice from the Audio & subtitles panel. Subtitles switch in the browser (the picture is untouched); audio switches in the browser or, when it
    // cannot see the file's tracks, through the Engine stream, which restarts at the second the player is at (SwitchVideoToAdaptiveAsync). The request
    // carries that second too, so the panel's promise (A9: within one second) is stated where the choice is made.
    private Task HandleTrackSwitchAsync(TrackSwitchRequest request) => request.Kind == TrackSwitchKind.Audio
        ? SelectAudioTrackAsync(request.AudioIndex, request.ResumeSeconds)
        : SelectCaptionAsync(request.CaptionKey);

    private async Task SelectAudioTrackAsync(int index, double? resumeSeconds = null)
    {
        if (AudioTracks.Count < 2 || _switchingAudio) return;
        _trackNotice = null;
        if (CanSwitchAudio && await JS.InvokeAsync<bool>("listenPlayback.selectAudioTrack", _videoRef, index))
        {
            _selectedAudioTrackIndex = index;
            return;
        }

        // The browser cannot see this file's audio tracks: ask the Engine for the stream that carries them and resume from the same second.
        _pendingAudioIndex = index;
        _switchingAudio = true;
        await InvokeAsync(StateHasChanged);
        if (!await Playback.SwitchVideoToAdaptiveAsync(_lifetimeCancellation.Token, resumeSeconds))
        {
            _switchingAudio = false;
            _pendingAudioIndex = null;
            _trackNotice = L["VideoPlaybackHost_AudioCanTBeSwitched"].Value;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Once the adaptive stream exposes the file's audio tracks, selects the one the person asked for.</summary>
    private async Task ApplyPendingAudioAsync(int availableTracks)
    {
        if (_pendingAudioIndex is not int wanted || availableTracks < AudioTracks.Count || availableTracks < 2) return;
        _pendingAudioIndex = null;
        if (await JS.InvokeAsync<bool>("listenPlayback.selectAudioTrack", _videoRef, wanted)) _selectedAudioTrackIndex = wanted;
        _switchingAudio = false;
        await InvokeAsync(StateHasChanged);
    }

