    private async Task ResetPlaybackPreferencesAsync()
    {
        await Playback.SetPlaybackRateAsync(PlaybackSpeedChoices.Normal);
        if (Services.GetService<PlaybackSettingsActions>() is { } actions && await actions.ResetSkipLengthsAsync(_lifetimeCancellation.Token)) return;
