@namespace MediaEngine.Web.Components.Player
@using System.Globalization
@using Microsoft.JSInterop
@using MediaEngine.Contracts.Playback
@using MediaEngine.Contracts.Details
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Web.Services.MediaTiles
@inject PlaybackSessionController Playback
@inject VideoPresentationResolver Presentation
@inject PlaybackTransientToolCoordinator Tools
@inject IEngineApiClient ApiClient
@inject ShellActivityState Activity
@inject NsfwModeState Nsfw
@inject IJSRuntime JS
@inject IServiceProvider Services
@inject NavigationManager Nav
@inject ILogger<VideoPlaybackHost> Logger
@implements IAsyncDisposable
@inject IStringLocalizer<SharedStrings> L

<section @ref="_hostRef" class="@StageClass"
         data-subtitle-size="@SubtitleSizeValue" data-subtitle-background="@SubtitleBackgroundValue"
         data-subtitle-font="@SubtitleFontValue" data-subtitle-shadow="@SubtitleShadowValue"
         data-subtitle-color="@SubtitleColorValue" data-subtitle-text-opacity="@SubtitleTextOpacityValue"
         data-subtitle-bg-color="@SubtitleBackgroundColorValue" data-subtitle-bg-opacity="@SubtitleBackgroundOpacityValue" data-subtitle-contrast="@(SubtitleStyleCss.IsHighContrast(_profileSubtitles) ? "true" : "false")"
         aria-label="@(Playback.IsVideoMode ? "Video player" : null)"
         aria-hidden="@(Playback.IsVideoMode ? "false" : "true")"
         tabindex="-1" @onkeydown="HandleVideoKeyDown">
    <video @ref="_videoRef" id="tuvima-video-engine"
           data-playback-asset-id="@Playback.CurrentItem?.AssetId"
           data-playback-request-version="@Playback.PlaybackRequestVersion"
           data-playback-caption-default="@TrackDefaults.CaptionAttribute"
           class="video-playback-host__media" playsinline preload="metadata"
           poster="@Playback.CurrentItem?.CoverUrl" @onclick="TogglePlayPauseAsync"
           @onloadedmetadata="HandleMetricsChangedAsync" @ondurationchange="HandleMetricsChangedAsync"
           @onplay="HandleStartedAsync" @onpause="HandlePausedAsync"
           @onerror="HandleErrorAsync">
        @foreach (var track in SubtitleTracks)
        {
            <track kind="subtitles" @key="@($"{track.Index}-{track.DeliveryUrl}")"
                   data-playback-track-key="@($"manifest:{track.Index}")"
                   src="@SubtitleUrl(track)" srclang="@(track.Language ?? "und")"
                   label="@SubtitleLabel(track)" default="@track.IsDefault" />
        }
        @if (Playback.IsVideoMode && Playback.CurrentItem?.AssetId is Guid subtitleAssetId)
        {
            @foreach (var track in ManagedSubtitleTracks)
            {
                <track kind="subtitles" @key="track.Id" data-playback-track-key="@($"managed:{track.Id:D}")"
                       data-playback-preferred="@(track.IsPreferred ? "true" : "false")"
                       src="@($"/engine-text-track/{subtitleAssetId:D}/{track.Id:D}")"
                       srclang="@track.Language" label="@ManagedSubtitleLabel(track)" />
            }
        }
    </video>
    @if (Playback.IsVideoMode && Playback.IsVideoExpanded && Playback.CurrentItem is not null)
    {
        @* While the Engine gets the title ready, or after it could not, the waiting state carries the Engine's own line (spec playback-path D8). *@
        @if (Playback.CurrentWaiting is { } waiting)
        {
            <VideoPreparingState View="@waiting" Title="@Playback.CurrentItem.Title" OnCancel="ClosePlayerAsync" OnRetry="RetryPreparationAsync" />
        }
        else if (Playback.Phase == PlaybackPhase.Loading || !string.IsNullOrWhiteSpace(Playback.CurrentError))
        {
            <div class="video-playback-host__status" role="status">@(Playback.CurrentError ?? PlaybackWaitingRules.NeutralLine)</div>
        }
        @if (_switchingAudio) { <div class="video-playback-host__status" role="status">@L["VideoPlaybackHost_SwitchingAudio"]</div> }
        @* Unified player v2 D25 (mockup screen 14): the rating card at the top-left (the content rating, never the audience score), and the paused details at
           the bottom-left above the bar. The details hide while a panel is open or the end card is up, and come back when it closes. *@
        <VideoRatingCard ContentRating="@Playback.CurrentItem.ContentRating" Playing="@VideoIsPlaying" @key="@VideoInstanceKey" />
        <VideoPausedDetails Content="@PausedDetails" Visible="@(!VideoIsPlaying && Playback.Phase != PlaybackPhase.Loading && string.IsNullOrWhiteSpace(Playback.CurrentError) && Tools.OpenToolId is null && !_endCard.Visible)" />
        <PlaybackVideoChrome HeaderContent="@(IsPhoneVideo ? PhoneHeader : null)">
            <BottomContent>
            @if (VisibleSkipSegment is { } segment)
            {
                <div class="video-playback-host__skip-segment">
                    <span>@SegmentDescription(segment.Kind)</span>
                    <AppTooltip Text="@SkipLabel(segment.Kind)"><AppNativeButton Type="button" Class="video-playback-host__icon"
                        AriaLabel="@SkipLabel(segment.Kind)" OnClick="@(() => SeekOnHostAsync(segment.EndSeconds!.Value))"><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Next" /></AppNativeButton></AppTooltip>
                </div>
            }
            @* What the "..." menu's Mark as watched or unwatched said, with Undo: in place above the bar, since the menu has closed. *@
            <div class="video-playback-host__undo"><AppUndoNote Offer="StatusUndo" OnCleared="ClearStatusUndo" /></div>
            <PlaybackShell Media="@BarMedia" Surface="video" Phone="@IsPhoneVideo" Class="video-playback-host__bar" AriaLabel="@L["VideoPlaybackHost_VideoPlayback"].Value"
                           State="@BarState" Identity="@BarIdentity"
                           ArtworkSrc="@BarArtwork.Src" ArtworkSrcSet="@BarArtwork.SrcSet" ArtworkIsPoster="@BarArtwork.IsPoster"
                           ArtworkAlt="" ArtworkDisplay="video-bar-thumbnail"
                           Volume="@Playback.Volume" IsMuted="@(PlaybackMuteDisplay.ShowsMuted(Playback.IsMuted, Playback.Volume, Playback.VolumeReported))"
                           CommitVolumeOnChange="false" OnToggleMute="ToggleMuteAsync" OnVolumeChanged="SetVolumeOnHostAsync"
                           OnTransport="HandleBarTransportAsync" OnTool="HandleBarToolAsync"
                           HostedTools="@HostedBarTools">
                <LinkContent Context="link">
                    <MediaEngine.Web.Components.Player.PlaybackIdentityLink Href="@PlaybackItemRoutes.ForVideoLink(link.Kind, link.Id, BarShowWorkId, Playback.CurrentItem)" Text="@link.Text" />
                </LinkContent>
                <IdentityActions>
                    <PlaybackIdentityActions Media="@BarMedia" Item="@Playback.CurrentItem" Surface="video" ShowWorkId="@BarShowWorkId" SeasonId="@BarSeasonId" OnStatusChanged="ShowStatusUndo" />
                </IdentityActions>
                <TimelineContent>
            <PlaybackSeekRail Position="@Playback.CurrentTimeSeconds" Duration="@Playback.DurationSeconds" ValueChanged="SeekOnHostAsync" ChapterTicks="@ShownChapterTicks" ChapterLabel="ChapterTickLabel" Surface="video"
                               Bookmarks="@ShownRailBookmarks" BookmarkJump="JumpToRailBookmarkAsync" BookmarkDelete="DeleteBookmarkAsync" Notice="@_bookmarkNotice" NewBookmarkId="@_newBookmarkId"
                               PreviewIndexUrl="@PlaybackSeekRail.PreviewIndexAddress(Playback.CurrentManifest?.ScrubPreviewIndexUrl)" />
                </TimelineContent>
                <ToolContent Context="tool">
                    @switch (tool.Key)
                    {
                        case PlaybackControlKey.Episodes:
                            if (ContextKind is not null)
                            {
                        <PlaybackPanel Title="@ContextTitle" Subtitle="@(IsTvEpisode ? _presentationContext?.ShowTitle : null)" ToolId="video-context" Kind="episodes" Surface="video" ItemKey="@VideoInstanceKey">
                            <TriggerContent><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Episodes" /></TriggerContent>
                            <ChildContent><EpisodesPanel Episodes="@(_presentationContext?.Episodes ?? [])"
                                Lessons="@(!IsTvEpisode)" FolderVideos="@IsFolderVideoNow" Upcoming="@UpcomingVideo" NextEpisode="@EligibleNextEpisode" CurrentWorkId="@Playback.CurrentItem.WorkId"
                                Position="@Playback.CurrentTimeSeconds" Duration="@Playback.DurationSeconds" IsPlaying="@VideoIsPlaying" FallbackArtUrl="@Playback.CurrentItem.CoverUrl"
                                AutoplayNextEpisode="@Playback.AutoplayNextEpisode" AutoplayChanged="ChangeAutoplayNextEpisodeAsync"
                                EpisodeSelected="PlayOwnedEpisodeAsync" QueueSelected="PlayVideoQueueEntryAsync" /></ChildContent>
                        </PlaybackPanel>
                            }
                            break;
                        case PlaybackControlKey.Bookmarks:
                            if (VideoControlState.CanBookmark && Playback.CurrentItem is { AssetId: not null })
                            {
                        <PlaybackPanel Title="@L["Glossary_Bookmarks"].Value" ToolId="video-bookmarks" Kind="bookmarks" Surface="video" ItemKey="@VideoInstanceKey">
                            <TriggerContent><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Bookmark" /></TriggerContent>
                            <ChildContent>
                                <BookmarksPanel Bookmarks="@_savedRail" Position="@Playback.CurrentTimeSeconds" ScrollKey="@VideoInstanceKey"
                                                Choice="@BookmarkFilter" ChoiceChanged="ChangeBookmarkFilterAsync"
                                                ShowOnTimeline="@ShowBookmarksOnBar" ShowOnTimelineChanged="ChangeShowBookmarksOnBarAsync"
                                                Add="AddBookmarkAsync" Seek="@(bookmark => JumpToBookmarkAsync(bookmark.Seconds, true))"
                                                Edit="EditBookmarkAsync" Delete="DeleteBookmarkAsync" />
                            </ChildContent>
                        </PlaybackPanel>
                            }
                            break;
                        case PlaybackControlKey.AudioSubtitles:
                    <AudioSubtitlesPanel ToolId="video-captions" Surface="video" ItemKey="@VideoInstanceKey" OpenChanged="HandleSettingsOpenChangedAsync"
                                         TriggerClass="@(_captionTracks.Any(track => track.Selected) ? "is-on" : null)"
                                         Audio="@AudioChoices" Subtitles="@SubtitleChoices" Position="@Playback.CurrentTimeSeconds" OnSwitch="HandleTrackSwitchAsync" Notice="@_trackNotice"
                                         Look="@_profileSubtitles" StyleChanged="ChangeSubtitleStyleAsync"
                                         NoSubtitleSource="@_noSubtitleSource" IsAdministrator="@CanShareBookmarks" IsEpisode="@IsTvEpisode" Find="@Find" />
                            break;
                        case PlaybackControlKey.Settings:
                            @SettingsTool
                            break;
                    }
                </ToolContent>
            </PlaybackShell>
        </BottomContent>
        </PlaybackVideoChrome>
        <div class="video-touch-feedback" data-video-touch-feedback aria-hidden="true"></div>
        <div class="sr-only" role="status" aria-live="polite" data-video-touch-announce></div>
        <div class="video-touch-hint" data-video-touch-hint hidden>
            <span>@L["VideoPlaybackHost_TurnYourPhoneForFull"]</span>
            <AppTooltip Text="@L["VideoPlaybackHost_DismissHint"].Value"><AppNativeButton Type="button" Class="video-playback-host__icon" AriaLabel="@L["VideoPlaybackHost_DismissHint"].Value" data-video-touch-hint-dismiss="true">
                <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Close" />
            </AppNativeButton></AppTooltip>
        </div>
        @if (_endCard.Visible && (EligibleNextEpisode is not null || HomeworkFiles.Count > 0))
        {
            @* A course's card also lists the files shown alongside the lesson that ended; it shows on the last lesson too (universal editor v5 D31). *@
            <VideoEndCard Next="@EligibleNextEpisode" Lesson="@(IsFolderVideoNow || !IsTvEpisodeNow)" AutoAdvance="@_endCard.AutoAdvance" RemainingSeconds="@_endCard.RemainingSeconds"
                          UpNextDismissed="@_endCard.UpNextDismissed" HomeworkFiles="@HomeworkFiles"
                          PlayNow="AdvanceCurrentVideoAsync" Cancel="DismissEndCard" OpenHomework="OpenHomeworkAsync" />
        }
    }
</section>
@if (Playback.HasQueue && Playback.IsVideoMode && !Playback.IsVideoExpanded && !_isPictureInPicture && Playback.CurrentItem is not null)
{
    <section class="video-playback-restore" aria-label="@L["VideoPlaybackHost_VideoPlayback"].Value">
        <span>@Playback.CurrentItem.DeviceTitle</span>
        @if (!string.IsNullOrWhiteSpace(_continuationStatus))
        {
            <small role="status">@_continuationStatus</small>
        }
        <AppTooltip Text="@L["VideoPlaybackHost_RestoreVideoPlayer"].Value"><AppNativeButton Type="button" Class="video-playback-restore__button" OnClick="RestoreVideoAsync" AriaLabel="@L["VideoPlaybackHost_RestoreVideoPlayer"].Value">
            <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Expand" />
        </AppNativeButton></AppTooltip>
        <AppNativeButton Type="button" Class="video-playback-restore__button" OnClick="ClosePlayerAsync" AriaLabel="@L["VideoPlaybackHost_StopVideoPlayback"].Value">
            <PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Close" />
        </AppNativeButton>
    </section>
}

@code {
    private UndoOffer? _statusUndo;
    private Guid? _statusUndoWorkId;
    private Task ShowStatusUndo(UndoOffer offer) { _statusUndo = offer; _statusUndoWorkId = Playback.CurrentItem?.WorkId; return Task.CompletedTask; }
    private Task ClearStatusUndo() { _statusUndo = null; return Task.CompletedTask; }

    // The offer belongs to the item it was made on: when the playing item changes, it is gone.
    private UndoOffer? StatusUndo
    {
        get
        {
            if (_statusUndo is not null && _statusUndoWorkId != Playback.CurrentItem?.WorkId)
            {
                _statusUndo = null;
            }

            return _statusUndo;
        }
    }

    private ElementReference _hostRef;
    private IJSObjectReference? _chromeModule, _presentationModule, _touchModule, _mediaSessionModule;
    private string? _mediaSessionSubject;
    private VideoPlaybackIdentity? _observedIdentity;
    private VideoPresentationContext? _presentationContext;
    private CancellationTokenSource? _metadataCancellation;
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private readonly VideoEndCardState _endCard = new();
    private bool _disposed;
    private bool _isFullscreen;
    private bool _isPictureInPicture;
    private ElementReference _videoRef;
    private DotNetObjectReference<VideoPlaybackHost>? _selfReference;
    private bool _observerRegistered;
    private string? _lastAppliedStreamUrl;
    private long _lastAppliedStartVersion = -1;
    private bool? _lastAppliedPlayingState;
    private double? _lastAppliedVolume;
    private bool? _lastAppliedMuteState;
    private double? _lastAppliedPlaybackRate;
    private Guid? _activeAssetId;
    private int _availableSubtitleCount;
    private int _availableAudioTrackCount;
    private int? _selectedAudioTrackIndex, _pendingAudioIndex;
    private bool _switchingAudio;
    private bool _keyboardFocused;
    private bool _canPictureInPicture;
    private string? _continuationStatus;

    // The title's saved bookmarks, drawn as ticks beside the chapters (Videos spec D43). Loaded again whenever the video changes.
    // The profile's own, shared and pack bookmarks are kept apart so a change to one redraws the rail without the others being reloaded.
    private IReadOnlyList<AudiobookBookmarkDto> _railSaved = [];
    private IReadOnlyList<PlaybackRailBookmark> _savedRail = [];
    private Task? _railBookmarksLoad;
    private bool ShowBookmarksOnBar => _profileSettings?.General.ShowBookmarksOnBar == true; // On by default once the profile has loaded (video player follow-ups D16); nothing is drawn before that, so a profile that turned the dots off never sees them flash.
    private string BookmarkFilter => _profileSettings?.General.BookmarkFilter ?? PlaybackPreferenceValues.Mine;
    private bool CanShareBookmarks => Services.GetService<DashboardSessionAccessor>()?.Authority?.EffectiveAdministrator == true;
    private Guid? _loadedSubtitleAssetId;
    private IReadOnlyList<TextTrackDto> _managedSubtitleTracks = [];
    private IReadOnlyList<CaptionTrackMetric> _captionTracks = [];
    private string? _selectedCaptionKey;
    // Why an audio switch did not happen, shown under the Audio & subtitles lists.
    private string? _trackNotice;

    // The Find subtitles view's state and calls (follow-ups D9 to D12) live in the presenter; the host only tells it what to do once the tracks changed.
    private SubtitleFindPresenter? _find;
    private SubtitleFindPresenter Find => _find ??= new SubtitleFindPresenter(ApiClient)
    {
        TracksChanged = SubtitleTracksChangedAsync,
        CurrentTrackFor = provider => ManagedSubtitleTracks
            .FirstOrDefault(track => track.IsPreferred && !track.IsUserOwned && string.Equals(track.Provider, provider, StringComparison.OrdinalIgnoreCase))?.Id,
    };

    private string StageClass =>
        Playback.IsVideoMode && Playback.IsVideoExpanded
            ? "video-playback-host is-expanded"
            : "video-playback-host";
    private double ProgressMax => Playback.DurationSeconds > 0 ? Playback.DurationSeconds : 1d;
    private string ProgressValueText => Playback.DurationSeconds > 0 ? $"{FormatTimestamp(Playback.CurrentTimeSeconds)} of {FormatTimestamp(ProgressMax)}" : "Duration unavailable";
    private bool IsTvEpisodeNow => VideoPresentationResolver.IsTvEpisode(Playback.CurrentItem);
    // A video from a Videos or Other videos library says its number and title ("3 · Ball handling"), never a season or "S1 E3" (issue 703).
    private bool IsFolderVideoNow => VideoPlayerWording.IsFolderVideo(Playback.CurrentItem);
    // The title, "S1 E1 · The First Wish · 22 min" line and short description of the paused overlay (D25).
    private VideoPausedDetailsContent? PausedDetails => VideoPausedDetailsPresenter.Build(Playback.CurrentItem, _presentationContext?.ShowTitle,
        _presentationContext?.Episodes.FirstOrDefault(episode => episode.WorkId == Playback.CurrentItem?.WorkId)?.Synopsis, Playback.DurationSeconds, L);
    private string VideoInstanceKey => $"{Playback.ActiveProfileId}:{Playback.CurrentItem?.AssetId}:{Playback.PlaybackRequestVersion}";
    private IReadOnlyList<ListenQueueItem> UpcomingVideo => Playback.Queue.Skip(Playback.CurrentIndex + 1).Where(item => MediaKindClassifier.IsVideo(item.MediaType)).ToList();
    private string? ContextKind => VideoPresentationResolver.ContextKind(VideoPresentationResolver.HasOwnedSequence(Playback.CurrentItem),
        Playback.CurrentItem?.MediaType.Contains("movie", StringComparison.OrdinalIgnoreCase) == true,
        _presentationContext?.Episodes.Count ?? 0, UpcomingVideo.Count);
    private bool IsMovie => Playback.CurrentItem?.MediaType.Contains("movie", StringComparison.OrdinalIgnoreCase) == true;
    private bool IsTvEpisode => VideoPresentationResolver.IsTvEpisode(Playback.CurrentItem);
    // The list is "Episodes" for a TV show and "Lessons" for a course or a folder of videos (unified player v2 D19).
    private string ContextTitle => EpisodesPanel.Title(L, IsTvEpisode);
    private string ChapterTickLabel(double seconds) => VideoChapters.Where(chapter => chapter.StartSeconds <= seconds).OrderByDescending(chapter => chapter.StartSeconds).FirstOrDefault() is { } chapter
        ? $"Chapter {chapter.Index + 1:00} · {chapter.Title} · {FormatTimestamp(chapter.StartSeconds)}" : FormatTimestamp(seconds);
    /// <summary>Chapter ticks follow the profile's setting: off by default for video (player-controls-v3 D8).</summary>
    private IReadOnlyList<double> ShownChapterTicks => PlayerPreferenceService.ShowChapterMarks(_profileSettings, audiobook: false) ? ChapterTicks : [];
    /// <summary>The bookmark beads on the bar: on by default (video player follow-ups D4, D16) unless the profile turned them off, and following the list the Bookmarks panel shows, Everyone or Mine (unified player v2 D21).</summary>
    private IReadOnlyList<PlaybackRailBookmark> ShownRailBookmarks => !ShowBookmarksOnBar ? [] : PlaybackRailBookmark.ForChoice(_savedRail, BookmarkFilter);
    private IReadOnlyList<double> ChapterTicks => Playback.DurationSeconds > 0 ? VideoChapters.Select(chapter => chapter.StartSeconds).Where(time => time >= 0 && time < Playback.DurationSeconds).Distinct().Order().ToList() : [];
    private IReadOnlyList<PlaybackSegmentDto> VerifiedSegments => (Playback.CurrentManifest?.Segments ?? [])
        .Where(segment => segment.Kind.ToLowerInvariant() is "intro" or "recap" or "credits" && VideoEndCardState.IsVerifiedRange(segment, Playback.DurationSeconds)).ToList();
    private string SegmentStyle(PlaybackSegmentDto segment) => $"left:{(segment.StartSeconds / ProgressMax * 100).ToString("0.###", CultureInfo.InvariantCulture)}%;width:{((segment.EndSeconds!.Value - segment.StartSeconds) / ProgressMax * 100).ToString("0.###", CultureInfo.InvariantCulture)}%;";
    private bool CanGoToPreviousEpisode => Playback.CurrentIndex > 0 && VideoPresentationResolver.HasOwnedSequence(Playback.CurrentItem);
    private VideoOwnedEpisode? EligibleNextEpisode => _presentationContext is { NextEpisode: { } next } context
        && context.Identity.IsCurrent(Playback) && Playback.Queue.Skip(Playback.CurrentIndex + 1).FirstOrDefault()?.WorkId == next.WorkId ? next : null;
    [JSInvokable] public Task HandleFullscreenChanged(bool fullscreen) { _isFullscreen = fullscreen; return InvokeAsync(StateHasChanged); }
    [JSInvokable] public Task HandlePictureInPictureChanged(Guid profileId, Guid workId, Guid assetId, long requestVersion, bool active)
    {
        var identity = VideoPlaybackIdentity.Capture(Playback);
        if (_disposed || identity is null || identity.ProfileId != profileId || identity.WorkId != workId
            || identity.AssetId != assetId || identity.RequestVersion != requestVersion) return Task.CompletedTask;
        _isPictureInPicture = active;
        // Native PiP exit has no reliable close/back-to-tab reason. Both exits retain Restore.
        if (active) Playback.SetVideoExpanded(false);
        return InvokeAsync(StateHasChanged);
    }
    private IReadOnlyList<PlaybackSubtitleTrackDto> SubtitleTracks =>
        (Playback.CurrentManifest?.SubtitleTracks ?? [])
            .Where(track => !string.IsNullOrWhiteSpace(track.DeliveryUrl))
            .ToList();
    // Audio & subtitles (unified player v2 D12): the rows the panel draws, built from the file's track data and the tracks the player reports.
    // Audio can be switched when the browser sees every track, or when the Engine can stream them (the player then resumes at the same second).
    private bool AudioSwitchPossible => AudioTracks.Count > 1
        && (CanSwitchAudio || Playback.CurrentManifest?.HlsStatus is not ("failed" or "unavailable"));
    private IReadOnlyList<AudioChoice> AudioChoices => AudioSubtitlesChoices.BuildAudio(L, AudioTracks, _selectedAudioTrackIndex, AudioSwitchPossible);
    private IReadOnlyList<SubtitleChoice> SubtitleChoices => _captionTracks
        .Select(track => new SubtitleChoice(track.Key, CaptionChoiceLabel(track), track.Selected))
        .Prepend(new SubtitleChoice(null, L["Common_Off"].Value, !_captionTracks.Any(track => track.Selected)))
        .ToList();

    private IReadOnlyList<PlaybackTrackDto> AudioTracks => Playback.CurrentManifest?.AudioTracks ?? [];
    // Profile defaults (Settings > Playback > Subtitles & audio). The size and background reach the cues through
    // --tl-subtitle-size / --tl-subtitle-bg, which wwwroot/app.css derives from these two attributes.
    private SubtitleLanguageSettingsDto? _profileSubtitles;
    // The profile's whole playback settings: the bar's chapter and bookmark marks and the remembered bookmark filter (player-controls-v3 D8, D8a, D10).
    private UserPlaybackSettingsDto? _profileSettings;
    private string? _profileAudioAppliedFor;
    private Guid? _profileSubtitlesProfile;
    private string SubtitleSizeValue => (_profileSubtitles?.SubtitleSize) switch
    {
        var size when string.Equals(size, PlaybackPreferenceValues.Small, StringComparison.OrdinalIgnoreCase) => PlaybackPreferenceValues.Small,
        var size when string.Equals(size, PlaybackPreferenceValues.Large, StringComparison.OrdinalIgnoreCase)
            || string.Equals(size, PlaybackPreferenceValues.ExtraLarge, StringComparison.OrdinalIgnoreCase) => PlaybackPreferenceValues.Large,
        _ => PlaybackPreferenceValues.Medium,
    };
    private string SubtitleBackgroundValue => SubtitleStyleCss.BackgroundOpacity(_profileSubtitles) <= 0 ? "false" : "true";
    private string SubtitleFontValue => _profileSubtitles?.SubtitleFont ?? PlaybackPreferenceValues.FontDefault;
    // Text and background colour with their opacity (unified player D12). app.css turns the four attributes into --tl-subtitle-color / --tl-subtitle-bg for the cues.
    private string SubtitleColorValue => SubtitleStyleCss.ColorName(_profileSubtitles?.SubtitleColor, PlaybackPreferenceValues.ColorWhite);
    private string SubtitleBackgroundColorValue => SubtitleStyleCss.ColorName(_profileSubtitles?.SubtitleBackgroundColor, PlaybackPreferenceValues.ColorBlack);
    private string SubtitleTextOpacityValue => SubtitleStyleCss.NearestStop(PlaybackPreferenceValues.TextOpacityStops, SubtitleStyleCss.TextOpacity(_profileSubtitles)).ToString(CultureInfo.InvariantCulture);
    private string SubtitleBackgroundOpacityValue => SubtitleStyleCss.NearestStop(PlaybackPreferenceValues.BackgroundOpacityStops, SubtitleStyleCss.BackgroundOpacity(_profileSubtitles)).ToString(CultureInfo.InvariantCulture);
    private string SubtitleShadowValue => _profileSubtitles?.SubtitleShadow == true ? "true" : "false";
    // The audio track can be changed only when the player reports every track (HLS, or a browser with audioTracks). Direct play in
    // Chrome or Firefox reports none, so the profile's audio language must not be assumed to play there.
    private bool CanSwitchAudio => AudioTracks.Count > 1 && _availableAudioTrackCount == AudioTracks.Count;
    // Recomputed only when one of its inputs is replaced, not on every render (the transport clock re-renders this host constantly).
    private VideoTrackDefaults _trackDefaults = VideoTrackDefaults.Unchanged;
    private SubtitleLanguageSettingsDto? _trackDefaultsSettings;
    private PlaybackManifestDto? _trackDefaultsManifest;
    private IReadOnlyList<TextTrackDto>? _trackDefaultsManaged;
    private bool _trackDefaultsCanSwitch;
    private bool _trackDefaultsComputed;
    private VideoTrackDefaults TrackDefaults
    {
        get
        {
            var manifest = Playback.CurrentManifest;
            var canSwitch = CanSwitchAudio;
            if (_trackDefaultsComputed && ReferenceEquals(_trackDefaultsSettings, _profileSubtitles) && ReferenceEquals(_trackDefaultsManifest, manifest)
                && ReferenceEquals(_trackDefaultsManaged, _managedSubtitleTracks) && _trackDefaultsCanSwitch == canSwitch)
            {
                return _trackDefaults;
            }
            _trackDefaultsSettings = _profileSubtitles; _trackDefaultsManifest = manifest; _trackDefaultsManaged = _managedSubtitleTracks;
            _trackDefaultsCanSwitch = canSwitch; _trackDefaultsComputed = true;
            return _trackDefaults = VideoPresentationResolver.ChooseTrackDefaults(_profileSubtitles, AudioTracks,
                SubtitleTracks.Select(track => new VideoSubtitleCandidate($"manifest:{track.Index}", track.Language, track.DisplayName, IsForced: track.IsForced))
                    .Concat(ManagedSubtitleTracks.Select(track => new VideoSubtitleCandidate($"managed:{track.Id:D}", track.Language, null, track.IsPreferred)))
                    .ToList(), canSwitch);
        }
    }
    private IReadOnlyList<PlaybackChapterDto> VideoChapters => Playback.CurrentItem?.Chapters ?? [];
    private IReadOnlyList<TextTrackDto> ManagedSubtitleTracks => _managedSubtitleTracks
        .Where(track => track.Kind.Equals("Subtitle", StringComparison.OrdinalIgnoreCase) || track.Kind.Equals("Subtitles", StringComparison.OrdinalIgnoreCase))
        .ToList();
    private bool VideoIsPlaying => Playback.IsPlaying && Playback.Phase is not (PlaybackPhase.Loading or PlaybackPhase.Error);
    private PlaybackControlState VideoControlState => new(
                ActiveSheet: Tools.OpenToolId,
                PlaybackRate: Playback.PlaybackRate,
                SkipBackSeconds: Playback.SkipBackSeconds,
                SkipForwardSeconds: Playback.SkipForwardSeconds,
                HasChapters: VideoChapters.Count > 0,
                HasQueue: Playback.CurrentIndex < Playback.Queue.Count - 1,
                IsTvEpisode: VideoPresentationResolver.IsTvEpisode(Playback.CurrentItem),
                IsFolderVideo: IsFolderVideoNow,
                IsMovie: IsMovie,
                HasCaptions: SubtitleTracks.Count > 0 || ManagedSubtitleTracks.Count > 0 || _captionTracks.Count > 0 || _availableSubtitleCount > 0,
                HasAudioTracks: AudioTracks.Count > 1 && _availableAudioTrackCount == AudioTracks.Count,
                CanBookmark: Playback.CurrentItem is { AssetId: not null } && Playback.ActiveProfileId is { } bookmarkProfile && bookmarkProfile != Guid.Empty,
