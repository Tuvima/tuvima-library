    {
        if (Services.GetService<PlaybackSettingsActions>() is { } actions && await actions.SetAutoplayNextEpisodeAsync(autoplay, _lifetimeCancellation.Token)) return;
        await ShowBookmarkNoticeAsync(L["PlaybackSettings_NotSaved"].Value);
