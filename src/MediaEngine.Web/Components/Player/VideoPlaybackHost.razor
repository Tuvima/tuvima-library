        if (Services.GetService<PlaybackSettingsActions>() is { } actions && await actions.SetSkipLengthAsync(change, _lifetimeCancellation.Token)) return;
        await ShowBookmarkNoticeAsync(L["PlaybackSettings_NotSaved"].Value);
