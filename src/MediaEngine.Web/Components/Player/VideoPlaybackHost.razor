        => JS.InvokeVoidAsync("listenPlayback.toggleFullscreen", _hostRef, _videoRef).AsTask();

    private async Task EnterPictureInPictureAsync()
    {
        if (!_canPictureInPicture) return;
        if (await JS.InvokeAsync<bool>("listenPlayback.togglePictureInPicture", _videoRef))
