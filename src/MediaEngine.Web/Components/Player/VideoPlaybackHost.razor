    private async Task HandleErrorAsync()
    {
        if (Playback.IsVideoMode)
        {
            // Tell the Engine so the next start of this kind of file uses a lighter-to-heavier rung (playback-path D13).
            if (Services.GetService(typeof(BrowserPlaybackCapabilityReporter)) is BrowserPlaybackCapabilityReporter abilityReporter)
            {
                await abilityReporter.ReportFailureAsync(Playback.CurrentManifest, "This video source failed to load or play.");
            }
            Playback.MarkCurrentFailed("This video source failed to load or play.");
        }
