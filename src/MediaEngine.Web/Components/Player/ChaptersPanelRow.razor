@namespace MediaEngine.Web.Components.Player
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Shared
@inject IStringLocalizer<SharedStrings> L

@* One row of the Chapters panel (unified player v2 D20; mockup screen 10). A row redraws only when what it shows changes, so the playing position moving a
   second at a time redraws the playing row and not the other two hundred; the panel rebuilds its list on every position update, but this part says no. *@
<PlaybackListRow Variant="chapter" Title="@Title" Length="@Length" Secondary="@Secondary" ProgressPercent="@ProgressPercent" IsCurrent="IsCurrent"
                 AriaLabel="@L["ChaptersPanel_PlayLabel", Title].Value" OnClick="@(() => OnPlay.InvokeAsync(Chapter))">
    <Leading><span class="chp__number">@Number</span></Leading>
    <Trailing>
        @if (IsCurrent)
        {
            <PlaybackActivityMark IsPlaying="@IsPlaying" Size="compact" />
        }
        else if (IsDone)
        {
            <span class="chp__done" data-chapter-done role="img" aria-label="@L["ChaptersPanel_Finished"].Value"><PlaybackUtilityGlyph Glyph="PlaybackUtilityGlyphKind.Check" /></span>
        }
    </Trailing>
</PlaybackListRow>

@code {
    private readonly record struct Shown(PlaybackChapterDto Chapter, int Number, string Title, string? Length, string? Secondary, double? ProgressPercent, bool IsCurrent, bool IsDone, bool IsPlaying);

    private Shown? _rendered;

    [Parameter, EditorRequired] public PlaybackChapterDto Chapter { get; set; } = null!;

    /// <summary>1 for the first chapter.</summary>
    [Parameter, EditorRequired] public int Number { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Length { get; set; }

    /// <summary>"12:08 elapsed · 18:32 remaining", for the playing chapter only.</summary>
    [Parameter] public string? Secondary { get; set; }
    [Parameter] public double? ProgressPercent { get; set; }
    [Parameter] public bool IsCurrent { get; set; }
    [Parameter] public bool IsDone { get; set; }
    [Parameter] public bool IsPlaying { get; set; }
    [Parameter] public EventCallback<PlaybackChapterDto> OnPlay { get; set; }

    private Shown Capture() => new(Chapter, Number, Title, Length, Secondary, ProgressPercent, IsCurrent, IsDone, IsCurrent && IsPlaying);

    // The first draw never asks ShouldRender, so the row remembers what it drew then; otherwise the first tick would redraw every row once.
    protected override void OnInitialized() => _rendered = Capture();

    protected override bool ShouldRender()
    {
        var shown = Capture();
        if (_rendered == shown) return false;
        _rendered = shown;
        return true;
    }
}
