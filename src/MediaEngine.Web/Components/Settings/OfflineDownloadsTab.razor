@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient
@inject IAppToastService Snackbar
@inject IStringLocalizer<SharedStrings> L

<div class="tl-page">
    <AppActionBar Align="AppHorizontalAlignment.End" Class="tl-sp-mb-4">
        <AppButton Label="@L["Ingestion_Refresh"].Value" StartIcon="@AppMaterialIcons.Outlined.Refresh" OnClick="@LoadJobsAsync" />
    </AppActionBar>

    <SettingsSectionPanel Title="@L["OfflineDownloadsTab_EncodeJobs"].Value"
                          Description="@L["OfflineDownloadsTab_CurrentAndQueuedWorkFor"].Value"
                          Icon="@AppMaterialIcons.Outlined.PendingActions">
        @if (_loading)
        {
            <AppProgressBar Indeterminate="true" />
        }
        else if (_jobs.Count == 0)
        {
            <AppEmptyState Title="@L["OfflineDownloadsTab_NoEncodeJobs"].Value"
                           Message="@L["OfflineDownloadsTab_OptimizedCopiesWillAppearHere"].Value" />
        }
        else
        {
            <div class="offline-downloads-table-wrap">
                <AppTable Class="offline-downloads-table" CardsOn="AppTableCardsMode.Phone">
                    <thead>
                        <tr>
                            <th data-card-role="title">@L["OfflineDownloadsTab_Asset"]</th>
                            <th data-card-role="subtitle">@L["Common_Profile"]</th>
                            <th data-card-role="value">@L["Models_Status"]</th>
                            <th>@L["Common_Progress"]</th>
                            <th>@L["AiFeatures_Scheduled"]</th>
                            <th>@L["OfflineDownloadsTab_Expires"]</th>
                            <th data-card-role="actions"><span class="sr-only">@L["ApiKeys_Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in _jobs)
                        {
                            <tr>
                                <td data-card-role="title">@job.AssetId</td>
                                <td data-card-role="subtitle">@job.ProfileKey</td>
                                <td data-card-role="value"><AppChip Text="@job.Status" Tone="@StatusTone(job.Status)" /></td>
                                <td data-label="Progress">@job.ProgressPct.ToString("0.#")%</td>
                                <td data-label="Scheduled">@(job.ScheduledFor?.LocalDateTime.ToString("g") ?? "Immediate")</td>
                                <td data-label="Expires">@(job.ExpiresAt?.LocalDateTime.ToString("g") ?? "None")</td>
                                <td data-card-role="actions">
                                    <AppButton Label="@L["Search_Cancel"].Value"
                                               ButtonStyle="AppButtonStyle.Text"
                                               Tone="AppUiTone.Warning"
                                               Size="AppControlSize.Compact"
                                               Disabled="@IsTerminal(job.Status)"
                                               OnClick="@(() => CancelAsync(job.Id))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </AppTable>
            </div>
        }
    </SettingsSectionPanel>

</div>

@code {
    private bool _loading;
    private List<EncodeJobDto> _jobs = [];

    protected override async Task OnInitializedAsync() => await LoadJobsAsync();

    private async Task LoadJobsAsync()
    {
        _loading = true;
        _jobs = await ApiClient.GetEncodeJobsAsync();
        _loading = false;
    }

    private async Task CancelAsync(Guid jobId)
    {
        var ok = await ApiClient.CancelEncodeJobAsync(jobId);
        Snackbar.Add(ok ? "Encode job cancelled" : "Encode job could not be cancelled", ok ? AppSeverity.Success : AppSeverity.Warning);
        await LoadJobsAsync();
    }

    private static bool IsTerminal(string status) =>
        status.Equals(EncodeJobStatuses.Complete, StringComparison.OrdinalIgnoreCase)
        || status.Equals(EncodeJobStatuses.Failed, StringComparison.OrdinalIgnoreCase)
        || status.Equals(EncodeJobStatuses.Cancelled, StringComparison.OrdinalIgnoreCase);

    private static AppUiTone StatusTone(string status) => status.ToLowerInvariant() switch
    {
        EncodeJobStatuses.Complete => AppUiTone.Success,
        EncodeJobStatuses.Failed => AppUiTone.Error,
        EncodeJobStatuses.Cancelled => AppUiTone.Neutral,
        EncodeJobStatuses.Running => AppUiTone.Info,
        _ => AppUiTone.Warning,
    };
}
