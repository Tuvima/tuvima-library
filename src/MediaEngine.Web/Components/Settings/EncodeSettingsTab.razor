@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Playback
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient
@inject IAppToastService Snackbar

<div class="tl-page encode-settings">
    @if (_loading)
    {
        <AppSkeleton Size="AppControlSize.Large" />
    }
    else if (IsSection("diagnostics"))
    {
        @if (_diagnostics is not null && !DeliveryChecksPassed)
        {
            <AppAlert Tone="AppUiTone.Warning">
                <div class="encode-settings__health">
                    <strong>Playback delivery needs attention</strong>
                    <span>@DeliveryDetail</span>
                </div>
            </AppAlert>
        }

        <SettingsSectionPanel Title="Playback checks"
                              Description="Technical checks reported directly by the Engine."
                              Icon="@AppMaterialIcons.Outlined.MonitorHeart">
            @if (_diagnostics is null)
            {
                <AppErrorState Title="Diagnostics are unavailable"
                               Message="The Engine did not return playback diagnostics. No sample status has been substituted." />
            }
            else
            {
                <div class="encode-settings__diagnostics">
                    <AppMetricCard Label="FFmpeg"
                                   Value="@ToolStatus(_diagnostics.FFmpegAvailable, _diagnostics.FFmpegVersion)"
                                   Tone="@(_diagnostics.FFmpegAvailable ? AppUiTone.Success : AppUiTone.Warning)" />
                    <AppMetricCard Label="Active encode jobs"
                                   Value="@_diagnostics.ActiveJobs.Count.ToString()" />
                </div>

                @if (_diagnostics.Warnings.Count > 0)
                {
                    <AppAlert Tone="AppUiTone.Warning" Class="tl-sp-mt-4">
                        <strong>Engine warnings</strong>
                        <ul class="encode-settings__warnings">
                            @foreach (var warning in _diagnostics.Warnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    </AppAlert>
                }
                else
                {
                    <AppAlert Tone="AppUiTone.Success" Class="tl-sp-mt-4">
                        The Engine reported no playback delivery warnings.
                    </AppAlert>
                }
            }
        </SettingsSectionPanel>
    }
    else if (!_settingsAvailable)
    {
        <AppErrorState Title="Playback delivery settings are unavailable"
                       Message="Start the Engine or retry before changing hardware acceleration and optimized copies." />
    }
    else if (IsSection("hardware"))
    {
        <SettingsSectionPanel Title="Hardware acceleration"
                              Description="Choose what the server uses to prepare video for playback. This is the one place to change it."
                              Icon="@AppMaterialIcons.Outlined.Memory">
            <div class="encode-settings__form">
                <AppSelect T="string" @bind-Value="_hardwarePreference" Label="Hardware acceleration" Options="@HardwareOptions" />
                <div class="encode-settings__current">
                    <strong>@DisplayHardware(_settings.HardwareAcceleration)</strong>
                    <span>Current Streaming preference</span>
                </div>
            </div>
        </SettingsSectionPanel>
        @SaveButton("Save hardware settings")
    }
    else
    {
        <SettingsSectionPanel Title="Optimized copies"
                              Description="Set how the server prepares media for playback and offline use."
                              Icon="@AppMaterialIcons.Outlined.VideoSettings">
            <div class="encode-settings__form">
                <AppSelect T="string" @bind-Value="_defaultProfile" Label="Prepared download quality" Options="@ProfileOptions" />
                <AppNumericField @bind-Value="_maxConcurrentJobs" Label="Maximum active encodes" Min="1" Max="4" />
            </div>
        </SettingsSectionPanel>

        <SettingsSectionPanel Title="Scheduling"
                              Description="Limit optimized copy work to a predictable maintenance window."
                              Icon="@AppMaterialIcons.Outlined.Schedule">
            <div class="encode-settings__form">
                <AppSwitchRow @bind-Value="_scheduledEncodesEnabled"
                              Label="Schedule prepared encodes"
                              Description="Queue non-urgent optimized copy work for the maintenance window." />
                <AppTextField @bind-Value="_maintenanceWindow"
                              Label="Maintenance window"
                              HelpText="Use 24-hour time, for example 01:00-05:00." />
            </div>
        </SettingsSectionPanel>

        <SettingsSectionPanel Title="Optimized copy storage"
                              Description="Control where prepared playback files are kept and when they are removed."
                              Icon="@AppMaterialIcons.Outlined.Storage">
            <div class="encode-settings__form">
                <AppTextField @bind-Value="_variantRoot"
                              Label="Cache location" />
                <AppNumericField @bind-Value="_cacheSizeGb"
                                 Label="Cache size limit (GB)"
                                 Min="1"
                                 Max="5000" />
                <AppNumericField @bind-Value="_retentionDays"
                                 Label="Keep unused optimized copies for"
                                 HelpText="Number of days before unused optimized copies become eligible for cleanup."
                                 Min="1"
                                 Max="3650" />
                <AppSwitchRow @bind-Value="_cleanupLru"
                              Label="Remove least-used optimized copies first"
                              Description="Free space by removing the least recently used prepared files before newer ones." />
            </div>
        </SettingsSectionPanel>
        @SaveButton("Save optimized copy settings")

        <OfflineDownloadsTab />
    }
</div>

@code {
    [Parameter] public string Section { get; set; } = "optimized-copies";

    private TranscodingSettings _settings = new();
    private bool _loading = true;
    private bool _settingsAvailable;
    private bool _saving;
    private bool _scheduledEncodesEnabled;
    private string _maintenanceWindow = string.Empty;
    private int _maxConcurrentJobs;
    private string _hardwarePreference = string.Empty;
    private string _variantRoot = string.Empty;
    private int _cacheSizeGb;
    private int _retentionDays;
    private bool _cleanupLru;
    private string _defaultProfile = string.Empty;
    private PlaybackDiagnosticsDto? _diagnostics;

    private static readonly IReadOnlyList<AppSelectOption> HardwareOptions =
    [
        new("auto", "Automatic"),
        new("cpu", "CPU"),
        new("gpu", "GPU when available"),
    ];

    private IReadOnlyList<AppSelectOption> ProfileOptions =>
        _settings.QualityProfiles
            .Select(profile => new AppSelectOption(profile.Name, $"{profile.Name} · {profile.Resolution}"))
            .ToList();

    private bool DeliveryChecksPassed =>
        _diagnostics is { FFmpegAvailable: true }
        && _diagnostics.Warnings.Count == 0;

    private string DeliveryDetail => DeliveryChecksPassed
        ? string.Empty
        : _diagnostics!.Warnings.FirstOrDefault()
          ?? "One or more required media tools are unavailable.";

    private static string DisplayHardware(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Unavailable" : value == "auto" ? "Automatic" : value;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;

        if (IsSection("diagnostics"))
        {
            _diagnostics = await ApiClient.GetPlaybackDiagnosticsAsync();
        }
        else
        {
            var settings = await ApiClient.GetTranscodingSettingsAsync();
            _settingsAvailable = settings is not null;
            if (settings is not null)
            {
                _settings = settings;
                HydrateForm(settings);
            }
        }

        _loading = false;
    }

    private bool IsSection(string section) =>
        string.Equals(Section, section, StringComparison.OrdinalIgnoreCase);

    private static string ToolStatus(bool available, string? version) =>
        available
            ? string.IsNullOrWhiteSpace(version) ? "Available" : version
            : "Unavailable";

    private RenderFragment SaveButton(string label) => @<div class="encode-settings__save-row">
        <AppButton Label="@(_saving ? "Saving..." : label)"
                   StartIcon="@AppMaterialIcons.Outlined.Save"
                   ButtonStyle="AppButtonStyle.Filled"
                   Tone="AppUiTone.Primary"
                   Disabled="@_saving"
                   OnClick="@SaveAsync" />
    </div>;

    private async Task SaveAsync()
    {
        if (!_settingsAvailable)
            return;

        _saving = true;
        ApplyForm(_settings);
        var saved = await ApiClient.SaveTranscodingSettingsAsync(_settings);
        _saving = false;

        if (saved is null)
        {
            Snackbar.Add("Optimized copy settings could not be saved.", AppSeverity.Error);
            return;
        }

        _settings = saved;
        HydrateForm(_settings);
        Snackbar.Add("Playback delivery settings saved.", AppSeverity.Success);
    }

    private void HydrateForm(TranscodingSettings settings)
    {
        _defaultProfile = settings.DefaultMobileProfile;
        _scheduledEncodesEnabled = settings.ScheduledEncodesEnabled;
        _maintenanceWindow = settings.MaintenanceWindow;
        _maxConcurrentJobs = settings.MaxConcurrentTranscodes;
        _hardwarePreference = settings.HardwareAcceleration;
        _variantRoot = settings.VariantCachePath;
        _cacheSizeGb = settings.ShadowStorageLimitGb;
        _retentionDays = settings.VariantRetentionDays;
        _cleanupLru = settings.CleanupLruEnabled;
    }

    private void ApplyForm(TranscodingSettings settings)
    {
        settings.DefaultMobileProfile = _defaultProfile;
        settings.ScheduledEncodesEnabled = _scheduledEncodesEnabled;
        settings.MaintenanceWindow = _maintenanceWindow;
        settings.MaxConcurrentTranscodes = _maxConcurrentJobs;
        settings.HardwareAcceleration = _hardwarePreference;
        settings.VariantCachePath = _variantRoot;
        settings.ShadowStorageLimitGb = _cacheSizeGb;
        settings.VariantRetentionDays = _retentionDays;
        settings.CleanupLruEnabled = _cleanupLru;
    }
}
