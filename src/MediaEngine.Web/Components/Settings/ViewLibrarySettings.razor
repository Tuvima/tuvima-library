@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.LocalAssets
@using System.Text.Json
@inject IEngineApiClient ApiClient
@inject IAppDialogService DialogService
@inject IAppToastService Snackbar

<div class="library-detail">
    <LibraryDetailHeader Title="View" Description="Personal photos, videos, documents, and recordings · Local files" Icon="@AppMaterialIcons.Outlined.PhotoLibrary">
        <AppStatusBadge Text="View" Tone="AppUiTone.Primary" />
    </LibraryDetailHeader>
    <div class="libraries-card__heading"><div><h2>Library Settings</h2><p>Each profile has a private space. Accepted contributions appear in Shared Library.</p></div></div>
    <AppCard Class="libraries-card">
        <div class="libraries-card__heading"><div><h3>Folders</h3><p>One storage base for Shared Library and each profile’s private files.</p></div>
            <AppButton Label="Add folder" StartIcon="@AppMaterialIcons.Outlined.Add" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(ReadOnly || _busy)" OnClick="@(() => _adding = !_adding)" />
        </div>
        <div class="view-storage-root">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Storage" />
            <div><strong>View library root</strong><code>@RootPath</code><small>The base folder for all managed View storage.</small></div>
            <AppButton Label="Choose root" ButtonStyle="AppButtonStyle.Outlined" Disabled="@(ReadOnly || _busy)" OnClick="ChooseRootAsync" />
        </div>
        <div class="view-storage-destinations">
            <div><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FolderShared" /><span><strong>Shared Library</strong><code>@Path.Combine(RootPath, "Shared")</code><small>Server-owned originals from accepted, verified contributions.</small></span></div>
            <div><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.AccountCircle" /><span><strong>Profile personal spaces</strong><code>@Path.Combine(RootPath, "Profiles")</code><small>One private space per profile. Folders appear automatically when the first file is added.</small></span></div>
        </div>
        <p class="library-detail__note">These are storage destinations. Empty profile folders are not created in advance. Choosing a root does not move existing files.</p>
        @if (_adding)
        {
            <div class="libraries-form-grid">
                <AppSelect Label="Owner profile" Value="@_owner" ValueChanged="@((string? value) => _owner = value)" Options="@OwnerOptions" Disabled="@_busy" />
                <AppTextField Label="Folder name" Value="@_name" ValueChanged="@((string? value) => _name = value ?? string.Empty)" ReadOnly="@_busy" />
                <AppSelect Label="Folder management" Value="@_mode" ValueChanged="@((string? value) => { _mode = value ?? "linked"; _path = null; })" Options="@ModeOptions" Disabled="@_busy" />
                @if (_mode == "linked")
                {
                    <AppButton Label="Choose existing folder" ButtonStyle="AppButtonStyle.Outlined" Disabled="@_busy" OnClick="ChooseSourceAsync" />
                    <code>@(_path ?? "No folder selected")</code>
                    <AppSwitchRow Label="Include subfolders" Value="@_recursive" ValueChanged="@((bool value) => _recursive = value)" Disabled="@_busy" />
                }
                <AppSwitchRow Label="Show in Photos timeline" Description="Folders remain browsable even when excluded from the timeline." Value="@_timeline" ValueChanged="@((bool value) => _timeline = value)" Disabled="@_busy" />
            </div>
            <p>@(_mode == "linked" ? "Files remain where they are and are indexed read-only." : "Create an empty managed folder in this profile’s Personal Space. Existing files are not moved.")</p>
            <AppActionBar><AppButton Label="Cancel" ButtonStyle="AppButtonStyle.Text" Disabled="@_busy" OnClick="@(() => _adding = false)" /><AppButton Label="Add folder" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_busy" Disabled="@(_busy || string.IsNullOrWhiteSpace(_owner) || string.IsNullOrWhiteSpace(_name) || (_mode == "linked" && _path is null))" OnClick="AddAsync" /></AppActionBar>
        }
        @if (_loading) { <p role="status">Loading personal sources…</p> }
        @if (_error is not null) { <AppAlert Tone="AppUiTone.Error">@_error</AppAlert> }
        @foreach (var profile in _profiles)
        {
            <div class="view-source-group">
                <h4>@profile.DisplayName</h4>
                @if (!_reviews.TryGetValue(profile.Id, out var review)) { <p>Sources unavailable.</p> }
                else if (review.PersonalSpace is null) { <p>No files yet — a Personal Space is created automatically when needed.</p> }
                else
                {
                    <code>@review.PersonalSpace.RootPath</code>
                    <div class="view-source-table">
                    <div class="view-source-head" aria-hidden="true"><span>Folder</span><span>Management</span><span>Subfolders</span><span>Photos</span><span>Status</span><span>Actions</span></div>
                    @foreach (var source in review.Sources)
                    {
                        <div class="view-source-row" @key="source.Id">
                            <span><strong>@source.Name</strong><code>@source.Location</code></span>
                            <span>@SourcePolicy(source)</span>
                            <span>@(source.IncludeSubdirectories ? "Includes subfolders" : "This folder only")</span>
                            <AppSwitchRow Label="Timeline" Value="@source.IncludeInTimeline" ValueChanged="@((bool value) => SetTimelineAsync(profile.Id, source, value))" Disabled="@(ReadOnly || _busy)" />
                            <AppStatusBadge Text="@(source.Enabled ? "Indexing enabled" : "Disabled")" Tone="AppUiTone.Neutral" />
                            <AppIconButton Icon="@AppMaterialIcons.Outlined.Delete" AriaLabel="@($"Detach {source.Name}")" Tooltip="Detach folder; keep files" Disabled="@(ReadOnly || _busy || source.SourceType == "browser_upload")" OnClick="@(() => DetachAsync(profile.Id, source))" />
                        </div>
                    }
                    </div>
                }
            </div>
        }
    </AppCard>
    <AppCard Class="libraries-card">
        <div class="libraries-card__heading"><div><h3>Organization</h3><p>How files are stored depends on how they are added.</p></div></div>
        <div class="view-organization">
            <article><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CalendarMonth" /><div><strong>Browser uploads</strong><small>Organized by capture date in the profile’s Timeline.</small><code>Timeline / year / month / file</code></div></article>
            <article><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FolderCopy" /><div><strong>Managed folders</strong><small>Keep their folder hierarchy and original filenames.</small><code>Folders / folder name / files</code></div></article>
            <article><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Link" /><div><strong>Linked folders</strong><small>Files stay in their existing location and are indexed read-only.</small><code>Existing folder / files</code></div></article>
        </div>
    </AppCard>
    <AppCard Class="libraries-card">
        <div class="libraries-card__heading"><div><h3>File Handling</h3><p>Originals remain protected throughout indexing and sharing.</p></div></div>
        <div class="view-policy-row"><div><strong>Linked originals</strong><small>Tuvima Library reads their local file details and thumbnails.</small></div><span>Read-only · Files stay in place</span></div>
        <div class="view-policy-row"><div><strong>Detach a folder</strong><small>Remove its connection to View.</small></div><span>Keep all original files</span></div>
        <div class="view-policy-row"><div><strong>Contribute to Shared Library</strong><small>Files transfer only after acceptance and destination verification.</small></div><span>Managed originals move · Linked originals copy</span></div>
    </AppCard>
    <AppCard Class="libraries-card">
        <div class="libraries-card__heading"><div><h3>Sharing &amp; Access</h3><p>Private files remain with their owning profile until shared through an allowed workflow.</p></div><AppButton Href="/settings/access" Label="Manage access" ButtonStyle="AppButtonStyle.Text" EndIcon="@AppMaterialIcons.Outlined.ChevronRight" /></div>
        <p>Shared Library access, contribution submission and review, and Gallery sharing have independent permissions.</p>
    </AppCard>
    <details class="library-detail__advanced"><summary><strong>Advanced Settings</strong></summary><p>View uses local file details, capture dates, available location metadata, and supported thumbnails. Personal media does not use external catalog providers or the Review Queue.</p></details>
</div>

@code {
    [Parameter, EditorRequired] public LibrariesConfigurationDto Configuration { get; set; } = default!;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback RootChanged { get; set; }
    private List<ProfileViewModel> _profiles = [];
    private readonly Dictionary<Guid, ViewPersonalSpaceAdminReviewDto> _reviews = [];
    private bool _loading = true, _busy, _adding, _recursive = true, _timeline;
    private string? _owner, _path, _error;
    private string _name = string.Empty, _mode = "linked";
    private string RootPath => Path.Combine(Configuration.StorageLocations.FirstOrDefault(x => x.Id == Configuration.ViewStorage.StorageLocationId)?.Path ?? "", Configuration.ViewStorage.RelativeRoot);
    private IReadOnlyList<AppSelectOption> OwnerOptions => _profiles.Select(p => new AppSelectOption(p.Id.ToString(), p.DisplayName)).ToList();
    private static readonly IReadOnlyList<AppSelectOption> ModeOptions = [new("linked", "Existing folder — read-only"), new("managed", "New managed folder")];

    protected override async Task OnInitializedAsync() => await LoadSourcesAsync();
    private async Task LoadSourcesAsync()
    {
        _loading = true;
        _profiles = await ApiClient.GetProfilesAsync();
        var results = await Task.WhenAll(_profiles.Select(async p => (p.Id, Review: await ApiClient.GetViewProfileSourcesAsync(p.Id))));
        _reviews.Clear();
        foreach (var (id, review) in results) if (review is not null) _reviews[id] = review;
        _loading = false;
    }
    private async Task ChooseSourceAsync()
    {
        var selected = await PickAsync(_path ?? "", ServerFolderSelectionModes.PersonalSpaceExisting);
        if (selected is not null) _path = selected.Path;
    }
    private async Task ChooseRootAsync()
    {
        var selected = await PickAsync(RootPath, ServerFolderSelectionModes.PersonalSpaceManaged);
        if (selected is null) return;
        _busy = true;
        try
        {
            var saved = await ApiClient.MutateLibraryAsync(new LibraryMutationRequest
            {
                ExpectedViewStorage = Configuration.ViewStorage,
                ViewStorage = new ViewStorageDto { StorageLocationId = selected.StorageLocationId, RelativeRoot = string.IsNullOrWhiteSpace(selected.RelativePath) ? "." : selected.RelativePath },
            });
            if (saved is null) _error = ApiClient.LastError ?? "Root could not be saved.";
            else { _error = null; Snackbar.Add("View root saved.", AppSeverity.Success); await RootChanged.InvokeAsync(); await LoadSourcesAsync(); }
        }
        finally { _busy = false; }
    }
    private async Task<ServerFolderValidationResultDto?> PickAsync(string path, string mode)
    {
        var dialog = await DialogService.ShowAsync<ServerFolderPicker>(string.Empty, new AppDialogParameters<ServerFolderPicker>
        {
            { x => x.InitialPath, path }, { x => x.SelectionMode, mode },
        }, new AppDialogOptions { MaxWidth = AppMaxWidth.ExtraExtraLarge, CloseButton = false, CloseOnEscapeKey = true });
        return await dialog.Result is { Canceled: false, Data: ServerFolderValidationResultDto result } ? result : null;
    }
    private async Task AddAsync()
    {
        if (!Guid.TryParse(_owner, out var owner) || _busy) return;
        _busy = true;
        try
        {
            var result = await ApiClient.CreateViewProfileSourceAsync(owner, new CreateViewSourceRequest(_name, _mode, _path, _recursive, _timeline));
            if (result is null) _error = ApiClient.LastError ?? "Folder could not be added.";
            else { _adding = false; _error = null; _name = ""; _path = null; await LoadSourcesAsync(); Snackbar.Add("Folder saved. Indexing runs separately.", AppSeverity.Success); }
        }
        finally { _busy = false; }
    }
    private async Task SetTimelineAsync(Guid owner, ViewSourceAdminDto source, bool value)
    {
        _busy = true;
        try
        {
            var updated = await ApiClient.UpdateViewProfileSourceAsync(owner, source.Id,
                new UpdateViewSourceRequest(source.Name, source.Enabled, value));
            if (updated is null) _error = ApiClient.LastError ?? "Timeline setting could not be saved.";
            else { await LoadSourcesAsync(); Snackbar.Add(value ? "Folder added to Photos timeline." : "Folder remains available in Folders only.", AppSeverity.Success); }
        }
        finally { _busy = false; }
    }
    private static string SourcePolicy(ViewSourceAdminDto source) => source.StorageMode == "linked"
        ? "Read-only · Keep existing layout"
        : source.SourceType == "browser_upload"
            ? "Managed · Calendar timeline"
            : "Managed · Keep existing layout";
    private async Task DetachAsync(Guid owner, ViewSourceAdminDto source)
    {
        if (await DialogService.ShowMessageBoxAsync("Detach folder?", $"Detach {source.Name}? Original files remain at {source.Location}.", yesText: "Detach folder", cancelText: "Cancel") != true) return;
        _busy = true;
        try
        {
            if (await ApiClient.DeleteViewProfileSourceAsync(owner, source.Id)) { await LoadSourcesAsync(); Snackbar.Add("Folder detached. Files kept.", AppSeverity.Success); }
            else _error = ApiClient.LastError ?? "Folder could not be detached.";
        }
        finally { _busy = false; }
    }
}
