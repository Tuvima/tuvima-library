@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Artwork
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Components.Shared
@inject IEngineApiClient ApiClient
@inject IAppToastService Snackbar
@inject ILogger<LibraryAdvancedSettings> Logger

@* File handling and naming. Global rows first, then one tab per media type. The host (LibraryFoldersPanel) owns every save. *@
<div class="library-advanced">
    <div class="library-advanced__global" role="group" aria-label="File handling for every type">
        <div class="library-advanced__row">
            <div>
                <strong>When the same file arrives twice</strong>
                <small>Tuvima compares file contents, so renamed copies count as the same file.</small>
            </div>
            <AppSegmentedControl Options="DuplicateOptions"
                                 Value="@DuplicatePolicy"
                                 ValueChanged="@(value => OnDuplicatePolicyChanged.InvokeAsync(value))"
                                 AriaLabel="When the same file arrives twice"
                                 Disabled="@(ReadOnly || Busy)" />
        </div>
        <AppSwitchRow Label="Embed artwork in files"
                      Description="Puts cover art inside the files Tuvima writes tags to. Available while at least one type has tags switched on."
                      Value="@(_artwork?.ArtworkEnabled ?? false)"
                      ValueChanged="SetArtworkAsync"
                      Disabled="@(ReadOnly || Busy || _savingArtwork || !AnyTagsOn)" />
        <div class="library-advanced__row">
            <div>
                <strong>When a file with the same name already exists</strong>
                <small>The new file gets a unique name; nothing is overwritten.</small>
            </div>
        </div>
    </div>

    <AppTabs @bind-ActivePanelIndex="_tab" Label="Media type" Class="library-advanced__tabs">
        @foreach (var type in Types)
        {
            <AppTabPanel Text="@type.Label">
                @TypePanel(type)
            </AppTabPanel>
        }
    </AppTabs>
</div>

@code {
    /// <summary>A media type tab. <see cref="TemplateKey"/> is its key in <c>organization_templates</c>.</summary>
    public sealed record AdvancedType(string Key, string Label, string TemplateKey, LibraryFolderDto? Library);

    private static readonly IReadOnlyList<AppSelectOption> DuplicateOptions =
    [
        new("keep_one", "Keep one copy"),
        new("keep_both", "Keep both"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> NamingOptions =
    [
        new("tuvima_standard", "Tuvima standard"),
        new("keep_original_names", "Keep original names"),
        new("custom", "Custom template"),
    ];

    private static readonly Dictionary<string, string> TokensByType = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Movies"] = "{Title} {Year} {Ext}",
        ["TV"] = "{Series} {Year} {Season} {Episode} {EpisodeTitle} {Ext}",
        ["Music"] = "{AlbumArtist} {Album} {Year} {TrackNumber} {Title} {Ext}",
        ["Books"] = "{Author} {Title} {Year} {Ext}",
        ["Audiobooks"] = "{Author} {BookTitle} {Year} {TrackNumber} {TrackTitle} {Ext}",
        ["Comics"] = "{Series} {IssueNumber} {Year} {Ext}",
    };

    private static readonly Dictionary<string, string> FallbackExamples = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Movies"] = "Movies/Dune (2021)/Dune (2021).mkv",
        ["TV"] = "TV/Severance (2022)/Season 01/Severance - s01e01 - Good News About Hell.mkv",
        ["Music"] = "Music/Radiohead/OK Computer (1997)/01 - Airbag.flac",
        ["Books"] = "Books/Frank Herbert/Dune (1965)/Dune (1965).epub",
        ["Audiobooks"] = "Audiobooks/Frank Herbert/Dune (1965)/01 Chapter 1.m4b",
        ["Comics"] = "Comics/Saga/Saga - 001 (2012).cbz",
    };

    [Parameter] public IReadOnlyList<AdvancedType> Types { get; set; } = [];
    [Parameter] public string DuplicatePolicy { get; set; } = "keep_one";
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Busy { get; set; }
    /// <summary>Raised with an edited copy of one type's library; the host saves it.</summary>
    [Parameter] public EventCallback<LibraryFolderDto> OnLibraryChanged { get; set; }
    [Parameter] public EventCallback<string> OnDuplicatePolicyChanged { get; set; }

    private int _tab;
    private ArtworkWritebackSettingsDto? _artwork;
    private bool _savingArtwork;
    private Dictionary<string, string>? _standardTemplates;
    private readonly Dictionary<string, string> _standardExamples = new(StringComparer.OrdinalIgnoreCase);

    // The custom template being typed per type; null means the type is not being edited.
    private readonly Dictionary<string, string> _drafts = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string?> _draftErrors = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string?> _draftExamples = new(StringComparer.OrdinalIgnoreCase);

    private bool AnyTagsOn => Types.Any(type => type.Library?.OrganizationPolicy.WriteTags == true);

    protected override async Task OnInitializedAsync()
    {
        _artwork = await ApiClient.GetArtworkWritebackSettingsAsync();
        var templates = await ApiClient.GetOrganizationTemplateAsync();
        _standardTemplates = templates?.Templates;
        foreach (var type in Types)
        {
            if (_standardTemplates is null || !_standardTemplates.TryGetValue(type.TemplateKey, out var template)) continue;
            try
            {
                var preview = await ApiClient.PreviewOrganizationTemplateAsync(template);
                if (!string.IsNullOrWhiteSpace(preview?.Preview)) _standardExamples[type.Key] = preview.Preview!;
            }
            catch (Exception ex)
            {
                // The example is a nicety: keep the built-in sample for this type and carry on.
                Logger.LogWarning(ex, "Naming example for {Type} could not be loaded", type.Key);
            }
        }
    }

    private RenderFragment TypePanel(AdvancedType type) => __builder =>
    {
        var library = type.Library;
        if (library is null)
        {
            <p class="library-advanced__note">Add a folder to @type.Label first. Its naming and tag settings appear here afterwards.</p>
            return;
        }

        var policy = library.OrganizationPolicy;
        var editingCustom = _drafts.ContainsKey(type.Key) || policy.Mode == "custom";
        var selected = editingCustom ? "custom" : policy.Mode;
        var hasManaged = library.Sources.Any(source => source.ManagementMode == "managed_by_tuvima");
        <div class="library-advanced__type">
            <section aria-label="@($"{type.Label} naming")">
                <h4>Naming</h4>
                <AppSegmentedControl Options="NamingOptions"
                                     Value="@selected"
                                     ValueChanged="@(value => ChooseNamingAsync(type, value))"
                                     AriaLabel="@($"{type.Label} naming")"
                                     Disabled="@(ReadOnly || Busy)" />
                @if (editingCustom)
                {
                    <AppTextField Label="Naming template"
                                  Value="@DraftFor(type)"
                                  ValueChanged="@((string? value) => EditDraftAsync(type, value))"
                                  Error="@(!string.IsNullOrEmpty(_draftErrors.GetValueOrDefault(type.Key)))"
                                  ErrorText="@_draftErrors.GetValueOrDefault(type.Key)"
                                  HelpText="@($"Tokens: {TokensByType.GetValueOrDefault(type.TemplateKey, "{Title} {Year} {Ext}")}. Add ? after a token, like {{TrackNumber?}}, to leave it out when empty.")"
                                  Disabled="@(ReadOnly || Busy)" />
                    <div class="library-advanced__actions">
                        <AppButton Label="Apply template"
                                   ButtonStyle="AppButtonStyle.Filled"
                                   Tone="AppUiTone.Primary"
                                   Disabled="@(ReadOnly || Busy || !CanApply(type))"
                                   OnClick="@(() => ApplyCustomAsync(type))" />
                    </div>
                }
                <div class="library-advanced__example"><span>Example</span><code>@ExampleFor(type, selected)</code></div>
                @if (hasManaged)
                {
                    <p class="library-advanced__note">A change applies to files Tuvima adds from now on.</p>
                }
            </section>
            <section aria-label="@($"{type.Label} tags")">
                <h4>Tags</h4>
                <AppSwitchRow Label="Update tags inside files"
                              Description="Tuvima writes title, people, artwork and other fields into files in managed folders where the file type allows it (MP3, M4A/M4B, FLAC, MP4/MKV, EPUB; PDF and CBZ are never changed). A backup copy is kept while writing. Files it cannot write are left as they are."
                              Value="@policy.WriteTags"
                              ValueChanged="@(value => SetTagsAsync(type, value))"
                              Disabled="@(ReadOnly || Busy)" />
            </section>
        </div>
    };

    private string DraftFor(AdvancedType type) => _drafts.TryGetValue(type.Key, out var draft)
        ? draft
        : type.Library?.OrganizationPolicy.CustomTemplate ?? StandardTemplate(type) ?? string.Empty;

    private string? StandardTemplate(AdvancedType type) =>
        _standardTemplates is not null && _standardTemplates.TryGetValue(type.TemplateKey, out var template) ? template : null;

    private string ExampleFor(AdvancedType type, string mode) => mode switch
    {
        "keep_original_names" => "Original Folder/Original Name.ext",
        "custom" => _draftExamples.GetValueOrDefault(type.Key) ?? "Type a template to see an example",
        _ => _standardExamples.GetValueOrDefault(type.Key) ?? FallbackExamples.GetValueOrDefault(type.TemplateKey, "Library/Organised Item.ext"),
    };

    // A template can be applied once its latest edit validated and it differs from what is saved.
    private bool CanApply(AdvancedType type) => _drafts.TryGetValue(type.Key, out var draft)
        && !string.IsNullOrWhiteSpace(draft)
        && string.IsNullOrEmpty(_draftErrors.GetValueOrDefault(type.Key))
        && !string.IsNullOrEmpty(_draftExamples.GetValueOrDefault(type.Key));

    private async Task ChooseNamingAsync(AdvancedType type, string? mode)
    {
        if (type.Library is null || mode is null) return;
        if (mode == "custom")
        {
            // Custom is a coupled edit: the template must validate before anything is saved.
            _drafts[type.Key] = DraftFor(type);
            await EditDraftAsync(type, _drafts[type.Key]);
            return;
        }

        _drafts.Remove(type.Key);
        _draftErrors.Remove(type.Key);
        _draftExamples.Remove(type.Key);
        var edited = Copy(type.Library);
        edited.OrganizationPolicy.Mode = mode;
        edited.OrganizationPolicy.CustomTemplate = null;
        await OnLibraryChanged.InvokeAsync(edited);
    }

    private async Task EditDraftAsync(AdvancedType type, string? value)
    {
        var template = value ?? string.Empty;
        _drafts[type.Key] = template;
        if (string.IsNullOrWhiteSpace(template))
        {
            _draftErrors[type.Key] = "Enter a template, for example the Tuvima standard one.";
            _draftExamples[type.Key] = null;
            return;
        }

        var preview = await ApiClient.PreviewOrganizationTemplateAsync(template);
        // Ignore an answer for text the person has already edited past.
        if (!string.Equals(_drafts.GetValueOrDefault(type.Key), template, StringComparison.Ordinal)) return;
        if (string.IsNullOrWhiteSpace(preview?.Preview))
        {
            _draftErrors[type.Key] = "That template isn't valid. Use only the tokens listed, each inside { } braces.";
            _draftExamples[type.Key] = null;
        }
        else
        {
            _draftErrors[type.Key] = null;
            _draftExamples[type.Key] = preview.Preview;
        }
    }

    private async Task ApplyCustomAsync(AdvancedType type)
    {
        if (type.Library is null || !CanApply(type)) return;
        var edited = Copy(type.Library);
        edited.OrganizationPolicy.Mode = "custom";
        edited.OrganizationPolicy.CustomTemplate = _drafts[type.Key].Trim();
        await OnLibraryChanged.InvokeAsync(edited);
        _drafts.Remove(type.Key);
    }

    private async Task SetTagsAsync(AdvancedType type, bool enabled)
    {
        if (type.Library is null) return;
        var edited = Copy(type.Library);
        edited.OrganizationPolicy.WriteTags = enabled;
        await OnLibraryChanged.InvokeAsync(edited);
    }

    private async Task SetArtworkAsync(bool enabled)
    {
        _savingArtwork = true;
        try
        {
            var updated = await ApiClient.UpdateArtworkWritebackSettingsAsync(new UpdateArtworkWritebackSettingsDto(enabled));
            if (updated is null) Snackbar.Add("The artwork setting could not be saved.", AppSeverity.Error);
            else _artwork = updated;
        }
        finally { _savingArtwork = false; }
    }

    private static LibraryFolderDto Copy(LibraryFolderDto library) =>
        System.Text.Json.JsonSerializer.Deserialize<LibraryFolderDto>(System.Text.Json.JsonSerializer.Serialize(library))!;
}
