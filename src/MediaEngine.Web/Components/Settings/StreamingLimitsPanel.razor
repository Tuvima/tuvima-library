@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient
@inject IAppToastService Snackbar
@inject DeviceContextService DeviceContext
@inject IStringLocalizer<SharedStrings> L

<div class="streaming-limits">
    <header class="streaming-limits__heading"><div><h3>@L["Common_LimitsAndQuality"]</h3><p>@L["StreamingLimitsPanel_ProtectYourUploadConnectionWhile"]</p></div></header>

    @if (!DeviceContext.IsMobile)
    {
        <SettingsSectionPanel Title="@L["StreamingLimitsPanel_RemoteStreamingQuality"].Value" Icon="@AppMaterialIcons.Outlined.HighQuality">
            <AppSelect T="string" @bind-Value="Settings.Streaming.RemoteQuality"
                       Label="@L["StreamingLimitsPanel_Quality"].Value" Options="@QualityOptions" />
            <AppSwitchRow Label="@L["StreamingLimitsPanel_AutomaticUploadProtection"].Value"
                          Description="@L["StreamingLimitsPanel_KeepBandwidthAvailableForThe"].Value"
                          Value="@Settings.Streaming.UploadProtectionEnabled"
                          ValueChanged="ChangeUploadProtectionAsync" />
            <AppNumericField @bind-Value="Settings.Streaming.ReservedUploadMbps"
                             Label="@L["StreamingLimitsPanel_BandwidthReservedForOtherTraffic"].Value" Min="0" Max="10000" />
            <div class="streaming-limits__actions"><AppButton Label="@L["StreamingLimitsPanel_SaveStreamingSettings"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="SaveRequested" /></div>
        </SettingsSectionPanel>
    }

    <SettingsSectionPanel Title="@L["StreamingLimitsPanel_UploadCapacity"].Value" Icon="@AppMaterialIcons.Outlined.Speed">
        <dl class="streaming-limits__bandwidth-grid">
            @Fact("Upload Capacity", FormatBandwidth(Status?.Bandwidth.UploadCapacityMbps))
            @Fact("Reserved", $"{Settings.Streaming.ReservedUploadMbps} Mbps")
            @Fact("Available to Library", FormatBandwidth(Status?.Bandwidth.AvailableMbps))
        </dl>
        @if (_bandwidth is { Status: "unavailable" })
        {
            <AppAlert Tone="AppUiTone.Info">@L["StreamingLimitsPanel_ATrustedExternalMeasurementTarget"]</AppAlert>
        }
        <div class="streaming-limits__actions"><AppButton Label="@L["StreamingLimitsPanel_TestBandwidth"].Value" StartIcon="@AppMaterialIcons.Outlined.NetworkCheck" OnClick="TestBandwidthAsync" /></div>
    </SettingsSectionPanel>

    <p class="streaming-limits__supporting-copy">@L["StreamingLimitsPanel_LibraryConsidersAvailableUploadBandwidth"]</p>
</div>

@code {
    [Parameter, EditorRequired] public NetworkSettingsDto Settings { get; set; } = new();
    [Parameter] public NetworkRuntimeStatusDto? Status { get; set; }
    [Parameter] public EventCallback SaveRequested { get; set; }
    [Parameter] public EventCallback StatusRefreshRequested { get; set; }

    private NetworkBandwidthStatusDto? _bandwidth;
    private static readonly IReadOnlyList<AppSelectOption> QualityOptions =
    [
        new("automatic", "Automatic — Recommended"),
        new("original", "Maximum / Original"),
        new("1080p", "1080p"),
        new("720p", "720p"),
        new("data-saver", "Data Saver"),
    ];

    private async Task ChangeUploadProtectionAsync(bool value)
    {
        Settings.Streaming.UploadProtectionEnabled = value;
        await SaveRequested.InvokeAsync();
    }

    private async Task TestBandwidthAsync()
    {
        _bandwidth = await ApiClient.TestNetworkBandwidthAsync();
        if (_bandwidth?.Status == "unavailable")
            Snackbar.Add(L["StreamingLimitsPanel_BandwidthTestingNeedsATrusted"].Value, AppSeverity.Info);
        await StatusRefreshRequested.InvokeAsync();
    }

    private static string FormatBandwidth(double? value) => value.HasValue ? $"{value.Value:0.#} Mbps" : "Not tested";
    private static RenderFragment Fact(string label, string value) => @<div><dt>@label</dt><dd>@value</dd></div>;
}
