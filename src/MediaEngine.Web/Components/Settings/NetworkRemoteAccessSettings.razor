@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient
@inject IAppToastService Snackbar
@inject IStringLocalizer<SharedStrings> L

<section class="network-settings" data-network-section="@ActiveSection">
    @if (_loading)
    {
        <AppSkeleton Size="AppControlSize.Large" />
    }
    else if (_settings is null)
    {
        <AppErrorState Title="@L["NetworkRemoteAccessSettings_NetworkSettingsAreUnavailable"].Value"
                       Message="@L["NetworkRemoteAccessSettings_StartTheEngineOrRetry"].Value" />
    }
    else
    {
        @switch (ActiveSection)
        {
            case "local":
                <LocalNetworkSettingsPanel Settings="@_settings" Status="@_status"
                                           SaveRequested="SaveAsync" StatusRefreshRequested="RefreshStatusAsync" />
                break;
            case "remote":
                <RemoteAccessSettingsPanel Settings="@_settings" Status="@_status"
                                           SaveRequested="SaveAsync" StatusRefreshRequested="RefreshStatusAsync" />
                break;
            case "advanced":
                <AdvancedNetworkSettingsPanel Settings="@_settings" Status="@_status"
                                              SaveRequested="SaveAsync" SettingsReplaced="ReplaceSettingsAsync"
                                              StatusRefreshRequested="RefreshStatusAsync" />
                break;
            default:
                <NetworkOverviewPanel Settings="@_settings" Status="@_status"
                                      StatusRefreshRequested="RefreshStatusAsync" />
                break;
        }
    }
</section>

@code {
    [Parameter] public string Subsection { get; set; } = "overview";

    /// <summary>
    /// Tells the Settings page whether remote access is not set up (the connection mode is still "local-only"), so the
    /// page notice under the title can offer to set it up. Raised after the settings load and after every save.
    /// </summary>
    [Parameter] public EventCallback<bool> RemoteAccessOffChanged { get; set; }

    private NetworkSettingsDto? _settings;
    private NetworkRuntimeStatusDto? _status;
    private bool _loading = true;

    private string ActiveSection => Subsection.ToLowerInvariant() switch
    {
        "local" => "local",
        "remote" => "remote",
        "advanced" => "advanced",
        _ => "overview",
    };

    protected override async Task OnInitializedAsync()
    {
        var settingsTask = ApiClient.GetNetworkSettingsAsync();
        var statusTask = ApiClient.GetNetworkRuntimeStatusAsync();
        await Task.WhenAll(settingsTask, statusTask);
        _settings = await settingsTask;
        _status = await statusTask;
        _loading = false;
        await ReportRemoteAccessAsync();
    }

    private Task ReportRemoteAccessAsync() => RemoteAccessOffChanged.InvokeAsync(
        _settings is not null
        && string.Equals(_settings.Remote.ConnectionMode?.Trim(), "local-only", StringComparison.OrdinalIgnoreCase));

    private async Task SaveAsync()
    {
        if (_settings is null)
            return;
        var saved = await ApiClient.UpdateNetworkSettingsAsync(_settings);
        if (saved is null)
        {
            Snackbar.Add(L["NetworkRemoteAccessSettings_NetworkSettingsCouldNotBe"].Value, AppSeverity.Error);
            return;
        }
        _settings = saved;
        Snackbar.Add(L["NetworkRemoteAccessSettings_NetworkSettingsSaved"].Value, AppSeverity.Success);
        await ReportRemoteAccessAsync();
        await RefreshStatusAsync();
    }

    private async Task ReplaceSettingsAsync(NetworkSettingsDto replacement)
    {
        _settings = replacement;
        await ReportRemoteAccessAsync();
        await RefreshStatusAsync();
    }

    private async Task RefreshStatusAsync()
    {
        _status = await ApiClient.GetNetworkRuntimeStatusAsync();
        StateHasChanged();
    }
}
