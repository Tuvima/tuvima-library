@namespace MediaEngine.Web.Components.Settings
@inject MetadataSettingsStateService StateService
@inject IEngineApiClient ApiClient
@inject ProviderCatalogueService CatalogueService
@inject ISnackbar Snackbar
@inject ILogger<MetadataSettingsPage> Logger
@inject DeviceContextService DeviceContext
@inject IDialogService DialogService
@inject IJSRuntime JS

<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" />

<MetadataAdminShell ActiveSubsection="@ActiveSurface">
    <SettingsSubsectionNav Section="SettingsSection.Providers"
                           ActiveSubsection="@ActiveSurface"
                           Mobile="@DeviceContext.IsMobile"
                           AriaLabel="Metadata settings sections" />

    @if (_loading)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="Loading metadata settings" Class="py-8" />
    }
    else if (!string.IsNullOrWhiteSpace(_loadError) || _snapshot is null)
    {
        <AppPageState Kind="AppPageStateKind.Error"
                      Icon="@Icons.Material.Outlined.CloudOff"
                      Title="Metadata settings are unavailable"
                      Message="@(_loadError ?? "The Engine did not return metadata configuration.")" />
    }
    else if (ActiveSurface == "providers")
    {
        @if (string.IsNullOrWhiteSpace(Detail))
        {
            @ProvidersPage()
        }
        else
        {
            @ProviderDetailPage()
        }
    }
    else
    {
        @IngestionFlowPage()
    }
</MetadataAdminShell>

@code {
    [Parameter] public string? Subsection { get; set; }
    [Parameter] public string? Detail { get; set; }

    private MetadataSettingsSnapshot? _snapshot;
    private readonly Dictionary<string, ProviderEditorDraft> _providerDrafts = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _providerBaselines = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _testMessages = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _testing = new(StringComparer.OrdinalIgnoreCase);
    private string _providerFilter = "all";
    private string _providerSearch = string.Empty;
    private string _flowFilter = "all";
    private string _flowSearch = string.Empty;
    private string? _loadedRoute;
    private string? _loadError;
    private bool _loading = true;
    private bool _saving;

    private string ActiveSurface => string.Equals(Subsection, "ingestion-flow", StringComparison.OrdinalIgnoreCase)
        ? "ingestion-flow"
        : "providers";

    private bool HasUnsavedChanges => _providerDrafts.Any(pair =>
        _providerBaselines.TryGetValue(pair.Key, out var baseline) && pair.Value.Fingerprint() != baseline);

    protected override async Task OnParametersSetAsync()
    {
        var route = $"{ActiveSurface}/{Detail}";
        if (string.Equals(route, _loadedRoute, StringComparison.OrdinalIgnoreCase)) return;
        _loadedRoute = route;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _snapshot = await StateService.LoadAsync();
            ResetDrafts();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load the Metadata settings experience.");
            _loadError = "Start the Engine and retry. No sample provider state is being shown.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetDrafts()
    {
        _providerDrafts.Clear();
        _providerBaselines.Clear();
        if (_snapshot is null) return;
        foreach (var provider in _snapshot.Providers)
        {
            var status = provider.Status;
            var draft = new ProviderEditorDraft
            {
                Key = provider.Key,
                Enabled = provider.Enabled,
                LanguageStrategy = status?.LanguageStrategy ?? provider.Catalogue.LanguageStrategy ?? "source",
                TimeoutSeconds = status?.TimeoutSeconds ?? 10,
                ThrottleMs = status?.ThrottleMs ?? 0,
                MaxConcurrency = status?.MaxConcurrency ?? 1,
                PrimaryEndpoint = status?.Endpoints?.GetValueOrDefault("api")
                    ?? status?.Endpoints?.Values.FirstOrDefault()
                    ?? string.Empty,
            };
            _providerDrafts[provider.Key] = draft;
            _providerBaselines[provider.Key] = draft.Fingerprint();
        }
    }

    private RenderFragment ProvidersPage() => @<div class="metadata-experience metadata-providers-page">
        <div class="metadata-provider-toolbar">
            <div class="metadata-filter-row" aria-label="Filter providers">
                @foreach (var filter in VisibleProviderFilters)
                {
                    <AppChip Text="@filter.Label"
                             Icon="@filter.Icon"
                             Class="@FilterClass(_providerFilter, filter.Value)"
                             OnClick="@(() => _providerFilter = filter.Value)" />
                }
            </div>
            <AppTextField Value="@_providerSearch"
                          ValueChanged="@(value => _providerSearch = value ?? string.Empty)"
                          Placeholder="Search providers"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Search"
                          Class="metadata-search" />
        </div>

        @if (_snapshot!.Providers.Any(provider => provider.NeedsSetup))
        {
            <AppAlert Tone="AppUiTone.Warning" Class="metadata-stage-callout">
                @_snapshot.Providers.Count(provider => provider.NeedsSetup) provider(s) need setup before they can run.
            </AppAlert>
        }

        @if (FilteredProviders.Count == 0)
        {
            <AppPageState Kind="AppPageStateKind.Empty" Title="No providers match" Message="Clear the search or select another filter." />
        }
        else
        {
            <div class="metadata-provider-table-wrap">
                <table class="metadata-provider-table">
                    <thead>
                        <tr>
                            <th>Provider</th><th>Used for</th><th>Role</th><th>Status</th>
                            @if (!DeviceContext.IsMobile)
                            {
                                <th><span class="metadata-sr-only">Configure</span></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var provider in FilteredProviders)
                        {
                            <tr>
                                <td data-label="Provider">
                                    <div class="metadata-provider-identity">
                                        <AppProviderLogo ImageUrl="@provider.LogoUrl" Icon="@provider.Icon" AccentColor="@provider.AccentColor"
                                                         FallbackText="@Initials(provider.DisplayName)" Size="AppControlSize.Compact" AltText="" />
                                        <span><strong>@provider.DisplayName</strong><small>@provider.Description</small></span>
                                    </div>
                                </td>
                                <td data-label="Used for">
                                    <div class="metadata-chip-list" aria-label="Used for">
                                        @foreach (var mediaType in provider.MediaTypes)
                                        {
                                            <AppChip Text="@MetadataSettingsStateService.MediaTypeLabel(mediaType)" Icon="@MetadataSettingsStateService.MediaTypeIcon(mediaType)" />
                                        }
                                        @if (provider.MediaTypes.Count == 0)
                                        {
                                            <AppChip Text="All media" Icon="@Icons.Material.Outlined.AllInclusive" />
                                        }
                                    </div>
                                </td>
                                <td data-label="Role"><span class="metadata-role-copy">@RoleSummary(provider)</span></td>
                                <td data-label="Status"><AppStatusBadge Text="@provider.HealthLabel" Tone="@provider.HealthTone" /></td>
                                @if (!DeviceContext.IsMobile)
                                {
                                    <td class="metadata-provider-action">
                                        <AppButton Label="Configure" Href="@ProviderRoute(provider.Key)" Size="AppControlSize.Compact" EndIcon="@Icons.Material.Outlined.ChevronRight" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>;

    private RenderFragment ProviderDetailPage() => @<div class="metadata-experience metadata-detail">
        @{ var provider = _snapshot!.ProviderFor(Detail); }
        @if (provider is null)
        {
            <AppPageState Kind="AppPageStateKind.Error" Title="Unknown provider" Message="This provider is not available in the configured provider catalogue." />
        }
        else
        {
            <div class="metadata-provider-detail-heading">
                <div class="metadata-provider-detail-title">
                    <AppProviderLogo ImageUrl="@provider.LogoUrl" Icon="@provider.Icon" AccentColor="@provider.AccentColor"
                                     FallbackText="@Initials(provider.DisplayName)" AltText="" />
                    <div><h2>@provider.DisplayName</h2><p>@provider.Description</p></div>
                </div>
                <AppStatusBadge Text="@provider.HealthLabel" Tone="@provider.HealthTone" />
            </div>

            <section class="metadata-detail-layout">
                <div class="metadata-detail-main">
                    @ProviderConfiguration(provider)
                </div>
                <aside class="metadata-detail-aside">
                    <AppCard Class="metadata-summary-card">
                        <SettingsSectionHeader Title="Used During Ingestion" Description="Roles are derived from the active media pipelines." />
                        <div class="metadata-provider-stage-list">
                            @foreach (var participation in provider.Participations)
                            {
                                <div>
                                    <span class="metadata-stage-number">@participation.Stage</span>
                                    <span><strong>@MetadataSettingsStateService.MediaTypeLabel(participation.MediaType)</strong><small>@participation.StageLabel</small></span>
                                    <AppChip Text="@participation.RoleLabel" Tone="@RoleTone(participation.RoleLabel)" />
                                </div>
                            }
                        </div>
                    </AppCard>
                    <AppCard Class="metadata-summary-card">
                        <SettingsSectionHeader Title="What This Provider Supplies" />
                        <div class="metadata-capability-grid">
                            @foreach (var output in ProviderOutputs(provider))
                            {
                                <div><MudIcon Icon="@CapabilityIcon(output)" /><span>@output</span></div>
                            }
                        </div>
                    </AppCard>
                    <AppCard Class="metadata-next-card">
                        <SettingsSectionHeader Title="What Happens Next" Icon="@Icons.Material.Outlined.Info" />
                        <p>@NextStepCopy(provider)</p>
                        <AppButton Label="View Ingestion Flow" Href="/settings/metadata/ingestion-flow" ButtonStyle="AppButtonStyle.Text" EndIcon="@Icons.Material.Outlined.ArrowForward" />
                    </AppCard>
                </aside>
            </section>
            @SaveBar()
        }
    </div>;

    private RenderFragment ProviderConfiguration(MetadataProviderInventoryItem provider) => @<AppCard Class="metadata-provider-configuration">
        @{ var draft = DraftFor(provider.Key); }
        <SettingsSectionHeader Title="Provider Configuration" Description="Only settings supported by this provider are shown." Icon="@Icons.Material.Outlined.Settings" />
        <div class="metadata-provider-facts">
            <div><MudIcon Icon="@Icons.Material.Outlined.Route" /><span><strong>Used during ingestion</strong><small>@ParticipationSummary(provider)</small></span></div>
            <div><MudIcon Icon="@Icons.Material.Outlined.Description" /><span><strong>Provides</strong><small>@string.Join(", ", ProviderOutputs(provider)).</small></span></div>
            <div><MudIcon Icon="@Icons.Material.Outlined.NetworkCheck" /><span><strong>Connection status</strong><small>@ConnectionCopy(provider)</small></span></div>
        </div>
        @ProviderConnection(provider)
        <div class="metadata-provider-fields">
            <AppSwitchRow Label="Provider enabled"
                          Description="@(provider.RequiredSystemProvider ? "Required system providers cannot be disabled." : "Disabled providers are skipped during metadata work.")"
                          Value="@draft.Enabled"
                          Disabled="@provider.RequiredSystemProvider"
                          ValueChanged="@(value => draft.Enabled = value)" />
            <AppSelect Value="@draft.LanguageStrategy"
                       ValueChanged="@(value => draft.LanguageStrategy = value ?? "source")"
                       Label="Language strategy"
                       Options="@LanguageOptions" />
        </div>
        <details class="metadata-advanced">
            <summary>Advanced connection settings</summary>
            <div class="metadata-provider-fields is-advanced">
                <AppNumericField Value="@draft.TimeoutSeconds" ValueChanged="@(value => draft.TimeoutSeconds = value)" Label="Request timeout (seconds)" Min="1" Max="120" />
                <AppNumericField Value="@draft.ThrottleMs" ValueChanged="@(value => draft.ThrottleMs = value)" Label="Minimum request interval (ms)" Min="0" Max="60000" />
                <AppNumericField Value="@draft.MaxConcurrency" ValueChanged="@(value => draft.MaxConcurrency = value)" Label="Max concurrency" Min="1" Max="32" />
                @if (!string.IsNullOrWhiteSpace(draft.PrimaryEndpoint))
                {
                    <AppTextField Value="@draft.PrimaryEndpoint" ValueChanged="@(value => draft.PrimaryEndpoint = value ?? string.Empty)" Label="Primary endpoint" />
                }
            </div>
        </details>
    </AppCard>;

    private RenderFragment ProviderConnection(MetadataProviderInventoryItem provider) => @<section class="metadata-provider-connection" aria-labelledby="provider-connection-title">
        <div class="metadata-provider-connection__heading">
            <div>
                <h3 id="provider-connection-title">Connection</h3>
                <p>@(_testMessages.GetValueOrDefault(provider.Key) ?? LastCheckCopy(provider))</p>
            </div>
        <AppStatusBadge Text="@provider.HealthLabel" Tone="@provider.HealthTone" />
        </div>
        <div class="metadata-provider-connection__actions">
            @if (UserCredentials(provider).Count == 0)
            {
                <AppButton Label="@(_testing.Contains(provider.Key) ? "Testing…" : "Test connection")"
                           StartIcon="@Icons.Material.Outlined.NetworkCheck"
                           Disabled="@(_testing.Contains(provider.Key) || !DraftFor(provider.Key).Enabled || HasUnsavedChanges)"
                           OnClick="@(() => TestProviderAsync(provider.Key))" />
            }
            else if (IsCredentialConfigured(provider) && HasStoredUserCredential(provider))
            {
                <AppButton Label="Replace credential" StartIcon="@Icons.Material.Outlined.Key" OnClick="@(() => OpenProviderDialogAsync(provider, ProviderOnboardingOperation.Replace))" />
                <AppButton Label="Test connection" StartIcon="@Icons.Material.Outlined.NetworkCheck" Disabled="@(_testing.Contains(provider.Key) || HasUnsavedChanges)" OnClick="@(() => TestProviderAsync(provider.Key))" />
                <AppButton Label="Remove credential" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Error" StartIcon="@Icons.Material.Outlined.DeleteOutline" OnClick="@(() => RemoveProviderCredentialAsync(provider))" />
            }
            else if (IsCredentialConfigured(provider))
            {
                <AppButton Label="Add optional credential" StartIcon="@Icons.Material.Outlined.Key" OnClick="@(() => OpenProviderDialogAsync(provider, ProviderOnboardingOperation.Replace))" />
                <AppButton Label="Test connection" StartIcon="@Icons.Material.Outlined.NetworkCheck" Disabled="@(_testing.Contains(provider.Key) || HasUnsavedChanges)" OnClick="@(() => TestProviderAsync(provider.Key))" />
            }
            else
            {
                <AppButton Label="Connect provider" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" StartIcon="@Icons.Material.Outlined.Link" OnClick="@(() => OpenProviderDialogAsync(provider, ProviderOnboardingOperation.Connect))" />
            }
        </div>
    </section>;

    private RenderFragment IngestionFlowPage() => @<div class="metadata-experience metadata-flow-page">
        <div class="metadata-flow-intro">
            <div><h2>Ingestion Flow</h2><p>See which providers run for each media type, their role, and the results they add to your library.</p></div>
            <div class="metadata-provider-toolbar">
                <div class="metadata-filter-row" aria-label="Filter ingestion flow">
                    @foreach (var filter in FlowFilters)
                    {
                        <AppChip Text="@filter.Label" Icon="@filter.Icon" Class="@FilterClass(_flowFilter, filter.Value)" OnClick="@(() => _flowFilter = filter.Value)" />
                    }
                </div>
                <AppTextField Value="@_flowSearch"
                              ValueChanged="@(value => _flowSearch = value ?? string.Empty)"
                              Placeholder="Search media type"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              Class="metadata-search" />
            </div>
        </div>

        <div class="metadata-flow-table" role="table" aria-label="Configured ingestion flow">
            <div class="metadata-flow-header" role="row">
                <span role="columnheader">Media type</span><span role="columnheader">1. Identify &amp; initial metadata</span><span role="columnheader">2. Canonical identity</span><span role="columnheader">3. Enrichment after match</span><span role="columnheader">Results you get</span>
            </div>
            @foreach (var flow in FilteredFlows)
            {
                <article class="metadata-flow-row" role="row">
                    <div class="metadata-flow-media" role="cell"><span class="metadata-icon-box"><MudIcon Icon="@flow.Icon" /></span><span><strong>@flow.Label</strong><small>@flow.Lane · @flow.Strategy</small></span></div>
                    <div class="metadata-flow-stage" role="cell" data-label="Identify & initial metadata">@FlowParticipants(flow.Identification)</div>
                    <div class="metadata-flow-stage" role="cell" data-label="Canonical identity">@FlowParticipants(flow.CanonicalIdentity)</div>
                    <div class="metadata-flow-stage" role="cell" data-label="Enrichment after match">@FlowParticipants(flow.Enrichment)</div>
                    <div class="metadata-flow-results" role="cell" data-label="Results you get">
                        <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" />
                        <span>@(flow.Results.Count == 0 ? "No active provider outputs" : string.Join(", ", flow.Results))</span>
                    </div>
                </article>
            }
        </div>
        <AppAlert Tone="AppUiTone.Info">Order and roles come from the active Engine configuration. Disabled or incomplete providers remain visible so gaps are clear.</AppAlert>
    </div>;

    private RenderFragment FlowParticipants(IReadOnlyList<MetadataFlowParticipant> participants) => @<div class="metadata-flow-participants">
        @if (participants.Count == 0)
        {
            <span class="metadata-not-configured">Not configured</span>
        }
        else
        {
            @foreach (var participant in participants)
            {
                <div class="metadata-flow-provider @(participant.Enabled && !participant.NeedsSetup ? null : "is-inactive")">
                    <AppProviderLogo ImageUrl="@participant.LogoUrl" Icon="@participant.Icon" AccentColor="@participant.AccentColor"
                                     FallbackText="@Initials(participant.DisplayName)" Size="AppControlSize.Compact" AltText="" />
                    <span><a href="@ProviderRoute(participant.ProviderKey)">@participant.DisplayName</a><small>@string.Join(" · ", participant.Outputs)</small></span>
                    <AppChip Text="@(participant.NeedsSetup ? "Needs setup" : participant.RoleLabel)" Tone="@(participant.NeedsSetup ? AppUiTone.Warning : RoleTone(participant.RoleLabel))" />
                </div>
            }
        }
    </div>;

    private RenderFragment SaveBar() => @<footer class="metadata-savebar">
        <AppButton Label="Cancel" Disabled="@(!HasUnsavedChanges || _saving)" OnClick="ResetDrafts" />
        <AppButton Label="@(_saving ? "Saving…" : "Save Changes")" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary"
                   Disabled="@(!HasUnsavedChanges || _saving)" OnClick="SaveChangesAsync" />
    </footer>;

    private async Task SaveChangesAsync()
    {
        if (_saving || !HasUnsavedChanges) return;
        _saving = true;
        try
        {
            foreach (var (key, draft) in _providerDrafts)
            {
                if (_providerBaselines.GetValueOrDefault(key) == draft.Fingerprint()) continue;
                if (!await ApiClient.SaveProviderConfigAsync(key, draft.ToUpdate("api")))
                {
                    Snackbar.Add($"Could not save {CatalogueService.GetDisplayName(key)} settings.", Severity.Error);
                    return;
                }
            }
            CatalogueService.Invalidate();
            _snapshot = await StateService.LoadAsync();
            ResetDrafts();
            Snackbar.Add("Provider settings saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not save provider settings.");
            Snackbar.Add("Provider settings could not be saved.", Severity.Error);
        }
        finally { _saving = false; }
    }

    private async Task TestProviderAsync(string key)
    {
        if (!_testing.Add(key)) return;
        try
        {
            var result = await ApiClient.TestProviderAsync(key);
            _testMessages[key] = result?.Message ?? "No connection result was returned.";
            Snackbar.Add(_testMessages[key], result?.Success == true ? Severity.Success : Severity.Warning);
            _snapshot = await StateService.LoadAsync();
            ResetDrafts();
        }
        finally { _testing.Remove(key); }
    }

    private async Task OpenProviderDialogAsync(
        MetadataProviderInventoryItem provider,
        ProviderOnboardingOperation operation)
    {
        var parameters = new DialogParameters<ProviderOnboardingDialog>
        {
            { component => component.Catalogue, provider.Catalogue },
            { component => component.Operation, operation },
        };
        var dialog = await DialogService.ShowAsync<ProviderOnboardingDialog>(string.Empty, parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = false,
            CloseOnEscapeKey = true,
        });
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: ProviderOnboardingDialogResult connection }) return;

        _testMessages[provider.Key] = connection.Message;
        Snackbar.Add(connection.Message, connection.Success ? Severity.Success : Severity.Warning);
        CatalogueService.Invalidate();
        await LoadAsync();
    }

    private async Task RemoveProviderCredentialAsync(MetadataProviderInventoryItem provider)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Remove the {provider.DisplayName} credential? The provider will stop running until it is connected again.");
        if (!confirmed) return;

        var result = await ApiClient.RemoveProviderCredentialsAsync(provider.Key);
        if (result?.Success != true)
        {
            Snackbar.Add(result?.Message ?? $"Could not remove the {provider.DisplayName} credential.", Severity.Error);
            return;
        }

        Snackbar.Add(result.Message, Severity.Success);
        CatalogueService.Invalidate();
        await LoadAsync();
    }

    private IReadOnlyList<MetadataProviderInventoryItem> FilteredProviders => _snapshot!.Providers
        .Where(MatchesProviderFilter)
        .Where(provider => string.IsNullOrWhiteSpace(_providerSearch)
            || ProviderSearchText(provider).Contains(_providerSearch.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    private IReadOnlyList<MetadataMediaPipeline> FilteredFlows => _snapshot!.MediaPipelines
        .Where(flow => _flowFilter == "all" || string.Equals(flow.Lane, _flowFilter, StringComparison.OrdinalIgnoreCase))
        .Where(flow => string.IsNullOrWhiteSpace(_flowSearch)
            || flow.Label.Contains(_flowSearch.Trim(), StringComparison.OrdinalIgnoreCase)
            || flow.MediaType.Contains(_flowSearch.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    private bool MatchesProviderFilter(MetadataProviderInventoryItem provider) => _providerFilter switch
    {
        "read" or "watch" or "listen" => provider.Lanes.Contains(_providerFilter, StringComparer.OrdinalIgnoreCase),
        "enrichment" => provider.Participations.Any(item => item.Stage == 3),
        "needs-setup" => provider.NeedsSetup,
        "connected" => provider.HealthLabel is "Connected" or "Enabled",
        "disabled" => !provider.Enabled,
        _ => true,
    };

    private ProviderEditorDraft DraftFor(string key) => _providerDrafts.TryGetValue(key, out var draft)
        ? draft
        : new ProviderEditorDraft { Key = key };

    private static IReadOnlyList<ProviderCredentialFieldDto> UserCredentials(MetadataProviderInventoryItem provider) =>
        provider.Catalogue.Onboarding?.Credentials
            .Where(field => string.Equals(field.Ownership, "user_supplied", StringComparison.OrdinalIgnoreCase))
            .ToList() ?? [];

    private static bool IsCredentialConfigured(MetadataProviderInventoryItem provider)
    {
        var fields = provider.Catalogue.Onboarding?.Credentials ?? [];
        return fields.Count > 0
            && fields.Where(field => field.Required).All(field => field.Configured);
    }

    private static bool HasStoredUserCredential(MetadataProviderInventoryItem provider) =>
        UserCredentials(provider).Any(field => field.Configured);

    private static readonly IReadOnlyList<AppSelectOption> LanguageOptions =
    [
        new("source", "Source defaults"),
        new("localized", "Prefer localized metadata"),
        new("both", "Source + localized"),
    ];

    private static readonly IReadOnlyList<MetadataFilterOption> ProviderFilters =
    [
        new("all", "All", Icons.Material.Outlined.Apps),
        new("read", "Read", Icons.Material.Outlined.MenuBook),
        new("watch", "Watch", Icons.Material.Outlined.PlayCircleOutline),
        new("listen", "Listen", Icons.Material.Outlined.Headphones),
        new("enrichment", "Enrichment", Icons.Material.Outlined.AutoAwesome),
        new("needs-setup", "Needs setup", Icons.Material.Outlined.WarningAmber),
        new("connected", "Connected", Icons.Material.Outlined.CheckCircle),
        new("disabled", "Disabled", Icons.Material.Outlined.Block),
    ];

    private IReadOnlyList<MetadataFilterOption> VisibleProviderFilters => DeviceContext.IsMobile
        ? ProviderFilters.Where(filter => filter.Value is "all" or "needs-setup" or "disabled").ToList()
        : ProviderFilters;

    private static readonly IReadOnlyList<MetadataFilterOption> FlowFilters =
    [
        new("all", "All", Icons.Material.Outlined.Apps),
        new("read", "Read", Icons.Material.Outlined.MenuBook),
        new("watch", "Watch", Icons.Material.Outlined.PlayCircleOutline),
        new("listen", "Listen", Icons.Material.Outlined.Headphones),
    ];

    private static string ProviderRoute(string providerKey) => $"/settings/metadata/providers/{Uri.EscapeDataString(providerKey.ToLowerInvariant())}";
    private static string FilterClass(string current, string value) => string.Equals(current, value, StringComparison.OrdinalIgnoreCase) ? "metadata-filter is-active" : "metadata-filter";
    private static string Initials(string name) => string.Concat(name.Split([' ', '.', '_', '-'], StringSplitOptions.RemoveEmptyEntries).Take(2).Select(word => char.ToUpperInvariant(word[0])));
    private static string ProviderSearchText(MetadataProviderInventoryItem provider) => string.Join(' ', [provider.DisplayName, provider.Key, provider.Category, provider.Domain, .. provider.MediaTypes, .. provider.Capabilities]);
    private static string RoleSummary(MetadataProviderInventoryItem provider) => string.Join(" · ", provider.Participations.Select(item => item.RoleLabel).Distinct(StringComparer.OrdinalIgnoreCase));
    private static string ParticipationSummary(MetadataProviderInventoryItem provider) => string.Join("; ", provider.Participations.GroupBy(item => item.Stage).Select(group => $"Stage {group.Key}: {string.Join(", ", group.Select(item => MetadataSettingsStateService.MediaTypeLabel(item.MediaType)).Distinct())}"));
    private static IReadOnlyList<string> ProviderOutputs(MetadataProviderInventoryItem provider) => provider.Participations.SelectMany(item => item.Outputs).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    private static string ConnectionCopy(MetadataProviderInventoryItem provider) => provider.NeedsSetup
        ? "Configuration is incomplete. Add the required credential and test again."
        : (ConnectionMessageIsCurrent(provider.Status) ? provider.Status?.ConnectionMessage : null)
            ?? provider.HealthLabel switch
        {
            "Connected" => "The provider is reachable and responding.",
            "Disabled" => "The provider is currently disabled.",
            "Unavailable" => "The provider could not be reached during the last availability check.",
            _ => $"Current provider status: {provider.HealthLabel}.",
        };
    private static bool ConnectionMessageIsCurrent(ProviderStatusDto? status) =>
        !string.IsNullOrWhiteSpace(status?.ConnectionMessage)
        && (!DateTimeOffset.TryParse(status.LastSuccessAt, out var lastSuccess)
            || !DateTimeOffset.TryParse(status.ConnectionCheckedAt, out var checkedAt)
            || checkedAt >= lastSuccess);
    private static string LastCheckCopy(MetadataProviderInventoryItem provider)
    {
        var value = provider.Status?.ConnectionCheckedAt
            ?? provider.Status?.LastSuccessAt ?? provider.Status?.LastFailureAt;
        return string.IsNullOrWhiteSpace(value)
            ? "Connection status uses the last recorded Engine check."
            : $"Last recorded provider check: {value}";
    }
    private static string NextStepCopy(MetadataProviderInventoryItem provider) => provider.Participations.Any(item => item.Stage == 1) ? "After a successful match, canonical identity is established before optional post-match enrichment adds any remaining details." : provider.Participations.Any(item => item.Stage == 2) ? "Canonical identity makes the item available for relationship, people, artwork, lyric, or subtitle enrichment." : "These optional outputs are added only after the item has been identified.";
    private static AppUiTone RoleTone(string role) => role switch { "Primary" or "Required" => AppUiTone.Primary, "Secondary" or "Fallback" => AppUiTone.Info, "Optional" => AppUiTone.Neutral, _ => AppUiTone.Neutral };
    private static string CapabilityIcon(string value) => value.ToLowerInvariant() switch { var text when text.Contains("identity") => Icons.Material.Outlined.Fingerprint, var text when text.Contains("rating") => Icons.Material.Outlined.StarOutline, var text when text.Contains("people") || text.Contains("portrait") => Icons.Material.Outlined.People, var text when text.Contains("cover") || text.Contains("poster") || text.Contains("background") || text.Contains("logo") => Icons.Material.Outlined.Image, var text when text.Contains("lyric") => Icons.Material.Outlined.Lyrics, var text when text.Contains("subtitle") || text.Contains("text track") => Icons.Material.Outlined.Subtitles, var text when text.Contains("relationship") => Icons.Material.Outlined.AccountTree, _ => Icons.Material.Outlined.Description };

    private sealed record MetadataFilterOption(string Value, string Label, string Icon);
}
