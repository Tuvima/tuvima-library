@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Services.Settings
@inject MetadataSettingsStateService StateService
@inject ILogger<MetadataSettingsPage> Logger
@inject IStringLocalizer<SharedStrings> L

@* Metadata now holds only the Ingestion Flow. Each source (provider) is a plugin with its own page under Plugins
   (Plugins and Integrations screens v3 D18). *@
<MetadataAdminShell ActiveSubsection="ingestion-flow">
    @if (_loading)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="@L["MetadataSettingsPage_LoadingMetadataSettings"].Value" Class="tl-sp-py-8" />
    }
    else if (!string.IsNullOrWhiteSpace(_loadError) || _snapshot is null)
    {
        <AppPageState Kind="AppPageStateKind.Error"
                      Icon="@AppMaterialIcons.Outlined.CloudOff"
                      Title="@L["MetadataSettingsPage_MetadataSettingsAreUnavailable"].Value"
                      Message="@(_loadError ?? "The Engine did not return metadata configuration.")" />
    }
    else
    {
        <div class="metadata-experience metadata-flow-page">
            <IngestionFlowEditor Snapshot="@_snapshot" />
        </div>
    }
</MetadataAdminShell>

@code {
    [Parameter] public string? Subsection { get; set; }
    [Parameter] public string? Detail { get; set; }

    private MetadataSettingsSnapshot? _snapshot;
    private string? _loadError;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _snapshot = await StateService.LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load the Metadata settings experience.");
            _loadError = L["MetadataSettingsPage_StartTheEngineAndRetry"].Value;
        }
        finally
        {
            _loading = false;
        }
    }
}
