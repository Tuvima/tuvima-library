@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Plugins
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedStrings> L
@implements IDisposable
@inject IEngineApiClient ApiClient
@inject ILogger<PluginFileCard> Logger
@inject IAppDialogService DialogService

@* The Plugin file tab (Plugins and Integrations screens v6 D65, D66). It shows the file's name, whether it is valid or how many problems it
   has, whether it differs from Tuvima's version, and the file itself, full width, read only and coloured, with line numbers. Edit file (an
   administrator on a computer, for a file the Engine says is editable) opens the editor in a pop-over window like Edit on an item; after a
   save or a reset the card says what happened and, if the plugin did not load or its check failed, offers Reset. Reading and editing are for
   a computer: the tab is absent elsewhere. The card draws whatever file the Engine names; it never knows which plugin it belongs to. *@
@{
    var file = _latest ?? Card.File;
}
<AppCard Title="@Card.Title" Class="plugin-page__card" data-testid="plugin-file-card">
    @if (file is null)
    {
        <p class="plugin-file__quiet" data-testid="plugin-file-none">@L["PluginFile_None"]</p>
    }
    else
    {
        <div class="plugin-file" data-testid="plugin-file-state" data-state="@file.State">
            <div class="plugin-file__heading">
                <strong data-testid="plugin-file-name">@file.FileName</strong>
                <span data-testid="plugin-file-valid"><AppStatusBadge Text="@StateWords(file)" Tone="@(file.State == "valid" ? AppUiTone.Success : AppUiTone.Error)" /></span>
                @if (file.HasShippedCopy)
                {
                    <span data-testid="plugin-file-differs"><AppStatusBadge Text="@(file.DiffersFromShipped ? "Differs from Tuvima's version" : "Same as Tuvima's version")"
                                    Tone="@(file.DiffersFromShipped ? AppUiTone.Warning : AppUiTone.Neutral)" /></span>
                }
                @if (CanView && CanEdit && file.Editable)
                {
                    <span class="plugin-file__spacer"></span>
                    <AppButton Label="@L["PluginFile_Edit"].Value" StartIcon="@AppMaterialIcons.Outlined.Edit" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary"
                               Disabled="@_loading" OnClick="@EditAsync" data-testid="plugin-file-edit" />
                }
            </div>
            @if (file.NoteCount > 0)
            {
                <small class="plugin-file__quiet" data-testid="plugin-file-notes">@(file.NoteCount == 1 ? "1 thing to know" : $"{file.NoteCount} things to know") that does not stop it working.</small>
            }

            @if (_result is not null)
            {
                <div class="@("plugin-file__result" + (_result.Health == "needs_attention" || !_result.Reloaded ? " plugin-file__result--problem" : " plugin-file__result--saved"))" data-testid="plugin-file-result" data-outcome="@_result.Outcome" data-health="@_result.Health">
                    <strong>@_result.Message</strong>
                    @if (!string.IsNullOrWhiteSpace(_result.HealthSummary))
                    {
                        <span data-testid="plugin-file-health">@_result.HealthSummary</span>
                    }
                    @if (CanEdit && file.HasShippedCopy && file.Editable && (!_result.Reloaded || _result.Health == "needs_attention"))
                    {
                        <div class="plugin-file__actions">
                            <AppButton Label="@L["PluginFile_ResetToShipped"].Value" StartIcon="@AppMaterialIcons.Outlined.RestartAlt" Size="AppControlSize.Compact"
                                       Disabled="@_resetting" OnClick="@ResetAfterFailureAsync" data-testid="plugin-file-reset-after" />
                        </div>
                    }
                </div>
            }

            @if (!CanView)
            {
                <small class="plugin-file__quiet" data-testid="plugin-file-computer-only">@L["PluginFile_ComputerOnly"]</small>
            }
            else if (_loading)
            {
                <AppPageState Kind="AppPageStateKind.Loading" Title="@L["PluginFile_Opening"]" />
            }
            else if (_response is null)
            {
                <AppAlert Tone="AppUiTone.Error" data-testid="plugin-file-unavailable">The Engine did not return the file. Try again.</AppAlert>
            }
            else
            {
                <PluginFileViewer Text="@_response.Text" FileName="@_response.State.FileName" Problems="@_response.Problems" />
            }
        </div>
    }
</AppCard>

@code {
    private readonly CancellationTokenSource _disposed = new();
    private PluginFileResponse? _response;
    private PluginFileStateDto? _latest;
    private PluginFileSaveResponse? _result;
    private PluginSetupCardDto? _card;
    private bool _loading;
    private bool _resetting;
    private string? _loadedFor;

    /// <summary>The plugin whose file this is.</summary>
    [Parameter, EditorRequired] public string PluginId { get; set; } = string.Empty;

    /// <summary>The file card of the plugin's page model.</summary>
    [Parameter, EditorRequired] public PluginSetupCardDto Card { get; set; } = default!;

    /// <summary>True on a computer (the same rule as editing items); false on a phone or tablet, where only the name and state show.</summary>
    [Parameter] public bool CanView { get; set; }

    /// <summary>
    /// True when the Edit file button may be offered: the same device rule as editing an item (a computer with a fine, hovering pointer).
    /// The Engine still decides who may save. Defaults to false so a card that is not told never offers editing.
    /// </summary>
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>Raised after a save or a reset, so the page and the plugin's tile read the plugin again.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!ReferenceEquals(_card, Card))
        {
            _card = Card;
            _latest = null;
        }

        if (!string.Equals(_loadedFor, PluginId, StringComparison.Ordinal))
        {
            _loadedFor = PluginId;
            _response = null;
            _result = null;
            if (CanView)
            {
                await LoadAsync();
            }
        }
    }

    // The file is always shown on its tab (v6 D65), so it is read as soon as the tab opens.
    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _response = await ApiClient.GetPluginFileAsync(PluginId, _disposed.Token);
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Could not read the file of plugin {PluginId}.", PluginId);
            _response = null;
        }
        finally
        {
            _loading = false;
        }
    }

    // Edit file opens the editor in a pop-over window; the page behind does not change while it is open.
    private async Task EditAsync()
    {
        if (!CanEdit || _response is null)
        {
            return;
        }

        _result = null;
        var parameters = new AppDialogParameters<PluginFileEditorPanel>
        {
            { component => component.PluginId, PluginId },
            { component => component.Initial, _response },
        };
        var dialog = await DialogService.ShowAsync<PluginFileEditorPanel>(string.Empty, parameters, new AppDialogOptions
        {
            MaxWidth = AppMaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = false,
            CloseOnEscapeKey = false,
        });
        var outcome = await dialog.Result;
        await EditorDoneAsync(outcome is { Canceled: false, Data: PluginFileSaveResponse saved } ? saved : null);
    }

    private async Task EditorDoneAsync(PluginFileSaveResponse? result)
    {
        if (result is null)
        {
            return;
        }

        _result = result;
        _latest = result.State;
        await LoadAsync();
        await Changed.InvokeAsync();
    }

    private async Task ResetAfterFailureAsync()
    {
        if (!CanEdit || _resetting)
        {
            return;
        }

        _resetting = true;
        try
        {
            var result = await ApiClient.ResetPluginFileAsync(PluginId, _disposed.Token);
            if (result is not null)
            {
                _result = result;
                _latest = result.State;
                await LoadAsync();
                await Changed.InvokeAsync();
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Could not reset the file of plugin {PluginId}.", PluginId);
        }
        finally
        {
            _resetting = false;
        }
    }

    private static string StateWords(PluginFileStateDto file) =>
        file.State == "valid" ? "Valid" : file.ErrorCount == 1 ? "1 problem" : $"{file.ErrorCount} problems";

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
