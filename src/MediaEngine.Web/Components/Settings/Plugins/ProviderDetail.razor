@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Plugins
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Services.Settings
@inject MetadataSettingsStateService StateService
@inject IEngineApiClient ApiClient
@inject ProviderCatalogueService CatalogueService
@inject IAppToastService Snackbar
@inject ILogger<ProviderDetail> Logger
@inject IAppDialogService DialogService
@inject IStringLocalizer<SharedStrings> L

@* One metadata provider's content on its plugin page's Set up tab (Plugins and Integrations screens v4 D33): the Access card, then
   what it provides (supplied by the page), then Settings (Lookup, the collapsed advanced connection and the page's own rows, saved
   with Review changes first), Privacy and About (supplied by the page). *@
<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" />

@if (_loading)
{
    <AppPageState Kind="AppPageStateKind.Loading" Title="@L["Common_Loading"].Value" Class="tl-sp-py-8" />
}
else if (!string.IsNullOrWhiteSpace(_loadError) || _snapshot is null)
{
    <AppPageState Kind="AppPageStateKind.Error"
                  Icon="@AppMaterialIcons.Outlined.CloudOff"
                  Title="@L["ProviderDetail_ThisSourceIsUnavailable"].Value"
                  Message="@(_loadError ?? "The Engine did not return the source's settings.")" />
}
else if (_snapshot.ProviderFor(ProviderKey) is not { } provider)
{
    <AppPageState Kind="AppPageStateKind.Error" Title="@L["ProviderDetail_UnknownSource"].Value" Message="@L["ProviderDetail_ThisSourceIsNotIn"].Value" />
}
else
{
    <div class="metadata-experience provider-setup">
        @AccessContent(provider)
        @ProvidesContent(provider)
        @if (Plugin?.Provider is not { AlwaysOn: true })
        {
            @SettingsContent(provider)
        }
        @PrivacyContent(provider)
        @About
    </div>
}

@code {
    [Parameter, EditorRequired] public string ProviderKey { get; set; } = string.Empty;

    /// <summary>The provider's entry in the Plugins list: its explanation, whether it needs a key and where to get one.</summary>
    [Parameter] public PluginSummaryResponse? Plugin { get; set; }

    /// <summary>Rows the page adds inside the Settings card (Who can use it, Libraries).</summary>
    [Parameter] public RenderFragment? ExtraSettings { get; set; }

    /// <summary>The About card, drawn last.</summary>
    [Parameter] public RenderFragment? About { get; set; }

    /// <summary>Raised after a change that the tiles should show (switched on or off, key added).</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private MetadataSettingsSnapshot? _snapshot;
    private readonly Dictionary<string, ProviderEditorDraft> _providerOriginal = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, ProviderEditorDraft> _providerDrafts = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _providerBaselines = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _testMessages = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _testing = new(StringComparer.OrdinalIgnoreCase);
    private string? _loadError;
    private bool _loading = true;
    private bool _saving;

    private bool HasUnsavedChanges => _providerDrafts.Any(pair =>
        _providerBaselines.TryGetValue(pair.Key, out var baseline) && pair.Value.Fingerprint() != baseline);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _snapshot = await StateService.LoadAsync();
            ResetDrafts();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load the source settings.");
            _loadError = L["ProviderDetail_StartTheEngineAndRetry"].Value;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetDrafts()
    {
        _providerDrafts.Clear();
        _providerBaselines.Clear();
        _providerOriginal.Clear();
        if (_snapshot is null) return;
        foreach (var provider in _snapshot.Providers)
        {
            var status = provider.Status;
            var draft = new ProviderEditorDraft
            {
                Key = provider.Key,
                Enabled = provider.Enabled,
                LanguageStrategy = status?.LanguageStrategy ?? provider.Catalogue.LanguageStrategy ?? "source",
                TimeoutSeconds = status?.TimeoutSeconds ?? 10,
                ThrottleMs = status?.ThrottleMs ?? 0,
                MaxConcurrency = status?.MaxConcurrency ?? 1,
                PrimaryEndpoint = status?.Endpoints?.GetValueOrDefault("api")
                    ?? status?.Endpoints?.Values.FirstOrDefault()
                    ?? string.Empty,
            };
            _providerDrafts[provider.Key] = draft;
            _providerBaselines[provider.Key] = draft.Fingerprint();
            _providerOriginal[provider.Key] = Clone(draft);
        }
    }


    // Access first (v4 D34): the shared card, with the same words first-run setup uses.
    private RenderFragment AccessContent(MetadataProviderInventoryItem provider)
    {
        var needsKey = Plugin?.Provider is { RequiresKey: true } || provider.Catalogue.Onboarding?.Credentials.Count > 0;
        var state = !needsKey ? ProviderAccessState.NoKeyNeeded : KeySaved(provider) ? ProviderAccessState.KeySaved : ProviderAccessState.NoKey;
        return @<ProviderAccessCard State="@state"
                                    Message="@(_testMessages.GetValueOrDefault(provider.Key) ?? (state == ProviderAccessState.KeySaved ? LastCheckCopy(provider) : null))"
                                    SignupUrl="@Plugin?.Provider?.SignupUrl"
                                    Testing="@_testing.Contains(provider.Key)"
                                    TestDisabled="@HasUnsavedChanges"
                                    CanRemove="@(IsCredentialConfigured(provider) && HasStoredUserCredential(provider))"
                                    OnConnect="@(() => OpenProviderDialogAsync(provider, ProviderOnboardingOperation.Connect))"
                                    OnReplace="@(() => OpenProviderDialogAsync(provider, ProviderOnboardingOperation.Replace))"
                                    OnTest="@(() => TestProviderAsync(provider.Key))"
                                    OnRemove="@(() => RemoveProviderCredentialAsync(provider))" />;
    }

    // What it provides: the standard icon list, then the one line that says where it is used (the only place targeting appears).
    private RenderFragment ProvidesContent(MetadataProviderInventoryItem provider) => @<AppCard Title="What it provides" Class="metadata-summary-card" data-testid="provider-provides">
        @if (Plugin is not null)
        {
            <PluginProvidesLine Plugin="@Plugin" />
        }
        <p class="provider-about" data-testid="provider-used-in">
            @UsedInWords(provider)
            <AppButton Label="Open Matching" Href="/settings/matching" ButtonStyle="AppButtonStyle.Text" EndIcon="@AppMaterialIcons.Outlined.ArrowForward" />
        </p>
    </AppCard>;

    private static string UsedInWords(MetadataProviderInventoryItem provider)
    {
        var kinds = provider.Participations
            .Select(participation => MetadataSettingsStateService.MediaTypeLabel(participation.MediaType))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        return kinds.Count == 0 ? "Not used in any flow yet." : "Used in: " + string.Join(", ", kinds) + ".";
    }

    // Privacy: what leaves this machine in a sentence or two, whether Vault items use it, and the service's own terms and privacy pages.
    private RenderFragment PrivacyContent(MetadataProviderInventoryItem provider) => @<AppCard Title="Privacy" Class="metadata-summary-card" data-testid="provider-privacy">
        <p class="provider-about" data-testid="provider-leaves">@LeavesWords()</p>
        @if (Plugin?.Provider is { VaultOnly: true })
        {
            <p class="provider-about">Library asks it only about videos in your Vault, and only when the Vault's online-lookup setting allows it.</p>
        }
        @if (!string.IsNullOrWhiteSpace(provider.Catalogue.Onboarding?.TermsUrl) || !string.IsNullOrWhiteSpace(provider.Catalogue.Onboarding?.PrivacyUrl))
        {
            <div class="provider-links">
                @if (!string.IsNullOrWhiteSpace(provider.Catalogue.Onboarding?.TermsUrl))
                {
                    <AppButton Label="Terms of use" Href="@provider.Catalogue.Onboarding!.TermsUrl" Target="_blank" ButtonStyle="AppButtonStyle.Text" EndIcon="@AppMaterialIcons.Outlined.OpenInNew" />
                }
                @if (!string.IsNullOrWhiteSpace(provider.Catalogue.Onboarding?.PrivacyUrl))
                {
                    <AppButton Label="Privacy policy" Href="@provider.Catalogue.Onboarding!.PrivacyUrl" Target="_blank" ButtonStyle="AppButtonStyle.Text" EndIcon="@AppMaterialIcons.Outlined.OpenInNew" />
                }
            </div>
        }
    </AppCard>;

    private string LeavesWords() => Plugin?.Provider is { SendsDataTo.Count: > 0 } provider
        ? $"Searches go to {string.Join(", ", provider.SendsDataTo)}." + (provider.RequiresKey ? " Your key is sent only to that address." : string.Empty)
        : "Nothing leaves this machine.";

    private RenderFragment SettingsContent(MetadataProviderInventoryItem provider) => @<text>
        @{ var draft = DraftFor(provider.Key); }
        <AppCard Title="Settings" Class="metadata-provider-configuration" data-testid="provider-settings">
            <div class="metadata-provider-fields">
                <AppSelect Value="@draft.LanguageStrategy"
                           ValueChanged="@(value => draft.LanguageStrategy = value ?? "source")"
                           Label="@L["Settings_Language"].Value"
                           Options="@LanguageOptions" />
            </div>
            @ExtraSettings
        </AppCard>
        @if (string.Equals(provider.Key, "stashbox", StringComparison.OrdinalIgnoreCase))
        {
            <StashBoxSettingsCard OnChanged="@NotifyChangedAsync" />
        }
        <AppCard Class="metadata-provider-configuration">
            <details class="metadata-advanced" data-testid="provider-advanced">
                <summary>Advanced connection</summary>
                <div class="metadata-provider-fields is-advanced">
                    <AppNumericField Value="@draft.TimeoutSeconds" ValueChanged="@(value => draft.TimeoutSeconds = value)" Label="Request timeout (seconds)" Min="1" Max="120" />
                    <AppNumericField Value="@draft.ThrottleMs" ValueChanged="@(value => draft.ThrottleMs = value)" Label="Minimum request interval (ms)" Min="0" Max="60000" />
                    <AppNumericField Value="@draft.MaxConcurrency" ValueChanged="@(value => draft.MaxConcurrency = value)" Label="Max concurrency" Min="1" Max="32" />
                    @if (!string.IsNullOrWhiteSpace(draft.PrimaryEndpoint))
                    {
                        <AppTextField Value="@draft.PrimaryEndpoint" ValueChanged="@(value => draft.PrimaryEndpoint = value ?? string.Empty)" Label="Primary address" />
                    }
                </div>
            </details>
        </AppCard>
        @SaveBar()
    </text>;

    private bool KeySaved(MetadataProviderInventoryItem provider) => IsCredentialConfigured(provider) || Plugin?.Provider is { KeyPresent: true };

    private RenderFragment SaveBar() => @<footer class="metadata-savebar">
        <AppButton Label="Cancel" Disabled="@(!HasUnsavedChanges || _saving)" OnClick="ResetDrafts" />
        <AppButton Label="@(_saving ? "Saving…" : "Save changes")" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary"
                   Disabled="@(!HasUnsavedChanges || _saving)" OnClick="SaveChangesAsync" />
    </footer>;

    private async Task SaveChangesAsync()
    {
        if (_saving || !HasUnsavedChanges) return;
        // Review changes first: nothing is saved until the person has seen what will change (Never rule on single-item editing).
        if (!await ReviewChangesAsync()) return;
        _saving = true;
        try
        {
            // Switching a source off can leave a kind of information with no source, so say so before it is saved.
            foreach (var (key, draft) in _providerDrafts)
            {
                var wasOn = _snapshot?.Providers.FirstOrDefault(provider => provider.Key == key)?.Enabled == true;
                if (!wasOn || draft.Enabled) continue;
                if (!await ConfirmSwitchOffAsync(key)) return;
            }

            foreach (var (key, draft) in _providerDrafts)
            {
                if (_providerBaselines.GetValueOrDefault(key) == draft.Fingerprint()) continue;
                if (!await ApiClient.SaveProviderConfigAsync(key, draft.ToUpdate("api")))
                {
                    Snackbar.Add($"Could not save {CatalogueService.GetDisplayName(key)} settings.", AppSeverity.Error);
                    return;
                }
            }
            CatalogueService.Invalidate();
            _snapshot = await StateService.LoadAsync();
            ResetDrafts();
            await NotifyChangedAsync();
            Snackbar.Add(L["PluginPage_Saved"].Value, AppSeverity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not save provider settings.");
            Snackbar.Add(L["Common_ProviderSettingsCouldNotBe"].Value, AppSeverity.Error);
        }
        finally { _saving = false; }
    }

    // The warning (Developer tools spec WP20, D-J): what would have no source, what other sources still cover, and that
    // everything already in the Library is kept. Existing matches are never undone by switching a source off.
    private async Task<bool> ConfirmSwitchOffAsync(string key)
    {
        var impact = await ApiClient.GetPluginSourceSwitchOffImpactAsync(key);
        if (impact is null) return true;

        RenderFragment preview = builder =>
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "data-testid", "switch-off-warning");
            builder.OpenElement(2, "p");
            builder.AddContent(3, impact.WouldLose.Count == 0
                ? "Everything this source supplies is also supplied by another source."
                : "Nothing else would supply: " + string.Join(", ", impact.WouldLose) + ".");
            builder.CloseElement();
            if (impact.StillCovered.Count > 0)
            {
                builder.OpenElement(4, "p");
                builder.AddContent(5, "Still covered: " + string.Join("; ", impact.StillCovered.Select(c => c.Supplies + " by " + string.Join(", ", c.By))) + ".");
                builder.CloseElement();
            }
            builder.OpenElement(6, "p");
            builder.AddContent(7, impact.Keeps);
            builder.CloseElement();
            builder.CloseElement();
        };
        var answer = await AppConfirmDialog.ShowAsync(
            DialogService,
            $"Switch off {impact.DisplayName}?",
            null,
            primaryLabel: "Switch off",
            secondaryLabel: "Keep on",
            primaryDestructive: impact.WouldLose.Count > 0,
            preview: preview);
        return answer == AppConfirmResult.Primary;
    }

    private async Task TestProviderAsync(string key)
    {
        if (!_testing.Add(key)) return;
        try
        {
            var result = await ApiClient.TestProviderAsync(key);
            _testMessages[key] = result?.Message ?? "No connection result was returned.";
            Snackbar.Add(_testMessages[key], result?.Success == true ? AppSeverity.Success : AppSeverity.Warning);
            _snapshot = await StateService.LoadAsync();
            ResetDrafts();
        }
        finally { _testing.Remove(key); }
    }

    private async Task OpenProviderDialogAsync(
        MetadataProviderInventoryItem provider,
        ProviderOnboardingOperation operation)
    {
        var parameters = new AppDialogParameters<ProviderOnboardingDialog>
        {
            { component => component.Catalogue, provider.Catalogue },
            { component => component.Operation, operation },
        };
        var dialog = await DialogService.ShowAsync<ProviderOnboardingDialog>(string.Empty, parameters, new AppDialogOptions
        {
            MaxWidth = AppMaxWidth.Large,
            FullWidth = true,
            CloseButton = false,
            CloseOnEscapeKey = true,
        });
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: ProviderOnboardingDialogResult connection }) return;

        _testMessages[provider.Key] = connection.Message;
        Snackbar.Add(connection.Message, connection.Success ? AppSeverity.Success : AppSeverity.Warning);
        CatalogueService.Invalidate();
        await LoadAsync();
        await NotifyChangedAsync();
    }

    private async Task RemoveProviderCredentialAsync(MetadataProviderInventoryItem provider)
    {
        var answer = await AppConfirmDialog.ShowAsync(
            DialogService,
            $"Remove the {provider.DisplayName} credential?",
            "The provider will stop running until it is connected again.",
            primaryLabel: "Remove",
            secondaryLabel: "Keep",
            primaryDestructive: true);
        if (answer != AppConfirmResult.Primary) return;

        var result = await ApiClient.RemoveProviderCredentialsAsync(provider.Key);
        if (result?.Success != true)
        {
            Snackbar.Add(result?.Message ?? $"Could not remove the {provider.DisplayName} credential.", AppSeverity.Error);
            return;
        }

        Snackbar.Add(result.Message, AppSeverity.Success);
        CatalogueService.Invalidate();
        await LoadAsync();
        await NotifyChangedAsync();
    }

    private Task NotifyChangedAsync() => Changed.InvokeAsync();

    private static ProviderEditorDraft Clone(ProviderEditorDraft d) => new()
    {
        Key = d.Key,
        Enabled = d.Enabled,
        LanguageStrategy = d.LanguageStrategy,
        TimeoutSeconds = d.TimeoutSeconds,
        ThrottleMs = d.ThrottleMs,
        MaxConcurrency = d.MaxConcurrency,
        PrimaryEndpoint = d.PrimaryEndpoint,
    };

    // What the person is about to save, in plain words, one line per change.
    private IReadOnlyList<string> ChangeLines()
    {
        var lines = new List<string>();
        foreach (var (key, draft) in _providerDrafts)
        {
            if (!_providerOriginal.TryGetValue(key, out var before) || _providerBaselines.GetValueOrDefault(key) == draft.Fingerprint()) continue;
            if (before.Enabled != draft.Enabled) lines.Add(draft.Enabled ? "Switch it on" : "Switch it off");
            if (before.LanguageStrategy != draft.LanguageStrategy) lines.Add($"Language: {LanguageWords(before.LanguageStrategy)} to {LanguageWords(draft.LanguageStrategy)}");
            if (before.TimeoutSeconds != draft.TimeoutSeconds) lines.Add($"Request timeout: {before.TimeoutSeconds} to {draft.TimeoutSeconds} seconds");
            if (before.ThrottleMs != draft.ThrottleMs) lines.Add($"Minimum request interval: {before.ThrottleMs} to {draft.ThrottleMs} ms");
            if (before.MaxConcurrency != draft.MaxConcurrency) lines.Add($"Max concurrency: {before.MaxConcurrency} to {draft.MaxConcurrency}");
            if (before.PrimaryEndpoint != draft.PrimaryEndpoint) lines.Add($"Primary address: {draft.PrimaryEndpoint}");
        }

        return lines;
    }

    private static string LanguageWords(string value) => LanguageOptions.FirstOrDefault(option => option.Value == value)?.Label ?? value;

    private async Task<bool> ReviewChangesAsync()
    {
        var lines = ChangeLines();
        RenderFragment preview = builder =>
        {
            builder.OpenElement(0, "ul");
            builder.AddAttribute(1, "data-testid", "review-changes");
            var sequence = 2;
            foreach (var line in lines)
            {
                builder.OpenElement(sequence++, "li");
                builder.AddContent(sequence++, line);
                builder.CloseElement();
            }

            builder.CloseElement();
        };
        var answer = await AppConfirmDialog.ShowAsync(
            DialogService,
            "Review changes",
            null,
            primaryLabel: "Save changes",
            secondaryLabel: "Keep editing",
            preview: preview);
        return answer == AppConfirmResult.Primary;
    }

    private ProviderEditorDraft DraftFor(string key) => _providerDrafts.TryGetValue(key, out var draft)
        ? draft
        : new ProviderEditorDraft { Key = key };

    private static IReadOnlyList<ProviderCredentialFieldDto> UserCredentials(MetadataProviderInventoryItem provider) =>
        provider.Catalogue.Onboarding?.Credentials
            .Where(field => string.Equals(field.Ownership, "user_supplied", StringComparison.OrdinalIgnoreCase))
            .ToList() ?? [];

    private static bool IsCredentialConfigured(MetadataProviderInventoryItem provider)
    {
        var fields = provider.Catalogue.Onboarding?.Credentials ?? [];
        return fields.Count > 0
            && fields.Where(field => field.Required).All(field => field.Configured);
    }

    private static bool HasStoredUserCredential(MetadataProviderInventoryItem provider) =>
        UserCredentials(provider).Any(field => field.Configured);

    private static readonly IReadOnlyList<AppSelectOption> LanguageOptions =
    [
        new("source", "Source defaults"),
        new("localized", "Prefer localized metadata"),
        new("both", "Source + localized"),
    ];

    private static string ConnectionCopy(MetadataProviderInventoryItem provider) => provider.NeedsSetup
        ? "Configuration is incomplete. Add the required credential and test again."
        : (ConnectionMessageIsCurrent(provider.Status) ? provider.Status?.ConnectionMessage : null)
            ?? provider.HealthLabel switch
        {
            "Connected" => "The provider is reachable and responding.",
            "Disabled" => "The provider is currently disabled.",
            "Unavailable" => "The provider could not be reached during the last availability check.",
            _ => $"Current provider status: {provider.HealthLabel}.",
        };
    private static bool ConnectionMessageIsCurrent(ProviderStatusDto? status) =>
        !string.IsNullOrWhiteSpace(status?.ConnectionMessage)
        && (!DateTimeOffset.TryParse(status.LastSuccessAt, out var lastSuccess)
            || !DateTimeOffset.TryParse(status.ConnectionCheckedAt, out var checkedAt)
            || checkedAt >= lastSuccess);
    private static string LastCheckCopy(MetadataProviderInventoryItem provider)
    {
        var value = provider.Status?.ConnectionCheckedAt
            ?? provider.Status?.LastSuccessAt ?? provider.Status?.LastFailureAt;
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Not checked yet.";
        }

        if (!DateTimeOffset.TryParse(value, out var when))
        {
            return "Last checked a while ago.";
        }

        var words = StateCardHealth.RelativeTime(when, DateTimeOffset.UtcNow);
        return words.EndsWith("ago", StringComparison.Ordinal) || words == "Just now"
            ? $"Last checked {words.ToLowerInvariant()}."
            : $"Last checked on {words}.";
    }

    // A source that identifies media but is in no media type's flow (a newly added plugin) says so, with a way to put it to work.
    private static bool NotUsedInAnyFlow(MetadataProviderInventoryItem provider) =>
        provider.Catalogue.HydrationStages.Contains(1)
        && provider.MediaTypes.Count > 0
        && !provider.Participations.Any(item => item.Stage == 1);

}
