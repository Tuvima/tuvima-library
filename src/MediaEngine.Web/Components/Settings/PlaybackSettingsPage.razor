@namespace MediaEngine.Web.Components.Settings
@using System.Text.Json
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Playback
@using Microsoft.JSInterop
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject IUserPlaybackPreferencesAccessor PreferencesAccessor
@inject IAppToastService Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (_loading)
{
    <div class="playback-settings-skeleton" aria-label="Loading playback preferences">
        @for (var index = 0; index < 3; index++)
        {
            <AppSkeleton Height="220px" />
        }
    </div>
}
else if (_forbidden)
{
    <AppAlert Severity="AppSeverity.Warning" Variant="AppVariant.Outlined">You can't change this person's settings.</AppAlert>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <AppAlert Severity="AppSeverity.Error" Variant="AppVariant.Outlined">@_loadError</AppAlert>
}
else if (_settings is not null)
{
    <div class="settings-playback-page" data-playback-section="overview">
        @if (!string.IsNullOrWhiteSpace(_saveError))
        {
            <AppAlert Severity="AppSeverity.Error" Variant="AppVariant.Outlined" Dense="true">@_saveError</AppAlert>
        }

        @if (IsOtherProfile && _target is not null)
        {
            <div class="playback-profile-heading">
                <span class="playback-profile-heading__avatar">
                    <ProfileAvatar DisplayName="@_target.DisplayName" ImageUrl="@_target.AvatarImageUrl" Color="@_target.AvatarColor" Icon="@_target.AvatarIcon" />
                </span>
                <AppText Typo="AppTypo.h6">How @_target.DisplayName watches.</AppText>
                <a class="playback-profile-heading__back" href="@($"/settings/profiles/{ProfileId}")">Back to @_target.DisplayName</a>
            </div>
        }

        <div class="playback-settings-grid">
            <SettingsSectionPanel Title="Autoplay"
                                  Description="What happens when an episode ends."
                                  Class="tl-card settings-section-card playback-settings-card">
                @BoolRow(
                    "Autoplay next episode",
                    "Start the next episode after a short countdown. Turn off to choose it yourself.",
                    _settings.Watching.AutoplayNextEpisode,
                    value => UpdateAndSaveAsync(() => _settings.Watching.AutoplayNextEpisode = value))
            </SettingsSectionPanel>

            <SettingsSectionPanel Title="Resume"
                                  Description="Where a movie or episode starts when you come back."
                                  Class="tl-card settings-section-card playback-settings-card">
                @BoolRow(
                    "Resume where you left off",
                    "Continue from your last saved position.",
                    _settings.General.ResumePlayback,
                    value => UpdateAndSaveAsync(() => _settings.General.ResumePlayback = value))
            </SettingsSectionPanel>

            <SettingsSectionPanel Title="Skip"
                                  Description="How far the player skip buttons jump."
                                  Class="tl-card settings-section-card playback-settings-card">
                @IntSelectRow(
                    "Skip back",
                    "The amount used by the rewind control.",
                    _settings.Watching.SkipBackSeconds,
                    WatchingSkipBackOptions,
                    value => UpdateAndSaveAsync(() => _settings.Watching.SkipBackSeconds = value))
                @IntSelectRow(
                    "Skip forward",
                    "The amount used by the forward control.",
                    _settings.Watching.SkipForwardSeconds,
                    WatchingSkipForwardOptions,
                    value => UpdateAndSaveAsync(() => _settings.Watching.SkipForwardSeconds = value))
            </SettingsSectionPanel>

            <div id="subtitles" class="playback-subtitles-group" data-playback-section="subtitles">
                <SettingsSectionPanel Title="Subtitles & audio"
                                      Description="Which language plays first, and when subtitles appear."
                                      Class="tl-card settings-section-card playback-settings-card">
                    @StringSelectRow(
                        "Audio language",
                        "The audio track the player starts with when a title has more than one.",
                        LanguageValue(Subtitles.AudioLanguage),
                        LanguageOptionsFor(Subtitles.AudioLanguage),
                        value => UpdateAndSaveAsync(() => Subtitles.AudioLanguage = value))
                    @StringSelectRow(
                        "Subtitle language",
                        "The subtitles the player picks when it shows them.",
                        LanguageValue(Subtitles.DefaultSubtitleLanguage),
                        LanguageOptionsFor(Subtitles.DefaultSubtitleLanguage),
                        value => UpdateAndSaveAsync(() => Subtitles.DefaultSubtitleLanguage = value))
                    @StringSelectRow(
                        "Show subtitles",
                        "Auto shows them only when the audio is not in your subtitle language.",
                        ShowSubtitlesValue,
                        ShowSubtitlesOptions,
                        value => UpdateAndSaveAsync(() => Subtitles.ForcedSubtitlesMode = value),
                        wide: true)
                </SettingsSectionPanel>

                <SettingsSectionPanel Title="Subtitle appearance"
                                      Description="How subtitles look over the picture."
                                      Class="tl-card settings-section-card playback-settings-card">
                    <div class="subtitle-preview"
                         data-subtitle-size="@NormalizedSubtitleSize"
                         data-subtitle-background="@(Subtitles.SubtitleBackground ? "true" : "false")"
                         role="img"
                         aria-label="Sample of the subtitle style">
                        <p class="subtitle-preview__line"><span class="subtitle-preview__text">The rain had stopped by the time we reached the station.</span></p>
                    </div>
                    <div class="playback-preference-row">
                        <div class="playback-preference-row__copy">
                            <AppText Typo="AppTypo.body1">Text size</AppText>
                            <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">How large subtitles are in the player.</AppText>
                        </div>
                        <AppSegmentedControl Options="SubtitleSizeOptions"
                                             Value="@NormalizedSubtitleSize"
                                             ValueChanged="@(value => UpdateAndSaveAsync(() => Subtitles.SubtitleSize = value))"
                                             AriaLabel="Text size"
                                             Class="playback-preference-row__control" />
                    </div>
                    @BoolRow(
                        "Background",
                        "Put a dark box behind subtitles. Turn off to show the text with a soft shadow only.",
                        Subtitles.SubtitleBackground,
                        value => UpdateAndSaveAsync(() => Subtitles.SubtitleBackground = value))
                </SettingsSectionPanel>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Another household profile to edit (administrators only). Null or the active profile edits your own.</summary>
    [Parameter] public Guid? ProfileId { get; set; }

    /// <summary>Raised with the other profile's name once it is known, so the page can show it in the breadcrumb.</summary>
    [Parameter] public EventCallback<string?> TargetNameChanged { get; set; }

    private readonly JsonSerializerOptions _jsonOptions = MediaEngineJson.Web;
    private UserPlaybackSettingsDto? _settings;
    private ProfileViewModel? _activeProfile;
    private ProfileViewModel? _target;
    private bool _forbidden;
    private bool _loading = true;
    private string? _loadError;
    private string? _saveError;

    private bool IsOtherProfile => ProfileId is { } id && id != Guid.Empty && id != _activeProfile?.Id;

    private bool _scrolledToFragment;

    private SubtitleLanguageSettingsDto Subtitles => _settings!.Subtitles;

    private static readonly int[] WatchingSkipBackOptions = [5, 10, 15, 30];
    private static readonly int[] WatchingSkipForwardOptions = [10, 30, 60, 90];

    private static readonly IReadOnlyList<AppSelectOption> SubtitleSizeOptions =
    [
        new(PlaybackPreferenceValues.Small, "Small"),
        new(PlaybackPreferenceValues.Medium, "Medium"),
        new(PlaybackPreferenceValues.Large, "Large"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> ShowSubtitlesOptions =
    [
        new(PlaybackPreferenceValues.Auto, "Auto (only when audio is not my language)"),
        new(PlaybackPreferenceValues.Always, "Always"),
        new(PlaybackPreferenceValues.Never, "Off"),
    ];

    // The Engine accepts ExtraLarge; this page offers three sizes, so it shows as the largest.
    private string NormalizedSubtitleSize => Subtitles.SubtitleSize switch
    {
        var size when string.Equals(size, PlaybackPreferenceValues.Small, StringComparison.OrdinalIgnoreCase) => PlaybackPreferenceValues.Small,
        var size when string.Equals(size, PlaybackPreferenceValues.Large, StringComparison.OrdinalIgnoreCase)
            || string.Equals(size, PlaybackPreferenceValues.ExtraLarge, StringComparison.OrdinalIgnoreCase) => PlaybackPreferenceValues.Large,
        _ => PlaybackPreferenceValues.Medium,
    };

    private string ShowSubtitlesValue =>
        ShowSubtitlesOptions.FirstOrDefault(option => string.Equals(option.Value, Subtitles.ForcedSubtitlesMode, StringComparison.OrdinalIgnoreCase))?.Value
        ?? PlaybackPreferenceValues.Auto;

    // A saved language that differs only in case still selects its entry in the list.
    private static string LanguageValue(string? language) =>
        PlaybackLanguageOptions.WithCurrent(language).FirstOrDefault(option => string.Equals(option, language?.Trim(), StringComparison.OrdinalIgnoreCase))
        ?? PlaybackLanguageOptions.Common[0];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _activeProfile = await Orchestrator.GetActiveProfileAsync();
            if (IsOtherProfile)
            {
                var profiles = await Orchestrator.GetProfilesAsync();
                _target = profiles.FirstOrDefault(profile => profile.Id == ProfileId);
                var loaded = await ApiClient.GetPlaybackSettingsAsync(ProfileId!.Value);
                if (loaded is null || _target is null)
                {
                    _forbidden = true;
                    return;
                }

                _settings = Clone(loaded);
                await TargetNameChanged.InvokeAsync(_target.DisplayName);
            }
            else
            {
                var loaded = await PreferencesAccessor.GetAsync();
                _settings = Clone(loaded ?? UserPlaybackSettingsDto.CreateDefaults(_activeProfile?.Id ?? Guid.Empty));
            }
        }
        catch
        {
            _loadError = "Playback settings could not be loaded.";
        }
        finally
        {
            _loading = false;
        }
    }

    private RenderFragment BoolRow(string title, string description, bool value, Func<bool, Task> changed) => @<div class="playback-preference-row">
        <div class="playback-preference-row__copy">
            <AppText Typo="AppTypo.body1">@title</AppText>
            <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">@description</AppText>
        </div>
        <AppSwitchRow T="bool" Value="@value" ValueChanged="@changed" Color="AppColor.Primary" AriaLabel="@title" />
    </div>;

    private static IReadOnlyList<AppSelectOption> LanguageOptionsFor(string? current) =>
        PlaybackLanguageOptions.WithCurrent(current).Select(language => new AppSelectOption(language, language)).ToList();

    private RenderFragment StringSelectRow(
        string title,
        string description,
        string value,
        IReadOnlyList<AppSelectOption> options,
        Func<string, Task> changed,
        bool wide = false) => @<div class="playback-preference-row">
        <div class="playback-preference-row__copy">
            <AppText Typo="AppTypo.body1">@title</AppText>
            <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">@description</AppText>
        </div>
        <AppSelect Value="@value"
                   ValueChanged="@(selected => changed(selected ?? value))"
                   Variant="AppVariant.Outlined"
                   Margin="AppMargin.Dense"
                   Dense="true"
                   Size="AppControlSize.Compact"
                   Class="@(wide ? "playback-preference-row__select playback-preference-row__select--wide" : "playback-preference-row__select")"
                   aria-label="@title">
            @foreach (var option in options)
            {
                <AppSelectItem T="string" Value="@option.Value">@option.Label</AppSelectItem>
            }
        </AppSelect>
    </div>;

    private RenderFragment IntSelectRow(
        string title,
        string description,
        int value,
        IReadOnlyList<int> options,
        Func<int, Task> changed) => @<div class="playback-preference-row">
        <div class="playback-preference-row__copy">
            <AppText Typo="AppTypo.body1">@title</AppText>
            <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">@description</AppText>
        </div>
        <AppIntSelect Value="@value"
                      ValueChanged="@changed"
                      Variant="AppVariant.Outlined"
                      Margin="AppMargin.Dense"
                      Dense="true"
                      Size="AppControlSize.Compact"
                      Class="playback-preference-row__select"
                      aria-label="@title">
            @foreach (var option in options)
            {
                <AppSelectItem T="int" Value="@option">@($"{option} seconds")</AppSelectItem>
            }
        </AppIntSelect>
    </div>;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The profile page links here as /settings/playback#subtitles. The group only exists once the settings have loaded,
        // so the scroll happens after that render rather than relying on the browser's own fragment handling.
        if (_scrolledToFragment || _settings is null || !string.Equals(new Uri(Navigation.Uri).Fragment, "#subtitles", StringComparison.Ordinal))
        {
            return;
        }

        _scrolledToFragment = true;
        try
        {
            await JS.InvokeVoidAsync("tuvimaEditorScrollTo", "#subtitles");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // Best effort: the group is still on the page if the scroll cannot run (for example when the circuit is closing).
        }
    }

    private async Task UpdateAndSaveAsync(Action update)
    {
        update();
        _saveError = null;
        await SaveAsync();
    }

    private async Task SaveAsync()
    {
        if (_settings is null)
            return;

        try
        {
            var other = IsOtherProfile;
            var saved = other
                ? await ApiClient.UpdatePlaybackSettingsAsync(ProfileId!.Value, _settings)
                : await Orchestrator.SavePlaybackSettingsAsync(_settings);
            if (saved is null)
            {
                _saveError = "Playback settings could not be saved.";
                Snackbar.Add(_saveError, AppSeverity.Error);
                return;
            }

            _settings = Clone(saved);
            if (!other)
                PreferencesAccessor.UpdateCache(saved);
        }
        catch
        {
            _saveError = "Playback settings could not be saved.";
            Snackbar.Add(_saveError, AppSeverity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private UserPlaybackSettingsDto Clone(UserPlaybackSettingsDto source) =>
        JsonSerializer.Deserialize<UserPlaybackSettingsDto>(
            JsonSerializer.Serialize(source, _jsonOptions),
            _jsonOptions) ?? UserPlaybackSettingsDto.CreateDefaults(source.ProfileId);
}
