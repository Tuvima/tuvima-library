@namespace MediaEngine.Web.Components.Settings
@using System.Text.Json
@using MediaEngine.Contracts.Playback
@using MediaEngine.Contracts.Profiles
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Playback
@using Microsoft.JSInterop
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject IUserPlaybackPreferencesAccessor PreferencesAccessor
@inject IAppToastService Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<PlaybackSettingsPage> Logger
@inject IStringLocalizer<SharedStrings> L

@if (_loading)
{
    <div class="playback-settings-skeleton" aria-label="@L["PlaybackSettingsPage_LoadingPlaybackPreferences"].Value">
        @for (var index = 0; index < 3; index++)
        {
            <AppSkeleton Height="220px" />
        }
    </div>
}
else if (_forbidden)
{
    <AppAlert Severity="AppSeverity.Warning" Variant="AppVariant.Outlined">@L["Common_YouCanTChangeThis"]</AppAlert>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <AppErrorState Title="@L["PlaybackSettingsPage_PlaybackPreferencesAreUnavailable"].Value"
                   Message="@_loadError"
                   Retry="@RetryLoadAsync" />
}
else if (_settings is not null)
{
    <div class="settings-playback-page" data-playback-section="overview">
        @if (!string.IsNullOrWhiteSpace(_saveError))
        {
            <AppAlert Severity="AppSeverity.Error" Variant="AppVariant.Outlined" Dense="true">@_saveError</AppAlert>
        }

        @if (IsOtherProfile && !Embedded && _target is not null)
        {
            <div class="playback-profile-heading">
                <span class="playback-profile-heading__avatar">
                    <ProfileAvatar DisplayName="@_target.DisplayName" ImageUrl="@_target.AvatarImageUrl" Color="@_target.AvatarColor" Icon="@_target.AvatarIcon" />
                </span>
                <AppText Typo="AppTypo.h6">@L["PlaybackSettingsPage_HowWatches", _target.DisplayName]</AppText>
                <a class="playback-profile-heading__back" href="@($"/settings/profiles/{ProfileId}")">@L["Common_BackTo", _target.DisplayName]</a>
            </div>
        }

        <div class="playback-settings-grid">
            <SettingsSectionPanel Title="@L["PlaybackSettingsPage_Autoplay"].Value"
                                  Description="@L["PlaybackSettingsPage_WhatHappensWhenAnEpisode"].Value"
                                  Class="tl-card settings-section-card playback-settings-card">
                @BoolRow(
                    "Autoplay next episode",
                    "Start the next episode after a short countdown. Turn off to choose it yourself.",
                    _settings.Watching.AutoplayNextEpisode,
                    value => UpdateAndSaveAsync(s => s.Watching.AutoplayNextEpisode = value))
            </SettingsSectionPanel>

            <SettingsSectionPanel Title="@L["Common_Resume"].Value"
                                  Description="@L["PlaybackSettingsPage_WhereAMovieOrEpisode"].Value"
                                  Class="tl-card settings-section-card playback-settings-card">
                @BoolRow(
                    "Resume where you left off",
                    "Continue from your last saved position.",
                    _settings.General.ResumePlayback,
                    value => UpdateAndSaveAsync(s => s.General.ResumePlayback = value))
            </SettingsSectionPanel>

            <SettingsSectionPanel Title="@L["Common_Skip"].Value"
                                  Description="@L["PlaybackSettingsPage_HowFarThePlayerSkip"].Value"
                                  Class="tl-card settings-section-card playback-settings-card">
                @IntSelectRow(
                    "Skip back",
                    "The amount used by the rewind control.",
                    _settings.Watching.SkipBackSeconds,
                    WatchingSkipBackOptions,
                    value => UpdateAndSaveAsync(s => s.Watching.SkipBackSeconds = value))
                @IntSelectRow(
                    "Skip forward",
                    "The amount used by the forward control.",
                    _settings.Watching.SkipForwardSeconds,
                    WatchingSkipForwardOptions,
                    value => UpdateAndSaveAsync(s => s.Watching.SkipForwardSeconds = value))
            </SettingsSectionPanel>

            @if (!IsOtherProfile)
            {
                @* Only the person themselves chooses this; an administrator editing another profile does not see it. *@
                <SettingsSectionPanel Title="@L["Common_Spoilers"].Value"
                                      Description="@L["PlaybackSettingsPage_HowMuchOfAStory"].Value"
                                      Class="tl-card settings-section-card playback-settings-card">
                    <div class="playback-preference-row" data-spoiler-level>
                        <div class="playback-preference-row__copy">
                            <AppText Typo="AppTypo.body1">@L["Universe_GuideFilterCharacters"]</AppText>
                            <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">@L["PlaybackSettingsPage_UpToWhereIAm"]</AppText>
                        </div>
                        <AppSegmentedControl Options="SpoilerLevelOptions"
                                             Value="@SpoilerLevelValue"
                                             ValueChanged="SaveSpoilerLevelAsync"
                                             AriaLabel="@L["Common_Spoilers"].Value"
                                             Class="playback-preference-row__control" />
                    </div>
                </SettingsSectionPanel>
            }

            <div id="subtitles" class="playback-subtitles-group" data-playback-section="subtitles">
                <SettingsSectionPanel Title="@L["PlaybackSettingsPage_SubtitlesAudio"].Value"
                                      Description="@L["PlaybackSettingsPage_WhichLanguagePlaysFirstAnd"].Value"
                                      Class="tl-card settings-section-card playback-settings-card">
                    @StringSelectRow(
                        "Audio language",
                        "The audio track the player starts with when a title has more than one.",
                        LanguageValue(Subtitles.AudioLanguage),
                        LanguageOptionsFor(Subtitles.AudioLanguage),
                        value => UpdateAndSaveAsync(s => s.Subtitles.AudioLanguage = value))
                    @StringSelectRow(
                        "Subtitle language",
                        "The subtitles the player picks when it shows them.",
                        LanguageValue(Subtitles.DefaultSubtitleLanguage),
                        LanguageOptionsFor(Subtitles.DefaultSubtitleLanguage),
                        value => UpdateAndSaveAsync(s => s.Subtitles.DefaultSubtitleLanguage = value))
                    @StringSelectRow(
                        L["PlaybackSettingsPage_SecondSubtitleLanguage"].Value,
                        L["PlaybackSettingsPage_SecondSubtitleLanguageHint"].Value,
                        AlternateLanguage(0),
                        OptionalLanguageOptions(AlternateLanguage(0)),
                        value => UpdateAndSaveAsync(s => SetAlternateLanguage(s, 0, value)))
                    @if (!string.IsNullOrEmpty(AlternateLanguage(0)))
                    {
                        @StringSelectRow(
                            L["PlaybackSettingsPage_ThirdSubtitleLanguage"].Value,
                            L["PlaybackSettingsPage_ThirdSubtitleLanguageHint"].Value,
                            AlternateLanguage(1),
                            OptionalLanguageOptions(AlternateLanguage(1)),
                            value => UpdateAndSaveAsync(s => SetAlternateLanguage(s, 1, value)))
                    }
                    @StringSelectRow(
                        L["PlaybackSettingsPage_LyricsLanguage"].Value,
                        L["PlaybackSettingsPage_LyricsLanguageHint"].Value,
                        Subtitles.LyricsLanguage ?? string.Empty,
                        OptionalLanguageOptions(Subtitles.LyricsLanguage),
                        value => UpdateAndSaveAsync(s => s.Subtitles.LyricsLanguage = value))
                    @StringSelectRow(
                        "Show subtitles",
                        "Auto shows them only when the audio is not in your subtitle language.",
                        ShowSubtitlesValue,
                        ShowSubtitlesOptions,
                        value => UpdateAndSaveAsync(s => s.Subtitles.ForcedSubtitlesMode = value),
                        wide: true)
                </SettingsSectionPanel>

                <SettingsSectionPanel Title="@L["PlaybackSettingsPage_SubtitleAppearance"].Value"
                                      Description="@L["PlaybackSettingsPage_HowSubtitlesLookOverThe"].Value"
                                      Class="tl-card settings-section-card playback-settings-card">
                    <div class="subtitle-preview"
                         data-subtitle-size="@NormalizedSubtitleSize"
                         data-subtitle-background="@(Subtitles.SubtitleBackground ? "true" : "false")"
                         role="img"
                         aria-label="@L["PlaybackSettingsPage_SampleOfTheSubtitleStyle"].Value">
                        <p class="subtitle-preview__line"><span class="subtitle-preview__text">@L["PlaybackSettingsPage_TheRainHadStoppedBy"]</span></p>
                    </div>
                    <div class="playback-preference-row">
                        <div class="playback-preference-row__copy">
                            <AppText Typo="AppTypo.body1">@L["Common_TextSize"]</AppText>
                            <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">@L["PlaybackSettingsPage_HowLargeSubtitlesAreIn"]</AppText>
                        </div>
                        <AppSegmentedControl Options="SubtitleSizeOptions"
                                             Value="@NormalizedSubtitleSize"
                                             ValueChanged="@(value => UpdateAndSaveAsync(s => s.Subtitles.SubtitleSize = value))"
                                             AriaLabel="@L["Common_TextSize"].Value"
                                             Class="playback-preference-row__control" />
                    </div>
                    @BoolRow(
                        "Background",
                        "Put a dark box behind subtitles. Turn off to show the text with a soft shadow only.",
                        Subtitles.SubtitleBackground,
                        value => UpdateAndSaveAsync(s => s.Subtitles.SubtitleBackground = value))
                </SettingsSectionPanel>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Another household profile to edit (administrators only). Null or the active profile edits your own.</summary>
    [Parameter] public Guid? ProfileId { get; set; }

    /// <summary>Drawn as a section of a profile's Preferences tab, which already names the person, so the page leaves out its own heading.</summary>
    [Parameter] public bool Embedded { get; set; }

    /// <summary>Raised with the other profile's name once it is known, so the page can show it in the breadcrumb.</summary>
    [Parameter] public EventCallback<string?> TargetNameChanged { get; set; }

    private readonly JsonSerializerOptions _jsonOptions = MediaEngineJson.Web;
    private UserPlaybackSettingsDto? _settings;
    private ProfileViewModel? _activeProfile;
    private ProfileViewModel? _target;
    private bool _forbidden;
    private bool _loading = true;
    private string? _loadError;
    private string? _saveError;
    private readonly SemaphoreSlim _saveGate = new(1, 1);

    private bool IsOtherProfile => ProfileId is { } id && id != Guid.Empty && id != _activeProfile?.Id;

    private bool _scrolledToFragment;

    private SubtitleLanguageSettingsDto Subtitles => _settings!.Subtitles;

    private static readonly int[] WatchingSkipBackOptions = [5, 10, 15, 30];
    private static readonly int[] WatchingSkipForwardOptions = [10, 30, 60, 90];

    private static readonly IReadOnlyList<AppSelectOption> SubtitleSizeOptions =
    [
        new(PlaybackPreferenceValues.Small, "Small"),
        new(PlaybackPreferenceValues.Medium, "Medium"),
        new(PlaybackPreferenceValues.Large, "Large"),
    ];

    private IReadOnlyList<AppSelectOption> ShowSubtitlesOptions =>
    [
        new(PlaybackPreferenceValues.Auto, "Auto (only when audio is not my language)"),
        new(PlaybackPreferenceValues.ForeignAudioOnly, L["PlaybackSettingsPage_OnlyWhenAudioIsAnotherLanguage"].Value),
        new(PlaybackPreferenceValues.Always, "Always"),
        new(PlaybackPreferenceValues.Never, "Off"),
    ];

    // The second and third subtitle languages are stored as an ordered list; an empty slot means "none".
    private string AlternateLanguage(int slot) =>
        Subtitles.AlternateSubtitleLanguages is { } list && slot < list.Count ? list[slot] : string.Empty;

    private static void SetAlternateLanguage(UserPlaybackSettingsDto settings, int slot, string value)
    {
        var list = (settings.Subtitles.AlternateSubtitleLanguages ?? []).ToList();
        while (list.Count <= slot) list.Add(string.Empty);
        list[slot] = value;
        // Dropping the second choice drops the third as well; blanks never reach the Engine.
        settings.Subtitles.AlternateSubtitleLanguages = (string.IsNullOrEmpty(list[0]) ? [] : list).Where(language => !string.IsNullOrWhiteSpace(language)).ToList();
    }

    // A language list with a leading "none" entry, for choices that are optional.
    private IReadOnlyList<AppSelectOption> OptionalLanguageOptions(string? current) =>
        [new(string.Empty, L["PlaybackSettingsPage_NoPreference"].Value), .. LanguageOptionsFor(current)];

    // The Engine accepts ExtraLarge; this page offers three sizes, so it shows as the largest.
    private string NormalizedSubtitleSize => Subtitles.SubtitleSize switch
    {
        var size when string.Equals(size, PlaybackPreferenceValues.Small, StringComparison.OrdinalIgnoreCase) => PlaybackPreferenceValues.Small,
        var size when string.Equals(size, PlaybackPreferenceValues.Large, StringComparison.OrdinalIgnoreCase)
            || string.Equals(size, PlaybackPreferenceValues.ExtraLarge, StringComparison.OrdinalIgnoreCase) => PlaybackPreferenceValues.Large,
        _ => PlaybackPreferenceValues.Medium,
    };

    private static readonly IReadOnlyList<AppSelectOption> SpoilerLevelOptions =
    [
        new(ProfileSpoilerPreferenceDto.UpToProgress, "Up to where I am"),
        new(ProfileSpoilerPreferenceDto.Everything, "Everything"),
    ];

    // The first option is the default, so anything unrecognised reads as "Up to where I am".
    private string SpoilerLevelValue =>
        string.Equals(_settings?.General.SpoilerLevel, ProfileSpoilerPreferenceDto.Everything, StringComparison.OrdinalIgnoreCase)
            ? ProfileSpoilerPreferenceDto.Everything
            : ProfileSpoilerPreferenceDto.UpToProgress;

    private string ShowSubtitlesValue =>
        ShowSubtitlesOptions.FirstOrDefault(option => string.Equals(option.Value, Subtitles.ForcedSubtitlesMode, StringComparison.OrdinalIgnoreCase))?.Value
        ?? PlaybackPreferenceValues.Auto;

    // A saved language that differs only in case still selects its entry in the list.
    private static string LanguageValue(string? language) =>
        PlaybackLanguageOptions.WithCurrent(language).FirstOrDefault(option => string.Equals(option, language?.Trim(), StringComparison.OrdinalIgnoreCase))
        ?? PlaybackLanguageOptions.Common[0];

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task RetryLoadAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _forbidden = false;
        _settings = null;
        try
        {
            _activeProfile = await Orchestrator.GetActiveProfileAsync();
            if (IsOtherProfile)
            {
                var profiles = await Orchestrator.GetProfilesAsync();
                _target = profiles.FirstOrDefault(profile => profile.Id == ProfileId);
                var loaded = await ApiClient.GetPlaybackSettingsAsync(ProfileId!.Value);
                if (loaded is null || _target is null)
                {
                    _forbidden = true;
                    return;
                }

                if (loaded.ProfileId != ProfileId)
                {
                    Logger.LogWarning("Playback settings could not be loaded: the Engine answered for a different profile.");
                    _loadError = L["PlaybackSettingsPage_PlaybackSettingsCouldNotBe"].Value;
                    return;
                }

                _settings = Clone(loaded);
                await TargetNameChanged.InvokeAsync(_target.DisplayName);
            }
            else
            {
                // A missing answer means the Engine could not be reached, not that nothing is saved. Showing defaults here would
                // let the first change write them over the profile's real choices, so the page shows an error and no controls.
                var loaded = await PreferencesAccessor.GetAsync();
                if (loaded is null)
                {
                    Logger.LogWarning("Playback settings could not be loaded: the Engine returned no settings for the active profile.");
                    _loadError = L["PlaybackSettingsPage_PlaybackSettingsCouldNotBe"].Value;
                    return;
                }

                _settings = Clone(loaded);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Playback settings could not be loaded.");
            _loadError = L["PlaybackSettingsPage_PlaybackSettingsCouldNotBe"].Value;
        }
        finally
        {
            _loading = false;
        }
    }

    private RenderFragment BoolRow(string title, string description, bool value, Func<bool, Task> changed) => @<div class="playback-preference-row">
        <div class="playback-preference-row__copy">
            <AppText Typo="AppTypo.body1">@title</AppText>
            <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">@description</AppText>
        </div>
        <AppSwitchRow T="bool" Value="@value" ValueChanged="@changed" Color="AppColor.Primary" AriaLabel="@title" />
    </div>;

    private static IReadOnlyList<AppSelectOption> LanguageOptionsFor(string? current) =>
        PlaybackLanguageOptions.WithCurrent(current).Select(language => new AppSelectOption(language, language)).ToList();

    private RenderFragment StringSelectRow(
        string title,
        string description,
        string value,
        IReadOnlyList<AppSelectOption> options,
        Func<string, Task> changed,
        bool wide = false) => @<div class="playback-preference-row">
        <div class="playback-preference-row__copy">
            <AppText Typo="AppTypo.body1">@title</AppText>
            <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">@description</AppText>
        </div>
        <AppSelect Value="@value"
                   ValueChanged="@(selected => changed(selected ?? value))"
                   Variant="AppVariant.Outlined"
                   Margin="AppMargin.Dense"
                   Dense="true"
                   Size="AppControlSize.Compact"
                   Class="@(wide ? "playback-preference-row__select playback-preference-row__select--wide" : "playback-preference-row__select")"
                   aria-label="@title">
            @foreach (var option in options)
            {
                <AppSelectItem T="string" Value="@option.Value">@option.Label</AppSelectItem>
            }
        </AppSelect>
    </div>;

    private RenderFragment IntSelectRow(
        string title,
        string description,
        int value,
        IReadOnlyList<int> options,
        Func<int, Task> changed) => @<div class="playback-preference-row">
        <div class="playback-preference-row__copy">
            <AppText Typo="AppTypo.body1">@title</AppText>
            <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">@description</AppText>
        </div>
        <AppIntSelect Value="@value"
                      ValueChanged="@changed"
                      Variant="AppVariant.Outlined"
                      Margin="AppMargin.Dense"
                      Dense="true"
                      Size="AppControlSize.Compact"
                      Class="playback-preference-row__select"
                      aria-label="@title">
            @foreach (var option in options)
            {
                <AppSelectItem T="int" Value="@option">@($"{option} seconds")</AppSelectItem>
            }
        </AppIntSelect>
    </div>;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The profile page links here as /settings/playback#subtitles. The group only exists once the settings have loaded,
        // so the scroll happens after that render rather than relying on the browser's own fragment handling.
        if (_scrolledToFragment || _settings is null || !string.Equals(new Uri(Navigation.Uri).Fragment, "#subtitles", StringComparison.Ordinal))
        {
            return;
        }

        _scrolledToFragment = true;
        try
        {
            await JS.InvokeVoidAsync("tuvimaEditorScrollTo", "#subtitles");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // Best effort: the group is still on the page if the scroll cannot run (for example when the circuit is closing).
        }
    }

    private async Task UpdateAndSaveAsync(Action<UserPlaybackSettingsDto> change)
    {
        _saveError = null;
        await SaveAsync(change);
    }

    // Reads the profile's current settings and applies only the changed field to that copy, so a change made in another tab
    // or on another device since this page opened is kept. If the current settings cannot be read, nothing is saved.
    private async Task SaveAsync(Action<UserPlaybackSettingsDto> change)
    {
        if (_settings is null)
            return;

        await _saveGate.WaitAsync();
        try
        {
            var other = IsOtherProfile;
            var fresh = other
                ? await ApiClient.GetPlaybackSettingsAsync(ProfileId!.Value)
                : await Orchestrator.GetPlaybackSettingsAsync();
            if (fresh is null)
            {
                Logger.LogWarning("Playback settings were not saved: the profile's current settings could not be read.");
                _saveError = L["PlaybackSettingsPage_PlaybackSettingsCouldNotBe2"].Value;
                Snackbar.Add(_saveError, AppSeverity.Error);
                return;
            }

            if (fresh.ProfileId != _settings.ProfileId)
            {
                // These settings belong to a different person than this page shows (for example the active profile changed),
                // so nothing is saved; the page starts again from what the Engine holds.
                Logger.LogWarning("Playback settings were not saved: the current settings belong to a different profile than the page shows.");
                await LoadAsync();
                return;
            }

            change(fresh);
            var saved = other
                ? await ApiClient.UpdatePlaybackSettingsAsync(ProfileId!.Value, fresh)
                : await Orchestrator.SavePlaybackSettingsAsync(fresh);
            if (saved is null)
            {
                Logger.LogWarning("Playback settings could not be saved: the Engine did not accept the update.");
                _saveError = L["PlaybackSettingsPage_PlaybackSettingsCouldNotBe2"].Value;
                Snackbar.Add(_saveError, AppSeverity.Error);
                return;
            }

            _settings = Clone(saved);
            if (!other)
                PreferencesAccessor.UpdateCache(saved);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Playback settings could not be saved.");
            _saveError = L["PlaybackSettingsPage_PlaybackSettingsCouldNotBe2"].Value;
            Snackbar.Add(_saveError, AppSeverity.Error);
        }
        finally
        {
            _saveGate.Release();
            StateHasChanged();
        }
    }

    // The spoiler level has its own Engine action (own profile only); a playback save never changes it.
    private async Task SaveSpoilerLevelAsync(string level)
    {
        if (_settings is null || IsOtherProfile)
            return;

        _saveError = null;
        await _saveGate.WaitAsync();
        try
        {
            var saved = await ApiClient.SaveSpoilerLevelAsync(_settings.ProfileId, level);
            if (saved is null || saved.ProfileId != _settings.ProfileId)
            {
                Logger.LogWarning("The spoiler setting could not be saved: the Engine did not accept the update.");
                _saveError = L["Common_TheSpoilerSettingCouldNot"].Value;
                Snackbar.Add(_saveError, AppSeverity.Error);
                return;
            }

            _settings.General.SpoilerLevel = saved.SpoilerLevel;
            PreferencesAccessor.UpdateCache(Clone(_settings));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The spoiler setting could not be saved.");
            _saveError = L["Common_TheSpoilerSettingCouldNot"].Value;
            Snackbar.Add(_saveError, AppSeverity.Error);
        }
        finally
        {
            _saveGate.Release();
            StateHasChanged();
        }
    }

    private UserPlaybackSettingsDto Clone(UserPlaybackSettingsDto source) =>
        JsonSerializer.Deserialize<UserPlaybackSettingsDto>(
            JsonSerializer.Serialize(source, _jsonOptions),
            _jsonOptions) ?? UserPlaybackSettingsDto.CreateDefaults(source.ProfileId);
}
