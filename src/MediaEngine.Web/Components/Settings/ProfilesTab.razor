@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Web.Components.Profiles
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Ui
@using Microsoft.JSInterop
@inject UIOrchestratorService Orchestrator
@inject DashboardSessionAccessor Session
@inject DashboardIdentityClient Identity
@inject ConfirmedActionRunner Confirmed
@inject NavigationManager Nav
@inject ILogger<ProfilesTab> Logger
@inject DeviceContextService DeviceContext
@inject IJSRuntime JS
@implements IDisposable

@* Settings > Personal > Profiles: the editing page for administrators. A household administrator sees the people in their own
   household; a server administrator sees every household. Each person opens on their own page. Switching profile is only done
   from the profile menu in the top bar, never here. *@
@if (!IsAdministrator)
{
    @* Not an administrator: Manage Profiles opens your own profile, which is the only one you can look after. *@
    <AppPageState Kind="AppPageStateKind.Loading" Title="Opening your profile" Class="tl-sp-py-8" />
}
else
{
    <div class="profiles-tab" data-profile-section="overview">
        <section class="profiles-tab__people" aria-label="People">
            @if (DeviceContext.IsPhone)
            {
                <p class="access-phone-note" role="note">Manage on a computer or tablet.</p>
            }
            @if (IsServerAdministrator && !DeviceContext.IsPhone)
            {
                <div class="profiles-tab__toolbar">
                    <AppButton Label="Add household" StartIcon="@AppMaterialIcons.Outlined.Home" OnClick="OpenAddHousehold" />
                </div>
            }

            @if (_loadingPeople)
            {
                <div class="profiles-tab__loading" role="status" aria-label="Loading the people">
                    <AppSkeleton Height="56px" />
                    <AppSkeleton Height="56px" />
                    <AppSkeleton Height="56px" />
                </div>
            }
            else if (_peopleFailed)
            {
                <AppAlert Severity="AppSeverity.Warning" Variant="AppVariant.Outlined">
                    The people couldn't be loaded. Reload the page to try again.
                </AppAlert>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(_notice))
                {
                    <AppAlert Severity="AppSeverity.Info" Variant="AppVariant.Outlined" Dense="true">@_notice</AppAlert>
                }

                @foreach (var group in Groups)
                {
                    <div class="profiles-tab__group" @key="group.Id" data-household-group="@group.Id">
                        <SettingsSectionPanel Title="@group.Title" Description="@(CanExport(group) ? ExportHelp : null)">
                            <Actions>
                                @if (CanExport(group))
                                {
                                    <AppButton Label="Export this household" Loading="@(_exportingHouseholdId == group.Id)" Disabled="@(_exportingHouseholdId is not null)"
                                               OnClick="@(() => ExportHouseholdAsync(group.Id))" data-testid="@($"export-household-{group.Id}")" />
                                }
                            </Actions>
                            <ChildContent>
                            @if (_exportResultHouseholdId == group.Id && !string.IsNullOrWhiteSpace(_exportResult))
                            {
                                <AppAlert Severity="@(_exportFailed ? AppSeverity.Warning : AppSeverity.Info)" Variant="AppVariant.Outlined" Dense="true"
                                          data-testid="@($"export-household-result-{group.Id}")">@_exportResult</AppAlert>
                            }
                        <ul class="profiles-tab__list" role="list">
                            @foreach (var person in group.People)
                            {
                                <li class="profiles-tab__item @(person.Id == _draggingId ? "is-dragging" : null)" @key="person.Id" data-profile-id="@person.Id"
                                    @ondragover:preventDefault="@CanReorder(group)"
                                    @ondrop="@(() => DropAsync(group, person.Id))">
                                    <div class="profiles-tab__line">
                                        @if (CanReorder(group))
                                        {
                                            @* Drag to put people in the order Who's watching and the profile menu list them; the arrow keys do the same. *@
                                            <AppNativeButton Type="button" Class="profiles-tab__drag" draggable="true" data-testid="@($"reorder-{person.Id}")"
                                                             AriaLabel="@($"Reorder {person.DisplayName}. Drag, or use the up and down arrow keys.")"
                                                             @ondragstart="@(() => _draggingId = person.Id)" @ondragend="@(() => _draggingId = null)"
                                                             @onkeydown="@(args => ReorderByKeyAsync(group, person.Id, args))">
                                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.DragIndicator" />
                                            </AppNativeButton>
                                        }
                                        <span class="profiles-tab__row-avatar"><ProfileAvatar DisplayName="@person.DisplayName" ImageUrl="@person.AvatarImageUrl" Color="@person.AvatarColor" Icon="@person.AvatarIcon" /></span>
                                        <span class="profiles-tab__who">
                                            <span class="profiles-tab__row-name">@person.DisplayName</span>
                                            @* Read-only here: a sign-in is attached and removed by the server administrator in Users & Households. *@
                                            <small class="profiles-tab__signin" data-profile-signin="@person.Id">@SignInText(person.Id)</small>
                                        </span>
                                        <span class="profiles-tab__badges">
                                            @if (person.Id == _active?.Id)
                                            {
                                                <span class="profiles-tab__badge profiles-tab__badge--you">You</span>
                                            }
                                            @if (Managed(person.Id)?.IsHouseholdAdmin == true)
                                            {
                                                <span class="profiles-tab__badge" data-role="household-administrator">Household administrator</span>
                                            }
                                            @if (Managed(person.Id)?.IsServerAdmin == true)
                                            {
                                                <span class="profiles-tab__badge" data-role="server-administrator">Server administrator</span>
                                            }
                                            @if (person.IsRestricted)
                                            {
                                                <span class="profiles-tab__badge">Kids</span>
                                            }
                                            @if (person.HasPin)
                                            {
                                                <span class="profiles-tab__badge">PIN</span>
                                            }
                                        </span>
                                        <AppNativeButton Type="button" Class="who-button profiles-tab__edit" aria-label="@($"Edit {person.DisplayName}")" OnClick="@(() => OpenProfile(person.Id))">Edit</AppNativeButton>
                                    </div>
                                </li>
                            }
                            @if (ProfileManageRules.CanAdd(CanManage, group.People.Count))
                            {
                                <li class="profiles-tab__item">
                                    <AppNativeButton Type="button" Class="profiles-tab__row profiles-tab__row--add" aria-label="@AddLabel(group)" OnClick="@(() => OpenAdd(group.Id))">
                                        <span class="profiles-tab__row-avatar profiles-tab__row-avatar--add" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Add" /></span>
                                        <span class="profiles-tab__row-name">Add profile</span>
                                    </AppNativeButton>
                                </li>
                            }
                        </ul>
                            </ChildContent>
                        </SettingsSectionPanel>
                    </div>
                }
            }
        </section>
    </div>

    <ProfileEditorSheet Open="@_editorOpen"
                        Saving="@_editorSaving"
                        Error="@_editorError"
                        OnSave="SaveEditorAsync"
                        OnClose="CloseEditor" />

    <AdminUnlockDialog Open="@_needsUnlock" Busy="@_unlocking" Error="@_unlockError" OnUnlock="UnlockAsync" OnCancel="CancelUnlock" />
}

@code {
    private ProfileEditingWorkflow? _workflow;
    private ProfileViewModel? _active;
    private List<ProfileViewModel> _profiles = [];
    private List<ManagedProfileResponse> _managed = [];
    private List<HouseholdResponse> _households = [];
    private bool _loadingPeople = true;
    private bool _peopleFailed;
    private string? _notice;
    private bool _editorOpen;
    private Guid? _addHouseholdId;
    private bool _editorSaving;
    private string? _editorError;
    private bool _needsUnlock;
    private bool _unlocking;
    private bool _justUnlocked;
    private string? _unlockError;
    private Func<Task>? _afterUnlock;
    private readonly CancellationTokenSource _lifetime = new();
    private Guid? _exportingHouseholdId;
    private Guid? _exportResultHouseholdId;
    private bool _exportFailed;
    private string _exportResult = string.Empty;

    private const string ExportHelp = "Download a file with this household's profiles, their sign-ins, progress, bookmarks and favourites. Anyone with this file can sign in as these people. Keep it somewhere safe.";

    private Guid? _draggingId;
    private bool _reordering;

    private ProfileEditingWorkflow Workflow => _workflow ??= new ProfileEditingWorkflow(Identity, Confirmed);

    private bool IsServerAdministrator => Session.Authority?.EffectiveAdministrator == true || Session.HasNavigation("settings.administration");

    private bool IsAdministrator => Session.HasAction("household.manage") || IsServerAdministrator;

    // Add profile is for administrators, and never from inside a Kids (restricted) profile.
    // A phone only reads the list; adding people is done on a computer or tablet.
    private bool CanManage => ProfileManageRules.CanManage(_active?.IsRestricted == true, IsAdministrator) && !DeviceContext.IsPhone;

    private Guid? OwnHouseholdId => _managed.FirstOrDefault(person => person.Id == _active?.Id)?.HouseholdId;

    private IReadOnlyList<Household> Groups => BuildGroups();

    private ManagedProfileResponse? Managed(Guid profileId) => _managed.FirstOrDefault(person => person.Id == profileId);

    private string SignInText(Guid profileId) => Managed(profileId)?.User?.Email is { Length: > 0 } email ? email : "No sign-in";

    // A phone only reads the list, so the export is a computer or tablet action (checked again in the handler).
    private bool CanExport(Household group) => IsServerAdministrator && !DeviceContext.IsPhone && group.Id != Guid.Empty;

    private static string AddLabel(Household group) => $"Add profile to {group.Title}";

    protected override async Task OnInitializedAsync()
    {
        await LoadPeopleAsync();
    }

    private async Task LoadPeopleAsync()
    {
        if (!IsAdministrator)
        {
            _loadingPeople = false;
            try
            {
                _active = await Orchestrator.GetActiveProfileAsync();
            }
            catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
            {
                Logger.LogWarning(exception, "Could not find the active profile to open.");
            }

            Nav.NavigateTo(_active is null ? SettingsNav.RouteFor(SettingsSection.Overview) : $"/settings/profiles/{_active.Id:D}", replace: true);
            return;
        }

        _loadingPeople = true;
        _peopleFailed = false;
        try
        {
            _active = await Orchestrator.GetActiveProfileAsync();
            var profiles = Orchestrator.GetProfilesAsync();
            var managed = Identity.GetManagedProfilesAsync();
            var households = Identity.GetManagedHouseholdsAsync();
            _profiles = await profiles;
            _managed = await managed;
            _households = await households;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not load the people for Settings.");
            _peopleFailed = true;
        }
        finally
        {
            _loadingPeople = false;
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            // The list of people a sign-in may open comes from its authority, so refresh that first.
            await Identity.RevalidateAuthorityAsync(Session);
            await Orchestrator.RefreshProfilesAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not refresh the profile list.");
            _notice = "The list couldn't be refreshed. Reload the page to see the latest.";
        }

        await LoadPeopleAsync();
    }

    // The Engine already limits a household administrator to their own household, so the list is grouped as it arrives:
    // their household first, then (for a server administrator) every other one by name.
    private IReadOnlyList<Household> BuildGroups()
    {
        var ownId = OwnHouseholdId;
        var names = _households.ToDictionary(household => household.Id, household => household.Name);
        var groups = _managed
            .GroupBy(person => person.HouseholdId)
            .Select(group => (Key: group.Key, People: group.OrderBy(person => person.SortPosition).ThenBy(person => person.CreatedAt).Select(ToProfile).ToList()))
            .OrderByDescending(group => group.Key == ownId)
            .ThenBy(group => group.Key is { } id && names.TryGetValue(id, out var name) ? name : string.Empty, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        var result = new List<Household>();
        foreach (var group in groups)
        {
            var title = group.Key is { } id && names.TryGetValue(id, out var name)
                ? name
                : group.Key == ownId ? "Your household" : "Household";
            result.Add(new Household(group.Key ?? Guid.Empty, title, group.People));
        }

        return result;
    }

    // The sheet works with the picker's profile shape, so use the full profile when we have it and fill the rest in.
    private ProfileViewModel ToProfile(ManagedProfileResponse person)
    {
        var known = _profiles.FirstOrDefault(profile => profile.Id == person.Id);
        return known ?? new ProfileViewModel(person.Id, person.DisplayName, person.AvatarColor,
            person.IsRestricted ? "RestrictedProfile" : "Profile", person.CreatedAt,
            AvatarIcon: person.AvatarIcon, ContentLimit: person.ContentLimit,
            ContentLimitAllowUnrated: person.ContentLimitAllowUnrated);
    }

    // The order is shared by the whole household, so only an administrator changes it, never on a phone, and only when there is
    // more than one person to put in order.
    private bool CanReorder(Household group) => CanManage && group.Id != Guid.Empty && group.People.Count > 1 && !_reordering;

    private Task DropAsync(Household group, Guid targetId)
    {
        var dragged = _draggingId;
        _draggingId = null;
        if (dragged is not { } id || id == targetId || !CanReorder(group))
        {
            return Task.CompletedTask;
        }

        var order = group.People.Select(person => person.Id).ToList();
        var from = order.IndexOf(id);
        var to = order.IndexOf(targetId);
        if (from < 0 || to < 0)
        {
            return Task.CompletedTask;
        }

        order.RemoveAt(from);
        order.Insert(to, id);
        return SaveOrderAsync(group.Id, order);
    }

    private Task ReorderByKeyAsync(Household group, Guid personId, KeyboardEventArgs args)
    {
        var step = args.Key switch { "ArrowUp" => -1, "ArrowDown" => 1, _ => 0 };
        if (step == 0 || !CanReorder(group))
        {
            return Task.CompletedTask;
        }

        var order = group.People.Select(person => person.Id).ToList();
        var from = order.IndexOf(personId);
        var to = from + step;
        if (from < 0 || to < 0 || to >= order.Count)
        {
            return Task.CompletedTask;
        }

        order.RemoveAt(from);
        order.Insert(to, personId);
        return SaveOrderAsync(group.Id, order);
    }

    // The new order shows straight away and is saved at once; if the Engine refuses, the list is read again so it never lies.
    private async Task SaveOrderAsync(Guid householdId, IReadOnlyList<Guid> order)
    {
        _reordering = true;
        _notice = null;
        for (var index = 0; index < order.Count; index++)
        {
            var position = _managed.FindIndex(person => person.Id == order[index]);
            if (position >= 0)
            {
                _managed[position] = _managed[position] with { SortPosition = index };
            }
        }

        try
        {
            var result = await Identity.ReorderHouseholdPeopleResultAsync(householdId, order, _lifetime.Token);
            if (!result.Succeeded)
            {
                _notice = "The order couldn't be saved. Try again.";
                await LoadPeopleAsync();
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            // The page was left while the order was being saved; nothing is shown.
        }
        finally
        {
            _reordering = false;
        }
    }

    // Each person has their own page; the sheet here is only for adding someone.
    private void OpenProfile(Guid profileId) => Nav.NavigateTo($"/settings/profiles/{profileId:D}");

    // Adding a household is a server-administrator action; the Households page takes the name.
    private void OpenAddHousehold()
    {
        if (!IsServerAdministrator || DeviceContext.IsPhone)
        {
            return;
        }

        Nav.NavigateTo($"{SettingsNav.RouteFor(SettingsSection.Access, SettingsNav.HouseholdsSubsection)}?add=1");
    }

    // Hands the household file to the browser. A failure is told in one plain sentence, the Engine's own when it gives one.
    private async Task ExportHouseholdAsync(Guid householdId)
    {
        if (_exportingHouseholdId is not null || !IsServerAdministrator || DeviceContext.IsPhone || householdId == Guid.Empty)
        {
            return;
        }

        _exportingHouseholdId = householdId;
        _exportResultHouseholdId = householdId;
        _exportFailed = false;
        _exportResult = string.Empty;
        try
        {
            var result = await Confirmed.RunAsync(() => Identity.ExportHouseholdResultAsync(householdId, _lifetime.Token), _lifetime.Token);
            if (result.Value is { } file)
            {
                await JS.SaveZipAsync(file);
                _exportResult = "The household's file was downloaded. Keep it somewhere safe.";
            }
            else
            {
                _exportFailed = true;
                _exportResult = result.Failure == DashboardAccessMutationFailure.ConfirmItsYou ? "Nothing was downloaded. Confirm it's you to continue."
                    : !string.IsNullOrWhiteSpace(result.Message) ? result.Message
                    : result.Failure == DashboardAccessMutationFailure.Transient ? "The Engine is unavailable. Try again."
                    : "The file couldn't be made. Try again.";
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            // The page was left while the file was being made; nothing is shown.
        }
        catch (JSException)
        {
            _exportFailed = true;
            _exportResult = "The file couldn't be saved. Try again.";
        }
        finally
        {
            _exportingHouseholdId = null;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private void OpenAdd(Guid householdId)
    {
        if (!CanManage)
        {
            return;
        }

        _editorError = null;
        _addHouseholdId = householdId;
        _editorOpen = true;
    }

    private void CloseEditor()
    {
        if (!_editorSaving)
        {
            _editorOpen = false;
            _editorError = null;
        }
    }

    private Task SaveEditorAsync(ProfileEditorResult result)
    {
        _justUnlocked = false;
        return SaveAsync(result);
    }

    private async Task SaveAsync(ProfileEditorResult result)
    {
        if (_editorSaving || !CanManage)
        {
            return;
        }

        _editorSaving = true;
        _editorError = null;
        try
        {
            var outcome = await Workflow.SaveAsync(null, _addHouseholdId ?? OwnHouseholdId, result, _justUnlocked);
            await FinishAsync(outcome, () => SaveAsync(result));
        }
        finally
        {
            _editorSaving = false;
        }
    }

    private async Task FinishAsync(ProfileEditOutcome outcome, Func<Task> retry)
    {
        if (outcome.NeedsUnlock)
        {
            _needsUnlock = true;
            _unlockError = null;
            _afterUnlock = retry;
            return;
        }

        _editorError = outcome.Error;
        if (outcome.Notice is not null)
        {
            _notice = outcome.Notice;
        }

        if (outcome.Done)
        {
            await ReloadAsync();
            _editorOpen = false;
        }
    }

    private async Task UnlockAsync(string pin)
    {
        if (_unlocking)
        {
            return;
        }

        _unlocking = true;
        _unlockError = null;
        try
        {
            var unlocked = await Identity.UnlockAdministratorAsync(new GrantAdminUnlockRequest(pin));
            if (unlocked?.Unlocked != true)
            {
                _unlockError = "That PIN didn't work. Try again.";
                return;
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not unlock administrator access from Settings.");
            _unlockError = "The Engine is unavailable. Try again.";
            return;
        }
        finally
        {
            _unlocking = false;
        }

        var retry = _afterUnlock;
        _needsUnlock = false;
        _afterUnlock = null;
        _justUnlocked = true;
        if (retry is not null)
        {
            await retry();
        }
    }

    private void CancelUnlock()
    {
        _needsUnlock = false;
        _afterUnlock = null;
        _unlockError = null;
    }

    private sealed record Household(Guid Id, string Title, IReadOnlyList<ProfileViewModel> People);
}
