@namespace MediaEngine.Web.Components.Settings
@using System.Text.Json
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Playback
@inject UIOrchestratorService Orchestrator
@inject IUserPlaybackPreferencesAccessor PreferencesAccessor
@inject IAppToastService Snackbar

@if (_loading)
{
    <div class="playback-settings-skeleton" aria-label="Loading playback preferences">
        @for (var index = 0; index < 4; index++)
        {
            <AppSkeleton Height="220px" />
        }
    </div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <AppAlert Severity="AppSeverity.Error" Variant="AppVariant.Outlined">@_loadError</AppAlert>
}
else if (_settings is not null)
{
    <div class="settings-playback-page" data-playback-section="overview">
        @if (!string.IsNullOrWhiteSpace(_saveError))
        {
            <AppAlert Severity="AppSeverity.Error" Variant="AppVariant.Outlined" Dense="true">@_saveError</AppAlert>
        }

        <div class="playback-settings-grid">
            <SettingsSectionPanel Title="Resume & Progress"
                                  Description="Choose whether long-form playback starts where you left off."
                                  Class="tl-card settings-section-card playback-settings-card">
                @BoolRow(
                    "Resume automatically",
                    "Continue from your last saved position when you return to a video or audiobook.",
                    _settings.General.ResumePlayback,
                    value => UpdateAndSaveAsync(() => _settings.General.ResumePlayback = value))
            </SettingsSectionPanel>

            <SettingsSectionPanel Title="Watching"
                                  Description="Defaults used when a video playback session starts."
                                  Class="tl-card settings-section-card playback-settings-card">
                @DecimalSelectRow(
                    "Default playback speed",
                    "Applied when a movie or episode begins.",
                    _settings.Watching.DefaultPlaybackSpeed,
                    VideoSpeedOptions,
                    value => UpdateAndSaveAsync(() => _settings.Watching.DefaultPlaybackSpeed = value))
                @IntSelectRow(
                    "Skip back",
                    "The default amount used by the player rewind control.",
                    _settings.Watching.SkipBackSeconds,
                    WatchingSkipBackOptions,
                    value => UpdateAndSaveAsync(() => _settings.Watching.SkipBackSeconds = value))
                @IntSelectRow(
                    "Skip forward",
                    "The default amount used by the player forward control.",
                    _settings.Watching.SkipForwardSeconds,
                    WatchingSkipForwardOptions,
                    value => UpdateAndSaveAsync(() => _settings.Watching.SkipForwardSeconds = value))
            </SettingsSectionPanel>

            <SettingsSectionPanel Title="Listening"
                                  Description="Defaults used when an audiobook playback session starts."
                                  Class="tl-card settings-section-card playback-settings-card">
                @DecimalSelectRow(
                    "Audiobook default speed",
                    "Applied when an audiobook begins.",
                    _settings.Listening.AudiobookDefaultSpeed,
                    AudiobookSpeedOptions,
                    value => UpdateAndSaveAsync(() => _settings.Listening.AudiobookDefaultSpeed = value))
                @IntSelectRow(
                    "Skip back",
                    "The default amount used by the player rewind control.",
                    _settings.Listening.SkipBackSeconds,
                    ListeningSkipBackOptions,
                    value => UpdateAndSaveAsync(() => _settings.Listening.SkipBackSeconds = value))
                @IntSelectRow(
                    "Skip forward",
                    "The default amount used by the player forward control.",
                    _settings.Listening.SkipForwardSeconds,
                    ListeningSkipForwardOptions,
                    value => UpdateAndSaveAsync(() => _settings.Listening.SkipForwardSeconds = value))
                @IntSelectRow(
                    "Resume rewind",
                    "Rewind slightly when resuming so spoken context is not lost.",
                    _settings.Listening.ResumeRewindSeconds,
                    ListeningResumeRewindOptions,
                    value => UpdateAndSaveAsync(() => _settings.Listening.ResumeRewindSeconds = value))
            </SettingsSectionPanel>

            <SettingsSectionPanel Title="Reading"
                                  Description="Reading controls stay close to the book you are using."
                                  Class="tl-card settings-section-card playback-settings-card playback-settings-card--guidance">
                <div class="playback-guidance">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.MenuBook" Size="AppSize.Medium" aria-hidden="true" />
                    <div>
                        <AppText Typo="AppTypo.body1">Adjust text while reading</AppText>
                        <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">
                            Font, spacing, margins, and page controls are available in the reader and are saved on that device.
                        </AppText>
                    </div>
                </div>
            </SettingsSectionPanel>

            <SettingsSectionPanel Title="Subtitles & Languages"
                                  Description="Track choices depend on the media that is currently playing."
                                  Class="tl-card settings-section-card playback-settings-card playback-settings-card--guidance">
                <div class="playback-guidance">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Subtitles" Size="AppSize.Medium" aria-hidden="true" />
                    <div>
                        <AppText Typo="AppTypo.body1">Choose tracks in the player</AppText>
                        <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">
                            Audio, captions, and subtitle appearance are available from the playback controls when supported.
                        </AppText>
                    </div>
                </div>
            </SettingsSectionPanel>
        </div>
    </div>
}

@code {
    private readonly JsonSerializerOptions _jsonOptions = MediaEngineJson.Web;
    private UserPlaybackSettingsDto? _settings;
    private ProfileViewModel? _activeProfile;
    private bool _loading = true;
    private string? _loadError;
    private string? _saveError;

    private static readonly decimal[] VideoSpeedOptions = [0.5m, 0.75m, 1m, 1.25m, 1.5m, 2m];
    private static readonly decimal[] AudiobookSpeedOptions = [0.5m, 0.75m, 1m, 1.25m, 1.5m, 1.75m, 2m, 2.5m, 3m];
    private static readonly int[] WatchingSkipBackOptions = [5, 10, 15, 30];
    private static readonly int[] WatchingSkipForwardOptions = [10, 30, 60, 90];
    private static readonly int[] ListeningSkipBackOptions = [10, 15, 30];
    private static readonly int[] ListeningSkipForwardOptions = [15, 30, 60];
    private static readonly int[] ListeningResumeRewindOptions = [0, 5, 10, 15, 30];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _activeProfile = await Orchestrator.GetActiveProfileAsync();
            var loaded = await PreferencesAccessor.GetAsync();
            _settings = Clone(loaded ?? UserPlaybackSettingsDto.CreateDefaults(_activeProfile?.Id ?? Guid.Empty));
        }
        catch
        {
            _loadError = "Playback and reading settings could not be loaded.";
        }
        finally
        {
            _loading = false;
        }
    }

    private RenderFragment BoolRow(string title, string description, bool value, Func<bool, Task> changed) => @<div class="playback-preference-row">
        <div class="playback-preference-row__copy">
            <AppText Typo="AppTypo.body1">@title</AppText>
            <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">@description</AppText>
        </div>
        <AppSwitchRow T="bool" Value="@value" ValueChanged="@changed" Color="AppColor.Primary" AriaLabel="@title" />
    </div>;

    private RenderFragment IntSelectRow(
        string title,
        string description,
        int value,
        IReadOnlyList<int> options,
        Func<int, Task> changed) => @<div class="playback-preference-row">
        <div class="playback-preference-row__copy">
            <AppText Typo="AppTypo.body1">@title</AppText>
            <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">@description</AppText>
        </div>
        <AppIntSelect Value="@value"
                      ValueChanged="@changed"
                      Variant="AppVariant.Outlined"
                      Margin="AppMargin.Dense"
                      Dense="true"
                      Size="AppControlSize.Compact"
                      Class="playback-preference-row__select"
                      aria-label="@title">
            @foreach (var option in options)
            {
                <AppSelectItem T="int" Value="@option">@($"{option} seconds")</AppSelectItem>
            }
        </AppIntSelect>
    </div>;

    private RenderFragment DecimalSelectRow(
        string title,
        string description,
        decimal value,
        IReadOnlyList<decimal> options,
        Func<decimal, Task> changed) => @<div class="playback-preference-row">
        <div class="playback-preference-row__copy">
            <AppText Typo="AppTypo.body1">@title</AppText>
            <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">@description</AppText>
        </div>
        <AppSelect Value="@value.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                   ValueChanged="@(raw => OnDecimalChangedAsync(raw, changed))"
                   Variant="AppVariant.Outlined"
                   Margin="AppMargin.Dense"
                   Dense="true"
                   Size="AppControlSize.Compact"
                   Class="playback-preference-row__select"
                   aria-label="@title">
            @foreach (var option in options)
            {
                <AppSelectItem T="string" Value="@option.ToString(System.Globalization.CultureInfo.InvariantCulture)">@DisplayFormat.FormatSpeedSetting(option)</AppSelectItem>
            }
        </AppSelect>
    </div>;

    private static Task OnDecimalChangedAsync(string? raw, Func<decimal, Task> changed) =>
        decimal.TryParse(raw, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var value)
            ? changed(value)
            : Task.CompletedTask;

    private async Task UpdateAndSaveAsync(Action update)
    {
        update();
        _saveError = null;
        await SaveAsync();
    }

    private async Task SaveAsync()
    {
        if (_settings is null)
            return;

        try
        {
            var saved = await Orchestrator.SavePlaybackSettingsAsync(_settings);
            if (saved is null)
            {
                _saveError = "Playback and reading settings could not be saved.";
                Snackbar.Add(_saveError, AppSeverity.Error);
                return;
            }

            _settings = Clone(saved);
            PreferencesAccessor.UpdateCache(saved);
        }
        catch
        {
            _saveError = "Playback and reading settings could not be saved.";
            Snackbar.Add(_saveError, AppSeverity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private UserPlaybackSettingsDto Clone(UserPlaybackSettingsDto source) =>
        JsonSerializer.Deserialize<UserPlaybackSettingsDto>(
            JsonSerializer.Serialize(source, _jsonOptions),
            _jsonOptions) ?? UserPlaybackSettingsDto.CreateDefaults(source.ProfileId);
}
