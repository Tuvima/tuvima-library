@namespace MediaEngine.Web.Components.Settings
@inject UIOrchestratorService Orchestrator

<div class="tl-page">
    <AppActionBar Align="AppHorizontalAlignment.End" Class="mb-3">
        <AppButton Label="Refresh" Size="AppControlSize.Compact" OnClick="RefreshAsync" Disabled="_loading" />
    </AppActionBar>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <AppAlert Tone="@MessageTone" Class="mb-3">@_message</AppAlert>
    }

    @if (_config is not null)
    {
        <AppCard Title="Resource profile"
                 Description="Tuvima Library downloads and runs one text model. Advanced is available only after this machine passes its benchmark."
                 Class="mb-3">
            <div class="model-card__header">
                <AppChip Text="Essential · Qwen3 0.6B Q8" Tone="@ProfileTone("essential")" />
                <AppChip Text="Standard · Qwen3 1.7B Q5" Tone="@ProfileTone("standard")" />
                <AppChip Text="Advanced · Qwen3 4B Q4" Tone="@ProfileTone("advanced")" />
            </div>
            <div class="mt-3">
                <AppChip Text="@($"Effective on this machine · {_config.EffectiveResourceProfile}")" Tone="AppUiTone.Info" />
            </div>
            <AppActionBar Align="AppHorizontalAlignment.Start" Class="mt-3">
                <AppButton Label="Use Essential" Size="AppControlSize.Compact" Disabled="@ProfileSelected("essential")" OnClick="@(() => SelectProfileAsync("essential"))" />
                <AppButton Label="Use Standard" Size="AppControlSize.Compact" Disabled="@ProfileSelected("standard")" OnClick="@(() => SelectProfileAsync("standard"))" />
                <AppButton Label="Use Advanced" Size="AppControlSize.Compact" Disabled="@AdvancedUnavailable" OnClick="@(() => SelectProfileAsync("advanced"))" />
            </AppActionBar>
            <div class="mt-3">
                <AppSwitchRow Value="@_config.AudioPackEnabled"
                              ValueChanged="SetAudioPackAsync"
                              Label="Optional Whisper feature pack"
                              Description="Whisper is not downloaded during basic setup. Enable this only when audio transcription or alignment is needed." />
            </div>
        </AppCard>

        <AppCard Title="Current-machine benchmark" Class="mb-3">
            <span class="model-card__meta">@BenchmarkSummary(_profile)</span>
            @if (!string.IsNullOrWhiteSpace(_profile?.FailureMessage))
            {
                <AppAlert Tone="AppUiTone.Warning" Class="mt-2">@_profile.FailureMessage</AppAlert>
            }
            <AppActionBar Align="AppHorizontalAlignment.Start" Class="mt-3">
                <AppButton Label="Run benchmark again" Size="AppControlSize.Compact" Tone="AppUiTone.Primary" Disabled="_benchmarking" OnClick="RunHardwareBenchmarkAsync" />
                <AppButton Label="Invalidate benchmark" Size="AppControlSize.Compact" Tone="AppUiTone.Warning" Disabled="_benchmarking" OnClick="InvalidateBenchmarkAsync" />
            </AppActionBar>
        </AppCard>
    }

    @if (_loading)
    {
        <AppProgressBar Indeterminate="true" />
    }
    else if (_models.Count == 0)
    {
        <AppAlert Tone="AppUiTone.Warning">The selected model status is unavailable.</AppAlert>
    }
    else
    {
        <div class="models-grid">
            @foreach (var model in _models)
            {
                <AppCard Class="model-card">
                    <div class="model-card__header">
                        <AppChip Text="@(model.ModelType.Equals("Audio", StringComparison.OrdinalIgnoreCase) ? "Optional audio" : "Selected text")" Tone="AppUiTone.Primary" />
                        <AppChip Text="@StateLabel(model)" Tone="@StateTone(model)" />
                    </div>
                    <strong class="model-card__title">@ModelTitle(model)</strong>
                    <span class="model-card__meta">@model.ModelFile · @FormatMb(model.SizeMB) · @model.Quantization</span>
                    <span class="model-card__meta">On disk: @DiskLabel(model) · Checksum: @model.ChecksumStatus</span>
                    @foreach (var warning in model.ValidationWarnings.Concat(model.BlockingReasons).Distinct(StringComparer.Ordinal))
                    {
                        <AppAlert Tone="AppUiTone.Warning" Class="mt-2">@warning</AppAlert>
                    }
                    @if (model.State.Equals("Downloading", StringComparison.OrdinalIgnoreCase))
                    {
                        <AppProgressBar Value="@model.DownloadProgressPercent" ShowValue="true" Class="mt-3" />
                    }
                    <AppActionBar Align="AppHorizontalAlignment.Start" Class="mt-3">
                        <AppButton Label="Download" Size="AppControlSize.Compact" Tone="AppUiTone.Primary" Disabled="@(!CanDownload(model))" OnClick="@(() => RunAction(model.Role, AiModelAction.Download))" />
                        <AppButton Label="Cancel" Size="AppControlSize.Compact" Tone="AppUiTone.Warning" Disabled="@(!CanCancel(model))" OnClick="@(() => RunAction(model.Role, AiModelAction.Cancel))" />
                        <AppButton Label="Load" Size="AppControlSize.Compact" Tone="AppUiTone.Success" Disabled="@(!CanLoad(model))" OnClick="@(() => RunAction(model.Role, AiModelAction.Load))" />
                        <AppButton Label="Unload" Size="AppControlSize.Compact" Disabled="@(!CanUnload(model))" OnClick="@(() => RunAction(model.Role, AiModelAction.Unload))" />
                    </AppActionBar>
                </AppCard>
            }
        </div>
    }
</div>

@code {
    private List<AiModelStatusDto> _models = [];
    private AiConfigDto? _config;
    private HardwareProfileDto? _profile;
    private bool _loading;
    private bool _benchmarking;
    private string? _message;
    private AppSeverity _messageSeverity = AppSeverity.Info;
    private AppUiTone MessageTone => _messageSeverity switch
    {
        AppSeverity.Success => AppUiTone.Success,
        AppSeverity.Warning => AppUiTone.Warning,
        AppSeverity.Error => AppUiTone.Error,
        _ => AppUiTone.Info,
    };
    private bool AdvancedUnavailable => _profile?.AdvancedEligible != true || ProfileSelected("advanced");

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        _loading = true;
        _config = await Orchestrator.GetAiConfigAsync();
        _profile = await Orchestrator.GetAiProfileAsync();
        _models = (await Orchestrator.GetAiModelStatusesAsync()).ToList();
        _loading = false;
    }

    private bool ProfileSelected(string profile) =>
        string.Equals(_config?.ResourceProfile, profile, StringComparison.OrdinalIgnoreCase);

    private AppUiTone ProfileTone(string profile) => ProfileSelected(profile) ? AppUiTone.Success : AppUiTone.Neutral;

    private async Task SelectProfileAsync(string profile)
    {
        if (_config is null)
            return;
        _config.ResourceProfile = profile;
        var saved = await Orchestrator.SaveAiConfigAsync(_config);
        _messageSeverity = saved ? AppSeverity.Success : AppSeverity.Error;
        _message = saved
            ? $"{profile} selected. Restart the Engine to activate a different physical text artifact."
            : "The resource profile could not be saved.";
        await RefreshAsync();
    }

    private async Task SetAudioPackAsync(bool enabled)
    {
        if (_config is null)
            return;
        _config.AudioPackEnabled = enabled;
        var saved = await Orchestrator.SaveAiConfigAsync(_config);
        if (saved && enabled)
            await Orchestrator.StartAiModelDownloadAsync("audio");
        _messageSeverity = saved ? AppSeverity.Success : AppSeverity.Error;
        _message = saved ? (enabled ? "Whisper feature pack enabled." : "Whisper feature pack disabled.") : "Audio feature-pack setting could not be saved.";
        await RefreshAsync();
    }

    private async Task RunHardwareBenchmarkAsync()
    {
        _benchmarking = true;
        var result = await Orchestrator.RunBenchmarkAsync();
        _benchmarking = false;
        _messageSeverity = result.Succeeded && result.Value?.Outcome == "succeeded" ? AppSeverity.Success : AppSeverity.Warning;
        _message = result.Succeeded ? BenchmarkSummary(result.Value) : result.Problem?.ToUserMessage() ?? "Benchmark failed.";
        await RefreshAsync();
    }

    private async Task InvalidateBenchmarkAsync()
    {
        _benchmarking = true;
        var result = await Orchestrator.InvalidateBenchmarkAsync();
        _benchmarking = false;
        _messageSeverity = result.Succeeded ? AppSeverity.Success : AppSeverity.Error;
        _message = result.Succeeded ? "The saved benchmark was invalidated." : result.Problem?.ToUserMessage() ?? "Benchmark invalidation failed.";
        await RefreshAsync();
    }

    private async Task RunAction(string role, AiModelAction action)
    {
        var result = action switch
        {
            AiModelAction.Download => await Orchestrator.StartAiModelDownloadAsync(role),
            AiModelAction.Cancel => await Orchestrator.CancelAiModelDownloadAsync(role),
            AiModelAction.Load => await Orchestrator.LoadAiModelAsync(role),
            AiModelAction.Unload => await Orchestrator.UnloadAiModelAsync(role),
            _ => AiOperationResultDto.Failure(new AiProblemDetailsDto { Title = "Unsupported AI action" }),
        };
        _messageSeverity = result.Succeeded ? AppSeverity.Success : AppSeverity.Error;
        _message = result.Succeeded ? $"{action} requested for {role}." : result.Problem?.ToUserMessage() ?? $"{action} failed.";
        await RefreshAsync();
    }

    private static string BenchmarkSummary(HardwareProfileDto? profile) => profile?.Outcome switch
    {
        "succeeded" => $"Succeeded on this machine at {profile.TokensPerSecond.GetValueOrDefault():F1} tokens/sec. Advanced eligibility: {(profile.AdvancedEligible ? "eligible" : "not eligible")}.",
        "failed" => "The benchmark failed. No throughput value was recorded and Advanced remains locked.",
        "invalidated" => "The prior benchmark is invalid for this machine and will not be reused.",
        _ => "No benchmark has been recorded for this machine.",
    };

    private static bool CanDownload(AiModelStatusDto model) => model.CanOperate && IsState(model, "NotDownloaded", "Error");
    private static bool CanCancel(AiModelStatusDto model) => IsState(model, "Downloading");
    private static bool CanLoad(AiModelStatusDto model) => model.CanOperate && IsState(model, "Ready") && !model.Loaded;
    private static bool CanUnload(AiModelStatusDto model) => model.Loaded || model.Active || IsState(model, "Loaded");
    private static bool IsState(AiModelStatusDto model, params string[] states) => states.Any(state => model.State.Equals(state, StringComparison.OrdinalIgnoreCase));
    private static string StateLabel(AiModelStatusDto model) => model.Active ? "Active" : model.Loaded ? "Loaded" : model.State;
    private static string ModelTitle(AiModelStatusDto model) => string.IsNullOrWhiteSpace(model.DisplayName) ? model.Description : model.DisplayName;
    private static AppUiTone StateTone(AiModelStatusDto model) => StateLabel(model).ToLowerInvariant() switch
    {
        "active" or "loaded" or "ready" => AppUiTone.Success,
        "downloading" => AppUiTone.Info,
        "error" => AppUiTone.Error,
        _ => AppUiTone.Warning,
    };
    private static string FormatMb(long mb) => mb >= 1024 ? $"{mb / 1024.0:F1} GB" : $"{mb} MB";
    private static string DiskLabel(AiModelStatusDto model) => model.DiskStatus == "present" ? "present" : "not downloaded";
    private enum AiModelAction { Download, Cancel, Load, Unload }
}
