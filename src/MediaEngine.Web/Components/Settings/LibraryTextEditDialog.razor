@namespace MediaEngine.Web.Components.Settings
@inject IStringLocalizer<SharedStrings> L
<AppDialogShell Title="@Label" Size="Medium" OnClose="@(() => Dialog.Cancel())">
    <ChildContent><AppTextField Label="@Label" Value="@_draft" ValueChanged="@((string? value) => _draft = value ?? string.Empty)" /></ChildContent>
    <FooterContent>
        <AppButton Label="@L["Search_Cancel"].Value" ButtonStyle="AppButtonStyle.Text" OnClick="@(() => Dialog.Cancel())" />
        <AppButton Label="@L["Common_Apply"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@string.IsNullOrWhiteSpace(_draft)" OnClick="@(() => Dialog.Close(AppDialogResult.Ok(_draft.Trim())))" />
    </FooterContent>
</AppDialogShell>
@code {
    [CascadingParameter] private IAppDialogContext Dialog { get; set; } = default!;
    [Parameter] public string Label { get; set; } = "Name";
    [Parameter] public string Value { get; set; } = "";
    private string _draft = "";
    protected override void OnInitialized() => _draft = Value;
}
