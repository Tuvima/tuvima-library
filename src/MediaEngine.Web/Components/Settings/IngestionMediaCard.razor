@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Ingestion

<div class="ingestion-media-card-shell is-@Item.Availability @(IsList ? "is-list" : null)">
    @if (IsList)
    {
        <AppNativeButton Type="button"
                         Class="ingestion-media-list-row"
                         AriaLabel="@CardAriaLabel"
                         OnClick="@(_ => OnOpen.InvokeAsync(Item))">
            <span class="ingestion-media-list-row__identity">
                <span class="ingestion-media-list-row__art">
                    <AppMediaArtwork ImageUrl="@Item.CoverUrl" Alt="" FallbackIcon="@MediaIcon(Item.MediaType)" />
                </span>
                <span class="ingestion-media-list-row__copy">
                    <strong title="@Item.Title">@Item.Title</strong>
                    <small title="@DisplaySubtitle">@DisplaySubtitle</small>
                </span>
            </span>
            <span class="ingestion-media-list-row__format">
                <strong><AppMaterialIcon Icon="@MediaIcon(Item.MediaType)" aria-hidden="true" />@FriendlyType(Item.MediaType)</strong>
                <small title="@CountLabel">@CountLabel</small>
            </span>
            <span class="ingestion-media-list-row__status is-@Item.Availability" title="@ActivityLabel">
                <AppMaterialIcon Icon="@ActivityIcon" aria-hidden="true" />
                @if (!Item.Availability.Equals("ready", StringComparison.OrdinalIgnoreCase))
                {
                    <span>@ActivityLabel</span>
                }
            </span>
            <span class="ingestion-media-list-row__details"><IngestionFacetIndicators Item="Item" /></span>
        </AppNativeButton>
    }
    else
    {
        <AppNativeButton Type="button"
                         Class="@($"ingestion-media-card {ProgressToneClass}")"
                         AriaLabel="@CardAriaLabel"
                         title="@ProgressTooltip"
                         OnClick="@(_ => OnOpen.InvokeAsync(Item))">
            <span class="ingestion-media-card__art">
                <AppMediaArtwork ImageUrl="@Item.CoverUrl" Alt="" FallbackIcon="@MediaIcon(Item.MediaType)" />
                <span class="ingestion-media-card__progress" aria-hidden="true">
                    <AppProgressBar Value="@(Item.ProgressPercent ?? 0)" ShowValue="false" />
                </span>
            </span>
            <strong class="ingestion-media-card__title" title="@Item.Title">@Item.Title</strong>
        </AppNativeButton>
    }
</div>

@code {
    [Parameter, EditorRequired] public IngestionMediaGroupDto Item { get; set; } = new();
    [Parameter] public EventCallback<IngestionMediaGroupDto> OnOpen { get; set; }
    [Parameter] public string DisplayMode { get; set; } = "card";

    private bool IsList => DisplayMode.Equals("list", StringComparison.OrdinalIgnoreCase);

    // Reserve the contributor row while metadata loads. TV may supply season
    // context here; a fallback media type is not a contributor.
    private string? DisplaySubtitle => string.IsNullOrWhiteSpace(Item.Subtitle)
        || Item.Subtitle == Item.MediaType || Item.Subtitle == FriendlyType(Item.MediaType)
            ? null : Item.Subtitle;
    private string ActivityLabel => Item.Availability == "ready" ? "Ready to browse" : Item.StatusLabel;
    private string ActivityIcon => Item.Availability switch
    {
        "ready" => AppMaterialIcons.Outlined.CheckCircle,
        "review" => AppMaterialIcons.Outlined.WarningAmber,
        "failed" => AppMaterialIcons.Outlined.ErrorOutline,
        _ => Item.StatusLabel switch
        {
            "Adding people" => AppMaterialIcons.Outlined.Groups,
            "Finishing artwork" => AppMaterialIcons.Outlined.Image,
            "Building relationships" => AppMaterialIcons.Outlined.AccountTree,
            "Adding lyrics" => AppMaterialIcons.Outlined.Lyrics,
            "Adding subtitles" => AppMaterialIcons.Outlined.ClosedCaption,
            "Identifying" or "Finishing details" => AppMaterialIcons.Outlined.ManageSearch,
            _ => AppMaterialIcons.Outlined.Sync,
        },
    };
    private string? CountLabel => Item.ChildUnit is not null && Item.ChildCompleted > 0
        ? $"{Item.ChildCompleted:N0} {DisplayChildUnit(Item.ChildCompleted)} added"
            + (Item.FileCount > 0 && Item.ChildUnit != "files" ? $" · {FileLabel}" : string.Empty)
        : Item.FileCount > 0 ? FileLabel : null;
    private string FileLabel => $"{Item.FileCount:N0} {(Item.FileCount == 1 ? "file" : "files")}";
    private IngestionProgressGateDto? CurrentGate => Item.ProgressGates.FirstOrDefault(gate => gate.Key == Item.CurrentGateKey)
        ?? Item.ProgressGates.FirstOrDefault(gate => gate.State != "complete");
    private string ProgressToneClass => CurrentGate?.State switch
    {
        "retry" => "is-retrying",
        "blocked" => "is-blocked",
        _ => string.Empty,
    };
    private string CardAriaLabel => $"Open ingestion details for {Item.Title}. {Item.ProgressPercent ?? 0}% complete. {Item.CurrentGateLabel ?? ActivityLabel}.";
    private string ProgressTooltip => string.Join(Environment.NewLine,
        new[] { Item.Title, $"{Item.ProgressPercent ?? 0}% · {Item.CurrentGateLabel ?? ActivityLabel}" }
            .Concat(Item.ProgressGates.Select(gate => $"{GateMarker(gate.State)} {gate.Label}")));

    private static string GateMarker(string state) => state switch
    {
        "complete" => "✓",
        "active" => "●",
        "retry" => "!",
        "blocked" => "×",
        _ => "○",
    };

    private string DisplayChildUnit(int count) => count == 1 && Item.ChildUnit!.EndsWith('s')
        ? Item.ChildUnit[..^1]
        : Item.ChildUnit!;

    internal static string FriendlyType(string mediaType) => mediaType switch
    {
        "TV" => "TV Show",
        "Music" => "Album",
        "Movies" => "Movie",
        "Audiobooks" => "Audiobook",
        "Comics" => "Comic",
        "Books" => "Book",
        _ => mediaType,
    };

    internal static string MediaIcon(string mediaType) => mediaType switch
    {
        "TV" => AppMaterialIcons.Outlined.Tv,
        "Music" => AppMaterialIcons.Outlined.Album,
        "Movies" => AppMaterialIcons.Outlined.Movie,
        "Audiobooks" => AppMaterialIcons.Outlined.Headphones,
        "Comics" => AppMaterialIcons.Outlined.CollectionsBookmark,
        "Books" => AppMaterialIcons.Outlined.MenuBook,
        _ => AppMaterialIcons.Outlined.PlayCircle,
    };
}
