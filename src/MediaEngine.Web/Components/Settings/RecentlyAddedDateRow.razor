@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Ingestion

<a class="recent-additions-row" href="@Href" aria-label="@($"View all {Day.TotalCount} items added {DateLabel}")">
    <span class="recent-additions-row__date"><strong>@DateLabel</strong><small>@Day.Date.ToString("MMM d, yyyy")</small><em>@Day.TotalCount.ToString("N0") items</em></span>
    <span class="recent-additions-row__covers" aria-hidden="true">
        @foreach (var item in Day.Items)
        {
            <span><AppMediaArtwork ImageUrl="@item.CoverUrl" Alt="" FallbackIcon="@IngestionMediaCard.MediaIcon(item.MediaType)" /></span>
        }
        @if (Remaining > 0)
        {
            <b>+@Remaining.ToString("N0")<small>more</small></b>
        }
    </span>
    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" />
</a>

@code {
    [Parameter, EditorRequired] public IngestionRecentDayDto Day { get; set; } = new();
    private int Remaining => Math.Max(0, Day.TotalCount - Day.Items.Count);
    private string Href => $"/settings/recently-added?date={Day.Date:yyyy-MM-dd}";
    private string DateLabel
    {
        get
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            if (Day.Date == today) return "Today";
            if (Day.Date == today.AddDays(-1)) return "Yesterday";
            return Day.Date.ToString("MMMM d");
        }
    }
}
