@namespace MediaEngine.Web.Components.Settings
@using System.Net.Http.Json
@using System.Text.Json
@using MediaEngine.Contracts.Development
@using MediaEngine.Web.Services.Integration
@using MudBlazor
@inject DashboardCircuitHttpClientFactory HttpFactory

<div class="settings-internal-tool" data-temporary-tool="enrichment-tester">

    <MudText Typo="Typo.h4" GutterBottom="true"
             Class="tl-u-color-tl-text-primary tl-u-font-family-app-font-sans tl-u-font-weight-700">
        Enrichment Tester
    </MudText>
    <MudText Typo="Typo.body2" Class="mb-6 tl-u-color-tl-text-secondary"
             >
        Enter a title, ISBN, or identifier to search Wikidata. Select a result to see full enrichment data.
    </MudText>
<AppPanel Elevation="0" Class="pa-4 mb-6 tl-u-background-tl-divider tl-u-border-1px-solid-tl-border-subtle tl-u-border-radius-12px"
              >
        <MudGrid>
            <MudItem xs="12" sm="5">
                <AppTextField @bind-Value="_title"
                              Label="Title"
                              Placeholder="e.g. Dune"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              OnKeyUp="@OnKeyUp" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <AppTextField @bind-Value="_author"
                              Label="Author (optional)"
                              Placeholder="e.g. Frank Herbert"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <AppSelect @bind-Value="_mediaType"
                           Label="Media Type"
                           Variant="Variant.Outlined">
                    @foreach (var mt in _mediaTypes)
                    {
                        <MudSelectItem Value="@mt">@mt</MudSelectItem>
                    }
                </AppSelect>
            </MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-center">
                <AppButton ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary"
                           FullWidth="true"
                           OnClick="@Search"
                           Disabled="@(_loading || string.IsNullOrWhiteSpace(_title))"
                           StartIcon="@Icons.Material.Outlined.Bolt">
                    Search
                </AppButton>
            </MudItem>
        </MudGrid>
    </AppPanel>
@if (_loading)
    {
        <AppProgressBar Indeterminate="true" Color="Color.Primary" Class="mb-4 tl-u-border-radius-4px"
                            />
        <MudText Typo="Typo.body2" Class="mb-4 tl-u-color-tl-text-secondary" >
            Searching Wikidata...
        </MudText>
    }
@if (_enriching)
    {
        <AppProgressBar Indeterminate="true" Color="Color.Secondary" Class="mb-4 tl-u-border-radius-4px"
                            />
        <MudText Typo="Typo.body2" Class="mb-4 tl-u-color-tl-text-secondary" >
            Running full enrichment...
        </MudText>
    }
@if (_error is not null)
    {
        <AppAlert Severity="Severity.Error" Class="mb-4" Dense="true">@_error</AppAlert>
    }
@if (_enrichUniverseMessage is not null)
    {
        <AppAlert Severity="Severity.Success" Class="mb-4" Dense="true"
                  Icon="@Icons.Material.Filled.Collections"
                  ShowCloseIcon="true"
                  CloseIconClicked="@(() => _enrichUniverseMessage = null)">
            @_enrichUniverseMessage
        </AppAlert>
    }
@if (_candidates is not null && _selectedCandidate is null && !_loading)
    {
        @if (_candidates.Count == 0)
        {
            <AppPanel Elevation="0" Class="pa-4 mb-4 tl-u-background-rgba-255-255-255-0-03 tl-u-border-1px-solid-tl-border-subtle tl-u-border-radius-10px"
                      >
                <MudText Typo="Typo.body2" Class="tl-u-color-tl-text-muted">
                    No candidates found. Try a different title or media type.
                </MudText>
            </AppPanel>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-3 tl-u-color-tl-text-secondary" >
                @_candidates.Count candidate(s) found - click one to run full enrichment.
            </MudText>

            <MudGrid Class="mb-4">
                @foreach (var candidate in _candidates)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <AppPanel Elevation="0" Class="pa-3 cursor-pointer tl-u-background-tl-divider tl-u-border-1px-solid-tl-border-subtle tl-u-border-radius-10px tl-u-transition-border-color-0-2s"
                                  
                                  @onclick="() => SelectCandidate(candidate)">
                            <div class="d-flex align-center gap-2 mb-2">
                                <AppChip T="string" Size="Size.Small" Color="Color.Primary"
                                         Class="tl-u-height-20px tl-u-font-size-xs">
                                    @candidate.Qid
                                </AppChip>
                                @if (candidate.Match)
                                {
                                    <AppChip T="string" Size="Size.Small" Color="Color.Success"
                                             Class="tl-u-height-20px tl-u-font-size-xs">
                                        Auto-match
                                    </AppChip>
                                }
                            </div>
                            <MudText Typo="Typo.body1" Class="tl-u-color-tl-text-primary tl-u-font-weight-600">
                                @candidate.Label
                            </MudText>
                            @if (!string.IsNullOrEmpty(candidate.Description))
                            {
                                <MudText Typo="Typo.body2"  Class="mt-1 tl-u-color-tl-text-secondary tl-u-font-size-0-8rem">
                                    @candidate.Description
                                </MudText>
                            }
                            @if (!string.IsNullOrEmpty(candidate.WikidataUrl))
                            {
                                <a href="@candidate.WikidataUrl" target="_blank"
                                   @onclick:stopPropagation="true"
                                   class="tl-u-color-tl-status-info tl-u-font-size-xs tl-u-text-decoration-none tl-u-display-inline-block tl-u-margin-top-4px">
                                    View on Wikidata ^
                                </a>
                            }
                            <AppProgressBar Value="@(candidate.Score * 100)" Color="Color.Primary"
                                               Class="mt-2 tl-u-border-radius-4px tl-u-height-4px"  />
                            <MudText Typo="Typo.caption"  Class="mt-1 tl-u-color-tl-text-muted">
                                Score: @candidate.Score.ToString("P0")
                            </MudText>
                        </AppPanel>
                    </MudItem>
                }
            </MudGrid>
        }
    }
@if (_selectedCandidate is not null && !_enriching)
    {
        @* Back button + selected candidate header + Enrich Universe *@
        <div class="d-flex align-center gap-3 mb-4">
            <AppIconButton Icon="@Icons.Material.Outlined.ArrowBack"
                           Tone="AppUiTone.Neutral"
                           OnClick="@BackToSearch" />
            <AppChip T="string" Color="Color.Primary" Size="Size.Small">
                @_selectedCandidate.Qid
            </AppChip>
            <MudText Typo="Typo.h6" Class="tl-u-color-tl-text-primary tl-u-font-weight-600">
                @_selectedCandidate.Label
            </MudText>
            <MudSpacer />
            <AppButton ButtonStyle="AppButtonStyle.Outlined"
                       Tone="AppUiTone.Info"
                       OnClick="@EnrichUniverse"
                       Disabled="@_enrichingUniverse"
                       StartIcon="@Icons.Material.Outlined.Collections"
                       Size="AppControlSize.Compact">
                @if (_enrichingUniverse)
                {
                    <AppSpinner Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    @:Enriching...
                }
                else
                {
                    @:Enrich Universe
                }
            </AppButton>
        </div>
@if (_result is not null)
        {
<MudText Typo="Typo.h6" Class="mb-2 tl-u-color-tl-accent-primary tl-u-font-family-app-font-sans tl-u-font-weight-600"
                     >
                Identity
            </MudText>
            <AppPanel Elevation="0" Class="pa-4 mb-4 tl-u-background-tl-divider tl-u-border-1px-solid-tl-border-subtle tl-u-border-radius-10px"
                      >
                <div class="d-flex align-center gap-4 mb-3">
                    @* Cover art *@
                    @{
                        var coverUrl = _result.ClaimGroups
                            .FirstOrDefault(g => g.FieldKey == "cover")?.Claims
                            .FirstOrDefault()?.Value;
                    }
                    @if (!string.IsNullOrEmpty(coverUrl))
                    {
                        <MudImage Src="@coverUrl" Alt="Cover" Width="80" Height="120"
                                  ObjectFit="ObjectFit.Cover"
                                  Class="tl-u-border-radius-6px tl-u-flex-shrink-0" />
                    }

                    <div>
                        @if (_result.ResolvedQid is not null)
                        {
                            <AppChip T="string" Icon="@Icons.Material.Outlined.Link"
                                     Color="Color.Primary" Size="Size.Small" Class="mb-1">
                                QID: @_result.ResolvedQid
                            </AppChip>
                        }
                        else
                        {
                            <AppChip T="string" Icon="@Icons.Material.Outlined.HelpOutline"
                                     Color="Color.Warning" Size="Size.Small" Class="mb-1">
                                No QID resolved
                            </AppChip>
                        }
                        <MudText Typo="Typo.body2" Class="tl-u-color-tl-text-secondary">
                            @_result.ClaimGroups.Count claim group(s) &bull;
                            @_result.Persons.Count person(s) &bull;
                            @_result.FictionalEntities.Count fictional entity(ies) &bull;
                            @_result.Relationships.Count relationship(s)
                        </MudText>
                    </div>
                </div>

                @* Claims grouped by field key *@
                @if (_result.ClaimGroups.Count > 0)
                {
                    <MudSimpleTable Dense="true" Striped="true" Hover="true"
                                    Class="tl-u-background-transparent tl-u-font-size-0-8rem">
                        <thead>
                            <tr>
                                <th class="tl-u-color-tl-text-secondary tl-u-width-180px">Field</th>
                                <th class="tl-u-color-tl-text-secondary">Value</th>
                                <th class="tl-u-color-tl-text-secondary tl-u-width-90px">Confidence</th>
                                <th class="tl-u-color-tl-text-secondary tl-u-width-300px">Provider</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in _result.ClaimGroups.OrderBy(g => g.FieldKey))
                            {
                                @foreach (var (claim, idx) in group.Claims.Select((c, i) => (c, i)))
                                {
                                    <tr>
                                        @if (idx == 0)
                                        {
                                            <td class="tl-u-color-tl-accent-primary tl-u-vertical-align-top tl-u-font-weight-600">
                                                @group.FieldKey
                                            </td>
                                        }
                                        else
                                        {
                                            <td></td>
                                        }
                                        <td class="tl-u-color-tl-text-primary tl-u-word-break-break-all">
                                            @if (group.FieldKey == "cover" && IsUrl(claim.Value))
                                            {
                                                <a href="@claim.Value" target="_blank"
                                                   class="tl-u-color-tl-status-info tl-u-text-decoration-none tl-u-font-size-0-75rem">
                                                    @TruncateUrl(claim.Value, 60)
                                                </a>
                                            }
                                            else
                                            {
                                                @claim.Value
                                            }
                                        </td>
                                        <AppCssElement Tag="td" Css="@($"color: {ConfidenceColor(claim.Confidence)};")">
                                            @claim.Confidence.ToString("P0")
                                        </AppCssElement>
                                        <td class="tl-u-color-tl-text-muted tl-u-font-size-xs tl-u-font-family-monospace">
                                            @claim.ProviderId
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </MudSimpleTable>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="tl-u-color-tl-text-muted">No claims returned.</MudText>
                }
            </AppPanel>
@if (GetBridgeClaims(_result).Count > 0)
            {
                <MudText Typo="Typo.h6" Class="mb-2 tl-u-color-tl-accent-primary tl-u-font-family-app-font-sans tl-u-font-weight-600"
                         >
                    Bridge IDs (@GetBridgeClaims(_result).Count)
                </MudText>
                <AppPanel Elevation="0" Class="pa-4 mb-4 tl-u-background-tl-divider tl-u-border-1px-solid-tl-border-subtle tl-u-border-radius-10px"
                          >
                    <MudGrid>
                        @foreach (var group in GetBridgeClaims(_result))
                        {
                            @foreach (var claim in group.Claims)
                            {
                                <MudItem xs="12" sm="6" md="4">
                                    <div>
                                        <MudText Typo="Typo.caption"
                                                 Class="tl-u-color-tl-text-muted tl-u-text-transform-uppercase tl-u-font-size-xs tl-u-letter-spacing-0-05em">
                                            @group.FieldKey
                                        </MudText>
                                        <MudText Typo="Typo.body2"
                                                 Class="tl-u-color-tl-text-primary tl-u-font-family-monospace tl-u-font-size-0-85rem">
                                            @claim.Value
                                        </MudText>
                                    </div>
                                </MudItem>
                            }
                        }
                    </MudGrid>
                </AppPanel>
            }
<MudText Typo="Typo.h6" Class="mb-2 tl-u-color-tl-accent-primary tl-u-font-family-app-font-sans tl-u-font-weight-600"
                     >
                Bridge Hint Preview (@(_result.BridgeHintPreview?.Count ?? 0))
            </MudText>
            @if (_result.BridgeHintPreview is { Count: > 0 })
            {
                <AppPanel Elevation="0" Class="pa-4 mb-4 tl-u-background-tl-divider tl-u-border-1px-solid-tl-border-subtle tl-u-border-radius-10px"
                          >
                    <MudText Typo="Typo.caption" Class="mb-3 tl-u-color-tl-text-muted tl-u-font-size-xs"
                             >
                        These bridge IDs would flow to Stage 2 retail providers for precise lookups (cover art, ratings).
                    </MudText>
                    <MudSimpleTable Dense="true" Striped="true" Hover="true"
                                    Class="tl-u-background-transparent tl-u-font-size-0-8rem">
                        <thead>
                            <tr>
                                <th class="tl-u-color-tl-text-secondary tl-u-width-130px">Hint Key</th>
                                <th class="tl-u-color-tl-text-secondary tl-u-width-160px">Raw Value</th>
                                <th class="tl-u-color-tl-text-secondary tl-u-width-160px">Normalized</th>
                                <th class="tl-u-color-tl-text-secondary tl-u-width-130px">Source Claim</th>
                                <th class="tl-u-color-tl-text-secondary">Target Providers</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var hint in _result.BridgeHintPreview)
                            {
                                <tr>
                                    <td class="tl-u-color-tl-accent-primary tl-u-font-weight-600">@hint.Key</td>
                                    <td class="tl-u-color-tl-text-muted tl-u-font-family-monospace tl-u-font-size-0-75rem tl-u-word-break-break-all">
                                        @hint.RawValue
                                    </td>
                                    <td class="tl-u-color-tl-text-primary tl-u-font-family-monospace tl-u-font-size-0-75rem tl-u-word-break-break-all">
                                        @hint.NormalizedValue
                                    </td>
                                    <td class="tl-u-color-tl-text-secondary tl-u-font-size-0-75rem">@hint.SourceClaimKey</td>
                                    <td>
                                        @foreach (var provider in hint.TargetProviders)
                                        {
                                            <AppChip T="string" Size="Size.Small" Color="Color.Primary"
                                                     Class="tl-u-height-18px tl-u-font-size-xs tl-u-margin-1px">
                                                @provider
                                            </AppChip>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </AppPanel>
            }
            else
            {
                <AppPanel Elevation="0" Class="pa-3 mb-4 tl-u-background-rgba-249-115-22-0-08 tl-u-border-1px-solid-rgba-249-115-22-0-25 tl-u-border-radius-10px"
                          >
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Outlined.Warning" Size="Size.Small"
                                 Class="tl-u-color-hex-f97316" />
                        <MudText Typo="Typo.body2" Class="tl-u-color-rgba-248-248-248-0-65 tl-u-font-size-0-8rem">
                            No bridge hints would flow to Stage 2 - cover art would rely on text search (ArtworkUnconfirmed)
                        </MudText>
                    </div>
                </AppPanel>
            }
<MudText Typo="Typo.h6" Class="mb-2 tl-u-color-tl-accent-primary tl-u-font-family-app-font-sans tl-u-font-weight-600"
                     >
                People (@_result.Persons.Count)
            </MudText>

            @if (_result.Persons.Count > 0)
            {
                <MudExpansionPanels Class="mb-4" Elevation="0">
                    @foreach (var person in _result.Persons)
                    {
                        <MudExpansionPanel Class="tl-u-background-tl-divider tl-u-border-1px-solid-tl-border-subtle tl-u-border-radius-8px tl-u-margin-bottom-4px">
                            <TitleContent>
                                <div class="d-flex align-center gap-3">
                                    @if (!string.IsNullOrEmpty(person.HeadshotUrl))
                                    {
                                        <MudAvatar Class="tl-u-width-36px tl-u-height-36px tl-u-flex-shrink-0">
                                            <MudImage Src="@person.HeadshotUrl" Alt="@person.Name"
                                                      ObjectFit="ObjectFit.Cover" />
                                        </MudAvatar>
                                    }
                                    else
                                    {
                                        <MudAvatar Color="Color.Dark" Class="tl-u-width-36px tl-u-height-36px tl-u-flex-shrink-0">
                                            <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" />
                                        </MudAvatar>
                                    }
                                    <div>
                                        <MudText Typo="Typo.body1" Class="tl-u-color-tl-text-primary tl-u-font-weight-600 tl-u-line-height-1-2">
                                            @person.Name
                                        </MudText>
                                        <div class="d-flex gap-2">
                                            <AppChip T="string" Size="Size.Small" Color="Color.Default"
                                                     Class="tl-u-height-18px tl-u-font-size-xs">
                                                @person.Role
                                            </AppChip>
                                            @if (person.Qid is not null)
                                            {
                                                <AppChip T="string" Size="Size.Small" Color="Color.Primary"
                                                         Class="tl-u-height-18px tl-u-font-size-xs">
                                                    @person.Qid
                                                </AppChip>
                                            }
                                            @if (!string.IsNullOrEmpty(person.Occupation))
                                            {
                                                <AppChip T="string" Size="Size.Small" Color="Color.Default"
                                                         Class="tl-u-height-18px tl-u-font-size-xs tl-u-color-tl-text-secondary">
                                                    @person.Occupation
                                                </AppChip>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <div class="pa-2">
                                    @if (!string.IsNullOrEmpty(person.HeadshotUrl))
                                    {
                                        <div class="mb-3">
                                            <MudText Typo="Typo.caption" Class="tl-u-color-tl-text-muted">HEADSHOT URL</MudText>
                                            <a href="@person.HeadshotUrl" target="_blank"
                                               class="tl-u-color-tl-status-info tl-u-font-size-0-75rem tl-u-word-break-break-all tl-u-text-decoration-none">
                                                @person.HeadshotUrl
                                            </a>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(person.Biography))
                                    {
                                        <div class="mb-2">
                                            <MudText Typo="Typo.caption" Class="tl-u-color-tl-text-muted">BIOGRAPHY</MudText>
                                            <MudText Typo="Typo.body2" Class="tl-u-color-rgba-248-248-248-0-80">
                                                @person.Biography
                                            </MudText>
                                        </div>
                                    }
                                    @if (string.IsNullOrEmpty(person.Biography) && string.IsNullOrEmpty(person.HeadshotUrl))
                                    {
                                        <MudText Typo="Typo.body2" Class="tl-u-color-tl-text-muted">
                                            No additional detail available.
                                        </MudText>
                                    }
                                </div>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            }
            else
            {
                <AppPanel Elevation="0" Class="pa-3 mb-4 tl-u-background-rgba-255-255-255-0-03 tl-u-border-1px-solid-tl-border-subtle tl-u-border-radius-10px"
                          >
                    <MudText Typo="Typo.body2" Class="tl-u-color-tl-text-muted">No people returned.</MudText>
                </AppPanel>
            }
<MudText Typo="Typo.h6" Class="mb-2 tl-u-color-tl-accent-primary tl-u-font-family-app-font-sans tl-u-font-weight-600"
                     >
                Fictional Entities (@_result.FictionalEntities.Count)
            </MudText>

            @if (_result.FictionalEntities.Count > 0)
            {
                <AppPanel Elevation="0" Class="pa-3 mb-4 tl-u-background-tl-divider tl-u-border-1px-solid-tl-border-subtle tl-u-border-radius-10px"
                          >
                    <MudSimpleTable Dense="true" Striped="true" Hover="true"
                                    Class="tl-u-background-transparent tl-u-font-size-0-8rem">
                        <thead>
                            <tr>
                                <th class="tl-u-color-tl-text-secondary">Label</th>
                                <th class="tl-u-color-tl-text-secondary tl-u-width-110px">QID</th>
                                <th class="tl-u-color-tl-text-secondary tl-u-width-110px">Type</th>
                                <th class="tl-u-color-tl-text-secondary">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entity in _result.FictionalEntities)
                            {
                                <tr>
                                    <td class="tl-u-color-tl-text-primary tl-u-font-weight-600">@entity.Label</td>
                                    <td class="tl-u-color-tl-text-secondary tl-u-font-family-monospace tl-u-font-size-0-75rem">
                                        @(entity.Qid ?? "-")
                                    </td>
                                    <td>
                                        <AppChip T="string" Size="Size.Small" Color="Color.Secondary"
                                                 Class="tl-u-height-18px tl-u-font-size-xs">
                                            @entity.EntityType
                                        </AppChip>
                                    </td>
                                    <td class="tl-u-color-rgba-248-248-248-0-70">@(entity.Description ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </AppPanel>
            }
            else
            {
                <AppPanel Elevation="0" Class="pa-3 mb-4 tl-u-background-rgba-255-255-255-0-03 tl-u-border-1px-solid-tl-border-subtle tl-u-border-radius-10px"
                          >
                    <MudText Typo="Typo.body2" Class="tl-u-color-tl-text-muted">No fictional entities returned.</MudText>
                </AppPanel>
            }
<MudText Typo="Typo.h6" Class="mb-2 tl-u-color-tl-accent-primary tl-u-font-family-app-font-sans tl-u-font-weight-600"
                     >
                Relationships (@_result.Relationships.Count)
            </MudText>

            @if (_result.Relationships.Count > 0)
            {
                <AppPanel Elevation="0" Class="pa-3 mb-4 tl-u-background-tl-divider tl-u-border-1px-solid-tl-border-subtle tl-u-border-radius-10px"
                          >
                    <MudSimpleTable Dense="true" Striped="true" Hover="true"
                                    Class="tl-u-background-transparent tl-u-font-size-0-8rem">
                        <thead>
                            <tr>
                                <th class="tl-u-color-tl-text-secondary">Subject</th>
                                <th class="tl-u-color-tl-text-secondary tl-u-width-140px">Relationship</th>
                                <th class="tl-u-color-tl-text-secondary">Object</th>
                                <th class="tl-u-color-tl-text-secondary tl-u-width-100px">Start</th>
                                <th class="tl-u-color-tl-text-secondary tl-u-width-100px">End</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rel in _result.Relationships)
                            {
                                <tr>
                                    <td class="tl-u-color-tl-text-primary">
                                        @rel.SubjectLabel
                                        @if (!string.IsNullOrEmpty(rel.SubjectQid))
                                        {
                                            <span class="tl-u-color-tl-text-muted tl-u-font-size-xs tl-u-margin-left-4px">
                                                (@rel.SubjectQid)
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <AppChip T="string" Size="Size.Small" Color="Color.Info"
                                                 Class="tl-u-height-18px tl-u-font-size-xs">
                                            @rel.RelationshipType
                                        </AppChip>
                                    </td>
                                    <td class="tl-u-color-tl-text-primary">
                                        @rel.ObjectLabel
                                        @if (!string.IsNullOrEmpty(rel.ObjectQid))
                                        {
                                            <span class="tl-u-color-tl-text-muted tl-u-font-size-xs tl-u-margin-left-4px">
                                                (@rel.ObjectQid)
                                            </span>
                                        }
                                    </td>
                                    <td class="tl-u-color-tl-text-secondary tl-u-font-size-0-75rem">
                                        @(rel.StartTime ?? "-")
                                    </td>
                                    <td class="tl-u-color-tl-text-secondary tl-u-font-size-0-75rem">
                                        @(rel.EndTime ?? "-")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </AppPanel>
            }
            else
            {
                <AppPanel Elevation="0" Class="pa-3 mb-4 tl-u-background-rgba-255-255-255-0-03 tl-u-border-1px-solid-tl-border-subtle tl-u-border-radius-10px"
                          >
                    <MudText Typo="Typo.body2" Class="tl-u-color-tl-text-muted">No relationships returned.</MudText>
                </AppPanel>
            }
<MudExpansionPanels Class="mb-6" Elevation="0">
                <MudExpansionPanel Class="tl-u-background-tl-divider tl-u-border-1px-solid-tl-border-subtle tl-u-border-radius-10px">
                    <TitleContent>
                        <MudText Typo="Typo.h6"
                                 Class="tl-u-color-tl-accent-primary tl-u-font-family-app-font-sans tl-u-font-weight-600">
                            Raw Claims -
                            @(_result.ClaimGroups.Sum(g => g.Claims.Count)) total
                        </MudText>
                    </TitleContent>
                    <ChildContent>
                        <MudSimpleTable Dense="true" Striped="true" Hover="true"
                                        Class="tl-u-background-transparent tl-u-font-size-0-78rem">
                            <thead>
                                <tr>
                                    <th class="tl-u-color-tl-text-secondary tl-u-width-160px">Field Key</th>
                                    <th class="tl-u-color-tl-text-secondary">Value</th>
                                    <th class="tl-u-color-tl-text-secondary tl-u-width-90px">Confidence</th>
                                    <th class="tl-u-color-tl-text-secondary tl-u-width-300px">Provider ID</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var group in _result.ClaimGroups.OrderBy(g => g.FieldKey))
                                {
                                    @foreach (var claim in group.Claims)
                                    {
                                        <tr>
                                            <td class="tl-u-color-tl-accent-primary tl-u-font-weight-600">@group.FieldKey</td>
                                            <td class="tl-u-color-tl-text-primary tl-u-word-break-break-all">@claim.Value</td>
                                            <AppCssElement Tag="td" Css="@($"color: {ConfidenceColor(claim.Confidence)};")">
                                                @claim.Confidence.ToString("P0")
                                            </AppCssElement>
                                            <td class="tl-u-color-rgba-248-248-248-0-40 tl-u-font-family-monospace tl-u-font-size-xs">
                                                @claim.ProviderId
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </MudSimpleTable>
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    }

</div>

@code {

    private string _title     = string.Empty;
    private string _author    = string.Empty;
    private string _mediaType = "Books";
    private bool   _loading;
    private bool   _enriching;
    private bool   _enrichingUniverse;
    private string? _error;
    private string? _enrichUniverseMessage;
    private DebugLookupResponse? _result;
    private List<DebugSearchCandidate>? _candidates;
    private DebugSearchCandidate? _selectedCandidate;

    private static readonly string[] _mediaTypes =
    [
        "Books", "Audiobooks", "Movies", "TV", "Comics", "Music"
    ];

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Search();
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(_title)) return;

        _loading          = true;
        _error            = null;
        _candidates       = null;
        _selectedCandidate = null;
        _result           = null;
        StateHasChanged();

        try
        {
            var client = HttpFactory.CreateClient("EngineApi");

            var request = new DebugLookupRequest(
                _title.Trim(),
                _mediaType,
                string.IsNullOrWhiteSpace(_author) ? null : _author.Trim());

            var options = MediaEngineJson.CaseInsensitive;

            using var response = await client.PostAsJsonAsync("/debug/search", request);

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _error = $"Engine returned {(int)response.StatusCode} {response.ReasonPhrase}. {(body.Length > 200 ? body[..200] + "..." : body)}";
                return;
            }

            var searchResponse = await response.Content.ReadFromJsonAsync<DebugSearchResponse>(options);

            if (searchResponse is null)
            {
                _error = "Engine returned an empty response.";
                return;
            }

            _candidates = searchResponse.Candidates;
        }
        catch (HttpRequestException ex)
        {
            _error = $"Could not reach the Engine: {ex.Message}";
        }
        catch (JsonException ex)
        {
            _error = $"Failed to parse Engine response: {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectCandidate(DebugSearchCandidate candidate)
    {
        _selectedCandidate = candidate;
        _enriching         = true;
        _error             = null;
        _result            = null;
        StateHasChanged();

        try
        {
            var client = HttpFactory.CreateClient("EngineApi");

            var request = new DebugEnrichRequest(
                Qid:       candidate.Qid,
                MediaType: _mediaType,
                Author:    string.IsNullOrWhiteSpace(_author) ? null : _author.Trim()
            );

            var options = MediaEngineJson.CaseInsensitive;

            using var response = await client.PostAsJsonAsync("/debug/enrich", request);

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _error = $"Engine returned {(int)response.StatusCode} {response.ReasonPhrase}. {(body.Length > 200 ? body[..200] + "..." : body)}";
                return;
            }

            _result = await response.Content.ReadFromJsonAsync<DebugLookupResponse>(options);

            if (_result is null)
                _error = "Engine returned an empty response.";
        }
        catch (HttpRequestException ex)
        {
            _error = $"Could not reach the Engine: {ex.Message}";
        }
        catch (JsonException ex)
        {
            _error = $"Failed to parse Engine response: {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _enriching = false;
        }
    }

    private void BackToSearch()
    {
        _selectedCandidate = null;
        _result            = null;
        _error             = null;
    }

    private async Task EnrichUniverse()
    {
        if (_selectedCandidate is null) return;

        _enrichingUniverse    = true;
        _error                = null;
        _enrichUniverseMessage = null;
        StateHasChanged();

        try
        {
            var client = HttpFactory.CreateClient("EngineApi");

            var request = new DebugEnrichRequest(
                Qid:       _selectedCandidate.Qid,
                MediaType: _mediaType,
                Author:    string.IsNullOrWhiteSpace(_author) ? null : _author.Trim()
            );

            var options = MediaEngineJson.CaseInsensitive;

            using var response = await client.PostAsJsonAsync("/debug/enrich-universe", request);

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _error = $"Engine returned {(int)response.StatusCode} {response.ReasonPhrase}. {(body.Length > 200 ? body[..200] + "..." : body)}";
                return;
            }

            var prevPersonCount = _result?.Persons.Count ?? 0;
            var prevEntityCount = _result?.FictionalEntities.Count ?? 0;

            _result = await response.Content.ReadFromJsonAsync<DebugLookupResponse>(options);

            if (_result is null)
            {
                _error = "Engine returned an empty response.";
            }
            else
            {
                var newPersons  = _result.Persons.Count - prevPersonCount;
                var newEntities = _result.FictionalEntities.Count - prevEntityCount;
                _enrichUniverseMessage =
                    $"Created {newPersons} person record(s) and {newEntities} entity record(s). " +
                    $"Wikidata enrichment enqueued for headshots and biographies.";
            }
        }
        catch (HttpRequestException ex)
        {
            _error = $"Could not reach the Engine: {ex.Message}";
        }
        catch (JsonException ex)
        {
            _error = $"Failed to parse Engine response: {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _enrichingUniverse = false;
        }
    }

    private static string ConfidenceColor(double c) => c switch
    {
        >= 0.85 => "#4ADE80",   // green
        >= 0.60 => "var(--tl-status-warning)",   // amber
        _       => "#F87171",   // red
    };

    private static bool IsUrl(string value) =>
        value.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
        value.StartsWith("https://", StringComparison.OrdinalIgnoreCase);

    private static string TruncateUrl(string url, int maxLen) =>
        url.Length <= maxLen ? url : url[..maxLen] + "...";

    private static readonly HashSet<string> BridgeFieldKeys = new(StringComparer.OrdinalIgnoreCase)
    {
        "isbn_13", "isbn_10", "asin", "tmdb_movie_id", "tmdb_tv_id", "imdb_id",
        "apple_books_id", "comic_vine_id", "musicbrainz_artist_id",
        "musicbrainz_release_id", "goodreads_id",
        "openlibrary_id", "wikidata_qid",
        "justwatch_id", "letterboxd_id", "tvdb_id", "tvcom_id",
        "audible_id", "spotify_id", "discogs_id", "musicbrainz_release_group_id",
    };

    private static List<DebugClaimGroup> GetBridgeClaims(DebugLookupResponse result) =>
        result.ClaimGroups
            .Where(g => BridgeFieldKeys.Contains(g.FieldKey))
            .OrderBy(g => g.FieldKey)
            .ToList();

}
