@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Components.Cinematic
@using MediaEngine.Web.Models.ViewDTOs
@inject DashboardIdentityClient Identity
@inject DashboardSessionAccessor Session
@inject NavigationManager Nav

<div class="tl-page users-access-settings">
    <SurfaceNavigationBar Items="@Sections" ActiveKey="@ActiveSection" ActiveKeyChanged="Navigate" AriaLabel="Access sections" />
    <section class="users-access-settings__section"
             data-access-section="@ActiveSection"
             aria-label="@ActiveSectionLabel">
        @switch (ActiveSection)
        {
            case "users":
                <ManagedAccessUsers />
                break;
            case "applications":
                <ManagedAccessApplications />
                break;
            case "authentication":
                <SecurityTab Section="authentication" />
                break;
            default:
                <ManagedAccessUsers />
                break;
        }
    </section>
</div>

@code {
    [Parameter] public string Subsection { get; set; } = string.Empty;

    private string ActiveSection => Subsection.ToLowerInvariant() switch
    {
        "users" => "users",
        "applications" => "applications",
        "authentication" => "authentication",
        _ => "users",
    };

    private string ActiveSectionLabel => ActiveSection switch
    {
        "users" => "Users",
        "applications" => "Applications",
        "authentication" => "Authentication",
        _ => "Users",
    };

    private static readonly IReadOnlyList<SurfaceTabItem> Sections =
    [
        new("users", "Users", AppMaterialIcons.Outlined.Group),
        new("applications", "Applications", AppMaterialIcons.Outlined.Apps),
        new("authentication", "Authentication", AppMaterialIcons.Outlined.Security),
    ];

    private Task Navigate(string section)
    {
        Nav.NavigateTo($"/settings/access/{section}");
        return Task.CompletedTask;
    }
}
