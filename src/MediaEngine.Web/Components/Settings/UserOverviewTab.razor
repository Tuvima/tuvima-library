@namespace MediaEngine.Web.Components.Settings
@using Microsoft.AspNetCore.Components.Forms
@using MediaEngine.Contracts.ProfileState
@using MediaEngine.Domain.Enums
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject DashboardSessionAccessor Session
@inject IAppToastService Snackbar

<div class="tl-page user-overview-page user-overview-page--refined">
    @if (_loading)
    {
        <AppStack Spacing="2">
            <AppProgressBar Indeterminate="true" Color="AppColor.Primary" />
            <AppSkeleton Height="180px" Animation="Animation.Wave" />
            <AppSkeleton Height="220px" Animation="Animation.Wave" />
        </AppStack>
    }
    else if (_overview is null)
    {
        <AppAlert Severity="AppSeverity.Info" Variant="AppVariant.Outlined">
            Your overview is not available yet. Profile details will appear here when the Engine is online.
        </AppAlert>
    }
    else
    {
        var profile = _overview.Profile;

        <div class="user-overview-grid" data-profile-section="overview">
            <AppPanel Elevation="0" Class="tl-card settings-section-card user-overview-card user-overview-profile-card">
                <AppStack Row="true" Spacing="3" AlignItems="AppAlignItems.Center" Class="user-overview-profile-layout">
                        <AppStack Spacing="1" AlignItems="AppAlignItems.Center" Class="user-overview-avatar-wrap">
                            <AppButton ButtonStyle="AppButtonStyle.Text"
                                       Tone="AppUiTone.Neutral"
                                       Class="user-overview-avatar-button"
                                       Disabled="@_avatarDialogBusy"
                                       OnClick="@OpenAvatarDialog"
                                       aria-label="Change profile photo">
                                <AppAvatar Size="AppSize.Large"
                                               Class="user-overview-avatar">
                                @if (!string.IsNullOrWhiteSpace(profile.AvatarImageUrl))
                                {
                                        <img src="@profile.AvatarImageUrl" alt="" class="user-overview-avatar-image" />
                                }
                                else
                                {
                                    @GetInitials(profile.DisplayName)
                                }
                                </AppAvatar>
                                <span class="user-overview-avatar-edit-badge">
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PhotoCamera" Size="AppSize.Small" />
                                </span>
                            </AppButton>
                        </AppStack>

                        <AppStack Spacing="1" Class="flex-grow-1 user-overview-profile-copy">
                            @if (_editingName)
                            {
                                <AppStack Row="true" Spacing="1" AlignItems="AppAlignItems.Center" Class="user-overview-name-edit">
                                    <AppTextField @bind-Value="_displayName"
                                                  Variant="AppVariant.Outlined"
                                                  Margin="AppMargin.Dense"
                                                  Immediate="true"
                                                  MaxLength="64"
                                                  Disabled="_savingProfile"
                                                  Class="user-overview-name-field"
                                                  aria-label="Display name" />
                                    <AppIconButton Icon="@AppMaterialIcons.Outlined.Check"
                                                   Tone="AppUiTone.Success"
                                                   Size="AppControlSize.Compact"
                                                   Disabled="@(_savingProfile || string.IsNullOrWhiteSpace(_displayName) || !ProfileDirty)"
                                                   OnClick="@SaveProfileAsync"
                                                   aria-label="Save display name" />
                                    <AppIconButton Icon="@AppMaterialIcons.Outlined.Close"
                                                   Tone="AppUiTone.Neutral"
                                                   Size="AppControlSize.Compact"
                                                   Disabled="_savingProfile"
                                                   OnClick="@CancelNameEdit"
                                                   aria-label="Cancel display name edit" />
                                </AppStack>
                            }
                            else
                            {
                                <AppStack Row="true" Spacing="1" AlignItems="AppAlignItems.Center" Class="user-overview-name-row">
                                    <AppText Typo="AppTypo.h5" Class="user-overview-profile-name">@profile.DisplayName</AppText>
                                </AppStack>
                            }

                            <AppText Typo="AppTypo.body1" Class="user-overview-role">@(Session.Authority?.EffectiveAdministrator == true ? "Administrator" : "Profile")</AppText>
                            <AppText Typo="AppTypo.body2" Color="AppColor.Secondary" Class="user-overview-joined">Joined @profile.CreatedAt.ToLocalTime().ToString("MMMM yyyy")</AppText>
                        </AppStack>
                    <AppButton Label="Edit profile"
                               StartIcon="@AppMaterialIcons.Outlined.Edit"
                               Size="AppControlSize.Compact"
                               OnClick="@StartNameEdit" />
                </AppStack>
            </AppPanel>

            <AppPanel Elevation="0" Class="tl-card settings-section-card user-overview-card user-overview-stat-strip">
                <AppText Typo="AppTypo.h6" Class="settings-card-title mb-3">Activity summary</AppText>
                @if (HasActivitySummary)
                {
                    <div class="user-overview-stats-grid">
                        @foreach (var stat in StatItems())
                        {
                            <AppStack Spacing="1" Class="user-overview-stat-card">
                                <AppMaterialIcon Icon="@stat.Icon" Color="@stat.Color" Class="user-overview-stat-icon" />
                                <AppText Typo="AppTypo.h4" Class="@StatValueClass(stat.Value)">@stat.Value</AppText>
                                <AppText Typo="AppTypo.caption" Class="user-overview-stat-label">@stat.Label</AppText>
                                <AppText Typo="AppTypo.caption" Color="AppColor.Secondary" Class="user-overview-stat-subtitle">@stat.Subtitle</AppText>
                            </AppStack>
                        }
                    </div>
                }
                else
                {
                    <AppEmptyState Class="app-page-state--compact"
                                   Title="No activity yet"
                                   Message="Start watching, reading, or listening and your progress will appear here." />
                }
            </AppPanel>

            <AppPanel Elevation="0" Class="tl-card settings-section-card user-overview-card user-overview-history-card">
                <div class="user-overview-section-heading">
                    <div>
                        <AppText Typo="AppTypo.h6" Class="settings-card-title">Continue where you left off</AppText>
                        <p>Your most recent activity across all media.</p>
                    </div>
                    <a href="/for-me">View all <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" Size="AppSize.Small" /></a>
                </div>
                <MediaRail Items="@_overview.ContinueItems.Take(5).ToList()" ShowContinuation="true"
                           EmptyText="Start reading, watching, or listening to pick up where you left off here." />
            </AppPanel>

            <AppPanel Elevation="0" Class="tl-card settings-section-card user-overview-card user-overview-taste-card">
                <AppStack Row="true" Justify="AppJustify.SpaceBetween" AlignItems="AppAlignItems.Center" Class="mb-3 user-overview-card-header">
                    <AppText Typo="AppTypo.h6" Class="settings-card-title">Taste</AppText>
                </AppStack>

                <p class="user-overview-taste-description">Your top genres from recent activity.</p>
                @{
                    var genres = TopGenres().OrderByDescending(genre => genre.Value).Take(3).ToList();
                }
                @if (genres.Count == 0 || !HasQualifiedTasteData)
                {
                    <AppEmptyState Class="app-page-state--compact"
                                   Title="Not enough activity yet"
                                   Message="Your most-used genres will appear after you spend more time with your library." />
                }
                else
                {
                    <div class="user-overview-genre-grid">
                        @foreach (var genre in genres)
                        {
                            var pct = NormalizeGenrePercent(genre.Value, TopGenres().ToList());
                            <AppStack Spacing="1" Class="user-overview-genre-row">
                                <AppStack Row="true" Justify="AppJustify.SpaceBetween" AlignItems="AppAlignItems.Center" Class="user-overview-genre-label-row">
                                    <AppText Typo="AppTypo.body2" Class="user-overview-genre-name">@genre.Key</AppText>
                                    <AppText Typo="AppTypo.body2" Class="user-overview-genre-percent">@($"{Math.Round(pct):0}%")</AppText>
                                </AppStack>
                                <AppProgressBar Value="@pct" Color="AppColor.Primary" Rounded="true" Class="user-overview-mini-bar" />
                            </AppStack>
                        }
                    </div>
                }
            </AppPanel>
            <AppPanel Elevation="0" Class="tl-card user-overview-card user-overview-favorites">
                @foreach (var lane in FavoriteLanes)
                {
                    <a href="@($"/for-me?view=favorites&area={lane.Area}")" class="user-overview-favorite">
                        <span class="user-overview-favorite-icon"><AppMaterialIcon Icon="@lane.Icon" /></span>
                        <div>
                            <span>@lane.Label favorites</span>
                            <strong>@(_favorites is null ? "—" : FavoriteCount(lane.Area).ToString("N0"))</strong>
                            <small>@(_favorites is null ? "Unavailable" : "Items you like or love")</small>
                        </div>
                    </a>
                }
            </AppPanel>
        </div>
    }
</div>

<AppDialog @bind-Visible="_avatarDialogOpen" Options="_avatarDialogOptions" Class="user-overview-photo-dialog">
    <TitleContent>
        <AppStack Row="true" Justify="AppJustify.SpaceBetween" AlignItems="AppAlignItems.Center" Class="user-overview-photo-dialog-title">
            <AppText Typo="AppTypo.h6">Change photo</AppText>
            <AppIconButton Icon="@AppMaterialIcons.Outlined.Close"
                           Size="AppControlSize.Compact"
                           Tone="AppUiTone.Neutral"
                           OnClick="@CloseAvatarDialog"
                           aria-label="Close change photo dialog" />
        </AppStack>
    </TitleContent>
    <DialogContent>
        @if (_overview is not null)
        {
            <AppStack Spacing="2" AlignItems="AppAlignItems.Center">
                <div class="user-overview-photo-preview">
                    @if (!string.IsNullOrWhiteSpace(AvatarDialogImageUrl))
                    {
                        <AppCssElement Tag="img" src="@AvatarDialogImageUrl" alt="" Css="@AvatarPreviewImageStyle" />
                    }
                    else
                    {
                        <span>@GetInitials(_overview.Profile.DisplayName)</span>
                    }
                </div>

                @if (_pendingAvatarFile is not null)
                {
                    <div class="user-overview-photo-zoom">
                        <AppStack Row="true" Justify="AppJustify.SpaceBetween" AlignItems="AppAlignItems.Center" Class="user-overview-photo-zoom-label">
                            <AppText Typo="AppTypo.caption">Zoom</AppText>
                            <AppText Typo="AppTypo.caption">@($"{_avatarZoom:0.0}x")</AppText>
                        </AppStack>
                        <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="1">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Remove" Size="AppSize.Small" />
                            <AppRangeSlider AriaLabel="Avatar zoom" ShowTicks="false"
                                       Value="@_avatarZoom"
                                       ValueChanged="@OnAvatarZoomChanged"
                                       Min="1"
                                       Max="3"
                                       Step="0.1"
                                       Class="user-overview-photo-slider" />
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Add" Size="AppSize.Small" />
                        </AppStack>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_avatarDialogError))
                {
                    <AppAlert Severity="AppSeverity.Error" Variant="AppVariant.Outlined" Dense="true" Class="user-overview-photo-alert">
                        @_avatarDialogError
                    </AppAlert>
                }

                @if (_avatarRemoveRequested)
                {
                    <AppAlert Severity="AppSeverity.Info" Variant="AppVariant.Outlined" Dense="true" Class="user-overview-photo-alert">
                        The current photo will be removed when you save.
                    </AppAlert>
                }

                <AppText Typo="AppTypo.body2" Color="AppColor.Secondary" Class="user-overview-photo-help">
                    Review the selected photo before saving. Supported file types are JPEG, PNG, and WebP up to 5 MB.
                </AppText>

                <AppStack Spacing="1" AlignItems="AppAlignItems.Start" Class="user-overview-photo-actions">
                    <AppFileUpload T="IBrowserFile"
                                   Accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                                   FilesChanged="@PreviewAvatarAsync"
                                   MaximumFileCount="1"
                                   Disabled="@_avatarDialogBusy">
                        <CustomContent>
                            <AppButton ButtonStyle="AppButtonStyle.Text"
                                       Tone="AppUiTone.Primary"
                                       Size="AppControlSize.Compact"
                                       StartIcon="@AppMaterialIcons.Outlined.AddPhotoAlternate"
                                       Disabled="@_avatarDialogBusy"
                                       OnClick="@context.OpenFilePickerAsync">
                                Change photo
                            </AppButton>
                        </CustomContent>
                        <SelectedTemplate>
                        </SelectedTemplate>
                    </AppFileUpload>

                    @if (CanRemoveAvatarInDialog)
                    {
                        <AppButton ButtonStyle="AppButtonStyle.Text"
                                   Tone="@(_confirmRemoveAvatar ? AppUiTone.Error : AppUiTone.Primary)"
                                   Size="AppControlSize.Compact"
                                   StartIcon="@AppMaterialIcons.Outlined.DeleteOutline"
                                   Disabled="@_avatarDialogBusy"
                                   OnClick="@RequestRemoveAvatar">
                            @(_confirmRemoveAvatar ? "Confirm remove" : "Remove photo")
                        </AppButton>
                    }
                </AppStack>
            </AppStack>
        }
    </DialogContent>
    <DialogActions>
        <AppButton OnClick="@CloseAvatarDialog" Disabled="@_avatarDialogBusy">Cancel</AppButton>
        <AppButton ButtonStyle="AppButtonStyle.Filled"
                   Tone="AppUiTone.Primary"
                   Disabled="@(!CanSaveAvatarDialog)"
                   OnClick="@SaveAvatarDialogAsync">
            @(_avatarDialogBusy ? "Saving" : "Save")
        </AppButton>
    </DialogActions>
</AppDialog>

@code {
    private IReadOnlyList<ProfileReactionDto>? _favorites;
    private static readonly (string Area, string Label, string Icon)[] FavoriteLanes =
    [
        ("read", "Read", AppMaterialIcons.Outlined.MenuBook),
        ("watch", "Watch", AppMaterialIcons.Outlined.Movie),
        ("listen", "Listen", AppMaterialIcons.Outlined.Headphones),
    ];

    private int FavoriteCount(string area) => _favorites?.Count(item =>
        (item.Reaction is ProfileReactionKind.Like or ProfileReactionKind.Love) && (area switch
        {
            "read" => item.EntityKind is ProfileEntityKind.Book or ProfileEntityKind.Comic,
            "watch" => item.EntityKind is ProfileEntityKind.Movie or ProfileEntityKind.TvShow,
            "listen" => item.EntityKind is ProfileEntityKind.Audiobook or ProfileEntityKind.Album or ProfileEntityKind.Song,
            _ => false,
        })) ?? 0;

    private bool _loading = true;
    private bool _savingProfile;
    private bool _avatarDialogOpen;
    private bool _avatarDialogBusy;
    private bool _avatarRemoveRequested;
    private bool _confirmRemoveAvatar;
    private bool _editingName;
    private IBrowserFile? _pendingAvatarFile;
    private string? _pendingAvatarPreviewUrl;
    private string? _avatarDialogError;
    private double _avatarZoom = 1;
    private ProfileOverviewViewModel? _overview;
    private string _displayName = string.Empty;
    private string _savedDisplayName = string.Empty;
    private static readonly AppDialogOptions _avatarDialogOptions = new()
    {
        CloseOnEscapeKey = true,
        MaxWidth = AppMaxWidth.ExtraSmall,
        FullWidth = true
    };

    private bool ProfileDirty =>
        !string.Equals(_displayName.Trim(), _savedDisplayName, StringComparison.Ordinal);

    private bool HasActivitySummary => _overview is not null
        && (_overview.Stats.InProgress > 0
            || _overview.Stats.Completed > 0
            || _overview.Stats.ConsumedSeconds > 0
            || _overview.RecentItems.Count > 0);

    private bool HasQualifiedTasteData => _overview is not null
        && (_overview.Stats.RecentActivity >= 5 || _overview.RecentItems.Count >= 5);

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var profile = await Orchestrator.GetActiveProfileAsync();
            if (profile is not null)
            {
                _overview = await ApiClient.GetProfileOverviewAsync(profile.Id);
                if (_overview is null)
                    _overview = new ProfileOverviewViewModel { Profile = profile };

                SyncProfileEditor(_overview.Profile);
                try { _favorites = await ApiClient.GetProfileReactionsAsync(); }
                catch { _favorites = null; }
            }
        }
        catch
        {
            _overview = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartNameEdit()
    {
        if (_overview is null)
            return;

        SyncProfileEditor(_overview.Profile);
        _editingName = true;
    }

    private void CancelNameEdit()
    {
        _displayName = _savedDisplayName;
        _editingName = false;
    }

    private async Task SaveProfileAsync()
    {
        if (_overview is null || string.IsNullOrWhiteSpace(_displayName))
            return;

        _savingProfile = true;
        var current = _overview.Profile;
        var ok = await Orchestrator.UpdateProfileAsync(
            current.Id,
            _displayName.Trim(),
            current.AvatarColor,
            current.NavigationConfig);

        if (ok)
        {
            var updated = current with { DisplayName = _displayName.Trim() };
            _overview.Profile = updated;
            SyncProfileEditor(updated);
            _editingName = false;
            Snackbar.Add("Profile updated.", AppSeverity.Success);
        }
        else
        {
            Snackbar.Add("Could not save profile.", AppSeverity.Error);
        }

        _savingProfile = false;
    }

    private void OpenAvatarDialog()
    {
        if (_overview is null)
            return;

        _avatarDialogOpen = true;
        _avatarDialogBusy = false;
        _avatarRemoveRequested = false;
        _confirmRemoveAvatar = false;
        _pendingAvatarFile = null;
        _pendingAvatarPreviewUrl = null;
        _avatarDialogError = null;
        _avatarZoom = 1;
    }

    private void CloseAvatarDialog()
    {
        _avatarDialogOpen = false;
        _avatarDialogBusy = false;
        _avatarRemoveRequested = false;
        _confirmRemoveAvatar = false;
        _pendingAvatarFile = null;
        _pendingAvatarPreviewUrl = null;
        _avatarDialogError = null;
        _avatarZoom = 1;
    }

    private async Task PreviewAvatarAsync(IBrowserFile file)
    {
        _avatarDialogError = null;
        _confirmRemoveAvatar = false;
        _avatarRemoveRequested = false;
        _pendingAvatarFile = null;
        _pendingAvatarPreviewUrl = null;
        _avatarZoom = 1;

        if (!IsSupportedAvatarFile(file))
        {
            _avatarDialogError = "Choose a JPEG, PNG, or WebP image.";
            return;
        }

        if (file.Size > 5 * 1024 * 1024)
        {
            _avatarDialogError = "Profile photo must be 5 MB or smaller.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            _pendingAvatarFile = file;
            _pendingAvatarPreviewUrl = $"data:{GetAvatarPreviewContentType(file)};base64,{Convert.ToBase64String(buffer.ToArray())}";
            _avatarZoom = 1;
        }
        catch (IOException)
        {
            Snackbar.Add("Profile photo must be 5 MB or smaller.", AppSeverity.Error);
        }
    }

    private void RequestRemoveAvatar()
    {
        if (!_confirmRemoveAvatar)
        {
            _confirmRemoveAvatar = true;
            return;
        }

        _pendingAvatarFile = null;
        _pendingAvatarPreviewUrl = null;
        _avatarZoom = 1;
        _avatarRemoveRequested = true;
        _confirmRemoveAvatar = false;
        _avatarDialogError = null;
    }

    private async Task SaveAvatarDialogAsync()
    {
        if (_overview is null)
            return;

        _avatarDialogBusy = true;
        try
        {
            ProfileViewModel? updated = null;
            if (_pendingAvatarFile is not null)
            {
                await using var stream = _pendingAvatarFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                updated = await Orchestrator.UploadProfileAvatarAsync(_overview.Profile.Id, stream, _pendingAvatarFile.Name, _avatarZoom);
            }
            else if (_avatarRemoveRequested)
            {
                updated = await Orchestrator.RemoveProfileAvatarAsync(_overview.Profile.Id);
            }

            if (updated is null)
            {
                Snackbar.Add("Could not save profile photo.", AppSeverity.Error);
                return;
            }

            _overview.Profile = updated;
            SyncProfileEditor(updated);
            CloseAvatarDialog();
            Snackbar.Add("Profile photo updated.", AppSeverity.Success);
        }
        finally
        {
            _avatarDialogBusy = false;
        }
    }

    private bool CanRemoveAvatarInDialog =>
        _pendingAvatarFile is not null || !string.IsNullOrWhiteSpace(_overview?.Profile.AvatarImageUrl);

    private bool CanSaveAvatarDialog =>
        !_avatarDialogBusy
        && string.IsNullOrWhiteSpace(_avatarDialogError)
        && (_pendingAvatarFile is not null || _avatarRemoveRequested);

    private string? AvatarDialogImageUrl =>
        _avatarRemoveRequested
            ? null
            : _pendingAvatarPreviewUrl ?? _overview?.Profile.AvatarImageUrl;

    private string AvatarPreviewImageStyle =>
        _pendingAvatarFile is null
            ? string.Empty
            : $"transform:scale({_avatarZoom.ToString(System.Globalization.CultureInfo.InvariantCulture)});";

    private Task OnAvatarZoomChanged(double value)
    {
        _avatarZoom = Math.Clamp(value, 1d, 3d);
        return Task.CompletedTask;
    }

    private static bool IsSupportedAvatarFile(IBrowserFile file)
    {
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        var contentType = file.ContentType.Trim().ToLowerInvariant();
        return contentType is "image/jpeg" or "image/jpg" or "image/png" or "image/webp"
               || extension is ".jpg" or ".jpeg" or ".png" or ".webp";
    }

    private static string GetAvatarPreviewContentType(IBrowserFile file)
    {
        var contentType = file.ContentType.Trim().ToLowerInvariant();
        if (contentType is "image/jpeg" or "image/jpg")
            return "image/jpeg";
        if (contentType is "image/png" or "image/webp")
            return contentType;

        return Path.GetExtension(file.Name).ToLowerInvariant() switch
        {
            ".png" => "image/png",
            ".webp" => "image/webp",
            _ => "image/jpeg",
        };
    }

    private void SyncProfileEditor(ProfileViewModel profile)
    {
        _displayName = profile.DisplayName;
        _savedDisplayName = profile.DisplayName;
    }

    private IEnumerable<StatItem> StatItems()
    {
        if (_overview is null)
            yield break;

        yield return new StatItem("In Progress", _overview.Stats.InProgress.ToString("N0"), "Across all media", AppMaterialIcons.Outlined.Bookmarks, AppColor.Info);
        yield return new StatItem("Completed", _overview.Stats.Completed.ToString("N0"), "Books, shows & more", AppMaterialIcons.Outlined.CheckCircle, AppColor.Success);
        yield return new StatItem("Time Tracked", DisplayFormat.FormatDurationHoursMinutesRounded(_overview.Stats.ConsumedSeconds), "From saved progress", AppMaterialIcons.Outlined.Schedule, AppColor.Warning);
        yield return new StatItem("Last Activity", RecentActivityValue(), "Recently watched, read, or played", AppMaterialIcons.Outlined.History, AppColor.Secondary);
    }

    private string RecentActivityValue()
    {
        if (_overview is null)
            return "-";

        return _overview.RecentItems.Count > 0
            ? RelativeTime(_overview.RecentItems.Max(item => item.LastAccessed))
            : "-";
    }

    private static string StatValueClass(string value) =>
        value.Length > 6 ? "user-overview-stat-value user-overview-stat-value--long" : "user-overview-stat-value";

    private IReadOnlyDictionary<string, int> TopGenres()
    {
        if (_overview?.Stats.TopGenres.Count > 0)
            return _overview.Stats.TopGenres;

        return _overview?.Taste?.GenreDistribution
            .OrderByDescending(item => item.Value)
            .Take(6)
            .ToDictionary(item => item.Key, item => (int)Math.Round(item.Value * 100), StringComparer.OrdinalIgnoreCase)
            ?? new Dictionary<string, int>();
    }

    private static double NormalizeGenrePercent(int value, IReadOnlyList<KeyValuePair<string, int>> genres)
    {
        if (value <= 0)
            return 0;

        var total = genres.Sum(item => item.Value);
        return total > 0 ? Math.Clamp(value * 100d / total, 0, 100) : 0;
    }

    private static string RelativeTime(DateTimeOffset timestamp)
    {
        var elapsed = DateTimeOffset.UtcNow - timestamp.ToUniversalTime();
        if (elapsed.TotalMinutes < 1)
            return "Just now";
        if (elapsed.TotalMinutes < 60)
            return $"{Math.Max(1, (int)Math.Round(elapsed.TotalMinutes))}m ago";
        if (elapsed.TotalHours < 24)
            return $"{Math.Max(1, (int)Math.Round(elapsed.TotalHours))}h ago";
        if (elapsed.TotalDays < 2)
            return "Yesterday";
        if (elapsed.TotalDays < 30)
            return $"{Math.Max(2, (int)Math.Round(elapsed.TotalDays))} days ago";
        return timestamp.ToLocalTime().ToString("MMM d");
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][0].ToString().ToUpperInvariant(),
            _ => string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0]))),
        };
    }

    private static string FriendlyMediaType(string mediaType)
    {
        var normalized = mediaType.Trim().ToLowerInvariant();
        if (normalized.Contains("audio") && normalized.Contains("book"))
            return "Audiobook";
        if (normalized.Contains("podcast"))
            return "Podcast";
        if (normalized.Contains("comic"))
            return "Comic";
        if (normalized.Contains("book") || normalized.Contains("epub"))
            return "Book";
        if (normalized.Contains("tv") || normalized.Contains("show") || normalized.Contains("episode"))
            return "TV";
        if (normalized.Contains("movie") || normalized.Contains("video"))
            return "Movie";
        if (normalized.Contains("music") || normalized.Contains("album") || normalized.Contains("song"))
            return "Music";
        return string.IsNullOrWhiteSpace(mediaType) ? "Media" : mediaType;
    }

    private static string MediaIcon(string mediaType) => FriendlyMediaType(mediaType) switch
    {
        "Book" => AppMaterialIcons.Outlined.MenuBook,
        "Audiobook" or "Podcast" => AppMaterialIcons.Outlined.Headphones,
        "Music" => AppMaterialIcons.Outlined.Album,
        "TV" => AppMaterialIcons.Outlined.Tv,
        "Movie" => AppMaterialIcons.Outlined.Movie,
        "Comic" => AppMaterialIcons.Outlined.AutoStories,
        _ => AppMaterialIcons.Outlined.PlayCircle,
    };

    private static RenderFragment ItemThumb(ProfileOverviewItemViewModel item) => @<AppAvatar Rounded="true" Class="user-overview-item-thumb">
        @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
        {
            <img src="@item.CoverUrl" alt="" />
        }
        else
        {
            <AppMaterialIcon Icon="@MediaIcon(item.MediaType)" Size="AppSize.Small" />
        }
    </AppAvatar>;

    private readonly record struct StatItem(string Label, string Value, string Subtitle, string Icon, AppColor Color);
}
