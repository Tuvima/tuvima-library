@namespace MediaEngine.Web.Components.Settings.NeedsReview
@using MediaEngine.Contracts.Review
@inject IStringLocalizer<SharedStrings> L

@* One of the four groups (Ready to confirm, Choose a match, No match found, File problems): the heading with the number of items still
   waiting in it, then its rows as cards in one list. One row that cannot be drawn shows a "couldn't be shown" row; the rest stay usable. *@
<section class="nr-section" aria-labelledby="@HeadingId" data-testid="@(KeptView ? "needs-review-kept" : "needs-review-group")" data-group="@Section.Group">
    <div class="nr-section__head">
        <h2 id="@HeadingId" class="nr-section__title">@Title</h2>
        <span class="nr-section__count" data-testid="needs-review-group-count">@Section.Count.ToString("N0")</span>
    </div>
    <div class="nr-section__list">
        @foreach (var entry in Section.Entries)
        {
            <AppRowErrorBoundary @key="entry.Key" ItemTitle="@TitleOf(entry)" ResetKey="@entry">
                @if (KeptView)
                {
                    <NeedsReviewRow Row="@entry.First" State="@Model.StateOf(entry.First.Key)" Actions="@Actions" KeptView="true" />
                }
                else if (entry.IsFamily)
                {
                    <NeedsReviewFamilyRow Entry="@entry" Model="@Model" Actions="@Actions" />
                }
                else
                {
                    <NeedsReviewRow Row="@entry.First" State="@Model.StateOf(entry.First.Key)" Actions="@Actions" />
                }
            </AppRowErrorBoundary>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public NeedsReviewSection Section { get; set; } = default!;

    [Parameter, EditorRequired] public NeedsReviewListModel Model { get; set; } = default!;

    [Parameter, EditorRequired] public NeedsReviewActions Actions { get; set; } = default!;

    /// <summary>Draws the kept items instead of a group: each row offers only Put back.</summary>
    [Parameter] public bool KeptView { get; set; }

    private string HeadingId => $"needs-review-group-{Section.Group}";

    private string Title => KeptView ? L["NeedsReviewKept_Title"].Value : Section.Group switch
    {
        NeedsReviewGroups.Ready => L["NeedsReviewGroup_Ready"].Value,
        NeedsReviewGroups.Choose => L["NeedsReviewGroup_Choose"].Value,
        NeedsReviewGroups.FileProblem => L["NeedsReviewGroup_FileProblem"].Value,
        _ => L["NeedsReviewGroup_NoMatch"].Value,
    };

    private string TitleOf(NeedsReviewEntry entry) =>
        entry.IsFamily && !string.IsNullOrWhiteSpace(entry.First.FamilyTitle)
            ? entry.First.FamilyTitle!
            : NeedsReviewRowInfo.TitleOf(entry.First, L["NeedsReviewRow_UnknownTitle"].Value);
}
