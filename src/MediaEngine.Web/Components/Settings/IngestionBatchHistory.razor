@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Activity
@using MediaEngine.Contracts.Paging
@using Microsoft.AspNetCore.WebUtilities
@inject UIOrchestratorService Orchestrator
@inject IngestionLiveDashboardState Dashboard
@inject NavigationManager Nav
@implements IDisposable

<section class="ingestion-batch-history" aria-labelledby="batch-history-title">
    <header class="ingestion-batch-history__title">
        <div>
            <h2 id="batch-history-title">Batch history</h2>
            <p>Review completed scans and what they added to the library.</p>
        </div>
    </header>

    <div class="ingestion-batch-history__filters">
        <AppTextField Value="@_search"
                      ValueChanged="OnSearchChanged"
                      OnDebounceIntervalElapsed="OnSearchDebounced"
                      DebounceInterval="350"
                      Placeholder="Search batches, titles, or content…"
                      Adornment="AppAdornment.Start"
                      AdornmentIcon="@AppMaterialIcons.Outlined.Search" />
        <div class="ingestion-batch-history__quick-filters" role="group" aria-label="Filter batch history">
            @foreach (var option in StatusOptions)
            {
                <AppNativeButton Type="button"
                                 Class="@StatusClass(option.Value)"
                                 OnClick="@(_ => SetStatusAsync(option.Value))">@option.Label</AppNativeButton>
            }
        </div>
    </div>

    @if (_loading && _operations.Count == 0)
    {
        <AppProgressBar Indeterminate="true" />
    }
    else if (!string.IsNullOrWhiteSpace(_error) && _operations.Count == 0)
    {
        <AppAlert Tone="AppUiTone.Warning">@_error</AppAlert>
    }
    else if (_operations.Count == 0)
    {
        <AppEmptyState Title="No batches found" Message="No ingestion runs match this search and filter." />
    }
    else
    {
        <p class="ingestion-batch-history__count">
            Showing @_operations.Count.ToString("N0") of @(_totalCount?.ToString("N0") ?? _operations.Count.ToString("N0")) batches
        </p>
        <div class="ingestion-batch-ledger" aria-label="Ingestion batch history">
            @foreach (var operation in _operations)
            {
                <article class="ingestion-batch @ResultClass(operation)" @key="operation.BatchId">
                    <div class="ingestion-batch__row">
                        <time>
                            <strong>@DateHeading(operation.StartedAt)</strong>
                            <span>@operation.StartedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                            <small>@operation.StartedAt.ToLocalTime().ToString("h:mm tt")</small>
                        </time>
                        <span class="ingestion-batch__state" aria-label="@ResultLabel(operation)"><AppMaterialIcon Icon="@ResultIcon(operation)" /></span>
                        <span class="ingestion-batch__identity">
                            <strong>@IngestionBatchDisplay.Title(operation)</strong>
                            <small>@IngestionBatchDisplay.Summary(operation)</small>
                            <em>
                                <span><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Description" />@IngestionBatchDisplay.FilesChecked(operation)</span>
                                <span><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Storage" />@IngestionBatchDisplay.AddedOutcome(operation)</span>
                            </em>
                        </span>
                        <span class="ingestion-batch__covers @(operation.AddedPreview.Count == 0 ? "is-empty" : null)" aria-hidden="true">
                            @if (operation.AddedPreview.Count == 0)
                            {
                                <span class="ingestion-batch__empty-art"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Inventory2" /></span>
                            }
                            else
                            {
                                @foreach (var item in operation.AddedPreview)
                                {
                                    <span><AppMediaArtwork ImageUrl="@item.CoverUrl" Alt="" FallbackIcon="@MediaIcon(item.MediaType)" /></span>
                                }
                                @if (operation.AddedGroupCount > operation.AddedPreview.Count)
                                {
                                    <b>+@(operation.AddedGroupCount - operation.AddedPreview.Count)<small>more</small></b>
                                }
                            }
                        </span>
                        <span class="ingestion-batch__action">
                            <AppButton Href="@IngestionBatchDisplay.MediaHref(operation)"
                                       Label="Open batch" aria-label="@($"Open batch {IngestionBatchDisplay.Title(operation)}")" ButtonStyle="AppButtonStyle.Filled"
                                       Tone="AppUiTone.Primary" EndIcon="@AppMaterialIcons.Outlined.ChevronRight" />
                        </span>
                    </div>
                </article>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <AppAlert Tone="AppUiTone.Warning">@_error</AppAlert>
        }

        @if (_hasMore)
        {
            <div class="ingestion-batch-history__more">
                <AppButton Label="Show older"
                           ButtonStyle="AppButtonStyle.Outlined"
                           EndIcon="@AppMaterialIcons.Outlined.ExpandMore"
                           Loading="@_loading"
                           Disabled="@_loading"
                           OnClick="ShowOlderAsync" />
            </div>
        }
    }
</section>

@code {
    private const int InitialBatchCount = 3;
    private const int OlderBatchCount = 10;
    private readonly List<ActivityBatchSummaryDto> _operations = [];
    private string? _search;
    private string _status = "all";
    private int? _totalCount;
    private bool _hasMore;
    private bool _loading = true;
    private string? _error;
    private int _loadRevision;
    private CancellationTokenSource? _loadCts;

    private static readonly IReadOnlyList<AppSelectOption> StatusOptions =
    [
        new("all", "All"),
        new("completed", "Completed"),
        new("attention", "Needs attention"),
        new("failed", "Failed"),
    ];

    protected override Task OnInitializedAsync()
    {
        Dashboard.OnChanged += OnDashboardChanged;
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        _search = query.TryGetValue("q", out var rawSearch) ? rawSearch.FirstOrDefault() : null;
        return LoadAsync(reset: true);
    }

    private DateTimeOffset _lastHistoryRefresh;
    private void OnDashboardChanged()
    {
        if (_loading || DateTimeOffset.UtcNow - _lastHistoryRefresh < TimeSpan.FromSeconds(5)) return;
        _lastHistoryRefresh = DateTimeOffset.UtcNow;
        _ = InvokeAsync(async () => { await LoadAsync(reset: true); StateHasChanged(); });
    }

    private Task OnSearchChanged(string? value)
    {
        _search = value;
        return Task.CompletedTask;
    }

    private Task OnSearchDebounced(string _) => LoadAsync(reset: true);

    private async Task SetStatusAsync(string status)
    {
        if (string.Equals(_status, status, StringComparison.OrdinalIgnoreCase))
            return;

        _status = status;
        await LoadAsync(reset: true);
    }

    private Task ShowOlderAsync() => LoadAsync(reset: false);

    private async Task LoadAsync(bool reset)
    {
        var revision = ++_loadRevision;
        _loading = true;
        _error = null;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;
        var offset = reset ? 0 : _operations.Count;
        var limit = reset ? Math.Max(InitialBatchCount, _operations.Count) : OlderBatchCount;
        var query = new ActivityAuditQuery
        {
            HistoricalOnly = true,
            Search = _search,
            Status = _status == "all" ? null : _status,
            Sort = "started",
            SortDirection = "desc",
            Offset = offset,
            Limit = limit,
        };

        try
        {
            var page = await Orchestrator.GetActivityBatchesAsync(query, ct);
            if (revision != _loadRevision)
                return;

            var items = page?.Items
                .GroupBy(operation => operation.BatchId)
                .Select(group => group.First())
                .ToList() ?? [];
            if (reset)
                _operations.Clear();
            _operations.AddRange(items.Where(item => _operations.All(existing => existing.BatchId != item.BatchId)));
            _totalCount = page?.TotalCount;
            _hasMore = page?.HasMore == true;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            if (revision == _loadRevision)
                _error = $"Batch history could not load: {ex.Message}";
        }
        finally
        {
            if (revision == _loadRevision)
                _loading = false;
        }
    }

    private string StatusClass(string value) =>
        $"ingestion-batch-history__filter {(value.Equals(_status, StringComparison.OrdinalIgnoreCase) ? "is-active" : null)}";

    private static string DateHeading(DateTimeOffset value)
    {
        var date = value.ToLocalTime().Date;
        return date == DateTime.Today
            ? "Today"
            : date == DateTime.Today.AddDays(-1)
                ? "Yesterday"
                : value.ToLocalTime().ToString("MMMM d, yyyy");
    }

    private static string ResultLabel(ActivityBatchSummaryDto operation) => operation.Status?.ToLowerInvariant() switch
    {
        "running" or "active" or "processing" => "In progress",
        "failed" => "Failed",
        "abandoned" or "interrupted" => "Interrupted",
        _ => operation.FailureCount > 0
            ? "Completed with failures"
            : operation.ReviewCount > 0 ? "Completed; needs attention" : "Completed",
    };

    private static string ResultClass(ActivityBatchSummaryDto operation) => operation.Status?.ToLowerInvariant() switch
    {
        "failed" => "is-danger",
        "abandoned" or "interrupted" => "is-warning",
        "running" or "active" or "processing" => "is-active",
        _ => operation.FailureCount > 0
            ? "is-danger"
            : operation.ReviewCount > 0 ? "is-warning" : "is-success",
    };

    private static string ResultIcon(ActivityBatchSummaryDto operation) => operation.Status?.ToLowerInvariant() switch
    {
        "failed" => AppMaterialIcons.Outlined.ErrorOutline,
        "abandoned" or "interrupted" => AppMaterialIcons.Outlined.WarningAmber,
        "running" or "active" or "processing" => AppMaterialIcons.Outlined.Sync,
        _ => operation.FailureCount > 0
            ? AppMaterialIcons.Outlined.ErrorOutline
            : operation.ReviewCount > 0 ? AppMaterialIcons.Outlined.WarningAmber : AppMaterialIcons.Outlined.CheckCircle,
    };

    private static string MediaIcon(string media) => media switch
    {
        "Music" => AppMaterialIcons.Outlined.Album,
        "TV" => AppMaterialIcons.Outlined.Tv,
        "Movies" => AppMaterialIcons.Outlined.Movie,
        "Books" => AppMaterialIcons.Outlined.MenuBook,
        "Audiobooks" => AppMaterialIcons.Outlined.Headphones,
        "Comics" => AppMaterialIcons.Outlined.CollectionsBookmark,
        _ => AppMaterialIcons.Outlined.PlayCircle,
    };

    public void Dispose()
    {
        Dashboard.OnChanged -= OnDashboardChanged;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }
}
