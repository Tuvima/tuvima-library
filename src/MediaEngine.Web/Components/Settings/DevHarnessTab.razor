@namespace MediaEngine.Web.Components.Settings
@using System.Text.Json
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="tl-page dev-harness-page" data-temporary-page="development-tools">
    <header class="dev-harness-header">
        <h2>Development Tools</h2>
        <p>Use protected real media or generated fixtures to exercise the normal library experience.</p>
    </header>

    <AppCard Title="Real media" Description="Index an existing collection without moving, renaming, or writing to its files.">
        <div class="real-media-harness-controls">
            <div>
                <p>@_realMediaStatus</p>
                <p>For a full library-state reset, stop the apps and run <code>tools/Run-RealMediaHarness.ps1</code> from the repository. Accounts and profiles remain; original files stay in place.</p>
                <p>Ingestion progress is shown in Operations. Source verification does not certify playback or subtitle support.</p>
            </div>
            <AppButton Label="Refresh protection status" ButtonStyle="AppButtonStyle.Outlined"
                       Disabled="@(_runningAction is not null)" OnClick="RefreshRealMediaStatusAsync" />
            <AppButton Label="Verify original files" ButtonStyle="AppButtonStyle.Outlined"
                       Disabled="@(!_realMediaActive || _runningAction is not null)" OnClick="VerifyRealMediaAsync" />
        </div>
    </AppCard>

    <AppCard Title="Test Media"
             Description="Choose the media you want to recreate as new library input."
             Class="dev-harness-card">
        <div class="dev-harness-form">
            <section class="dev-harness-fieldset" aria-labelledby="dev-media-label">
                <div id="dev-media-label" class="dev-harness-field-label">Media</div>
                <div class="dev-harness-chip-row">
                    <AppChip Text="All"
                             Icon="@Icons.Material.Outlined.AllInclusive"
                             Tone="@(AllTypesSelected ? AppUiTone.Primary : AppUiTone.Neutral)"
                             Variant="@(AllTypesSelected ? Variant.Filled : Variant.Outlined)"
                             Disabled="@IsBusy"
                             OnClick="SelectAllTypes"
                             Class="dev-harness-chip" />
                    @foreach (var mediaType in MediaTypes)
                    {
                        var selected = _selectedTypes.Contains(mediaType.Key);
                        <AppChip Text="@mediaType.Label"
                                 Icon="@mediaType.Icon"
                                 Tone="@(selected ? AppUiTone.Primary : AppUiTone.Neutral)"
                                 Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                                 Disabled="@IsBusy"
                                 OnClick="@(() => ToggleType(mediaType.Key))"
                                 Class="dev-harness-chip" />
                    }
                </div>
            </section>

            <section class="dev-harness-fieldset" aria-labelledby="dev-fixture-label">
                <div id="dev-fixture-label" class="dev-harness-field-label">Fixture Set</div>
                <AppSegmentedControl Options="@FixtureSetOptions"
                                     Value="@_fixtureSet"
                                     ValueChanged="SetFixtureSet"
                                     Disabled="@IsBusy"
                                     AriaLabel="Fixture set" />
                <p class="dev-harness-helper">
                    @(_fixtureSet == "standard"
                        ? "A small deterministic set covering standalone items, series, episodes, albums, tracks, and comic issues."
                        : "A larger deterministic set for queue, activity, layout, pagination, and concurrent enrichment testing.")
                </p>
            </section>

            <div class="dev-harness-primary-action">
                <AppButton Label="@(_runningAction == "seed" ? "Resetting & Seeding" : "Reset & Seed Test Library")"
                           StartIcon="@Icons.Material.Outlined.RestartAlt"
                           Tone="AppUiTone.Primary"
                           ButtonStyle="AppButtonStyle.Filled"
                           Disabled="@(IsBusy || _selectedTypes.Count == 0)"
                           OnClick="ResetAndSeedAsync" />
                <p>Clears generated library state, creates the selected test media fixtures, and sends them through the normal ingestion pipeline.</p>
            </div>
        </div>
    </AppCard>

    <section class="dev-harness-secondary-section">
        <div>
            <h3>Existing Development Media</h3>
            <p>Forces configured library folders to be rediscovered using the normal ingestion pipeline.</p>
        </div>
        <AppButton Label="@(_runningAction == "rescan" ? "Rescanning" : "Rescan All Libraries")"
                   StartIcon="@Icons.Material.Outlined.Refresh"
                   ButtonStyle="AppButtonStyle.Outlined"
                   Disabled="@IsBusy"
                   OnClick="RescanLibrariesAsync" />
    </section>

    <section class="dev-harness-secondary-section">
        <div>
            <h3>View Sample Memories</h3>
            <p>Adds ten attributed photos plus 360 labeled synthetic images across Seattle and nearby cities, Tokyo and nearby cities, France, and Chicago/Naperville. Neighborhood offsets and regional groups exercise map clustering and zoom, with dense dates spanning 2004–2026. Re-running updates existing fixture locations and adds only new images.</p>
        </div>
        <AppButton Label="@(_runningAction == "view-photos" ? "Seeding View Photos" : "Seed View Photos")"
                   StartIcon="@Icons.Material.Outlined.AddPhotoAlternate"
                   ButtonStyle="AppButtonStyle.Outlined"
                   Disabled="@IsBusy"
                   OnClick="SeedViewPhotosAsync" />
    </section>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <AppAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="dev-harness-message">
            @_error
        </AppAlert>
    }
    else if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <AppAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="dev-harness-message">
            <div class="dev-harness-success-row">
                <span>@_statusMessage</span>
                @if (_showIngestionLink)
                {
                    <AppButton Label="View Ingestion"
                               Href="/settings/ingestion"
                               StartIcon="@Icons.Material.Outlined.PendingActions"
                               Size="AppControlSize.Compact" />
                }
            </div>
        </AppAlert>
    }

    <MudExpansionPanels Elevation="0" Class="dev-harness-advanced">
        <MudExpansionPanel Text="Advanced">
            <div class="dev-harness-danger-zone">
                <div class="dev-harness-danger-row">
                    <div>
                        <strong>Reset Library Data</strong>
                        <p>Clears catalogued media, relationships, enrichment, generated artwork, and ingestion history. Configuration and source files remain.</p>
                    </div>
                    <AppButton Label="@(_runningAction == "reset" ? "Resetting" : "Reset Library Data")"
                               StartIcon="@Icons.Material.Outlined.DeleteSweep"
                               Tone="AppUiTone.Warning"
                               ButtonStyle="AppButtonStyle.Outlined"
                               Disabled="@IsBusy"
                               OnClick="ResetLibraryDataAsync" />
                </div>
                <div class="dev-harness-danger-row is-factory">
                    <div>
                        <strong>Factory Reset Development Instance</strong>
                        <p>Clears the development database, users, profiles, activity, and generated state. Configured source media is never deleted.</p>
                    </div>
                    <AppButton Label="@(_runningAction == "factory" ? "Factory Resetting" : "Factory Reset")"
                               StartIcon="@Icons.Material.Outlined.Warning"
                               Tone="AppUiTone.Error"
                               ButtonStyle="AppButtonStyle.Filled"
                               Disabled="@IsBusy"
                               OnClick="FactoryResetAsync" />
                </div>
            </div>
        </MudExpansionPanel>
    </MudExpansionPanels>
</div>

@code {
    [Parameter] public string Subsection { get; set; } = "options";

    private sealed record HarnessMediaType(string Key, string Label, string Icon);

    private static readonly HarnessMediaType[] MediaTypes =
    [
        new("books", "Books", Icons.Material.Outlined.MenuBook),
        new("audiobooks", "Audiobooks", Icons.Material.Outlined.Headphones),
        new("movies", "Movies", Icons.Material.Outlined.Movie),
        new("tv", "TV", Icons.Material.Outlined.LiveTv),
        new("music", "Music", Icons.Material.Outlined.Album),
        new("comics", "Comics", Icons.Material.Outlined.AutoStories),
    ];

    private static readonly AppSelectOption[] FixtureSetOptions =
    [
        new("standard", "Standard", Icons.Material.Outlined.CheckCircleOutline),
        new("stress", "Stress", Icons.Material.Outlined.Speed),
    ];

    private readonly HashSet<string> _selectedTypes = MediaTypes
        .Select(mediaType => mediaType.Key)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);

    private string _fixtureSet = "standard";
    private string? _runningAction;
    private string? _statusMessage;
    private string? _error;
    private bool _showIngestionLink;

    private bool _realMediaActive;
    private bool _modeKnown;
    private string _realMediaStatus = "Checking harness mode…";
    private bool IsBusy => _runningAction is not null || _realMediaActive || !_modeKnown;
    private bool AllTypesSelected => _selectedTypes.Count == MediaTypes.Length;

    protected override Task OnInitializedAsync() => RefreshRealMediaStatusAsync();

    private async Task RefreshRealMediaStatusAsync()
    {
        var result = await ApiClient.RunDevHarnessAsync("/dev/real-media/status");
        if (result?.Succeeded != true)
        {
            _realMediaStatus = "Protection status unavailable. Reset and seed actions remain disabled until the Engine can verify its mode.";
            _modeKnown = false;
            return;
        }
        using var json = JsonDocument.Parse(result.Body);
        _realMediaActive = json.RootElement.GetProperty("active").GetBoolean();
        _modeKnown = true;
        _realMediaStatus = _realMediaActive
            ? $"{json.RootElement.GetProperty("status").GetString()} · {json.RootElement.GetProperty("files").GetInt32()} original files · {json.RootElement.GetProperty("source").GetString()}"
            : "Generated-fixture mode is active. The offline real-media runner prepares a protected source baseline before resetting library records.";
    }

    private async Task VerifyRealMediaAsync()
    {
        await RunHarnessActionAsync("real-verify", "/dev/real-media/verify", null,
            "Source verification requested. Refresh protection status to see the result.");
        await RefreshRealMediaStatusAsync();
    }

    private void SelectAllTypes()
    {
        foreach (var mediaType in MediaTypes)
        {
            _selectedTypes.Add(mediaType.Key);
        }
    }

    private void ToggleType(string key)
    {
        if (!_selectedTypes.Remove(key))
        {
            _selectedTypes.Add(key);
        }
    }

    private Task SetFixtureSet(string value)
    {
        _fixtureSet = string.Equals(value, "stress", StringComparison.OrdinalIgnoreCase)
            ? "stress"
            : "standard";
        return Task.CompletedTask;
    }

    private async Task ResetAndSeedAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Reset and seed test library?",
            "This will remove current ingested library data and recreate the selected development fixtures. Application settings, users, configured libraries, and provider credentials will be preserved.",
            yesText: "Reset & Seed",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        await RunHarnessActionAsync(
            "seed",
            "/dev/reset-and-seed",
            new Dictionary<string, string?>
            {
                ["types"] = string.Join(",", MediaTypes.Select(type => type.Key).Where(_selectedTypes.Contains)),
                ["fixtureSet"] = _fixtureSet,
            },
            "Test fixtures created. Ingestion triggered.",
            showIngestionLink: true);
    }

    private async Task RescanLibrariesAsync()
    {
        BeginAction("rescan");
        try
        {
            var succeeded = await ApiClient.TriggerRescanAsync();
            if (succeeded)
            {
                CompleteAction("Library rescan triggered.", showIngestionLink: true);
            }
            else
            {
                FailAction(ApiClient.LastError ?? "The library rescan could not be started.");
            }
        }
        finally
        {
            _runningAction = null;
        }
    }

    private Task SeedViewPhotosAsync() =>
        RunHarnessActionAsync(
            "view-photos",
            "/dev/view-photo-harness",
            null,
            "370 View image fixtures seeded across neighborhood and regional groups, including Chicago/Naperville and five French cities.");

    private async Task ResetLibraryDataAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Reset library data?",
            "This clears ingested media, relationships, enrichment, generated artwork, and ingestion history. Application configuration and source media will be preserved.",
            yesText: "Reset Library Data",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        await RunHarnessActionAsync(
            "reset",
            "/dev/reset-library-data",
            null,
            "Library data reset. Configuration and source media were preserved.");
    }

    private async Task FactoryResetAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Factory reset this development instance?",
            "This permanently clears the development database, including users, profiles, activity, provider state, and generated fixtures. Configured source media will not be deleted. You may need to complete setup again.",
            yesText: "Factory Reset Development Instance",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        await RunHarnessActionAsync(
            "factory",
            "/dev/factory-reset",
            null,
            "Development instance factory reset completed.");
    }

    private async Task RunHarnessActionAsync(
        string action,
        string path,
        IReadOnlyDictionary<string, string?>? query,
        string fallbackMessage,
        bool showIngestionLink = false)
    {
        BeginAction(action);
        try
        {
            var result = await ApiClient.RunDevHarnessAsync(path, query);
            if (result?.Succeeded == true)
            {
                CompleteAction(ExtractMessage(result.Body, fallbackMessage), showIngestionLink);
            }
            else
            {
                FailAction(result is null
                    ? "The operation was cancelled."
                    : ExtractError(result.Body, $"The operation failed with HTTP {result.StatusCode}."));
            }
        }
        finally
        {
            _runningAction = null;
        }
    }

    private void BeginAction(string action)
    {
        _runningAction = action;
        _error = null;
        _statusMessage = null;
        _showIngestionLink = false;
    }

    private void CompleteAction(string message, bool showIngestionLink)
    {
        _statusMessage = message;
        _showIngestionLink = showIngestionLink;
        Snackbar.Add(message, Severity.Success);
    }

    private void FailAction(string message)
    {
        _error = message;
        Snackbar.Add(message, Severity.Error);
    }

    private static string ExtractMessage(string body, string fallback) =>
        ExtractJsonString(body, "message") ?? fallback;

    private static string ExtractError(string body, string fallback) =>
        ExtractJsonString(body, "error") ?? fallback;

    private static string? ExtractJsonString(string body, string propertyName)
    {
        if (string.IsNullOrWhiteSpace(body))
        {
            return null;
        }

        try
        {
            using var document = JsonDocument.Parse(body);
            return document.RootElement.TryGetProperty(propertyName, out var property)
                && property.ValueKind == JsonValueKind.String
                    ? property.GetString()
                    : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }
}
