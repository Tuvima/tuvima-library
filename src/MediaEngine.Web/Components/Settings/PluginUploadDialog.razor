@namespace MediaEngine.Web.Components.Settings
@using Microsoft.AspNetCore.Components.Forms
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Ui
@inject UIOrchestratorService Orchestrator
@inject IStringLocalizer<SharedStrings> L

@* Upload plugin (Plugins and Integrations screens spec D5, D11): add a JSON-only plugin from a file on this computer. The
   warning is always shown; a refused file is explained in the Engine's words and nothing is added. *@
@if (Open)
{
    <AppDialogFrame Open="true" Title="@L["PluginUploadDialog_UploadPlugin"].Value" DialogOptions="DialogShape" OnCancel="CloseAsync">
        <AppDialogShell Modal="false" Title="@L["PluginUploadDialog_UploadPlugin"].Value" Size="Medium" Tone="AppUiTone.Warning" OnClose="CloseAsync">
        <ChildContent>
        <div class="plugin-upload app-dialog-shell__pad app-dialog-shell__pad--stretch" data-testid="plugin-upload-dialog">
            <AppAlert Tone="AppUiTone.Warning">@L["PluginUploadDialog_OnlyUploadPluginsYouTrust"]</AppAlert>
            <p>Only plugins described entirely in JSON can be uploaded. An uploaded plugin is marked Private and arrives switched off; you see what it can do before you switch it on. Any keys it needs are kept in the config folder as plain text, and the page never shows them back.</p>
            <AppFileUpload T="IBrowserFile" Accept=".zip" FilesChanged="@Chosen" Disabled="@_busy">
                <SelectedTemplate>
                    <span data-testid="plugin-upload-file">@(_file?.Name ?? "No file chosen")</span>
                </SelectedTemplate>
            </AppFileUpload>
            @if (!string.IsNullOrWhiteSpace(_problem))
            {
                <AppAlert Tone="AppUiTone.Error" data-testid="plugin-upload-problem">@_problem</AppAlert>
            }
        </div>
        </ChildContent>
        <FooterContent>
            <AppButton Label="@L["Search_Cancel"].Value" ButtonStyle="AppButtonStyle.Outlined" OnClick="CloseAsync" Disabled="@_busy" />
            <AppButton Label="@L["PluginUploadDialog_Upload"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary"
                       Disabled="@(_file is null || _busy)" Loading="@_busy" OnClick="UploadAsync" />
        </FooterContent>
        </AppDialogShell>
    </AppDialogFrame>
}

@code {
    private const long MaxPackageBytes = 64L * 1024 * 1024;
    private static readonly AppDialogOptions DialogShape = new() { Sheet = AppDialogSheetMode.Phone, BackdropClick = false, CloseOnEscapeKey = true, NoHeader = true };

    private IBrowserFile? _file;
    private string? _problem;
    private bool _busy;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    /// <summary>Raised with the plain sentence the Engine gave when the plugin was added.</summary>
    [Parameter] public EventCallback<string> OnUploaded { get; set; }

    private void Chosen(IBrowserFile? file)
    {
        _file = file;
        _problem = null;
    }

    private async Task CloseAsync()
    {
        if (_busy)
            return;

        _file = null;
        _problem = null;
        await OnClosed.InvokeAsync();
    }

    private async Task UploadAsync()
    {
        if (_file is null || _busy)
            return;

        _busy = true;
        _problem = null;
        try
        {
            await using var stream = _file.OpenReadStream(MaxPackageBytes);
            var outcome = await Orchestrator.UploadPluginAsync(stream, _file.Name);
            if (!outcome.Succeeded)
            {
                _problem = string.IsNullOrWhiteSpace(outcome.Problem) ? "The plugin could not be uploaded. Try again." : outcome.Problem;
                return;
            }

            var message = outcome.Result!.Message;
            _file = null;
            await OnUploaded.InvokeAsync(message);
            await OnClosed.InvokeAsync();
        }
        catch (IOException)
        {
            _problem = "The file could not be read, or it is larger than 64 MB.";
        }
        finally
        {
            _busy = false;
        }
    }
}
