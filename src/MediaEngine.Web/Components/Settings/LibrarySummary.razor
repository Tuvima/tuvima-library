@namespace MediaEngine.Web.Components.Settings
@using System.Globalization
@using MediaEngine.Contracts.Library
@using MediaEngine.Contracts.System
@using MediaEngine.Web.Services.Formatting
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient
@inject ILogger<LibrarySummary> Logger
@inject IStringLocalizer<SharedStrings> L

@* The top of the Library and Ingestion page: what the library holds (counts by type) and how healthy it is (items
   waiting in Needs Review, storage problems), read from the Engine's library overview. It reloads when RefreshToken
   changes, which the live page bumps each time the Library finishes adding media; it never polls on its own. *@
<section class="library-summary" data-testid="library-summary" aria-label="@L["LibrarySummary_LibrarySummary"].Value">
    @if (_overview is null && _error is null)
    {
        <AppSkeleton Class="library-summary__skeleton" Width="100%" Height="7rem" />
    }
    else if (_overview is null)
    {
        <AppAlert Tone="AppUiTone.Warning">@_error</AppAlert>
    }
    else
    {
        @if (_error is not null)
        {
            <AppAlert Tone="AppUiTone.Warning">@_error</AppAlert>
        }

        <SettingsSectionPanel Title="@L["LibrarySummary_LibrarySummary"].Value"
                              Icon="@AppMaterialIcons.Outlined.VideoLibrary"
                              Description="@($"{DisplayFormat.FormatCount(LibraryTotal)} items across your catalogued media.")">
            <Actions>
                <AppButton Href="/settings/libraries" Label="@L["LibrarySummary_ManageLibraries"].Value" ButtonStyle="AppButtonStyle.Text" Size="AppControlSize.Compact" EndIcon="@AppMaterialIcons.Outlined.ChevronRight" />
            </Actions>
            <ChildContent>
                <div class="library-summary__breakdown" aria-label="@L["LibrarySummary_LibraryMediaTypeBreakdown"].Value">
                    @foreach (var media in MediaBreakdown)
                    {
                        <AppCssElement Tag="div" Class="library-summary__media" Css="@MediaCardStyle(media)">
                            <AppIconTile Name="@media.IconKey" AccentColor="@media.Color" />
                            <span class="library-summary__media-copy">
                                <span class="library-summary__media-label">@media.Label</span>
                                <strong class="library-summary__media-count">@DisplayFormat.FormatCount(media.Count)</strong>
                                <span class="library-summary__media-percent">@FormatPercent(media.Percent)</span>
                            </span>
                        </AppCssElement>
                    }
                </div>

                <div class="library-summary__composition" role="list" aria-label="@CompositionAccessibleLabel">
                    @if (MediaBreakdown.Any(item => item.Count > 0))
                    {
                        @foreach (var media in MediaBreakdown.Where(item => item.Count > 0))
                        {
                            <AppCssElement Tag="span"
                                           Class="library-summary__segment"
                                           Css="@SegmentStyle(media)"
                                           role="listitem"
                                           aria-label="@CompositionItemLabel(media)"
                                           title="@CompositionItemLabel(media)"></AppCssElement>
                        }
                    }
                    else
                    {
                        <span class="library-summary__composition-empty"></span>
                    }
                </div>

                @if (PendingReviewCount > 0)
                {
                    <div class="library-summary__attention" data-testid="library-summary-review">
                        <div class="library-summary__attention-copy">
                            <AppIconTile Name="@AppIcons.Warning" AccentColor="var(--tl-status-warning)" Size="AppControlSize.Compact" />
                            <div><strong>@ReviewTitle</strong><p>@L["LibrarySummary_CouldNotBeIdentifiedConfidently"]</p></div>
                        </div>
                        <AppButton Href="/settings/review"
                                   Label="@L["LibrarySummary_ReviewItems"].Value"
                                   EndIcon="@AppMaterialIcons.Outlined.ChevronRight"
                                   ButtonStyle="AppButtonStyle.Outlined"
                                   Size="AppControlSize.Compact"
                                   Tone="AppUiTone.Warning" />
                    </div>
                }

                @if (StorageIssues.Count > 0)
                {
                    <div class="library-summary__issues" role="list" aria-label="@L["LibrarySummary_LibraryStorageProblems"].Value" data-testid="library-summary-storage">
                        @foreach (var check in StorageIssues)
                        {
                            <a class="library-summary__issue" role="listitem" href="/settings/libraries">
                                <AppIconTile Name="@AppIcons.Library" AccentColor="@IssueAccent(check.Status)" />
                                <span><strong>@check.Name.Replace('_', ' ')</strong><small>@check.Description</small></span>
                                <AppStatusBadge Text="@IssueStatus(check.Status)" Tone="@IssueTone(check.Status)" />
                            </a>
                        }
                    </div>
                }
            </ChildContent>
        </SettingsSectionPanel>
    }
</section>

@code {
    /// <summary>Changes when the live page sees the Library finish adding media; each change reloads the summary once.</summary>
    [Parameter] public int RefreshToken { get; set; }

    private LibraryOverviewDto? _overview;
    private StartupReadinessResponse? _readiness;
    private string? _error;
    private int? _loadedToken;

    private int PendingReviewCount => _overview?.ReviewTotal ?? 0;

    private string ReviewTitle =>
        $"{DisplayFormat.FormatCount(PendingReviewCount)} item{(PendingReviewCount == 1 ? "" : "s")} need review";

    // Only problems with the library's own folders belong here; the rest of the readiness checks describe the server.
    private IReadOnlyList<StartupReadinessCheckResponse> StorageIssues =>
        _readiness?.Checks
            .Where(check => string.Equals(check.Category, "storage", StringComparison.OrdinalIgnoreCase)
                            && !string.Equals(check.Status, "ready", StringComparison.OrdinalIgnoreCase))
            .ToList() ?? [];

    private int LibraryTotal => _overview?.MediaTypeCounts.Count > 0
        ? MediaBreakdown.Sum(item => item.Count)
        : _overview?.TotalItems ?? 0;

    private IReadOnlyList<MediaBreakdownItem> MediaBreakdown
    {
        get
        {
            var counts = _overview?.MediaTypeCounts ?? [];
            var items = new[]
            {
                MediaItem("Books", counts, "Books"),
                MediaItem("Audiobooks", counts, "Audiobooks"),
                MediaItem("Movies", counts, "Movies"),
                MediaItem("TV Episodes", counts, "TV"),
                MediaItem("Music", counts, "Music"),
                MediaItem("Comics", counts, "Comics"),
                MediaItem("Videos", counts, "Videos"),
            };

            var total = items.Sum(item => item.Count);
            if (total <= 0)
            {
                return items;
            }

            return items
                .Select(item => item with { Percent = item.Count * 100d / total })
                .ToList();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedToken == RefreshToken)
        {
            return;
        }

        _loadedToken = RefreshToken;
        await LoadAsync();
    }

    // The counts and the folder checks are asked for together, but the tiles never wait for the folder checks: they draw as
    // soon as the counts arrive and any storage problem fills in after. Only the storage checks are asked for, because the
    // full readiness report also scans the whole data store, which is slow on a large library and while media is being added.
    private async Task LoadAsync()
    {
        var readinessTask = ApiClient.GetStorageReadinessAsync();
        try
        {
            _overview = await ApiClient.GetLibraryOverviewAsync();
            _error = _overview is null ? "The library summary is unavailable right now." : null;
        }
        catch (Exception ex)
        {
            // The summary is one card of the page: keep what was shown (if anything) and say it could not refresh.
            Logger.LogWarning(ex, "The library summary could not be loaded.");
            _error = _overview is null
                ? "The library summary could not load. The live ingestion below is unaffected."
                : "The library summary could not refresh, so the previous numbers are shown.";
        }

        StateHasChanged();

        try
        {
            _readiness = await readinessTask;
        }
        catch (Exception ex)
        {
            // Storage problems are an extra line under the tiles; without them the counts are still right, so say nothing more.
            Logger.LogWarning(ex, "The library storage checks could not be loaded.");
        }
    }

    private static string IssueStatus(string status) => status switch
    {
        "degraded" => "Degraded",
        _ => "Blocked",
    };

    private static AppUiTone IssueTone(string status) => status switch
    {
        "degraded" => AppUiTone.Warning,
        _ => AppUiTone.Error,
    };

    private static string IssueAccent(string status) => status switch
    {
        "degraded" => "var(--tl-status-warning)",
        _ => "var(--tl-status-danger)",
    };

    private static MediaBreakdownItem MediaItem(string label, Dictionary<string, int> counts, string mediaType) =>
        new(
            label,
            CountFor(counts, label),
            0,
            AppMediaPresentation.IconKeyFor(mediaType),
            AppMediaPresentation.AccentFor(mediaType));

    private static int CountFor(Dictionary<string, int> counts, string label)
    {
        string[] aliases = label switch
        {
            "Books" => new[] { "book", "books", "epub" },
            "Audiobooks" => new[] { "audiobook", "audiobooks", "m4b" },
            "Movies" => new[] { "movie", "movies", "film" },
            "Videos" => new[] { "video", "videos" },
            "TV Episodes" => new[] { "tv", "tv episode", "tv episodes", "episode", "episodes" },
            "Music" => new[] { "music", "track", "tracks", "song", "songs", "album" },
            "Comics" => new[] { "comic", "comics", "cbz", "cbr" },
            _ => new[] { label },
        };

        var normalizedAliases = aliases.Select(NormalizeMediaKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return counts
            .Where(kv => normalizedAliases.Contains(NormalizeMediaKey(kv.Key)))
            .Sum(kv => kv.Value);
    }

    private static string NormalizeMediaKey(string value) =>
        new(value
            .Where(char.IsLetterOrDigit)
            .Select(char.ToLowerInvariant)
            .ToArray());

    private static string SegmentStyle(MediaBreakdownItem item) =>
        $"width:{item.Percent.ToString("0.######", CultureInfo.InvariantCulture)}%;--library-summary-segment:{item.Color};";

    private static string MediaCardStyle(MediaBreakdownItem item) =>
        $"--library-summary-accent:{item.Color};";

    private static string CompositionItemLabel(MediaBreakdownItem item) =>
        $"{item.Label}: {DisplayFormat.FormatCount(item.Count)} items, {FormatPercent(item.Percent)} of library";

    private string CompositionAccessibleLabel => LibraryTotal <= 0
        ? "Library composition: no catalogued media"
        : $"Library composition, {LibraryTotal} total: {string.Join(", ", MediaBreakdown.Select(item => $"{item.Label} {item.Count}, {FormatPercent(item.Percent)}"))}";

    private static string FormatPercent(double value) =>
        value <= 0 ? "0%" : $"{Math.Round(value):0}%";

    private sealed record MediaBreakdownItem(
        string Label,
        int Count,
        double Percent,
        string IconKey,
        string Color);
}
