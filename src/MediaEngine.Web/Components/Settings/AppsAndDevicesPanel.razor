@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient
@inject DashboardIdentityClient Identity
@inject IAppToastService Snackbar
@inject IJSRuntime JS

<div class="network-panel apps-devices">
    <header class="network-panel__heading">
        <div><h3>Apps &amp; devices</h3><p>Let the Tuvima apps on phones and TVs connect, and see which ones are paired.</p></div>
    </header>

    <SettingsSectionPanel Title="Allow apps" Icon="@AppMaterialIcons.Outlined.Devices"
                          Description="Phones and TVs connect over your internet address and sign in with a paired code.">
        <AppSwitchRow Label="Allow apps to connect"
                      Value="@Settings.NativeAppAccess.Enabled"
                      ValueChanged="SetAppAccessAsync"
                      Disabled="@(!AllowsInternet || _saving)" />
        @if (!AllowsInternet)
        {
            <AppAlert Tone="AppUiTone.Info">Apps connect over the internet address. Set Who can connect to Anywhere first. <a href="/settings/network/remote">Open Remote Access</a></AppAlert>
        }
    </SettingsSectionPanel>

    @if (Settings.NativeAppAccess.Enabled && AllowsInternet)
    {
        <SettingsSectionPanel Title="Address to type in the app" Icon="@AppMaterialIcons.Outlined.Language"
                              Description="Enter this in the app when it asks for your server.">
            @if (string.IsNullOrWhiteSpace(Settings.Remote.PublicHostname))
            {
                <AppAlert Tone="AppUiTone.Warning">No internet address is set yet. <a href="/settings/network/remote">Set it in Remote Access</a></AppAlert>
            }
            else
            {
                <div class="apps-devices__address">
                    <code>@Settings.Remote.PublicHostname</code>
                    <AppButton Label="Copy" StartIcon="@AppMaterialIcons.Outlined.ContentCopy"
                               Size="AppControlSize.Compact" OnClick="CopyAddressAsync" />
                </div>
            }
            <div class="network-card-actions">
                <AppButton Label="Test" StartIcon="@AppMaterialIcons.Outlined.Science" OnClick="TestAsync" />
            </div>
        </SettingsSectionPanel>
    }

    <SettingsSectionPanel Title="Paired devices" Icon="@AppMaterialIcons.Outlined.Devices"
                          Description="Phones and TVs signed in to Tuvima. Revoke one to sign it out at once.">
        @if (_loading)
        {
            <AppSkeleton Size="AppControlSize.Compact" />
        }
        else if (_loadFailed)
        {
            <AppAlert Tone="AppUiTone.Error">Paired devices could not be loaded. Try again in a moment.</AppAlert>
        }
        else if (_devices.Count == 0)
        {
            <AppEmptyState Class="app-page-state--compact" Title="No phones or TVs paired"
                           Message="Open a Tuvima app and choose this server to pair it." />
        }
        else
        {
            <div class="apps-devices__table-wrap">
                <AppTable Class="apps-devices__table">
                    <thead>
                        <tr>
                            <th>Device</th>
                            <th>Type</th>
                            <th>Belongs to</th>
                            <th>Paired</th>
                            <th>Last seen</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var device in _devices)
                        {
                            <tr @key="device.Id">
                                <td>@device.DeviceName<small>@device.ClientName</small></td>
                                <td>@PlatformLabel(device.Platform)</td>
                                <td>@device.AccountDisplayName<small>@device.ProfileName</small></td>
                                <td>@device.PairedAt.LocalDateTime.ToString("d")</td>
                                <td>@device.LastSeenAt.LocalDateTime.ToString("g")</td>
                                <td>
                                    <AppButton Label="Revoke" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Error"
                                               Size="AppControlSize.Compact" OnClick="@(() => AskRevoke(device))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </AppTable>
            </div>
        }
    </SettingsSectionPanel>
</div>

<AppDialog Visible="@(_pendingRevoke is not null)"
           VisibleChanged="@(_ => CancelRevoke())"
           Title="Revoke this device?"
           Subtitle="@(_pendingRevoke is null ? null : $"{_pendingRevoke.DeviceName} will be signed out and has to be paired again.")"
           Icon="@AppMaterialIcons.Outlined.Devices"
           Size="Small">
    <ChildContent>
        <p>It stops working straight away. Nothing is deleted from your library.</p>
    </ChildContent>
    <FooterContent>
        <div class="network-test-dialog__actions">
            <AppButton Label="Cancel" OnClick="CancelRevoke" />
            <AppButton Label="Revoke" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Error"
                       Disabled="@_revoking" OnClick="ConfirmRevokeAsync" />
        </div>
    </FooterContent>
</AppDialog>

<NetworkTestDialog @bind-Visible="_testDialogOpen" Busy="@_testing" Result="@_testResult" />

@code {
    [Parameter, EditorRequired] public NetworkSettingsDto Settings { get; set; } = new();
    [Parameter] public NetworkRuntimeStatusDto? Status { get; set; }
    [Parameter] public EventCallback StatusRefreshRequested { get; set; }

    private List<ManagedClientDeviceDto> _devices = [];
    private ManagedClientDeviceDto? _pendingRevoke;
    private NetworkTestResultDto? _testResult;
    private bool _loading = true;
    private bool _loadFailed;
    private bool _saving;
    private bool _revoking;
    private bool _testing;
    private bool _testDialogOpen;

    private bool AllowsInternet => Settings.WhoCanConnect == "anywhere";

    protected override async Task OnInitializedAsync() => await LoadDevicesAsync();

    private async Task LoadDevicesAsync()
    {
        _loading = true;
        _loadFailed = false;
        try
        {
            _devices = await Identity.GetManagedDevicesAsync();
        }
        catch (Exception)
        {
            // The panel shows its own "could not be loaded" message; the rest of the page stays usable.
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SetAppAccessAsync(bool enabled)
    {
        var previous = Settings.NativeAppAccess.Enabled;
        Settings.NativeAppAccess.Enabled = enabled;
        _saving = true;
        try
        {
            if (await ApiClient.UpdateNetworkSettingsAsync(Settings) is null)
            {
                Settings.NativeAppAccess.Enabled = previous;
                Snackbar.Add(ApiClient.LastError ?? "App access could not be changed.", AppSeverity.Error);
                return;
            }

            Snackbar.Add(enabled ? "Apps can connect." : "Apps can no longer connect.", AppSeverity.Success);
            await StatusRefreshRequested.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CopyAddressAsync()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", Settings.Remote.PublicHostname);
        Snackbar.Add("Address copied.", AppSeverity.Success);
    }

    private async Task TestAsync()
    {
        _testResult = null;
        _testing = true;
        _testDialogOpen = true;
        try
        {
            _testResult = await ApiClient.TestRemoteNetworkAsync();
        }
        finally
        {
            _testing = false;
        }
    }

    private void AskRevoke(ManagedClientDeviceDto device) => _pendingRevoke = device;

    private void CancelRevoke() => _pendingRevoke = null;

    private async Task ConfirmRevokeAsync()
    {
        if (_pendingRevoke is not { } device)
            return;

        _revoking = true;
        try
        {
            var result = await Identity.RevokeManagedDeviceAsync(device.Id);
            if (result.Succeeded)
            {
                Snackbar.Add($"{device.DeviceName} was revoked.", AppSeverity.Success);
            }
            else
            {
                Snackbar.Add("That device could not be revoked.", AppSeverity.Error);
            }
        }
        finally
        {
            _revoking = false;
            _pendingRevoke = null;
        }

        await LoadDevicesAsync();
    }

    private static string PlatformLabel(string platform) => platform switch
    {
        "mobile" => "Phone or tablet",
        "television" => "TV",
        "automotive" => "Car",
        "web" => "Browser",
        _ => platform,
    };
}
