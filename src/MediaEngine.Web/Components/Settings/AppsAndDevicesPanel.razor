@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient
@inject IAppToastService Snackbar
@inject IJSRuntime JS

@if (_loading)
{
    <AppSkeleton Size="AppControlSize.Large" />
}
else if (Settings is null)
{
    <AppErrorState Title="App addresses are unavailable"
                   Message="Start the Engine or retry to see the address to type in the app." />
}
else
{
<div class="apps-devices" data-devices-panel="apps">
    <SettingsSectionPanel Title="Address to type in the app" Icon="@AppMaterialIcons.Outlined.Language"
                          Description="Enter this in the app when it asks for your server.">
        <dl class="apps-devices__facts">
            <div><dt>At home</dt><dd>@(HomeAddress ?? "Not detected yet")</dd></div>
            @if (OutsideAddress is not null)
            {
                <div><dt>Apps use this away from home</dt><dd>@OutsideAddress</dd></div>
            }
        </dl>
        @if (OutsideAddress is null)
        {
            <AppAlert Tone="AppUiTone.Info">Want apps to work away from home too? <a href="/settings/network/remote">Set a secure outside address in Remote Access</a></AppAlert>
        }
        <div class="apps-devices__actions">
            @if (HomeAddress is not null)
            {
                <AppButton Label="Copy" StartIcon="@AppMaterialIcons.Outlined.ContentCopy" OnClick="CopyHomeAddressAsync" />
            }
            @if (OutsideAddress is not null)
            {
                <AppButton Label="Copy outside address" StartIcon="@AppMaterialIcons.Outlined.ContentCopy" OnClick="CopyOutsideAddressAsync" />
            }
            <AppButton Label="Test" StartIcon="@AppMaterialIcons.Outlined.Science" OnClick="TestAsync" />
        </div>
    </SettingsSectionPanel>
</div>
}

<NetworkTestDialog @bind-Visible="_testDialogOpen" Busy="@_testing" Result="@_testResult" />

@code {
    // The addresses belong to the server administrator; the page that hosts this panel decides who sees it.
    private NetworkSettingsDto? Settings { get; set; }
    private NetworkRuntimeStatusDto? Status { get; set; }
    private NetworkTestResultDto? _testResult;
    private bool _loading = true;
    private bool _testing;
    private bool _testDialogOpen;

    // The address a phone or TV on the home network types in: the Engine's preferred address on the adapter the owner
    // chose (Settings > Network), with the Dashboard port.
    private string? HomeAddress => string.IsNullOrWhiteSpace(Status?.PreferredLocalAddress) ? null : Status.PreferredLocalAddress;

    // An outside address only counts once a way in from the internet is chosen (Tailscale or a reverse proxy); the Engine
    // reports the tailnet address in Tailscale mode and the public hostname otherwise.
    private bool HasOutsidePath =>
        !string.Equals(Settings?.Remote.ConnectionMode?.Trim(), "local-only", StringComparison.OrdinalIgnoreCase);

    private string? OutsideAddress => HasOutsidePath && !string.IsNullOrWhiteSpace(Status?.ExternalAddress)
        ? Status.ExternalAddress
        : null;

    protected override async Task OnInitializedAsync()
    {
        Settings = await ApiClient.GetNetworkSettingsAsync();
        Status = await ApiClient.GetNetworkRuntimeStatusAsync();
        _loading = false;
    }

    private Task CopyHomeAddressAsync() => CopyAsync(HomeAddress);

    private Task CopyOutsideAddressAsync() => CopyAsync(OutsideAddress);

    private async Task CopyAsync(string? address)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", address ?? string.Empty);
        Snackbar.Add("Address copied.", AppSeverity.Success);
    }

    private async Task TestAsync()
    {
        _testResult = null;
        _testing = true;
        _testDialogOpen = true;
        try
        {
            // Without an outside address only the home network can be checked.
            _testResult = OutsideAddress is null
                ? await ApiClient.TestLocalNetworkAsync()
                : await ApiClient.TestRemoteNetworkAsync();
        }
        finally
        {
            _testing = false;
        }
    }
}
