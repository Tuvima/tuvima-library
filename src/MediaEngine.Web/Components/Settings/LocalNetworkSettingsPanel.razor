@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient
@inject IAppToastService Snackbar

<div class="network-panel">
    <header class="network-panel__heading">
        <div><h3>Local Network Settings</h3><p>Configure how Tuvima Library works on your home network.</p></div>
    </header>

    <SettingsSectionPanel Title="Local network" Icon="@AppMaterialIcons.Outlined.Lan">
        <div class="network-setting-rows">
            <div class="network-setting-row">
                <div><strong>Server Port</strong><span>Port used by Tuvima Library for local connections.</span></div>
                <div class="network-setting-row__control"><code>@Settings.Local.Port</code><AppButton Label="Change Port" OnClick="OpenPortDialog" /></div>
            </div>
            <div class="network-setting-row">
                <div><strong>Network Interface</strong><span>Which network interface should Tuvima Library listen on.</span></div>
                <AppSelect T="string" Value="@InterfaceValue" ValueChanged="ChangeInterfaceAsync"
                           Label="Network interface" HideLabel="true" Options="@InterfaceOptions" />
            </div>
            <AppSwitchRow Label="Local Discovery"
                          Description="Allow other devices on your network to find Tuvima Library automatically."
                          Value="@Settings.Local.DiscoveryEnabled"
                          ValueChanged="ChangeDiscoveryAsync" />
            <div class="network-setting-row">
                <div><strong>Preferred Server Name</strong><span>Shown to devices on your local network.</span></div>
                <div class="network-server-name-control">
                    <AppTextField T="string" @bind-Value="Settings.Local.PreferredServerName" Label="Server name" HideLabel="true" />
                    <span>.local</span>
                    <AppButton Label="Save" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="SaveRequested" />
                </div>
            </div>
            <AppSwitchRow Label="IPv6 Support"
                          Description="Allow connections over IPv6 when the network supports it."
                          Value="@Settings.Local.Ipv6Enabled"
                          ValueChanged="ChangeIpv6Async" />
        </div>
    </SettingsSectionPanel>

    <SettingsSectionPanel Title="Local Connection" Icon="@AppMaterialIcons.Outlined.NetworkCheck">
        <dl class="network-facts network-facts--compact">
            @Fact("Status", Display(Status?.LocalAccess))
            @Fact("Local Address", Status?.PreferredLocalAddress ?? "Unavailable")
        </dl>
        <div class="network-card-actions">
            <AppButton Label="Test Local Connection" StartIcon="@AppMaterialIcons.Outlined.Science" OnClick="TestLocalAsync" />
        </div>
    </SettingsSectionPanel>

    <AppAlert Tone="AppUiTone.Info" Icon="@AppMaterialIcons.Outlined.Info">
        You can access Tuvima on your local network using the address above or @(Settings.Local.PreferredServerName).local where supported.
    </AppAlert>
</div>

<NetworkPortChangeDialog @bind-Visible="_portDialogOpen"
                         CurrentPort="@Settings.Local.Port"
                         Applied="PortAppliedAsync" />
<NetworkTestDialog @bind-Visible="_testDialogOpen" Busy="@_testing" Result="@_testResult" />

@code {
    [Parameter, EditorRequired] public NetworkSettingsDto Settings { get; set; } = new();
    [Parameter] public NetworkRuntimeStatusDto? Status { get; set; }
    [Parameter] public EventCallback SaveRequested { get; set; }
    [Parameter] public EventCallback StatusRefreshRequested { get; set; }

    private bool _portDialogOpen;
    private bool _testDialogOpen;
    private bool _testing;
    private NetworkTestResultDto? _testResult;

    private string InterfaceValue => Settings.Local.BindMode == "specific-interface"
        ? Settings.Local.InterfaceId ?? "automatic"
        : "automatic";

    private IReadOnlyList<AppSelectOption> InterfaceOptions =>
        [new("automatic", "Automatic — All Interfaces"),
         .. (Status?.LocalAddresses ?? []).GroupBy(address => address.InterfaceId)
             .Select(group => new AppSelectOption(group.Key, $"{group.First().InterfaceName} · {string.Join(", ", group.Select(address => address.Address))}"))];

    private void OpenPortDialog() => _portDialogOpen = true;

    private async Task ChangeInterfaceAsync(string? value)
    {
        Settings.Local.BindMode = value == "automatic" ? "automatic" : "specific-interface";
        Settings.Local.InterfaceId = value == "automatic" ? null : value;
        await SaveRequested.InvokeAsync();
    }

    private async Task ChangeDiscoveryAsync(bool value)
    {
        Settings.Local.DiscoveryEnabled = value;
        await SaveRequested.InvokeAsync();
    }

    private async Task ChangeIpv6Async(bool value)
    {
        Settings.Local.Ipv6Enabled = value;
        await SaveRequested.InvokeAsync();
    }

    private async Task PortAppliedAsync(PortAvailabilityResultDto result)
    {
        Settings.Local.Port = result.Port;
        _portDialogOpen = false;
        Snackbar.Add(result.Message, AppSeverity.Success);
        await StatusRefreshRequested.InvokeAsync();
    }

    private async Task TestLocalAsync()
    {
        _testDialogOpen = true;
        _testing = true;
        _testResult = await ApiClient.TestLocalNetworkAsync();
        _testing = false;
        await StatusRefreshRequested.InvokeAsync();
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value)
        ? "Unavailable"
        : string.Join(' ', value.Split('-', StringSplitOptions.RemoveEmptyEntries).Select(part => char.ToUpperInvariant(part[0]) + part[1..]));

    private static RenderFragment Fact(string label, string value) => @<div><dt>@label</dt><dd>@value</dd></div>;
}
