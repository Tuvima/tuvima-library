@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@inject IStringLocalizer<SharedStrings> L

<div class="network-panel">
    <SettingsSectionPanel Title="@L["LocalNetworkSettingsPanel_Address"].Value" Icon="@AppMaterialIcons.Outlined.Lan">
        <dl class="network-facts network-facts--compact">
            <div><dt>@L["LocalNetworkSettingsPanel_NameOnYourNetwork"]</dt><dd>@(Settings.Local.PreferredServerName).local</dd></div>
            <div><dt>@L["LocalNetworkSettingsPanel_LocalAddress"]</dt><dd>@(Status?.PreferredLocalAddress ?? "Unavailable")</dd></div>
        </dl>
        <p class="network-supporting-copy">@L["LocalNetworkSettingsPanel_NameIsEditedOn"] <a href="/settings/general">@L["LocalNetworkSettingsPanel_General"]</a>.</p>
        <div class="network-setting-rows">
            <AppSwitchRow Label="@L["LocalNetworkSettingsPanel_LetDevicesFindLibraryByName"].Value"
                          Description="@L["LocalNetworkSettingsPanel_AllowOtherDevicesOnYour"].Value"
                          Value="@Settings.Local.DiscoveryEnabled"
                          ValueChanged="ChangeDiscoveryAsync" />
        </div>
    </SettingsSectionPanel>
</div>

@code {
    [Parameter, EditorRequired] public NetworkSettingsDto Settings { get; set; } = new();
    [Parameter] public NetworkRuntimeStatusDto? Status { get; set; }
    [Parameter] public EventCallback SaveRequested { get; set; }

    private async Task ChangeDiscoveryAsync(bool value)
    {
        Settings.Local.DiscoveryEnabled = value;
        await SaveRequested.InvokeAsync();
    }
}
