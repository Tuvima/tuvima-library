@namespace MediaEngine.Web.Components.Settings
@inject IStringLocalizer<SharedStrings> L

@* System > Configuration: a language and region panel, then two headed groups on one page, in the order people reach for them. *@
<div class="configuration-page" data-testid="configuration-page">
    <LanguageRegionPanel />

    <section class="configuration-page__group" aria-labelledby="configuration-tools-heading">
        <h2 id="configuration-tools-heading" class="configuration-page__heading">@L["Common_ToolsAndRequirements"]</h2>
        <ToolsRequirementsTab />
    </section>

    <section class="configuration-page__group" aria-labelledby="configuration-notifications-heading">
        <h2 id="configuration-notifications-heading" class="configuration-page__heading">@L["Common_Notifications"]</h2>
        <NotificationsPanel />
    </section>
</div>
