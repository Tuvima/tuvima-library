@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient
@inject IAppToastService Snackbar

<div class="network-panel network-advanced">
    <details class="network-advanced-card">
        <summary><span class="network-advanced-card__icon"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.SettingsEthernet" /></span><span><strong>Ports &amp; Binding</strong><small>Inspect the local Dashboard listener and address binding.</small></span><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" /></summary>
        <div class="network-advanced-card__body">
            <dl class="network-facts">
                @Fact("Dashboard HTTP port", Settings.Local.Port.ToString())
                @Fact("Binding", Settings.Local.BindMode == "automatic" ? "Automatic — All Interfaces" : Settings.Local.InterfaceId ?? "Selected interface unavailable")
                @Fact("IPv4", "Automatic")
                @Fact("IPv6", Settings.Local.Ipv6Enabled ? "Enabled when available" : "Disabled")
            </dl>
        </div>
    </details>

    <details class="network-advanced-card">
        <summary><span class="network-advanced-card__icon"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Router" /></span><span><strong>Port Forwarding &amp; Router Mapping</strong><small>Advanced direct access through your own local TLS reverse proxy.</small></span><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" /></summary>
        <div class="network-advanced-card__body network-advanced-fields">
            <AppAlert Tone="AppUiTone.Warning">PCP, NAT-PMP, and UPnP are never enabled by default. Tuvima Library maps only the HTTPS reverse-proxy port below and never maps its Dashboard HTTP listener directly.</AppAlert>
            <dl class="network-facts">
                @Fact("Topology", Display(Status?.Topology))
                @Fact("Observed gateway", Status?.RouterGateway ?? "Not detected")
                @Fact("Mapping state", Display(Status?.MappingStatus))
                @Fact("Selected method", Status?.RouterMethod ?? "None")
                @Fact("Lease expires", Status?.MappingExpiresAt?.ToLocalTime().ToString("g") ?? "Not active")
                @Fact("Public address", Status?.PublicIp ?? "Not observed")
            </dl>
            <p class="network-supporting-copy">@(Status?.TopologyDetail ?? "Topology has not been inspected.")</p>
            <p class="network-supporting-copy">@(Status?.MappingDetail ?? "Router mapping has not been attempted.")</p>

            <AppTextField T="string" @bind-Value="Settings.Remote.PublicHostname" Label="Public HTTPS address" Placeholder="https://tuvima.example.com" />
            <AppTextField T="string" @bind-Value="_tlsPortText" Label="Local TLS reverse-proxy port" HelpText="The local Caddy/nginx/Traefik HTTPS listener. Never use the Dashboard HTTP port." />
            <AppTextField T="string" @bind-Value="_externalPortText" Label="External HTTPS port" HelpText="Normally 443." />
            <AppSwitchRow Label="Manage router mapping automatically"
                          Description="Try PCP, NAT-PMP, then UPnP for the explicitly configured TLS listener."
                          Value="@Settings.Remote.AutomaticRouterConfiguration"
                          ValueChanged="ChangeRouterAutomationAsync" />
            <AppSwitchRow Label="Enable direct remote access"
                          Description="Available only after authentication, topology, the TLS listener, and the public HTTPS route are verified."
                          Value="@DirectRemoteEnabled"
                          ValueChanged="ChangeDirectEnabledAsync" />
            <div class="network-card-actions">
                <AppButton Label="Save direct settings" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="SaveRouterSettingsAsync" />
                <AppButton Label="Set up manually" StartIcon="@AppMaterialIcons.Outlined.Tune" OnClick="OpenManual" />
                <AppButton Label="Renew now" StartIcon="@AppMaterialIcons.Outlined.Refresh" OnClick="RenewAsync" />
            </div>
        </div>
    </details>

    <details class="network-advanced-card">
        <summary><span class="network-advanced-card__icon"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Language" /></span><span><strong>Reverse Proxy Trust</strong><small>Accept forwarded client and HTTPS information only from known proxy peers.</small></span><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" /></summary>
        <div class="network-advanced-card__body network-advanced-fields">
            <AppTextField T="string" @bind-Value="_trustedProxyText" Label="Trusted proxy addresses" HelpText="Comma-separated exact IP addresses." />
            <AppTextField T="string" @bind-Value="_trustedProxyNetworkText" Label="Trusted proxy networks" HelpText="Comma-separated CIDR ranges for isolated Docker proxy networks, for example 172.21.0.0/24." />
            <AppAlert Tone="AppUiTone.Info">Forwarded headers from every other peer are ignored. A Dashboard restart applies proxy trust changes.</AppAlert>
            <AppButton Label="Save proxy trust" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="SaveProxySettingsAsync" />
        </div>
    </details>

    <details class="network-advanced-card">
        <summary><span class="network-advanced-card__icon"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Science" /></span><span><strong>Diagnostics</strong><small>Observed network facts without assuming public reachability.</small></span><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" /></summary>
        <div class="network-advanced-card__body">
            <dl class="network-facts">
                @Fact("IPv6 available", Status?.Ipv6Available == true ? "Yes" : "No")
                @Fact("CGNAT suspected", Status?.CgnatSuspected == true ? "Yes — port forwarding may not work" : "No evidence observed")
                @Fact("Last connection test", Status?.LastTestedAt?.ToLocalTime().ToString("g") ?? "Not tested")
                @Fact("External verification", Status?.LastTestSucceeded == true ? "Passed" : Status?.LastTestSucceeded == false ? "Failed" : "Unknown")
            </dl>
        </div>
    </details>

    <AppAlert Tone="AppUiTone.Warning" Icon="@AppMaterialIcons.Outlined.WarningAmber" Class="network-advanced-warning">
        <strong>Advanced settings are intended for experienced administrators.</strong>
        <span>Tailscale or a documented reverse proxy is the supported default for remote access.</span>
    </AppAlert>

    <div class="network-danger-row">
        <div><strong>Reset Network Settings</strong><span>Restore local-first defaults and turn off remote access.</span></div>
        <AppButton Label="Reset Network Settings" Tone="AppUiTone.Error" OnClick="OpenReset" />
    </div>
</div>

<ManualPortForwardingDialog @bind-Visible="_manualDialogOpen"
                            InternalPort="@(Settings.Remote.TlsTerminationPort ?? 443)"
                            ExternalPort="@(Settings.Remote.ExternalPort ?? 443)"
                            InternalAddress="@InternalAddress"
                            CgnatSuspected="@(Status?.CgnatSuspected == true)"
                            TestAgain="TestRemoteAsync" />

<AppDialog @bind-Visible="_resetDialogOpen"
           Title="Reset network settings?"
           Subtitle="This turns off remote access and removes custom network configuration. Other Tuvima Library settings are not affected."
           Icon="@AppMaterialIcons.Outlined.Restore"
           Size="Medium">
    <ChildContent><AppAlert Tone="AppUiTone.Warning">Tuvima Library will attempt to remove any automatic mapping it owns during reconciliation or shutdown.</AppAlert></ChildContent>
    <FooterContent>
        <AppButton Label="Cancel" OnClick="CloseReset" />
        <AppButton Label="Reset Network Settings" Tone="AppUiTone.Error" ButtonStyle="AppButtonStyle.Filled" OnClick="ResetAsync" />
    </FooterContent>
</AppDialog>

@code {
    [Parameter, EditorRequired] public NetworkSettingsDto Settings { get; set; } = new();
    [Parameter] public NetworkRuntimeStatusDto? Status { get; set; }
    [Parameter] public EventCallback SaveRequested { get; set; }
    [Parameter] public EventCallback<NetworkSettingsDto> SettingsReplaced { get; set; }
    [Parameter] public EventCallback StatusRefreshRequested { get; set; }

    private bool _resetDialogOpen;
    private bool _manualDialogOpen;
    private string? _trustedProxyText;
    private string? _trustedProxyNetworkText;
    private string? _tlsPortText;
    private string? _externalPortText;

    private bool DirectRemoteEnabled => Settings.WhoCanConnect == "anywhere" && Settings.Remote.ConnectionMode == "direct-only";
    private string InternalAddress => Status?.LocalAddresses.FirstOrDefault(address => address.AddressFamily == "ipv4")?.Address
        ?? Status?.LocalAddresses.FirstOrDefault()?.Address
        ?? "Unavailable";

    protected override void OnParametersSet()
    {
        _trustedProxyText ??= string.Join(", ", Settings.Remote.TrustedProxies);
        _trustedProxyNetworkText ??= string.Join(", ", Settings.Remote.TrustedProxyNetworks);
        _tlsPortText ??= (Settings.Remote.TlsTerminationPort ?? 443).ToString();
        _externalPortText ??= (Settings.Remote.ExternalPort ?? 443).ToString();
    }

    private async Task ChangeRouterAutomationAsync(bool value)
    {
        if (Settings.WhoCanConnect == "anywhere")
            Settings.WhoCanConnect = "home_network";
        Settings.Remote.ConnectionMode = "direct-only";
        Settings.Remote.AutomaticRouterConfiguration = value;
        if (value && !ApplyPortText())
            return;
        await SaveRequested.InvokeAsync();
    }

    private async Task SaveRouterSettingsAsync()
    {
        if (!ApplyPortText())
            return;
        if (Settings.WhoCanConnect == "anywhere")
            Settings.WhoCanConnect = "home_network";
        Settings.Remote.ConnectionMode = "direct-only";
        await SaveRequested.InvokeAsync();
    }

    private bool ApplyPortText()
    {
        if (!int.TryParse(_tlsPortText, out var tlsPort) || tlsPort is < 1 or > 65535
            || !int.TryParse(_externalPortText, out var externalPort) || externalPort is < 1 or > 65535)
        {
            Snackbar.Add("TLS and external ports must be between 1 and 65535.", AppSeverity.Warning);
            return false;
        }
        Settings.Remote.TlsTerminationPort = tlsPort;
        Settings.Remote.ExternalPort = externalPort;
        return true;
    }

    private async Task ChangeDirectEnabledAsync(bool value)
    {
        if (value)
        {
            var readiness = await ApiClient.GetRemoteAccessReadinessAsync();
            if (readiness?.Ready != true)
            {
                Snackbar.Add("Direct remote access remains off until every security check passes.", AppSeverity.Warning);
                return;
            }
        }
        Settings.WhoCanConnect = value ? "anywhere" : (Settings.WhoCanConnect == "anywhere" ? "home_network" : Settings.WhoCanConnect);
        await SaveRequested.InvokeAsync();
    }

    private async Task SaveProxySettingsAsync()
    {
        Settings.Remote.TrustedProxies = Split(_trustedProxyText);
        Settings.Remote.TrustedProxyNetworks = Split(_trustedProxyNetworkText);
        await SaveRequested.InvokeAsync();
    }

    private async Task RenewAsync()
    {
        await ApiClient.RenewNetworkRouterMappingAsync();
        await StatusRefreshRequested.InvokeAsync();
        Snackbar.Add("Router mapping reconciliation completed.", AppSeverity.Info);
    }

    private async Task TestRemoteAsync() => _ = await ApiClient.TestRemoteNetworkAsync();
    private void OpenManual() => _manualDialogOpen = true;
    private void OpenReset() => _resetDialogOpen = true;
    private void CloseReset() => _resetDialogOpen = false;

    private async Task ResetAsync()
    {
        var replacement = await ApiClient.ResetNetworkSettingsAsync();
        if (replacement is null)
        {
            Snackbar.Add("Network settings could not be reset.", AppSeverity.Error);
            return;
        }
        _resetDialogOpen = false;
        Snackbar.Add("Network settings reset. Remote access is off.", AppSeverity.Success);
        await SettingsReplaced.InvokeAsync(replacement);
    }

    private static List<string> Split(string? value) => (value ?? string.Empty)
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value)
        ? "Unavailable"
        : string.Join(' ', value.Split('-', StringSplitOptions.RemoveEmptyEntries).Select(part => char.ToUpperInvariant(part[0]) + part[1..]));

    private static RenderFragment Fact(string label, string value) => @<div><dt>@label</dt><dd>@value</dd></div>;
}
