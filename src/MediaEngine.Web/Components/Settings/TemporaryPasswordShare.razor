@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Services.Ui
@inject IStringLocalizer<SharedStrings> L

<AppAlert Severity="AppSeverity.Success" Class="access-invitation">
    @if (MustChange)
    {
        <strong>@L["TemporaryPasswordShare_TemporaryPasswordSet"]</strong>
        <span>@L["TemporaryPasswordShare_GiveItToThemNow"]</span>
    }
    else
    {
        <strong>@L["TemporaryPasswordShare_PasswordSet"]</strong>
        <span>@L["TemporaryPasswordShare_GiveItToThemNow2"]</span>
    }
    <code>@Password</code>
    <AppCopyButton Label="@L["TemporaryPasswordShare_CopyPassword"].Value" Text="@Password" What="the password" Size="AppControlSize.Compact" CopyFailed="ShowCopyFailure" />
    @if (MustChange && ExpiresAt is { } expires)
    {
        <small>Stops working @expires.ToLocalTime().ToString("g") if it hasn't been used.</small>
    }
    @if (_copyFailure is not null)
    {
        <small role="alert" data-copy-failure>@_copyFailure</small>
    }
</AppAlert>

@code {
    [Parameter, EditorRequired] public string Password { get; set; } = string.Empty;
    [Parameter] public DateTimeOffset? ExpiresAt { get; set; }

    /// <summary>True (the default) for a temporary password they replace at first sign-in; false for an ordinary password.</summary>
    [Parameter] public bool MustChange { get; set; } = true;

    private string? _copyFailure;

    // A copy the browser refused is told here, beside the button, for as long as the password is shown.
    private void ShowCopyFailure(string message) => _copyFailure = message;
}
