@namespace MediaEngine.Web.Components.Settings
@inject IJSRuntime JS
@inject IAppToastService Toast
@inject ILogger<TemporaryPasswordShare> Logger
@using MediaEngine.Web.Services.Ui

<AppAlert Severity="AppSeverity.Success" Class="access-invitation">
    @if (MustChange)
    {
        <strong>Temporary password set.</strong>
        <span>Give it to them now. It won't be shown again, and they will be asked to choose their own password the first time they sign in.</span>
    }
    else
    {
        <strong>Password set.</strong>
        <span>Give it to them now. It won't be shown again. They can change it any time from their Security settings.</span>
    }
    <code>@Password</code>
    <AppButton Label="Copy password" Size="AppControlSize.Compact" StartIcon="@AppMaterialIcons.Outlined.ContentCopy" OnClick="CopyAsync" />
    @if (MustChange && ExpiresAt is { } expires)
    {
        <small>Stops working @expires.ToLocalTime().ToString("g") if it hasn't been used.</small>
    }
</AppAlert>

@code {
    [Parameter, EditorRequired] public string Password { get; set; } = string.Empty;
    [Parameter] public DateTimeOffset? ExpiresAt { get; set; }

    /// <summary>True (the default) for a temporary password they replace at first sign-in; false for an ordinary password.</summary>
    [Parameter] public bool MustChange { get; set; } = true;

    private async Task CopyAsync()
    {
        switch (await JS.TryCopyAsync(Password, Logger))
        {
            case ClipboardCopyResult.Copied:
                Toast.Add("Password copied.", AppSeverity.Success);
                break;
            case ClipboardCopyResult.Failed:
                Toast.Add(ClipboardInterop.FailedMessage("the password"), AppSeverity.Warning);
                break;
        }
    }
}
