@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Services.Navigation
@implements IDisposable
@inject SettingsAttentionState Attention

@* The permanent notice at the top of every Local AI page. It cannot be dismissed and lasts exactly as long as the
   problem: Local AI is off until the tools and libraries it needs are downloaded. Download starts the same downloads
   the Tools page offers for the missing models; what the Library cannot fetch itself is left to the Tools page. It reads
   the shared attention state, so it agrees with the red "Off" in the Settings menu. *@
@if (Attention.IsServerAdministrator && Attention.LocalAiBlocked)
{
    var downloadingNow = Attention.LocalAiBlockers.Where(tool => tool.State == ToolRequirementStates.Downloading).ToList();
    <SettingsNoticeBubble NoticeKey="local-ai-off"
                          Tone="AppUiTone.Error"
                          Icon="@AppMaterialIcons.Outlined.ErrorOutline"
                          Message="Local AI is switched off until the tools and libraries it needs are downloaded."
                          Detail="@Attention.ActionError">
        <Actions>
            @if (Attention.LocalAiBlockers.Any(SettingsAttentionState.IsDownloadableModel))
            {
                <AppButton Label="Download" StartIcon="@AppMaterialIcons.Outlined.Download" Size="AppControlSize.Compact"
                           Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@Attention.IsWorking"
                           OnClick="@(() => Attention.DownloadLocalAiAsync())" />
            }
            else if (downloadingNow.Count > 0)
            {
                <span>Downloading @((int)Math.Round(downloadingNow.Average(tool => tool.DownloadPercent ?? 0)))%</span>
            }
            else
            {
                <AppButton Label="See tools" Href="@SettingsNav.RouteFor(SettingsSection.Tools)" Size="AppControlSize.Compact"
                           Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" />
            }
        </Actions>
    </SettingsNoticeBubble>
}

@code {
    protected override void OnInitialized() => Attention.Changed += OnAttentionChanged;

    private void OnAttentionChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Attention.Changed -= OnAttentionChanged;
}
