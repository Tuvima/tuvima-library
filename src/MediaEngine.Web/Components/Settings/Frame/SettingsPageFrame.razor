@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Components.Shared.Shell
@implements IDisposable
@inject IStringLocalizer<SharedStrings> L

@* The one frame every Settings page sits in: administrator notices, title and one-line description,
   an optional permanent page notice, optional in-page tabs, then the page content. Everything shares one left
   edge and one width, so pages never set their own outer width, margin or padding. *@
<div class="settings-frame" data-settings-frame>
    @if (Notices is not null)
    {
        <div class="settings-frame__notices" data-settings-frame-slot="notices">@Notices</div>
    }

    <div class="settings-frame__header" data-settings-frame-slot="header">
        @if (!string.IsNullOrWhiteSpace(BackHref))
        {
            @* A page below a Settings page (one plugin, one person, one library folder) keeps one link back to its parent.
               This is not a breadcrumb: the menu already says where you are (settings-alignment D1). *@
            <a class="settings-frame__back" href="@BackHref" data-testid="settings-back-link">
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronLeft" aria-hidden="true" />
                <span>@BackLabel</span>
            </a>
        }

        <SidebarPageHeader Title="@Title" Subtitle="@Description" Actions="@_headerActions.Content" />
    </div>

    @if (PageNotice is not null)
    {
        <div class="settings-frame__page-notice" data-settings-frame-slot="page-notice">@PageNotice</div>
    }

    @if (Tabs is not null)
    {
        <div class="settings-frame__tabs" data-settings-frame-slot="tabs">@Tabs</div>
    }

    <div class="settings-frame__content" data-settings-frame-slot="content">
        @if (AdvancedWarning)
        {
            @* The one warning every Advanced tab opens with (settings-and-setup-simplified D1). *@
            <AppAlert Severity="AppSeverity.Warning"
                      Variant="AppVariant.Outlined"
                      Dense="true"
                      Class="tl-sp-mb-4"
                      data-testid="settings-advanced-warning">@L["SettingsPageFrame_AdvancedWarning"]</AppAlert>
        }
        <CascadingValue Value="_headerActions" IsFixed="true">@ChildContent</CascadingValue>
    </div>
</div>

@code {
    // A page inside the frame may put one action at the top right of the header (Libraries' Add library).
    private readonly SettingsHeaderActions _headerActions = new();

    protected override void OnInitialized() => _headerActions.Changed += OnHeaderActionsChanged;

    private void OnHeaderActionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => _headerActions.Changed -= OnHeaderActionsChanged;

    /// <summary>Administrator attention lines drawn above the breadcrumb. Nothing is drawn when null.</summary>
    [Parameter] public RenderFragment? Notices { get; set; }

    /// <summary>For a page below a Settings page: where "back" goes. No back link is drawn when null.</summary>
    [Parameter] public string? BackHref { get; set; }

    /// <summary>The parent page's name, shown beside the back arrow.</summary>
    [Parameter] public string? BackLabel { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>One line under the title.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>A permanent notice for this page that cannot be dismissed while the problem lasts. Nothing is drawn when null.</summary>
    [Parameter] public RenderFragment? PageNotice { get; set; }

    /// <summary>Tabs for sections inside this one page. Nothing is drawn when null.</summary>
    [Parameter] public RenderFragment? Tabs { get; set; }

    /// <summary>Draws the Advanced warning line first in the content: set while a page's Advanced tab is open.</summary>
    [Parameter] public bool AdvancedWarning { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
