@namespace MediaEngine.Web.Components.Settings
@inject UIOrchestratorService Orchestrator
@inject IAppToastService Snackbar
<AppDrawer Open="@Open"
           OpenChanged="@OnOpenChangedHandler"
           Anchor="AppAnchor.End"
           Width="480px"
           Overlay="true"
           Variant="AppDrawerVariant.Temporary"
           Class="curators-drawer">
<AppStack Row="true" AlignItems="AppAlignItems.Center" Class="pa-4">
        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.EditNote" Color="AppColor.Primary" Class="mr-2" />
        <AppText Typo="AppTypo.h6" Class="tl-u-flex-1">Correct Metadata</AppText>
        <AppIconButton Icon="@AppMaterialIcons.Filled.Close"
                       Tone="AppUiTone.Neutral"
                       Size="AppControlSize.Compact"
                       OnClick="@CloseDrawer" />
    </AppStack>

    <AppDivider Class="mb-2" />
@if (EntityId != Guid.Empty)
    {
        <AppPanel Elevation="0" Class="tl-card mx-4 mb-4">
            <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">Currently editing</AppText>
            <AppText Typo="AppTypo.subtitle1" Class="tl-u-font-weight-600">@CurrentTitle</AppText>
        </AppPanel>
    }
<div class="px-4 mb-4">
        <AppTextField @bind-Value="_query"
                      Label="Search by title, ISBN, or Wikidata ID"
                      Variant="AppVariant.Outlined"
                      Adornment="AppAdornment.Start"
                      AdornmentIcon="@AppMaterialIcons.Filled.Search"
                      FullWidth="true"
                      Immediate="true"
                      DebounceInterval="400"
                      OnDebounceIntervalElapsed="@SearchAsync"
                      Margin="AppMargin.Dense" />
    </div>
@if (_searching)
    {
        <AppProgressBar Indeterminate="true" Color="AppColor.Primary" Class="mx-4 mb-2" />
    }
    else if (_results.Count > 0)
    {
        <div class="px-4 tl-u-overflow-y-auto tl-u-max-height-calc-100vh---400px" >
            @foreach (var r in _results)
            {
                bool isSelected = _selectedResult?.WorkId == r.WorkId;
                <AppPanel Elevation="0"
                          Class="@($"mb-2 cursor-pointer curator-result-card {(isSelected ? "curator-result-card--selected" : null)}")"
                          OnClick="@(() => SelectResult(r))">
                    <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="2">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Filled.MenuBook"
                                 Color="AppColor.Primary" Size="AppSize.Small" />
                        <div class="tl-u-min-width-0 tl-u-flex-1">
                            <AppText Typo="AppTypo.subtitle2" Class="tl-u-font-weight-600">
                                @r.Title
                            </AppText>
                            @if (!string.IsNullOrEmpty(r.Author))
                            {
                                <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">
                                    @r.Author
                                </AppText>
                            }
                        </div>
                        <AppChip T="string" Size="AppSize.Small" Variant="AppVariant.Outlined">
                            @r.MediaType
                        </AppChip>
                    </AppStack>
                    @if (!string.IsNullOrEmpty(r.CollectionDisplayName))
                    {
                        <AppText Typo="AppTypo.caption" Color="AppColor.Secondary" Class="mt-1">
                            Collection: @r.CollectionDisplayName
                        </AppText>
                    }
                </AppPanel>
            }
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_query) && _query.Length >= 2 && !_searching)
    {
        <AppText Typo="AppTypo.body2" Color="AppColor.Secondary" Class="px-4">
            No results found for "@_query".
        </AppText>
    }
@if (_selectedResult is not null)
    {
        <AppDivider Class="my-3" />
        <AppPanel Elevation="0" Class="tl-card mx-4 mb-2">
            <AppText Typo="AppTypo.caption" Color="AppColor.Secondary" Class="mb-1">
                New values from selected candidate:
            </AppText>
            <AppStack Spacing="1">
                <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="2">
                    <AppText Typo="AppTypo.caption" Color="AppColor.Secondary" Class="tl-u-min-width-60px">
                        Title:
                    </AppText>
                    <AppText Typo="AppTypo.body2" Class="tl-u-font-weight-600">
                        @_selectedResult.Title
                    </AppText>
                </AppStack>
                @if (!string.IsNullOrEmpty(_selectedResult.Author))
                {
                    <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="2">
                        <AppText Typo="AppTypo.caption" Color="AppColor.Secondary" Class="tl-u-min-width-60px">
                            Author:
                        </AppText>
                        <AppText Typo="AppTypo.body2" Class="tl-u-font-weight-600">
                            @_selectedResult.Author
                        </AppText>
                    </AppStack>
                }
            </AppStack>
        </AppPanel>

        <div class="px-4 mb-4">
            <AppButton ButtonStyle="AppButtonStyle.Filled"
                       Tone="AppUiTone.Primary"
                       FullWidth="true"
                       StartIcon="@AppMaterialIcons.Filled.Lock"
                       OnClick="@ApplyCorrectionAsync"
                       Disabled="@_applying">
                @(_applying ? "Applying..." : "Apply Correction")
            </AppButton>
        </div>
    }
@if (EntityId != Guid.Empty)
    {
        <AppDivider Class="my-2" />
        <AppExpansionPanels Elevation="0" Class="px-4 mb-4">
            <AppExpansionPanel Text="Claim History"
                               Class="tl-u-background-transparent"
                               Expanded="false">
                @if (_claimsLoading)
                {
                    <AppProgressBar Indeterminate="true" Color="AppColor.Primary" Class="mb-2" />
                }
                else if (_claims.Count == 0)
                {
                    <AppText Typo="AppTypo.body2" Color="AppColor.Secondary">
                        No claims recorded for this entity.
                    </AppText>
                }
                else
                {
                    @foreach (var claim in _claims)
                    {
                        <AppPanel Elevation="0" Class="tl-card tl-card--compact mb-1">
                            <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="2">
                                <AppChip T="string" Size="AppSize.Small"
                                         Color="@(claim.IsUserLocked ? AppColor.Warning : AppColor.Default)"
                                         Variant="AppVariant.Outlined">
                                    @claim.ClaimKey
                                </AppChip>
                                <AppText Typo="AppTypo.body2" Class="tl-u-flex-1 tl-u-min-width-0 tl-u-overflow-hidden tl-u-text-overflow-ellipsis">
                                    @claim.ClaimValue
                                </AppText>
                                <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">
                                    @claim.Confidence.ToString("P0")
                                </AppText>
                                @if (claim.IsUserLocked)
                                {
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Lock"
                                             Size="AppSize.Small" Color="AppColor.Warning" />
                                }
                            </AppStack>
                        </AppPanel>
                    }
                }
            </AppExpansionPanel>
        </AppExpansionPanels>
    }

</AppDrawer>

@code {

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public Guid EntityId { get; set; }
    [Parameter] public string CurrentTitle { get; set; } = string.Empty;
    [Parameter] public EventCallback OnCorrected { get; set; }

    private string                     _query          = string.Empty;
    private bool                       _searching;
    private List<SearchResultDto> _results        = [];
    private SearchResultDto?     _selectedResult;
    private bool                       _applying;
    private bool                       _claimsLoading;
    private List<ClaimDto>             _claims         = [];

    protected override async Task OnParametersSetAsync()
    {
        if (Open && EntityId != Guid.Empty)
        {
            await LoadClaimHistoryAsync();
        }
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query) || _query.Length < 2)
        {
            _results = [];
            _selectedResult = null;
            return;
        }

        _searching = true;
        _results = await Orchestrator.SearchWorksAsync(_query);
        _searching = false;
    }

    private void SelectResult(SearchResultDto result)
    {
        _selectedResult = result;
    }

    private async Task ApplyCorrectionAsync()
    {
        if (_selectedResult is null || EntityId == Guid.Empty) return;
        _applying = true;
        var titleOk = await Orchestrator.LockClaimAsync(
            EntityId, "title", _selectedResult.Title);
        bool authorOk = true;
        if (!string.IsNullOrEmpty(_selectedResult.Author))
        {
            authorOk = await Orchestrator.LockClaimAsync(
                EntityId, "author", _selectedResult.Author);
        }

        _applying = false;

        if (titleOk && authorOk)
        {
            Snackbar.Add("Metadata corrected - user-locked claims applied.", AppSeverity.Success);
            _selectedResult = null;
            _query = string.Empty;
            _results = [];
            await LoadClaimHistoryAsync();
            await OnCorrected.InvokeAsync();
        }
        else
        {
            Snackbar.Add("Could not apply correction - is the Engine running?", AppSeverity.Error);
        }
    }

    private async Task LoadClaimHistoryAsync()
    {
        if (EntityId == Guid.Empty) return;
        _claimsLoading = true;
        _claims = await Orchestrator.GetClaimHistoryAsync(EntityId);
        _claimsLoading = false;
    }

    private async Task CloseDrawer()
    {
        Open = false;
        await OpenChanged.InvokeAsync(false);
        ResetState();
    }

    private async Task OnOpenChangedHandler(bool open)
    {
        Open = open;
        await OpenChanged.InvokeAsync(open);
        if (!open) ResetState();
    }

    private void ResetState()
    {
        _query          = string.Empty;
        _results        = [];
        _selectedResult = null;
        _applying       = false;
    }
}
