@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Settings
@inject DashboardIdentityClient Identity
@inject ApprovalFlow Approvals
@inject DashboardSessionAccessor Session
@inject DeviceContextService DeviceContext
@inject NavigationManager Navigation
@implements IDisposable
@inject IStringLocalizer<SharedStrings> L

<div class="access-page">
    @if (!CanManage)
    {
        <AppAlert Severity="AppSeverity.Warning">@L["ManagedAccessApplications_AdministratorAccessIsRequiredTo"]</AppAlert>
    }
    else if (!string.IsNullOrWhiteSpace(IntegrationId))
    {
        @IntegrationPage()
    }
    else if (_wizard)
    {
        <NewIntegrationWizard Permissions="@_permissions" Presets="@_presets" OnFinished="WizardFinishedAsync" />
    }
    else
    {
        @if (!DeviceContext.IsPhone)
        {
            <AppListPageHeader>
                <Actions>
                    <span @ref="_returnFocus" tabindex="-1"><AppButton Label="@L["Common_NewIntegration"].Value" StartIcon="@AppMaterialIcons.Outlined.Add" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" OnClick="NewApplication" /></span>
                </Actions>
            </AppListPageHeader>
        }
        @if (DeviceContext.IsPhone)
        {
            <p class="access-phone-note" role="note">@L["Common_ManageOnAComputerOr"]</p>
        }
        @if (!string.IsNullOrWhiteSpace(_notice)) { <AppAlert Severity="AppSeverity.Success" Class="access-notice">@_notice</AppAlert> }
        <AppSummaryStrip AriaLabel="@L["ManagedAccessApplications_IntegrationSummary"].Value" Loading="@_loading" Items="@SummaryItems()" />
        @if (_loading) { <AppProgressBar Indeterminate="true" aria-label="@L["ManagedAccessApplications_LoadingApplications"].Value" /> }
        else if (_applications.Count == 0)
        {
            <AppEmptyState Title="@L["ManagedAccessApplications_NoIntegrations"].Value" Message="@L["ManagedAccessApplications_ConnectAnotherApplicationSecurelyTo"].Value">
                <Action>
                    @if (!DeviceContext.IsPhone)
                    {
                        <AppButton Label="@L["Common_NewIntegration"].Value" StartIcon="@AppMaterialIcons.Outlined.Add" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" OnClick="NewApplication" />
                    }
                </Action>
            </AppEmptyState>
        }
        else
        {
            @if (!DeviceContext.IsPhone)
            {
                <AppSearchFilterRow Search="@_search" SearchChanged="@(value => Narrow(() => _search = value))" Placeholder="@L["ManagedAccessApplications_SearchIntegrationsByName"].Value"
                                    Narrowed="@Narrowed" OnClear="@ClearFilters">
                    <AppSelect Label="@L["Models_Status"].Value" Value="@_statusFilter" Options="@StatusOptions" Native="true" FullWidth="false"
                               ValueChanged="@(value => Narrow(() => _statusFilter = value ?? "all"))" />
                    <AppSelect Label="@L["Common_Access"].Value" Value="@_accessFilter" Options="@AccessOptions()" Native="true" FullWidth="false"
                               ValueChanged="@(value => Narrow(() => _accessFilter = value ?? "all"))" />
                    <AppLayoutSwitch StorageKey="tuvima.integrations.layout" Value="@_layout" ValueChanged="@(value => _layout = value)" AriaLabel="@L["ManagedAccessApplications_IntegrationsLayout"].Value" />
                </AppSearchFilterRow>
            }
            <AppCountTabs Tabs="@KindTabs()" Selected="@_kindTab" AriaLabel="@L["ManagedAccessApplications_IntegrationKinds"].Value" SelectedChanged="@(key => Narrow(() => _kindTab = key))" />
            var visible = VisibleApplications();
            _page = Math.Clamp(_page, 1, Math.Max(1, (int)Math.Ceiling(visible.Count / (double)PageSize)));
            @if (visible.Count == 0)
            {
                @if (Narrowed)
                {
                    <AppEmptyState Title="@L["ManagedAccessApplications_NoIntegrationsMatch"].Value" Message="@L["ManagedAccessApplications_NothingConnectedFitsThatSearch"].Value">
                        <Action><AppButton Label="@L["Common_ClearFilters"].Value" Size="AppControlSize.Compact" OnClick="@ClearFilters" /></Action>
                    </AppEmptyState>
                }
                else
                {
                    <AppEmptyState Title="@L["ManagedAccessApplications_NothingInThisCategoryYet"].Value" Message="@L["ManagedAccessApplications_IntegrationsOfThisKindWill"].Value" />
                }
            }
            else
            {
                @if (_layout == AppLayoutSwitch.List && !DeviceContext.IsPhone)
                {
                    @IntegrationRows(visible.Skip((_page - 1) * PageSize).Take(PageSize).ToList())
                }
                else
                {
                    <div class="app-card-grid access-cards" role="list">
                        @foreach (var app in visible.Skip((_page - 1) * PageSize).Take(PageSize))
                        {
                            <div role="listitem" @key="app.Id">@IntegrationCard(app)</div>
                        }
                    </div>
                }
                <AppPager Total="@visible.Count" PageSize="@PageSize" Page="@_page" PageChanged="@(page => _page = page)" Noun="integrations" />
            }
        }
    }
</div>

@code {
    /// <summary>The integration whose own page is open (<c>/settings/integrations/{id}</c>); null shows the list.</summary>
    [Parameter] public string? IntegrationId { get; set; }

    /// <summary>The open tab of the integration's page: access, keys, deliveries or activity; anything else is Overview.</summary>
    [Parameter] public string? DetailTab { get; set; }

    /// <summary>Tells the Settings page the integration's name for its breadcrumb.</summary>
    [Parameter] public EventCallback<string> NameChanged { get; set; }

    private string _layout = AppLayoutSwitch.Cards;
    private string? _appliedId;
    private List<ApplicationResponse> _applications = [];
    private List<ApplicationPermissionDefinitionDto> _permissions = [];
    private List<ApplicationPermissionPresetDto> _presets = [];
    private HashSet<string> _selected = new(StringComparer.Ordinal);
    private ApplicationResponse? _editing;
        private ApplicationTypeDto _type = ApplicationTypeDto.UserClient;
    private bool _loading = true;
    private bool _open;
    private bool _saving;
    private bool _enabled = true;
    private bool _administrator;
    private bool _deleteMode;
    private long _drawerGeneration;
    private string _name = string.Empty;
    private string _description = string.Empty;
    private string _clientIds = string.Empty;
    private string _credentialName = "Credential";

    // A new key suggests a year, because a key that never expires is easy to forget about (spec D-W). "Never" stays available.
    private const string SuggestedExpiry = "year";
    private string _credentialExpiry = SuggestedExpiry;
    private static readonly IReadOnlyList<AppSelectOption> ExpiryOptions =
    [
        new("year", "In 1 year (suggested)"),
        new("quarter", "In 90 days"),
        new("never", "Never"),
    ];

    private static DateTimeOffset? ExpiryFor(string choice, DateTimeOffset now) => choice switch
    {
        "quarter" => now.AddDays(90),
        "never" => null,
        _ => now.AddDays(IntegrationHealthRules.SuggestedKeyLifetimeDays),
    };

    private RenderFragment IntegrationCard(ApplicationResponse app) => @<AppListCard Title="@app.Name" Icon="@AppMaterialIcons.Outlined.Apps" Kind="@KindLabel(app)" Description="@app.Description">
        <Status><AppStatusBadge Text="@(FailingWebhook(app) is not null ? "Delivery failed" : StatusText(app))" Tone="@(FailingWebhook(app) is not null ? AppUiTone.Error : StatusTone(app))" /></Status>
        <Badges><AppStatusBadge Text="@PresetLabel(app)" Tone="@(app.IsAdministrator ? AppUiTone.Warning : AppUiTone.Neutral)" /></Badges>
        <ChildContent>
            <p class="access-card__meta">
                <span>@app.Credentials.Count(credential => credential.RevokedAt is null) active keys@(CredentialExpirySummary(app) is { } expiry ? $" · {expiry}" : null)</span>
                <span>@(app.LastUsedAt is null ? "Never used" : $"Last used {app.LastUsedAt.Value.ToLocalTime():g}")</span>
            </p>
            @if (FailingWebhook(app) is { } failing)
            {
                <p class="access-card__failure" role="status"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ErrorOutline" /> Delivery failed@(failing.LastAttemptAt is { } at ? $" · last attempt {at.ToLocalTime():g}" : null)</p>
            }
            else if (HealthOf(app) is { Word: HealthWord.NeedsAttention or HealthWord.Broken } health)
            {
                <p class="access-card__failure" role="status"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ErrorOutline" /> @health.LastProblem</p>
            }
        </ChildContent>
        <Footer>
            @if (!DeviceContext.IsPhone)
            {
                <AppButton Label="Manage" Size="AppControlSize.Compact" OnClick="@(() => OpenPage(app))" />
                <AppRowMenu AriaLabel="@($"Actions for {app.Name}")" Items="@MenuItems(app)" />
            }
        </Footer>
    </AppListCard>;


    // The integration's own page (Plugins and Integrations screens v3 D24): the side drawer's forms, split over tabs.
    private RenderFragment IntegrationPage()
    {
        if (_editing is not { } app)
        {
            return @<AppEmptyState Title="That integration is not available" Message="It may have been deleted. Go back to the list to pick another.">
                <Action><AppButton Label="All integrations" Href="@ListHref" Size="AppControlSize.Compact" /></Action>
            </AppEmptyState>;
        }

        var hasDeliveries = app.ApplicationType is ApplicationTypeDto.ServerIntegration or ApplicationTypeDto.Automation;
        var tab = DetailTab?.Trim().ToLowerInvariant() switch
        {
            "access" => "access",
            "keys" => "keys",
            "deliveries" when hasDeliveries => "deliveries",
            "activity" => "activity",
            _ => "overview",
        };
        var tabs = new List<AppCountTab>
        {
            new("overview", "Overview", null, PageHref(app.Id, "overview")),
            new("access", "Access", null, PageHref(app.Id, "access")),
            new("keys", "Keys", app.Credentials.Count(credential => credential.RevokedAt is null), PageHref(app.Id, "keys")),
        };
        if (hasDeliveries)
            tabs.Add(new("deliveries", "Deliveries", null, PageHref(app.Id, "deliveries")));
        tabs.Add(new("activity", "Activity", null, PageHref(app.Id, "activity")));
        var failing = FailingWebhook(app);

        return @<div class="integration-page" data-testid="integration-page">
            <header class="integration-page__header">
                <span class="integration-page__logo"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Apps" /></span>
                <div class="integration-page__title">
                    <h2>@app.Name</h2>
                    @if (!string.IsNullOrWhiteSpace(app.Description)) { <p>@app.Description</p> }
                    <div class="integration-page__pills">
                        <AppStatusBadge Text="@KindLabel(app)" Tone="AppUiTone.Neutral" />
                        <AppStatusBadge Text="@PresetLabel(app)" Tone="@(app.IsAdministrator ? AppUiTone.Warning : AppUiTone.Neutral)" />
                        <AppStatusBadge Text="@(failing is not null ? "Delivery failed" : StatusText(app))" Tone="@(failing is not null ? AppUiTone.Error : StatusTone(app))" />
                    </div>
                </div>
                @if (!DeviceContext.IsPhone)
                {
                    <div class="integration-page__actions">
                        <AppSwitchRow Value="@app.IsEnabled" ValueChanged="@(value => SetEnabledAsync(app, value))" AriaLabel="@($"Switch {app.Name} on or off")" />
                        <AppRowMenu AriaLabel="@($"Actions for {app.Name}")" Items="@MenuItems(app)" />
                    </div>
                }
            </header>
            @if (!string.IsNullOrWhiteSpace(_notice)) { <AppAlert Severity="AppSeverity.Success" Class="access-notice">@_notice</AppAlert> }
            @if (!string.IsNullOrWhiteSpace(_error)) { <AppAlert Severity="AppSeverity.Error">@_error</AppAlert> }
            @if (!string.IsNullOrWhiteSpace(_message)) { <AppAlert Severity="AppSeverity.Info">@_message</AppAlert> }
            <AppCountTabs Tabs="@tabs" Selected="@tab" AriaLabel="@($"{app.Name} sections")" />
            <div class="integration-page__body">
                @if (_deleteMode)
                {
                    <AppAlert Severity="AppSeverity.Warning">Delete @app.Name? Its credentials will stop authenticating immediately.</AppAlert>
                    <p>This does not delete any media or account data.</p>
                    <AppActionBar Align="AppHorizontalAlignment.Start">
                        <AppButton Label="Delete application" Tone="AppUiTone.Error" ButtonStyle="AppButtonStyle.Filled" Disabled="@_saving" OnClick="DeleteApplication" />
                        <AppButton Label="Cancel" OnClick="@(() => _deleteMode = false)" />
                    </AppActionBar>
                }
                else
                {
                    @switch (tab)
                    {
                        case "access":
                            @AccessTab()
                            break;
                        case "keys":
                            @KeysTab(app)
                            break;
                        case "deliveries":
                            <ManagedApplicationWebhooks Application="@app" />
                            break;
                        case "activity":
                            @ActivityTab(app)
                            break;
                        default:
                            @OverviewTab(app, failing)
                            break;
                    }
                }
            </div>
            @if (!_deleteMode && tab is "overview" or "access")
            {
                <footer class="integration-page__savebar">
                    <AppButton Label="Cancel" OnClick="Close" />
                    <AppButton Label="Save application" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@(_saving || string.IsNullOrWhiteSpace(_name))" OnClick="Save" />
                </footer>
            }
        </div>;
    }

    private RenderFragment OverviewTab(ApplicationResponse app, ApplicationWebhookResponse? failing) => @<text>
        @if (failing is not null)
        {
            <AppAlert Severity="AppSeverity.Error" data-testid="integration-failure">
                <strong>Delivery failed</strong>@(failing.LastAttemptAt is { } at ? $" · last attempt {at.ToLocalTime():g}" : null).
                Open Deliveries to see what the receiver answered and to send a test.
            </AppAlert>
        }
        else if (HealthOf(app) is { Word: HealthWord.NeedsAttention or HealthWord.Broken } health)
        {
            <AppAlert Severity="AppSeverity.Warning">@health.LastProblem</AppAlert>
        }
        <section class="access-form-section">
            <AppText Typo="AppTypo.subtitle1">Application</AppText>
            <AppTextField @bind-Value="_name" Label="Name" FullWidth="true" />
            <AppTextField @bind-Value="_description" Label="Description" FullWidth="true" />
            <label class="access-native-label" for="application-type">Application type</label>
            <AppNativeSelect id="application-type" Value="@_type.ToString()" OnChange="SetType" Disabled="@_saving" aria-label="Application type">
                @foreach (var type in Enum.GetValues<ApplicationTypeDto>()) { <option value="@type">@TypeLabel(type)</option> }
            </AppNativeSelect>
            <AppSwitchRow @bind-Value="_enabled" Disabled="@_saving" Label="Application enabled" Description="Disabling an application rejects every credential attached to it." />
            @if (_type == ApplicationTypeDto.UserClient)
            {
                <AppTextField @bind-Value="_clientIds" Label="Native client IDs" HelpText="Comma-separated registered client IDs allowed to use this application." FullWidth="true" />
            }
        </section>
        <section class="access-form-section">
            <AppText Typo="AppTypo.subtitle1">Delete this integration</AppText>
            <small>Its credentials stop working at once. No media or account data is deleted.</small>
            <AppActionBar Align="AppHorizontalAlignment.Start">
                <AppButton Label="Delete integration" Tone="AppUiTone.Error" StartIcon="@AppMaterialIcons.Outlined.Delete" OnClick="@(() => _deleteMode = true)" />
            </AppActionBar>
        </section>
    </text>;

    private RenderFragment AccessTab() => @<text>
        <section class="access-form-section">
            <AppText Typo="AppTypo.subtitle1">Permission preset</AppText>
            <AppNativeSelect Value="@_presetId" OnChange="ApplyPreset" Disabled="@_saving" aria-label="Permission preset">
                <option value="custom">Custom</option>
                @foreach (var preset in _presets.Where(value => !value.Id.Equals("custom", StringComparison.OrdinalIgnoreCase))) { <option value="@preset.Id">@preset.DisplayName</option> }
            </AppNativeSelect>
            @if (_administrator)
            {
                <AppAlert Severity="AppSeverity.Warning">Administrator applications receive every currently available registered permission and automatically include newly available permissions.</AppAlert>
            }
        </section>
        <section class="access-form-section">
            <AppText Typo="AppTypo.subtitle1">Permissions</AppText>
            @foreach (var group in CompatiblePermissions.GroupBy(permission => permission.Category))
            {
                <div class="access-permission-group">
                    <strong>@group.Key</strong>
                    @foreach (var permission in group)
                    {
                        <div class="access-permission-row @(permission.IsAvailable ? null : "is-unavailable")">
                            <AppCheckbox Value="@_selected.Contains(permission.Id)" ValueChanged="@((bool value) => TogglePermission(permission, value))" Disabled="@(_saving || _administrator || !permission.IsAvailable)" Label="@permission.DisplayName" />
                            <small>@permission.Description</small>
                            <div><AppStatusBadge Text="@permission.Risk" Tone="@RiskTone(permission.Risk)" />@if (!permission.IsAvailable) { <AppStatusBadge Text="Unavailable" Tone="AppUiTone.Warning" /> }</div>
                            @if (!permission.IsAvailable) { <small>@(permission.UnavailableReason ?? "This service is not available.")</small> }
                        </div>
                    }
                </div>
            }
        </section>
    </text>;

    private RenderFragment KeysTab(ApplicationResponse app) => @<text>
        <section class="access-form-section">
            <AppText Typo="AppTypo.subtitle1">Credentials</AppText>
            @if (app.Credentials.Count == 0) { <small>No credentials issued.</small> }
            @foreach (var credential in app.Credentials)
            {
                <div class="access-credential-row">
                    <div><strong>@credential.Name</strong><small>Created @credential.CreatedAt.ToLocalTime().ToString("g") · @ExpiryText(credential)</small><small>@LastUsedText(credential)</small></div>
                    <div><AppButton Label="Rotate" Size="AppControlSize.Compact" Disabled="@(_saving || credential.RevokedAt is not null)" OnClick="@(() => RotateCredential(credential))" /><AppButton Label="Revoke" Size="AppControlSize.Compact" Tone="AppUiTone.Error" Disabled="@(_saving || credential.RevokedAt is not null)" OnClick="@(() => RevokeCredential(credential))" /></div>
                </div>
            }
            <div class="access-credential-issue"><AppTextField @bind-Value="_credentialName" Label="Credential name" FullWidth="true" /><AppSelect Native="true" Label="Expires" Value="@_credentialExpiry" Options="@ExpiryOptions" ValueChanged="@(value => _credentialExpiry = value ?? SuggestedExpiry)" /><AppButton Label="Generate credential" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(_saving || string.IsNullOrWhiteSpace(_credentialName))" OnClick="IssueCredential" /></div>
        </section>
        @if (_plaintext is not null)
        {
            <AppAlert Severity="AppSeverity.Success" Class="access-credential-secret"><strong>Copy this credential now. It will not be shown again.</strong><code>@_plaintext</code></AppAlert>
        }
    </text>;

    private RenderFragment ActivityTab(ApplicationResponse app) => @<text>
        <section class="access-form-section">
            <AppText Typo="AppTypo.subtitle1">Activity</AppText>
            <small>@(app.LastUsedAt is null ? "Never used." : $"Last used {app.LastUsedAt.Value.ToLocalTime():g}.")</small>
            <small>@app.Credentials.Count(credential => credential.RevokedAt is null) active keys@(CredentialExpirySummary(app) is { } expiry ? $" · {expiry}" : null)</small>
            @if (HealthOf(app) is { Word: HealthWord.NeedsAttention or HealthWord.Broken } health)
            {
                <AppAlert Severity="AppSeverity.Warning">@health.LastProblem</AppAlert>
            }
        </section>
    </text>;

    // The List view (Plugins and Integrations screens v3 D27): status, kind, access, keys, last used and Manage on one 56 px row.
    private RenderFragment IntegrationRows(IReadOnlyList<ApplicationResponse> apps) => @<AppTable Class="access-rows" data-testid="integration-rows">
        <thead>
            <tr><th scope="col">Integration</th><th scope="col">Status</th><th scope="col">Kind</th><th scope="col">Access</th><th scope="col">Keys</th><th scope="col">Last used</th><th scope="col"><span class="access-rows__sr">Actions</span></th></tr>
        </thead>
        <tbody>
            @foreach (var app in apps)
            {
                <tr @key="app.Id" data-integration-row="@app.Id">
                    <td><a href="@PageHref(app.Id, "overview")">@app.Name</a></td>
                    <td><AppStatusBadge Text="@(FailingWebhook(app) is not null ? "Delivery failed" : StatusText(app))" Tone="@(FailingWebhook(app) is not null ? AppUiTone.Error : StatusTone(app))" /></td>
                    <td>@KindLabel(app)</td>
                    <td>@PresetLabel(app)</td>
                    <td>@app.Credentials.Count(credential => credential.RevokedAt is null)</td>
                    <td>@(app.LastUsedAt is null ? "Never" : app.LastUsedAt.Value.ToLocalTime().ToString("g"))</td>
                    <td>
                        <div class="access-rows__actions">
                            <AppButton Label="Manage" Size="AppControlSize.Compact" OnClick="@(() => OpenPage(app))" />
                            <AppRowMenu AriaLabel="@($"Actions for {app.Name}")" Items="@MenuItems(app)" />
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </AppTable>;

    private IReadOnlyList<AppRowMenuItem> MenuItems(ApplicationResponse app)
    {
        var items = new List<AppRowMenuItem>
        {
            new() { Label = app.IsEnabled ? "Disable" : "Enable", Icon = app.IsEnabled ? AppMaterialIcons.Outlined.Block : AppMaterialIcons.Outlined.CheckCircle, OnClick = EventCallback.Factory.Create(this, () => SetEnabledAsync(app, !app.IsEnabled)) },
        };
        if (app.Credentials.Any(credential => credential.RevokedAt is null))
            items.Add(new() { Label = "Revoke keys", Icon = AppMaterialIcons.Outlined.Key, Destructive = true, OnClick = EventCallback.Factory.Create(this, () => RevokeAllKeysAsync(app)) });
        items.Add(new() { Label = "Delete", Icon = AppMaterialIcons.Outlined.Delete, Destructive = true, OnClick = EventCallback.Factory.Create(this, () => ConfirmDelete(app)) });
        return items;
    }

    private const int PageSize = 24;
    private string? _search;
    private string _statusFilter = "all";
    private string _accessFilter = "all";
    private string _kindTab = "all";
    private int _page = 1;
    private readonly Dictionary<Guid, List<ApplicationWebhookResponse>> _webhooks = [];

    private static readonly IReadOnlyList<AppSelectOption> StatusOptions =
    [
        new("all", "All"),
        new("enabled", "Enabled"),
        new("disabled", "Disabled"),
        new("attention", "Needs attention"),
    ];

    private IReadOnlyList<AppSelectOption> AccessOptions() =>
        [new("all", "All access"), .. _applications.Select(PresetLabel).Distinct().Order().Select(label => new AppSelectOption(label, label))];

    private bool IsWebhook(ApplicationResponse app) => _webhooks.TryGetValue(app.Id, out var hooks) && hooks.Count > 0;
    private ApplicationWebhookResponse? FailingWebhook(ApplicationResponse app) =>
        _webhooks.TryGetValue(app.Id, out var hooks) ? hooks.FirstOrDefault(hook => StateCardHealth.ForWebhook(hook).Word is HealthWord.NeedsAttention or HealthWord.Broken) : null;
    private bool NeedsAttention(ApplicationResponse app) => FailingWebhook(app) is not null || HealthOf(app).Word is HealthWord.NeedsAttention or HealthWord.Broken;
    private string KindLabel(ApplicationResponse app) => IsWebhook(app) ? "Webhook" : TypeLabel(app.ApplicationType);
    private string StatusText(ApplicationResponse app) => !app.IsEnabled ? "Disabled" : NeedsAttention(app) ? "Needs attention" : "Enabled";
    private AppUiTone StatusTone(ApplicationResponse app) => !app.IsEnabled ? AppUiTone.Neutral : NeedsAttention(app) ? AppUiTone.Warning : AppUiTone.Success;
    // Tabs are navigation, not a filter: only search and the filter menus count (spec plugins-and-integrations-screens-v3 D20).
    private bool Narrowed => !string.IsNullOrWhiteSpace(_search) || _statusFilter != "all" || _accessFilter != "all";

    private void Narrow(Action change) { change(); _page = 1; }
    private void ClearFilters() { _search = null; _statusFilter = _accessFilter = "all"; _page = 1; }

    private bool MatchesFilters(ApplicationResponse app) =>
        (string.IsNullOrWhiteSpace(_search) || app.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
        && (_statusFilter switch { "enabled" => app.IsEnabled, "disabled" => !app.IsEnabled, "attention" => NeedsAttention(app), _ => true })
        && (_accessFilter == "all" || PresetLabel(app) == _accessFilter);

    private List<ApplicationResponse> VisibleApplications() => _applications
        .Where(MatchesFilters)
        .Where(app => _kindTab switch { "webhooks" => IsWebhook(app), "applications" => !IsWebhook(app), _ => true })
        .OrderBy(app => app.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IReadOnlyList<AppCountTab> KindTabs()
    {
        var matching = _applications.Where(MatchesFilters).ToList();
        return
        [
            new("all", "All", matching.Count),
            new("applications", "Applications", matching.Count(app => !IsWebhook(app))),
            new("webhooks", "Webhooks", matching.Count(IsWebhook)),
        ];
    }

    private IReadOnlyList<AppSummaryItem> SummaryItems() =>
    [
        new("integrations", _applications.Count.ToString(), AppMaterialIcons.Outlined.Apps, AppSummaryTone.Accent),
        new("active", _applications.Count(app => app.IsEnabled).ToString(), AppMaterialIcons.Outlined.CheckCircle, AppSummaryTone.Ok),
        new("need attention", _applications.Count(NeedsAttention).ToString(), AppMaterialIcons.Outlined.ErrorOutline, _applications.Count(NeedsAttention) == 0 ? AppSummaryTone.Mute : AppSummaryTone.Warn),
    ];

    private async Task SetEnabledAsync(ApplicationResponse app, bool enabled)
    {
        _notice = string.Empty;
        var updated = await ConfirmedAsync(hash => Identity.UpdateApplicationResultAsync(
            app.Id, new(app.Name, app.Description, app.ApplicationType, enabled, app.IsAdministrator, hash)));
        if (updated is null) { _notice = NotConfirmedMessage; return; }
        if (!updated.Succeeded || updated.Value is null) { _notice = FailureMessage(updated.Failure); return; }
        ReplaceApplication(updated.Value);
        _notice = $"{app.Name} was {(enabled ? "enabled" : "disabled")}.";
    }

    private async Task RevokeAllKeysAsync(ApplicationResponse app)
    {
        _notice = string.Empty;
        foreach (var credential in app.Credentials.Where(credential => credential.RevokedAt is null))
        {
            var result = await Identity.RevokeApplicationCredentialResultAsync(app.Id, credential.Id);
            if (!result.Succeeded) { _notice = FailureMessage(result.Failure); await ReloadAllAsync(); return; }
        }
        await ReloadAllAsync();
        _notice = $"Every key for {app.Name} was revoked.";
    }

    private async Task ReloadAllAsync()
    {
        _applications = await Identity.GetApplicationsAsync();
        await LoadWebhooksAsync();
    }

    // Webhooks hang off the integrations that can host them; their delivery state drives the Webhooks tab and "Delivery failed".
    private async Task LoadWebhooksAsync()
    {
        var hosts = _applications.Where(app => app.ApplicationType is ApplicationTypeDto.ServerIntegration or ApplicationTypeDto.Automation).ToList();
        var loaded = await Task.WhenAll(hosts.Select(async app => (app.Id, Hooks: await Identity.GetApplicationWebhooksAsync(app.Id))));
        _webhooks.Clear();
        foreach (var (id, hooks) in loaded)
            _webhooks[id] = hooks;
    }

    private static StateCardHealthResult HealthOf(ApplicationResponse app) => StateCardHealth.ForApplication(app, DateTimeOffset.UtcNow);
    private string _presetId = "custom";
    private string _error = string.Empty;
    private string _message = string.Empty;
    private string _notice = string.Empty;
    private string? _plaintext;
    private ElementReference _returnFocus;
    private bool _restoreFocus;

    private bool CanManage => Session.HasAction("applications.manage");
        private IEnumerable<ApplicationPermissionDefinitionDto> CompatiblePermissions => _permissions.Where(permission => permission.ApplicationTypes.Contains(_type)).OrderBy(permission => permission.Category).ThenBy(permission => permission.SortOrder);

    protected override void OnInitialized() => DeviceContext.OnChanged += DeviceChanged;

    public void Dispose() => DeviceContext.OnChanged -= DeviceChanged;

    private void DeviceChanged() => InvokeAsync(() =>
    {
        // Editing drawers never open on phones, so a switch to the phone form factor closes one that is already open.
        if (DeviceContext.IsPhone && _open) Close();
        StateHasChanged();
    });

    protected override async Task OnInitializedAsync()
    {
        if (CanManage)
        {
            var applications = Identity.GetApplicationsAsync();
            var permissions = Identity.GetApplicationPermissionsAsync();
            var presets = Identity.GetApplicationPresetsAsync();
            await Task.WhenAll(applications, permissions, presets);
            _applications = applications.Result;
            _permissions = permissions.Result;
            _presets = presets.Result;
            await LoadWebhooksAsync();
        }
        _loading = false;
        ApplyDetail();
    }

    protected override void OnParametersSet()
    {
        if (!_loading)
            ApplyDetail();
    }

    // Opening an integration's page fills the form from it, once per integration, and tells the breadcrumb its name.
    private void ApplyDetail()
    {
        if (string.Equals(_appliedId, IntegrationId, StringComparison.Ordinal))
            return;

        _appliedId = IntegrationId;
        if (!Guid.TryParse(IntegrationId, out var id) || _applications.FirstOrDefault(app => app.Id == id) is not { } app)
        {
            ResetDrawer();
            _open = false;
            return;
        }

        Edit(app);
        if (_deleteRequestedFor == id)
        {
            _deleteMode = true;
            _deleteRequestedFor = null;
        }

        _ = NameChanged.InvokeAsync(app.Name);
    }

    private bool _wizard;

    // The three-step page owns creating; this list only opens it and refreshes when it is done.
    private void NewApplication() { _notice = string.Empty; _wizard = true; }

    private async Task WizardFinishedAsync(ApplicationResponse? created)
    {
        _wizard = false;
        if (created is null)
            return;
        await ReloadAllAsync();
        _notice = $"{created.Name} was created.";
    }

    private void Edit(ApplicationResponse app)
    {
        ResetDrawer();
        _editing = app;
        _name = app.Name;
        _description = app.Description ?? string.Empty;
        _type = app.ApplicationType;
        _enabled = app.IsEnabled;
        _administrator = app.IsAdministrator;
        _selected = app.PermissionIds.ToHashSet(StringComparer.Ordinal);
        _clientIds = string.Join(", ", app.ClientIds);
        _presetId = MatchingPreset(app)?.Id ?? "custom";
        var excluded = app.PermissionIds.Count(id => !IsCompatible(id, app.ApplicationType));
        if (excluded > 0)
            _message = $"{excluded} unavailable permission(s) are retained by the Engine but cannot be submitted from this editor.";
        _open = true;
    }

    private Guid? _deleteRequestedFor;
    private void ConfirmDelete(ApplicationResponse app) { _deleteRequestedFor = app.Id; OpenPage(app); }
    private void OpenPage(ApplicationResponse app) => Navigation.NavigateTo(PageHref(app.Id, "overview"));
    private static string PageHref(Guid id, string tab) => $"/settings/integrations/{id:D}" + (tab == "overview" ? string.Empty : "/" + tab);
    private const string ListHref = "/settings/integrations";

    private async Task Save()
    {
        if (!Begin(out var generation)) return;
        try
        {
            ClearMessages();
            var wasNew = _editing is null;
            var permissionIds = SubmittedPermissionIds();
            DashboardAccessMutationResult<ApplicationResponse> result;
            if (_editing is null)
            {
                result = await Identity.CreateApplicationResultAsync(new(_name.Trim(), NullIfWhiteSpace(_description), _type, _administrator, permissionIds));
            }
            else
            {
                var hasExcludedPermissions = _editing.PermissionIds.Any(id => !IsCompatible(id, _editing.ApplicationType));
                if (_editing.ApplicationType != _type)
                {
                    var transitionPermissions = _editing.PermissionIds
                        .Where(id => IsCompatible(id, _editing.ApplicationType) && IsCompatible(id, _type))
                        .Order()
                        .ToArray();
                    var narrowed = await Identity.ReplaceApplicationPermissionsResultAsync(
                        _editing.Id,
                        new(transitionPermissions));
                    if (!Current(generation)) return;
                    if (!narrowed.Succeeded || narrowed.Value is null)
                    {
                        _error = $"The type change was not applied because permissions could not be prepared. {FailureMessage(narrowed.Failure)}";
                        return;
                    }
                    ReplaceApplication(narrowed.Value);
                    _editing = narrowed.Value;

                    if (_editing.ApplicationType == ApplicationTypeDto.UserClient && _editing.ClientIds.Count > 0)
                    {
                        var clearedBindings = await Identity.SetApplicationClientBindingsResultAsync(
                            _editing.Id,
                            new([]));
                        if (!Current(generation)) return;
                        if (!clearedBindings.Succeeded || clearedBindings.Value is null)
                        {
                            _error = $"Permissions were narrowed, but client bindings could not be cleared. {FailureMessage(clearedBindings.Failure)}";
                            await ReloadEditing(generation);
                            return;
                        }
                        ReplaceApplication(clearedBindings.Value);
                        _editing = clearedBindings.Value;
                    }
                }
                else if (hasExcludedPermissions)
                {
                    var editingId = _editing.Id;
                    var cleaned = await ConfirmedAsync(hash => Identity.ReplaceApplicationPermissionsResultAsync(
                        editingId,
                        new(permissionIds, hash)));
                    if (!Current(generation)) return;
                    if (cleaned is null)
                    {
                        _error = NotConfirmedMessage;
                        return;
                    }
                    if (!cleaned.Succeeded || cleaned.Value is null)
                    {
                        _error = FailureMessage(cleaned.Failure);
                        return;
                    }
                }

                var updatingId = _editing.Id;
                var updated = await ConfirmedAsync(hash => Identity.UpdateApplicationResultAsync(
                    updatingId,
                    new(_name.Trim(), NullIfWhiteSpace(_description), _type, _enabled, _administrator, hash)));
                if (!Current(generation)) return;
                if (updated is null)
                {
                    _error = NotConfirmedMessage;
                    await ReloadEditing(generation);
                    return;
                }
                result = updated;
            }
            if (!Current(generation)) return;
            if (!result.Succeeded || result.Value is null) { _error = FailureMessage(result.Failure); return; }

            var saved = result.Value;
            ReplaceApplication(saved);
            _editing = saved;
            if (!wasNew)
            {
                var savedId = saved.Id;
                var permissions = await ConfirmedAsync(hash => Identity.ReplaceApplicationPermissionsResultAsync(savedId, new(permissionIds, hash)));
                if (!Current(generation)) return;
                if (permissions is null)
                {
                    _error = $"Application details were saved, but the new permissions were not applied. {NotConfirmedMessage}";
                    await ReloadEditing(generation);
                    return;
                }
                if (!permissions.Succeeded || permissions.Value is null)
                {
                    _error = $"Application details were saved, but permissions were not. {FailureMessage(permissions.Failure)}";
                    await ReloadEditing(generation);
                    return;
                }
                saved = permissions.Value;
                ReplaceApplication(saved);
                _editing = saved;
            }
            if (_type == ApplicationTypeDto.UserClient)
            {
                var bindings = await Identity.SetApplicationClientBindingsResultAsync(saved.Id, new(ParseClientIds()));
                if (!Current(generation)) return;
                if (!bindings.Succeeded || bindings.Value is null)
                {
                    _error = $"Application details were saved, but native client bindings were not. Retry Save application. {FailureMessage(bindings.Failure)}";
                    await ReloadEditing(generation);
                    return;
                }
                saved = bindings.Value;
            }
            ReplaceApplication(saved);
            _editing = saved;
            _notice = $"{saved.Name} was {(wasNew ? "created" : "saved")}.";
        }
        finally { End(generation); }
    }

    private const string NotConfirmedMessage = "The change to what its keys can do was not confirmed, so it was not saved.";

    // Runs one save step. When the Engine asks the person to see what the integration's keys will be able to do first (more
    // permissions, or switching it back on while it holds keys), the dialog is shown and the step repeats carrying the
    // confirmed hash. Null means the person cancelled, so nothing more is sent.
    private async Task<DashboardAccessMutationResult<ApplicationResponse>?> ConfirmedAsync(
        Func<string?, Task<DashboardAccessMutationResult<ApplicationResponse>>> step)
    {
        var result = await step(null);
        if (result.Failure != DashboardAccessMutationFailure.ApprovalRequired || result.Approval is not { } approval)
            return result;

        var hashes = await Approvals.ConfirmAsync(approval.Approvals);
        if (hashes is null)
            return null;

        return await step(hashes.Values.First());
    }

    private async Task IssueCredential()
    {
        if (_editing is null || !Begin(out var generation)) return;
        try
        {
            ClearMessages();
            _plaintext = null;
            var applicationId = _editing.Id;
            var request = new CreateApplicationCredentialRequest(_credentialName.Trim(), ExpiryFor(_credentialExpiry, DateTimeOffset.UtcNow));
            var result = await Identity.IssueApplicationCredentialResultAsync(applicationId, request);
            if (!Current(generation)) return;
            if (result.Failure == DashboardAccessMutationFailure.ApprovalRequired && result.Approval is { } approval)
            {
                // Every key is new, so the person sees what it can do first. Cancel issues nothing.
                var hashes = await Approvals.ConfirmAsync(approval.Approvals);
                if (!Current(generation)) return;
                if (hashes is null) return;
                result = await Identity.IssueApplicationCredentialResultAsync(applicationId, request with { ApprovalHash = hashes.Values.First() });
                if (!Current(generation)) return;
            }
            if (result.Succeeded && result.Value is not null) { _plaintext = result.Value.PlaintextCredential; _credentialName = "Credential"; _credentialExpiry = SuggestedExpiry; await ReloadEditing(generation); }
            else _error = FailureMessage(result.Failure);
        }
        finally { End(generation); }
    }

    private async Task RotateCredential(ApplicationCredentialResponse credential)
    {
        if (_editing is null || !Begin(out var generation)) return;
        try
        {
            ClearMessages();
            _plaintext = null;
            var result = await Identity.RotateApplicationCredentialResultAsync(_editing.Id, credential.Id, new(credential.Name, credential.ExpiresAt));
            if (!Current(generation)) return;
            if (result.Succeeded && result.Value is not null) { _plaintext = result.Value.PlaintextCredential; await ReloadEditing(generation); }
            else _error = FailureMessage(result.Failure);
        }
        finally { End(generation); }
    }

    private async Task RevokeCredential(ApplicationCredentialResponse credential)
    {
        if (_editing is null || !Begin(out var generation)) return;
        try
        {
            ClearMessages();
            var result = await Identity.RevokeApplicationCredentialResultAsync(_editing.Id, credential.Id);
            if (!Current(generation)) return;
            if (result.Succeeded) { _plaintext = null; await ReloadEditing(generation); }
            else _error = FailureMessage(result.Failure);
        }
        finally { End(generation); }
    }

    private async Task DeleteApplication()
    {
        if (_editing is null || !Begin(out var generation)) return;
        try
        {
            var name = _editing.Name;
            var result = await Identity.DeleteApplicationResultAsync(_editing.Id);
            if (!Current(generation)) return;
            if (result.Succeeded) { _applications.RemoveAll(app => app.Id == _editing.Id); _notice = $"{name} was deleted."; Close(); }
            else _error = FailureMessage(result.Failure);
        }
        finally { End(generation); }
    }

    private async Task ReloadEditing(long generation)
    {
        var id = _editing?.Id;
        var applications = await Identity.GetApplicationsAsync();
        if (!Current(generation)) return;
        _applications = applications;
        _editing = id is null ? null : applications.FirstOrDefault(app => app.Id == id);
    }

    private void ApplyPreset(ChangeEventArgs args)
    {
        var id = args.Value?.ToString() ?? "custom";
        if (id == "custom") { _presetId = id; _administrator = false; return; }
        var preset = _presets.FirstOrDefault(value => value.Id == id);
        if (preset is not null) SetPreset(preset);
    }

    private void SetPreset(ApplicationPermissionPresetDto preset)
    {
        _presetId = preset.Id;
        _administrator = preset.IsAdministrator;
        _selected = preset.PermissionIds.Where(id => _permissions.Any(permission => permission.Id == id && permission.IsAvailable && permission.ApplicationTypes.Contains(_type))).ToHashSet(StringComparer.Ordinal);
    }

    private void TogglePermission(ApplicationPermissionDefinitionDto permission, bool selected)
    {
        if (!permission.IsAvailable || _administrator) return;
        if (selected) _selected.Add(permission.Id); else _selected.Remove(permission.Id);
        _presetId = "custom";
    }

    private void SetType(ChangeEventArgs args)
    {
        if (!Enum.TryParse<ApplicationTypeDto>(args.Value?.ToString(), out var type)) return;
        _type = type;
        var incompatible = _selected.Where(id => !_permissions.Any(permission => permission.Id == id && permission.IsAvailable && permission.ApplicationTypes.Contains(type))).ToArray();
        if (incompatible.Length > 0)
        {
            _selected.ExceptWith(incompatible);
            _presetId = "custom";
            _message = $"{incompatible.Length} permission(s) incompatible with {TypeLabel(type)} were removed.";
        }
        if (type != ApplicationTypeDto.UserClient) _clientIds = string.Empty;
    }

    private string[] SubmittedPermissionIds() => _administrator ? [] : _selected.Where(id => _permissions.Any(permission => permission.Id == id && permission.IsAvailable && permission.ApplicationTypes.Contains(_type))).Order().ToArray();
    private bool IsCompatible(string id, ApplicationTypeDto type) => _permissions.Any(permission => permission.Id == id && permission.IsAvailable && permission.ApplicationTypes.Contains(type));
    private string[] ParseClientIds() => _clientIds.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.Ordinal).ToArray();
    private ApplicationPermissionPresetDto? MatchingPreset(ApplicationResponse app) => _presets.FirstOrDefault(preset => preset.IsAdministrator == app.IsAdministrator && (app.IsAdministrator || preset.PermissionIds.Order().SequenceEqual(app.PermissionIds.Order())));
    /// <summary>What a key's card says about its expiry: always something plain, never blank.</summary>
    private static string ExpiryText(ApplicationCredentialResponse credential)
    {
        if (credential.RevokedAt is not null)
            return "Revoked";
        if (credential.ExpiresAt is not { } expires)
            return "No expiry";
        return expires <= DateTimeOffset.UtcNow ? $"Expired {expires.ToLocalTime():g}" : $"Expires {expires.ToLocalTime():g}";
    }

    private static string LastUsedText(ApplicationCredentialResponse credential) =>
        credential.LastUsedAt is { } used ? $"Last used {used.ToLocalTime():g}" : "Never used";

    /// <summary>The soonest expiry among an application's keys that are not revoked, for the credentials cell; null when it has none.</summary>
    private static string? CredentialExpirySummary(ApplicationResponse app)
    {
        var live = app.Credentials.Where(credential => credential.RevokedAt is null).ToList();
        if (live.Count == 0)
            return null;
        var expiries = live.Where(credential => credential.ExpiresAt is not null).Select(credential => credential.ExpiresAt!.Value).ToList();
        if (expiries.Count == 0)
            return "No expiry";
        var soonest = expiries.Min();
        return soonest <= DateTimeOffset.UtcNow ? $"Expired {soonest.ToLocalTime():g}" : $"Next expiry {soonest.ToLocalTime():g}";
    }

    private string PresetLabel(ApplicationResponse app) => MatchingPreset(app)?.DisplayName ?? "Custom";
    private static string TypeLabel(ApplicationTypeDto type) => type switch { ApplicationTypeDto.UserClient => "User Client", ApplicationTypeDto.ServerIntegration => "Server Integration", ApplicationTypeDto.Automation => "Automation", _ => "Other" };
    private static AppUiTone RiskTone(string risk) => risk.Equals("Sensitive", StringComparison.OrdinalIgnoreCase) || risk.Equals("High", StringComparison.OrdinalIgnoreCase) ? AppUiTone.Warning : AppUiTone.Neutral;
    private static string? NullIfWhiteSpace(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private void ReplaceApplication(ApplicationResponse app) { var index = _applications.FindIndex(value => value.Id == app.Id); if (index < 0) _applications.Add(app); else _applications[index] = app; }
    private void ResetDrawer() { _drawerGeneration++; _saving = false; _editing = null; _selected = new(StringComparer.Ordinal); _type = ApplicationTypeDto.UserClient; _enabled = true; _administrator = _deleteMode = false; _name = _description = _clientIds = _error = _message = string.Empty; _credentialName = "Credential"; _credentialExpiry = SuggestedExpiry; _presetId = "custom"; _plaintext = null; }
    private bool Begin(out long generation) { generation = _drawerGeneration; if (_saving) return false; _saving = true; return true; }
    private bool Current(long generation) => generation == _drawerGeneration;
    private void End(long generation) { if (Current(generation)) _saving = false; }
    private void ClearMessages() { _error = _message = string.Empty; }
    private void Close()
    {
        _drawerGeneration++;
        _saving = false;
        _open = false;
        _plaintext = null;
        _restoreFocus = true;
        if (!string.IsNullOrWhiteSpace(IntegrationId))
            Navigation.NavigateTo(ListHref);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_restoreFocus) return;
        _restoreFocus = false;
        await _returnFocus.FocusAsync();
    }
    private static string FailureMessage(DashboardAccessMutationFailure failure) => failure switch { DashboardAccessMutationFailure.Validation => "Check the values and try again.", DashboardAccessMutationFailure.Conflict => "This change conflicts with the current application state.", DashboardAccessMutationFailure.Forbidden => "You no longer have permission for this change.", DashboardAccessMutationFailure.Unauthorized => "Your session has expired.", DashboardAccessMutationFailure.NotFound => "This application or credential no longer exists.", DashboardAccessMutationFailure.Transient => "The Engine is unavailable. Try again.", _ => "The change could not be saved. Try again." };
}
