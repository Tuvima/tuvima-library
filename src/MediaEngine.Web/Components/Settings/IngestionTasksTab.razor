@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Ingestion
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Web.Components.Shared
@using Microsoft.AspNetCore.WebUtilities
@inject IngestionLiveDashboardState Dashboard
@inject NavigationManager Nav
@inject IEngineApiClient Api
@inject ContextSidebarPreferences ContextPreferences
@inject ContextSidebarCoordinator ContextSidebar
@implements IAsyncDisposable

<div class="tl-page ingestion-operations">
    @if (IsHistoricalBatchView && _runId is { } batchId)
    {
        <IngestionMediaPagedView Mode="batch" BatchId="batchId" OnOpen="OpenDrawer" />
    }
    else if (IsCurrentPagedView)
    {
        <IngestionMediaPagedView Mode="@PagedViewMode" OnOpen="OpenDrawer" />
    }
    else if (Dashboard.IsLoading && Dashboard.Presentation is null)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="Loading ingestion status" />
    }
    else if (Dashboard.Presentation is null)
    {
        <AppPageState Kind="AppPageStateKind.Error" Icon="@AppMaterialIcons.Outlined.CloudOff" Title="Ingestion status is unavailable" Message="The Engine did not return a media ingestion summary." />
    }
    else
    {
        <div class="ingestion-summary-layout">
            <AppPanel Class="@($"tl-card ingestion-current {(Model.IsRunning ? "is-active" : "is-idle")}")"
                      aria-live="polite"
                      aria-busy="@(Model.IsRunning ? "true" : "false")">
                <div class="ingestion-current__top">
                    <span class="ingestion-current__icon" aria-hidden="true"><AppMaterialIcon Icon="@CurrentIcon" /></span>
                    <div class="ingestion-current__copy">
                        <h2>@(Model.IsRunning ? "Active batch" : "Library is up to date")</h2>
                        <p class="ingestion-current__lead">@(Model.IsRunning ? "Scanning and enriching your media library." : "No active ingestion is running right now.")</p>
                        <p class="ingestion-current__summary">@SummaryLine</p>
                        @if (Model.IsRunning)
                        {
                            <div class="ingestion-current__progress">
                                <AppProgressBar Class="ingestion-current__progress-bar" Indeterminate="@(Dashboard.BatchProgress is not { FilesTotal: > 0 } || Dashboard.BatchProgress.ProgressIsIndeterminate)" Value="@(Dashboard.BatchProgress?.ProgressPercent ?? 0)" ShowValue="false" />
                                <span>@(Dashboard.BatchProgress is { FilesTotal: > 0 } progress ? $"{progress.CurrentStage} · {progress.FilesProcessed:N0} of {progress.FilesTotal:N0} files registered · {progress.WorkUnitsCompleted:N0} of {progress.WorkUnitsTotal:N0} current-stage items settled" : "Discovering batch work…")</span>
                            </div>
                        }
                    </div>
                    <dl class="ingestion-current__facts">
                        <div><dt><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Schedule" aria-hidden="true" />@(Model.IsRunning ? "Elapsed" : "Last activity")</dt><dd>@TimingLabel</dd></div>
                        <div><dt><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PlayArrow" aria-hidden="true" />Active now</dt><dd>@Model.ActiveOperations.ToString("N0")</dd></div>
                        <div><dt><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Layers" aria-hidden="true" />Queued</dt><dd>@Model.QueuedOperations.ToString("N0")</dd></div>
                        <div><dt><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Sync" aria-hidden="true" />Waiting to retry</dt><dd>@Model.RetryWaitingOperations.ToString("N0")</dd></div>
                    </dl>
                </div>
            </AppPanel>

            @if (Model.Attention.Count > 0)
            {
                <AppPanel Class="tl-card ingestion-attention">
                    <header><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.WarningAmber" /><h3>Needs Attention</h3></header>
                    @foreach (var item in Model.Attention)
                    {
                        <a href="@item.Route"><AppMaterialIcon Icon="@AttentionIcon(item.Kind)" /><span><strong>@item.Label</strong><small>@item.Description</small></span><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" /></a>
                    }
                </AppPanel>
            }
        </div>

        @if (Model.IsRunning)
        {
            <section class="ingestion-section" aria-labelledby="being-added-title">
                <header><div><h2 id="being-added-title">Being Added Now</h2><p><i class="ingestion-live-dot" aria-hidden="true"></i>@Model.CurrentMediaTotal.ToString("N0") items currently being processed</p></div>@if (Model.CurrentMediaTotal > Model.CurrentMedia.Count) { <AppButton Href="/settings/ingestion?view=all" Label="View all" ButtonStyle="AppButtonStyle.Text" EndIcon="@AppMaterialIcons.Outlined.ArrowForward" /> }</header>
                @if (Model.CurrentMedia.Count > 0)
                {
                    <div class="ingestion-media-grid">
                        @foreach (var item in Model.CurrentMedia)
                        {
                            <IngestionMediaCard Item="item" OnOpen="OpenDrawer" @key="(item.BatchId, item.GroupId)" />
                        }
                    </div>
                }
                else
                {
                    <div class="ingestion-grouping-state"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Sync" /><span><strong>Identifying media</strong><small>Recognizable albums, shows, books, and movies appear here once their identity and primary cover art are ready.</small></span></div>
                }
            </section>
        }

        <IngestionRecentlyAddedPreview Days="Model.RecentDays" />
    }
</div>

@code {
    [Parameter] public string? View { get; set; }
    [Parameter] public Guid? RunId { get; set; }
    [Parameter] public Guid? ItemId { get; set; }
    private IngestionMediaGroupDto? _selectedItem;
    private int _drawerWidth = 340;
    private Guid? _contextLeaseId;

    private async Task SaveDrawerWidthAsync(int width)
    {
        _drawerWidth = width;
        var layout = await ContextPreferences.GetAsync("desktop:ingestion");
        layout.Width = width;
        await ContextPreferences.SaveAsync("desktop:ingestion", layout);
    }
    private bool _drawerRefreshInFlight;
    private int _drawerRevision;
    private string? _view;
    private Guid? _runId;
    private Guid? _requestedItemId;
    private IngestionPresentationSnapshotDto Model => Dashboard.Presentation!;
    private bool IsHistoricalBatchView => _view == "all" && _runId.HasValue;
    private bool IsCurrentPagedView => _view == "all" && !_runId.HasValue;
    private string PagedViewMode => "current";
    private string SummaryLine => Model.IsRunning
        ? $"{Model.FilesDiscovered:N0} files discovered · {Model.LibraryGroups:N0} library items · {Model.ReadyGroups:N0} ready · {Model.FinishingGroups:N0} finishing details · {Model.ReviewGroups:N0} need review"
        : $"{LastActivityCopy} · {Model.FilesProcessed:N0} files processed · {RecentCount:N0} media groups recently added";
    private int RecentCount => Model.RecentDays.Sum(day => day.TotalCount);
    private string TimingLabel => Model.IsRunning && Model.StartedAt.HasValue ? FormatDuration(DateTimeOffset.UtcNow - Model.StartedAt.Value.ToUniversalTime()) : LastActivityCopy;
    private string LastActivityCopy => Model.LastActivityAt.HasValue ? FormatRelative(Model.LastActivityAt.Value) : "No activity yet";
    private string CurrentIcon => Model.IsRunning ? AppMaterialIcons.Outlined.Sync : AppMaterialIcons.Outlined.CheckCircle;

    protected override async Task OnInitializedAsync()
    {
        Dashboard.OnChanged += OnDashboardChanged;
        ResolveQuery();
        _drawerWidth = (await ContextPreferences.GetAsync("desktop:ingestion")).Width;
        await Dashboard.InitializeAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        ResolveQuery();
        await LoadRequestedItemAsync();
    }

    private void ResolveQuery()
    {
        _view = View?.ToLowerInvariant();
        _runId = RunId;
        _requestedItemId = ItemId;
    }

    private async Task OpenDrawer(IngestionMediaGroupDto item)
    {
        _drawerRevision++;
        _selectedItem = item;
        if (IsHistoricalBatchView)
        {
            _requestedItemId = item.GroupId;
            Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["itemId"] = item.GroupId,
            }));
        }
        await OpenOrUpdateContextAsync();
    }

    private async Task CloseDrawer()
    {
        _drawerRevision++;
        _selectedItem = null;
        _requestedItemId = null;
        if (IsHistoricalBatchView)
        {
            Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["itemId"] = null,
            }), replace: true);
        }
        if (_contextLeaseId is { } leaseId) ContextSidebar.Release(leaseId);
        _contextLeaseId = null;
    }

    private void OnDashboardChanged()
    {
        if (_selectedItem is not null && Dashboard.Presentation is not null && !IsHistoricalBatchView)
        {
            var updated = Dashboard.Presentation.CurrentMedia.FirstOrDefault(item => item.BatchId == _selectedItem.BatchId && item.GroupId == _selectedItem.GroupId);
            if (updated is not null)
            {
                _selectedItem = updated;
                _ = OpenOrUpdateContextAsync();
            }
            else if (!_drawerRefreshInFlight)
                _ = RefreshPinnedDrawerAsync(_selectedItem.BatchId, _selectedItem.GroupId, _drawerRevision);
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LoadRequestedItemAsync()
    {
        var revision = ++_drawerRevision;
        if (_runId is not { } runId || _requestedItemId is not { } itemId)
        {
            if (_requestedItemId is null)
                _selectedItem = null;
            return;
        }

        var item = await Api.GetIngestionMediaGroupAsync(runId, itemId);
        if (revision == _drawerRevision && _runId == runId && _requestedItemId == itemId)
        {
            _selectedItem = item;
            await OpenOrUpdateContextAsync();
        }
    }

    private async Task RefreshPinnedDrawerAsync(Guid batchId, Guid groupId, int revision)
    {
        _drawerRefreshInFlight = true;
        try
        {
            var updated = await Api.GetIngestionMediaGroupAsync(batchId, groupId);
            if (updated is not null
                && revision == _drawerRevision
                && _selectedItem is not null
                && _selectedItem.BatchId == batchId
                && _selectedItem.GroupId == groupId)
            {
                _selectedItem = updated;
                await OpenOrUpdateContextAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            _drawerRefreshInFlight = false;
        }
    }

    private static string AttentionIcon(string kind) => kind switch { "review" => AppMaterialIcons.Outlined.WarningAmber, "textTracks" => AppMaterialIcons.Outlined.Lyrics, _ => AppMaterialIcons.Outlined.CloudQueue };
    private static string FormatDuration(TimeSpan value) => value.TotalHours >= 1 ? $"{(int)value.TotalHours}h {value.Minutes}m" : $"{Math.Max(0, (int)value.TotalMinutes)}m {Math.Max(0, value.Seconds)}s";
    private static string FormatRelative(DateTimeOffset value) { var elapsed = DateTimeOffset.UtcNow - value.ToUniversalTime(); return elapsed.TotalMinutes < 1 ? "Just now" : elapsed.TotalHours < 1 ? $"{(int)elapsed.TotalMinutes} minutes ago" : elapsed.TotalDays < 1 ? $"{(int)elapsed.TotalHours} hours ago" : value.ToLocalTime().ToString("MMM d, yyyy"); }

    public async ValueTask DisposeAsync()
    {
        _drawerRevision++;
        Dashboard.OnChanged -= OnDashboardChanged;
        if (_contextLeaseId is { } leaseId) ContextSidebar.Release(leaseId);
        await Dashboard.StopAsync();
    }

    private async Task OpenOrUpdateContextAsync()
    {
        if (_selectedItem is null) return;
        var body = DrawerBody(_selectedItem);
        if (_contextLeaseId is { } leaseId && ContextSidebar.Update(leaseId, "Ingestion details", _drawerWidth, body,
                CloseDrawer, SaveDrawerWidthAsync, () => ClearDisplacedDrawerAsync(leaseId)))
            return;

        var createdLease = Guid.NewGuid();
        createdLease = await ContextSidebar.OpenExplicitAsync(ContextSidebarOwner.Ingestion, "Ingestion details", _drawerWidth, body,
            CloseDrawer, SaveDrawerWidthAsync, () => ClearDisplacedDrawerAsync(createdLease));
        _contextLeaseId = createdLease;
    }

    private RenderFragment DrawerBody(IngestionMediaGroupDto item) => builder =>
    {
        builder.OpenComponent<IngestionMediaDrawer>(0);
        builder.AddAttribute(1, nameof(IngestionMediaDrawer.Item), item);
        builder.AddAttribute(2, nameof(IngestionMediaDrawer.Close), EventCallback.Factory.Create(this, CloseDrawer));
        builder.CloseComponent();
    };

    private async Task ClearDisplacedDrawerAsync(Guid expectedLease)
    {
        if (_contextLeaseId != expectedLease) return;
        _contextLeaseId = null;
        _drawerRevision++;
        _selectedItem = null;
        _requestedItemId = null;
        if (IsHistoricalBatchView)
            Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["itemId"] = null }), replace: true);
        await InvokeAsync(StateHasChanged);
    }

}
