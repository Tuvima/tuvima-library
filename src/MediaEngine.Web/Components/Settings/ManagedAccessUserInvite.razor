@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Web.Services.Integration
@inject DashboardIdentityClient Identity
@inject ConfirmedActionRunner Confirmed
@inject DashboardSessionAccessor Session
@inject NavigationManager Nav
@inject IStringLocalizer<SharedStrings> L
@* Add a sign-in (server administrator only): for a profile that has none, or for a new person with their own profile. Who they are
   and what they may use is set on the profile afterwards, under Profiles. The Engine decides every refusal and its sentence is
   shown as it is. *@
@if (_loading)
{
    <AppProgressBar Indeterminate="true" aria-label="@L["Common_LoadingProfiles"].Value" />
}
else
{
<div class="invite-form" data-user-invite>
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <AppAlert Severity="AppSeverity.Error" data-user-invite-error>@_error</AppAlert>
    }
    @if (_needsPassword)
    {
        @* D10: a second household needs the server administrator's own sign-in to have an email and password first. *@
        <div data-user-invite-set-password>
            <AppButton Label="@L["Common_SetAnEmailAndPassword"].Value" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" OnClick="OpenSecurity" />
        </div>
    }
    <section class="invite-form__section">
        <AppText Typo="AppTypo.subtitle1">@L["ManagedAccessUserInvite_WhoIsItFor"]</AppText>
        @if (Profiles.Count > 0)
        {
            <AppSegmentedControl Options="@TargetChoices" Value="@Target" ValueChanged="SetTarget" AriaLabel="@L["ManagedAccessUserInvite_WhoIsTheSignIn"].Value" />
        }
        @if (Target == ExistingProfile)
        {
            <small>@L["ManagedAccessUserInvite_TheSignInOpensThis"]</small>
            <AppNativeSelect Value="@_profileId" OnChange="@(value => _profileId = value.Value?.ToString() ?? string.Empty)" aria-label="@L["ManagedAccessUserInvite_ProfileWithoutASignIn"].Value">
                <option value="">@L["ManagedAccessUserInvite_ChooseAProfile"]</option>
                @foreach (var profile in Profiles)
                {
                    <option value="@profile.Id">@ProfileLabel(profile)</option>
                }
            </AppNativeSelect>
        }
        else
        {
            <small>They get their own profile. Its household and Kids setting are chosen here; everything else is set on the profile afterwards.</small>
            <AppTextField @bind-Value="_name" Label="@L["Users_ColName"].Value" FullWidth="true" />
            <AppNativeSelect Value="@_household" OnChange="@(value => _household = value.Value?.ToString() ?? string.Empty)" aria-label="@L["Common_Household"].Value">
                <option value="">@L["ManagedAccessUserInvite_ChooseAHousehold"]</option>
                @foreach (var household in HouseholdOptions)
                {
                    <option value="@household.Id">@household.Name</option>
                }
                <option value="@NewHousehold">@L["ManagedAccessUserInvite_ANewHousehold"]</option>
            </AppNativeSelect>
            @if (_household == NewHousehold)
            {
                <AppTextField @bind-Value="_newHouseholdName" Label="@L["ManagedAccessUserInvite_NewHouseholdName"].Value" HelpText="They will look after it." FullWidth="true" />
            }
            <AppCheckbox @bind-Value="_isKids" Label="@L["ManagedAccessUserInvite_KidsProfile"].Value" />
        }
    </section>
    <section class="invite-form__section">
        <AppText Typo="AppTypo.subtitle1">@L["ManagedAccessUserInvite_TheirSignIn"]</AppText>
        <AppTextField @bind-Value="_email" Label="@L["Common_Email"].Value" FullWidth="true" />
        <AppSegmentedControl Options="@MethodChoices" Value="@_method" ValueChanged="SetMethod" AriaLabel="@L["ManagedAccessUserInvite_HowWillTheySignIn"].Value" />
        @if (_method == TemporaryPasswordMethod)
        {
            <small>@L["ManagedAccessUserInvite_YouChooseAPasswordAnd"]</small>
            <AppTextField @bind-Value="_temporaryPassword" Label="@L["Common_TemporaryPassword"].Value" HelpText="At least 12 characters, not a common password." FullWidth="true" />
            <AppButton Label="@L["ApiKeys_Generate"].Value" Size="AppControlSize.Compact" StartIcon="@AppMaterialIcons.Outlined.AutoAwesome" OnClick="GeneratePassword" />
        }
        else
        {
            <small>@L["ManagedAccessUserInvite_YouGetACodeA"]</small>
        }
    </section>
    <div class="invite-form__actions">
        <AppButton Label="@L["Search_Cancel"].Value" OnClick="@(() => Cancelled.InvokeAsync())" />
        <AppButton Label="@L["ManagedAccessUserInvite_AddSignIn"].Value" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@(_saving || !CanSubmit)" OnClick="SubmitAsync" />
    </div>
</div>
}

@code {
    private const string ExistingProfile = "existing";
    private const string NewPerson = "new";
    private const string NewHousehold = "new-household";
    private const string InvitationMethod = "invitation";
    private const string TemporaryPasswordMethod = "temporary_password";

    private static readonly IReadOnlyList<AppSelectOption> TargetChoices =
    [
        new(ExistingProfile, "A profile without a sign-in"),
        new(NewPerson, "A new person"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> MethodChoices =
    [
        new(InvitationMethod, "Send an invitation"),
        new(TemporaryPasswordMethod, "Set a temporary password"),
    ];

    private string? _target;
    private string _profileId = string.Empty;
    private string _name = string.Empty;
    private string _household = string.Empty;
    private string _newHouseholdName = string.Empty;
    private bool _isKids;
    private string _email = string.Empty;
    private string _method = InvitationMethod;
    private string _temporaryPassword = string.Empty;
    private string _error = string.Empty;
    private bool _needsPassword;
    private bool _saving;

    // The profiles that have no sign-in yet, and the households a new person can join.
    private IReadOnlyList<ManagedProfileResponse> Profiles { get; set; } = [];
    private IReadOnlyList<HouseholdResponse> HouseholdOptions { get; set; } = [];
    private bool _loading = true;

    /// <summary>Raised with the Engine's answer and, for a temporary password, the password the administrator chose.</summary>
    [Parameter] public EventCallback<UserCreatedEventArgs> Created { get; set; }

    [Parameter] public EventCallback Cancelled { get; set; }

    /// <summary>What the page needs to show the hand-over (the invitation, or the password once).</summary>
    public sealed record UserCreatedEventArgs(CreateUserResponse Result, string? TemporaryPassword);

    protected override async Task OnInitializedAsync()
    {
        if (Session.HasAction("access.manage"))
        {
            var profiles = Identity.GetManagedProfilesAsync();
            var households = Identity.GetManagedHouseholdsAsync();
            await Task.WhenAll(profiles, households);
            Profiles = profiles.Result.Where(profile => profile.User is null).ToList();
            HouseholdOptions = households.Result;
        }

        _loading = false;
    }

    private string Target => Profiles.Count == 0 ? NewPerson : _target ?? ExistingProfile;

    private bool CanSubmit => !string.IsNullOrWhiteSpace(_email)
        && (_method != TemporaryPasswordMethod || !string.IsNullOrWhiteSpace(_temporaryPassword))
        && (Target == ExistingProfile
            ? Guid.TryParse(_profileId, out _)
            : !string.IsNullOrWhiteSpace(_name)
                && (_household == NewHousehold ? !string.IsNullOrWhiteSpace(_newHouseholdName) : Guid.TryParse(_household, out _)));

    private void SetTarget(string target) => _target = target == NewPerson ? NewPerson : ExistingProfile;

    private void SetMethod(string method) => _method = method == TemporaryPasswordMethod ? TemporaryPasswordMethod : InvitationMethod;

    private void GeneratePassword() => _temporaryPassword = TemporaryPasswordGenerator.Generate();

    private string ProfileLabel(ManagedProfileResponse profile)
    {
        var household = HouseholdOptions.FirstOrDefault(candidate => candidate.Id == profile.HouseholdId)?.Name;
        return string.IsNullOrWhiteSpace(household) ? profile.DisplayName : $"{profile.DisplayName} · {household}";
    }

    private void OpenSecurity() => Nav.NavigateTo("/settings/security");

    private async Task SubmitAsync()
    {
        // The Engine decides who may add a sign-in; this keeps the handler itself closed to anyone else.
        if (_saving || !CanSubmit || !Session.HasAction("access.manage"))
            return;
        _saving = true;
        _error = string.Empty;
        _needsPassword = false;
        try
        {
            var useTemporaryPassword = _method == TemporaryPasswordMethod;
            var password = useTemporaryPassword ? _temporaryPassword : null;
            var request = Target == ExistingProfile
                ? new CreateUserRequest(_email.Trim(), _method, ProfileId: Guid.Parse(_profileId), TemporaryPassword: password)
                : new CreateUserRequest(_email.Trim(), _method, TemporaryPassword: password, NewProfile: new NewUserProfileRequest(
                    _name.Trim(),
                    _household == NewHousehold ? null : Guid.Parse(_household),
                    _household == NewHousehold ? _newHouseholdName.Trim() : null,
                    _isKids));
            var result = await Confirmed.RunAsync(() => Identity.CreateUserResultAsync(request));
            if (result.Succeeded && result.Value is not null)
            {
                _temporaryPassword = string.Empty;
                await Created.InvokeAsync(new UserCreatedEventArgs(result.Value, password));
            }
            else
            {
                _error = ManagedUserMessages.For(result.Failure, result.Message);
                // The Engine marks this refusal with a stable code, so the button shows whatever words the sentence uses.
                _needsPassword = result.NeedsSecuredAdministrators;
            }
        }
        finally
        {
            _saving = false;
        }
    }
}
