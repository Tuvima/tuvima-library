@namespace MediaEngine.Web.Components.Settings
@using System.Text.Json
@using MediaEngine.Contracts.Ingestion
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Services.Formatting
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Models.ViewDTOs
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject IAppDialogService DialogService
@inject IAppToastService Snackbar
@inject LibraryFolderAddService AddService
@inject NavigationManager Navigation
@implements IDisposable
@inject IStringLocalizer<SharedStrings> L

@* The folders of one library or of the Import folder, for Settings > Libraries: a library's page hosts it (Folders tab), and the Import
   folder's address shows the Import entry. The host chose the type (TypeKey) or the library (LibraryId). *@
<div class="library-folders">
    @if (_loading)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="@L["Common_LoadingLibraries"].Value" />
    }
    else if (_configuration is null)
    {
        <AppPageState Kind="AppPageStateKind.Error"
                      Icon="@AppMaterialIcons.Outlined.CloudOff"
                      Title="@L["Common_LibrariesCouldNotBeLoaded"].Value"
                      Message="@(_loadError ?? "The Engine did not return library configuration.")" />
    }
    else
    {
        @* Shown on phones only (see the stylesheet): folders are read-only there, so every control that adds, converts or merges is hidden. *@
        <p class="library-folders__phone-note">@PhoneNote</p>
        @if (_unknownType)
        {
            <AppCard Class="library-folders__detail">
                <div class="library-folders__empty">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FolderOpen" />
                    <strong>@L["LibraryFoldersPanel_ThisLibraryTypeDoesNot"]</strong>
                    <span><a href="/settings/libraries">@L["Common_BackToLibraries"]</a></span>
                </div>
            </AppCard>
        }
        else if (ImportSelected)
        {
            <AppCard Class="library-folders__detail">
                <header class="library-folders__detail-header">
                    <span class="library-folders__icon library-folders__icon--import"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.MoveToInbox" /></span>
                    <div>
                        @* The Settings title already says "Import folder", so the heading is kept for screen readers only. *@
                        <h3 id="library-import-title" class="sr-only">@L["Common_ImportFolder"]</h3>
                        <p>@L["LibraryFoldersPanel_OneFolderWhereNewMedia"]</p>
                    </div>
                    @if (!ImportStatus.Configured)
                    {
                        <div class="library-folders__detail-actions">
                            <AppButton Label="@L["LibraryFoldersPanel_SetImportFolder"].Value"
                                       StartIcon="@AppMaterialIcons.Outlined.Add"
                                       ButtonStyle="AppButtonStyle.Outlined"
                                       Disabled="@(_saving || ReadOnly)"
                                       OnClick="ChooseImportFolderAsync" />
                        </div>
                    }
                </header>

                @if (!string.IsNullOrWhiteSpace(_notice))
                {
                    <AppAlert Tone="AppUiTone.Warning">@_notice</AppAlert>
                }

                @if (ImportStatus.Configured)
                {
                    <div class="library-folders__table" role="table" aria-label="@L["Common_ImportFolder"].Value">
                        <div class="library-folders__table-head" role="row">
                            <span role="columnheader">@L["Common_Folder"]</span>
                            <span role="columnheader">@L["LibraryFoldersPanel_Handling"]</span>
                            <span role="columnheader"></span>
                        </div>
                        <div class="library-folders__table-row" role="row">
                            <div class="library-folders__name" role="cell">
                                <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Folder" />
                                <span class="library-folders__name-text">
                                    <strong>@L["Common_ImportFolder"]</strong>
                                    <span class="library-folders__path" title="@ImportStatus.Path">@ImportStatus.Path</span>
                                </span>
                            </div>
                            <div role="cell"><span class="library-folders__chip">@L["Common_Import"]</span></div>
                            <div class="library-folders__row-actions" role="cell">
                                <AppButton Label="@L["LibraryFoldersPanel_Change"].Value" ButtonStyle="AppButtonStyle.Outlined" Disabled="@(_saving || ReadOnly)" OnClick="ChooseImportFolderAsync" />
                                <AppButton Label="@L["Common_Remove"].Value" ButtonStyle="AppButtonStyle.Text" Disabled="@(_saving || ReadOnly)" OnClick="RemoveImportFolderAsync" />
                            </div>
                        </div>
                    </div>

                    <h4 class="library-folders__subheading" id="library-import-destinations">@L["LibraryFoldersPanel_WhereImportedFilesGo"]</h4>
                    <ul class="library-folders__destinations" aria-labelledby="library-import-destinations">
                        @foreach (var destination in ImportStatus.Destinations)
                        {
                            var type = TypeForDestination(destination);
                            var message = WaitingMessageFor(destination);
                            var unavailable = DestinationUnavailable(destination);
                            <li class="library-folders__destination">
                                <strong class="library-folders__destination-type">@destination.MediaType</strong>
                                @if (string.IsNullOrWhiteSpace(destination.DestinationSourceId))
                                {
                                    <span class="library-folders__destination-path">@L["LibraryFoldersPanel_AddAManagedFolderTo", destination.MediaType]</span>
                                    @if (type is not null)
                                    {
                                        <span class="library-folders__choose">
                                            <AppButton Label="@L["Common_Choose"].Value"
                                                       ButtonStyle="AppButtonStyle.Outlined"
                                                       Disabled="@_saving"
                                                       aria-label="@($"Choose a managed folder for {destination.MediaType}")"
                                                       OnClick="@(() => ChooseDestinationType(type))" />
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="library-folders__destination-path" title="@destination.Path">&rarr; @DestinationName(destination) &middot; @destination.Path</span>
                                    @if (unavailable)
                                    {
                                        <span class="library-folders__status library-folders__status--warning">@L["LibraryFoldersPanel_FolderUnavailable"]</span>
                                    }
                                }
                                @if (!string.IsNullOrWhiteSpace(message))
                                {
                                    <span class="library-folders__destination-note">@message</span>
                                }
                            </li>
                        }
                    </ul>

                    @if (LibraryFolderTable.HasMergeAction)
                    {
                        <p class="library-folders__hint library-folders__hint--merge">@L["LibraryFoldersPanel_ToBringInAWhole"]</p>
                    }
                }
            </AppCard>
        }
        else
        {
            <AppCard Class="library-folders__detail">
                @* Dropping files on this type's page puts them in the Import folder (Library setup D44). *@
                <LibraryUploadZone Kinds="@Kinds"
                                   Configuration="@_configuration"
                                   Type="@_selected"
                                   ReadOnly="@(ReadOnly || HostOwnsActions)"
                                   FolderAdded="@(EventCallback.Factory.Create(this, FolderAddedAsync))">
                @* The type's name is already the selected entry in the list on the left, so the pane starts with the folders. *@
                @if (!string.IsNullOrWhiteSpace(_notice))
                {
                    <AppAlert Tone="AppUiTone.Warning">@_notice</AppAlert>
                }

                @if (ShowNamedLibraries)
                {
                    @* A kind that holds several named libraries (D51): one section each, its name with a pencil to rename it, then its folders. *@
                    @foreach (var library in NamedLibraries)
                    {
                        <section class="library-folders__library" data-library="@library.Id" aria-label="@NameOf(library)">
                            <header class="library-folders__detail-header">
                                <div>
                                    <h3>@NameOf(library)</h3>
                                </div>
                                <div class="library-folders__detail-actions">
                                    <AppIconButton Icon="@AppMaterialIcons.Outlined.Edit"
                                                   Tooltip="@L["Common_Rename"].Value"
                                                   AriaLabel="@($"Rename {NameOf(library)}")"
                                                   Disabled="@(_saving || ReadOnly)"
                                                   OnClick="@(() => RenameLibraryAsync(library))" />
                                    @UnmatchedBar(library)
                                </div>
                            </header>
                            @LibraryBody(library, library.Id == BinLibraryId)
                        </section>
                    }
                }
                else
                {
                    @if (SelectedLibrary is { UnmatchedCount: > 0 })
                    {
                        <div class="library-folders__detail-actions">@UnmatchedBar(SelectedLibrary)</div>
                    }

                    @LibraryBody(SelectedLibrary, true)
                }
                </LibraryUploadZone>
            </AppCard>
        }

    }
</div>

@code {
    // The import folder is the storage location with this id (see ImportFolderRules in the Engine).
    private const string ImportLocationId = "incoming";

    private IReadOnlyList<LibraryTypeOption> LibraryTypes => Kinds.Types;

    /// <summary>The Engine's list of library kinds; the Advanced tabs and the folder table are drawn from it.</summary>
    [Parameter, EditorRequired] public LibraryKindCatalog Kinds { get; set; } = default!;

    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>Raised by a folder's "Move to Vault" menu entry; the entry is drawn only when the host sets this (server administrators, ordinary libraries).</summary>
    [Parameter] public EventCallback<LibrarySourceDto> OnMoveToVault { get; set; }

    /// <summary>Raised by a Vault folder's "Move out of the Vault" menu entry; drawn only when the host sets this.</summary>
    [Parameter] public EventCallback<LibrarySourceDto> OnMoveOutOfVault { get; set; }
    /// <summary>The type to show (a standard key or "import").</summary>
    [Parameter] public string? TypeKey { get; set; }
    /// <summary>Raised after any saved change so the host can refresh its own state.</summary>
    [Parameter] public EventCallback Changed { get; set; }
    /// <summary>Shows this one library (by its Id) instead of the kind's libraries: a library page holds one library, even when its kind holds several.</summary>
    [Parameter] public string? LibraryId { get; set; }
    /// <summary>The host draws Add folder and Add files itself and wraps this panel in its own upload zone, so the panel draws neither.</summary>
    [Parameter] public bool HostOwnsActions { get; set; }
    /// <summary>The folder just added on a library page: its row is pointed at.</summary>
    [Parameter] public string? HighlightSourceId { get; set; }

    private LibrariesConfigurationDto? _configuration;
    private string _baseline = string.Empty;
    private string? _loadError;
    private string? _notice;
    private bool _loading = true;
    private bool _saving;
    private LibraryTypeOption _selected = ImportEntry;
    private bool _unknownType;
    private IReadOnlyDictionary<string, string> _pathIssues = new Dictionary<string, string>();
    // False until the live folder check has answered, so the table claims no access word before then.
    private bool _pathsChecked;
    // Titles the catalogue holds for each folder of a library page's library (the Titles column); null until read.
    private IReadOnlyDictionary<string, int>? _titles;

    // The seventh entry in the list is not a media type; it has its own panel.
    private static readonly LibraryTypeOption ImportEntry = new("import", "Import folder", "import", string.Empty, [], AppMaterialIcons.Outlined.MoveToInbox);
    private bool ImportSelected => string.Equals(_selected.Key, ImportEntry.Key, StringComparison.Ordinal);
    private ImportFolderWaitingResponse? _waiting;

    private ImportFolderStatusDto ImportStatus => _configuration?.ImportFolderStatus ?? new ImportFolderStatusDto();

    private LibraryTypeOption Selected => _selected;

    private const string PhoneNote = "Add or change folders on a computer or tablet.";
    private LibraryFolderDto? SelectedLibrary => LibraryFor(_selected);

    protected override async Task OnInitializedAsync()
    {
        _selected = LibraryTypes.FirstOrDefault() ?? ImportEntry;
        await LoadAsync();
        // The host's address names the type; an unknown name shows a small state instead of a different type.
        var chosen = string.IsNullOrWhiteSpace(LibraryId) ? ResolveTypeKey(TypeKey) : ResolveLibrary(LibraryId);
        _unknownType = chosen is null;
        if (chosen is not null) _selected = chosen;

        await InvokeAsync(StateHasChanged);
        await RefreshPathIssuesAsync();
        await RefreshTitlesAsync();
        await RefreshWaitingAsync();
        await RefreshJobsAsync();
    }

    // The Titles column of a library page's folder table: one read per library, after load and after a save.
    private async Task RefreshTitlesAsync()
    {
        if (!HostOwnsActions || SelectedLibrary is not { } library) return;
        var counts = await ApiClient.GetLibraryFolderTitlesAsync(library.Id);
        if (counts is null) return;
        _titles = counts.Counts;
        await InvokeAsync(StateHasChanged);
    }

    // Live read/write check of every folder; a problem shows as one status line under the path, nothing when healthy.
    private async Task RefreshPathIssuesAsync()
    {
        if (_configuration is null) return;
        _pathIssues = await LibraryFolderHealth.CheckAsync(_configuration, path => Orchestrator.TestPathAsync(path));
        _pathsChecked = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _configuration = await Orchestrator.GetLibrariesAsync();
        _loadError = _configuration is null ? ApiClient.LastError : null;
        _baseline = _configuration is null ? string.Empty : JsonSerializer.Serialize(_configuration);
        _loading = false;
    }

    private LibraryFolderDto? LibraryFor(LibraryTypeOption type) => LibraryRollup.LibraryFor(_configuration, type);

    private LibraryFolderDto? PrimaryLibraryFor(LibraryTypeOption type) => LibraryRollup.PrimaryLibraryFor(_configuration, type);

    // Libraries that are not the one library of a standard type (an older custom type, or a second library of a standard
    // type) still show here, so their folders can be seen and removed instead of silently hiding.
    private IReadOnlyList<LibraryTypeOption> OtherLibraries => LibraryRollup.OtherLibraries(Kinds, _configuration);

    // One library by its Id: its kind with the library's own name and Id, so the folders shown are this library's alone.
    private LibraryTypeOption? ResolveLibrary(string id)
    {
        var library = _configuration?.Libraries.FirstOrDefault(item => LibraryRollup.IsCatalogued(item) && string.Equals(item.Id, id, StringComparison.OrdinalIgnoreCase));
        if (library is null) return null;
        var type = LibraryListing.TypeOf(Kinds, library);
        var name = string.IsNullOrWhiteSpace(library.Name) ? type.Label : library.Name;
        return type with { Label = name, PluralLabel = name, LibraryId = library.Id };
    }

    private LibraryTypeOption? ResolveTypeKey(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return null;
        if (string.Equals(key, ImportEntry.Key, StringComparison.OrdinalIgnoreCase)) return ImportEntry;
        return LibraryTypes.FirstOrDefault(type => string.Equals(type.Key, key, StringComparison.OrdinalIgnoreCase))
            ?? OtherLibraries.FirstOrDefault(type => string.Equals(type.Key, key, StringComparison.OrdinalIgnoreCase));
    }

    // Choose on an Import line jumps to the page of the library that holds that type and points at its Add folder; a type with no
    // library yet goes to the overview, where Add library creates one.
    private void ChooseDestinationType(LibraryTypeOption type) => Navigation.NavigateTo(PrimaryLibraryFor(type) is { } library
        ? LibraryListing.AddressOf(library.Id) + "?highlight=add"
        : LibraryListing.OverviewAddress(null));

    private LibraryTypeOption? TypeForDestination(ImportFolderDestinationDto destination) => LibraryTypes.FirstOrDefault(type =>
        string.Equals(type.Label, destination.MediaType, StringComparison.OrdinalIgnoreCase)
        || type.MediaTypes.Contains(destination.MediaType, StringComparer.OrdinalIgnoreCase));

    private ImportFolderWaitingDto? WaitingFor(ImportFolderDestinationDto destination) =>
        _waiting?.Waiting.FirstOrDefault(item => string.Equals(item.MediaType, destination.MediaType, StringComparison.OrdinalIgnoreCase));

    // The Engine's one plain sentence for a type whose files cannot be filed yet; nothing when it has none.
    private string? WaitingMessageFor(ImportFolderDestinationDto destination) => WaitingFor(destination)?.Message;

    private bool DestinationUnavailable(ImportFolderDestinationDto destination) =>
        string.Equals(WaitingFor(destination)?.Reason, "folder_unavailable", StringComparison.OrdinalIgnoreCase)
        || (!string.IsNullOrWhiteSpace(destination.Path) && _pathIssues.TryGetValue(destination.Path, out var issue) && issue == "Folder unavailable");

    private string DestinationName(ImportFolderDestinationDto destination) =>
        _configuration?.Libraries.SelectMany(library => library.Sources).FirstOrDefault(source => source.Id == destination.DestinationSourceId)?.DisplayName()
        ?? destination.MediaType;

    // The picker starts on a folder named Import beside Tuvima's own library folder, so accepting it is one click.
    private string? SuggestedImportPath
    {
        get
        {
            var path = _configuration?.StorageLocations.FirstOrDefault(location => string.Equals(location.Id, "media", StringComparison.OrdinalIgnoreCase))?.Path;
            if (string.IsNullOrWhiteSpace(path)) return null;
            var trimmed = path.TrimEnd('\\', '/');
            var cut = trimmed.LastIndexOfAny(['\\', '/']);
            return cut <= 0 ? null : $"{trimmed[..(cut + 1)]}Import";
        }
    }

    private async Task RefreshWaitingAsync()
    {
        if (!ImportStatus.Configured)
        {
            _waiting = null;
            return;
        }

        _waiting = await ApiClient.GetImportFolderWaitingAsync();
        await InvokeAsync(StateHasChanged);
    }
    private static bool IsManaged(LibrarySourceDto source) => source.ManagementMode == "managed_by_tuvima";
    private Task<ServerFolderValidationResultDto?> ValidateAsync(string path, string mode, string? sourceId = null) =>
        AddService.ValidateAsync(Scope, path, mode, sourceId);

    // A folder was added from a drop that needed a new library: the table and the checks are read again.
    private async Task FolderAddedAsync()
    {
        await InvokeAsync(async () =>
        {
            await ReloadConfigurationAsync();
            await Changed.InvokeAsync();
            await RefreshPathIssuesAsync();
            await RefreshWaitingAsync();
            await RefreshJobsAsync();
        });
    }

    private bool IsVideosSelected => _selected.MediaTypes.Contains("Videos", StringComparer.OrdinalIgnoreCase);

    private static FolderAddScope Scope => FolderAddScope.Settings;

    // Row menu "Merge into": choose the managed folder and Copy or Move, look at a preview, then queue the merge job.
    private async Task MergeIntoAsync(LibrarySourceDto source)
    {
        var library = LibraryHolding(source);
        if (library is null || _saving) return;
        await AfterFollowUpAsync(await AddService.MergeIntoAsync(Scope, library, source));
    }

    // Row menu "Change what this folder is" (and the paused first-check line): the dialog asks what the folder is instead, shows the impact and queues the job.
    private async Task ChangeKindAsync(LibrarySourceDto source)
    {
        var library = LibraryHolding(source);
        if (library is null || _configuration is null || _saving || ReadOnly) return;
        await AfterFollowUpAsync(await AddService.ChangeKindAsync(Scope, Kinds, _configuration, library, source));
    }

    // A follow-up that queued a job reloads the folders and starts watching the job; anything it has to say stays on screen.
    private async Task AfterFollowUpAsync(FolderFollowUp followUp)
    {
        if (followUp.Notice is not null) _notice = followUp.Notice;
        if (!followUp.Started) return;
        await ReloadConfigurationAsync();
        await RefreshJobsAsync();
        await Changed.InvokeAsync();
    }

    // Tapping Handling. Read-only to Managed asks honestly first and then queues the organising job (the setup wizard has no files to
    // organise yet, so it keeps the plain switch); Managed to Read-only also asks, and stops any job that is running.
    private async Task ChangeModeAsync(LibrarySourceDto source)
    {
        var library = Clone(LibraryHolding(source));
        var target = library?.Sources.FirstOrDefault(item => item.Id == source.Id);
        if (library is null || target is null || _saving) return;
        var managed = !IsManaged(target);
        if (managed)
        {
            await ConvertToManagedAsync(library, target);
            return;
        }

        var confirmed = managed
            ? await DialogService.ShowMessageBoxAsync(
                $"Let Library manage {target.Path}?",
                "Library may rename and reorganise files in this folder, which could affect other applications that use it.",
                yesText: "Let Library manage it", cancelText: "Keep read-only")
            : await DialogService.ShowMessageBoxAsync(
                $"Use {target.Path} as read-only?",
                "Library will stop organising this folder, and any organising that is running stops. Files already renamed keep their new names; nothing is undone and nothing else on disk changes.",
                yesText: "Use read-only", cancelText: "Keep managed");
        if (confirmed != true) return;
        await ApplyModeAsync(library, target, managed);
    }

    // The plain mode switch: validate the folder for the new mode, then save it.
    private async Task ApplyModeAsync(LibraryFolderDto library, LibrarySourceDto target, bool managed)
    {
        var validation = await ValidateAsync(target.Path, managed ? ServerFolderSelectionModes.ManagedLibrary : ServerFolderSelectionModes.ExistingLibrary, target.Id);
        if (validation is null || !validation.CanSelect)
        {
            _notice = validation?.Issues.FirstOrDefault()?.Message ?? ApiClient.LastError ?? "This folder does not meet the access needed for that choice.";
            return;
        }

        // The Engine keeps or re-picks the library's destination when it saves.
        target.ManagementMode = managed ? "managed_by_tuvima" : "existing_library";
        target.AccessMode = managed ? "writable" : "read_only";
        if (!managed)
        {
            target.ConversionState = "none";
            target.ConversionOperationId = null;
        }
        await SaveAsync(library, managed ? "Library will now manage this folder." : "This folder will be used as read-only.");
    }

    // Read-only to Managed for a folder in the signed-in Settings: count what is there, ask, then let the Engine convert it.
    private async Task ConvertToManagedAsync(LibraryFolderDto library, LibrarySourceDto target)
    {
        var validation = await ValidateAsync(target.Path, ServerFolderSelectionModes.ManagedLibrary, target.Id);
        if (validation is null || !validation.CanSelect)
        {
            _notice = validation?.Issues.FirstOrDefault()?.Message ?? ApiClient.LastError ?? "This folder does not meet the access needed for that choice.";
            return;
        }

        var quick = await ApiClient.PreviewFolderConversionAsync(new FolderConversionPreviewRequest { SourceId = target.Id, Quick = true });
        if (quick is null)
        {
            _notice = ApiClient.LastError ?? "Library could not count the files in this folder, so it was not changed.";
            return;
        }

        if (quick.TotalFiles == 0)
        {
            var plain = await DialogService.ShowMessageBoxAsync(
                $"Let Library manage {target.Path}?",
                "There are no media files in this folder yet. Library will name and organise the files it adds here from now on.",
                yesText: "Let Library manage it", cancelText: "Keep read-only");
            if (plain == true) await ApplyModeAsync(library, target, managed: true);
            return;
        }

        if (await AskToConvertAsync(target, quick, alreadyManaged: false)) await StartConversionAsync(target);
    }

    private Task<bool> AskToConvertAsync(LibrarySourceDto target, FolderConversionPreviewResponse quick, bool alreadyManaged) =>
        AddService.AskToConvertAsync(target, quick, alreadyManaged);

    // Queues the organising job for a folder, makes it Managed in the same step, and starts watching its progress.
    private async Task StartConversionAsync(LibrarySourceDto source)
    {
        if (_saving) return;
        _saving = true;
        FolderFollowUp followUp;
        try { followUp = await AddService.StartConversionAsync(source); }
        finally { _saving = false; }
        await AfterFollowUpAsync(followUp);
    }

    // Row menu "Organise files now", and the offer after adding a folder that already has files.
    private async Task OrganiseNowAsync(LibrarySourceDto source) => await OfferOrganiseAsync(source, alreadyManaged: true, quiet: false);

    private async Task OfferOrganiseAsync(LibrarySourceDto source, bool alreadyManaged, bool quiet)
    {
        if (_saving) return;
        await AfterFollowUpAsync(await AddService.OfferOrganiseAsync(Scope, source, alreadyManaged, quiet));
    }

    // Tapping the New media radio on another managed folder moves the marker. It only affects future imports and uploads.
    private async Task SetDestinationAsync(LibrarySourceDto source)
    {
        var current = LibraryHolding(source);
        var target = current?.Sources.FirstOrDefault(item => item.Id == source.Id);
        if (current is null || target is null || _saving || !IsManaged(target)) return;
        await SaveAsync(LibraryFolderAddService.WithDestination(current, target.Id), $"New {Selected.PluralLabel} will go to {target.DisplayName()}.");
    }

    private async Task LabelFolderAsync(LibrarySourceDto source)
    {
        var library = Clone(LibraryHolding(source));
        var target = library?.Sources.FirstOrDefault(item => item.Id == source.Id);
        if (library is null || target is null || _saving) return;
        var dialog = await DialogService.ShowAsync<LibraryTextEditDialog>(string.Empty, new AppDialogParameters<LibraryTextEditDialog>
        {
            { component => component.Label, "Folder label" },
            { component => component.Value, target.DisplayName() },
        }, new AppDialogOptions { NoHeader = true, FullWidth = true, MaxWidth = AppMaxWidth.Small });
        if (await dialog.Result is not { Canceled: false, Data: string label }) return;
        target.Notes = label;
        await SaveAsync(library, "Label saved.");
    }

    private async Task ChooseImportFolderAsync()
    {
        if (_configuration is null || _saving) return;
        _notice = null;
        var parameters = new AppDialogParameters<ServerFolderPicker>
        {
            { component => component.SelectionMode, ServerFolderSelectionModes.ManagedLibrary },
            { component => component.CurrentSourceId, ImportLocationId },
            { component => component.InitialPath, ImportStatus.Configured ? ImportStatus.Path : SuggestedImportPath },
            { component => component.HelpText, "Choose a folder on the Library server where new media will be dropped. It must be separate from your library folders." },
        };
        var dialog = await DialogService.ShowAsync<ServerFolderPicker>(string.Empty, parameters, new AppDialogOptions
        {
            MaxWidth = AppMaxWidth.ExtraExtraLarge,
            FullWidth = false,
            CloseButton = false,
            CloseOnEscapeKey = true,
        });
        if (await dialog.Result is not { Canceled: false, Data: ServerFolderValidationResultDto selected }) return;
        await SaveImportFolderAsync(selected.Path, "Import folder saved.");
    }

    private async Task RemoveImportFolderAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove the import folder?",
            "Library stops importing from it. Files in the folder stay on disk.",
            yesText: "Remove", cancelText: "Keep");
        if (confirmed == true) await SaveImportFolderAsync(null, "Import folder removed.");
    }

    private Task SaveImportFolderAsync(string? path, string message) => PutAsync(baseline =>
    {
        var locations = baseline.StorageLocations
            .Where(location => !string.Equals(location.Id, ImportLocationId, StringComparison.OrdinalIgnoreCase))
            .ToList();
        if (path is not null)
        {
            locations.Add(new ServerStorageLocationDto { Id = ImportLocationId, Label = "Library import folder", Path = path, AllowWrite = true });
        }

        return new UpdateLibrariesRequest
        {
            SchemaVersion = baseline.SchemaVersion,
            StorageLocations = locations,
            ViewStorage = baseline.ViewStorage,
            Libraries = baseline.Libraries,
            PersonalLibraryPolicy = baseline.PersonalLibraryPolicy,
            FileHandling = baseline.FileHandling,
        };
    }, message);

    // Saves a whole-configuration change (import folder, file handling) and adopts the Engine's answer.
    private async Task PutAsync(Func<LibrariesConfigurationDto, UpdateLibrariesRequest> build, string message)
    {
        if (_configuration is null || _saving) return;
        _saving = true;
        try
        {
            var baseline = JsonSerializer.Deserialize<LibrariesConfigurationDto>(_baseline)!;
            var request = build(baseline);
            var saved = await ApiClient.UpdateLibrariesAsync(request);
            if (saved is null)
            {
                _notice = ApiClient.LastError ?? "That change could not be saved. Check it and try again.";
                return;
            }
            _configuration = saved;
            _baseline = JsonSerializer.Serialize(saved);
            Snackbar.Add(message, AppSeverity.Success);
        }
        finally { _saving = false; }
        await Changed.InvokeAsync();
        await RefreshWaitingAsync();
    }

    private async Task RemoveFolderAsync(LibrarySourceDto source)
    {
        var library = Clone(LibraryHolding(source));
        if (library is null || _saving) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove this folder?",
            $"{source.DisplayName()} stops being part of {NameOf(library)}. Your files stay on disk."
                + (IsVideosSelected ? " To move it to Photos and personal videos, remove it here and add it again there; folders are never moved automatically." : string.Empty),
            yesText: "Remove", cancelText: "Keep");
        if (confirmed != true) return;
        library.Sources.RemoveAll(item => item.Id == source.Id);
        await SaveAsync(library, "Folder removed.");
    }

    // Keep going on a paused folder (Library setup D35): identification resumes, files that do not match stay Unmatched and are tried again
    // later. The question was answered by the paused line itself, so it does not ask again; the rows are read again to drop the line.
    private async Task KeepGoingAsync(LibrarySourceDto source)
    {
        if (_saving) return;
        // Busy while the request runs, so a double click sends one.
        _saving = true;
        try
        {
            if (!await ApiClient.KeepGoingAsync(source.Id))
            {
                _notice = ApiClient.LastError ?? "That could not be done. Try again in a moment.";
                return;
            }

            Snackbar.Add($"Carrying on with {source.DisplayName()}. Files that don't match stay as they are and are tried again later.", AppSeverity.Success);
            await ReloadConfigurationAsync();
            await Changed.InvokeAsync();
        }
        finally { _saving = false; }
    }

    // The folder's Scan switch (and Pause or Resume scanning in its menu): saved straight away through the folder save. What is already
    // catalogued from a paused folder stays; only new scans and watching stop.
    private async Task SetScanAsync(LibraryFolderGrid.ScanChange change)
    {
        var library = Clone(LibraryHolding(change.Source));
        var target = library?.Sources.FirstOrDefault(item => item.Id == change.Source.Id);
        if (library is null || target is null || _saving || ReadOnly) return;
        target.ScanEnabled = change.Value;
        await SaveAsync(library, change.Value
            ? $"Scanning {target.DisplayName()} again."
            : $"Scanning paused for {target.DisplayName()}. What is already in your library stays.");
    }

    // Override file handling for this folder: the small dialog answers, the folder's override is saved through the same folder save.
    private async Task OverrideFileHandlingAsync(LibrarySourceDto source)
    {
        var library = Clone(LibraryHolding(source));
        var target = library?.Sources.FirstOrDefault(item => item.Id == source.Id);
        if (library is null || target is null || _saving || ReadOnly) return;
        var dialog = await DialogService.ShowAsync<FolderFileHandlingDialog>(string.Empty, new AppDialogParameters<FolderFileHandlingDialog>
        {
            { component => component.Current, target.FileHandlingOverride },
            { component => component.FolderName, target.DisplayName() },
        }, new AppDialogOptions { NoHeader = true, FullWidth = true, MaxWidth = AppMaxWidth.Small });
        if (await dialog.Result is not { Canceled: false, Data: FolderFileHandlingDialog.Answer answer }) return;
        target.FileHandlingOverride = answer.Override;
        await SaveAsync(library, answer.Override is null
            ? $"{target.DisplayName()} follows the library's file handling."
            : $"File handling saved for {target.DisplayName()}.");
    }

    private async Task SetRecycleBinAsync(LibraryFolderDto source, bool value)
    {
        var library = Clone(source);
        if (library is null || _saving) return;
        library.RecycleBin = value;
        await SaveAsync(library, value ? "Deleted files now go to the recycle bin." : "Deleted files are removed straight away.");
    }

    private async Task SetRecycleBinDaysAsync(LibraryFolderDto source, int days)
    {
        var library = Clone(source);
        if (library is null || _saving) return;
        library.RecycleBinDays = Math.Clamp(days, 0, 3650);
        await SaveAsync(library, library.RecycleBinDays == 0
            ? "Deleted files stay in the recycle bin until it is emptied."
            : $"Deleted files stay in the recycle bin for {library.RecycleBinDays} days.");
    }

    private async Task<bool> SaveAsync(LibraryFolderDto library, string message)
    {
        if (_configuration is null || _saving) return false;
        _saving = true;
        try
        {
            var baseline = JsonSerializer.Deserialize<LibrariesConfigurationDto>(_baseline)!;
            var saved = await AddService.SaveLibraryAsync(Scope, baseline, library);
            if (saved is null)
            {
                _notice = ApiClient.LastError ?? "That change could not be saved. Check the folder and try again.";
                return false;
            }
            _configuration = saved;
            _baseline = JsonSerializer.Serialize(saved);
            Snackbar.Add(message, AppSeverity.Success);
        }
        finally { _saving = false; }
        await Changed.InvokeAsync();
        await RefreshPathIssuesAsync();
        await RefreshTitlesAsync();
        await RefreshWaitingAsync();
        await RefreshJobsAsync();
        return true;
    }

    // ── Folder jobs (converting a folder to Managed) ───────────────────────────────────────────────────────────

    private IReadOnlyDictionary<string, FolderJobStatusDto> _jobs = new Dictionary<string, FolderJobStatusDto>();
    private CancellationTokenSource? _pollCancellation;
    private bool _polling;

    // Reads the saved configuration again without the loading flash (the conversion state changes when a job starts or ends).
    private async Task ReloadConfigurationAsync()
    {
        var fresh = await Orchestrator.GetLibrariesAsync();
        if (fresh is null) return;
        _configuration = fresh;
        _baseline = JsonSerializer.Serialize(fresh);
        await InvokeAsync(StateHasChanged);
    }

    // Asks the Engine for the folder jobs. A job that has just ended gets a toast with a link to its log, and the folder rows are
    // refreshed because the Engine has flipped the folder from Converting to Managed. Polling continues only while a job is open.
    private async Task RefreshJobsAsync()
    {
        if (_configuration is null) return;
        var list = await ApiClient.GetFolderJobsAsync();
        var previous = _jobs;
        var latest = new Dictionary<string, FolderJobStatusDto>(StringComparer.OrdinalIgnoreCase);
        foreach (var job in list.OrderBy(item => FolderJobFormat.IsOpen(item) ? 0 : 1))
        {
            latest.TryAdd(job.SourceId, job);
        }

        var justEnded = latest.Values.Where(job => !FolderJobFormat.IsOpen(job)
            && previous.TryGetValue(job.SourceId, out var before)
            && string.Equals(before.OperationId, job.OperationId, StringComparison.OrdinalIgnoreCase)
            && FolderJobFormat.IsOpen(before)).ToList();
        _jobs = latest;
        await InvokeAsync(StateHasChanged);

        foreach (var job in justEnded)
        {
            AnnounceEnded(job);
        }

        if (justEnded.Count > 0)
        {
            await ReloadConfigurationAsync();
            await Changed.InvokeAsync();
        }

        if (latest.Values.Any(FolderJobFormat.IsOpen)) EnsurePolling();
    }

    private void AnnounceEnded(FolderJobStatusDto job)
    {
        var folder = _configuration?.Libraries.SelectMany(library => library.Sources).FirstOrDefault(item => item.Id == job.SourceId);
        var name = folder?.DisplayName() ?? "the folder";
        var text = job.State == "failed"
            ? $"{(FolderJobFormat.IsMerge(job) ? "Merging" : "Organising")} {name} stopped. {job.Message}"
            : $"{name}: {job.Message}";
        Snackbar.Add(text, job.State == "failed" ? AppSeverity.Error : AppSeverity.Success, options =>
        {
            options.RequireInteraction = true;
            if (!job.HasLog) return;
            options.Action = "Download log";
            options.OnClick = _ =>
            {
                Navigation.NavigateTo($"/engine-folder-log/{job.OperationId}", forceLoad: true);
                return Task.CompletedTask;
            };
        });
    }

    private void EnsurePolling()
    {
        if (_polling || _disposed) return;
        _polling = true;
        _pollCancellation = new CancellationTokenSource();
        _ = PollJobsAsync(_pollCancellation.Token);
    }

    private async Task PollJobsAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(RefreshJobsAsync);
                if (!_jobs.Values.Any(FolderJobFormat.IsOpen)) break;
            }
        }
        catch (OperationCanceledException)
        {
            // The page was closed; there is nothing left to refresh.
        }
        finally { _polling = false; }
    }

    // Pause, Resume and Cancel on a folder's job. Cancel asks first, because it ends the work for good.
    private async Task ControlJobAsync(LibraryFolderTable.FolderJobControl request)
    {
        if (request.Action == "cancel")
        {
            var merging = FolderJobFormat.IsMerge(request.Job);
            var confirmed = merging
                ? await DialogService.ShowMessageBoxAsync(
                    $"Stop merging {request.Source.DisplayName()}?",
                    "What was already copied stays in the target folder, and the rest stays in this folder. Nothing is undone. The log lists what remains.",
                    yesText: "Stop merging", cancelText: "Keep going")
                : await DialogService.ShowMessageBoxAsync(
                    $"Stop organising {request.Source.DisplayName()}?",
                    "The folder stays Managed with the work done so far. Files already renamed keep their new names, and the rest will be tidied gradually by normal scans.",
                    yesText: "Stop organising", cancelText: "Keep going");
            if (confirmed != true) return;
        }

        var updated = await ApiClient.ControlFolderJobAsync(request.Job.OperationId, request.Action);
        if (updated is null)
        {
            _notice = ApiClient.LastError ?? "That could not be done. The job may already have finished.";
        }

        await RefreshJobsAsync();
        if (request.Action == "cancel") await ReloadConfigurationAsync();
    }

    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        _pollCancellation?.Cancel();
        _pollCancellation?.Dispose();
    }


    // One library's folders and settings: its folder table (or the empty state), then the switches and lists under it.
    // The recycle bin list is not per library, so it is drawn once, with the first library that has the bin on (showBin).
    private RenderFragment LibraryBody(LibraryFolderDto? library, bool showBin) => __builder =>
    {
        if (library is null || library.Sources.Count == 0)
        {
            <div class="library-folders__empty">
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FolderOpen" />
                <strong>No folders yet</strong>
                <span class="library-folders__empty-action">Choose Add Folder to point Library at where your @Selected.PluralLabel live.</span>
            </div>
        }
        else
        {
            @if (HostOwnsActions)
            {
                <LibraryFolderGrid Library="@library"
                                   PluralLabel="@Selected.PluralLabel"
                                   ReadOnly="@ReadOnly"
                                   Busy="@_saving"
                                   PathIssues="@_pathIssues"
                                   PathsChecked="@_pathsChecked"
                                   Titles="@_titles"
                                   HighlightSourceId="@HighlightSourceId"
                                   Jobs="@_jobs"
                                   OnJobControl="ControlJobAsync"
                                   OnSetDestination="SetDestinationAsync"
                                   OnSetScan="SetScanAsync"
                                   OnOverride="OverrideFileHandlingAsync"
                                   OnChangeKind="@(EventCallback.Factory.Create<LibrarySourceDto>(this, ChangeKindAsync))"
                                   OnRemove="RemoveFolderAsync"
                                   OnChangeHandling="ChangeModeAsync"
                                   OnLabel="LabelFolderAsync"
                                   OnOrganiseNow="OrganiseNowAsync"
                                   OnMerge="MergeIntoAsync"
                                   OnMoveToVault="@OnMoveToVault"
                                   OnMoveOutOfVault="@OnMoveOutOfVault"
                                   OnKeepGoing="@(EventCallback.Factory.Create<LibrarySourceDto>(this, KeepGoingAsync))" />
            }
            else
            {
            <LibraryFolderTable Library="@library"
                                TypeLabel="@Selected.Label"
                                PluralLabel="@Selected.PluralLabel"
                                ReadOnly="@ReadOnly"
                                Busy="@_saving"
                                PathIssues="@_pathIssues"
                                OnChangeHandling="ChangeModeAsync"
                                OnSetDestination="SetDestinationAsync"
                                OnLabel="LabelFolderAsync"
                                OnRemove="RemoveFolderAsync"
                                OnKeepGoing="@(EventCallback.Factory.Create<LibrarySourceDto>(this, KeepGoingAsync))"
                                Jobs="@_jobs"
                                OnJobControl="ControlJobAsync"
                                OnOrganiseNow="OrganiseNowAsync"
                                OnMerge="MergeIntoAsync"
                                OnChangeKind="@(EventCallback.Factory.Create<LibrarySourceDto>(this, ChangeKindAsync))" />
            }
            if (!library.Sources.Any(IsManaged))
            {
                <p class="library-folders__hint">Add a managed folder to import or upload @Selected.PluralLabel.</p>
            }
        }

        // Shown even when the last folder has been removed: files that stayed on disk can still be listed and added back.
        if (library is not null)
        {
            <ExcludedFilesSection LibraryId="@library.Id" ReadOnly="@ReadOnly" />
        }

        // Pinned to the bottom of the pane, so the switch sits in the same place for every library. What is in the bin lists above it.
        if (library is not null)
        {
            <div class="library-folders__recycle">
                @if (library.RecycleBin && showBin)
                {
                    <RecycleBinSection />
                }
                <AppSwitchRow Label="Recycle bin"
                              Icon="@AppMaterialIcons.Outlined.DeleteOutline"
                              Description="Deleted files wait in a recycle bin inside Library's data folder instead of being removed straight away. You can put them back, or empty the bin."
                              Value="@library.RecycleBin"
                              Disabled="@(_saving || ReadOnly)"
                              ValueChanged="@((bool value) => SetRecycleBinAsync(library, value))" />
                @if (library.RecycleBin)
                {
                    <AppNumericField Label="Keep deleted files for (days, 0 keeps them until the bin is emptied)"
                                     Value="@library.RecycleBinDays" Min="0" Max="3650"
                                     Disabled="@(_saving || ReadOnly)"
                                     ValueChanged="@((int value) => SetRecycleBinDaysAsync(library, value))" />
                }
            </div>
        }
    };

    // The amber Unmatched count with Retry now and Keep all as they are.
    private RenderFragment UnmatchedBar(LibraryFolderDto library) => __builder =>
    {
        if (library.UnmatchedCount <= 0) return;
        <LibraryUnmatchedCount Count="@library.UnmatchedCount" />
        <AppButton Label="Retry now"
                   ButtonStyle="AppButtonStyle.Outlined"
                   Disabled="@(_saving || ReadOnly)"
                   aria-label="@($"Retry now for {NameOf(library)}")"
                   OnClick="@(() => RetryUnmatchedAsync(library))" />
        <AppButton Label="Keep all as they are"
                   ButtonStyle="AppButtonStyle.Text"
                   Disabled="@(_saving || ReadOnly)"
                   aria-label="@($"Keep all unmatched files in {NameOf(library)} as they are")"
                   OnClick="@(() => KeepAllUnmatchedAsync(library))" />
    };

    // The libraries of the selected kind when it holds several named ones and has any; otherwise the one library (or none yet).
    private IReadOnlyList<LibraryFolderDto> NamedLibraries => _selected.AllowsMultiple && _selected.LibraryId is null && !ImportSelected
        ? LibraryRollup.LibrariesOf(_configuration, _selected)
        : [];
    private bool ShowNamedLibraries => NamedLibraries.Count > 0;
    private string? BinLibraryId => NamedLibraries.FirstOrDefault(library => library.RecycleBin)?.Id;

    // A named library reads by its own name; every other library by the type's name, as before.
    private string NameOf(LibraryFolderDto library) => _selected.AllowsMultiple && !string.IsNullOrWhiteSpace(library.Name) ? library.Name : _selected.Label;

    // The library that holds a folder, so every folder action works on its own library when a kind holds several.
    private LibraryFolderDto? LibraryHolding(LibrarySourceDto source) =>
        _configuration?.Libraries.FirstOrDefault(library => library.Sources.Any(item => item.Id == source.Id)) ?? SelectedLibrary;

    // The pencil beside a library's name: the new name is saved through the library change the folders use, and the Engine's refusal
    // (a name already in use, a name that reads as another kind) is shown as it comes.
    private async Task RenameLibraryAsync(LibraryFolderDto library)
    {
        if (_saving) return;
        var copy = Clone(library);
        if (copy is null) return;
        var dialog = await DialogService.ShowAsync<LibraryTextEditDialog>(string.Empty, new AppDialogParameters<LibraryTextEditDialog>
        {
            { component => component.Label, "Library name" },
            { component => component.Value, NameOf(library) },
        }, new AppDialogOptions { NoHeader = true, FullWidth = true, MaxWidth = AppMaxWidth.Small });
        if (await dialog.Result is not { Canceled: false, Data: string name } || string.Equals(name, library.Name, StringComparison.Ordinal)) return;
        _notice = null;
        copy.Name = name;
        await SaveAsync(copy, "Library renamed.");
    }

    // Retry now: the Engine makes the library's Unmatched files due and looks them up in the background.
    private async Task RetryUnmatchedAsync(LibraryFolderDto library)
    {
        if (_saving) return;
        // Busy while the request runs, so a double click sends one.
        _saving = true;
        try
        {
            var result = await ApiClient.RetryUnmatchedLibraryAsync(library.Id);
            await AfterUnmatchedActionAsync(result, affected => $"Trying {affected} again in {NameOf(library)}.");
        }
        finally { _saving = false; }
    }

    // Keep all as they are stops the retries and clears them from the count; it asks first, because it ends the lookups for those files.
    private async Task KeepAllUnmatchedAsync(LibraryFolderDto library)
    {
        if (_saving) return;
        // Busy from the question to the answer, so a double click asks and sends once.
        _saving = true;
        try
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(
                $"Stop trying to match {FilesText(library.UnmatchedCount)} in {NameOf(library)}?",
                "You can look them up again later.",
                yesText: "Keep all as they are", cancelText: "Cancel");
            if (confirmed != true) return;
            var result = await ApiClient.KeepAllUnmatchedLibraryAsync(library.Id);
            await AfterUnmatchedActionAsync(result, affected => $"Kept {affected} in {NameOf(library)} as they are.");
        }
        finally { _saving = false; }
    }

    // The toast says how many files the action touched; the counts are read again.
    private async Task AfterUnmatchedActionAsync(MediaEngine.Contracts.Library.UnmatchedActionResultDto? result, Func<string, string> message)
    {
        if (result is null)
        {
            _notice = ApiClient.LastError ?? "That could not be done. Try again in a moment.";
            return;
        }

        Snackbar.Add(message(FilesText(result.Affected)), AppSeverity.Success);
        await ReloadConfigurationAsync();
        await Changed.InvokeAsync();
    }

    private static string FilesText(int count) => count == 1 ? "1 file" : $"{DisplayFormat.FormatCount(count)} files";

    private static LibraryFolderDto? Clone(LibraryFolderDto? library) => library is null
        ? null
        : JsonSerializer.Deserialize<LibraryFolderDto>(JsonSerializer.Serialize(library));
}
