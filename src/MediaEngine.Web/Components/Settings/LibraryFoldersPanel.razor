    // A naming change applies to files Tuvima adds from now on. When the type already has files in managed folders the person is
    // asked, never surprised with a long job: Apply to existing files now, or Only new files.
    private async Task SaveAdvancedLibraryAsync(LibraryFolderDto library)
    {
        var before = _configuration?.Libraries.FirstOrDefault(item => item.Id == library.Id)?.OrganizationPolicy;
        var namingChanged = before is not null
            && (!string.Equals(before.Mode, library.OrganizationPolicy.Mode, StringComparison.Ordinal)
                || !string.Equals(before.CustomTemplate ?? string.Empty, library.OrganizationPolicy.CustomTemplate ?? string.Empty, StringComparison.Ordinal));
        var saved = await SaveAsync(library, "Saved.");
        if (saved && namingChanged && !Embedded && !ReadOnly) await OfferApplyNamingAsync(library.Id);
    }

    private async Task OfferApplyNamingAsync(string libraryId)
    {
        var library = _configuration?.Libraries.FirstOrDefault(item => item.Id == libraryId);
        var managed = library?.Sources.Where(IsManaged).ToList() ?? [];
        if (library is null || managed.Count == 0) return;

        var files = 0;
        foreach (var folder in managed)
        {
            var quick = await ApiClient.PreviewFolderConversionAsync(new FolderConversionPreviewRequest { SourceId = folder.Id, Quick = true });
            files += quick?.TotalFiles ?? 0;
        }

        if (files == 0) return;
        var name = string.IsNullOrWhiteSpace(library.Name) ? "library" : library.Name;
        var apply = await DialogService.ShowMessageBoxAsync(
            $"Apply the new naming to your existing {name}?",
            $"{files:N0} {(files == 1 ? "file" : "files")} in your managed {(managed.Count == 1 ? "folder" : "folders")} would be renamed. " +
            "This can take hours for a large folder; you can keep using Library while it runs. Other programs that use these folders (Plex, Jellyfin) will need to rescan, " +
            "and it cannot be undone automatically (Library keeps a full log of every move). Or choose Only new files: nothing is renamed now, and the new naming applies to files added from now on.",
            yesText: "Apply to existing files now", noText: "Only new files");
        if (apply != true) return;

        foreach (var folder in managed)
        {
            var job = await ApiClient.ConvertFolderAsync(folder.Id);
            if (job is null)
            {
                _notice = ApiClient.LastError ?? $"Library could not start organising {folder.DisplayName()}.";
                break;
            }
        }

        Snackbar.Add($"Library is renaming your existing {name}. You can keep using Library meanwhile.", AppSeverity.Success);
        await ReloadConfigurationAsync();
        await RefreshJobsAsync();
        await Changed.InvokeAsync();
    }


