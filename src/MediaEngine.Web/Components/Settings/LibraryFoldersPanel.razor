@namespace MediaEngine.Web.Components.Settings
@using System.Text.Json
@using MediaEngine.Web.Components.Shared
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject IAppDialogService DialogService
@inject IAppToastService Snackbar

@* One screen for libraries: media types on the left, the selected type's folders on the right.
   Used by the first-run setup step and by Settings > Libraries, so both behave identically. *@
<div class="library-folders">
    @if (_loading)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="Loading libraries" />
    }
    else if (_configuration is null)
    {
        <AppPageState Kind="AppPageStateKind.Error"
                      Icon="@AppMaterialIcons.Outlined.CloudOff"
                      Title="Libraries could not be loaded"
                      Message="@(_loadError ?? "The Engine did not return library configuration.")" />
    }
    else
    {
        <nav class="library-folders__types" aria-label="Library types">
            @foreach (var type in LibraryTypes)
            {
                var count = FolderCount(type);
                <AppNativeButton Type="button"
                                 Class="@TypeClass(type)"
                                 AriaLabel="@($"{type.Label}, {FolderCountText(count)}")"
                                 aria-current="@(type.Key == _selected.Key ? "true" : null)"
                                 OnClick="@(_ => Select(type))">
                    <span class="@($"library-folders__icon library-folders__icon--{type.Key}")"><AppMaterialIcon Icon="@type.Icon" /></span>
                    <span class="library-folders__type-text"><strong>@type.Label</strong><small>@FolderCountText(count)</small></span>
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" />
                </AppNativeButton>
            }
            @if (OtherLibraries.Count > 0)
            {
                <p class="library-folders__group">Other libraries</p>
                @foreach (var type in OtherLibraries)
                {
                    var count = FolderCount(type);
                    <AppNativeButton Type="button"
                                     Class="@TypeClass(type)"
                                     AriaLabel="@($"{type.Label}, {FolderCountText(count)}")"
                                     aria-current="@(type.Key == _selected.Key ? "true" : null)"
                                     OnClick="@(_ => Select(type))">
                        <span class="library-folders__icon library-folders__icon--other"><AppMaterialIcon Icon="@type.Icon" /></span>
                        <span class="library-folders__type-text"><strong>@type.Label</strong><small>@FolderCountText(count)</small></span>
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" />
                    </AppNativeButton>
                }
            }
        </nav>

        <section class="library-folders__detail" aria-labelledby="library-folders-title">
            <header class="library-folders__detail-header">
                <span class="@($"library-folders__icon library-folders__icon--{Selected.Key}")"><AppMaterialIcon Icon="@Selected.Icon" /></span>
                <div>
                    <h3 id="library-folders-title">@Selected.Label</h3>
                    <p>Folders that make up @(Selected.LibraryId is null ? $"your {Selected.PluralLabel} library" : Selected.Label).</p>
                </div>
                <div class="library-folders__detail-actions">
                    <AppButton Label="Add Folder"
                               StartIcon="@AppMaterialIcons.Outlined.Add"
                               ButtonStyle="AppButtonStyle.Outlined"
                               Disabled="@(_saving || ReadOnly)"
                               OnClick="AddFolderAsync" />
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(_notice))
            {
                <AppAlert Tone="AppUiTone.Warning">@_notice</AppAlert>
            }

            @if (SelectedLibrary is null || SelectedLibrary.Sources.Count == 0)
            {
                <div class="library-folders__empty">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FolderOpen" />
                    <strong>No folders yet</strong>
                    <span>Choose Add Folder to point Tuvima at where your @Selected.PluralLabel live.</span>
                </div>
            }
            else
            {
                <LibraryFolderTable Library="@SelectedLibrary"
                                    TypeLabel="@Selected.Label"
                                    PluralLabel="@Selected.PluralLabel"
                                    ReadOnly="@ReadOnly"
                                    Busy="@_saving"
                                    PathIssues="@_pathIssues"
                                    OnChangeHandling="ChangeModeAsync"
                                    OnSetDestination="SetDestinationAsync"
                                    OnLabel="LabelFolderAsync"
                                    OnRemove="RemoveFolderAsync" />
                @if (!SelectedLibrary.Sources.Any(IsManaged))
                {
                    <p class="library-folders__hint">Add a managed folder to import or upload @Selected.PluralLabel.</p>
                }
            }
        </section>

        <section class="library-folders__import" aria-labelledby="library-import-title">
            <header class="library-folders__detail-header">
                <span class="library-folders__icon library-folders__icon--import"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.MoveToInbox" /></span>
                <div>
                    <h3 id="library-import-title">Import folder <small>(optional)</small></h3>
                    <p>A drop-off folder for new media. Apps like Sonarr and Radarr can save finished downloads here too, and Tuvima files them into your libraries.</p>
                </div>
                <div class="library-folders__detail-actions">
                    @if (ImportStatus.Configured)
                    {
                        <AppButton Label="Change" ButtonStyle="AppButtonStyle.Outlined" Disabled="@(_saving || ReadOnly)" OnClick="ChooseImportFolderAsync" />
                        <AppButton Label="Remove" ButtonStyle="AppButtonStyle.Text" Disabled="@(_saving || ReadOnly)" OnClick="RemoveImportFolderAsync" />
                    }
                    else
                    {
                        <AppButton Label="Set import folder"
                                   StartIcon="@AppMaterialIcons.Outlined.Add"
                                   ButtonStyle="AppButtonStyle.Outlined"
                                   Disabled="@(_saving || ReadOnly)"
                                   OnClick="ChooseImportFolderAsync" />
                    }
                </div>
            </header>
            @if (ImportStatus.Configured)
            {
                <div class="library-folders__row">
                    <span class="library-folders__name"><AppMaterialIcon Icon="@AppMaterialIcons.Filled.Folder" /><strong>Import folder</strong></span>
                    <span class="library-folders__path" title="@ImportStatus.Path">@ImportStatus.Path</span>
                    <span class="library-folders__row-actions">
                        <AppStatusBadge Text="@(ImportStatus.Ready ? "Ready" : "Waiting for destinations")" Tone="@(ImportStatus.Ready ? AppUiTone.Success : AppUiTone.Warning)" />
                    </span>
                </div>
                @if (!ImportStatus.Ready)
                {
                    <AppAlert Tone="AppUiTone.Warning">
                        Import won't run until every type has a destination. Still needed: @string.Join(", ", ImportStatus.MissingTypes).
                        Add a folder that Tuvima manages for each type. Folders used as-is are never changed, so they can't take imports.
                    </AppAlert>
                }
            }
        </section>

        @if (!Embedded)
        {
            <details class="library-folders__advanced">
                <summary><strong>Advanced</strong><span>File handling and naming</span></summary>
                <LibraryAdvancedSettings Types="AdvancedTypes"
                                         DuplicatePolicy="@(_configuration.FileHandling.DuplicatePolicy)"
                                         ReadOnly="@ReadOnly"
                                         Busy="@_saving"
                                         OnLibraryChanged="SaveAdvancedLibraryAsync"
                                         OnDuplicatePolicyChanged="SaveDuplicatePolicyAsync" />
            </details>
        }
    }
</div>

@code {
    // The import folder is the storage location with this id (see ImportFolderRules in the Engine).
    private const string ImportLocationId = "incoming";

    private sealed record LibraryTypeOption(string Key, string Label, string PluralLabel, string Area, string[] MediaTypes, string Icon, string? LibraryId = null);

    private static readonly LibraryTypeOption[] LibraryTypes =
    [
        new("books", "Books", "Books", "read", ["Books"], AppMaterialIcons.Outlined.MenuBook),
        new("audiobooks", "Audiobooks", "Audiobooks", "listen", ["Audiobooks"], AppMaterialIcons.Outlined.Headphones),
        new("movies", "Movies", "Movies", "watch", ["Movies"], AppMaterialIcons.Outlined.Movie),
        new("tv", "TV Shows", "TV shows", "watch", ["TV", "TVShows"], AppMaterialIcons.Outlined.Tv),
        new("music", "Music", "Music", "listen", ["Music"], AppMaterialIcons.Outlined.MusicNote),
        new("comics", "Comics", "Comics", "read", ["Comics"], AppMaterialIcons.Outlined.AutoStories),
    ];

    /// <summary>True when the first-run setup session is in use instead of the signed-in Settings endpoints.</summary>
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public string? SetupSession { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>Empty-state links open the screen on a given type, for example ?type=movies.</summary>
    [SupplyParameterFromQuery(Name = "type")] public string? PreselectedType { get; set; }
    /// <summary>Raised after any saved change so the host can refresh its own state.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private LibrariesConfigurationDto? _configuration;
    private string _baseline = string.Empty;
    private string? _loadError;
    private string? _notice;
    private bool _loading = true;
    private bool _saving;
    private LibraryTypeOption _selected = LibraryTypes[0];
    private IReadOnlyDictionary<string, string> _pathIssues = new Dictionary<string, string>();

    // Advanced tabs follow the order people think in; the template key is the type's entry in organization_templates.
    private static readonly (string Key, string TemplateKey)[] AdvancedOrder =
    [
        ("movies", "Movies"), ("tv", "TV"), ("music", "Music"), ("books", "Books"), ("audiobooks", "Audiobooks"), ("comics", "Comics"),
    ];

    private IReadOnlyList<LibraryAdvancedSettings.AdvancedType> AdvancedTypes => AdvancedOrder
        .Select(entry =>
        {
            var type = LibraryTypes.First(item => item.Key == entry.Key);
            return new LibraryAdvancedSettings.AdvancedType(type.Key, type.Label, entry.TemplateKey, PrimaryLibraryFor(type));
        })
        .ToList();

    private ImportFolderStatusDto ImportStatus => _configuration?.ImportFolderStatus ?? new ImportFolderStatusDto();

    private LibraryTypeOption Selected => _selected;
    private LibraryFolderDto? SelectedLibrary => LibraryFor(_selected);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _selected = LibraryTypes.FirstOrDefault(type => string.Equals(type.Key, PreselectedType, StringComparison.OrdinalIgnoreCase))
            ?? LibraryTypes.FirstOrDefault(type => FolderCount(type) > 0)
            ?? LibraryTypes[0];
        await InvokeAsync(StateHasChanged);
        await RefreshPathIssuesAsync();
    }

    // Live read/write check of every folder; a problem shows as one status line under the path, nothing when healthy.
    // The setup session cannot call the signed-in path check, so the first-run screen skips it.
    private async Task RefreshPathIssuesAsync()
    {
        if (_configuration is null || Embedded) return;
        var folders = _configuration.Libraries.SelectMany(library => library.Sources)
            .Where(source => !string.IsNullOrWhiteSpace(source.Path))
            .GroupBy(source => source.Path, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .ToList();
        using var gate = new SemaphoreSlim(4);
        var checks = folders.Select(async source =>
        {
            await gate.WaitAsync();
            try { return (Source: source, Result: await Orchestrator.TestPathAsync(source.Path)); }
            finally { gate.Release(); }
        }).ToList();
        var issues = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var (source, result) in await Task.WhenAll(checks))
        {
            if (result is null) continue;
            if (!result.Exists) issues[source.Path] = "Folder unavailable";
            else if (!result.HasRead || (IsManaged(source) && !result.HasWrite)) issues[source.Path] = "No access";
        }
        _pathIssues = issues;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _configuration = Embedded
            ? await ApiClient.GetSetupLibrariesAsync(SetupSession)
            : await Orchestrator.GetLibrariesAsync();
        _loadError = _configuration is null ? ApiClient.LastError : null;
        _baseline = _configuration is null ? string.Empty : JsonSerializer.Serialize(_configuration);
        _loading = false;
    }

    private LibraryFolderDto? LibraryFor(LibraryTypeOption type) => type.LibraryId is not null
        ? _configuration?.Libraries.FirstOrDefault(library => library.Id == type.LibraryId)
        : PrimaryLibraryFor(type);

    private LibraryFolderDto? PrimaryLibraryFor(LibraryTypeOption type) => _configuration?.Libraries
        .FirstOrDefault(library => IsCatalogued(library)
            && library.MediaTypes.Any(token => type.MediaTypes.Contains(token, StringComparer.OrdinalIgnoreCase)));

    private static bool IsCatalogued(LibraryFolderDto library) => string.Equals(library.Kind, "catalogued", StringComparison.OrdinalIgnoreCase);

    // Libraries that are not the one library of a standard type (an older custom type, or a second library of a standard
    // type) still show here, so their folders can be seen and removed instead of silently hiding.
    private IReadOnlyList<LibraryTypeOption> OtherLibraries => _configuration is null
        ? []
        : _configuration.Libraries
            .Where(library => IsCatalogued(library) && !LibraryTypes.Any(type => ReferenceEquals(PrimaryLibraryFor(type), library)))
            .Select(library => new LibraryTypeOption(
                $"other-{library.Id}",
                string.IsNullOrWhiteSpace(library.Name) ? "Other library" : library.Name,
                string.IsNullOrWhiteSpace(library.Name) ? "other" : library.Name,
                library.Area,
                [.. library.MediaTypes],
                OtherIcon(library.Area),
                library.Id))
            .ToList();

    private static string OtherIcon(string? area) => area?.ToLowerInvariant() switch
    {
        "read" => AppMaterialIcons.Outlined.MenuBook,
        "watch" => AppMaterialIcons.Outlined.Movie,
        "listen" => AppMaterialIcons.Outlined.Headphones,
        _ => AppMaterialIcons.Outlined.Folder,
    };

    private int FolderCount(LibraryTypeOption type) => LibraryFor(type)?.Sources.Count ?? 0;
    private static string FolderCountText(int count) => count == 1 ? "1 folder" : $"{count} folders";
    private string TypeClass(LibraryTypeOption type) => $"library-folders__type{(type.Key == _selected.Key ? " is-active" : string.Empty)}";
    private void Select(LibraryTypeOption type) { _selected = type; _notice = null; }
    private static bool IsManaged(LibrarySourceDto source) => source.ManagementMode == "managed_by_tuvima";
    private static string FriendlyName(LibrarySourceDto source)
    {
        if (!string.IsNullOrWhiteSpace(source.Notes)) return source.Notes;
        var name = Path.GetFileName(source.Path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar));
        return string.IsNullOrWhiteSpace(name) ? source.Path : name;
    }

    private Task<ServerFolderValidationResultDto?> ValidateAsync(string path, string mode, string? sourceId = null)
    {
        var request = new ValidateServerFolderRequest { ManualPath = path, SelectionMode = mode, CurrentSourceId = sourceId };
        return Embedded ? ApiClient.ValidateSetupServerFolderAsync(request, SetupSession) : ApiClient.ValidateServerFolderAsync(request);
    }

    private async Task AddFolderAsync()
    {
        if (_configuration is null || _saving) return;
        _notice = null;
        var parameters = new AppDialogParameters<ServerFolderPicker>
        {
            { component => component.SelectionMode, ServerFolderSelectionModes.ExistingLibrary },
            { component => component.HelpText, $"Choose a folder on the Tuvima Library server to add to {_selected.Label}." },
            { component => component.SetupSession, SetupSession },
        };
        var dialog = await DialogService.ShowAsync<ServerFolderPicker>(string.Empty, parameters, new AppDialogOptions
        {
            MaxWidth = AppMaxWidth.ExtraExtraLarge,
            FullWidth = false,
            CloseButton = false,
            CloseOnEscapeKey = true,
        });
        if (await dialog.Result is not { Canceled: false, Data: ServerFolderValidationResultDto selected }) return;

        // An empty folder is ours to manage. A folder that already holds files is used as-is unless the person says otherwise,
        // because managing it could rename or move files other apps depend on.
        var managed = true;
        if (selected.ContainsFiles)
        {
            var choice = await DialogService.ShowMessageBoxAsync(
                "This folder already has files in it",
                "Tuvima will use it as-is: it only reads the folder and never renames, moves or changes your files, so other apps are not affected. If you let Tuvima manage it instead, Tuvima may rename and reorganise files here, which could affect other applications that use this folder.",
                yesText: "Use as-is (recommended)", noText: "Let Tuvima manage it", cancelText: "Cancel");
            if (choice is null) return;
            managed = choice == false;
        }

        if (managed)
        {
            var writable = await ValidateAsync(selected.Path, ServerFolderSelectionModes.ManagedLibrary);
            if (writable?.CanSelect == true) selected = writable;
            else
            {
                managed = false;
                _notice = writable is null
                    ? "Tuvima couldn't check whether it can write to this folder, so it will be used as-is (read only)."
                    : "Tuvima can't write to this folder, so it will be used as-is (read only).";
            }
        }

        var library = Clone(SelectedLibrary) ?? NewLibrary(_selected);
        // The Engine makes the first managed folder the library's destination when it saves.
        var source = new LibrarySourceDto
        {
            Id = Guid.NewGuid().ToString("D"),
            Path = selected.Path,
            Notes = Path.GetFileName(selected.Path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)),
            ManagementMode = managed ? "managed_by_tuvima" : "existing_library",
            SourceType = "local_folder",
            IncludeSubdirectories = true,
            AccessMode = managed ? "writable" : "read_only",
        };
        if (string.IsNullOrWhiteSpace(source.Notes)) source.Notes = selected.Path;
        library.Sources.Add(source);
        await SaveAsync(library, "Folder added.");
    }

    // Tapping Handling. As-is to Managed asks first (the organising job arrives later, so today this is the plain mode switch);
    // Managed to As-is also asks, and stops any job that is running. Nothing already done is undone.
    private async Task ChangeModeAsync(LibrarySourceDto source)
    {
        var library = Clone(SelectedLibrary);
        var target = library?.Sources.FirstOrDefault(item => item.Id == source.Id);
        if (library is null || target is null || _saving) return;
        var managed = !IsManaged(target);
        var confirmed = managed
            ? await DialogService.ShowMessageBoxAsync(
                $"Let Tuvima manage {target.Path}?",
                "Tuvima may rename and reorganise files in this folder, which could affect other applications that use it.",
                yesText: "Let Tuvima manage it", cancelText: "Keep as-is")
            : await DialogService.ShowMessageBoxAsync(
                $"Use {target.Path} as-is?",
                "Tuvima stops renaming, moving or tagging files here, and any organising that is running stops. Nothing is undone and your files stay where they are.",
                yesText: "Use as-is", cancelText: "Keep managed");
        if (confirmed != true) return;
        var validation = await ValidateAsync(target.Path, managed ? ServerFolderSelectionModes.ManagedLibrary : ServerFolderSelectionModes.ExistingLibrary, target.Id);
        if (validation is null || !validation.CanSelect)
        {
            _notice = validation?.Issues.FirstOrDefault()?.Message ?? ApiClient.LastError ?? "This folder does not meet the access needed for that choice.";
            return;
        }

        // The Engine keeps or re-picks the library's destination when it saves.
        target.ManagementMode = managed ? "managed_by_tuvima" : "existing_library";
        target.AccessMode = managed ? "writable" : "read_only";
        if (!managed)
        {
            target.ConversionState = "none";
            target.ConversionOperationId = null;
        }
        await SaveAsync(library, managed ? "Tuvima will now manage this folder." : "This folder will be used as-is.");
    }

    // Tapping the New media radio on another managed folder moves the marker. It only affects future imports and uploads.
    private async Task SetDestinationAsync(LibrarySourceDto source)
    {
        var library = Clone(SelectedLibrary);
        var target = library?.Sources.FirstOrDefault(item => item.Id == source.Id);
        if (library is null || target is null || _saving || !IsManaged(target)) return;
        library.PrimaryDestinationSourceId = target.Id;
        await SaveAsync(library, $"New {Selected.PluralLabel} will go to {FriendlyName(target)}.");
    }

    private async Task LabelFolderAsync(LibrarySourceDto source)
    {
        var library = Clone(SelectedLibrary);
        var target = library?.Sources.FirstOrDefault(item => item.Id == source.Id);
        if (library is null || target is null || _saving) return;
        var dialog = await DialogService.ShowAsync<LibraryTextEditDialog>(string.Empty, new AppDialogParameters<LibraryTextEditDialog>
        {
            { component => component.Label, "Folder label" },
            { component => component.Value, FriendlyName(target) },
        }, new AppDialogOptions { NoHeader = true, FullWidth = true, MaxWidth = AppMaxWidth.Small });
        if (await dialog.Result is not { Canceled: false, Data: string label }) return;
        target.Notes = label;
        await SaveAsync(library, "Label saved.");
    }

    private Task SaveAdvancedLibraryAsync(LibraryFolderDto library) => SaveAsync(library, "Saved.");

    private Task SaveDuplicatePolicyAsync(string policy) => PutAsync(
        baseline => new UpdateLibrariesRequest
        {
            SchemaVersion = baseline.SchemaVersion,
            StorageLocations = baseline.StorageLocations,
            ViewStorage = baseline.ViewStorage,
            Libraries = baseline.Libraries,
            PersonalLibraryPolicy = baseline.PersonalLibraryPolicy,
            FileHandling = new FileHandlingDto { DuplicatePolicy = policy },
        },
        "Saved.");

    private async Task ChooseImportFolderAsync()
    {
        if (_configuration is null || _saving) return;
        _notice = null;
        var parameters = new AppDialogParameters<ServerFolderPicker>
        {
            { component => component.SelectionMode, ServerFolderSelectionModes.ManagedLibrary },
            { component => component.CurrentSourceId, ImportLocationId },
            { component => component.HelpText, "Choose a folder on the Tuvima Library server where new media will be dropped. It must be separate from your library folders." },
            { component => component.SetupSession, SetupSession },
        };
        var dialog = await DialogService.ShowAsync<ServerFolderPicker>(string.Empty, parameters, new AppDialogOptions
        {
            MaxWidth = AppMaxWidth.ExtraExtraLarge,
            FullWidth = false,
            CloseButton = false,
            CloseOnEscapeKey = true,
        });
        if (await dialog.Result is not { Canceled: false, Data: ServerFolderValidationResultDto selected }) return;
        await SaveImportFolderAsync(selected.Path, "Import folder saved.");
    }

    private async Task RemoveImportFolderAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove the import folder?",
            "Tuvima stops importing from it. Files in the folder stay on disk.",
            yesText: "Remove", cancelText: "Keep");
        if (confirmed == true) await SaveImportFolderAsync(null, "Import folder removed.");
    }

    private Task SaveImportFolderAsync(string? path, string message) => PutAsync(baseline =>
    {
        var locations = baseline.StorageLocations
            .Where(location => !string.Equals(location.Id, ImportLocationId, StringComparison.OrdinalIgnoreCase))
            .ToList();
        if (path is not null)
        {
            locations.Add(new ServerStorageLocationDto { Id = ImportLocationId, Label = "Tuvima import folder", Path = path, AllowWrite = true });
        }

        return new UpdateLibrariesRequest
        {
            SchemaVersion = baseline.SchemaVersion,
            StorageLocations = locations,
            ViewStorage = baseline.ViewStorage,
            Libraries = baseline.Libraries,
            PersonalLibraryPolicy = baseline.PersonalLibraryPolicy,
            FileHandling = baseline.FileHandling,
        };
    }, message);

    // Saves a whole-configuration change (import folder, file handling) and adopts the Engine's answer.
    private async Task PutAsync(Func<LibrariesConfigurationDto, UpdateLibrariesRequest> build, string message)
    {
        if (_configuration is null || _saving) return;
        _saving = true;
        try
        {
            var baseline = JsonSerializer.Deserialize<LibrariesConfigurationDto>(_baseline)!;
            var request = build(baseline);
            var saved = Embedded ? await ApiClient.UpdateSetupLibrariesAsync(request, SetupSession) : await ApiClient.UpdateLibrariesAsync(request);
            if (saved is null)
            {
                _notice = ApiClient.LastError ?? "That change could not be saved. Check it and try again.";
                return;
            }
            _configuration = saved;
            _baseline = JsonSerializer.Serialize(saved);
            Snackbar.Add(message, AppSeverity.Success);
        }
        finally { _saving = false; }
        await Changed.InvokeAsync();
    }

    private async Task RemoveFolderAsync(LibrarySourceDto source)
    {
        var library = Clone(SelectedLibrary);
        if (library is null || _saving) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove this folder?",
            $"{FriendlyName(source)} stops being part of {_selected.Label}. Your files stay on disk.",
            yesText: "Remove", cancelText: "Keep");
        if (confirmed != true) return;
        library.Sources.RemoveAll(item => item.Id == source.Id);
        await SaveAsync(library, "Folder removed.");
    }

    private async Task SaveAsync(LibraryFolderDto library, string message)
    {
        if (_configuration is null || _saving) return;
        _saving = true;
        try
        {
            var baseline = JsonSerializer.Deserialize<LibrariesConfigurationDto>(_baseline)!;
            var existing = baseline.Libraries.FirstOrDefault(item => item.Id == library.Id);
            LibrariesConfigurationDto? saved;
            if (Embedded)
            {
                var libraries = baseline.Libraries.Where(item => item.Id != library.Id).ToList();
                libraries.Add(library);
                saved = await ApiClient.UpdateSetupLibrariesAsync(new UpdateLibrariesRequest
                {
                    SchemaVersion = baseline.SchemaVersion,
                    StorageLocations = baseline.StorageLocations,
                    ViewStorage = baseline.ViewStorage,
                    Libraries = libraries,
                    PersonalLibraryPolicy = baseline.PersonalLibraryPolicy,
                    FileHandling = baseline.FileHandling,
                }, SetupSession);
            }
            else
            {
                saved = await ApiClient.MutateLibraryAsync(new LibraryMutationRequest { Library = library, ExpectedLibrary = existing });
            }

            if (saved is null)
            {
                _notice = ApiClient.LastError ?? "That change could not be saved. Check the folder and try again.";
                return;
            }
            _configuration = saved;
            _baseline = JsonSerializer.Serialize(saved);
            Snackbar.Add(message, AppSeverity.Success);
        }
        finally { _saving = false; }
        await Changed.InvokeAsync();
        await RefreshPathIssuesAsync();
    }

    private static LibraryFolderDto? Clone(LibraryFolderDto? library) => library is null
        ? null
        : JsonSerializer.Deserialize<LibraryFolderDto>(JsonSerializer.Serialize(library));

    private static LibraryFolderDto NewLibrary(LibraryTypeOption option) => new()
    {
        Id = Guid.NewGuid().ToString("D"),
        Name = option.Label,
        Category = option.Label,
        Kind = "catalogued",
        Area = option.Area,
        Presentation = "catalogue",
        MetadataPolicy = "enriched",
        MediaTypes = [option.MediaTypes[0]],
        Visibility = "household",
        AcceptedIntakeModes = ["incoming_folder"],
        OrganizationPolicy = new LibraryOrganizationPolicyDto { Mode = "tuvima_standard", WriteTags = true },
    };
}
