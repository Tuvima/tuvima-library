@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@inject IJSRuntime JS
@inject IAppToastService Snackbar
@inject ILogger<ManualPortForwardingDialog> Logger
@inject IStringLocalizer<SharedStrings> L

<AppDialog Visible="@Visible" VisibleChanged="@VisibleChanged"
           Title="@L["ManualPortForwardingDialog_YourRouterNeedsOneSetting"].Value"
           Subtitle="@L["ManualPortForwardingDialog_CreateThisPortForwardingRule"].Value"
           Icon="@AppMaterialIcons.Outlined.Router" Size="Medium">
    <ChildContent>
        <dl class="network-manual-rule">
            @Fact("Name", "Library")
            @Fact("External Port", ExternalPort.ToString())
            @Fact("Internal IP", InternalAddress)
            @Fact("Internal Port", InternalPort.ToString())
            @Fact("Protocol", "TCP")
        </dl>
        <div class="network-manual-rule__summary">
            <code>@RuleSummary</code>
            <AppButton Label="@L["ManualPortForwardingDialog_CopyRule"].Value" StartIcon="@AppMaterialIcons.Outlined.ContentCopy" OnClick="CopyAsync" />
        </div>
        <AppAlert Tone="AppUiTone.Info" Icon="@AppMaterialIcons.Outlined.HomeWork">
            <strong>@L["ManualPortForwardingDialog_KeepThisServerAtThe"]</strong>
            <span>@L["ManualPortForwardingDialog_YourRouterMayAssignA", InternalAddress]</span>
        </AppAlert>
        @if (CgnatSuspected)
        {
            <AppAlert Tone="AppUiTone.Warning">@L["ManualPortForwardingDialog_YourInternetProviderMayNot"]</AppAlert>
        }
    </ChildContent>
    <FooterContent>
        <AppButton Label="@L["Common_Close"].Value" OnClick="CloseAsync" />
        <AppButton Label="@L["ManualPortForwardingDialog_IVeConfiguredThisTest"].Value" ButtonStyle="AppButtonStyle.Filled" OnClick="TestAgainAsync" />
    </FooterContent>
</AppDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public int InternalPort { get; set; }
    [Parameter] public int ExternalPort { get; set; }
    [Parameter] public string InternalAddress { get; set; } = "Unavailable";
    [Parameter] public bool CgnatSuspected { get; set; }
    [Parameter] public EventCallback TestAgain { get; set; }

    private string RuleSummary => $"TCP {ExternalPort} → {InternalAddress}:{InternalPort}";
    private Task CloseAsync() => VisibleChanged.InvokeAsync(false);
    private async Task TestAgainAsync()
    {
        await VisibleChanged.InvokeAsync(false);
        await TestAgain.InvokeAsync();
    }
    private async Task CopyAsync()
    {
        switch (await JS.TryCopyAsync(RuleSummary, Logger))
        {
            case ClipboardCopyResult.Copied:
                Snackbar.Add("Port-forwarding rule copied.", AppSeverity.Success);
                break;
            case ClipboardCopyResult.Failed:
                Snackbar.Add(ClipboardInterop.FailedMessage("the rule"), AppSeverity.Warning);
                break;
        }
    }
    private static RenderFragment Fact(string label, string value) => @<div><dt>@label</dt><dd>@value</dd></div>;
}
