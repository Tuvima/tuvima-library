@namespace MediaEngine.Web.Components.Settings
@implements IDisposable
@inject IEngineApiClient ApiClient
@inject UIOrchestratorService Orchestrator
@inject IAppDialogService DialogService
@inject ILogger<ToolsRequirementsTab> Logger

<div class="tl-page tools-requirements">
    <div class="tools-requirements__toolbar">
        <span class="tools-requirements__checked">@CheckedLine</span>
        <AppButton Label="Check again" StartIcon="@AppMaterialIcons.Outlined.Refresh" Loading="_checking" Disabled="@(_loading || _checking)" OnClick="CheckAgainAsync" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <AppAlert Tone="@_messageTone" Class="tl-sp-mb-3" data-testid="tools-message">@_message</AppAlert>
    }

    @if (_loading)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="Checking tools" Message="Looking at the tools and downloads the Library relies on." />
    }
    else if (_tools is null)
    {
        <AppErrorState Title="Could not check the tools"
                       Message="The Library could not get the tools list from the server. Check that the server is online, then try again."
                       Retry="LoadAsync" />
    }
    else
    {
        @if (_tools.NeedsAttention)
        {
            <AppAlert Tone="AppUiTone.Warning" Class="tl-sp-mb-3">Something the Library needs isn't ready. Files that need it wait until it is.</AppAlert>
        }

        <AppCard Title="Tools" Description="Outside programs the Library uses to read and prepare your media." Class="tl-sp-mb-3">
            <div class="tools-requirements__list" data-testid="tools-list">
                @foreach (var tool in Tools)
                {
                    <ToolRequirementRow Tool="@tool" Busy="@(_busyId is not null)" OnLocate="LocateAsync"
                                        OnInstall="InstallAsync" OnDownloadAgain="InstallAsync">
                        <Actions>
                            @if (tool.State == ToolRequirementStates.Downloading)
                            {
                                <AppButton Label="Cancel" Size="AppControlSize.Compact" Tone="AppUiTone.Warning" Disabled="@(_busyId is not null)" OnClick="@(() => CancelInstallAsync(tool))" />
                            }
                            @if (tool.State == ToolRequirementStates.InstallerReady)
                            {
                                <AppButton Label="Run installer" Size="AppControlSize.Compact" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@(_busyId is not null)" OnClick="@(() => RunInstallerAsync(tool))" />
                            }
                        </Actions>
                    </ToolRequirementRow>
                }
            </div>
        </AppCard>

        <div class="tools-requirements__stack">
            <PlaybackToolsStatusCard />
        </div>

        @if (Models.Count > 0)
        {
            <AppCard Title="Local AI models" Description="Model files for the optional local AI features. They are downloaded only when you ask." Class="tl-sp-mb-3">
                <div class="tools-requirements__list" data-testid="models-list">
                    @foreach (var model in Models)
                    {
                        <ToolRequirementRow Tool="@model"
                                            Busy="@ModelBusy(model)"
                                            OnDownloadAgain="DownloadModelAsync">
                            <Actions>
                                @if (model.State == ToolRequirementStates.Downloading)
                                {
                                    <AppButton Label="Cancel" Size="AppControlSize.Compact" Tone="AppUiTone.Warning" Disabled="@(_busyId is not null)" OnClick="@(() => RunModelActionAsync(model, ModelAction.Cancel))" />
                                }
                                @if (CanLoad(model))
                                {
                                    <AppButton Label="Load" Size="AppControlSize.Compact" Tone="AppUiTone.Success" Disabled="@(_busyId is not null)" OnClick="@(() => RunModelActionAsync(model, ModelAction.Load))" />
                                }
                                @if (CanUnload(model))
                                {
                                    <AppButton Label="Unload" Size="AppControlSize.Compact" Disabled="@(_busyId is not null)" OnClick="@(() => RunModelActionAsync(model, ModelAction.Unload))" />
                                }
                            </Actions>
                        </ToolRequirementRow>
                    }
                </div>
            </AppCard>
        }

    }
</div>

@code {
    /// <summary>How often the list is read again while a download is running.</summary>
    [Parameter] public TimeSpan PollInterval { get; set; } = TimeSpan.FromSeconds(2);

    private enum ModelAction { Cancel, Load, Unload }

    private ToolRequirementsDto? _tools;
    private Dictionary<string, AiModelStatusDto> _modelStatuses = new(StringComparer.OrdinalIgnoreCase);
    private bool _loading = true;
    private bool _checking;
    private string? _busyId;
    private bool _awaitingInstaller;
    private string? _message;
    private AppUiTone _messageTone = AppUiTone.Info;
    private CancellationTokenSource? _poll;
    private readonly CancellationTokenSource _lifetime = new();
    private bool _disposed;

    // Work that resumes after the page has gone must not touch the disposed source; it gets an already-cancelled token.
    private CancellationToken Lifetime => _disposed ? new CancellationToken(canceled: true) : _lifetime.Token;

    private IReadOnlyList<ToolRequirementDto> Tools =>
        _tools?.Tools.Where(tool => tool.Kind == "tool").ToList() ?? [];

    private IReadOnlyList<ToolRequirementDto> Models =>
        _tools?.Tools.Where(tool => tool.Kind == "ai_model").ToList() ?? [];

    private string CheckedLine => _tools is null
        ? string.Empty
        : $"Last checked {_tools.CheckedAt.ToLocalTime():MMM d, h:mm tt}";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        await RefreshAsync();
        _loading = false;
        EnsurePolling();
    }

    private async Task RefreshAsync()
    {
        if (_disposed)
        {
            return;
        }

        _tools = await ApiClient.GetToolRequirementsAsync(Lifetime);
        await LoadModelStatusesAsync();
    }

    private async Task LoadModelStatusesAsync()
    {
        var statuses = await Orchestrator.GetAiModelStatusesAsync(Lifetime);
        _modelStatuses = statuses.ToDictionary(status => status.Role, StringComparer.OrdinalIgnoreCase);
    }

    private async Task CheckAgainAsync()
    {
        _checking = true;
        _message = null;
        var fresh = await ApiClient.CheckToolRequirementsAsync(Lifetime);
        if (fresh is null)
        {
            Say("The Library could not check the tools. Check that the server is online, then try again.", AppUiTone.Error);
        }
        else
        {
            _tools = fresh;
            await LoadModelStatusesAsync();
            Say(fresh.NeedsAttention ? "Checked again. Something the Library needs still isn't ready." : "Checked again. Everything the Library needs is ready.",
                fresh.NeedsAttention ? AppUiTone.Warning : AppUiTone.Success);
        }

        _checking = false;
        EnsurePolling();
    }

    // ── Locate it ────────────────────────────────────────────────────────────

    private async Task LocateAsync(ToolRequirementDto tool)
    {
        var dialog = await DialogService.ShowAsync<ServerFolderPicker>(string.Empty, new AppDialogParameters<ServerFolderPicker>
        {
            { component => component.SelectionMode, ServerFolderSelectionModes.ToolLocation },
            { component => component.Title, $"Locate {tool.Name}" },
            { component => component.HelpText, $"Choose the folder that contains {tool.Name}." },
            { component => component.ConfirmLabel, "Use this folder" },
        }, new AppDialogOptions { MaxWidth = AppMaxWidth.ExtraExtraLarge, FullWidth = false, CloseButton = false, CloseOnEscapeKey = true });
        if (await dialog.Result is not { Canceled: false, Data: ServerFolderValidationResultDto selected })
        {
            return;
        }

        _busyId = tool.Id;
        _message = null;
        var result = await ApiClient.SetToolLocationAsync(
            tool.Id, new ToolLocationRequest(selected.StorageLocationId, selected.RelativePath, null), Lifetime);
        _busyId = null;
        if (!result.Success || result.Tools is null)
        {
            Say(result.ErrorMessage ?? $"That folder can't be used for {tool.Name}.", AppUiTone.Error);
            return;
        }

        _tools = result.Tools;
        var fresh = result.Tools.Tools.FirstOrDefault(row => row.Id == tool.Id);
        if (fresh is { State: ToolRequirementStates.Ready })
        {
            Say($"{tool.Name} is ready.", AppUiTone.Success);
        }
        else
        {
            Say($"That folder was saved, but {tool.Name} still isn't working.", AppUiTone.Warning);
        }

        EnsurePolling();
    }

    // ── Install for me, Download again, Cancel, Run installer ────────────────

    private Task InstallAsync(ToolRequirementDto tool) => RunToolActionAsync(
        tool, () => ApiClient.InstallToolAsync(tool.Id, Lifetime), $"Downloading {tool.Name}.");

    private Task CancelInstallAsync(ToolRequirementDto tool) => RunToolActionAsync(
        tool, () => ApiClient.CancelToolInstallAsync(tool.Id, Lifetime), $"The download of {tool.Name} was cancelled.");

    private async Task RunInstallerAsync(ToolRequirementDto tool)
    {
        _awaitingInstaller = true;
        await RunToolActionAsync(tool, () => ApiClient.RunToolInstallerAsync(tool.Id, Lifetime),
            $"{tool.Name}'s installer was started. Finish it in the window that opened, then press Check again.");
    }

    private async Task RunToolActionAsync(ToolRequirementDto tool, Func<Task<ToolActionResult>> action, string success)
    {
        _busyId = tool.Id;
        _message = null;
        var result = await action();
        _busyId = null;
        if (!result.Success || result.Tools is null)
        {
            Say(result.ErrorMessage ?? $"That didn't work for {tool.Name}.", AppUiTone.Error);
            return;
        }

        _tools = result.Tools;
        Say(success, AppUiTone.Info);
        EnsurePolling();
    }

    // ── Local AI models ──────────────────────────────────────────────────────

    private static string RoleOf(ToolRequirementDto model) => model.Id[ToolRequirementIds.AiModelPrefix.Length..];

    private AiModelStatusDto? StatusOf(ToolRequirementDto model) =>
        _modelStatuses.TryGetValue(RoleOf(model), out var status) ? status : null;

    // A model this machine cannot run is not offered a download that would only fail.
    private bool ModelBusy(ToolRequirementDto model) => _busyId is not null || StatusOf(model) is { CanOperate: false };

    private bool CanLoad(ToolRequirementDto model) =>
        StatusOf(model) is { CanOperate: true, Loaded: false } status
        && status.State.Equals("Ready", StringComparison.OrdinalIgnoreCase);

    private bool CanUnload(ToolRequirementDto model) =>
        StatusOf(model) is { } status
        && (status.Loaded || status.Active || status.State.Equals("Loaded", StringComparison.OrdinalIgnoreCase));

    private async Task DownloadModelAsync(ToolRequirementDto model)
    {
        _busyId = model.Id;
        var result = await Orchestrator.StartAiModelDownloadAsync(RoleOf(model), Lifetime);
        _busyId = null;
        await AfterModelActionAsync(result, $"The download of {model.Name} could not start.", $"Downloading {model.Name}.");
    }

    private async Task RunModelActionAsync(ToolRequirementDto model, ModelAction action)
    {
        _busyId = model.Id;
        var role = RoleOf(model);
        var result = action switch
        {
            ModelAction.Cancel => await Orchestrator.CancelAiModelDownloadAsync(role, Lifetime),
            ModelAction.Load => await Orchestrator.LoadAiModelAsync(role, Lifetime),
            _ => await Orchestrator.UnloadAiModelAsync(role, Lifetime),
        };
        _busyId = null;
        await AfterModelActionAsync(result, $"{action} did not work for {model.Name}.", $"{action} requested for {model.Name}.");
    }

    private async Task AfterModelActionAsync(AiOperationResultDto result, string failure, string success)
    {
        if (result.Succeeded)
        {
            Say(success, AppUiTone.Success);
        }
        else
        {
            Logger.LogInformation("A model action was refused: {Problem}", result.Problem?.ToUserMessage());
            Say(failure, AppUiTone.Error);
        }

        await RefreshAsync();
        EnsurePolling();
    }

    // ── Progress ─────────────────────────────────────────────────────────────

    private bool AnyDownloading => _tools?.Tools.Any(tool => tool.State == ToolRequirementStates.Downloading) == true;

    // After Run installer the Tesseract row stays "installer ready" until its setup closes, so progress is read
    // until then, but only on a page where the person started it.
    private bool NeedsPolling => AnyDownloading
        || (_awaitingInstaller && _tools?.Tools.Any(tool => tool.State == ToolRequirementStates.InstallerReady) == true);

    private void EnsurePolling()
    {
        if (_poll is not null || !NeedsPolling || _disposed)
        {
            return;
        }

        _poll = CancellationTokenSource.CreateLinkedTokenSource(Lifetime);
        _ = PollWhileDownloadingAsync(_poll);
    }

    private async Task PollWhileDownloadingAsync(CancellationTokenSource source)
    {
        try
        {
            using var timer = new PeriodicTimer(PollInterval);
            while (await timer.WaitForNextTickAsync(source.Token))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
                if (!NeedsPolling)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // The page closed while a download was running; there is nothing left to refresh.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Refreshing download progress stopped.");
        }
        finally
        {
            if (ReferenceEquals(_poll, source))
            {
                _poll = null;
            }

            source.Dispose();
        }
    }

    private void Say(string message, AppUiTone tone)
    {
        _message = message;
        _messageTone = tone;
    }

    public void Dispose()
    {
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
