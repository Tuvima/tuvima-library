@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Services.Formatting
@* The last-30-days calendar (D3): whole Monday-to-Sunday weeks, one square a day, darker for busier days. Drawn only when there was
   some activity; the days outside the window are left blank. Days are UTC days, the same ones the Engine counts. *@
<figure class="overview-heatmap" data-overview-heatmap>
    <div class="overview-heatmap__body">
        <ol class="overview-heatmap__days" aria-hidden="true">
            <li>Mon</li><li></li><li>Wed</li><li></li><li>Fri</li><li></li><li></li>
        </ol>
        <div class="overview-heatmap__grid" role="img" aria-label="@Summary" data-overview-heatmap-grid>
            @foreach (var day in Days)
            {
                <span class="@("overview-heatmap__cell overview-heatmap__cell--" + day.Level + (day.InWindow ? string.Empty : " overview-heatmap__cell--outside"))"
                      title="@(day.InWindow ? ProfileOverviewPresentation.DayLabel(day) : null)"
                      data-heatmap-date="@(day.InWindow ? day.Date.ToString("yyyy-MM-dd") : null)"
                      data-heatmap-level="@(day.InWindow ? day.Level : null)"></span>
            }
        </div>
    </div>
    <figcaption class="overview-heatmap__legend" aria-hidden="true">
        <span>Less</span>
        @for (var level = 0; level <= 4; level++)
        {
            <span class="@("overview-heatmap__cell overview-heatmap__cell--" + level)"></span>
        }
        <span>More</span>
    </figcaption>
</figure>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<HeatmapDay> Days { get; set; } = [];

    private string Summary
    {
        get
        {
            var active = Days.Count(day => day.InWindow && day.Level > 0);
            return $"Your activity over the last {ProfileOverviewPresentation.RollingDays} days: active on {active} {(active == 1 ? "day" : "days")}.";
        }
    }
}
