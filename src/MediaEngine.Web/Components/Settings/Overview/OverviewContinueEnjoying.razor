@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Components.MediaTiles
@using MediaEngine.Web.Models.ViewDTOs
@inject IStringLocalizer<SharedStrings> L
@* Continue enjoying (issue 1128): the same Continue tiles as the Continue pages and the discover rows, in one mixed row, most recently touched
   first. Nothing is invented: with nothing started, one friendly line says where it will appear. *@
@if (Shelf.Items.Count == 0)
{
    <p class="overview-continue__empty" data-overview-continue-empty>@L["OverviewContinueEnjoying_NothingIsPartWayThrough"]</p>
}
else
{
    <div data-overview-continue>
        <ContinueAcrossMediaSection Shelf="@Shelf" Heading="@L["Common_ContinueEnjoying"].Value" />
    </div>
}

@code {
    /// <summary>The titles left part way through, as the shared Continue shelf.</summary>
    [Parameter, EditorRequired] public MediaTileShelfViewModel Shelf { get; set; } = default!;
}
