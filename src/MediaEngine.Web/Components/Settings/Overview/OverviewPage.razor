@namespace MediaEngine.Web.Components.Settings
@using System.Globalization
@using MediaEngine.Contracts.Activity
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Contracts.Taste
@using MediaEngine.Web.Components.Profiles
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Components.MediaTiles
@using MediaEngine.Web.Services.MediaTiles
@using MediaEngine.Web.Services.Formatting
@using MediaEngine.Web.Services.Integration
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient Api
@inject DeviceContextService DeviceContext
@inject DashboardSessionAccessor Session
@inject DashboardIdentityClient Identity
@inject ILogger<OverviewPage> Logger
@inject IStringLocalizer<SharedStrings> L
@* My profile > Profile (specs: Profile Overview, Taste and Activity; profile-and-household D5): you, with "Edit name and picture", the
   Sign-in and safety rows (Profile PIN, Password and email, Devices), a few friendly numbers, what you are in the middle of,
   what you did lately, your taste and the last 30 days. It is your own page, so it reads only the signed-in profile. Everything is
   worked out from your own history; anything the Engine cannot supply is left out, never faked. *@
@if (_loading)
{
    <div class="overview-page__loading" aria-busy="true" aria-label="@L["OverviewPage_LoadingYourOverview"].Value">
        <AppSkeleton Width="100%" Height="140px" />
        <AppSkeleton Width="100%" Height="88px" />
        <AppSkeleton Width="100%" Height="200px" />
    </div>
}
else if (_profile is null)
{
    <AppErrorState Title="@L["OverviewPage_YourProfileCouldnTBe"].Value"
                   Message="@L["Common_StartTheEngineOrTry"].Value"
                   Retry="@(() => LoadAsync())" />
}
else
{
    <div class="@RootClass" data-settings-overview>
        <RecycleBinLeavingSoonCard />
        <div class="overview-page__profile">
        <AppCard>
            <div class="overview-header">
                <span class="overview-header__avatar">
                    <ProfileAvatar DisplayName="@_profile.DisplayName" ImageUrl="@_profile.AvatarImageUrl" Color="@ProfileAvatarPalette.ColorFor(_profiles, _profile)" Icon="@_profile.AvatarIcon" />
                </span>
                <div class="overview-header__identity">
                    <h2 class="overview-header__name">@_profile.DisplayName</h2>
                    <p class="overview-header__joined">@L["OverviewPage_RoleAndJoined", RoleLabel, Joined]</p>
                </div>
                <div class="overview-header__actions">
                    @if (!IsKids)
                    {
                        <AppButton Label="@L["Common_EditNameAndPicture"].Value"
                                   StartIcon="@AppMaterialIcons.Outlined.Edit"
                                   Class="overview-header__edit"
                                   FullWidth="@DeviceContext.IsPhone"
                                   OnClick="OpenEditor" />
                    }
                    @* Import opens its own page (it is no longer a tab of Profile). *@
                    <AppButton Label="@L["Common_Import"].Value"
                               StartIcon="@AppMaterialIcons.Outlined.UploadFile"
                               ButtonStyle="AppButtonStyle.Outlined"
                               Class="overview-header__import"
                               FullWidth="@DeviceContext.IsPhone"
                               Href="@SettingsNav.RouteFor(SettingsSection.Overview, SettingsNav.ImportSubsection)"
                               data-overview-import />
                </div>
            </div>
        </AppCard>
        </div>

        @if (!IsKids)
        {
            @* The PIN is visible here without opening anything; password, email and devices open Security & Devices, which stays as it is. *@
            <SettingsSectionPanel Title="@L["OverviewPage_SignInAndSafety"].Value" Class="overview-page__signin">
                <ul class="overview-page__signin-list" role="list" data-overview-signin>
                    <li class="overview-page__signin-item">
                        <ProfilePinRow ProfileId="@_profile.Id" HasPin="@_profile.HasPin" CanChange="@CanChangePin" OnChanged="PinChangedAsync" />
                    </li>
                    <li class="overview-page__signin-item">
                        <SettingsNavRow Key="password-email" Icon="@AppMaterialIcons.Outlined.Key" Title="@L["OverviewPage_PasswordAndEmail"].Value"
                                        Status="@PasswordStatus" Href="/settings/security" />
                    </li>
                    <li class="overview-page__signin-item">
                        <SettingsNavRow Key="devices" Icon="@AppMaterialIcons.Outlined.Devices" Title="@L["OverviewPage_Devices"].Value"
                                        Status="@DevicesStatus" Href="/settings/security/devices" />
                    </li>
                </ul>
            </SettingsSectionPanel>
        }

        @if (_summary is not null)
        {
            <SettingsSectionPanel Title="@L["OverviewPage_Last30Days"].Value" Class="overview-page__stats">
                <OverviewStatStrip Stats="@ProfileOverviewPresentation.Stats(_summary)" />
                @if (ProfileOverviewPresentation.IsNewProfile(_summary))
                {
                    <p class="overview-page__invite" data-overview-invite>@L["OverviewPage_NothingHereYetWatchRead"]</p>
                }
            </SettingsSectionPanel>
        }

        <SettingsSectionPanel Title="@L["Common_ContinueEnjoying"].Value" Class="overview-page__continue">
            <ChildContent>
                <OverviewContinueEnjoying Shelf="@_continueShelf" />
            </ChildContent>
        </SettingsSectionPanel>

        <div class="overview-page__columns">
            <SettingsSectionPanel Title="@L["Common_RecentActivity"].Value" Class="overview-page__activity">
                <Actions>
                    <a class="overview-page__link" href="@ActivityHref" data-overview-see-all>@L["Common_SeeAll"]</a>
                </Actions>
                <ChildContent>
                    <OverviewTimeline Tiles="@_recent" SeeAllHref="@ActivityHref" />
                </ChildContent>
            </SettingsSectionPanel>

            <div class="overview-page__side">
                <SettingsSectionPanel Title="@L["OverviewPage_YourTaste"].Value" Class="overview-page__taste">
                    <Actions>
                        <a class="overview-page__link" href="@TasteHref" data-overview-taste-link>@L["OverviewPage_SeeYourTaste"]</a>
                    </Actions>
                    <ChildContent>
                        <p class="overview-page__taste-summary" data-overview-taste-summary>@(TasteLine ?? "Your taste appears here once you have watched, read or listened to a few things.")</p>
                        @if (TasteGenres.Count > 0)
                        {
                            <ul class="overview-page__taste-pills" role="list" data-overview-taste-genres>
                                @foreach (var genre in TasteGenres)
                                {
                                    <li><AppChip Text="@genre" data-overflow-tooltip="@genre" /></li>
                                }
                            </ul>
                        }
                    </ChildContent>
                </SettingsSectionPanel>

                @if (_calendar is not null)
                {
                    <SettingsSectionPanel Title="@L["OverviewPage_Last30Days"].Value" Class="overview-page__month">
                        <ChildContent>
                            <p class="overview-page__month-line" data-overview-month-line>@MonthLine</p>
                            <OverviewHeatmap Days="@_calendar" />
                        </ChildContent>
                    </SettingsSectionPanel>
                }
            </div>
        </div>
    </div>

    <ProfileEditorSheet Open="@_editorOpen"
                        Profile="@_profile"
                        SelfEdit="true"
                        Saving="@_saving"
                        Error="@_editorError"
                        OnSave="SaveProfileAsync"
                        OnClose="CloseEditor" />
}

@code {
    private ProfileViewModel? _profile;
    // The household in its order: the circle's colour is worked out from it, so it matches the top-bar menu.
    private IReadOnlyList<ProfileViewModel> _profiles = [];
    private ProfileOverviewViewModel? _overview;
    private PersonalActivitySummaryDto? _summary;
    private IReadOnlyList<PersonalActivityRecentTileDto>? _recent;
    private TastePersonDto? _taste;
    private IReadOnlyList<HeatmapDay>? _calendar;
    private bool _loading = true;
    private bool _editorOpen;
    private bool _saving;
    private string? _editorError;

    private string RootClass => DeviceContext.IsPhone ? "overview-page overview-page--phone" : "overview-page";

    // The role in plain words, as the Household page says it: Kids, Administrator or Member.
    private string RoleLabel => IsKids ? L["OverviewPage_RoleKids"].Value : CanChangePin ? L["OverviewPage_RoleAdministrator"].Value : L["OverviewPage_RoleMember"].Value;

    // What the two Security & Devices rows say right now. Until the answer is read (or if it cannot be), they keep their general wording.
    private AccountSelfServiceResponse? _account;
    private int? _signedInCount;

    private string PasswordStatus => _account?.SecurityCapabilities is not { } capabilities
        ? L["OverviewPage_PasswordAndEmailStatus"].Value
        : (capabilities.HasPassword ? L["OverviewPage_PasswordSet"].Value : L["OverviewPage_PasswordNotSet"].Value)
          + (string.IsNullOrWhiteSpace(_account.Email) ? string.Empty : " · " + _account.Email);

    private string DevicesStatus => _signedInCount switch
    {
        null => L["OverviewPage_DevicesStatus"].Value,
        1 => L["OverviewPage_DevicesSignedInOne"].Value,
        var count => L["OverviewPage_DevicesSignedIn", count].Value,
    };

    private string Joined => _profile is null ? string.Empty : _profile.CreatedAt.ToLocalTime().ToString("MMMM yyyy", CultureInfo.CurrentCulture);

    // A Kids profile has no Settings: its own activity lives on My activity.
    // A Kids profile has no Settings: it keeps its own pages, with no editing.
    private bool IsKids => _profile?.IsRestricted == true;

    // Only an administrator can change a PIN (the Engine decides); everyone else sees the state and who can set it.
    private bool CanChangePin => Session.HasAction("household.manage") || Session.HasNavigation("settings.administration") || Session.Authority?.EffectiveAdministrator == true;

    private string TasteHref => IsKids ? SettingsNav.MyTasteRoute : SettingsNav.TasteRoute;

    private string ActivityHref => _profile?.IsRestricted == true ? SettingsNav.MyActivityRoute : SettingsNav.ActivityRoute;

    // The sentence comes from the taste with the person's own removals and additions applied, so it matches the Taste page.
    // Before the Library has worked a taste out, nothing is said.
    private string? TasteLine => _taste is null ? null : ProfileOverviewPresentation.Sentence(_taste, learned: _taste.LastUpdatedAt is not null);

    private IReadOnlyList<string> TasteGenres => _taste is null || _taste.LastUpdatedAt is null
        ? []
        : [.. _taste.Genres.OrderByDescending(item => item.Weight ?? 0).Take(5).Select(item => ProfileOverviewPresentation.Capitalise(item.Value))];

    private string MonthLine
    {
        get
        {
            var days = _summary?.DaysActiveLast30 ?? 0;
            var finished = _summary?.FinishedLast30Days ?? 0;
            return $"Active on {days} of the last {ProfileOverviewPresentation.RollingDays} days · {finished} {(finished == 1 ? "title" : "titles")} finished";
        }
    }

    private const int ContinueLimit = 24;
    private MediaTileShelfViewModel _continueShelf = new() { Key = "continue", Title = string.Empty };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync(bool showSkeleton = true)
    {
        _loading = showSkeleton;
        try
        {
            _profile = await Orchestrator.GetActiveProfileAsync();
            if (_profile is null)
            {
                return;
            }

            _profiles = await Orchestrator.GetProfilesAsync();

            // The profile overview feeds Continue enjoying; the numbers and the calendar come from the activity summary.
            var overview = Api.GetProfileOverviewAsync(_profile.Id);
            var started = Api.GetDisplayContinueAsync(limit: ContinueLimit);
            var summary = Api.GetPersonalActivitySummaryAsync();
            var recent = Api.GetPersonalActivityRecentAsync(PersonalActivityPresentation.StripLimit);
            var taste = Api.GetPersonalTasteAsync(null);
            await Task.WhenAll(overview, summary, recent, taste, started);
            _overview = await overview;
            _continueShelf = new MediaTileShelfViewModel
            {
                Key = "continue",
                Title = L["Common_ContinueEnjoying"].Value,
                Items = PhoneContinueLogic.Select(PersonalTileIndex.FlattenCards(await started).Select(MediaTileComposerService.FromDisplayCard)).Take(ContinueLimit).ToList(),
            };
            _summary = await summary;
            _recent = (await recent)?.Tiles;
            _taste = (await taste)?.People.FirstOrDefault(person => person.IsYou);
            if (!IsKids)
            {
                await LoadSecurityStatusAsync();
            }

            _calendar = _summary is { Daily.Count: > 0 }
                ? ProfileOverviewPresentation.Calendar(_summary.Daily, DateOnly.FromDateTime(DateTime.UtcNow))
                : null;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(exception, "The Overview could not be loaded.");
        }
        finally
        {
            _loading = false;
        }
    }

    // Best effort: a row simply keeps its general wording when the Engine cannot say.
    private async Task LoadSecurityStatusAsync()
    {
        try
        {
            var account = Identity.GetAccountAsync();
            var sessions = Identity.GetSessionsAsync();
            _account = await account;
            _signedInCount = (await sessions) is { Count: > 0 } signedIn ? signedIn.Count : null;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogDebug(exception, "The sign-in status for My profile could not be read.");
        }
    }

    // A PIN was set, changed or removed from the PIN row: read the profile again so the row shows the new state.
    private async Task PinChangedAsync()
    {
        await Orchestrator.RefreshProfilesAsync();
        _profile = await Orchestrator.GetActiveProfileAsync() ?? _profile;
        _profiles = await Orchestrator.GetProfilesAsync();
    }

    private void OpenEditor()
    {
        _editorError = null;
        _editorOpen = true;
    }

    private void CloseEditor() => _editorOpen = false;

    // A person changes their own name and picture through the self-service routes. The existing navigation preferences are sent back
    // unchanged, because the Engine stores whatever it is given.
    private async Task SaveProfileAsync(ProfileEditorResult result)
    {
        if (_profile is not { } profile || _saving)
        {
            return;
        }

        _saving = true;
        _editorError = null;
        try
        {
            if (!await Orchestrator.UpdateProfileAsync(profile.Id, result.DisplayName, result.Color, profile.NavigationConfig))
            {
                _editorError = L["OverviewPage_ThatCouldnTBeSaved"].Value;
                return;
            }

            ProfileViewModel? photo = null;
            var photoFailed = false;
            if (result.PhotoBytes is { } bytes)
            {
                await using var stream = new MemoryStream(bytes);
                photo = await Orchestrator.UploadProfileAvatarAsync(profile.Id, stream, result.PhotoFileName ?? "photo.jpg");
                photoFailed = photo is null;
            }
            else if (result.RemovePhoto)
            {
                photoFailed = await Orchestrator.RemoveProfileAvatarAsync(profile.Id) is null;
            }

            _profile = await Orchestrator.GetActiveProfileAsync() ?? profile;
            _profiles = await Orchestrator.GetProfilesAsync();
            if (photoFailed)
            {
                _editorError = L["OverviewPage_YourChangesWereSavedBut"].Value;
                return;
            }

            _editorOpen = false;
        }
        finally
        {
            _saving = false;
        }
    }
}
