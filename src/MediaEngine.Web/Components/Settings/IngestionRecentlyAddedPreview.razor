@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Ingestion
@inject NavigationManager Nav

<section class="ingestion-recent-preview" aria-labelledby="ingestion-recent-preview-title">
    <header>
        <div><h2 id="ingestion-recent-preview-title">Recently Added</h2><p>Items completed in this ingestion run.</p></div>
        <AppButton Href="/settings/recently-added" Label="View all" ButtonStyle="AppButtonStyle.Text" EndIcon="@AppMaterialIcons.Outlined.ArrowForward" />
    </header>
    @if (Items.Count == 0)
    {
        <AppEmptyState Title="Nothing added yet" Message="Completed media will appear here while this ingestion run continues." />
    }
    else
    {
        <div class="ingestion-recent-preview__list">
            @foreach (var item in Items)
            {
                <article @key="(item.BatchId, item.GroupId)">
                    <time datetime="@item.AddedAt.ToString("O")">@item.AddedAt.ToLocalTime().ToString("h:mm tt")</time>
                    <span class="ingestion-recent-preview__art"><AppMediaArtwork ImageUrl="@item.CoverUrl" Alt="" FallbackIcon="@IngestionMediaCard.MediaIcon(item.MediaType)" /></span>
                    <span class="ingestion-recent-preview__identity"><strong>@item.Title</strong><small>@IngestionMediaCard.FriendlyType(item.MediaType)</small></span>
                    <span class="ingestion-recent-preview__result"><strong>Added to library</strong><small>@ResultSummary(item)</small></span>
                    <span class="ingestion-recent-preview__status"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CheckCircle" /><span>Completed</span></span>
                    <AppOverflowMenu AriaLabel="@($"More actions for {item.Title}")" Size="AppControlSize.Compact">
                        @if (!string.IsNullOrWhiteSpace(item.DetailRoute))
                        {
                            <AppMenuItem Label="Open details" Icon="@AppMaterialIcons.Outlined.OpenInNew" OnClick="@(() => Nav.NavigateTo(item.DetailRoute!))" />
                        }
                        <AppMenuItem Label="View ingestion run" Icon="@AppMaterialIcons.Outlined.ReceiptLong" OnClick="@(() => Nav.NavigateTo($"/settings/ingestion?runId={item.BatchId:D}&view=all"))" />
                    </AppOverflowMenu>
                </article>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<IngestionRecentDayDto> Days { get; set; } = [];
    private IReadOnlyList<IngestionMediaGroupDto> Items => Days.SelectMany(day => day.Items).OrderByDescending(item => item.AddedAt).Take(8).ToList();
    private static string ResultSummary(IngestionMediaGroupDto item) => item.ChildUnit is not null && item.ChildCompleted > 0
        ? $"{item.ChildCompleted:N0} {Pluralize(item.ChildUnit, item.ChildCompleted)} added"
        : $"{IngestionMediaCard.FriendlyType(item.MediaType)} added successfully";
    private static string Pluralize(string value, int count) => count == 1 && value.EndsWith('s') ? value[..^1] : value;
}
