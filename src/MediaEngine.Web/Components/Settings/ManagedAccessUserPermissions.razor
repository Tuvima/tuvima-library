@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Authentication

<section class="access-user-permissions">
    <AppText Typo="AppTypo.subtitle1">Media access</AppText>
    @foreach (var feature in Features.Where(feature => !(ViewStartsOff && feature.Id == "view")))
    {
        <AppSwitchRow Value="@FeatureIds.Contains(feature.Id)" ValueChanged="@((bool value) => FeatureChanged.InvokeAsync((feature.Id, value)))" Label="@feature.Label" Description="@feature.Description" />
        @if (FeatureIds.Contains(feature.Id) && !LibrariesUnavailable)
        {
            <AreaLibraryList Area="@feature.Id" Libraries="Libraries" HiddenIds="HiddenIds" PersonName="@PersonName" PrimaryName="@PrimaryName"
                             ReadOnly="ReadOnly" Busy="LibrariesBusy" OnHiddenChanged="OnHiddenChanged" />
        }
    }
    @if (ViewStartsOff)
    {
        <small>View starts off for people outside your household. Switch it on from their row once you know them.</small>
    }
    @if (LibrariesUnavailable && FeatureIds.Count > 0)
    {
        @* The area switches above still work; no library is changed while the list can't be read. *@
        <AppErrorState Compact="true" Title="Libraries not loaded" Message="The libraries could not be loaded, so which ones are hidden can't be changed right now. Libraries already hidden stay hidden; a new person starts with every library visible. Try again." Retry="RetryLibraries" />
    }
</section>

@code {
    internal static readonly IReadOnlyList<FeatureOption> Features =
    [
        new("read", "Read", "Books and comics"),
        new("watch", "Watch", "Movies and TV shows"),
        new("listen", "Listen", "Music and audiobooks"),
        new("view", "View", "Shared content and the active profile's Personal Space"),
    ];

    /// <summary>A person outside the household starts with View off, so the switch is not offered here.</summary>
    [Parameter] public bool ViewStartsOff { get; set; }
    [Parameter, EditorRequired] public IReadOnlySet<string> FeatureIds { get; set; } = new HashSet<string>();
    [Parameter, EditorRequired] public IReadOnlyList<AccessLibraryOptionDto> Libraries { get; set; } = [];

    /// <summary>The libraries hidden from the person right now; each area's list ticks everything else.</summary>
    [Parameter, EditorRequired] public IReadOnlySet<Guid> HiddenIds { get; set; } = new HashSet<Guid>();

    /// <summary>True when the Engine's library list could not be read. The libraries are then left exactly as they are.</summary>
    [Parameter] public bool LibrariesUnavailable { get; set; }
    [Parameter] public EventCallback<(string Id, bool Value)> FeatureChanged { get; set; }

    /// <summary>One tick on an area's Libraries list: the library and whether it is now hidden; answers true when it took effect.</summary>
    [Parameter] public Func<Guid, bool, Task<bool>>? OnHiddenChanged { get; set; }

    /// <summary>Asks the page to read the Engine's library list again.</summary>
    [Parameter] public EventCallback RetryLibraries { get; set; }

    /// <summary>Who the ticks belong to ("Hidden from Sam").</summary>
    [Parameter] public string PersonName { get; set; } = string.Empty;

    /// <summary>The household's main sign-in, named on libraries it hides ("Hidden by Alex").</summary>
    [Parameter] public string? PrimaryName { get; set; }

    /// <summary>True on a phone: ticks are shown but disabled.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>True while a save is running.</summary>
    [Parameter] public bool LibrariesBusy { get; set; }

    internal sealed record FeatureOption(string Id, string Label, string Description);
}
