@namespace MediaEngine.Web.Components.Settings
@inject UIOrchestratorService Orchestrator
@inject IStringLocalizer<SharedStrings> L

@* The Local AI runtime (resource profile, benchmark, runtime limits and diagnostics): the Runtime page of Local AI.
   Model files and downloads are the "Local AI models" card on Tools and requirements. The page title and its
   one-line description come from the Settings frame. *@
<div class="local-ai-runtime" data-testid="local-ai-runtime">
    <ModelsTab />
    <AppCard Title="@L["LocalAiRuntimePanel_RuntimeSettings"].Value" Density="AppSurfaceDensity.Compact">
        @if (_config is null)
        {
            <AppEmptyState Title="@L["Common_AIConfigurationUnavailable"].Value" Message="@L["LocalAiRuntimePanel_RuntimeControlsAreHiddenUntil"].Value" />
        }
        else
        {
            <div class="tl-form-grid local-ai-runtime__form">
                <AppTextField @bind-Value="_config.ModelsDirectory" Label="@L["LocalAiRuntimePanel_ModelsDirectory"].Value" />
                <AppNumericField T="int" @bind-Value="_config.IdleUnloadSeconds" Label="@L["LocalAiRuntimePanel_IdleUnloadSeconds"].Value" Min="1" />
                <AppNumericField T="int" @bind-Value="_config.InferenceTimeoutSeconds" Label="@L["LocalAiRuntimePanel_InferenceTimeoutSeconds"].Value" Min="1" />
                <AppNumericField T="int" @bind-Value="_config.MinimumFreeDiskMB" Label="@L["LocalAiRuntimePanel_MinimumFreeDiskMB"].Value" Min="256" />
                <AppNumericField T="int" @bind-Value="_config.EnrichmentBatchSize" Label="@L["LocalAiRuntimePanel_EnrichmentBatchSize"].Value" Min="1" />
            </div>
            <AppButton Label="@L["LocalAiRuntimePanel_SaveRuntimeSettings"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary"
                       Class="tl-sp-mt-3" Disabled="@_savingConfig" OnClick="@SaveConfig" />
        }
    </AppCard>
    @if (_profile is not null || _resources is not null)
    {
        <AppCard Title="@L["LocalAiRuntimePanel_RuntimeDiagnostics"].Value" Density="AppSurfaceDensity.Compact">
            <div class="local-ai-runtime__diagnostics">
                @if (_profile is not null)
                {
                    <span><strong>@L["LocalAiRuntimePanel_Backend"]</strong>@_profile.Backend</span>
                    <span><strong>@L["LocalAiRuntimePanel_Benchmark"]</strong>@BenchmarkLabel()</span>
                }
                @if (_resources is not null)
                {
                    <span><strong>@L["LocalAiRuntimePanel_EngineMemory"]</strong>@FormatMb(_resources.EngineRamMb)</span>
                    <span><strong>@L["LocalAiRuntimePanel_CPUPressure"]</strong>@CpuPressureLabel(_resources.CpuPressure)</span>
                }
            </div>
        </AppCard>
    }
</div>

@code {
    private HardwareProfileDto? _profile;
    private ResourceSnapshotDto? _resources;
    private AiConfigDto? _config;
    private bool _savingConfig;

    protected override async Task OnInitializedAsync()
    {
        _config = await Orchestrator.GetAiConfigAsync();
        _profile = await Orchestrator.GetAiProfileAsync();
        _resources = await Orchestrator.GetResourceSnapshotAsync();
    }

    private async Task SaveConfig()
    {
        if (_config is null || !ValidateRuntime())
            return;

        _savingConfig = true;
        await Orchestrator.SaveAiConfigAsync(_config);
        _savingConfig = false;
    }

    private bool ValidateRuntime() => _config is
    {
        IdleUnloadSeconds: > 0,
        InferenceTimeoutSeconds: > 0,
        MinimumFreeDiskMB: >= 256,
        EnrichmentBatchSize: > 0,
    } && !string.IsNullOrWhiteSpace(_config.ModelsDirectory);

    private static string FormatMb(long mb) => mb >= 1024 ? $"{mb / 1024.0:F1} GB" : $"{mb} MB";

    private static string CpuPressureLabel(double pressure) => pressure switch
    {
        >= 0.85 => "High",
        >= 0.5 => "Moderate",
        _ => "Low",
    };

    private string BenchmarkLabel() => _profile?.Outcome switch
    {
        "succeeded" => $"{_profile.TokensPerSecond.GetValueOrDefault():F1} tokens/sec",
        "failed" => "Failed — rerun available",
        "invalidated" => "Invalidated for this machine",
        _ => "Not run",
    };
}
