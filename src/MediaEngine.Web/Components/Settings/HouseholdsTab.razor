@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Web.Components.Profiles
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Ui
@inject DashboardIdentityClient Identity
@inject DashboardSessionAccessor Session
@inject ConfirmedActionRunner Confirmed
@inject IAppDialogService Dialogs
@inject NavigationManager Nav
@inject ILogger<HouseholdsTab> Logger
@inject IStringLocalizer<SharedStrings> L

@* Settings > Manage > Users & Households > Households. A server administrator adds, renames and removes households here; each one has its
   own people, library access and Shared Library. The Engine refuses a removal while a household still holds people, sign-ins or
   shared photos, and its sentence is shown as it is. *@
@if (!IsServerAdministrator)
{
    <AppPageState Kind="AppPageStateKind.Unavailable"
                  Icon="@AppMaterialIcons.Outlined.Lock"
                  Title="@L["HouseholdsTab_NotAvailable"].Value"
                  Message="@L["HouseholdsTab_HouseholdsAreLookedAfterBy"].Value" />
}
else
{
    <div class="households-tab" data-households-tab>
        <SettingsSectionPanel Title="@L["HouseholdsTab_Households"].Value"
                              Description="@L["HouseholdsTab_EachHouseholdHasItsOwn"].Value"
                              Icon="@AppMaterialIcons.Outlined.Home">
            <Actions>
                <AppButton Label="@L["Common_AddHousehold"].Value" StartIcon="@AppMaterialIcons.Outlined.Add" Tone="AppUiTone.Primary"
                           ButtonStyle="AppButtonStyle.Filled" Disabled="@(_adding || _busy)" OnClick="BeginAdd" />
            </Actions>
            <ChildContent>

            @if (!string.IsNullOrWhiteSpace(_notice))
            {
                <AppAlert Severity="AppSeverity.Success" Class="households-tab__notice">@_notice</AppAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <p class="households-tab__error" role="alert" data-households-error>@_error</p>
            }
            @if (_needsPassword)
            {
                @* D10: a second household needs the server administrator's own sign-in to have an email and password first. *@
                <div class="households-tab__set-password" data-households-set-password>
                    <AppButton Label="@L["Common_SetAnEmailAndPassword"].Value" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled"
                               OnClick="OpenSecurity" />
                </div>
            }

            @if (_adding)
            {
                <div class="households-tab__form" data-households-add>
                    <AppTextField Label="@L["HouseholdsTab_HouseholdName"].Value" Value="@_newName" ValueChanged="@(value => _newName = value ?? string.Empty)"
                                  MaxLength="@MaximumNameLength" Disabled="@_busy" AutoFocus="true" />
                    <div class="households-tab__form-actions">
                        <AppButton Label="@L["Vibes_Add"].Value" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled"
                                   Disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))" OnClick="AddAsync" />
                        <AppButton Label="@L["Search_Cancel"].Value" Disabled="@_busy" OnClick="CancelAdd" />
                    </div>
                </div>
            }

            @if (_loading)
            {
                <div role="status" aria-label="@L["HouseholdsTab_LoadingHouseholds"].Value">
                    <AppSkeleton Height="56px" />
                    <AppSkeleton Height="56px" />
                </div>
            }
            else if (_loadFailed)
            {
                <AppAlert Severity="AppSeverity.Warning" Variant="AppVariant.Outlined">
                    @L["HouseholdsTab_HouseholdsCouldnTBeLoaded"]
                </AppAlert>
            }
            else if (_households.Count == 0)
            {
                <AppEmptyState Title="@L["HouseholdsTab_NoHouseholds"].Value" Message="@L["HouseholdsTab_AddAHouseholdToGive"].Value" />
            }
            else
            {
                <ul class="households-tab__list" role="list" aria-label="@L["HouseholdsTab_Households"].Value">
                    @foreach (var household in _households)
                    {
                        <li class="households-tab__item" data-household-id="@household.Id" @key="household.Id">
                            @if (_renamingId == household.Id)
                            {
                                <div class="households-tab__form households-tab__form--row">
                                    <AppTextField Label="@L["HouseholdsTab_HouseholdName"].Value" Value="@_renameText" ValueChanged="@(value => _renameText = value ?? string.Empty)"
                                                  MaxLength="@MaximumNameLength" Disabled="@_busy" AutoFocus="true" />
                                    <div class="households-tab__form-actions">
                                        <AppButton Label="@L["Common_Save"].Value" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled"
                                                   Disabled="@(_busy || string.IsNullOrWhiteSpace(_renameText))" OnClick="@(() => RenameAsync(household))" />
                                        <AppButton Label="@L["Search_Cancel"].Value" Disabled="@_busy" OnClick="CancelRename" />
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="households-tab__identity">
                                    <strong class="households-tab__name">@household.Name</strong>
                                    <small class="households-tab__counts">@Counts(household)</small>
                                </div>
                                <div class="households-tab__actions">
                                    <AppButton Label="@L["Common_Rename"].Value" ButtonStyle="AppButtonStyle.Text" Disabled="@_busy"
                                               aria-label="@($"Rename {household.Name}")" OnClick="@(() => BeginRename(household))" />
                                    <AppButton Label="@L["Common_Remove"].Value" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Error" Disabled="@_busy"
                                               aria-label="@($"Remove {household.Name}")" OnClick="@(() => RemoveAsync(household))" />
                                </div>
                                <HouseholdLibraryCeiling Household="@household" Libraries="@_libraries"
                                                         LibrariesUnavailable="@_librariesUnavailable" OnSave="SaveCeilingAsync" />
                            }
                        </li>
                    }
                </ul>
            }
            </ChildContent>
        </SettingsSectionPanel>
    </div>

    <AdminUnlockDialog Open="@_needsUnlock" Busy="@_unlocking" Error="@_unlockError" OnUnlock="UnlockAsync" OnCancel="CancelUnlock" />
}

@code {
    private const int MaximumNameLength = 60;

    private List<HouseholdResponse> _households = [];
    private List<AccessLibraryOptionDto> _libraries = [];
    private bool _librariesUnavailable;
    private bool _loading = true;
    private bool _loadFailed;
    private bool _busy;
    private bool _adding;
    private string _newName = string.Empty;
    private Guid? _renamingId;
    private string _renameText = string.Empty;
    private string? _notice;
    private string? _error;
    private bool _needsPassword;
    private bool _needsUnlock;
    private bool _unlocking;
    private bool _justUnlocked;
    private string? _unlockError;
    private Func<Task>? _afterUnlock;

    private bool IsServerAdministrator => Session.Authority?.EffectiveAdministrator == true;

    protected override Task OnInitializedAsync()
    {
        // The Add household button on the Profiles list lands here with the name box already open.
        _adding = IsServerAdministrator
            && System.Web.HttpUtility.ParseQueryString(Nav.ToAbsoluteUri(Nav.Uri).Query)["add"] == "1";
        return IsServerAdministrator ? LoadAsync() : Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        _loading = _households.Count == 0;
        _loadFailed = false;
        try
        {
            _households = (await Identity.GetManagedHouseholdsAsync())
                .OrderBy(household => household.Name, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
            var libraries = await Identity.GetAccessLibrariesAsync();
            _librariesUnavailable = libraries is null;
            _libraries = libraries ?? [];
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not load the households.");
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Counts(HouseholdResponse household) =>
        $"{household.ProfileCount} {(household.ProfileCount == 1 ? "person" : "people")} · {household.AccountCount} {(household.AccountCount == 1 ? "sign-in" : "sign-ins")}";

    private void BeginAdd()
    {
        ClearMessages();
        _renamingId = null;
        _newName = string.Empty;
        _adding = true;
    }

    private void CancelAdd()
    {
        _adding = false;
        _newName = string.Empty;
        _error = null;
        _needsPassword = false;
    }

    private void BeginRename(HouseholdResponse household)
    {
        ClearMessages();
        _adding = false;
        _renamingId = household.Id;
        _renameText = household.Name;
    }

    private void CancelRename()
    {
        _renamingId = null;
        _error = null;
    }

    private Task AddAsync()
    {
        _justUnlocked = false;
        return AddCoreAsync();
    }

    private async Task AddCoreAsync()
    {
        var name = _newName.Trim();
        await RunAsync(async () =>
        {
            var result = await Confirmed.RunAsync(() => Identity.CreateManagedHouseholdResultAsync(name));
            if (!result.Succeeded)
            {
                return Refused(result.Failure, result.Message, result.Code, AddCoreAsync);
            }

            _adding = false;
            _newName = string.Empty;
            _notice = $"{result.Value?.Name ?? name} was added.";
            return true;
        });
    }

    private Task RenameAsync(HouseholdResponse household)
    {
        _justUnlocked = false;
        return RenameCoreAsync(household);
    }

    private async Task RenameCoreAsync(HouseholdResponse household)
    {
        var name = _renameText.Trim();
        await RunAsync(async () =>
        {
            var result = await Confirmed.RunAsync(() => Identity.RenameManagedHouseholdResultAsync(household.Id, name));
            if (!result.Succeeded)
            {
                return Refused(result.Failure, result.Message, result.Code, () => RenameCoreAsync(household));
            }

            _renamingId = null;
            _notice = $"Renamed to {result.Value?.Name ?? name}.";
            return true;
        });
    }

    // Saves one household's library ceiling. Answers null when it went through, or the sentence to show beside the ticks. A missing
    // administrator PIN opens the unlock prompt; the person saves again once it is granted, so the ticks are never lost.
    private async Task<string?> SaveCeilingAsync(Guid householdId, IReadOnlyList<Guid> hiddenLibraryIds)
    {
        _justUnlocked = false;
        _error = null;
        _notice = null;
        var result = await Confirmed.RunAsync(() => Identity.ReplaceHouseholdLibraryAccessResultAsync(householdId, hiddenLibraryIds));
        if (result.Succeeded)
        {
            await LoadAsync();
            return null;
        }

        if (result.Failure == DashboardAccessMutationFailure.Forbidden)
        {
            _needsUnlock = true;
            _unlockError = null;
            _afterUnlock = null;
            return "Confirm it's you, then save again.";
        }

        return !string.IsNullOrWhiteSpace(result.Message)
            ? result.Message
            : result.Failure switch
            {
                DashboardAccessMutationFailure.ConfirmItsYou => "Nothing was changed. Confirm it's you to continue.",
                DashboardAccessMutationFailure.NotFound => "That household is no longer there.",
                DashboardAccessMutationFailure.Validation => "One of those libraries is no longer available. Reload and try again.",
                DashboardAccessMutationFailure.Unauthorized => "Sign in again to continue.",
                DashboardAccessMutationFailure.Transient => "The Engine is unavailable. Try again.",
                _ => "That couldn't be saved. Try again.",
            };
    }

    private async Task RemoveAsync(HouseholdResponse household)
    {
        ClearMessages();
        if (await Dialogs.ShowMessageBoxAsync($"Remove {household.Name}?",
                "The household is removed for good. It can only be removed while it has no people, sign-ins or shared photos.",
                yesText: "Remove", cancelText: "Cancel") != true)
        {
            return;
        }

        _justUnlocked = false;
        await RemoveCoreAsync(household);
    }

    private async Task RemoveCoreAsync(HouseholdResponse household)
    {
        await RunAsync(async () =>
        {
            var result = await Confirmed.RunAsync(() => Identity.DeleteManagedHouseholdResultAsync(household.Id));
            if (!result.Succeeded)
            {
                return Refused(result.Failure, result.Message, result.Code, () => RemoveCoreAsync(household));
            }

            _notice = $"{household.Name} was removed.";
            return true;
        });
    }

    // Runs one change; when it went through, the list is read again so the counts are the Engine's.
    private async Task RunAsync(Func<Task<bool>> change)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        _notice = null;
        _needsPassword = false;
        try
        {
            if (await change())
            {
                await LoadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // A refusal: ask for the administrator PIN once if that is what is missing, otherwise say why in plain words. The Engine's own
    // sentence (a household that still holds people, a bad name) is shown as it is.
    private bool Refused(DashboardAccessMutationFailure failure, string? message, string? code, Func<Task> retry)
    {
        if (failure == DashboardAccessMutationFailure.Forbidden && !_justUnlocked)
        {
            _needsUnlock = true;
            _unlockError = null;
            _afterUnlock = retry;
            return false;
        }

        // D10: the Engine marks this refusal with a stable code, so the button shows whatever words the sentence uses.
        _needsPassword = failure == DashboardAccessMutationFailure.Conflict && code == DashboardAccessMutationResult.SecureAdministratorsFirstCode;
        _error = !string.IsNullOrWhiteSpace(message)
            ? message
            : failure switch
            {
                DashboardAccessMutationFailure.ConfirmItsYou => "Nothing was changed. Confirm it's you to continue.",
                DashboardAccessMutationFailure.Validation => "Check the name and try again.",
                DashboardAccessMutationFailure.Conflict => "That can't be done right now.",
                DashboardAccessMutationFailure.NotFound => "That household is no longer there.",
                DashboardAccessMutationFailure.Forbidden => "You can't change households.",
                DashboardAccessMutationFailure.Unauthorized => "Sign in again to continue.",
                DashboardAccessMutationFailure.Transient => "The Engine is unavailable. Try again.",
                _ => "That couldn't be saved. Try again.",
            };
        return false;
    }

    private void OpenSecurity() => Nav.NavigateTo("/settings/security");

    private void ClearMessages()
    {
        _error = null;
        _notice = null;
        _needsPassword = false;
    }

    private async Task UnlockAsync(string pin)
    {
        if (_unlocking)
        {
            return;
        }

        _unlocking = true;
        _unlockError = null;
        try
        {
            var unlocked = await Identity.UnlockAdministratorAsync(new GrantAdminUnlockRequest(pin));
            if (unlocked?.Unlocked != true)
            {
                _unlockError = "That PIN didn't work. Try again.";
                return;
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not unlock administrator access from Households.");
            _unlockError = "The Engine is unavailable. Try again.";
            return;
        }
        finally
        {
            _unlocking = false;
        }

        var retry = _afterUnlock;
        _needsUnlock = false;
        _afterUnlock = null;
        _justUnlocked = true;
        if (retry is not null)
        {
            await retry();
        }
    }

    private void CancelUnlock()
    {
        _needsUnlock = false;
        _afterUnlock = null;
        _unlockError = null;
    }
}
