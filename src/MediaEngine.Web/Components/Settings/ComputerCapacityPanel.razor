@namespace MediaEngine.Web.Components.Settings
@implements IDisposable
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Services.Playback
@inject IServiceProvider Services
@inject DeviceContextService DeviceContext
@inject IStringLocalizer<SharedStrings> L

@* Settings > Tools, Computer capacity (review mock-ups spec D1): the pinned panel above the tool list. A conic score gauge out of 100, the
   graphics hardware line (the same words as the first-run Tools step), when the test last ran, three numbers and Run again.
   Administrators only (the Tools page is a Server page and the Engine answers only administrators) and drawn nothing on a phone's reduced
   Settings. Run again measures at once with no toast: the button shows its busy state and the numbers change when the test finishes. *@
@if (!DeviceContext.IsPhone)
{
    <section class="computer-capacity" data-testid="computer-capacity" aria-labelledby="computer-capacity-title">
        <div class="computer-capacity__gauge" role="img" aria-label="@GaugeLabel" data-testid="capacity-gauge">
            @* The ring is drawn by two circles whose length is read out of 100, so the score needs no inline style. *@
            <svg class="computer-capacity__ring" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
                <circle class="computer-capacity__ring-track" cx="20" cy="20" r="17" pathLength="100" />
                <circle class="computer-capacity__ring-fill" cx="20" cy="20" r="17" pathLength="100" stroke-dasharray="@GaugeScore 100"
                        transform="rotate(-90 20 20)" data-testid="capacity-gauge-fill" />
            </svg>
            <span class="computer-capacity__score" data-testid="capacity-score">@ScoreText</span>
            <span class="computer-capacity__out-of">/ 100</span>
        </div>

        <div class="computer-capacity__words">
            <h2 class="computer-capacity__title" id="computer-capacity-title">@L["CapacityPanel_Title"]</h2>
            <p class="computer-capacity__hardware" data-testid="capacity-hardware">@HardwareLine</p>
            <p class="computer-capacity__tested" data-testid="capacity-tested">@TestedLine</p>
        </div>

        <dl class="computer-capacity__stats">
            <div class="computer-capacity__stat" data-testid="capacity-streams">
                <dt>@L["CapacityPanel_Streams"]</dt>
                <dd>@StreamsText</dd>
            </div>
            <div class="computer-capacity__stat" data-testid="capacity-four-k">
                <dt>@L["CapacityPanel_FourK"]</dt>
                <dd>@FourKText</dd>
            </div>
            <div class="computer-capacity__stat" data-testid="capacity-speed">
                <dt>@L["CapacityPanel_Speed"]</dt>
                <dd>@SpeedText</dd>
            </div>
        </dl>

        @if (!SetupMode)
        {
            <div class="computer-capacity__action">
                <AppButton Label="@RunLabel" StartIcon="@AppMaterialIcons.Outlined.Refresh" ButtonStyle="AppButtonStyle.Outlined"
                           Loading="@_running" Disabled="@(_loading || _running)" OnClick="RunAsync" data-testid="capacity-run" />
            </div>
        }

        @if (_running)
        {
            <div class="computer-capacity__note" role="status" aria-live="polite" data-testid="capacity-running">
                <AppProgressBar Indeterminate="true" />
                <span>@L["CapacityPanel_Running"]</span>
            </div>
        }
        else if (_failed)
        {
            <div class="computer-capacity__note">
                <AppAlert Tone="AppUiTone.Error" data-testid="capacity-error">@FailureText</AppAlert>
            </div>
        }
    </section>
}

@code {
    /// <summary>
    /// First-run setup draws this same panel from what the setup check already measured (no sign-in exists yet, so it cannot ask the
    /// Settings connection points): it takes <see cref="Capacity"/> and <see cref="Graphics"/> and shows no Run again button.
    /// </summary>
    [Parameter] public bool SetupMode { get; set; }
    [Parameter] public PlaybackCapacityDto? Capacity { get; set; }
    [Parameter] public GraphicsHardwareDto? Graphics { get; set; }

    // First-run setup has no sign-in, so the Engine connection is looked up only when the panel is not in setup mode.
    private IEngineApiClient ApiClient => Services.GetRequiredService<IEngineApiClient>();

    private PlaybackCapacityDto? _capacity;
    private GraphicsHardwareDto? _graphics;
    private bool _loading = true;
    private bool _running;
    private bool _failed;
    private string? _failureReason;
    private readonly CancellationTokenSource _lifetime = new();
    private bool _disposed;

    // Work that resumes after the page has gone must not touch the disposed source; it gets an already-cancelled token.
    private CancellationToken Lifetime => _disposed ? new CancellationToken(canceled: true) : _lifetime.Token;

    private bool Measured => _capacity is { Measured: true };

    private int GaugeScore => Measured ? Math.Clamp(_capacity!.Score, 0, 100) : 0;

    private string ScoreText => Measured ? GaugeScore.ToString(System.Globalization.CultureInfo.InvariantCulture) : "–";

    private string GaugeLabel => Measured ? L["CapacityPanel_GaugeLabel", GaugeScore].Value : L["CapacityPanel_NotTested"].Value;

    private string HardwareLine => GraphicsHardwareText.ForSetupRow(_graphics, L).Headline;

    private string TestedLine => _capacity is { Measured: true, TestedAt: { } at }
        ? L["CapacityPanel_Tested", at.ToLocalTime().ToString("MMM d, h:mm tt", System.Globalization.CultureInfo.CurrentCulture)].Value
        : L["CapacityPanel_NotTested"].Value;

    private string StreamsText => Measured ? _capacity!.StreamsSupported.ToString(System.Globalization.CultureInfo.InvariantCulture) : "–";

    private string FourKText => Measured ? _capacity!.FourKStreamsSupported.ToString(System.Globalization.CultureInfo.InvariantCulture) : "–";

    private string SpeedText => Measured
        ? $"{_capacity!.SpeedFactor.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}×"
        : "–";

    private string RunLabel => _running ? L["CapacityPanel_Testing"].Value : Measured ? L["CapacityPanel_RunAgain"].Value : L["CapacityPanel_RunTest"].Value;

    private string FailureText => string.IsNullOrWhiteSpace(_failureReason) ? L["CapacityPanel_CouldNotRun"].Value : _failureReason;

    protected override void OnParametersSet()
    {
        if (!SetupMode)
        {
            return;
        }

        _capacity = Capacity;
        _graphics = Graphics;
        _loading = false;
    }

    protected override async Task OnInitializedAsync()
    {
        if (SetupMode || DeviceContext.IsPhone)
        {
            return;
        }

        var capacity = ApiClient.GetPlaybackCapacityAsync(Lifetime);
        var graphics = ApiClient.GetPlaybackHardwareAsync(Lifetime);
        _capacity = await capacity;
        _graphics = await graphics;
        _loading = false;
    }

    private async Task RunAsync()
    {
        _running = true;
        _failed = false;
        _failureReason = null;
        var answer = await ApiClient.TestPlaybackCapacityAsync(Lifetime);
        _running = false;
        if (_disposed)
        {
            return;
        }

        if (answer is not { Measured: true })
        {
            _failed = true;
            _failureReason = answer?.Reason;
            return;
        }

        _capacity = answer;
        // The test may have found different graphics hardware than the page was opened with.
        _graphics = await ApiClient.GetPlaybackHardwareAsync(Lifetime) ?? _graphics;
    }

    public void Dispose()
    {
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
