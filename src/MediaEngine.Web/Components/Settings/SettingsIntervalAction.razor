@namespace MediaEngine.Web.Components.Settings

<AppButton ButtonStyle="AppButtonStyle.Text"
           Size="AppControlSize.Compact"
           Class="@RootClass"
           aria-label="@ResolvedAriaLabel"
           OnClick="OnClick">
    <AppMaterialIcon Icon="@Icon" />
    <span class="settings-interval-action__copy">
        <span class="settings-interval-action__value">@Value</span>
        <span class="settings-interval-action__label">@Label</span>
    </span>
</AppButton>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string ResolvedAriaLabel =>
        string.IsNullOrWhiteSpace(AriaLabel) ? $"{Label}, {Value}" : AriaLabel;

    private string RootClass => string.Join(" ", new[] { "settings-interval-action", Class }
        .Where(value => !string.IsNullOrWhiteSpace(value)));
}
