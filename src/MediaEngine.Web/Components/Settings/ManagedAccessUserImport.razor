@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Backups
@using MediaEngine.Web.Services.Integration
@using Microsoft.AspNetCore.Components.Forms
@inject DashboardIdentityClient Identity
@inject ConfirmedActionRunner Confirmed

@* Import a user (backup and restore spec D19): choose the file, see who is in it, then add them. The Engine writes nothing until
   Import is pressed, and it refuses in its own sentences (shown as they are). It lives in the Users drawer, so it is never drawn on phones. *@
<section class="user-import" aria-busy="@_busy" data-testid="user-import">
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <AppAlert Severity="AppSeverity.Error" data-testid="user-import-error">@_error</AppAlert>
    }

    @if (_preview is null)
    {
        <p class="user-import__lead">Choose a user file made by Export on this or another Library. You'll see who is in it before anyone is added.</p>
        @if (_busy)
        {
            <AppProgressBar Indeterminate="true" aria-label="Checking the file" />
        }
        <div class="user-import__actions">
            <AppButton Label="Cancel" Disabled="@_busy" OnClick="CancelAsync" />
            <AppFileUpload T="IBrowserFile" Accept=".zip,application/zip" Disabled="@_busy" FilesChanged="PickFileAsync">
                <CustomContent Context="upload">
                    <AppButton Label="Choose file" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@_busy" OnClick="upload.OpenFilePickerAsync" data-testid="user-import-choose" />
                </CustomContent>
            </AppFileUpload>
        </div>
    }
    else
    {
        <div class="user-import__preview" data-testid="user-import-preview">
            <strong class="user-import__email">@_preview.Email</strong>
            @if (!string.IsNullOrWhiteSpace(_preview.HouseholdName))
            {
                <span class="user-import__household">Household: @_preview.HouseholdName</span>
            }
            <ul class="user-import__profiles" aria-label="Profiles">
                @foreach (var profile in _preview.Profiles)
                {
                    var note = ProfileNote(profile);
                    <li>
                        <span>@profile.Name</span>
                        @if (note is not null)
                        {
                            <small>@note</small>
                        }
                    </li>
                }
            </ul>
            @if (_preview.TwoStepToSetUp)
            {
                <p data-testid="user-import-two-step">They'll need to set up two-step sign-in again after they sign in.</p>
            }
            <p>@ItemsSentence(_preview.PersonalItems)</p>
            @if (string.IsNullOrWhiteSpace(_preview.BlockedReason))
            {
                <p>They can sign in straight away but won't see any libraries until you give them access.</p>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(_preview.BlockedReason))
        {
            <AppAlert Severity="AppSeverity.Warning" data-testid="user-import-blocked">@_preview.BlockedReason</AppAlert>
        }
        @if (_busy)
        {
            <AppProgressBar Indeterminate="true" aria-label="Adding the user" />
        }
        <div class="user-import__actions">
            <AppButton Label="Cancel" Disabled="@_busy" OnClick="CancelAsync" />
            @if (CanImport)
            {
                <AppButton Label="Import" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@_busy" OnClick="ImportAsync" data-testid="user-import-confirm" />
            }
        </div>
    }
</section>

@code {
    private UserImportPreviewDto? _preview;
    private string? _error;
    private bool _busy;
    private bool _refused;

    /// <summary>Raised with the result once the user has been added.</summary>
    [Parameter] public EventCallback<UserImportResultDto> Imported { get; set; }

    /// <summary>Raised when the administrator backs out.</summary>
    [Parameter] public EventCallback Cancelled { get; set; }

    private bool CanImport => _preview is not null && string.IsNullOrWhiteSpace(_preview.BlockedReason) && !_refused;

    private Task CancelAsync() => _busy ? Task.CompletedTask : Cancelled.InvokeAsync();

    private async Task PickFileAsync(IBrowserFile? file)
    {
        if (file is null || _busy)
            return;
        _error = null;
        if (file.Size > DashboardIdentityClient.MaxUserImportBytes)
        {
            _error = "This file is too large to be a user export.";
            return;
        }

        _busy = true;
        try
        {
            var result = await Confirmed.RunAsync(() => Identity.InspectUserImportResultAsync(
                () => file.OpenReadStream(DashboardIdentityClient.MaxUserImportBytes), file.Name));
            if (result.Succeeded && result.Value is { } preview)
                _preview = preview;
            else
                _error = FailureSentence(result.Failure, result.Message, "The file couldn't be checked. Try again.", "Nothing was checked. Confirm it's you to continue.");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportAsync()
    {
        if (_preview is null || !CanImport || _busy)
            return;
        _error = null;
        _busy = true;
        UserImportResultDto? added = null;
        try
        {
            var result = await Confirmed.RunAsync(() => Identity.ImportUserResultAsync(_preview.OperationId));
            if (result.Succeeded && result.Value is { } value)
            {
                added = value;
            }
            else
            {
                // Stay on the preview, but there is nothing left to press: the Engine's sentence says why.
                _refused = true;
                _error = FailureSentence(result.Failure, result.Message, "The user couldn't be added. Try again.", "Nothing was added. Confirm it's you to continue.");
            }
        }
        finally
        {
            _busy = false;
        }

        if (added is not null)
            await Imported.InvokeAsync(added);
    }

    // The Engine's own sentence is shown as it is; the generic line is only for a failure it gave no reason for.
    private static string FailureSentence(DashboardAccessMutationFailure failure, string? engineMessage, string fallback, string confirmItsYou) =>
        failure == DashboardAccessMutationFailure.ConfirmItsYou ? confirmItsYou
        : !string.IsNullOrWhiteSpace(engineMessage) ? engineMessage
        : failure == DashboardAccessMutationFailure.Transient ? "The Engine is unavailable. Try again."
        : fallback;

    // An Administrator role in a file is shown as a standard profile: an import never carries administrator rights.
    internal static string? ProfileNote(UserImportProfileDto profile)
    {
        var parts = new List<string>(2);
        if (string.Equals(profile.Role, "RestrictedProfile", StringComparison.OrdinalIgnoreCase))
            parts.Add("Kids profile");
        if (!string.IsNullOrWhiteSpace(profile.ContentLimit))
            parts.Add(profile.ContentLimitAllowUnrated ? $"limited to {profile.ContentLimit}, unrated titles allowed" : $"limited to {profile.ContentLimit}");
        return parts.Count == 0 ? null : string.Join(", ", parts);
    }

    internal static string ItemsSentence(int items) => items switch
    {
        0 => "No progress, bookmarks or favourites come with them.",
        1 => "1 item of progress, bookmarks and favourites, which returns when its title is found.",
        _ => $"{items:N0} items of progress, bookmarks and favourites, which return as their titles are found.",
    };
}
