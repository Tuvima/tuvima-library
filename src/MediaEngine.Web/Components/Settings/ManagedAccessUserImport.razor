@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Backups
@using MediaEngine.Web.Services.Integration
@using Microsoft.AspNetCore.Components.Forms
@inject DashboardIdentityClient Identity
@inject ConfirmedActionRunner Confirmed
@inject NavigationManager Nav

@* Import people (backup and restore spec D19, users spec D9): choose the file, see who is in it, choose where they go and what to keep,
   then add them. The Engine writes nothing until Import is pressed, and it refuses in its own sentences (shown as they are). Roles are
   never carried: everyone arrives as an ordinary member (Kids stays Kids), and Read, Watch, Listen and View arrive only when ticked.
   It lives in the Users drawer, so it is never drawn on phones. *@
<section class="user-import" aria-busy="@_busy" data-testid="user-import">
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <AppAlert Severity="AppSeverity.Error" data-testid="user-import-error">@_error</AppAlert>
    }

    @if (_preview is null)
    {
        <p class="user-import__lead">Choose a file made by Export on this or another Library: one person, or a whole household. You'll see who is in it before anyone is added.</p>
        @if (_busy)
        {
            <AppProgressBar Indeterminate="true" aria-label="Checking the file" />
        }
        <div class="user-import__actions">
            <AppButton Label="Cancel" Disabled="@_busy" OnClick="CancelAsync" />
            <AppFileUpload T="IBrowserFile" Accept=".zip,application/zip" Disabled="@_busy" FilesChanged="PickFileAsync">
                <CustomContent Context="upload">
                    <AppButton Label="Choose file" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@_busy" OnClick="upload.OpenFilePickerAsync" data-testid="user-import-choose" />
                </CustomContent>
            </AppFileUpload>
        </div>
    }
    else
    {
        <div class="user-import__preview" data-testid="user-import-preview">
            <strong class="user-import__email">@Title</strong>
            @if (!string.IsNullOrWhiteSpace(_preview.HouseholdName))
            {
                <span class="user-import__household">Household: @_preview.HouseholdName</span>
            }
            <ul class="user-import__profiles" aria-label="Profiles">
                @foreach (var profile in _preview.Profiles)
                {
                    var note = ProfileNote(profile);
                    var signIn = SignInOf(profile);
                    <li>
                        <span>@profile.Name</span>
                        @if (note is not null)
                        {
                            <small>@note</small>
                        }
                        @if (signIn is null)
                        {
                            <small>no sign-in</small>
                        }
                    </li>
                }
            </ul>
            @if (_preview.TwoStepToSetUp)
            {
                <p data-testid="user-import-two-step">They'll need to set up two-step sign-in again after they sign in.</p>
            }
            <p>@ItemsSentence(_preview.PersonalItems)</p>
        </div>

        @if (string.IsNullOrWhiteSpace(_preview.BlockedReason))
        {
            @if (_preview.SignIns.Count > 0)
            {
                <div class="user-import__preview" data-testid="user-import-signins">
                    <strong>Sign-ins</strong>
                    @for (var index = 0; index < _preview.SignIns.Count; index++)
                    {
                        var signIn = _preview.SignIns[index];
                        var position = index;
                        var profile = _preview.Profiles.FirstOrDefault(candidate => candidate.Id == signIn.ProfileId);
                        var forcedOff = signIn.Problem is not null;
                        var off = forcedOff || _without.Contains(signIn.Id);
                        <div class="user-import__preview" data-testid="user-import-signin">
                            <small>@(profile?.Name ?? "Profile")</small>
                            @if (signIn.Problem is not null)
                            {
                                <small data-testid="user-import-signin-problem">@signIn.Problem</small>
                            }
                            else
                            {
                                <AppTextField Value="@EmailOf(signIn)" ValueChanged="@(value => SetEmail(signIn, value))" Label="Email" Disabled="@(off || _busy)"
                                              data-testid="@($"user-import-email-{position}")" />
                                @if (!off && signIn.EmailInUse && EmailUnchanged(signIn))
                                {
                                    <small data-testid="user-import-email-used">Someone here already signs in with this email. Choose a different one, or import without a sign-in.</small>
                                }
                                <AppCheckbox Value="@off" ValueChanged="@(value => SetWithout(signIn, value))" Label="Import without a sign-in" Disabled="@_busy"
                                             data-testid="@($"user-import-without-{position}")" />
                            }
                        </div>
                    }
                </div>
            }

            <div class="user-import__preview" data-testid="user-import-where">
                <strong>Put them in</strong>
                <AppSegmentedControl Options="@TargetChoices" Value="@Target" ValueChanged="SetTarget" AriaLabel="Which household?" />
                @if (Target == ExistingHousehold)
                {
                    <AppNativeSelect Value="@_household" OnChange="@(value => _household = value.Value?.ToString() ?? string.Empty)" aria-label="Household" data-testid="user-import-household">
                        <option value="">Choose a household</option>
                        @foreach (var household in _preview.Households)
                        {
                            <option value="@household.Id">@household.Name (@PeopleSentence(household.Profiles))</option>
                        }
                    </AppNativeSelect>
                    @if (HouseholdFull)
                    {
                        <small data-testid="user-import-full">That household has room for @Room more, and the file has @_preview.Profiles.Count. A household can have up to @_preview.MaxProfilesPerHousehold people.</small>
                    }
                }
                else
                {
                    @if (!_preview.CanAddHousehold)
                    {
                        <small data-testid="user-import-secure-first">@_preview.AddHouseholdBlockedReason</small>
                        <AppButton Label="Set an email and password" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" OnClick="OpenSecurity" />
                    }
                    else
                    {
                        <AppTextField @bind-Value="_newHouseholdName" Label="New household name" FullWidth="true" data-testid="user-import-new-household" />
                        <AppNativeSelect Value="@_administrator" OnChange="@(value => _administrator = value.Value?.ToString() ?? string.Empty)" aria-label="Who looks after it" data-testid="user-import-administrator">
                            <option value="">Who looks after it?</option>
                            @foreach (var profile in AdministratorChoices)
                            {
                                <option value="@profile.Id">@profile.Name</option>
                            }
                        </AppNativeSelect>
                        <small>They manage the household's people. They need a sign-in and can't be a Kids profile.</small>
                    }
                }
            </div>

            @if (_preview.Profiles.Any(profile => profile.Access is { Count: > 0 }))
            {
                <div class="user-import__preview">
                    <AppCheckbox @bind-Value="_keepAccess" Label="Keep their access" data-testid="user-import-keep-access" />
                    <small>Keeps Read, Watch, Listen and View as the file had them. Libraries are never carried, so they won't see any libraries until you give them access.</small>
                </div>
            }

            <p data-testid="user-import-summary">@Summary</p>
        }
        else
        {
            <AppAlert Severity="AppSeverity.Warning" data-testid="user-import-blocked">@_preview.BlockedReason</AppAlert>
        }
        @if (_busy)
        {
            <AppProgressBar Indeterminate="true" aria-label="Adding the people" />
        }
        <div class="user-import__actions">
            <AppButton Label="Cancel" Disabled="@_busy" OnClick="CancelAsync" />
            @if (string.IsNullOrWhiteSpace(_preview.BlockedReason))
            {
                <AppButton Label="Import" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@(_busy || !CanImport)" OnClick="ImportAsync" data-testid="user-import-confirm" />
            }
        </div>
    }
</section>

@code {
    private const string ExistingHousehold = "existing";
    private const string NewHousehold = "new";

    private static readonly IReadOnlyList<AppSelectOption> TargetChoices =
    [
        new(ExistingHousehold, "A household that exists"),
        new(NewHousehold, "A new household"),
    ];

    private UserImportPreviewDto? _preview;
    private string? _error;
    private bool _busy;
    private string? _target;
    private string _household = string.Empty;
    private string _newHouseholdName = string.Empty;
    private string _administrator = string.Empty;
    private bool _keepAccess;
    private readonly Dictionary<Guid, string> _emails = [];
    private readonly HashSet<Guid> _without = [];

    /// <summary>Raised with the result once the people have been added.</summary>
    [Parameter] public EventCallback<UserImportResultDto> Imported { get; set; }

    /// <summary>Raised when the administrator backs out.</summary>
    [Parameter] public EventCallback Cancelled { get; set; }

    private string Title => _preview is null ? string.Empty
        : _preview.Scope == "household" ? $"{_preview.Profiles.Count} people"
        : _preview.Profiles.FirstOrDefault()?.Name ?? "One person";

    // With no household to choose from, the only way forward is a new one.
    private string Target => _target ?? (_preview is { Households.Count: > 0 } ? ExistingHousehold : NewHousehold);

    private UserImportSignInDto? SignInOf(UserImportProfileDto profile) =>
        profile.SignInId is { } id ? _preview?.SignIns.FirstOrDefault(signIn => signIn.Id == id) : null;

    private string EmailOf(UserImportSignInDto signIn) => _emails.TryGetValue(signIn.Id, out var value) ? value : signIn.Email;

    private bool EmailUnchanged(UserImportSignInDto signIn) =>
        string.Equals(EmailOf(signIn).Trim(), signIn.Email.Trim(), StringComparison.OrdinalIgnoreCase);

    private void SetEmail(UserImportSignInDto signIn, string? value) => _emails[signIn.Id] = value ?? string.Empty;

    private void SetWithout(UserImportSignInDto signIn, bool value)
    {
        if (value)
            _without.Add(signIn.Id);
        else
            _without.Remove(signIn.Id);
        if (!AdministratorChoices.Any(profile => profile.Id.ToString() == _administrator))
            _administrator = string.Empty;
    }

    private void SetTarget(string target) => _target = target == NewHousehold ? NewHousehold : ExistingHousehold;

    private bool IsKept(UserImportSignInDto signIn) => signIn.Problem is null && !_without.Contains(signIn.Id);

    // Someone to look after a new household: a profile that keeps its sign-in and is not a Kids profile (the Engine checks this too).
    private IEnumerable<UserImportProfileDto> AdministratorChoices => _preview is null ? [] : _preview.Profiles.Where(profile =>
        !string.Equals(profile.Role, "RestrictedProfile", StringComparison.OrdinalIgnoreCase)
        && SignInOf(profile) is { } signIn && IsKept(signIn));

    private UserImportHouseholdDto? ChosenHousehold =>
        Guid.TryParse(_household, out var id) ? _preview?.Households.FirstOrDefault(household => household.Id == id) : null;

    private int Room => _preview is null || ChosenHousehold is not { } chosen ? 0 : Math.Max(0, _preview.MaxProfilesPerHousehold - chosen.Profiles);

    private bool HouseholdFull => Target == ExistingHousehold && _preview is not null && ChosenHousehold is not null && _preview.Profiles.Count > Room;

    private bool CanImport
    {
        get
        {
            if (_preview is null || !string.IsNullOrWhiteSpace(_preview.BlockedReason))
                return false;
            foreach (var signIn in _preview.SignIns.Where(IsKept))
            {
                if (string.IsNullOrWhiteSpace(EmailOf(signIn)) || (signIn.EmailInUse && EmailUnchanged(signIn)))
                    return false;
            }

            return Target == ExistingHousehold
                ? ChosenHousehold is not null && !HouseholdFull
                : _preview.CanAddHousehold
                    && !string.IsNullOrWhiteSpace(_newHouseholdName)
                    && AdministratorChoices.Any(profile => profile.Id.ToString() == _administrator);
        }
    }

    private string Summary
    {
        get
        {
            var access = _keepAccess && _preview is not null && _preview.Profiles.Any(profile => profile.Access is { Count: > 0 })
                ? "with the Read, Watch, Listen and View access the file had"
                : "with no access, so they won't see any libraries until you give them access";
            return $"They arrive as ordinary members (Kids profiles stay Kids) {access}.";
        }
    }

    private Task CancelAsync() => _busy ? Task.CompletedTask : Cancelled.InvokeAsync();

    private void OpenSecurity() => Nav.NavigateTo("/settings/security");

    private async Task PickFileAsync(IBrowserFile? file)
    {
        if (file is null || _busy)
            return;
        _error = null;
        if (file.Size > DashboardIdentityClient.MaxUserImportBytes)
        {
            _error = "This file is too large to be a user export.";
            return;
        }

        _busy = true;
        try
        {
            var result = await Confirmed.RunAsync(() => Identity.InspectUserImportResultAsync(
                () => file.OpenReadStream(DashboardIdentityClient.MaxUserImportBytes), file.Name));
            if (result.Succeeded && result.Value is { } preview)
                StartChoices(preview);
            else
                _error = FailureSentence(result.Failure, result.Message, "The file couldn't be checked. Try again.", "Nothing was checked. Confirm it's you to continue.");
        }
        finally
        {
            _busy = false;
        }
    }

    // The choices start where the Engine says is safe: the file's emails, every sign-in that can move kept, a new household named as the
    // file named it, and no access carried.
    private void StartChoices(UserImportPreviewDto preview)
    {
        _preview = preview;
        _target = null;
        _household = preview.Households.Count == 1 ? preview.Households[0].Id.ToString() : string.Empty;
        _newHouseholdName = preview.HouseholdName ?? string.Empty;
        _administrator = string.Empty;
        _keepAccess = false;
        _emails.Clear();
        _without.Clear();
        foreach (var signIn in preview.SignIns)
            _emails[signIn.Id] = signIn.Email;
        var candidates = AdministratorChoices.ToList();
        if (candidates.Count == 1)
            _administrator = candidates[0].Id.ToString();
    }

    private UserImportRequestDto BuildRequest()
    {
        var emails = new Dictionary<Guid, string>();
        foreach (var signIn in _preview!.SignIns.Where(IsKept).Where(signIn => !EmailUnchanged(signIn)))
            emails[signIn.Id] = EmailOf(signIn).Trim();
        var without = _preview.SignIns.Where(signIn => !IsKept(signIn)).Select(signIn => signIn.Id).ToList();
        return Target == ExistingHousehold
            ? new UserImportRequestDto(TargetHouseholdId: Guid.Parse(_household), KeepAccess: _keepAccess, Emails: emails, WithoutSignIn: without)
            : new UserImportRequestDto(
                NewHouseholdName: _newHouseholdName.Trim(),
                NewHouseholdAdministratorProfileId: Guid.Parse(_administrator),
                KeepAccess: _keepAccess,
                Emails: emails,
                WithoutSignIn: without);
    }

    private async Task ImportAsync()
    {
        if (_preview is null || !CanImport || _busy)
            return;
        _error = null;
        _busy = true;
        UserImportResultDto? added = null;
        try
        {
            var request = BuildRequest();
            var operation = _preview.OperationId;
            var result = await Confirmed.RunAsync(() => Identity.ImportUserResultAsync(operation, request));
            if (result.Succeeded && result.Value is { } value)
            {
                added = value;
            }
            else
            {
                // The Engine keeps the file after a refusal, so a choice (another email, another household) can be changed and tried again.
                _error = FailureSentence(result.Failure, result.Message, "The people couldn't be added. Try again.", "Nothing was added. Confirm it's you to continue.");
            }
        }
        finally
        {
            _busy = false;
        }

        if (added is not null)
            await Imported.InvokeAsync(added);
    }

    // The Engine's own sentence is shown as it is; the generic line is only for a failure it gave no reason for.
    private static string FailureSentence(DashboardAccessMutationFailure failure, string? engineMessage, string fallback, string confirmItsYou) =>
        failure == DashboardAccessMutationFailure.ConfirmItsYou ? confirmItsYou
        : !string.IsNullOrWhiteSpace(engineMessage) ? engineMessage
        : failure == DashboardAccessMutationFailure.Transient ? "The Engine is unavailable. Try again."
        : fallback;

    // Roles are never carried: an administrator role in a file is shown as arriving as an ordinary member.
    internal static string? ProfileNote(UserImportProfileDto profile)
    {
        var parts = new List<string>(2);
        if (string.Equals(profile.Role, "RestrictedProfile", StringComparison.OrdinalIgnoreCase))
            parts.Add("Kids profile");
        if (!string.IsNullOrWhiteSpace(profile.ContentLimit))
            parts.Add(profile.ContentLimitAllowUnrated ? $"limited to {profile.ContentLimit}, unrated titles allowed" : $"limited to {profile.ContentLimit}");
        return parts.Count == 0 ? null : string.Join(", ", parts);
    }

    internal static string PeopleSentence(int people) => people == 1 ? "1 person" : $"{people} people";

    internal static string ItemsSentence(int items) => items switch
    {
        0 => "No progress, bookmarks or favourites come with them.",
        1 => "1 item of progress, bookmarks and favourites, which returns when its title is found.",
        _ => $"{items:N0} items of progress, bookmarks and favourites, which return as their titles are found.",
    };
}
