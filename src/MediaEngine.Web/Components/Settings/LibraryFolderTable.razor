@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Models.ViewDTOs

@* One media type's folders as a table: folder (its icon says whether Library manages it or only reads it), where new media goes, and what happens to its files.
   Under 840px of its own width each row becomes a stacked card. The host owns every save; this component only raises what was
   tapped. One polite live region (below) announces what is organising or merging, instead of one per row. *@
<span class="sr-only" role="status">@LiveStatusText</span>
<div class="folder-table" role="table" aria-label="@($"{TypeLabel} folders")">
    <div class="folder-table__head" role="row">
        <span role="columnheader">Folder</span>
        <span role="columnheader">New media</span>
        <span role="columnheader">Files</span>
        <span role="columnheader"><span class="sr-only">Actions</span></span>
    </div>
    @foreach (var source in Library.Sources)
    {
        var managed = IsManaged(source);
        var converting = IsConverting(source);
        var job = JobFor(source);
        var marked = IsNewMediaFolder(source);
        var issue = IssueFor(source);
        var name = source.DisplayName();
        <div class="@RowClass(source)" role="row" @key="source.Id">
            <div class="folder-table__folder" role="cell">
                <span class="@HandlingIconClass(source)" role="img" aria-label="@HandlingTitle(source)" title="@HandlingTitle(source)">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Folder" />
                    @if (!managed)
                    {
                        <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Lock" Class="folder-table__lock" />
                    }
                </span>
                <div class="folder-table__folder-text">
                    <strong>@name</strong>
                    <span class="folder-table__path" title="@source.Path">@source.Path</span>
                    @if (job is not null)
                    {
                        <FolderJobStatusLine Job="@job"
                                             Name="@name"
                                             ReadOnly="@(ReadOnly || Busy)"
                                             OnControl="@(action => OnJobControl.InvokeAsync(new FolderJobControl(source, job, action)))" />
                    }
                    else if (converting)
                    {
                        <span class="folder-table__status">Organising…</span>
                    }
                    else if (IsMerging(source))
                    {
                        <span class="folder-table__status">Merging…</span>
                    }
                    @if (IsMerged(source))
                    {
                        <span class="folder-table__status">@MergedText(source)</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(issue))
                    {
                        <span class="folder-table__status folder-table__status--warning">@issue</span>
                    }
                </div>
            </div>
            <div class="@(marked ? "folder-table__marker is-marked" : "folder-table__marker")" role="cell">
                @if (!managed)
                {
                    <span class="folder-table__none" role="img" aria-label="Not a place for new media">—</span>
                }
                else
                {
                    <div class="folder-table__radio-group" role="radiogroup" aria-label="@($"Where new {PluralLabel} go")">
                        <AppNativeButton Type="button"
                                         Class="folder-table__radio"
                                         role="radio"
                                         aria-checked="@(marked ? "true" : "false")"
                                         Disabled="@(ReadOnly || Busy)"
                                         AriaLabel="@(marked ? $"{name} is where new {PluralLabel} go" : $"Make {name} the place for new {PluralLabel}")"
                                         OnClick="@(_ => marked ? Task.CompletedTask : OnSetDestination.InvokeAsync(source))">
                            <AppMaterialIcon Icon="@(marked ? AppMaterialIcons.Filled.RadioButtonChecked : AppMaterialIcons.Outlined.RadioButtonUnchecked)" />
                            @if (marked)
                            {
                                <span class="folder-table__radio-text">New media goes here</span>
                            }
                        </AppNativeButton>
                    </div>
                }
            </div>
            <div class="folder-table__files" role="cell">
                <span class="folder-table__files-value">@FilesLabel(source)</span>
                @if (ShowAdvancedHint)
                {
                    <small class="folder-table__files-hint">Change in Advanced &gt; @TypeLabel</small>
                }
            </div>
            <div class="folder-table__actions" role="cell">
                <AppNativeButton Type="button"
                                 Class="folder-table__expand"
                                 AriaLabel="@($"Show details for {name}")"
                                 aria-expanded="@(IsExpanded(source) ? "true" : "false")"
                                 OnClick="@(_ => Toggle(source))">
                    <AppMaterialIcon Icon="@(IsExpanded(source) ? AppMaterialIcons.Outlined.ExpandLess : AppMaterialIcons.Outlined.ExpandMore)" />
                </AppNativeButton>
                @if (!ReadOnly)
                {
                    <AppOverflowMenu AriaLabel="@($"Actions for {name}")" Disabled="@Busy" Class="folder-table__menu" TriggerClass="folder-table__menu-trigger">
                        @if (managed && !marked)
                        {
                            <AppMenuItem Label="@($"Make this the place for new {PluralLabel}")" Icon="@AppMaterialIcons.Outlined.RadioButtonUnchecked" OnClick="@(() => OnSetDestination.InvokeAsync(source))" />
                        }
                        @if (managed && job is null)
                        {
                            <AppMenuItem Label="Organise files now" Icon="@AppMaterialIcons.Outlined.DriveFileMove" OnClick="@(() => OnOrganiseNow.InvokeAsync(source))" />
                        }
                        @if (CanMerge(source, job))
                        {
                            <AppMenuItem Label="Merge into…" Icon="@AppMaterialIcons.Outlined.ArrowForward" OnClick="@(() => OnMerge.InvokeAsync(source))" />
                        }
                        <AppMenuItem Label="@(managed ? "Switch to Read-only" : "Switch to Managed")" Icon="@(managed ? AppMaterialIcons.Outlined.Lock : AppMaterialIcons.Outlined.DriveFileMove)" Disabled="@IsMerging(source)" OnClick="@(() => OnChangeHandling.InvokeAsync(source))" />
                        <AppMenuItem Label="Label" Icon="@AppMaterialIcons.Outlined.Edit" OnClick="@(() => OnLabel.InvokeAsync(source))" />
                        <AppMenuItem Label="Remove folder" Icon="@AppMaterialIcons.Outlined.Delete" Tone="AppUiTone.Error" DividerBefore="true" OnClick="@(() => OnRemove.InvokeAsync(source))" />
                    </AppOverflowMenu>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public LibraryFolderDto Library { get; set; } = new();
    [Parameter] public string TypeLabel { get; set; } = string.Empty;
    [Parameter] public string PluralLabel { get; set; } = string.Empty;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Busy { get; set; }
    /// <summary>Shows "Change in Advanced > Type" under the Files value. Off where there is no Advanced section to go to (first-run setup).</summary>
    [Parameter] public bool ShowAdvancedHint { get; set; } = true;
    /// <summary>Folder path to a plain-English problem ("Folder unavailable", "No access"); absent when the folder is fine.</summary>
    [Parameter] public IReadOnlyDictionary<string, string>? PathIssues { get; set; }
    [Parameter] public EventCallback<LibrarySourceDto> OnChangeHandling { get; set; }
    [Parameter] public EventCallback<LibrarySourceDto> OnSetDestination { get; set; }
    [Parameter] public EventCallback<LibrarySourceDto> OnLabel { get; set; }
    [Parameter] public EventCallback<LibrarySourceDto> OnRemove { get; set; }
    /// <summary>The latest folder job for each folder (by folder id): progress while it runs, how it went afterwards.</summary>
    [Parameter] public IReadOnlyDictionary<string, FolderJobStatusDto>? Jobs { get; set; }
    /// <summary>Raised when Pause, Resume or Cancel is chosen on a folder's job.</summary>
    [Parameter] public EventCallback<FolderJobControl> OnJobControl { get; set; }
    /// <summary>Raised from the row menu to organise the files already in a managed folder.</summary>
    [Parameter] public EventCallback<LibrarySourceDto> OnOrganiseNow { get; set; }
    /// <summary>Raised from the row menu to merge a folder, once, into one of the type's managed folders.</summary>
    [Parameter] public EventCallback<LibrarySourceDto> OnMerge { get; set; }

    /// <summary>One press of Pause, Resume or Cancel on a folder's job.</summary>
    public sealed record FolderJobControl(LibrarySourceDto Source, FolderJobStatusDto Job, string Action);

    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>What the Files cell says for a folder. Shared with tests so the wording has one owner.</summary>
    public static string FilesText(LibraryFolderDto library, LibrarySourceDto source) => !IsManaged(source)
        ? "Not touched"
        : library.OrganizationPolicy.WriteTags ? "Named + tagged" : "Named";

    /// <summary>True once the Merge into menu item exists; the Import folder panel shows its Merge hint only then.</summary>
    public static bool HasMergeAction => true;

    /// <summary>
    /// Whether Merge into is offered for a folder: another managed folder of the type is there to receive the files, nothing is
    /// running on this folder, it has not been merged already, and it is not where new media goes (that folder is a target).
    /// Shared with tests so the rule has one owner.
    /// </summary>
    public static bool CanMergeInto(LibraryFolderDto library, LibrarySourceDto source, bool jobOpen) =>
        !jobOpen
        && !IsConverting(source)
        && string.Equals(source.MergeState, "none", StringComparison.OrdinalIgnoreCase)
        && !ReferenceEquals(source, library.GetPrimaryDestination())
        && MergeTargets(library, source).Count > 0;

    /// <summary>The managed folders a folder can be merged into: every other managed folder of the type that is not itself merged away.</summary>
    public static IReadOnlyList<LibrarySourceDto> MergeTargets(LibraryFolderDto library, LibrarySourceDto source) => library.Sources
        .Where(candidate => !ReferenceEquals(candidate, source)
            && candidate.Id != source.Id
            && IsManaged(candidate)
            && string.Equals(candidate.MergeState, "none", StringComparison.OrdinalIgnoreCase))
        .ToList();

    private static bool IsManaged(LibrarySourceDto source) => source.ManagementMode == "managed_by_tuvima";
    private static bool IsConverting(LibrarySourceDto source) => string.Equals(source.ConversionState, "converting", StringComparison.OrdinalIgnoreCase);
    private static bool IsMerging(LibrarySourceDto source) => string.Equals(source.MergeState, "merging", StringComparison.OrdinalIgnoreCase);
    private static bool IsMerged(LibrarySourceDto source) => string.Equals(source.MergeState, "merged", StringComparison.OrdinalIgnoreCase);

    private bool CanMerge(LibrarySourceDto source, FolderJobStatusDto? job) =>
        CanMergeInto(Library, source, job is not null && FolderJobFormat.IsOpen(job));

    /// <summary>"Merged into Movies on 13 Oct 2026"; the target's name comes from the library, or a plain fallback when it was removed.</summary>
    private string MergedText(LibrarySourceDto source)
    {
        var target = Library.Sources.FirstOrDefault(candidate => candidate.Id == source.MergeTargetSourceId);
        return FolderJobFormat.MergedLine(target?.DisplayName() ?? "another folder", source.MergedAt);
    }

    // Read the marker through the same rule the Engine uses: only a managed folder can hold it.
    private bool IsNewMediaFolder(LibrarySourceDto source) => IsManaged(source)
        && ReferenceEquals(source, Library.GetPrimaryDestination());

    private string FilesLabel(LibrarySourceDto source) => FilesText(Library, source);

    private FolderJobStatusDto? JobFor(LibrarySourceDto source) =>
        Jobs is not null && Jobs.TryGetValue(source.Id, out var job) && (job.State is "queued" or "running" or "paused" || job.HasLog || !string.IsNullOrWhiteSpace(job.Message))
            ? job
            : null;

    private bool IsOrganising(LibrarySourceDto source) =>
        IsConverting(source) || IsMerging(source) || (JobFor(source) is { State: "queued" or "running" or "paused" });

    // The folder's icon is its state: full access (Library manages it), read-only (Library never changes its files) or busy. The label
    // and tooltip say it in words too, so the state is never colour alone.
    private string HandlingTitle(LibrarySourceDto source) => IsOrganising(source)
        ? IsMerging(source) || (JobFor(source) is { } job && FolderJobFormat.IsMerge(job) && FolderJobFormat.IsOpen(job)) ? "Merging" : "Converting"
        : IsManaged(source) ? "Managed: Library has full access" : "Read-only: Library never changes these files";

    private string HandlingIconClass(LibrarySourceDto source) =>
        $"folder-table__icon {(IsOrganising(source) ? "is-converting" : IsManaged(source) ? "is-managed" : "is-readonly")}";

    // What the one live region says: which folders are organising or merging, and how finished jobs ended. It carries no
    // progress numbers, so it changes (and is read out) only when a job starts, pauses, ends or a folder is merged.
    private string LiveStatusText => string.Join(". ", Library.Sources.Select(LiveStatusFor).Where(text => text.Length > 0));

    private string LiveStatusFor(LibrarySourceDto source)
    {
        var name = source.DisplayName();
        if (JobFor(source) is { } job)
        {
            if (FolderJobFormat.IsOpen(job))
            {
                var verb = FolderJobFormat.IsMerge(job) ? "Merging" : "Organising";
                return job.State == "paused" ? $"{verb} {name} is paused" : $"{verb} {name}";
            }

            return string.IsNullOrWhiteSpace(job.Message) ? string.Empty : $"{name}: {job.Message}";
        }

        if (IsConverting(source))
        {
            return $"Organising {name}";
        }

        if (IsMerging(source))
        {
            return $"Merging {name}";
        }

        return IsMerged(source) ? $"{name}: {MergedText(source)}" : string.Empty;
    }

    private string RowClass(LibrarySourceDto source) =>
        $"folder-table__row{(IsExpanded(source) ? " is-expanded" : string.Empty)}{(IsNewMediaFolder(source) ? " is-marked" : string.Empty)}";

    private string? IssueFor(LibrarySourceDto source) =>
        PathIssues is not null && PathIssues.TryGetValue(source.Path, out var issue) ? issue : null;

    private bool IsExpanded(LibrarySourceDto source) => _expanded.Contains(source.Id);

    private void Toggle(LibrarySourceDto source)
    {
        if (!_expanded.Remove(source.Id)) _expanded.Add(source.Id);
    }
}
