@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient
@inject IStringLocalizer<SharedStrings> L

@* Step 4 for My own address (mock-ups, picture 6). The own-domain wizard is a later packet; until then this keeps what the old page
   offered: the public https address with Save and verify, and the remote test. In the guided flow it also lists the three ways in
   as plain words, the router door last with a warning when the provider shares one public address between homes. Reached from the
   start page's "I already have a proxy or tunnel" it shows only the address. *@
<div class="ra-own" data-remote-screen="@(ShowRoutes ? "connect-own-address" : "own-address")">
    @if (ShowRoutes)
    {
        <RemoteAccessCard Key="routes" Title="@L["RemoteAccessOwnAddressStep_HowReach"].Value">
            <RemoteAccessRow Key="route-tunnel" Title="@L["RemoteAccessOwnAddressStep_Tunnel"].Value" Detail="@L["RemoteAccessOwnAddressStep_TunnelText"].Value" />
            <RemoteAccessRow Key="route-proxy" Title="@L["RemoteAccessOwnAddressStep_Proxy"].Value" Detail="@L["RemoteAccessOwnAddressStep_ProxyText"].Value" />
            <RemoteAccessRow Key="route-router" Title="@L["RemoteAccessOwnAddressStep_RouterDoor"].Value"
                             Tone="@(SharedAddress ? AppStatusDotTone.Attention : null)" StatusText="@(SharedAddress ? L["RemoteAccessOwnAddressStep_MayNotWork"].Value : null)"
                             Detail="@(SharedAddress ? L["RemoteAccessOwnAddressStep_RouterDoorShared"].Value : L["RemoteAccessOwnAddressStep_RouterDoorText"].Value)" />
        </RemoteAccessCard>
    }

    <RemoteAccessCard Key="address" Title="@L["RemoteAccessOwnAddressStep_PublicAddress"].Value" Intro="@L["RemoteAccessOwnAddressStep_PublicAddressText"].Value">
        <AppTextField T="string" @bind-Value="Settings.Remote.PublicHostname"
                      Label="@L["RemoteAccessOwnAddressStep_PublicHttpsAddress"].Value" Placeholder="https://tuvima.example.com"
                      HelpText="@L["RemoteAccessOwnAddressStep_AddressHelp"].Value" />
        <div class="ra-own__actions">
            <AppButton Label="@L["RemoteAccessOwnAddressStep_SaveAndVerify"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="SaveAddressAsync" data-remote-action="save-address" />
            <AppButton Label="@L["RemoteAccessOwnAddressStep_TestRemoteAccess"].Value" StartIcon="@AppMaterialIcons.Outlined.Science" OnClick="TestRemoteAsync" data-remote-action="test-remote" />
        </div>
    </RemoteAccessCard>

    <div class="ra-own__actions">
        @if (ShowRoutes)
        {
            <AppButton Label="@L["Common_Continue"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="ContinueRequested" data-remote-action="continue" />
        }
        <AppButton Label="@L["Common_Back"].Value" OnClick="BackRequested" data-remote-action="back" />
    </div>
</div>

<NetworkTestDialog @bind-Visible="_testDialogOpen" Busy="@_testing" Result="@_testResult" />

@code {
    [Parameter, EditorRequired] public NetworkSettingsDto Settings { get; set; } = new();

    /// <summary>True inside the five steps (the ways in are listed and Continue goes on to Test); false from the start page's own-address link.</summary>
    [Parameter] public bool ShowRoutes { get; set; }

    [Parameter] public RemoteCheckResultDto? Result { get; set; }
    [Parameter] public EventCallback SaveRequested { get; set; }
    [Parameter] public EventCallback StatusRefreshRequested { get; set; }
    [Parameter] public EventCallback ContinueRequested { get; set; }
    [Parameter] public EventCallback BackRequested { get; set; }

    private bool _testDialogOpen;
    private bool _testing;
    private NetworkTestResultDto? _testResult;

    private bool SharedAddress => Result?.Findings.Any(finding => finding.Key == RemoteCheckFindingKeys.SharedAddress) == true;

    // Saving an address means the own-address way in is on: a proxy or tunnel ("custom"), or the router door ("direct-only") when that is what Advanced set.
    private async Task SaveAddressAsync()
    {
        var mode = Settings.Remote.ConnectionMode?.Trim().ToLowerInvariant();
        if (mode is not ("custom" or "direct-only"))
        {
            Settings.Remote.ConnectionMode = "custom";
            Settings.Remote.AutomaticRouterConfiguration = false;
        }

        await SaveRequested.InvokeAsync();
        await StatusRefreshRequested.InvokeAsync();
    }

    private async Task TestRemoteAsync()
    {
        _testDialogOpen = true;
        _testing = true;
        _testResult = await ApiClient.TestRemoteNetworkAsync();
        _testing = false;
        await StatusRefreshRequested.InvokeAsync();
    }
}
