@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@inject IStringLocalizer<SharedStrings> L

@* Step 3, Passwords, before anyone connects from outside (mock-ups, picture 4). The standing rule is said once. Then the people the
   check found without a password are listed as "home only" with a Set a password link, and the person setting this up cannot
   continue until the server administrator has a password, since they could otherwise be locked out away from home. Everyone else
   is never forced: a profile left alone simply stays home only. *@
<div class="ra-passwords" data-remote-screen="passwords">
    <RemoteAccessCard Key="rule" Tone="AppUiTone.Warning">
        <span>@L["RemoteAccessPasswordsStep_Rule"]</span>
    </RemoteAccessCard>

    <RemoteAccessCard Key="people">
        @if (AdministratorFinding is not null)
        {
            <RemoteAccessRow Key="@AdministratorFinding.Key" Tone="AppStatusDotTone.Broken" StatusText="@L["RemoteAccessPasswordsStep_NoPassword"].Value"
                             Title="@AdministratorFinding.Title" Detail="@AdministratorFinding.Detail">
                <Actions>
                    <AppButton Label="@L["RemoteAccessPasswordsStep_SetPassword"].Value" Href="@UsersRoute" data-remote-action="set-password" />
                </Actions>
            </RemoteAccessRow>
        }
        @if (PeopleFinding is not null)
        {
            <RemoteAccessRow Key="@PeopleFinding.Key" Tone="AppStatusDotTone.Attention" StatusText="@L["RemoteAccessPasswordsStep_HomeOnly"].Value"
                             Title="@PeopleFinding.Title" Detail="@PeopleFinding.Detail" Tag="@L["RemoteAccessPasswordsStep_HomeOnly"].Value">
                <Actions>
                    <AppButton Label="@L["RemoteAccessPasswordsStep_SetPassword"].Value" Href="@UsersRoute" data-remote-action="set-password" />
                </Actions>
            </RemoteAccessRow>
        }
        @if (AdministratorFinding is null && PeopleFinding is null)
        {
            <RemoteAccessRow Key="everyone" Tone="AppStatusDotTone.Working" StatusText="@L["RemoteAccessPasswordsStep_Ready"].Value"
                             Title="@L["RemoteAccessPasswordsStep_EveryoneReady"].Value" Detail="@L["RemoteAccessPasswordsStep_EveryoneReadyDetail"].Value" />
        }
    </RemoteAccessCard>

    @if (Blocked)
    {
        <p class="ra-passwords__blocked" role="status" data-remote-blocked>@L["RemoteAccessPasswordsStep_Blocked"]</p>
    }

    <div class="ra-passwords__actions">
        <AppButton Label="@L["Common_Continue"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@Blocked"
                   OnClick="ContinueRequested" data-remote-action="continue" />
        @if (Blocked)
        {
            <AppButton Label="@L["RemoteAccessCheckStep_CheckAgain"].Value" OnClick="CheckAgainRequested" data-remote-action="check-again" />
        }
        <AppButton Label="@L["Common_Back"].Value" OnClick="BackRequested" data-remote-action="back" />
    </div>
</div>

@code {
    [Parameter] public RemoteCheckResultDto? Result { get; set; }
    [Parameter] public EventCallback ContinueRequested { get; set; }
    [Parameter] public EventCallback CheckAgainRequested { get; set; }
    [Parameter] public EventCallback BackRequested { get; set; }

    private RemoteCheckFindingDto? AdministratorFinding =>
        Result?.Findings.FirstOrDefault(finding => finding.Key == RemoteCheckFindingKeys.AdminWithoutPassword);

    private RemoteCheckFindingDto? PeopleFinding =>
        Result?.Findings.FirstOrDefault(finding => finding.Key == RemoteCheckFindingKeys.ProfilesWithoutPassword);

    /// <summary>Continue stays off until the server administrator has a password or passkey.</summary>
    private bool Blocked => AdministratorFinding is not null;

    private static string UsersRoute => SettingsNav.RouteFor(SettingsSection.Access);
}
