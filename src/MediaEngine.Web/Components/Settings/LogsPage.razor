@namespace MediaEngine.Web.Components.Settings
@inject IStringLocalizer<SharedStrings> L

@* System > Logs: the Events log (what was added, what needs review, what failed and what the system did) and the Engine's
   technical log. A page has one row of tabs, so the two views sit under a segmented control inside the Logs tab. Retention and
   export live on the System > Advanced tab. *@
<div class="tl-page logs-page">
    <div class="logs-page__views">
        <AppSegmentedControl Options="@Views"
                             Value="@_view"
                             ValueChanged="@(value => _view = value)"
                             AriaLabel="@L["LogsPage_LogsViews"].Value" />
    </div>

    @switch (_view)
    {
        case TechnicalView:
            <TechnicalLogPanel />
            break;
        default:
            <ActivityLogPanel Filter="@Filter" />
            break;
    }
</div>

@code {
    private const string EventsView = "events";
    private const string TechnicalView = "technical";

    private static readonly IReadOnlyList<AppSelectOption> Views =
    [
        new(EventsView, "Events"),
        new(TechnicalView, "Technical log"),
    ];

    /// <summary>Which view opens first: <c>events</c> (the default), or <c>technical</c>.</summary>
    [Parameter] public string? Tab { get; set; }

    /// <summary>Which filter the Events view opens on: <c>added</c>, <c>review</c>, <c>failed</c>, <c>system</c> or <c>all</c> (the default).</summary>
    [Parameter] public string? Filter { get; set; }

    private string _view = EventsView;
    private string? _openedWith;

    protected override void OnParametersSet()
    {
        // Only a changed address moves the view; a parent re-render must not undo the one the person picked.
        if (_openedWith == Tab)
        {
            return;
        }

        _openedWith = Tab;
        _view = Tab?.ToLowerInvariant() switch
        {
            TechnicalView => TechnicalView,
            _ => EventsView,
        };
    }
}
