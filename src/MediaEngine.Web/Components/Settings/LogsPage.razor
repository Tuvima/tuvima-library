@namespace MediaEngine.Web.Components.Settings

@* System > Logs (settings revamp D38, ingestion WP12): the Events log (what was added, what needs review, what failed and what
   the system did), the Engine's technical log, how long logs are kept, and the export, as in-page sections. *@
<div class="tl-page logs-page">
    <AppTabs @bind-ActivePanelIndex="_tab" Label="Logs sections">
        <AppTabPanel Text="Events">
            <ActivityLogPanel Filter="@Filter" />
        </AppTabPanel>
        <AppTabPanel Text="Technical log">
            <TechnicalLogPanel />
        </AppTabPanel>
        <AppTabPanel Text="Retention">
            <LogRetentionPanel />
        </AppTabPanel>
        <AppTabPanel Text="Export">
            <LogExportPanel />
        </AppTabPanel>
    </AppTabs>
</div>

@code {
    /// <summary>Which section opens first: <c>events</c> (the default), <c>technical</c>, <c>retention</c> or <c>export</c>.</summary>
    [Parameter] public string? Tab { get; set; }

    /// <summary>Which filter the Events section opens on: <c>added</c>, <c>review</c>, <c>failed</c>, <c>system</c> or <c>all</c> (the default).</summary>
    [Parameter] public string? Filter { get; set; }

    private int _tab;
    private string? _openedWith;

    protected override void OnParametersSet()
    {
        // Only a changed address moves the tab; a parent re-render must not undo the one the person picked.
        if (_openedWith == Tab)
        {
            return;
        }

        _openedWith = Tab;
        _tab = Tab?.ToLowerInvariant() switch
        {
            "technical" => 1,
            "retention" => 2,
            "export" => 3,
            _ => 0,
        };
    }
}
