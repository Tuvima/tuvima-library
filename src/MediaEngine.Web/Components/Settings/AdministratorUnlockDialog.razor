@namespace MediaEngine.Web.Components.Settings

<AppDialog>
    <DialogContent>
        <AdministratorSurfaceGate Required="true">
            <p>Your administrator settings are unlocked. Continue to open the editor.</p>
            <AppButton Label="Continue to editor" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="Continue" />
        </AdministratorSurfaceGate>
    </DialogContent>
    <DialogActions>
        <AppButton Label="Cancel" OnClick="Cancel" />
    </DialogActions>
</AppDialog>

@code {
    [CascadingParameter] private IAppDialogContext DialogContext { get; set; } = null!;
    private void Continue() => DialogContext.Close(AppDialogResult.Ok(true));
    private void Cancel() => DialogContext.Cancel();
}
