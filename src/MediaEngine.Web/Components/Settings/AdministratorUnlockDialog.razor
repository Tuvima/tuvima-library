@namespace MediaEngine.Web.Components.Settings
@inject IStringLocalizer<SharedStrings> L

<AppDialog>
    <DialogContent>
        <AdministratorSurfaceGate Required="true">
            <p>@L["AdministratorUnlockDialog_YourAdministratorSettingsAreUnlocked"]</p>
            <AppButton Label="@L["AdministratorUnlockDialog_ContinueToEditor"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="Continue" />
        </AdministratorSurfaceGate>
    </DialogContent>
    <DialogActions>
        <AppButton Label="@L["Search_Cancel"].Value" ButtonStyle="AppButtonStyle.Outlined" OnClick="Cancel" />
    </DialogActions>
</AppDialog>

@code {
    [CascadingParameter] private IAppDialogContext DialogContext { get; set; } = null!;
    private void Continue() => DialogContext.Close(AppDialogResult.Ok(true));
    private void Cancel() => DialogContext.Cancel();
}
