@namespace MediaEngine.Web.Components.Settings
@implements IAsyncDisposable
@inject UIOrchestratorService Orchestrator
@inject ILogger<SecurityTab> Logger
@inject RegisteredExternalProvidersSnapshot RegisteredProviders
@inject IStringLocalizer<SharedStrings> L

<div class="tl-page security-settings">
    @* No panel title and no "How people sign in" heading: the page and its Advanced tab already say where this is (settings alignment D15). *@
    <AppSettingsGroup>
        @if (_authLoading)
        {
            <AppSkeleton Size="AppControlSize.Large" Class="security-settings__skeleton" />
        }
        else if (_authSettings is null)
        {
            <AppErrorState Title="@L["SecurityTab_AuthenticationConfigurationIsUnavailable"].Value"
                           Message="The server did not return the current sign-in configuration." />
        }
        else
        {
            @if (_failure is not null)
            {
                <AppAlert Tone="AppUiTone.Error" ShowCloseIcon="true" CloseIconClicked="@(() => { _failure = null; })" data-security-failure>@_failure</AppAlert>
            }
            @* Plain switches that save the moment they change (settings alignment D2, D15). Everyone always signs in, so there is no switch for it. *@
            <div class="security-settings__controls" role="group" aria-label="@L["SecurityTab_HowPeopleSignIn"]" data-testid="sign-in-switches">
                <AppSwitchRow Label="@L["SecurityTab_AllowPasswords"].Value"
                              Description="@L["SecurityTab_AllowAccountPasswordsAndPassword"].Value"
                              Value="@_passwordSignInEnabled"
                              Disabled="@_saving"
                              ValueChanged="value => SaveSwitchAsync(() => _passwordSignInEnabled = value)" />
                <AppSwitchRow Label="@L["SecurityTab_PasskeySignIn"].Value"
                              Description="@L["SecurityTab_AllowPasskeysAndPlatformCredentials"].Value"
                              Value="@_passkeySignInEnabled"
                              Disabled="@_saving"
                              ValueChanged="value => SaveSwitchAsync(() => _passkeySignInEnabled = value)" />
                <AppSwitchRow Label="@L["SecurityTab_ExternalProviderSignIn"].Value"
                              Description="@L["SecurityTab_ExternalSignInHelp"].Value"
                              Value="@_externalSignInEnabled"
                              Disabled="@_saving"
                              ValueChanged="value => SaveSwitchAsync(() => ChangeExternalSignIn(value))" />
                <AppSavedNote @ref="_switchSavedNote" data-testid="sign-in-saved" />
            </div>

            <h4 class="tl-sp-mt-5">@L["SecurityTab_ExternalProviders"]</h4>
            @if (ProvidersNeedRestart)
            {
                <AppAlert Tone="AppUiTone.Warning" Class="tl-sp-mb-3" aria-live="polite">
                    @L["SecurityTab_RestartLibraryToApplySign"]
                </AppAlert>
            }
            @foreach (var provider in _providerEditors)
            {
                <div class="security-settings__provider @_glow.Class(provider.Id)">
                    <div class="security-settings__provider-heading">
                        <strong>@ValueOrNotConfigured(provider.DisplayName)</strong>
                        <span>@ProviderState(provider)</span>
                    </div>
                    <div class="security-settings__controls">
                        <AppTextField T="string" @bind-Value="provider.Id"
                                      Label="@L["SecurityTab_ProviderId"].Value" ReadOnly="@provider.Persisted"
                                      HelpText="Stable id such as google, microsoft, github, facebook, or your OIDC provider name." />
                        <label class="app-field__label">@L["SecurityTab_Protocol"]</label>
                        <AppSelect Native="true" Value="@provider.Kind" ValueChanged="selected => ChangeProviderKind(provider, selected)">
                            <option value="oidc">@L["SecurityTab_OpenIDConnect"]</option>
                            <option value="oauth">@L["SecurityTab_OAuth20"]</option>
                        </AppSelect>
                        <AppSwitchRow Label="@L["Schedule_Enabled"].Value" Value="@provider.Enabled"
                                      ValueChanged="value => provider.Enabled = value" />
                        <AppTextField T="string" @bind-Value="provider.DisplayName" Label="@L["SecurityTab_DisplayName"].Value" />
                        <AppTextField T="string" @bind-Value="provider.ClientId" Label="@L["SecurityTab_ClientID"].Value" />
                        <AppTextField T="string" @bind-Value="provider.ClientSecret" InputType="AppInputType.Password"
                                      Label="@L["SecurityTab_ClientSecret"].Value"
                                      HelpText="Leave blank to preserve the stored secret. Secret values are write-only." />
                        <AppSwitchRow Label="@L["SecurityTab_ClearStoredClientSecret"].Value" Value="@provider.ClearClientSecret"
                                      ValueChanged="value => provider.ClearClientSecret = value" />
                        <AppSwitchRow Label="@L["SecurityTab_UsePKCE"].Value" Value="@provider.UsePkce"
                                      Description="@L["SecurityTab_ProtectAuthorizationCodeCallbacksWith"].Value"
                                      ValueChanged="value => provider.UsePkce = value" />
                        @if (provider.Kind == "oidc")
                        {
                            <AppTextField T="string" @bind-Value="provider.Authority" Label="@L["SecurityTab_OIDCAuthority"].Value" />
                        }
                        else
                        {
                            <AppTextField T="string" @bind-Value="provider.Issuer" Label="@L["SecurityTab_Issuer"].Value" />
                            <AppTextField T="string" @bind-Value="provider.AuthorizationEndpoint" Label="@L["SecurityTab_AuthorizationEndpoint"].Value" />
                            <AppTextField T="string" @bind-Value="provider.TokenEndpoint" Label="@L["SecurityTab_TokenEndpoint"].Value" />
                            <AppTextField T="string" @bind-Value="provider.UserInformationEndpoint" Label="@L["SecurityTab_UserInformationEndpoint"].Value" />
                        }
                        <AppTextField T="string" @bind-Value="provider.Scopes" Label="@L["SecurityTab_Scopes"].Value"
                                      HelpText="Space-separated scopes. OIDC requires openid." />
                    </div>
                    <div class="security-settings__provider-actions">
                        <SettingsSaveBar Saving="@_saving" OnSave="() => SaveProviderAsync(provider)" />
                        @if (provider.Persisted)
                        {
                            <AppButton Label="@L["SecurityTab_DeleteProvider"].Value" Tone="AppUiTone.Error"
                                       Disabled="@_saving" OnClick="() => DeleteProviderAsync(provider)" />
                        }
                    </div>
                </div>
            }
            <AppButton Label="@L["Common_AddProvider"].Value" StartIcon="@AppMaterialIcons.Outlined.Add"
                       OnClick="AddProvider" Class="tl-sp-mt-4" />
            <AppAlert Tone="AppUiTone.Info" Class="tl-sp-mt-4">
                @L["SecurityTab_ProviderSecretsStayInThe"]
            </AppAlert>
            <h3 class="tl-sp-mt-5" id="security-group-sessions">@L["SecurityTab_SessionsAndInvitations"]</h3>
            <div class="security-settings__controls" role="group" aria-labelledby="security-group-sessions">
                <AppTextField T="string" @bind-Value="_sessionLifetimeHours"
                              Label="@L["SecurityTab_SessionLifetimeHours"].Value"
                              HelpText="1 to 8760 hours. New sessions use this lifetime." />
                <AppTextField T="string" @bind-Value="_maximumActiveSessions"
                              Label="@L["SecurityTab_MaximumActiveSessionsPerAccount"].Value"
                              HelpText="1 to 100. Creating another session revokes the oldest active session." />
                <AppTextField T="string" @bind-Value="_invitationLifetimeHours"
                              Label="@L["SecurityTab_InvitationLifetimeHours"].Value"
                              HelpText="1 to 720 hours. New invitations use this lifetime." />
                <AppTextField T="string" @bind-Value="_trustedLocalNetworks"
                              Label="@L["SecurityTab_TrustedLocalNetworks"].Value"
                              HelpText="@L["SecurityTab_TrustedLocalNetworksHelp"].Value" />
            </div>
            <AppAlert Tone="AppUiTone.Info" Class="tl-sp-mt-4">
                @L["SecurityTab_ActiveSessionsKeepTheirExisting"]
            </AppAlert>
            <AppAlert Tone="AppUiTone.Info" Class="tl-sp-mt-3">
                @L["SecurityTab_AdministratorSurfaceProtectionIsOptional"]
            </AppAlert>

            <h3 class="tl-sp-mt-5" id="security-group-status">@L["SecurityTab_Status"]</h3>
            <dl class="security-settings__facts" aria-labelledby="security-group-status">
                <div><dt>@L["SecurityTab_PublicAddress"]</dt><dd>@CanonicalOriginStatus <a href="/settings/network/remote">@L["SecurityTab_ChangeItInNetworkSettings"]</a></dd></div>
                <div><dt>@L["SecurityTab_Passkeys"]</dt><dd>@PasskeyStatus</dd></div>
                <div data-recovery-email-status><dt>@L["SecurityTab_PasswordRecoveryEmail"]</dt><dd>@RecoveryStatus <a href="@SettingsNav.RouteFor(SettingsSection.General, SettingsNav.NotificationsSubsection)">@L["SecurityTab_SetUpInNotificationsChannelsEmail"]</a></dd></div>
            </dl>
            <div class="security-settings__actions tl-sp-mt-5">
                <SettingsSaveBar @ref="_saveBar" Saving="@_saving" OnSave="SaveAsync" />
            </div>
        }
    </AppSettingsGroup>
</div>

@code {
    [Parameter] public string Section { get; set; } = "authentication";

    private bool _authLoading = true;
    private bool _saving;
    private string? _failure;
    private SettingsSaveBar? _saveBar;
    private AppSavedNote? _switchSavedNote;
    private readonly JustChanged _glow = new();
    // The glow clears itself a few seconds after it started; draw the row again without it.
    private void OnGlowCleared() => _ = InvokeAsync(StateHasChanged);
    private bool _disposed;
    private readonly CancellationTokenSource _lifetime = new();
    private AuthSettingsDto? _authSettings;
    private string _mode = "Local";
    private bool _passwordSignInEnabled;
    private bool _passkeySignInEnabled;
    private bool _externalSignInEnabled;
    private string _trustedLocalNetworks = string.Empty;
    private string _invitationLifetimeHours = "168";
    private string _sessionLifetimeHours = "336";
    private string _maximumActiveSessions = "20";
    private readonly List<ProviderEditor> _providerEditors = [];

    private bool ProvidersNeedRestart =>
        _authSettings is not null && RegisteredProviders.DiffersFrom(_authSettings.ExternalProviders, _authSettings.Mode);
    // Linked sign-in needs a mode other than Local; switching it on moves Local to Optional and switching it off moves Optional back.
    private void ChangeExternalSignIn(bool on)
    {
        _externalSignInEnabled = on;
        if (on && _mode == "Local") _mode = "Optional";
        else if (!on && _mode == "Optional") _mode = "Local";
    }
    private string CanonicalOriginStatus => _authSettings is null
        ? "Unavailable"
        : _authSettings.CanonicalOriginReady
            ? _authSettings.PublicAddress
            : string.IsNullOrWhiteSpace(_authSettings.PublicAddress)
                ? "Not set. Set the public address in Network settings for passkeys, linked sign-in and reset links."
                : "Use an https address with no path (http is allowed only for localhost).";
    private string PasskeyStatus => _authSettings is null
        ? "Unavailable"
        : _authSettings.PasskeyReady
            ? "Ready"
            : !_passkeySignInEnabled
                ? "Enable passkey sign-in."
                : CanonicalOriginStatus;
    private string RecoveryStatus => _authSettings is null
        ? "Unavailable"
        : !_authSettings.PasswordReset.Configured
            ? L["SecurityTab_EmailNotConfigured"].Value
            : _authSettings.RecoveryDeliveryReady
                ? L["SecurityTab_EmailConfigured"].Value
                : L["SecurityTab_EmailConfiguredNeedsAddress"].Value;

    protected override async Task OnInitializedAsync()
    {
        _glow.Changed += OnGlowCleared;
        Apply(await Orchestrator.GetAuthSettingsAsync(_lifetime.Token));
        _authLoading = false;
    }

    private void Apply(AuthSettingsDto? value)
    {
        _authSettings = value;
        if (value is null) return;
        _mode = value.Mode;
        _passwordSignInEnabled = value.PasswordSignInEnabled;
        _passkeySignInEnabled = value.PasskeySignInEnabled;
        _externalSignInEnabled = value.ExternalSignInEnabled;
        _trustedLocalNetworks = string.Join(", ", value.TrustedLocalNetworks);
        _invitationLifetimeHours = value.InvitationLifetimeHours.ToString();
        _sessionLifetimeHours = value.SessionLifetimeHours.ToString();
        _maximumActiveSessions = value.MaximumActiveSessions.ToString();
        _providerEditors.Clear();
        _providerEditors.AddRange(value.ExternalProviders.Select(ProviderEditor.From));
    }

    private void Fail(string message) => _failure = message;

    // A switch saves the moment it changes. Only the switches and the values last saved are sent, so a number or network
    // still being typed below is neither saved early nor lost. A refused save puts the switches back and says why.
    private async Task SaveSwitchAsync(Action change)
    {
        if (_saving || _disposed || _authSettings is null) return;
        var before = (_mode, _passwordSignInEnabled, _passkeySignInEnabled, _externalSignInEnabled);
        change();
        _failure = null;
        if (!_passwordSignInEnabled && !_passkeySignInEnabled && !_externalSignInEnabled)
        {
            (_mode, _passwordSignInEnabled, _passkeySignInEnabled, _externalSignInEnabled) = before;
            Fail(L["SecurityTab_KeepAtLeastOneAccount"].Value);
            return;
        }

        var typed = (_trustedLocalNetworks, _invitationLifetimeHours, _sessionLifetimeHours, _maximumActiveSessions);
        _saving = true;
        try
        {
            var saved = await Orchestrator.UpdateAuthSettingsAsync(new UpdateAuthSettingsRequest
            {
                Mode = _mode,
                PasswordSignInEnabled = _passwordSignInEnabled,
                PasskeySignInEnabled = _passkeySignInEnabled,
                ExternalSignInEnabled = _externalSignInEnabled,
                TrustedLocalNetworks = _authSettings.TrustedLocalNetworks.ToList(),
                InvitationLifetimeHours = _authSettings.InvitationLifetimeHours,
                SessionLifetimeHours = _authSettings.SessionLifetimeHours,
                MaximumActiveSessions = _authSettings.MaximumActiveSessions,
            }, _lifetime.Token);
            if (saved is null)
            {
                (_mode, _passwordSignInEnabled, _passkeySignInEnabled, _externalSignInEnabled) = before;
                Fail(L["SecurityTab_AuthenticationSettingsCouldNotBe"].Value);
                return;
            }
            Apply(saved);
            (_trustedLocalNetworks, _invitationLifetimeHours, _sessionLifetimeHours, _maximumActiveSessions) = typed;
            _switchSavedNote?.Show();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Authentication switch save failed");
            (_mode, _passwordSignInEnabled, _passkeySignInEnabled, _externalSignInEnabled) = before;
            Fail(L["SecurityTab_AuthenticationSettingsCouldNotBe"].Value);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_saving || _disposed) return;
        _failure = null;
        if (!int.TryParse(_invitationLifetimeHours, out var invitations) || invitations is < 1 or > 720 ||
            !int.TryParse(_sessionLifetimeHours, out var sessions) || sessions is < 1 or > 8760 ||
            !int.TryParse(_maximumActiveSessions, out var maximum) || maximum is < 1 or > 100)
        {
            Fail(L["SecurityTab_EnterValidInvitationAndSession"].Value);
            return;
        }
        if (!_passwordSignInEnabled && !_passkeySignInEnabled && !_externalSignInEnabled)
        {
            Fail(L["SecurityTab_KeepAtLeastOneAccount"].Value);
            return;
        }

        _saving = true;
        try
        {
            var saved = await Orchestrator.UpdateAuthSettingsAsync(new UpdateAuthSettingsRequest
            {
                Mode = _mode,
                PasswordSignInEnabled = _passwordSignInEnabled,
                PasskeySignInEnabled = _passkeySignInEnabled,
                ExternalSignInEnabled = _externalSignInEnabled,
                TrustedLocalNetworks = _trustedLocalNetworks.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(),
                InvitationLifetimeHours = invitations,
                SessionLifetimeHours = sessions,
                MaximumActiveSessions = maximum,
            }, _lifetime.Token);
            if (saved is null)
            {
                Fail(L["SecurityTab_AuthenticationSettingsCouldNotBe"].Value);
                return;
            }
            Apply(saved);
            _saveBar?.ShowSaved();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Authentication settings save failed");
            Fail(L["SecurityTab_AuthenticationSettingsCouldNotBe"].Value);
        }
        finally
        {
            _saving = false;
        }
    }

    private void AddProvider()
    {
        _providerEditors.Add(new ProviderEditor
        {
            Kind = "oidc",
            Scopes = "openid profile email",
        });
    }

    private static void ChangeProviderKind(ProviderEditor provider, string? selected)
    {
        provider.Kind = selected ?? "oidc";
        if (provider.Kind == "oidc" && !provider.Scopes.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Contains("openid", StringComparer.OrdinalIgnoreCase))
        {
            provider.Scopes = string.IsNullOrWhiteSpace(provider.Scopes)
                ? "openid profile email"
                : $"openid {provider.Scopes}";
        }
    }

    private async Task SaveProviderAsync(ProviderEditor provider)
    {
        if (_saving || _disposed) return;
        _failure = null;
        if (string.IsNullOrWhiteSpace(provider.Id))
        {
            Fail(L["SecurityTab_EnterAStableProviderId"].Value);
            return;
        }

        _saving = true;
        try
        {
            var saved = await Orchestrator.UpdateExternalAuthProviderAsync(provider.Id, new UpdateExternalAuthProviderRequest
            {
                Kind = provider.Kind,
                Enabled = provider.Enabled,
                DisplayName = provider.DisplayName,
                Issuer = provider.Issuer,
                Authority = provider.Authority,
                ClientId = provider.ClientId,
                ClientSecret = string.IsNullOrWhiteSpace(provider.ClientSecret) ? null : provider.ClientSecret,
                ClearClientSecret = provider.ClearClientSecret,
                Scopes = provider.Scopes.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(),
                UsePkce = provider.UsePkce,
                AuthorizationEndpoint = provider.AuthorizationEndpoint,
                TokenEndpoint = provider.TokenEndpoint,
                UserInformationEndpoint = provider.UserInformationEndpoint,
                IdClaim = provider.IdClaim,
                NameClaim = provider.NameClaim,
                EmailClaim = provider.EmailClaim,
            }, _lifetime.Token);
            if (saved is null)
            {
                Fail(L["Common_ProviderSettingsCouldNotBe"].Value);
                return;
            }
            if (!string.IsNullOrWhiteSpace(provider.ClientSecret) || provider.ClearClientSecret)
            {
                RegisteredProviders.MarkSecretChanged();
            }
            Apply(saved);
            _glow.Mark(provider.Id);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Authentication provider save failed");
            Fail(L["Common_ProviderSettingsCouldNotBe"].Value);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteProviderAsync(ProviderEditor provider)
    {
        if (_saving || _disposed) return;
        _failure = null;
        _saving = true;
        try
        {
            var deleted = await Orchestrator.DeleteExternalAuthProviderAsync(provider.Id, _lifetime.Token);
            var current = deleted ? await Orchestrator.GetAuthSettingsAsync(_lifetime.Token) : null;
            if (!deleted || current is null)
            {
                Fail(L["SecurityTab_ProviderCouldNotBeDeleted"].Value);
                return;
            }
            Apply(current);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Authentication provider delete failed");
            Fail(L["SecurityTab_ProviderCouldNotBeDeleted"].Value);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string ProviderState(ProviderEditor provider) => provider.Ready
        ? "Ready"
        : provider.Configured ? "Configured, not ready" : provider.Enabled ? "Enabled, not configured" : "Disabled";
    private static string ValueOrNotConfigured(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not configured" : value;

    public ValueTask DisposeAsync()
    {
        if (_disposed) return ValueTask.CompletedTask;
        _disposed = true;
        _glow.Changed -= OnGlowCleared;
        _glow.Dispose();
        _lifetime.Cancel();
        _lifetime.Dispose();
        return ValueTask.CompletedTask;
    }
    private sealed class ProviderEditor
    {
        public string Id { get; set; } = string.Empty;
        public bool Persisted { get; set; }
        public string Kind { get; set; } = "oidc";
        public bool Enabled { get; set; }
        public string DisplayName { get; set; } = string.Empty;
        public string Issuer { get; set; } = string.Empty;
        public string Authority { get; set; } = string.Empty;
        public string ClientId { get; set; } = string.Empty;
        public string ClientSecret { get; set; } = string.Empty;
        public bool ClearClientSecret { get; set; }
        public string Scopes { get; set; } = string.Empty;
        public bool UsePkce { get; set; } = true;
        public string AuthorizationEndpoint { get; set; } = string.Empty;
        public string TokenEndpoint { get; set; } = string.Empty;
        public string UserInformationEndpoint { get; set; } = string.Empty;
        public string IdClaim { get; set; } = "id";
        public string NameClaim { get; set; } = "name";
        public string EmailClaim { get; set; } = "email";
        public bool Configured { get; set; }
        public bool Ready { get; set; }

        public static ProviderEditor From(ExternalAuthProviderDto provider) => new()
        {
            Id = provider.Id,
            Persisted = true,
            Kind = provider.Kind,
            Enabled = provider.Enabled,
            DisplayName = provider.DisplayName,
            Issuer = provider.Issuer,
            Authority = provider.Authority,
            ClientId = provider.ClientId,
            Scopes = string.Join(' ', provider.Scopes),
            UsePkce = provider.UsePkce,
            AuthorizationEndpoint = provider.AuthorizationEndpoint,
            TokenEndpoint = provider.TokenEndpoint,
            UserInformationEndpoint = provider.UserInformationEndpoint,
            IdClaim = provider.IdClaim,
            NameClaim = provider.NameClaim,
            EmailClaim = provider.EmailClaim,
            Configured = provider.Configured,
            Ready = provider.Ready,
        };
    }
}
