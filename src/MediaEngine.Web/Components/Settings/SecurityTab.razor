@namespace MediaEngine.Web.Components.Settings
@implements IAsyncDisposable
@inject UIOrchestratorService Orchestrator
@inject DashboardIdentityClient IdentityClient
@inject PasswordResetEmailSender PasswordResetEmails
@inject IAppToastService Snackbar
@inject ILogger<SecurityTab> Logger
@inject RegisteredExternalProvidersSnapshot RegisteredProviders

<div class="tl-page security-settings">
    <SettingsSectionPanel Title="@PanelTitle" Description="@PanelDescription" Icon="@PanelIcon">
        @if (_authLoading)
        {
            <AppSkeleton Size="AppControlSize.Large" Class="security-settings__skeleton" />
        }
        else if (_authSettings is null)
        {
            <AppErrorState Title="Authentication configuration is unavailable"
                           Message="The Engine did not return the current sign-in configuration." />
        }
        else
        {
            <div class="security-settings__controls">
                <label class="app-field__label">Authentication mode</label>
                <AppNativeSelect Value="@_mode" OnChange="ChangeMode">
                    <option value="Local">Local account sign-in</option>
                    <option value="DisabledLocalOnly">Local-only entry</option>
                    <option value="Optional">Optional sign-in</option>
                    <option value="Required">Sign-in required</option>
                </AppNativeSelect>
                <AppSwitchRow Label="Password sign-in"
                              Description="Allow account passwords and password recovery."
                              Value="@_passwordSignInEnabled"
                              ValueChanged="value => _passwordSignInEnabled = value" />
                <AppSwitchRow Label="Passkey sign-in"
                              Description="Allow passkeys and platform credentials when the canonical origin is ready."
                              Value="@_passkeySignInEnabled"
                              ValueChanged="value => _passkeySignInEnabled = value" />
                <AppSwitchRow Label="External provider sign-in"
                              Description="@ExternalSignInDescription"
                              Value="@(_externalSignInEnabled && ExternalCapableMode)"
                              ValueChanged="value => _externalSignInEnabled = value"
                              Disabled="@(!ExternalCapableMode)" />
                <AppSwitchRow Label="Local-only accounts"
                              Description="Allow local-only profile entry from this computer. Remote clients remain ineligible."
                              Value="@_allowLocalOnlyAccounts"
                              ValueChanged="value => _allowLocalOnlyAccounts = value" />
                <AppTextField T="string" @bind-Value="_trustedLocalNetworks"
                              Label="Trusted local networks"
                              HelpText="Optional comma-separated CIDR ranges. With none configured, only this computer is local." />
                <AppTextField T="string" @bind-Value="_invitationLifetimeHours"
                              Label="Invitation lifetime (hours)"
                              HelpText="1 to 720 hours. New invitations use this lifetime." />
            </div>

            <h3 class="mt-5">Who can connect and sessions</h3>
            <AppAlert Tone="AppUiTone.Info" Class="mb-3">
                Who can connect is set under Settings &gt; Network.
            </AppAlert>
            <div class="security-settings__controls">
                <AppTextField T="string" @bind-Value="_sessionLifetimeHours"
                              Label="Session lifetime (hours)"
                              HelpText="1 to 8760 hours. New sessions use this lifetime." />
                <AppTextField T="string" @bind-Value="_maximumActiveSessions"
                              Label="Maximum active sessions per account"
                              HelpText="1 to 100. Creating another session revokes the oldest active session." />
            </div>
            <AppAlert Tone="AppUiTone.Info" Class="mt-4">
                Active sessions keep their existing expiry. New sessions use the saved policy.
            </AppAlert>
            <AppAlert Tone="AppUiTone.Info" Class="mt-3">
                Administrator surface protection is optional and configured per account profile grant in Users. It adds a lock around protected settings after sign-in.
            </AppAlert>

            <dl class="security-settings__facts mt-5">
                <div><dt>Canonical origin</dt><dd>@CanonicalOriginStatus</dd></div>
                <div><dt>Passkeys</dt><dd>@PasskeyStatus</dd></div>
                <div><dt>Recovery delivery</dt><dd>@RecoveryStatus</dd></div>
            </dl>
            @if (_authSettings.PasswordReset.Configured)
            {
                <dl class="security-settings__facts mt-5">
                    <div><dt>Public URL</dt><dd>@_authSettings.PasswordReset.PublicBaseUrl</dd></div>
                    <div><dt>SMTP server</dt><dd>@_authSettings.PasswordReset.SmtpHost:@_authSettings.PasswordReset.SmtpPort</dd></div>
                    <div><dt>From</dt><dd>@_authSettings.PasswordReset.FromAddress</dd></div>
                    <div><dt>SMTP state</dt><dd>@(_authSettings.PasswordReset.Ready ? "Ready" : "Configured, not ready")</dd></div>
                </dl>
                <AppButton Label="Send test email to my account"
                           StartIcon="@AppMaterialIcons.Outlined.MarkEmailRead"
                           Disabled="@(_saving || !_authSettings.PasswordReset.Ready)"
                           OnClick="SendTestEmailAsync" Class="mt-3" />
                <div class="app-field__help mt-2">Sends only to the email address on your current signed-in account.</div>
            }
            <h3 class="mt-5">External providers</h3>
            @if (ProvidersNeedRestart)
            {
                <AppAlert Tone="AppUiTone.Warning" Class="mb-3" aria-live="polite">
                    Restart Tuvima Library to apply sign-in provider changes.
                </AppAlert>
            }
            @foreach (var provider in _providerEditors)
            {
                <div class="security-settings__provider">
                    <div class="security-settings__provider-heading">
                        <strong>@ValueOrNotConfigured(provider.DisplayName)</strong>
                        <span>@ProviderState(provider)</span>
                    </div>
                    <div class="security-settings__controls">
                        <AppTextField T="string" @bind-Value="provider.Id"
                                      Label="Provider id" ReadOnly="@provider.Persisted"
                                      HelpText="Stable id such as google, microsoft, github, facebook, or your OIDC provider name." />
                        <label class="app-field__label">Protocol</label>
                        <AppNativeSelect Value="@provider.Kind" OnChange="args => ChangeProviderKind(provider, args)">
                            <option value="oidc">OpenID Connect</option>
                            <option value="oauth">OAuth 2.0</option>
                        </AppNativeSelect>
                        <AppSwitchRow Label="Enabled" Value="@provider.Enabled"
                                      ValueChanged="value => provider.Enabled = value" />
                        <AppTextField T="string" @bind-Value="provider.DisplayName" Label="Display name" />
                        <AppTextField T="string" @bind-Value="provider.ClientId" Label="Client ID" />
                        <AppTextField T="string" @bind-Value="provider.ClientSecret" InputType="AppInputType.Password"
                                      Label="Client secret"
                                      HelpText="Leave blank to preserve the stored secret. Secret values are write-only." />
                        <AppSwitchRow Label="Clear stored client secret" Value="@provider.ClearClientSecret"
                                      ValueChanged="value => provider.ClearClientSecret = value" />
                        <AppSwitchRow Label="Use PKCE" Value="@provider.UsePkce"
                                      Description="Protect authorization-code callbacks with a per-request verifier."
                                      ValueChanged="value => provider.UsePkce = value" />
                        @if (provider.Kind == "oidc")
                        {
                            <AppTextField T="string" @bind-Value="provider.Authority" Label="OIDC authority" />
                        }
                        else
                        {
                            <AppTextField T="string" @bind-Value="provider.Issuer" Label="Issuer" />
                            <AppTextField T="string" @bind-Value="provider.AuthorizationEndpoint" Label="Authorization endpoint" />
                            <AppTextField T="string" @bind-Value="provider.TokenEndpoint" Label="Token endpoint" />
                            <AppTextField T="string" @bind-Value="provider.UserInformationEndpoint" Label="User information endpoint" />
                        }
                        <AppTextField T="string" @bind-Value="provider.Scopes" Label="Scopes"
                                      HelpText="Space-separated scopes. OIDC requires openid." />
                    </div>
                    <div class="security-settings__provider-actions">
                        <AppButton Label="Save provider" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled"
                                   Disabled="@_saving" OnClick="() => SaveProviderAsync(provider)" />
                        @if (provider.Persisted)
                        {
                            <AppButton Label="Delete provider" Tone="AppUiTone.Error"
                                       Disabled="@_saving" OnClick="() => DeleteProviderAsync(provider)" />
                        }
                    </div>
                </div>
            }
            <AppButton Label="Add provider" StartIcon="@AppMaterialIcons.Outlined.Add"
                       OnClick="AddProvider" Class="mt-4" />
            <AppAlert Tone="AppUiTone.Info" Class="mt-4">
                Provider secrets stay in the server's private authentication secret file and are never returned here.
            </AppAlert>
            <div class="security-settings__actions mt-5">
                <AppButton Label="@(_saving ? "Saving…" : "Save authentication settings")"
                           Disabled="@_saving" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Loading="@_saving" OnClick="SaveAsync" />
            </div>
        }
    </SettingsSectionPanel>
</div>

@code {
    [Parameter] public string Section { get; set; } = "authentication";

    private bool _authLoading = true;
    private bool _saving;
    private bool _disposed;
    private readonly CancellationTokenSource _lifetime = new();
    private AuthSettingsDto? _authSettings;
    private string _mode = "Local";
    private bool _localhostBypass;
    private bool _passwordSignInEnabled;
    private bool _passkeySignInEnabled;
    private bool _externalSignInEnabled;
    private bool _allowLocalOnlyAccounts;
    private string _trustedLocalNetworks = string.Empty;
    private string _invitationLifetimeHours = "168";
    private string _sessionLifetimeHours = "336";
    private string _maximumActiveSessions = "20";
    private readonly List<ProviderEditor> _providerEditors = [];

    private bool ProvidersNeedRestart =>
        _authSettings is not null && RegisteredProviders.DiffersFrom(_authSettings.ExternalProviders, _authSettings.Mode);
    private string PanelTitle => "Authentication";
    private string PanelDescription => "Control how people sign in, remote access, sessions, and provider readiness.";
    private string PanelIcon => AppMaterialIcons.Outlined.AdminPanelSettings;
    private bool ExternalCapableMode => _mode is "Optional" or "Required";
    private string ExternalSignInDescription => ExternalCapableMode
        ? "Allow enabled OIDC and OAuth providers registered at startup."
        : "Choose Optional or Required mode to enable external provider sign-in.";
    private string CanonicalOriginStatus => _authSettings is null
        ? "Unavailable"
        : _authSettings.CanonicalOriginReady
            ? _authSettings.PasswordReset.PublicBaseUrl
            : string.IsNullOrWhiteSpace(_authSettings.PasswordReset.PublicBaseUrl)
                ? "Set the Dashboard public URL for sign-in callbacks."
                : "Use an absolute HTTPS URL, or a loopback URL for local use.";
    private string PasskeyStatus => _authSettings is null
        ? "Unavailable"
        : _authSettings.PasskeyReady
            ? "Ready"
            : !_passkeySignInEnabled
                ? "Enable passkey sign-in."
                : _mode == "DisabledLocalOnly"
                    ? "Choose Local, Optional, or Required authentication mode."
                    : CanonicalOriginStatus;
    private string RecoveryStatus => _authSettings is null
        ? "Unavailable"
        : _authSettings.RecoveryDeliveryReady
            ? "Ready"
            : !_authSettings.PasswordReset.Configured
                ? "Configure SMTP host, port, and sender address."
                : CanonicalOriginStatus;

    protected override async Task OnInitializedAsync()
    {
        Apply(await Orchestrator.GetAuthSettingsAsync(_lifetime.Token));
        _authLoading = false;
    }

    private void Apply(AuthSettingsDto? value)
    {
        _authSettings = value;
        if (value is null) return;
        _mode = value.Mode;
        _localhostBypass = value.LocalhostBypass;
        _passwordSignInEnabled = value.PasswordSignInEnabled;
        _passkeySignInEnabled = value.PasskeySignInEnabled;
        _externalSignInEnabled = value.ExternalSignInEnabled;
        _allowLocalOnlyAccounts = value.AllowLocalOnlyAccounts;
        _trustedLocalNetworks = string.Join(", ", value.TrustedLocalNetworks);
        _invitationLifetimeHours = value.InvitationLifetimeHours.ToString();
        _sessionLifetimeHours = value.SessionLifetimeHours.ToString();
        _maximumActiveSessions = value.MaximumActiveSessions.ToString();
        _providerEditors.Clear();
        _providerEditors.AddRange(value.ExternalProviders.Select(ProviderEditor.From));
    }

    private void ChangeMode(ChangeEventArgs args)
    {
        _mode = args.Value?.ToString() ?? "Local";
        if (!ExternalCapableMode) _externalSignInEnabled = false;
    }

    private async Task SaveAsync()
    {
        if (_saving || _disposed) return;
        if (!int.TryParse(_invitationLifetimeHours, out var invitations) || invitations is < 1 or > 720 ||
            !int.TryParse(_sessionLifetimeHours, out var sessions) || sessions is < 1 or > 8760 ||
            !int.TryParse(_maximumActiveSessions, out var maximum) || maximum is < 1 or > 100)
        {
            Snackbar.Add("Enter valid invitation and session policy values.", AppSeverity.Error);
            return;
        }
        if (!_passwordSignInEnabled && !_passkeySignInEnabled &&
            !_externalSignInEnabled && !_allowLocalOnlyAccounts)
        {
            Snackbar.Add("Keep at least one account sign-in method enabled.", AppSeverity.Error);
            return;
        }

        _saving = true;
        try
        {
            var saved = await Orchestrator.UpdateAuthSettingsAsync(new UpdateAuthSettingsRequest
            {
                Mode = _mode,
                LocalhostBypass = _localhostBypass,
                PasswordSignInEnabled = _passwordSignInEnabled,
                PasskeySignInEnabled = _passkeySignInEnabled,
                ExternalSignInEnabled = _externalSignInEnabled,
                AllowLocalOnlyAccounts = _allowLocalOnlyAccounts,
                TrustedLocalNetworks = _trustedLocalNetworks.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(),
                InvitationLifetimeHours = invitations,
                SessionLifetimeHours = sessions,
                MaximumActiveSessions = maximum,
            }, _lifetime.Token);
            if (saved is null)
            {
                Snackbar.Add("Authentication settings could not be saved.", AppSeverity.Error);
                return;
            }
            Apply(saved);
            Snackbar.Add("Authentication settings saved. Restart the Engine and Dashboard to apply provider changes.", AppSeverity.Success);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Authentication settings save failed");
            Snackbar.Add("Authentication settings could not be saved.", AppSeverity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void AddProvider()
    {
        _providerEditors.Add(new ProviderEditor
        {
            Kind = "oidc",
            Scopes = "openid profile email",
        });
    }

    private static void ChangeProviderKind(ProviderEditor provider, ChangeEventArgs args)
    {
        provider.Kind = args.Value?.ToString() ?? "oidc";
        if (provider.Kind == "oidc" && !provider.Scopes.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Contains("openid", StringComparer.OrdinalIgnoreCase))
        {
            provider.Scopes = string.IsNullOrWhiteSpace(provider.Scopes)
                ? "openid profile email"
                : $"openid {provider.Scopes}";
        }
    }

    private async Task SaveProviderAsync(ProviderEditor provider)
    {
        if (_saving || _disposed) return;
        if (string.IsNullOrWhiteSpace(provider.Id))
        {
            Snackbar.Add("Enter a stable provider id.", AppSeverity.Error);
            return;
        }

        _saving = true;
        try
        {
            var saved = await Orchestrator.UpdateExternalAuthProviderAsync(provider.Id, new UpdateExternalAuthProviderRequest
            {
                Kind = provider.Kind,
                Enabled = provider.Enabled,
                DisplayName = provider.DisplayName,
                Issuer = provider.Issuer,
                Authority = provider.Authority,
                ClientId = provider.ClientId,
                ClientSecret = string.IsNullOrWhiteSpace(provider.ClientSecret) ? null : provider.ClientSecret,
                ClearClientSecret = provider.ClearClientSecret,
                Scopes = provider.Scopes.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(),
                UsePkce = provider.UsePkce,
                AuthorizationEndpoint = provider.AuthorizationEndpoint,
                TokenEndpoint = provider.TokenEndpoint,
                UserInformationEndpoint = provider.UserInformationEndpoint,
                IdClaim = provider.IdClaim,
                NameClaim = provider.NameClaim,
                EmailClaim = provider.EmailClaim,
            }, _lifetime.Token);
            if (saved is null)
            {
                Snackbar.Add("Provider settings could not be saved.", AppSeverity.Error);
                return;
            }
            if (!string.IsNullOrWhiteSpace(provider.ClientSecret) || provider.ClearClientSecret)
            {
                RegisteredProviders.MarkSecretChanged();
            }
            Apply(saved);
            Snackbar.Add("Provider saved. Restart the Engine and Dashboard before using the new provider configuration.", AppSeverity.Success);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Authentication provider save failed");
            Snackbar.Add("Provider settings could not be saved.", AppSeverity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteProviderAsync(ProviderEditor provider)
    {
        if (_saving || _disposed) return;
        _saving = true;
        try
        {
            var deleted = await Orchestrator.DeleteExternalAuthProviderAsync(provider.Id, _lifetime.Token);
            var current = deleted ? await Orchestrator.GetAuthSettingsAsync(_lifetime.Token) : null;
            if (!deleted || current is null)
            {
                Snackbar.Add("Provider could not be deleted.", AppSeverity.Error);
                return;
            }
            Apply(current);
            Snackbar.Add("Provider deleted. Restart the Engine and Dashboard to apply the change.", AppSeverity.Success);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Authentication provider delete failed");
            Snackbar.Add("Provider could not be deleted.", AppSeverity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SendTestEmailAsync()
    {
        if (_saving || _disposed || _authSettings?.PasswordReset.Ready != true) return;
        _saving = true;
        try
        {
            var sent = await DashboardAuthenticationEndpoints.SendCurrentAccountTestEmailAsync(
                IdentityClient, PasswordResetEmails, _lifetime.Token);
            Snackbar.Add(sent ? "Test email sent to your account address." : "Test email could not be sent.",
                sent ? AppSeverity.Success : AppSeverity.Error);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Authentication test email failed");
            Snackbar.Add("Test email could not be sent.", AppSeverity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string ProviderState(ProviderEditor provider) => provider.Ready
        ? "Ready"
        : provider.Configured ? "Configured, not ready" : provider.Enabled ? "Enabled, not configured" : "Disabled";
    private static string ValueOrNotConfigured(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not configured" : value;

    public ValueTask DisposeAsync()
    {
        if (_disposed) return ValueTask.CompletedTask;
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
        return ValueTask.CompletedTask;
    }
    private sealed class ProviderEditor
    {
        public string Id { get; set; } = string.Empty;
        public bool Persisted { get; set; }
        public string Kind { get; set; } = "oidc";
        public bool Enabled { get; set; }
        public string DisplayName { get; set; } = string.Empty;
        public string Issuer { get; set; } = string.Empty;
        public string Authority { get; set; } = string.Empty;
        public string ClientId { get; set; } = string.Empty;
        public string ClientSecret { get; set; } = string.Empty;
        public bool ClearClientSecret { get; set; }
        public string Scopes { get; set; } = string.Empty;
        public bool UsePkce { get; set; } = true;
        public string AuthorizationEndpoint { get; set; } = string.Empty;
        public string TokenEndpoint { get; set; } = string.Empty;
        public string UserInformationEndpoint { get; set; } = string.Empty;
        public string IdClaim { get; set; } = "id";
        public string NameClaim { get; set; } = "name";
        public string EmailClaim { get; set; } = "email";
        public bool Configured { get; set; }
        public bool Ready { get; set; }

        public static ProviderEditor From(ExternalAuthProviderDto provider) => new()
        {
            Id = provider.Id,
            Persisted = true,
            Kind = provider.Kind,
            Enabled = provider.Enabled,
            DisplayName = provider.DisplayName,
            Issuer = provider.Issuer,
            Authority = provider.Authority,
            ClientId = provider.ClientId,
            Scopes = string.Join(' ', provider.Scopes),
            UsePkce = provider.UsePkce,
            AuthorizationEndpoint = provider.AuthorizationEndpoint,
            TokenEndpoint = provider.TokenEndpoint,
            UserInformationEndpoint = provider.UserInformationEndpoint,
            IdClaim = provider.IdClaim,
            NameClaim = provider.NameClaim,
            EmailClaim = provider.EmailClaim,
            Configured = provider.Configured,
            Ready = provider.Ready,
        };
    }
}
