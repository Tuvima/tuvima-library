@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Services.Navigation
@using MediaEngine.Web.Services.Settings
@implements IDisposable
@inject UIOrchestratorService Orchestrator
@inject DeviceContextService DeviceContext
@inject SettingsAttentionState Attention
@inject ApprovalFlow Approvals

<div class="tl-page local-ai-settings">
    @switch (NormalizedSubsection)
    {
        case "models":
            @* Desktop and tablet only, like the other runtime controls. *@
            @if (!DeviceContext.IsMobile)
            {
                <LocalAiRuntimePanel />
            }
            break;
        case "vocabulary":
            <VibeVocabularyTab />
            break;
        case "automation":
            <AiScheduleTab />
            break;
        default:
            @OverviewContent()
            break;
    }
</div>

@code {
    [Parameter] public string Subsection { get; set; } = "overview";

    private string NormalizedSubsection => Subsection?.Trim().ToLowerInvariant() switch
    {
        "models" => "models",
        "vocabulary" => "vocabulary",
        "automation" => "automation",
        _ => "overview",
    };

    private EnrichmentProgressDto? _progress;
    private AiConfigDto? _config;
    private List<AiModelStatusDto> _models = [];
    private string? _loadedSubsection;
    private bool _loading = true;
    private bool _savingFeatures;
    private string? _featureMessage;

    private AiModelStatusDto? ActiveModel => _models.FirstOrDefault(model => model.Active)
        ?? _models.FirstOrDefault(model => model.Loaded);

    private int EnabledFeatureCount => FeatureDefinitions()
        .Count(feature => feature.Connected && IsFeatureEnabled(feature.Key));

    protected override void OnInitialized() => Attention.Changed += OnAttentionChanged;

    private void OnAttentionChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Attention.Changed -= OnAttentionChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedSubsection, NormalizedSubsection, StringComparison.Ordinal))
            return;

        _loadedSubsection = NormalizedSubsection;
        _loading = true;

        if (NormalizedSubsection == "overview")
        {
            _config = await Orchestrator.GetAiConfigAsync();
            _models = (await Orchestrator.GetAiModelStatusesAsync()).ToList();
            _progress = await Orchestrator.GetEnrichmentProgressAsync();
        }

        _loading = false;
    }

    private RenderFragment OverviewContent() => @<text>
        @if (_loading)
        {
            <AppProgressBar Indeterminate="true" />
        }
        else
        {
            @EngineCard()

            <div class="local-ai-settings__summary-grid">
                <AppCard Title="Features" Class="local-ai-settings__summary-card">
                    <strong>@EnabledFeatureCount enabled</strong>
                    <span>Connected local capabilities</span>
                </AppCard>
                <AppCard Title="Automation" Class="local-ai-settings__summary-card">
                    <strong>@AutomationSummary()</strong>
                    <span>@AutomationDescription()</span>
                </AppCard>
            </div>

            @if (!DeviceContext.IsMobile)
            {
            <SettingsAdvancedLinkRow Title="Models and runtime" Description="The resource profile, runtime limits and diagnostics are on Runtime. Model files and downloads are on Tools and requirements." Href="/settings/ai/models" ActionLabel="Open" />
            <section class="local-ai-settings__features" aria-label="Enabled features">
                <AppText Typo="AppTypo.subtitle1">Enabled features</AppText>
                <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">Choose which connected Local AI capabilities Tuvima Library may use.</AppText>
                @if (_config is null)
                {
                    <AppEmptyState Title="AI configuration unavailable" Message="Feature controls are hidden until saved configuration can be loaded." />
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(_featureMessage))
                    {
                        <AppAlert Tone="AppUiTone.Info">@_featureMessage</AppAlert>
                    }
                    <div class="local-ai-settings__feature-grid">
                        @foreach (var feature in FeatureDefinitions())
                        {
                            @FeatureCard(feature)
                        }
                    </div>
                    <div>
                        <AppButton Label="Save features" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary"
                                   Disabled="@_savingFeatures" OnClick="@SaveFeaturesAsync" />
                    </div>
                }
            </section>

            @* Feature readiness is the model and hardware dependency view of the same feature switches, so it stays with them. *@
            <AppCard Title="Feature readiness" Description="Inspect model and hardware dependencies for every Local AI capability.">
                <AiFeaturesTab />
            </AppCard>
            }
        }
    </text>;

    private string? FirstBlockerText() =>
        Attention.LocalAiBlockers.FirstOrDefault() is { } blocker ? StateCardHealth.BlockerText(blocker) : null;

    private RenderFragment EngineCard()
    {
        var health = StateCardHealth.ForLocalAiEngine(Attention.LocalAiBlocked, FirstBlockerText(), ActiveModel);
        return @<AppStateCard Name="@ActiveModelName()"
                              Kind="StateCardKind.LocalAiEngine"
                              Health="@health.Word"
                              LastProblem="@health.LastProblem"
                              AllowedTo="@StateCardHealth.EngineAllowedTo"
                              SendsDataOut="false"
                              SendsDataTo="@StateCardHealth.RunsOnThisMachine"
                              Action="@ModelsAction()" />;
    }

    // The runtime and model page is desktop and tablet only, like the other runtime controls.
    private RenderFragment? ModelsAction() => DeviceContext.IsMobile
        ? null
        : @<AppButton Label="Models and runtime" Href="/settings/ai/models" Size="AppControlSize.Compact" />;

    private RenderFragment FeatureCard(FeatureDefinition feature)
    {
        var enabled = IsFeatureEnabled(feature.Key);
        var model = _models.FirstOrDefault(m => string.Equals(m.Role, StateCardHealth.FeatureModelRole, StringComparison.OrdinalIgnoreCase));
        var health = StateCardHealth.ForAiFeature(enabled, Attention.LocalAiBlocked, FirstBlockerText(), StateCardHealth.IsModelReady(model));
        return @<AppStateCard Name="@feature.Name"
                              Kind="StateCardKind.Plugin"
                              Description="@feature.Description"
                              IsOn="@enabled"
                              IsOnChanged="@(value => SetFeatureEnabled(feature.Key, value))"
                              SwitchDisabledReason="@(feature.Connected ? null : "Planned: this is not connected to the Library yet.")"
                              Health="@health.Word"
                              LastProblem="@health.LastProblem"
                              AllowedTo="@FeatureAllowedTo(feature.Key)"
                              SendsDataOut="@(FeatureSendsDataTo(feature.Key) is not null)"
                              SendsDataTo="@(FeatureSendsDataTo(feature.Key) ?? StateCardHealth.RunsOnThisMachine)">
            <Badges><AppStatusBadge Text="Uses Local AI" Tone="AppUiTone.Info" /></Badges>
        </AppStateCard>;
    }

    private string ActiveModelName()
    {
        if (ActiveModel is null)
            return "None loaded";

        return !string.IsNullOrWhiteSpace(ActiveModel.DisplayName) ? ActiveModel.DisplayName : ActiveModel.Role;
    }

    private string AutomationSummary() => _progress is null ? "Unavailable" : _progress.PendingCount == 0 ? "Up to date" : $"{_progress.PendingCount} pending";

    private string AutomationDescription() => _progress is null ? "Progress could not be loaded" : $"{_progress.CompletedCount} of {_progress.Total} completed";

    // The Engine's own words for what a feature may do; the same ones the approval dialog shows.
    private IReadOnlyList<string> FeatureAllowedTo(string key) =>
        _config?.FeatureInfo.TryGetValue(key, out var info) == true ? info.AllowedTo : [];

    private string? FeatureSendsDataTo(string key) =>
        _config?.FeatureInfo.TryGetValue(key, out var info) == true ? info.SendsDataTo : null;

    private bool IsFeatureEnabled(string key) => _config?.Features.TryGetValue(key, out var enabled) == true && enabled;

    private void SetFeatureEnabled(string key, bool enabled)
    {
        if (_config is not null)
            _config.Features[key] = enabled;
    }

    private async Task SaveFeaturesAsync()
    {
        if (_config is null)
            return;

        _savingFeatures = true;
        var outcome = await Approvals.SaveAiConfigAsync(Orchestrator, _config);
        _savingFeatures = false;
        _featureMessage = outcome switch
        {
            AiSaveOutcome.Saved => "Local AI features saved.",
            AiSaveOutcome.Cancelled => "Nothing was turned on. The features are back to how they were saved.",
            _ => "Local AI features could not be saved.",
        };
    }

    private sealed record FeatureDefinition(string Key, string Name, string Description, bool Connected = true);

    private static IReadOnlyList<FeatureDefinition> FeatureDefinitions() =>
    [
        new("smart_labeling", "Smart labeling", "Improve filenames and initial metadata."),
        new("type_logic", "Media-type assistance", "Classify ambiguous incoming files."),
        new("series_alignment", "Series alignment", "Assist structural order and grouping."),
        new("vibe_tags", "Vibe tags", "Generate controlled local mood tags."),
        new("tldr", "Description TL;DR", "Present concise summaries created by description intelligence."),
        new("description_intelligence", "Description intelligence", "Extract themes, setting, entities, and useful context."),
    ];
}
