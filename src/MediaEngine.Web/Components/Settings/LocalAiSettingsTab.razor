@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Services.Navigation
@using MediaEngine.Web.Services.Settings
@implements IDisposable
@inject UIOrchestratorService Orchestrator
@inject DeviceContextService DeviceContext
@inject SettingsAttentionState Attention

<div class="tl-page local-ai-settings">
    @switch (NormalizedSubsection)
    {
        case "models":
            @* Desktop and tablet only, like the other runtime controls. *@
            @if (!DeviceContext.IsMobile)
            {
                <ModelsTab />
            }
            break;
        case "advanced":
            @* Runtime settings, invalidate benchmark and diagnostics, then the plugin allowance, then the detailed usage table. *@
            @if (!DeviceContext.IsMobile)
            {
                <LocalAiRuntimePanel />
                <LocalAiBudgetPanel />
            }
            <LocalAiUsagePanel View="LocalAiUsagePanel.LocalAiUsageView.Table" />
            break;
        default:
            @StatusContent()
            break;
    }
</div>

@code {
    [Parameter] public string Subsection { get; set; } = "status";

    private string NormalizedSubsection => Subsection?.Trim().ToLowerInvariant() switch
    {
        "models" => "models",
        "advanced" => "advanced",
        _ => "status",
    };

    private List<AiModelStatusDto> _models = [];
    private string? _loadedSubsection;
    private bool _loading = true;

    private AiModelStatusDto? ActiveModel => _models.FirstOrDefault(model => model.Active)
        ?? _models.FirstOrDefault(model => model.Loaded);

    protected override void OnInitialized() => Attention.Changed += OnAttentionChanged;

    private void OnAttentionChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Attention.Changed -= OnAttentionChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedSubsection, NormalizedSubsection, StringComparison.Ordinal))
            return;

        _loadedSubsection = NormalizedSubsection;
        _loading = true;

        if (NormalizedSubsection == "status")
            _models = (await Orchestrator.GetAiModelStatusesAsync()).ToList();

        _loading = false;
    }

    // Local AI is an engine room, not a feature list: the AI features are plugins, switched on and off on the Plugins page.
    private RenderFragment StatusContent() => @<text>
        @if (_loading)
        {
            <AppProgressBar Indeterminate="true" />
        }
        else
        {
            @EngineCard()

            <LocalAiUsagePanel View="LocalAiUsagePanel.LocalAiUsageView.Plugins" />

            <SettingsAdvancedLinkRow Title="AI features are plugins" Description="Smart labelling, vibe tags and the other AI features are switched on, approved and changed on the Plugins page. Turning one on for the first time may download an AI model." Href="/settings/plugins" ActionLabel="Open Plugins" />
        }
    </text>;

    private string? FirstBlockerText() =>
        Attention.LocalAiBlockers.FirstOrDefault() is { } blocker ? StateCardHealth.BlockerText(blocker) : null;

    private RenderFragment EngineCard()
    {
        var health = StateCardHealth.ForLocalAiEngine(Attention.LocalAiBlocked, FirstBlockerText(), ActiveModel);
        return @<AppStateCard Name="@ActiveModelName()"
                              Kind="StateCardKind.LocalAiEngine"
                              Health="@health.Word"
                              LastProblem="@health.LastProblem"
                              AllowedTo="@StateCardHealth.EngineAllowedTo"
                              SendsDataOut="false"
                              SendsDataTo="@StateCardHealth.RunsOnThisMachine"
                              Action="@ModelsAction()" />;
    }

    // The model and hardware page is desktop and tablet only, like the other runtime controls.
    private RenderFragment? ModelsAction() => DeviceContext.IsMobile
        ? null
        : @<AppButton Label="Model and hardware" Href="/settings/ai/models" Size="AppControlSize.Compact" />;

    private string ActiveModelName()
    {
        if (ActiveModel is null)
            return "None loaded";

        return !string.IsNullOrWhiteSpace(ActiveModel.DisplayName) ? ActiveModel.DisplayName : ActiveModel.Role;
    }
}
