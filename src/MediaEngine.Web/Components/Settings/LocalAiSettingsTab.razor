@namespace MediaEngine.Web.Components.Settings
@inject UIOrchestratorService Orchestrator
@inject DeviceContextService DeviceContext

<div class="tl-page local-ai-settings">
    @switch (NormalizedSubsection)
    {
        case "vocabulary":
            <AppPanel Class="local-ai-settings__section">
                @SectionHeading("Vocabulary", "Manage the controlled terms used by local enrichment.", AppMaterialIcons.Outlined.Spellcheck)
                <VibeVocabularyTab />
            </AppPanel>
            break;
        case "automation":
            <AppPanel Class="local-ai-settings__section">
                @SectionHeading("Automation", "Control saved enrichment and maintenance schedules.", AppMaterialIcons.Outlined.Schedule)
                <AiScheduleTab />
            </AppPanel>
            break;
        default:
            @OverviewContent()
            break;
    }
</div>

@code {
    [Parameter] public string Subsection { get; set; } = "overview";

    private string NormalizedSubsection => Subsection?.Trim().ToLowerInvariant() switch
    {
        "vocabulary" => "vocabulary",
        "automation" => "automation",
        _ => "overview",
    };

    private EnrichmentProgressDto? _progress;
    private AiConfigDto? _config;
    private List<AiModelStatusDto> _models = [];
    private string? _loadedSubsection;
    private bool _loading = true;
    private bool _savingFeatures;
    private string? _featureMessage;

    private AiModelStatusDto? ActiveModel => _models.FirstOrDefault(model => model.Active)
        ?? _models.FirstOrDefault(model => model.Loaded);

    private int EnabledFeatureCount => FeatureDefinitions()
        .Count(feature => feature.Connected && IsFeatureEnabled(feature.Key));

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedSubsection, NormalizedSubsection, StringComparison.Ordinal))
            return;

        _loadedSubsection = NormalizedSubsection;
        _loading = true;

        if (NormalizedSubsection == "overview")
        {
            _config = await Orchestrator.GetAiConfigAsync();
            _models = (await Orchestrator.GetAiModelStatusesAsync()).ToList();
            _progress = await Orchestrator.GetEnrichmentProgressAsync();
        }

        _loading = false;
    }

    private RenderFragment OverviewContent() => @<text>
        @if (_loading)
        {
            <AppProgressBar Indeterminate="true" />
        }
        else
        {
            <div class="local-ai-settings__summary-grid">
                <AppCard Title="Active model" Class="local-ai-settings__summary-card">
                    <strong>@ActiveModelName()</strong>
                    <span>@(ActiveModel is null ? "No model is currently loaded" : "Primary local model")</span>
                </AppCard>
                <AppCard Title="Features" Class="local-ai-settings__summary-card">
                    <strong>@EnabledFeatureCount enabled</strong>
                    <span>Connected local capabilities</span>
                </AppCard>
                <AppCard Title="Automation" Class="local-ai-settings__summary-card">
                    <strong>@AutomationSummary()</strong>
                    <span>@AutomationDescription()</span>
                </AppCard>
            </div>

            @if (!DeviceContext.IsMobile)
            {
            <SettingsAdvancedLinkRow Title="Models and runtime" Description="Model files, downloads and the Local AI runtime are on Tools and requirements." Href="/settings/tools" ActionLabel="Open" />
            <AppCard Title="Enabled features" Description="Choose which connected Local AI capabilities Tuvima Library may use.">
                @if (_config is null)
                {
                    <AppEmptyState Title="AI configuration unavailable" Message="Feature controls are hidden until saved configuration can be loaded." />
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(_featureMessage))
                    {
                        <AppAlert Tone="AppUiTone.Info" Class="tl-sp-mb-3">@_featureMessage</AppAlert>
                    }
                    <div class="local-ai-settings__feature-grid">
                        @foreach (var feature in FeatureDefinitions())
                        {
                            <AppSwitchRow Label="@feature.Name" Description="@feature.Description"
                                          Value="@IsFeatureEnabled(feature.Key)"
                                          ValueChanged="@(value => SetFeatureEnabled(feature.Key, value))"
                                          Disabled="@(!feature.Connected)"
                                          Class="@(!feature.Connected ? "local-ai-settings__feature--planned" : null)" />
                        }
                    </div>
                    <AppButton Label="Save features" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary"
                               Class="tl-sp-mt-3" Disabled="@_savingFeatures" OnClick="@SaveFeaturesAsync" />
                }
            </AppCard>

            @* Feature readiness is the model and hardware dependency view of the same feature switches, so it stays with them. *@
            <AppCard Title="Feature readiness" Description="Inspect model and hardware dependencies for every Local AI capability.">
                <AiFeaturesTab />
            </AppCard>
            }
        }
    </text>;

    private string ActiveModelName()
    {
        if (ActiveModel is null)
            return "None loaded";

        return !string.IsNullOrWhiteSpace(ActiveModel.DisplayName) ? ActiveModel.DisplayName : ActiveModel.Role;
    }

    private string AutomationSummary() => _progress is null ? "Unavailable" : _progress.PendingCount == 0 ? "Up to date" : $"{_progress.PendingCount} pending";

    private string AutomationDescription() => _progress is null ? "Progress could not be loaded" : $"{_progress.CompletedCount} of {_progress.Total} completed";

    private bool IsFeatureEnabled(string key) => _config?.Features.TryGetValue(key, out var enabled) == true && enabled;

    private void SetFeatureEnabled(string key, bool enabled)
    {
        if (_config is not null)
            _config.Features[key] = enabled;
    }

    private async Task SaveFeaturesAsync()
    {
        if (_config is null)
            return;

        _savingFeatures = true;
        var saved = await Orchestrator.SaveAiConfigAsync(_config);
        _savingFeatures = false;
        _featureMessage = saved ? "Local AI features saved." : "Local AI features could not be saved.";
    }

    private static RenderFragment SectionHeading(string title, string description, string icon) => @<SettingsSectionHeader Title="@title" Description="@description" Icon="@icon" Divider="true" />;

    private sealed record FeatureDefinition(string Key, string Name, string Description, bool Connected = true);

    private static IReadOnlyList<FeatureDefinition> FeatureDefinitions() =>
    [
        new("smart_labeling", "Smart labeling", "Improve filenames and initial metadata."),
        new("type_logic", "Media-type assistance", "Classify ambiguous incoming files."),
        new("series_alignment", "Series alignment", "Assist structural order and grouping."),
        new("vibe_tags", "Vibe tags", "Generate controlled local mood tags."),
        new("tldr", "Description TL;DR", "Present concise summaries created by description intelligence."),
        new("description_intelligence", "Description intelligence", "Extract themes, setting, entities, and useful context."),
    ];
}
