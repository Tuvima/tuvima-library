@namespace MediaEngine.Web.Components.Settings
@inject UIOrchestratorService Orchestrator
@inject DeviceContextService DeviceContext

<div class="tl-page local-ai-settings">
    @switch (NormalizedSubsection)
    {
        case "models":
            <AppPanel Class="local-ai-settings__section">
                @SectionHeading("Models & Runtime", "Manage local model files, lifecycle actions, and runtime limits.", AppMaterialIcons.Outlined.Storage)
                <ModelsTab />
                <AppCard Title="Runtime settings" Density="AppSurfaceDensity.Compact">
                    @if (_config is null)
                    {
                        <AppEmptyState Title="AI configuration unavailable" Message="Runtime controls are hidden until the Engine returns saved configuration." />
                    }
                    else
                    {
                        <div class="tl-form-grid local-ai-settings__runtime-form">
                            <AppTextField @bind-Value="_config.ModelsDirectory" Label="Models directory" />
                            <AppNumericField T="int" @bind-Value="_config.IdleUnloadSeconds" Label="Idle unload seconds" Min="1" />
                            <AppNumericField T="int" @bind-Value="_config.InferenceTimeoutSeconds" Label="Inference timeout seconds" Min="1" />
                            <AppNumericField T="int" @bind-Value="_config.MaxConcurrentInferences" Label="Maximum concurrent inference" Min="1" Max="1" />
                            <AppNumericField T="int" @bind-Value="_config.MinimumFreeDiskMB" Label="Minimum free disk (MB)" Min="256" />
                            <AppNumericField T="int" @bind-Value="_config.EnrichmentBatchSize" Label="Enrichment batch size" Min="1" />
                        </div>
                        <AppButton Label="Save runtime settings" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary"
                                   Class="mt-3" Disabled="@_savingConfig" OnClick="@SaveConfig" />
                    }
                </AppCard>
                @if (_profile is not null || _resources is not null)
                {
                    <AppCard Title="Runtime diagnostics" Density="AppSurfaceDensity.Compact">
                        <div class="local-ai-settings__diagnostics">
                            @if (_profile is not null)
                            {
                                <span><strong>Backend</strong>@_profile.Backend</span>
                                <span><strong>Benchmark</strong>@BenchmarkLabel()</span>
                            }
                            @if (_resources is not null)
                            {
                                <span><strong>Engine memory</strong>@FormatMb(_resources.EngineRamMb)</span>
                                <span><strong>CPU pressure</strong>@CpuPressureLabel(_resources.CpuPressure)</span>
                            }
                        </div>
                    </AppCard>
                }
                <AppCard Title="Feature readiness" Description="Inspect model and hardware dependencies for every Local AI capability." Density="AppSurfaceDensity.Compact">
                    <AiFeaturesTab />
                </AppCard>
            </AppPanel>
            break;
        case "vocabulary":
            <AppPanel Class="local-ai-settings__section">
                @SectionHeading("Vocabulary", "Manage the controlled terms used by local enrichment.", AppMaterialIcons.Outlined.Spellcheck)
                <VibeVocabularyTab />
            </AppPanel>
            break;
        case "automation":
            <AppPanel Class="local-ai-settings__section">
                @SectionHeading("Automation", "Control saved enrichment and maintenance schedules.", AppMaterialIcons.Outlined.Schedule)
                <AiScheduleTab />
            </AppPanel>
            break;
        default:
            @OverviewContent()
            break;
    }
</div>

@code {
    [Parameter] public string Subsection { get; set; } = "overview";

    private string NormalizedSubsection => Subsection?.Trim().ToLowerInvariant() switch
    {
        "models" => "models",
        "vocabulary" => "vocabulary",
        "automation" => "automation",
        _ => "overview",
    };

    private AiHealthStatusDto? _status;
    private HardwareProfileDto? _profile;
    private ResourceSnapshotDto? _resources;
    private EnrichmentProgressDto? _progress;
    private AiConfigDto? _config;
    private List<AiModelStatusDto> _models = [];
    private string? _loadedSubsection;
    private bool _loading = true;
    private bool _savingConfig;
    private bool _savingFeatures;
    private string? _featureMessage;

    private AiModelStatusDto? ActiveModel => _models.FirstOrDefault(model => model.Active)
        ?? _models.FirstOrDefault(model => model.Loaded);

    private int EnabledFeatureCount => FeatureDefinitions()
        .Count(feature => feature.Connected && IsFeatureEnabled(feature.Key));

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedSubsection, NormalizedSubsection, StringComparison.Ordinal))
            return;

        _loadedSubsection = NormalizedSubsection;
        _loading = true;

        if (NormalizedSubsection == "overview")
        {
            _status = await Orchestrator.GetAiStatusAsync();
            _config = await Orchestrator.GetAiConfigAsync();
            _models = (await Orchestrator.GetAiModelStatusesAsync()).ToList();
            _progress = await Orchestrator.GetEnrichmentProgressAsync();
        }
        else if (NormalizedSubsection == "models")
        {
            _config = await Orchestrator.GetAiConfigAsync();
            _profile = await Orchestrator.GetAiProfileAsync();
            _resources = await Orchestrator.GetResourceSnapshotAsync();
        }

        _loading = false;
    }

    private RenderFragment OverviewContent() => @<text>
        @if (_loading)
        {
            <AppProgressBar Indeterminate="true" />
        }
        else
        {
            @if (_status?.IsReady != true)
            {
                <AppAlert Tone="AppUiTone.Warning" Class="local-ai-settings__health-banner">
                    <strong>@OverviewStatusTitle</strong>
                    <span>@OverviewStatusDescription</span>
                </AppAlert>
            }

            <div class="local-ai-settings__summary-grid">
                <AppCard Title="Active model" Class="local-ai-settings__summary-card">
                    <strong>@ActiveModelName()</strong>
                    <span>@(ActiveModel is null ? "No model is currently loaded" : "Primary local model")</span>
                </AppCard>
                <AppCard Title="Features" Class="local-ai-settings__summary-card">
                    <strong>@EnabledFeatureCount enabled</strong>
                    <span>Connected local capabilities</span>
                </AppCard>
                <AppCard Title="Automation" Class="local-ai-settings__summary-card">
                    <strong>@AutomationSummary()</strong>
                    <span>@AutomationDescription()</span>
                </AppCard>
            </div>

            @if (!DeviceContext.IsMobile)
            {
            <AppCard Title="Enabled features" Description="Choose which connected Local AI capabilities Tuvima Library may use.">
                @if (_config is null)
                {
                    <AppEmptyState Title="AI configuration unavailable" Message="Feature controls are hidden until saved configuration can be loaded." />
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(_featureMessage))
                    {
                        <AppAlert Tone="AppUiTone.Info" Class="mb-3">@_featureMessage</AppAlert>
                    }
                    <div class="local-ai-settings__feature-grid">
                        @foreach (var feature in FeatureDefinitions())
                        {
                            <AppSwitchRow Label="@feature.Name" Description="@feature.Description"
                                          Value="@IsFeatureEnabled(feature.Key)"
                                          ValueChanged="@(value => SetFeatureEnabled(feature.Key, value))"
                                          Disabled="@(!feature.Connected)"
                                          Class="@(!feature.Connected ? "local-ai-settings__feature--planned" : null)" />
                        }
                    </div>
                    <AppButton Label="Save features" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary"
                               Class="mt-3" Disabled="@_savingFeatures" OnClick="@SaveFeaturesAsync" />
                }
            </AppCard>
            }

            @if (!DeviceContext.IsMobile)
            {
            <AppCard Title="Advanced AI" Description="Technical controls stay available when you need them.">
                <SettingsAdvancedLinkRow Title="Models & Runtime" Description="Manage model files, lifecycle actions, validation, and runtime limits." Href="/settings/ai/models" ActionLabel="Manage" />
                <SettingsAdvancedLinkRow Title="Vocabulary" Description="Edit the controlled vocabulary used by local tagging." Href="/settings/ai/vocabulary" ActionLabel="Manage" />
                <SettingsAdvancedLinkRow Title="Automation" Description="Review enrichment progress and edit saved schedules." Href="/settings/ai/automation" ActionLabel="Manage" />
            </AppCard>
            }
        }
    </text>;

    private string OverviewStatusTitle => _status?.IsReady == true
        ? string.Empty
        : _status is null ? "Local AI status is unavailable" : "Local AI is available with limitations";

    private string OverviewStatusDescription => _status?.IsReady == true
        ? string.Empty
        : _status is null ? "Library browsing continues without Local AI status." : "Review models and runtime details before relying on every feature.";

    private string ActiveModelName()
    {
        if (ActiveModel is null)
            return "None loaded";

        return !string.IsNullOrWhiteSpace(ActiveModel.DisplayName) ? ActiveModel.DisplayName : ActiveModel.Role;
    }

    private string AutomationSummary() => _progress is null ? "Unavailable" : _progress.PendingCount == 0 ? "Up to date" : $"{_progress.PendingCount} pending";

    private string AutomationDescription() => _progress is null ? "Progress could not be loaded" : $"{_progress.CompletedCount} of {_progress.Total} completed";

    private bool IsFeatureEnabled(string key) => _config?.Features.TryGetValue(key, out var enabled) == true && enabled;

    private void SetFeatureEnabled(string key, bool enabled)
    {
        if (_config is not null)
            _config.Features[key] = enabled;
    }

    private async Task SaveFeaturesAsync()
    {
        if (_config is null)
            return;

        _savingFeatures = true;
        var saved = await Orchestrator.SaveAiConfigAsync(_config);
        _savingFeatures = false;
        _featureMessage = saved ? "Local AI features saved." : "Local AI features could not be saved.";
    }

    private static RenderFragment SectionHeading(string title, string description, string icon) => @<SettingsSectionHeader Title="@title" Description="@description" Icon="@icon" Divider="true" />;

    private async Task SaveConfig()
    {
        if (_config is null || !ValidateRuntime())
            return;

        _savingConfig = true;
        await Orchestrator.SaveAiConfigAsync(_config);
        _savingConfig = false;
    }

    private bool ValidateRuntime() => _config is
    {
        IdleUnloadSeconds: > 0,
        InferenceTimeoutSeconds: > 0,
        MaxConcurrentInferences: 1,
        MinimumFreeDiskMB: >= 256,
        EnrichmentBatchSize: > 0,
    } && !string.IsNullOrWhiteSpace(_config.ModelsDirectory);

    private static string FormatMb(long mb) => mb >= 1024 ? $"{mb / 1024.0:F1} GB" : $"{mb} MB";

    private static string CpuPressureLabel(double pressure) => pressure switch
    {
        >= 0.85 => "High",
        >= 0.5 => "Moderate",
        _ => "Low",
    };

    private string BenchmarkLabel() => _profile?.Outcome switch
    {
        "succeeded" => $"{_profile.TokensPerSecond.GetValueOrDefault():F1} tokens/sec",
        "failed" => "Failed — rerun available",
        "invalidated" => "Invalidated for this machine",
        _ => "Not run",
    };

    private sealed record FeatureDefinition(string Key, string Name, string Description, bool Connected = true);

    private static IReadOnlyList<FeatureDefinition> FeatureDefinitions() =>
    [
        new("smart_labeling", "Smart labeling", "Improve filenames and initial metadata."),
        new("type_logic", "Media-type assistance", "Classify ambiguous incoming files."),
        new("series_alignment", "Series alignment", "Assist structural order and grouping."),
        new("vibe_tags", "Vibe tags", "Generate controlled local mood tags."),
        new("tldr", "Description TL;DR", "Present concise summaries created by description intelligence."),
        new("description_intelligence", "Description intelligence", "Extract themes, setting, entities, and useful context."),
    ];
}
