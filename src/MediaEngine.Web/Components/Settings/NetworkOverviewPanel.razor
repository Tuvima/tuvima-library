@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient
@inject IStringLocalizer<SharedStrings> L

<div class="network-panel network-overview">
    <SettingsSectionPanel Title="@L["NetworkOverviewPanel_ConnectionStatus"].Value"
                          Description="@L["NetworkOverviewPanel_ALiveSummaryOfHow"].Value">
        @* One status line with Test connection beside it (settings alignment D12), instead of three tiles. *@
        <div class="network-status-line" data-testid="network-status-line">
            <p class="network-status-line__text">@StatusLine</p>
            <AppButton Label="@L["NetworkOverviewPanel_TestConnection"].Value" StartIcon="@AppMaterialIcons.Outlined.NetworkCheck"
                       Tone="AppUiTone.Primary" OnClick="TestAsync" />
        </div>
    </SettingsSectionPanel>

    @if (!NetworkIsHealthy)
    {
        <AppAlert Tone="AppUiTone.Warning" Class="network-summary-alert">
            <strong>@(Status?.Headline ?? "Network status is unavailable")</strong>
            <span>@(Status?.Guidance ?? "Start the server to inspect network access.")</span>
        </AppAlert>
    }
</div>

<NetworkTestDialog @bind-Visible="_testDialogOpen" Busy="@_testing" Result="@_testResult" />

@code {
    [Parameter, EditorRequired] public NetworkSettingsDto Settings { get; set; } = new();
    [Parameter] public NetworkRuntimeStatusDto? Status { get; set; }
    [Parameter] public EventCallback StatusRefreshRequested { get; set; }

    private bool _testDialogOpen;
    private bool _testing;
    private NetworkTestResultDto? _testResult;

    private bool HasOutsidePath =>
        !string.Equals(Settings.Remote.ConnectionMode?.Trim(), "local-only", StringComparison.OrdinalIgnoreCase);

    private bool NetworkIsHealthy => Status?.LocalAccess == "healthy"
        && (!HasOutsidePath || Status.RemoteAccess == "available")
        && Status.SecureConnection is not "unavailable";

    private async Task TestAsync()
    {
        _testDialogOpen = true;
        _testing = true;
        _testResult = null;
        _testResult = HasOutsidePath
            ? await ApiClient.TestRemoteNetworkAsync()
            : await ApiClient.TestLocalNetworkAsync();
        _testing = false;
        await StatusRefreshRequested.InvokeAsync();
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value)
        ? "Unavailable"
        : string.Join(' ', value.Split('-', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => char.ToUpperInvariant(part[0]) + part[1..]));

    // Home access, the active route and whether it is secure, as one sentence-like line.
    private string StatusLine =>
        $"Home access: {Display(Status?.LocalAccess)} · Route: {Display(Status?.ConnectionType)} · Secure connection: {Display(Status?.SecureConnection)}";
}
