@namespace MediaEngine.Web.Components.Settings
@inject UIOrchestratorService Orchestrator
@inject IStringLocalizer<SharedStrings> L

@* The plugin allowance card on the Local AI Advanced tab: how much of the machine each plugin may use. Ingestion and a
   person's own requests are never held to a budget; they only go first in the queue. Plugins with their own allowance are
   listed on the Status tab. *@
<div class="local-ai-budget" data-testid="local-ai-budget">
    <AppCard Title="@L["LocalAiBudgetPanel_PluginAllowance"].Value" Description="@L["LocalAiBudgetPanel_HowMuchLocalAIA"].Value" Density="AppSurfaceDensity.Compact">
        @if (_config is null)
        {
            <AppEmptyState Title="@L["Common_AIConfigurationUnavailable"].Value" Message="@L["LocalAiBudgetPanel_TheAllowanceIsHiddenUntil"].Value" />
        }
        else
        {
            <div class="tl-form-grid">
                <AppNumericField T="int" @bind-Value="_config.PluginBudget.RequestsPerHour" Label="@L["LocalAiBudgetPanel_RequestsPerHour"].Value" Min="1" HelpText="Most requests one plugin may make in an hour." />
                <AppNumericField T="int" @bind-Value="_config.PluginBudget.BusySecondsPerHour" Label="@L["LocalAiBudgetPanel_BusySecondsPerHour"].Value" Min="1" HelpText="Most running time one plugin may use in an hour." />
                <AppNumericField T="int" @bind-Value="_config.PluginBudget.MaxWaitSeconds" Label="@L["LocalAiBudgetPanel_LongestWaitSeconds"].Value" Min="1" HelpText="How long a plugin request may wait for its turn before giving up." />
            </div>
            <AppButton Label="@L["LocalAiBudgetPanel_SaveAllowance"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary"
                       Class="tl-sp-mt-3" Disabled="@(_saving || !IsValid)" OnClick="@SaveAsync" />
            @if (_overrideCount > 0)
            {
                <AppText Typo="AppTypo.caption" Color="AppColor.Secondary" Class="tl-sp-mt-2">@OverrideNote()</AppText>
            }
        }
    </AppCard>
</div>

@code {
    private AiConfigDto? _config;
    private bool _saving;
    private int _overrideCount;

    private bool IsValid => _config is { PluginBudget: { RequestsPerHour: > 0, BusySecondsPerHour: > 0, MaxWaitSeconds: > 0 } };

    protected override async Task OnInitializedAsync()
    {
        _config = await Orchestrator.GetAiConfigAsync();
        _overrideCount = _config?.PluginBudgetOverrides.Count ?? 0;
    }

    private string OverrideNote() =>
        _overrideCount == 1 ? "One plugin has its own allowance and keeps it." : $"{_overrideCount} plugins have their own allowance and keep it.";

    private async Task SaveAsync()
    {
        if (_config is null || !IsValid)
        {
            return;
        }

        _saving = true;
        await Orchestrator.SaveAiConfigAsync(_config);
        _saving = false;
    }
}
