@namespace MediaEngine.Web.Components.Settings

@* Streaming. It opens on Limits & Quality; Hardware Acceleration, Optimized Copies and Diagnostics are its other tabs.
   The playback tools and services status shows once, under Diagnostics. *@
<section class="tl-page playback-delivery"
         data-delivery-section="@ActiveSection"
         aria-label="@ActiveSectionLabel">
    @switch (ActiveSection)
    {
        case "hardware":
            <EncodeSettingsTab @key="ActiveSection" Section="hardware" />
            break;
        case "optimized-copies":
            <EncodeSettingsTab @key="ActiveSection" Section="optimized-copies" />
            break;
        case "diagnostics":
            <EncodeSettingsTab @key="ActiveSection" Section="diagnostics" />
            <PlaybackToolsStatusCard />
            break;
        default:
            <StreamingLimitsSettingsTab />
            break;
    }
</section>

@code {
    [Parameter] public string Subsection { get; set; } = string.Empty;

    private string ActiveSection => Subsection.ToLowerInvariant() switch
    {
        "hardware" => "hardware",
        "optimized-copies" => "optimized-copies",
        "diagnostics" => "diagnostics",
        _ => "limits",
    };

    private string ActiveSectionLabel => ActiveSection switch
    {
        "hardware" => "Hardware Acceleration",
        "optimized-copies" => "Optimized Copies",
        "diagnostics" => "Diagnostics",
        _ => "Streaming limits and quality",
    };
}
