@namespace MediaEngine.Web.Components.Settings

@* Playback. It opens on Quality; Advanced holds hardware acceleration, optimized copies and diagnostics (until the Playback packet
   regroups them). The playback tools and services status shows once, under diagnostics. *@
<section class="tl-page playback-delivery"
         data-delivery-section="@ActiveSection"
         aria-label="@ActiveSectionLabel">
    @switch (ActiveSection)
    {
        case "advanced":
            <EncodeSettingsTab Section="hardware" />
            <EncodeSettingsTab Section="optimized-copies" />
            <EncodeSettingsTab Section="diagnostics" />
            <PlaybackToolsStatusCard />
            break;
        default:
            <StreamingLimitsSettingsTab />
            break;
    }
</section>

@code {
    [Parameter] public string Subsection { get; set; } = string.Empty;

    private string ActiveSection => Subsection.ToLowerInvariant() switch
    {
        "advanced" => "advanced",
        _ => "limits",
    };

    private string ActiveSectionLabel => ActiveSection switch
    {
        "advanced" => "Advanced playback settings",
        _ => "Streaming limits and quality",
    };
}
