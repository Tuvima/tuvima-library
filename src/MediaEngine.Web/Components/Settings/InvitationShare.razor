@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Services.Ui
@inject IJSRuntime JS
@inject IAppToastService Toast
@inject NavigationManager Navigation

<AppAlert Severity="AppSeverity.Success" Class="access-invitation">
    <strong>Invitation created.</strong>
    <span>Share the code, the link or the QR code. It won't be shown again.</span>
    <span>Invitation code</span>
    <code>@FormattedCode</code>
    <AppButton Label="Copy code" Size="AppControlSize.Compact" StartIcon="@AppMaterialIcons.Outlined.ContentCopy" OnClick="@(() => CopyAsync(FormattedCode, "Code copied."))" />
    <span>Link</span>
    <code>@_link</code>
    <AppButton Label="Copy link" Size="AppControlSize.Compact" StartIcon="@AppMaterialIcons.Outlined.ContentCopy" OnClick="@(() => CopyAsync(_link, "Link copied."))" />
    <div class="invitation-qr">@((MarkupString)_qr)</div>
    <small>Expires @ExpiresAt.ToLocalTime().ToString("g")</small>
</AppAlert>

@code {
    /// <summary>The code as the Engine gave it (<c>XXXXX-XXXXX</c>).</summary>
    [Parameter, EditorRequired] public string Code { get; set; } = string.Empty;
    [Parameter, EditorRequired] public DateTimeOffset ExpiresAt { get; set; }

    /// <summary>The one public address when it is set; otherwise the address the administrator is using.</summary>
    [Parameter] public string? PublicAddress { get; set; }

    private string _link = string.Empty;
    private string _qr = string.Empty;
    private string FormattedCode => Code;

    protected override void OnParametersSet()
    {
        var address = string.IsNullOrWhiteSpace(PublicAddress) ? Navigation.BaseUri : PublicAddress;
        _link = $"{address.Trim().TrimEnd('/')}/auth/invite?code={Uri.EscapeDataString(Code)}";
        _qr = QrCodeSvg.Render(_link);
    }

    private async Task CopyAsync(string text, string message)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        Toast.Add(message, AppSeverity.Success);
    }
}
