@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@inject DashboardIdentityClient Identity
@inject IAppToastService Snackbar

<SettingsSectionPanel Title="Paired devices" Icon="@AppMaterialIcons.Outlined.Devices"
                      Description="Phones and TVs paired with Library. Sign one out to end its access at once.">
    @if (_loading)
    {
        <AppSkeleton Size="AppControlSize.Compact" />
    }
    else if (_loadFailed)
    {
        <AppAlert Tone="AppUiTone.Error">Paired devices could not be loaded. Try again in a moment.</AppAlert>
    }
    else if (_devices.Count == 0)
    {
        <AppEmptyState Class="app-page-state--compact" Title="No phones or TVs paired"
                       Message="Open a Library app and choose this server to pair it." />
    }
    else if (VisibleDevices.Count == 0)
    {
        <AppEmptyState Class="app-page-state--compact" Title="No paired devices match"
                       Message="Change the household or profile above to see more." />
    }
    else
    {
        <div>
            <AppTable>
                <thead>
                    <tr>
                        <th>Device</th>
                        <th>Type</th>
                        @if (ManagesOthers)
                        {
                            <th>Belongs to</th>
                        }
                        <th>Backs up to</th>
                        <th>Paired</th>
                        <th>Last seen</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var device in VisibleDevices)
                    {
                        <tr @key="device.Id" data-device-row="@device.Id">
                            <td>
                                <span class="paired-device__name">
                                    <DeviceTypeIcon Kind="@DeviceTypeClassifier.Classify(device.Platform, device.ClientName)" />
                                    <span class="paired-device__text">@device.DeviceName<small>@device.ClientName</small></span>
                                </span>
                            </td>
                            <td>@PlatformLabel(device.Platform)</td>
                            @if (ManagesOthers)
                            {
                                <td>@device.AccountDisplayName<small>@device.ProfileName</small></td>
                            }
                            <td>
                                @if (device.Platform == "mobile" && People.Count > 0)
                                {
                                    <AppNativeSelect Value="@(device.BackupProfileId?.ToString() ?? string.Empty)"
                                                     ValueChanged="@(value => SetBackupAsync(device, value))"
                                                     aria-label="@($"Whose photos {device.DeviceName} backs up")">
                                        <option value="">Not chosen</option>
                                        @foreach (var person in People.Where(profile => profile.HouseholdId == device.HouseholdId))
                                        {
                                            <option value="@person.Id">@person.DisplayName</option>
                                        }
                                    </AppNativeSelect>
                                }
                                else if (device.Platform == "mobile")
                                {
                                    @(string.IsNullOrEmpty(device.BacksUpTo) ? "Not chosen" : device.BacksUpTo)
                                }
                            </td>
                            <td>@device.PairedAt.LocalDateTime.ToString("d")</td>
                            <td>@device.LastSeenAt.LocalDateTime.ToString("g")</td>
                            <td>
                                <AppButton Label="Sign out" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Error"
                                           Size="AppControlSize.Compact" OnClick="@(() => AskSignOut(device))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </AppTable>
        </div>
    }
</SettingsSectionPanel>

<AppDialog Visible="@(_pendingSignOut is not null)"
           VisibleChanged="@(_ => CancelSignOut())"
           Title="Sign this device out?"
           Subtitle="@(_pendingSignOut is null ? null : $"{_pendingSignOut.DeviceName} will be signed out and has to be paired again.")"
           Icon="@AppMaterialIcons.Outlined.Devices"
           Size="Small">
    <ChildContent>
        <p>It stops working straight away. Nothing is deleted from your library.</p>
    </ChildContent>
    <FooterContent>
        <div class="network-test-dialog__actions">
            <AppButton Label="Cancel" OnClick="CancelSignOut" />
            <AppButton Label="Sign out" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Error"
                       Disabled="@_signingOut" OnClick="ConfirmSignOutAsync" />
        </div>
    </FooterContent>
</AppDialog>

@code {
    /// <summary>What an administrator narrowed the page to; the Engine has already limited the list to what they may see.</summary>
    [Parameter] public DevicesFilter Filter { get; set; } = DevicesFilter.All;

    /// <summary>The people in scope, for the "Backs up to" choice. Empty for a member, whose list is read-only.</summary>
    [Parameter] public IReadOnlyList<ManagedProfileResponse> People { get; set; } = [];

    /// <summary>An administrator, who also sees whose device each one is.</summary>
    [Parameter] public bool ManagesOthers { get; set; }

    private List<ManagedClientDeviceDto> _devices = [];
    private ManagedClientDeviceDto? _pendingSignOut;
    private bool _loading = true;
    private bool _loadFailed;
    private bool _signingOut;

    private List<ManagedClientDeviceDto> VisibleDevices => _devices.Where(Filter.Matches).ToList();

    protected override async Task OnInitializedAsync() => await LoadDevicesAsync();

    private async Task LoadDevicesAsync()
    {
        _loading = true;
        _loadFailed = false;
        try
        {
            _devices = await Identity.GetManagedDevicesAsync();
        }
        catch (Exception)
        {
            // The panel shows its own "could not be loaded" message; the rest of the page stays usable.
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SetBackupAsync(ManagedClientDeviceDto device, object? value)
    {
        Guid? profileId = Guid.TryParse(value?.ToString(), out var parsed) ? parsed : null;
        var result = await Identity.SetManagedDeviceBackupProfileAsync(device.Id, profileId);
        Snackbar.Add(result.Succeeded ? "Photo backup updated." : "That change could not be saved.",
            result.Succeeded ? AppSeverity.Success : AppSeverity.Error);
        await LoadDevicesAsync();
    }

    private void AskSignOut(ManagedClientDeviceDto device) => _pendingSignOut = device;

    private void CancelSignOut() => _pendingSignOut = null;

    private async Task ConfirmSignOutAsync()
    {
        if (_pendingSignOut is not { } device)
            return;

        _signingOut = true;
        try
        {
            var result = await Identity.RevokeManagedDeviceAsync(device.Id);
            if (result.Succeeded)
            {
                Snackbar.Add($"{device.DeviceName} was signed out.", AppSeverity.Success);
            }
            else
            {
                Snackbar.Add("That device could not be signed out.", AppSeverity.Error);
            }
        }
        finally
        {
            _signingOut = false;
            _pendingSignOut = null;
        }

        await LoadDevicesAsync();
    }

    private static string PlatformLabel(string platform) => platform switch
    {
        "mobile" => "Phone or tablet",
        "television" => "TV",
        "automotive" => "Car",
        "web" => "Browser",
        _ => platform,
    };
}
