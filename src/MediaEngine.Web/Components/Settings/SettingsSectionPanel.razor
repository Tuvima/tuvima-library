@namespace MediaEngine.Web.Components.Settings

@* A Settings group: a 16/600 heading, an optional helper line, optional actions at the right end of the heading row,
   then rows. It sits on the page background with no border (Look v3 D5). *@
<AppSettingsGroup Heading="@Title" Helper="@Description" Class="@Class" Actions="@Actions">@ChildContent</AppSettingsGroup>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
