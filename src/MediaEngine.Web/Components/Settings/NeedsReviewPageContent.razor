@namespace MediaEngine.Web.Components.Settings
@implements IDisposable
@inject UIOrchestratorService Orchestrator
@using MediaEngine.Contracts.Details
@using MediaEngine.Contracts.Library
@using MediaEngine.Contracts.Review
@using MediaEngine.Web.Components.Settings.NeedsReview
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Navigation
@using MediaEngine.Web.Services.Theming
@inject IEngineApiClient Api
@inject ListEditLauncher EditLauncher
@inject EditorHost Editor
@inject DeviceContextService Device
@inject NavigationManager Nav
@inject IAppDialogService Dialogs
@inject DashboardSessionAccessor Session
@inject UniverseStateContainer State
@inject IStringLocalizer<SharedStrings> L
@inject ILogger<NeedsReviewPageContent> Logger

@* Settings, Needs Review (spec needs-review-redesign): ONE list for everything the Engine wants a person to look at, split by what the person
   must do: Ready to confirm, Choose a match, No match found, File problems. This host owns loading, the filters, the states and every action;
   the parts in NeedsReview/ draw the groups, rows, families and choices and ask this page (NeedsReviewActions) to act. Fix opens the pop-over
   editor over this list on Match. A finished row becomes one quiet line, a failed one shows its reason under it (no toasts). The list is for
   server administrators only; everyone else gets no list and no review-list request. Ticking rows (the parts draw the tick boxes) shows the
   action bar at the bottom; its buttons act on the ticked rows only, each through the same per-row action a single press uses. *@
<div @ref="_root" class="@PageClass" tabindex="-1" data-testid="needs-review" @onkeydown="OnKeyDown">
    @if (!CanViewReview)
    {
        <AppEmptyState Title="@L["NeedsReviewPageContent_NeedsReviewIsForServer"].Value"
                       Message="@L["NeedsReviewPageContent_AskAServerAdministratorTo"].Value" />
    }
    else if (_loading && !_model.HasRows)
    {
        <div class="needs-review-page__loading" role="status" aria-label="@L["NeedsReviewPage_Loading"].Value" data-testid="needs-review-loading">
            <AppSkeleton Width="180px" Height="18px" />
            <div class="needs-review-page__skeleton-list">
                @for (var placeholder = 0; placeholder < 3; placeholder++)
                {
                    <div class="needs-review-page__skeleton-row">
                        <AppSkeleton Width="44px" Height="64px" />
                        <div class="needs-review-page__skeleton-text">
                            <AppSkeleton Width="40%" Height="12px" />
                            <AppSkeleton Width="65%" Height="12px" />
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (_error is not null)
    {
        <AppAlert Tone="AppUiTone.Error">
            <span class="review-load-error">
                <span>@L["NeedsReviewPageContent_NeedsReviewCouldNotLoad"]</span>
                <AppButton Label="@L["Common_TryAgain"].Value" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Primary" Size="AppControlSize.Compact" OnClick="@(() => LoadAsync())" />
            </span>
        </AppAlert>
    }
    else if (!_model.HasRows && !HasFilter)
    {
        @ActionErrorAlert
        <div class="needs-review-page__empty" data-testid="needs-review-empty">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CheckCircle" Size="AppIconSize.Choice48" />
            <strong>@L["NeedsReviewPage_EmptyTitle"]</strong>
            <span>@L["NeedsReviewPage_EmptyMessage"]</span>
        </div>
        @KeptBlock
    }
    else
    {
        <div class="needs-review-page__summary" data-testid="needs-review-summary">
            <span class="needs-review-page__count">@SummaryText</span>
            <span class="needs-review-page__hint">@L["NeedsReviewPage_SummaryHint"]</span>
        </div>

        @if (ImportRemaining is { } remaining)
        {
            <div class="needs-review-page__note" data-testid="needs-review-importing">
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Info" Size="AppIconSize.Control20" />
                <span>@(remaining == 1 ? L["NeedsReviewPage_ImportingOne"].Value : L["NeedsReviewPage_Importing", remaining].Value)</span>
                <AppButton Label="@L["NeedsReviewPage_ViewActivity"].Value" ButtonStyle="AppButtonStyle.Text" Size="AppControlSize.Compact" Href="/settings/library-activity" />
            </div>
        }

        <AppFilterRow Class="needs-review-page__filters" AriaLabel="@L["NeedsReviewPageContent_NeedsReviewSearch"].Value">
            @if (_libraryOptions.Count > 2)
            {
                <AppSelect T="string"
                           Label="@L["NeedsReviewList_Library"].Value"
                           HideLabel="true"
                           Value="@(Library ?? AllLibrariesKey)"
                           ValueChanged="OnLibraryChanged"
                           Options="@_libraryOptions"
                           FullWidth="false" />
            }
            <div class="needs-review-page__search">
                <AppTextField Value="@_search"
                              ValueChanged="OnSearchChanged"
                              Label="@L["NeedsReviewPageContent_SearchItemsNeedingReview"].Value"
                              HideLabel="true"
                              Placeholder="@L["NeedsReviewPageContent_SearchItemsNeedingReview"].Value"
                              Adornment="AppAdornment.Start"
                              AdornmentIcon="@AppMaterialIcons.Outlined.Search" />
            </div>
        </AppFilterRow>

        @ActionErrorAlert

        @if (_model.MatchingRows(_search) == 0)
        {
            <div class="needs-review-page__nomatch" data-testid="needs-review-no-match">
                <strong>@NoMatchTitle</strong>
                <span>@StillNeedText</span>
            </div>
        }
        else
        {
            @foreach (var section in _model.Sections(_search))
            {
                <NeedsReviewGroupSection @key="section.Group" Section="@section" Model="@_model" Actions="@_actions" />
            }
        }

        @if (_model.HasMore)
        {
            <div class="needs-review-page__more">
                <AppButton Label="@L["Common_ShowMore"].Value" ButtonStyle="AppButtonStyle.Outlined" Disabled="@_busy" OnClick="LoadMoreAsync" />
            </div>
        }

        @KeptBlock

        <NeedsReviewActionBar Plan="@BarPlan"
                              Busy="@_barBusy"
                              OnUseSuggestions="UseSuggestionsAsync"
                              OnTryAgain="BarTryAgainAsync"
                              OnKeep="BarKeepAsync"
                              OnEdit="BarEditAsync"
                              OnDelete="BarDeleteAsync"
                              OnClear="ClearSelection" />
    }
</div>

@code {
    private const int PageSize = 500;
    private const string AllLibrariesKey = "all";

    [Parameter] public string? InitialSearch { get; set; }

    /// <summary>The Id of the library the list is narrowed to (<c>?library=</c>, from a library's "N need review" link); null shows every library.</summary>
    [Parameter] public string? Library { get; set; }

    private readonly NeedsReviewListModel _model = new();
    private readonly NeedsReviewListModel _keptModel = new();
    private readonly NeedsReviewSelection _selection = new();
    private readonly Dictionary<string, string> _libraryMediaTypes = new(StringComparer.OrdinalIgnoreCase);
    private NeedsReviewActions _actions = default!;
    private IReadOnlyList<AppSelectOption> _libraryOptions = [];
    private string? _search;
    private string? _error;
    private string? _actionError;
    private bool _loading = true;
    private bool _busy;
    private bool _initialized;
    private bool _disposed;
    private bool _awaitingFix;
    private bool _barBusy;
    private bool _deferCountRefresh;
    private EditorBinding? _editBinding;
    private bool _showKept;
    private string? _loadedInitialSearch;
    private string? _loadedLibrary;
    private int _loadGeneration;
    private int _keptGeneration;
    private ElementReference _root;
    private bool _focusAfterBarGone;

    // Same rule as the account menu's Needs Review entry and the shell badge (MainLayout.CanViewReview).
    private bool CanViewReview => Session.HasNavigation("settings.administration");

    // Deleting is for an administrator on a desktop, tablet or phone; the Engine checks again on every call.
    private bool CanRemove => LibraryItemDeletionFlow.CanDelete(Device, Session);

    private bool HasFilter => !string.IsNullOrWhiteSpace(Library) || !string.IsNullOrWhiteSpace(_search);

    private string SummaryText
    {
        get
        {
            var waiting = _model.WaitingTotal;
            return waiting == 1 ? L["NeedsReviewPage_SummaryOne"].Value : L["NeedsReviewPage_SummaryMany", waiting.ToString("N0")].Value;
        }
    }

    private string NoMatchTitle => string.IsNullOrWhiteSpace(_search)
        ? L["NeedsReviewPage_NoMatchFilter"].Value
        : L["NeedsReviewPage_NoMatchSearch", _search.Trim()].Value;

    // The search leaves nothing: how many items still wait. With a library chosen the Engine's list holds only that library, so the shell's
    // own number (every library) is the honest one.
    private string StillNeedText
    {
        get
        {
            var waiting = string.IsNullOrWhiteSpace(Library) ? _model.WaitingTotal : Math.Max(_model.WaitingTotal, Orchestrator.ReviewCount);
            return waiting == 1 ? L["NeedsReviewPage_StillNeedOne"].Value : L["NeedsReviewPage_StillNeedMany", waiting.ToString("N0")].Value;
        }
    }

    // The files Library is still working through, from the same queue snapshot the Activity page shows; null when nothing is being imported.
    private int? ImportRemaining =>
        State.IngestionQueueProgress is { } queue && IngestionQueueProgressText.IsWorking(queue) && queue.FilesFound - queue.FilesDone is > 0 and var remaining
            ? remaining
            : null;

    protected override void OnInitialized()
    {
        Orchestrator.OnLibraryItemsRemoved += OnLibraryItemsRemoved;
        _model.Changed += OnModelChanged;
        _keptModel.Changed += OnModelChanged;
        Editor.Closed += OnEditorClosed;
        State.IngestionQueueProgressReceived += OnQueueProgress;
        Device.OnChanged += OnDeviceChanged;
        _actions = new NeedsReviewActions
        {
            CanFix = entry => MayEdit && FixTargetOf(entry) is not null,
            CanDelete = row => row.Unmatched?.WorkId is not null && CanRemove,
            IsPhone = () => Device.IsPhone,
            LibraryMediaTypeOf = row => row.LibraryId is { } id ? _libraryMediaTypes.GetValueOrDefault(id) : null,
            Fix = Redraw<NeedsReviewEntry>(FixAsync),
            UseThis = Redraw<NeedsReviewRowDto>(UseThisAsync),
            Choose = (row, choice) => Redraw<NeedsReviewRowDto>(chosenRow => ChooseAsync(chosenRow, choice.Id, choice.Kind, choice.Title))(row),
            MoveToTv = Redraw<NeedsReviewRowDto>(MoveToTvAsync),
            KeepAsFilm = Redraw<NeedsReviewRowDto>(KeepAsFilmAsync),
            TryAgain = Redraw<IReadOnlyList<NeedsReviewRowDto>>(TryAgainAsync),
            Keep = Redraw<IReadOnlyList<NeedsReviewRowDto>>(KeepAsync),
            ShowInActivity = title =>
            {
                Nav.NavigateTo($"/settings/library-activity?q={Uri.EscapeDataString(title)}");
                return Task.CompletedTask;
            },
            Delete = Redraw<NeedsReviewRowDto>(DeleteAsync),
            PutBack = Redraw<NeedsReviewRowDto>(PutBackAsync),
            Selection = _selection,
            SetSelected = (rows, on) =>
            {
                _selection.Set(rows.Where(_model.IsWaiting).Select(row => row.Key), on);
                StateHasChanged();
            },
        };
    }

    // A row's button redraws that row only; the counts, groups and summary belong to this page, so every action ends by drawing the page again.
    private Func<T, Task> Redraw<T>(Func<T, Task> action) => async argument =>
    {
        try
        {
            await action(argument);
        }
        finally
        {
            if (!_disposed)
            {
                PruneSelection();
                StateHasChanged();
            }
        }
    };

    // The pop-over Fix opened over this list closed: when it saved or matched something, the list is read again so the fixed row leaves
    // (or shows its new state) without the person being taken away from the list.
    private void OnEditorClosed(EditorClosedEventArgs closed)
    {
        if (!_awaitingFix)
        {
            return;
        }

        _awaitingFix = false;
        if (closed.Changed && !_disposed)
        {
            _ = InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
    }

    // Titles deleted from the library close their Needs Review items: reload so they leave the list.
    private void OnLibraryItemsRemoved(MediaEngine.Contracts.Realtime.LibraryItemsRemovedEvent ev) =>
        _ = InvokeAsync(async () =>
        {
            if (_disposed || !_initialized) return;
            await LoadAsync();
            StateHasChanged();
        });

    // A row began, finished or failed an action: every part that shows its state (a family header, the counts) is drawn again at once.
    private void OnModelChanged() =>
        _ = InvokeAsync(() =>
        {
            if (!_disposed) StateHasChanged();
        });

    private void OnQueueProgress(MediaEngine.Contracts.Ingestion.IngestionQueueProgressDto snapshot) =>
        _ = InvokeAsync(() =>
        {
            if (!_disposed) StateHasChanged();
        });

    private void OnDeviceChanged() =>
        _ = InvokeAsync(() =>
        {
            if (!_disposed) StateHasChanged();
        });

    public void Dispose()
    {
        _disposed = true;
        Orchestrator.OnLibraryItemsRemoved -= OnLibraryItemsRemoved;
        _model.Changed -= OnModelChanged;
        _keptModel.Changed -= OnModelChanged;
        Editor.Closed -= OnEditorClosed;
        State.IngestionQueueProgressReceived -= OnQueueProgress;
        Device.OnChanged -= OnDeviceChanged;
        if (_editBinding is { } binding)
        {
            Editor.Unbind(binding);
        }
    }

    // When the action bar has gone (its close button, Escape, or a bar action that finished every ticked row) the focused control left the page
    // with it, so focus moves to the list region instead of falling back to the top of the document.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusAfterBarGone)
        {
            return;
        }

        _focusAfterBarGone = false;
        if (_disposed || _selection.Count > 0)
        {
            return;
        }

        try
        {
            await _root.FocusAsync(preventScroll: true);
        }
        catch (Microsoft.JSInterop.JSDisconnectedException ex)
        {
            Logger.LogDebug(ex, "The Needs Review list could not take focus because the browser connection is gone.");
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogDebug(ex, "The Needs Review list could not take focus before the page was ready.");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var searchChanged = !string.Equals(_loadedInitialSearch, InitialSearch, StringComparison.Ordinal);
        _loadedInitialSearch = InitialSearch;
        var filterChanged = _initialized && !string.Equals(_loadedLibrary, Library, StringComparison.Ordinal);
        _loadedLibrary = Library;

        if (!_initialized)
        {
            _initialized = true;
            _search = InitialSearch;
            await LoadAsync(keepFinished: false);
            return;
        }

        if (searchChanged) _search = InitialSearch;
        if (filterChanged)
        {
            // Another library is another list: nothing stays ticked from the old one.
            _selection.Clear();
            await LoadAsync(keepFinished: false);
        }
    }

    // Reads the list again. A finished row's line stays until the page is left (spec D8), so a reload keeps them; the first load and a
    // changed library start clean. Only the newest answer is applied: an older one that arrives late is dropped.
    private async Task LoadAsync(bool keepFinished = true)
    {
        if (!CanViewReview)
        {
            // Nothing is requested and nothing is shown: the list is for server administrators only.
            _error = null;
            _loading = false;
            return;
        }

        var generation = ++_loadGeneration;
        _loading = true;
        _actionError = null;
        try
        {
            await ResolveLibrariesAsync();
            var attempt = await Orchestrator.GetNeedsReviewListAsync(Library, 0, PageSize);
            if (generation != _loadGeneration)
            {
                return;
            }

            if (attempt.List is { } page)
            {
                _model.Replace(page, keepFinished);
                PruneSelection();
                _error = null;
                await Orchestrator.RefreshReviewCountAsync();
                if (_showKept)
                {
                    await LoadKeptAsync(keepFinished);
                }
            }
            else
            {
                // A failed load is never shown as an empty list.
                _error = attempt.Error ?? L["NeedsReviewPage_NoListReturned"].Value;
            }
        }
        finally
        {
            if (generation == _loadGeneration)
            {
                _loading = false;
            }
        }
    }

    // The next page starts after the rows still waiting (a finished row is no longer in the Engine's list); an answer that arrives after a
    // newer load began is dropped.
    private async Task LoadMoreAsync()
    {
        var generation = _loadGeneration;
        _busy = true;
        try
        {
            var attempt = await Orchestrator.GetNeedsReviewListAsync(Library, _model.WaitingRead, PageSize);
            if (generation != _loadGeneration)
            {
                return;
            }

            if (attempt.List is { } page) _model.Append(page);
            else _actionError = L["NeedsReviewList_MoreCouldNotBeLoaded"].Value;
        }
        finally { _busy = false; }
    }

    // The library choices come from the configured libraries; the Vault is never named outside its own area. Each library's media type
    // names the kind of the files in it that the Engine could not match (those have no type of their own).
    private async Task ResolveLibrariesAsync()
    {
        try
        {
            var configuration = await Orchestrator.GetLibrariesAsync();
            var options = new List<AppSelectOption> { new(AllLibrariesKey, L["NeedsReviewList_AllLibraries"].Value) };
            var listed = (configuration?.Libraries ?? []).Where(library => !library.IsVault).ToList();
            options.AddRange(listed.Select(library => new AppSelectOption(library.Id, library.Name)));
            _libraryOptions = options;
            _libraryMediaTypes.Clear();
            foreach (var library in listed.Where(library => library.MediaTypes.Count == 1))
            {
                _libraryMediaTypes[library.Id] = library.MediaTypes[0];
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The libraries could not be read for the Needs Review library choices.");
            _libraryOptions = [];
        }
    }

    // A refusal or a failed read (the kept items, the next page, Edit) that has no row to sit under; drawn with the list and with the empty page.
    private RenderFragment ActionErrorAlert => __builder =>
    {
        if (_actionError is not null)
        {
            <AppAlert Tone="AppUiTone.Warning" Dense="true" ShowCloseIcon="true" CloseIconClicked="@(() => { _actionError = null; })" data-review-load-more-failure>@_actionError</AppAlert>
        }
    };

    private RenderFragment KeptBlock => __builder =>
    {
        <NeedsReviewKeptBlock Total="@_model.KeptTotal" Open="@_showKept" OnToggle="ToggleKeptAsync" Model="@_keptModel" Section="@KeptSection()" Actions="@_actions" />
    };

    // The search narrows what is on screen, and a row that is no longer shown is no longer ticked (the bar must not act on what cannot be seen).
    private Task OnSearchChanged(string? value)
    {
        _search = value;
        PruneSelection();
        return Task.CompletedTask;
    }

    private void OnLibraryChanged(string? library) =>
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("library", string.IsNullOrEmpty(library) || library == AllLibrariesKey ? null : library), replace: true);

    // ---- The kept items (spec D7) ---------------------------------------------------------------------------------------------------------

    private async Task ToggleKeptAsync()
    {
        _showKept = !_showKept;
        if (_showKept)
        {
            await LoadKeptAsync();
        }
    }

    // The newest answer wins here too: opening, a Keep and a Put back may each ask while an earlier read is still on its way.
    private async Task LoadKeptAsync(bool keepFinished = true)
    {
        var generation = ++_keptGeneration;
        var attempt = await Orchestrator.GetNeedsReviewListAsync(Library, 0, PageSize, kept: true);
        if (generation != _keptGeneration)
        {
            return;
        }

        if (attempt.List is { } page)
        {
            _keptModel.Replace(page, keepFinished);
        }
        else
        {
            _actionError = L["NeedsReviewPage_KeptCouldNotBeLoaded"].Value;
        }
    }

    // Items just kept leave the list and join the hidden ones: the count rises at once and the open kept list is read again.
    private async Task NoteKeptAsync(int count)
    {
        if (count == 0)
        {
            return;
        }

        _model.NoteKept(count);
        if (_showKept)
        {
            await LoadKeptAsync();
        }
    }

    private NeedsReviewSection KeptSection() =>
        new("kept", _keptModel.Rows.Select(row => new NeedsReviewEntry(row.Key, [row])).ToList(), _keptModel.Rows.Count);

    // ---- What a row says and what Fix opens -------------------------------------------------------------------------------------------------

    private string TitleOf(NeedsReviewRowDto row) => NeedsReviewRowInfo.TitleOf(row, L["NeedsReviewRow_UnknownTitle"].Value);

    private static Guid? FixTargetOf(NeedsReviewEntry entry) =>
        entry.IsFamily ? entry.First.FamilyWorkId : NeedsReviewRowInfo.FixTargetOf(entry.First);

    // What several rows are called in a finished or failed line: the row's title, the family's title, or how many items.
    private string SubjectOf(IReadOnlyList<NeedsReviewRowDto> rows)
    {
        if (rows.Count == 1)
        {
            return TitleOf(rows[0]);
        }

        var family = rows[0].FamilyTitle;
        return !string.IsNullOrWhiteSpace(family) && rows.All(row => row.FamilyKey == rows[0].FamilyKey)
            ? family
            : L["NeedsReviewRow_SubjectMany", rows.Count].Value;
    }

    // Edit and Fix need a device that may edit items and a profile the Engine says may edit item details; the Engine still checks every save.
    private bool MayEdit => EditorDeviceRule.CanEditItems(Device, Session);

    // ---- Actions ----------------------------------------------------------------------------------------------------------------------

    // Fix opens the pop-over editor over this list, on Match (universal editor v3 D6, D9): the same Match, Review changes and Save as
    // everywhere else, and no navigation away. A family opens its show, album or Series. The Engine's own answer says whether this item may
    // be edited.
    private async Task FixAsync(NeedsReviewEntry entry)
    {
        if (FixTargetOf(entry) is not { } entityId) return;
        // Fix is offered only on a device and to a profile that may edit; a handler never trusts that.
        if (EditorDeviceRule.ItemRefusal(Device, Session) is { } refusal)
        {
            _model.Fail(entry.First, refusal);
            return;
        }

        var first = entry.First;
        var title = entry.IsFamily && !string.IsNullOrWhiteSpace(first.FamilyTitle) ? first.FamilyTitle : TitleOf(first);
        var mediaType = NeedsReviewRowInfo.MediaTypeOf(first, first.LibraryId is { } id ? _libraryMediaTypes.GetValueOrDefault(id) : null);
        _awaitingFix = true;
        var target = ListEditTarget.ForLibraryRow(entityId, title, mediaType);
        // A delete that closes the editor leaves its line (the title is gone, files may be left on disk) as a finished line in place of the row.
        if (!await EditLauncher.OpenAsync(target, EditTool.Match, notice => InvokeAsync(() =>
            {
                foreach (var row in entry.Rows)
                {
                    _model.Finish(row, notice);
                }

                StateHasChanged();
            })))
        {
            _awaitingFix = false;
            if (EditLauncher.LastNotice is { } why) _model.Fail(first, why);
        }
    }

    // Use this runs the one action the Engine offered as the row's best guess.
    private async Task UseThisAsync(NeedsReviewRowDto row)
    {
        if (row.Review is not { } review || row.BestGuess is not { } guess) return;
        var name = string.IsNullOrWhiteSpace(guess.Year) ? guess.Name : $"{guess.Name} ({guess.Year})";
        switch (guess.Action)
        {
            case "move_to_tv":
                await MoveToTvAsync(row);
                break;
            case "use_retail_match" when !string.IsNullOrWhiteSpace(guess.ChoiceId):
                await ChooseAsync(row, guess.ChoiceId, NeedsReviewChoiceKinds.Retail, name);
                break;
            case "confirm_match":
                // The person says yes to the match the Engine already linked: the review is resolved by them, and the match is not changed.
                await RunOneAsync(row, async () => (await Orchestrator.ResolveReviewAsync(review.Id, new MediaEngine.Web.Models.ViewDTOs.ReviewResolveRequestDto(), refreshCount: !_deferCountRefresh), null),
                    L["NeedsReviewRow_DoneMatched", TitleOf(row), name].Value, L["NeedsReviewRow_FailMatch", TitleOf(row)].Value);
                break;
            case "keep_provider_match":
                await RunOneAsync(row, async () => (await Orchestrator.SkipUniverseAsync(review.Id, refreshCount: !_deferCountRefresh), null),
                    L["NeedsReviewRow_DoneMatched", TitleOf(row), name].Value, L["NeedsReviewRow_FailMatch", TitleOf(row)].Value);
                break;
            default:
                // An action this page does not know (or a retail match with no choice to apply) makes no Engine call: the row says it could not be matched.
                Logger.LogWarning("The Needs Review best guess action {Action} on {Key} is not one this page can run.", guess.Action, row.Key);
                if (CanAct(row))
                {
                    _model.Fail(row, L["NeedsReviewRow_FailMatch", TitleOf(row)].Value);
                }

                break;
        }
    }

    // One of the Engine's own choices: the Engine applies it exactly as the editor's Match would, and the row finishes in place.
    private async Task ChooseAsync(NeedsReviewRowDto row, string choiceId, string kind, string chosen)
    {
        if (row.Review is not { } review) return;
        var done = kind switch
        {
            NeedsReviewChoiceKinds.Series => L["NeedsReviewRow_DoneSeries", TitleOf(row), chosen].Value,
            NeedsReviewChoiceKinds.MediaType => L["NeedsReviewRow_DoneMediaType", TitleOf(row), chosen].Value,
            _ => L["NeedsReviewRow_DoneMatched", TitleOf(row), chosen].Value,
        };
        var fail = kind == NeedsReviewChoiceKinds.Retail
            ? L["NeedsReviewRow_FailMatch", TitleOf(row)].Value
            : L["NeedsReviewRow_FailChoose", TitleOf(row)].Value;
        await RunOneAsync(row, async () =>
            {
                var attempt = await Orchestrator.ChooseReviewAsync(review.Id, choiceId, refreshCount: !_deferCountRefresh);
                return (attempt.Succeeded, attempt.Error);
            },
            done, fail);
    }

    private async Task MoveToTvAsync(NeedsReviewRowDto row)
    {
        if (row.Review is not { } review) return;
        await RunOneAsync(row, async () =>
            {
                var attempt = await Orchestrator.MoveReviewToTvAsync(review.Id, refreshCount: !_deferCountRefresh);
                return (attempt.Response is not null, attempt.Error);
            },
            L["NeedsReviewRow_DoneMovedToTv", TitleOf(row)].Value, L["NeedsReviewRow_FailMoveToTv", TitleOf(row)].Value);
    }

    private async Task KeepAsFilmAsync(NeedsReviewRowDto row)
    {
        if (row.Review is not { } review) return;
        var done = await RunOneAsync(row, async () => (await Orchestrator.DismissReviewAsync(review.Id, refreshCount: !_deferCountRefresh), null),
            L["NeedsReviewRow_DoneKept", TitleOf(row)].Value, L["NeedsReviewRow_FailKeep", TitleOf(row)].Value);
        if (done) await NoteKeptAsync(1);
    }

    // Try again: a file is looked up now; a file whose tags could not be saved is handed to the Engine's re-tag sweep again.
    private Task TryAgainAsync(IReadOnlyList<NeedsReviewRowDto> rows) =>
        RunManyAsync(rows, async row => row.Unmatched is { } file
            ? (await Api.RetryUnmatchedItemAsync(file.AssetId) is not null, null)
            : (NeedsReviewRowInfo.IsWritebackRetry(row) && await Orchestrator.RetryRetagForAssetAsync(row.Review!.EntityId), null),
            subject => L["NeedsReviewRow_DoneRetry", subject].Value,
            subject => L["NeedsReviewRow_FailRetry", subject].Value);

    // Keep as it is stops a file's retries; for an item the Engine was unsure about it records that the person chose to leave it as it is.
    private async Task KeepAsync(IReadOnlyList<NeedsReviewRowDto> rows)
    {
        var kept = await RunManyAsync(rows, async row => row.Unmatched is { } file
            ? (await Api.KeepUnmatchedItemAsync(file.AssetId) is not null, null)
            : (row.Review is { } review && await Orchestrator.DismissReviewAsync(review.Id, refreshCount: !_deferCountRefresh), null),
            subject => rows.Count == 1 ? L["NeedsReviewRow_DoneKept", subject].Value : L["NeedsReviewRow_DoneKeptMany", subject].Value,
            subject => L["NeedsReviewRow_FailKeep", subject].Value);
        await NoteKeptAsync(kept.Count);
    }

    // Delete takes the file out through the same Delete from library dialog as any title (with the Recycle bin on for the library's type,
    // the file goes there). It asks once, and the row becomes a "deleted" line.
    private async Task DeleteAsync(NeedsReviewRowDto row)
    {
        if (row.Unmatched is not { WorkId: { } workId } file || !CanAct(row)) return;
        if (LibraryItemDeletionFlow.Refusal(Device, Session) is { } refusal) { _model.Fail(row, refusal); return; }
        _model.SetBusy(row, true);
        try
        {
            var result = await LibraryItemDeletionFlow.RunAsync(Dialogs, [workId], file.FileName);
            if (result.Outcome != LibraryItemDeletionFlowOutcome.Canceled)
            {
                var line = L["NeedsReviewRow_DoneDeleted", TitleOf(row)].Value;
                _model.Finish(row, result.Notice is { Length: > 0 } notice ? $"{line} {notice}" : line);
                await Orchestrator.RefreshReviewCountAsync();
            }
            else
            {
                _model.SetBusy(row, false);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Deleting the Needs Review item {Key} failed.", row.Key);
            _model.Fail(row, $"{L["NeedsReviewRow_FailDelete", TitleOf(row)].Value} {ex.Message}");
        }
    }

    // Put back: a kept item waits in Needs Review again, then both lists are read again.
    private async Task PutBackAsync(NeedsReviewRowDto row)
    {
        if (_keptModel.IsBusy(row)) return;
        var title = TitleOf(row);
        _keptModel.SetBusy(row, true);
        try
        {
            var ok = row.Unmatched is { } file
                ? await Api.UnkeepUnmatchedItemAsync(file.AssetId) is not null
                : row.Review is { } review && await Orchestrator.ReopenReviewAsync(review.Id);
            if (ok)
            {
                await LoadAsync();
            }
            else
            {
                _keptModel.Fail(row, $"{L["NeedsReviewRow_FailPutBack", title].Value} {L["NeedsReviewRow_TryAgainInAMoment"].Value}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Putting the kept Needs Review item {Key} back failed.", row.Key);
            _keptModel.Fail(row, $"{L["NeedsReviewRow_FailPutBack", title].Value} {ex.Message}");
        }
    }

    // One row, one action: busy while it runs, then one quiet line (success) or the reason under the row (failure). True when it finished.
    private async Task<bool> RunOneAsync(NeedsReviewRowDto row, Func<Task<(bool Ok, string? Reason)>> action, string doneLine, string failLine) =>
        (await RunManyAsync([row], _ => action(), _ => doneLine, _ => failLine)).Count == 1;

    // A row that is already working on an action, or has finished, takes no second one: a press on its menu, a bar button or a family
    // button that reaches it again does nothing.
    private bool CanAct(NeedsReviewRowDto row) => _model.IsWaiting(row) && !_model.IsBusy(row);

    // Rows act one after another. When all succeed they share one line named for the group (a family); when some fail, those rows keep
    // their reason and the others finish under their own names. Returns the rows that finished.
    private async Task<IReadOnlyList<NeedsReviewRowDto>> RunManyAsync(
        IReadOnlyList<NeedsReviewRowDto> requested,
        Func<NeedsReviewRowDto, Task<(bool Ok, string? Reason)>> action,
        Func<string, string> doneLine,
        Func<string, string> failLine)
    {
        var rows = requested.Where(CanAct).ToList();
        if (rows.Count == 0)
        {
            return [];
        }

        foreach (var row in rows)
        {
            _model.SetBusy(row, true);
        }

        var succeeded = new List<NeedsReviewRowDto>();
        var failed = new List<(NeedsReviewRowDto Row, string? Reason)>();
        foreach (var row in rows)
        {
            try
            {
                var (ok, reason) = await action(row);
                if (ok) succeeded.Add(row);
                else failed.Add((row, reason));
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "A Needs Review action on {Key} failed.", row.Key);
                failed.Add((row, ex.Message));
            }
        }

        var allOk = failed.Count == 0;
        foreach (var row in succeeded)
        {
            _model.Finish(row, doneLine(allOk ? SubjectOf(rows) : TitleOf(row)));
        }

        foreach (var (row, reason) in failed)
        {
            var sentence = failLine(TitleOf(row));
            _model.Fail(row, $"{sentence} {(string.IsNullOrWhiteSpace(reason) ? L["NeedsReviewRow_TryAgainInAMoment"].Value : reason)}");
        }

        // An action bar run refreshes the count once at its end instead of after every row.
        if (succeeded.Count > 0 && !_deferCountRefresh)
        {
            await Orchestrator.RefreshReviewCountAsync();
        }

        return succeeded;
    }

    // ---- Ticking and the action bar (spec WP5) --------------------------------------------------------------------------------------------

    private string PageClass => _selection.Count > 0 ? "needs-review-page needs-review-page--selecting" : "needs-review-page";

    private IReadOnlyList<NeedsReviewTicked> Ticked => _selection.Count == 0 ? [] : _model.TickedEntries(_selection, _search);

    // The ticked rows an action could start on right now: a row that is already working on an action is left out, so a count, a confirm
    // dialog and a button only ever speak of rows that will really be acted on.
    private IReadOnlyList<NeedsReviewTicked> Actable => [.. Ticked
        .Select(item =>
        {
            var rows = item.Rows.Where(CanAct).ToList();
            return rows.Count == item.Rows.Count ? item : new NeedsReviewTicked(item.Entry, rows, false);
        })
        .Where(item => item.Rows.Count > 0)];

    // "N selected" counts every ticked row (a busy one is still ticked); the buttons count only what they will act on. While a bar run is
    // going its own rows are busy, so the buttons keep the plan they started with (they are disabled) instead of vanishing mid-run.
    private NeedsReviewBarPlan BarPlan => _selection.Count == 0
        ? NeedsReviewBarPlan.Empty
        : NeedsReviewBulk.PlanFor(_barBusy ? Ticked : Actable, MayEdit, _actions.CanDelete) with { Selected = Ticked.Sum(item => item.Rows.Count) };

    // Only rows that are still waiting and still shown stay ticked: a finished row, a row the search hides and a row that left the list lose their tick.
    private void PruneSelection()
    {
        if (_selection.Count > 0)
        {
            var allowed = _model.TickableKeys(_search);
            _selection.Retain(allowed.Contains);
        }
    }

    private void ClearSelection()
    {
        var hadSelection = _selection.Count > 0;
        _selection.Clear();
        _focusAfterBarGone |= hadSelection;
    }

    // Escape clears the selection (the bar goes with it). A row's "..." menu and its phone sheet keep their own Escape: the row stops the key
    // there (NeedsReviewRow), so closing a menu never also clears the ticks.
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            ClearSelection();
        }
    }

    // One bar button at a time. Each row's own done or failure line is drawn as it finishes; the review count is read once at the end.
    private async Task RunBarAsync(Func<Task> work)
    {
        if (_barBusy)
        {
            return;
        }

        _barBusy = true;
        _deferCountRefresh = true;
        _actionError = null;
        var hadSelection = _selection.Count > 0;
        try
        {
            await work();
        }
        finally
        {
            _deferCountRefresh = false;
            _barBusy = false;
            if (!_disposed)
            {
                // One count refresh for the whole run, also when the run stopped part way.
                await Orchestrator.RefreshReviewCountAsync();
                PruneSelection();
                _focusAfterBarGone |= hadSelection && _selection.Count == 0;
                StateHasChanged();
            }
        }
    }

    // Use suggestions: says how many rows it will change, asks once, then applies each ticked row's one suggestion through the same code as its
    // own Use this. Ticked rows without exactly one suggestion are skipped and stay ticked.
    private async Task UseSuggestionsAsync()
    {
        var rows = NeedsReviewBulk.SuggestionRows(Actable);
        if (_barBusy || rows.Count == 0)
        {
            return;
        }

        var answer = await AppConfirmDialog.ShowAsync(
            Dialogs,
            L["NeedsReviewBar_UseTitle"].Value,
            rows.Count == 1 ? L["NeedsReviewBar_UseMessageOne"].Value : L["NeedsReviewBar_UseMessageMany", rows.Count].Value,
            L["NeedsReviewBar_UseConfirm"].Value,
            L["NeedsReviewBar_Cancel"].Value);
        if (answer != AppConfirmResult.Primary)
        {
            return;
        }

        await RunBarAsync(async () =>
        {
            foreach (var row in rows.Where(_model.IsWaiting))
            {
                await UseThisAsync(row);
                StateHasChanged();
            }
        });
    }

    private async Task BarTryAgainAsync()
    {
        var groups = NeedsReviewBulk.TryAgainGroups(Actable);
        if (_barBusy || groups.Count == 0)
        {
            return;
        }

        await RunBarAsync(async () =>
        {
            foreach (var group in groups)
            {
                await TryAgainAsync(group);
                StateHasChanged();
            }
        });
    }

    // Keep as they are asks once, like the old "Keep all" did, then keeps each ticked row (a family whose files are all ticked as one line).
    private async Task BarKeepAsync()
    {
        var groups = NeedsReviewBulk.KeepGroups(Actable);
        var count = groups.Sum(group => group.Count);
        if (_barBusy || count == 0)
        {
            return;
        }

        var answer = await AppConfirmDialog.ShowAsync(
            Dialogs,
            count == 1 ? L["NeedsReviewBar_KeepTitleOne"].Value : L["NeedsReviewBar_KeepTitleMany", count].Value,
            count == 1 ? L["NeedsReviewBar_KeepMessageOne"].Value : L["NeedsReviewBar_KeepMessageMany"].Value,
            L["NeedsReviewBar_KeepConfirm"].Value,
            L["NeedsReviewBar_Cancel"].Value);
        if (answer != AppConfirmResult.Primary)
        {
            return;
        }

        await RunBarAsync(async () =>
        {
            foreach (var group in groups)
            {
                await KeepAsync(group);
                StateHasChanged();
            }
        });
    }

    // Edit N items: the same pop-over window other lists open for ticked rows ("Edit N items"), over this page. Nothing here changes until Save
    // changes there; the list is read again when the window closes after a save.
    private async Task BarEditAsync()
    {
        var rows = NeedsReviewBulk.EditRows(Actable, MayEdit);
        if (_barBusy || rows.Count == 0)
        {
            return;
        }

        _actionError = null;
        var editRows = rows
            .Select(row => new BulkEditRow(
                NeedsReviewRowInfo.FixTargetOf(row)!.Value,
                TitleOf(row),
                DetailEntityType.Work,
                MediaType: ListEditLauncher.NormalizeMediaType(NeedsReviewRowInfo.MediaTypeOf(row, row.LibraryId is { } id ? _libraryMediaTypes.GetValueOrDefault(id) : null)),
                ImageUrl: row.CoverUrl))
            .DistinctBy(row => row.Id)
            .ToList();
        var mediaTypes = editRows.Select(row => row.MediaType).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        var binding = EditLauncher.BindRows(mediaTypes.Count == 1 ? mediaTypes[0] : null, () => editRows, () =>
        {
            Editor.Batch.NotifySaved();
            return Task.CompletedTask;
        });
        _editBinding = binding;
        _awaitingFix = true;
        if (!await Editor.OpenAsync(binding, binding.EntityId, EditTool.Details) || !Editor.IsOpen)
        {
            _awaitingFix = false;
            _actionError = EditorDeviceRule.ItemRefusal(Device, Session) ?? L["NeedsReviewBar_EditUnavailable"].Value;
            return;
        }

        Editor.Batch.Replace(editRows);
        Editor.Batch.OpenPanel(BulkPanelKind.Edit);
    }

    // Delete asks once for all ticked rows (the shared Delete from library dialog), then each row becomes a "deleted" line.
    private async Task BarDeleteAsync()
    {
        var rows = NeedsReviewBulk.DeleteRows(Actable, _actions.CanDelete).ToList();
        if (_barBusy || rows.Count == 0)
        {
            return;
        }

        if (LibraryItemDeletionFlow.Refusal(Device, Session) is { } refusal)
        {
            _actionError = refusal;
            return;
        }

        await RunBarAsync(async () =>
        {
            foreach (var row in rows)
            {
                _model.SetBusy(row, true);
            }

            StateHasChanged();
            try
            {
                var workIds = rows.Select(row => row.Unmatched!.WorkId!.Value).Distinct().ToList();
                var result = await LibraryItemDeletionFlow.RunAsync(Dialogs, workIds, rows.Count == 1 ? rows[0].Unmatched!.FileName : null);
                if (result.Outcome == LibraryItemDeletionFlowOutcome.Canceled)
                {
                    foreach (var row in rows)
                    {
                        _model.SetBusy(row, false);
                    }

                    return;
                }

                for (var index = 0; index < rows.Count; index++)
                {
                    var line = L["NeedsReviewRow_DoneDeleted", TitleOf(rows[index])].Value;
                    _model.Finish(rows[index], index == 0 && result.Notice is { Length: > 0 } notice ? $"{line} {notice}" : line);
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Deleting {Count} ticked Needs Review items failed.", rows.Count);
                foreach (var row in rows)
                {
                    _model.Fail(row, $"{L["NeedsReviewRow_FailDelete", TitleOf(row)].Value} {ex.Message}");
                }
            }
        });
    }
}
