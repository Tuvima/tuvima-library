@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Web.Services.Integration
@inject DashboardIdentityClient Identity
@inject DashboardSessionAccessor Session
@inject IReadOnlyList<RegisteredExternalAuthProvider> ExternalProviders
@inject IJSRuntime JS
@inject IAppToastService Snackbar
@inject IAppDialogService DialogService
@implements IAsyncDisposable

<div class="tl-page account-security-settings" aria-busy="@_accountLoading">
    @if (_accountLoading)
    {
        <div class="account-security-settings__content" aria-label="Loading account security">
            <AppSkeleton Height="112px" Animation="Animation.Wave" />
            <AppSkeleton Height="170px" Animation="Animation.Wave" />
            <AppSkeleton Height="140px" Animation="Animation.Wave" />
        </div>
    }
    else if (_account is null)
    {
        <AppPageState Kind="AppPageStateKind.Error"
                      Icon="@AppMaterialIcons.Outlined.CloudOff"
                      Title="Account security is unavailable"
                      Message="Tuvima Library could not load your account identity. Your security settings have not been changed." />
    }
    else
    {
        <div class="account-security-settings__content">
            <SettingsSectionPanel Title="Account security overview"
                                  Description="Your account identity and attached sign-in methods."
                                  Icon="@AppMaterialIcons.Outlined.ManageAccounts"
                                  Class="tl-card settings-section-card settings-section-card--dense account-security-settings__overview-card">
                <div class="account-security-settings__overview">
                    <div class="account-security-settings__identity">
                        <span class="account-security-settings__identity-icon" aria-hidden="true">
                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.PersonOutline" />
                        </span>
                        <div>
                            <strong>@AccountEmail</strong>
                            <span>@(_account.IsLocalOnly ? "Local profile account" : "Tuvima Library account")</span>
                        </div>
                    </div>
                    <div class="account-security-settings__methods">
                        <span class="account-security-settings__label">Sign-in methods</span>
                        <div class="account-security-settings__method-list">
                            @if (_account.AuthenticationMethods.Count == 0)
                            {
                                <span class="account-security-settings__availability">No attached sign-in methods</span>
                            }
                            @foreach (var method in _account.AuthenticationMethods)
                            {
                                <span class="account-security-settings__method">@FormatAuthenticationMethod(method)</span>
                            }
                        </div>
                    </div>
                </div>
            </SettingsSectionPanel>

            @if (Capabilities.HasPassword)
            {
                <SettingsSectionPanel Title="Password"
                                      Description="Change your password while keeping this device signed in."
                                      Icon="@AppMaterialIcons.Outlined.Password">
                    @if (_passwordChanged)
                    {
                        <AppAlert Tone="AppUiTone.Success" Class="mb-4" aria-live="polite">
                            Password changed successfully. Other signed-in sessions have been revoked.
                        </AppAlert>
                    }
                    <div class="account-security-settings__password-grid">
                        <AppTextField T="string" @bind-Value="_currentPassword" Label="Current password"
                                      InputType="AppInputType.Password" autocomplete="current-password" />
                        <AppTextField T="string" @bind-Value="_newPassword" Label="New password"
                                      InputType="AppInputType.Password" autocomplete="new-password" MaxLength="128"
                                      Error="@(_newPassword.Length > 0 && !NewPasswordValid)"
                                      ErrorText="Use 8 to 128 characters." HelpText="Use 8 to 128 characters." />
                        <AppTextField T="string" @bind-Value="_confirmPassword" Label="Confirm new password"
                                      InputType="AppInputType.Password" autocomplete="new-password" MaxLength="128"
                                      Error="@(_confirmPassword.Length > 0 && !PasswordsMatch)"
                                      ErrorText="Passwords do not match." />
                        <div class="app-field account-security-settings__field-action">
                            <span class="app-field__label" aria-hidden="true">Action</span>
                            <AppButton Label="Change password" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary"
                                       Loading="@_changingPassword" Disabled="@(!CanChangePassword)" OnClick="ChangePasswordAsync" />
                        </div>
                    </div>
                </SettingsSectionPanel>
            }

            @if (ShowPasskeys)
            {
                <SettingsSectionPanel Title="Passkeys"
                                      Description="Use Windows Hello, Touch ID, Face ID, or a password manager for secure sign-in."
                                      Icon="@AppMaterialIcons.Outlined.Fingerprint">
                    @if (_passkeysLoading)
                    {
                        <AppSkeleton Height="72px" Animation="Animation.Wave" aria-label="Loading passkeys" />
                    }
                    else if (_passkeysError is not null)
                    {
                        <AppAlert Tone="AppUiTone.Error">@_passkeysError</AppAlert>
                    }
                    else if (_passkeys.Count == 0)
                    {
                        <AppEmptyState Class="app-page-state--compact"
                                       Title="No passkeys added yet"
                                       Message="Use a passkey to sign in securely without entering your password." />
                    }
                    else
                    {
                        <div class="account-security-settings__rows">
                            @foreach (var passkey in _passkeys)
                            {
                                <div class="account-security-settings__row" @key="passkey.CredentialId">
                                    <div><strong>@passkey.Name</strong><span>Added @FormatDate(passkey.CreatedAt)@BackupStatus(passkey)</span></div>
                                    <AppButton Label="Remove" Size="AppControlSize.Compact" Tone="AppUiTone.Error"
                                               Disabled="@_busy" OnClick="@(() => RemovePasskeyAsync(passkey))" />
                                </div>
                            }
                        </div>
                    }
                    <div class="account-security-settings__actions">
                        <AppButton Label="@(_registeringPasskey ? "Waiting for device…" : "Add passkey")"
                                   StartIcon="@AppMaterialIcons.Outlined.Add" Loading="@_registeringPasskey"
                                   Disabled="@(_busy || !Capabilities.CanRegisterPasskey)"
                                   OnClick="RegisterPasskeyAsync"
                                   aria-describedby="@(!Capabilities.CanRegisterPasskey ? "passkey-unavailable" : null)" />
                    </div>
                    @if (!Capabilities.CanRegisterPasskey)
                    {
                        <p id="passkey-unavailable" class="account-security-settings__availability">@PasskeyUnavailableMessage</p>
                    }
                </SettingsSectionPanel>
            }

            @if (ShowLinkedAccounts)
            {
                <SettingsSectionPanel Title="Linked accounts" Description="Use another account to sign in to Tuvima Library."
                                      Icon="@AppMaterialIcons.Outlined.Link">
                    @if (_loginsLoading)
                    {
                        <AppSkeleton Height="88px" Animation="Animation.Wave" aria-label="Loading linked accounts" />
                    }
                    else if (_loginsError is not null)
                    {
                        <AppAlert Tone="AppUiTone.Error">@_loginsError</AppAlert>
                    }
                    else
                    {
                        <div class="account-security-settings__rows">
                            @foreach (var provider in AvailableProviders)
                            {
                                var login = FindLogin(provider.Id);
                                <div class="account-security-settings__row" @key="provider.Id">
                                    <div><strong>@provider.DisplayName</strong><span>@(login is null ? "Not linked" : LoginDescription(login))</span></div>
                                    @if (login is null)
                                    {
                                        <AppButton Href="@($"/account/security/external/{Uri.EscapeDataString(provider.Id)}")"
                                                   Label="Link account" Size="AppControlSize.Compact" />
                                    }
                                    else
                                    {
                                        <AppButton Label="Disconnect" Size="AppControlSize.Compact" Tone="AppUiTone.Error"
                                                   Disabled="@_busy" OnClick="@(() => UnlinkExternalLoginAsync(login))" />
                                    }
                                </div>
                            }
                            @foreach (var login in UnmatchedLogins)
                            {
                                <div class="account-security-settings__row" @key="login.Id">
                                    <div><strong>@login.Provider</strong><span>@LoginDescription(login) · Linked</span></div>
                                    <AppButton Label="Disconnect" Size="AppControlSize.Compact" Tone="AppUiTone.Error"
                                               Disabled="@_busy" OnClick="@(() => UnlinkExternalLoginAsync(login))" />
                                </div>
                            }
                        </div>
                    }
                </SettingsSectionPanel>
            }

            <SettingsSectionPanel Title="Devices & sessions" Description="Review devices currently signed in to your account."
                                  Icon="@AppMaterialIcons.Outlined.Devices"
                                  Class="tl-card settings-section-card settings-section-card--dense account-security-settings__sessions-card">
                <Actions>
                    @if (OtherSessions.Any())
                    {
                        <AppButton Label="Sign out all other sessions" Size="AppControlSize.Compact" Tone="AppUiTone.Error"
                                   Disabled="@_busy" OnClick="RevokeOtherSessionsAsync" />
                    }
                </Actions>
                <ChildContent>
                    @if (_sessionsLoading)
                    {
                        <AppSkeleton Height="128px" Animation="Animation.Wave" aria-label="Loading devices and sessions" />
                    }
                    else if (_sessionsError is not null)
                    {
                        <AppAlert Tone="AppUiTone.Error">@_sessionsError</AppAlert>
                    }
                    else if (_sessions.Count == 0)
                    {
                        <AppEmptyState Class="app-page-state--compact" Title="Sessions unavailable"
                                       Message="No active sessions were returned for this account." />
                    }
                    else
                    {
                        <div class="account-security-settings__session-list">
                            @foreach (var session in OrderedSessions)
                            {
                                var current = IsCurrent(session);
                                var display = SecuritySessionDisplayFormatter.Format(session);
                                <div class="account-security-settings__session" @key="session.Id">
                                    <span class="account-security-settings__session-icon" aria-hidden="true"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Devices" /></span>
                                    <div class="account-security-settings__session-copy">
                                        <div class="account-security-settings__session-title">
                                            <strong>@display.DeviceName</strong>
                                            @if (current)
                                            {
                                                <span class="account-security-settings__current" aria-label="Current session">Current session</span>
                                            }
                                        </div>
                                        <span>@display.ClientDescription</span>
                                    </div>
                                    <div class="account-security-settings__session-status">
                                        <strong>@(current ? "Active now" : $"Last active {RelativeTime(session.LastSeenAt)}")</strong>
                                        <span>Signed in @FormatDate(session.CreatedAt)</span>
                                    </div>
                                    @if (!current)
                                    {
                                        <AppButton Label="Sign out" Size="AppControlSize.Compact" Tone="AppUiTone.Error"
                                                   Disabled="@_busy" OnClick="@(() => RevokeSessionAsync(session))" />
                                    }
                                </div>
                            }
                        </div>
                    }
                </ChildContent>
            </SettingsSectionPanel>

            @if (Capabilities.HasPassword)
            {
                <SettingsSectionPanel Title="Recovery codes"
                                      Description="Recovery codes can be used if you lose access to your normal sign-in methods."
                                      Icon="@AppMaterialIcons.Outlined.Key">
                    <p class="account-security-settings__warning-copy">Generating a new set invalidates all existing recovery codes.</p>
                    <div class="account-security-settings__recovery">
                        <AppTextField T="string" @bind-Value="_recoveryPassword" Label="Current password"
                                      InputType="AppInputType.Password" autocomplete="current-password" />
                        <div class="app-field account-security-settings__field-action">
                            <span class="app-field__label" aria-hidden="true">Action</span>
                            <AppButton Label="Generate new recovery codes" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Warning"
                                       Loading="@_generatingRecoveryCodes"
                                       Disabled="@(_busy || string.IsNullOrWhiteSpace(_recoveryPassword))"
                                       OnClick="GenerateRecoveryCodesAsync" />
                        </div>
                    </div>
                    @if (_recoveryCodes.Count > 0)
                    {
                        <RecoveryCodesDisplay Codes="@_recoveryCodes" />
                    }
                </SettingsSectionPanel>
            }
        </div>
    }
</div>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private AccountSelfServiceResponse? _account;
    private List<DeviceSessionResponse> _sessions = [];
    private List<AccountExternalLoginDto> _externalLogins = [];
    private List<PasskeyCredentialResponse> _passkeys = [];
    private IReadOnlyList<string> _recoveryCodes = [];
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string _recoveryPassword = string.Empty;
    private bool _accountLoading = true;
    private bool _sessionsLoading = true;
    private bool _loginsLoading = true;
    private bool _passkeysLoading = true;
    private bool _busy;
    private bool _changingPassword;
    private bool _registeringPasskey;
    private bool _generatingRecoveryCodes;
    private bool _passwordChanged;
    private bool _disposed;
    private string? _sessionsError;
    private string? _loginsError;
    private string? _passkeysError;

    private AccountSecurityCapabilitiesResponse Capabilities => _account!.SecurityCapabilities;
    private string AccountEmail => string.IsNullOrWhiteSpace(_account?.Email) ? "Local profile" : _account.Email;
    private bool NewPasswordValid => _newPassword.Length is >= 8 and <= 128;
    private bool PasswordsMatch => string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal);
    private bool CanChangePassword => !_busy && !_changingPassword && !string.IsNullOrWhiteSpace(_currentPassword)
        && NewPasswordValid && PasswordsMatch;
    private bool ShowPasskeys => !_account!.IsLocalOnly;
    private string PasskeyUnavailableMessage => Capabilities.PasskeyReady
        ? "Passkeys are unavailable from this connection. Use a secure connection or local access."
        : "Passkeys are not available on this server.";
    private bool ShowLinkedAccounts => Capabilities.HasExternalLogins || AvailableProviders.Any();
    private IEnumerable<RegisteredExternalAuthProvider> AvailableProviders => ExternalProviders.Where(provider =>
        Capabilities.AvailableExternalProviders.Any(available => available.Id.Equals(provider.Id, StringComparison.OrdinalIgnoreCase)));
    private IEnumerable<AccountExternalLoginDto> UnmatchedLogins => _externalLogins.Where(login =>
        AvailableProviders.All(provider => !provider.Id.Equals(login.Provider, StringComparison.OrdinalIgnoreCase)));
    private IEnumerable<DeviceSessionResponse> OrderedSessions => _sessions.OrderByDescending(IsCurrent).ThenByDescending(session => session.LastSeenAt);
    private IEnumerable<DeviceSessionResponse> OtherSessions => _sessions.Where(session => !IsCurrent(session));

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountAsync();
        if (_account is null || _disposed) return;
        StateHasChanged();
        await Task.WhenAll(LoadSessionsAsync(), LoadLoginsAsync(), LoadPasskeysAsync());
    }

    private async Task LoadAccountAsync()
    {
        try { _account = await Identity.GetAccountAsync(_lifetime.Token); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch { _account = null; }
        finally { _accountLoading = false; }
    }

    private async Task RefreshAccountAsync()
    {
        try { _account = await Identity.GetAccountAsync(_lifetime.Token) ?? _account; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    private async Task LoadSessionsAsync()
    {
        _sessionsLoading = true;
        _sessionsError = null;
        try { _sessions = await Identity.GetSessionsAsync(_lifetime.Token); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch { _sessionsError = "Devices and sessions could not be loaded. The rest of your security settings are still available."; }
        finally { _sessionsLoading = false; }
    }

    private async Task LoadLoginsAsync()
    {
        if (!Capabilities.HasExternalLogins && !Capabilities.ExternalSignInAvailable) { _loginsLoading = false; return; }
        _loginsLoading = true;
        _loginsError = null;
        try { _externalLogins = await Identity.GetExternalLoginsAsync(_lifetime.Token); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch { _loginsError = "Linked accounts could not be loaded. The rest of your security settings are still available."; }
        finally { _loginsLoading = false; }
    }

    private async Task LoadPasskeysAsync()
    {
        if (!ShowPasskeys) { _passkeysLoading = false; return; }
        _passkeysLoading = true;
        _passkeysError = null;
        try { _passkeys = await Identity.GetPasskeysAsync(_lifetime.Token); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch { _passkeysError = "Passkeys could not be loaded. The rest of your security settings are still available."; }
        finally { _passkeysLoading = false; }
    }

    private async Task ChangePasswordAsync()
    {
        if (!CanChangePassword || _disposed) return;
        _busy = _changingPassword = true;
        _passwordChanged = false;
        try
        {
            var result = await Identity.ChangePasswordResultAsync(
                new ChangePasswordRequest { CurrentPassword = _currentPassword, NewPassword = _newPassword }, _lifetime.Token);
            if (!result.Succeeded)
            {
                Snackbar.Add(result.Failure == DashboardAccessMutationFailure.Unauthorized
                    ? "The current password is incorrect." : "The password could not be changed.", AppSeverity.Error);
                return;
            }
            _currentPassword = _newPassword = _confirmPassword = string.Empty;
            _passwordChanged = true;
            await LoadSessionsAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = _changingPassword = false; }
    }

    private async Task RegisterPasskeyAsync()
    {
        if (_busy || _registeringPasskey || !Capabilities.CanRegisterPasskey || _disposed) return;
        _busy = _registeringPasskey = true;
        try
        {
            var options = await Identity.GetPasskeyRegistrationOptionsAsync(_lifetime.Token);
            if (options is null) { Snackbar.Add("Passkeys are not available on this server.", AppSeverity.Error); return; }
            var credentialJson = await JS.InvokeAsync<string>("tuvimaPasskeys.createCredential", _lifetime.Token, options.OptionsJson);
            var saved = await Identity.CompletePasskeyRegistrationAsync(
                new CompletePasskeyRegistrationRequest(credentialJson, options.State, NextPasskeyName()), _lifetime.Token);
            if (!saved) { Snackbar.Add("The passkey could not be registered.", AppSeverity.Error); return; }
            await LoadPasskeysAsync();
            await RefreshAccountAsync();
            Snackbar.Add("Passkey added.", AppSeverity.Success);
        }
        catch (JSException exception) { Snackbar.Add(exception.Message, AppSeverity.Error); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = _registeringPasskey = false; }
    }

    private async Task RemovePasskeyAsync(PasskeyCredentialResponse passkey)
    {
        if (!await ConfirmAsync("Remove passkey?", $"Remove {passkey.Name} from your sign-in methods?", "Remove passkey")) return;
        _busy = true;
        try
        {
            var result = await Identity.RemovePasskeyResultAsync(passkey.CredentialId, _lifetime.Token);
            if (result.Succeeded)
            {
                _passkeys.RemoveAll(item => item.CredentialId == passkey.CredentialId);
                await RefreshAccountAsync();
                Snackbar.Add("Passkey removed.", AppSeverity.Success);
            }
            else Snackbar.Add(result.Failure == DashboardAccessMutationFailure.Conflict
                ? "Add another sign-in method before removing this passkey." : "The passkey could not be removed.", AppSeverity.Error);
        }
        finally { _busy = false; }
    }

    private async Task UnlinkExternalLoginAsync(AccountExternalLoginDto login)
    {
        if (!await ConfirmAsync("Disconnect linked account?", "You will no longer be able to use this account to sign in to Tuvima Library.", "Disconnect")) return;
        _busy = true;
        try
        {
            var result = await Identity.UnlinkExternalLoginResultAsync(login.Id, _lifetime.Token);
            if (result.Succeeded)
            {
                _externalLogins.RemoveAll(item => item.Id == login.Id);
                await RefreshAccountAsync();
                Snackbar.Add("Linked account disconnected.", AppSeverity.Success);
            }
            else Snackbar.Add(result.Failure == DashboardAccessMutationFailure.Conflict
                ? "Add another sign-in method before disconnecting this account." : "The linked account could not be disconnected.", AppSeverity.Error);
        }
        finally { _busy = false; }
    }

    private async Task RevokeSessionAsync(DeviceSessionResponse session)
    {
        if (!await ConfirmAsync("Sign out this session?", "This device will need to sign in again.", "Sign out")) return;
        _busy = true;
        try
        {
            var result = await Identity.RevokeSessionResultAsync(session.Id, _lifetime.Token);
            if (result.Succeeded) { _sessions.RemoveAll(item => item.Id == session.Id); Snackbar.Add("Session signed out.", AppSeverity.Success); }
            else Snackbar.Add("The session could not be signed out.", AppSeverity.Error);
        }
        finally { _busy = false; }
    }

    private async Task RevokeOtherSessionsAsync()
    {
        if (!await ConfirmAsync("Sign out all other sessions?", "You will remain signed in on this device.", "Sign out other sessions")) return;
        _busy = true;
        try
        {
            var result = await Identity.RevokeOtherSessionsAsync(_lifetime.Token);
            if (result.Succeeded)
            {
                _sessions.RemoveAll(session => !IsCurrent(session));
                Snackbar.Add(result.Value!.RevokedCount == 1 ? "1 other session signed out."
                    : $"{result.Value.RevokedCount} other sessions signed out.", AppSeverity.Success);
            }
            else Snackbar.Add("Other sessions could not be signed out.", AppSeverity.Error);
        }
        finally { _busy = false; }
    }

    private async Task GenerateRecoveryCodesAsync()
    {
        if (_busy || _generatingRecoveryCodes || string.IsNullOrWhiteSpace(_recoveryPassword) || _disposed) return;
        if (!await ConfirmAsync("Generate new recovery codes?", "Every existing recovery code will stop working.", "Generate new codes")) return;
        _busy = _generatingRecoveryCodes = true;
        try
        {
            var codes = await Identity.RegenerateRecoveryCodesAsync(_recoveryPassword, _lifetime.Token);
            if (codes is null) { Snackbar.Add("Recovery codes could not be generated. Check your current password.", AppSeverity.Error); return; }
            _recoveryCodes = codes;
            _recoveryPassword = string.Empty;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = _generatingRecoveryCodes = false; }
    }

    private async Task<bool> ConfirmAsync(string title, string message, string confirmLabel) =>
        await DialogService.ShowMessageBoxAsync(title, message, yesText: confirmLabel, cancelText: "Cancel") == true;
    private bool IsCurrent(DeviceSessionResponse session) => Session.SessionId == session.Id;
    private AccountExternalLoginDto? FindLogin(string providerId) => _externalLogins.FirstOrDefault(login =>
        login.Provider.Equals(providerId, StringComparison.OrdinalIgnoreCase));
    private static string LoginDescription(AccountExternalLoginDto login) =>
        StringHelpers.FirstNonBlankOr(login.Provider, login.Email, login.DisplayName);
    private string NextPasskeyName()
    {
        var current = _sessions.FirstOrDefault(IsCurrent);
        var baseName = current is null ? "This device"
            : SecuritySessionDisplayFormatter.Format(current).ClientDescription.Split(" · ", StringSplitOptions.None)[0];
        if (_passkeys.All(passkey => !passkey.Name.Equals(baseName, StringComparison.OrdinalIgnoreCase))) return baseName;
        var suffix = 2;
        while (_passkeys.Any(passkey => passkey.Name.Equals($"{baseName} {suffix}", StringComparison.OrdinalIgnoreCase))) suffix++;
        return $"{baseName} {suffix}";
    }
    private static string FormatAuthenticationMethod(string value) =>
        SecuritySessionDisplayFormatter.FormatAuthenticationMethod(value) switch
        {
            "Profile Entry" => "Local profile",
            "Profile Pin" => "Profile PIN",
            var method => method,
        };
    private static string FormatDate(DateTimeOffset value) => value.ToLocalTime().ToString("MMM d, yyyy");
    private static string BackupStatus(PasskeyCredentialResponse passkey) => passkey.BackedUp ? " · Synced" : string.Empty;
    private static string RelativeTime(DateTimeOffset value)
    {
        var elapsed = DateTimeOffset.UtcNow - value.ToUniversalTime();
        if (elapsed.TotalMinutes < 1) return "just now";
        if (elapsed.TotalHours < 1) return $"{Math.Max(1, (int)elapsed.TotalMinutes)} minutes ago";
        if (elapsed.TotalDays < 1) return $"{Math.Max(1, (int)elapsed.TotalHours)} hours ago";
        if (elapsed.TotalDays < 30) return $"{Math.Max(1, (int)elapsed.TotalDays)} days ago";
        return FormatDate(value);
    }

    public ValueTask DisposeAsync()
    {
        if (_disposed) return ValueTask.CompletedTask;
        _disposed = true;
        _recoveryCodes = [];
        _lifetime.Cancel();
        _lifetime.Dispose();
        return ValueTask.CompletedTask;
    }
}
