@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Profiles
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Ui
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject DashboardSessionAccessor Session
@inject DashboardIdentityClient Identity
@inject ConfirmedActionRunner Confirmed
@inject NavigationManager Nav
@inject IAppToastService Toasts
@inject ILogger<ProfileDetailPage> Logger
@inject DeviceContextService DeviceContext

@* Settings > Manage Profiles > one person, in three tabs: Profile (details, sign-in, roles), Preferences (watching, listening, reading,
   subtitles, Home) and Access & safety (libraries, Vault, administrator PIN, delete). The same for your own profile and, for
   administrators, anyone in the household. *@
<div class="profile-detail" data-profile-section="detail" data-profile-tab="@(Tab.Length == 0 ? "profile" : Tab)">
    @if (IsAdministrator)
    {
        <a class="profile-detail__back" href="/settings/profiles">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ArrowBack" aria-hidden="true" />
            <span>Manage Profiles</span>
        </a>
    }

    @if (_loading)
    {
        <div class="profile-detail__loading" role="status" aria-label="Loading profile">
            <AppSkeleton Height="96px" />
            <AppSkeleton Height="168px" />
            <AppSkeleton Height="224px" />
        </div>
    }
    else if (_person is null)
    {
        <AppAlert Severity="AppSeverity.Warning" Variant="AppVariant.Outlined">
            This profile couldn't be loaded. Reload the page to try again.
        </AppAlert>
    }
    else
    {
        <header class="profile-detail__header">
            <span class="profile-detail__avatar"><ProfileAvatar DisplayName="@_person.DisplayName" ImageUrl="@_person.AvatarImageUrl" Color="@_person.AvatarColor" Icon="@_person.AvatarIcon" /></span>
            <div class="profile-detail__who">
                <h2 class="profile-detail__name">@_person.DisplayName</h2>
                <p class="profile-detail__role">@RoleLabel</p>
                <ul class="profile-detail__badges" aria-label="Profile badges">
                    @if (IsSelf)
                    {
                        <li class="profile-detail__badge profile-detail__badge--you">You</li>
                    }
                    @if (_managedPerson?.IsHouseholdAdmin == true)
                    {
                        <li class="profile-detail__badge" data-role="household-administrator">Household administrator</li>
                    }
                    @if (_managedPerson?.IsServerAdmin == true)
                    {
                        <li class="profile-detail__badge" data-role="server-administrator">Server administrator</li>
                    }
                    @if (_person.IsRestricted)
                    {
                        <li class="profile-detail__badge">Kids</li>
                    }
                    @if (_person.HasPin)
                    {
                        <li class="profile-detail__badge">PIN</li>
                    }
                </ul>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(_notice))
        {
            <AppAlert Severity="AppSeverity.Info" Variant="AppVariant.Outlined" Dense="true">@_notice</AppAlert>
        }

        @if (OnProfileTab)
        {
        <div class="profile-detail__group">
        <SettingsSectionPanel Title="Profile">
            <ul class="profile-detail__list" role="list">
                @if (CanEditDetails)
                {
                    @* The editor saves through administrator-only Engine actions, so a member does not see a row that could not save. *@
                    <li class="profile-detail__item">
                        <SettingsNavRow Key="details" Icon="@AppMaterialIcons.Outlined.Person" Title="Profile details" Status="@DetailsStatus" OnClick="OpenEditor" />
                    </li>
                }
                <li class="profile-detail__item">
                    @if (IsSelf)
                    {
                        @* Your own sign-in is looked after in Security (password, two-step codes). *@
                        <SettingsNavRow Key="sign-in" Icon="@AppMaterialIcons.Outlined.Key" Title="Sign-in" Status="@SignInStatus" Href="/settings/security" />
                    }
                    else
                    {
                        @* Read-only: a sign-in is attached, changed and removed by the server administrator in Users and Sign-in. *@
                        <SettingsNavRow Key="sign-in" Icon="@AppMaterialIcons.Outlined.Key" Title="Sign-in" Status="@SignInStatus"
                                        Note="Managed by the server administrator in Users and Sign-in."
                                        Href="@(CanOpenUsers ? UsersRoute : null)" Disabled="@(!CanOpenUsers)" ShowChevron="@CanOpenUsers" />
                    }
                </li>
                <li class="profile-detail__item">
                    @* Opens the Devices page already narrowed to this person. *@
                    <SettingsNavRow Key="devices" Icon="@AppMaterialIcons.Outlined.Devices" Title="Devices" Status="Phones, TVs and browsers" Href="@DevicesLink" />
                </li>
                @if (IsAdministrator)
                {
                    <li class="profile-detail__item">
                        @* Opens the Activity page already narrowed to this person; the Engine logs an administrator looking at someone else's activity. *@
                        <SettingsNavRow Key="activity" Icon="@AppMaterialIcons.Outlined.History" Title="View activity" Status="What they watched, listened to and read" Href="@ActivityLink" />
                    </li>
                }
            </ul>
        </SettingsSectionPanel>
        </div>
        }

        @if (OnPreferencesTab)
        {
            @if (_forbidden)
            {
                <AppAlert Severity="AppSeverity.Warning" Variant="AppVariant.Outlined">You can't change this person's settings.</AppAlert>
            }
            else
            {
                @* Each part is the page it used to be, now a section of this tab. An old link such as Playback#subtitles lands on its part. *@
                <section id="playback" class="profile-detail__preferences" aria-labelledby="profile-prefs-watching">
                    <h2 id="profile-prefs-watching" class="profile-detail__section-heading">Watching</h2>
                    <PlaybackSettingsPage ProfileId="@ProfileId" Embedded="true" />
                </section>
                <section id="listening" class="profile-detail__preferences" aria-labelledby="profile-prefs-listening">
                    <h2 id="profile-prefs-listening" class="profile-detail__section-heading">Listening</h2>
                    <ListeningSettingsPage ProfileId="@ProfileId" Embedded="true" />
                </section>
                <section id="reading" class="profile-detail__preferences" aria-labelledby="profile-prefs-reading">
                    <h2 id="profile-prefs-reading" class="profile-detail__section-heading">Reading</h2>
                    <ReadingSettingsPage ProfileId="@ProfileId" Embedded="true" />
                </section>
                @if (IsSelf)
                {
                    @* Home shows what the signed-in person's own top banner may show, so it is offered on your own profile only. *@
                    <section id="home" class="profile-detail__preferences" aria-labelledby="profile-prefs-home">
                        <h2 id="profile-prefs-home" class="profile-detail__section-heading">Home</h2>
                        <HomeSettingsPage />
                    </section>
                }
            }
        }

        @if (OnAccessTab && !_forbidden)
        {
            <MediaEngine.Web.Components.Vault.VaultProfileSettings Person="@_person"
                                                                   IsSelf="@IsSelf"
                                                                   IsAdministrator="@IsAdministrator"
                                                                   AdministratorHasPin="@(_active?.HasPin == true)" />
        }

        @if (!OnPreferencesTab && CanManage && _managedPerson is not null && DeviceContext.IsPhone)
        {
            @* A phone shows who is who; roles, access and Delete profile are changed on a computer or tablet. *@
            <p class="access-phone-note" role="note">Manage on a computer or tablet.</p>
        }

        @if (OnProfileTab && ShowRoles)
        {
            <div class="profile-detail__group" data-profile-section="roles">
            <SettingsSectionPanel Title="Roles">
                @if (!string.IsNullOrWhiteSpace(_roleError))
                {
                    <p class="who-page__error" role="alert">@_roleError</p>
                }
                <ul class="profile-detail__list" role="list">
                    <li class="profile-detail__item" data-role-switch="household-administrator">
                        <AppSwitchRow Label="Household administrator"
                                      Description="@(_householdRole.Reason ?? "Looks after this household's people and what they can open.")"
                                      Value="@_householdRole.On"
                                      ValueChanged="@(on => SetRolesAsync(on, ServerRoleValue))"
                                      Disabled="@(!_householdRole.Enabled || _roleBusy)" />
                    </li>
                    @if (_serverRole.Visible)
                    {
                        <li class="profile-detail__item" data-role-switch="server-administrator">
                            <AppSwitchRow Label="Server administrator"
                                          Description="@(_serverRole.Reason ?? "Looks after the whole Library: settings, users and every household.")"
                                          Value="@_serverRole.On"
                                          ValueChanged="@(on => SetRolesAsync(_householdRole.On, on))"
                                          Disabled="@(!_serverRole.Enabled || _roleBusy)" />
                        </li>
                    }
                </ul>
            </SettingsSectionPanel>
            </div>
        }

        @if (OnAccessTab && ShowAccess)
        {
            <div class="profile-detail__group" data-profile-section="access">
            <SettingsSectionPanel Title="Access">
                @if (!string.IsNullOrWhiteSpace(_accessMessage))
                {
                    <p class="who-page__error" role="alert">@_accessMessage</p>
                }
                <ul class="profile-detail__list" role="list">
                    <li class="profile-detail__item">
                        @if (_managedPerson is { IsServerAdmin: true })
                        {
                            <SettingsNavRow Key="access" Icon="@AppMaterialIcons.Outlined.LibraryBooks" Title="Libraries and lanes"
                                            Status="Everything" Note="A server administrator can open everything." Disabled="true" ShowChevron="false" />
                        }
                        else
                        {
                            <SettingsNavRow Key="access" Icon="@AppMaterialIcons.Outlined.LibraryBooks" Title="Libraries and lanes" Status="@AccessStatus" OnClick="OpenAccess" />
                        }
                    </li>
                </ul>
            </SettingsSectionPanel>
            </div>
        }

        @if (OnAccessTab && ShowPinProtection)
        {
            @* "Ask for a PIN to open administrator settings": the profile's own PIN (one PIN per profile), asked for before this profile
               opens administrator settings. Off unless switched on, and only possible once the profile has a PIN. Only on your own
               profile, or by the server administrator. *@
            <div class="profile-detail__group" data-profile-section="pin-protection">
            <SettingsSectionPanel Title="Administrator PIN">
                @if (!string.IsNullOrWhiteSpace(_protectionMessage))
                {
                    <AppAlert Severity="AppSeverity.Success" Variant="AppVariant.Outlined" Dense="true">@_protectionMessage</AppAlert>
                }
                @if (!string.IsNullOrWhiteSpace(_protectionError))
                {
                    <p class="who-page__error" role="alert">@_protectionError</p>
                }
                <div class="profile-detail__protection" data-admin-protection="@ProfileId">
                    <AppSwitchRow Label="Ask for a PIN to open administrator settings"
                                  Description="@ProtectionDescription()"
                                  Value="@(_protection?.Enabled == true)"
                                  ValueChanged="@(on => ToggleProtectionAsync(on))"
                                  Disabled="@_protectionBusy" />
                    @if (_protection?.Enabled == true)
                    {
                        <AppNativeSelect Value="@ProtectionOption()" OnChange="@(value => ProtectionDurationChangedAsync(value.Value?.ToString() ?? "FixedDuration:30"))"
                                         Disabled="@_protectionBusy" aria-label="@($"How long the PIN unlocks administrator settings for {PersonName}")">
                            <option value="FixedDuration:15">For 15 minutes</option>
                            <option value="FixedDuration:30">For 30 minutes</option>
                            <option value="FixedDuration:60">For 1 hour</option>
                            <option value="UntilProfileSwitch">Until profile switch</option>
                            <option value="LockOnLeave">Lock when leaving settings</option>
                        </AppNativeSelect>
                    }
                </div>
            </SettingsSectionPanel>
            </div>
        }

        @if (OnAccessTab && CanDelete)
        {
            <div class="profile-detail__group">
                <AppCard>
                <ul class="profile-detail__list" role="list">
                    <li class="profile-detail__item">
                        @* The sheet asks what to do with their photos and then deletes; the Delete button in it is the confirmation. *@
                        <SettingsNavRow Key="delete" Icon="@AppMaterialIcons.Outlined.Delete" Title="Delete profile" Destructive="true" ShowChevron="false" OnClick="OpenDelete" />
                    </li>
                </ul>
                </AppCard>
            </div>
        }
    }
</div>

<ProfileEditorSheet Open="@_editorOpen"
                    Profile="@_person"
                    Saving="@_editorSaving"
                    Error="@_editorError"
                    CanDelete="@CanDelete"
                    HasSignIn="@(_managedPerson is null ? null : _managedPerson.User is not null)"
                    SignInEmail="@_managedPerson?.User?.Email"
                    StartInDelete="@_startInDelete"
                    OnSave="SaveEditorAsync"
                    OnDelete="DeleteAsync"
                    OnClose="CloseEditor" />

<ProfileAccessSheet Open="@_accessOpen"
                    PersonName="@(_person?.DisplayName ?? string.Empty)"
                    Loading="@_accessLoading"
                    Saving="@_accessSaving"
                    Error="@_accessError"
                    Libraries="@_accessLibraries"
                    LibrariesUnavailable="@_accessLibrariesUnavailable"
                    ReadOnly="@DeviceContext.IsPhone"
                    OnHiddenChanged="HiddenChangedAsync"
                    OnRetryLibraries="RetryLibrariesAsync"
                    OfferedFeatureIds="@OfferedFeatureIds"
                    Person="@_managedPerson"
                    OnSave="SaveAccessAsync"
                    OnClose="CloseAccess" />

<AdminUnlockDialog Open="@_needsUnlock" Busy="@_unlocking" Error="@_unlockError" OnUnlock="UnlockAsync" OnCancel="CancelUnlock" />

@code {
    private const string SettingsProfilesRoute = "/settings/profiles";

    private ProfileEditingWorkflow? _workflow;
    private ProfileViewModel? _active;
    private ProfileViewModel? _person;
    private List<ProfileViewModel> _profiles = [];
    private List<ManagedProfileResponse> _managed = [];
    private UserPlaybackSettingsDto? _settings;
    private Guid? _loadedFor;
    private bool _loading = true;
    private bool _forbidden;
    private string? _notice;
    private bool _editorOpen;
    private bool _startInDelete;
    private bool _editorSaving;
    private string? _editorError;
    private ManagedProfileResponse? _managedPerson;
    private List<AccessLibraryOptionDto> _accessLibraries = [];
    private bool _accessLibrariesUnavailable;
    private bool _accessOpen;
    private bool _accessLoading;
    // The profile's access_version the open sheet's lanes were taken from; the Engine refuses a save made against an older one.
    private long _accessLoadedVersion;
    private bool _accessSaving;
    private string? _accessError;
    private string? _accessMessage;
    private RoleSwitchState _householdRole = RoleSwitchState.Hidden;
    private RoleSwitchState _serverRole = RoleSwitchState.Hidden;
    private bool _roleBusy;
    private string? _roleError;
    private ProfileAdminProtectionResponse? _protection;
    private string? _protectionChoice;
    private bool _protectionBusy;
    private string? _protectionMessage;
    private string? _protectionError;
    private bool _needsUnlock;
    private bool _unlocking;
    private bool _justUnlocked;
    private string? _unlockError;
    private Func<Task>? _afterUnlock;

    /// <summary>The person this page is about.</summary>
    [Parameter, EditorRequired] public Guid ProfileId { get; set; }

    /// <summary>The open tab: empty for Profile, otherwise <c>preferences</c> or <c>access</c>.</summary>
    [Parameter] public string Tab { get; set; } = string.Empty;

    private bool OnPreferencesTab => Tab == "preferences";

    private bool OnAccessTab => Tab == "access";

    private bool OnProfileTab => !OnPreferencesTab && !OnAccessTab;

    /// <summary>Raised with the person's name once it is known (and after a rename) so the page title and breadcrumb can use it.</summary>
    [Parameter] public EventCallback<string> NameChanged { get; set; }

    private ProfileEditingWorkflow Workflow => _workflow ??= new ProfileEditingWorkflow(Identity, Confirmed);

    // The sign-in is the user attached to this profile; it is shown here and changed in Users and Sign-in.
    private string SignInStatus => _managedPerson?.User?.Email is { Length: > 0 } email
        ? email
        : IsSelf ? "Managed in Security" : "No sign-in";

    private const string UsersRoute = "/settings/access/users";

    // Users and Sign-in is a server-administrator page.
    private bool CanOpenUsers => Session.HasNavigation("settings.administration");

    // Roles and access are looked after by administrators, and never from inside a Kids (restricted) profile.
    private bool CanManage => _active is { } active && ProfileManageRules.CanManage(active.IsRestricted, IsAdministrator);

    // The profile editor saves through administrator-only Engine actions; a member's rename/avatar route may come later.
    private bool CanEditDetails => IsAdministrator;

    // Roles, access and Delete profile are changed on a computer or tablet; a phone only reads them.
    private bool ShowRoles => CanManage && _managedPerson is not null && !DeviceContext.IsPhone;

    private bool ShowAccess => CanManage && _managedPerson is not null && !DeviceContext.IsPhone;

    // The server switch is not drawn for everyone; when it is hidden the person's current state is sent, never "off".
    private bool ServerRoleValue => _serverRole.Visible ? _serverRole.On : _managedPerson?.IsServerAdmin == true;

    private bool IsServerAdministrator => Session.Authority?.EffectiveAdministrator == true || Session.HasNavigation("settings.administration");

    private Guid? OwnHouseholdId => _managed.FirstOrDefault(person => person.Id == _active?.Id)?.HouseholdId;

    private IReadOnlyList<ManagedProfileResponse> HouseholdPeople => _managedPerson is null
        ? []
        : _managed.Where(person => person.HouseholdId == _managedPerson.HouseholdId).ToList();

    // A household administrator hands out only what their own profile holds; a server administrator hands out everything.
    private IReadOnlySet<string>? OfferedFeatureIds => IsServerAdministrator
        ? null
        : ManagedAccessUserPermissions.Features.Select(feature => feature.Id).Where(Session.HasNavigation).ToHashSet();

    private string? AccessStatus
    {
        get
        {
            if (_managedPerson is not { } person)
            {
                return null;
            }

            var lanes = ManagedAccessUserPermissions.Features
                .Where(feature => person.FeatureIds?.Contains(feature.Id) == true)
                .ToList();
            var laneText = lanes.Count == 0 ? "No lanes" : string.Join(", ", lanes.Select(feature => feature.Label));
            var hiddenIds = person.HiddenLibraryIds ?? [];
            if (hiddenIds.Count == 0)
            {
                return $"{laneText} · all libraries";
            }

            var perLane = _accessLibrariesUnavailable
                ? []
                : lanes
                    .Select(feature => (feature.Label, Count: _accessLibraries.Count(library =>
                        string.Equals(library.Area, feature.Id, StringComparison.OrdinalIgnoreCase) && hiddenIds.Contains(library.Id))))
                    .Where(entry => entry.Count > 0)
                    .Select(entry => $"{entry.Label}: {entry.Count} hidden")
                    .ToList();
            return perLane.Count > 0 ? $"{laneText} · {string.Join(", ", perLane)}" : $"{laneText} · {hiddenIds.Count} hidden";
        }
    }

    private bool IsAdministrator => Session.HasAction("household.manage") || Session.HasNavigation("settings.administration");

    // The Devices page, already narrowed to this person. Your own page omits ?profile=, like the preference links do.
    private string DevicesLink => IsSelf ? "/settings/security/devices" : $"/settings/security/devices?profile={ProfileId:D}";

    // The Activity page, already narrowed to this person. Your own page omits ?scope=, because Me is the default.
    private string ActivityLink => IsSelf ? SettingsNav.ActivityRoute : $"{SettingsNav.ActivityRoute}?scope=profile:{ProfileId:D}";

    // PIN protection only has something to protect on a profile that holds an administrator role and has a sign-in, and it is changed
    // only on your own profile or by the server administrator.
    private bool ShowPinProtection => _managedPerson is { User: not null } person
        && (person.IsServerAdmin || person.IsHouseholdAdmin)
        && (IsSelf || IsServerAdministrator)
        && _protection is not null;

    private string ProtectionDescription() =>
        _person?.HasPin == true
            ? "Uses the profile PIN, the same one that protects the profile. Off unless you turn it on."
            : "Needs a PIN on this profile. Set one in Profile details first.";

    private async Task ToggleProtectionAsync(bool on)
    {
        if (on && _person?.HasPin != true)
        {
            _protectionMessage = null;
            _protectionError = "Set a PIN for this profile first (Profile details), then turn this on.";
            return;
        }

        await SaveProtectionAsync(on);
    }

    private async Task ProtectionDurationChangedAsync(string option)
    {
        _protectionChoice = option;
        await SaveProtectionAsync(true);
    }

    private string ProtectionOption() =>
        _protectionChoice ?? (_protection?.UnlockMode == "FixedDuration"
            ? $"FixedDuration:{_protection.UnlockMinutes ?? 30}"
            : _protection?.UnlockMode ?? "FixedDuration:30");

    private bool IsSelf => _active is not null && _active.Id == ProfileId;

    private string RoleLabel => _managedPerson switch
    {
        { IsServerAdmin: true, IsHouseholdAdmin: true } => "Server administrator and household administrator",
        { IsServerAdmin: true } => "Server administrator",
        { IsHouseholdAdmin: true } => "Household administrator",
        _ when IsSelf && Session.Authority?.EffectiveAdministrator == true => "Administrator",
        _ => _person?.IsRestricted == true ? "Kids profile" : "Profile",
    };

    // Delete is offered only to someone who can manage people, and never for the profile in use, the last household administrator,
    // a server administrator (to a household administrator) or the household's only person.
    private bool CanDelete => _managedPerson is { } person && _active is { } active && CanManage && !DeviceContext.IsPhone
        && ProfileRoleRules.CanDelete(person, active.Id, HouseholdPeople, IsServerAdministrator);

    private string DetailsStatus
    {
        get
        {
            if (_person is null)
            {
                return string.Empty;
            }

            var limit = string.IsNullOrWhiteSpace(_person.ContentLimit) ? "Everything" : _person.ContentLimit;
            var status = _person.IsRestricted ? $"Kids · {limit}" : limit;
            return _person.HasPin ? $"{status} · PIN set" : status;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == ProfileId)
        {
            return;
        }

        _loadedFor = ProfileId;
        _notice = null;
        _person = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = _person is null;
        _forbidden = false;
        try
        {
            _active = await Orchestrator.GetActiveProfileAsync();
            if (_active is null)
            {
                _person = null;
                return;
            }

            var canManage = ProfileManageRules.CanManage(_active.IsRestricted, IsAdministrator);
            if (ProfileId != _active.Id && !canManage)
            {
                Nav.NavigateTo(SettingsProfilesRoute, replace: true);
                return;
            }

            if (canManage)
            {
                var profiles = Orchestrator.GetProfilesAsync();
                var managed = Identity.GetManagedProfilesAsync();
                _profiles = await profiles;
                _managed = await managed;
            }

            _person = FindPerson();
            if (_person is null && ProfileId != _active.Id)
            {
                // Not someone this administrator can see (or no longer there): back to the list rather than a blank page.
                Nav.NavigateTo(SettingsProfilesRoute, replace: true);
                return;
            }

            ApplyManaged();
            if (_person is not null)
            {
                await NameChanged.InvokeAsync(_person.DisplayName);
                await LoadSettingsAsync();
                await LoadProtectionAsync();
                if (ShowAccess && !_managedPerson!.IsServerAdmin)
                {
                    // The summary line names what is hidden per lane.
                    await LoadLibrariesAsync();
                }
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not load the profile page.");
            _person = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private ProfileViewModel? FindPerson()
    {
        if (_active is { } active && active.Id == ProfileId)
        {
            return _profiles.FirstOrDefault(profile => profile.Id == ProfileId) ?? active;
        }

        var person = _managed.FirstOrDefault(known => known.Id == ProfileId);
        if (person is null)
        {
            return null;
        }

        // The sheet works with the picker's profile shape, so use the full profile when we have it and fill the rest in.
        return _profiles.FirstOrDefault(profile => profile.Id == person.Id)
            ?? new ProfileViewModel(person.Id, person.DisplayName, person.AvatarColor,
                person.IsRestricted ? "RestrictedProfile" : "Profile", person.CreatedAt,
                AvatarIcon: person.AvatarIcon, ContentLimit: person.ContentLimit,
                ContentLimitAllowUnrated: person.ContentLimitAllowUnrated);
    }

    private async Task LoadSettingsAsync()
    {
        _settings = await ApiClient.GetPlaybackSettingsAsync(ProfileId);

        // The Engine says no (403) when this person's settings are off limits; the client keeps the reason, not the status code.
        _forbidden = _settings is null
            && !IsSelf
            && ApiClient.LastError?.Contains("403", StringComparison.Ordinal) == true;
    }

    private async Task RefreshPeopleAsync()
    {
        try
        {
            // The list of people a sign-in may open comes from its authority, so refresh that first.
            await Identity.RevalidateAuthorityAsync(Session);
            await Orchestrator.RefreshProfilesAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not refresh the profile list.");
            _notice = "The change was saved, but the page couldn't be refreshed. Reload the page to see the latest.";
        }
    }

    // The roles and access shown come from the managed list the Engine returned for this administrator.
    private void ApplyManaged()
    {
        _managedPerson = _managed.FirstOrDefault(person => person.Id == ProfileId);
        if (_managedPerson is { } person && CanManage)
        {
            var household = HouseholdPeople;
            _householdRole = ProfileRoleRules.HouseholdAdministrator(person, household, IsServerAdministrator);
            _serverRole = ProfileRoleRules.ServerAdministrator(person, household, IsServerAdministrator, OwnHouseholdId);
        }
        else
        {
            _householdRole = RoleSwitchState.Hidden;
            _serverRole = RoleSwitchState.Hidden;
        }
    }

    // The profile's administrator PIN setting is the profile's own (a person reads their own, a server administrator any).
    private async Task LoadProtectionAsync()
    {
        _protection = null;
        _protectionChoice = null;
        if (_managedPerson is not { } person || !(person.IsServerAdmin || person.IsHouseholdAdmin) || !(IsSelf || IsServerAdministrator))
        {
            return;
        }

        try
        {
            _protection = await Identity.GetProfileAdminProtectionAsync(ProfileId)
                ?? new ProfileAdminProtectionResponse(false, "FixedDuration", 30, 0);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not load this profile's administrator PIN setting.");
        }
    }

    private async Task OpenAccess()
    {
        if (!ShowAccess)
        {
            return;
        }

        _accessError = null;
        _accessMessage = null;
        _accessLoading = true;
        _accessOpen = true;
        try
        {
            // The list shows every Library; the ones hidden from this administrator's own profile can't be shown again by them.
            await LoadLibrariesAsync();
            _accessLoadedVersion = _managedPerson?.AccessVersion ?? 0;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not load the Libraries to choose from.");
            _accessError = "The Engine is unavailable. Try again.";
        }
        finally
        {
            _accessLoading = false;
        }
    }

    // Reads the Engine's library picker. A failed read is "unavailable", never "empty": the libraries are then left as they are.
    private async Task LoadLibrariesAsync()
    {
        var loaded = await Identity.GetAccessLibrariesAsync();
        _accessLibrariesUnavailable = loaded is null;
        _accessLibraries = loaded ?? [];
    }

    private async Task RetryLibrariesAsync()
    {
        try
        {
            await LoadLibrariesAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not load the Libraries to choose from.");
            _accessLibrariesUnavailable = true;
        }
    }

    // One tick on a lane's Libraries list. It saves straight away: the lanes as they are saved now, and the hidden libraries with this
    // one added or removed. The lanes still waiting for Save are not sent. Answers true when the Engine took it.
    private async Task<bool> HiddenChangedAsync(Guid libraryId, bool hidden)
    {
        if (_accessSaving || !ShowAccess || DeviceContext.IsPhone || _accessLibrariesUnavailable || _managedPerson is not { } person)
        {
            return false;
        }

        var nextHidden = (person.HiddenLibraryIds ?? []).ToHashSet();
        if (hidden)
        {
            nextHidden.Add(libraryId);
        }
        else
        {
            nextHidden.Remove(libraryId);
        }

        _accessSaving = true;
        _accessError = null;
        // Draw the busy state now, so the ticks read as disabled while this save is in flight.
        StateHasChanged();
        try
        {
            var lanes = (person.FeatureIds ?? []).Order().ToArray();
            var loadedVersion = person.AccessVersion;
            var result = await Confirmed.RunAsync(() => Identity.ReplaceProfileAccessResultAsync(
                ProfileId, new ReplaceProfileAccessRequest(lanes, nextHidden.Order().ToArray(), loadedVersion)));
            if (!result.Succeeded)
            {
                await HandleAccessRefusalAsync(result);
                return false;
            }

            await ReloadManagedAsync();
            // A save raises the profile's version by exactly one, so the lanes still waiting in the sheet stay current only when nothing
            // else changed either; otherwise the next Save is refused and the person starts again from what is now saved.
            if (_accessLoadedVersion == loadedVersion && _managedPerson?.AccessVersion == loadedVersion + 1)
            {
                _accessLoadedVersion = loadedVersion + 1;
            }

            Toasts.Add(hidden ? $"Hidden from {PersonName}" : $"Shown to {PersonName}", AppSeverity.Success);
            return true;
        }
        finally
        {
            _accessSaving = false;
            // The tick was reported by the list, not by this page, so nothing else would draw the new saved state.
            StateHasChanged();
        }
    }

    private void CloseAccess()
    {
        if (!_accessSaving)
        {
            _accessOpen = false;
            _accessError = null;
        }
    }

    private async Task SaveAccessAsync(ReplaceProfileAccessRequest request)
    {
        if (_accessSaving || !ShowAccess)
        {
            return;
        }

        _accessSaving = true;
        _accessError = null;
        try
        {
            var versioned = request with { ExpectedAccessVersion = _accessLoadedVersion };
            var result = await Confirmed.RunAsync(() => Identity.ReplaceProfileAccessResultAsync(ProfileId, versioned));
            if (!result.Succeeded)
            {
                await HandleAccessRefusalAsync(result);
                return;
            }

            await ReloadManagedAsync();
            _accessOpen = false;
            Toasts.Add($"Access for {PersonName} was saved.", AppSeverity.Success);
        }
        finally
        {
            _accessSaving = false;
        }
    }

    // A refused access save. When the profile's access changed since this page loaded (409), the Engine saved nothing: read the
    // profile's access again, say so, and let the sheet start over from what is now saved (the person can tick again).
    private async Task HandleAccessRefusalAsync(DashboardAccessMutationResult result)
    {
        if (result.Failure != DashboardAccessMutationFailure.Conflict)
        {
            _accessError = AccessFailureMessage(result.Failure, result.Message);
            return;
        }

        _accessLoading = true;
        StateHasChanged();
        try
        {
            await ReloadManagedAsync();
            _accessLoadedVersion = _managedPerson?.AccessVersion ?? 0;
            _accessError = string.IsNullOrWhiteSpace(result.Message)
                ? "Something changed since you looked. Check the list and try again."
                : result.Message;
        }
        finally
        {
            _accessLoading = false;
        }
    }

    // Turns the Household administrator / Server administrator switches into one roles change; both values are the wanted state.
    private async Task SetRolesAsync(bool householdAdministrator, bool serverAdministrator)
    {
        if (_roleBusy || !ShowRoles)
        {
            return;
        }

        _roleBusy = true;
        _roleError = null;
        try
        {
            var result = await Confirmed.RunAsync(() => Identity.SetProfileRolesResultAsync(ProfileId,
                new SetProfileRolesRequest(householdAdministrator, serverAdministrator)));
            if (!result.Succeeded)
            {
                _roleError = AccessFailureMessage(result.Failure, result.Message);
                return;
            }

            await ReloadManagedAsync();
            await LoadProtectionAsync();
            await RefreshPeopleAsync();
        }
        finally
        {
            _roleBusy = false;
        }
    }

    private async Task SaveProtectionAsync(bool enabled)
    {
        if (_protectionBusy || _managedPerson is null)
        {
            return;
        }

        _protectionBusy = true;
        _protectionMessage = null;
        _protectionError = null;
        try
        {
            var parts = ProtectionOption().Split(':', 2);
            var unlockMode = parts[0];
            var unlockMinutes = unlockMode == "FixedDuration" && parts.Length == 2 && int.TryParse(parts[1], out var minutes)
                ? minutes
                : _protection?.UnlockMinutes;
            var result = await Confirmed.RunAsync(() => Identity.SetProfileAdminProtectionResultAsync(ProfileId,
                new SetProfileAdminProtectionRequest(enabled, unlockMode, unlockMinutes)));
            if (!result.Succeeded)
            {
                _protectionError = result.Failure == DashboardAccessMutationFailure.ConfirmItsYou
                    ? "Nothing was changed. Confirm it's you to continue."
                    : AccessFailureMessage(result.Failure, result.Message);
                return;
            }

            await LoadProtectionAsync();
            _protectionMessage = enabled
                ? $"Administrator settings now ask for {PersonName}'s PIN."
                : $"Administrator settings no longer ask for {PersonName}'s PIN.";
        }
        finally
        {
            _protectionBusy = false;
        }
    }

    // The Engine's own sentence is shown as it is; the generic lines are for a refusal with no reason given.
    private static string AccessFailureMessage(DashboardAccessMutationFailure failure, string? engineMessage = null) => failure switch
    {
        DashboardAccessMutationFailure.ConfirmItsYou => "Nothing was changed. Confirm it's you to continue.",
        DashboardAccessMutationFailure.Unauthorized => "Your session has expired.",
        DashboardAccessMutationFailure.Transient => "The Engine is unavailable. Try again.",
        _ when !string.IsNullOrWhiteSpace(engineMessage) => engineMessage,
        DashboardAccessMutationFailure.Validation or DashboardAccessMutationFailure.Forbidden
            => "That wasn't saved. You can only give what your profile has, and only to people in your household.",
        DashboardAccessMutationFailure.Conflict => "This change conflicts with the current state.",
        DashboardAccessMutationFailure.NotFound => "This profile no longer exists.",
        _ => "The change could not be saved. Try again.",
    };

    private void OpenEditor()
    {
        _editorError = null;
        _startInDelete = false;
        _editorOpen = true;
    }

    private void OpenDelete()
    {
        if (!CanDelete)
        {
            return;
        }

        _editorError = null;
        _startInDelete = true;
        _editorOpen = true;
    }

    private string PersonName => _person?.DisplayName ?? "This person";

    private async Task ReloadManagedAsync()
    {
        try
        {
            _managed = await Identity.GetManagedProfilesAsync();
            ApplyManaged();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not refresh the profile details.");
            _notice = "The change was saved, but the page couldn't be refreshed. Reload the page to see the latest.";
        }
    }

    private void CloseEditor()
    {
        if (!_editorSaving)
        {
            _editorOpen = false;
            _editorError = null;
        }
    }

    private Task SaveEditorAsync(ProfileEditorResult result)
    {
        _justUnlocked = false;
        return SaveAsync(result);
    }

    private Task DeleteAsync(bool keepPhotos)
    {
        _justUnlocked = false;
        return RemoveAsync(keepPhotos);
    }

    private async Task SaveAsync(ProfileEditorResult result)
    {
        if (_editorSaving || _person is null)
        {
            return;
        }

        _editorSaving = true;
        _editorError = null;
        try
        {
            var householdId = _managed.FirstOrDefault(person => person.Id == ProfileId)?.HouseholdId;
            var outcome = await Workflow.SaveAsync(_person, householdId, result, _justUnlocked);
            await FinishAsync(outcome, () => SaveAsync(result), deleted: false);
        }
        finally
        {
            _editorSaving = false;
        }
    }

    private async Task RemoveAsync(bool keepPhotos)
    {
        if (_person is not { } profile || _editorSaving || DeviceContext.IsPhone)
        {
            return;
        }

        _editorSaving = true;
        _editorError = null;
        try
        {
            var outcome = await Workflow.RemoveAsync(profile, keepPhotos, _justUnlocked);
            await FinishAsync(outcome, () => RemoveAsync(keepPhotos), deleted: true);
        }
        finally
        {
            _editorSaving = false;
        }
    }

    private async Task FinishAsync(ProfileEditOutcome outcome, Func<Task> retry, bool deleted)
    {
        if (outcome.NeedsUnlock)
        {
            _needsUnlock = true;
            _unlockError = null;
            _afterUnlock = retry;
            return;
        }

        _editorError = outcome.Error;
        if (outcome.Notice is not null)
        {
            _notice = outcome.Notice;
        }

        if (!outcome.Done)
        {
            return;
        }

        _editorOpen = false;
        await RefreshPeopleAsync();
        if (deleted)
        {
            // This page has nothing left to show, so go back to the list.
            Nav.NavigateTo(SettingsProfilesRoute);
            return;
        }

        await LoadAsync();
    }

    private async Task UnlockAsync(string pin)
    {
        if (_unlocking)
        {
            return;
        }

        _unlocking = true;
        _unlockError = null;
        try
        {
            var unlocked = await Identity.UnlockAdministratorAsync(new GrantAdminUnlockRequest(pin));
            if (unlocked?.Unlocked != true)
            {
                _unlockError = "That PIN didn't work. Try again.";
                return;
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not unlock administrator access from a profile page.");
            _unlockError = "The Engine is unavailable. Try again.";
            return;
        }
        finally
        {
            _unlocking = false;
        }

        var retry = _afterUnlock;
        _needsUnlock = false;
        _afterUnlock = null;
        _justUnlocked = true;
        if (retry is not null)
        {
            await retry();
        }
    }

    private void CancelUnlock()
    {
        _needsUnlock = false;
        _afterUnlock = null;
        _unlockError = null;
    }
}
