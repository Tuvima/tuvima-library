@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Components.Profiles
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Ui
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject DashboardSessionAccessor Session
@inject DashboardIdentityClient Identity
@inject ConfirmedActionRunner Confirmed
@inject NavigationManager Nav
@inject IAppDialogService Dialogs
@inject IAppToastService Toasts
@inject ILogger<ProfileDetailPage> Logger

@* Settings > Profiles > one person: a short list of rows, the same for your own profile and (for administrators) anyone in the household. *@
<div class="profile-detail" data-profile-section="detail">
    <a class="profile-detail__back" href="/settings/profiles">
        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ArrowBack" aria-hidden="true" />
        <span>Profiles</span>
    </a>

    @if (_loading)
    {
        <div class="profile-detail__loading" role="status" aria-label="Loading profile">
            <AppSkeleton Height="96px" />
            <AppSkeleton Height="168px" />
            <AppSkeleton Height="224px" />
        </div>
    }
    else if (_person is null)
    {
        <AppAlert Severity="AppSeverity.Warning" Variant="AppVariant.Outlined">
            This profile couldn't be loaded. Reload the page to try again.
        </AppAlert>
    }
    else
    {
        <header class="profile-detail__header">
            <span class="profile-detail__avatar"><ProfileAvatar DisplayName="@_person.DisplayName" ImageUrl="@_person.AvatarImageUrl" Color="@_person.AvatarColor" Icon="@_person.AvatarIcon" /></span>
            <div class="profile-detail__who">
                <h2 class="profile-detail__name">@_person.DisplayName</h2>
                <p class="profile-detail__role">@RoleLabel</p>
                <ul class="profile-detail__badges" aria-label="Profile badges">
                    @if (IsSelf)
                    {
                        <li class="profile-detail__badge profile-detail__badge--you">You</li>
                    }
                    @if (IsSelf && IsAdministrator)
                    {
                        <li class="profile-detail__badge">Admin</li>
                    }
                    @if (_person.IsRestricted)
                    {
                        <li class="profile-detail__badge">Kids</li>
                    }
                    @if (_person.HasPin)
                    {
                        <li class="profile-detail__badge">PIN</li>
                    }
                </ul>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(_notice))
        {
            <AppAlert Severity="AppSeverity.Info" Variant="AppVariant.Outlined" Dense="true">@_notice</AppAlert>
        }

        <section class="profile-detail__group" aria-labelledby="profile-detail-profile">
            <h3 id="profile-detail-profile" class="profile-detail__group-title">Profile</h3>
            <ul class="profile-detail__list" role="list">
                @if (CanEditDetails)
                {
                    @* The editor saves through administrator-only Engine actions, so a member does not see a row that could not save. *@
                    <li class="profile-detail__item">
                        <SettingsNavRow Key="details" Icon="@AppMaterialIcons.Outlined.Person" Title="Profile details" Status="@DetailsStatus" OnClick="OpenEditor" />
                    </li>
                }
                <li class="profile-detail__item">
                    @if (IsSelf)
                    {
                        @* Your own sign-in is looked after in Security (password, two-step codes); an administrator never edits it from here. *@
                        <SettingsNavRow Key="sign-in" Icon="@AppMaterialIcons.Outlined.Key" Title="Sign-in" Status="@SignInStatus" Href="/settings/security" />
                    }
                    else
                    {
                        <SettingsNavRow Key="sign-in" Icon="@AppMaterialIcons.Outlined.Key" Title="Sign-in" Status="@SignInStatus" Note="@SignInNote" OnClick="OpenSignIn" />
                    }
                </li>
            </ul>
        </section>

        @if (_forbidden)
        {
            <AppAlert Severity="AppSeverity.Warning" Variant="AppVariant.Outlined">You can't change this person's settings.</AppAlert>
        }
        else
        {
            <section class="profile-detail__group" aria-labelledby="profile-detail-preferences">
                <h3 id="profile-detail-preferences" class="profile-detail__group-title">Preferences</h3>
                <ul class="profile-detail__list" role="list">
                    <li class="profile-detail__item">
                        <SettingsNavRow Key="playback" Icon="@AppMaterialIcons.Outlined.PlayCircle" Title="Playback" Status="@PlaybackStatus" Href="@PreferenceLink("playback")" />
                    </li>
                    <li class="profile-detail__item">
                        <SettingsNavRow Key="listening" Icon="@AppMaterialIcons.Outlined.Headphones" Title="Listening" Status="@ListeningStatus" Href="@PreferenceLink("listening")" />
                    </li>
                    <li class="profile-detail__item">
                        <SettingsNavRow Key="reading" Icon="@AppMaterialIcons.Outlined.MenuBook" Title="Reading" Status="@ReadingStatus" Href="@PreferenceLink("reading")" />
                    </li>
                    <li class="profile-detail__item">
                        <SettingsNavRow Key="subtitles" Icon="@AppMaterialIcons.Outlined.Subtitles" Title="Subtitles" Status="@SubtitlesStatus" Href="@PreferenceLink("playback", "#subtitles")" />
                    </li>
                </ul>
            </section>
        }

        @if (ShowHouseholdAccess)
        {
            <section class="profile-detail__group" aria-labelledby="profile-detail-access" data-profile-section="household-access">
                <h3 id="profile-detail-access" class="profile-detail__group-title">Household access</h3>
                @if (!string.IsNullOrWhiteSpace(_accessMessage))
                {
                    <p class="who-page__error" role="alert">@_accessMessage</p>
                }
                <ul class="profile-detail__list" role="list">
                    <li class="profile-detail__item">
                        @if (AccessFollowsHousehold)
                        {
                            @* An own sign-in follows the household's main sign-in, so this is shown, not edited; the Engine refuses to change it here. *@
                            <SettingsNavRow Key="access" Icon="@AppMaterialIcons.Outlined.LibraryBooks" Title="Libraries and lanes" Status="@AccessStatus"
                                            Note="Follows the household's access. Change it on the household's main sign-in."
                                            Href="@(CanOpenHouseholdSettings ? HouseholdAccessRoute : null)" Disabled="@(!CanOpenHouseholdSettings)" />
                        }
                        else
                        {
                            <SettingsNavRow Key="access" Icon="@AppMaterialIcons.Outlined.LibraryBooks" Title="Libraries and lanes" Status="@AccessStatus" OnClick="OpenAccess" />
                        }
                    </li>
                    <li class="profile-detail__item">
                        @if (_access is { HasTwoStep: false })
                        {
                            <SettingsNavRow Key="two-step" Icon="@AppMaterialIcons.Outlined.Key" Title="Two-step codes" Status="Off" Disabled="true" />
                        }
                        else
                        {
                            <SettingsNavRow Key="two-step" Icon="@AppMaterialIcons.Outlined.Key" Title="Two-step codes" Status="@(_access is null ? null : "On")" Note="Turn off if they lost their phone" ShowChevron="false" OnClick="ResetTwoStepAsync" />
                        }
                    </li>
                </ul>
            </section>
        }

        @if (CanDelete)
        {
            <section class="profile-detail__group" aria-label="Delete profile">
                <ul class="profile-detail__list" role="list">
                    <li class="profile-detail__item">
                        @* The sheet asks what to do with their photos and then deletes; the Delete button in it is the confirmation. *@
                        <SettingsNavRow Key="delete" Icon="@AppMaterialIcons.Outlined.Delete" Title="Delete profile" Destructive="true" ShowChevron="false" OnClick="OpenDelete" />
                    </li>
                </ul>
            </section>
        }
    }
</div>

<ProfileEditorSheet Open="@_editorOpen"
                    Profile="@_person"
                    Saving="@_editorSaving"
                    Error="@_editorError"
                    CanDelete="@CanDelete"
                    StartInDelete="@_startInDelete"
                    OnSave="SaveEditorAsync"
                    OnDelete="DeleteAsync"
                    OnClose="CloseEditor" />

@* Before the unlock dialog, so a PIN prompt raised from the sheet is drawn on top of it. *@
<ProfileSignInSheet Open="@_signInOpen"
                    PersonName="@(_person?.DisplayName ?? string.Empty)"
                    SignIn="@OwnSignIn"
                    CanChangeEmail="@IsAdministrator"
                    Saving="@_signInSaving"
                    Error="@_signInError"
                    Issued="@_signInIssued"
                    OnGive="GiveSignInAsync"
                    OnInvite="InviteSignInAsync"
                    OnSetPassword="SetSignInPasswordAsync"
                    OnChangeEmail="ChangeSignInEmailAsync"
                    OnRemove="RemoveSignInAsync"
                    OnClose="CloseSignIn" />

<ProfileAccessSheet Open="@_accessOpen"
                    PersonName="@(_person?.DisplayName ?? string.Empty)"
                    Loading="@_accessLoading"
                    Saving="@_accessSaving"
                    Error="@_accessError"
                    Libraries="@_accessLibraries"
                    Account="@_access"
                    OnSave="SaveAccessAsync"
                    OnClose="CloseAccess" />

<AdminUnlockDialog Open="@_needsUnlock" Busy="@_unlocking" Error="@_unlockError" OnUnlock="UnlockAsync" OnCancel="CancelUnlock" />

@code {
    private const string SettingsProfilesRoute = "/settings/profiles";

    private ProfileEditingWorkflow? _workflow;
    private ProfileViewModel? _active;
    private ProfileViewModel? _person;
    private List<ProfileViewModel> _profiles = [];
    private List<ManagedProfileResponse> _managed = [];
    private UserPlaybackSettingsDto? _settings;
    private Guid? _loadedFor;
    private bool _loading = true;
    private bool _forbidden;
    private string? _notice;
    private bool _editorOpen;
    private bool _startInDelete;
    private bool _editorSaving;
    private string? _editorError;
    private ProfileSignInWorkflow? _signInWorkflow;
    private bool _signInOpen;
    private bool _signInSaving;
    private string? _signInError;
    private SignInIssued? _signInIssued;
    private AccountAccessResponse? _access;
    private List<AccessLibraryOptionDto> _accessLibraries = [];
    private bool _accessOpen;
    private bool _accessLoading;
    private bool _accessSaving;
    private string? _accessError;
    private string? _accessMessage;
    private bool _needsUnlock;
    private bool _unlocking;
    private bool _justUnlocked;
    private string? _unlockError;
    private Func<Task>? _afterUnlock;

    /// <summary>The person this page is about.</summary>
    [Parameter, EditorRequired] public Guid ProfileId { get; set; }

    /// <summary>Raised with the person's name once it is known (and after a rename) so the page title and breadcrumb can use it.</summary>
    [Parameter] public EventCallback<string> NameChanged { get; set; }

    private ProfileEditingWorkflow Workflow => _workflow ??= new ProfileEditingWorkflow(Identity, Confirmed);

    private ProfileSignInWorkflow SignInWorkflow => _signInWorkflow ??= new ProfileSignInWorkflow(Identity, Confirmed);

    // Only people in the administrator's household list carry sign-in details; your own page never offers the sheet.
    private ManagedProfileSignInDto? OwnSignIn => _managed.FirstOrDefault(person => person.Id == ProfileId)?.OwnSignIn;

    private string SignInStatus => IsSelf
        ? OwnSignIn?.Email ?? "Managed in Security"
        : OwnSignIn?.Email ?? "Switches from Who's watching";

    private string? SignInNote => OwnSignIn is { MustChangePassword: true } ? "Must change password at first sign-in" : null;

    // Their access is only theirs to manage when they have a sign-in of their own; your own access is never edited from here.
    private bool ShowHouseholdAccess => IsAdministrator && !IsSelf && OwnSignIn is not null;

    // A person's own sign-in follows the household's main sign-in (the Engine reads its access from there and refuses to change it
    // on the own sign-in), so the access is shown read-only. Only an account that keeps its own access gets the editable sheet.
    private bool AccessFollowsHousehold => _access is { GrantsInheritFromAccountId: not null };

    private const string HouseholdAccessRoute = "/settings/access/users";

    // Users & Access (where the main sign-in's access is changed) is a server-administrator page.
    private bool CanOpenHouseholdSettings => Session.HasNavigation("settings.administration");

    // The profile editor saves through administrator-only Engine actions; a member's rename/avatar route may come later.
    private bool CanEditDetails => IsAdministrator;

    private string? AccessStatus
    {
        get
        {
            if (_access is null)
            {
                return null;
            }

            var lanes = ManagedAccessUserPermissions.Features
                .Where(feature => _access.FeatureGrants.Any(grant => grant.Allowed && grant.Feature == feature.Id))
                .Select(feature => feature.Label)
                .ToList();
            var libraries = _access.LibraryGrants.Count(grant => grant.Allowed);
            var laneText = lanes.Count == 0 ? "No lanes" : string.Join(", ", lanes);
            return $"{laneText} · {libraries} {(libraries == 1 ? "library" : "libraries")}";
        }
    }

    private bool IsAdministrator => Session.HasAction("household.manage") || Session.HasNavigation("settings.administration");

    private bool IsSelf => _active is not null && _active.Id == ProfileId;

    private string RoleLabel => IsSelf && Session.Authority?.EffectiveAdministrator == true
        ? "Administrator"
        : _person?.IsRestricted == true ? "Kids profile" : "Profile";

    private int HouseholdCount
    {
        get
        {
            var household = _managed.FirstOrDefault(person => person.Id == ProfileId)?.HouseholdId;
            return household is null ? _managed.Count : _managed.Count(person => person.HouseholdId == household);
        }
    }

    // Deleting is an administrator action, so it is only offered to someone who can manage people.
    private bool CanDelete => _person is { } person && _active is { } active
        && ProfileManageRules.CanManage(active.IsRestricted, IsAdministrator)
        && ProfileManageRules.CanDelete(person, active.Id, HouseholdCount);

    private string DetailsStatus
    {
        get
        {
            if (_person is null)
            {
                return string.Empty;
            }

            var limit = string.IsNullOrWhiteSpace(_person.ContentLimit) ? "Everything" : _person.ContentLimit;
            var status = _person.IsRestricted ? $"Kids · {limit}" : limit;
            return _person.HasPin ? $"{status} · PIN set" : status;
        }
    }

    private string? PlaybackStatus => _settings is null ? null
        : $"Autoplay {(_settings.Watching.AutoplayNextEpisode ? "on" : "off")} · Skip {_settings.Watching.SkipBackSeconds} s / {_settings.Watching.SkipForwardSeconds} s";

    private string? ListeningStatus => _settings is null ? null
        : $"Skip {_settings.Listening.SkipBackSeconds} s / {_settings.Listening.SkipForwardSeconds} s · Sleep {SleepLabel(_settings.Listening.DefaultSleepTimer)}";

    private string? ReadingStatus => _settings?.Reading.ReadingMode;

    private string? SubtitlesStatus => _settings is null ? null
        : $"{_settings.Subtitles.DefaultSubtitleLanguage} · {_settings.Subtitles.SubtitleSize}";

    // Your own pages omit ?profile=, so they keep working exactly as they do from the sidebar.
    private string PreferenceLink(string page, string fragment = "") =>
        IsSelf ? $"/settings/{page}{fragment}" : $"/settings/{page}?profile={ProfileId:D}{fragment}";

    private static string SleepLabel(string value) => value switch
    {
        PlaybackPreferenceValues.Off => "off",
        PlaybackPreferenceValues.EndOfChapter => "end of chapter",
        PlaybackPreferenceValues.EndOfEpisode => "end of episode",
        _ when int.TryParse(value, out var minutes) => $"{minutes} min",
        _ => value,
    };

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == ProfileId)
        {
            return;
        }

        _loadedFor = ProfileId;
        _notice = null;
        _person = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = _person is null;
        _forbidden = false;
        try
        {
            _active = await Orchestrator.GetActiveProfileAsync();
            if (_active is null)
            {
                _person = null;
                return;
            }

            var canManage = ProfileManageRules.CanManage(_active.IsRestricted, IsAdministrator);
            if (ProfileId != _active.Id && !canManage)
            {
                Nav.NavigateTo(SettingsProfilesRoute, replace: true);
                return;
            }

            if (canManage)
            {
                var profiles = Orchestrator.GetProfilesAsync();
                var managed = Identity.GetManagedProfilesAsync();
                _profiles = await profiles;
                _managed = await managed;
            }

            _person = FindPerson();
            if (_person is null && ProfileId != _active.Id)
            {
                // Not someone this administrator can see (or no longer there): back to the list rather than a blank page.
                Nav.NavigateTo(SettingsProfilesRoute, replace: true);
                return;
            }

            if (_person is not null)
            {
                await NameChanged.InvokeAsync(_person.DisplayName);
                await LoadSettingsAsync();
                await LoadAccessAsync();
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not load the profile page.");
            _person = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private ProfileViewModel? FindPerson()
    {
        if (_active is { } active && active.Id == ProfileId)
        {
            return _profiles.FirstOrDefault(profile => profile.Id == ProfileId) ?? active;
        }

        var person = _managed.FirstOrDefault(known => known.Id == ProfileId);
        if (person is null)
        {
            return null;
        }

        // The sheet works with the picker's profile shape, so use the full profile when we have it and fill the rest in.
        return _profiles.FirstOrDefault(profile => profile.Id == person.Id)
            ?? new ProfileViewModel(person.Id, person.DisplayName, person.AvatarColor,
                person.IsRestricted ? "RestrictedProfile" : "Profile", person.CreatedAt,
                AvatarIcon: person.AvatarIcon, ContentLimit: person.ContentLimit,
                ContentLimitAllowUnrated: person.ContentLimitAllowUnrated);
    }

    private async Task LoadSettingsAsync()
    {
        _settings = await ApiClient.GetPlaybackSettingsAsync(ProfileId);

        // The Engine says no (403) when this person's settings are off limits; the client keeps the reason, not the status code.
        _forbidden = _settings is null
            && !IsSelf
            && ApiClient.LastError?.Contains("403", StringComparison.Ordinal) == true;
    }

    private async Task RefreshPeopleAsync()
    {
        try
        {
            // The list of people a sign-in may open comes from its authority, so refresh that first.
            await Identity.RevalidateAuthorityAsync(Session);
            await Orchestrator.RefreshProfilesAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not refresh the profile list.");
            _notice = "The change was saved, but the page couldn't be refreshed. Reload the page to see the latest.";
        }
    }

    private async Task LoadAccessAsync()
    {
        _access = null;
        if (!ShowHouseholdAccess || OwnSignIn is not { } signIn)
        {
            return;
        }

        try
        {
            var accounts = await Identity.GetManagedAccountsAsync();
            _access = accounts.FirstOrDefault(account => account.Id == signIn.AccountId);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not load this person's access.");
        }
    }

    private async Task OpenAccess()
    {
        _accessError = null;
        _accessMessage = null;
        _accessLoading = true;
        _accessOpen = true;
        try
        {
            // The list is what this administrator may hand out, so a Library the household lacks is never offered.
            var libraries = Identity.GetAccessLibrariesAsync();
            await LoadAccessAsync();
            _accessLibraries = await libraries;
            if (AccessFollowsHousehold)
            {
                // Found out only now that this access follows the household: there is nothing to edit here.
                _accessOpen = false;
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not load the Libraries to choose from.");
            _accessError = "The Engine is unavailable. Try again.";
        }
        finally
        {
            _accessLoading = false;
        }
    }

    private void CloseAccess()
    {
        if (!_accessSaving)
        {
            _accessOpen = false;
            _accessError = null;
        }
    }

    private async Task SaveAccessAsync(ReplaceAccountAccessRequest request)
    {
        if (_accessSaving || AccessFollowsHousehold || OwnSignIn is not { } signIn)
        {
            return;
        }

        _accessSaving = true;
        _accessError = null;
        try
        {
            var result = await Identity.ReplaceManagedAccountAccessResultAsync(signIn.AccountId, request);
            if (!result.Succeeded)
            {
                _accessError = AccessFailureMessage(result.Failure);
                return;
            }

            await LoadAccessAsync();
            _accessOpen = false;
            Toasts.Add($"Access for {PersonName} was saved.", AppSeverity.Success);
        }
        finally
        {
            _accessSaving = false;
        }
    }

    // For someone who lost their phone and their recovery codes. The Engine records who did this.
    private async Task ResetTwoStepAsync()
    {
        if (OwnSignIn is not { } signIn)
        {
            return;
        }

        _accessMessage = null;
        if (await Dialogs.ShowMessageBoxAsync($"Turn off two-step codes for {PersonName}?",
                "They can sign in with just their password until they turn two-step codes on again. This is recorded in the activity log.",
                yesText: "Turn off", cancelText: "Cancel") != true)
        {
            return;
        }

        var result = await Confirmed.RunAsync(() => Identity.ResetAccountTwoStepResultAsync(signIn.AccountId));
        if (result.Succeeded && result.Value is not null)
        {
            _access = result.Value;
            Toasts.Add($"Two-step codes are off for {PersonName}.", AppSeverity.Success);
            return;
        }

        _accessMessage = result.Failure == DashboardAccessMutationFailure.ConfirmItsYou
            ? "Nothing was changed. Confirm it's you to continue."
            : AccessFailureMessage(result.Failure);
    }

    private static string AccessFailureMessage(DashboardAccessMutationFailure failure) => failure switch
    {
        DashboardAccessMutationFailure.Validation or DashboardAccessMutationFailure.Forbidden
            => "That wasn't saved. You can only give what your household has, and only to people in it.",
        DashboardAccessMutationFailure.Conflict => "This change conflicts with the current account state.",
        DashboardAccessMutationFailure.Unauthorized => "Your session has expired.",
        DashboardAccessMutationFailure.NotFound => "This account no longer exists.",
        DashboardAccessMutationFailure.Transient => "The Engine is unavailable. Try again.",
        _ => "The change could not be saved. Try again.",
    };

    private void OpenEditor()
    {
        _editorError = null;
        _startInDelete = false;
        _editorOpen = true;
    }

    private void OpenDelete()
    {
        _editorError = null;
        _startInDelete = true;
        _editorOpen = true;
    }

    private void OpenSignIn()
    {
        _signInError = null;
        _signInIssued = null;
        _signInOpen = true;
    }

    private void CloseSignIn()
    {
        if (_signInSaving)
        {
            return;
        }

        _signInOpen = false;
        _signInError = null;
        _signInIssued = null;
    }

    private string PersonName => _person?.DisplayName ?? "This person";

    private Task GiveSignInAsync(SignInGiveChoice choice) =>
        RunSignInAsync(afterUnlock => SignInWorkflow.GiveAsync(ProfileId, PersonName, choice.Email, choice.Password,
            choice.MustChangePassword, invite: false, afterUnlock));

    private Task InviteSignInAsync(SignInGiveChoice choice) =>
        RunSignInAsync(afterUnlock => SignInWorkflow.GiveAsync(ProfileId, PersonName, choice.Email, null,
            choice.MustChangePassword, invite: true, afterUnlock));

    private Task SetSignInPasswordAsync(SignInPasswordChoice choice) =>
        OwnSignIn is { } signIn
            ? RunSignInAsync(afterUnlock => SignInWorkflow.SetPasswordAsync(signIn.AccountId, PersonName, choice.Password,
                choice.MustChangePassword, afterUnlock))
            : Task.CompletedTask;

    private Task ChangeSignInEmailAsync(string email) =>
        OwnSignIn is { } signIn
            ? RunSignInAsync(afterUnlock => SignInWorkflow.ChangeEmailAsync(signIn.AccountId, PersonName, email, afterUnlock))
            : Task.CompletedTask;

    private Task RemoveSignInAsync() =>
        OwnSignIn is { } signIn
            ? RunSignInAsync(afterUnlock => SignInWorkflow.RemoveAsync(signIn.AccountId, PersonName, afterUnlock))
            : Task.CompletedTask;

    private async Task RunSignInAsync(Func<bool, Task<SignInOutcome>> action, bool afterUnlock = false)
    {
        if (_signInSaving)
        {
            return;
        }

        _signInSaving = true;
        _signInError = null;
        try
        {
            var outcome = await action(afterUnlock);
            if (outcome.NeedsUnlock)
            {
                _needsUnlock = true;
                _unlockError = null;
                _afterUnlock = () => RunSignInAsync(action, afterUnlock: true);
                return;
            }

            _signInError = outcome.Error;
            if (!outcome.Done)
            {
                return;
            }

            _signInIssued = outcome.Issued;
            if (outcome.Notice is not null)
            {
                _notice = outcome.Notice;
            }

            await ReloadManagedAsync();

            // A password or invitation is shown once, so the sheet stays until Done; everything else closes it.
            if (outcome.Issued is null)
            {
                _signInOpen = false;
            }
        }
        finally
        {
            _signInSaving = false;
        }
    }

    private async Task ReloadManagedAsync()
    {
        try
        {
            _managed = await Identity.GetManagedProfilesAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not refresh the sign-in details.");
            _notice = "The change was saved, but the page couldn't be refreshed. Reload the page to see the latest.";
        }
    }

    private void CloseEditor()
    {
        if (!_editorSaving)
        {
            _editorOpen = false;
            _editorError = null;
        }
    }

    private Task SaveEditorAsync(ProfileEditorResult result)
    {
        _justUnlocked = false;
        return SaveAsync(result);
    }

    private Task DeleteAsync(bool keepPhotos)
    {
        _justUnlocked = false;
        return RemoveAsync(keepPhotos);
    }

    private async Task SaveAsync(ProfileEditorResult result)
    {
        if (_editorSaving || _person is null)
        {
            return;
        }

        _editorSaving = true;
        _editorError = null;
        try
        {
            var householdId = _managed.FirstOrDefault(person => person.Id == ProfileId)?.HouseholdId;
            var outcome = await Workflow.SaveAsync(_person, householdId, result, _justUnlocked);
            await FinishAsync(outcome, () => SaveAsync(result), deleted: false);
        }
        finally
        {
            _editorSaving = false;
        }
    }

    private async Task RemoveAsync(bool keepPhotos)
    {
        if (_person is not { } profile || _editorSaving)
        {
            return;
        }

        _editorSaving = true;
        _editorError = null;
        try
        {
            var outcome = await Workflow.RemoveAsync(profile, keepPhotos, _justUnlocked);
            await FinishAsync(outcome, () => RemoveAsync(keepPhotos), deleted: true);
        }
        finally
        {
            _editorSaving = false;
        }
    }

    private async Task FinishAsync(ProfileEditOutcome outcome, Func<Task> retry, bool deleted)
    {
        if (outcome.NeedsUnlock)
        {
            _needsUnlock = true;
            _unlockError = null;
            _afterUnlock = retry;
            return;
        }

        _editorError = outcome.Error;
        if (outcome.Notice is not null)
        {
            _notice = outcome.Notice;
        }

        if (!outcome.Done)
        {
            return;
        }

        _editorOpen = false;
        await RefreshPeopleAsync();
        if (deleted)
        {
            // This page has nothing left to show, so go back to the list.
            Nav.NavigateTo(SettingsProfilesRoute);
            return;
        }

        await LoadAsync();
    }

    private async Task UnlockAsync(string pin)
    {
        if (_unlocking)
        {
            return;
        }

        _unlocking = true;
        _unlockError = null;
        try
        {
            var unlocked = await Identity.UnlockAdministratorAsync(new GrantAdminUnlockRequest(pin));
            if (unlocked?.Unlocked != true)
            {
                _unlockError = "That PIN didn't work. Try again.";
                return;
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not unlock administrator access from a profile page.");
            _unlockError = "The Engine is unavailable. Try again.";
            return;
        }
        finally
        {
            _unlocking = false;
        }

        var retry = _afterUnlock;
        _needsUnlock = false;
        _afterUnlock = null;
        _justUnlocked = true;
        if (retry is not null)
        {
            await retry();
        }
    }

    private void CancelUnlock()
    {
        _needsUnlock = false;
        _afterUnlock = null;
        _unlockError = null;
    }
}
