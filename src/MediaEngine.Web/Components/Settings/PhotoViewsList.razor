@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.LocalAssets
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient
@inject IStringLocalizer<SharedStrings> L
@* Settings > Security > Who viewed your photos (the sheet body). A server administrator can open another household's
   photos through "Other people"; every look is recorded and listed here for the person whose photos were opened (and
   the household's Shared Library for the household's own administrator). The Engine answers only for the signed-in
   person, newest first; this list has no delete or clear control by design. *@
@if (_loading)
{
    <AppSkeleton Size="AppControlSize.Compact" aria-label="@L["PhotoViewsList_LoadingWhoViewedYourPhotos"].Value" />
}
else if (_loadFailed)
{
    <AppAlert Tone="AppUiTone.Error">@L["PhotoViewsList_ThisListCouldNotBe"]</AppAlert>
}
else
{
    <p class="security-sheet__hint">@Description</p>
    @if (_items.Count == 0)
    {
        <AppEmptyState Class="app-page-state--compact" Title="@L["PhotoViewsList_NobodyElseHasLookedAt"].Value"
                       Message="@L["PhotoViewsList_IfAServerAdministratorEver"].Value" />
    }
    else
    {
        <AppTable CardsOn="AppTableCardsMode.Phone">
            <caption class="sr-only">@L["PhotoViewsList_WhoViewedYourPhotosNewest"]</caption>
            <thead>
                <tr>
                    <th data-card-role="title">@L["PhotoViewsList_Who"]</th>
                    <th data-card-role="subtitle">@L["PhotoViewsList_Opened"]</th>
                    <th data-card-role="value">@L["Common_When"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var view in _items)
                {
                    <tr @key="view.Id">
                        <td data-card-role="title">@view.ViewerName</td>
                        <td data-card-role="subtitle">@view.Opened</td>
                        <td data-card-role="value">@FormatWhen(view.ViewedAt)</td>
                    </tr>
                }
            </tbody>
        </AppTable>
        @if (_loadMoreFailed)
        {
            <AppAlert Tone="AppUiTone.Error">@L["PhotoViewsList_CouldnTLoadMoreTry"]</AppAlert>
        }
        @if (_hasMore && _items.Count < MaxItems)
        {
            <AppButton Label="@L["Common_ShowMore"].Value" Loading="@_loadingMore" Disabled="@_loadingMore" OnClick="LoadMoreAsync" />
        }
        else if (_items.Count >= MaxItems)
        {
            <p class="security-sheet__hint">@L["PhotoViewsList_ShowingTheLatest", MaxItems]</p>
        }
    }
}

@code {
    private const int PageSize = 25;
    private const int MaxItems = 100;
    private readonly List<ViewPhotoViewDto> _items = [];
    private bool _loading = true;
    private bool _loadingMore;
    private bool _loadFailed;
    private bool _loadMoreFailed;
    private bool _hasMore;
    private bool _includesSharedLibrary;

    private string Description => _includesSharedLibrary
        ? "Times a server administrator opened your photos or your household's Shared Library, newest first. They can look but never change anything."
        : "Times a server administrator opened your photos, newest first. They can look but never change anything.";

    protected override async Task OnInitializedAsync()
    {
        var page = await ApiClient.GetViewPhotoViewsAsync(0, PageSize);
        if (page is null)
        {
            _loadFailed = true;
        }
        else
        {
            Add(page);
        }

        _loading = false;
    }

    private async Task LoadMoreAsync()
    {
        _loadingMore = true;
        _loadMoreFailed = false;
        var page = await ApiClient.GetViewPhotoViewsAsync(_items.Count, Math.Min(PageSize, MaxItems - _items.Count));
        if (page is null)
        {
            _loadMoreFailed = true;
        }
        else
        {
            Add(page);
        }

        _loadingMore = false;
    }

    // The Dashboard has no browser time zone of its own, and the audit trail should read the same on every device: UTC, labelled.
    private static string FormatWhen(DateTimeOffset when) =>
        when.UtcDateTime.ToString("g", System.Globalization.CultureInfo.CurrentCulture) + " UTC";

    private void Add(ViewPhotoViewsPageDto page)
    {
        _items.AddRange(page.Page.Items);
        _hasMore = page.Page.HasMore;
        _includesSharedLibrary = page.HouseholdWide;
    }
}
