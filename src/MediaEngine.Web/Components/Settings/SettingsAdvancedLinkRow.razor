@namespace MediaEngine.Web.Components.Settings

@* A settings row whose control is a link to another page: label and helper left, the link at the right end. *@
<AppSettingRow Label="@Title" Helper="@Description">
    <Control>
        <a class="settings-advanced-link-row__action" href="@Href">
            <span>@ActionLabel</span>
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" Size="AppSize.Small" aria-hidden="true" />
        </a>
    </Control>
</AppSettingRow>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Href { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string ActionLabel { get; set; } = "Open";
}
