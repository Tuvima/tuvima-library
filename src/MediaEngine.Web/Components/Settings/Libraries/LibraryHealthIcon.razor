@namespace MediaEngine.Web.Components.Settings

@* A green tick when every folder is healthy, an amber warning icon when not. Nothing at all while the folders have not been
   checked yet (a tick must never claim health that is not known). Never colour alone: the icon changes shape and carries an
   accessible name either way. The warning's words open as a tooltip on the link that holds this icon (hover and keyboard focus). *@
@if (Health is { Healthy: true })
{
    <span class="lib-health lib-health--ok" role="img" aria-label="@HealthyLabel"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CheckCircle" /></span>
}
else if (Health is not null)
{
    <span class="lib-health lib-health--warning" role="img" aria-label="@Health.Text"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Warning" /></span>
}

@code {
    /// <summary>The state to show; null while it is not known, which draws nothing.</summary>
    [Parameter] public LibraryHealth? Health { get; set; }
    /// <summary>The words for the tick, for example "All folders healthy".</summary>
    [Parameter] public string HealthyLabel { get; set; } = "All folders healthy";
}
