@namespace MediaEngine.Web.Components.Settings

@* One quiet line at the bottom of a Libraries screen: only the icons that screen uses, each with a word. No box, no paragraph. *@
<p class="lib-legend" aria-label="Icon guide">
    @if (ShowHandling)
    {
        <span class="lib-legend__item"><span class="lib-legend__icon"><AppMaterialIcon Icon="@AppMaterialIcons.Filled.Lock" /></span>Read-only</span>
        <span class="lib-legend__item"><span class="lib-legend__icon"><AppMaterialIcon Icon="@AppMaterialIcons.Filled.Folder" /></span>Managed</span>
    }
    @if (ShowHealth)
    {
        <span class="lib-legend__item"><span class="lib-legend__icon lib-legend__icon--ok"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CheckCircle" /></span>Healthy</span>
        <span class="lib-legend__item"><span class="lib-legend__icon lib-legend__icon--warning"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Warning" /></span>Warning</span>
    }
</p>

@code {
    /// <summary>The Read-only and Managed folder icons (the type page's folder table).</summary>
    [Parameter] public bool ShowHandling { get; set; }
    /// <summary>The Healthy tick and Warning icon (the front door and group pages).</summary>
    [Parameter] public bool ShowHealth { get; set; }
}
