@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Components.Navigation
@using MediaEngine.Web.Services.Integration
@implements IDisposable
@inject IServiceProvider Services
@inject DashboardSessionAccessor Session
@inject IStringLocalizer<SharedStrings> L

@* The scan card (Libraries and folder picker, point 2; Library activity D4): idle it reads "Idle · Library is up to date · last activity ..." with no bar; while
   the Engine is working it names what is happening, shows a bar with the percent, and View activity opens the Activity page (administrators only). It reads the
   same shell activity the top bar's ring reads, so the two always agree. *@
<section class="lib-scan" data-scan-card data-state="@(Snapshot.IsWorking ? "working" : "idle")" aria-live="polite">
    <span class="@(Snapshot.IsWorking ? "lib-scan__icon is-working" : "lib-scan__icon")"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Sync" /></span>
    <div class="lib-scan__text">
        <strong class="lib-scan__title">@Title</strong>
        <span class="lib-scan__line">@Line</span>
        @if (Snapshot.IsWorking && Snapshot.Primary?.ProgressPercent is { } percent)
        {
            <AppProgressBar Value="@percent" ShowValue="true" Rounded="true" Label="@L["LibraryScanCard_Progress"].Value" />
        }
    </div>
    @if (CanOpenActivity)
    {
        <a class="lib-scan__link" href="/settings/library-activity" data-view-activity>@L["LibraryScanCard_ViewActivity"]</a>
    }
</section>

@code {
    // The shell's activity feed; a host without one (a plain test host) simply shows the idle card.
    private ShellActivityState? Activity => Services.GetService(typeof(ShellActivityState)) as ShellActivityState;
    private ShellActivitySnapshot Snapshot => Activity?.Current ?? new ShellActivitySnapshot([]);
    private bool CanOpenActivity => Session.HasNavigation("settings.administration");
    private string Title => Snapshot.IsWorking ? L["LibraryScanCard_Working"].Value : L["LibraryScanCard_Idle"].Value;
    private string Line => SystemActivityText.Tooltip(Snapshot, DateTimeOffset.UtcNow);

    protected override void OnInitialized()
    {
        if (Activity is { } feed) feed.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (Activity is { } feed) feed.Changed -= OnChanged;
    }
}
