@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IStringLocalizer<SharedStrings> L
@inject MediaEngine.Web.Services.Theming.DeviceContextService DeviceContext
@implements IDisposable

@* "N folders" as a button (Libraries and folder picker D3): it opens a small list of the library's real paths, each on one line: a green check when Library can reach it
   or an amber triangle with the reason under the path, the path shortened in the middle (its full path is the tooltip), a grey lock (Read-only) or a purple pencil
   (Managed) and a copy button; with two or more folders each shows its friendly name above its path. It never navigates. Enter or Space opens it, Esc closes it; on a phone the list is a bottom sheet. *@
<span class="lib-folders" @onclick:stopPropagation="true">
    <span @ref="_anchor" class="lib-folders__anchor">
    <AppButton Label="@Label"
               EndIcon="@AppMaterialIcons.Outlined.ExpandMore"
               ButtonStyle="AppButtonStyle.Text"
               Size="AppControlSize.Compact"
               Class="lib-folders__button"
               aria-haspopup="dialog"
               aria-expanded="@(_open ? "true" : "false")"
               data-folder-count
               OnClick="Toggle" />
    </span>
    @if (_open && DeviceContext.IsPhone)
    {
        @* Phones: the list is a bottom sheet (D13). *@
        <AppDialogFrame Open="true" Title="@PanelLabel" DialogOptions="SheetOptions" Class="lib-folders__sheet" OnCancel="CloseAsync">
            @ListBody
        </AppDialogFrame>
    }
    else if (_open)
    {
        @* Drawn through the shared popover so it sits in the top layer and no table row or card can clip it. *@
        <AppPopover Open="true" OpenChanged="PopoverChanged" Anchor="_anchor" Size="AppPopoutSize.Panel" Role="dialog" AriaLabel="@PanelLabel" Class="lib-folders__panel">
            <div data-folder-list @onkeydown="KeyDown">
                @ListBody
            </div>
        </AppPopover>
    }
</span>

@code {
    private RenderFragment ListBody => __builder =>
    {
            <div class="lib-folders__inner">
            <ul class="lib-folders__list">
                @foreach (var source in Rows)
                {
                    var issue = IssueFor(source);
                    var (pathStart, pathEnd) = SplitPath(source.Path);
                    <li class="lib-folders__item" data-source="@source.Id" data-state="@(Reachable(issue) ? "online" : "offline")">
                        @if (Reachable(issue))
                        {
                            <AppTooltip Text="@ReachableWords">
                                <span class="lib-folders__icon lib-folders__icon--ok" role="img" aria-label="@ReachableWords" data-folder-status="reachable"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CheckCircle" /></span>
                            </AppTooltip>
                        }
                        else
                        {
                            <AppTooltip Text="@UnreachableWords">
                                <span class="lib-folders__icon lib-folders__icon--warn" role="img" aria-label="@UnreachableWords" data-folder-status="unreachable"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Warning" /></span>
                            </AppTooltip>
                        }
                        <span class="lib-folders__body">
                            @if (ShowNames && !string.IsNullOrWhiteSpace(source.Name))
                            {
                                <strong class="lib-folders__name" data-folder-name>@source.Name</strong>
                            }
                            <AppTooltip Text="@source.Path">
                                <span class="lib-folders__path" data-folder-path="@source.Path"><span class="lib-folders__path-start">@pathStart</span>@if (pathEnd.Length > 0){<span class="lib-folders__path-end">@pathEnd</span>}</span>
                            </AppTooltip>
                            @if (issue is not null)
                            {
                                <span class="lib-folders__why" data-folder-reason data-overflow-tooltip="@ReasonText(issue)">@ReasonText(issue)</span>
                            }
                        </span>
                        @if (source.Managed is { } managed)
                        {
                            var handling = HandlingWords(managed);
                            <AppTooltip Text="@handling">
                                <span class="@(managed ? "lib-folders__icon lib-folders__icon--managed" : "lib-folders__icon")" role="img" aria-label="@handling" data-handling="@(managed ? "managed" : "read-only")"><AppMaterialIcon Icon="@(managed ? AppMaterialIcons.Outlined.Edit : AppMaterialIcons.Outlined.Lock)" /></span>
                            </AppTooltip>
                        }
                        <AppIconButton Icon="@AppMaterialIcons.Outlined.ContentCopy"
                                       ButtonStyle="AppButtonStyle.Text"
                                       Tooltip="@L["LibraryFoldersPopover_CopyPath"].Value"
                                       AriaLabel="@L["LibraryFoldersPopover_CopyThisPath", source.Path].Value"
                                       OnClick="@(() => CopyAsync(source.Path))" />
                    </li>
                }
            </ul>
            <div class="lib-folders__foot">
                <span aria-live="polite">@_copied</span>
                <AppButton Label="@L["LibraryFoldersPopover_Close"].Value" ButtonStyle="AppButtonStyle.Text" Size="AppControlSize.Compact" OnClick="Close" />
            </div>
            </div>
    };

    /// <summary>A library's folders; use <see cref="Items"/> instead for folders that are not a library's (View folders).</summary>
    [Parameter] public IReadOnlyList<LibrarySourceDto> Sources { get; set; } = [];
    /// <summary>The same list from neutral items (View folders spec D5); when set it is shown instead of <see cref="Sources"/>.</summary>
    [Parameter] public IReadOnlyList<FolderListItem>? Items { get; set; }
    [Parameter] public string LibraryName { get; set; } = "library";
    /// <summary>Folder path to its problem (offline, no access); null while the folder checks have not finished, so nothing is claimed.</summary>
    [Parameter] public IReadOnlyDictionary<string, string>? PathIssues { get; set; }

    private bool _open;
    private string? _copied;
    private ElementReference _anchor;
    private static readonly AppDialogOptions SheetOptions = new() { Sheet = AppDialogSheetMode.Phone, BackdropClick = true, CloseOnEscapeKey = true };

    protected override void OnInitialized() => DeviceContext.OnChanged += DeviceChanged;
    public void Dispose() => DeviceContext.OnChanged -= DeviceChanged;
    private void DeviceChanged() => _ = InvokeAsync(StateHasChanged);
    private void PopoverChanged(bool open) => _open = open;
    private Task CloseAsync()
    {
        _open = false;
        return Task.CompletedTask;
    }

    private IReadOnlyList<FolderListItem> Rows => Items ?? [.. Sources.Select(source => new FolderListItem(
        source.Id, source.Path, Name: source.DisplayName(), Managed: string.Equals(source.ManagementMode, "managed_by_tuvima", StringComparison.OrdinalIgnoreCase)))];

    // A folder's name shows only once the library has two or more folders (Libraries v3 D18); with one the path and its handling tag are enough.
    private bool ShowNames => Rows.Count >= 2;

    private string Label => Rows.Count == 1 ? L["LibraryFoldersPopover_OneFolder"].Value : L["LibraryFoldersPopover_ManyFolders", Rows.Count].Value;
    private string PanelLabel => L["LibraryFoldersPopover_FoldersOf", LibraryName].Value;

    private string ReachableWords => L["LibraryFoldersPopover_Reachable"].Value;
    private string UnreachableWords => L["LibraryFoldersPopover_Unreachable"].Value;
    private static string HandlingWords(bool managed) => $"{FolderHandlingWords.LabelFor(managed)}: {FolderHandlingWords.ExplainerFor(managed)}";

    // A long path keeps its start and its last segments visible: the start is the part that is cut with an ellipsis (CSS), the end never is.
    private const int PathEndLength = 28;

    private static (string Start, string End) SplitPath(string path)
    {
        if (path.Length <= PathEndLength) return (path, string.Empty);
        var trimmed = path.TrimEnd('\\', '/');
        var lastSeparator = trimmed.LastIndexOfAny(['\\', '/']);
        var cut = lastSeparator > 0 ? trimmed.LastIndexOfAny(['\\', '/'], lastSeparator - 1) : -1;
        if (cut <= 0 || path.Length - cut > PathEndLength) cut = path.Length - PathEndLength;
        return (path[..cut], path[cut..]);
    }

    // A folder waiting for its lookup source is still reachable: it keeps the green check and says what it is waiting for (D4 keeps the triangle for folders
    // Library cannot reach).
    private static bool Reachable(string? issue) => issue is null or LibraryFolderHealth.WaitingForSource;

    // The short status word becomes a sentence that says what to try (D4, the folder status mock).
    private string ReasonText(string issue) => issue switch
    {
        LibraryFolderHealth.Unavailable => L["LibraryFoldersPopover_NotFound"].Value,
        LibraryFolderHealth.NoAccess => L["FolderPicker_CantOpen"].Value,
        _ => issue,
    };

    private string? IssueFor(FolderListItem source) => source.Issue ?? (PathIssues is not null && PathIssues.TryGetValue(source.Path, out var issue) ? issue : null);

    private void Toggle()
    {
        _open = !_open;
        _copied = null;
    }

    private void Close() => _open = false;

    private void KeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") _open = false;
    }

    private async Task CopyAsync(string path)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", path);
            _copied = L["LibraryFoldersPopover_Copied"].Value;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            _copied = L["LibraryFoldersPopover_CouldNotCopy"].Value;
        }
    }
}
