@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Library
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Services.Ui
@inject NavigationManager Navigation
@inject IAppDialogService DialogService
@inject LibraryFolderAddService AddService

@* The Libraries overview (Library pages D2, D17, D19; library setup D0b): icon buttons for the areas (Watch, Listen, Read, View, and the Vault for
   someone who may open it), then one table of that area's libraries, one row per library. The whole row opens the library; the name is the real link
   for the keyboard. The selected area lives in the address (?area=). A Vault library is listed only inside the Vault area. A library that was just
   added glows for about two seconds (no toast). First-run setup draws this same table with Simple on (Library pages D13): Watch, Listen and Read
   only, no Vault, rows that do not open a page (a library's page belongs to Settings), no Import folder line, and Add library saves through the
   setup session. *@
<div class="libs">
    @if (ReadOnly)
    {
        <p class="libs__note">Use a desktop or tablet to change folders.</p>
    }

    @if (_addError is not null)
    {
        <AppAlert Severity="AppSeverity.Warning" Variant="AppVariant.Outlined">@_addError</AppAlert>
    }

    <AppSegmentedControl Options="AreaOptions"
                         Value="@SelectedArea.Key"
                         ValueChanged="SelectArea"
                         AriaLabel="Library areas"
                         Class="libs__areas" />

    @{ var area = SelectedArea; var all = AreaRows; var rows = VisibleRows; }
    @if (all.Count == 0)
    {
        <AppPageState Kind="AppPageStateKind.Empty"
                      Icon="@area.Icon"
                      Title="@($"No {area.Label} libraries yet")"
                      Message="@(ReadOnly ? "Use a desktop or tablet to add one." : null)">
            <Actions>
                @if (CanAddLibrary)
                {
                    <AppButton Label="Add library"
                               StartIcon="@AppMaterialIcons.Outlined.Add"
                               ButtonStyle="AppButtonStyle.Filled"
                               Tone="AppUiTone.Primary"
                               OnClick="OpenAddLibraryAsync" />
                }
            </Actions>
        </AppPageState>
    }
    else
    {
        <div class="libs__toolbar">
            <div class="libs__search">
                <AppSearchField Label="Search libraries"
                                HideLabel="true"
                                Placeholder="Search libraries"
                                Value="@_search"
                                ValueChanged="@((string? value) => _search = value ?? string.Empty)" />
            </div>
            <div class="libs__filter">
                <AppSelect Label="Status"
                           HideLabel="true"
                           AriaLabel="Filter by status"
                           Value="@_status"
                           ValueChanged="@((string? value) => _status = value ?? string.Empty)"
                           Options="StatusOptions"
                           Size="AppControlSize.Compact" />
            </div>
            @if (CanAddLibrary)
            {
                <AppButton Label="Add library"
                           StartIcon="@AppMaterialIcons.Outlined.Add"
                           ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary"
                           OnClick="OpenAddLibraryAsync" />
            }
        </div>

        @if (rows.Count == 0)
        {
            <AppPageState Kind="AppPageStateKind.Empty" Icon="@AppMaterialIcons.Outlined.Search" Title="No libraries match" Message="Try a different search or status." />
        }
        else
        {
            <AppTable Hover="true" CardsOn="AppTableCardsMode.Phone" Class="libs__table" data-area="@area.Key">
                <caption class="sr-only">@area.Label libraries</caption>
                <thead>
                    <tr>
                        <th data-card-role="title">Name</th>
                        <th data-card-role="subtitle">Content type</th>
                        <th>Folders and titles</th>
                        <th data-card-role="value">Status</th>
                        @if (!Simple)
                        {
                            <th data-card-role="hidden"><span class="sr-only">Open</span></th>
                        }
                        else if (CanAddFolder)
                        {
                            <th data-card-role="hidden"><span class="sr-only">Add folder</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        <tr @key="row.Key" class="@RowClass(row)" data-library="@row.Key" data-new="@(row.Key == _newLibraryId ? "true" : null)" @onclick="@(() => OpenRow(row))">
                            <td data-card-role="title">
                                <span class="libs__name">
                                    <span class="@LibraryKindLook.TileClass(row.Type)"><AppMaterialIcon Icon="@row.Type.Icon" /></span>
                                    @if (Simple)
                                    {
                                        <span class="libs__link">@row.Name</span>
                                    }
                                    else
                                    {
                                        <a href="@row.Href" class="libs__link" aria-label="@AccessibleName(row)" @onclick:stopPropagation="true">@row.Name</a>
                                    }
                                    @if (row.Access == LibraryListing.Vault)
                                    {
                                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Lock" Class="libs__lock" />
                                    }
                                </span>
                            </td>
                            <td data-card-role="subtitle">
                                <span class="libs__type"><AppMaterialIcon Icon="@row.Type.Icon" />@row.Type.Label</span>
                            </td>
                            <td class="libs__counts">@CountsFor(row)</td>
                            <td data-card-role="value">
                                <LibraryStatusCell Row="@row" />
                            </td>
                            @if (!Simple)
                            {
                                <td data-card-role="hidden" class="libs__chevron"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" /></td>
                            }
                            else if (CanAddFolder)
                            {
                                <td data-card-role="hidden" class="libs__add-folder">
                                    <AppButton Label="Add folder"
                                               StartIcon="@AppMaterialIcons.Outlined.Add"
                                               ButtonStyle="AppButtonStyle.Text"
                                               aria-label="@($"Add a folder to {row.Name}")"
                                               OnClick="@(() => AddFolderAsync(row))" />
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </AppTable>
        }
    }

    @if (Simple)
    {
        <p class="libs__note" data-later>Photos and personal videos, the Import folder and each library's own settings are added after setup, in Settings &gt; Libraries.</p>
    }
    else
    {
        <p class="libs__note">
            <a href="/settings/libraries/import">Import folder</a>: @(Configuration.ImportFolderStatus?.Configured == true ? "set" : "not set")
        </p>
    }
</div>

@code {
    [Parameter, EditorRequired] public LibrariesConfigurationDto Configuration { get; set; } = default!;
    /// <summary>The Engine's list of library kinds; the area tabs, content types and icons are drawn from it.</summary>
    [Parameter, EditorRequired] public LibraryKindCatalog Kinds { get; set; } = default!;
    [Parameter] public LibraryOverviewDto? Overview { get; set; }
    /// <summary>View's folder count per kind; null while it is not known.</summary>
    [Parameter] public IReadOnlyDictionary<string, int>? ViewFolders { get; set; }
    /// <summary>Folder path to issue; null while the folder checks have not finished (no status is claimed then).</summary>
    [Parameter] public IReadOnlyDictionary<string, string>? PathIssues { get; set; }
    /// <summary>A Vault-protected library is listed only while the Vault may be shown; the host decides (see <see cref="LibraryVaultAccess"/>).</summary>
    [Parameter] public bool ShowVault { get; set; }
    /// <summary>First-run setup (Library pages D13): Watch, Listen and Read, Standard access only, no Vault, rows that do not open a page, saves through the setup session.</summary>
    [Parameter] public bool Simple { get; set; }
    /// <summary>The first-run setup session the Create library dialog saves through; used only with <see cref="Simple"/>.</summary>
    [Parameter] public string? SetupSession { get; set; }
    /// <summary>Phones: counts and status only, no control that changes anything.</summary>
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>The selected area (watch, listen, read, view or vault); the first button when empty or unknown.</summary>
    [Parameter] public string? Area { get; set; }
    /// <summary>Raised after a folder was added, so the page can refresh its counts.</summary>
    [Parameter] public EventCallback FolderAdded { get; set; }

    private string _search = string.Empty;
    private string _status = string.Empty;
    private string? _setupArea;

    private string? _newLibraryId;
    private string? _addError;

    // Watch, Listen, Read, View, then the Vault for someone who may open it (library access D6); the Vault never exists for anyone else.
    // Setup leaves View and the Vault out: View's folders are added from its own pages in Settings, and nobody has Vault access yet.
    private IReadOnlyList<LibraryGroup> Areas => [.. Kinds.Visible(ShowVault && !Simple).Where(group => !(Simple && group.Key == LibraryTypeCatalog.ViewArea))];

    private IReadOnlyList<AppSelectOption> AreaOptions => [.. Areas.Select(group => new AppSelectOption(group.Key, group.Label, group.Icon))];

    private bool InVault => string.Equals(SelectedArea.Key, LibraryGroupCatalog.VaultKey, StringComparison.OrdinalIgnoreCase);

    private string RowClass(LibraryListRow row) => string.Join(' ', new[] { "libs__row", Simple ? "libs__row--static" : null, row.Key == _newLibraryId ? "libs__row--new" : null }
        .Where(value => value is not null));

    private int ActiveIndex
    {
        get
        {
            // Setup keeps the choice here: the address belongs to the wizard, and leaving it would abandon the first run.
            var wanted = Simple ? _setupArea ?? Area : Area;
            var index = Areas.ToList().FindIndex(group => string.Equals(group.Key, wanted?.Trim(), StringComparison.OrdinalIgnoreCase));
            return Math.Max(index, 0);
        }
    }

    private LibraryGroup SelectedArea => Areas.Count == 0 ? new LibraryGroup("watch", "Watch", AppMaterialIcons.Outlined.LiveTv, []) : Areas[ActiveIndex];

    private IReadOnlyList<LibraryListRow> AreaRows => LibraryListing.RowsFor(Kinds, SelectedArea.Key, Configuration, Overview, ViewFolders, PathIssues, ShowVault && !Simple);

    private IReadOnlyList<LibraryListRow> VisibleRows => [.. AreaRows.Where(Matches)];

    private bool Matches(LibraryListRow row)
    {
        var term = _search.Trim();
        if (term.Length > 0
            && !row.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            && !row.Type.Label.Contains(term, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return _status.Length == 0 || row.Status?.ToString() == _status;
    }

    private IReadOnlyList<AppSelectOption> StatusOptions =>
    [
        new("", "All statuses"),
        .. Enum.GetValues<LibraryStatusKind>().Select(status => new AppSelectOption(LibraryListing.FilterValue(status), LibraryListing.StatusText(status))),
    ];

    private void SelectArea(string key)
    {
        var index = Areas.ToList().FindIndex(group => string.Equals(group.Key, key, StringComparison.OrdinalIgnoreCase));
        if (index < 0 || index == ActiveIndex)
        {
            return;
        }

        if (Simple)
        {
            _setupArea = Areas[index].Key;
            return;
        }

        Navigation.NavigateTo(LibraryListing.OverviewAddress(Areas[index].Key));
    }

    private void OpenRow(LibraryListRow row)
    {
        if (!Simple) Navigation.NavigateTo(row.Href);
    }

    // View's three kinds always exist and keep their own add-folder form, so View has no Add library (Library pages WP11).
    private bool CanAddLibrary => !ReadOnly && !string.Equals(SelectedArea.Key, LibraryTypeCatalog.ViewArea, StringComparison.OrdinalIgnoreCase);

    // The one place the add flow is started: the two-screen Add library dialog. In the Vault area it makes a library in the Vault.
    private async Task OpenAddLibraryAsync()
    {
        var parameters = new AppDialogParameters<CreateLibraryDialog>
        {
            { component => component.Configuration, Configuration },
            { component => component.Kinds, Kinds },
            { component => component.StartAreaKey, SelectedArea.Key },
            { component => component.VaultVisible, ShowVault },
            { component => component.Simple, Simple },
            { component => component.SetupSession, SetupSession },
            { component => component.OnCreated, (Func<string, Task>)(id => { _newLibraryId = id; return FolderAdded.InvokeAsync(); }) },
        };
        await DialogService.ShowAsync<CreateLibraryDialog>(string.Empty, parameters, CreateLibraryDialog.DialogOptions);
    }

    // Setup rows do not open a page, so each one adds its own folders here: the same pop-up and the same save as a library's page, through the setup session.
    private bool CanAddFolder => Simple && !ReadOnly;

    private async Task AddFolderAsync(LibraryListRow row)
    {
        if (row.Library is not { } library) return;
        var managed = row.Type.DefaultHandling == "managed";
        var parameters = new AppDialogParameters<ServerFolderPicker>
        {
            { component => component.Title, $"Choose your {row.Type.Label} folder" },
            { component => component.HelpText, $"Choose the folder on the Library server that holds more of {row.Name}." },
            { component => component.ConfirmLabel, "Choose folder" },
            { component => component.SelectionMode, managed ? ServerFolderSelectionModes.ManagedLibrary : ServerFolderSelectionModes.ExistingLibrary },
            { component => component.KindKey, library.KindKey },
            { component => component.MediaType, row.Type.MediaTypes.FirstOrDefault() },
            { component => component.SetupSession, SetupSession },
        };
        var dialog = await DialogService.ShowAsync<ServerFolderPicker>(string.Empty, parameters, ServerFolderPicker.DialogOptions);
        if (await dialog.Result is not { Canceled: false, Data: ServerFolderValidationResultDto selected }) return;

        var plan = new AddFolderPlan(library.KindKey, selected, managed ? AddFolderHandling.Managed : AddFolderHandling.ReadOnly, MarkNewMediaHere: false, LibraryId: library.Id);
        var result = await AddService.AddAsync(plan, Kinds, Configuration, new FolderAddScope(true, SetupSession));
        if (!result.Saved)
        {
            _addError = result.Error ?? "The folder could not be added. Check it and try again.";
            return;
        }

        _addError = null;
        _newLibraryId = row.Key;
        await FolderAdded.InvokeAsync();
    }

    private string CountsFor(LibraryListRow row) => LibraryRollup.CountsText(row.Folders, row.Titles);

    private static string AccessibleName(LibraryListRow row)
    {
        var parts = new List<string> { row.Name, row.Type.Label };
        if (row.Folders is not null)
        {
            parts.Add(LibraryRollup.CountsText(row.Folders, row.Titles).Replace(" · ", ", ", StringComparison.Ordinal));
        }

        if (row.Status is { } status)
        {
            parts.Add(LibraryListing.StatusText(status));
        }

        return string.Join(", ", parts);
    }
}
