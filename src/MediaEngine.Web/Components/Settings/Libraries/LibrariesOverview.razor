@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Library
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Services.Ui
@inject NavigationManager Navigation
@inject IAppDialogService DialogService
@inject IStringLocalizer<SharedStrings> L

@* The Libraries overview (Libraries redesign D2, D13, D15): one table of every library grouped under Watch, Listen, Read, View and (for someone who may open it) the
   Vault, one row per library. The whole row opens the library and ends in a chevron; the name is the real link for the keyboard. A Vault library is listed only inside the Vault area. A library that was just
   added glows for about two seconds (no toast). First-run setup does not draw this table: it has its own area cards (SetupAreaCards). *@
<div class="libs">
    @if (ReadOnly)
    {
        <p class="libs__note">@L["Common_UseADesktopOrTablet"]</p>
    }

    @{ var groups = Groups; var anyRows = groups.Any(group => group.All.Count > 0); }
    @if (anyRows)
    {
        <div class="libs__toolbar">
            <div class="libs__search">
                <AppSearchField Label="@L["LibrariesOverview_SearchLibraries"].Value"
                                HideLabel="true"
                                Placeholder="@L["LibrariesOverview_SearchLibraries"].Value"
                                Value="@_search"
                                ValueChanged="@((string? value) => _search = value ?? string.Empty)" />
            </div>
            <div class="libs__filter">
                <AppSelect Label="@L["Models_Status"].Value"
                           HideLabel="true"
                           AriaLabel="@L["LibrariesOverview_FilterByStatus"].Value"
                           Value="@_status"
                           ValueChanged="@((string? value) => _status = value ?? string.Empty)"
                           Options="StatusOptions"
                           Size="AppControlSize.Compact" />
            </div>
            <AppLayoutSwitch StorageKey="tuvima.libraries.layout" Value="@_layout" ValueChanged="@(value => _layout = value)" AriaLabel="@L["LibrariesOverview_LibrariesLayout"].Value" />
            @if (CanAddLibrary)
            {
                <AppButton Label="@L["Common_AddLibrary"].Value"
                           StartIcon="@AppMaterialIcons.Outlined.Add"
                           ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary"
                           OnClick="@(() => OpenAddLibraryAsync(null))" />
            }
        </div>
    }

    @* One table grouped by area: nothing to toggle, nothing hidden (Libraries redesign D2). A heading is plain text with its count. *@
    @foreach (var group in groups)
    {
        var area = group.Area;
        var rows = group.Visible;
        <section class="libs__group" data-area="@area.Key" aria-label="@area.Label">
            <h3 class="libs__group-heading">
                <AppMaterialIcon Icon="@area.Icon" />
                <span>@area.Label</span>
                @if (group.All.Count > 0)
                {
                    <span class="libs__group-count">@group.All.Count</span>
                }
                else
                {
                    <span class="libs__group-count">@L["LibrariesOverview_NothingYet"]</span>
                    @if (CanAddLibraryIn(area))
                    {
                        <AppButton Label="@($"Add a {area.Label} library")" ButtonStyle="AppButtonStyle.Text" Size="AppControlSize.Compact" OnClick="@(() => OpenAddLibraryAsync(area.Key))" />
                    }
                }
            </h3>
            @if (rows.Count > 0 && _layout == AppLayoutSwitch.Cards)
            {
                <div class="libs__cards" data-area="@area.Key">
                    @foreach (var row in rows)
                    {
                        <div @key="row.Key" class="@(row.Key == _newLibraryId ? "libs__card-slot libs__card-slot--new" : "libs__card-slot")" data-library="@row.Key" data-new="@(row.Key == _newLibraryId ? "true" : null)" @onclick="@(() => OpenRow(row))">
                            <AppListCard Title="@row.Name" Icon="@row.Type.Icon" Kind="@row.Type.Label" Description="@CountsFor(row)">
                                <Status><LibraryStatusCell Row="@row" /></Status>
                            </AppListCard>
                        </div>
                    }
                </div>
            }
            else if (rows.Count > 0)
            {
                <AppTable Hover="true" CardsOn="AppTableCardsMode.Phone" Class="libs__table" data-area="@area.Key">
                    <caption class="sr-only">@area.Label libraries</caption>
                    <thead>
                        <tr>
                            <th data-card-role="title">@L["Users_ColName"]</th>
                            <th data-card-role="subtitle">@L["Common_ContentType"]</th>
                            <th>@L["LibrariesOverview_FoldersAndTitles"]</th>
                            <th data-card-role="value">@L["Models_Status"]</th>
                            <th data-card-role="hidden"><span class="sr-only">@L["Common_Open"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr @key="row.Key" class="@RowClass(row)" data-library="@row.Key" data-new="@(row.Key == _newLibraryId ? "true" : null)" @onclick="@(() => OpenRow(row))">
                                <td data-card-role="title">
                                    <span class="libs__name">
                                        <span class="@LibraryKindLook.TileClass(row.Type)"><AppMaterialIcon Icon="@row.Type.Icon" /></span>
                                        <a href="@row.Href" class="libs__link" aria-label="@AccessibleName(row)" @onclick:stopPropagation="true">@row.Name</a>
                                        @if (row.Access == LibraryListing.Vault)
                                        {
                                            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Lock" Class="libs__lock" />
                                        }
                                    </span>
                                </td>
                                <td data-card-role="subtitle">
                                    <span class="libs__type"><AppMaterialIcon Icon="@row.Type.Icon" />@row.Type.Label</span>
                                </td>
                                <td class="libs__counts">@CountsFor(row)</td>
                                <td data-card-role="value">
                                    <LibraryStatusCell Row="@row" />
                                </td>
                                <td data-card-role="hidden" class="libs__chevron"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" /></td>
                            </tr>
                        }
                    </tbody>
                </AppTable>
            }
            else if (group.All.Count > 0)
            {
                <p class="libs__note">@L["LibrariesOverview_NoLibrariesMatch", area.Label]</p>
            }
        </section>
    }

    <p class="libs__note">
        <a href="/settings/libraries/import">@L["Common_ImportFolder"]</a>: @(Configuration.ImportFolderStatus?.Configured == true ? "set" : "not set")
    </p>
</div>

@code {
    // The Cards / List switch (Plugins v3 D27); List is the table Settings has always shown, and the choice is remembered on this device.
    private string _layout = AppLayoutSwitch.List;

    [Parameter, EditorRequired] public LibrariesConfigurationDto Configuration { get; set; } = default!;
    /// <summary>The Engine's list of library kinds; the area tabs, content types and icons are drawn from it.</summary>
    [Parameter, EditorRequired] public LibraryKindCatalog Kinds { get; set; } = default!;
    [Parameter] public LibraryOverviewDto? Overview { get; set; }
    /// <summary>View's folder count per kind; null while it is not known.</summary>
    [Parameter] public IReadOnlyDictionary<string, int>? ViewFolders { get; set; }
    /// <summary>Folder path to issue; null while the folder checks have not finished (no status is claimed then).</summary>
    [Parameter] public IReadOnlyDictionary<string, string>? PathIssues { get; set; }
    /// <summary>A Vault-protected library is listed only while the Vault may be shown; the host decides (see <see cref="LibraryVaultAccess"/>).</summary>
    [Parameter] public bool ShowVault { get; set; }
    /// <summary>Phones: counts and status only, no control that changes anything.</summary>
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>Raised after a folder was added, so the page can refresh its counts.</summary>
    [Parameter] public EventCallback FolderAdded { get; set; }

    private string _search = string.Empty;
    private string _status = string.Empty;

    private string? _newLibraryId;

    // Watch, Listen, Read, View, then the Vault for someone who may open it (library access D6); the Vault never exists for anyone else.
    private IReadOnlyList<LibraryGroup> Areas => Kinds.Visible(ShowVault);

    private sealed record AreaRows(LibraryGroup Area, IReadOnlyList<LibraryListRow> All, IReadOnlyList<LibraryListRow> Visible);

    private IReadOnlyList<AreaRows> Groups => [.. Areas.Select(area =>
    {
        var all = LibraryListing.RowsFor(Kinds, area.Key, Configuration, Overview, ViewFolders, PathIssues, ShowVault);
        return new AreaRows(area, all, [.. all.Where(Matches)]);
    })];

    private string RowClass(LibraryListRow row) => string.Join(' ', new[] { "libs__row", row.Key == _newLibraryId ? "libs__row--new" : null }
        .Where(value => value is not null));

    private bool Matches(LibraryListRow row)
    {
        var term = _search.Trim();
        if (term.Length > 0
            && !row.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            && !row.Type.Label.Contains(term, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return _status.Length == 0 || row.Status?.ToString() == _status;
    }

    private IReadOnlyList<AppSelectOption> StatusOptions =>
    [
        new("", "All statuses"),
        .. Enum.GetValues<LibraryStatusKind>().Select(status => new AppSelectOption(LibraryListing.FilterValue(status), LibraryListing.StatusText(status))),
    ];

    private void OpenRow(LibraryListRow row) => Navigation.NavigateTo(row.Href);

    // View's three kinds always exist and keep their own add-folder form, so View has no Add library (Library pages WP11).
    private bool CanAddLibrary => !ReadOnly;

    private bool CanAddLibraryIn(LibraryGroup area) => !ReadOnly && !string.Equals(area.Key, LibraryTypeCatalog.ViewArea, StringComparison.OrdinalIgnoreCase);

    // The one place the add flow is started: the two-step Add library dialog, on the area the person asked from (Watch from the toolbar).
    private Task OpenAddLibraryAsync(string? areaKey) => LibraryAddFlow.OpenAsync(
        DialogService, Configuration, Kinds, areaKey, ShowVault, setup: false, setupSession: null,
        id => { _newLibraryId = id; return FolderAdded.InvokeAsync(); });

    private string CountsFor(LibraryListRow row) => LibraryRollup.CountsText(row.Folders, row.Titles);

    private static string AccessibleName(LibraryListRow row)
    {
        var parts = new List<string> { row.Name, row.Type.Label };
        if (row.Folders is not null)
        {
            parts.Add(LibraryRollup.CountsText(row.Folders, row.Titles).Replace(" · ", ", ", StringComparison.Ordinal));
        }

        if (row.Status is { } status)
        {
            parts.Add(LibraryListing.StatusText(status));
        }

        return string.Join(", ", parts);
    }
}
