@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Library
@using MediaEngine.Contracts.Settings
@using MediaEngine.Contracts.Vault
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Ui
@inject NavigationManager Navigation
@inject IEngineApiClient Api
@inject LibraryFolderAddService AddService
@inject IAppToastService Toast
@inject IAppDialogService DialogService
@inject DashboardSessionAccessor Session
@inject MediaEngine.Web.Services.Vault.NsfwModeState Nsfw

@* One library's page (Library pages D7, D17, D18, D19): its content type, access, counts and status, the header actions, and the tab
   strip (Folders, File handling, Activity, plus Lookup for a kind with lookup settings). The Settings frame above carries the
   breadcrumb Libraries > area > name and the library's name as the title. Folders embeds the existing folders panel for this one
   library; the other tabs are filled in by the next steps. The selected tab lives in the address (?tab=).
   Scan now scans this library only. Add folder adds a folder to THIS library and comes straight back to its table with the new row pointed
   at (it glows for a moment; no toast and no "go to..." question). Add files copies server files into the import destination, so it waits for one.
   Vault-protected libraries (Library pages WP9) are reached only by someone who may see the Vault: their folders are listed as they are, Add
   folder adds a Vault folder (its pop-up also offers "Let Library manage this folder"), Scan and Add files are not offered, and the Lookup tab holds
   the library's online lookup switch. For a server administrator the Folders menu offers "Move to Vault". Anyone else sees no Vault word. *@
@{
    var row = Row;
}
<LibraryUploadZone Kinds="@Kinds" Configuration="@Configuration" Type="@row.Type" ReadOnly="@(ReadOnly || IsVault)" FolderAdded="FolderAddedAsync">
    <div class="libpage" data-library="@row.Key">
        @if (ReadOnly)
        {
            <p class="libpage__note">Use a desktop or tablet to change folders.</p>
        }

        <div class="libpage__header">
            <div class="libpage__facts">
                <span class="libpage__type"><AppMaterialIcon Icon="@row.Type.Icon" />@row.Type.Label</span>
                @if (row.Access == LibraryListing.Vault)
                {
                    <AppChip Icon="@AppMaterialIcons.Outlined.Lock" Text="@LibraryListing.AccessText(row.Access)" />
                }
                <span class="libpage__counts">@LibraryRollup.CountsText(row.Folders, row.Titles)</span>
                <LibraryStatusCell Row="@row" />
            </div>
            @if (!ReadOnly)
            {
                <div class="libpage__actions">
                    @if (!IsVault)
                    {
                        <AppButton Label="Scan now"
                                   StartIcon="@AppMaterialIcons.Outlined.Sync"
                                   ButtonStyle="AppButtonStyle.Outlined"
                                   Loading="@_scanning"
                                   Disabled="@(_scanning || row.Folders == 0)"
                                   OnClick="ScanNowAsync" />
                    }
                    <AppButton Label="Add folder"
                               StartIcon="@AppMaterialIcons.Outlined.Add"
                               ButtonStyle="@(HighlightAddFolder ? AppButtonStyle.Filled : AppButtonStyle.Outlined)"
                               Tone="@(HighlightAddFolder ? AppUiTone.Primary : AppUiTone.Neutral)"
                               data-highlighted="@(HighlightAddFolder ? "true" : null)"
                               OnClick="AddFolderAsync" />
                    @if (!IsVault)
                    {
                        <AppButton Label="Add files"
                                   StartIcon="@AppMaterialIcons.Outlined.UploadFile"
                                   ButtonStyle="AppButtonStyle.Outlined"
                                   Disabled="@(!HasImportDestination)"
                                   data-add-files="@(HasImportDestination ? "ready" : "needs-import-folder")"
                                   OnClick="AddFilesAsync" />
                        @if (!HasImportDestination)
                        {
                            <AppInfoTip Text="@AddFilesWording.NeedsImportFolderHint" Label="@AddFilesWording.ChooseImportFolderFirst" />
                        }
                    }
                </div>
            }
        </div>

        @if (_addError is not null)
        {
            <AppAlert Tone="AppUiTone.Warning" Dense="true">@_addError</AppAlert>
        }

        @* The attention strip (Libraries redesign D4): only when there is something to do, one sentence and one button each. *@
        @if (!IsVault && (row.Unidentified > 0 || row.NeedsReview > 0 || row.Status == LibraryStatusKind.FolderOffline))
        {
            <div class="libpage__strip" role="status" data-testid="library-attention">
                @if (row.Status == LibraryStatusKind.FolderOffline)
                {
                    <div class="libpage__strip-line" data-strip="offline">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Warning" />
                        <span>Folder offline: @row.StatusDetail</span>
                        @if (!ReadOnly)
                        {
                            <AppButton Label="Check again" ButtonStyle="AppButtonStyle.Text" OnClick="@(() => Changed.InvokeAsync())" />
                        }
                    </div>
                }
                @if (row.Unidentified > 0)
                {
                    <div class="libpage__strip-line" data-strip="unidentified">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Warning" />
                        <span>@LibraryListing.UnidentifiedText(row.Unidentified) could not be identified.</span>
                        <AppButton Label="Review them" ButtonStyle="AppButtonStyle.Text" Href="@LibraryListing.UnidentifiedAddress(row.Key)" />
                    </div>
                }
                @if (row.NeedsReview > 0)
                {
                    <div class="libpage__strip-line" data-strip="needs-review">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Warning" />
                        <span>@LibraryListing.NeedsReviewText(row.NeedsReview) a look.</span>
                        <AppButton Label="Open Needs Review" ButtonStyle="AppButtonStyle.Text" Href="@LibraryListing.NeedsReviewAddress(row.Key)" />
                    </div>
                }
            </div>
        }

        <AppTabs ActivePanelIndex="@ActiveIndex" ActivePanelIndexChanged="SelectTab" Label="Library sections">
            @foreach (var tab in Tabs)
            {
                <AppTabPanel Text="@tab.Label">
                    @if (tab.Slug == FoldersTab && IsVault)
                    {
                        @if (Library.Sources.Count == 0)
                        {
                            <AppPageState Kind="AppPageStateKind.Empty" Icon="@AppMaterialIcons.Outlined.FolderOpen" Title="No folders yet" Message="Choose Add folder to point Library at where these files live." />
                        }
                        else
                        {
                            <LibraryFolderGrid Library="@Library"
                                               PluralLabel="@row.Type.PluralLabel"
                                               ReadOnly="true"
                                               PathIssues="@PathIssues"
                                               PathsChecked="@(PathIssues is not null)"
                                               HighlightSourceId="@_highlightSourceId" />
                            <AppQuietNote>These folders are watched as they are. Library never changes their files.</AppQuietNote>
                        }
                    }
                    else if (tab.Slug == FoldersTab)
                    {
                        <LibraryFoldersPanel @key="@_panelVersion"
                                             TypeKey="@row.Type.Key"
                                             LibraryId="@row.Key"
                                             Kinds="@Kinds"
                                             HostOwnsActions="true"
                                             HighlightSourceId="@_highlightSourceId"
                                             ReadOnly="@ReadOnly"
                                             OnMoveToVault="@(CanOfferVault ? EventCallback.Factory.Create<LibrarySourceDto>(this, MoveToVaultAsync) : default)"
                                             OnMoveOutOfVault="@(CanOfferMoveOut ? EventCallback.Factory.Create<LibrarySourceDto>(this, MoveOutOfVaultAsync) : default)"
                                             Changed="ChangedAsync" />
                    }
                    else if (tab.Slug == FileHandlingTab)
                    {
                        <LibraryFileHandlingTab Library="@Library"
                                                Kinds="@Kinds"
                                                ServerDuplicatePolicy="@Configuration.FileHandling.DuplicatePolicy"
                                                ReadOnly="@ReadOnly"
                                                Changed="ChangedAsync" />
                    }
                    else if (tab.Slug == UnidentifiedTab)
                    {
                        <LibraryUnidentifiedTab Library="@Library" ReadOnly="@ReadOnly" Changed="ChangedAsync" />
                    }
                    else if (tab.Slug == ActivityTab && IsVault)
                    {
                        @* A Vault library's activity is listed in the Vault, never here (Vault sections D40), so nothing about it is read from this page. *@
                        <AppQuietNote>This library's activity is listed in the Vault, not here. <AppLink Href="/vault">Open the Vault</AppLink></AppQuietNote>
                    }
                    else if (tab.Slug == ActivityTab)
                    {
                        <LibraryActivityTab Library="@Library" />
                    }
                    else if (tab.Slug == LookupTab && IsVault)
                    {
                        <LibraryVaultLookupTab Library="@Library" ReadOnly="@ReadOnly" Changed="ChangedAsync" />
                    }
                    else if (tab.Slug == LookupTab)
                    {
                        <LibraryLookupTab Library="@Library" ReadOnly="@ReadOnly" />
                    }
                    else
                    {
                        <AppPageState Kind="AppPageStateKind.Empty"
                                      Icon="@AppMaterialIcons.Outlined.Info"
                                      Title="Coming in the next step"
                                      Message="@($"The {tab.Label} tab for this library is being built.")" />
                    }
                </AppTabPanel>
            }
        </AppTabs>
    </div>
</LibraryUploadZone>

@code {
    public const string FoldersTab = "folders";
    public const string AccessTab = "access";
    public const string FileHandlingTab = "file-handling";
    public const string ActivityTab = "activity";
    public const string LookupTab = "lookup";
    public const string UnidentifiedTab = "unidentified";

    [Parameter, EditorRequired] public LibraryFolderDto Library { get; set; } = default!;
    [Parameter, EditorRequired] public LibrariesConfigurationDto Configuration { get; set; } = default!;
    [Parameter, EditorRequired] public LibraryKindCatalog Kinds { get; set; } = default!;
    [Parameter] public LibraryOverviewDto? Overview { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string>? PathIssues { get; set; }
    /// <summary>Phones: counts and status only, no control that changes anything.</summary>
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>The selected tab (folders, access, file-handling, activity, lookup); the first when empty or unknown.</summary>
    [Parameter] public string? Tab { get; set; }
    /// <summary>Points at Add folder (a jump from the Import folder's "Choose" arrives this way).</summary>
    [Parameter] public bool HighlightAddFolder { get; set; }
    /// <summary>Raised after a folder was added or changed, so the page can read the library list and counts again.</summary>
    [Parameter] public EventCallback Changed { get; set; }
    /// <summary>True when the host shows Vault libraries (the administrator's Vault mode is on), so a library made from Move to Vault can be opened.</summary>
    [Parameter] public bool VaultVisible { get; set; }

    private bool _scanning;
    private int _panelVersion;
    private string? _highlightSourceId;
    // Why the last Add folder did not work, drawn as a warning bubble above the tabs (never a toast).
    private string? _addError;

    // Add files needs somewhere to copy into: a managed folder that is this library's import destination.
    private bool HasImportDestination => Library.GetPrimaryDestination() is { ManagementMode: "managed_by_tuvima" };

    private bool IsVault => LibraryLookupRules.IsVaultLibrary(Library);

    // The Vault choices on this page (Add as a Vault folder, Move to Vault) are for a server administrator whose Vault mode is on, on an ordinary library of a content
    // type that can have a Vault library. With Vault mode off they are not drawn at all, so nothing here tells an administrator the Vault exists (review of WP9).
    private bool CanOfferVault => !ReadOnly
        && !IsVault
        && LibraryVaultAccess.CanShow(Nsfw, Session, isKids: false)
        && Kinds.Find(Library.KindKey) is { } kind
        && !LibraryTypeCatalog.IsViewKind(kind);

    // Move out of the Vault (Vault sections D38) is offered on a Vault library's folders to an unlocked administrator; the Engine decides whether the folder
    // may be moved and refuses a destination that is not a managed folder.
    private bool CanOfferMoveOut => !ReadOnly
        && IsVault
        && LibraryVaultAccess.CanShow(Nsfw, Session, isKids: false);

    private LibraryListRow Row => LibraryListing.RowFor(Kinds, Library, Configuration, Overview, PathIssues);

    private sealed record TabDef(string Slug, string Label);

    private IReadOnlyList<TabDef> Tabs
    {
        get
        {
            var tabs = new List<TabDef>
            {
                new(FoldersTab, "Folders"),
                new(FileHandlingTab, "File handling"),
                new(ActivityTab, "Activity"),
            };
            // The Engine's unmatched files get their own tab only while there are some (Libraries redesign D5); a Vault library never lists them here.
            if (Library.UnmatchedCount > 0 && !IsVault)
            {
                tabs.Add(new(UnidentifiedTab, $"Unidentified ({Library.UnmatchedCount:N0})"));
            }

            if (LibraryLookupRules.HasLookupTab(Library, Kinds.Find(Library.KindKey)))
            {
                tabs.Add(new(LookupTab, "Lookup"));
            }

            return tabs;
        }
    }

    private int ActiveIndex => Math.Max(Tabs.ToList().FindIndex(tab => string.Equals(tab.Slug, Tab?.Trim(), StringComparison.OrdinalIgnoreCase)), 0);

    private void SelectTab(int index)
    {
        var tabs = Tabs;
        if (index < 0 || index >= tabs.Count || index == ActiveIndex)
        {
            return;
        }

        Navigation.NavigateTo($"{LibraryListing.AddressOf(Library.Id)}?tab={tabs[index].Slug}");
    }

    // Scan now scans this library's own folders only (those with scanning on), never the whole server.
    private async Task ScanNowAsync()
    {
        _scanning = true;
        try
        {
            var started = await Api.ScanLibraryAsync(Library.Id);
            Toast.Add(
                started is not null ? $"Scanning {row_name()}." : Api.LastError ?? "The scan could not start. Try again in a moment.",
                started is not null ? AppSeverity.Success : AppSeverity.Error);
        }
        finally
        {
            _scanning = false;
        }
    }

    private string row_name() => string.IsNullOrWhiteSpace(Library.Name) ? "this library" : Library.Name;

    // Add folder: the same "Choose source folder" pop-up Add library uses (it shows the file count and says why a folder is refused). The folder is added
    // to THIS library, the table comes back and the new row glows for a moment. Nothing else is asked and nothing pops up afterwards.
    private async Task AddFolderAsync()
    {
        var kind = Kinds.Find(Library.KindKey);
        if (kind is null) return;
        var managed = kind.DefaultHandling == "managed";
        var managedVault = false;
        var parameters = new AppDialogParameters<ServerFolderPicker>
        {
            { component => component.Title, $"Choose your {kind.Label} folder" },
            { component => component.HelpText, $"Choose the folder on the Library server that holds more of {row_name()}." },
            { component => component.ConfirmLabel, "Choose folder" },
            { component => component.SelectionMode, managed && !IsVault ? ServerFolderSelectionModes.ManagedLibrary : ServerFolderSelectionModes.ExistingLibrary },
            { component => component.KindKey, Library.KindKey },
            { component => component.MediaType, kind.MediaTypes.FirstOrDefault() },
            { component => component.OfferManagedChoice, IsVault },
            { component => component.OnManagedChoiceChanged, EventCallback.Factory.Create<bool>(this, value => managedVault = value) },
        };
        var dialog = await DialogService.ShowAsync<ServerFolderPicker>(string.Empty, parameters, ServerFolderPicker.DialogOptions);
        if (await dialog.Result is not { Canceled: false, Data: ServerFolderValidationResultDto selected }) return;
        if (IsVault)
        {
            await AddVaultFolderAsync(selected, managedVault);
            return;
        }

        var plan = new AddFolderPlan(
            Library.KindKey,
            selected,
            managed ? AddFolderHandling.Managed : AddFolderHandling.ReadOnly,
            MarkNewMediaHere: false,
            LibraryId: Library.Id);
        var result = await AddService.AddAsync(plan, Kinds, Configuration, FolderAddScope.Settings);
        if (!result.Saved)
        {
            _addError = result.Error ?? "The folder could not be added. Check it and try again.";
            return;
        }

        _addError = null;
        // The new folder is scanned at once, so its titles start to fill in. A scan that cannot start shows as the row's own status.
        await Api.TriggerRescanAsync(selected.Path);
        _highlightSourceId = result.Source?.Id;
        await FolderAddedAsync();
    }

    // A folder added to a Vault library. An administrator is enough, with no PIN. The Engine starts watching and scanning the folder when it saves it.
    private async Task AddVaultFolderAsync(ServerFolderValidationResultDto selected, bool managedVault)
    {
        var added = await Api.AddVaultFolderAsync(new AddVaultFolderRequest(Library.KindKey, selected.Path, managedVault));
        if (added is not { Ok: true })
        {
            _addError = Api.LastError ?? "The folder could not be added. Check it and try again.";
            return;
        }

        _addError = null;
        _highlightSourceId = null;
        await FolderAddedAsync();
    }

    // Move out of the Vault: the same dialog, going the other way. Nothing is added here; a move out only goes to a folder Library manages.
    private async Task MoveOutOfVaultAsync(LibrarySourceDto source)
    {
        var kind = Kinds.Find(Library.KindKey);
        if (kind is null || !CanOfferMoveOut) return;
        var parameters = new AppDialogParameters<MoveToVaultDialog>
        {
            { component => component.KindKey, kind.Key },
            { component => component.PluralLabel, kind.PluralLabel },
            { component => component.FolderName, source.DisplayName() },
            { component => component.SourceId, source.Id },
            { component => component.Direction, VaultMoveDirections.Out },
        };
        var dialog = await DialogService.ShowAsync<MoveToVaultDialog>(string.Empty, parameters, MoveToVaultDialog.DialogOptions);
        await dialog.Result;
        await Changed.InvokeAsync();
    }

    // Move to Vault: a doorway that checks where the items would go before anything is touched (Library pages D11). With no Vault library of this content
    // type it offers Add a Vault library, which opens Add library with the area, type and Vault-protected chosen; once it is made, the preview opens again.
    private async Task MoveToVaultAsync(LibrarySourceDto source)
    {
        var kind = Kinds.Find(Library.KindKey);
        if (kind is null || !CanOfferVault) return;
        while (true)
        {
            var parameters = new AppDialogParameters<MoveToVaultDialog>
            {
                { component => component.KindKey, kind.Key },
                { component => component.PluralLabel, kind.PluralLabel },
                { component => component.FolderName, source.DisplayName() },
                { component => component.SourceId, source.Id },
            };
            var dialog = await DialogService.ShowAsync<MoveToVaultDialog>(string.Empty, parameters, MoveToVaultDialog.DialogOptions);
            if (await dialog.Result is not { Canceled: false, Data: MoveToVaultDialog.AddVaultLibrary }) return;

            var created = false;
            var create = new AppDialogParameters<CreateLibraryDialog>
            {
                { component => component.Configuration, Configuration },
                { component => component.Kinds, Kinds },
                { component => component.StartAreaKey, kind.Area },
                { component => component.StartKindKey, kind.Key },
                { component => component.StartAccessKey, LibraryAccessChoices.Vault },
                { component => component.VaultVisible, VaultVisible },
                { component => component.OpenCreated, false },
                { component => component.OnCreated, (Func<string, Task>)(_ => { created = true; return Task.CompletedTask; }) },
            };
            var made = await DialogService.ShowAsync<CreateLibraryDialog>(string.Empty, create, CreateLibraryDialog.DialogOptions);
            await made.Result;
            if (!created) return;
            await Changed.InvokeAsync();
        }
    }

    // Add files: the server file picker; the Engine copies the chosen files into the import destination and the dialog reports how it went.
    private async Task AddFilesAsync()
    {
        if (!HasImportDestination) return;
        var kind = Kinds.Find(Library.KindKey);
        var parameters = new AppDialogParameters<AddFilesDialog>
        {
            { component => component.LibraryId, Library.Id },
            { component => component.LibraryName, row_name() },
            { component => component.KindKey, Library.KindKey },
            { component => component.Noun, AddFilesWording.NounFor(kind?.MediaTypes ?? [.. Library.MediaTypes]) },
        };
        var dialog = await DialogService.ShowAsync<AddFilesDialog>(string.Empty, parameters, AddFilesDialog.DialogOptions);
        if (await dialog.Result is { Canceled: false, Data: MediaEngine.Contracts.Library.LibraryAddFilesResultDto { Copied: > 0 } })
        {
            await FolderAddedAsync();
        }
    }

    private async Task FolderAddedAsync()
    {
        _panelVersion++;
        await Changed.InvokeAsync();
    }

    private Task ChangedAsync() => Changed.InvokeAsync();
}
