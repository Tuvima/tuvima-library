@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Library
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Ui
@inject NavigationManager Navigation
@inject IEngineApiClient Api
@inject LibraryFolderAddService AddService
@inject IAppToastService Toast
@inject IAppDialogService DialogService

@* One library's page (Library pages D7, D17, D18, D19): its content type, access, counts and status, the header actions, and the tab
   strip (Folders, Access, File handling, Activity, plus Lookup for a kind with lookup settings). The Settings frame above carries the
   breadcrumb Libraries > area > name and the library's name as the title. Folders embeds the existing folders panel for this one
   library; the other tabs are filled in by the next steps. The selected tab lives in the address (?tab=).
   Scan now scans this library only. Add folder adds a folder to THIS library and comes straight back to its table with the new row pointed
   at and one confirmation (no "go to..." question). Add files copies server files into the import destination, so it waits for one. *@
@{
    var row = Row;
}
<LibraryUploadZone Kinds="@Kinds" Configuration="@Configuration" Type="@row.Type" ReadOnly="@ReadOnly" FolderAdded="FolderAddedAsync">
    <div class="libpage" data-library="@row.Key">
        @if (ReadOnly)
        {
            <p class="libpage__note">Use a desktop or tablet to change folders.</p>
        }

        <div class="libpage__header">
            <div class="libpage__facts">
                <span class="libpage__type"><AppMaterialIcon Icon="@row.Type.Icon" />@row.Type.Label</span>
                @if (row.Access == LibraryListing.Vault)
                {
                    <AppChip Icon="@AppMaterialIcons.Outlined.Lock" Text="@LibraryListing.AccessText(row.Access)" />
                }
                else
                {
                    <span class="libpage__access">@LibraryListing.AccessText(row.Access)</span>
                }
                <span class="libpage__counts">@LibraryRollup.CountsText(row.Folders, row.Titles)</span>
                <LibraryStatusCell Row="@row" />
            </div>
            @if (!ReadOnly)
            {
                <div class="libpage__actions">
                    <AppButton Label="Scan now"
                               StartIcon="@AppMaterialIcons.Outlined.Sync"
                               ButtonStyle="AppButtonStyle.Outlined"
                               Loading="@_scanning"
                               Disabled="@(_scanning || row.Folders == 0)"
                               OnClick="ScanNowAsync" />
                    <AppButton Label="Add folder"
                               StartIcon="@AppMaterialIcons.Outlined.Add"
                               ButtonStyle="@(HighlightAddFolder ? AppButtonStyle.Filled : AppButtonStyle.Outlined)"
                               Tone="@(HighlightAddFolder ? AppUiTone.Primary : AppUiTone.Neutral)"
                               data-highlighted="@(HighlightAddFolder ? "true" : null)"
                               OnClick="AddFolderAsync" />
                    <AppButton Label="Add files"
                               StartIcon="@AppMaterialIcons.Outlined.UploadFile"
                               ButtonStyle="AppButtonStyle.Outlined"
                               Disabled="@(!HasImportDestination)"
                               data-add-files="@(HasImportDestination ? "ready" : "needs-import-folder")"
                               OnClick="AddFilesAsync" />
                    @if (!HasImportDestination)
                    {
                        <AppInfoTip Text="@AddFilesWording.NeedsImportFolderHint" Label="@AddFilesWording.ChooseImportFolderFirst" />
                    }
                </div>
            }
        </div>

        <AppTabs ActivePanelIndex="@ActiveIndex" ActivePanelIndexChanged="SelectTab" Label="Library sections">
            @foreach (var tab in Tabs)
            {
                <AppTabPanel Text="@tab.Label">
                    @if (tab.Slug == FoldersTab)
                    {
                        <LibraryFoldersPanel @key="@_panelVersion"
                                             TypeKey="@row.Type.Key"
                                             LibraryId="@row.Key"
                                             Kinds="@Kinds"
                                             HostOwnsActions="true"
                                             HighlightSourceId="@_highlightSourceId"
                                             ReadOnly="@ReadOnly"
                                             Changed="ChangedAsync" />
                    }
                    else if (tab.Slug == AccessTab)
                    {
                        <LibraryAccessTab Library="@Library" ReadOnly="@ReadOnly" Changed="ChangedAsync" />
                    }
                    else if (tab.Slug == FileHandlingTab)
                    {
                        <LibraryFileHandlingTab Library="@Library"
                                                Kinds="@Kinds"
                                                ServerDuplicatePolicy="@Configuration.FileHandling.DuplicatePolicy"
                                                ReadOnly="@ReadOnly"
                                                Changed="ChangedAsync" />
                    }
                    else if (tab.Slug == ActivityTab)
                    {
                        <LibraryActivityTab Library="@Library" />
                    }
                    else if (tab.Slug == LookupTab)
                    {
                        <LibraryLookupTab Library="@Library" ReadOnly="@ReadOnly" />
                    }
                    else
                    {
                        <AppPageState Kind="AppPageStateKind.Empty"
                                      Icon="@AppMaterialIcons.Outlined.Info"
                                      Title="Coming in the next step"
                                      Message="@($"The {tab.Label} tab for this library is being built.")" />
                    }
                </AppTabPanel>
            }
        </AppTabs>
    </div>
</LibraryUploadZone>

@code {
    public const string FoldersTab = "folders";
    public const string AccessTab = "access";
    public const string FileHandlingTab = "file-handling";
    public const string ActivityTab = "activity";
    public const string LookupTab = "lookup";

    [Parameter, EditorRequired] public LibraryFolderDto Library { get; set; } = default!;
    [Parameter, EditorRequired] public LibrariesConfigurationDto Configuration { get; set; } = default!;
    [Parameter, EditorRequired] public LibraryKindCatalog Kinds { get; set; } = default!;
    [Parameter] public LibraryOverviewDto? Overview { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string>? PathIssues { get; set; }
    /// <summary>Phones: counts and status only, no control that changes anything.</summary>
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>The selected tab (folders, access, file-handling, activity, lookup); the first when empty or unknown.</summary>
    [Parameter] public string? Tab { get; set; }
    /// <summary>Points at Add folder (a jump from the Import folder's "Choose" arrives this way).</summary>
    [Parameter] public bool HighlightAddFolder { get; set; }
    /// <summary>Raised after a folder was added or changed, so the page can read the library list and counts again.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private bool _scanning;
    private int _panelVersion;
    private string? _highlightSourceId;

    // Add files needs somewhere to copy into: a managed folder that is this library's import destination.
    private bool HasImportDestination => Library.GetPrimaryDestination() is { ManagementMode: "managed_by_tuvima" };

    private LibraryListRow Row => LibraryListing.RowFor(Kinds, Library, Configuration, Overview, PathIssues);

    private sealed record TabDef(string Slug, string Label);

    private IReadOnlyList<TabDef> Tabs
    {
        get
        {
            var tabs = new List<TabDef>
            {
                new(FoldersTab, "Folders"),
                new(AccessTab, "Access"),
                new(FileHandlingTab, "File handling"),
                new(ActivityTab, "Activity"),
            };
            if (LibraryLookupRules.HasLookupTab(Library.KindKey))
            {
                tabs.Add(new(LookupTab, "Lookup"));
            }

            return tabs;
        }
    }

    private int ActiveIndex => Math.Max(Tabs.ToList().FindIndex(tab => string.Equals(tab.Slug, Tab?.Trim(), StringComparison.OrdinalIgnoreCase)), 0);

    private void SelectTab(int index)
    {
        var tabs = Tabs;
        if (index < 0 || index >= tabs.Count || index == ActiveIndex)
        {
            return;
        }

        Navigation.NavigateTo($"{LibraryListing.AddressOf(Library.Id)}?tab={tabs[index].Slug}");
    }

    // Scan now scans this library's own folders only (those with scanning on), never the whole server.
    private async Task ScanNowAsync()
    {
        _scanning = true;
        try
        {
            var started = await Api.ScanLibraryAsync(Library.Id);
            Toast.Add(
                started is not null ? $"Scanning {row_name()}." : Api.LastError ?? "The scan could not start. Try again in a moment.",
                started is not null ? AppSeverity.Success : AppSeverity.Error);
        }
        finally
        {
            _scanning = false;
        }
    }

    private string row_name() => string.IsNullOrWhiteSpace(Library.Name) ? "this library" : Library.Name;

    // Add folder: the folder picker on this library's content type (it shows the file count and says why a folder is refused), then the folder
    // is added to THIS library and the table comes back with the new row pointed at. The confirmation is the toast; nothing else is asked.
    private async Task AddFolderAsync()
    {
        var kind = Kinds.Find(Library.KindKey);
        if (kind is null) return;
        var managed = kind.DefaultHandling == "managed";
        var parameters = new AppDialogParameters<ServerFolderPicker>
        {
            { component => component.SelectionMode, managed ? ServerFolderSelectionModes.ManagedLibrary : ServerFolderSelectionModes.ExistingLibrary },
            { component => component.KindKey, Library.KindKey },
            { component => component.Title, "Add folder" },
            { component => component.HelpText, $"Choose a folder on the Library server that holds more of {row_name()}." },
            { component => component.MediaType, kind.MediaTypes.FirstOrDefault() },
            { component => component.ConfirmLabel, "Add" },
        };
        var dialog = await DialogService.ShowAsync<ServerFolderPicker>(string.Empty, parameters, new AppDialogOptions
        {
            MaxWidth = AppMaxWidth.ExtraExtraLarge,
            FullWidth = false,
            CloseButton = false,
            CloseOnEscapeKey = true,
        });
        if (await dialog.Result is not { Canceled: false, Data: ServerFolderValidationResultDto selected }) return;

        var plan = new AddFolderPlan(
            Library.KindKey,
            selected,
            managed ? AddFolderHandling.Managed : AddFolderHandling.ReadOnly,
            MarkNewMediaHere: false,
            LibraryId: Library.Id,
            SuccessMessage: $"Added {Path.GetFileName(selected.Path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))} to {row_name()}.");
        var result = await AddService.AddAsync(plan, Kinds, Configuration, FolderAddScope.Settings);
        if (!result.Saved)
        {
            Toast.Add(result.Error ?? "The folder could not be added. Check it and try again.", AppSeverity.Error);
            return;
        }

        if (!string.IsNullOrWhiteSpace(result.Notice))
        {
            Toast.Add(result.Notice, AppSeverity.Warning);
        }

        // The new folder is scanned at once, so its titles start to fill in.
        if (!await Api.TriggerRescanAsync(selected.Path))
        {
            Toast.Add("The folder was added, but its first scan could not start. Use Scan now.", AppSeverity.Warning);
        }

        _highlightSourceId = result.Source?.Id;
        await FolderAddedAsync();
    }

    // Add files: the server file picker; the Engine copies the chosen files into the import destination and the dialog reports how it went.
    private async Task AddFilesAsync()
    {
        if (!HasImportDestination) return;
        var kind = Kinds.Find(Library.KindKey);
        var parameters = new AppDialogParameters<AddFilesDialog>
        {
            { component => component.LibraryId, Library.Id },
            { component => component.LibraryName, row_name() },
            { component => component.KindKey, Library.KindKey },
            { component => component.Noun, AddFilesWording.NounFor(kind?.MediaTypes ?? [.. Library.MediaTypes]) },
        };
        var dialog = await DialogService.ShowAsync<AddFilesDialog>(string.Empty, parameters, AddFilesDialog.DialogOptions);
        if (await dialog.Result is { Canceled: false, Data: MediaEngine.Contracts.Library.LibraryAddFilesResultDto { Copied: > 0 } })
        {
            await FolderAddedAsync();
        }
    }

    private async Task FolderAddedAsync()
    {
        _panelVersion++;
        await Changed.InvokeAsync();
    }

    private Task ChangedAsync() => Changed.InvokeAsync();
}
