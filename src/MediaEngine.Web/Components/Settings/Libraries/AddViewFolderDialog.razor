@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.LocalAssets
@using MediaEngine.Contracts.Settings
@using MediaEngine.Domain.PersonalMedia
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Ui
@inject IEngineApiClient Api
@inject IAppDialogService DialogService
@inject IStringLocalizer<SharedStrings> L

@* Add a View folder (library setup and add-folder v2, D15, D16; View folders spec D2, D4a, D4c): the same look as the second screen of Add library. The
   content type is the row the person clicked (Photos, Personal videos or Documents). The friendly name is optional and filled from the folder, and the
   person chooses Read-only (the folder is read where it is) or Managed (Library creates the folder in View's storage, so uploads can be filed into it). A View
   folder is shared with everyone; choosing who sees what is a Settings job. If View has nowhere to keep its files yet, the dialog asks for that location too,
   pre-filled, and Add folder stays off until both are valid, so a View folder can never be saved with no storage behind it. In the Edit window the folder is only
   collected (Defer) and saved with Save changes. *@
<AppDialogShell Eyebrow="@Eyebrow"
                Title="@Heading"
                Size="Large"
                HostClass="@ServerFolderPicker.HostClass"
                OnClose="@(() => Dialog.Cancel())">
    <ChildContent>
        <div class="add-view-folder">
            @* The same folder window as Add library's third step (Libraries v3 D20, D21): friendly name at the top, the shared picker, and the handling
               labels. A View folder is shared with everyone and read where it is, so only Read-only is offered. *@
            <div class="add-view-folder__picker" data-folder-step>
                <ServerFolderPicker Inline="true"
                                    HideConfirm="true"
                                    MediaType="@Kind.MediaTypes.FirstOrDefault()"
                                    SelectionMode="@ServerFolderSelectionModes.PersonalSpaceExisting"
                                    SetupSession="@SetupSession"
                                    ShowFolderName="true"
                                    FolderName="@_name"
                                    FolderNameChanged="NameChanged"
                                    OfferHandling="true"
                                    InitialManaged="@InitialManaged"
                                    ManagedAllowed="true"
                                    ShowManagedWarning="false"
                                    OnHandlingChanged="HandlingChanged"
                                    OnPathChanged="PathChosen"
                                    Message="@MessageLine" />
            </div>

            @if (!StorageReady)
            {
                <section class="add-view-folder__section" data-view-storage>
                    <span class="add-view-folder__caption">@L["AddViewFolderDialog_WhereViewKeepsItsFiles"]</span>
                    @if (_storageWritable.Count == 0)
                    {
                        <AppAlert Tone="AppUiTone.Warning" Dense="true">@L["AddViewFolderDialog_LibraryHasNoPlaceTo"]</AppAlert>
                    }
                    else
                    {
                        <div class="add-view-folder__folder">
                            <div class="add-view-folder__path" data-storage-path>
                                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Storage" />
                                <span class="add-view-folder__text">@StoragePath</span>
                            </div>
                            <AppButton Label="@L["AddViewFolderDialog_Browse"].Value" StartIcon="@AppMaterialIcons.Outlined.FolderOpen" ButtonStyle="AppButtonStyle.Outlined" Disabled="@_saving" OnClick="BrowseStorageAsync" />
                        </div>
                        <p class="add-view-folder__line">@L["AddViewFolderDialog_ViewKeepsThumbnailsAndAnything"]</p>
                    }
                </section>
            }

        </div>
    </ChildContent>
    <FooterContent>
        <AppActionBar Align="AppHorizontalAlignment.End">
            <AppButton Label="@L["Search_Cancel"].Value" ButtonStyle="AppButtonStyle.Text" Disabled="@_saving" OnClick="@(() => Dialog.Cancel())" />
            <AppButton Label="@L["Common_AddFolder"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_saving" Disabled="@(!CanAdd)" OnClick="AddAsync" />
        </AppActionBar>
    </FooterContent>
</AppDialogShell>

@code {
    private const int MaxNameLength = FolderHandlingWords.MaxFolderNameLength;

    /// <summary>The centred dialog the host opens this with: the one folder window (Libraries v3 D21).</summary>
    public static AppDialogOptions DialogOptions => ServerFolderPicker.DialogOptions;

    [CascadingParameter] private IAppDialogContext Dialog { get; set; } = default!;

    /// <summary>The View kind the folder belongs to (its key is photos, personal_videos or documents).</summary>
    [Parameter, EditorRequired] public LibraryTypeOption Kind { get; set; } = default!;
    [Parameter, EditorRequired] public LibrariesConfigurationDto Configuration { get; set; } = default!;
    [Parameter] public string? SetupSession { get; set; }
    /// <summary>The folders this kind already has (for the " (2)" name rule and the uploads note); read from the Engine when not given.</summary>
    [Parameter] public IReadOnlyList<ViewSourceAdminDto>? ExistingFolders { get; set; }
    /// <summary>The Edit window collects the folder and saves it with its own Save changes; the dialog then closes with a <see cref="ViewFolderPlan"/> and saves nothing but View's storage.</summary>
    [Parameter] public bool Defer { get; set; }
    /// <summary>Names already waiting in the Edit window, so a second folder with the same name is numbered.</summary>
    [Parameter] public IReadOnlyList<string> PendingNames { get; set; } = [];
    /// <summary>True when the Edit window already holds a Managed folder to add, so the uploads note is not needed.</summary>
    [Parameter] public bool PendingManaged { get; set; }
    /// <summary>True when the window opens with Managed already chosen (the page notice's "Add a Managed folder").</summary>
    [Parameter] public bool InitialManaged { get; set; }

    // The folder path the window has selected so far (a plain choice; View checks it when the folder is added).
    private string _chosenPath = string.Empty;
    private string _name = string.Empty;
    private bool _saving;
    private string? _error;

    // The View storage this dialog will save when the configuration has none that can be written to: a writable storage location and a folder inside it.
    private string? _storageLocationId;
    private string _storageRelative = "View";

    private string Heading => L["AddViewFolderDialog_Heading"].Value;

    // The header names what the folder is being added to, the area and the kind, above "Add folder" (setup and libraries fixes D8).
    private string Eyebrow => $"{L["Nav_View"].Value} · {LibraryTypeCatalog.AddChoiceLabel(Kind)}";

    // "Photos" reads "photos" in the middle of a sentence; "Personal videos" and "Documents" follow the same rule.
    private string Noun => ViewFolderRules.Noun(Kind.Key, Kind.PluralLabel);

    private bool _managed;
    private IReadOnlyList<ViewSourceAdminDto> _existing = [];

    // The one message line under the handling choice (D7): the host's own error when Add folder was refused, else the Managed note, else the upload line. Null draws no line.
    private RenderFragment? MessageLine =>
        !string.IsNullOrWhiteSpace(_error)
            ? @<AppAlert Tone="AppUiTone.Error" Dense="true">@_error</AppAlert>
            : _managed
                ? @<p class="add-view-folder__line" data-managed-note>@L["AddViewFolderDialog_ManagedNote", ManagedName]</p>
                : NeedsManagedNote
                    ? @<p class="add-view-folder__line add-view-folder__line--note" data-uploads-note><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.WarningAmber" />@ViewFolderRules.UploadsNeedManagedLine(L, Noun)</p>
                    : null;

    private void HandlingChanged(string handling) => _managed = handling == FolderHandlingWords.ManagedKey;

    // Read-only is picked and the kind has no Managed folder yet: uploads stay off, and the person is told before trying (View folders spec D4c).
    private bool NeedsManagedNote => !ViewFolderRules.HasManagedFolder(_existing, Kind.Key) && !PendingManaged;

    private IEnumerable<string> TakenNames => ViewFolderRules.OfKind(_existing, Kind.Key).Select(source => source.Name).Concat(PendingNames);

    private string ManagedName => ViewFolderRules.NameFor(_name, _chosenPath, TakenNames);

    private IReadOnlyList<ServerStorageLocationDto> _storageWritable = [];

    private bool StorageReady => Configuration.StorageLocations.Any(location =>
        location.AllowWrite && string.Equals(location.Id, Configuration.ViewStorage.StorageLocationId, StringComparison.OrdinalIgnoreCase));

    private string StoragePath
    {
        get
        {
            var location = _storageWritable.FirstOrDefault(item => string.Equals(item.Id, _storageLocationId, StringComparison.OrdinalIgnoreCase));
            return location is null ? string.Empty : Path.Combine(location.Path, _storageRelative);
        }
    }

    private bool FolderUsable => !string.IsNullOrWhiteSpace(_chosenPath);

    // The name never blocks Add folder: an empty box saves the folder's own name (View folders spec D2). A Managed folder is created, so it needs no existing folder.
    private bool CanAdd => !_saving
        && (_managed ? !string.IsNullOrWhiteSpace(ManagedName) : FolderUsable)
        && _name.Trim().Length <= MaxNameLength
        && (StorageReady || _storageLocationId is not null);

    protected override async Task OnInitializedAsync()
    {
        _managed = InitialManaged;
        _storageWritable = [.. Configuration.StorageLocations.Where(location => location.AllowWrite)];
        _storageLocationId = StorageReady ? null : _storageWritable.FirstOrDefault()?.Id;
        if (ExistingFolders is not null)
        {
            _existing = ExistingFolders;
        }
        else if (await ViewFolderRules.LoadAsync(Api, includeProfiles: SetupSession is null) is { } entries)
        {
            _existing = [.. entries.Select(entry => entry.Source)];
        }
    }

    private void NameChanged(string value)
    {
        _name = value;
    }

    private Task PathChosen(string path)
    {
        _chosenPath = path;
        _error = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task<ServerFolderValidationResultDto?> PickAsync(string title, string help, string mode, string? start)
    {
        var parameters = new AppDialogParameters<ServerFolderPicker>
        {
            { component => component.Title, title },
            { component => component.HelpText, help },
            { component => component.ConfirmLabel, "Choose folder" },
            { component => component.SelectionMode, mode },
            { component => component.SetupSession, SetupSession },
            { component => component.InitialPath, start },
        };
        var dialog = await DialogService.ShowAsync<ServerFolderPicker>(string.Empty, parameters, ServerFolderPicker.DialogOptions);
        return await dialog.Result is { Canceled: false, Data: ServerFolderValidationResultDto selected } ? selected : null;
    }

    private async Task BrowseStorageAsync()
    {
        var selected = await PickAsync("Where View keeps its files", "Choose the folder on the Library server where View keeps its files.", ServerFolderSelectionModes.PersonalSpaceManaged, StoragePath);
        if (selected is not { CanSelect: true } || string.IsNullOrWhiteSpace(selected.StorageLocationId)) return;
        _storageLocationId = selected.StorageLocationId;
        _storageRelative = string.IsNullOrWhiteSpace(selected.RelativePath) ? "." : selected.RelativePath;
        _error = null;
    }

    private async Task AddAsync()
    {
        if (!CanAdd) return;
        _saving = true;
        _error = null;
        try
        {
            // Looked at once, when Add folder is pressed: the picker itself reads nothing but the folder list. A Managed folder is made by Library, so nothing is checked.
            ServerFolderValidationResultDto? folder = null;
            if (!_managed)
            {
                var request = new ValidateServerFolderRequest { ManualPath = _chosenPath, SelectionMode = ServerFolderSelectionModes.PersonalSpaceExisting, KindKey = Kind.Key };
                folder = SetupSession is not null ? await Api.ValidateSetupServerFolderAsync(request, SetupSession) : await Api.ValidateServerFolderAsync(request);
                if (folder is not { CanSelect: true, Exists: true, HasRead: true })
                {
                    _error = folder?.Issues.FirstOrDefault(issue => issue.Severity == "error")?.Message ?? Api.LastError ?? "Library can't use this folder. Choose another one.";
                    return;
                }
            }

            if (!StorageReady && !await SaveStorageAsync()) return;

            var plan = new ViewFolderPlan(Kind.Key, _name.Trim(), _managed, folder?.Path);
            if (Defer)
            {
                // The Edit window numbers and saves it with Save changes.
                Dialog.Close(AppDialogResult.Ok(plan));
                return;
            }

            // A Read-only folder is shared with everyone and read where it is, subfolders included; Documents never join the Photos timeline.
            var created = await Api.CreateViewSharedSourceAsync(ViewFolderRules.RequestFor(plan, ViewFolderRules.NameFor(_name, _managed ? _chosenPath : folder!.Path, TakenNames)));
            if (created is null)
            {
                _error = Api.LastError ?? "The folder could not be added. Check it and try again.";
                return;
            }

            Dialog.Close(AppDialogResult.Ok(created.Id));
        }
        finally
        {
            _saving = false;
        }
    }

    // Saves the View storage through setup's own libraries save, which checks it against the storage locations before it keeps anything.
    private async Task<bool> SaveStorageAsync()
    {
        var saved = await Api.UpdateSetupLibrariesAsync(new UpdateLibrariesRequest
        {
            SchemaVersion = Configuration.SchemaVersion,
            StorageLocations = Configuration.StorageLocations,
            ViewStorage = new ViewStorageDto { StorageLocationId = _storageLocationId!, RelativeRoot = _storageRelative },
            Libraries = [.. Configuration.Libraries.Where(library => !library.IsVault)],
            PersonalLibraryPolicy = Configuration.PersonalLibraryPolicy,
            FileHandling = Configuration.FileHandling,
        }, SetupSession);
        if (saved is null)
        {
            _error = Api.LastError ?? "View's storage could not be saved. Check the location and try again.";
            return false;
        }

        return true;
    }
}
