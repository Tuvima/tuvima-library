@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Components.Shared
@* The three Access choices of a library, in one place: Standard, Selected profiles and, for a server administrator only (the host passes ShowVault),
   Vault-protected. A choice that cannot be picked is drawn, disabled, with the reason. *@
<div class="library-access-options" role="group" aria-label="Access">
    <AppChoiceRow Title="Standard"
                  Description="Everyone who can use this area, within each profile's limits."
                  Selected="@(Value == LibraryAccessChoices.Standard)"
                  Disabled="@Disabled"
                  OnClick="@(() => Choose(LibraryAccessChoices.Standard))" />
    <AppChoiceRow Title="Selected profiles"
                  Description="@(SelectedProfilesEnabled ? "Only the profiles you choose." : SelectedProfilesReason)"
                  Selected="@(Value == LibraryAccessChoices.Selected)"
                  Disabled="@(Disabled || !SelectedProfilesEnabled)"
                  OnClick="@(() => Choose(LibraryAccessChoices.Selected))" />
    @if (ShowVault)
    {
        <AppChoiceRow Title="Vault-protected"
                      Description="@(VaultEnabled ? "Kept in the Vault, for the people you give Vault access." : (VaultDisabledReason ?? VaultReason))"
                      Selected="@(Value == LibraryAccessChoices.Vault)"
                      Disabled="@(Disabled || !VaultEnabled)"
                      OnClick="@(() => Choose(LibraryAccessChoices.Vault))" />
    }
</div>

@code {
    /// <summary>Selected profiles can be chosen when a library is created and on the Access tab.</summary>
    public static readonly bool SelectedProfilesAvailable = true;

    /// <summary>Vault-protected can be chosen when a library is created (Library pages WP9).</summary>
    public static readonly bool VaultAvailable = true;

    public const string SelectedProfilesReason = "Not available here.";
    public const string VaultReason = "Not available here.";

    /// <summary>The chosen access value (<see cref="LibraryAccessChoices"/>).</summary>
    [Parameter] public string Value { get; set; } = LibraryAccessChoices.Standard;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    /// <summary>Draws the Vault-protected choice: only for a server administrator, and never in first-run setup.</summary>
    [Parameter] public bool ShowVault { get; set; }
    [Parameter] public bool SelectedProfilesEnabled { get; set; } = SelectedProfilesAvailable;
    [Parameter] public bool VaultEnabled { get; set; } = VaultAvailable;
    /// <summary>The words shown when the Vault choice is drawn but cannot be picked (for example the content type already has one).</summary>
    [Parameter] public string? VaultDisabledReason { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private Task Choose(string value) => Value == value ? Task.CompletedTask : ValueChanged.InvokeAsync(value);
}
