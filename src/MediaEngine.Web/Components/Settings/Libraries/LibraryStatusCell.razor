@namespace MediaEngine.Web.Components.Settings
@inject IStringLocalizer<SharedStrings> L

@* A library's status in words (Libraries redesign D3): Healthy, Empty, Scanning, Folder offline (the warning's words open as a tooltip), or an amber
   count: "3 need review" opens Needs Review for the library. The count is what that page lists for the library (Needs Review redesign D2: one
   name, one list). Nothing is claimed while the status is not known. *@
@if (Row.Status is not { } status)
{
    <span class="lib-status lib-status--muted" data-status="unknown" aria-label="@L["LibraryStatusCell_NoStatusToShow"].Value">—</span>
}
else
{
    switch (status)
    {
        case LibraryStatusKind.Healthy:
            <span class="lib-status" data-status="healthy"><LibraryHealthIcon Health="@LibraryHealth.Ok" />@L["Ingestion_HealthHealthy"]</span>
            break;
        case LibraryStatusKind.NeedsReview:
            <span class="lib-status-group">
                @if (Row.NeedsReview > 0)
                {
                    <a class="lib-status lib-status--warning" data-status="needs-review" href="@LibraryListing.NeedsReviewAddress(Row.Key)" @onclick:stopPropagation="true"
                       aria-label="@($"{LibraryListing.NeedsReviewText(Row.NeedsReview)}. Open Needs Review for {Row.Name}")">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Warning" />@LibraryListing.NeedsReviewText(Row.NeedsReview)
                    </a>
                }
            </span>
            break;
        case LibraryStatusKind.FolderOffline:
            <AppTooltip Text="@Row.StatusDetail">
                <span class="lib-status lib-status--warning" data-status="folder-offline" tabindex="0"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Warning" />@L["Common_FolderOffline"]</span>
            </AppTooltip>
            break;
        case LibraryStatusKind.Scanning:
            <span class="lib-status" data-status="scanning"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Sync" />@L["Ingestion_StageScanning"]</span>
            break;
        default:
            <span class="lib-status lib-status--muted" data-status="empty">@L["LibraryStatusCell_Empty"]</span>
            break;
    }
}

@code {
    [Parameter, EditorRequired] public LibraryListRow Row { get; set; } = default!;
}
