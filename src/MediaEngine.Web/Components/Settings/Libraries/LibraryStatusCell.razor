@namespace MediaEngine.Web.Components.Settings

@* A library's status in words (Libraries redesign D3): Healthy, Empty, Scanning, Folder offline (the warning's words open as a tooltip), or an amber
   count that names its kind and goes exactly there: "12 files not identified" opens the library's Unidentified tab, "3 need review" opens Needs
   Review for the library. A library can have both; each is its own link, never mixed. Nothing is claimed while the status is not known. *@
@if (Row.Status is not { } status)
{
    <span class="lib-status lib-status--muted" data-status="unknown" aria-label="No status to show">—</span>
}
else
{
    switch (status)
    {
        case LibraryStatusKind.Healthy:
            <span class="lib-status" data-status="healthy"><LibraryHealthIcon Health="@LibraryHealth.Ok" />Healthy</span>
            break;
        case LibraryStatusKind.NotIdentified:
        case LibraryStatusKind.NeedsReview:
            <span class="lib-status-group">
                @if (Row.Unidentified > 0)
                {
                    <a class="lib-status lib-status--warning" data-status="not-identified" href="@LibraryListing.UnidentifiedAddress(Row.Key)" @onclick:stopPropagation="true"
                       aria-label="@($"{LibraryListing.UnidentifiedText(Row.Unidentified)}. Open the Unidentified files for {Row.Name}")">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Warning" />@LibraryListing.UnidentifiedText(Row.Unidentified)
                    </a>
                }
                @if (Row.NeedsReview > 0)
                {
                    <a class="lib-status lib-status--warning" data-status="needs-review" href="@LibraryListing.NeedsReviewAddress(Row.Key)" @onclick:stopPropagation="true"
                       aria-label="@($"{LibraryListing.NeedsReviewText(Row.NeedsReview)}. Open Needs Review for {Row.Name}")">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Warning" />@LibraryListing.NeedsReviewText(Row.NeedsReview)
                    </a>
                }
            </span>
            break;
        case LibraryStatusKind.FolderOffline:
            <AppTooltip Text="@Row.StatusDetail">
                <span class="lib-status lib-status--warning" data-status="folder-offline" tabindex="0"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Warning" />Folder offline</span>
            </AppTooltip>
            break;
        case LibraryStatusKind.Scanning:
            <span class="lib-status" data-status="scanning"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Sync" />Scanning</span>
            break;
        default:
            <span class="lib-status lib-status--muted" data-status="empty">Empty</span>
            break;
    }
}

@code {
    [Parameter, EditorRequired] public LibraryListRow Row { get; set; } = default!;
}
