@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Ui
@inject LibraryFolderAddService AddService
@inject IAppDialogService DialogService
@inject IEngineApiClient Api
@inject NavigationManager Navigation
@inject DashboardSessionAccessor Session
@inject MediaEngine.Web.Services.Vault.NsfwModeState Nsfw
@inject IStringLocalizer<SharedStrings> L

@* Add library: two screens, one question each. Screen 1 "What is it?" is only the content type of the area the person is standing in; screen 2 "Choose your
   Movies folder" is the folder (Browse opens the shared "Choose source folder" pop-up, the same one Add folder uses) and a name that is already filled in. Add
   library saves the library with that folder, starts a scan and opens the new library's page: no "go to..." question and no toast. Who can see a library is never
   asked here (library access D1), and the ordinary Add library says nothing about the Vault. The Vault is its own area: opened from it (StartAreaKey or
   StartAccessKey set to vault) the dialog offers Movies, TV Shows, Music, Books, Adult content and Other, and the library is made in the Vault (library access D6).
   First-run setup uses the same dialog with Simple on and stays where it is. *@
<AppDialogShell Eyebrow="@StepText"
                Title="@Heading"
                Subtitle="@Lead"
                Size="Large"
                OnClose="@(() => Dialog.Cancel())">
    <ChildContent>
        <div class="create-library" data-step="@_step">
            @if (_step == 1)
            {
                @if (!_vaultMode && Areas.Count > 1)
                {
                    <div class="create-library__areas" data-area-tabs>
                        <AppSegmentedControl Options="@AreaOptions"
                                             Value="@_area"
                                             ValueChanged="ChooseAreaAsync"
                                             AriaLabel="@L["Common_Area"].Value"
                                             Disabled="@_saving" />
                    </div>
                }

                @if (KindsOfArea.Count == 0)
                {
                    <AppQuietNote>@L["CreateLibraryDialog_ThereAreNoContentTypes"]</AppQuietNote>
                }
                else
                {
                    <div class="create-library__rows" role="group" aria-label="@L["Common_ContentType"].Value">
                        @foreach (var kind in KindsOfArea)
                        {
                            var availability = AvailabilityOf(kind);
                            <AppChoiceRow Title="@LabelOf(kind)"
                                          Description="@(availability.Reason ?? DescriptionOf(kind))"
                                          Icon="@kind.Icon"
                                          IconClass="@LibraryKindLook.TileClass(kind)"
                                          Selected="@(kind.Key == _kindKey)"
                                          Disabled="@(_saving || !availability.Enabled)"
                                          OnClick="@(() => ChooseKindAsync(kind))" />
                        }
                    </div>
                }
            }
            else
            {
                <div class="create-library__picker" data-folder-step>
                    <ServerFolderPicker @key="@_pickerKey"
                                        Inline="true"
                                        HideConfirm="true"
                                        MediaType="@Kind?.MediaTypes.FirstOrDefault()"
                                        SelectionMode="@PickerMode"
                                        KindKey="@_kindKey"
                                        SetupSession="@SetupSession"
                                        InitialPath="@_pickerStart"
                                        OnValidationChanged="FolderChecked" />
                    <p class="create-library__line" data-scan-line>@ScanLine</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <AppAlert Tone="AppUiTone.Error">@_error</AppAlert>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <AppActionBar Align="AppHorizontalAlignment.End">
            @if (_step == 1)
            {
                <AppButton Label="@L["Search_Cancel"].Value" ButtonStyle="AppButtonStyle.Text" OnClick="@(() => Dialog.Cancel())" />
                <AppButton Label="@L["Home_CarouselNext"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(Kind is null)" OnClick="NextAsync" />
            }
            else
            {
                <div class="create-library__name" data-library-name>
                    <AppTextField Label="@L["Common_LibraryName"].Value"
                                  Value="@_name"
                                  ValueChanged="NameChanged"
                                  MaxLength="@MaxNameLength"
                                  ReadOnly="@_saving"
                                  Error="@(NameProblem is not null)"
                                  ErrorText="@NameProblem" />
                    <span class="create-library__hint">@L["CreateLibraryDialog_YouCanRenameItLater"]</span>
                </div>
                <AppButton Label="@L["Common_Back"].Value" ButtonStyle="AppButtonStyle.Text" Disabled="@_saving" OnClick="BackAsync" />
                <AppButton Label="@L["Common_AddLibrary"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_saving" Disabled="@(!CanCreate)" OnClick="CreateAsync" />
            }
        </AppActionBar>
    </FooterContent>
</AppDialogShell>

@code {
    /// <summary>The most characters a library name may have.</summary>
    public const int MaxNameLength = 80;

    /// <summary>The kind that is only ever offered with the Vault tick (Libraries spec D12, D21).</summary>
    public const string AdultContentKindKey = "adult_content";

    /// <summary>The centred dialog every host opens Add library with.</summary>
    public static AppDialogOptions DialogOptions { get; } = new()
    {
        MaxWidth = AppMaxWidth.Large,
        FullWidth = true,
        CloseButton = false,
        NoHeader = true,
        CloseOnEscapeKey = true,
    };

    // Watch, Listen and Read make a new library; View's three kinds always exist, so its tab goes straight to the View folder pop-up (Libraries spec D8, Q6).
    private static readonly string[] OfferedAreas = ["watch", "listen", "read", "view"];

    // What the Vault's own Add library offers, in this order (library access D6). "Other" is the plain video kind: the Vault holds one library per content type.
    private static readonly string[] VaultKindKeys = ["movies", "tv", "music", "books", AdultContentKindKey, "other_videos"];

    [CascadingParameter] private IAppDialogContext Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public LibrariesConfigurationDto Configuration { get; set; } = default!;
    [Parameter, EditorRequired] public LibraryKindCatalog Kinds { get; set; } = default!;
    /// <summary>Opens in this area (watch, listen, read or vault); null opens on Watch. The area is never asked: it is the one the person is standing in.</summary>
    [Parameter] public string? StartAreaKey { get; set; }
    /// <summary>Opens with this content type chosen when it can still take a library.</summary>
    [Parameter] public string? StartKindKey { get; set; }
    /// <summary>First-run setup: the dialog stays where it is after Create instead of opening the library page.</summary>
    [Parameter] public bool Simple { get; set; }
    /// <summary>The first-run setup session; the setup calls are used instead of the signed-in ones.</summary>
    [Parameter] public string? SetupSession { get; set; }
    /// <summary>Called with the new library's id once it is saved, so the host can read the libraries again.</summary>
    [Parameter] public Func<string, Task>? OnCreated { get; set; }
    /// <summary>Opens in the Vault (Move to Vault passes <c>vault</c>; the Vault area's own Add library passes the vault area): the library is made in the Vault. Ignored when the person may not use the Vault; there is no switch for it.</summary>
    [Parameter] public string? StartAccessKey { get; set; }
    /// <summary>True when the host shows Vault libraries (the administrator's Vault mode is on); only then does Create open the new Vault library's page.</summary>
    [Parameter] public bool VaultVisible { get; set; }
    /// <summary>False when the host carries on with what it was doing (Move to Vault continues from its preview) instead of opening the new library.</summary>
    [Parameter] public bool OpenCreated { get; set; } = true;

    // 1 = "What is it?", 2 = "Choose your ... folder".
    private int _step = 1;
    private string _area = "watch";
    private string? _kindKey;
    private string _name = string.Empty;
    private bool _nameTouched;
    // True when opened for the Vault; never changed afterwards, because the dialog has no Vault choice.
    private bool _vaultMode;
    private ServerFolderValidationResultDto? _folder;
    // Where the folder picker opens: the folder already chosen when the content type changes under it.
    private string? _pickerStart;
    private int _pickerKey;
    private bool _saving;
    private string? _error;

    private FolderAddScope Scope => new(Simple, SetupSession);
    // Only a server administrator whose Vault mode is on can make a Vault library, which first-run setup allows only after the administrator turned the
    // Vault on there. Anyone else never gets Vault mode, so the dialog holds no Vault word at all and nothing here can tell them the Vault exists.
    private bool VaultAllowed => LibraryVaultAccess.CanShow(Nsfw, Session, isKids: false);

    private IReadOnlyList<LibraryGroup> Areas => [.. OfferedAreas.Select(Kinds.TryGetGroup).OfType<LibraryGroup>()];

    private IReadOnlyList<AppSelectOption> AreaOptions => [.. Areas.Select(group => new AppSelectOption(group.Key, group.Label))];

    private bool IsViewArea => !_vaultMode && string.Equals(_area, ViewAreaKey, StringComparison.Ordinal);

    private const string ViewAreaKey = "view";

    // Adult content exists only in the Vault (library access D6), so only the Vault's own Add library offers it, and the Vault offers its own list.
    private IReadOnlyList<LibraryTypeOption> KindsOfArea => _vaultMode
        ? [.. VaultKindKeys.Select(Kinds.Find).OfType<LibraryTypeOption>()]
        : Kinds.TryGetGroup(_area) is { } group
            ? [.. group.TypeKeys.Select(Kinds.Find).OfType<LibraryTypeOption>().Where(kind => kind.Key != AdultContentKindKey)]
            : [];

    private string StepText => $"Step {_step} of 2";

    // The plain video kind is called "Videos" everywhere else (import folder, Change what this folder is); only this dialog says "Other".
    private static string LabelOf(LibraryTypeOption kind) => kind.Key == "other_videos" ? "Other" : kind.Label;

    private static string DescriptionOf(LibraryTypeOption kind) => kind.Key == "other_videos"
        ? "Anything else, like home videos, recordings or clips. Nothing is looked up."
        : kind.Tooltip;

    private string Heading => _step == 1 ? "What is it?" : $"Choose your {(Kind is { } chosen ? LabelOf(chosen) : "library")} folder";

    private string? Lead => _step == 1
        ? (_vaultMode ? "Stored in the Vault, away from everyone without Vault access." : $"Pick the kind of {AreaNoun} you have.")
        : $"Pick the folder on the Library server that holds your {Plural}.";

    // "Movies" reads "movies" in the middle of a sentence; "TV shows" and "YouTube" keep their capitals, and the "Other" kinds just say files.
    private string Plural
    {
        get
        {
            if (Kind is not { } kind || kind.Key.StartsWith("other", StringComparison.Ordinal)) return "files";
            var label = kind.PluralLabel;
            var firstWord = label.Split(' ')[0];
            return firstWord.Skip(1).Any(char.IsUpper) ? label : char.ToLowerInvariant(label[0]) + label[1..];
        }
    }

    private string AreaNoun => _area switch { "watch" => "videos", "listen" => "audio", "read" => "reading", "view" => "photos and files", _ => "media" };

    // Library only ever reads a folder it is not told to manage, so the plain sentence says so; a managed folder is kept tidy as well.
    private string ScanLine => Handling == AddFolderHandling.Managed
        ? "Library scans this folder and its subfolders, and keeps it organised."
        : "Library scans this folder and its subfolders. Your files are never changed.";

    private LibraryTypeOption? Kind => _kindKey is null ? null : KindsOfArea.FirstOrDefault(kind => kind.Key == _kindKey);

    // A kind that holds one library cannot start a second (its folders merge instead); a kind that holds several stops at its limit.
    private (bool Enabled, string? Reason) AvailabilityOf(LibraryTypeOption kind)
    {
        // View's kinds always exist; they take folders, never a second library.
        if (!_vaultMode && string.Equals(kind.Area, ViewAreaKey, StringComparison.Ordinal))
        {
            return (true, null);
        }

        // Each content type has one Vault library beside its ordinary one; the Engine refuses a second in any case.
        if (_vaultMode && Configuration.Libraries.Any(library => library.IsVault && string.Equals(library.KindKey, kind.Key, StringComparison.Ordinal)))
        {
            return (false, $"You already have a Vault-protected {LabelOf(kind)} library. Add a folder to it instead.");
        }

        // Ordinary libraries never count toward the Vault's own, so the Vault list is open once its own check passes.
        if (_vaultMode)
        {
            return (true, null);
        }

        var held = LibraryRollup.LibrariesOf(Configuration, kind).Count;
        if (!kind.AllowsMultiple)
        {
            return held >= 1 ? (false, $"You already have a {LabelOf(kind)} library. Add a folder to it instead.") : (true, null);
        }

        return held >= kind.MaxLibraries
            ? (false, $"You already have {kind.MaxLibraries} {kind.PluralLabel} libraries, the most you can keep. Add a folder to one of them instead.")
            : (true, null);
    }

    // A Vault library's folders are added as they are (read-only); a folder Library manages in the Vault is part of the Vault update.
    private bool IsVaultChoice => _vaultMode;

    private string PickerMode => Kind is { DefaultHandling: "managed" } && !IsVaultChoice ? ServerFolderSelectionModes.ManagedLibrary : ServerFolderSelectionModes.ExistingLibrary;

    // Read-only (As-is) unless the kind's own default is Managed.
    private AddFolderHandling Handling => Kind is { DefaultHandling: "managed" } && !IsVaultChoice ? AddFolderHandling.Managed : AddFolderHandling.ReadOnly;

    // The name must be there, fit, and be new within the area ("Home videos" twice would be two rows nobody could tell apart).
    private string? NameProblem
    {
        get
        {
            var name = _name.Trim();
            if (name.Length == 0) return _nameTouched ? "Give the library a name." : null;
            if (name.Length > MaxNameLength) return $"Use {MaxNameLength} characters or fewer.";
            return NameTaken(name) ? $"You already have a library called \"{name}\" in this area. Choose a different name." : null;
        }
    }

    // A Vault library is compared only with other Vault libraries, and an ordinary one only with the ordinary ones in its area, so the ordinary list never
    // tells anyone that a Vault library of that name exists.
    private bool NameTaken(string name) => Configuration.Libraries.Any(library =>
        library.IsVault == _vaultMode
        && (_vaultMode || string.Equals(library.Area, _area, StringComparison.OrdinalIgnoreCase))
        && string.Equals(library.Name?.Trim(), name, StringComparison.OrdinalIgnoreCase));

    private bool FolderUsable => _folder is { CanSelect: true, Exists: true, HasRead: true };

    private bool CanCreate => !_saving
        && !string.IsNullOrWhiteSpace(_name)
        && _name.Trim().Length <= MaxNameLength
        && NameProblem is null
        && Kind is not null
        && AvailabilityOf(Kind).Enabled
        && FolderUsable;

    protected override void OnInitialized()
    {
        _vaultMode = (string.Equals(StartAccessKey, LibraryAccessChoices.Vault, StringComparison.Ordinal)
            || string.Equals(StartAreaKey?.Trim(), LibraryGroupCatalog.VaultKey, StringComparison.OrdinalIgnoreCase)) && VaultAllowed;
        var start = Areas.FirstOrDefault(group => string.Equals(group.Key, StartAreaKey?.Trim(), StringComparison.OrdinalIgnoreCase))
            ?? Areas.FirstOrDefault(group => group.Key == "watch")
            ?? Areas.FirstOrDefault();
        _area = start?.Key ?? "watch";
        var wanted = KindsOfArea.FirstOrDefault(kind => string.Equals(kind.Key, StartKindKey?.Trim(), StringComparison.OrdinalIgnoreCase) && AvailabilityOf(kind).Enabled);
        _kindKey = (wanted ?? KindsOfArea.FirstOrDefault(kind => AvailabilityOf(kind).Enabled))?.Key;
        // A host that already knows the content type (Move to Vault, a dropped file) goes straight to the folder; Back changes the type.
        _step = wanted is not null ? 2 : 1;
        PrefillName();
    }

    private async Task NextAsync()
    {
        if (Kind is not { } kind) return;
        if (IsViewArea)
        {
            await AddViewFolderAsync(kind);
            return;
        }

        _step = 2;
    }

    // A different area shows its own content types, with the first one that can still take a library chosen.
    private Task ChooseAreaAsync(string area)
    {
        if (_saving || string.Equals(_area, area, StringComparison.Ordinal)) return Task.CompletedTask;
        _area = area;
        _error = null;
        _kindKey = KindsOfArea.FirstOrDefault(kind => AvailabilityOf(kind).Enabled)?.Key;
        PrefillName();
        return Task.CompletedTask;
    }

    // View has no library to create: the folder joins the View kind through the View folder pop-up, shared with everyone and read where it is.
    private async Task AddViewFolderAsync(LibraryTypeOption kind)
    {
        var parameters = new AppDialogParameters<AddViewFolderDialog>
        {
            { component => component.Kind, kind },
            { component => component.Configuration, Configuration },
            { component => component.SetupSession, SetupSession },
        };
        var dialog = await DialogService.ShowAsync<AddViewFolderDialog>(string.Empty, parameters, AddViewFolderDialog.DialogOptions);
        if (await dialog.Result is not { Canceled: false }) return;

        var libraryId = LibraryRollup.LibrariesOf(Configuration, kind).FirstOrDefault()?.Id ?? string.Empty;
        if (OnCreated is not null) await OnCreated(libraryId);
        Dialog.Close(AppDialogResult.Ok(libraryId));
    }

    private Task BackAsync()
    {
        _step = 1;
        _error = null;
        return Task.CompletedTask;
    }

    private Task ChooseKindAsync(LibraryTypeOption kind)
    {
        if (_kindKey == kind.Key) return Task.CompletedTask;
        _kindKey = kind.Key;
        PrefillName();
        RestartPicker();
        return Task.CompletedTask;
    }

    // The folder is checked for the content type, so a new type checks it again (the picker is rebuilt on the folder already chosen).
    private void RestartPicker()
    {
        _pickerStart = _folder?.Path;
        _pickerKey++;
        _error = null;
    }

    // The name starts as the content type's name (a second "Videos" becomes "Videos 2") and follows the type until the person types their own.
    private void PrefillName()
    {
        if (_nameTouched) return;
        var kind = Kind;
        if (kind is null)
        {
            _name = string.Empty;
            return;
        }

        var stem = IsVaultChoice ? VaultNameStem(LabelOf(kind)) : LabelOf(kind);
        var suggestion = stem;
        for (var number = 2; NameTaken(suggestion); number++)
        {
            suggestion = $"{stem} {number}";
        }

        _name = suggestion;
    }

    // "Private Movies" beside "Movies" (the library the Vault shortcuts make carries the same stem).
    private static string VaultNameStem(string kindLabel) => $"Private {kindLabel}";

    private void NameChanged(string? value)
    {
        _name = value ?? string.Empty;
        _nameTouched = true;
    }

    private Task FolderChecked(ServerFolderValidationResultDto? folder)
    {
        _folder = folder;
        _error = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    // Vault-protected: the Engine makes the Vault library beside the content type's ordinary one (an administrator is enough, no PIN). The new library is
    // opened only for someone who sees Vault libraries; otherwise the dialog just closes, so nothing about it shows on the page.
    private async Task CreateVaultAsync(LibraryTypeOption kind, ServerFolderValidationResultDto folder)
    {
        var created = await Api.CreateVaultLibraryAsync(new CreateVaultLibraryFromKindRequest(kind.Key, _name.Trim(), folder.Path));
        if (created is not { Ok: true })
        {
            _error = Api.LastError ?? "The library could not be created. Check the folder and try again.";
            return;
        }

        // The answer carries the new library's id only when the Engine sees the Vault as open for this person.
        var id = created.LibraryId ?? string.Empty;
        if (OnCreated is not null) await OnCreated(id);
        Dialog.Close(AppDialogResult.Ok(id));
        if (VaultVisible && OpenCreated && id.Length > 0) Navigation.NavigateTo($"/settings/libraries/{id}");
    }

    private async Task CreateAsync()
    {
        if (!CanCreate || Kind is not { } kind || _folder is not { } folder) return;
        _saving = true;
        _error = null;
        try
        {
            if (IsVaultChoice)
            {
                await CreateVaultAsync(kind, folder);
                return;
            }

            var plan = new AddFolderPlan(
                kind.Key,
                folder,
                Handling,
                MarkNewMediaHere: Handling == AddFolderHandling.Managed,
                NewLibraryName: _name.Trim(),
                CreateNewLibrary: true,
                Access: LibraryAccessChoices.Standard);
            var result = await AddService.AddAsync(plan, Kinds, Configuration, Scope);
            if (!result.Saved || string.IsNullOrWhiteSpace(result.LibraryId))
            {
                _error = result.Error ?? "The library could not be created. Check the folder and try again.";
                return;
            }

            var libraryId = result.LibraryId;
            // A scan starts at once so the library page opens on a library that is already filling. Setup scans later, with everything else. A scan
            // that cannot start shows as the library's own status, where Scan now is one click away.
            if (!Simple) await Api.TriggerRescanAsync(folder.Path);

            if (OnCreated is not null) await OnCreated(libraryId);
            Dialog.Close(AppDialogResult.Ok(libraryId));
            if (!Simple && OpenCreated) Navigation.NavigateTo($"/settings/libraries/{libraryId}");
        }
        finally
        {
            _saving = false;
        }
    }
}
