@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Ui
@inject LibraryFolderAddService AddService
@inject IAppDialogService DialogService
@inject IEngineApiClient Api
@inject NavigationManager Navigation
@inject DashboardSessionAccessor Session
@inject MediaEngine.Web.Services.Vault.NsfwModeState Nsfw
@inject IStringLocalizer<SharedStrings> L

@* Add library (Libraries v3 D17, D21, D23): three steps in one fixed window, one question each, drawn from full-width rows (setup and libraries fixes D5). 1 "Where does it belong?" is the area
   (Watch, Listen, Read, View); 2 "What is it?" is that area's kinds; 3 "Where is it?" is the folder window, with the folder's friendly name at the top and the
   Read-only / Managed choice under the list. The library itself is never named: its name is its kind (Movies is Movies). A kind that already has a library takes the
   folder as a second folder of it. Add library saves the library with that folder, starts a scan and opens the new library's page: no "go to..." question and no toast. Who can see a library is never
   asked here (library access D1), and the ordinary Add library says nothing about the Vault. The Vault is its own area: opened from it (StartAreaKey or
   StartAccessKey set to vault) the dialog offers Movies, TV Shows, Music, Books, Adult content and Other, and the library is made in the Vault (library access D6).
   First-run setup uses the same dialog with Simple on and stays where it is. *@
<AppDialogShell Eyebrow="@StepText"
                Title="@Heading"
                Subtitle="@Lead"
                Size="Large"
                HostClass="@ServerFolderPicker.HostClass"
                OnClose="@(() => Dialog.Cancel())">
    <ChildContent>
        <div class="create-library" data-step="@_step">
            @if (_step == 1)
            {
                <div class="create-library__rows" role="group" aria-label="@L["Common_Area"].Value" data-area-rows tabindex="-1" @ref="_rowsElement">
                    @foreach (var group in Areas)
                    {
                        <LibraryChoiceRow Key="@group.Key"
                                          Title="@group.Label"
                                          Icon="@group.Icon"
                                          AreaKey="@group.Key"
                                          Line="@AreaLine(group.Key)"
                                          Selected="@(_returned && !_vaultMode && group.Key == _area)"
                                          GoesOnWhenChosen="true"
                                          Disabled="@_saving"
                                          OnClick="@(() => PickAreaAsync(group.Key))" />
                    }
                    @if (VaultRowShown)
                    {
                        <LibraryChoiceRow Key="@LibraryGroupCatalog.VaultKey"
                                          Title="@L["CreateLibrary_VaultTitle"].Value"
                                          Icon="@AppMaterialIcons.Outlined.Lock"
                                          AreaKey="@LibraryGroupCatalog.VaultKey"
                                          Line="@L["CreateLibrary_VaultInfo"].Value"
                                          Selected="@(_returned && _vaultMode)"
                                          GoesOnWhenChosen="true"
                                          Disabled="@_saving"
                                          OnClick="@(() => PickAreaAsync(LibraryGroupCatalog.VaultKey))" />
                    }
                </div>
            }
            else if (_step == 2)
            {
                <p class="create-library__area-line" data-area-line>
                    <span class="create-library__chip lib-area--@(_vaultMode ? "vault" : _area)">@(_vaultMode ? L["Nav_Vault"].Value : Kinds.TryGetGroup(_area)?.Label)</span>
                    @if (!_vaultMode || VaultRowShown)
                    {
                        <AppButton Label="@L["Common_Change"].Value" ButtonStyle="AppButtonStyle.Text" Size="AppControlSize.Compact" OnClick="BackAsync" />
                    }
                </p>
                @if (KindsOfArea.Count == 0)
                {
                    <AppQuietNote>@L["CreateLibraryDialog_ThereAreNoContentTypes"]</AppQuietNote>
                }
                else
                {
                    <div class="create-library__rows" role="group" aria-label="@L["Common_ContentType"].Value" data-kind-rows tabindex="-1" @ref="_rowsElement">
                        @foreach (var kind in KindsOfArea)
                        {
                            var availability = AvailabilityOf(kind);
                            <LibraryChoiceRow Key="@kind.Key"
                                              Title="@LabelOf(kind)"
                                              Icon="@kind.Icon"
                                              AreaKey="@kind.Area.ToLowerInvariant()"
                                              Line="@RowLine(kind, availability.Reason)"
                                              ActionLabel="@(HasLibrary(kind) ? L["CreateLibrary_AddFolderInstead", LibraryNameOf(kind)].Value : null)"
                                              Selected="@(_returned && kind.Key == _kindKey && CanPick(kind))"
                                              GoesOnWhenChosen="true"
                                              Disabled="@(_saving || !CanPick(kind))"
                                              OnClick="@(() => PickKindAsync(kind))"
                                              OnAction="@(() => AddFolderInsteadAsync(kind))" />
                        }
                    </div>
                }
            }
            else if (_step == 4)
            {
                <div class="create-library__check" data-fit="@_fit" role="status" aria-live="polite">
                    <AppMaterialIcon Icon="@FitIcon" />
                    <div><strong>@FitTitle</strong><p>@FitText</p></div>
                </div>
            }
            else
            {
                <div class="create-library__picker" data-folder-step>
                    <ServerFolderPicker @key="@_pickerKey"
                                        Inline="true"
                                        HideConfirm="true"
                                        MediaType="@Kind?.MediaTypes.FirstOrDefault()"
                                        KindLabel="@(Kind is null ? null : LabelOf(Kind))"
                                        SelectionMode="@PickerMode"
                                        SetupSession="@SetupSession"
                                        InitialPath="@_pickerStart"
                                        ShowFolderName="LibraryFolderStep.ShowFolderName"
                                        FolderName="@_folderName"
                                        FolderNameChanged="FolderNameChanged"
                                        OfferHandling="@(!IsVaultChoice)"
                                        ManagedAllowed="@ManagedAllowed"
                                        OnHandlingChanged="HandlingChanged"
                                        OnPathChanged="PathChosen"
                                        Message="@FolderMessage">
                        <TopContent>
                            @* Step line, then the area and kind (read only), the same chips Edit's Add folder shows. The folder's friendly name comes first inside the folder window. *@
                            @LibraryFolderStep.Chips(_vaultMode ? LibraryGroupCatalog.VaultKey : _area, _vaultMode && Simple ? null : _vaultMode ? L["Nav_Vault"].Value : Kinds.TryGetGroup(_area)?.Label, Kind)
                        </TopContent>
                    </ServerFolderPicker>
                </div>
            }

            @if (_step != 3 && !string.IsNullOrWhiteSpace(_error))
            {
                <AppAlert Tone="AppUiTone.Error">@_error</AppAlert>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <AppActionBar Align="AppHorizontalAlignment.End">
            @if (_step == 1)
            {
                @* Choosing a row moves on at once, so steps 1 and 2 have no Next (setup and libraries fixes D5, mock). *@
                <AppButton Label="@L["Search_Cancel"].Value" ButtonStyle="AppButtonStyle.Text" OnClick="@(() => Dialog.Cancel())" />
            }
            else if (_step == 2)
            {
                <AppButton Label="@L["Common_Back"].Value" ButtonStyle="AppButtonStyle.Text" OnClick="BackAsync" />
                <AppButton Label="@L["Search_Cancel"].Value" ButtonStyle="AppButtonStyle.Text" OnClick="@(() => Dialog.Cancel())" />
            }
            else if (_step == 4)
            {
                @if (_fit == FitLooksRight)
                {
                    <AppButton Label="@L["Common_Done"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="FinishAsync" />
                }
                else
                {
                    <AppButton Label="@L["CreateLibrary_ChooseAnother"].Value" ButtonStyle="AppButtonStyle.Text" Disabled="@_saving" OnClick="BackAsync" />
                    @if (_fit == FitHeadsUp)
                    {
                        <AppButton Label="@L["CreateLibrary_AddAnyway"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_saving" OnClick="CreateAsync" />
                    }
                }
            }
            else
            {
                <AppButton Label="@L["Common_Back"].Value" ButtonStyle="AppButtonStyle.Text" Disabled="@_saving" OnClick="BackAsync" />
                <AppButton Label="@(Kind is { } chosen && HasLibrary(chosen) ? L["Common_AddFolder"].Value : L["Common_AddLibrary"].Value)" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_saving" Disabled="@(!CanCreate)" OnClick="AddClickedAsync" />
            }
        </AppActionBar>
    </FooterContent>
</AppDialogShell>

@code {
    /// <summary>The kind that is only ever offered with the Vault tick (Libraries spec D12, D21).</summary>
    public const string AdultContentKindKey = "adult_content";

    /// <summary>The centred dialog every host opens Add library with: the one folder window (Libraries v3 D21).</summary>
    public static AppDialogOptions DialogOptions => ServerFolderPicker.DialogOptions;

    // Watch, Listen and Read make a new library; View's three kinds always exist, so its tab goes straight to the View folder pop-up (Libraries spec D8, Q6).
    private static readonly string[] OfferedAreas = ["watch", "listen", "read", "view"];

    // What the Vault's own Add library offers, in this order (library access D6). "Other" is the plain video kind: the Vault holds one library per content type.
    private static readonly string[] VaultKindKeys = ["movies", "tv", "music", "books", AdultContentKindKey, "other_videos"];

    [CascadingParameter] private IAppDialogContext Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public LibrariesConfigurationDto Configuration { get; set; } = default!;
    [Parameter, EditorRequired] public LibraryKindCatalog Kinds { get; set; } = default!;
    /// <summary>Opens in this area (watch, listen, read or vault); null opens on Watch. The area is never asked: it is the one the person is standing in.</summary>
    [Parameter] public string? StartAreaKey { get; set; }
    /// <summary>Opens with this content type chosen when it can still take a library.</summary>
    [Parameter] public string? StartKindKey { get; set; }
    /// <summary>First-run setup: the dialog stays where it is after Create instead of opening the library page.</summary>
    [Parameter] public bool Simple { get; set; }
    /// <summary>The first-run setup session; the setup calls are used instead of the signed-in ones.</summary>
    [Parameter] public string? SetupSession { get; set; }
    /// <summary>Called with the new library's id once it is saved, so the host can read the libraries again.</summary>
    [Parameter] public Func<string, Task>? OnCreated { get; set; }
    /// <summary>Opens in the Vault (Move to Vault passes <c>vault</c>; the Vault area's own Add library passes the vault area): the library is made in the Vault. Ignored when the person may not use the Vault; there is no switch for it.</summary>
    [Parameter] public string? StartAccessKey { get; set; }
    /// <summary>True when the host shows Vault libraries (the administrator's Vault mode is on); only then does Create open the new Vault library's page.</summary>
    [Parameter] public bool VaultVisible { get; set; }
    /// <summary>False when the host carries on with what it was doing (Move to Vault continues from its preview) instead of opening the new library.</summary>
    [Parameter] public bool OpenCreated { get; set; } = true;

    // 1 = area, 2 = type, 3 = "Choose your ... folder", 4 = the check after adding (Looks right / Heads up / Already used).
    private int _step = 1;
    private const string FitLooksRight = "looks_right";
    private const string FitHeadsUp = "heads_up";
    private const string FitAlreadyUsed = "already_used";
    private string _fit = FitLooksRight;
    private string? _fitDetail;
    private string _createdId = string.Empty;
    private bool _areaChosen;
    // True after Back to step 1 or 2: the row of the earlier choice is marked. Rows move on when chosen, so nothing is pending-selected otherwise.
    private bool _returned;
    private string _area = "watch";
    private string? _kindKey;
    // The folder's friendly name and handling, reported by the folder window (Libraries v3 D18, D19). The library itself is never named by the person.
    private string _folderName = string.Empty;
    private string _handling = FolderHandlingWords.ReadOnlyKey;
    // True when opened for the Vault; never changed afterwards, because the dialog has no Vault choice.
    private bool _vaultMode;
    private bool AreaChosen => _areaChosen;
    // The Vault row is offered only once the Vault is on for this person (and, in setup, only after it was turned on there).
    private bool VaultRowShown => VaultAllowed && VaultVisible;
    private ServerFolderValidationResultDto? _folder;
    // The folder path the picker has selected so far (a plain choice, not checked).
    private string _chosenPath = string.Empty;
    // Where the folder picker opens: the folder already chosen when the content type changes under it.
    private string? _pickerStart;
    private int _pickerKey;
    private bool _saving;
    private string? _error;

    private FolderAddScope Scope => new(Simple, SetupSession);
    // Only a server administrator whose Vault mode is on can make a Vault library, which first-run setup allows only after the administrator turned the
    // Vault on there. Anyone else never gets Vault mode, so the dialog holds no Vault word at all and nothing here can tell them the Vault exists.
    private bool VaultAllowed => LibraryVaultAccess.CanShow(Nsfw, Session, isKids: false);

    private IReadOnlyList<LibraryGroup> Areas => [.. OfferedAreas.Select(Kinds.TryGetGroup).OfType<LibraryGroup>()];

    private IReadOnlyList<AppSelectOption> AreaOptions => [.. Areas.Select(group => new AppSelectOption(group.Key, group.Label))];

    private bool IsViewArea => !_vaultMode && string.Equals(_area, ViewAreaKey, StringComparison.Ordinal);

    private const string ViewAreaKey = "view";

    // Adult content exists only in the Vault (library access D6), so only the Vault's own Add library offers it, and the Vault offers its own list.
    private IReadOnlyList<LibraryTypeOption> KindsOfArea => _vaultMode
        ? [.. VaultKindKeys.Select(Kinds.Find).OfType<LibraryTypeOption>()]
        : Kinds.TryGetGroup(_area) is { } group
            ? [.. group.TypeKeys.Select(Kinds.Find).OfType<LibraryTypeOption>().Where(kind => kind.Key != AdultContentKindKey && !LibraryTypeCatalog.IsHiddenFromAdd(kind))]
            : [];

    // The folder step names the area beside the step, in the header that never scrolls (Libraries fixes, item 3b).
    private string? StepText => _step switch
    {
        3 when _vaultMode && Simple => "Step 3 of 3",
        3 => $"Step 3 of 3 · {(_vaultMode ? L["Nav_Vault"].Value : Kinds.TryGetGroup(_area)?.Label)}",
        < 3 => $"Step {_step} of 3",
        _ => null,
    };

    // The name a kind goes by everywhere: the kind list's label ("Videos", "Other audio", "Photos and videos").
    private static string LabelOf(LibraryTypeOption kind) => LibraryTypeCatalog.AddChoiceLabel(kind);

    private string Heading => _step switch
    {
        1 => "Where does it belong?",
        2 => "What is it?",
        4 => _fit switch { FitHeadsUp => "Heads up", FitAlreadyUsed => "Already used", _ => "Looks right" },
        _ => LibraryFolderStep.Heading(L, Kind),
    };

    private string? Lead => _step switch
    {
        1 => "Pick the area it belongs in. The library is named for what it is, so there is nothing to type.",
        2 => _vaultMode ? "Stored in the Vault, away from everyone without Vault access." : $"Pick the kind of {AreaNoun} you have.",
        4 => null,
        _ => LibraryFolderStep.Lead(L, Kind),
    };

    // The one line under an area's name on its row ("Movies, TV shows and other videos."), from the strings file.
    private string? AreaLine(string area) => area switch
    {
        "watch" => L["CreateLibrary_AreaLine_watch"].Value,
        "listen" => L["CreateLibrary_AreaLine_listen"].Value,
        "read" => L["CreateLibrary_AreaLine_read"].Value,
        "view" => L["CreateLibrary_AreaLine_view"].Value,
        _ => null,
    };

    private string FitIcon => _fit switch { FitHeadsUp => AppMaterialIcons.Outlined.WarningAmber, FitAlreadyUsed => AppMaterialIcons.Outlined.ErrorOutline, _ => AppMaterialIcons.Outlined.CheckCircle };
    private string FitTitle => _fit switch
    {
        FitHeadsUp => L["CreateLibrary_HeadsUpTitle"].Value,
        FitAlreadyUsed => L["CreateLibrary_AlreadyUsedTitle"].Value,
        _ => L["CreateLibrary_LooksRightTitle"].Value,
    };
    private string FitText => _fitDetail ?? string.Empty;

    private string Plural => LibraryFolderStep.Plural(Kind);

    private string AreaNoun => _area switch { "watch" => "videos", "listen" => "audio", "read" => "reading", "view" => "photos and files", _ => "media" };

    // Library only ever reads a folder it is not told to manage, so the plain sentence says so; a managed folder is kept tidy as well.
    // "Your files are never changed" is said once, in the folder window's footer, so it is not repeated here.
    // The folder step's one message line, under the handling choice (setup and libraries fixes D7): the error when Add was refused, else the held-kind notice, else the scan line.
    private RenderFragment FolderMessage =>
        !string.IsNullOrWhiteSpace(_error)
            ? @<AppAlert Tone="AppUiTone.Error" Dense="true">@_error</AppAlert>
            : HeldWords is { } held
                ? @<AppAlert Tone="AppUiTone.Warning" Dense="true" data-testid="create-library-held">
                    @held
                    <AppActionBar Align="AppHorizontalAlignment.Start">
                        <AppButton Label="@L["CreateLibraryDialog_ConnectASource"].Value" Size="AppControlSize.Compact" OnClick="ConnectASource" />
                    </AppActionBar>
                </AppAlert>
                : @<p class="create-library__line" data-scan-line>@ScanLine</p>;

    private string ScanLine => Handling == AddFolderHandling.Managed
        ? L["FolderStep_ScanLineManaged"].Value
        : L["FolderStep_ScanLine"].Value;

    private LibraryTypeOption? Kind => _kindKey is null ? null : KindsOfArea.FirstOrDefault(kind => kind.Key == _kindKey);

    // One library per kind (Libraries v3 D17): a kind that already has a library takes the new folder as a second folder of it, so it stays pickable.
    // A kind that already has a library is greyed with "Add a folder to it instead" (setup and libraries fixes D5): its row cannot be chosen, but its button goes to the folder step for it.
    // A host that names the kind (StartKindKey, as a dropped file does) reaches the folder step the same way, so this is the row rule only.
    private bool CanPick(LibraryTypeOption kind) => AvailabilityOf(kind).Enabled && !HasLibrary(kind);

    // The one line of a kind's row: what belongs there, from the kind list (a new kind brings its own); a kind that already has a library says so instead, and a Vault kind that is taken says why.
    private string RowLine(LibraryTypeOption kind, string? reason) =>
        reason ?? (HasLibrary(kind) ? L["CreateLibrary_AlreadyHave", LibraryNameOf(kind)].Value : LibraryKindLook.RowLine(kind));

    private (bool Enabled, string? Reason) AvailabilityOf(LibraryTypeOption kind)
    {
        // Each content type has one Vault library beside its ordinary one; the Engine refuses a second in any case.
        if (_vaultMode && Configuration.Libraries.Any(library => library.IsVault && string.Equals(library.KindKey, kind.Key, StringComparison.Ordinal)))
        {
            return (false, $"You already have a Vault-protected {LabelOf(kind)} library. Add a folder to it instead.");
        }

        return (true, null);
    }

    // The library an ordinary kind already has; View's kinds always exist and are not counted as "has a library" here.
    private bool HasLibrary(LibraryTypeOption kind) => !_vaultMode && !string.Equals(kind.Area, ViewAreaKey, StringComparison.Ordinal) && LibraryRollup.LibrariesOf(Configuration, kind).Count > 0;

    // A Vault library's folders are added as they are (read-only); a folder Library manages in the Vault is part of the Vault update.
    private bool IsVaultChoice => _vaultMode;

    private string PickerMode => Handling == AddFolderHandling.Managed ? ServerFolderSelectionModes.ManagedLibrary : ServerFolderSelectionModes.ExistingLibrary;

    // Read-only unless the person picks Managed in the folder window (Libraries v3 D19); a Vault library's folders are always added as they are.
    private AddFolderHandling Handling => !IsVaultChoice && _handling == FolderHandlingWords.ManagedKey && ManagedAllowed ? AddFolderHandling.Managed : AddFolderHandling.ReadOnly;

    // Managed is offered for kinds whose Engine rules identify, file and name their files (they look details up); a plain kind keeps files as they are.
    private bool ManagedAllowed => !IsVaultChoice && Kind is { } kind && LibraryKindLook.ManagedOffered(kind);

    // The library is named for its kind and the person never types it (Libraries v3 D17). A Vault library carries the "Private" stem.
    private string LibraryNameOf(LibraryTypeOption kind) => IsVaultChoice ? VaultNameStem(LabelOf(kind)) : LibraryTypeCatalog.AddChoiceLabel(kind);

    // Nothing is checked while browsing; the folder is looked at once, when Add library is pressed (the picker keeps only a chosen path).
    private bool FolderUsable => !string.IsNullOrWhiteSpace(_chosenPath);

    private bool CanCreate => !_saving
        && Kind is not null
        && AvailabilityOf(Kind).Enabled
        && FolderUsable;

    // Movies, TV Shows and Comics wait for a source that can identify them (Plugins screens v4 D38); the dialog says so before the
    // library is made. First-run setup has no signed-in plugin list, so it says nothing.
    private IReadOnlySet<string> _heldKinds = new HashSet<string>();

    private string? HeldWords => _kindKey is { } key && _heldKinds.Contains(key)
        ? L[key switch
        {
            "movies" => "CreateLibraryDialog_NothingCanIdentifyFilms",
            "tv" => "CreateLibraryDialog_NothingCanIdentifyShows",
            _ => "CreateLibraryDialog_NothingCanIdentifyComics",
        }].Value
        : null;

    private void ConnectASource()
    {
        Dialog.Cancel();
        Navigation.NavigateTo("/settings/plugins");
    }

    protected override async Task OnInitializedAsync()
    {
        if (Simple || SetupSession is not null)
        {
            return;
        }

        try
        {
            _heldKinds = LibraryFolderHealth.HeldKinds(await Api.GetPluginsAsync());
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            // The plugin list could not be read: the dialog simply does not show the line.
        }
    }

    protected override void OnInitialized()
    {
        _vaultMode = (string.Equals(StartAccessKey, LibraryAccessChoices.Vault, StringComparison.Ordinal)
            || string.Equals(StartAreaKey?.Trim(), LibraryGroupCatalog.VaultKey, StringComparison.OrdinalIgnoreCase)) && VaultAllowed;
        var start = Areas.FirstOrDefault(group => string.Equals(group.Key, StartAreaKey?.Trim(), StringComparison.OrdinalIgnoreCase))
            ?? Areas.FirstOrDefault(group => group.Key == "watch")
            ?? Areas.FirstOrDefault();
        _area = start?.Key ?? "watch";
        var wanted = KindsOfArea.FirstOrDefault(kind => string.Equals(kind.Key, StartKindKey?.Trim(), StringComparison.OrdinalIgnoreCase) && AvailabilityOf(kind).Enabled);
        _kindKey = (wanted ?? KindsOfArea.FirstOrDefault(CanPick))?.Key;
        // A host that already knows the content type (Move to Vault, a dropped file) goes straight to the folder; one that knows the area goes to the type;
        // otherwise the person starts by choosing the area. Back walks the other way.
        _areaChosen = !string.IsNullOrWhiteSpace(StartAreaKey) || _vaultMode;
        _step = wanted is not null ? 3 : _areaChosen ? 2 : 1;
    }

    // After an area row moves the window on, keyboard focus goes to the new list instead of dropping to the page.
    private ElementReference _rowsElement;
    private bool _focusRows;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusRows) return;
        _focusRows = false;
        if (_step is not (1 or 2)) return;
        try
        {
            await _rowsElement.FocusAsync(preventScroll: true);
        }
        catch (JSException)
        {
            // The list was already replaced by the next step; there is nothing to focus.
        }
        catch (InvalidOperationException)
        {
            // A host without a browser (prerender, tests): focus is a nicety, not a requirement.
        }
    }

    // Choosing an area row moves on to its kinds at once.
    private async Task PickAreaAsync(string area)
    {
        await ChooseAreaAsync(area);
        if (_saving) return;
        _returned = false;
        _step = 2;
        _focusRows = true;
    }

    // Choosing a kind row moves on at once: to the folder step, or to the View folder pop-up for a View kind.
    private async Task PickKindAsync(LibraryTypeOption kind)
    {
        if (_saving) return;
        await ChooseKindAsync(kind);
        _returned = false;
        if (Kind is not { } chosen) return;
        if (IsViewArea)
        {
            await AddViewFolderAsync(chosen);
            return;
        }

        _step = 3;
        _folder = null;
    }

    // A different area shows its own content types, with the first one that can still take a library chosen.
    private Task ChooseAreaAsync(string area)
    {
        if (_saving) return Task.CompletedTask;
        _areaChosen = true;
        _error = null;
        if (string.Equals(area, LibraryGroupCatalog.VaultKey, StringComparison.OrdinalIgnoreCase))
        {
            _vaultMode = VaultAllowed;
            _kindKey = KindsOfArea.FirstOrDefault(CanPick)?.Key;
                return Task.CompletedTask;
        }

        _vaultMode = false;
        _area = area;
        _error = null;
        _kindKey = KindsOfArea.FirstOrDefault(CanPick)?.Key;
        return Task.CompletedTask;
    }

    // View has no library to create: the folder joins the View kind through the View folder pop-up, shared with everyone and read where it is.
    private async Task AddViewFolderAsync(LibraryTypeOption kind)
    {
        var parameters = new AppDialogParameters<AddViewFolderDialog>
        {
            { component => component.Kind, kind },
            { component => component.Configuration, Configuration },
            { component => component.SetupSession, SetupSession },
        };
        var dialog = await DialogService.ShowAsync<AddViewFolderDialog>(string.Empty, parameters, AddViewFolderDialog.DialogOptions);
        if (await dialog.Result is not { Canceled: false }) return;

        var libraryId = LibraryRollup.LibrariesOf(Configuration, kind).FirstOrDefault()?.Id ?? string.Empty;
        if (OnCreated is not null) await OnCreated(libraryId);
        Dialog.Close(AppDialogResult.Ok(libraryId));
    }

    private Task BackAsync()
    {
        _step = Math.Max(1, _step == 4 ? 3 : _step - 1);
        // Back to a row step shows the earlier choice as the current one; going forward never does.
        _returned = _step < 3;
        _error = null;
        return Task.CompletedTask;
    }

    private Task ChooseKindAsync(LibraryTypeOption kind)
    {
        if (_kindKey == kind.Key) return Task.CompletedTask;
        _kindKey = kind.Key;
        RestartPicker();
        return Task.CompletedTask;
    }

    // "Add a folder to Movies instead": the kind already has a library, so the dialog goes straight to the folder step for it, where Add folder saves the folder into that library.
    private Task AddFolderInsteadAsync(LibraryTypeOption kind)
    {
        if (_saving || !AvailabilityOf(kind).Enabled) return Task.CompletedTask;
        _kindKey = kind.Key;
        RestartPicker();
        _folder = null;
        _returned = false;
        _step = 3;
        return Task.CompletedTask;
    }

    // The folder is checked for the content type, so a new type checks it again (the picker is rebuilt on the folder already chosen).
    private void RestartPicker()
    {
        _pickerStart = string.IsNullOrWhiteSpace(_chosenPath) ? null : _chosenPath;
        _pickerKey++;
        _error = null;
    }

    // "Private Movies" beside "Movies" (the library the Vault shortcuts make carries the same stem).
    private static string VaultNameStem(string kindLabel) => $"Private {kindLabel}";

    private void FolderNameChanged(string value) => _folderName = value;

    private void HandlingChanged(string value)
    {
        _handling = value;
        _folder = null;
    }

    private Task PathChosen(string path)
    {
        _chosenPath = path;
        _folder = null;
        _error = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    // Vault-protected: the Engine makes the Vault library beside the content type's ordinary one (an administrator is enough, no PIN). The new library is
    // opened only for someone who sees Vault libraries; otherwise the dialog just closes, so nothing about it shows on the page.
    private async Task CreateVaultAsync(LibraryTypeOption kind, ServerFolderValidationResultDto folder)
    {
        var created = await Api.CreateVaultLibraryAsync(new CreateVaultLibraryFromKindRequest(kind.Key, LibraryNameOf(kind), folder.Path));
        if (created is not { Ok: true })
        {
            _error = Api.LastError ?? "The library could not be created. Check the folder and try again.";
            return;
        }

        // The answer carries the new library's id only when the Engine sees the Vault as open for this person.
        var id = created.LibraryId ?? string.Empty;
        if (OnCreated is not null) await OnCreated(id);
        Dialog.Close(AppDialogResult.Ok(id));
        if (VaultVisible && OpenCreated && id.Length > 0) Navigation.NavigateTo($"/settings/libraries/{id}");
    }

    // Add library on the folder step: look inside the folder first (the picker itself reads nothing but the folder list), then show Looks right, Heads up or Already used.
    // A Vault library skips the look, because its answers never name anything outside the Vault.
    private async Task AddClickedAsync()
    {
        if (!CanCreate || Kind is not { } kind) return;
        _saving = true;
        _error = null;
        try
        {
            var request = new ValidateServerFolderRequest { ManualPath = _chosenPath, SelectionMode = PickerMode, KindKey = kind.Key };
            var checkedFolder = Simple ? await Api.ValidateSetupServerFolderAsync(request, SetupSession) : await Api.ValidateServerFolderAsync(request);
            if (checkedFolder is null)
            {
                _error = Api.LastError ?? "The folder could not be checked. Try again.";
                return;
            }

            _folder = checkedFolder;
            if (IsVaultChoice)
            {
                // A Vault library skips the look, because its answers never name anything outside the Vault.
                if (!checkedFolder.CanSelect)
                {
                    _error = checkedFolder.Issues.FirstOrDefault()?.Message ?? "This folder cannot be used.";
                    return;
                }
            }
            else
            {
                var duplicate = checkedFolder.Issues.FirstOrDefault(issue => issue.Code == "already_configured");
                if (duplicate is not null)
                {
                    _fit = FitAlreadyUsed;
                    _fitDetail = duplicate.Message;
                    _step = 4;
                    return;
                }

                if (!checkedFolder.CanSelect)
                {
                    _error = checkedFolder.Issues.FirstOrDefault()?.Message ?? "This folder cannot be used.";
                    return;
                }

                if (Handling == AddFolderHandling.Managed && checkedFolder.SupportedFileCount is > 0)
                {
                    // Managed on a folder that already holds files (Libraries v3 D19): say what will happen before it does.
                    _fit = FitHeadsUp;
                    _fitDetail = FolderHandlingWords.ManagedOnFilesWarning;
                    _step = 4;
                    return;
                }

                var other = checkedFolder.Issues.FirstOrDefault(issue => issue.Code == "looks_like_other_kind");
                var empty = checkedFolder.SupportedFileCount == 0 && !checkedFolder.SupportedFileCountUnavailable;
                if (other is not null || empty)
                {
                    _fit = FitHeadsUp;
                    _fitDetail = other?.Message ?? $"We did not find any {Plural} here. Check it is the right folder, or add it anyway and fill it later.";
                    _step = 4;
                    return;
                }

                _fit = FitLooksRight;
                _fitDetail = checkedFolder.SupportedFileCount is { } found and > 0
                    ? $"Found {found:N0}{(checkedFolder.SupportedFileCountCapped ? "+" : string.Empty)} {checkedFolder.SupportedFileKindLabel ?? "media"} files. {(Simple ? "Library will scan them once setup is finished." : "Library is scanning them now.")}"
                    : "The folder is ready. Library will look inside as soon as it can.";
            }
        }
        finally
        {
            _saving = false;
        }

        await CreateAsync();
    }

    private string? FolderLabel => string.IsNullOrWhiteSpace(_folderName) ? null : _folderName.Trim();

    // The library is saved, then the check's result stays on screen until Done (Looks right) so the person sees what Library found.
    private async Task FinishAsync()
    {
        Dialog.Close(AppDialogResult.Ok(_createdId));
        if (!Simple && OpenCreated && _createdId.Length > 0) Navigation.NavigateTo($"/settings/libraries/{_createdId}");
        await Task.CompletedTask;
    }

    private async Task CreateAsync()
    {
        if (!CanCreate || Kind is not { } kind || _folder is not { } folder) return;
        _saving = true;
        _error = null;
        try
        {
            if (IsVaultChoice)
            {
                await CreateVaultAsync(kind, folder);
                return;
            }

            var existing = HasLibrary(kind) ? LibraryRollup.LibrariesOf(Configuration, kind).FirstOrDefault() : null;
            var plan = new AddFolderPlan(
                kind.Key,
                folder,
                Handling,
                MarkNewMediaHere: Handling == AddFolderHandling.Managed && existing is null,
                LibraryId: existing?.Id,
                NewLibraryName: LibraryNameOf(kind),
                CreateNewLibrary: existing is null,
                Access: LibraryAccessChoices.Standard,
                Label: FolderLabel);
            var result = await AddService.AddAsync(plan, Kinds, Configuration, Scope);
            if (!result.Saved || string.IsNullOrWhiteSpace(result.LibraryId))
            {
                _error = result.Error ?? "The library could not be created. Check the folder and try again.";
                _step = 3;
                return;
            }

            _createdId = result.LibraryId;
            // A scan starts at once so the library page opens on a library that is already filling. Setup scans later, with everything else. A scan
            // that cannot start shows as the library's own status, where Scan now is one click away.
            if (!Simple) await Api.TriggerRescanAsync(folder.Path);

            if (OnCreated is not null) await OnCreated(_createdId);
            // The result stays on screen with Done; a Heads up the person added anyway closes the same way.
            if (_fit == FitHeadsUp)
            {
                _fit = FitLooksRight;
                _fitDetail = "Added. Library will use the folder as it is.";
            }
            _step = 4;
        }
        finally
        {
            _saving = false;
        }
    }
}
