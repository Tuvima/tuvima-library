@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Ui
@inject LibraryFolderAddService AddService
@inject IEngineApiClient Api
@inject NavigationManager Navigation
@inject DashboardSessionAccessor Session
@inject MediaEngine.Web.Services.Vault.NsfwModeState Nsfw
@inject IAppToastService Toasts
@inject IAppDialogService DialogService

@* Add library: one screen. The media area, a name, the content type, who can see it, and the first source folder, checked as it is chosen.
   Create saves the library with that folder, starts a scan and opens the new library's page: no "go to..." question. First-run setup uses the
   same dialog with Simple on (no Access choice, so Standard; no Vault, so no Adult content kind) and stays where it is. For an administrator the
   Access choices include Vault-protected (Library pages D10): chosen here, never switched on or off later; Adult content comes with that tick on (D12). *@
<AppDialogShell Title="Add library" Size="Large" OnClose="@(() => Dialog.Cancel())">
    <ChildContent>
        <div class="create-library">
            <section class="create-library__section">
                <h3 class="create-library__heading">Media area</h3>
                <AppSegmentedControl Options="AreaOptions" Value="@_area" ValueChanged="ChooseAreaAsync" AriaLabel="Media area" Disabled="@_saving" />
            </section>

            <section class="create-library__section">
                <AppTextField Label="Name"
                              Value="@_name"
                              ValueChanged="NameChanged"
                              MaxLength="@MaxNameLength"
                              ReadOnly="@_saving"
                              Error="@(NameProblem is not null)"
                              ErrorText="@NameProblem" />
            </section>

            <section class="create-library__section">
                <h3 class="create-library__heading">Content type <AppInfoTip Text="Library looks for details in the right places for the type you choose. Types that allow only one library can take more folders instead." Label="About content types" /></h3>
                @if (KindsOfArea.Count == 0)
                {
                    <AppQuietNote>There are no content types in this area yet.</AppQuietNote>
                }
                else
                {
                    <div class="create-library__rows" role="group" aria-label="Content type">
                        @foreach (var kind in KindsOfArea)
                        {
                            var availability = AvailabilityOf(kind);
                            <AppChoiceRow Title="@kind.Label"
                                          Description="@(availability.Reason ?? kind.Tooltip)"
                                          Selected="@(kind.Key == _kindKey)"
                                          Disabled="@(_saving || !availability.Enabled)"
                                          OnClick="@(() => ChooseKindAsync(kind))" />
                        }
                    </div>
                }
            </section>

            @if (!Simple)
            {
            <section class="create-library__section">
                <h3 class="create-library__heading">Access <AppInfoTip Text="@AccessTipText" Label="About access" /></h3>
                <LibraryAccessOptions Value="@_access"
                                      ValueChanged="ChooseAccess"
                                      ShowVault="ShowVaultOption"
                                      VaultEnabled="@(VaultChoice.Enabled)"
                                      VaultDisabledReason="@VaultChoice.Reason"
                                      Disabled="@_saving" />
                @if (_access == LibraryAccessChoices.Selected)
                {
                    <AppAlert Tone="AppUiTone.Warning" Dense="true">Nobody but administrators will see this library until you tick profiles on its Access tab.</AppAlert>
                }
                @if (IsAdultContent && ShowVaultOption)
                {
                    <AppSwitchRow Label="Protect with the Vault"
                                  Description="@(_access == LibraryAccessChoices.Vault ? "Kept in the Vault, away from everyone who can't open it." : "Stays a Watch library that only administrators see until you choose profiles on its Access tab.")"
                                  Value="@(_access == LibraryAccessChoices.Vault)"
                                  Disabled="@(_saving || !VaultChoice.Enabled)"
                                  ValueChanged="SetVaultTick" />
                }
            </section>
            }

            <section class="create-library__section">
                <h3 class="create-library__heading">First folder <AppInfoTip Text="Choose a folder on the Library server that holds your files. Library never changes your originals unless you let it." Label="About the first folder" /></h3>
                <div class="create-library__folder">
                    <div class="create-library__folder-path" data-folder-path>
                        @if (_folder is { } chosen)
                        {
                            <AppMaterialIcon Icon="@(FolderUsable ? AppMaterialIcons.Outlined.CheckCircle : AppMaterialIcons.Outlined.WarningAmber)" />
                            <span class="create-library__folder-text">@chosen.Path</span>
                        }
                        else
                        {
                            <span class="create-library__folder-text create-library__folder-text--empty">No folder chosen yet</span>
                        }
                    </div>
                    <AppButton Label="@(_folder is null ? "Browse" : "Change")"
                               StartIcon="@AppMaterialIcons.Outlined.FolderOpen"
                               ButtonStyle="AppButtonStyle.Outlined"
                               Disabled="@(_saving || Kind is null)"
                               OnClick="BrowseAsync" />
                </div>
                @if (_folder is { } problem && !FolderUsable)
                {
                    <AppAlert Tone="AppUiTone.Warning" Dense="true">@FolderProblemText(problem)</AppAlert>
                }
                <AppQuietNote>Only this folder and its subfolders are scanned.</AppQuietNote>
                @if (SubfolderHint is { } hint)
                {
                    <AppQuietNote data-subfolder-hint="@_area">@hint</AppQuietNote>
                }
                <AppQuietNote>Additional folders can be added later.</AppQuietNote>
            </section>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <AppAlert Tone="AppUiTone.Error">@_error</AppAlert>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <AppActionBar Align="AppHorizontalAlignment.End">
            <AppButton Label="Cancel" ButtonStyle="AppButtonStyle.Text" Disabled="@_saving" OnClick="@(() => Dialog.Cancel())" />
            <AppButton Label="Create" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_saving" Disabled="@(!CanCreate)" OnClick="CreateAsync" />
        </AppActionBar>
    </FooterContent>
</AppDialogShell>

@code {
    /// <summary>The most characters a library name may have.</summary>
    public const int MaxNameLength = 80;

    /// <summary>The kind that is only ever offered with the Vault tick (Libraries spec D12, D21).</summary>
    public const string AdultContentKindKey = "adult_content";

    /// <summary>The centred dialog every host opens Add library with.</summary>
    public static AppDialogOptions DialogOptions { get; } = new()
    {
        MaxWidth = AppMaxWidth.Medium,
        FullWidth = true,
        CloseButton = false,
        NoHeader = true,
        CloseOnEscapeKey = true,
    };

    // Watch, Listen and Read take Add library; View keeps its own add form.
    private static readonly string[] OfferedAreas = ["watch", "listen", "read"];

    [CascadingParameter] private IAppDialogContext Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public LibrariesConfigurationDto Configuration { get; set; } = default!;
    [Parameter, EditorRequired] public LibraryKindCatalog Kinds { get; set; } = default!;
    /// <summary>Opens with this media area chosen (watch, listen or read); null opens on Watch.</summary>
    [Parameter] public string? StartAreaKey { get; set; }
    /// <summary>Opens with this content type chosen when it can still take a library.</summary>
    [Parameter] public string? StartKindKey { get; set; }
    /// <summary>First-run setup: Standard access only, no Vault. The dialog stays where it is after Create instead of opening the library page.</summary>
    [Parameter] public bool Simple { get; set; }
    /// <summary>The first-run setup session; the setup calls are used instead of the signed-in ones.</summary>
    [Parameter] public string? SetupSession { get; set; }
    /// <summary>Called with the new library's id once it is saved, so the host can read the libraries again.</summary>
    [Parameter] public Func<string, Task>? OnCreated { get; set; }
    /// <summary>Opens with this access chosen (Add a Vault library from Move to Vault arrives with Vault-protected chosen). Ignored when the person may not choose it.</summary>
    [Parameter] public string? StartAccessKey { get; set; }
    /// <summary>True when the host shows Vault libraries (the administrator's Vault mode is on); only then does Create open the new Vault library's page.</summary>
    [Parameter] public bool VaultVisible { get; set; }
    /// <summary>False when the host carries on with what it was doing (Move to Vault continues from its preview) instead of opening the new library.</summary>
    [Parameter] public bool OpenCreated { get; set; } = true;

    private string _area = "watch";
    private string? _kindKey;
    private string _name = string.Empty;
    private bool _nameTouched;
    private string _access = LibraryAccessChoices.Standard;
    // True while the access was set for the person by the content type (Adult content), so leaving that type puts it back.
    private bool _accessFollowsKind;
    private ServerFolderValidationResultDto? _folder;
    // Where the folder picker opens: the folder already chosen when the content type changes under it.
    private string? _pickerStart;
    private bool _saving;
    private string? _error;

    private FolderAddScope Scope => new(Simple, SetupSession);
    // Only a server administrator whose Vault mode is on is offered Vault-protected (and Adult content), and never in first-run setup. For anyone else, an
    // administrator with Vault mode off included, the dialog holds no Vault word at all, so nothing here can tell them the Vault exists.
    private bool ShowVaultOption => !Simple && LibraryVaultAccess.CanShow(Nsfw, Session, isKids: false);

    private string AccessTipText => ShowVaultOption
        ? "Standard: everyone who can use this area. Selected profiles: only the profiles you choose. Vault-protected: kept in the Vault, and it cannot be changed later."
        : "Standard: everyone who can use this area. Selected profiles: only the profiles you choose.";

    private IReadOnlyList<LibraryGroup> Areas => [.. Kinds.Groups.Where(group => OfferedAreas.Contains(group.Key, StringComparer.Ordinal))];

    private IReadOnlyList<AppSelectOption> AreaOptions => [.. Areas.Select(group => new AppSelectOption(group.Key, group.Label, group.Icon))];

    // Adult content is offered to administrators only, and never in first-run setup, which offers Standard access only.
    private IReadOnlyList<LibraryTypeOption> KindsOfArea => Kinds.TryGetGroup(_area) is { } group
        ? [.. group.TypeKeys.Select(Kinds.Find).OfType<LibraryTypeOption>().Where(kind => ShowVaultOption || kind.Key != AdultContentKindKey)]
        : [];

    private LibraryTypeOption? Kind => _kindKey is null ? null : KindsOfArea.FirstOrDefault(kind => kind.Key == _kindKey);
    private bool IsAdultContent => string.Equals(_kindKey, AdultContentKindKey, StringComparison.Ordinal);

    // A kind that holds one library cannot start a second (its folders merge instead); a kind that holds several stops at its limit.
    private (bool Enabled, string? Reason) AvailabilityOf(LibraryTypeOption kind)
    {
        var held = LibraryRollup.LibrariesOf(Configuration, kind).Count;
        if (!kind.AllowsMultiple)
        {
            return held >= 1 ? (false, $"You already have a {kind.Label} library. Add a folder to it instead.") : (true, null);
        }

        return held >= kind.MaxLibraries
            ? (false, $"You already have {kind.MaxLibraries} {kind.PluralLabel} libraries, the most you can keep. Add a folder to one of them instead.")
            : (true, null);
    }

    // A Vault library's folders are added as they are (read-only); a folder Library manages in the Vault is part of the Vault update.
    private bool IsVaultChoice => _access == LibraryAccessChoices.Vault;

    private string PickerMode => Kind is { DefaultHandling: "managed" } && !IsVaultChoice ? ServerFolderSelectionModes.ManagedLibrary : ServerFolderSelectionModes.ExistingLibrary;

    // Read-only (As-is) unless the kind's own default is Managed.
    private AddFolderHandling Handling => Kind is { DefaultHandling: "managed" } && !IsVaultChoice ? AddFolderHandling.Managed : AddFolderHandling.ReadOnly;

    // Each content type has one Vault library beside its ordinary one. Known only to a viewer who sees Vault libraries; the Engine refuses a second in any case.
    private (bool Enabled, string? Reason) VaultChoice
    {
        get
        {
            if (Kind is { } kind && Configuration.Libraries.Any(library => string.Equals(library.Access, LibraryAccessChoices.Vault, StringComparison.OrdinalIgnoreCase)
                    && string.Equals(library.KindKey, kind.Key, StringComparison.Ordinal)))
            {
                return (false, $"You already have a Vault-protected {kind.Label} library. Add a folder to it instead.");
            }

            return (true, null);
        }
    }

    private string? SubfolderHint => SubfolderHints.For(_area);

    // The name must be there, fit, and be new within the area ("Home videos" twice would be two rows nobody could tell apart).
    private string? NameProblem
    {
        get
        {
            var name = _name.Trim();
            if (name.Length == 0) return _nameTouched ? "Give the library a name." : null;
            if (name.Length > MaxNameLength) return $"Use {MaxNameLength} characters or fewer.";
            return NameTaken(name) ? $"You already have a library called \"{name}\" in this area. Choose a different name." : null;
        }
    }

    private bool NameTaken(string name) => Configuration.Libraries.Any(library =>
        string.Equals(library.Area, _area, StringComparison.OrdinalIgnoreCase)
        && string.Equals(library.Name?.Trim(), name, StringComparison.OrdinalIgnoreCase));

    private bool AccessChoosable => _access == LibraryAccessChoices.Standard
        || (_access == LibraryAccessChoices.Selected && LibraryAccessOptions.SelectedProfilesAvailable)
        || (_access == LibraryAccessChoices.Vault && LibraryAccessOptions.VaultAvailable && ShowVaultOption && VaultChoice.Enabled);

    private bool FolderUsable => _folder is { CanSelect: true, Exists: true, HasRead: true };

    private bool CanCreate => !_saving
        && !string.IsNullOrWhiteSpace(_name)
        && _name.Trim().Length <= MaxNameLength
        && NameProblem is null
        && Kind is not null
        && AvailabilityOf(Kind).Enabled
        && AccessChoosable
        && FolderUsable;

    protected override void OnInitialized()
    {
        var start = Areas.FirstOrDefault(group => string.Equals(group.Key, StartAreaKey?.Trim(), StringComparison.OrdinalIgnoreCase))
            ?? Areas.FirstOrDefault(group => group.Key == "watch")
            ?? Areas.FirstOrDefault();
        _area = start?.Key ?? "watch";
        var wanted = KindsOfArea.FirstOrDefault(kind => string.Equals(kind.Key, StartKindKey?.Trim(), StringComparison.OrdinalIgnoreCase) && AvailabilityOf(kind).Enabled);
        _kindKey = (wanted ?? KindsOfArea.FirstOrDefault(kind => AvailabilityOf(kind).Enabled))?.Key;
        if (string.Equals(StartAccessKey, LibraryAccessChoices.Vault, StringComparison.Ordinal) && ShowVaultOption && VaultChoice.Enabled)
        {
            _access = LibraryAccessChoices.Vault;
        }
        else
        {
            FollowKindAccess();
        }

        PrefillName();
    }

    private Task ChooseAreaAsync(string area)
    {
        if (_area == area) return Task.CompletedTask;
        _area = area;
        _kindKey = KindsOfArea.FirstOrDefault(kind => AvailabilityOf(kind).Enabled)?.Key;
        FollowKindAccess();
        PrefillName();
        RestartPicker();
        return Task.CompletedTask;
    }

    private Task ChooseKindAsync(LibraryTypeOption kind)
    {
        if (_kindKey == kind.Key) return Task.CompletedTask;
        _kindKey = kind.Key;
        FollowKindAccess();
        PrefillName();
        RestartPicker();
        return Task.CompletedTask;
    }

    // Adult content comes with the Vault tick on (Library pages D12). Where the person may not choose the Vault, or after they untick it, it starts as
    // Selected profiles so it never opens to every profile by accident (D21). Moving to another type puts back what the type had set.
    private void FollowKindAccess()
    {
        if (IsAdultContent)
        {
            if (!_accessFollowsKind || _access == LibraryAccessChoices.Standard)
            {
                _access = ShowVaultOption && VaultChoice.Enabled ? LibraryAccessChoices.Vault : LibraryAccessChoices.Selected;
                _accessFollowsKind = true;
            }

            return;
        }

        if (_accessFollowsKind)
        {
            _access = LibraryAccessChoices.Standard;
            _accessFollowsKind = false;
        }

        // A Vault choice that no longer fits the type (it already has a Vault library) falls back to Standard rather than blocking Create.
        if (_access == LibraryAccessChoices.Vault && (!ShowVaultOption || !VaultChoice.Enabled))
        {
            _access = LibraryAccessChoices.Standard;
        }
    }

    private void ChooseAccess(string value)
    {
        _access = value;
        _accessFollowsKind = false;
        PrefillName();
    }

    private void SetVaultTick(bool ticked) => ChooseAccess(ticked ? LibraryAccessChoices.Vault : LibraryAccessChoices.Selected);

    // The folder is checked for the content type, so a new type checks it again (the picker is rebuilt on the folder already chosen).
    private void RestartPicker()
    {
        _pickerStart = _folder?.Path;
        _error = null;
        if (_folder is not null) _ = RecheckFolderAsync();
    }

    // The folder already chosen is checked again for the new content type, so changing the type never throws the choice away.
    private async Task RecheckFolderAsync()
    {
        var path = _folder?.Path;
        if (string.IsNullOrWhiteSpace(path)) return;
        var request = new ValidateServerFolderRequest { ManualPath = path, SelectionMode = PickerMode, KindKey = _kindKey };
        var result = string.IsNullOrWhiteSpace(SetupSession)
            ? await Api.ValidateServerFolderAsync(request)
            : await Api.ValidateSetupServerFolderAsync(request, SetupSession);
        if (!string.Equals(_folder?.Path, path, StringComparison.Ordinal)) return;
        _folder = result;
        await InvokeAsync(StateHasChanged);
    }

    // Choose source folder: its own pop-up over this one, so the browser has room and this screen stays short.
    private async Task BrowseAsync()
    {
        var parameters = new AppDialogParameters<ServerFolderPicker>
        {
            { component => component.Title, "Choose source folder" },
            { component => component.HelpText, "Choose the folder on the Library server that holds your files." },
            { component => component.ConfirmLabel, "Use this folder" },
            { component => component.SelectionMode, PickerMode },
            { component => component.KindKey, _kindKey },
            { component => component.SetupSession, SetupSession },
            { component => component.InitialPath, _folder?.Path ?? _pickerStart },
        };
        var dialog = await DialogService.ShowAsync<ServerFolderPicker>(string.Empty, parameters,
            new AppDialogOptions { MaxWidth = AppMaxWidth.ExtraExtraLarge, FullWidth = false, CloseButton = false, CloseOnEscapeKey = true });
        if (await dialog.Result is { Canceled: false, Data: ServerFolderValidationResultDto selected })
        {
            await FolderChecked(selected);
        }
    }

    private static string FolderProblemText(ServerFolderValidationResultDto folder) =>
        folder.Issues.FirstOrDefault(issue => issue.Severity == "error")?.Message ?? "Library can't use this folder. Choose another one.";

    // The name starts as the content type's name (a second "Videos" becomes "Videos 2") and follows the type until the person types their own.
    private void PrefillName()
    {
        if (_nameTouched) return;
        var kind = Kind;
        if (kind is null)
        {
            _name = string.Empty;
            return;
        }

        var stem = IsVaultChoice ? VaultNameStem(kind.Label) : kind.Label;
        var suggestion = stem;
        for (var number = 2; NameTaken(suggestion); number++)
        {
            suggestion = $"{stem} {number}";
        }

        _name = suggestion;
    }

    // "Private Movies" beside "Movies" (the library the Vault shortcuts make carries the same stem).
    private static string VaultNameStem(string kindLabel) => $"Private {kindLabel}";

    private void NameChanged(string? value)
    {
        _name = value ?? string.Empty;
        _nameTouched = true;
    }

    private Task FolderChecked(ServerFolderValidationResultDto? folder)
    {
        _folder = folder;
        _error = null;
        return Task.CompletedTask;
    }

    // Vault-protected: the Engine makes the Vault library beside the content type's ordinary one (an administrator is enough, no PIN). The new library is
    // opened only for someone who sees Vault libraries; otherwise the dialog just closes, so nothing about it shows on the page.
    private async Task CreateVaultAsync(LibraryTypeOption kind, ServerFolderValidationResultDto folder)
    {
        var created = await Api.CreateVaultLibraryAsync(new CreateVaultLibraryFromKindRequest(kind.Key, _name.Trim(), folder.Path));
        if (created is not { Ok: true })
        {
            _error = Api.LastError ?? "The library could not be created. Check the folder and try again.";
            return;
        }

        // The answer carries the new library's id only when the Engine sees the Vault as open for this person.
        var id = created.LibraryId ?? string.Empty;
        Toasts.Add($"{_name.Trim()} created.", AppSeverity.Success);
        if (OnCreated is not null) await OnCreated(id);
        Dialog.Close(AppDialogResult.Ok(id));
        if (VaultVisible && OpenCreated && id.Length > 0) Navigation.NavigateTo($"/settings/libraries/{id}");
    }

    private async Task CreateAsync()
    {
        if (!CanCreate || Kind is not { } kind || _folder is not { } folder) return;
        _saving = true;
        _error = null;
        try
        {
            if (IsVaultChoice)
            {
                await CreateVaultAsync(kind, folder);
                return;
            }

            var plan = new AddFolderPlan(
                kind.Key,
                folder,
                Handling,
                MarkNewMediaHere: Handling == AddFolderHandling.Managed,
                NewLibraryName: _name.Trim(),
                CreateNewLibrary: true,
                Access: _access,
                SuccessMessage: $"{_name.Trim()} created.");
            var result = await AddService.AddAsync(plan, Kinds, Configuration, Scope);
            if (!result.Saved || string.IsNullOrWhiteSpace(result.LibraryId))
            {
                _error = result.Error ?? "The library could not be created. Check the folder and try again.";
                return;
            }

            var libraryId = result.LibraryId;
            // A scan starts at once so the library page opens on a library that is already filling. Setup scans later, with everything else.
            if (!Simple && !await Api.TriggerRescanAsync(folder.Path))
            {
                Toasts.Add("The library was created, but the first scan could not start. Use Scan now on its page.", AppSeverity.Warning);
            }

            if (OnCreated is not null) await OnCreated(libraryId);
            Dialog.Close(AppDialogResult.Ok(libraryId));
            if (!Simple && OpenCreated) Navigation.NavigateTo($"/settings/libraries/{libraryId}");
        }
        finally
        {
            _saving = false;
        }
    }
}
