@namespace MediaEngine.Web.Components.Settings

@* "Libraries > Watch > Movies": every step but the last is a link, so Back and the breadcrumb both climb one level. *@
<nav class="lib-crumbs" aria-label="Breadcrumb">
    @for (var index = 0; index < Crumbs.Count; index++)
    {
        var crumb = Crumbs[index];
        if (index > 0)
        {
            <span class="lib-crumbs__separator" aria-hidden="true">&rsaquo;</span>
        }
        @if (!string.IsNullOrWhiteSpace(crumb.Href))
        {
            <a href="@crumb.Href">@crumb.Label</a>
        }
        else
        {
            <span aria-current="page">@crumb.Label</span>
        }
    }
</nav>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<LibraryCrumb> Crumbs { get; set; } = [];
}
