@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Library
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Services.Ui
@inject IAppDialogService DialogService

@* The Libraries front door: one card per group (Watch, Listen, Read, View, and the Vault when it may be shown) with its types,
   a health icon and counts, then the Import folder row. The page title and one-line subtitle come from the Settings frame. *@
<div class="lib-door">
    @if (ReadOnly)
    {
        <p class="lib-door__note">Use a desktop or tablet to change folders.</p>
    }

    <div class="lib-door__groups">
        @foreach (var summary in Summaries)
        {
            var group = summary.Group;
            var vault = group.Key == LibraryGroupCatalog.VaultKey;
            @* The warning's words open on hover and on keyboard focus of the link itself. *@
            <AppTooltip Class="lib-door__tip" Text="@(summary.Health is { Healthy: false } ? summary.Health.Text : null)">
            <a class="@($"lib-door__group lib-door__group--{group.Key}{(vault ? " lib-door__group--strip" : string.Empty)}")"
               href="@LibraryGroupCatalog.GroupAddress(group)"
               data-group="@group.Key"
               aria-label="@AccessibleName(summary)">
                <span class="lib-door__tile"><AppMaterialIcon Icon="@group.Icon" /></span>
                <span class="lib-door__text">
                    <strong class="lib-door__name">@group.Label</strong>
                    @if (!vault)
                    {
                        <small class="lib-door__types">@TypeNames(group)</small>
                    }
                    <span class="lib-door__counts">@LibraryRollup.CountsText(summary.Folders, summary.Titles)</span>
                </span>
                <LibraryHealthIcon Health="@summary.Health" />
                <span class="lib-door__chevron"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" /></span>
            </a>
            </AppTooltip>
        }
    </div>

    <a class="lib-door__import" href="/settings/libraries/import" aria-label="@($"Import folder, {ImportText}")">
        <span class="lib-door__tile lib-door__tile--import"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.MoveToInbox" /></span>
        <span class="lib-door__text"><strong class="lib-door__name">Import folder</strong></span>
        <span class="lib-door__counts">@ImportText</span>
        <span class="lib-door__chevron"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" /></span>
    </a>

    @foreach (var other in LibraryRollup.OthersWithoutGroup(Configuration))
    {
        var row = LibraryRollup.RowFor(other, Configuration, Overview, ViewFolders, PathIssues);
        <a class="lib-door__import" href="@($"/settings/libraries/other/{other.Key}")" aria-label="@($"{other.Label}, {LibraryRollup.CountsText(row.Folders, row.Titles)}")">
            <span class="lib-door__tile lib-door__tile--import"><AppMaterialIcon Icon="@other.Icon" /></span>
            <span class="lib-door__text"><strong class="lib-door__name">@other.Label</strong></span>
            <span class="lib-door__counts">@LibraryRollup.CountsText(row.Folders, row.Titles)</span>
            <span class="lib-door__chevron"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" /></span>
        </a>
    }

    @if (!ReadOnly)
    {
        <div class="lib-door__actions">
            <AppButton Label="Add folder"
                       StartIcon="@AppMaterialIcons.Outlined.Add"
                       ButtonStyle="@(NoFolders ? AppButtonStyle.Filled : AppButtonStyle.Outlined)"
                       Tone="@(NoFolders ? AppUiTone.Primary : AppUiTone.Neutral)"
                       Class="lib-door__add"
                       aria-label="Add folder"
                       OnClick="AddFolderAsync" />
        </div>
    }

    <LibraryIconLegend ShowHealth="true" />
</div>

@code {
    [Parameter, EditorRequired] public LibrariesConfigurationDto Configuration { get; set; } = default!;
    /// <summary>The Engine's overview counts; null when they could not be read (only folder counts show then).</summary>
    [Parameter] public LibraryOverviewDto? Overview { get; set; }
    /// <summary>View's own folder count; null while it is not known (the card shows no count rather than a guess).</summary>
    [Parameter] public int? ViewFolders { get; set; }
    /// <summary>Folder path to issue, from <see cref="LibraryFolderHealth.CheckAsync"/>; null while the checks have not finished (no health icon is shown then).</summary>
    [Parameter] public IReadOnlyDictionary<string, string>? PathIssues { get; set; }
    /// <summary>
    /// Draws the Vault strip. The Vault card follows the Vault's privacy rules, so the host decides; today it is always false
    /// because Vault mode does not exist yet (the Videos Vault work adds it, and a later packet wires it here).
    /// </summary>
    [Parameter] public bool ShowVault { get; set; }
    /// <summary>Phones: cards and counts only, with a note saying where to change folders.</summary>
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>Raised after a folder was added through the wizard, so the page can refresh its counts.</summary>
    [Parameter] public EventCallback FolderAdded { get; set; }

    // With no folder anywhere (View's included) the button is the one prominent primary action on the page.
    private bool NoFolders => Configuration.Libraries.All(library => library.Sources.Count == 0) && (ViewFolders ?? 0) == 0;

    private async Task AddFolderAsync()
    {
        var parameters = new AppDialogParameters<AddFolderWizard>
        {
            { component => component.ShowVault, ShowVault },
            { component => component.Configuration, Configuration },
            { component => component.OnFolderAdded, (Func<string?, Task>)(_ => FolderAdded.InvokeAsync()) },
        };
        await DialogService.ShowAsync<AddFolderWizard>(string.Empty, parameters, AddFolderWizard.DialogOptions);
    }

    private IReadOnlyList<LibraryGroupSummary> Summaries => [.. LibraryGroupCatalog.Visible(ShowVault)
        .Select(group => LibraryRollup.SummaryFor(group, Configuration, Overview, ViewFolders, PathIssues))];

    private string ImportText => Configuration.ImportFolderStatus?.Configured == true ? "Set" : "Not set";

    private static string TypeNames(LibraryGroup group) => string.Join(" · ", group.TypeKeys
        .Select(LibraryTypeCatalog.Find)
        .OfType<LibraryTypeOption>()
        .Select(type => type.Label));

    // "Watch, 3 folders, 1,284 titles, all folders healthy": the same facts the card shows, in one spoken line.
    private static string AccessibleName(LibraryGroupSummary summary)
    {
        if (summary.Folders is null) return summary.Group.Label;
        if (summary.Folders == 0) return $"{summary.Group.Label}, nothing added yet";
        var counts = LibraryRollup.CountsText(summary.Folders, summary.Titles).Replace(" · ", ", ", StringComparison.Ordinal);
        return summary.Health is null
            ? $"{summary.Group.Label}, {counts}"
            : $"{summary.Group.Label}, {counts}, {(summary.Health.Healthy ? "all folders healthy" : summary.Health.Text)}";
    }
}
