@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings

@* The file-drop dialog's kinds, as the same full-width rows Add library draws (setup and libraries fixes D5): the kind's icon on its area's colour, its name and
   one line from the kind list, with the Metadata icons at the end of the row when asked for. No hover card and no tooltip on the row. *@
<div class="lib-choice__kinds" role="group" aria-label="@Label">
    @foreach (var kind in Kinds)
    {
        <LibraryChoiceRow Key="@kind.Key"
                          Title="@kind.Label"
                          Icon="@kind.Icon"
                          AreaKey="@kind.Area.ToLowerInvariant()"
                          Line="@LibraryKindLook.RowLine(kind)"
                          Selected="@(kind.Key == SelectedKey)"
                          data-type="@kind.Key"
                          OnClick="@(() => OnChoose.InvokeAsync(kind))">
            @if (ShowMetadata)
            {
                <LibraryMetadataCell Type="@kind" Catalogue="@Catalogue" />
            }
        </LibraryChoiceRow>
    }
</div>

@code {
    /// <summary>The kinds to offer, in the order to draw them.</summary>
    [Parameter, EditorRequired] public IEnumerable<LibraryTypeOption> Kinds { get; set; } = [];
    /// <summary>The accessible name of the group of cards.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    /// <summary>The key of the kind chosen so far, or null.</summary>
    [Parameter] public string? SelectedKey { get; set; }
    /// <summary>Draws each kind's Metadata icons (the providers it looks details up from) at the end of its row.</summary>
    [Parameter] public bool ShowMetadata { get; set; }
    /// <summary>The provider catalogue the Metadata icons are drawn from; null while it is not known.</summary>
    [Parameter] public IReadOnlyList<ProviderCatalogueDto>? Catalogue { get; set; }
    /// <summary>Raised with the kind whose row was pressed.</summary>
    [Parameter] public EventCallback<LibraryTypeOption> OnChoose { get; set; }
}
