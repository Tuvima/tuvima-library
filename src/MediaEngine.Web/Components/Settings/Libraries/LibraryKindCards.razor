@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings

@* The kind cards: an icon tile (coloured when the kind looks details up, grey when it files as it is) and the kind's name; hovering or focusing a card
   opens its hover card with what belongs in it (Libraries v3 D24, no (i) and no browser tooltip). Change kind and the file-drop dialog both draw their kinds from here. *@
<div class="lib-choice__kinds" role="group" aria-label="@Label">
    @foreach (var kind in Kinds)
    {
        <div class="lib-choice__kind">
            <LibraryPeek Title="@kind.Label" About="@kind.Explainer" Examples="@kind.Examples" LibraryDoes="@kind.LibraryDoes">
            <AppNativeButton Type="button"
                             Class="@($"lib-choice__kind-option{(kind.Key == SelectedKey ? " is-selected" : string.Empty)}")"
                             data-type="@kind.Key"
                             OnClick="@(_ => OnChoose.InvokeAsync(kind))">
                <span class="@LibraryKindLook.TileClass(kind)" data-lookup="@(LibraryKindLook.LooksUp(kind) ? "true" : "false")"><AppMaterialIcon Icon="@kind.Icon" /></span>
                <strong>@kind.Label</strong>
            </AppNativeButton>
            </LibraryPeek>
            @if (ShowMetadata)
            {
                <LibraryMetadataCell Type="@kind" Catalogue="@Catalogue" />
            }
        </div>
    }
</div>

@code {
    /// <summary>The kinds to offer, in the order to draw them.</summary>
    [Parameter, EditorRequired] public IEnumerable<LibraryTypeOption> Kinds { get; set; } = [];
    /// <summary>The accessible name of the group of cards.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    /// <summary>The key of the kind chosen so far, or null.</summary>
    [Parameter] public string? SelectedKey { get; set; }
    /// <summary>Draws each kind's Metadata icons (the providers it looks details up from) beside its card.</summary>
    [Parameter] public bool ShowMetadata { get; set; }
    /// <summary>The provider catalogue the Metadata icons are drawn from; null while it is not known.</summary>
    [Parameter] public IReadOnlyList<ProviderCatalogueDto>? Catalogue { get; set; }
    /// <summary>Raised with the kind whose card was pressed.</summary>
    [Parameter] public EventCallback<LibraryTypeOption> OnChoose { get; set; }
}
