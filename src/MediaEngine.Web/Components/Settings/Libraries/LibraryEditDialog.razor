@namespace MediaEngine.Web.Components.Settings
@using System.Text.Json
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Ui
@inject LibraryFolderAddService AddService
@inject IAppDialogService DialogService
@inject IEngineApiClient Api
@inject IStringLocalizer<SharedStrings> L
@inject DashboardSessionAccessor Session
@inject MediaEngine.Web.Services.Vault.NsfwModeState Nsfw

@* Edit (Libraries and folder picker D4, Libraries v3 D17 to D19, D27): one window for a library's folders (the library's own name is fixed by its kind and never edited), with the fixed footer. The folders are a table: Folder name (with two or more
   folders), Path and How Library uses it. Nothing is saved until Save changes, which first shows Review: the plain list of what will happen. Removing a folder never deletes files. Scan now and Remove library (asks once) sit at the left of the footer,
   Cancel and Save changes at the right; Move to Vault (administrators) is in a folder's menu, so the table row needs only one Edit button. The Import folder uses the same window with its one folder. *@
<AppDialogShell Title="@Title" Subtitle="@Lead" Size="Large" OnClose="@(() => Dialog.Cancel())">
    <ChildContent>
        <div class="lib-edit" data-step="@(_review ? "review" : "edit")">
            @if (_review)
            {
                <ul class="lib-edit__review" data-review>
                    @foreach (var line in ReviewLines)
                    {
                        <li>@line</li>
                    }
                </ul>
            }
            else
            {
                @if (KeptSources.Count > 0 || _added.Count > 0)
                {
                    <AppTable Dense="true" aria-label="@L["LibraryEditDialog_Folders"].Value" data-folder-rows>
                        <thead>
                            <tr>
                                @if (ShowFolderNames)
                                {
                                    <th>@L["LibraryEditDialog_ColFolderName"]</th>
                                }
                                <th>@L["LibraryEditDialog_ColPath"]</th>
                                @if (!Import)
                                {
                                    <th>@L["LibraryEditDialog_ColHandling"]</th>
                                }
                                <th class="lib-edit__actions"><span class="sr-only">@L["Common_Actions"]</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var source in KeptSources)
                            {
                                var issue = IssueFor(source.Path);
                                <tr class="lib-edit__folder" data-source="@source.Id">
                                    @if (ShowFolderNames)
                                    {
                                        @* With two or more folders each one's friendly name can be edited here (Libraries v3 D18). *@
                                        <td>
                                            <AppTextField Label="@L["LibraryEditDialog_FriendlyName"].Value"
                                                          HideLabel="true"
                                                          Value="@LabelOf(source)"
                                                          ValueChanged="@((string? value) => _labels[source.Id] = value ?? string.Empty)"
                                                          MaxLength="@FolderHandlingWords.MaxFolderNameLength"
                                                          ReadOnly="@_saving"
                                                          Error="@(LabelProblem(source) is not null)"
                                                          ErrorText="@LabelProblem(source)" />
                                        </td>
                                    }
                                    <td>
                                        <span class="lib-edit__pathcell">
                                            <span class="lib-edit__path" data-overflow-tooltip="@source.Path">@source.Path</span>
                                            @if (issue is not null)
                                            {
                                                @* An offline folder is marked beside its path, not in a column of its own. *@
                                                <span class="lib-edit__state" data-state="offline">@issue</span>
                                            }
                                        </span>
                                    </td>
                                    @if (!Import)
                                    {
                                        <td><span class="lib-edit__tag" data-handling="@(IsManaged(source) ? "managed" : "read-only")">@HandlingText(source)</span></td>
                                    }
                                    <td class="lib-edit__actions">
                                        <AppRowMenu AriaLabel="@L["LibraryEditDialog_ActionsFor", source.Path].Value" Items="@FolderMenu(source)" />
                                    </td>
                                </tr>
                            }
                            @foreach (var added in _added)
                            {
                                var info = AddedInfoOf(added);
                                <tr class="lib-edit__folder lib-edit__folder--new" data-added="@added.Path">
                                    @if (ShowFolderNames)
                                    {
                                        <td><strong class="lib-edit__label">@info.Label</strong></td>
                                    }
                                    <td>
                                        <span class="lib-edit__pathcell">
                                            <span class="lib-edit__path" data-overflow-tooltip="@added.Path">@added.Path</span>
                                            <span class="lib-edit__state">@L["LibraryEditDialog_WillBeAdded"]</span>
                                        </span>
                                    </td>
                                    @if (!Import)
                                    {
                                        <td><span class="lib-edit__tag" data-handling="@(info.Managed ? "managed" : "read-only")">@FolderHandlingWords.LabelFor(info.Managed)</span></td>
                                    }
                                    <td class="lib-edit__actions">
                                        <AppIconButton Icon="@AppMaterialIcons.Outlined.Close" Tooltip="@L["LibraryEditDialog_DontAdd"].Value" AriaLabel="@L["LibraryEditDialog_DontAddPath", added.Path].Value" OnClick="@(() => _added.Remove(added))" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </AppTable>
                }
                else
                {
                    <p class="lib-edit__note">@(Import ? L["LibraryEditDialog_NoImportFolder"].Value : L["LibraryEditDialog_NoFolders"].Value)</p>
                }

                @if (!Import || (KeptSources.Count == 0 && _added.Count == 0))
                {
                    <AppButton Label="@(Import ? L["LibrariesOverview_ChooseAFolder"].Value : L["LibraryEditDialog_AddFolder"].Value)" StartIcon="@AppMaterialIcons.Outlined.Add" ButtonStyle="AppButtonStyle.Outlined" Disabled="@_saving" OnClick="AddFolderAsync" />
                }

                @if (!Import && _scanNote is not null)
                {
                    <p class="lib-edit__note" role="status">@_scanNote</p>
                }
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <AppAlert Tone="AppUiTone.Error">@_error</AppAlert>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <AppActionBar Align="AppHorizontalAlignment.End">
            @if (_review)
            {
                <AppButton Label="@L["LibraryEditDialog_Back"].Value" ButtonStyle="AppButtonStyle.Text" Disabled="@_saving" OnClick="@(() => _review = false)" />
                <AppButton Label="@L["LibraryEditDialog_Save"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_saving" OnClick="SaveAsync" />
            }
            else
            {
                @if (!Import)
                {
                    @* The quiet and the destructive action sit together at the far left (Look v3 footer order); Cancel and Save changes are the right-hand group. *@
                    <span class="lib-edit__footer-start app-footer-start" data-footer-start>
                        @if (!IsVault && !Scope.Embedded)
                        {
                            <AppButton Label="@L["LibraryEditDialog_ScanNow"].Value" StartIcon="@AppMaterialIcons.Outlined.Sync" ButtonStyle="AppButtonStyle.Text" Disabled="@(_saving || Library!.Sources.Count == 0)" OnClick="ScanNowAsync" />
                        }
                        <AppButton Label="@L["LibraryEditDialog_RemoveLibrary"].Value" StartIcon="@AppMaterialIcons.Outlined.Delete" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Error" Disabled="@_saving" OnClick="RemoveLibraryAsync" />
                    </span>
                }
                <AppButton Label="@L["LibraryEditDialog_Cancel"].Value" ButtonStyle="AppButtonStyle.Text" Disabled="@_saving" OnClick="@(() => Dialog.Cancel())" />
                <AppButton Label="@L["LibraryEditDialog_SaveChanges"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(!CanReview)" OnClick="OpenReview" />
            }
        </AppActionBar>
    </FooterContent>
</AppDialogShell>

@code {
    [CascadingParameter] private IAppDialogContext Dialog { get; set; } = default!;
    /// <summary>The library being edited; null for the Import folder.</summary>
    [Parameter] public LibraryFolderDto? Library { get; set; }
    [Parameter, EditorRequired] public LibrariesConfigurationDto Configuration { get; set; } = default!;
    [Parameter, EditorRequired] public LibraryKindCatalog Kinds { get; set; } = default!;
    [Parameter] public IReadOnlyDictionary<string, string>? PathIssues { get; set; }
    /// <summary>True when the window edits the Import folder (one folder, no name).</summary>
    [Parameter] public bool Import { get; set; }
    /// <summary>First-run setup: the setup calls are used.</summary>
    [Parameter] public FolderAddScope Scope { get; set; } = FolderAddScope.Settings;

    private const string ImportLocationId = "incoming";

    public static AppDialogOptions DialogOptions { get; } = new() { MaxWidth = AppMaxWidth.Large, FullWidth = true, CloseButton = false, NoHeader = true, CloseOnEscapeKey = true };

    // Friendly names edited in this window (source id to name) and the name and handling chosen for each folder about to be added (by path).
    private readonly Dictionary<string, string> _labels = new(StringComparer.Ordinal);
    private readonly Dictionary<string, (string? Label, bool Managed)> _addedInfo = new(StringComparer.OrdinalIgnoreCase);
    private string? _pickLabel;
    private bool _pickManaged;
    private readonly HashSet<string> _removed = new(StringComparer.Ordinal);
    private readonly List<ServerFolderValidationResultDto> _added = [];
    private bool _review;
    private bool _saving;
    private string? _error;
    private string? _scanNote;

    private bool IsVault => Library is not null && LibraryLookupRules.IsVaultLibrary(Library);
    private string Title => Import ? L["LibrariesOverview_EditImport"].Value : L["LibrariesOverview_EditNamed", (string.IsNullOrWhiteSpace(Library?.Name) ? L["LibraryEditDialog_LibraryLower"].Value : Library!.Name)].Value;
    private string Lead => Import
        ? L["LibraryEditDialog_LeadImport"].Value
        : L["LibraryEditDialog_Lead"].Value;

    private IReadOnlyList<LibrarySourceDto> Sources => Import
        ? Configuration.ImportFolderStatus is { Configured: true } status
            ? [new LibrarySourceDto { Id = ImportLocationId, Path = status.Path ?? string.Empty }]
            : []
        : Library?.Sources ?? [];

    private IReadOnlyList<LibrarySourceDto> KeptSources => [.. Sources.Where(source => !_removed.Contains(source.Id))];

    // The folder names show only once the library has two or more folders (Libraries v3 D18).
    private bool ShowFolderNames => !Import && KeptSources.Count + _added.Count >= 2;

    private static bool IsManaged(LibrarySourceDto source) => string.Equals(source.ManagementMode, "managed_by_tuvima", StringComparison.OrdinalIgnoreCase);

    private string HandlingText(LibrarySourceDto source) =>
        string.Equals(source.ConversionState, "converting", StringComparison.OrdinalIgnoreCase) ? L["LibraryEditDialog_Converting"].Value : FolderHandlingWords.LabelFor(IsManaged(source));

    private string LabelOf(LibrarySourceDto source) => _labels.TryGetValue(source.Id, out var label) ? label : source.Label ?? source.DisplayName();

    private (string? Label, bool Managed) AddedInfoOf(ServerFolderValidationResultDto added) => _addedInfo.TryGetValue(added.Path, out var info) ? info : (null, false);

    private string? IssueFor(string path) => PathIssues is not null && PathIssues.TryGetValue(path, out var issue) ? issue : null;

    // A friendly name is at most 60 characters and unique within the library (Libraries v3 D18).
    private string? LabelProblem(LibrarySourceDto source)
    {
        if (!_labels.TryGetValue(source.Id, out var label)) return null;
        var name = label.Trim();
        if (name.Length > FolderHandlingWords.MaxFolderNameLength) return L["LibraryEditDialog_NameTooLong", FolderHandlingWords.MaxFolderNameLength].Value;
        var taken = KeptSources.Any(other => other.Id != source.Id && string.Equals(LabelOf(other).Trim(), name, StringComparison.OrdinalIgnoreCase))
            || _added.Any(added => string.Equals(AddedInfoOf(added).Label?.Trim(), name, StringComparison.OrdinalIgnoreCase));
        return name.Length > 0 && taken ? L["LibraryEditDialog_NameTaken", name].Value : null;
    }

    private bool LabelsChanged => !Import && KeptSources.Any(source => _labels.TryGetValue(source.Id, out var label)
        && !string.Equals(label.Trim(), (source.Label ?? source.DisplayName()).Trim(), StringComparison.Ordinal));

    private bool HasLabelProblem => KeptSources.Any(source => LabelProblem(source) is not null);

    private bool HasChanges => LabelsChanged || _removed.Count > 0 || _added.Count > 0;

    private bool CanReview => HasChanges && !HasLabelProblem && !_saving;

    private bool JobRunning(LibrarySourceDto source) =>
        string.Equals(source.ConversionState, "converting", StringComparison.OrdinalIgnoreCase)
        || string.Equals(source.MergeState, "merging", StringComparison.OrdinalIgnoreCase);

    private bool CanOfferVault => !Import && !Scope.Embedded && Library is not null && !IsVault
        && LibraryVaultAccess.CanShow(Nsfw, Session, isKids: false)
        && Kinds.Find(Library.KindKey) is { } kind && !LibraryTypeCatalog.IsViewKind(kind);

    private IReadOnlyList<AppRowMenuItem> FolderMenu(LibrarySourceDto source)
    {
        var running = JobRunning(source);
        var items = new List<AppRowMenuItem>
        {
            new() { Label = L["LibraryEditDialog_OpenInPicker"].Value, Icon = AppMaterialIcons.Outlined.FolderOpen, Disabled = _saving, OnClick = EventCallback.Factory.Create(this, () => OpenInPickerAsync(source)) },
        };
        if (CanSwitchToManaged(source))
        {
            items.Add(new() { Label = L["LibraryEditDialog_SwitchToManaged"].Value, Icon = AppMaterialIcons.Outlined.Tune, Disabled = _saving || running, OnClick = EventCallback.Factory.Create(this, () => SwitchToManagedAsync(source)) });
        }

        if (CanOfferVault)
        {
            items.Add(new() { Label = L["LibraryEditDialog_MoveToVault"].Value, Icon = AppMaterialIcons.Outlined.Lock, Disabled = _saving || running, OnClick = EventCallback.Factory.Create(this, () => MoveToVaultAsync(source)) });
        }

        // A folder Library is moving or organising cannot be removed until the job ends.
        items.Add(new()
        {
            Label = running ? L["LibraryEditDialog_RemoveWait"].Value : L["LibraryEditDialog_Remove"].Value,
            Icon = AppMaterialIcons.Outlined.Delete,
            Destructive = true,
            Disabled = _saving || running,
            OnClick = EventCallback.Factory.Create(this, () => { _removed.Add(source.Id); _error = null; }),
        });
        return items;
    }

    private IReadOnlyList<string> ReviewLines
    {
        get
        {
            var lines = new List<string>();
            foreach (var source in KeptSources.Where(source => _labels.TryGetValue(source.Id, out var label) && !string.Equals(label.Trim(), (source.Label ?? source.DisplayName()).Trim(), StringComparison.Ordinal)))
            {
                lines.Add(L["LibraryEditDialog_ReviewRenameFolder", source.Path, _labels[source.Id].Trim()].Value);
            }

            foreach (var added in _added) lines.Add(Import ? L["LibraryEditDialog_ReviewUseImport", added.Path].Value : L["LibraryEditDialog_ReviewAddFolder", added.Path].Value);
            foreach (var source in Sources.Where(source => _removed.Contains(source.Id)))
            {
                lines.Add(Import
                    ? L["LibraryEditDialog_ReviewStopImport", source.Path].Value
                    : L["LibraryEditDialog_ReviewRemoveFolder", source.Path].Value);
            }

            lines.Add(L["LibraryEditDialog_ReviewNeverChanged"].Value);
            return lines;
        }
    }

    private void OpenReview()
    {
        if (!CanReview) return;
        _error = null;
        _review = true;
    }

    private async Task<ServerFolderValidationResultDto?> PickAsync(string? start)
    {
        var kind = Import ? null : Kinds.Find(Library?.KindKey);
        var parameters = new AppDialogParameters<ServerFolderPicker>
        {
            { component => component.SelectionMode, Import ? ServerFolderSelectionModes.ManagedLibrary : ServerFolderSelectionModes.ExistingLibrary },
            { component => component.MediaType, kind?.MediaTypes.FirstOrDefault() },
            { component => component.SetupSession, Scope.SetupSession },
            { component => component.InitialPath, start },
        };
        if (Import)
        {
            parameters.Add(component => component.Title, L["LibraryEditDialog_ChooseImport"].Value);
            parameters.Add(component => component.HelpText, L["LibraryEditDialog_HelpImport"].Value);
            parameters.Add(component => component.ConfirmLabel, L["LibraryEditDialog_ChooseFolder"].Value);
        }
        else
        {
            // The very window Add library's third step draws (Libraries v3 D21, L4): same heading, lead, chips fixed to this library's area and kind, friendly name
            // first and the same buttons, all read from LibraryFolderStep so the two cannot drift apart.
            parameters.Add(component => component.Title, LibraryFolderStep.Heading(L, kind));
            parameters.Add(component => component.HelpText, LibraryFolderStep.Lead(L, kind));
            parameters.Add(component => component.ConfirmLabel, L["Common_AddFolder"].Value);
            parameters.Add(component => component.ShowFolderName, LibraryFolderStep.ShowFolderName);
            parameters.Add(component => component.TopContent, LibraryFolderStep.Chips(
                IsVault ? LibraryGroupCatalog.VaultKey : kind?.Area.ToLowerInvariant() ?? string.Empty,
                IsVault ? L["Nav_Vault"].Value : Kinds.TryGetGroup(kind?.Area ?? string.Empty)?.Label,
                kind));
            parameters.Add(component => component.OfferHandling, !IsVault);
            parameters.Add(component => component.ManagedAllowed, kind is not null && LibraryKindLook.ManagedOffered(kind));
            parameters.Add(component => component.FolderNameChanged, EventCallback.Factory.Create<string>(this, value => _pickLabel = value));
            parameters.Add(component => component.OnHandlingChanged, EventCallback.Factory.Create<string>(this, value => _pickManaged = value == FolderHandlingWords.ManagedKey));
        }

        _pickLabel = null;
        _pickManaged = false;
        var dialog = await DialogService.ShowAsync<ServerFolderPicker>(string.Empty, parameters, ServerFolderPicker.DialogOptions);
        return await dialog.Result is { Canceled: false, Data: ServerFolderValidationResultDto selected } ? selected : null;
    }

    private async Task AddFolderAsync()
    {
        if (await PickAsync(null) is not { } selected) return;
        if (_added.Any(item => string.Equals(item.Path, selected.Path, StringComparison.OrdinalIgnoreCase))
            || Sources.Any(source => string.Equals(source.Path, selected.Path, StringComparison.OrdinalIgnoreCase) && !_removed.Contains(source.Id)))
        {
            _error = L["LibraryEditDialog_AlreadyListed"].Value;
            return;
        }

        _error = null;
        _added.Add(selected);
        _addedInfo[selected.Path] = (string.IsNullOrWhiteSpace(_pickLabel) ? null : _pickLabel.Trim(), _pickManaged);
    }

    // Open in picker: the picker starts on the folder; choosing another one swaps it in (the old one is removed, the new one added) when Save changes is pressed.
    private async Task OpenInPickerAsync(LibrarySourceDto source)
    {
        if (await PickAsync(source.Path) is not { } selected || string.Equals(selected.Path, source.Path, StringComparison.OrdinalIgnoreCase)) return;
        _removed.Add(source.Id);
        _added.Add(selected);
        _addedInfo[selected.Path] = (string.IsNullOrWhiteSpace(_pickLabel) ? source.Label : _pickLabel.Trim(), _pickManaged);
        _error = null;
    }

    private async Task ScanNowAsync()
    {
        if (Library is null) return;
        var started = await Api.ScanLibraryAsync(Library.Id);
        _scanNote = started is not null ? L["LibraryEditDialog_Scanning", Library.Name].Value : Api.LastError ?? L["LibraryEditDialog_ScanFailed"].Value;
    }

    private async Task MoveToVaultAsync(LibrarySourceDto source)
    {
        var kind = Kinds.Find(Library?.KindKey);
        if (kind is null) return;
        var parameters = new AppDialogParameters<MoveToVaultDialog>
        {
            { component => component.KindKey, kind.Key },
            { component => component.PluralLabel, kind.PluralLabel },
            { component => component.FolderName, source.DisplayName() },
            { component => component.SourceId, source.Id },
        };
        var dialog = await DialogService.ShowAsync<MoveToVaultDialog>(string.Empty, parameters, MoveToVaultDialog.DialogOptions);
        await dialog.Result;
        Dialog.Close(AppDialogResult.Ok(true));
    }

    // A Read-only folder of a kind whose rules allow it can be switched to Managed from here (Libraries v3 D27). Setup has no files to tidy yet, Vault folders are
    // handled by the Vault, and a folder that is already Managed or busy with a job is left alone.
    private bool CanSwitchToManaged(LibrarySourceDto source) => !Import && !Scope.Embedded && !IsVault && !IsManaged(source) && !JobRunning(source)
        && Kinds.Find(Library?.KindKey) is { } kind && LibraryKindLook.ManagedOffered(kind);

    // Preview, then Review in plain words, then the Engine tidies the folder in place as a job that can be paused and cancelled; "Converting" shows until it ends.
    private async Task SwitchToManagedAsync(LibrarySourceDto source)
    {
        var outcome = await AddService.SwitchToManagedAsync(source);
        if (outcome.Error is not null)
        {
            _error = outcome.Error;
            return;
        }

        if (outcome.Started) Dialog.Close(AppDialogResult.Ok(true));
    }

    // Remove library asks once; the folders' files stay on disk.
    private async Task RemoveLibraryAsync()
    {
        if (Library is null || _saving) return;
        if (Scope.Embedded)
        {
            // First-run setup: its own session removes the library and asks once itself.
            var outcome = await AddService.RemoveSetupLibraryAsync(Scope, Configuration, Library);
            if (outcome.Changed) Dialog.Close(AppDialogResult.Ok(true));
            else _error = outcome.Error;
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["LibraryEditDialog_RemoveTitle", Library.Name].Value,
            L["LibraryEditDialog_RemoveBody"].Value,
            yesText: L["LibraryEditDialog_Remove"].Value, cancelText: L["LibraryEditDialog_Keep"].Value, options: AppDialogOptions.DestructiveConfirm);
        if (confirmed != true) return;

        _saving = true;
        try
        {
            var saved = await Api.UpdateLibrariesAsync(new UpdateLibrariesRequest
            {
                SchemaVersion = Configuration.SchemaVersion,
                StorageLocations = Configuration.StorageLocations,
                ViewStorage = Configuration.ViewStorage,
                Libraries = [.. Configuration.Libraries.Where(item => item.Id != Library.Id)],
                PersonalLibraryPolicy = Configuration.PersonalLibraryPolicy,
                FileHandling = Configuration.FileHandling,
            });
            if (saved is null)
            {
                _error = Api.LastError ?? L["LibraryEditDialog_RemoveFailed"].Value;
                return;
            }
        }
        finally
        {
            _saving = false;
        }

        Dialog.Close(AppDialogResult.Ok(true));
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        // Taking away the last folder takes the library off the list (Setup and Libraries fixes D11), so it asks once; Keep goes back to the Review page with nothing changed.
        if (!Import && Sources.Count > 0 && KeptSources.Count == 0 && _added.Count == 0 && !await ConfirmLastFolderAsync()) return;
        _saving = true;
        _error = null;
        try
        {
            if (Import)
            {
                await SaveImportAsync();
            }
            else
            {
                await SaveLibraryAsync();
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task<bool> ConfirmLastFolderAsync() =>
        await AppConfirmDialog.ShowAsync(DialogService, L["LibraryEditDialog_LastFolderTitle"].Value,
            L["LibraryEditDialog_LastFolderBody", string.IsNullOrWhiteSpace(Library?.Name) ? L["LibraryEditDialog_LibraryLower"].Value : Library!.Name].Value,
            L["LibraryEditDialog_LastFolderRemove"].Value, L["LibraryEditDialog_Keep"].Value, primaryDestructive: true) == AppConfirmResult.Primary;

    private async Task SaveImportAsync()
    {
        var path = _added.LastOrDefault()?.Path;
        var locations = Configuration.StorageLocations
            .Where(location => !string.Equals(location.Id, ImportLocationId, StringComparison.OrdinalIgnoreCase))
            .ToList();
        if (path is not null)
        {
            locations.Add(new ServerStorageLocationDto { Id = ImportLocationId, Label = L["LibraryEditDialog_ImportLabel"].Value, Path = path, AllowWrite = true });
        }

        var saved = await Api.UpdateLibrariesAsync(new UpdateLibrariesRequest
        {
            SchemaVersion = Configuration.SchemaVersion,
            StorageLocations = locations,
            ViewStorage = Configuration.ViewStorage,
            Libraries = Configuration.Libraries,
            PersonalLibraryPolicy = Configuration.PersonalLibraryPolicy,
            FileHandling = Configuration.FileHandling,
        });
        if (saved is null)
        {
            _review = false;
            _error = Api.LastError ?? L["LibraryEditDialog_ImportSaveFailed"].Value;
            return;
        }

        Dialog.Close(AppDialogResult.Ok(true));
    }

    private async Task SaveLibraryAsync()
    {
        if (Library is null) return;
        var current = Configuration;
        if (LabelsChanged || _removed.Count > 0)
        {
            var copy = JsonSerializer.Deserialize<LibraryFolderDto>(JsonSerializer.Serialize(Library));
            if (copy is null) return;
            copy.Sources.RemoveAll(source => _removed.Contains(source.Id));
            foreach (var source in copy.Sources)
            {
                if (_labels.TryGetValue(source.Id, out var label)) source.Label = string.IsNullOrWhiteSpace(label) ? null : label.Trim();
            }

            var saved = await AddService.SaveLibraryAsync(Scope, current, copy);
            if (saved is null)
            {
                _review = false;
                _error = Api.LastError ?? L["LibraryEditDialog_SaveFailed"].Value;
                return;
            }

            current = saved;
        }

        foreach (var folder in _added)
        {
            var info = AddedInfoOf(folder);
            var plan = new AddFolderPlan(
                Library.KindKey,
                folder,
                info.Managed && !IsVault ? AddFolderHandling.Managed : AddFolderHandling.ReadOnly,
                MarkNewMediaHere: false,
                LibraryId: Library.Id,
                Label: info.Label);
            var result = await AddService.AddAsync(plan, Kinds, current, Scope);
            if (!result.Saved)
            {
                _review = false;
                _error = result.Error ?? L["LibraryEditDialog_AddFailed"].Value;
                return;
            }

            current = result.Configuration ?? current;
            if (!Scope.Embedded) await Api.TriggerRescanAsync(folder.Path);
        }

        Dialog.Close(AppDialogResult.Ok(true));
    }
}
