@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.LocalAssets
@using MediaEngine.Domain.PersonalMedia
@inject IEngineApiClient ApiClient
@inject IAppToastService Snackbar
@inject IStringLocalizer<SharedStrings> L

@* The File handling tab of a View kind (Library pages WP11): how files are stored depending on how they are added, what Library does and
   does not do to originals, and, for Documents, the text, organisation and rules panels. *@
<div class="view-file-handling">
    <SettingsSectionPanel Title="@L["Common_Organization"].Value" Description="@L["ViewFileHandlingTab_HowFilesAreStoredDepends"].Value">
        <div class="view-organization">
            <article><span class="view-icon"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CalendarMonth" /></span><div><strong>@L["ViewFileHandlingTab_AddedThroughLibrary"]</strong><small>@L["ViewFileHandlingTab_PhotosAndVideosCopiedInto"]</small><code>@(_layout?.Example ?? "Year / Year-Month-Day / original name")</code></div></article>
            <article><span class="view-icon"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FolderCopy" /></span><div><strong>@L["ViewFileHandlingTab_ManagedFolders"]</strong><small>@L["ViewFileHandlingTab_KeepTheirFolderHierarchyAnd"]</small><code>@L["ViewFileHandlingTab_FoldersFolderNameFiles"]</code></div></article>
            <article><span class="view-icon"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Link" /></span><div><strong>@L["ViewFileHandlingTab_LinkedFolders"]</strong><small>@L["ViewFileHandlingTab_FilesStayInTheirExisting"]</small><code>@L["ViewFileHandlingTab_ExistingFolderFiles"]</code></div></article>
        </div>
    </SettingsSectionPanel>
    @if (Kind is ViewContentKinds.Photos or ViewContentKinds.PersonalVideos)
    {
        <SettingsSectionPanel Title="@L["ViewFileHandlingTab_FilingLayout"].Value" Description="@L["ViewFileHandlingTab_TheFoldersNewPhotosAnd"].Value">
            <div class="libraries-form-grid">
                <AppTextField Label="@L["Common_Layout"].Value" Value="@_pattern" ValueChanged="@((string? value) => _pattern = value ?? string.Empty)" ReadOnly="@(ReadOnly || _busy)" />
                <div>
                    <small>Use {year}, {month} and {day}. For example <code>{year}/{year}-{month}-{day}</code> or <code>{year}/{month}</code>.</small>
                    <small>@L["ViewFileHandlingTab_Example"] <code>@(_layout?.Example ?? "Year / Year-Month-Day / original name")</code></small>
                </div>
            </div>
            <p>@L["ViewFileHandlingTab_ChangingTheLayoutAffectsOnly"]</p>
            @if (_error is not null) { <AppAlert Tone="AppUiTone.Error">@_error</AppAlert> }
            <AppActionBar>
                <AppButton Label="@L["ViewFileHandlingTab_UseTheDefault"].Value" ButtonStyle="AppButtonStyle.Text" Disabled="@(ReadOnly || _busy)" OnClick="UseDefaultAsync" />
                <AppButton Label="@L["ViewFileHandlingTab_SaveLayout"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_busy" Disabled="@(ReadOnly || _busy || string.IsNullOrWhiteSpace(_pattern))" OnClick="SaveAsync" />
            </AppActionBar>
        </SettingsSectionPanel>
        <ViewDuplicatesPanel ReadOnly="@ReadOnly" />
    }
    <SettingsSectionPanel Title="@L["Common_FileHandling"].Value" Description="@L["ViewFileHandlingTab_OriginalsRemainProtectedThroughoutIndexi"].Value">
        <div class="view-policy-row"><div><strong>@L["ViewFileHandlingTab_LinkedOriginals"]</strong><small>@L["ViewFileHandlingTab_LibraryReadsTheirLocalFile"]</small></div><span>@L["ViewFileHandlingTab_ReadOnlyFilesStayIn"]</span></div>
        <div class="view-policy-row"><div><strong>@L["ViewFileHandlingTab_DetachAFolder"]</strong><small>@L["ViewFileHandlingTab_RemoveItsConnectionToView"]</small></div><span>@L["ViewFileHandlingTab_KeepAllOriginalFiles"]</span></div>
        <div class="view-policy-row"><div><strong>@L["ViewFileHandlingTab_ContributeToSharedLibrary"]</strong><small>@L["ViewFileHandlingTab_FilesTransferOnlyAfterAcceptance"]</small></div><span>@L["ViewFileHandlingTab_ManagedOriginalsMoveLinkedOriginals"]</span></div>
        <p>@L["ViewFileHandlingTab_ViewUsesLocalFileDetails"]</p>
    </SettingsSectionPanel>
    <SettingsSectionPanel Title="@L["ViewFileHandlingTab_MissingFiles"].Value" Description="@L["ViewFileHandlingTab_WhatLibraryDoesWhenA"].Value">
        <p>@L["ViewFileHandlingTab_LibraryNeverDeletesAnythingBecause"]</p>
        <div class="view-missing-row">
            <AppSwitchRow Label="@L["ViewFileHandlingTab_RemoveTheRecordAfterA"].Value" Description="@L["ViewFileHandlingTab_ForgetsTheNotesTagsAnd"].Value"
                          Value="@_removeAfterWhile" ValueChanged="SetRemoveAfterWhileAsync" Disabled="@(ReadOnly || _missingBusy || _missing is null)" />
            @if (_removeAfterWhile)
            {
                <AppNumericField Label="@L["ViewFileHandlingTab_DaysToWait"].Value" Min="1" Max="3650" Value="@_days" ValueChanged="SetDaysAsync" ReadOnly="@(ReadOnly || _missingBusy)" HelpText="Counted from when the file was first seen missing." />
            }
        </div>
        @if (_missingError is not null) { <AppAlert Tone="AppUiTone.Error">@_missingError</AppAlert> }
        else if (_missingSaved) { <small class="view-missing-saved">@L["Common_Saved"]</small> }
    </SettingsSectionPanel>
    @if (Kind == ViewContentKinds.Documents)
    {
        <DocumentTextSettings ReadOnly="@ReadOnly" />
        <DocumentOrganisationSettings ReadOnly="@ReadOnly" />
        <DocumentRulesSettings ReadOnly="@ReadOnly" />
    }
</div>

@code {
    /// <summary>The View kind: photos, personal_videos or documents.</summary>
    [Parameter] public string Kind { get; set; } = string.Empty;
    [Parameter] public bool ReadOnly { get; set; }

    private ViewFilingLayoutDto? _layout;
    private string _pattern = string.Empty;
    private string? _error;
    private bool _busy;
    private ViewMissingFileSettingsDto? _missing;
    private bool _removeAfterWhile;
    private int _days = 90;
    private bool _missingBusy;
    private bool _missingSaved;
    private string? _missingError;

    protected override async Task OnInitializedAsync()
    {
        _missing = await ApiClient.GetViewMissingFileSettingsAsync();
        ShowMissing(_missing);
        if (Kind is ViewContentKinds.Photos or ViewContentKinds.PersonalVideos)
        {
            _layout = await ApiClient.GetViewFilingLayoutAsync();
            _pattern = _layout?.Pattern ?? string.Empty;
        }
    }

    private void ShowMissing(ViewMissingFileSettingsDto? settings)
    {
        if (settings is null) return;
        _missing = settings;
        _removeAfterWhile = settings.RetentionDays > 0;
        _days = settings.RetentionDays > 0 ? settings.RetentionDays : settings.DefaultRetentionDays;
    }

    private Task SetRemoveAfterWhileAsync(bool on) => SaveMissingAsync(on ? Math.Max(1, _days) : 0);

    private Task SetDaysAsync(int days) => SaveMissingAsync(Math.Max(1, days));

    private async Task SaveMissingAsync(int days)
    {
        if (_missingBusy) return;
        _missingBusy = true;
        _missingSaved = false;
        try
        {
            var saved = await ApiClient.UpdateViewMissingFileSettingsAsync(days);
            if (saved is null) _missingError = ApiClient.LastError ?? "The setting could not be saved.";
            else { _missingError = null; _missingSaved = true; ShowMissing(saved); }
        }
        finally { _missingBusy = false; }
    }

    private Task SaveAsync() => ApplyAsync(_pattern);

    private Task UseDefaultAsync() => ApplyAsync(null);

    private async Task ApplyAsync(string? pattern)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var saved = await ApiClient.UpdateViewFilingLayoutAsync(pattern);
            if (saved is null) _error = ApiClient.LastError ?? "The layout could not be saved.";
            else { _error = null; _layout = saved; _pattern = saved.Pattern; Snackbar.Add("Filing layout saved. It applies to files filed from now on.", AppSeverity.Success); }
        }
        finally { _busy = false; }
    }
}
