@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Components.Shared
@inject IEngineApiClient Api
@inject IStringLocalizer<SharedStrings> L

@* The Lookup tab of a Vault-protected library of an ordinary content type (Library pages D15; Vault sections D34): one switch, "Look up details
   online", off by default, with the plain privacy note. Off, nothing about the library leaves the machine; on, titles from it are sent to online services and
   the Engine fetches covers, descriptions and cast like any other library. The switch is the library's own, so Movies and Music in the Vault are set apart. Drawn only for a Vault library, which only someone
   who may see the Vault ever reaches. A phone shows the state and changes nothing. *@
<section class="vault-lookup" aria-label="@L["Common_Lookup"].Value">
    @if (_failure is not null)
    {
        <AppAlert Tone="AppUiTone.Error" ShowCloseIcon="true" CloseIconClicked="@(() => { _failure = null; })" data-vault-lookup-failure>@_failure</AppAlert>
    }
    <h3 class="vault-lookup__heading">@L["LibraryVaultLookupTab_LookUpDetailsOnline"] <AppInfoTip Text="@L["LibraryVaultLookupTab_LibraryCanFetchCoversDescriptions"].Value" Label="@L["LibraryVaultLookupTab_AboutOnlineLookup"].Value" /></h3>
    <AppSwitchRow Label="@L["LibraryVaultLookupTab_LookUpDetailsOnline"].Value"
                  Description="@(_on ? LibraryLookupRules.VaultPrivacyNote : LibraryLookupRules.VaultOffNote)"
                  Value="@_on"
                  Disabled="@(ReadOnly || _saving)"
                  ValueChanged="SetAsync" />
    <AppQuietNote data-testid="vault-lookup-privacy">@LibraryLookupRules.VaultPrivacyNote</AppQuietNote>
    @if (ReadOnly)
    {
        <p class="vault-lookup__note">@L["LibraryVaultLookupTab_UseADesktopOrTablet"]</p>
    }
</section>

@code {
    /// <summary>The Vault library being shown.</summary>
    [Parameter, EditorRequired] public LibraryFolderDto Library { get; set; } = default!;

    /// <summary>Phones: the state is shown and nothing can be changed.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Raised after the switch was saved, so the page reads the libraries again.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private bool _on;
    private bool _saving;
    private string? _failure;
    private string? _syncedFor;

    protected override void OnParametersSet()
    {
        // Follows the library as the Engine last returned it, but never while a save is in flight.
        var key = $"{Library.Id}|{Library.MetadataPolicy}";
        if (_saving || key == _syncedFor) return;
        _syncedFor = key;
        _on = LibraryLookupRules.VaultLookupIsOn(Library);
    }

    private async Task SetAsync(bool value)
    {
        if (ReadOnly || _saving || value == _on) return;
        _saving = true;
        _failure = null;
        var before = _on;
        _on = value;
        try
        {
            var saved = await Api.SetVaultOnlineLookupAsync(Library.Id, value);
            if (saved is null)
            {
                _on = before;
                _failure = Api.LastError ?? L["LibraryVaultLookupTab_TheSettingCouldNotBe"].Value;
                return;
            }

            _syncedFor = $"{saved.Id}|{saved.MetadataPolicy}";
            // The switch already shows the new state; that is the confirmation.
            await Changed.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }
}
