@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.LocalAssets
@using MediaEngine.Contracts.Settings
@using MediaEngine.Contracts.Vault
@using MediaEngine.Domain.PersonalMedia
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Ui
@using MediaEngine.Web.Services.Vault
@implements IDisposable
@inject LibraryFolderAddService AddService
@inject NavigationManager Navigation
@inject NsfwModeState Nsfw
@inject VaultLibraryOnboarding VaultOnboarding
@inject IEngineApiClient Api

@* Adding a folder, in up to three steps: what is it, which folder, how should Library treat it. Nothing is created until
   "Add folder" on the last step. A level that already knows the type (its own page) starts at the folder step. The Vault tile
   (only while the Vault may be shown) has no kinds, so it goes straight to the folder step, and its last step is "Vault". *@
<AppDialogShell Title="Add folder" Size="Large" OnClose="@(() => Dialog.Cancel())">
    <ChildContent>
        <div class="add-wizard">
            @if (_step != WizardStep.Done)
            {
                <div class="add-wizard__steps" role="list" aria-label="Steps">
                    @foreach (var (label, index) in Steps.Select((entry, index) => (entry.Label, index)))
                    {
                        if (index > 0)
                        {
                            <span class="add-wizard__sep" aria-hidden="true"> &middot; </span>
                        }
                        <span role="listitem" class="@(index == CurrentStepIndex ? "add-wizard__step is-current" : "add-wizard__step")" aria-current="@(index == CurrentStepIndex ? "step" : null)">@(index + 1) @label</span>
                    }
                </div>
            }

            @if (_step == WizardStep.Kind)
            {
                <div class="add-wizard__tiles" role="group" aria-label="What is it?">
                    @foreach (var group in OfferedGroups)
                    {
                        <AppNativeButton Type="button"
                                         Class="@($"add-wizard__tile add-wizard__tile--{group.Key}{(group.Key == _groupKey ? " is-selected" : string.Empty)}")"
                                         data-group="@group.Key"
                                         aria-pressed="@(group.Key == _groupKey ? "true" : "false")"
                                         OnClick="@(_ => ChooseGroup(group))">
                            <span class="add-wizard__tile-icon"><AppMaterialIcon Icon="@group.Icon" /></span>
                            <strong>@group.Label</strong>
                        </AppNativeButton>
                    }
                </div>

                @if (CurrentGroup is { } shown && !IsVault)
                {
                    <div class="add-wizard__kinds" role="group" aria-label="@($"{shown.Label} kinds")">
                        @foreach (var kind in KindsOf(shown))
                        {
                            <div class="add-wizard__kind">
                                <AppNativeButton Type="button"
                                                 Class="@($"add-wizard__kind-option{(kind.Key == _type?.Key ? " is-selected" : string.Empty)}")"
                                                 data-type="@kind.Key"
                                                 OnClick="@(_ => ChooseKind(kind))">
                                    <span class="@LibraryKindLook.TileClass(kind)" data-lookup="@(LibraryKindLook.LooksUp(kind) ? "true" : "false")"><AppMaterialIcon Icon="@kind.Icon" /></span>
                                    <strong>@kind.Label</strong>
                                </AppNativeButton>
                                <AppTooltip Text="@TipFor(kind)" Placement="AppPlacement.Top">
                                    <span class="add-wizard__info" role="img" tabindex="0" aria-label="@($"About {kind.Label}: {TipFor(kind)}")" data-info-for="@kind.Key"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Info" /></span>
                                </AppTooltip>
                            </div>
                        }
                    </div>
                }
            }
            else if (_step == WizardStep.Library && _type is not null)
            {
                @* A kind that holds several named libraries asks which one the folder joins: an existing library by name, or a new custom one. *@
                <h3 class="add-wizard__question" id="add-wizard-library">Which library?</h3>
                <div class="add-wizard__options" role="radiogroup" aria-labelledby="add-wizard-library">
                    @foreach (var library in ExistingLibraries)
                    {
                        @LibraryOption(library.Id, string.IsNullOrWhiteSpace(library.Name) ? _type.Label : library.Name)
                    }
                    @if (CanAddLibrary)
                    {
                        @LibraryOption(NewLibraryChoice, "New custom library")
                    }
                </div>
                @if (!CanAddLibrary)
                {
                    <p class="add-wizard__lead" data-library-limit>@LibraryLimitText</p>
                }
                @if (_libraryChoice == NewLibraryChoice)
                {
                    <div class="add-wizard__options add-wizard__field">
                        <AppTextField Label="Library name" Value="@_newLibraryName" ValueChanged="@((string? value) => _newLibraryName = value ?? string.Empty)" />
                    </div>
                }
            }
            else if (_step == WizardStep.Folder && _type is not null)
            {
                <p class="add-wizard__lead">Choose the folder on the Library server that holds your @_type.PluralLabel.</p>
                <ServerFolderPicker Inline="true"
                                    ConfirmLabel="Next"
                                    SelectionMode="@(IsViewFlow ? ServerFolderSelectionModes.PersonalSpaceExisting : ServerFolderSelectionModes.ExistingLibrary)"
                                    MediaType="@_type.MediaTypes.FirstOrDefault()"
                                    SetupSession="@SetupSession"
                                    InitialPath="@_initialPath"
                                    OnConfirmed="OnFolderConfirmed" />
                @if (_footagePending && LooksLikeFootage)
                {
                    <div class="add-wizard__hint" role="note">
                        @* First-run setup never leaves setup for View's settings, so it only says where View is set up. *@
                        <span>@(Embedded ? "This looks like phone or camera footage. Personal videos belong in View; you can set View up later in Settings > Libraries > View." : "This looks like phone or camera footage. Personal videos belong in View.")</span>
                        <div class="add-wizard__hint-actions">
                            @if (!Embedded)
                            {
                                <AppButton Label="Add to View instead" ButtonStyle="AppButtonStyle.Outlined" OnClick="@(() => HandOffToView(ViewContentKinds.PersonalVideos, _folder?.Path))" />
                            }
                            <AppButton Label="Continue anyway" ButtonStyle="AppButtonStyle.Text" OnClick="@(() => GoTo(WizardStep.How))" />
                        </div>
                    </div>
                }
            }
            else if (_step == WizardStep.How && IsViewFlow && _type is not null && _folder is not null)
            {
                @* View in first-run setup: who the folder is for, then the same few fields View's own add form asks. *@
                <p class="add-wizard__lead"><code class="add-wizard__path" title="@_folder.Path">@_folder.Path</code></p>
                <h3 class="add-wizard__question" id="add-wizard-who">Who is it for?</h3>
                <div class="add-wizard__options" role="radiogroup" aria-labelledby="add-wizard-who">
                    @AudienceOption(true, "Everyone in the household", "The household's shared View library: everyone with access to it can see these files.")
                    @AudienceOption(false, "Only me", "Your own space in View. Nobody else sees these files unless you share them.")
                </div>
                <div class="add-wizard__options add-wizard__field">
                    <AppTextField Label="Folder name" Value="@_viewName" ValueChanged="@((string? value) => _viewName = value ?? string.Empty)" ReadOnly="@_saving" />
                    <AppSwitchRow Label="Include subfolders" Value="@_viewSubfolders" ValueChanged="@((bool value) => _viewSubfolders = value)" Disabled="@_saving" />
                    @if (_type.Key != ViewContentKinds.Documents)
                    {
                        <AppSwitchRow Label="Show in Photos timeline" Value="@_viewTimeline" ValueChanged="@((bool value) => _viewTimeline = value)" Disabled="@_saving" />
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <AppAlert Tone="AppUiTone.Error">@_error</AppAlert>
                }
            }
            else if (_step == WizardStep.How && _type is not null && _folder is not null)
            {
                <p class="add-wizard__lead"><code class="add-wizard__path" title="@_folder.Path">@_folder.Path</code></p>
                @if (_folder.ContainsFiles)
                {
                    <h3 class="add-wizard__question" id="add-wizard-how">How should Library treat it?</h3>
                    <div class="add-wizard__options" role="radiogroup" aria-labelledby="add-wizard-how">
                        @Option(AddFolderHandling.ReadOnly, AppMaterialIcons.Outlined.Visibility, "Read-only (recommended)", ReadOnlyTip, false)
                        @if (CanMerge)
                        {
                            @Option(AddFolderHandling.Merge, AppMaterialIcons.Outlined.Folder, $"Merge into your managed {_type.Label} folder", MergeTip, false)
                        }
                        @Option(AddFolderHandling.Managed, AppMaterialIcons.Outlined.Folder, "Let Library manage it", ManagedTip, true)
                    </div>
                }
                else
                {
                    <h3 class="add-wizard__question" id="add-wizard-how">Should new media go here?</h3>
                    <div class="add-wizard__options" role="radiogroup" aria-labelledby="add-wizard-how">
                        @YesNoOption(true, "Yes", "New " + _type.PluralLabel + " that Library adds are filed in this folder.")
                        @YesNoOption(false, "No", "This folder is managed, but new media keeps going where it goes now.")
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <AppAlert Tone="AppUiTone.Error">@_error</AppAlert>
                }
            }
            else if (_step == WizardStep.Vault && _folder is not null)
            {
                <p class="add-wizard__lead"><code class="add-wizard__path" title="@_folder.Path">@_folder.Path</code></p>
                @if (!Nsfw.HasPin)
                {
                    <AppAlert Tone="AppUiTone.Warning">@VaultMessages.SetProfilePinFirst</AppAlert>
                }
                else if (_vaultLoading)
                {
                    <AppSkeleton Height="96px" />
                }
                else if (_vaultReadFailed)
                {
                    @* Without a clear answer the wizard neither creates a library (there may already be one) nor adds to one. *@
                    <AppAlert Tone="AppUiTone.Error">@VaultMessages.Unreachable</AppAlert>
                    <div><AppButton Label="Try again" ButtonStyle="AppButtonStyle.Outlined" OnClick="RetryVaultReadAsync" /></div>
                }
                else if (_vaultLibrary is null)
                {
                    @* The first Vault folder creates the library: where details come from, then the adults-only confirmation (D34). The PIN is asked on the number pad when Add folder is pressed. *@
                    <label class="add-wizard__options add-wizard__field">
                        <span>Where details come from</span>
                        <AppNativeSelect Value="@_vaultLookup"
                                         OnChange="@(e => _vaultLookup = e.Value?.ToString() ?? "none")"
                                         Disabled="@_saving"
                                         aria-label="Where details for this library come from">
                            <option value="none">Nowhere: file names only</option>
                            <option value="stash_box">A Stash-box server</option>
                        </AppNativeSelect>
                        @if (_vaultLookup == "stash_box")
                        {
                            <small>Choosing a server and entering its key arrives with the Vault lookup update. Until then details stay file-name based.</small>
                        }
                    </label>
                    <AppCheckbox Value="@_adultsConfirmed" ValueChanged="@(value => _adultsConfirmed = value)" Disabled="@_saving" data-vault-adults>
                        @VaultLibraryOnboarding.AdultsConfirmationText
                    </AppCheckbox>
                }

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <AppAlert Tone="AppUiTone.Error">@_error</AppAlert>
                }
            }
            else if (_step == WizardStep.Done && _type is not null)
            {
                <div class="add-wizard__done" role="status">
                    <span class="add-wizard__done-icon"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CheckCircle" /></span>
                    <h3>Folder added to @_type.Label</h3>
                </div>
                @if (!string.IsNullOrWhiteSpace(_notice))
                {
                    <AppAlert Tone="AppUiTone.Warning">@_notice</AppAlert>
                }
            }
        </div>
    </ChildContent>
    <FooterContent>
        <AppActionBar Align="AppHorizontalAlignment.End">
            @if (_step == WizardStep.Done)
            {
                <AppButton Label="Close" ButtonStyle="AppButtonStyle.Text" OnClick="@(() => Dialog.Cancel())" />
                <AppButton Label="Add another" ButtonStyle="AppButtonStyle.Outlined" OnClick="AddAnother" />
                @if (!Embedded && GoToAddress is not null)
                {
                    <AppButton Label="@($"Go to {_type!.Label}")" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="GoToType" />
                }
            }
            else
            {
                <AppButton Label="Cancel" ButtonStyle="AppButtonStyle.Text" Disabled="@_saving" OnClick="@(() => Dialog.Cancel())" />
                @if (CanGoBack)
                {
                    <AppButton Label="Back" ButtonStyle="AppButtonStyle.Outlined" Disabled="@_saving" OnClick="Back" />
                }
                @if (_step == WizardStep.Library)
                {
                    <AppButton Label="Next" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(!CanLeaveLibraryStep)" OnClick="@(() => GoTo(WizardStep.Folder))" />
                }
                else if (_step == WizardStep.How)
                {
                    <AppButton Label="Add folder" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_saving" Disabled="@_saving" OnClick="@(() => IsViewFlow ? AddViewAsync() : AddAsync())" />
                }
                else if (_step == WizardStep.Vault)
                {
                    <AppButton Label="Add folder" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_saving" Disabled="@(_saving || !CanAddToVault)" OnClick="AddToVaultAsync" />
                }
            }
        </AppActionBar>
    </FooterContent>
</AppDialogShell>

@code {
    private enum WizardStep { Kind, Library, Folder, How, Vault, Done }

    // The library step's answer for a new custom library; an existing library's answer is its id.
    private const string NewLibraryChoice = "new";

    private const string ReadOnlyTip = "Library reads the files and never changes them. Best for folders other apps also use.";
    private const string MergeTip = "Library moves these files into your managed folder, renamed and tagged.";
    private const string ManagedTip = "Library renames, moves and tags the files here. Other apps that use this folder may stop finding them.";

    /// <summary>The centred dialog every host opens the wizard with (a centred dialog on tablets too).</summary>
    public static AppDialogOptions DialogOptions { get; } = new()
    {
        MaxWidth = AppMaxWidth.Medium,
        FullWidth = true,
        CloseButton = false,
        NoHeader = true,
        CloseOnEscapeKey = true,
    };

    [CascadingParameter] private IAppDialogContext Dialog { get; set; } = default!;
    /// <summary>Opens with this group's tile chosen (a group page); null on the front door.</summary>
    [Parameter] public string? StartGroupKey { get; set; }
    /// <summary>Opens at the folder step for this type (a type page); step 1 is skipped.</summary>
    [Parameter] public string? StartTypeKey { get; set; }
    /// <summary>The first-run setup session; the setup calls are used instead of the signed-in ones.</summary>
    [Parameter] public string? SetupSession { get; set; }
    /// <summary>True in the first-run setup, which has no files to merge and no signed-in session.</summary>
    [Parameter] public bool Embedded { get; set; }
    /// <summary>
    /// The signed-in administrator's profile id, set by first-run setup only once its own session is gone (see <see cref="SetupViewAccess"/>).
    /// It lets the embedded wizard offer View; null keeps View out of setup.
    /// </summary>
    [Parameter] public Guid? ViewOwnerProfileId { get; set; }
    /// <summary>Offers the Vault tile. The host sets it only while the Vault may be shown (see <see cref="LibraryVaultAccess"/>); setup never does.</summary>
    [Parameter] public bool ShowVault { get; set; }
    [Parameter, EditorRequired] public LibrariesConfigurationDto Configuration { get; set; } = default!;
    /// <summary>The Engine's list of library kinds; step 1 offers each group's available kinds from it.</summary>
    [Parameter, EditorRequired] public LibraryKindCatalog Kinds { get; set; } = default!;
    /// <summary>Called after each folder is added (and its Convert or Merge question answered), with a notice to keep on screen or null.</summary>
    [Parameter] public Func<string?, Task>? OnFolderAdded { get; set; }

    private WizardStep _step = WizardStep.Kind;
    private bool _typeKnown;
    private string? _groupKey;
    private LibraryTypeOption? _type;
    private ServerFolderValidationResultDto? _folder;
    private AddFolderHandling _handling = AddFolderHandling.ReadOnly;
    private bool _markNewMediaHere = true;
    private bool _footagePending;
    // A kind that holds several named libraries: the library the folder joins (an existing library's id, or NewLibraryChoice with its name).
    private string? _libraryChoice;
    private string _newLibraryName = string.Empty;
    // Where the embedded picker opens: the folder already chosen when coming Back from step 3.
    private string? _initialPath;
    private bool _saving;
    private string? _error;
    private string? _notice;
    private LibrariesConfigurationDto _configuration = default!;
    // The Vault step: the Vault's library if there already is one, else what a new one is created with.
    private VaultLibraryDto? _vaultLibrary;
    private bool _vaultLoading;
    // The Vault library could not be read, so it is unknown: not "none". Only a successful, empty answer means there is no library.
    private bool _vaultReadFailed;
    private string _vaultLookup = "none";
    private bool _adultsConfirmed;

    // The Vault is offered only while the host allows it and Vault mode is still on; setup never shows it.
    private bool VaultOffered => ShowVault && !Embedded && Nsfw.Unlocked;
    private bool IsVault => _groupKey == LibraryGroupCatalog.VaultKey && VaultOffered;
    private bool CanAddToVault => Nsfw.HasPin && !_vaultLoading && !_vaultReadFailed && (_vaultLibrary is not null || _adultsConfirmed);

    // The Vault has no kinds, so the wizard carries this stand-in where it carries a kind: its name, no media type, the lock icon.
    private static readonly LibraryTypeOption VaultType = new(
        LibraryGroupCatalog.VaultKey, "Vault", "Vault videos and images", LibraryGroupCatalog.VaultKey, [], AppMaterialIcons.Outlined.Lock);

    // View is offered in setup only for the signed-in administrator (never with a setup session); it is saved here, never handed off.
    private bool ViewInSetup => Embedded && string.IsNullOrWhiteSpace(SetupSession) && ViewOwnerProfileId is not null;
    private bool IsViewFlow => ViewInSetup && LibraryTypeCatalog.IsViewKind(_type);
    // Setup adds a View folder as a read-only linked folder; the defaults are the ones View's own add form starts with.
    private bool _forHousehold = true;
    private bool _viewSubfolders = true;
    private bool _viewTimeline;
    private string _viewName = string.Empty;

    private IEnumerable<LibraryGroup> OfferedGroups => Kinds.Visible(VaultOffered).Where(group => !Embedded || ViewInSetup || group.Key != "view");

    private FolderAddScope Scope => new(Embedded, SetupSession);
    private LibraryGroup? CurrentGroup => OfferedGroups.FirstOrDefault(group => group.Key == _groupKey);
    // The phone-footage hint is for Watch kinds, so it follows the area of the chosen kind rather than a particular kind.
    private bool InWatch => string.Equals(_type?.Area, "watch", StringComparison.OrdinalIgnoreCase);
    private bool LooksLikeFootage => InWatch && _folder is { LooksLikePhoneFootage: true };
    private bool CanGoBack => _step is WizardStep.How or WizardStep.Vault || (_step == WizardStep.Library && !_typeKnown) || (_step == WizardStep.Folder && (!_typeKnown || HasLibraryStep));
    // A kind that holds several libraries merges only into the library the person chose; a new custom library has no folder to merge into yet.
    private LibraryFolderDto? TypeLibrary => _type is null ? null : _type.AllowsMultiple ? ChosenLibrary : LibraryRollup.LibraryFor(_configuration, _type);

    // Several named libraries (D51): the plain kinds ask which library, up to the kind's limit; the other kinds hold one library.
    private bool HasLibraryStep => _type is { AllowsMultiple: true } && !LibraryTypeCatalog.IsViewKind(_type);
    private IReadOnlyList<LibraryFolderDto> ExistingLibraries => _type is null ? [] : LibraryRollup.LibrariesOf(_configuration, _type);
    private bool CanAddLibrary => _type is not null && ExistingLibraries.Count < _type.MaxLibraries;
    private string LibraryLimitText => _type is null ? string.Empty : $"{_type.MaxLibraries} is the most {_type.PluralLabel} libraries you can keep.";
    private LibraryFolderDto? ChosenLibrary => _type is { AllowsMultiple: true } && _libraryChoice is { } id && id != NewLibraryChoice
        ? ExistingLibraries.FirstOrDefault(library => library.Id == id)
        : null;
    private bool CanLeaveLibraryStep => _libraryChoice == NewLibraryChoice ? !string.IsNullOrWhiteSpace(_newLibraryName) : ChosenLibrary is not null;
    private bool CanMerge => !Embedded && _folder?.ContainsFiles == true && TypeLibrary?.Sources.Any(source => source.ManagementMode == "managed_by_tuvima") == true;

    // "1 What is it? · 2 Folder · 3 How" ("3 Vault" for the Vault), or "1 Folder · 2 How" when the type is already known; a kind that
    // holds several named libraries adds "Library" before Folder.
    private IReadOnlyList<(WizardStep Step, string Label)> Steps
    {
        get
        {
            var steps = new List<(WizardStep, string)>();
            if (!_typeKnown) steps.Add((WizardStep.Kind, "What is it?"));
            if (HasLibraryStep) steps.Add((WizardStep.Library, "Library"));
            steps.Add((WizardStep.Folder, "Folder"));
            steps.Add((WizardStep.How, IsVault ? "Vault" : IsViewFlow ? "Who for" : "How"));
            return steps;
        }
    }

    private int CurrentStepIndex => Steps.ToList().FindIndex(entry => entry.Step == (_step == WizardStep.Vault ? WizardStep.How : _step));

    protected override void OnInitialized()
    {
        Nsfw.Changed += OnVaultModeChanged;
        _configuration = Configuration;
        var known = LibraryFolderAddService.ResolveType(Kinds, _configuration, StartTypeKey);
        // View's folders cannot be added in setup without the signed-in administrator, so a View type there starts at step 1 like no type at all.
        if (Embedded && !ViewInSetup && known is not null && Kinds.GroupFor(known.Key)?.Key == "view") known = null;
        if (known is not null)
        {
            _typeKnown = true;
            _type = known;
            _groupKey = Kinds.GroupFor(known.Key)?.Key ?? Kinds.ForArea(known.Area)?.Key;
            _step = HasLibraryStep ? WizardStep.Library : WizardStep.Folder;
            if (_step == WizardStep.Library) PreselectLibrary();
        }
        else
        {
            // Only a group the wizard offers can start it, so setup opens on View only for the signed-in administrator (and never hands off to it).
            _groupKey = OfferedGroups.FirstOrDefault(group => string.Equals(group.Key, StartGroupKey?.Trim(), StringComparison.OrdinalIgnoreCase))?.Key;
            // The Vault has no kinds to choose, so its own page opens the wizard on the folder step.
            if (IsVault)
            {
                _type = VaultType;
                _step = WizardStep.Folder;
            }
        }
    }

    // Vault mode switching off while the wizard is open takes the Vault tile off step 1 at once and closes the wizard if the Vault was picked.
    private void OnVaultModeChanged() => _ = InvokeAsync(() =>
    {
        if (!Nsfw.Unlocked && _groupKey == LibraryGroupCatalog.VaultKey)
        {
            Dialog.Cancel();
            return;
        }

        StateHasChanged();
    });

    public void Dispose() => Nsfw.Changed -= OnVaultModeChanged;

    private IEnumerable<LibraryTypeOption> KindsOf(LibraryGroup group) =>
        group.TypeKeys.Select(Kinds.Find).OfType<LibraryTypeOption>();

    // What belongs in each kind (the (i) beside its card) is part of the kind's own entry.
    private static string TipFor(LibraryTypeOption kind) => kind.Tooltip;

    private void ChooseGroup(LibraryGroup group)
    {
        // The Vault has no kinds: choosing its tile goes straight to the folder step.
        if (group.Key == LibraryGroupCatalog.VaultKey)
        {
            if (_type != VaultType) _folder = null;
            _groupKey = group.Key;
            _type = VaultType;
            GoTo(WizardStep.Folder);
            return;
        }

        if (_groupKey == group.Key) return;
        _groupKey = group.Key;
        _type = null;
    }

    private void ChooseKind(LibraryTypeOption kind)
    {
        // View keeps its folders in its own place, so choosing one of its kinds hands over to that kind's add form; nothing is created here.
        // First-run setup stays in setup: the wizard saves the View folder itself (AddViewAsync).
        if (LibraryTypeCatalog.IsViewKind(kind) && !ViewInSetup)
        {
            HandOffToView(kind.Key, null);
            return;
        }

        if (_type?.Key != kind.Key)
        {
            _folder = null;
            _libraryChoice = null;
            _newLibraryName = string.Empty;
        }

        _type = kind;
        if (HasLibraryStep)
        {
            PreselectLibrary();
            GoTo(WizardStep.Library);
            return;
        }

        GoTo(WizardStep.Folder);
    }

    // The library step opens on the first existing library, or on a new custom library when the kind has none yet; the first
    // library of a kind starts out named for it (the person can change it), later ones start empty.
    private void PreselectLibrary()
    {
        if (_libraryChoice == NewLibraryChoice && CanAddLibrary) return;
        if (ChosenLibrary is not null) return;
        _libraryChoice = ExistingLibraries.FirstOrDefault()?.Id ?? (CanAddLibrary ? NewLibraryChoice : null);
        if (_libraryChoice == NewLibraryChoice && ExistingLibraries.Count == 0 && string.IsNullOrWhiteSpace(_newLibraryName) && _type is not null)
        {
            _newLibraryName = _type.Label;
        }
    }

    private void GoTo(WizardStep step)
    {
        _error = null;
        _footagePending = false;
        _initialPath = step == WizardStep.Folder ? _folder?.Path : null;
        if (step == WizardStep.How)
        {
            _forHousehold = true;
            _viewSubfolders = true;
            _viewTimeline = false;
            _viewName = _folder is null ? string.Empty : Path.GetFileName(_folder.Path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar));
            // A folder with files is read-only until the person says otherwise; an empty one is managed, and asks only about new media.
            _handling = AddFolderHandling.ReadOnly;
            _markNewMediaHere = true;
        }

        _step = step;
    }

    private void Back() => GoTo(_step switch
    {
        WizardStep.How or WizardStep.Vault => WizardStep.Folder,
        WizardStep.Folder when HasLibraryStep => WizardStep.Library,
        _ => WizardStep.Kind,
    });

    // Step 2 embeds the shared folder picker; its Next button confirms the folder. Phone or camera footage in a Watch kind
    // pauses here with a hint before moving on.
    private async Task OnFolderConfirmed(ServerFolderValidationResultDto selected)
    {
        _folder = selected;
        _error = null;
        if (InWatch && selected.LooksLikePhoneFootage)
        {
            _footagePending = true;
            return;
        }

        if (IsVault)
        {
            await EnterVaultStepAsync();
            return;
        }

        GoTo(WizardStep.How);
    }

    // The Vault step needs to know whether the Vault library exists yet (then only the PIN is asked) or this folder creates it.
    private async Task EnterVaultStepAsync()
    {
        GoTo(WizardStep.Vault);
        await RetryVaultReadAsync();
    }

    private async Task RetryVaultReadAsync()
    {
        _vaultLoading = true;
        try
        {
            await LoadVaultLibraryAsync();
        }
        finally
        {
            _vaultLoading = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadVaultLibraryAsync()
    {
        var call = await Api.GetVaultLibrariesAsync();
        _vaultReadFailed = !call.Succeeded;
        _vaultLibrary = call.Succeeded ? call.Value?.FirstOrDefault() : null;
    }

    // The PIN comes on the number pad, never typed into the page. The Engine's refusals (a wrong PIN, a folder that holds ordinary files) are shown as they come.
    private async Task AddToVaultAsync()
    {
        if (_saving || _folder is null || !CanAddToVault) return;
        _saving = true;
        _error = null;
        try
        {
            var created = _vaultLibrary is null ? new NewVaultLibrary(_vaultLookup, null, _adultsConfirmed) : null;
            var result = await VaultOnboarding.AddFolderAsync(_folder.Path, _vaultLibrary, created);
            switch (result.Outcome)
            {
                case VaultOnboardingOutcome.FolderAttached:
                    _notice = null;
                    _step = WizardStep.Done;
                    if (OnFolderAdded is not null) await OnFolderAdded(null);
                    break;
                case VaultOnboardingOutcome.FolderNotAdded:
                    _error = result.Message;
                    // A first folder that is refused still leaves the (empty) library behind, so the next try only asks for the PIN.
                    await LoadVaultLibraryAsync();
                    break;
                case VaultOnboardingOutcome.NotAvailable:
                    _error = VaultMessages.NotAvailable;
                    break;
            }
        }
        finally { _saving = false; }
    }

    // View's own add form for the kind takes over (its address reads ?add=folder); nothing has been saved by the wizard.
    private void HandOffToView(string kindKey, string? path)
    {
        var address = $"{LibraryGroupCatalog.TypeAddress(Kinds.TryGetGroup(LibraryTypeCatalog.ViewArea)!, kindKey)}?add=folder";
        if (!string.IsNullOrWhiteSpace(path)) address += $"&path={Uri.EscapeDataString(path)}";
        Dialog.Cancel();
        Navigation.NavigateTo(address);
    }

    // Setup's View save: the shared household library (the default) or the administrator's own space, through the same Engine actions
    // View settings uses. The Engine's refusal is shown as it comes and nothing is added.
    private async Task AddViewAsync()
    {
        if (_saving || _type is null || _folder is null || ViewOwnerProfileId is not { } owner) return;
        if (string.IsNullOrWhiteSpace(_viewName))
        {
            _error = "Give the folder a name.";
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            var request = new CreateViewSourceRequest(_viewName.Trim(), "linked", _folder.Path, _viewSubfolders, _viewTimeline && _type.Key != ViewContentKinds.Documents, _type.Key);
            var created = _forHousehold
                ? await Api.CreateViewSharedSourceAsync(request)
                : await Api.CreateViewProfileSourceAsync(owner, request);
            if (created is null)
            {
                _error = Api.LastError is { Length: > 0 } refusal ? refusal : "Folder could not be added.";
                return;
            }

            _notice = null;
            _step = WizardStep.Done;
            if (OnFolderAdded is not null) await OnFolderAdded(null);
        }
        finally { _saving = false; }
    }

    private async Task AddAsync()
    {
        if (_saving || _type is null || _folder is null) return;
        _saving = true;
        _error = null;
        try
        {
            var withFiles = _folder.ContainsFiles;
            var plan = new AddFolderPlan(
                _type.Key,
                _folder,
                withFiles ? _handling : AddFolderHandling.Managed,
                MarkNewMediaHere: !withFiles && _markNewMediaHere,
                LibraryId: _type.AllowsMultiple && _libraryChoice != NewLibraryChoice ? _libraryChoice : null,
                NewLibraryName: _type.AllowsMultiple && _libraryChoice == NewLibraryChoice ? _newLibraryName.Trim() : null);
            var result = await AddService.AddAsync(plan, Kinds, _configuration, Scope);
            if (!result.Saved)
            {
                _error = result.Error;
                return;
            }

            _configuration = result.Configuration!;
            // A new custom library now exists: adding another folder joins it instead of making a second one with the same name.
            if (_type.AllowsMultiple && result.LibraryId is not null)
            {
                _libraryChoice = result.LibraryId;
                _newLibraryName = string.Empty;
            }

            _notice = result.Notice;
            await FollowUpAsync(plan, result);
            _step = WizardStep.Done;
            if (OnFolderAdded is not null) await OnFolderAdded(_notice);
        }
        finally { _saving = false; }
    }

    // The same questions the panel always asked after adding: organise a managed folder's existing files, or choose where a merged one goes.
    private async Task FollowUpAsync(AddFolderPlan plan, AddFolderResult result)
    {
        var library = _configuration.Libraries.FirstOrDefault(item => item.Id == result.LibraryId)
            ?? (_type is null ? null : LibraryRollup.LibraryFor(_configuration, _type));
        var added = library?.Sources.FirstOrDefault(item => item.Id == result.Source?.Id) ?? result.Source;
        if (library is null || added is null) return;

        FolderFollowUp? followUp = null;
        if (result.Managed && plan.Folder.ContainsFiles)
        {
            // The files already in it are not touched until the person says so.
            followUp = await AddService.OfferOrganiseAsync(Scope, added, alreadyManaged: true, quiet: true);
        }
        else if (plan.Handling == AddFolderHandling.Merge)
        {
            // The folder is now part of the library as read-only; the sheet asks where its files should go.
            followUp = await AddService.MergeIntoAsync(Scope, library, added);
        }

        if (followUp?.Notice is not null) _notice = followUp.Notice;
    }

    private void AddAnother()
    {
        _folder = null;
        _initialPath = null;
        _footagePending = false;
        _error = null;
        _notice = null;
        _handling = AddFolderHandling.ReadOnly;
        _markNewMediaHere = true;
        _vaultLookup = "none";
        _adultsConfirmed = false;
        if (_typeKnown)
        {
            _step = HasLibraryStep ? WizardStep.Library : WizardStep.Folder;
            if (_step == WizardStep.Library) PreselectLibrary();
            return;
        }

        _type = null;
        _step = WizardStep.Kind;
    }

    private string? GoToAddress
    {
        get
        {
            if (IsVault) return LibraryGroupCatalog.GroupAddress(Kinds.TryGetGroup(LibraryGroupCatalog.VaultKey)!);
            if (_type is null) return null;
            var group = Kinds.GroupFor(_type.Key) ?? Kinds.ForArea(_type.Area);
            return group is not null
                ? LibraryGroupCatalog.TypeAddress(group, _type.Key)
                : $"/settings/libraries/other/{_type.Key}";
        }
    }

    private void GoToType()
    {
        if (GoToAddress is not { } address) return;
        Dialog.Cancel();
        Navigation.NavigateTo(address);
    }

    // One radio card for a way of using a folder that has files: the choice, an (i) with what it does, and for Managed a warning icon that shows without hovering.
    private RenderFragment Option(AddFolderHandling handling, string icon, string title, string tip, bool warning) => __builder =>
    {
        var selected = _handling == handling;
        <div class="add-wizard__option">
            <AppNativeButton Type="button"
                             role="radio"
                             Class="@(selected ? "add-wizard__choice is-selected" : "add-wizard__choice")"
                             data-handling="@handling.ToString().ToLowerInvariant()"
                             aria-checked="@(selected ? "true" : "false")"
                             Disabled="@_saving"
                             OnClick="@(_ => _handling = handling)">
                <AppMaterialIcon Icon="@icon" />
                <strong>@title</strong>
                @if (warning)
                {
                    <span class="add-wizard__warning" role="img" aria-label="Warning"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Warning" /></span>
                }
            </AppNativeButton>
            <AppTooltip Text="@tip" Placement="AppPlacement.Top">
                <span class="add-wizard__info" role="img" tabindex="0" aria-label="@($"About {title}: {tip}")"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Info" /></span>
            </AppTooltip>
        </div>
    };

    // One radio card for a library the folder can join: an existing library by name, or a new custom one.
    private RenderFragment LibraryOption(string choice, string title) => __builder =>
    {
        var selected = _libraryChoice == choice;
        <div class="add-wizard__option">
            <AppNativeButton Type="button"
                             role="radio"
                             Class="@(selected ? "add-wizard__choice is-selected" : "add-wizard__choice")"
                             data-library="@choice"
                             aria-checked="@(selected ? "true" : "false")"
                             OnClick="@(_ => _libraryChoice = choice)">
                <strong>@title</strong>
            </AppNativeButton>
        </div>
    };

    // One radio card for who a View folder is for.
    private RenderFragment AudienceOption(bool household, string title, string tip) => __builder =>
    {
        var selected = _forHousehold == household;
        <div class="add-wizard__option">
            <AppNativeButton Type="button"
                             role="radio"
                             Class="@(selected ? "add-wizard__choice is-selected" : "add-wizard__choice")"
                             data-audience="@(household ? "household" : "me")"
                             aria-checked="@(selected ? "true" : "false")"
                             Disabled="@_saving"
                             OnClick="@(_ => _forHousehold = household)">
                <strong>@title</strong>
            </AppNativeButton>
            <AppTooltip Text="@tip" Placement="AppPlacement.Top">
                <span class="add-wizard__info" role="img" tabindex="0" aria-label="@($"About {title}: {tip}")"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Info" /></span>
            </AppTooltip>
        </div>
    };

    // The empty-folder question: Yes files new media here, No keeps it managed without the marker.
    private RenderFragment YesNoOption(bool yes, string title, string tip) => __builder =>
    {
        var selected = _markNewMediaHere == yes;
        <div class="add-wizard__option">
            <AppNativeButton Type="button"
                             role="radio"
                             Class="@(selected ? "add-wizard__choice is-selected" : "add-wizard__choice")"
                             data-answer="@(yes ? "yes" : "no")"
                             aria-checked="@(selected ? "true" : "false")"
                             Disabled="@_saving"
                             OnClick="@(_ => _markNewMediaHere = yes)">
                <strong>@title</strong>
            </AppNativeButton>
            <AppTooltip Text="@tip" Placement="AppPlacement.Top">
                <span class="add-wizard__info" role="img" tabindex="0" aria-label="@($"About {title}: {tip}")"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Info" /></span>
            </AppTooltip>
        </div>
    };
}
