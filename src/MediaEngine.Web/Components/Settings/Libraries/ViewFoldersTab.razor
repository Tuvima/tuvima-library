@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.LocalAssets
@using MediaEngine.Domain.PersonalMedia
@using MediaEngine.Web.Services.Ui
@inject IEngineApiClient ApiClient
@inject IAppDialogService DialogService
@inject IStringLocalizer<SharedStrings> L

@* The Folders tab of a View kind (Library pages WP11, D24, D25, D26): the storage base, the folders of every profile's personal space and
   of the Shared Library, and one "Show in Photos timeline" switch on each folder. A folder is read in full, subfolders included, so there
   is no subfolders switch. A new folder is Managed by default (Library owns its structure); a linked folder stays read-only and its
   timeline switch is the only way to keep it out of the Photos timeline. *@
@if (Kind is ViewContentKinds.Photos or ViewContentKinds.PersonalVideos)
{
    <ViewImportPanel Kind="@Kind" ReadOnly="@ReadOnly" Changed="SourcesChanged" />
}
<SettingsSectionPanel Title="@L["ViewFoldersTab_Folders"].Value" Description="@L["ViewFoldersTab_OneStorageBaseForShared"].Value">
    <Actions>
        <AppButton Label="@L["Common_AddFolder"].Value" StartIcon="@AppMaterialIcons.Outlined.Add" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(ReadOnly || _busy)" OnClick="@(() => AddingChanged.InvokeAsync(!Adding))" />
    </Actions>
    <ChildContent>
    <div class="view-storage-root">
        <span class="view-icon"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Storage" /></span>
        <div><strong>@L["ViewFoldersTab_ViewLibraryRoot"]</strong><code>@RootPath</code><small>@L["ViewFoldersTab_TheBaseFolderForAll"]</small></div>
        <AppButton Label="@L["ViewFoldersTab_ChooseRoot"].Value" ButtonStyle="AppButtonStyle.Outlined" Disabled="@(ReadOnly || _busy)" OnClick="ChooseRootAsync" />
    </div>
    <div class="view-storage-destinations">
        <div><span class="view-icon"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FolderShared" /></span><span><strong>@L["Common_SharedLibrary"]</strong><code>@Path.Combine(RootPath, "Shared")</code><small>@L["ViewFoldersTab_ServerOwnedOriginalsFromAccepted"]</small></span></div>
        <div><span class="view-icon"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.AccountCircle" /></span><span><strong>@L["ViewFoldersTab_ProfilePersonalSpaces"]</strong><code>@Path.Combine(RootPath, "Profiles")</code><small>@L["ViewFoldersTab_OnePrivateSpacePerProfile"]</small></span></div>
    </div>
    <p class="view-folders__note">
        @L["ViewFoldersTab_TheseAreStorageDestinationsEmpty"]
        <AppInfoTip Text="@BackupNote" Label="@L["ViewFoldersTab_AboutBackups"].Value" />
    </p>
    @if (Adding)
    {
        <div class="libraries-form-grid">
            <AppSelect Label="@L["ViewFoldersTab_OwnerProfile"].Value" Value="@_owner" ValueChanged="@((string? value) => _owner = value)" Options="@OwnerOptions" Disabled="@_busy" />
            <AppTextField Label="@(_mode == LinkedMode ? L["ViewFoldersTab_FolderNameOptional"].Value : L["Common_FolderName"].Value)" Value="@_name" ValueChanged="@((string? value) => _name = value ?? string.Empty)" ReadOnly="@_busy" />
            <AppSelect Label="@L["ViewFoldersTab_FolderManagement"].Value" Value="@_mode" ValueChanged="@((string? value) => { _mode = value ?? LinkedMode; _path = null; })" Options="@ModeOptions" Disabled="@_busy" />
            @if (_mode == LinkedMode)
            {
                <AppButton Label="@L["ViewFoldersTab_ChooseExistingFolder"].Value" ButtonStyle="AppButtonStyle.Outlined" Disabled="@_busy" OnClick="ChooseSourceAsync" />
                <code>@(_path ?? "No folder selected")</code>
            }
            @if (ShowsTimeline)
            {
                <AppSwitchRow Label="@L["ViewFoldersTab_ShowInPhotosTimeline"].Value" Description="@L["ViewFoldersTab_FoldersRemainBrowsableEvenWhen"].Value" Value="@_timeline" ValueChanged="@((bool value) => _timeline = value)" Disabled="@_busy" />
            }
        </div>
        <p>@(_mode == LinkedMode ? "Files remain where they are and are indexed read-only. Everything inside the folder is included, subfolders too." : "Create an empty managed folder in this profile’s Personal Space. Existing files are not moved.")</p>
        <AppActionBar><AppButton Label="@L["Search_Cancel"].Value" ButtonStyle="AppButtonStyle.Text" Disabled="@_busy" OnClick="@(() => AddingChanged.InvokeAsync(false))" /><AppButton Label="@L["Common_AddFolder"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_busy" Disabled="@(_busy || string.IsNullOrWhiteSpace(_owner) || (_mode != LinkedMode && string.IsNullOrWhiteSpace(_name)) || (_mode == LinkedMode && _path is null))" OnClick="AddAsync" /></AppActionBar>
    }
    @if (Loading) { <p role="status">@L["ViewFoldersTab_LoadingPersonalSources"]</p> }
    @if (_error is not null) { <AppAlert Tone="AppUiTone.Error">@_error</AppAlert> }
    @if (_note is not null) { <AppAlert Tone="AppUiTone.Info" ShowCloseIcon="true" CloseIconClicked="@(() => { _note = null; })" data-folders-note>@_note</AppAlert> }
    @foreach (var profile in Profiles)
    {
        <div class="view-source-group">
            <h4>@profile.DisplayName</h4>
            @if (!Reviews.TryGetValue(profile.Id, out var review)) { <p>@L["ViewFoldersTab_SourcesUnavailable"]</p> }
            else if (review.PersonalSpace is null) { <p>@L["ViewFoldersTab_NoFilesYetAPersonal"]</p> }
            else
            {
                <code>@review.PersonalSpace.RootPath</code>
                var sources = review.Sources.Where(source => LibraryRollup.ViewFolderBelongsTo(source, Kind)).ToList();
                @if (sources.Count == 0) { <p>@L["ViewFoldersTab_NoFoldersYet", KindNoun]</p> }
                else
                {
                <div class="view-source-table">
                <div class="view-source-head" aria-hidden="true"><span>@L["Common_Folder"]</span><span>@L["ViewFoldersTab_Management"]</span><span>@(ShowsTimeline ? "Show in Photos timeline" : string.Empty)</span><span>@L["Models_Status"]</span><span>@L["ApiKeys_Actions"]</span></div>
                @foreach (var source in sources)
                {
                    <div class="view-source-row @_glow.Class(source.Id.ToString())" @key="@($"{source.Id}-{_glow.Version(source.Id.ToString())}")">
                        <span>
                            <strong>@source.Name</strong>
                            @if (source.AcceptsPhotosAndVideos) { <AppStatusBadge Text="@L["ViewFoldersTab_PhotosAndVideos"].Value" Tone="AppUiTone.Neutral" /> }
                            <code>@source.Location</code>
                            @if (source.SkippedFileCount > 0)
                            {
                                <AppTooltip Text="@SkippedTooltip"><small>@SkippedText(source.SkippedFileCount)</small></AppTooltip>
                            }
                            @if (source.KeptInLibraryCount > 0)
                            {
                                <AppTooltip Text="@KeptInLibraryTooltip"><small>@KeptInLibraryText(source.KeptInLibraryCount)</small></AppTooltip>
                            }
                        </span>
                        <span>@SourcePolicy(source)</span>
                        @if (ShowsTimeline) { <AppSwitchRow Label="@L["ViewFoldersTab_ShowInPhotosTimeline"].Value" Value="@source.IncludeInTimeline" ValueChanged="@((bool value) => SetTimelineAsync(profile.Id, source, value))" Disabled="@(ReadOnly || _busy)" /> }
                        else { <span></span> }
                        @if (source.FolderOffline)
                        {
                            <AppTooltip Text="@L["ViewFoldersTab_LibraryCanTReachThis"].Value"><AppStatusBadge Text="@L["Common_FolderOffline"].Value" Tone="AppUiTone.Warning" /></AppTooltip>
                        }
                        else
                        {
                            <AppStatusBadge Text="@(source.Enabled ? "Indexing enabled" : "Disabled")" Tone="AppUiTone.Neutral" />
                        }
                        @if (CanTidy(source))
                        {
                            <AppIconButton Icon="@AppMaterialIcons.Outlined.CalendarMonth" AriaLabel="@($"Tidy {source.Name}")" Tooltip="@L["ViewFoldersTab_TidyThisFolderByDate"].Value" Disabled="@(ReadOnly || _busy)" OnClick="@(() => TidyAsync(source))" />
                            <AppIconButton Icon="@AppMaterialIcons.Outlined.Schedule" AriaLabel="@($"Tidy {source.Name} every night")" Tooltip="@L["ViewFoldersTab_TidyThisFolderEveryNight"].Value" Disabled="@(ReadOnly || _busy)" OnClick="@(() => ScheduleTidyAsync(source))" />
                        }
                        <AppIconButton Icon="@AppMaterialIcons.Outlined.Delete" AriaLabel="@($"Detach {source.Name}")" Tooltip="@L["ViewFoldersTab_DetachFolderKeepFiles"].Value" Disabled="@(ReadOnly || _busy || source.SourceType == "browser_upload" || source.AcceptsPhotosAndVideos)" OnClick="@(() => DetachAsync(profile.Id, source))" />
                    </div>
                }
                </div>
                }
            }
        </div>
    }
    </ChildContent>
</SettingsSectionPanel>

@code {
    private const string ManagedMode = "managed";
    private const string LinkedMode = "linked";

    /// <summary>The View kind this tab is for: photos, personal_videos or documents.</summary>
    [Parameter] public string Kind { get; set; } = ViewContentKinds.Photos;
    /// <summary>The kind's name as it reads in a sentence ("photos", "personal videos", "documents").</summary>
    [Parameter] public string KindNoun { get; set; } = "photos";
    [Parameter, EditorRequired] public LibrariesConfigurationDto Configuration { get; set; } = default!;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public IReadOnlyList<ProfileViewModel> Profiles { get; set; } = [];
    /// <summary>Each profile's folders, as the Engine last returned them.</summary>
    [Parameter] public IReadOnlyDictionary<Guid, ViewPersonalSpaceAdminReviewDto> Reviews { get; set; } = new Dictionary<Guid, ViewPersonalSpaceAdminReviewDto>();
    [Parameter] public bool Loading { get; set; }
    /// <summary>The add form is shown.</summary>
    [Parameter] public bool Adding { get; set; }
    [Parameter] public EventCallback<bool> AddingChanged { get; set; }
    /// <summary>Raised after a folder was added, changed or detached, so the page reads the folders again.</summary>
    [Parameter] public EventCallback SourcesChanged { get; set; }
    /// <summary>Raised after the View root was saved.</summary>
    [Parameter] public EventCallback RootChanged { get; set; }

    private bool _busy, _timeline;
    private string? _owner, _path, _error, _note;
    // A folder just added or given a schedule glows once; nothing else says it worked.
    private readonly JustChanged _glow = new();
    private string _name = string.Empty, _mode = LinkedMode;

    // Documents never join the Photos timeline.
    private bool ShowsTimeline => Kind != ViewContentKinds.Documents;
    private string SkippedTooltip => $"These files aren't {KindNoun}, so this folder leaves them out. They stay where they are.";
    private static string SkippedText(int count) => count == 1 ? "1 file skipped" : $"{count:N0} files skipped";
    private const string KeptInLibraryTooltip = "These files can't hold the profile name (a kind of file with no room for it, a signed or locked file, or a file kept at two places in this folder), so the name is kept in Library only. The files themselves are never changed.";
    private static string KeptInLibraryText(int count) => count == 1 ? "1 file kept in Library only" : $"{count:N0} files kept in Library only";
    private const string BackupNote = "Library's backups never include your photos, videos or documents, so a managed folder needs your own backup.";
    private string RootPath => Path.Combine(Configuration.StorageLocations.FirstOrDefault(x => x.Id == Configuration.ViewStorage.StorageLocationId)?.Path ?? "", Configuration.ViewStorage.RelativeRoot);
    private IReadOnlyList<AppSelectOption> OwnerOptions => Profiles.Select(p => new AppSelectOption(p.Id.ToString(), p.DisplayName)).ToList();
    private IReadOnlyList<AppSelectOption> ModeOptions => [new(ManagedMode, L["ViewFoldersTab_ModeManaged"].Value), new(LinkedMode, L["ViewFoldersTab_ModeLinked"].Value)];

    private async Task ChooseSourceAsync()
    {
        var selected = await PickAsync(_path ?? "", ServerFolderSelectionModes.PersonalSpaceExisting);
        if (selected is not null) _path = selected.Path;
    }

    private async Task ChooseRootAsync()
    {
        var selected = await PickAsync(RootPath, ServerFolderSelectionModes.PersonalSpaceManaged);
        if (selected is null) return;
        _busy = true;
        try
        {
            var saved = await ApiClient.MutateLibraryAsync(new LibraryMutationRequest
            {
                ExpectedViewStorage = Configuration.ViewStorage,
                ViewStorage = new ViewStorageDto { StorageLocationId = selected.StorageLocationId, RelativeRoot = string.IsNullOrWhiteSpace(selected.RelativePath) ? "." : selected.RelativePath },
            });
            if (saved is null) _error = ApiClient.LastError ?? "Root could not be saved.";
            else { _error = null; await RootChanged.InvokeAsync(); await SourcesChanged.InvokeAsync(); }
        }
        finally { _busy = false; }
    }

    private async Task<ServerFolderValidationResultDto?> PickAsync(string path, string mode)
    {
        var dialog = await DialogService.ShowAsync<ServerFolderPicker>(string.Empty, new AppDialogParameters<ServerFolderPicker>
        {
            { x => x.InitialPath, path }, { x => x.SelectionMode, mode },
        }, ServerFolderPicker.DialogOptions);
        return await dialog.Result is { Canceled: false, Data: ServerFolderValidationResultDto result } ? result : null;
    }

    private async Task AddAsync()
    {
        if (!Guid.TryParse(_owner, out var owner) || _busy) return;
        _busy = true;
        try
        {
            // A View folder is read in full, subfolders included, so the request always asks for them.
            var result = await ApiClient.CreateViewProfileSourceAsync(owner, new CreateViewSourceRequest(AddName(owner), _mode, _path, true, _timeline, Kind));
            if (result is null) _error = ApiClient.LastError ?? "Folder could not be added.";
            else
            {
                _error = null; _name = ""; _path = null;
                _glow.Mark(result.Id.ToString());
                await AddingChanged.InvokeAsync(false);
                await SourcesChanged.InvokeAsync();
            }
        }
        finally { _busy = false; }
    }

    // A linked folder's name is optional: an empty box saves the folder's own name, and a name already used by this kind gets " (2)" (View folders spec D2).
    private string AddName(Guid owner) => _mode == LinkedMode
        ? ViewFolderRules.NameFor(_name, _path, Reviews.Values.SelectMany(review => ViewFolderRules.OfKind(review.Sources, Kind)).Select(source => source.Name))
        : _name.Trim();

    private async Task SetTimelineAsync(Guid owner, ViewSourceAdminDto source, bool value)
    {
        _busy = true;
        try
        {
            var updated = await ApiClient.UpdateViewProfileSourceAsync(owner, source.Id,
                new UpdateViewSourceRequest(source.Name, source.Enabled, value));
            if (updated is null) _error = ApiClient.LastError ?? "Timeline setting could not be saved.";
            else { _error = null; await SourcesChanged.InvokeAsync(); }
        }
        finally { _busy = false; }
    }

    private static string SourcePolicy(ViewSourceAdminDto source) => source.StorageMode == LinkedMode
        ? "Read-only · Keep existing layout"
        : source.SourceType == "browser_upload"
            ? "Managed · Filed by day"
            : "Managed · Keep existing layout";

    // Tidy files what is already in a Managed photos or videos folder into the date layout, in place.
    private bool CanTidy(ViewSourceAdminDto source) =>
        Kind is ViewContentKinds.Photos or ViewContentKinds.PersonalVideos
        && source.StorageMode == ManagedMode && source.Enabled && source.SourceType == "folder" && !source.AcceptsPhotosAndVideos;

    private async Task TidyAsync(ViewSourceAdminDto source)
    {
        _note = null;
        var status = await ApiClient.GetViewTidyStatusAsync(source.Id);
        if (status is null) { _error = ApiClient.LastError ?? "This folder can't be tidied."; return; }
        // What the person asked about is answered in place, above the folders, until it is closed or the next try.
        if (status.Running) { _note = L["ViewFoldersTab_BeingTidied", source.Name, status.Moved, status.Total].Value; return; }
        if (status.WillMove == 0)
        {
            _note = status.Message is { Length: > 0 } last ? L["ViewFoldersTab_FiledByDateLast", source.Name, last].Value : L["ViewFoldersTab_AlreadyFiledByDate", source.Name].Value;
            return;
        }

        var example = status.ExampleFrom is null ? string.Empty : $" For example {status.ExampleFrom} becomes {status.ExampleTo}.";
        var question = $"Tidy {source.Name}? {status.WillMove:N0} files will be renamed into date folders inside this folder; nothing is copied or leaves it.{example} " +
            "While it runs, new files for this library wait and are filed afterwards. Your originals' contents are never changed.";
        if (await DialogService.ShowMessageBoxAsync("Tidy this folder?", question, yesText: "Tidy now", cancelText: "Cancel") != true) return;
        _busy = true;
        try
        {
            if (await ApiClient.RunViewTidyAsync(source.Id) is null) _error = ApiClient.LastError ?? "The folder could not be tidied.";
            else _note = L["ViewFoldersTab_TidyingNow", source.Name].Value;
        }
        finally { _busy = false; }
    }

    private async Task ScheduleTidyAsync(ViewSourceAdminDto source)
    {
        var status = await ApiClient.GetViewTidyStatusAsync(source.Id);
        if (status is null) { _error = ApiClient.LastError ?? "This folder can't be tidied."; return; }
        var turnOn = !status.Scheduled;
        var hour = DateTime.Today.AddHours(status.ScheduleHour).ToString("h tt");
        var question = turnOn
            ? $"Tidy {source.Name} every night at {hour}? New files for this library wait while it runs."
            : $"Stop tidying {source.Name} every night?";
        if (await DialogService.ShowMessageBoxAsync(turnOn ? "Tidy every night?" : "Stop tidying every night?", question, yesText: turnOn ? "Tidy every night" : "Stop", cancelText: "Cancel", options: turnOn ? null : AppDialogOptions.DestructiveConfirm) != true) return;
        _busy = true;
        try
        {
            if (await ApiClient.SetViewTidyScheduleAsync(source.Id, turnOn) is null) _error = ApiClient.LastError ?? "The schedule could not be saved.";
            else _glow.Mark(source.Id.ToString());
        }
        finally { _busy = false; }
    }

    private async Task DetachAsync(Guid owner, ViewSourceAdminDto source)
    {
        if (await DialogService.ShowMessageBoxAsync("Detach folder?", $"Detach {source.Name}? Original files remain at {source.Location}.", yesText: "Detach folder", cancelText: "Cancel", options: AppDialogOptions.DestructiveConfirm) != true) return;
        _busy = true;
        try
        {
            if (await ApiClient.DeleteViewProfileSourceAsync(owner, source.Id)) { await SourcesChanged.InvokeAsync(); }
            else _error = ApiClient.LastError ?? "Folder could not be detached.";
        }
        finally { _busy = false; }
    }
}
