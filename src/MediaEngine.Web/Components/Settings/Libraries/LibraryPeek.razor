@namespace MediaEngine.Web.Components.Settings

@* The hover card of Add library's tiles and Change kind's cards (Libraries v3 D24): a small styled card beside the control, never the browser's
   tooltip bubble and no (i) icon. It opens on mouse-over or keyboard focus, closes on mouse-out, focus-out or Esc, and says what belongs in the
   thing, with examples, and what Library does with it. The words come from the kind list, so a new kind brings its own. *@
<div class="lib-peek"
     @onmouseenter="Show" @onmouseleave="Hide"
     @onfocusin="Show" @onfocusout="Hide"
     @onkeydown="KeyDown">
    @ChildContent
    @if (_open && HasWords)
    {
        <div class="lib-peek__tip" role="tooltip" data-hover-card>
            <strong class="lib-peek__title">@Title</strong>
            @if (!string.IsNullOrWhiteSpace(About))
            {
                <p class="lib-peek__about">@About</p>
            }
            @if (Examples is { Count: > 0 })
            {
                <p class="lib-peek__examples">@string.Join(", ", Examples)</p>
            }
            @if (!string.IsNullOrWhiteSpace(LibraryDoes))
            {
                <p class="lib-peek__does">@LibraryDoes</p>
            }
            @if (!string.IsNullOrWhiteSpace(Note))
            {
                <p class="lib-peek__note">@Note</p>
            }
        </div>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    /// <summary>One plain sentence on what belongs here.</summary>
    [Parameter] public string? About { get; set; }
    /// <summary>Two or three examples.</summary>
    [Parameter] public IReadOnlyList<string>? Examples { get; set; }
    /// <summary>One line on what Library does with it.</summary>
    [Parameter] public string? LibraryDoes { get; set; }
    /// <summary>An extra line, for example why a tile is greyed.</summary>
    [Parameter] public string? Note { get; set; }

    private bool _open;

    private bool HasWords => !string.IsNullOrWhiteSpace(About) || Examples is { Count: > 0 } || !string.IsNullOrWhiteSpace(LibraryDoes) || !string.IsNullOrWhiteSpace(Note);

    private void Show() => _open = true;

    private void Hide() => _open = false;

    private void KeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") _open = false;
    }
}
