    private string LibraryLastScan(LibraryFolderDto library)
    {
        var latest = _ingestionSnapshot?.SourceGroups
            .SelectMany(group => group.Libraries)
            .SelectMany(sourceLibrary => sourceLibrary.Folders)
            .Where(folder => library.Sources.Any(source => string.Equals(source.Path, folder.Path, StringComparison.OrdinalIgnoreCase)))
            .Where(folder => folder.LastScan.HasValue)
            .Select(folder => folder.LastScan!.Value)
            .DefaultIfEmpty()
            .Max();
        return latest is null || latest == default ? "Not scanned" : FormatRelative(latest.Value);
    }

