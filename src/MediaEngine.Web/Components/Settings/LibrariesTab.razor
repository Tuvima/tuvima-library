@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Library
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Services.Navigation
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject MediaEngine.Web.Services.Settings.LibraryKindsState LibraryKinds
@inject DeviceContextService DeviceContext
@inject NavigationManager Navigation
@inject MediaEngine.Web.Services.Ui.IAppDialogService DialogService
@inject MediaEngine.Web.Services.Vault.NsfwModeState Nsfw
@inject DashboardSessionAccessor Session
@implements IDisposable
@inject IStringLocalizer<SharedStrings> L

@{
    var readOnly = DeviceContext.IsMobile;
    var unavailable = DeviceContext.IsTelevision;
}

@* Libraries has these addresses, so Back and a reload keep the level: the overview (/settings/libraries, with ?area=watch|listen|read|view),
   one library's page (/settings/libraries/{libraryId}, with ?tab=), and each View kind's
   settings (/settings/libraries/view/{kind}: photos, personal_videos, documents). An older group or type address is not found. *@
<div class="libraries">
    @if (unavailable)
    {
        <AppPageState Kind="AppPageStateKind.Unavailable"
                      Icon="@AppMaterialIcons.Outlined.DesktopAccessDisabled"
                      Title="@L["LibrariesTab_LibrarySettingsAreUnavailable"].Value"
                      Message="@L["LibrariesTab_UseADesktopOrTablet"].Value" />
    }
    else if (_loading)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="@L["Common_LoadingLibraries"].Value" Class="tl-sp-py-8" />
    }
    else if (_configuration is null)
    {
        <AppPageState Kind="AppPageStateKind.Error"
                      Icon="@AppMaterialIcons.Outlined.CloudOff"
                      Title="@L["Common_LibrariesCouldNotBeLoaded"].Value"
                      Message="@(_loadError ?? "The Engine did not return library configuration.")">
            <Actions>
                <AppButton Label="@L["Common_TryAgain"].Value" ButtonStyle="AppButtonStyle.Outlined" OnClick="RetryAsync" />
            </Actions>
        </AppPageState>
    }
    else
    {
        var level = CurrentLevel;
        RenderFragment content = @<text>
        @switch (level.Kind)
        {
            case LevelKind.Overview:
                <LibrariesOverview Configuration="@_configuration"
                                   Kinds="@Kinds"
                                   Overview="@_overview"
                                   ViewFolders="@_viewFolders"
                                   PathIssues="@_pathIssues"
                                   ShowVault="@VaultVisible"
                                   ReadOnly="@readOnly"
                                   Area="@AreaQuery"
                                   ImportWaiting="@_importWaiting"
                                   FolderAdded="FolderAddedAsync" />
                break;
            case LevelKind.Library:
                <LibraryShell @key="@level.Library!.Id"
                             Library="@level.Library"
                             Configuration="@_configuration"
                             Kinds="@Kinds"
                             Overview="@_overview"
                             PathIssues="@_pathIssues"
                             ReadOnly="@readOnly"
                             Tab="@TabQuery"
                             HighlightAddFolder="@HighlightAdd"
                             VaultVisible="@VaultVisible"
                             Changed="FolderAddedAsync" />
                break;
            case LevelKind.ViewKind:
                <ViewKindPage @key="@level.TypeKey"
                                 Kind="@(level.TypeKey!)"
                                 Kinds="@Kinds"
                                 Configuration="@_configuration"
                                 ReadOnly="@readOnly"
                                 Tab="@TabQuery"
                                 RootChanged="LoadAsync" />
                break;
            default:
                <AppPageState Kind="AppPageStateKind.Unavailable"
                              Icon="@AppMaterialIcons.Outlined.FolderOpen"
                              Title="@L["LibrariesTab_ThisPageDoesNot"].Value">
                    <Actions>
                        <AppButton Href="/settings/libraries" Label="@L["Common_BackToLibraries"].Value" ButtonStyle="AppButtonStyle.Outlined" />
                    </Actions>
                </AppPageState>
                break;
        }
        </text>;

        @* The folders panel carries its own phone note; this one covers the View settings, which are read-only on a phone too. *@
        @if (readOnly && level.Kind == LevelKind.ViewKind)
        {
            <p class="libraries__mobile-note">@L["LibrariesTab_LibraryStorageAndIntakeAre"]</p>
        }

        @if (_engineUnavailable)
        {
            <AppAlert Tone="AppUiTone.Error">
                @L["LibrariesTab_TheEngineIsUnavailableExisting"]
            </AppAlert>
        }
        else if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <AppAlert Tone="AppUiTone.Warning">@_loadError</AppAlert>
        }

        @* No rail on a Libraries page (Libraries v3 D22): the table uses the full width, the chips filter, and a library's page has its breadcrumb back. *@
        @if (level.Kind != LevelKind.NotFound)
        {
            <LibraryStatusLine ReadOnly="@readOnly" />
        }
        @content
    }
</div>

@code {
    [Parameter] public string? Subsection { get; set; }
    [Parameter] public string? Detail { get; set; }

    // The address this page was routed with (see RoutedPageQuery): the page under the details overlay keeps its own query.
    [CascadingParameter(Name = RoutedPageQuery.CascadingName)] public string? RoutedUri { get; set; }

    private enum LevelKind { Overview, Library, ViewKind, NotFound }

    private sealed record Level(LevelKind Kind, LibraryFolderDto? Library = null, string? TypeKey = null);

    private LibrariesConfigurationDto? _configuration;
    private LibraryKindCatalog Kinds => LibraryKinds.Catalog;
    private LibraryOverviewDto? _overview;
    private IReadOnlyDictionary<string, int>? _viewFolders;
    // Null until the folder checks finish: no status is claimed before then.
    private IReadOnlyDictionary<string, string>? _pathIssues;
    private string? _loadError;
    private bool _loading = true;
    private bool _engineUnavailable;
    private string? _routeKey;
    // Files waiting in the Import folder, for its row on the overview; null until known.
    private int? _importWaiting;
    private bool _isKids;

    // A Vault-protected library is listed only for an administrator with Vault mode on, never on a Kids profile (Library setup D13).
    private bool VaultVisible => LibraryVaultAccess.CanShow(Nsfw, Session, _isKids);

    private RoutedPageQuery Query => RoutedPageQuery.From(RoutedUri ?? Navigation.Uri);
    private string? AreaQuery => Query.String("area");
    private string? TabQuery => Query.String("tab");

    protected override async Task OnInitializedAsync()
    {
        _routeKey = $"{Subsection}/{Detail}";
        Nsfw.Changed += OnVaultModeChanged;
        _isKids = (await Orchestrator.GetActiveProfileAsync())?.IsRestricted == true;
        // The list of kinds is read again on each visit, since a plugin may have been switched on or off; the list read
        // before stays if the Engine cannot answer.
        await LibraryKinds.RefreshAsync();
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
        await LoadSummaryAsync();
    }

    // Vault mode switching on or off lists or removes Vault-protected libraries at once.
    private void OnVaultModeChanged() => _ = InvokeAsync(async () =>
    {
        // The Vault-protected libraries are read only while the person may see them, so they are added or dropped here.
        await RefreshConfigurationAsync();
        StateHasChanged();
    });

    public void Dispose() => Nsfw.Changed -= OnVaultModeChanged;

    protected override async Task OnParametersSetAsync()
    {
        // The Settings page keeps this component while the address changes; coming back to a list shows fresh counts.
        var routeKey = $"{Subsection}/{Detail}";
        if (_routeKey is null || string.Equals(_routeKey, routeKey, StringComparison.OrdinalIgnoreCase)) return;
        _routeKey = routeKey;
        if (_configuration is not null && CurrentLevel.Kind is LevelKind.Overview or LevelKind.Library)
        {
            await RefreshConfigurationAsync();
            await LoadSummaryAsync();
        }
    }

    private LibraryFolderDto? FindLibrary(string? id) => string.IsNullOrWhiteSpace(id)
        ? null
        : _configuration?.Libraries.FirstOrDefault(library => LibraryRollup.IsCatalogued(library) && string.Equals(library.Id, id.Trim(), StringComparison.OrdinalIgnoreCase));

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _configuration = await ReadConfigurationAsync();
        _engineUnavailable = _configuration is null;
        if (_configuration is null) _loadError = ApiClient.LastError;
        else if (!LibraryKinds.Loaded) _loadError = L["LibrariesTab_TheListOfLibraryKinds"].Value;
        _loading = false;
    }

    private async Task RetryAsync()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
        await LoadSummaryAsync();
    }

    // The folder check plus the folders whose import is held because nothing can identify their files yet.
    private async Task<IReadOnlyDictionary<string, string>> CheckFoldersAsync(LibrariesConfigurationDto configuration)
    {
        var issues = await LibraryFolderHealth.CheckAsync(configuration, path => Orchestrator.TestPathAsync(path));
        try
        {
            return LibraryFolderHealth.WithHeldKinds(issues, configuration, LibraryFolderHealth.HeldKinds(await ApiClient.GetPluginsAsync()));
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            // The plugin list could not be read: show the folder check as it is rather than guess which sources work.
            return issues;
        }
    }

    // The overview and library pages show counts and status. They load after the first render so the rows appear at once;
    // anything that cannot be read is left out rather than guessed (no overview means folder counts only).
    private async Task LoadSummaryAsync()
    {
        if (_configuration is null || DeviceContext.IsTelevision || CurrentLevel.Kind is not (LevelKind.Overview or LevelKind.Library)) return;
        var configuration = _configuration;
        var overview = ApiClient.GetLibraryOverviewAsync();
        var issues = CheckFoldersAsync(configuration);
        var viewFolders = CurrentLevel.Kind == LevelKind.Overview ? CountViewFoldersAsync() : Task.FromResult(_viewFolders);

        _overview = await overview;
        await InvokeAsync(StateHasChanged);
        if (CurrentLevel.Kind == LevelKind.Overview && configuration.ImportFolderStatus?.Configured == true)
        {
            _importWaiting = (await ApiClient.GetImportFolderWaitingAsync())?.Waiting.Sum(item => item.FileCount);
            await InvokeAsync(StateHasChanged);
        }

        _pathIssues = await issues;
        await InvokeAsync(StateHasChanged);
        _viewFolders = await viewFolders;
        await InvokeAsync(StateHasChanged);
    }

    // View keeps its folders per profile, outside the library list: the distinct folders of each View kind across every profile's
    // sources. The counts are unknown (null) when the profiles could not be read or any profile's sources could not, never a guessed zero.
    private async Task<IReadOnlyDictionary<string, int>?> CountViewFoldersAsync()
    {
        var profiles = await ApiClient.GetProfilesAsync();
        // The client answers an empty list on failure, so an empty list only counts as "no profiles" when no failure was recorded.
        if (profiles.Count == 0 && !string.IsNullOrWhiteSpace(ApiClient.LastError)) return null;
        var reviews = await Task.WhenAll(profiles.Select(profile => ApiClient.GetViewProfileSourcesAsync(profile.Id)));
        if (reviews.Any(review => review is null)) return null;
        var sources = reviews.SelectMany(review => review!.Sources).Where(source => !string.IsNullOrWhiteSpace(source.Location)).ToList();
        return Kinds.ViewKinds.ToDictionary(
            kind => kind.Key,
            kind => sources
                .Where(source => LibraryRollup.ViewFolderBelongsTo(source, kind.Key))
                .Select(source => source.Location)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count());
    }

    // The folders panel saves on its own; keep this page's copy current for the View settings and the counts.
    private async Task RefreshConfigurationAsync()
    {
        var latest = await ReadConfigurationAsync();
        if (latest is not null) _configuration = latest;
    }

    // The ordinary library list never holds Vault-protected libraries. Only for someone who may see the Vault (an unlocked administrator
    // with Vault mode on) the Engine is asked for them as well; for everyone else nothing is asked, so no trace of them reaches the page.
    private async Task<LibrariesConfigurationDto?> ReadConfigurationAsync()
    {
        var configuration = await Orchestrator.GetLibrariesAsync();
        if (configuration is null || !VaultVisible) return configuration;
        var vault = await ApiClient.GetVaultSiblingLibrariesAsync();
        if (vault is null) return configuration;
        foreach (var library in vault)
        {
            if (configuration.Libraries.All(existing => !string.Equals(existing.Id, library.Id, StringComparison.OrdinalIgnoreCase)))
            {
                configuration.Libraries.Add(library);
            }
        }

        return configuration;
    }

    // A jump from the Import folder's "Choose" arrives with ?highlight=add so Add Folder is pointed at on the type's page.
    private bool HighlightAdd => string.Equals(Query.String("highlight"), "add", StringComparison.OrdinalIgnoreCase);

    // A folder was added from the overview or a library page: its counts and status are read again.
    private async Task FolderAddedAsync()
    {
        await RefreshConfigurationAsync();
        await LoadSummaryAsync();
    }

    private Level CurrentLevel => ResolveLevel();

    private Level ResolveLevel()
    {
        var subsection = Subsection?.Trim();
        var detail = Detail?.Trim();
        if (string.IsNullOrEmpty(subsection)) return string.IsNullOrEmpty(detail) ? new Level(LevelKind.Overview) : new Level(LevelKind.NotFound);

        if (string.Equals(subsection, LibraryTypeCatalog.ViewArea, StringComparison.OrdinalIgnoreCase))
        {
            return Kinds.FindViewKind(detail) is { } viewKind ? new Level(LevelKind.ViewKind, null, viewKind.Key) : new Level(LevelKind.NotFound);
        }

        if (Guid.TryParse(subsection, out _) && string.IsNullOrEmpty(detail) && FindLibrary(subsection) is { } library
            && (LibraryListing.AccessOf(library) != LibraryListing.Vault || VaultVisible))
        {
            return new Level(LevelKind.Library, library);
        }

        return new Level(LevelKind.NotFound);
    }
}
