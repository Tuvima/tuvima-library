@namespace MediaEngine.Web.Components.Settings
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject DeviceContextService DeviceContext

@{
    var readOnly = DeviceContext.IsMobile;
    var unavailable = DeviceContext.IsTelevision;
    var section = NormalizeSection(Subsection);
}

<div class="libraries">
    @if (unavailable)
    {
        <AppPageState Kind="AppPageStateKind.Unavailable"
                      Icon="@AppMaterialIcons.Outlined.DesktopAccessDisabled"
                      Title="Library settings are unavailable"
                      Message="Use a desktop or tablet to manage library storage and intake." />
    }
    else if (_loading)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="Loading libraries" Class="py-8" />
    }
    else if (_configuration is null)
    {
        <AppPageState Kind="AppPageStateKind.Error"
                      Icon="@AppMaterialIcons.Outlined.CloudOff"
                      Title="Libraries could not be loaded"
                      Message="@(_loadError ?? "The Engine did not return library configuration.")" />
    }
    else
    {
        @if (section == "overview")
        {
        <header class="libraries-page-header"><div><h1>Libraries</h1><p>Manage the folders for each type of media in your library.</p></div>
        </header>
        }

        @* The folders panel carries its own phone note; this one covers the View settings, which are read-only on a phone too. *@
        @if (readOnly && section == "view")
        {
            <p class="libraries__mobile-note">Library storage and intake are read-only on mobile. Use a desktop or tablet to change library configuration.</p>
        }

        @if (_engineUnavailable)
        {
            <AppAlert Tone="AppUiTone.Error">
                The Engine is unavailable. Existing library values remain visible and are not replaced with sample data.
            </AppAlert>
        }
        else if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <AppAlert Tone="AppUiTone.Warning">@_loadError</AppAlert>
        }

        @if (section == "overview")
        {
            <LibraryFoldersPanel ReadOnly="@(readOnly || _engineUnavailable)" Changed="RefreshConfigurationAsync" />
            <p class="libraries__view-link"><a href="/settings/libraries/view">Personal photos &amp; videos settings</a></p>
        }
        else if (section == "view")
        {
            <ViewLibrarySettings Configuration="@_configuration" ReadOnly="@readOnly" RootChanged="LoadAsync" />
        }
    }
</div>

@code {
    [Parameter] public string? Subsection { get; set; }

    private LibrariesConfigurationDto? _configuration;
    private string? _loadError;
    private bool _loading = true;
    private bool _engineUnavailable;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _configuration = await Orchestrator.GetLibrariesAsync();
        _engineUnavailable = _configuration is null;
        if (_configuration is null) _loadError = ApiClient.LastError;
        _loading = false;
    }

    // The Libraries panel saves on its own; keep this page's copy current for the View settings.
    private async Task RefreshConfigurationAsync()
    {
        var latest = await Orchestrator.GetLibrariesAsync();
        if (latest is not null) _configuration = latest;
    }

    private static string NormalizeSection(string? section) =>
        string.Equals(section?.Trim(), "view", StringComparison.OrdinalIgnoreCase) ? "view" : "overview";
}
