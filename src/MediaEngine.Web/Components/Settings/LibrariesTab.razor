    private int? LibraryItemCount(LibraryFolderDto library)
    {
        var folders = _ingestionSnapshot?.SourceGroups
            .SelectMany(group => group.Libraries)
            .SelectMany(sourceLibrary => sourceLibrary.Folders)
            .Where(folder => library.Sources.Any(source => string.Equals(source.Path, folder.Path, StringComparison.OrdinalIgnoreCase)))
            .ToList();
        return folders is not null && folders.Count == library.Sources.Count
            ? folders.Sum(folder => folder.ItemCount) : null;
    }

