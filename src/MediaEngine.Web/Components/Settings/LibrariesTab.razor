@namespace MediaEngine.Web.Components.Settings
@using System.Text.Json
@using MediaEngine.Contracts.Artwork
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject DeviceContextService DeviceContext
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav




@{
    var readOnly = DeviceContext.IsMobile;
    var unavailable = DeviceContext.IsTelevision || DeviceContext.IsAutomotive;
    var section = NormalizeSection(Subsection);
    var activeLibrary = ResolveActiveLibrary(section);
}

<div class="libraries">
    @if (unavailable)
    {
        <AppPageState Kind="AppPageStateKind.Unavailable"
                      Icon="@Icons.Material.Outlined.DesktopAccessDisabled"
                      Title="Library settings are unavailable"
                      Message="Use a desktop or tablet to manage library storage and intake." />
    }
    else if (_loading)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="Loading libraries" Class="py-8" />
    }
    else if (_configuration is null)
    {
        <AppPageState Kind="AppPageStateKind.Error"
                      Icon="@Icons.Material.Outlined.CloudOff"
                      Title="Libraries could not be loaded"
                      Message="@(_loadError ?? "The Engine did not return library configuration.")" />
    }
    else
    {
        @if (section == "overview")
        {
        <header class="libraries-page-header"><div><h1>Libraries</h1><p>Manage structured libraries and storage roots.</p></div>
        <AppActionBar Align="AppHorizontalAlignment.End" Class="libraries__actions">
            @if (section == "overview" && !readOnly)
            {
                <AppButton Label="Add library"
                           StartIcon="@Icons.Material.Outlined.CreateNewFolder"
                           ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary"
                           Disabled="@_engineUnavailable"
                           Href="/settings/libraries/new" />
            }
        </AppActionBar>
        </header>
        }

        @if (readOnly)
        {
            <p class="libraries__mobile-note">Library storage and intake are read-only on mobile. Use a desktop or tablet to add folders or change library configuration.</p>
        }

        @if (_engineUnavailable)
        {
            <AppAlert Tone="AppUiTone.Error">
                The Engine is unavailable. Existing library values remain visible and are not replaced with sample data.
            </AppAlert>
        }
        else if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <AppAlert Tone="AppUiTone.Warning">@_loadError</AppAlert>
        }


        @if (section == "overview")
        {
            @OverviewSurface(readOnly)
        }
        else if (section == "view")
        {
            <ViewLibrarySettings Configuration="@_configuration" ReadOnly="@readOnly" RootChanged="LoadAsync" />
        }
        else if (activeLibrary is not null)
        {
            @LibraryDetailSurface(activeLibrary, readOnly)
        }
        else
        {
            <AppPageState Kind="AppPageStateKind.Error" Icon="@Icons.Material.Outlined.SearchOff" Title="Library not found" Message="This library does not exist or is no longer configured." />
        }


    }
</div>

@code {
    private sealed record OrganizationDetailOption(string Value, string Label, string Help, string Icon);

    [Parameter] public string? Subsection { get; set; }
    [Parameter] public string? Scope { get; set; }
    [Parameter] public EventCallback<string> LibraryNameChanged { get; set; }

    private LibrariesConfigurationDto? _configuration;
    private IngestionOperationsSnapshotDto? _ingestionSnapshot;
    private ViewStorageSummaryDto? _viewSummary;
    private string _baseline = string.Empty;
    private string? _loadError;
    private bool _loading = true;
    private bool _saving;
    private bool _engineUnavailable;
    private ArtworkWritebackSettingsDto? _artworkWritebackSettings;
    private bool _savingArtworkWriteback;
    private string _libraryFilter = "all";
    private readonly Dictionary<string, PathTestResultDto> _pathResults = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _selectedLibraryIds = new(StringComparer.OrdinalIgnoreCase);

    private static readonly IReadOnlyList<AppSelectOption> DuplicateOptions =
    [
        new("skip_exact", "Skip exact duplicates"),
        new("keep_both", "Keep both"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> OrganizationOptions =
    [
        new("tuvima_standard", "Tuvima Library standard"),
        new("keep_original_names", "Keep original names"),
        new("capture_year_month", "Capture year / month"),
        new("year_month_day", "Year / month / day"),
        new("keep_original_folders", "Keep original folders"),
        new("flat_folder", "Flat folder"),
        new("custom", "Custom"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> ManagementOptions =
    [
        new("managed_by_tuvima", "Managed by Tuvima Library"),
        new("existing_library", "Existing library"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> SourceRoleOptions =
    [
        new("primary_destination", "Primary destination"),
        new("secondary", "Secondary source"),
        new("intake", "Intake source"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> SourceTypeOptions =
    [
        new("local_folder", "Local folder"),
        new("network_share", "Network share"),
        new("mobile_device", "Mobile device"),
        new("connected_device", "Connected device"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> LibraryFilterOptions =
    [
        new("all", "All", Icons.Material.Outlined.Layers),
        new("read", "Read", Icons.Material.Outlined.MenuBook),
        new("watch", "Watch", Icons.Material.Outlined.LiveTv),
        new("listen", "Listen", Icons.Material.Outlined.Headphones),
        new("view", "View", Icons.Material.Outlined.PhotoLibrary),
    ];

    private static readonly OrganizationDetailOption[] OrganizationDetailOptions =
    [
        new("tuvima_standard", "Tuvima Library Standard", "Use media-aware folders and filenames for new imports.", Icons.Material.Outlined.AutoAwesome),
        new("keep_original_names", "Keep original names", "Preserve existing names and folder structure.", Icons.Material.Outlined.FolderCopy),
        new("custom", "Custom", "Use a library-specific naming template.", Icons.Material.Outlined.Tune),
    ];

    protected override async Task OnInitializedAsync()
    {
        _libraryFilter = Scope is "read" or "watch" or "listen" or "view" ? Scope : "all";
        await LoadAsync();
        _artworkWritebackSettings = await ApiClient.GetArtworkWritebackSettingsAsync();
    }

    protected override void OnParametersSet()
    {
        _libraryFilter = Scope is "read" or "watch" or "listen" or "view" ? Scope : "all";
        _ = PublishLibraryNameAsync();
    }

    private RenderFragment OverviewSurface(bool readOnly) => @<div class="libraries__overview">
        <AppSegmentedControl Value="@_libraryFilter"
                             ValueChanged="@SetLibraryFilter"
                             Options="@LibraryFilterOptions"
                             AriaLabel="Choose a media area" />

        <div class="libraries-metrics" aria-label="Library summary">
            <AppPanel Density="AppSurfaceDensity.Compact" Class="libraries-metric">
                <span class="libraries-metric__icon"><MudIcon Icon="@Icons.Material.Outlined.VideoLibrary" /></span>
                <span><small>Total libraries</small><strong>@((_configuration?.Libraries.Count(library => library.Kind == "catalogued") ?? 0) + 1)</strong><em>Across Read, Watch, Listen, and View</em></span>
            </AppPanel>
            <AppPanel Density="AppSurfaceDensity.Compact" Class="libraries-metric">
                <span class="libraries-metric__icon libraries-metric__icon--blue"><MudIcon Icon="@Icons.Material.Outlined.Folder" /></span>
                <span><small>Total folders</small><strong>@(_viewSummary is null ? "Unavailable" : ((_configuration?.Libraries.Sum(library => library.Sources.Count) ?? 0) + _viewSummary.Sources).ToString())</strong><em>Watched by their library</em></span>
            </AppPanel>
            <AppPanel Density="AppSurfaceDensity.Compact" Class="libraries-metric libraries-metric--link">
                <a href="/settings/recently-added?review=expanded" aria-label="Open items needing review"></a>
                <span class="libraries-metric__icon libraries-metric__icon--warning"><MudIcon Icon="@Icons.Material.Outlined.WarningAmber" /></span>
                <span><small>Items needing review</small><strong>@(_ingestionSnapshot?.Summary.ItemsNeedingReview.ToString() ?? "Unavailable")</strong><em>Catalogued media only</em></span>
            </AppPanel>
        </div>

        <AppCard Class="libraries-card">
            <div class="libraries-card__heading">
                <div><h3>@(_libraryFilter == "all" ? "All libraries" : $"{TitleCase(_libraryFilter)} libraries")</h3><p>Open a library to review its folders, organization rules, and health.</p></div>
            </div>
            @if (FilteredLibraries.Count == 0 && _libraryFilter != "view" && _libraryFilter != "all")
            {
                <AppPageState Kind="AppPageStateKind.Empty" Icon="@AreaIcon(_libraryFilter)" Title="No folders in this area" Message="Choose another media area or configure its first folder." />
            }
            else
            {
            <div class="libraries-table libraries-table--summary" aria-label="Configured libraries">
                <div class="libraries-table__head" ><span>Library</span><span>Area</span><span>Folders</span><span>Items</span><span>Health</span><span></span></div>
                @if (_libraryFilter is "all" or "view")
                {
                    <a class="libraries-table__row" href="/settings/libraries/view?scope=@_libraryFilter">
                        <span class="libraries-table__identity"><span class="libraries-table__media-icon is-view"><MudIcon Icon="@Icons.Material.Outlined.PhotoLibrary" Size="Size.Small" /></span><span><strong>View</strong><small>Personal photos, videos, documents, and recordings</small></span></span>
                        <AppStatusBadge Text="View" Tone="AppUiTone.Success" />
                        <span>@(_viewSummary is null ? "Unavailable" : $"{_viewSummary.Sources} {(_viewSummary.Sources == 1 ? "folder" : "folders")}")</span><span>@(_viewSummary?.Items.ToString() ?? "Unavailable")</span>
                        <AppStatusBadge Text="Not checked" Tone="AppUiTone.Neutral" />
                        <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
                    </a>
                }
                @foreach (var library in FilteredLibraries)
                {
                    <a class="libraries-table__row" href="@LibraryRoute(library)">
                        <span class="libraries-table__identity"><span class="libraries-table__media-icon @($"is-{library.Area}")"><MudIcon Icon="@LibraryIcon(library)" Size="Size.Small" /></span><span><strong>@LibraryDisplayName(library)</strong><small>@LibraryDescription(library)</small></span></span>
                        <AppStatusBadge Text="@TitleCase(library.Area)" Tone="@AreaTone(library.Area)" />
                        <span>@library.Sources.Count @(library.Sources.Count == 1 ? "folder" : "folders")</span>
                        <span>@(LibraryItemCount(library) is { } count ? DisplayFormat.FormatCount(count) : "Unavailable")</span>
                        <AppStatusBadge Text="@LibraryStatus(library)" Tone="@LibraryStatusTone(library)" />
                        <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
                    </a>
                }
            </div>
            }
        </AppCard>

        <div class="libraries__aside-grid">
            <AppPanel Density="AppSurfaceDensity.Compact" Class="libraries-info">
                <MudIcon Icon="@Icons.Material.Outlined.Shield" />
                <div><strong>Existing folders stay unchanged</strong><p>Tuvima Library can scan and index an existing library, but it never moves, renames, tags, or deletes its files.</p></div>
            </AppPanel>
        </div>
    </div>;

    private RenderFragment LibraryDetailSurface(LibraryFolderDto library, bool readOnly) => @<div class="library-detail">
        <LibraryDetailHeader Title="@library.Name" Description="@($"{TitleCase(library.Area)} library · {LibraryDescription(library)}")" Icon="@LibraryIcon(library)">
            <AppStatusBadge Text="@TitleCase(library.Area)" Tone="@AreaTone(library.Area)" />
        </LibraryDetailHeader>
        <div class="libraries-card__heading"><div><h2>Library Settings</h2><p>Manage folders, organization, and file handling for this library.</p></div><AppStatusBadge Text="@LibraryStatus(library)" Tone="@LibraryStatusTone(library)" /></div>
        <AppCard Class="libraries-card">
            <div class="libraries-card__heading"><div><h3>Folders</h3><p>Folders define where media is watched and where new managed imports can be organized.</p></div>
                <AppButton Label="Add folder" StartIcon="@Icons.Material.Outlined.Add" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(readOnly || _engineUnavailable || _saving)" OnClick="@(() => AddAndBrowseLibrarySourceAsync(library))" />
            </div>
            @if (_saving) { <p role="status">Saving…</p> }
            @if (library.Sources.Count == 0) { <p>No folders configured. Add a folder to enable intake.</p> }
            <div class="library-detail__folder-table">
                <div class="library-detail__folder-head" aria-hidden="true"><span>Folder</span><span>Role</span><span>Management</span><span>Subfolders</span><span>Access</span><span>Status</span><span>Actions</span></div>
                @foreach (var source in library.Sources)
                {
                    <div class="library-detail__folder-editor" @key="source.Id">
                        <div class="library-detail__folder-path"><MudIcon Icon="@Icons.Material.Outlined.Folder" /><span><strong>@SourceFriendlyName(source)</strong><code>@source.Path</code></span></div>
                        <AppSelect Label="Role" Value="@source.Role" Options="@SourceRoleOptions" ValueChanged="@((string? value) => EditAsync(library, () => SetSourceRole(library, source, value)))" Disabled="@(readOnly || _engineUnavailable || _saving)" />
                        <AppSelect Label="Management" Value="@source.ManagementMode" Options="@ManagementOptions" ValueChanged="@((string? value) => EditAsync(library, () => SetManagementMode(library, source, value)))" Disabled="@(readOnly || _engineUnavailable || _saving)" />
                        <AppSwitchRow Label="Include subfolders" Value="@source.IncludeSubdirectories" ValueChanged="@((bool value) => EditAsync(library, () => source.IncludeSubdirectories = value))" Disabled="@(readOnly || _engineUnavailable || _saving)" />
                        <span>@SourceAccess(source)</span>
                        <AppStatusBadge Text="@SourceStatus(source)" Tone="@SourceTone(source)" />
                        <div class="library-detail__folder-actions">
                            <AppIconButton Icon="@Icons.Material.Outlined.FolderOpen" Tooltip="Change path" AriaLabel="@($"Change folder path for {SourceFriendlyName(source)}")" Disabled="@(readOnly || _engineUnavailable || _saving)" OnClick="@(() => BrowseLibrarySourceAsync(library, source))" />
                            <AppIconButton Icon="@Icons.Material.Outlined.Refresh" Tooltip="Test path" AriaLabel="@($"Test folder path for {SourceFriendlyName(source)}")" Disabled="@(_engineUnavailable || _saving)" OnClick="@(() => CheckPathAsync(source.Path))" />
                            <AppIconButton Icon="@Icons.Material.Outlined.Delete" Tooltip="Detach folder; keep files" AriaLabel="@($"Remove folder {SourceFriendlyName(source)}")" Disabled="@(readOnly || _engineUnavailable || _saving )" OnClick="@(() => RemoveLibrarySource(library, source))" />
                        </div>
                    </div>
                }
            </div>
            <p class="library-detail__note">Removing a folder detaches it from this library; its files stay on disk. Existing Library sources always remain read-only.</p>
        </AppCard>
        <AppCard Class="libraries-card">
            <div class="libraries-card__heading"><div><h3>Organization</h3><p>Choose how new media should be named and placed.</p></div></div>
            <div class="library-detail__organization-options" role="radiogroup" aria-label="Organization mode">
                @foreach (var option in OrganizationDetailOptions)
                {
                    <AppNativeButton Type="button" role="radio" aria-checked="@(library.OrganizationPolicy.Mode == option.Value ? "true" : "false")" Disabled="@(readOnly || _engineUnavailable || _saving)" Class="@($"library-detail__organization-option {(library.OrganizationPolicy.Mode == option.Value ? "is-active" : null)}")" OnClick="@(() => ChooseOrganizationAsync(library, option.Value))">
                        <MudIcon Icon="@option.Icon" /><span><strong>@option.Label</strong><small>@option.Help</small></span><MudIcon Icon="@(library.OrganizationPolicy.Mode == option.Value ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Outlined.RadioButtonUnchecked)" />
                    </AppNativeButton>
                }
            </div>
            @if (library.OrganizationPolicy.Mode == "custom")
            {
                <AppButton Label="Edit template" Disabled="@(readOnly || _engineUnavailable || _saving)" OnClick="@(() => ChooseOrganizationAsync(library, "custom"))" />
            }
            <div class="libraries-example"><span>Example</span><code>@OrganizationExample(library)</code></div>
            <AppAlert Tone="AppUiTone.Info">Changing organization rules does not alter existing files automatically. Preview any reorganization before applying filesystem changes.</AppAlert>
        </AppCard>
        <AppCard Class="libraries-card">
            <div class="libraries-card__heading"><div><h3>File Handling</h3><p>Control how Tuvima Library handles existing files and common scenarios.</p></div></div>
            <div class="library-detail__policies">
                <AppSwitchRow Label="Protect existing files" Description="Keep media already in library folders unchanged. New imports can still enter the managed destination." Value="@library.OrganizationPolicy.PreserveOriginals" ValueChanged="@((bool value) => EditAsync(library, () => library.OrganizationPolicy.PreserveOriginals = value))" Disabled="@(readOnly || _engineUnavailable || _saving)" />
                <div class="library-detail__policy-row"><div><strong>When a duplicate is found</strong><small>Exact duplicate content is indexed once.</small></div><AppSelect Label="Duplicate handling" Value="@library.DuplicatePolicy" Options="@DuplicateOptions" ValueChanged="@((string? value) => EditAsync(library, () => library.DuplicatePolicy = value ?? "skip_exact"))" Disabled="@(readOnly || _engineUnavailable || _saving)" /></div>
                <div class="library-detail__policy-row"><div><strong>When a filename already exists</strong><small>The existing file is never overwritten.</small></div><span>Give the incoming file a unique name</span></div>
                <div class="library-detail__policy-row"><div><strong>Metadata writeback</strong><small>Applied per managed folder; protection still takes precedence.</small></div><span>@WritebackState(library)</span></div>
                <AppSwitchRow Label="Embed artwork in supported media files" Description="When metadata writeback is enabled, preferred artwork is embedded only in supported, writable media files." Value="@(_artworkWritebackSettings?.ArtworkEnabled ?? false)" ValueChanged="SetArtworkWritebackAsync" Disabled="@(readOnly || _engineUnavailable || _saving || _savingArtworkWriteback || !(_artworkWritebackSettings?.MetadataWritebackEnabled ?? false))" />
                <details><summary>Folder writeback settings</summary>
                    @foreach (var source in library.Sources)
                    {
                        <div class="library-detail__policy-row"><strong>@SourceFriendlyName(source)</strong><AppSelect Label="Metadata writeback" Value="@WritebackValue(source)" Options="@WritebackOptions" ValueChanged="@((string? value) => EditAsync(library, () => SetWriteback(source, value)))" Disabled="@(readOnly || _engineUnavailable || _saving || source.ManagementMode == "existing_library")" /></div>
                    }
                </details>
            </div>
        </AppCard>
        <details class="library-detail__advanced">
            <summary><strong>Advanced Settings</strong><span>Library identity and metadata policy</span></summary>
            <div class="libraries-form-grid">
                <div><strong>Library name</strong><p>@library.Name</p><AppButton Label="Edit name" Disabled="@(readOnly || _engineUnavailable || _saving)" OnClick="@(() => RenameAsync(library))" /></div>
                <div><strong>Visibility</strong><p>@TitleCase(library.Visibility)</p></div>
                <div><strong>Library kind</strong><p>Catalogued</p></div>
                <div><strong>Library ID</strong><code>@library.Id</code></div>
                <div><strong>Metadata</strong><p>@PolicyLabel(library.MetadataPolicy)</p><a href="@MetadataSettingsRoute(library)">Manage media-type metadata settings</a></div>
            </div>
        </details>
    </div>;

    private static string MetadataSettingsRoute(LibraryFolderDto library) => "/settings/metadata/ingestion-flow";

    private async Task SetArtworkWritebackAsync(bool enabled)
    {
        _savingArtworkWriteback = true;
        try
        {
            var updated = await ApiClient.UpdateArtworkWritebackSettingsAsync(new UpdateArtworkWritebackSettingsDto(enabled));
            if (updated is null) { Snackbar.Add("Artwork writeback setting could not be saved.", Severity.Error); return; }
            _artworkWritebackSettings = updated;
        }
        finally { _savingArtworkWriteback = false; }
    }

    private IReadOnlyList<LibraryFolderDto> FilteredLibraries => _configuration?.Libraries
        .Where(library => !string.Equals(library.Kind, "personal", StringComparison.OrdinalIgnoreCase))
        .Where(library => _libraryFilter == "all" || string.Equals(library.Area, _libraryFilter, StringComparison.OrdinalIgnoreCase))
        .OrderBy(library => library.Area)
        .ThenBy(library => library.Name)
        .ToList() ?? [];

    private IReadOnlyList<AppSelectOption> ViewStorageLocationOptions => _configuration?.StorageLocations
        .Where(location => location.AllowWrite)
        .Select(location => new AppSelectOption(location.Id, location.Label))
        .ToList() ?? [];

    private string ViewRootPreview
    {
        get
        {
            if (_configuration is null) return "View";
            var location = _configuration.StorageLocations.FirstOrDefault(candidate =>
                string.Equals(candidate.Id, _configuration.ViewStorage.StorageLocationId, StringComparison.OrdinalIgnoreCase));
            return location is null
                ? _configuration.ViewStorage.RelativeRoot
                : Path.Combine(location.Path, _configuration.ViewStorage.RelativeRoot);
        }
    }

    private LibraryFolderDto? ActiveFilteredLibrary
    {
        get
        {
            var libraries = FilteredLibraries;
            if (libraries.Count == 0) return null;
            var selectedId = _selectedLibraryIds.GetValueOrDefault(_libraryFilter);
            return libraries.FirstOrDefault(library => library.Id == selectedId) ?? libraries[0];
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var configurationTask = Orchestrator.GetLibrariesAsync();
            var ingestionTask = ApiClient.GetIngestionOperationsSnapshotAsync();
            var viewTask = ApiClient.GetViewStorageSummaryAsync();

            _configuration = await configurationTask;

            _engineUnavailable = _configuration is null;
            if (_configuration is null)
                _loadError = ApiClient.LastError;
            else
            {
                _baseline = JsonSerializer.Serialize(_configuration);
                _loading = false;
                await PublishLibraryNameAsync();
                await InvokeAsync(StateHasChanged);
                _viewSummary = await viewTask;
                _ingestionSnapshot = await ingestionTask;
                await RefreshPathStatusesAsync();
                await PublishLibraryNameAsync();
            }
        }
        catch (Exception ex)
        {
            _configuration = null;
            _engineUnavailable = true;
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
    }

    private async Task<string?> EditTextAsync(string label, string value)
    {
        var dialog = await DialogService.ShowAsync<LibraryTextEditDialog>(string.Empty, new DialogParameters<LibraryTextEditDialog>
        {
            { x => x.Label, label }, { x => x.Value, value },
        }, new DialogOptions { NoHeader = true, FullWidth = true, MaxWidth = MaxWidth.Small });
        return await dialog.Result is { Canceled: false, Data: string result } ? result : null;
    }
    private async Task RenameAsync(LibraryFolderDto library)
    {
        var value = await EditTextAsync("Library name", library.Name);
        if (value is not null) await EditAsync(library, () => library.Name = value);
    }
    private async Task ChooseOrganizationAsync(LibraryFolderDto library, string mode)
    {
        var template = mode == "custom" ? await EditTextAsync("Naming template", library.OrganizationPolicy.CustomTemplate ?? "{Title} ({Year})/{Title}.{Extension}") : null;
        if (mode == "custom" && template is null) return;
        await EditAsync(library, () => { library.OrganizationPolicy.Mode = mode; library.OrganizationPolicy.CustomTemplate = template; });
    }

    private async Task EditAsync(LibraryFolderDto library, Action change)
    {
        if (_saving) return;
        change();
        // Custom naming is a coupled edit: keep the choice in the editor until Apply.
        if (library.OrganizationPolicy.Mode == "custom" && string.IsNullOrWhiteSpace(library.OrganizationPolicy.CustomTemplate)) return;
        await SaveLibraryAsync(library);
    }

    private async Task SaveLibraryAsync(LibraryFolderDto library)
    {
        if (_configuration is null || _saving) return;
        var baseline = JsonSerializer.Deserialize<LibrariesConfigurationDto>(_baseline)!;
        _saving = true;
        try
        {
            var saved = await ApiClient.MutateLibraryAsync(new LibraryMutationRequest
            {
                Library = library,
                ExpectedLibrary = baseline.Libraries.FirstOrDefault(x => x.Id == library.Id),
            });
            if (saved is null)
            {
                _configuration = baseline;
                Snackbar.Add(ApiClient.LastError ?? "Changes could not be saved. Reload and try again.", Severity.Error);
                return;
            }
            _configuration = saved;
            _baseline = JsonSerializer.Serialize(saved);
            await PublishLibraryNameAsync();
            Snackbar.Add("Saved.", Severity.Success);
        }
        finally { _saving = false; }
    }

    private async Task AddAndBrowseLibrarySourceAsync(LibraryFolderDto library)
    {
        var source = new LibrarySourceDto
        {
            Id = Guid.NewGuid().ToString("D"),
            Role = "secondary",
            ManagementMode = "existing_library",
            SourceType = "local_folder",
            AccessMode = "read_only",
            IncludeSubdirectories = true,
            IntakeRole = "none",
        };
        library.Sources.Add(source);
        await BrowseLibrarySourceAsync(library, source);
        if (string.IsNullOrWhiteSpace(source.Path)) library.Sources.Remove(source);
    }

    private async Task RemoveLibrarySource(LibraryFolderDto library, LibrarySourceDto source)
    {
        string? replacement = null;
        var alternatives = library.Sources.Where(x => x != source && x.ManagementMode == "managed_by_tuvima").ToList();
        if (library.PrimaryDestinationSourceId == source.Id && alternatives.Count > 0)
        {
            var dialog = await DialogService.ShowAsync<DetachLibraryFolderDialog>(string.Empty, new DialogParameters<DetachLibraryFolderDialog>
            {
                { x => x.FolderPath, source.Path },
                { x => x.Replacements, alternatives.Select(x => new AppSelectOption(x.Id, SourceFriendlyName(x))).ToList() },
            }, new DialogOptions { NoHeader = true, FullWidth = true, MaxWidth = MaxWidth.Small });
            if (await dialog.Result is not { Canceled: false, Data: string chosen }) return;
            replacement = chosen;
        }
        else if (await DialogService.ShowMessageBoxAsync("Detach folder?", $"Remove {source.Path} from {library.Name}? Files remain on disk.", yesText: "Detach folder", cancelText: "Cancel") != true) return;
        library.Sources.Remove(source);
        if (library.PrimaryDestinationSourceId == source.Id) library.PrimaryDestinationSourceId = null;
        if (replacement is not null) SetSourceRole(library, library.Sources.Single(x => x.Id == replacement), "primary_destination");
        await SaveLibraryAsync(library);
    }

    private static void SetSourceRole(LibraryFolderDto library, LibrarySourceDto source, string? role)
    {
        source.Role = role ?? "secondary";
        if (source.Role == "primary_destination")
        {
            foreach (var other in library.Sources.Where(other => other != source && other.Role == "primary_destination")) other.Role = "secondary";
            source.ManagementMode = "managed_by_tuvima";
            source.AccessMode = "writable";
            source.ParticipatesInOrganization = true;
            library.PrimaryDestinationSourceId = source.Id;
        }
        else if (library.PrimaryDestinationSourceId == source.Id)
        {
            library.PrimaryDestinationSourceId = null;
        }
    }

    private static void SetManagementMode(LibraryFolderDto library, LibrarySourceDto source, string? mode)
    {
        source.ManagementMode = mode ?? "existing_library";
        if (source.ManagementMode == "existing_library")
        {
            source.AccessMode = "read_only";
            source.ParticipatesInOrganization = false;
            source.WritebackOverride = false;
            if (source.Role == "primary_destination")
            {
                source.Role = "secondary";
                library.PrimaryDestinationSourceId = null;
            }
        }
        else
        {
            source.AccessMode = "writable";
            source.ParticipatesInOrganization = true;
            source.WritebackOverride = null;
            if (library.PrimaryDestinationSourceId is null)
                SetSourceRole(library, source, "primary_destination");
        }
    }

    private async Task CheckLibraryPathsAsync(LibraryFolderDto library)
    {
        foreach (var source in library.Sources) await CheckPathAsync(source.Path);
    }

    private async Task CheckPathAsync(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return;
        var result = await Orchestrator.TestPathAsync(path);
        if (result is not null) _pathResults[path] = result;
    }

    private async Task RefreshPathStatusesAsync()
    {
        if (_configuration is null)
            return;

        var paths = _configuration.Libraries
            .SelectMany(library => library.Sources)
            .Select(source => source.Path)
            .Where(path => !string.IsNullOrWhiteSpace(path))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        using var gate = new SemaphoreSlim(4);
        var checks = paths.Select(async path =>
        {
            await gate.WaitAsync();
            try
            {
                return (Path: path, Result: await Orchestrator.TestPathAsync(path));
            }
            finally
            {
                gate.Release();
            }
        }).ToList();
        foreach (var check in await Task.WhenAll(checks))
            if (check.Result is not null)
                _pathResults[check.Path] = check.Result;
    }

    private async Task BrowseLibrarySourceAsync(LibraryFolderDto library, LibrarySourceDto source)
    {
        var selectionMode = source.ManagementMode == "managed_by_tuvima"
            ? ServerFolderSelectionModes.ManagedLibrary
            : ServerFolderSelectionModes.ExistingLibrary;
        var selected = await BrowseForPathAsync(
            source.Path,
            selectionMode,
            source.Id,
            "Choose a server folder to attach to this library.");
        if (selected is null) return;
        source.Path = selected;
        await CheckPathAsync(selected);
        await SaveLibraryAsync(library);
    }

    private async Task<string?> BrowseForPathAsync(
        string currentPath,
        string selectionMode,
        string? currentSourceId,
        string helpText)
    {
        var parameters = new DialogParameters<ServerFolderPicker>
        {
            { component => component.InitialPath, currentPath },
            { component => component.SelectionMode, selectionMode },
            { component => component.CurrentSourceId, currentSourceId },
            { component => component.HelpText, helpText },
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraExtraLarge,
            FullWidth = false,
            CloseButton = false,
            CloseOnEscapeKey = true,
        };
        var dialog = await DialogService.ShowAsync<ServerFolderPicker>(string.Empty, parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: ServerFolderValidationResultDto selection }
            ? selection.Path
            : null;
    }

    private string LibraryRoute(LibraryFolderDto library) => $"/settings/libraries/{library.Id}" + (_libraryFilter == "all" ? "" : $"?scope={_libraryFilter}");

    private void OpenLibrary(LibraryFolderDto library)
    {
        _selectedLibraryIds[library.Area] = library.Id;
        _selectedLibraryIds["all"] = library.Id;
        _libraryFilter = library.Area;
        Nav.NavigateTo($"/settings/libraries/{library.Id}");
    }

    private void SelectLibrary(string section, string id) => _selectedLibraryIds[section] = id;

    private void SetLibraryFilter(string? value)
    {
        _libraryFilter = value is "read" or "watch" or "listen" or "view" ? value : "all";
        Nav.NavigateTo(_libraryFilter == "all" ? "/settings/libraries" : $"/settings/libraries?scope={_libraryFilter}");
        var libraries = FilteredLibraries;
        if (libraries.Count > 0
            && (!_selectedLibraryIds.TryGetValue(_libraryFilter, out var id) || libraries.All(library => library.Id != id)))
        {
            _selectedLibraryIds[_libraryFilter] = libraries[0].Id;
        }
    }

    private LibraryFolderDto? ActiveLibrary(string section)
    {
        var libraries = LibrariesFor(section);
        if (libraries.Count == 0) return null;
        EnsureSelection(section);
        return libraries.FirstOrDefault(library => _selectedLibraryIds.GetValueOrDefault(section) == library.Id) ?? libraries[0];
    }

    private IReadOnlyList<LibraryFolderDto> LibrariesFor(string section) => _configuration?.Libraries
        .Where(library => string.Equals(library.Area, section, StringComparison.OrdinalIgnoreCase))
        .OrderBy(library => library.Name).ToList() ?? [];

    private void EnsureSelection(string section)
    {
        if (_configuration is null || section == "overview") return;
        var libraries = LibrariesFor(section);
        if (libraries.Count == 0) return;
        if (!_selectedLibraryIds.TryGetValue(section, out var id) || libraries.All(library => library.Id != id))
            _selectedLibraryIds[section] = libraries[0].Id;
    }

    private string PathStatus(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "Missing path";
        if (!_pathResults.TryGetValue(path, out var result)) return "Not checked";
        if (!result.Exists) return "Source unavailable";
        if (!result.HasRead) return "Permission issue";
        if (!result.HasWrite) return "Read-only";
        return "Healthy";
    }

    private static string FormatRelative(DateTimeOffset value)
    {
        var elapsed = DateTimeOffset.UtcNow - value.ToUniversalTime();
        return elapsed.TotalMinutes switch
        {
            < 1 => "just now",
            < 60 => $"{(int)elapsed.TotalMinutes}m ago",
            < 1440 => $"{(int)elapsed.TotalHours}h ago",
            _ => $"{(int)elapsed.TotalDays}d ago",
        };
    }

    private AppUiTone PathTone(string path) => PathStatus(path) switch
    {
        "Healthy" => AppUiTone.Success,
        "Not checked" => AppUiTone.Neutral,
        "Read-only" => AppUiTone.Warning,
        _ => AppUiTone.Error,
    };

    private string? _publishedLibraryName;
    private Task PublishLibraryNameAsync()
    {
        if (NormalizeSection(Subsection) == "overview") return Task.CompletedTask;
        var name = NormalizeSection(Subsection) == "view" ? "View" : _loading ? "Library" : ResolveActiveLibrary(NormalizeSection(Subsection))?.Name ?? "Library unavailable";
        if (name == _publishedLibraryName) return Task.CompletedTask;
        _publishedLibraryName = name;
        return LibraryNameChanged.InvokeAsync(name);
    }
    private string SourceStatus(LibrarySourceDto source)
    {
        var status = PathStatus(source.Path);
        return status == "Read-only" && source.ManagementMode == "existing_library" ? "Healthy" : status;
    }
    private AppUiTone SourceTone(LibrarySourceDto source) => SourceStatus(source) == "Healthy" ? AppUiTone.Success : PathTone(source.Path);
    private string SourceAccess(LibrarySourceDto source) => _pathResults.TryGetValue(source.Path, out var result)
        ? !result.HasRead ? "No read access" : result.HasWrite ? "Read / Write" : "Read-only" : "Not checked";
    private string WritebackState(LibraryFolderDto library)
    {
        var values = library.Sources.Where(source => source.ManagementMode == "managed_by_tuvima").Select(source => source.WritebackOverride).Distinct().ToList();
        return values.Count > 1 ? "Mixed — set per folder" : values.Count == 0 ? "Off — read-only sources" : values[0] is null ? "Inherited — set per folder" : values[0] == true ? "On for eligible files" : "Off";
    }
    private static readonly IReadOnlyList<AppSelectOption> WritebackOptions = [new("inherit", "Use global setting"), new("off", "Off"), new("on", "On")];
    private static string WritebackValue(LibrarySourceDto source) => source.WritebackOverride is null ? "inherit" : source.WritebackOverride == true ? "on" : "off";
    private static void SetWriteback(LibrarySourceDto source, string? value) => source.WritebackOverride = value == "inherit" ? null : value == "on";

    private string LibraryStatus(LibraryFolderDto library)
    {
        if (library.Sources.Count == 0) return "No sources";
        var statuses = library.Sources.Select(SourceStatus).ToList();
        if (statuses.Any(status => status is "Missing path" or "Source unavailable" or "Permission issue")) return "Needs attention";
        if (statuses.All(status => status == "Healthy")) return "Healthy";
        if (statuses.Any(status => status == "Read-only")) return "Read-only";
        return "Not checked";
    }

    private AppUiTone LibraryStatusTone(LibraryFolderDto library) => LibraryStatus(library) switch
    {
        "Healthy" => AppUiTone.Success,
        "Read-only" => AppUiTone.Info,
        "Not checked" => AppUiTone.Neutral,
        _ => AppUiTone.Warning,
    };

    private LibraryFolderDto? ResolveActiveLibrary(string section)
    {
        if (_configuration is null) return null;
        if (Guid.TryParse(section, out var id))
            return _configuration.Libraries.FirstOrDefault(library => Guid.TryParse(library.Id, out var libraryId) && libraryId == id);
        return section == "overview" ? null : ActiveLibrary(section);
    }

    private static string NormalizeSection(string? section)
    {
        var normalized = section?.Trim().ToLowerInvariant();
        if (Guid.TryParse(normalized, out _)) return normalized!;
        return normalized switch
        {
            "libraries" => "libraries", "view" => "view", _ => "overview",
        };
    }

