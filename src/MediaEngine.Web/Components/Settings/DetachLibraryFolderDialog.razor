@namespace MediaEngine.Web.Components.Settings
<AppDialogShell Title="Detach folder?" Size="Medium" OnClose="@(() => Dialog.Cancel())">
    <ChildContent>
        <p>Detach @FolderPath? Its files remain on disk.</p>
        <p>This is the primary destination. Choose the managed folder that should receive new imports.</p>
        <AppSelect Label="Replacement primary destination" Value="@_replacement" ValueChanged="@((string? value) => _replacement = value)" Options="@Replacements" />
    </ChildContent>
    <FooterContent>
        <AppButton Label="Cancel" ButtonStyle="AppButtonStyle.Text" OnClick="@(() => Dialog.Cancel())" />
        <AppButton Label="Detach folder" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@string.IsNullOrWhiteSpace(_replacement)" OnClick="@(() => Dialog.Close(AppDialogResult.Ok(_replacement)))" />
    </FooterContent>
</AppDialogShell>
@code {
    [CascadingParameter] private IAppDialogContext Dialog { get; set; } = default!;
    [Parameter] public string FolderPath { get; set; } = "";
    [Parameter] public IReadOnlyList<AppSelectOption> Replacements { get; set; } = [];
    private string? _replacement;
}
