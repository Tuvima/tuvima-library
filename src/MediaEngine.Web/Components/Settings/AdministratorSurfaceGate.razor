@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Services.Integration
@inject DashboardSessionAccessor Session
@inject DashboardIdentityClient Identity
@implements IDisposable

@if (!Required)
{
    @ChildContent
}
else if (Session.Authority?.EffectiveAdministrator != true)
{
    <AppAlert Severity="AppSeverity.Warning">Administrator access could not be verified. Refresh your session to continue.</AppAlert>
}
else if (Session.Authority.AdministratorSurfaceUnlocked)
{
    @if (Session.HasAction("administrator.lock"))
    {
        <div class="administrator-protection">
            <span>Administrator settings are unlocked.</span>
            <AppButton Label="Lock settings" StartIcon="@AppMaterialIcons.Outlined.Lock" Disabled="@_busy" OnClick="LockAsync" />
        </div>
    }
    @ChildContent
}
else
{
    <SettingsSectionPanel Title="Administrator settings are locked" Description="Enter the PIN for this account and profile to continue." Icon="@AppMaterialIcons.Outlined.Lock">
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <AppAlert Severity="AppSeverity.Error">@_error</AppAlert>
        }
        <div class="administrator-protection administrator-protection--entry">
            <AppTextField Label="Administrator PIN" InputType="AppInputType.Password" InputMode="AppInputMode.numeric" Value="@_pin" ValueChanged="@(value => _pin = value ?? string.Empty)" aria-label="Administrator PIN" autocomplete="off" MaxLength="12" Disabled="@_busy" />
            <AppButton Label="Unlock settings" StartIcon="@AppMaterialIcons.Outlined.LockOpen" Disabled="@(_busy || !ValidPin)" OnClick="UnlockAsync" />
        </div>
    </SettingsSectionPanel>
}

@code {
    [Parameter] public bool Required { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string _pin = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _disposed;
    private bool ValidPin => _pin.Length is >= 4 and <= 12 && _pin.All(char.IsAsciiDigit);

    protected override void OnInitialized() => Session.OnAuthorityChanged += OnAuthorityChanged;

    private async Task UnlockAsync()
    {
        if (_busy || !ValidPin) return;
        _busy = true;
        _error = null;
        var pin = _pin;
        _pin = string.Empty;
        try
        {
            var result = await Identity.UnlockAdministratorAsync(new(pin));
            await Identity.RevalidateAuthorityAsync(Session);
            if (result?.Unlocked != true || Session.Authority?.AdministratorSurfaceUnlocked != true)
                _error = "The PIN could not be verified. Check the PIN and try again.";
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _error = "The Engine is unavailable. Your settings remain locked; try again.";
        }
        finally { _busy = false; }
    }

    private async Task LockAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        Session.ClearAdministratorActions();
        try
        {
            if (!await Identity.ExitAdministratorAsync())
                _error = "The Engine could not confirm the lock. Keep this page closed and retry when it is available.";
            else
                await Identity.RevalidateAuthorityAsync(Session);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _error = "The Engine could not confirm the lock. Retry when it is available.";
        }
        finally { _busy = false; }
    }

    private void OnAuthorityChanged()
    {
        _pin = string.Empty;
        if (!_disposed) _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _disposed = true;
        _pin = string.Empty;
        Session.OnAuthorityChanged -= OnAuthorityChanged;
    }
}
