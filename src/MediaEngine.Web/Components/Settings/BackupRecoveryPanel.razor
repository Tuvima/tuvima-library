@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.System
@using Microsoft.JSInterop
@inject IEngineApiClient ApiClient
@inject IJSRuntime JS
@inject IAppToastService Snackbar
@inject DeviceContextService DeviceContext
@inject IStringLocalizer<SharedStrings> L

<div class="backup-page">
    <div class="backup-page__toolbar">
        <AppButton Label="@L["Ingestion_Refresh"].Value" StartIcon="@AppMaterialIcons.Outlined.Refresh" Disabled="@(_busy || _loading)" OnClick="LoadAsync" />
    </div>

    @if (_loading)
    {
        <AppPageState Kind="AppPageStateKind.Loading"
                      Title="@L["BackupRecoveryPanel_LoadingRecoveryPoints"].Value"
                      Message="@L["BackupRecoveryPanel_CheckingBackupStorageAndRecent"].Value" />
    }
    else
    {
        @if (DataStoreVersionLine is { } versionLine)
        {
            <AppText Class="tl-u-color-tl-text-muted" data-testid="data-store-version">@versionLine</AppText>
        }

        <AppCard Title="@L["BackupRecoveryPanel_BackupStatus"].Value" Class="backup-status">
            @if (LatestBackup is null)
            {
                @if (RestoreSummaryLine is { } emptyRestoreSummary)
                {
                    <p class="backup-status__mobile-note" data-testid="restore-summary">@emptyRestoreSummary</p>
                }
                <div class="backup-status__empty"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Inventory2" /><span><strong>@L["BackupRecoveryPanel_NoRecoveryPointsYet"]</strong><small>@L["BackupRecoveryPanel_CreateABackupBeforeSignificant"]</small></span></div>
            }
            else
            {
                <div class="backup-status__facts">
                    <div><small>@L["BackupRecoveryPanel_LatestBackup"]</small><strong>@LatestBackup.CreatedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</strong></div>
                    <div><small>@L["BackupRecoveryPanel_BackupSize"]</small><strong>@FormatBytes(LatestBackup.SizeBytes)</strong></div>
                    <div><small>@L["BackupRecoveryPanel_RecoveryPoints"]</small><strong>@_backups.Count</strong></div>
                </div>
                @if (RestoreSummaryLine is { } restoreSummary)
                {
                    <p class="backup-status__mobile-note" data-testid="restore-summary">@restoreSummary</p>
                }
                @if (DeviceContext.IsMobile)
                {
                    <p class="backup-status__mobile-note">@L["BackupRecoveryPanel_CreatingDownloadingTestingAndRestoring"]</p>
                }
            }
        </AppCard>

        @if (_lastValidation is { Valid: false })
        {
            <AppAlert Tone="AppUiTone.Error" Class="backup-validation-result">
                <div><strong>@L["BackupRecoveryPanel_RestoreTestFailed"]</strong></div>
                <div data-testid="restore-error">@_lastValidation.Message</div>
                <div><small>Tested @_lastValidation.ValidatedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt").</small></div>
            </AppAlert>
        }
        else if (_lastValidation is { Valid: true, Contents: { } firstLook })
        {
            <AppAlert Tone="AppUiTone.Success" Class="backup-validation-result" data-testid="restore-first-look">
                <div><strong>@L["BackupRecoveryPanel_RestoreTestPassed"]</strong></div>
                <BackupContentsSummary Contents="firstLook" />
            </AppAlert>
        }

        @if (!DeviceContext.IsMobile)
        {
        <div class="backup-actions-grid">
            <AppCard Title="@L["BackupRecoveryPanel_CreateBackup"].Value" Class="backup-action-card">
                <AppButton Label="@L["BackupRecoveryPanel_CreateBackup"].Value" StartIcon="@AppMaterialIcons.Outlined.Backup" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@_busy" Loading="@_busy" OnClick="CreateAsync" />
                @if (_lastCreated is { } created)
                {
                    <p data-testid="backup-created">@L["BackupRecoveryPanel_BackupCreated"] <strong>@created.FileName</strong>, @FormatBytes(created.SizeBytes).</p>
                }
                <p data-testid="backup-note">@L["BackupRecoveryPanel_BackupsHoldYourSettingsAnd"]</p>
                <p data-testid="backup-keep-safe">@L["BackupRecoveryPanel_AnyoneWithThisFileCan"]</p>
                @if (_state is { FileOnlyTitles: > 0 } fileOnly)
                {
                    <AppAlert Tone="AppUiTone.Warning" data-testid="file-only-warning">@FileOnlyLine(fileOnly.FileOnlyTitles)</AppAlert>
                }
            </AppCard>

            <AppCard Title="@L["Common_Restore"].Value" Class="backup-action-card">
                <p>The Engine validates and stages your chosen recovery point. Restart the Engine to apply it; the current database remains available as a recovery copy.</p>
                @if (_backups.Count == 0)
                {
                    <AppButton Label="@L["BackupRecoveryPanel_NoBackupsAvailable"].Value" Disabled="true" />
                }
                else
                {
                    <div class="backup-list" aria-label="@L["BackupRecoveryPanel_AvailableRecoveryPoints"].Value">
                        @foreach (var backup in _backups)
                        {
                            <div class="backup-list__row">
                                <div class="backup-list__identity"><strong>@backup.CreatedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</strong><small>@FormatBytes(backup.SizeBytes)</small></div>
                                <div class="backup-list__actions">
                                    <AppButton Label="@L["Models_Download"].Value" ButtonStyle="AppButtonStyle.Text" StartIcon="@AppMaterialIcons.Outlined.Download" Disabled="@_busy" OnClick="@(() => DownloadAsync(backup))" />
                                    <AppButton Label="@L["BackupRecoveryPanel_TestRestore"].Value" ButtonStyle="AppButtonStyle.Text" StartIcon="@AppMaterialIcons.Outlined.FactCheck" Disabled="@_busy" OnClick="@(() => ValidateAsync(backup))" />
                                    <AppButton Label="@L["Common_Restore"].Value" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Warning" StartIcon="@AppMaterialIcons.Outlined.Restore" Disabled="@_busy" OnClick="@(() => OpenRestoreDialog(backup))" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </AppCard>
        </div>

        @if (_state is { } state)
        {
            <AppCard Title="@L["BackupRecoveryPanel_RestoredProgress"].Value" Class="backup-action-card">
                <AppSelect @key="_waitingPeriodRenderKey" Native="true" Label="@L["BackupRecoveryPanel_KeepRestoredProgressWaitingFor"].Value" Value="@state.WaitingPeriodDays.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           Options="@WaitingPeriodOptions(state.WaitingPeriodDays)" Disabled="@_busy" ValueChanged="SetWaitingPeriodAsync" data-testid="waiting-period" />
            </AppCard>
        }

        <BackupDestinationsSection />

        <AppCard>
        <details class="backup-advanced">
            <summary>@L["BackupRecoveryPanel_Advanced"]</summary>
            <div class="backup-advanced__content">
                <div><span>@L["BackupRecoveryPanel_StoredContent"]</span><strong>@L["BackupRecoveryPanel_SettingsAndYourOwnProgress"]</strong></div>
                <div><span>@L["BackupRecoveryPanel_TotalArchiveSize"]</span><strong>@FormatBytes(_backups.Sum(item => item.SizeBytes))</strong></div>
                <p>@L["BackupRecoveryPanel_BackupLocationAndRetentionAre"]</p>
            </div>
        </details>
        </AppCard>
        }
    }

    @if (!string.IsNullOrWhiteSpace(_notice))
    {
        <AppAlert Severity="@(_restartRequired ? AppSeverity.Warning : AppSeverity.Info)"
                  Variant="AppVariant.Outlined"
                  Dense="true">
            @_notice
        </AppAlert>
    }
</div>

<AppDialog @bind-Visible="_restoreDialogOpen"
           Title="@L["BackupRecoveryPanel_ScheduleRestore"].Value"
           Icon="@AppMaterialIcons.Outlined.Restore"
           Size="Small"
           OnClose="CloseRestoreDialog">
    <ChildContent>
        <AppAlert Tone="AppUiTone.Warning">
            The selected recovery point will be validated and staged. Restart the Engine to apply it; the current library is retained as a safety copy.
        </AppAlert>
        @if (_selectedRestore is not null)
        {
            <dl class="backup-restore-confirmation">
                <div><dt>@L["BackupRecoveryPanel_RecoveryPoint"]</dt><dd>@_selectedRestore.CreatedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</dd></div>
                <div><dt>@L["BackupRecoveryPanel_ArchiveSize"]</dt><dd>@FormatBytes(_selectedRestore.SizeBytes)</dd></div>
            </dl>
        }
    </ChildContent>
    <FooterContent>
        <AppActionBar Align="AppHorizontalAlignment.End">
            <AppButton Label="@L["Search_Cancel"].Value" Disabled="@_busy" OnClick="CloseRestoreDialog" />
            <AppButton Label="@L["BackupRecoveryPanel_ValidateAndSchedule"].Value"
                       ButtonStyle="AppButtonStyle.Filled"
                       Tone="AppUiTone.Warning"
                       Loading="@_busy"
                       Disabled="@(_busy || _selectedRestore is null)"
                       OnClick="ConfirmRestoreAsync" />
        </AppActionBar>
    </FooterContent>
</AppDialog>

@code {
    private IReadOnlyList<BackupArchiveDto> _backups = [];
    private bool _loading = true;
    private bool _busy;
    private bool _restartRequired;
    private string? _notice;
    private RestoreValidationResultDto? _lastValidation;
    private bool _restoreDialogOpen;
    private BackupArchiveDto? _selectedRestore;
    private BackupArchiveDto? _lastCreated;

    // Null when the Engine could not be asked; everything that depends on it is then hidden.
    private BackupStateDto? _state;
    private BackupArchiveDto? LatestBackup => _backups.OrderByDescending(item => item.CreatedAt).FirstOrDefault();

    // Null when the Engine could not be asked; the line is then hidden (the usual unreachable messaging applies).
    private DataStoreVersionDto? _dataStoreVersion;

    private string? DataStoreVersionLine => _dataStoreVersion switch
    {
        null => null,
        { StepNumber: > 0, AppliedAt: { } appliedAt } version =>
            $"Data store version: step {version.StepNumber}, upgraded on {DisplayFormat.FormatPlainDate(appliedAt)}",
        _ => "Data store version: setting up",
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var backups = ApiClient.GetBackupsAsync();
        var version = ApiClient.GetDataStoreVersionAsync();
        var state = ApiClient.GetBackupStateAsync();
        _backups = await backups;
        _dataStoreVersion = await version;
        _state = await state;
        _loading = false;
    }

    private async Task CreateAsync()
    {
        _busy = true;
        _notice = null;
        _restartRequired = false;
        var backup = await ApiClient.CreateBackupAsync();
        if (backup is null)
        {
            Snackbar.Add("The backup could not be created.", AppSeverity.Error);
        }
        else
        {
            _lastCreated = backup;
            Snackbar.Add("Recovery point created.", AppSeverity.Success);
            await LoadAsync();
        }
        _busy = false;
    }

    private async Task DownloadAsync(BackupArchiveDto backup)
    {
        _busy = true;
        var bytes = await ApiClient.DownloadBackupAsync(backup.FileName);
        if (bytes is null)
        {
            Snackbar.Add("The backup could not be downloaded.", AppSeverity.Error);
        }
        else
        {
            await using var stream = new MemoryStream(bytes, writable: false);
            using var reference = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("tuvimaDownloads.fromStream", backup.FileName, reference);
        }
        _busy = false;
    }

    private async Task ValidateAsync(BackupArchiveDto backup)
    {
        _busy = true;
        _lastValidation = await ApiClient.ValidateRestoreAsync(backup.FileName);
        _busy = false;

        if (_lastValidation?.Valid == true)
        {
            Snackbar.Add("Restore test passed. No restore was scheduled.", AppSeverity.Success);
        }
        else
        {
            Snackbar.Add("The restore test failed. Do not rely on this recovery point.", AppSeverity.Error);
        }
    }

    private void OpenRestoreDialog(BackupArchiveDto backup)
    {
        _selectedRestore = backup;
        _restoreDialogOpen = true;
    }

    private void CloseRestoreDialog()
    {
        if (_busy) return;
        _restoreDialogOpen = false;
        _selectedRestore = null;
    }

    private async Task ConfirmRestoreAsync()
    {
        if (_selectedRestore is null) return;

        _busy = true;
        var result = await ApiClient.ScheduleRestoreAsync(_selectedRestore.FileName);
        if (result?.Scheduled == true)
        {
            _notice = result.Message;
            _restartRequired = result.RestartRequired;
            _restoreDialogOpen = false;
            _selectedRestore = null;
            Snackbar.Add(
                result.RestartRequired
                    ? "Restore scheduled. Restart the Engine when ready."
                    : "Restore scheduled.",
                result.RestartRequired ? AppSeverity.Warning : AppSeverity.Success);
        }
        else
        {
            Snackbar.Add("The restore could not be scheduled.", AppSeverity.Error);
        }
        _busy = false;
    }

    private static readonly int[] StandardWaitingDays = [30, 60, 90, 180, 365];

    private static string FileOnlyLine(int count) => count == 1
        ? "1 item is matched by exact file only and may lose progress if the file changes."
        : $"{count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)} items are matched by exact file only and may lose progress if the file changes.";

    // The latest restore stays in view while items still wait for their files, and for a week after a restore that has nothing waiting.
    private string? RestoreSummaryLine
    {
        get
        {
            if (_state is not { LatestRestore: { } restore } state
                || (state.StillWaiting <= 0 && restore.RestoredAt < DateTimeOffset.UtcNow.AddDays(-7)))
            {
                return null;
            }

            var days = state.WaitingPeriodDays;
            var waiting = state.StillWaiting.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);
            var waitingOnly = state.StillWaiting == 1
                ? $"1 item is waiting for its file; it'll return if the file does, and is cleared after {days} days."
                : $"{waiting} items are waiting for their files; they'll return if the files do, and are cleared after {days} days.";
            if (restore.Attached <= 0)
            {
                // Nothing came back yet: say only what waits, and nothing at all when nothing waits either.
                return state.StillWaiting > 0 ? waitingOnly : null;
            }

            var attached = restore.Attached == 1
                ? "1 item got its progress and bookmarks back."
                : $"{restore.Attached.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)} items got their progress and bookmarks back.";
            if (state.StillWaiting <= 0)
            {
                return attached;
            }

            return state.StillWaiting == 1
                ? $"{attached} 1 is waiting for its file; it'll return if the file does, and is cleared after {days} days."
                : $"{attached} {waiting} are waiting for their files; they'll return if the files do, and are cleared after {days} days.";
        }
    }

    // The five standard choices; a stored value that is not one of them is shown as one more choice so the page never lies about it.
    private static IReadOnlyList<AppSelectOption> WaitingPeriodOptions(int stored)
    {
        var days = StandardWaitingDays.Contains(stored) ? StandardWaitingDays : [.. StandardWaitingDays, stored];
        return [.. days.Order().Select(count => new AppSelectOption(
            count.ToString(System.Globalization.CultureInfo.InvariantCulture), $"{count} days"))];
    }

    private int _waitingPeriodRenderKey;

    private async Task SetWaitingPeriodAsync(string? value)
    {
        if (_state is null || !int.TryParse(value, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var days))
        {
            return;
        }

        _busy = true;
        var updated = await ApiClient.SetBackupWaitingPeriodAsync(days);
        if (updated is null)
        {
            Snackbar.Add("The waiting period could not be saved.", AppSeverity.Error);
            // The browser kept the choice that was not saved; a new key redraws the field with the stored value.
            _waitingPeriodRenderKey++;
        }
        else
        {
            _state = updated;
        }
        _busy = false;
    }

    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1_073_741_824 => $"{bytes / 1_073_741_824d:0.0} GB",
        >= 1_048_576 => $"{bytes / 1_048_576d:0.0} MB",
        >= 1024 => $"{bytes / 1024d:0.0} KB",
        _ => $"{bytes} B",
    };
}
