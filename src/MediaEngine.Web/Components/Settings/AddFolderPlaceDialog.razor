@namespace MediaEngine.Web.Components.Settings

@* Adding a folder to Videos always asks where it belongs, because real videos (downloads, courses) and phone memories need
   different presentation. The choice is never made silently; a phone-looking folder only gets a gentle suggestion. *@
<AppDialogShell Title="Where does this folder belong?" Size="Medium" OnClose="@(() => Dialog.Cancel())">
    <ChildContent>
        <div class="add-folder-place">
            @if (LooksLikePhoneFootage)
            {
                <p class="add-folder-place__hint" role="note">This looks like footage from a phone or camera. Photos and personal videos is usually the better home for it.</p>
            }
            <AppChoiceCard Title="Videos (Watch)"
                           Description="Downloads, courses and anything with a title. They get shelves, series pages, Resume and Up Next."
                           OnClick="@(() => Dialog.Close(AppDialogResult.Ok(new AddFolderPlaceAnswer(true, _youtubeLookup))))" />
            <AppChoiceCard Title="Photos and personal videos (View)"
                           Description="@((LooksLikePhoneFootage ? "Suggested for this folder. " : string.Empty) + "Phone memories and home videos, shown with your photos in galleries and a timeline.")"
                           OnClick="@(() => Dialog.Close(AppDialogResult.Ok(new AddFolderPlaceAnswer(false, _youtubeLookup))))" />
            @if (ShowVault)
            {
                @* Only drawn for an administrator while NSFW mode is on; nothing in this dialog mentions it otherwise. *@
                <AppChoiceCard Title="Vault (adults only)"
                               Description="Adult videos and images in their own area, visible only while NSFW mode is on. You'll confirm that everyone who can unlock it is an adult."
                               OnClick="@(() => Dialog.Close(AppDialogResult.Ok(new AddFolderPlaceAnswer(false, false, true))))" />
            }
            <AppSwitchRow Label="Look up YouTube videos online"
                          Description="Only for videos named with a YouTube ID. This contacts YouTube and sends just that ID, never your files. You can change it later."
                          Value="_youtubeLookup"
                          ValueChanged="@((bool value) => _youtubeLookup = value)" />
        </div>
    </ChildContent>
    <FooterContent>
        <AppButton Label="Cancel" ButtonStyle="AppButtonStyle.Text" OnClick="@(() => Dialog.Cancel())" />
    </FooterContent>
</AppDialogShell>

@code {
    [CascadingParameter] private IAppDialogContext Dialog { get; set; } = default!;
    /// <summary>True when the Engine thinks the folder is phone or camera footage.</summary>
    [Parameter] public bool LooksLikePhoneFootage { get; set; }
    /// <summary>The library's current YouTube lookup setting.</summary>
    [Parameter] public bool YoutubeLookup { get; set; } = true;

    /// <summary>True for an administrator while NSFW mode is on: adds the third choice, the Vault (Videos spec D3, D45).</summary>
    [Parameter] public bool ShowVault { get; set; }

    private bool _youtubeLookup;

    protected override void OnInitialized() => _youtubeLookup = YoutubeLookup;

    /// <summary>The person's answer: Videos (Watch), View or the Vault, and whether YouTube may be asked.</summary>
    public sealed record AddFolderPlaceAnswer(bool Watch, bool YoutubeLookup, bool Vault = false);
}
