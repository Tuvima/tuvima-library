@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient
@implements IDisposable

@* The Events part of System > Logs (ingestion WP12): one flat, time-stamped, paged, searchable log of what was added, what needs
   review, what failed and what the system did. Server administrators only; the Engine enforces that, and the Settings shell only
   offers the page to administrators. The Engine writes every word shown here (title, detail, media type); this panel only lays
   them out. *@
<AppCard Title="Events" Description="What was added, what needs review, what failed and what the system did, newest first.">
    <div class="activity-log__toolbar">
        <div class="activity-log__filters">
            <AppSegmentedControl Options="FilterOptions"
                                 Value="@_filter"
                                 ValueChanged="OnFilterChanged"
                                 AriaLabel="Filter the activity log" />
        </div>
        <div class="activity-log__sort">
            <AppSelect Label="Media type"
                       Value="@_mediaType"
                       ValueChanged="OnMediaTypeChanged"
                       Options="MediaTypeOptions"
                       Size="AppControlSize.Compact" />
        </div>
        <div class="activity-log__sort">
            <AppSelect Label="Sort by"
                       Value="@_sort"
                       ValueChanged="OnSortChanged"
                       Options="SortOptions"
                       Size="AppControlSize.Compact" />
        </div>
        <div class="activity-log__search">
            <AppSearchField Label="Search the activity log"
                            HideLabel="true"
                            Placeholder="Search titles and details"
                            Value="@_search"
                            ValueChanged="OnSearchChanged"
                            DebounceInterval="300" />
        </div>
    </div>

    @if (_loading)
    {
        <div class="activity-log__skeleton" aria-busy="true" data-testid="activity-log-loading">
            @for (var row = 0; row < 6; row++)
            {
                <div class="activity-log__skeleton-row">
                    <AppSkeleton Width="5rem" Height="0.875rem" />
                    <AppSkeleton Width="@(row % 2 == 0 ? "55%" : "40%")" Height="1rem" />
                </div>
            }
        </div>
    }
    else if (_failed)
    {
        <div data-testid="activity-log-error">
            <AppErrorState Title="The Library's engine isn't responding"
                           Message="Check that the Engine is running, then try again."
                           Retry="ReloadAsync"
                           Compact="true" />
        </div>
    }
    else if (_items.Count == 0)
    {
        <div data-testid="activity-log-empty">
            <AppEmptyState Title="@EmptyTitle" />
        </div>
    }
    else
    {
        <ol class="activity-log__list" aria-label="Events, newest first" data-testid="activity-log-rows">
            @foreach (var row in Rows)
            {
                if (row.Children is null)
                {
                    @EntryRow(row.Entry)
                }
                else
                {
                var open = _expanded.Contains(row.Key);
                var newest = row.Children[0];
                <li class="activity-log__row activity-log__row--added activity-log__row--group" data-testid="activity-log-group" data-group="@row.Key">
                    <time class="activity-log__time" datetime="@newest.OccurredAt.ToString("O")" title="@FullTime(newest.OccurredAt)">@ShortTime(newest.OccurredAt)</time>
                    <span class="activity-log__symbol" aria-hidden="true">
                        <AppMaterialIcon Icon="@SymbolFor(newest.Category)" Size="AppSize.Small" />
                    </span>
                    <span class="activity-log__art" aria-hidden="true">
                        <AppMediaArtwork ImageUrl="@newest.CoverUrl" AspectRatio="1 / 1" Alt="" FallbackIcon="@IngestionMediaCard.MediaIcon(newest.MediaType)" />
                    </span>
                    <div class="activity-log__body">
                        <AppButton ButtonStyle="AppButtonStyle.Text"
                                   Size="AppControlSize.Compact"
                                   Class="activity-log__group-toggle"
                                   StartIcon="@(open ? AppMaterialIcons.Outlined.ExpandMore : AppMaterialIcons.Outlined.ChevronRight)"
                                   Label="@($"{row.Title} · {GroupSummary(row)}")"
                                   aria-expanded="@(open ? "true" : "false")"
                                   OnClick="@(() => ToggleGroup(row.Key))" />
                        @if (open)
                        {
                            <ol class="activity-log__children" aria-label="@($"Added to {row.Title}")">
                                @foreach (var child in row.Children)
                                {
                                    @EntryRow(child)
                                }
                            </ol>
                        }
                    </div>
                </li>
                }
            }
        </ol>

        <div class="activity-log__pager" data-testid="activity-log-pager">
            <span class="activity-log__pager-summary" aria-live="polite">@PagerSummary</span>
            <div class="activity-log__pager-actions">
                <AppButton Label="Previous"
                           Size="AppControlSize.Compact"
                           StartIcon="@AppMaterialIcons.Outlined.ChevronLeft"
                           Disabled="@(_offset <= 0)"
                           OnClick="PreviousAsync" />
                <AppButton Label="Next"
                           Size="AppControlSize.Compact"
                           EndIcon="@AppMaterialIcons.Outlined.ChevronRight"
                           Disabled="@(!_hasMore)"
                           OnClick="NextAsync" />
            </div>
        </div>
    }
</AppCard>

@code {
    // One row of the log: a single event, or a show or album folding the episodes or songs added to it.
    private RenderFragment EntryRow(ActivityLogEntryDto entry) => @<text>
        <AppRowErrorBoundary ItemTitle="@entry.Title" ResetKey="@entry">
        <ChildContent>
        <li class="activity-log__row activity-log__row--@CategoryKey(entry.Category)" data-testid="activity-log-row" data-category="@entry.Category">
            <time class="activity-log__time" datetime="@entry.OccurredAt.ToString("O")" title="@FullTime(entry.OccurredAt)">@ShortTime(entry.OccurredAt)</time>
            <span class="activity-log__symbol" aria-hidden="true">
                <AppMaterialIcon Icon="@SymbolFor(entry.Category)" Size="AppSize.Small" />
            </span>
            <span class="activity-log__art" aria-hidden="true">
                @if (HasArt(entry))
                {
                    <AppMediaArtwork ImageUrl="@entry.CoverUrl" AspectRatio="1 / 1" Alt="" FallbackIcon="@IngestionMediaCard.MediaIcon(entry.MediaType)" />
                }
            </span>
            <div class="activity-log__body">
                <div class="activity-log__headline">
                    @if (!string.IsNullOrWhiteSpace(entry.Route))
                    {
                        <a class="activity-log__title activity-log__title--link" href="@entry.Route">@entry.Title</a>
                    }
                    else
                    {
                        <strong class="activity-log__title">@entry.Title</strong>
                    }
                    @if (!string.IsNullOrWhiteSpace(entry.MediaType))
                    {
                        @* The type is an icon with its name as the tooltip and accessible name, the same icon the Now panel uses. *@
                        <AppTooltip Text="@TypeLabel(entry)" Placement="AppPlacement.Top">
                            <span class="activity-log__media-type" role="img" aria-label="@TypeLabel(entry)">
                                <AppMaterialIcon Icon="@IngestionMediaCard.MediaIcon(entry.MediaType)" Size="AppSize.Small" aria-hidden="true" />
                            </span>
                        </AppTooltip>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(entry.Detail))
                {
                    <p class="activity-log__detail">@entry.Detail@(string.IsNullOrWhiteSpace(entry.GroupTitle) ? null : $" · {entry.GroupTitle}")</p>
                }
            </div>
        </li>
        </ChildContent>
        <ErrorContent>
            <li class="activity-log__row activity-log__row--failed" data-testid="row-error">
                <span></span>
                <span class="activity-log__symbol" aria-hidden="true">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ReportProblem" Size="AppSize.Small" />
                </span>
                <span class="activity-log__art" aria-hidden="true"></span>
                <div class="activity-log__body">
                    <div class="activity-log__headline"><strong class="activity-log__title">@AppRowErrorBoundary.Headline</strong></div>
                    @if (!string.IsNullOrWhiteSpace(entry.Title))
                    {
                        <p class="activity-log__detail">@entry.Title</p>
                    }
                </div>
            </li>
        </ErrorContent>
        </AppRowErrorBoundary>

    </text>;

    private sealed record ActivityRow(ActivityLogEntryDto Entry, string Key, string Title, IReadOnlyList<ActivityLogEntryDto>? Children);

    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);

    private void ToggleGroup(string key)
    {
        if (!_expanded.Remove(key))
        {
            _expanded.Add(key);
        }
    }

    // Only episodes and songs are ever added, never the show or album, so entries that name one fold under it: one row per show
    // or album with the episodes or songs from this page inside. A lone episode or song stays an ordinary row.
    private IReadOnlyList<ActivityRow> Rows
    {
        get
        {
            var ordered = OrderedItems.ToList();
            var groups = ordered
                .Where(IsGroupable)
                .GroupBy(GroupKey, StringComparer.Ordinal)
                .Where(group => group.Count() > 1)
                .ToDictionary(group => group.Key, group => (IReadOnlyList<ActivityLogEntryDto>)group.ToList(), StringComparer.Ordinal);
            var rows = new List<ActivityRow>(ordered.Count);
            var placed = new HashSet<string>(StringComparer.Ordinal);
            foreach (var entry in ordered)
            {
                if (IsGroupable(entry) && groups.TryGetValue(GroupKey(entry), out var children))
                {
                    if (placed.Add(GroupKey(entry)))
                    {
                        rows.Add(new ActivityRow(children[0], GroupKey(entry), entry.GroupTitle!, children));
                    }

                    continue;
                }

                rows.Add(new ActivityRow(entry, string.Empty, entry.Title, null));
            }

            return rows;
        }
    }

    private static bool IsGroupable(ActivityLogEntryDto entry) =>
        !string.IsNullOrWhiteSpace(entry.GroupTitle) && CategoryKey(entry.Category ?? string.Empty) == ActivityLogCategoryValues.Added;

    private static string GroupKey(ActivityLogEntryDto entry) => $"{entry.MediaType}|{entry.GroupTitle}";

    private static string GroupSummary(ActivityRow row)
    {
        var count = row.Children!.Count;
        var unit = string.Equals(row.Entry.MediaType, "Music", StringComparison.OrdinalIgnoreCase)
            ? (count == 1 ? "song" : "songs")
            : (count == 1 ? "episode" : "episodes");
        return $"{count:N0} {unit} added";
    }

    private const int PageSize = 50;

    private static readonly IReadOnlyList<AppSelectOption> FilterOptions =
    [
        new(ActivityLogCategoryValues.Added, "Added"),
        new(ActivityLogCategoryValues.Review, "Needs Review"),
        new(ActivityLogCategoryValues.Failed, "Failed"),
        new(ActivityLogCategoryValues.System, "System"),
        new(ActivityLogCategoryValues.All, "All"),
    ];

    // Only types that have events of their own; photos and personal videos arrive as count rows, not titles.
    private static readonly IReadOnlyList<AppSelectOption> MediaTypeOptions =
    [
        new("all", "All types"), new("Movies", "Movies"), new("TV", "TV Shows"), new("Music", "Music"),
        new("Books", "Books"), new("Audiobooks", "Audiobooks"), new("Comics", "Comics"),
    ];

    private const string SortNewest = "newest";
    private const string SortType = "type";

    private static readonly IReadOnlyList<AppSelectOption> SortOptions =
    [
        new(SortNewest, "Newest first"),
        new(SortType, "Type"),
    ];

    /// <summary>The filter the log opens on: <c>added</c>, <c>review</c>, <c>failed</c>, <c>system</c> or <c>all</c> (the default).</summary>
    [Parameter] public string? Filter { get; set; }

    private readonly List<ActivityLogEntryDto> _items = [];
    private CancellationTokenSource? _load;
    private string _filter = ActivityLogCategoryValues.All;
    private string? _appliedParameter;
    private bool _parameterApplied;
    private string? _search;
    private string _mediaType = "all";
    private string _sort = SortNewest;
    private int _offset;
    private int? _total;
    private bool _hasMore;
    private bool _loading = true;
    private bool _failed;

    protected override Task OnParametersSetAsync()
    {
        // Only a changed address moves the filter; a parent re-render must not undo the chip the person picked.
        if (_parameterApplied && _appliedParameter == Filter)
        {
            return Task.CompletedTask;
        }

        _parameterApplied = true;
        _appliedParameter = Filter;
        _filter = NormalizeFilter(Filter);
        _offset = 0;
        return LoadAsync();
    }

    private Task OnFilterChanged(string value)
    {
        _filter = NormalizeFilter(value);
        _offset = 0;
        return LoadAsync();
    }

    private Task OnMediaTypeChanged(string? value)
    {
        _mediaType = string.IsNullOrWhiteSpace(value) ? "all" : value;
        _offset = 0;
        return LoadAsync();
    }

    // Sorting by type re-orders the page on screen (newest first within each type, entries with no type last); it does not reload.
    private Task OnSortChanged(string? value)
    {
        _sort = value == SortType ? SortType : SortNewest;
        return Task.CompletedTask;
    }

    private Task OnSearchChanged(string? value)
    {
        _search = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        _offset = 0;
        return LoadAsync();
    }

    private Task ReloadAsync() => LoadAsync();

    private Task PreviousAsync()
    {
        _offset = Math.Max(0, _offset - PageSize);
        return LoadAsync();
    }

    private Task NextAsync()
    {
        _offset += PageSize;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        // A newer request replaces an older one, so a slow answer never overwrites a fresher one.
        _load?.Cancel();
        _load?.Dispose();
        var source = _load = new CancellationTokenSource();
        var token = source.Token;

        _loading = true;
        _failed = false;
        await InvokeAsync(StateHasChanged);

        var page = await ApiClient.GetActivityLogAsync(_filter, _search, _offset, PageSize, _mediaType == "all" ? null : _mediaType, token);
        if (token.IsCancellationRequested)
        {
            return;
        }

        if (page is not null && page.Items.Count == 0 && _offset > 0)
        {
            // The log shrank under a later page (for example after old entries were pruned): go back to the first page.
            _offset = 0;
            page = await ApiClient.GetActivityLogAsync(_filter, _search, _offset, PageSize, _mediaType == "all" ? null : _mediaType, token);
            if (token.IsCancellationRequested)
            {
                return;
            }
        }

        _items.Clear();
        if (page is null)
        {
            _failed = true;
            _total = null;
            _hasMore = false;
        }
        else
        {
            _items.AddRange(page.Items);
            _total = page.TotalCount;
            _hasMore = page.HasMore;
        }

        _loading = false;
    }

    private IEnumerable<ActivityLogEntryDto> OrderedItems => _sort == SortType
        ? _items
            .Select((entry, position) => (entry, position))
            .OrderBy(pair => string.IsNullOrWhiteSpace(pair.entry.MediaType) ? 1 : 0)
            .ThenBy(pair => string.IsNullOrWhiteSpace(pair.entry.MediaType) ? string.Empty : IngestionMediaCard.FriendlyType(pair.entry.MediaType), StringComparer.OrdinalIgnoreCase)
            .ThenBy(pair => pair.position)
            .Select(pair => pair.entry)
        : _items;

    // A row shows a cover (or the type's icon in its place) when it is about an item of a known type.
    private static bool HasArt(ActivityLogEntryDto entry) =>
        !string.IsNullOrWhiteSpace(entry.CoverUrl) || !string.IsNullOrWhiteSpace(entry.MediaType);

    private static string TypeLabel(ActivityLogEntryDto entry) => IngestionMediaCard.FriendlyType(entry.MediaType);

    private static string NormalizeFilter(string? value) => value?.ToLowerInvariant() switch
    {
        ActivityLogCategoryValues.Added => ActivityLogCategoryValues.Added,
        ActivityLogCategoryValues.Review => ActivityLogCategoryValues.Review,
        ActivityLogCategoryValues.Failed => ActivityLogCategoryValues.Failed,
        ActivityLogCategoryValues.System => ActivityLogCategoryValues.System,
        _ => ActivityLogCategoryValues.All,
    };

    private string EmptyTitle
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_search))
            {
                return $"Nothing matches “{_search}”";
            }

            return _filter switch
            {
                ActivityLogCategoryValues.Added => "Nothing added yet",
                ActivityLogCategoryValues.Review => "Nothing needs review",
                ActivityLogCategoryValues.Failed => "No failures",
                ActivityLogCategoryValues.System => "No system events",
                _ => "No activity yet",
            };
        }
    }

    private string PagerSummary
    {
        get
        {
            var first = _offset + 1;
            var last = _offset + _items.Count;
            var total = Math.Max(_total ?? last, last);
            return $"{first:N0}–{last:N0} of {total:N0}";
        }
    }

    // One symbol and colour per category, from the theme tokens in the stylesheet.
    private static string CategoryKey(string category) => category.ToLowerInvariant() switch
    {
        ActivityLogCategoryValues.Added => ActivityLogCategoryValues.Added,
        ActivityLogCategoryValues.Review => ActivityLogCategoryValues.Review,
        ActivityLogCategoryValues.Failed => ActivityLogCategoryValues.Failed,
        _ => ActivityLogCategoryValues.System,
    };

    private static string SymbolFor(string category) => CategoryKey(category) switch
    {
        ActivityLogCategoryValues.Added => AppMaterialIcons.Outlined.AddCircleOutline,
        ActivityLogCategoryValues.Review => AppMaterialIcons.Outlined.RateReview,
        ActivityLogCategoryValues.Failed => AppMaterialIcons.Outlined.ErrorOutline,
        _ => AppMaterialIcons.Outlined.Settings,
    };

    // Today shows just the time; an older entry shows the date as well. The tooltip always carries the full timestamp.
    private static string ShortTime(DateTimeOffset occurredAt)
    {
        // A missing time (the default value) cannot be moved into every time zone, so it shows as a dash.
        if (occurredAt == default)
        {
            return "—";
        }

        var local = occurredAt.ToLocalTime();
        return local.Date == DateTimeOffset.Now.Date
            ? local.ToString("h:mm tt")
            : local.ToString("MMM d, h:mm tt");
    }

    private static string FullTime(DateTimeOffset occurredAt) =>
        occurredAt == default ? "Time not recorded" : occurredAt.ToLocalTime().ToString("dddd, MMMM d, yyyy h:mm:ss tt");

    public void Dispose()
    {
        _load?.Cancel();
        _load?.Dispose();
    }
}
