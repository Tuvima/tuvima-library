@namespace MediaEngine.Web.Components.Settings
@inject IStringLocalizer<SharedStrings> L

@* Server > General: one page, no tabs. Name and address, Language and region, Notifications (with its email test). *@
<div class="general-page" data-testid="general-page">
    <GeneralNameAddressPanel />

    <LanguageRegionPanel />

    <section class="general-page__group" aria-labelledby="general-notifications-heading" data-testid="general-notifications">
        <h2 id="general-notifications-heading" class="general-page__heading">@L["Common_Notifications"]</h2>
        <NotificationsPanel />
        <NotificationsEmailTest />
    </section>
</div>
