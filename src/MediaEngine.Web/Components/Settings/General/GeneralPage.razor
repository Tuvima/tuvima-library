@namespace MediaEngine.Web.Components.Settings
@inject IStringLocalizer<SharedStrings> L

@* Server > General. For now it holds the two panels that moved here from System > Configuration (Language and region, Notifications);
   the Library's name and address join them with the General page packet (settings-and-setup-simplified WP7). *@
<div class="general-page" data-testid="general-page">
    <LanguageRegionPanel />

    <section class="general-page__group" aria-labelledby="general-notifications-heading">
        <h2 id="general-notifications-heading" class="general-page__heading">@L["Common_Notifications"]</h2>
        <NotificationsPanel />
    </section>
</div>
