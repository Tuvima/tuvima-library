@namespace MediaEngine.Web.Components.Settings

@* A folder that already has files can be used three ways. Using it as-is is recommended because it changes nothing; merging
   brings its files into a managed folder once; managing it lets Tuvima rename and reorganise the files where they are. *@
<AppDialogShell Title="This folder already has files in it" Size="Medium" OnClose="@(() => Dialog.Cancel())">
    <ChildContent>
        <div class="add-folder-choice">
            <AppChoiceCard Class="add-folder-choice__card" Title="Use as-is (recommended)"
                           Description="Library only reads the folder and never renames, moves or changes your files, so other apps are not affected."
                           OnClick="@(() => Dialog.Close(AppDialogResult.Ok(AsIs)))" />
            @if (CanMerge)
            {
                <AppChoiceCard Class="add-folder-choice__card" Title="@($"Merge into {TypeLabel}")"
                               Description="Bring its files into one of your managed folders, once. By default they are copied and this folder is left untouched."
                               OnClick="@(() => Dialog.Close(AppDialogResult.Ok(Merge)))" />
            }
            <AppChoiceCard Class="add-folder-choice__card" Title="Let Library manage it"
                           Description="Library may rename and reorganise the files here, which could affect other applications that use this folder."
                           OnClick="@(() => Dialog.Close(AppDialogResult.Ok(Managed)))" />
        </div>
    </ChildContent>
    <FooterContent>
        <AppButton Label="Cancel" ButtonStyle="AppButtonStyle.Text" OnClick="@(() => Dialog.Cancel())" />
    </FooterContent>
</AppDialogShell>

@code {
    /// <summary>The answers the dialog can give.</summary>
    public const string AsIs = "as-is";
    public const string Merge = "merge";
    public const string Managed = "managed";

    [CascadingParameter] private IAppDialogContext Dialog { get; set; } = default!;
    /// <summary>The media type's name, for "Merge into Movies".</summary>
    [Parameter] public string TypeLabel { get; set; } = string.Empty;
    /// <summary>True when the type already has a managed folder to merge into.</summary>
    [Parameter] public bool CanMerge { get; set; }
}
