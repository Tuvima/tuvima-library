@namespace MediaEngine.Web.Components.Settings
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject IAppDialogService DialogService
@inject IAppToastService Snackbar
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Routing
@using MediaEngine.Contracts.LocalAssets

<NavigationLock ConfirmExternalNavigation="@HasDraft" OnBeforeInternalNavigation="ConfirmNavigationAsync" />

<div class="add-library-wizard">
    @if (_loading)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="Preparing library setup" Class="py-8" />
    }
    else if (_configuration is null)
    {
        <AppPageState Kind="AppPageStateKind.Error"
                      Icon="@AppMaterialIcons.Outlined.CloudOff"
                      Title="Library setup is unavailable"
                      Message="@(_loadError ?? "The Engine did not return library configuration.")" />
    }
    else
    {
        <div class="add-library-wizard__header">
            @if (!Embedded)
            {
                <AppIconButton Icon="@AppMaterialIcons.Outlined.ArrowBack" Tooltip="Back to libraries" AriaLabel="Back to libraries" OnClick="Cancel" />
            }
            <div>@if (Embedded) { <h2>Add Library</h2> } else { <h1>Add Library</h1> }<p>Choose what you want Tuvima Library to manage.</p></div>
        </div>

        <ol class="add-library-wizard__steps" aria-label="Library setup progress">
            @foreach (var step in VisibleSteps)
            {
                var ordinal = VisibleStepOrdinal(step.Number);
                <li class="@StepClass(step.Number)" aria-current="@(step.Number == _step ? "step" : null)">
                    <span>@(IsStepComplete(step.Number) ? "✓" : ordinal.ToString())</span>
                    <div><strong>@step.Title</strong><small>@step.Help</small></div>
                </li>
            }
        </ol>

        @if (_step == 1)
        {
            <section class="add-library-wizard__stage" aria-labelledby="library-type-heading">
                <div class="add-library-wizard__stage-heading">
                    <h3 id="library-type-heading">What would you like to add?</h3>
                    <p>Choose structured media or configure Personal Media storage for View.</p>
                </div>
                <div class="add-library-wizard__branches" role="radiogroup" aria-label="Library setup kind">
                    <AppNativeButton Type="button" role="radio" aria-checked="@(!_personal ? "true" : "false")" Class="@($"add-library-wizard__branch {(!_personal ? "is-selected" : null)}")" OnClick="SelectStructured">
                        <span class="add-library-wizard__category-icon"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.VideoLibrary" /></span>
                        <span><strong>Structured Media</strong><small>Books, comics, movies, TV shows, music, and audiobooks.</small></span>
                    </AppNativeButton>
                    <AppNativeButton Type="button" role="radio" aria-checked="@(_personal ? "true" : "false")" Class="@($"add-library-wizard__branch {(_personal ? "is-selected" : null)}")" OnClick="SelectPersonal">
                        <span class="add-library-wizard__category-icon"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Person" /></span>
                        <span><strong>Personal Media</strong><small>Photos, videos, documents, and recordings for each enabled profile.</small><small>One storage root · One Personal Space per profile</small></span>
                    </AppNativeButton>
                </div>
                @if (!_personal)
                {
                <div class="add-library-wizard__type-layout">
                    <div class="add-library-wizard__type-category">
                        <span class="add-library-wizard__category-icon"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.VideoLibrary" /></span>
                        <div><strong>Structured Media</strong><p>Identified and enriched with metadata.</p></div>
                    </div>
                    <div class="add-library-wizard__types" role="radiogroup" aria-label="Structured library type">
                        @foreach (var option in LibraryTypes)
                        {
                            <AppNativeButton Type="button"
                                             Class="@($"add-library-wizard__type is-{option.Key} {(_selectedType?.Key == option.Key ? "is-selected" : null)}")"
                                             role="radio"
                                             aria-checked="@(_selectedType?.Key == option.Key ? "true" : "false")"
                                             OnClick="@(() => SelectType(option))">
                                <span class="add-library-wizard__type-icon"><AppMaterialIcon Icon="@option.Icon" /></span>
                                <strong>@option.Label</strong>
                                @if (_selectedType?.Key == option.Key)
                                {
                                    <AppMaterialIcon Icon="@AppMaterialIcons.Filled.CheckCircle" Class="add-library-wizard__selected-check" />
                                }
                            </AppNativeButton>
                        }
                    </div>
                </div>
                }
                <AppAlert Tone="AppUiTone.Info">Shared View combines permitted content from Personal Spaces without duplicating files. Access and sharing follow administrator policies.</AppAlert>
            </section>
        }
        else if (_step == 2 && _personal)
        {
            <section class="add-library-wizard__stage">
                @if (!Embedded)
                {
                    <div class="add-library-wizard__branches" role="radiogroup" aria-label="Personal Media setup action">
                        <AppNativeButton Type="button" role="radio" aria-checked="@(_personalSetup == "root")" Class="@($"add-library-wizard__branch {(_personalSetup == "root" ? "is-selected" : null)}")" OnClick="@(_ => SetPersonalSetup("root"))"><span><strong>Configure View root</strong><small>Set the one Profiles and Shared storage foundation.</small></span></AppNativeButton>
                        <AppNativeButton Type="button" role="radio" aria-checked="@(_personalSetup == "source")" Class="@($"add-library-wizard__branch {(_personalSetup == "source" ? "is-selected" : null)}")" OnClick="@(_ => SetPersonalSetup("source"))"><span><strong>Add profile folder</strong><small>Attach an archive or create a managed mixed-media folder.</small></span></AppNativeButton>
                    </div>
                }
                @if (_personalSetup == "root")
                {
                    <div class="add-library-wizard__stage-heading"><h3>Choose Personal Media storage</h3><p>This is the single View root for enabled profiles. Existing storage is shown below.</p></div>
                    <div class="add-library-wizard__example"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Folder" /><span>View root</span><code>@ViewRootPath</code></div>
                    <AppButton Label="Choose root" StartIcon="@AppMaterialIcons.Outlined.FolderOpen" ButtonStyle="AppButtonStyle.Outlined" OnClick="ChooseViewRootAsync" />
                    <div class="add-library-wizard__example"><span>Profile folders</span><code>@Path.Combine(ViewRootPath, "Profiles")</code></div>
                    <p>Each profile has a stable named folder containing Timeline uploads and any additional managed Folders.</p>
                    <div class="add-library-wizard__example"><span>Shared Library originals</span><code>@Path.Combine(ViewRootPath, "Shared")</code></div>
                    <AppAlert Tone="AppUiTone.Info">Verified keeper promotions from managed Personal Spaces move into Shared after verification; linked read-only sources are copied. Changing this root does not relocate existing files.</AppAlert>
                    @if (_viewValidation is not null) { <AppStatusBadge Text="@(_viewValidation.CanSelect ? "Root validated" : "Root needs attention")" Tone="@(_viewValidation.CanSelect ? AppUiTone.Success : AppUiTone.Warning)" /> }
                    @if (_viewValidation is { CanSelect: false })
                    {
                        <AppAlert Tone="AppUiTone.Warning">@string.Join(" ", _viewValidation.Issues.Select(issue => issue.Message))</AppAlert>
                    }
                }
                else
                {
                    <div class="add-library-wizard__stage-heading"><h3>Add a View folder</h3><p>Choose the owning profile, storage behavior, and whether its items join Photos.</p></div>
                    <div class="libraries-form-grid">
                        <AppSelect Label="Owner profile" Value="@_personalOwner" ValueChanged="@((string? value) => _personalOwner = value)" Options="@PersonalOwnerOptions" />
                        <AppTextField Label="Folder name" Value="@_personalSourceName" ValueChanged="@((string? value) => _personalSourceName = value ?? string.Empty)" />
                        <AppSelect Label="Folder management" Value="@_personalSourceMode" ValueChanged="@((string? value) => { _personalSourceMode = value ?? "linked"; _personalSourcePath = null; })" Options="@PersonalSourceModeOptions" />
                        @if (_personalSourceMode == "linked")
                        {
                            <AppButton Label="Choose existing folder" StartIcon="@AppMaterialIcons.Outlined.FolderOpen" ButtonStyle="AppButtonStyle.Outlined" OnClick="ChoosePersonalSourceAsync" />
                            <code>@(_personalSourcePath ?? "No folder selected")</code>
                            <AppSwitchRow Label="Include subfolders" Value="@_personalSourceRecursive" ValueChanged="@((bool value) => _personalSourceRecursive = value)" />
                        }
                        <AppSwitchRow Label="Show in Photos timeline" Description="The folder remains available under View > Folders when this is off." Value="@_personalSourceTimeline" ValueChanged="@((bool value) => _personalSourceTimeline = value)" />
                    </div>
                    <div class="add-library-wizard__example"><span>Resulting path</span><code>@PersonalSourcePreview</code></div>
                    <AppAlert Tone="AppUiTone.Info">@(_personalSourceMode == "linked" ? "The existing folder is indexed in place and its originals remain read-only." : "Tuvima Library creates an empty managed folder. Adding it does not move existing media.")</AppAlert>
                }
            </section>
        }
        else if (_step == 2)
        {
            <section class="add-library-wizard__stage" aria-labelledby="library-folders-heading">
                <div class="add-library-wizard__stage-heading add-library-wizard__stage-heading--actions">
                    <div>
                        <h3 id="library-folders-heading">Where are your @(_selectedType?.PluralLabel.ToLowerInvariant())?</h3>
                        <p>Add one or more server-visible folders that contain your @(_selectedType?.PluralLabel.ToLowerInvariant()).</p>
                    </div>
                    <div class="add-library-wizard__folder-actions">
                        <AppSegmentedControl Value="@_newFolderMode" ValueChanged="SetNewFolderMode" Options="@FolderModeOptions" Size="AppControlSize.Compact" AriaLabel="New folder mode" />
                        <AppButton Label="Add folder" StartIcon="@AppMaterialIcons.Outlined.CreateNewFolder" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="AddFolderAsync" />
                    </div>
                </div>

                @if (_draft.Sources.Count == 0)
                {
                    <AppPageState Kind="AppPageStateKind.Empty" Icon="@AppMaterialIcons.Outlined.FolderOpen"
                                  Title="No folders selected" Message="Choose a managed destination or an existing read-only library folder." />
                }
                else
                {
                    <div class="add-library-wizard__folder-list">
                        @foreach (var source in _draft.Sources)
                        {
                            <article class="add-library-wizard__folder" @key="source.Id">
                                <div class="add-library-wizard__folder-identity">
                                    <span class="add-library-wizard__folder-icon"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Folder" /></span>
                                    <div>
                                        <AppTextField Label="Friendly name" Value="@SourceFriendlyName(source)" ValueChanged="@((string? value) => source.Notes = value)" />
                                        <code>@source.Path</code>
                                    </div>
                                </div>
                                <div class="add-library-wizard__folder-control">
                                    <span>Role</span>
                                    <AppSelect Value="@source.Role" ValueChanged="@((string? value) => SetSourceRole(source, value))" Options="@RoleOptionsFor(source)" />
                                </div>
                                <div class="add-library-wizard__folder-control">
                                    <span>Mode</span>
                                    <AppSelect Value="@source.ManagementMode" ValueChanged="@((string? value) => ChangeSourceModeAsync(source, value))" Options="@FolderModeOptions" />
                                    <small>@ModeHelp(source.ManagementMode)</small>
                                </div>
                                <div class="add-library-wizard__folder-control">
                                    <span>Access</span>
                                    <strong>@(source.ManagementMode == "managed_by_tuvima" ? "Read / Write" : "Read-only permitted")</strong>
                                </div>
                                <div class="add-library-wizard__folder-control">
                                    <AppSwitchRow Label="Include subfolders" Value="@source.IncludeSubdirectories" ValueChanged="@((bool value) => source.IncludeSubdirectories = value)" />
                                </div>
                                <div class="add-library-wizard__folder-health">
                                    <AppStatusBadge Text="@ValidationLabel(source)" Tone="@ValidationTone(source)" />
                                    <AppIconButton Icon="@AppMaterialIcons.Outlined.Delete" Tooltip="Remove folder" AriaLabel="Remove folder" Tone="AppUiTone.Error" OnClick="@(() => RemoveSource(source))" />
                                </div>
                            </article>
                        }
                    </div>
                    @if (AllFoldersValid)
                    {
                        <AppAlert Tone="AppUiTone.Success" Icon="@AppMaterialIcons.Outlined.CheckCircle">@FolderValidationSummary</AppAlert>
                    }
                }
            </section>
            @if (HasManagedSources)
            {
            <section class="add-library-wizard__stage" aria-labelledby="library-organization-heading">
                <div class="add-library-wizard__stage-heading">
                    <h3 id="library-organization-heading">Choose how new media is organized</h3>
                    <p>Organization applies only to managed folders. Existing library files remain unchanged.</p>
                </div>
                <div class="add-library-wizard__organization" role="radiogroup" aria-label="Organization mode">
                    @foreach (var option in OrganizationModes)
                    {
                        <AppNativeButton Type="button" role="radio" aria-checked="@(_draft.OrganizationPolicy.Mode == option.Value ? "true" : "false")"
                                         Class="@($"add-library-wizard__organization-option {(_draft.OrganizationPolicy.Mode == option.Value ? "is-selected" : null)}")"
                                         OnClick="@(() => { _draft.OrganizationPolicy.Mode = option.Value; if (option.Value != "custom") _draft.OrganizationPolicy.CustomTemplate = null; })">
                            <AppMaterialIcon Icon="@option.Icon" />
                            <span><strong>@option.Label</strong><small>@option.Description</small></span>
                            <AppMaterialIcon Icon="@(_draft.OrganizationPolicy.Mode == option.Value ? AppMaterialIcons.Filled.RadioButtonChecked : AppMaterialIcons.Outlined.RadioButtonUnchecked)" />
                        </AppNativeButton>
                    }
                </div>
                @if (_draft.OrganizationPolicy.Mode == "custom")
                {
                    <AppTextField Label="Naming template" Value="@_draft.OrganizationPolicy.CustomTemplate"
                                  ValueChanged="@((string? value) => _draft.OrganizationPolicy.CustomTemplate = value)"
                                  Placeholder="{Title} ({Year})/{Title} ({Year}).{Extension}" />
                }
                <div class="add-library-wizard__example"><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.AccountTree" /><span>Example</span><code>@OrganizationExample</code></div>
            </section>
            }
        }
        else if (_personal)
        {
            <section class="add-library-wizard__stage">
                <div class="add-library-wizard__stage-heading"><h3>Review Personal Media storage</h3><p>Nothing is saved until you confirm this change.</p></div>
                <dl class="add-library-wizard__review">
                    @if (_personalSetup == "root")
                    {
                        <div><dt>Storage root</dt><dd>@ViewRootPath</dd></div>
                        <div><dt>Personal Spaces</dt><dd>One per enabled profile</dd></div>
                        <div><dt>New profiles</dt><dd>Folders created automatically when files are first added</dd></div>
                        <div><dt>Profile storage</dt><dd>@Path.Combine(ViewRootPath, "Profiles")</dd></div>
                        <div><dt>Shared Library originals</dt><dd>@Path.Combine(ViewRootPath, "Shared")</dd></div>
                        <div><dt>Existing files</dt><dd>Remain in place; setting the root does not move files into Shared.</dd></div>
                    }
                    else
                    {
                        <div><dt>Owner</dt><dd>@PersonalOwnerName</dd></div>
                        <div><dt>Folder</dt><dd>@_personalSourceName</dd></div>
                        <div><dt>Path</dt><dd>@PersonalSourcePreview</dd></div>
                        <div><dt>Management</dt><dd>@(_personalSourceMode == "linked" ? "Linked read-only" : "Managed empty folder")</dd></div>
                        <div><dt>Photos</dt><dd>@(_personalSourceTimeline ? "Included in Timeline" : "Folders only")</dd></div>
                        <div><dt>Existing files</dt><dd>@(_personalSourceMode == "linked" ? "Indexed in place and unchanged" : "No existing files are moved")</dd></div>
                    }
                </dl>
            </section>
        }
        else
        {
            <section class="add-library-wizard__stage" aria-labelledby="library-review-heading">
                <div class="add-library-wizard__stage-heading">
                    <h3 id="library-review-heading">Review your library</h3>
                    <p>Nothing is saved until you create the library.</p>
                </div>
                <div class="add-library-wizard__review-identity">
                    <span class="@($"add-library-wizard__type-icon is-{_selectedType?.Key}")"><AppMaterialIcon Icon="@_selectedType?.Icon" /></span>
                    <div><h3>@_draft.Name</h3><p>@TitleCase(_draft.Area) library · @(_selectedType?.Description)</p></div>
                </div>
                <dl class="add-library-wizard__review">
                    <div><dt>Area</dt><dd>@TitleCase(_draft.Area)</dd></div>
                    <div><dt>Type</dt><dd>Structured media</dd></div>
                    <div><dt>Folders</dt><dd>@_draft.Sources.Count</dd></div>
                    @if (HasManagedSources)
                    {
                        <div><dt>Managed primary</dt><dd>@(_draft.GetPrimaryDestination()?.Path ?? "Not configured")</dd></div>
                        <div><dt>Other folders</dt><dd>@SecondaryFolderSummary</dd></div>
                        <div><dt>Organization</dt><dd>@OrganizationLabel</dd></div>
                        @if (HasReadOnlySources)
                        {
                            <div><dt>Read-only sources</dt><dd>Existing files remain unchanged</dd></div>
                        }
                    }
                    else
                    {
                        <div><dt>File handling</dt><dd>Existing files will remain unchanged</dd></div>
                    }
                </dl>
            </section>
        }

        <div class="add-library-wizard__footer">
            <AppButton Label="Back" ButtonStyle="AppButtonStyle.Outlined" Disabled="@(IsFirstStep || _saving)" OnClick="Back" />
            <div>
                <AppButton Label="Cancel" ButtonStyle="AppButtonStyle.Text" Disabled="@_saving" OnClick="Cancel" />
                @if (!IsLastStep)
                {
                    <AppButton Label="Next" EndIcon="@AppMaterialIcons.Outlined.ArrowForward" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(!CanContinue)" OnClick="Next" />
                }
                else
                {
                    <AppButton Label="@(_personal ? (_personalSetup == "root" ? "Save View storage" : "Add View folder") : "Create library")" StartIcon="@AppMaterialIcons.Outlined.Add" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_saving" Disabled="@(_saving || !CanCommit)" OnClick="CreateAsync" />
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public string? SetupSession { get; set; }
    [Parameter] public EventCallback LibraryCreated { get; set; }
    [Parameter] public EventCallback Cancelled { get; set; }
    private sealed record LibraryTypeOption(string Key, string Label, string PluralLabel, string Area, string MediaType, string Icon, string Accent, string Description);
    private sealed record WizardStep(int Number, string Title, string Help);
    private sealed record OrganizationMode(string Value, string Label, string Description, string Icon);

    private static readonly LibraryTypeOption[] LibraryTypes =
    [
        new("books", "Books", "Books", "read", "Books", AppMaterialIcons.Outlined.MenuBook, "#61a8ff", "Ebooks and PDFs"),
        new("comics", "Comics", "Comics", "read", "Comics", AppMaterialIcons.Outlined.AutoStories, "#7de568", "Issues and graphic novels"),
        new("movies", "Movies", "Movies", "watch", "Movies", AppMaterialIcons.Outlined.Movie, "#a16dff", "Films and full-length features"),
        new("tv", "TV Shows", "TV shows", "watch", "TVShows", AppMaterialIcons.Outlined.Tv, "#49a7ff", "Series and owned episodes"),
        new("music", "Music", "Music", "listen", "Music", AppMaterialIcons.Outlined.MusicNote, "#e76fce", "Albums and tracks"),
        new("audiobooks", "Audiobooks", "Audiobooks", "listen", "Audiobooks", AppMaterialIcons.Outlined.Headphones, "#f1b95b", "Narrated books"),
    ];

    private static readonly WizardStep[] WizardSteps =
    [
        new(1, "Choose type", "Structured or Personal"),
        new(2, "Add folders", "Choose folders or root"),
        new(3, "Review", "Confirm and create"),
    ];

    private IReadOnlyList<WizardStep> VisibleSteps => WizardSteps;

    private static readonly OrganizationMode[] OrganizationModes =
    [
        new("tuvima_standard", "Tuvima Library Standard", "Apply media-aware folders and filenames to new imports.", AppMaterialIcons.Outlined.AutoAwesome),
        new("keep_original_names", "Keep original names", "Preserve existing names and folder structure.", AppMaterialIcons.Outlined.FolderCopy),
        new("custom", "Custom", "Use a library-specific naming template.", AppMaterialIcons.Outlined.Tune),
    ];

    private static readonly IReadOnlyList<AppSelectOption> FolderModeOptions =
    [
        new("managed_by_tuvima", "Managed by Tuvima Library", AppMaterialIcons.Outlined.DriveFileMove),
        new("existing_library", "Existing library", AppMaterialIcons.Outlined.Lock),
    ];

    private static readonly IReadOnlyList<AppSelectOption> PrimaryRoleOptions =
    [
        new("primary_destination", "Primary", AppMaterialIcons.Outlined.Star),
        new("secondary", "Secondary", AppMaterialIcons.Outlined.StarOutline),
    ];

    private static readonly IReadOnlyList<AppSelectOption> SecondaryRoleOptions =
    [
        new("secondary", "Secondary", AppMaterialIcons.Outlined.StarOutline),
    ];

    private LibrariesConfigurationDto? _configuration;
    private LibraryFolderDto _draft = new();
    private LibraryTypeOption? _selectedType;
    private readonly Dictionary<string, ServerFolderValidationResultDto> _validation = new(StringComparer.OrdinalIgnoreCase);
    private string _newFolderMode = "managed_by_tuvima";
    private string? _loadError;
    private bool _loading = true;
    private bool _saving;
    private bool _personal;
    private bool _completed;
    private bool _viewChanged;
    private string _personalSetup = "root";
    private string? _personalOwner;
    private string _personalSourceName = string.Empty;
    private string _personalSourceMode = "linked";
    private string? _personalSourcePath;
    private bool _personalSourceRecursive = true;
    private bool _personalSourceTimeline;
    private List<ProfileViewModel> _personalProfiles = [];
    private readonly Dictionary<Guid, ViewPersonalSpaceAdminReviewDto> _personalReviews = [];
    private string _initialViewLocation = "";
    private string _initialViewRoot = "";
    private ServerFolderValidationResultDto? _viewValidation;
    private bool HasDraft => !_completed && (_selectedType is not null || _viewChanged || (_personal && _personalSetup == "source"));
    private bool CanCommit => _personal
        ? _personalSetup == "root"
            ? _viewValidation?.CanSelect == true
            : Guid.TryParse(_personalOwner, out _) && !string.IsNullOrWhiteSpace(_personalSourceName)
                && (_personalSourceMode == "managed" || !string.IsNullOrWhiteSpace(_personalSourcePath))
        : AllFoldersValid && ValidOrganization;
    private bool ValidOrganization => !HasManagedSources || _draft.OrganizationPolicy.Mode != "custom" || !string.IsNullOrWhiteSpace(_draft.OrganizationPolicy.CustomTemplate);
    private string ViewRootPath => _configuration is null ? "" : Path.Combine(_configuration.StorageLocations.FirstOrDefault(location => location.Id == _configuration.ViewStorage.StorageLocationId)?.Path ?? "", _configuration.ViewStorage.RelativeRoot);
    private void SelectStructured() { _personal = false; _viewValidation = null; _viewChanged = false; if (_configuration is not null) { _configuration.ViewStorage.StorageLocationId = _initialViewLocation; _configuration.ViewStorage.RelativeRoot = _initialViewRoot; } }
    private void SelectPersonal() { _personal = true; _selectedType = null; _draft = new(); _validation.Clear(); }
    private void SetPersonalSetup(string value) { _personalSetup = value; _viewChanged = value == "source" || _viewChanged; }
    private async Task ConfirmNavigationAsync(LocationChangingContext context)
    {
        if (HasDraft && await DialogService.ShowMessageBoxAsync("Discard setup?", "Your library setup has not been saved.", yesText: "Discard and leave", cancelText: "Keep editing") != true)
            context.PreventNavigation();
    }
    private async Task ChooseViewRootAsync()
    {
        var parameters = new AppDialogParameters<ServerFolderPicker>
        {
            { component => component.InitialPath, ViewRootPath },
            { component => component.SelectionMode, ServerFolderSelectionModes.PersonalSpaceManaged },
            { component => component.SetupSession, SetupSession },
            { component => component.HelpText, "Choose the single managed View root for enabled profiles." },
        };
        var dialog = await DialogService.ShowAsync<ServerFolderPicker>(string.Empty, parameters, new AppDialogOptions { MaxWidth = AppMaxWidth.ExtraExtraLarge, FullWidth = false, CloseButton = false, CloseOnEscapeKey = true });
        if (await dialog.Result is not { Canceled: false, Data: ServerFolderValidationResultDto selected }) return;
        _configuration!.ViewStorage.StorageLocationId = selected.StorageLocationId;
        _configuration.ViewStorage.RelativeRoot = string.IsNullOrWhiteSpace(selected.RelativePath) ? "." : selected.RelativePath;
        _viewValidation = selected;
        _viewChanged = true;
    }
    private async Task ValidateViewAsync()
    {
        var request = new ValidateServerFolderRequest { ManualPath = ViewRootPath, SelectionMode = ServerFolderSelectionModes.PersonalSpaceManaged };
        _viewValidation = Embedded ? await ApiClient.ValidateSetupServerFolderAsync(request, SetupSession) : await ApiClient.ValidateServerFolderAsync(request);
    }
    private async Task ChoosePersonalSourceAsync()
    {
        var parameters = new AppDialogParameters<ServerFolderPicker>
        {
            { component => component.InitialPath, _personalSourcePath ?? string.Empty },
            { component => component.SelectionMode, ServerFolderSelectionModes.PersonalSpaceExisting },
            { component => component.HelpText, "Choose an existing folder to index read-only in this profile's View." },
        };
        var dialog = await DialogService.ShowAsync<ServerFolderPicker>(string.Empty, parameters,
            new AppDialogOptions { MaxWidth = AppMaxWidth.ExtraExtraLarge, CloseButton = false, CloseOnEscapeKey = true });
        if (await dialog.Result is { Canceled: false, Data: ServerFolderValidationResultDto selected })
            _personalSourcePath = selected.Path;
    }
    private int _step = 1;

    protected override async Task OnInitializedAsync()
    {
        _configuration = Embedded
            ? await ApiClient.GetSetupLibrariesAsync(SetupSession)
            : await Orchestrator.GetLibrariesAsync();
        _loadError = _configuration is null ? ApiClient.LastError : null;
        _initialViewLocation = _configuration?.ViewStorage.StorageLocationId ?? "";
        _initialViewRoot = _configuration?.ViewStorage.RelativeRoot ?? "";
        if (!Embedded)
        {
            _personalProfiles = await ApiClient.GetProfilesAsync();
            _personalOwner = _personalProfiles.FirstOrDefault()?.Id.ToString("D");
            var reviews = await Task.WhenAll(_personalProfiles.Select(async profile =>
                (profile.Id, Review: await ApiClient.GetViewProfileSourcesAsync(profile.Id))));
            foreach (var (profileId, review) in reviews)
                if (review is not null) _personalReviews[profileId] = review;
        }
        _loading = false;
    }

    private void SelectType(LibraryTypeOption option)
    {
        if (_selectedType?.Key == option.Key) return;
        SelectStructured();
        _selectedType = option;
        _draft = new LibraryFolderDto
        {
            Id = Guid.NewGuid().ToString("D"),
            Name = option.Label,
            Category = option.Label,
            Kind = "catalogued",
            Area = option.Area,
            Presentation = "catalogue",
            MetadataPolicy = "enriched",
            MediaTypes = [option.MediaType],
            Visibility = "household",
            AcceptedIntakeModes = ["incoming_folder"],
            DuplicatePolicy = "skip_exact",
            OrganizationPolicy = new LibraryOrganizationPolicyDto { Mode = "tuvima_standard", PreserveOriginals = true },
        };
        _validation.Clear();
    }

    private async Task AddFolderAsync()
    {
        var mode = _newFolderMode == "existing_library"
            ? ServerFolderSelectionModes.ExistingLibrary
            : ServerFolderSelectionModes.ManagedLibrary;
        var parameters = new AppDialogParameters<ServerFolderPicker>
        {
            { component => component.SelectionMode, mode },
            { component => component.HelpText, $"Choose a folder on the Tuvima Library server to add to the {_draft.Name} library." },
            { component => component.SetupSession, SetupSession },
        };
        var dialog = await DialogService.ShowAsync<ServerFolderPicker>(string.Empty, parameters, new AppDialogOptions
        {
            MaxWidth = AppMaxWidth.ExtraExtraLarge,
            FullWidth = false,
            CloseButton = false,
            CloseOnEscapeKey = true,
        });
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: ServerFolderValidationResultDto selected }) return;

        var managed = _newFolderMode == "managed_by_tuvima";
        var isPrimary = managed && _draft.GetPrimaryDestination() is null;
        var source = new LibrarySourceDto
        {
            Id = Guid.NewGuid().ToString("D"),
            Path = selected.Path,
            Notes = Path.GetFileName(selected.Path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)),
            Role = isPrimary ? "primary_destination" : "secondary",
            ManagementMode = _newFolderMode,
            SourceType = "local_folder",
            IncludeSubdirectories = true,
            AccessMode = managed ? "writable" : "read_only",
            ParticipatesInOrganization = managed,
            IntakeRole = isPrimary ? "direct" : "none",
            WritebackOverride = false,
        };
        _draft.Sources.Add(source);
        if (isPrimary) _draft.PrimaryDestinationSourceId = source.Id;
        _validation[source.Id] = selected;
    }

    private async Task ChangeSourceModeAsync(LibrarySourceDto source, string? value)
    {
        var managed = value == "managed_by_tuvima";
        var request = new ValidateServerFolderRequest
        {
            ManualPath = source.Path,
            SelectionMode = managed ? ServerFolderSelectionModes.ManagedLibrary : ServerFolderSelectionModes.ExistingLibrary,
            CurrentSourceId = source.Id,
        };
        var validation = Embedded
            ? await ApiClient.ValidateSetupServerFolderAsync(request, SetupSession)
            : await ApiClient.ValidateServerFolderAsync(request);
        if (validation is null || !validation.CanSelect)
        {
            Snackbar.Add(validation?.Issues.FirstOrDefault()?.Message ?? ApiClient.LastError ?? "This folder does not meet the selected mode's access requirements.", AppSeverity.Error);
            return;
        }

        source.ManagementMode = managed ? "managed_by_tuvima" : "existing_library";
        source.AccessMode = managed ? "writable" : "read_only";
        source.ParticipatesInOrganization = managed;
        source.WritebackOverride = false;
        if (!managed && source.Role == "primary_destination")
        {
            source.Role = "secondary";
            source.IntakeRole = "none";
            _draft.PrimaryDestinationSourceId = null;
        }
        _validation[source.Id] = validation!;
        NormalizePrimaryDestination();
    }

    private void SetSourceRole(LibrarySourceDto source, string? role)
    {
        if (role != "primary_destination" || source.ManagementMode != "managed_by_tuvima")
        {
            source.Role = "secondary";
            source.IntakeRole = "none";
            if (_draft.PrimaryDestinationSourceId == source.Id) _draft.PrimaryDestinationSourceId = null;
            return;
        }

        foreach (var other in _draft.Sources.Where(other => other.Id != source.Id && other.Role == "primary_destination"))
        {
            other.Role = "secondary";
            other.IntakeRole = "none";
        }
        source.Role = "primary_destination";
        source.IntakeRole = "direct";
        _draft.PrimaryDestinationSourceId = source.Id;
    }

    private void RemoveSource(LibrarySourceDto source)
    {
        _draft.Sources.Remove(source);
        _validation.Remove(source.Id);
        if (_draft.PrimaryDestinationSourceId == source.Id) _draft.PrimaryDestinationSourceId = null;
        NormalizePrimaryDestination();
    }

    private void SetNewFolderMode(string value) => _newFolderMode = value;
    private IReadOnlyList<AppSelectOption> RoleOptionsFor(LibrarySourceDto source) => source.ManagementMode == "managed_by_tuvima" ? PrimaryRoleOptions : SecondaryRoleOptions;
    private string SourceFriendlyName(LibrarySourceDto source) => string.IsNullOrWhiteSpace(source.Notes) ? Path.GetFileName(source.Path) : source.Notes;
    private string ValidationLabel(LibrarySourceDto source) => _validation.TryGetValue(source.Id, out var result) && result.CanSelect ? "Healthy" : "Needs validation";
    private AppUiTone ValidationTone(LibrarySourceDto source) => _validation.TryGetValue(source.Id, out var result) && result.CanSelect ? AppUiTone.Success : AppUiTone.Warning;
    private bool HasManagedSources => _draft.Sources.Any(source => source.ManagementMode == "managed_by_tuvima");
    private bool HasReadOnlySources => _draft.Sources.Any(source => source.ManagementMode == "existing_library");
    private bool RequiresPrimaryDestination => HasManagedSources;
    private bool HasValidPrimaryDestination
    {
        get
        {
            var primaryRoles = _draft.Sources.Where(source => source.Role == "primary_destination").ToList();
            if (!RequiresPrimaryDestination)
            {
                return string.IsNullOrWhiteSpace(_draft.PrimaryDestinationSourceId) && primaryRoles.Count == 0;
            }

            var primary = _draft.GetPrimaryDestination();
            return primaryRoles.Count == 1
                && primary is not null
                && ReferenceEquals(primary, primaryRoles[0])
                && primary.ManagementMode == "managed_by_tuvima"
                && primary.AccessMode == "writable"
                && _validation.TryGetValue(primary.Id, out var validation)
                && validation.CanSelect
                && validation.HasWrite;
        }
    }
    private bool AllFoldersValid => _draft.Sources.Count > 0
        && HasValidPrimaryDestination
        && _draft.Sources.All(source => _validation.TryGetValue(source.Id, out var result)
            && result.CanSelect
            && result.HasRead
            && (source.ManagementMode != "managed_by_tuvima" || result.HasWrite));
    private bool CanContinue => _step switch
    {
        1 => _personal || _selectedType is not null,
        2 => _personal ? CanCommit : AllFoldersValid && ValidOrganization,
        _ => true,
    };

    private int CurrentVisibleStepIndex => VisibleSteps.ToList().FindIndex(step => step.Number == _step);
    private bool IsFirstStep => CurrentVisibleStepIndex <= 0;
    private bool IsLastStep => CurrentVisibleStepIndex == VisibleSteps.Count - 1;
    private int VisibleStepOrdinal(int step) => VisibleSteps.ToList().FindIndex(item => item.Number == step) + 1;
    private bool IsStepComplete(int step) => VisibleStepOrdinal(step) < VisibleStepOrdinal(_step);
    private string StepClass(int step) => step == _step ? "is-active" : IsStepComplete(step) ? "is-complete" : string.Empty;
    private void Back()
    {
        var index = CurrentVisibleStepIndex;
        if (index > 0) _step = VisibleSteps[index - 1].Number;
    }
    private async Task Next()
    {
        var index = CurrentVisibleStepIndex;
        if (CanContinue && index >= 0 && index < VisibleSteps.Count - 1)
        {
            _step = VisibleSteps[index + 1].Number;
            if (_personal && _personalSetup == "root" && _step == 2) await ValidateViewAsync();
        }
    }

    private void NormalizePrimaryDestination()
    {
        var managed = _draft.Sources
            .Where(source => source.ManagementMode == "managed_by_tuvima")
            .ToList();
        foreach (var source in _draft.Sources.Where(source => source.ManagementMode != "managed_by_tuvima"))
        {
            source.Role = "secondary";
            source.IntakeRole = "none";
        }

        if (managed.Count == 0)
        {
            _draft.PrimaryDestinationSourceId = null;
            return;
        }

        var primary = managed.FirstOrDefault(source =>
            source.Role == "primary_destination"
            && string.Equals(source.Id, _draft.PrimaryDestinationSourceId, StringComparison.OrdinalIgnoreCase))
            ?? managed.FirstOrDefault(source => source.Role == "primary_destination")
            ?? managed[0];
        foreach (var source in managed)
        {
            var isPrimary = ReferenceEquals(source, primary);
            source.Role = isPrimary ? "primary_destination" : "secondary";
            source.IntakeRole = isPrimary ? "direct" : "none";
        }
        _draft.PrimaryDestinationSourceId = primary.Id;
    }
    private async Task Cancel()
    {
        if (Embedded)
        {
            if (HasDraft && await DialogService.ShowMessageBoxAsync("Discard setup?", "Your setup has not been saved.", yesText: "Discard", cancelText: "Keep editing") != true) return;
            _completed = true;
            await Cancelled.InvokeAsync();
        }
        else
            Nav.NavigateTo("/settings/libraries");
    }

    private async Task CreateAsync()
    {
        if (_configuration is null || _saving || !CanCommit) return;
        _saving = true;
        try
        {
            if (_personal)
            {
                if (_personalSetup == "source")
                {
                    if (!Guid.TryParse(_personalOwner, out var owner)) return;
                    var created = await ApiClient.CreateViewProfileSourceAsync(owner,
                        new CreateViewSourceRequest(_personalSourceName, _personalSourceMode,
                            _personalSourcePath, _personalSourceRecursive, _personalSourceTimeline));
                    if (created is null)
                    {
                        Snackbar.Add(ApiClient.LastError ?? "The View folder could not be added.", AppSeverity.Error);
                        return;
                    }
                    _completed = true;
                    Snackbar.Add("View folder added. Indexing runs separately.", AppSeverity.Success);
                    Nav.NavigateTo("/settings/libraries/view");
                    return;
                }
                await ValidateViewAsync();
                if (_viewValidation?.CanSelect != true) { Snackbar.Add("The View root is no longer valid.", AppSeverity.Error); return; }
            }
            else
            {
                foreach (var source in _draft.Sources)
                {
                    var pathRequest = new ValidateServerFolderRequest { ManualPath = source.Path, SelectionMode = source.ManagementMode == "managed_by_tuvima" ? ServerFolderSelectionModes.ManagedLibrary : ServerFolderSelectionModes.ExistingLibrary };
                    var validation = Embedded ? await ApiClient.ValidateSetupServerFolderAsync(pathRequest, SetupSession) : await ApiClient.ValidateServerFolderAsync(pathRequest);
                    if (validation?.CanSelect != true) { Snackbar.Add(validation?.Issues.FirstOrDefault()?.Message ?? "A folder could not be validated.", AppSeverity.Error); return; }
                    _validation[source.Id] = validation;
                }
            }
            var request = new UpdateLibrariesRequest
            {
                SchemaVersion = _configuration.SchemaVersion,
                StorageLocations = _configuration.StorageLocations,
                ViewStorage = _configuration.ViewStorage,
                Libraries = _personal ? _configuration.Libraries : [.. _configuration.Libraries, _draft],
                PersonalLibraryPolicy = _configuration.PersonalLibraryPolicy,
            };
            var saved = Embedded
                ? await ApiClient.UpdateSetupLibrariesAsync(request, SetupSession)
                : await ApiClient.MutateLibraryAsync(_personal
                    ? new LibraryMutationRequest
                    {
                        ViewStorage = _configuration.ViewStorage,
                        ExpectedViewStorage = new ViewStorageDto { StorageLocationId = _initialViewLocation, RelativeRoot = _initialViewRoot },
                    }
                    : new LibraryMutationRequest { Library = _draft });
            if (saved is null)
            {
                Snackbar.Add(ApiClient.LastError ?? "The library could not be created.", AppSeverity.Error);
                return;
            }
            _completed = true;
            Snackbar.Add(_personal ? "View storage saved." : $"{_draft.Name} library created.", AppSeverity.Success);
            if (Embedded)
                await LibraryCreated.InvokeAsync();
            else
                Nav.NavigateTo(_personal ? "/settings/libraries/view" : $"/settings/libraries/{_draft.Id}");
        }
        finally
        {
            _saving = false;
        }
    }

    private string ModeHelp(string mode) => mode == "managed_by_tuvima"
        ? "Tuvima Library may organize new files and apply naming rules."
        : "Tuvima Library indexes files without moving, renaming, or modifying them.";
    private string OrganizationExample => _draft.OrganizationPolicy.Mode switch
    {
        "keep_original_names" => "Original Folder / Original Name.ext",
          "custom" => _draft.OrganizationPolicy.CustomTemplate ?? "Add a custom template",
          _ when _draft.MediaTypes.Contains("Audiobooks") => "Author / Title (2026) / Title.m4b",
        _ when _draft.Area == "read" => "Author / Series / Title (2026) / Title.epub",
        _ when _draft.Area == "listen" => "Artist / Album (2026) / 01 - Track.flac",
        _ => "Movies / Title (2026) / Title (2026).mkv",
    };
    private string OrganizationLabel => OrganizationModes.First(mode => mode.Value == _draft.OrganizationPolicy.Mode).Label;
    private string FolderValidationSummary => HasManagedSources
        ? HasReadOnlySources
            ? "All folders are accessible. The managed primary is writable, and read-only sources will remain unchanged."
            : "All folders are accessible and the managed primary destination is writable."
        : "All folders are accessible. Existing files will remain unchanged.";
    private string SecondaryFolderSummary => _draft.Sources.Count(source => source.Role == "secondary") switch
    {
        0 => "None",
        1 => _draft.Sources.First(source => source.Role == "secondary").Path,
        var count => $"{count} secondary folders",
    };
    private IReadOnlyList<AppSelectOption> PersonalOwnerOptions => _personalProfiles
        .Select(profile => new AppSelectOption(profile.Id.ToString("D"), profile.DisplayName)).ToList();
    private static readonly IReadOnlyList<AppSelectOption> PersonalSourceModeOptions =
    [
        new("linked", "Existing folder — read-only"),
        new("managed", "New managed folder"),
    ];
    private string PersonalOwnerName => Guid.TryParse(_personalOwner, out var owner)
        ? _personalProfiles.FirstOrDefault(profile => profile.Id == owner)?.DisplayName ?? "Profile"
        : "Profile";
    private string PersonalSourcePreview
    {
        get
        {
            if (_personalSourceMode == "linked") return _personalSourcePath ?? "Choose an existing folder";
            if (!Guid.TryParse(_personalOwner, out var owner)
                || !_personalReviews.TryGetValue(owner, out var review)
                || review.PersonalSpace is null)
                return "The profile's Personal Space will be provisioned before this folder is created.";
            var safeName = MediaEngine.Domain.PersonalMedia.ViewStorageNames.FromDisplayName(_personalSourceName);
            return Path.Combine(review.PersonalSpace.RootPath, "Folders",
                string.IsNullOrWhiteSpace(safeName) ? "<folder-name>" : safeName);
        }
    }
    private static string TitleCase(string value) => char.ToUpperInvariant(value[0]) + value[1..];
}
