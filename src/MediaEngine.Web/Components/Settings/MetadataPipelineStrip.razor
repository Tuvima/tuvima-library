@namespace MediaEngine.Web.Components.Settings
@inject MetadataSettingsStateService StateService
@inject IStringLocalizer<SharedStrings> L

@if (_loading)
{
    <AppPanel Density="AppSurfaceDensity.Compact" Class="metadata-library-loading">
        <AppSpinner Indeterminate="true" Size="AppSize.Small" /><span>@L["MetadataPipelineStrip_LoadingMetadataPipeline"]</span>
    </AppPanel>
}
else if (LocalOnly)
{
    <AppPanel Density="AppSurfaceDensity.Compact" Class="metadata-library-local">
        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.FolderOpen" />
        <div><strong>@L["MetadataPipelineStrip_LocalMetadataOnly"]</strong><p>@L["MetadataPipelineStrip_ThisPersonalSpaceDoesNot"]</p></div>
    </AppPanel>
}
else if (_pipeline is not null)
{
    <section class="metadata-library" aria-label="@L["MetadataPipelineStrip_MetadataPipelineSummary"].Value">
        <div class="metadata-library__pipeline">
            <div class="metadata-library__stage">
                <span class="metadata-library__stage-number">1</span>
                <AppMaterialIcon Icon="@_pipeline.Icon" />
                <span><strong>@PrimaryProviderSummary</strong><small>@L["MetadataPipelineStrip_MetadataProvider"]</small></span>
            </div>
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ArrowForward" Class="metadata-library__arrow" />
            <div class="metadata-library__stage">
                <span class="metadata-library__stage-number">2</span>
                <span class="metadata-library__wikidata">W</span>
                <span><strong>@L["MetadataPipelineStrip_Wikidata"]</strong><small>@L["MetadataPipelineStrip_CanonicalIdentity"]</small></span>
            </div>
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ArrowForward" Class="metadata-library__arrow" />
            <div class="metadata-library__stage">
                <span class="metadata-library__stage-number">3</span>
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.AutoAwesome" />
                <span><strong>@L["AiFeatures_Enrichment"]</strong><small>@EnrichmentSummary</small></span>
            </div>
        </div>
        <AppCard Class="metadata-library__summary">
            <SettingsSectionHeader Title="@L["MetadataPipelineStrip_MetadataSummary"].Value" Icon="@AppMaterialIcons.Outlined.Storage" />
            <ol>
                <li><span>1</span><div><small>@L["MetadataPipelineStrip_Stage1MetadataProvider"]</small><strong>@PrimaryProviderSummary</strong></div></li>
                <li><span>2</span><div><small>@L["MetadataPipelineStrip_Stage2CanonicalIdentity"]</small><strong>@L["MetadataPipelineStrip_Wikidata"]</strong></div></li>
                <li><span>3</span><div><small>@L["MetadataPipelineStrip_Stage3Enrichment"]</small><strong>@EnrichmentSummary</strong></div></li>
            </ol>
            <AppButton Label="@L["MetadataPipelineStrip_ManageMetadataSettings"].Value" Href="@ManageHref" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Primary" />
        </AppCard>
        <AppPanel Density="AppSurfaceDensity.Compact" Class="metadata-library__inheritance">
            <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Info" /><span>@L["MetadataPipelineStrip_ThisLibraryUsesTheGlobal", MetadataSettingsStateService.MediaTypeLabel(_pipeline.MediaType).ToLowerInvariant()]</span>
        </AppPanel>
    </section>
}

@code {
    [Parameter] public string? MediaType { get; set; }
    [Parameter] public bool LocalOnly { get; set; }

    private MetadataMediaPipeline? _pipeline;
    private MetadataSettingsSnapshot? _snapshot;
    private string? _loadedKey;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{MediaType}|{LocalOnly}";
        if (string.Equals(key, _loadedKey, StringComparison.OrdinalIgnoreCase)) return;
        _loadedKey = key;
        if (LocalOnly) { _loading = false; return; }
        _loading = true;
        try
        {
            _snapshot = await StateService.LoadAsync();
            _pipeline = _snapshot.PipelineFor(MediaType);
        }
        catch
        {
            _pipeline = null;
        }
        finally { _loading = false; }
    }

    private string PrimaryProviderSummary => _pipeline is null || _pipeline.Identification.Count == 0
        ? "Not configured"
        : string.Join(" + ", _pipeline.Identification.Select(provider => provider.DisplayName));

    private string EnrichmentSummary
    {
        get
        {
            if (_pipeline is null) return "Not configured";
            return _pipeline.Enrichment.Count == 0
                ? "No optional services"
                : string.Join(" · ", _pipeline.Enrichment.Select(item => $"{item.DisplayName} {(item.Enabled && !item.NeedsSetup ? "enabled" : "available")}"));
        }
    }

    private const string ManageHref = "/settings/metadata/ingestion-flow";
}
