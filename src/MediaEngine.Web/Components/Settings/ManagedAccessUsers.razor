    // For someone who lost their phone and their recovery codes. The Engine records who did this.
    private async Task ResetTwoStep(AccountAccessResponse account)
    {
        _actionAccountId = null;
        if (await Dialogs.ShowMessageBoxAsync($"Turn off two-step codes for {AccountLabel(account)}?",
                "They can sign in with just their password until they turn two-step codes on again. This is recorded in the activity log.",
                yesText: "Turn off", cancelText: "Cancel") != true)
            return;
        if (!TryBeginMutation(out var generation))
            return;
        try
        {
            ClearMessages();
            var result = await Confirmed.RunAsync(() => Identity.ResetAccountTwoStepResultAsync(account.Id));
            if (!IsCurrentMutation(generation))
                return;
            if (result.Succeeded && result.Value is not null)
            {
                ReplaceAccount(result.Value);
                _notice = $"Two-step codes are off for {AccountLabel(result.Value)}.";
            }
            else
            {
                _error = result.Failure == DashboardAccessMutationFailure.ConfirmItsYou
                    ? "Nothing was changed. Confirm it's you to continue."
                    : Message(result.Failure);
            }
        }
        finally
        {
            EndMutation(generation);
        }
    }

