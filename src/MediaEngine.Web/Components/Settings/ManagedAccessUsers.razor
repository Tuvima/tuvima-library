@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Contracts.Backups
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Ui
@inject DashboardIdentityClient Identity
@inject DashboardSessionAccessor Session
@inject ConfirmedActionRunner Confirmed
@inject IAppDialogService Dialogs
@inject DeviceContextService DeviceContext
@inject IJSRuntime JS
@implements IDisposable

<SettingsSectionPanel Title="Users and Sign-in" Description="The sign-ins people use to get into the Library. Each one opens a profile; what a person may see and do is set on their profile, under Profiles." Icon="@AppMaterialIcons.Outlined.Group">
    @if (!CanManage)
    {
        <AppAlert Severity="AppSeverity.Warning">Administrator access is required to manage users.</AppAlert>
    }
    else
    {
        @if (DeviceContext.IsPhone)
        {
            <p class="access-phone-note" role="note">Manage on a computer or tablet.</p>
        }
        @if (!string.IsNullOrWhiteSpace(_notice))
        {
            <AppAlert Severity="AppSeverity.Success" Class="access-notice" data-testid="access-notice">@_notice</AppAlert>
        }
        @if (!string.IsNullOrWhiteSpace(_exportError))
        {
            <AppAlert Severity="AppSeverity.Error" Class="access-notice" data-testid="access-export-error">@_exportError</AppAlert>
        }
        <div class="access-toolbar" @ref="_returnFocus" tabindex="-1">
            @if (!DeviceContext.IsPhone)
            {
                <AppButton Label="Import a user" StartIcon="@AppMaterialIcons.Outlined.UploadFile" OnClick="OpenImport" data-testid="access-import-user" />
                <AppButton Label="Add a sign-in" StartIcon="@AppMaterialIcons.Outlined.PersonAdd" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" OnClick="OpenInvite" data-testid="access-add-sign-in" />
            }
        </div>
        @if (_loading)
        {
            <AppProgressBar Indeterminate="true" aria-label="Loading users" />
        }
        else if (_users.Count == 0)
        {
            <AppEmptyState Title="No sign-ins" Message="Add a sign-in for a profile, or for someone new." />
        }
        else if (DeviceContext.IsPhone)
        {
            <AppTable CardsOn="AppTableCardsMode.Phone" Class="access-users">
                <caption class="sr-only">Sign-ins</caption>
                <thead>
                    <tr>
                        <th data-card-role="title">Sign-in</th>
                        <th data-card-role="subtitle">Opens profile and household</th>
                        <th data-card-role="value">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in _users)
                    {
                        <tr @key="user.Id">
                            <td data-card-role="title">@UserLabel(user)</td>
                            <td data-card-role="subtitle">@($"{user.ProfileName ?? "No profile"} · {user.HouseholdName ?? "No household"}")</td>
                            <td data-card-role="@(HasBadges(user) ? "value" : "hidden")">@if (HasBadges(user)) {<div class="access-users__badges">@UserBadges(user)</div>}</td>
                        </tr>
                    }
                </tbody>
            </AppTable>
        }
        else
        {
            <div class="access-users" role="table" aria-label="Sign-ins">
                <div class="access-users__header" role="row">
                    <span role="columnheader">Sign-in</span><span role="columnheader">Opens profile</span><span role="columnheader">Household</span><span role="columnheader">Actions</span>
                </div>
                @foreach (var user in _users)
                {
                    <div class="access-users__row" role="row" @key="user.Id">
                        <div class="access-users__identity" role="cell">
                            <strong>@UserLabel(user)</strong>
                            @if (HasBadges(user))
                            {
                                <div class="access-users__badges">@UserBadges(user)</div>
                            }
                        </div>
                        <div class="access-users__profile" role="cell">@(user.ProfileName ?? "No profile")</div>
                        <div class="access-users__household" role="cell">@(user.HouseholdName ?? "No household")</div>
                        <div class="access-users__actions" role="cell">
                            <AppRowMenu AriaLabel="@($"Actions for {UserLabel(user)}")" Items="@ActionItems(user)" />
                        </div>
                    </div>
                }
            </div>
        }
    }
</SettingsSectionPanel>

@if (_open && CanManage)
{
<div class="access-drawer-host">
<AppDrawer Open="true" OpenChanged="DrawerChanged" Anchor="AppAnchor.End" Width="560px" Overlay="true" Variant="AppDrawerVariant.Temporary" Class="access-drawer">
    <AppFocusTrap DefaultFocus="true">
    <div class="access-drawer__shell" @onkeydown="HandleDrawerKeyDown">
        <header class="access-drawer__header">
            <div><AppText Typo="AppTypo.overline">Users and Sign-in</AppText><AppText Typo="AppTypo.h6">@DrawerTitle</AppText></div>
            <AppIconButton Icon="@AppMaterialIcons.Filled.Close" AriaLabel="Close user drawer" OnClick="Close" />
        </header>
        <div class="access-drawer__body">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <AppAlert Severity="AppSeverity.Error" data-testid="access-error">@_error</AppAlert>
            }
            @if (_mode == UserDrawerMode.Import)
            {
                <ManagedAccessUserImport Imported="ImportedAsync" Cancelled="CancelImport" />
            }
            else if (_mode == UserDrawerMode.Invite)
            {
                <ManagedAccessUserInvite Created="CreatedAsync" Cancelled="Close" />
            }
            else if (_mode == UserDrawerMode.Created)
            {
                @if (_invitation is not null)
                {
                    <InvitationShare Code="@_invitation.Code" ExpiresAt="@_invitation.ExpiresAt" PublicAddress="@_invitation.PublicAddress" />
                }
                else
                {
                    <TemporaryPasswordShare Password="@_issuedTemporaryPassword" ExpiresAt="@_issuedTemporaryPasswordExpiresAt" />
                }
                <div class="access-form-actions"><AppButton Label="Done" OnClick="Close" /></div>
            }
            else if (_mode == UserDrawerMode.Email && _editing is not null)
            {
                <section class="access-form-section">
                    <AppText Typo="AppTypo.subtitle1">Change email</AppText>
                    <small>This is the email @UserLabel(_editing) signs in with. Their profile and everything in it stay exactly as they are.</small>
                    <AppTextField @bind-Value="_email" Label="Email" FullWidth="true" />
                </section>
                <div class="access-form-actions">
                    <AppButton Label="Cancel" OnClick="Close" />
                    <AppButton Label="Save email" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@(_saving || !CanSaveEmail)" OnClick="SaveEmail" />
                </div>
            }
            else if (_mode == UserDrawerMode.TemporaryPassword && _editing is not null)
            {
                @if (!string.IsNullOrEmpty(_issuedTemporaryPassword))
                {
                    <TemporaryPasswordShare Password="@_issuedTemporaryPassword" ExpiresAt="@_issuedTemporaryPasswordExpiresAt" />
                    <div class="access-form-actions"><AppButton Label="Done" OnClick="Close" /></div>
                }
                else
                {
                    <section class="access-form-section">
                        <AppText Typo="AppTypo.subtitle1">Set a temporary password</AppText>
                        <small>This signs @UserLabel(_editing) out everywhere. They will have to use the temporary password, then choose their own.</small>
                        <AppTextField @bind-Value="_temporaryPassword" Label="Temporary password" HelpText="At least 12 characters, not a common password." FullWidth="true" />
                        <AppButton Label="Generate" Size="AppControlSize.Compact" StartIcon="@AppMaterialIcons.Outlined.AutoAwesome" OnClick="GeneratePassword" />
                    </section>
                    <div class="access-form-actions">
                        <AppButton Label="Cancel" OnClick="Close" />
                        <AppButton Label="Set temporary password" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@(_saving || string.IsNullOrWhiteSpace(_temporaryPassword))" OnClick="SetTemporaryPassword" />
                    </div>
                }
            }
            else if (_mode == UserDrawerMode.Delete && _editing is not null)
            {
                @if (_preview is not null)
                {
                    <SignInDeletionConfirmation Preview="_preview" Email="@UserLabel(_editing)" Household="@_editing.HouseholdName"
                                              Busy="@_saving" Error="@_deleteError" />
                }
                <div class="access-form-actions">
                    <AppButton Label="Keep sign-in" Disabled="@_saving" OnClick="Close" />
                    @if (CanDelete)
                    {
                        <AppButton Label="Delete sign-in" Tone="AppUiTone.Error" ButtonStyle="AppButtonStyle.Filled" Disabled="@_saving" OnClick="DeleteUser" />
                    }
                </div>
            }
        </div>
    </div>
    </AppFocusTrap>
</AppDrawer>
</div>
}

@code {
    private List<UserSummaryResponse> _users = [];
    private UserSummaryResponse? _editing;
    private AccountInvitationResponse? _invitation;
    private UserDeletionPreviewResponse? _preview;
    private UserDrawerMode _mode;
    private IReadOnlyList<AppRowMenuItem> ActionItems(UserSummaryResponse user)
    {
        var items = new List<AppRowMenuItem>
        {
            new() { Label = "Change email", Icon = AppMaterialIcons.Outlined.Mail, OnClick = EventCallback.Factory.Create(this, () => OpenEmail(user)) },
            new() { Label = "Set temporary password", Icon = AppMaterialIcons.Outlined.Key, OnClick = EventCallback.Factory.Create(this, () => OpenTemporaryPassword(user)) },
        };
        if (user.HasTwoStep)
            items.Add(new() { Label = "Turn off two-step codes", Icon = AppMaterialIcons.Outlined.Lock, OnClick = EventCallback.Factory.Create(this, () => ResetTwoStep(user)) });
        if (!string.IsNullOrWhiteSpace(user.Email))
            items.Add(new() { Label = "Export", Icon = AppMaterialIcons.Outlined.Download, OnClick = EventCallback.Factory.Create(this, () => ExportUser(user)) });
        items.Add(new() { Label = "Delete sign-in", Icon = AppMaterialIcons.Outlined.Delete, Destructive = true, OnClick = EventCallback.Factory.Create(this, () => ConfirmDelete(user)) });
        return items;
    }
    private long _drawerGeneration;
    private bool _loading = true;
    private bool _open;
    private bool _saving;
    private string _email = string.Empty;
    private string _error = string.Empty;
    private string _deleteError = string.Empty;
    private string _notice = string.Empty;
    private string _exportError = string.Empty;
    private string _temporaryPassword = string.Empty;
    private string _issuedTemporaryPassword = string.Empty;
    private DateTimeOffset? _issuedTemporaryPasswordExpiresAt;
    private ElementReference _returnFocus;
    private bool _restoreFocus;

    private bool CanManage => Session.HasAction("access.manage");

    // Management is for the server administrator on a computer or tablet; every handler asks, not only the buttons.
    private bool CanAct => CanManage && !DeviceContext.IsPhone;

    private bool CanSaveEmail => _editing is not null
        && !string.IsNullOrWhiteSpace(_email)
        && !string.Equals(_email.Trim(), _editing.Email, StringComparison.OrdinalIgnoreCase);

    // A refusal from the Engine (the Library's only server administrator, a household that must keep an administrator) leaves nothing to confirm.
    private bool CanDelete => _preview is not null && string.IsNullOrWhiteSpace(_preview.RefusedReason);

    private string DrawerTitle => _mode switch
    {
        UserDrawerMode.Invite => "Add a sign-in",
        UserDrawerMode.Created => "Sign-in added",
        UserDrawerMode.Email when _editing is not null => $"Change email · {UserLabel(_editing)}",
        UserDrawerMode.TemporaryPassword when _editing is not null => $"Temporary password · {UserLabel(_editing)}",
        UserDrawerMode.Delete when _editing is not null => $"Delete sign-in · {UserLabel(_editing)}",
        UserDrawerMode.Import => "Import a user",
        _ => "Users and Sign-in",
    };

    protected override void OnInitialized() => DeviceContext.OnChanged += DeviceChanged;

    public void Dispose() => DeviceContext.OnChanged -= DeviceChanged;

    private void DeviceChanged() => InvokeAsync(() =>
    {
        // Editing drawers never open on phones, so a switch to the phone form factor closes one that is already open.
        if (DeviceContext.IsPhone && _open) Close();
        StateHasChanged();
    });

    protected override async Task OnInitializedAsync()
    {
        if (CanManage)
            await ReloadAll();
        _loading = false;
    }

    private void OpenInvite()
    {
        if (!CanAct) return;
        ResetDrawer(UserDrawerMode.Invite);
        _open = true;
    }

    private void OpenEmail(UserSummaryResponse user)
    {
        if (!CanAct) return;
        ResetDrawer(UserDrawerMode.Email);
        _editing = user;
        _email = user.Email ?? string.Empty;
        _open = true;
    }

    private void OpenTemporaryPassword(UserSummaryResponse user)
    {
        if (!CanAct) return;
        ResetDrawer(UserDrawerMode.TemporaryPassword);
        _editing = user;
        _open = true;
    }

    private void OpenImport()
    {
        if (!CanAct) return;
        ResetDrawer(UserDrawerMode.Import);
        _exportError = string.Empty;
        _open = true;
    }

    private void CancelImport() => Close();

    // The file is on this Library now: reload the list and say where the new person's access is looked after.
    private async Task ImportedAsync(UserImportResultDto added)
    {
        await ReloadAll();
        Close();
        var names = string.Join(", ", added.Profiles.Select(profile => profile.Name));
        _notice = $"{names} {(added.Profiles.Count == 1 ? "was" : "were")} added to {added.HouseholdName}. Choose what they can see on their profile, under Profiles.";
    }

    // The user is made: show the hand-over (the invitation, or the temporary password once) and reload the list.
    private async Task CreatedAsync(ManagedAccessUserInvite.UserCreatedEventArgs created)
    {
        if (!CanAct) return;
        var generation = _drawerGeneration;
        _invitation = created.Result.Invitation;
        _issuedTemporaryPassword = created.TemporaryPassword ?? string.Empty;
        _issuedTemporaryPasswordExpiresAt = created.Result.TemporaryPasswordExpiresAt;
        _mode = UserDrawerMode.Created;
        _notice = $"{UserLabel(created.Result.User)} can now sign in to {created.Result.User.ProfileName ?? "their profile"}.";
        await ReloadAll(generation);
    }

    // Anyone with the file can sign in as that person, so the Engine asks the administrator to confirm it is them first.
    private async Task ExportUser(UserSummaryResponse user)
    {
        if (!TryBeginMutation(out var generation))
            return;
        try
        {
            _notice = _exportError = string.Empty;
            var result = await Confirmed.RunAsync(() => Identity.ExportAccountResultAsync(user.Id));
            if (!IsCurrentMutation(generation))
                return;
            if (result.Succeeded && result.Value is { } file)
            {
                await JS.SaveZipAsync(file);
                _notice = $"A file for {UserLabel(user)} was downloaded. Anyone with it can sign in as them, so keep it somewhere safe.";
            }
            else
            {
                _exportError = result.Failure == DashboardAccessMutationFailure.ConfirmItsYou
                    ? "Nothing was downloaded. Confirm it's you to continue."
                    : !string.IsNullOrWhiteSpace(result.Message) ? result.Message
                    : result.Failure == DashboardAccessMutationFailure.Transient ? "The Engine is unavailable. Try again."
                    : "The file couldn't be made. Try again.";
            }
        }
        catch (JSException)
        {
            // The browser refused the download (for example a blocked download): say so instead of losing the page.
            _exportError = "The file couldn't be saved. Try again.";
        }
        finally
        {
            EndMutation(generation);
        }
    }

    private void GeneratePassword() => _temporaryPassword = TemporaryPasswordGenerator.Generate();

    private async Task ConfirmDelete(UserSummaryResponse user)
    {
        if (!CanAct) return;
        // The Engine says what the delete does (only the sign-in, or the household too), so the confirmation can say exactly that.
        var preview = await Identity.GetUserDeletionPreviewResultAsync(user.Id);
        ResetDrawer(UserDrawerMode.Delete);
        _editing = user;
        _preview = preview.Value;
        if (!preview.Succeeded)
            _error = ManagedUserMessages.For(preview.Failure, preview.Message);
        _open = true;
    }

    private void ResetDrawer(UserDrawerMode mode)
    {
        _drawerGeneration++;
        _saving = false;
        _mode = mode;
        _editing = null;
        _invitation = null;
        _preview = null;
        _temporaryPassword = _issuedTemporaryPassword = string.Empty;
        _issuedTemporaryPasswordExpiresAt = null;
        _email = _error = _deleteError = string.Empty;
    }

    private async Task SaveEmail()
    {
        if (_editing is null || !CanSaveEmail || !TryBeginMutation(out var generation))
            return;
        try
        {
            _error = string.Empty;
            var userId = _editing.Id;
            var email = _email.Trim();
            var result = await Confirmed.RunAsync(() => Identity.ChangeUserEmailResultAsync(userId, email));
            if (!IsCurrentMutation(generation))
                return;
            if (result.Succeeded && result.Value is not null)
            {
                ReplaceUser(result.Value);
                _notice = $"{UserLabel(result.Value)} is now the email for {result.Value.ProfileName ?? "this sign-in"}. Their profile and everything in it are unchanged.";
                Close();
            }
            else
            {
                _error = ManagedUserMessages.For(result.Failure, result.Message);
            }
        }
        finally
        {
            EndMutation(generation);
        }
    }

    private async Task SetTemporaryPassword()
    {
        if (_editing is null || !TryBeginMutation(out var generation))
            return;
        try
        {
            _error = string.Empty;
            var password = _temporaryPassword;
            var result = await Identity.SetTemporaryPasswordResultAsync(_editing.Id, new SetTemporaryPasswordRequest(password));
            if (!IsCurrentMutation(generation))
                return;
            if (result.Succeeded && result.Value is not null)
            {
                _issuedTemporaryPassword = password;
                _issuedTemporaryPasswordExpiresAt = result.Value.TemporaryPasswordExpiresAt;
                _temporaryPassword = string.Empty;
                await ReloadAll(generation);
            }
            else
            {
                _error = result.Failure == DashboardAccessMutationFailure.Validation && string.IsNullOrWhiteSpace(result.Message)
                    ? "That password isn't allowed. Use at least 12 characters, avoid common passwords, and don't use their email address."
                    : ManagedUserMessages.For(result.Failure, result.Message);
            }
        }
        finally
        {
            EndMutation(generation);
        }
    }

    // For someone who lost their phone and their recovery codes. The Engine records who did this.
    private async Task ResetTwoStep(UserSummaryResponse user)
    {
        if (!CanAct)
            return;
        if (await Dialogs.ShowMessageBoxAsync($"Turn off two-step codes for {UserLabel(user)}?",
                "They can sign in with just their password until they turn two-step codes on again. This is recorded in the activity log.",
                yesText: "Turn off", cancelText: "Cancel") != true)
            return;
        if (!TryBeginMutation(out var generation))
            return;
        try
        {
            _notice = _exportError = string.Empty;
            var result = await Confirmed.RunAsync(() => Identity.ResetAccountTwoStepResultAsync(user.Id));
            if (!IsCurrentMutation(generation))
                return;
            if (result.Succeeded)
            {
                await ReloadAll(generation);
                _notice = $"Two-step codes are off for {UserLabel(user)}.";
            }
            else
            {
                _exportError = ManagedUserMessages.For(result.Failure, result.Message);
            }
        }
        finally
        {
            EndMutation(generation);
        }
    }

    private async Task DeleteUser()
    {
        if (_editing is null || _preview is null || !CanDelete || !TryBeginMutation(out var generation))
            return;
        try
        {
            _deleteError = string.Empty;
            var user = _editing;
            var preview = _preview;
            // The profiles the person was shown travel with the delete, so the Engine refuses if what would go has changed.
            var shown = preview.HouseholdProfiles.Select(profile => profile.Id).ToList();
            var result = await Confirmed.RunAsync(() => Identity.DeleteUserResultAsync(user.Id, shown));
            if (!IsCurrentMutation(generation))
                return;
            if (result.Succeeded)
            {
                await ReloadAll(generation);
                if (!IsCurrentMutation(generation))
                    return;
                _notice = SignInDeletionText.Done(UserLabel(user), user.ProfileName ?? preview.ProfileName, preview);
                Close();
            }
            else
            {
                _deleteError = ManagedUserMessages.For(result.Failure, result.Message);
            }
        }
        finally
        {
            EndMutation(generation);
        }
    }

    private async Task ReloadAll(long? generation = null)
    {
        var users = await Identity.GetManagedUsersAsync();
        if (generation is { } expected && !IsCurrentMutation(expected))
            return;
        _users = users;
    }

    private void ReplaceUser(UserSummaryResponse user)
    {
        var index = _users.FindIndex(candidate => candidate.Id == user.Id);
        if (index >= 0)
            _users[index] = user;
        else
            _users.Add(user);
    }


    private static string UserLabel(UserSummaryResponse user) => string.IsNullOrWhiteSpace(user.Email) ? "No email" : user.Email;

    private static bool HasBadges(UserSummaryResponse user) => !user.HasPassword || user.HasTwoStep || !user.IsEnabled;

    private RenderFragment UserBadges(UserSummaryResponse user) => builder =>
    {
        var sequence = 0;
        void Chip(string text, AppUiTone tone)
        {
            builder.OpenComponent<AppChip>(sequence++);
            builder.AddAttribute(sequence++, nameof(AppChip.Text), text);
            builder.AddAttribute(sequence++, nameof(AppChip.Tone), tone);
            builder.CloseComponent();
        }

        if (!user.HasPassword) Chip("No password", AppUiTone.Warning);
        if (user.HasTwoStep) Chip("Two-step on", AppUiTone.Success);
        if (!user.IsEnabled) Chip("Disabled", AppUiTone.Neutral);
    };

    // A mutation starts only for the server administrator on a computer or tablet, and only one at a time.
    private bool TryBeginMutation(out long generation)
    {
        generation = _drawerGeneration;
        if (_saving || !CanAct)
            return false;
        _saving = true;
        return true;
    }

    private bool IsCurrentMutation(long generation) => generation == _drawerGeneration;

    private void EndMutation(long generation)
    {
        if (IsCurrentMutation(generation))
            _saving = false;
    }

    private void DrawerChanged(bool value)
    {
        if (value)
            _open = true;
        else
            Close();
    }

    private void HandleDrawerKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            Close();
    }

    private void Close()
    {
        _drawerGeneration++;
        _saving = false;
        _open = false;
        _invitation = null;
        _temporaryPassword = _issuedTemporaryPassword = string.Empty;
        _restoreFocus = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_restoreFocus) return;
        _restoreFocus = false;
        await _returnFocus.FocusAsync();
    }

    private enum UserDrawerMode
    {
        Invite,
        Created,
        Email,
        TemporaryPassword,
        Delete,
        Import,
    }
}
