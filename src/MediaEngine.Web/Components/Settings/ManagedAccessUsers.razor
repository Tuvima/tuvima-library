    private async Task GiveOwnSignIn()
    {
        if (_targetProfile is not { } profile)
            return;
        if (!TryBeginMutation(out var generation))
            return;
        try
        {
            ClearMessages();
            var useTemporaryPassword = _signInMethod == TemporaryPasswordMethod;
            var result = await Identity.GiveOwnSignInResultAsync(profile.Id,
                new GiveOwnSignInRequest(_email.Trim(), useTemporaryPassword ? _temporaryPassword : null));
            if (!IsCurrentMutation(generation))
                return;
            if (result.Succeeded && result.Value is not null)
            {
                if (useTemporaryPassword)
                {
                    _issuedTemporaryPassword = _temporaryPassword;
                    _issuedTemporaryPasswordExpiresAt = result.Value.TemporaryPasswordExpiresAt;
                    _temporaryPassword = string.Empty;
                }
                else
                {
                    _invitation = result.Value.Invitation;
                }

                _notice = $"{profile.DisplayName} now has their own sign-in.";
                await ReloadAll(generation);
            }
            else
            {
                _error = result.Failure == DashboardAccessMutationFailure.Validation
                    ? "Check the email, and if you chose a password use at least 12 characters that are not common and not their email address."
                    : PersonMessage(result.Failure);
            }
        }
        finally
        {
            EndMutation(generation);
        }
    }

    private async Task RemoveOwnSignIn()
