        || (_mode == UserDrawerMode.Invitation && _invitation is not null)
        || (_mode == UserDrawerMode.TemporaryPassword && !string.IsNullOrEmpty(_issuedTemporaryPassword));
    private bool CanSaveAccount => !string.IsNullOrWhiteSpace(_email)
        && (_editing is not null || (!string.IsNullOrWhiteSpace(_profileName)
            && (_signInMethod != TemporaryPasswordMethod || !string.IsNullOrWhiteSpace(_temporaryPassword))));
    private string EditingLabel => _editing is null ? string.Empty : AccountLabel(_editing);
    private string DrawerTitle => _mode switch
    {
        UserDrawerMode.AddPerson => "Add person",
        UserDrawerMode.OwnSignIn => $"Own sign-in · {_targetProfile?.DisplayName}",
        UserDrawerMode.RemoveOwnSignIn => $"Remove sign-in · {_targetProfile?.DisplayName}",
        UserDrawerMode.Permissions => $"Permissions · {EditingLabel}",
        UserDrawerMode.Profiles => $"Profiles · {EditingLabel}",
        UserDrawerMode.Invitation => "Invite user",
        UserDrawerMode.TemporaryPassword => $"Temporary password · {EditingLabel}",
        UserDrawerMode.Delete => $"Delete · {EditingLabel}",
        _ => _editing is null ? "New user" : $"Account · {EditingLabel}",
    };
    private List<ManagedProfileResponse> GrantableProfiles => _editing is null
        ? []
        : _profiles.Where(profile => _editing.ProfileGrants.All(grant => grant.ProfileId != profile.Id)).ToList();

