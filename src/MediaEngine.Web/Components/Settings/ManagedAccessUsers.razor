    private void ResetDrawer(UserDrawerMode mode)
    {
        _drawerGeneration++;
        _saving = false;
        _mode = mode;
        _actionAccountId = null;
        _invitation = null;
        _signInMethod = InvitationMethod;
        _temporaryPassword = _issuedTemporaryPassword = string.Empty;
        _issuedTemporaryPasswordExpiresAt = null;
        _invitationProfiles.Clear();
        _invitationDefault = null;
        _featureIds.Clear();
        _libraryIds.Clear();
        _profileNames.Clear();
        _pins.Clear();
        _protectionOptions.Clear();
        _email = _profileName = _grantProfile = _error = _drawerMessage = string.Empty;
        _profileColor = "#7C4DFF";
        _administrator = _newProfileDefault = false;
        _enabled = true;
        _householdId = null;
        _targetProfile = null;
        _targetAccount = null;
        _personIsChild = false;
        _personPin = string.Empty;
    }

    private async Task SaveAccount()
    {
        if (!TryBeginMutation(out var generation))
            return;
        try
        {
            ClearMessages();
            if (_editing is null)
            {
                var useTemporaryPassword = _signInMethod == TemporaryPasswordMethod;
                var result = await Identity.CreateManagedAccountResultAsync(new(_email.Trim(), _administrator, null,
                    new(_profileName.Trim(), _profileColor), _featureIds.Order().ToArray(), _libraryIds.Order().ToArray(),
                    useTemporaryPassword ? _temporaryPassword : null));
                if (!IsCurrentMutation(generation))
                    return;
                if (result.Succeeded && result.Value is not null)
                {
                    _notice = $"{AccountLabel(result.Value)} was created.";
                    if (useTemporaryPassword)
                    {
                        _issuedTemporaryPassword = _temporaryPassword;
                        _issuedTemporaryPasswordExpiresAt = result.Value.TemporaryPasswordExpiresAt;
                        _temporaryPassword = string.Empty;
                        await ReloadAll(generation);
                        return;
                    }

                    // The new account has no password yet, so the invitation is how they get one.
                    var grants = result.Value.ProfileGrants.Where(grant => grant.IsEnabled).ToArray();
                    var invitation = await Identity.CreateInvitationResultAsync(new CreateAccountInvitationRequest
                    {
                        Email = result.Value.Email ?? _email.Trim(),
                        ProfileIds = grants.Select(grant => grant.ProfileId).Order().ToArray(),
                        DefaultProfileId = grants.FirstOrDefault(grant => grant.IsDefault)?.ProfileId,
                    });
                    if (!IsCurrentMutation(generation))
                        return;
                    await ReloadAll(generation);
                    if (invitation.Succeeded && invitation.Value is not null)
                    {
                        _invitation = invitation.Value;
                        _drawerMessage = "User created. Share the invitation below.";
                    }
                    else
                    {
                        // The person exists; the administrator can still hand over access from Invite user.
                        _error = $"The user was created, but the invitation could not be. Use Invite user to try again. {Message(invitation.Failure)}";
                    }
                }
                else
                {
                    _error = Message(result.Failure);
                }
            }
            else
            {
                var result = await Identity.UpdateManagedAccountResultAsync(_editing.Id,
                    new(_email.Trim(), _enabled, _administrator));
                if (!IsCurrentMutation(generation))
                    return;
                if (result.Succeeded && result.Value is not null)
                {
                    ReplaceAccount(result.Value);
                    _notice = $"{AccountLabel(result.Value)} was updated.";
                    Close();
                }
                else
                {
                    _error = Message(result.Failure);
                }
            }
        }
        finally
        {
            EndMutation(generation);
        }
    }

