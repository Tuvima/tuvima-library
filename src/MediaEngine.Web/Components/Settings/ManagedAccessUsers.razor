    private async Task SaveProtection(AccountProfileGrantDto grant, bool enabled, string? mode = null)
    {
        if (_editing is null)
            return;
        if (!TryBeginMutation(out var generation))
            return;
        try
        {
            ClearMessages();
            var option = mode ?? ProtectionOption(grant.ProfileId);
            var parts = option.Split(':', 2);
            var unlockMode = parts[0];
            var unlockMinutes = unlockMode == "FixedDuration" && parts.Length == 2 && int.TryParse(parts[1], out var minutes)
                ? minutes
                : grant.AdminProtection.UnlockMinutes;
            var result = await Identity.SetGrantProtectionResultAsync(_editing.Id, grant.ProfileId,
                new(enabled, enabled ? Pin(grant.ProfileId) : null, unlockMode, unlockMinutes));
            if (!IsCurrentMutation(generation))
                return;
            _pins.Remove(grant.ProfileId);
            if (result.Succeeded)
            {
                _drawerMessage = enabled
                    ? $"Admin protection for {grant.DisplayName} was updated."
                    : $"Admin protection for {grant.DisplayName} was removed.";
                await ReloadKeepingEditing(generation);
            }
            else
            {
                _error = Message(result.Failure);
            }
        }
        finally
        {
            EndMutation(generation);
        }
    }

