    private async Task ReloadAll(long? generation = null)
    {
        var accounts = Identity.GetManagedAccountsAsync();
        var profiles = Identity.GetManagedProfilesAsync();
        var libraries = Identity.GetAccessLibrariesAsync();
        await Task.WhenAll(accounts, profiles, libraries);
        if (generation is { } expected && !IsCurrentMutation(expected))
            return;
        _accounts = accounts.Result;
        _profiles = profiles.Result;
        _libraries = libraries.Result;
    }

    private async Task ReloadKeepingEditing(long? generation = null)
    {
        var id = _editing?.Id;
        await ReloadAll(generation);
        if (generation is { } expected && !IsCurrentMutation(expected))
            return;
        _editing = id is null ? null : _accounts.FirstOrDefault(account => account.Id == id);
        _profileNames.Clear();
        if (_editing is not null)
            foreach (var grant in _editing.ProfileGrants)
            {
                _profileNames[grant.ProfileId] = grant.DisplayName;
                _protectionOptions[grant.ProfileId] = grant.AdminProtection.UnlockMode == "FixedDuration"
                    ? $"FixedDuration:{grant.AdminProtection.UnlockMinutes ?? 30}"
                    : grant.AdminProtection.UnlockMode;
            }
    }

    private void ReplaceAccount(AccountAccessResponse account)
    {
        var index = _accounts.FindIndex(candidate => candidate.Id == account.Id);
        if (index >= 0)
            _accounts[index] = account;
        else
            _accounts.Add(account);
        _editing = account;
    }

    private void ToggleFeature((string Id, bool Value) change)
    {
