                new AddHouseholdPersonRequest(_profileName.Trim(), null, _personIsChild,
                    string.IsNullOrWhiteSpace(_personPin) ? null : _personPin.Trim()));
            if (!IsCurrentMutation(generation))
                return;
            if (result.Succeeded && result.Value is not null)
            {
                await ReloadAll(generation);
                if (!IsCurrentMutation(generation))
                    return;
                _notice = $"{result.Value.DisplayName} was added to the household.";
