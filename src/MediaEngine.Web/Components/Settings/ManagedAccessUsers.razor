    private void ToggleInvitationProfile(Guid id, bool value)
    {
        if (value && _invitationProfiles.Count < 8)
            _invitationProfiles.Add(id);
        else if (!value)
            _invitationProfiles.Remove(id);
        if (_invitationDefault is null || !_invitationProfiles.Contains(_invitationDefault.Value))
        {
            var first = _invitationProfiles.FirstOrDefault();
            _invitationDefault = first == Guid.Empty ? null : first;
        }
    }

    private void SetInvitationDefault(ChangeEventArgs value)
    {
        _invitationDefault = Guid.TryParse(value.Value?.ToString(), out var id) && _invitationProfiles.Contains(id)
            ? id
            : null;
    }

    private void ToggleActions(Guid id) => _actionAccountId = _actionAccountId == id ? null : id;
    private string ProfileName(AccountProfileGrantDto grant) => _profileNames.GetValueOrDefault(grant.ProfileId, grant.DisplayName);
    private string ProfileAvatarColor(Guid id) => _profiles.FirstOrDefault(profile => profile.Id == id)?.AvatarColor ?? "#7C4DFF";
    private string Pin(Guid id) => _pins.GetValueOrDefault(id, "");
    private string ProtectionOption(Guid id) => _protectionOptions.GetValueOrDefault(id, "FixedDuration:30");
    private static string AccountLabel(AccountAccessResponse account) => account.Email ?? "Account";
    private static string Initials(string value) => string.Concat(value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
    private void ClearMessages() => _error = _drawerMessage = string.Empty;

    private bool TryBeginMutation(out long generation)
    {
        generation = _drawerGeneration;
        if (_saving)
            return false;
        _saving = true;
        return true;
    }

    private bool IsCurrentMutation(long generation) => generation == _drawerGeneration;

    private void EndMutation(long generation)
    {
        if (IsCurrentMutation(generation))
            _saving = false;
    }

    private void DrawerChanged(bool value)
    {
        if (value)
            _open = true;
        else
            Close();
    }

    private void HandleDrawerKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            Close();
    }

    private void Close()
    {
        _drawerGeneration++;
        _saving = false;
        _open = false;
        _actionAccountId = null;
        _invitation = null;
        _temporaryPassword = _issuedTemporaryPassword = string.Empty;
        _pins.Clear();
        _protectionOptions.Clear();
        _restoreFocus = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_restoreFocus) return;
        _restoreFocus = false;
        await _returnFocus.FocusAsync();
    }

    private static string Message(DashboardAccessMutationFailure failure) => failure switch
    {
        DashboardAccessMutationFailure.Validation => "Check the values and try again.",
        DashboardAccessMutationFailure.Conflict => "This change conflicts with the current account state.",
        DashboardAccessMutationFailure.Forbidden => "You no longer have permission for this change.",
        DashboardAccessMutationFailure.Unauthorized => "Your session has expired.",
        DashboardAccessMutationFailure.NotFound => "This account or profile no longer exists.",
        DashboardAccessMutationFailure.Transient => "The Engine is unavailable. Try again.",
        _ => "The change could not be saved. Try again.",
    };

    private enum UserDrawerMode
    {
        Account,
        Permissions,
        Profiles,
        Invitation,
        TemporaryPassword,
        Delete,
        AddPerson,
        OwnSignIn,
        RemoveOwnSignIn,
    }
}
