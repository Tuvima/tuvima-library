@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Ui
@inject DashboardIdentityClient Identity
@inject DashboardSessionAccessor Session
@inject ConfirmedActionRunner Confirmed
@inject IAppDialogService Dialogs

<SettingsSectionPanel Title="Users" Description="Accounts control access. Profiles retain each person's library experience and history." Icon="@AppMaterialIcons.Outlined.Group">
    @if (!CanManage)
    {
        <AppAlert Severity="AppSeverity.Warning">Administrator access is required to manage users.</AppAlert>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_notice))
        {
            <AppAlert Severity="AppSeverity.Success" Class="access-notice">@_notice</AppAlert>
        }
        <div class="access-toolbar" @ref="_returnFocus" tabindex="-1">
            <AppButton Label="Invite user" StartIcon="@AppMaterialIcons.Outlined.Mail" OnClick="OpenInvitation" />
            <AppButton Label="New user" StartIcon="@AppMaterialIcons.Outlined.PersonAdd" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" OnClick="NewUser" />
        </div>
        @if (!_loading && Households.Count > 0)
        {
            <section class="access-form-section" aria-label="People in each household">
                <AppText Typo="AppTypo.subtitle1">People</AppText>
                <small>Everyone in a household shares its library. A person can also have their own sign-in that opens straight to them.</small>
                @foreach (var household in Households)
                {
                    <div class="access-toolbar">
                        <strong>@household.Label · @household.People.Count of 8</strong>
                        <AppButton Label="Add person" StartIcon="@AppMaterialIcons.Outlined.PersonAdd" Disabled="@(household.People.Count >= 8)" OnClick="@(() => OpenAddPerson(household.Id))" />
                    </div>
                    <div class="access-users" role="table" aria-label="@($"People in {household.Label}")" @key="household.Id">
                        @foreach (var person in household.People)
                        {
                            <div class="access-users__row" role="row" @key="person.Profile.Id">
                                <div class="access-users__identity" role="cell">
                                    <strong>@person.Profile.DisplayName</strong>
                                    <div class="access-users__badges">
                                        @if (person.Profile.IsRestricted) { <AppChip Text="Child" Tone="AppUiTone.Primary" /> }
                                    </div>
                                </div>
                                <div role="cell">
                                    @if (person.OwnSignIn is { } ownSignIn)
                                    {
                                        <span>@AccountLabel(ownSignIn)</span>
                                        <AppButton Label="Remove sign-in" Size="AppControlSize.Compact" Tone="AppUiTone.Error" ButtonStyle="AppButtonStyle.Text" OnClick="@(() => ConfirmRemoveOwnSignIn(person))" />
                                    }
                                    else
                                    {
                                        <small>Uses the household sign-in</small>
                                        <AppButton Label="@($"Give {person.Profile.DisplayName} their own sign-in")" Size="AppControlSize.Compact" ButtonStyle="AppButtonStyle.Text" OnClick="@(() => OpenOwnSignIn(person.Profile))" />
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        }
        @if (_loading)
        {
            <AppProgressBar Indeterminate="true" aria-label="Loading users" />
        }
        else if (_accounts.Count == 0)
        {
            <AppEmptyState Title="No users" Message="Create a local account or invite someone to an existing profile." />
        }
        else
        {
            <div class="access-users" role="table" aria-label="User accounts">
                <div class="access-users__header" role="row">
                    <span role="columnheader">Account</span><span role="columnheader">Profiles</span><span role="columnheader">Status</span><span role="columnheader">Last active</span><span role="columnheader">Actions</span>
                </div>
                @foreach (var account in _accounts)
                {
                    <div class="access-users__row" role="row" @key="account.Id">
                        <div class="access-users__identity" role="cell">
                            <strong>@AccountLabel(account)</strong>
                            <div class="access-users__badges">
                                @if (account.IsAdministrator) { <AppChip Text="Administrator" Tone="AppUiTone.Primary" /> }
                                @if (account.MustChangePassword) { <AppChip Text="Temporary password" Tone="AppUiTone.Warning" /> }
                                @if (account.HasTwoStep) { <AppChip Text="Two-step codes" Tone="AppUiTone.Success" /> }
                            </div>
                        </div>
                        <div class="access-profile-chips" role="cell">
                            @foreach (var grant in account.ProfileGrants.Take(8))
                            {
                                <span class="access-profile-chip">
                                    <span class="access-profile-chip__avatar">@Initials(grant.DisplayName)</span><span>@grant.DisplayName</span>
                                    @if (grant.AdminEnabled) { <AppMaterialIcon Icon="@AppMaterialIcons.Filled.AdminPanelSettings" Size="AppSize.Small" aria-label="Administrator dashboard allowed" /> }
                                </span>
                            }
                        </div>
                        <div role="cell"><span class="access-status @(account.IsEnabled ? "access-status--enabled" : "access-status--disabled")">@(account.IsEnabled ? "Enabled" : "Disabled")</span></div>
                        <div class="access-users__last-active" role="cell">@(account.LastActiveAt?.ToLocalTime().ToString("g") ?? "Never")</div>
                        <div class="access-users__actions" role="cell">
                            <AppIconButton Icon="@AppMaterialIcons.Filled.MoreVert" AriaLabel="@($"Actions for {AccountLabel(account)}")" OnClick="@(() => ToggleActions(account.Id))" />
                            @if (_actionAccountId == account.Id)
                            {
                                <div class="access-action-menu" role="menu">
                                    @if (account.GrantsInheritFromAccountId is null)
                                    {
                                        <AppButton Label="Edit permissions" FullWidth="true" ButtonStyle="AppButtonStyle.Text" role="menuitem" OnClick="@(() => OpenPermissions(account))" />
                                    }
                                    <AppButton Label="Manage profiles" FullWidth="true" ButtonStyle="AppButtonStyle.Text" role="menuitem" OnClick="@(() => OpenProfiles(account))" />
                                    <AppButton Label="Account details" FullWidth="true" ButtonStyle="AppButtonStyle.Text" role="menuitem" OnClick="@(() => EditAccount(account))" />
                                    <AppButton Label="Set temporary password" FullWidth="true" ButtonStyle="AppButtonStyle.Text" role="menuitem" OnClick="@(() => OpenTemporaryPassword(account))" />
                                    @if (account.HasTwoStep)
                                    {
                                        <AppButton Label="Turn off two-step codes" FullWidth="true" ButtonStyle="AppButtonStyle.Text" role="menuitem" OnClick="@(() => ResetTwoStep(account))" />
                                    }
                                    <AppButton Label="@(account.IsEnabled ? "Disable user" : "Enable user")" FullWidth="true" ButtonStyle="AppButtonStyle.Text" role="menuitem" OnClick="@(() => ToggleEnabled(account))" />
                                    <AppButton Label="Delete user" FullWidth="true" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Error" Class="access-action-menu__danger" role="menuitem" OnClick="@(() => ConfirmDelete(account))" />
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</SettingsSectionPanel>

@if (_open)
{
<div class="access-drawer-host">
<AppDrawer Open="true" OpenChanged="DrawerChanged" Anchor="AppAnchor.End" Width="560px" Overlay="true" Variant="AppDrawerVariant.Temporary" Class="access-drawer">
    <AppFocusTrap DefaultFocus="true">
    <div class="access-drawer__shell" @onkeydown="HandleDrawerKeyDown">
        <header class="access-drawer__header">
            <div><AppText Typo="AppTypo.overline">Access · Users</AppText><AppText Typo="AppTypo.h6">@DrawerTitle</AppText></div>
            <AppIconButton Icon="@AppMaterialIcons.Filled.Close" AriaLabel="Close user drawer" OnClick="Close" />
        </header>
        <div class="access-drawer__body">
            @if (!string.IsNullOrWhiteSpace(_error)) { <AppAlert Severity="AppSeverity.Error">@_error</AppAlert> }
            @if (!string.IsNullOrWhiteSpace(_drawerMessage)) { <AppAlert Severity="AppSeverity.Success">@_drawerMessage</AppAlert> }

            @if (_mode == UserDrawerMode.Account && ShowingCreatedResult)
            {
                @if (_invitation is not null)
                {
                    <InvitationShare Code="@_invitation.Code" ExpiresAt="@_invitation.ExpiresAt" PublicAddress="@_invitation.PublicAddress" />
                }
                else
                {
                    <TemporaryPasswordShare Password="@_issuedTemporaryPassword" ExpiresAt="@_issuedTemporaryPasswordExpiresAt" />
                }
            }
            else if (_mode == UserDrawerMode.Account)
            {
                <section class="access-form-section">
                    <AppText Typo="AppTypo.subtitle1">Account</AppText>
                    <AppTextField @bind-Value="_email" Label="Email" FullWidth="true" />
                    <AppSwitchRow @bind-Value="_administrator" Disabled="@_saving" Label="Administrator eligible" Description="Each profile grant still decides where administrator settings are available." />
                    @if (_editing is not null) { <AppSwitchRow @bind-Value="_enabled" Disabled="@_saving" Label="Account enabled" Description="Disabling the account revokes its access and sessions." /> }
                </section>
                @if (_editing is null)
                {
                    <section class="access-form-section">
                        <AppText Typo="AppTypo.subtitle1">How will they sign in?</AppText>
                        <AppSegmentedControl Options="@SignInChoices" Value="@_signInMethod" ValueChanged="SetSignInMethod" AriaLabel="How will they sign in?" />
                        @if (_signInMethod == TemporaryPasswordMethod)
                        {
                            <small>You choose a password and tell them. They must choose their own the first time they sign in.</small>
                            <AppTextField @bind-Value="_temporaryPassword" Label="Temporary password" HelpText="At least 12 characters, not a common password." FullWidth="true" />
                            <AppButton Label="Generate" Size="AppControlSize.Compact" StartIcon="@AppMaterialIcons.Outlined.AutoAwesome" OnClick="GeneratePassword" />
                        }
                        else
                        {
                            <small>You get a code, a link and a QR code to hand over. They use it to choose their own password.</small>
                        }
                    </section>
                    <section class="access-form-section">
                        <AppText Typo="AppTypo.subtitle1">First profile</AppText>
                        <AppTextField @bind-Value="_profileName" Label="Profile name" FullWidth="true" />
                        <AppTextField @bind-Value="_profileColor" Label="Avatar color" HelpText="Use a color such as #7C4DFF." FullWidth="true" />
                    </section>
                    <ManagedAccessUserPermissions FeatureIds="_featureIds" LibraryIds="_libraryIds" Libraries="_libraries" FeatureChanged="ToggleFeature" LibraryChanged="ToggleLibrary" />
                }
            }
            else if (_mode == UserDrawerMode.Permissions && _editing is not null)
            {
                @if (_editing.IsAdministrator)
                {
                    <AppAlert Severity="AppSeverity.Info">Administrator access overrides normal content restrictions while an administrator-enabled profile is active. These permissions remain editable for other profiles.</AppAlert>
                }
                <ManagedAccessUserPermissions FeatureIds="_featureIds" LibraryIds="_libraryIds" Libraries="_libraries" FeatureChanged="ToggleFeature" LibraryChanged="ToggleLibrary" />
            }
            else if (_mode == UserDrawerMode.Profiles && _editing is not null)
            {
                <section class="access-form-section">
                    <div><AppText Typo="AppTypo.subtitle1">Profile grants</AppText><small>@_editing.ProfileGrants.Count of 8 profiles granted</small></div>
                    @foreach (var grant in _editing.ProfileGrants)
                    {
                        <section class="access-grant" @key="grant.ProfileId">
                            <div class="access-grant__heading"><span class="access-profile-chip__avatar">@Initials(grant.DisplayName)</span><div><strong>@grant.DisplayName</strong><small>@(grant.IsDefault ? "Default profile" : "Granted profile")</small></div></div>
                            <div class="access-grant__rename">
                                <AppTextField Value="@ProfileName(grant)" ValueChanged="@((string value) => _profileNames[grant.ProfileId] = value)" Label="Profile name" FullWidth="true" />
                                <AppButton Label="Rename" Size="AppControlSize.Compact" Disabled="@(string.IsNullOrWhiteSpace(ProfileName(grant)) || ProfileName(grant) == grant.DisplayName)" OnClick="@(() => RenameProfile(grant))" />
                            </div>
                            <AppSwitchRow Value="@grant.IsDefault" ValueChanged="@((bool value) => SaveGrant(grant, value, grant.AdminEnabled))" Disabled="@grant.IsDefault" Label="Default profile" />
                            @if (_editing.IsAdministrator && !grant.IsRestricted)
                            {
                                <AppSwitchRow Value="@grant.AdminEnabled" ValueChanged="@((bool value) => SaveGrant(grant, grant.IsDefault, value))" Disabled="@_saving" Label="Allow admin dashboard" Description="This setting applies only to this account's use of the profile." />
                                @if (grant.AdminEnabled)
                                {
                                    <div class="access-protection">
                                        <div><strong>@(grant.AdminProtection.Enabled ? "Admin settings are protected" : "Protect admin settings")</strong><small>Require a PIN before opening administrator settings from this profile.</small></div>
                                        <AppTextField InputType="AppInputType.Password" Value="@Pin(grant.ProfileId)" ValueChanged="@(value => _pins[grant.ProfileId] = value ?? string.Empty)" Disabled="@_saving" aria-label="@($"New administrator PIN for {grant.DisplayName}")" />
                                        <AppNativeSelect Value="@ProtectionOption(grant.ProfileId)" OnChange="@(value => _protectionOptions[grant.ProfileId] = value.Value?.ToString() ?? "FixedDuration:30")" Disabled="@_saving" aria-label="@($"PIN unlock duration for {grant.DisplayName}")">
                                            <option value="FixedDuration:15">For 15 minutes</option>
                                            <option value="FixedDuration:30">For 30 minutes</option>
                                            <option value="FixedDuration:60">For 1 hour</option>
                                            <option value="UntilProfileSwitch">Until profile switch</option>
                                            <option value="LockOnLeave">Lock when leaving settings</option>
                                        </AppNativeSelect>
                                        <div class="access-protection__actions">
                                            <AppButton Label="@(grant.AdminProtection.Enabled ? "Update protection" : "Enable protection")" Size="AppControlSize.Compact" Disabled="@(_saving || string.IsNullOrWhiteSpace(Pin(grant.ProfileId)))" OnClick="@(() => SaveProtection(grant, true))" />
                                            @if (grant.AdminProtection.Enabled) { <AppButton Label="Remove protection" Size="AppControlSize.Compact" Tone="AppUiTone.Error" Disabled="@_saving" OnClick="@(() => SaveProtection(grant, false))" /> }
                                        </div>
                                    </div>
                                }
                            }
                            <AppButton Label="Revoke profile" Size="AppControlSize.Compact" Tone="AppUiTone.Error" Disabled="@(_saving || _editing.ProfileGrants.Count == 1)" OnClick="@(() => Revoke(grant))" />
                        </section>
                    }
                </section>
                @if (_editing.ProfileGrants.Count < 8)
                {
                    <section class="access-form-section">
                        <AppText Typo="AppTypo.subtitle1">Create a profile</AppText>
                        <AppTextField @bind-Value="_profileName" Label="Profile name" FullWidth="true" />
                        <AppTextField @bind-Value="_profileColor" Label="Avatar color" FullWidth="true" />
                        <AppSwitchRow @bind-Value="_newProfileDefault" Label="Make this the default profile" />
                        <AppButton Label="Create profile" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(_saving || string.IsNullOrWhiteSpace(_profileName))" OnClick="CreateProfile" />
                    </section>
                    @if (GrantableProfiles.Count > 0)
                    {
                        <section class="access-form-section">
                            <AppText Typo="AppTypo.subtitle1">Grant an existing profile</AppText>
                            <AppNativeSelect Value="@_grantProfile" OnChange="@(value => _grantProfile = value.Value?.ToString() ?? string.Empty)" aria-label="Add existing profile">
                                <option value="">Select a profile</option>@foreach (var profile in GrantableProfiles) { <option value="@profile.Id">@profile.DisplayName</option> }
                            </AppNativeSelect>
                            <AppButton Label="Grant profile" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(_saving || string.IsNullOrWhiteSpace(_grantProfile))" OnClick="GrantProfile" />
                        </section>
                    }
                }
                else { <AppAlert Severity="AppSeverity.Info">This account already has the maximum of eight profiles.</AppAlert> }
            }
            else if (_mode == UserDrawerMode.Invitation)
            {
                <section class="access-form-section">
                    <AppText Typo="AppTypo.subtitle1">Invite by email</AppText>
                    <AppTextField @bind-Value="_email" Label="Email" FullWidth="true" />
                    <small>Select between one and eight existing profiles. The invitation creates a remote-capable account.</small>
                    <div class="access-permission-list">
                        @foreach (var profile in _profiles) { <AppCheckbox Value="@_invitationProfiles.Contains(profile.Id)" ValueChanged="@((bool value) => ToggleInvitationProfile(profile.Id, value))" Label="@profile.DisplayName" /> }
                    </div>
                    @if (_invitationProfiles.Count > 0)
                    {
                        <AppNativeSelect Value="@(_invitationDefault?.ToString("D") ?? string.Empty)" OnChange="SetInvitationDefault" aria-label="Invitation default profile">
                            @foreach (var profile in _profiles.Where(profile => _invitationProfiles.Contains(profile.Id))) { <option value="@profile.Id">@profile.DisplayName</option> }
                        </AppNativeSelect>
                    }
                </section>
                <ManagedAccessUserPermissions FeatureIds="_featureIds" LibraryIds="_libraryIds" Libraries="_libraries" FeatureChanged="ToggleFeature" LibraryChanged="ToggleLibrary" />
                @if (_invitation is not null)
                {
                    <InvitationShare Code="@_invitation.Code" ExpiresAt="@_invitation.ExpiresAt" PublicAddress="@_invitation.PublicAddress" />
                }
            }
            else if (_mode == UserDrawerMode.TemporaryPassword && _editing is not null)
            {
                @if (!string.IsNullOrEmpty(_issuedTemporaryPassword))
                {
                    <TemporaryPasswordShare Password="@_issuedTemporaryPassword" ExpiresAt="@_issuedTemporaryPasswordExpiresAt" />
                }
                else
                {
                    <section class="access-form-section">
                        <AppText Typo="AppTypo.subtitle1">Set a temporary password</AppText>
                        <small>This signs @EditingLabel out everywhere. They will have to use the temporary password, then choose their own.</small>
                        <AppTextField @bind-Value="_temporaryPassword" Label="Temporary password" HelpText="At least 12 characters, not a common password." FullWidth="true" />
                        <AppButton Label="Generate" Size="AppControlSize.Compact" StartIcon="@AppMaterialIcons.Outlined.AutoAwesome" OnClick="GeneratePassword" />
                    </section>
                }
            }
            else if (_mode == UserDrawerMode.AddPerson)
            {
                <section class="access-form-section">
                    <AppText Typo="AppTypo.subtitle1">Add a person</AppText>
                    <small>They join this household and share its library. You can give them their own sign-in afterwards.</small>
                    <AppTextField @bind-Value="_profileName" Label="Name" FullWidth="true" />
                    <AppSwitchRow @bind-Value="_personIsChild" Disabled="@_saving" Label="Child profile" Description="A child profile is restricted: it can't open settings and can't be an administrator." />
                    <AppTextField InputType="AppInputType.Password" @bind-Value="_personPin" Label="PIN (optional)" HelpText="4 to 12 digits. Asked before switching into this person." FullWidth="true" />
                </section>
            }
            else if (_mode == UserDrawerMode.OwnSignIn && _targetProfile is not null)
            {
                @if (_invitation is not null)
                {
                    <InvitationShare Code="@_invitation.Code" ExpiresAt="@_invitation.ExpiresAt" PublicAddress="@_invitation.PublicAddress" />
                }
                else if (!string.IsNullOrEmpty(_issuedTemporaryPassword))
                {
                    <TemporaryPasswordShare Password="@_issuedTemporaryPassword" ExpiresAt="@_issuedTemporaryPasswordExpiresAt" />
                }
                else
                {
                    <section class="access-form-section">
                        <AppText Typo="AppTypo.subtitle1">Give @_targetProfile.DisplayName their own sign-in</AppText>
                        <small>It opens straight to @_targetProfile.DisplayName, who stays in the household with the same library access. This sign-in is never an administrator.</small>
                        <AppTextField @bind-Value="_email" Label="Email" FullWidth="true" />
                        <AppSegmentedControl Options="@SignInChoices" Value="@_signInMethod" ValueChanged="SetSignInMethod" AriaLabel="How will they sign in?" />
                        @if (_signInMethod == TemporaryPasswordMethod)
                        {
                            <small>You choose a password and tell them. They must choose their own the first time they sign in.</small>
                            <AppTextField @bind-Value="_temporaryPassword" Label="Temporary password" HelpText="At least 12 characters, not a common password." FullWidth="true" />
                            <AppButton Label="Generate" Size="AppControlSize.Compact" StartIcon="@AppMaterialIcons.Outlined.AutoAwesome" OnClick="GeneratePassword" />
                        }
                        else
                        {
                            <small>You get a code, a link and a QR code to hand over. They use it to choose their own password.</small>
                        }
                    </section>
                }
            }
            else if (_mode == UserDrawerMode.RemoveOwnSignIn && _targetProfile is not null && _targetAccount is not null)
            {
                <AppAlert Severity="AppSeverity.Warning">Remove @AccountLabel(_targetAccount)? @_targetProfile.DisplayName stays in the household with everything they have saved. This sign-in, its sessions and its paired devices stop working.</AppAlert>
            }
            else if (_mode == UserDrawerMode.Delete && _editing is not null)
            {
                <AppAlert Severity="AppSeverity.Warning">Delete @AccountLabel(_editing)? This revokes the account and its profile grants. Personal media files are kept.</AppAlert>
                <p>This action cannot be undone from the Dashboard.</p>
            }
        </div>
        <footer class="access-drawer__footer">
            <AppButton Label="@(ShowingResult ? "Done" : "Cancel")" OnClick="Close" />
            @if (_mode == UserDrawerMode.Account && !ShowingCreatedResult) { <AppButton Label="@(_editing is null ? "Create user" : "Save account")" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@(_saving || !CanSaveAccount)" OnClick="SaveAccount" /> }
            else if (_mode == UserDrawerMode.TemporaryPassword && string.IsNullOrEmpty(_issuedTemporaryPassword)) { <AppButton Label="Set temporary password" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@(_saving || string.IsNullOrWhiteSpace(_temporaryPassword))" OnClick="SetTemporaryPassword" /> }
            else if (_mode == UserDrawerMode.Permissions) { <AppButton Label="Save permissions" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@_saving" OnClick="SavePermissions" /> }
            else if (_mode == UserDrawerMode.Invitation && _invitation is null) { <AppButton Label="Create invitation" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@(_saving || string.IsNullOrWhiteSpace(_email) || _invitationProfiles.Count == 0)" OnClick="CreateInvitation" /> }
            else if (_mode == UserDrawerMode.AddPerson) { <AppButton Label="Add person" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@(_saving || string.IsNullOrWhiteSpace(_profileName))" OnClick="AddPerson" /> }
            else if (_mode == UserDrawerMode.OwnSignIn && !ShowingResult) { <AppButton Label="Create sign-in" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@(_saving || !CanCreateOwnSignIn)" OnClick="GiveOwnSignIn" /> }
            else if (_mode == UserDrawerMode.RemoveOwnSignIn) { <AppButton Label="Remove sign-in" Tone="AppUiTone.Error" ButtonStyle="AppButtonStyle.Filled" Disabled="@_saving" OnClick="RemoveOwnSignIn" /> }
            else if (_mode == UserDrawerMode.Delete) { <AppButton Label="Delete user" Tone="AppUiTone.Error" ButtonStyle="AppButtonStyle.Filled" Disabled="@_saving" OnClick="DeleteAccount" /> }
        </footer>
    </div>
    </AppFocusTrap>
</AppDrawer>
</div>
}

@code {
    private readonly HashSet<string> _featureIds = new(StringComparer.Ordinal);
    private readonly HashSet<Guid> _libraryIds = [];
    private readonly HashSet<Guid> _invitationProfiles = [];
    private readonly Dictionary<Guid, string> _profileNames = [];
    private readonly Dictionary<Guid, string> _pins = [];
    private readonly Dictionary<Guid, string> _protectionOptions = [];
    private List<AccountAccessResponse> _accounts = [];
    private List<ManagedProfileResponse> _profiles = [];
    private List<AccessLibraryOptionDto> _libraries = [];
    private AccountAccessResponse? _editing;
    private AccountInvitationResponse? _invitation;
    private UserDrawerMode _mode;
    private Guid? _actionAccountId;
    private Guid? _invitationDefault;
    private long _drawerGeneration;
    private bool _loading = true;
    private bool _open;
    private bool _saving;
    private bool _administrator;
    private bool _enabled = true;
    private bool _newProfileDefault;
    private string _email = string.Empty;
    private string _profileName = string.Empty;
    private string _profileColor = "#7C4DFF";
    private string _grantProfile = string.Empty;
    private string _error = string.Empty;
    private string _drawerMessage = string.Empty;
    private string _notice = string.Empty;
    private string _signInMethod = InvitationMethod;
    private string _temporaryPassword = string.Empty;
    private string _issuedTemporaryPassword = string.Empty;
    private DateTimeOffset? _issuedTemporaryPasswordExpiresAt;
    private Guid? _householdId;
    private ManagedProfileResponse? _targetProfile;
    private AccountAccessResponse? _targetAccount;
    private bool _personIsChild;
    private string _personPin = string.Empty;
    private ElementReference _returnFocus;
    private bool _restoreFocus;

    private const string InvitationMethod = "invitation";
    private const string TemporaryPasswordMethod = "temporary";
    private static readonly IReadOnlyList<AppSelectOption> SignInChoices =
    [
        new(InvitationMethod, "Send an invitation"),
        new(TemporaryPasswordMethod, "Set a temporary password"),
    ];

    private bool CanManage => Session.HasAction("access.manage");
    private bool ShowingCreatedResult => _editing is null && (_invitation is not null || !string.IsNullOrEmpty(_issuedTemporaryPassword));
    private bool CanCreateOwnSignIn => !string.IsNullOrWhiteSpace(_email)
        && (_signInMethod != TemporaryPasswordMethod || !string.IsNullOrWhiteSpace(_temporaryPassword));
    private IReadOnlyList<HouseholdView> Households => _profiles
        .Where(profile => profile.HouseholdId is not null)
        .GroupBy(profile => profile.HouseholdId!.Value)
        .Select(group =>
        {
            var members = _accounts.Where(account => account.HouseholdId == group.Key).ToList();
            var main = members.Where(account => account.GrantsInheritFromAccountId is null).OrderBy(account => account.CreatedAt).FirstOrDefault();
            var people = group.OrderBy(profile => profile.CreatedAt)
                .Select(profile => new PersonView(profile, members.FirstOrDefault(account =>
                    account.GrantsInheritFromAccountId is not null
                    && account.ProfileGrants.Count(grant => grant.IsEnabled) == 1
                    && account.ProfileGrants.Any(grant => grant.IsEnabled && grant.ProfileId == profile.Id))))
                .ToList();
            return new HouseholdView(group.Key, main?.Email is { } email ? $"{email}'s household" : "Household", people);
        })
        .OrderBy(household => household.Label, StringComparer.CurrentCultureIgnoreCase)
        .ToList();
    private sealed record PersonView(ManagedProfileResponse Profile, AccountAccessResponse? OwnSignIn);
