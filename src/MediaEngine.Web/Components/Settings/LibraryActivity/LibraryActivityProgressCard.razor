@namespace MediaEngine.Web.Components.Settings.LibraryActivity
@using MediaEngine.Contracts.Ingestion
@using MediaEngine.Web.Components.Navigation
@using MediaEngine.Web.Components.Settings
@inject IStringLocalizer<SharedStrings> L

@* The one progress card (spec library-activity D5): everything Library is doing in one ring with its percent, the counts found by kind
   and Review N items (Shy 10 Nov: very simple, no bar, no started line). Nothing per library. Its counts line uses the same words as a finished batch. When nothing runs it is replaced by the
   up-to-date line, which has no icon and no bar. *@
@if (Working)
{
    <section class="lact-summary" data-testid="activity-progress-card" aria-live="polite">
        <div class="lact-summary__head">
            @* The same ring as the top bar's spinner: it fills as the percent grows and the Sync glyph sits inside it. *@
            <span class="lact-summary__ring" aria-hidden="true">
                @if (Percent is { } ringValue)
                {
                    <AppSpinner Indeterminate="false" Value="@ringValue" Size="AppSize.Small" StrokeWidth="2" />
                }
                else
                {
                    <AppSpinner Indeterminate="true" Size="AppSize.Small" StrokeWidth="2" />
                }
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Sync" Size="AppIconSize.Control20" />
            </span>
            <strong class="lact-summary__title">@L["LibraryActivity_Updating"]</strong>
            @if (Percent is { } percent)
            {
                <strong data-testid="activity-progress-percent">@L["LibraryActivity_PercentProcessed", percent]</strong>
            }
        </div>
        <div class="lact-summary__foot">
            <span class="lact-summary__counts" data-testid="activity-progress-counts">@CountsLine</span>
            @if (ReviewCount > 0)
            {
                <AppLink Href="/settings/review" Class="lact-summary__review">@(ReviewCount == 1 ? L["LibraryActivity_ReviewOneItem"] : L["LibraryActivity_ReviewItems", ReviewCount.ToString("N0")])</AppLink>
            }
        </div>
    </section>
}
else
{
    <section class="lact-summary lact-summary--idle" data-testid="activity-up-to-date">
        <strong>@L["LibraryActivity_UpToDate"]</strong>
        @if (LastCompleted is { } last)
        {
            <span> · @L["LibraryActivity_LastCompletedScan", LibraryActivityText.Ago(last, DateTimeOffset.UtcNow)]</span>
        }
    </section>
}

@* D27: files nobody has picked up cannot hold the run "working"; they are named here, in the working and the up-to-date states alike. *@
@if (FilesWaiting > 0)
{
    <p class="lact-waiting" data-testid="activity-files-waiting"><strong>@L["LibraryActivity_SomeFilesWaiting"]</strong> · @(FilesWaiting == 1 ? L["LibraryActivity_OneFileWaiting"] : L["LibraryActivity_FilesWaiting", FilesWaiting.ToString("N0")])</p>
}

@code {
    [Parameter] public IngestionQueueProgressDto? Queue { get; set; }
    [Parameter] public IngestionPresentationSnapshotDto? Presentation { get; set; }

    /// <summary>The media types the library chips allow; empty means every type.</summary>
    [Parameter] public IReadOnlySet<string>? MediaTypes { get; set; }

    [Parameter] public DateTimeOffset? LastCompleted { get; set; }

    private bool Working => Queue is { State: "working" } || Presentation is { IsRunning: true };

    // With area chips chosen every number on the card belongs to those areas (D5); the top bar's ring keeps the whole library's percent.
    private bool Scoped => MediaTypes is { Count: > 0 };

    private IEnumerable<IngestionQueueTypeTallyDto> Tally => (Queue?.Tally ?? [])
        .Where(entry => !Scoped || MediaTypes!.Contains(entry.MediaType));

    private IEnumerable<IngestionPresentationTypeDto> PresentationTypes => (Presentation?.ByType ?? [])
        .Where(entry => MediaTypes!.Contains(entry.MediaType));

    private int Found => Scoped ? Tally.Sum(entry => entry.Files) : Queue?.FilesFound ?? Presentation?.FilesDiscovered ?? 0;

    // The same rule as the top bar's ring (rounded down, never 100 while still working), added up from the chosen areas' own step counts.
    private int? Percent => Queue is null ? null : IngestionQueueProgressText.Percent(Queue, MediaTypes);

    private int Ready => Scoped ? PresentationTypes.Sum(entry => entry.ReadyGroups) : Presentation?.ReadyGroups ?? 0;
    // The one "need review" number (D28): the Engine counts it as the Needs Review list does, so it is the whole number even with chips picked.
    private int ReviewCount => Presentation?.NeedReviewCount ?? 0;
    private int Processing => Scoped ? PresentationTypes.Sum(entry => entry.ActiveOperations) : Presentation?.ActiveOperations ?? 0;
    private int Queued => Scoped ? PresentationTypes.Sum(entry => entry.QueuedOperations) : Presentation?.QueuedOperations ?? 0;

    // Files held back with no tool to blame (nobody picked them up, D27) are named; files waiting for a missing tool have their own notice.
    private int FilesWaiting => Queue is { FilesWaiting: > 0 } queue
        && !queue.WaitingFor.Any(tool => !string.Equals(tool, IngestionQueueProgressText.UnclaimedId, StringComparison.OrdinalIgnoreCase))
        ? queue.FilesWaiting
        : 0;

    private string CountsLine
    {
        get
        {
            var parts = new List<string>();
            var found = LibraryActivityText.Counts(Tally.Select(entry => (entry.MediaType, entry.Files)));
            parts.Add(string.IsNullOrEmpty(found)
                ? L["LibraryActivity_FilesFound", Found.ToString("N0")].Value
                : L["LibraryActivity_CountsFound", found].Value);
            if (Ready > 0) parts.Add(L["LibraryActivity_Ready", Ready.ToString("N0")].Value);
            if (ReviewCount > 0) parts.Add(L["LibraryActivity_NeedReview", ReviewCount.ToString("N0")].Value);
            if (Processing > 0) parts.Add(L["LibraryActivity_Processing", Processing.ToString("N0")].Value);
            if (Queued > 0) parts.Add(L["LibraryActivity_Queued", Queued.ToString("N0")].Value);

            return string.Join(" · ", parts);
        }
    }
}
