@namespace MediaEngine.Web.Components.Settings.LibraryActivity
@using MediaEngine.Contracts.Ingestion
@using MediaEngine.Web.Components.Navigation
@using MediaEngine.Web.Components.Settings
@inject IStringLocalizer<SharedStrings> L

@* The one slim progress card (spec library-activity D32, D36), drawn on the Activity page only (the Libraries page has just a one-line status, no bar).
   Left: the same animated sync icon as the top bar, the title and an "In progress" dot-label. Under it one line, "427 of 538 files processed ·
   16 min elapsed". Right: one amber "N need review" pill that opens Needs Review (hidden at zero). Along the bottom: a thin bar with the percent at
   its right end, the same truthful number as the top bar (D23). With the total not yet known it reads "412 files found" over a moving bar and shows no
   percent. When nothing runs it is replaced by the up-to-date sentence, which has no icon and no bar. *@
@if (Working)
{
    <section class="lact-progress" data-testid="activity-progress-card" aria-live="polite">
        <span class="lact-progress__icon"><AppSyncActivityIcon Percent="@Percent" Working="true" Spinning="true" /></span>
        <div class="lact-progress__head">
            <strong class="lact-progress__title">@L["LibraryActivity_Updating"]</strong>
            <span class="lact-progress__state" data-testid="activity-in-progress"><i class="lact-progress__dot" aria-hidden="true"></i>@L["LibraryActivity_InProgress"]</span>
        </div>
        <span class="lact-progress__line" data-testid="activity-progress-counts">@Line</span>
        @if (ReviewCount > 0 && ShowReview)
        {
            <div class="lact-progress__actions">
                <a href="/settings/review" class="lact-progress__pill" data-testid="activity-need-review">@ReviewText</a>
            </div>
        }
        <div class="lact-progress__bar">
            <AppProgressBar Value="@(Percent ?? 0)"
                            ShowValue="@(Percent is not null)"
                            Indeterminate="@(Percent is null)"
                            Rounded="true"
                            Title="@L["LibraryActivity_Progress"].Value"
                            data-testid="activity-progress-bar" />
        </div>
    </section>
}
else
{
    <section class="lact-progress lact-progress--idle" data-testid="activity-up-to-date">
        <span class="lact-progress__idle-text">
            <strong>@L["LibraryActivity_UpToDate"]</strong>
            @if (LastCompleted is { } last)
            {
                <span> · @L["LibraryActivity_LastCompletedScan", LibraryActivityText.Ago(last, DateTimeOffset.UtcNow)]</span>
            }
        </span>
    </section>
}

@* D27: files nobody has picked up cannot hold the run "working"; they are named here, in the working and the up-to-date states alike. *@
@if (FilesWaiting > 0)
{
    <p class="lact-waiting" data-testid="activity-files-waiting"><strong>@L["LibraryActivity_SomeFilesWaiting"]</strong> · @(FilesWaiting == 1 ? L["LibraryActivity_OneFileWaiting"] : L["LibraryActivity_FilesWaiting", FilesWaiting.ToString("N0")])</p>
}

@code {
    [Parameter] public IngestionQueueProgressDto? Queue { get; set; }
    [Parameter] public IngestionPresentationSnapshotDto? Presentation { get; set; }

    /// <summary>The media types the library chips allow; empty means every type.</summary>
    [Parameter] public IReadOnlySet<string>? MediaTypes { get; set; }

    [Parameter] public DateTimeOffset? LastCompleted { get; set; }

    /// <summary>The "N need review" pill; a host that is not for administrators turns it off.</summary>
    [Parameter] public bool ShowReview { get; set; } = true;

    private bool Working => Queue is { State: "working" } || Presentation is { IsRunning: true };

    // With area chips chosen every number on the card belongs to those areas (D5); the top bar's ring keeps the whole library's percent.
    private bool Scoped => MediaTypes is { Count: > 0 };

    private IEnumerable<IngestionQueueTypeTallyDto> Tally => (Queue?.Tally ?? [])
        .Where(entry => !Scoped || MediaTypes!.Contains(entry.MediaType));

    private int Found => Scoped ? Tally.Sum(entry => entry.Files) : Queue?.FilesFound ?? Presentation?.FilesDiscovered ?? 0;

    private int Done => Scoped ? Tally.Sum(entry => entry.FilesDone) : Queue?.FilesDone ?? 0;

    // The same rule as the top bar's ring (rounded down, never 100 while still working), added up from the chosen areas' own step counts.
    // Null while the total is not known yet.
    private int? Percent => Queue is null ? null : IngestionQueueProgressText.Percent(Queue, MediaTypes);

    // The one "need review" number (D28): the Engine counts it as the Needs Review list does, so it is the whole number even with chips picked.
    private int ReviewCount => Presentation?.NeedReviewCount ?? 0;

    private string ReviewText => ReviewCount == 1
        ? L["LibraryActivity_NeedReviewOne"].Value
        : L["LibraryActivity_NeedReview", ReviewCount.ToString("N0")].Value;

    // Files held back with no tool to blame (nobody picked them up, D27) are named; files waiting for a missing tool have their own notice.
    private int FilesWaiting => Queue is { FilesWaiting: > 0 } queue
        && !queue.WaitingFor.Any(tool => !string.Equals(tool, IngestionQueueProgressText.UnclaimedId, StringComparison.OrdinalIgnoreCase))
        ? queue.FilesWaiting
        : 0;

    // "427 of 538 files processed · 16 min elapsed"; with the total not known yet, just "412 files found".
    private string Line
    {
        get
        {
            if (Percent is null)
            {
                return L["LibraryActivity_FilesFound", Found.ToString("N0")].Value;
            }

            var processed = Found == 1
                ? L["LibraryActivity_FilesProcessedOne", Done.ToString("N0")].Value
                : L["LibraryActivity_FilesProcessed", Done.ToString("N0"), Found.ToString("N0")].Value;
            return Queue?.StartedAt is { } started
                ? $"{processed} · {L["LibraryActivity_Elapsed", IngestionQueueProgressText.FormatElapsed(DateTimeOffset.UtcNow - started.ToUniversalTime())].Value}"
                : processed;
        }
    }
}
