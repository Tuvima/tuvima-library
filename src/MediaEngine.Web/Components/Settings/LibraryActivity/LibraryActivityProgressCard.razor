@namespace MediaEngine.Web.Components.Settings.LibraryActivity
@using MediaEngine.Contracts.Ingestion
@using MediaEngine.Web.Components.Navigation
@inject IStringLocalizer<SharedStrings> L

@* The one progress card (spec library-activity D5): everything Library is doing, one overall bar, the counts found by kind, and Review N items.
   Nothing per library. Its counts line uses the same words as a finished batch. When nothing runs it is replaced by the up-to-date line. *@
@if (Working)
{
    <section class="lact-summary" data-testid="activity-progress-card" aria-live="polite">
        <div class="lact-summary__head">
            <strong><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Sync" /> @L["LibraryActivity_Updating"]</strong>
            @if (Percent is { } percent)
            {
                <strong>@L["LibraryActivity_PercentProcessed", percent]</strong>
            }
        </div>
        @if (Percent is { } value)
        {
            <AppProgressBar Value="@value" Decorative="true" />
        }
        else
        {
            <AppProgressBar Indeterminate="true" Decorative="true" />
        }
        <div class="lact-summary__foot">
            <span data-testid="activity-progress-counts">@CountsLine</span>
            @if (ReviewCount > 0)
            {
                <AppLink Href="/settings/review">@(ReviewCount == 1 ? L["LibraryActivity_ReviewOneItem"] : L["LibraryActivity_ReviewItems", ReviewCount.ToString("N0")])</AppLink>
            }
        </div>
    </section>
}
else
{
    <section class="lact-summary lact-summary--idle" data-testid="activity-up-to-date">
        <strong><AppMaterialIcon Icon="@AppMaterialIcons.Outlined.CheckCircle" /> @L["LibraryActivity_UpToDate"]</strong>
        @if (LastCompleted is { } last)
        {
            <span> · @L["LibraryActivity_LastCompletedScan", LibraryActivityText.Ago(last, DateTimeOffset.UtcNow)]</span>
        }
    </section>
}

@code {
    [Parameter] public IngestionQueueProgressDto? Queue { get; set; }
    [Parameter] public IngestionPresentationSnapshotDto? Presentation { get; set; }

    /// <summary>The media types the library chips allow; empty means every type.</summary>
    [Parameter] public IReadOnlySet<string>? MediaTypes { get; set; }

    [Parameter] public DateTimeOffset? LastCompleted { get; set; }

    private bool Working => Queue is { State: "working" } || Presentation is { IsRunning: true };

    private IEnumerable<IngestionQueueTypeTallyDto> Tally => (Queue?.Tally ?? [])
        .Where(entry => MediaTypes is null || MediaTypes.Count == 0 || MediaTypes.Contains(entry.MediaType));

    private int Found => MediaTypes is { Count: > 0 } ? Tally.Sum(entry => entry.Files) : Queue?.FilesFound ?? Presentation?.FilesDiscovered ?? 0;

    private int? Percent => Queue is { FilesFound: > 0 } queue
        ? (int)Math.Clamp(Math.Round(queue.Progress * 100), 0, 100)
        : null;

    private int ReviewCount => Presentation?.ReviewGroups ?? 0;

    private string CountsLine
    {
        get
        {
            var parts = new List<string>();
            var found = LibraryActivityText.Counts(Tally.Select(entry => (entry.MediaType, entry.Files)));
            parts.Add(string.IsNullOrEmpty(found)
                ? L["LibraryActivity_FilesFound", Found.ToString("N0")].Value
                : L["LibraryActivity_CountsFound", found].Value);
            if (Presentation is { } presentation)
            {
                if (presentation.ReadyGroups > 0) parts.Add(L["LibraryActivity_Ready", presentation.ReadyGroups.ToString("N0")].Value);
                if (presentation.ReviewGroups > 0) parts.Add(L["LibraryActivity_NeedReview", presentation.ReviewGroups.ToString("N0")].Value);
                if (presentation.ActiveOperations > 0) parts.Add(L["LibraryActivity_Processing", presentation.ActiveOperations.ToString("N0")].Value);
                if (presentation.QueuedOperations > 0) parts.Add(L["LibraryActivity_Queued", presentation.QueuedOperations.ToString("N0")].Value);
            }

            return string.Join(" · ", parts);
        }
    }
}
