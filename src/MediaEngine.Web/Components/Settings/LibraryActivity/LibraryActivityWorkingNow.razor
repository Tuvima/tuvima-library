@namespace MediaEngine.Web.Components.Settings.LibraryActivity
@using MediaEngine.Contracts.Ingestion
@inject IStringLocalizer<SharedStrings> L
@inject IJSRuntime JS
@implements IAsyncDisposable
@using MediaEngine.Web.Components.Settings

@* Working now (spec library-activity D6, D7, D34): one row of small tiles, each with the flush status label for what Library is doing to that title
   and a flush count or step at the bottom-left. The row shows only as many tiles as fit across (measured, so it never scrolls and never cuts one off),
   at most 10 at a time, each held at least 2 seconds; when more titles are in progress than fit, it rotates through them. The heading says how many
   there are in all. Hidden when nothing runs. Background work is one plain line with no bar of its own. *@
@if (Items.Count > 0)
{
    <section class="lact-working" data-testid="activity-working-now" aria-labelledby="lact-working-title">
        <h2 id="lact-working-title" class="lact-heading" data-testid="activity-working-now-heading">@Heading</h2>
        <div class="lact-working__row" data-testid="activity-working-now-row" @ref="_row">
            @foreach (var item in _rotation.Shown)
            {
                <LibraryActivityTile @key="item.GroupId"
                              Compact="true"
                              Title="@IngestionMediaCard.DisplayTitleFor(item.Title)"
                              CoverUrl="@item.CoverUrl"
                              MediaType="@item.MediaType"
                              Route="@item.DetailRoute"
                              StatusLabel="@(string.IsNullOrWhiteSpace(item.CurrentGateLabel) ? item.StatusLabel : item.CurrentGateLabel)"
                              BottomLabel="@Step(item)" />
            }
        </div>
    </section>
}
@if (Background.Count > 0)
{
    <p class="lact-background" data-testid="activity-background"><strong>@L["LibraryActivity_Background"]</strong> · @string.Join(" · ", Background)</p>
}

@code {
    // Until the browser reports how many fit, the row aims for the most it ever shows; the row's own CSS clips anything past one line.
    private const int FallbackFit = WorkingNowRotation.MaxShown;

    private WorkingNowRotation _rotation = new();
    private ElementReference _row;
    private string? _attachedRowId;
    private int _fit = FallbackFit;
    private ITimer? _timer;
    private IJSObjectReference? _module;
    private DotNetObjectReference<LibraryActivityWorkingNow>? _self;

    [Parameter] public IReadOnlyList<IngestionMediaGroupDto> Items { get; set; } = [];

    /// <summary>How many titles are in progress in all (the Engine's own count, which can be more than it lists); never below what is listed.</summary>
    [Parameter] public int? Total { get; set; }

    /// <summary>
    /// Plain names of the background work now running (follow-up jobs such as preview pictures with their count, AI, maintenance); empty hides
    /// the line. Background work is never "working" (D29): <see cref="Items"/> holds only titles being added, identified or having details fetched.
    /// </summary>
    [Parameter] public IReadOnlyList<string> Background { get; set; } = [];

    /// <summary>The clock the 2-second hold and the rotation run on; tests pass a fake one.</summary>
    [Parameter] public TimeProvider? Clock { get; set; }

    private string Heading
    {
        get
        {
            var total = Math.Max(Total ?? 0, _rotation.Total);
            return total == 1
                ? L["LibraryActivity_WorkingNowOne"].Value
                : string.Format(System.Globalization.CultureInfo.CurrentCulture, L["LibraryActivity_WorkingNowMany"].Value, total);
        }
    }

    protected override void OnInitialized()
    {
        var clock = Clock ?? TimeProvider.System;
        _rotation = new WorkingNowRotation(clock);
        _timer = clock.CreateTimer(_ => _ = InvokeAsync(Tick), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    protected override void OnParametersSet() => _rotation.Update(Items, _fit);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Items.Count == 0 || _row.Id is null || _row.Id == _attachedRowId)
        {
            return;
        }

        _attachedRowId = _row.Id;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/working-now-fit.js");
        _self ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attach", _row, _self);
    }

    /// <summary>Called by the browser when the number of tiles that fit across the row changes (the width changed).</summary>
    [JSInvokable]
    public Task OnFit(int fit)
    {
        return InvokeAsync(() =>
        {
            _fit = fit;
            if (_rotation.Update(Items, _fit))
            {
                StateHasChanged();
            }
        });
    }

    private void Tick()
    {
        if (_rotation.NeedsTick && _rotation.Tick())
        {
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        _self?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser circuit is already gone, so there is nothing left to release.
            }
        }
    }

    private static string? Step(IngestionMediaGroupDto item)
    {
        if (item.ChildUnit is { Length: > 0 } unit && item.ChildCompleted > 0)
        {
            var noun = item.ChildCompleted == 1 && unit.EndsWith('s') ? unit[..^1] : unit;
            return $"{item.ChildCompleted:N0} {noun}";
        }

        return string.IsNullOrWhiteSpace(item.Subtitle) ? null : item.Subtitle;
    }
}
