@namespace MediaEngine.Web.Components.Settings.LibraryActivity
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient Api
@inject IStringLocalizer<SharedStrings> L
@inject IngestionLiveDashboardState Dashboard
@inject ShellActivityState Shell
@inject DeviceContextService DeviceContext
@inject MediaEngine.Web.Services.Ui.IAppDialogService Dialogs
@inject MediaEngine.Web.Services.Settings.LibraryKindsState LibraryKinds
@implements IAsyncDisposable

@* The Library Activity page (spec library-activity, administrators only). Working now at the top while something runs, History as a vertical
   timeline underneath. With nothing running it opens on History. The library tab of one library shows this same page filtered to it. *@
<div class="lact-page" data-testid="library-activity-page">
    <header class="lact-header">
        @* The host already names the page (the Settings frame's title, or the library's own page and its Activity tab), so it asks for no second title. *@
        @if (ShowTitle)
        {
            <h1 class="lact-title-main">@L["LibraryActivity_Title"]</h1>
        }
        @* Live means the page updates by itself: green while connected to the Engine, quiet "Not live" otherwise (busy or idle makes no difference). *@
        <span class="lact-live @(IsLive ? "is-live" : null)" data-testid="lact-live" data-live="@(IsLive ? "true" : "false")"><span class="lact-live__dot" aria-hidden="true"></span> @(IsLive ? L["LibraryActivity_Live"] : L["LibraryActivity_NotLive"])</span>
    </header>

    @if (LibraryId is null)
    {
        @* Each area chip is outlined in its own area colour (the same lib-chip look as the Libraries page). All libraries is an on/off chip like the others, with no arrow. *@
        <div class="lact-chips" role="group" aria-label="@L["LibraryActivity_Areas"]" data-testid="lact-chips">
            <AppToggleChip Pressed="@(_area is null)" Class="@ChipClass(null)" OnClick="@(() => PickAreaAsync(null))">
                @L["LibraryActivity_AllLibraries"]
            </AppToggleChip>
            @foreach (var area in Areas)
            {
                <AppToggleChip Pressed="@(_area == area.Key)" Class="@ChipClass(area.Key)" OnClick="@(() => PickAreaAsync(area.Key))">@L[area.LabelKey]</AppToggleChip>
            }
        </div>
    }

    <LibraryActivityProgressCard Queue="Dashboard.QueueProgress"
                                 Presentation="Dashboard.Presentation"
                                 MediaTypes="MediaTypes"
                                 LastCompleted="_lastCompleted" />

    <LibraryActivityWorkingNow Items="WorkingItems" Background="BackgroundNames" />

    <LibraryActivityHistory LibraryIds="LibraryIds"
                            MediaTypes="AreaMediaTypes"
                            RefreshToken="_refresh"
                            NoLibraries="NoLibraries"
                            OnAddLibrary="@(CanAddLibrary ? EventCallback.Factory.Create(this, AddLibraryAsync) : default)"
                            LastCompletedChanged="OnLastCompleted" />
</div>

@code {
    private static readonly (string Key, string LabelKey, string[] MediaTypes)[] Areas =
    [
        ("watch", "LibraryActivity_AreaWatch", ["Movies", "TV", "Videos"]),
        ("listen", "LibraryActivity_AreaListen", ["Music", "Audiobooks"]),
        ("read", "LibraryActivity_AreaRead", ["Books", "Comics"]),
    ];

    /// <summary>When set, the page is one library's Activity tab: filtered to that library, with no area chips.</summary>
    [Parameter] public string? LibraryId { get; set; }

    /// <summary>Whether the page draws its own "Activity" title. Both hosts name the page themselves, so they turn it off.</summary>
    [Parameter] public bool ShowTitle { get; set; } = true;

    private LibrariesConfigurationDto? _configuration;
    private IReadOnlyList<LibraryFolderDto> _libraries = [];
    private string? _area;
    private int _refresh;
    private bool _wasRunning;
    private bool _disposed;
    private DateTimeOffset? _lastCompleted;

    private bool Working => Dashboard.QueueProgress is { State: "working" } || Dashboard.Presentation is { IsRunning: true };

    // History's empty state offers Add library when there is nothing to show because there are no libraries at all.
    private bool NoLibraries => LibraryId is null && _configuration is not null && _libraries.Count == 0;

    // The same rule as the Libraries page's Add library button: not on a phone (the page itself is for administrators only).
    private bool CanAddLibrary => !DeviceContext.IsMobile;

    private async Task AddLibraryAsync()
    {
        if (_configuration is null)
        {
            return;
        }

        await LibraryKinds.EnsureLoadedAsync();
        await LibraryAddFlow.OpenAsync(
            Dialogs, _configuration, LibraryKinds.Catalog, areaKey: null, vaultVisible: false, setup: false, setupSession: null,
            async _ =>
            {
                _configuration = await Api.GetLibrariesAsync() ?? _configuration;
                _libraries = _configuration.Libraries;
                await InvokeAsync(StateHasChanged);
            });
    }

    private bool IsLive => Dashboard.ConnectionState == EngineConnectionState.Online && !Dashboard.IsEngineUnreachable;

    // The chip is the shared toggle chip; this adds the area colour (lib-area--*) its outline takes, and the accent for All libraries.
    private static string ChipClass(string? area) => area is null ? "lact-chip lact-chip--all" : $"lact-chip lib-area--{area}";

    private IReadOnlyList<string> LibraryIds
    {
        get
        {
            if (LibraryId is not null)
            {
                return [LibraryId];
            }

            return _area is null
                ? []
                : _libraries.Where(library => string.Equals(library.Area, _area, StringComparison.OrdinalIgnoreCase)).Select(library => library.Id).ToList();
        }
    }

    // History narrows by the same media types as the card and Working now (D31).
    private IReadOnlyList<string> AreaMediaTypes
        => _area is null ? [] : Areas.First(area => area.Key == _area).MediaTypes;

    private IReadOnlySet<string>? MediaTypes
        => _area is null ? null : Areas.First(area => area.Key == _area).MediaTypes.ToHashSet(StringComparer.Ordinal);

    private IReadOnlyList<MediaEngine.Contracts.Ingestion.IngestionMediaGroupDto> WorkingItems
        => (Dashboard.Presentation?.CurrentMedia ?? [])
            .Where(item => MediaTypes is null || MediaTypes.Contains(item.MediaType))
            .ToList();

    // AI, enrichment and maintenance have no bar of their own; they count in the card's total and are named here (D7).
    private IReadOnlyList<string> BackgroundNames
        => Shell.Current.Items.Where(item => item.Kind != ShellActivityKind.Ingestion).Select(item => item.Label).Distinct().ToList();

    protected override async Task OnInitializedAsync()
    {
        Dashboard.OnChanged += OnDashboardChanged;
        Shell.Changed += OnShellChanged;
        // Opening Activity is seeing how the last library update ended: the indicator's needs-attention mark clears.
        Shell.AcknowledgeAttention();
        await Dashboard.InitializeAsync();
        _wasRunning = Working;
        _configuration = await Api.GetLibrariesAsync();
        _libraries = _configuration?.Libraries ?? [];
    }

    private Task PickAreaAsync(string? area)
    {
        _area = area;
        return Task.CompletedTask;
    }

    private Task OnLastCompleted(DateTimeOffset? value)
    {
        _lastCompleted = value;
        return Task.CompletedTask;
    }

    // When a run starts or finishes, History is read again so the newest entry turns Active, then Completed, without a reload.
    private void OnDashboardChanged()
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            var running = Working;
            if (running != _wasRunning)
            {
                _wasRunning = running;
                _refresh++;
            }

            StateHasChanged();
        });
    }

    // While Activity is open, an update that ends with failures is seen at once: the indicator must not turn amber for someone already looking.
    private void OnShellChanged() => _ = InvokeAsync(() =>
    {
        if (_disposed)
        {
            return;
        }

        Shell.AcknowledgeAttention();
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Dashboard.OnChanged -= OnDashboardChanged;
        Shell.Changed -= OnShellChanged;
        await Dashboard.StopAsync();
    }
}
