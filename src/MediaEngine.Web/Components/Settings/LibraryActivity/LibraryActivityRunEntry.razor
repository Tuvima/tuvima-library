@namespace MediaEngine.Web.Components.Settings.LibraryActivity
@using System.Globalization
@using MediaEngine.Contracts.Library
@inject IEngineApiClient Api
@inject IJSRuntime JS
@inject IStringLocalizer<SharedStrings> L
@implements IAsyncDisposable

@* One History entry (spec library-activity D33, D35): a date label on the line, then one slim row in a bordered box. A running batch has a purple
   left edge, "Adding audiobooks", "2 added so far", up to two small covers, Active and a chevron. A finished batch reads "250 items added", one
   counts-by-kind line, three small covers with "+247", Completed and a chevron. The phone shows two covers with the "+N" and lets the counts wrap
   to two lines. No library names on the row. Clicking opens it in place: its items as standard tiles in a scrolling area that shows two rows at a
   time and loads more as you scroll, with no filter of its own (the chips at the top of the page narrow the whole page, D31). Episodes are stacked
   into one tile per show, tracks into one per album. No file or enrichment detail (that lives in the item's editor). *@
<li class="lact-entry @(IsActive ? "is-active" : null)" data-testid="lact-entry" data-run-status="@Run.Status">
    <div class="lact-entry__row">
        <span class="lact-bubble" data-testid="lact-entry-date">@Bubble</span>
        <div class="lact-box">
            <AppNativeButton Type="button" Class="lact-box__toggle" OnClick="ToggleAsync"
                             aria-expanded="@(_open ? "true" : "false")" data-testid="lact-entry-toggle"
                             AriaLabel="@($"{Title}, {StatusText}")">
                <span class="lact-box__what">
                    <strong data-testid="lact-entry-title">@Title</strong>
                    @if (!string.IsNullOrEmpty(Line))
                    {
                        <small data-testid="lact-entry-line" data-overflow-tooltip="@Line">@Line</small>
                    }
                </span>
                <span class="lact-box__covers" aria-hidden="true" data-testid="lact-entry-covers">
                    @{ var covers = Run.Covers.Take(IsActive ? PhoneCovers : DesktopCovers).ToList(); }
                    @for (var index = 0; index < covers.Count; index++)
                    {
                        var cover = covers[index];
                        <span class="lact-cover @(cover.MediaType == "Music" ? "is-square" : null) @(index >= PhoneCovers ? "is-desktop-only" : null)">
                            <LibraryActivityPicture Url="@cover.Url" DrawnPx="44" />
                        </span>
                    }
                    @if (!IsActive)
                    {
                        @if (MoreOnDesktop > 0 && MoreOnDesktop == MoreOnPhone)
                        {
                            <span class="lact-cover-more" data-testid="lact-entry-more">+@MoreOnDesktop.ToString("N0", CultureInfo.InvariantCulture)</span>
                        }
                        else
                        {
                            @if (MoreOnDesktop > 0)
                            {
                                <span class="lact-cover-more is-desktop-only" data-testid="lact-entry-more">+@MoreOnDesktop.ToString("N0", CultureInfo.InvariantCulture)</span>
                            }
                            @if (MoreOnPhone > 0)
                            {
                                <span class="lact-cover-more is-phone-only" data-testid="lact-entry-more-phone">+@MoreOnPhone.ToString("N0", CultureInfo.InvariantCulture)</span>
                            }
                        }
                    }
                </span>
                <span class="lact-box__status lact-status--@Run.Status" data-testid="lact-entry-status">
                    @if (IsActive)
                    {
                        <span class="lact-dot" aria-hidden="true"></span><span>@StatusText</span>
                    }
                    else if (Run.Status == ActivityRunStatusNames.Failed)
                    {
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ErrorOutline" Size="AppIconSize.Control20" /><span>@StatusText</span>
                    }
                    else
                    {
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Check" Size="AppIconSize.Control20" /><span>@StatusText</span>
                    }
                </span>
                <span class="lact-box__chevron"><AppMaterialIcon Icon="@(_open ? AppMaterialIcons.Outlined.ExpandLess : AppMaterialIcons.Outlined.ExpandMore)" Size="AppIconSize.Control20" /></span>
            </AppNativeButton>
        </div>
    </div>

    @if (_open)
    {
        @* The opened batch is its own panel under the line, indented past the date bubble (mock screen 2). *@
        <div class="lact-open" data-testid="lact-open">
                @if (_failed)
                {
                    <AppAlert Tone="AppUiTone.Warning">@L["LibraryActivity_ItemsFailed"] <AppButton Label="@L["LibraryActivity_TryAgain"].Value" OnClick="LoadFirstPageAsync" /></AppAlert>
                }
                else if (_loadedOnce && _groups.Count == 0)
                {
                    <p class="lact-empty">@L["LibraryActivity_NothingInBatch"]</p>
                }
                else
                {
                    <div class="lact-scroll" data-testid="lact-open-tiles">
                        <div class="lact-tiles">
                            @foreach (var group in _groups)
                            {
                                <LibraryActivityTile @key="group.GroupKey"
                                                     Title="@group.Title"
                                                     CoverUrl="@group.CoverUrl"
                                                     MediaType="@group.MediaType"
                                                     Route="@group.Route"
                                                     BottomLabel="@BottomLabel(group)" />
                            }
                        </div>
                        @if (_hasMore)
                        {
                            <div id="@SentinelId" class="lact-sentinel"><AppButton Label="@L["LibraryActivity_ShowMore"].Value" OnClick="LoadMoreAsync" Disabled="_loading" /></div>
                        }
                    </div>
                }
            </div>
        }
</li>

@code {
    private const int PageSize = 24;
    private const int DesktopCovers = 3;
    private const int PhoneCovers = 2;

    [Parameter, EditorRequired] public ActivityRunDto Run { get; set; } = default!;

    /// <summary>The libraries the page is narrowed to (a library's own tab, or an area chip); empty means every library.</summary>
    [Parameter] public IReadOnlyList<string> LibraryIds { get; set; } = [];

    /// <summary>The chosen area's media types (D31): the opened batch lists only these. Empty means every kind.</summary>
    [Parameter] public IReadOnlyList<string> MediaTypes { get; set; } = [];

    private readonly List<ActivityGroupDto> _groups = [];
    private bool _open;
    private bool _loading;
    private bool _loadedOnce;
    private bool _failed;
    private bool _hasMore;
    private IJSObjectReference? _module;
    private DotNetObjectReference<MoreCallback>? _callback;
    private string? _observedId;

    private string SentinelId => $"lact-more-{Run.Id:N}";

    private bool IsActive => Run.Status == ActivityRunStatusNames.Active;

    private string Bubble => IsActive ? L["LibraryActivity_Now"].Value : LibraryActivityText.Bubble(Run.StartedAt);

    private string StatusText => Run.Status switch
    {
        ActivityRunStatusNames.Active => L["LibraryActivity_Active"].Value,
        ActivityRunStatusNames.Failed => L["LibraryActivity_Failed"].Value,
        _ => L["LibraryActivity_Completed"].Value,
    };

    // A running import reads "Adding audiobooks" when one kind is arriving and "Adding items" when several are; every other batch, and a
    // finished one, reads by its count and what happened to it: "250 items added", "12 items updated", "3 items fixed", "3 items removed".
    private string Title
    {
        get
        {
            var count = Run.ItemCount.ToString("N0", CultureInfo.InvariantCulture);
            if (IsActive && Run.Kind == ActivityRunKindNames.Added)
            {
                var kinds = Run.Counts.Where(entry => entry.Count > 0).Select(entry => entry.MediaType).Distinct(StringComparer.Ordinal).ToList();
                return kinds.Count == 1
                    ? L["LibraryActivity_AddingKind", LibraryActivityText.Noun(kinds[0], 2)].Value
                    : L["LibraryActivity_AddingItems"].Value;
            }

            var one = Run.ItemCount == 1;
            return Run.Kind switch
            {
                ActivityRunKindNames.Updated => L[one ? "LibraryActivity_BatchItemUpdated" : "LibraryActivity_BatchItemsUpdated", count].Value,
                ActivityRunKindNames.Fixed => L[one ? "LibraryActivity_BatchItemFixed" : "LibraryActivity_BatchItemsFixed", count].Value,
                ActivityRunKindNames.Removed => L[one ? "LibraryActivity_BatchItemRemoved" : "LibraryActivity_BatchItemsRemoved", count].Value,
                _ => L[one ? "LibraryActivity_BatchItemAdded" : "LibraryActivity_BatchItemsAdded", count].Value,
            };
        }
    }

    // The one line under the title: "2 added so far" while it runs, otherwise the counts by kind; a batch that knows no kinds (a removal) says why instead.
    private string Line
    {
        get
        {
            if (IsActive && Run.Kind == ActivityRunKindNames.Added)
            {
                return L["LibraryActivity_AddedSoFar", Run.ItemCount.ToString("N0", CultureInfo.InvariantCulture)].Value;
            }

            var counts = LibraryActivityText.Counts(Run);
            if (counts.Length > 0)
            {
                return counts;
            }

            return Run.Kind switch
            {
                ActivityRunKindNames.Fixed => L["LibraryActivity_ReasonFixed"].Value,
                ActivityRunKindNames.Removed => L["LibraryActivity_ReasonRemoved"].Value,
                _ => string.Empty,
            };
        }
    }

    // The desktop draws three covers and the phone two, so the "+N" differs; a running batch shows two covers and no "+N" (D33).
    private int MoreOnDesktop => Math.Max(0, Run.ItemCount - Math.Min(DesktopCovers, Run.Covers.Count));

    private int MoreOnPhone => Math.Max(0, Run.ItemCount - Math.Min(PhoneCovers, Run.Covers.Count));

    // The bottom-left label: "12 new episodes", or nothing for a single movie.
    private static string? BottomLabel(ActivityGroupDto group)
        => group.ItemCount > 1 || group.MediaType is "TV" or "Music"
            ? LibraryActivityText.NewLabel(group.MediaType, group.ItemCount)
            : null;

    private async Task ToggleAsync()
    {
        _open = !_open;
        if (_open && !_loadedOnce)
        {
            await LoadFirstPageAsync();
        }
    }

    private async Task LoadFirstPageAsync()
    {
        _groups.Clear();
        _hasMore = false;
        _failed = false;
        await LoadMoreAsync();
    }

    private async Task LoadMoreAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        try
        {
            var page = await Api.GetActivityRunGroupsAsync(Run.Id, LibraryIds, MediaTypes, _groups.Count, PageSize);
            if (page is null)
            {
                _failed = true;
                return;
            }

            _groups.AddRange(page.Groups.Where(group => _groups.All(existing => existing.GroupKey != group.GroupKey)));
            _hasMore = page.HasMore;
            _loadedOnce = true;
        }
        finally
        {
            _loading = false;
        }

        StateHasChanged();
        await ObserveAsync();
    }

    // The next page loads as the sentinel scrolls near; the Show more button still works where scripts cannot run.
    private async Task ObserveAsync()
    {
        try
        {
            var wanted = _open && _hasMore ? SentinelId : null;
            if (_observedId is not null && _observedId != wanted && _module is not null)
            {
                await _module.InvokeVoidAsync("disconnectById", _observedId);
            }

            _observedId = wanted;
            if (wanted is null)
            {
                return;
            }

            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/load-more-observer.js");
            _callback ??= DotNetObjectReference.Create(new MoreCallback(() => InvokeAsync(LoadMoreAsync)));
            await _module.InvokeVoidAsync("observeById", wanted, _callback, new { rootMargin = "160px 0px" });
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException or JSDisconnectedException)
        {
            // No script support (a test host, a closing circuit): the Show more button still pages the tiles in.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                if (_observedId is not null)
                {
                    await _module.InvokeVoidAsync("disconnectById", _observedId);
                }

                await _module.DisposeAsync();
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or InvalidOperationException)
        {
            // The circuit ended first, or the script never loaded; there is nothing left to disconnect.
        }

        _callback?.Dispose();
    }

    /// <summary>What the page-in observer calls when the end of the tiles nears the visible area.</summary>
    public sealed class MoreCallback(Func<Task> loadMore)
    {
        [JSInvokable]
        public Task LoadMoreFromObserverAsync() => loadMore();
    }
}
