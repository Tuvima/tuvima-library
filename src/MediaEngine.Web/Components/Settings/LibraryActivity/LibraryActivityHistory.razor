@namespace MediaEngine.Web.Components.Settings.LibraryActivity
@using MediaEngine.Contracts.Library
@using MediaEngine.Web.Services.Formatting
@inject IEngineApiClient Api
@inject IStringLocalizer<SharedStrings> L
@implements IDisposable

@* History (spec library-activity D9 to D20): one entry per batch on a vertical timeline, a round date bubble on a line, under month and year
   headings that collapse. The current month starts open; older months and years start collapsed with their batch count. One row of
   controls: search, type, date range, sort by time. Searching is an instant filter and expands every heading that holds a match. *@
<section class="lact-history" aria-labelledby="lact-history-title">
    @* The heading on the left and one compact row of controls on the right (search, type, date range, sort by time), none with a label above:
       the closed value says what it is and the label stays for screen readers. While a search is showing the heading adds "· 2 titles". *@
    <div class="lact-history__head">
        <h2 id="lact-history-title" class="lact-heading">
            @L["LibraryActivity_History"]
            @if (_titles is not null)
            {
                <span class="lact-heading__count" data-testid="lact-title-count">· @LibraryActivityText.TitlesCount(_titles.Count)</span>
            }
        </h2>

        <AppFilterRow Class="lact-controls" AriaLabel="@L["LibraryActivity_HistoryFilters"].Value">
            <div class="lact-controls__search">
                <AppTextField Value="@_search"
                              ValueChanged="OnSearchChanged"
                              OnDebounceIntervalElapsed="OnSearchDebounced"
                              DebounceInterval="250"
                              Label="@L["LibraryActivity_SearchTitles"].Value"
                              HideLabel="true"
                              Placeholder="@L["LibraryActivity_SearchHistory"].Value"
                              Adornment="AppAdornment.Start"
                              AdornmentIcon="@AppMaterialIcons.Outlined.Search" />
            </div>
            @if (_range == CustomRange)
            {
                @* Custom date range (D16): From and To beside the search, the same pair as the personal Activity page. *@
                <div class="lact-controls__dates" role="group" aria-label="@L["Common_Dates"].Value" data-testid="lact-custom-dates">
                    <span class="lact-controls__date-word" aria-hidden="true">@L["Common_From"]</span>
                    <AppTextField Label="@L["Common_From"].Value" HideLabel="true" InputType="AppInputType.Date" Value="@_fromDate" ValueChanged="OnFromChanged" data-testid="lact-date-from" />
                    <span class="lact-controls__date-word" aria-hidden="true">@L["Common_To"]</span>
                    <AppTextField Label="@L["Common_To"].Value" HideLabel="true" InputType="AppInputType.Date" Value="@_toDate" ValueChanged="OnToChanged" data-testid="lact-date-to" />
                </div>
            }
            <div class="lact-controls__select lact-controls__select--type">
                <AppSelect Label="@L["LibraryActivity_Type"].Value" HideLabel="true" Value="@_kind" ValueChanged="OnKindChanged" Options="KindOptions" />
            </div>
            <div class="lact-controls__select lact-controls__select--range">
                <AppSelect Label="@L["LibraryActivity_DateRange"].Value" HideLabel="true" Value="@_range" ValueChanged="OnRangeChanged" Options="RangeOptions" />
            </div>
            <div class="lact-controls__select lact-controls__select--sort">
                <AppSelect Label="@L["LibraryActivity_SortByTime"].Value" HideLabel="true" Value="@_sort" ValueChanged="OnSortChanged" Options="SortOptions" />
            </div>
        </AppFilterRow>
    </div>

    @if (_loading && _runs.Count == 0 && _titles is null)
    {
        <AppProgressBar Indeterminate="true" Decorative="true" />
    }
    else if (_failed)
    {
        <AppPageState Kind="AppPageStateKind.Error"
                      Icon="@AppMaterialIcons.Outlined.CloudOff"
                      Title="@L["LibraryActivity_LoadFailed"].Value"
                      Message="@L["LibraryActivity_LoadFailedHelp"].Value">
            <Actions>
                <AppButton Label="@L["LibraryActivity_TryAgain"].Value" OnClick="ReloadAsync" />
            </Actions>
        </AppPageState>
    }
    else if (_titles is not null)
    {
        @if (_titles.Count == 0)
        {
            <AppPageState Kind="AppPageStateKind.Empty" Icon="@AppMaterialIcons.Outlined.Search" Title="@L["LibraryActivity_NoMatch"].Value" Message="@L["LibraryActivity_NoMatchHelp"].Value" />
        }
        else
        {
            <div class="lact-titles" data-testid="lact-title-results">
                @foreach (var card in _titles)
                {
                    <article class="lact-title" @key="card.GroupKey" data-testid="lact-title-card">
                        <LibraryActivityTile Title="@card.Title"
                                             CoverUrl="@card.CoverUrl"
                                             MediaType="@card.MediaType"
                                             Route="@card.Route"
                                             BottomLabel="@LibraryActivityText.NewLabel(card.MediaType, card.TotalCount)" />
                        <div class="lact-markers-wrap">
                            @if (card.Markers.Count > ManyMarkers)
                            {
                                @* Many dates group under month headings that collapse, like the main timeline (D18). *@
                                @foreach (var month in card.Markers.GroupBy(marker => (marker.StartedAt.ToLocalTime().Year, marker.StartedAt.ToLocalTime().Month)))
                                {
                                    var key = $"t{card.GroupKey}-{month.Key.Year}-{month.Key.Month}";
                                    var open = IsOpen(key, true);
                                    <div class="lact-group" data-testid="lact-title-month">
                                        <AppNativeButton Type="button" Class="lact-group__toggle" aria-expanded="@(open ? "true" : "false")"
                                                         OnClick="@(() => Toggle(key, true))">
                                            <AppMaterialIcon Icon="@(open ? AppMaterialIcons.Outlined.ExpandMore : AppMaterialIcons.Outlined.ChevronRight)" />
                                            <strong>@LibraryActivityText.MonthHeading(month.First().StartedAt)</strong>
                                            <span class="lact-group__count">· @LibraryActivityText.BatchCount(month.Count())</span>
                                        </AppNativeButton>
                                        @if (open)
                                        {
                                            @Markers(card, month)
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                @Markers(card, card.Markers)
                            }
                        </div>
                    </article>
                }
            </div>
        }
    }
    else if (_runs.Count == 0 && NoLibraries)
    {
        @* No libraries at all: nothing has been added yet, and the way forward is Add library (administrators on a computer only). *@
        <AppPageState Kind="AppPageStateKind.Empty"
                      Icon="@AppMaterialIcons.Outlined.History"
                      Title="@L["LibraryActivity_Empty"].Value"
                      Message="@L["LibraryActivity_EmptyHelp"].Value">
            <Actions>
                @if (OnAddLibrary.HasDelegate)
                {
                    <AppButton Label="@L["Common_AddLibrary"].Value"
                               StartIcon="@AppMaterialIcons.Outlined.Add"
                               ButtonStyle="AppButtonStyle.Filled"
                               Tone="AppUiTone.Primary"
                               OnClick="OnAddLibrary" />
                }
            </Actions>
        </AppPageState>
    }
    else if (_runs.Count == 0)
    {
        @* The date range always narrows the list, so an empty answer means "none in this time", not "never". *@
        <AppPageState Kind="AppPageStateKind.Empty"
                      Icon="@AppMaterialIcons.Outlined.History"
                      Title="@L["LibraryActivity_NoBatches"].Value"
                      Message="@L["LibraryActivity_NoBatchesHelp"].Value" />
    }
    else
    {
        <div class="lact-timeline" data-testid="lact-timeline">
            @foreach (var year in Years)
            {
                @if (year.Wrap)
                {
                    <div class="lact-group lact-group--year">
                        <AppNativeButton Type="button" Class="lact-group__toggle" aria-expanded="@(IsOpen(year.Key, year.OpenByDefault) ? "true" : "false")" data-testid="lact-year-toggle"
                                         OnClick="@(() => Toggle(year.Key, year.OpenByDefault))">
                            <AppMaterialIcon Icon="@(IsOpen(year.Key, year.OpenByDefault) ? AppMaterialIcons.Outlined.ExpandMore : AppMaterialIcons.Outlined.ChevronRight)" />
                            <strong>@year.Year</strong>
                            <span class="lact-group__count">· @LibraryActivityText.BatchCount(year.Count)</span>
                        </AppNativeButton>
                        @if (IsOpen(year.Key, year.OpenByDefault))
                        {
                            @foreach (var month in year.Months)
                            {
                                @MonthGroup(month)
                            }
                        }
                    </div>
                }
                else
                {
                    @foreach (var month in year.Months)
                    {
                        @MonthGroup(month)
                    }
                }
            }
            @if (_hasMore)
            {
                <div class="lact-more"><AppButton Label="@L["LibraryActivity_ShowOlder"].Value" OnClick="LoadMoreAsync" Disabled="_loading" /></div>
            }
        </div>
    }
</section>

@code {
    private const int PageSize = 50;

    private const string CustomRange = "custom";

    // D16: the type list reads "All types" first; the date range is Today, 7 days, 30 days, year or custom (no "All time").
    private IReadOnlyList<AppSelectOption> KindOptions =>
    [
        new("all", L["LibraryActivity_AllTypes"].Value), new(ActivityRunKindNames.Added, "Added"), new(ActivityRunKindNames.Updated, "Updated"),
        new(ActivityRunKindNames.Fixed, "Fixed"), new(ActivityRunKindNames.Removed, "Removed"),
    ];

    private IReadOnlyList<AppSelectOption> RangeOptions =>
    [
        new("today", "Today"), new("7", "Last 7 days"), new("30", "Last 30 days"), new("year", "This year"), new(CustomRange, L["LibraryActivity_Custom"].Value),
    ];

    // More dated markers than this on one searched title group under month headings.
    private const int ManyMarkers = 6;

    private static readonly IReadOnlyList<AppSelectOption> SortOptions = [new("newest", "Newest first"), new("oldest", "Oldest first")];

    /// <summary>The libraries the chips and the library tab allow; empty means every library.</summary>
    [Parameter] public IReadOnlyList<string> LibraryIds { get; set; } = [];

    /// <summary>The chosen area's media types (D31): batches with none of them are hidden and mixed batches show only these. Empty means every kind.</summary>
    [Parameter] public IReadOnlyList<string> MediaTypes { get; set; } = [];

    /// <summary>Bumped by the page when ingestion starts or finishes, so the newest entry follows along.</summary>
    [Parameter] public int RefreshToken { get; set; }

    /// <summary>The newest completed scan time, for the "Everything is up to date" card.</summary>
    [Parameter] public EventCallback<DateTimeOffset?> LastCompletedChanged { get; set; }

    /// <summary>True when the Library has no libraries at all, so an empty History offers Add library.</summary>
    [Parameter] public bool NoLibraries { get; set; }

    /// <summary>Opens the Add library window. Left unset when the person cannot add one (a phone), which hides the button.</summary>
    [Parameter] public EventCallback OnAddLibrary { get; set; }

    private readonly List<ActivityRunDto> _runs = [];
    private readonly HashSet<string> _toggled = [];
    private IReadOnlyList<ActivityTitleCardDto>? _titles;
    private CancellationTokenSource? _cts;
    private string? _search;
    private string _kind = "all";
    private string _range = "30";
    private string? _fromDate;
    private string? _toDate;
    private string _sort = "newest";
    private bool _loading = true;
    private bool _failed;
    private bool _hasMore;
    // Null until the first load has started, so the first render loads even when no library filter is chosen (an empty signature).
    private string? _signature;
    private int _lastRefresh;

    private bool Searching => !string.IsNullOrWhiteSpace(_search);

    private sealed record MonthGroupModel(string Key, string Heading, int Count, bool OpenByDefault, IReadOnlyList<ActivityRunDto> Runs);
    private sealed record YearGroupModel(string Key, string Year, int Count, bool Wrap, bool OpenByDefault, IReadOnlyList<MonthGroupModel> Months);

    protected override async Task OnParametersSetAsync()
    {
        var signature = string.Join(',', LibraryIds) + "|" + string.Join(',', MediaTypes);
        if (signature == _signature && _lastRefresh == RefreshToken)
        {
            return;
        }

        _signature = signature;
        _lastRefresh = RefreshToken;
        await ReloadAsync();
    }

    private IEnumerable<YearGroupModel> Years
    {
        get
        {
            var now = DateTimeOffset.Now;
            foreach (var year in _runs.GroupBy(run => run.StartedAt.ToLocalTime().Year, (key, runs) => (Year: key, Runs: runs.ToList())))
            {
                var current = year.Year == now.Year;
                var months = year.Runs
                    .GroupBy(run => run.StartedAt.ToLocalTime().Month)
                    .Select(group => new MonthGroupModel(
                        $"m{year.Year}-{group.Key}",
                        LibraryActivityText.MonthHeading(group.First().StartedAt),
                        group.Count(),
                        Searching || (current && group.Key == now.Month),
                        group.ToList()))
                    .ToList();
                yield return new YearGroupModel(
                    $"y{year.Year}", year.Year.ToString(System.Globalization.CultureInfo.InvariantCulture), year.Runs.Count,
                    Wrap: !current, OpenByDefault: Searching, months);
            }
        }
    }

    private RenderFragment MonthGroup(MonthGroupModel month) => __builder =>
    {
        var open = IsOpen(month.Key, month.OpenByDefault);
        <div class="lact-group" data-testid="lact-month">
            <AppNativeButton Type="button" Class="lact-group__toggle" aria-expanded="@(open ? "true" : "false")" data-testid="lact-month-toggle"
                             OnClick="@(() => Toggle(month.Key, month.OpenByDefault))">
                <AppMaterialIcon Icon="@(open ? AppMaterialIcons.Outlined.ExpandMore : AppMaterialIcons.Outlined.ChevronRight)" />
                <strong>@month.Heading</strong>
                <span class="lact-group__count">· @LibraryActivityText.BatchCount(month.Count)</span>
            </AppNativeButton>
            @if (open)
            {
                <ol class="lact-line">
                    @foreach (var run in month.Runs)
                    {
                        <LibraryActivityRunEntry @key="@((run.Id, _signature))" Run="run" LibraryIds="LibraryIds" MediaTypes="MediaTypes" />
                    }
                </ol>
            }
        </div>
    };

    // One searched title's dated markers (D18): a round date bubble on a line, how much was added that time, and what kind of batch it was.
    private RenderFragment Markers(ActivityTitleCardDto card, IEnumerable<ActivityTitleMarkerDto> markers) => __builder =>
    {
        <ol class="lact-markers" aria-label="@L["LibraryActivity_WhenAdded", card.Title]">
            @foreach (var marker in markers)
            {
                <li class="lact-marker" data-testid="lact-title-marker">
                    <span class="lact-bubble">@LibraryActivityText.Bubble(marker.StartedAt)</span>
                    <span class="lact-marker__text">
                        <strong>@LibraryActivityText.MarkerLine(marker, card.MediaType)</strong>
                        <small>@LibraryActivityText.KindVerb(marker.Kind)</small>
                    </span>
                </li>
            }
        </ol>
    };

    private bool IsOpen(string key, bool openByDefault) => _toggled.Contains(key) ? !openByDefault : openByDefault;

    private void Toggle(string key, bool openByDefault)
    {
        if (!_toggled.Remove(key))
        {
            _toggled.Add(key);
        }
    }

    private Task OnSearchChanged(string? value)
    {
        _search = value;
        return Task.CompletedTask;
    }

    private Task OnSearchDebounced(string _) => ReloadAsync();
    private Task OnKindChanged(string? value) { _kind = value ?? "all"; return ReloadAsync(); }
    private Task OnRangeChanged(string? value) { _range = value ?? "30"; return ReloadAsync(); }
    private Task OnSortChanged(string? value) { _sort = value ?? "newest"; return ReloadAsync(); }
    private Task OnFromChanged(string? value) { _fromDate = string.IsNullOrWhiteSpace(value) ? null : value; return ReloadAsync(); }
    private Task OnToChanged(string? value) { _toDate = string.IsNullOrWhiteSpace(value) ? null : value; return ReloadAsync(); }

    private (DateTimeOffset? From, DateTimeOffset? To) Dates()
    {
        var now = DateTimeOffset.Now;
        return _range switch
        {
            "today" => (new DateTimeOffset(now.Date, now.Offset), null),
            "7" => (now.AddDays(-7), null),
            "30" => (now.AddDays(-30), null),
            "year" => (new DateTimeOffset(new DateTime(now.Year, 1, 1), now.Offset), null),
            CustomRange => (ActivityListPresentation.StartOfLocalDay(_fromDate), ActivityListPresentation.EndOfLocalDay(_toDate)),
            _ => (null, null),
        };
    }

    private IReadOnlyCollection<string>? Kinds => _kind == "all" ? null : [_kind];

    private async Task ReloadAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;
        _loading = true;
        _failed = false;
        try
        {
            var (from, to) = Dates();
            if (Searching)
            {
                var found = await Api.SearchActivityTitlesAsync(_search!.Trim(), LibraryIds, Kinds, from, to, MediaTypes, ct);
                if (ct.IsCancellationRequested) { return; }
                if (found is null) { _failed = true; return; }
                _titles = found.Titles;
                _runs.Clear();
                _hasMore = false;
                return;
            }

            _titles = null;
            var page = await Api.GetActivityRunsAsync(LibraryIds, Kinds, from, to, null, _sort == "newest", 0, PageSize, MediaTypes, ct);
            // The client answers null for a cancelled call too; a newer load has taken over, so that is not a failure.
            if (ct.IsCancellationRequested) { return; }
            if (page is null) { _failed = true; return; }
            _runs.Clear();
            _runs.AddRange(page.Runs);
            _hasMore = page.HasMore;
            await LastCompletedChanged.InvokeAsync(page.LastCompletedAt);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        finally
        {
            if (!ct.IsCancellationRequested) { _loading = false; }
        }
    }

    private async Task LoadMoreAsync()
    {
        _loading = true;
        try
        {
            var (from, to) = Dates();
            var page = await Api.GetActivityRunsAsync(LibraryIds, Kinds, from, to, null, _sort == "newest", _runs.Count, PageSize, MediaTypes);
            if (page is not null)
            {
                _runs.AddRange(page.Runs.Where(run => _runs.All(existing => existing.Id != run.Id)));
                _hasMore = page.HasMore;
            }
        }
        finally { _loading = false; }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
