@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient

<div class="network-panel">
    <header class="network-panel__heading">
        <div><h3>Remote Access</h3><p>Optional. Add a secure outside address so apps and other devices can reach Tuvima away from home. Tuvima Library sign-in is always required.</p></div>
    </header>

    <div id="remote-connection-mode">
    <SettingsSectionPanel Title="How the internet reaches Tuvima" Icon="@AppMaterialIcons.Outlined.Public"
                          Description="Local access works without router, DNS, or certificate setup. Pick a secure path only if you want to reach Tuvima from outside your home.">
        <div class="network-mode-list" role="radiogroup" aria-label="How the internet reaches Tuvima">
            @Mode("local-only", "Not set up — Default", "No public router mapping or remote tunnel is attempted.")
            @Mode("tailscale", "Tailscale", "Private HTTPS access through an independently installed Tailscale client and Tailscale Serve.")
            @Mode("custom", "HTTPS reverse proxy", "Use a trusted HTTPS hostname served by Caddy, nginx, Traefik, or another reverse proxy.")
        </div>
        <div class="network-card-actions">
            <AppButton Label="Test remote access" StartIcon="@AppMaterialIcons.Outlined.Science" OnClick="TestRemoteAsync" />
        </div>
    </SettingsSectionPanel>
    </div>

    @if (Settings.Remote.ConnectionMode == "tailscale")
    {
        <SettingsSectionPanel Title="Tailscale Serve" Icon="@AppMaterialIcons.Outlined.VpnLock">
            <dl class="network-facts">
                @Fact("Status", Display(Status?.TailscaleState))
                @Fact("Private HTTPS address", Status?.TailnetAddress ?? "Not detected")
                @Fact("Serve HTTPS", Status?.TailscaleServeHttps == true ? "Active" : "Not verified")
                @Fact("Router mapping", "Not used")
            </dl>
            <AppAlert Tone="AppUiTone.Info">Tailscale is a supported deployment preset, not an embedded VPN. Install it on the host or use the official sidecar preset.</AppAlert>
        </SettingsSectionPanel>
    }

    @if (Settings.Remote.ConnectionMode is "custom" or "direct-only")
    {
        <div id="remote-public-address">
        <SettingsSectionPanel Title="HTTPS Reverse Proxy" Icon="@AppMaterialIcons.Outlined.Language"
                              Description="The address must have a trusted certificate and route to this Dashboard.">
            <AppTextField T="string" @bind-Value="Settings.Remote.PublicHostname"
                          Label="Public HTTPS address" Placeholder="https://tuvima.example.com"
                          HelpText="Used for passkeys, linked sign-in and reset links" />
            <div class="network-card-actions"><AppButton Label="Save and verify" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="SaveAddressAsync" /></div>
        </SettingsSectionPanel>
        </div>
    }

</div>

<NetworkTestDialog @bind-Visible="_testDialogOpen" Busy="@_testing" Result="@_testResult" />

@code {
    [Parameter, EditorRequired] public NetworkSettingsDto Settings { get; set; } = new();
    [Parameter] public NetworkRuntimeStatusDto? Status { get; set; }
    [Parameter] public EventCallback SaveRequested { get; set; }
    [Parameter] public EventCallback StatusRefreshRequested { get; set; }

    private bool _testDialogOpen;
    private bool _testing;
    private NetworkTestResultDto? _testResult;

    private RenderFragment Mode(string value, string title, string description) => @<label class="network-mode-option">
        <AppNativeInput Type="radio" Name="network-mode" Value="@value"
                        Checked="@(Settings.Remote.ConnectionMode == value)"
                        OnChange="@(_ => ChangeModeAsync(value))" />
        <span><strong>@title</strong><small>@description</small></span>
    </label>;

    private async Task ChangeModeAsync(string value)
    {
        Settings.Remote.ConnectionMode = value;
        if (value != "direct-only")
            Settings.Remote.AutomaticRouterConfiguration = false;
        await SaveRequested.InvokeAsync();
        await StatusRefreshRequested.InvokeAsync();
    }

    private async Task SaveAddressAsync()
    {
        await SaveRequested.InvokeAsync();
        await StatusRefreshRequested.InvokeAsync();
    }

    private async Task TestRemoteAsync()
    {
        _testDialogOpen = true;
        _testing = true;
        _testResult = await ApiClient.TestRemoteNetworkAsync();
        _testing = false;
        await StatusRefreshRequested.InvokeAsync();
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value)
        ? "Unavailable"
        : string.Join(' ', value.Split('-', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => char.ToUpperInvariant(part[0]) + part[1..]));

    private static RenderFragment Fact(string label, string value) => @<div><dt>@label</dt><dd>@value</dd></div>;
}
