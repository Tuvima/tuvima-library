@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings

@* Settings > Network > Remote access. The plain list of three radio buttons is gone: this page is the guided "away from home" flow
   (start page, then Check, Choose, Passwords, Connect and Test) that lives in Components/Settings/RemoteAccess. *@
<div class="network-panel">
    <RemoteAccessFlow Settings="Settings" SaveRequested="SaveRequested" StatusRefreshRequested="StatusRefreshRequested" />
</div>

@code {
    [Parameter, EditorRequired] public NetworkSettingsDto Settings { get; set; } = new();
    [Parameter] public EventCallback SaveRequested { get; set; }
    [Parameter] public EventCallback StatusRefreshRequested { get; set; }
}
