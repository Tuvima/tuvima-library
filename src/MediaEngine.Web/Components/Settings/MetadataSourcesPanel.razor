@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Plugins
@using MediaEngine.Web.Services.Integration
@implements IDisposable
@inject UIOrchestratorService Orchestrator

@* Metadata sources (Developer tools spec WP20): every source that supplies information about your media, whether it ships
   with the Library or comes from a plugin, with what it supplies. Read-only: switching a source on or off stays on the
   Metadata providers page, and plugin sources are switched on and off with their plugin above. *@
<AppCard Title="Metadata sources"
         Description="Where information about your media comes from, and what each source supplies."
         Class="metadata-sources">
    <div class="metadata-sources__body" data-testid="metadata-sources">
        @if (_loading)
        {
            <AppSkeleton Size="AppControlSize.Large" />
        }
        else if (_sources is null)
        {
            <AppAlert Tone="AppUiTone.Error">The metadata sources could not be loaded from the Engine.</AppAlert>
        }
        else
        {
            @if (_sources.RestartNeeded)
            {
                <AppAlert Tone="AppUiTone.Warning" data-testid="metadata-sources-restart">A plugin's metadata source was switched on or off. Restart the Engine for the change to take effect.</AppAlert>
            }
            <div class="metadata-sources__list" role="list">
                @foreach (var source in _sources.Sources)
                {
                    <div role="listitem" class="metadata-sources__item" data-testid="metadata-source" data-source="@source.Name" data-origin="@source.Origin" @key="source.Name">
                        <div class="metadata-sources__title">
                            <strong>@source.DisplayName</strong>
                            <AppStatusBadge Text="@(source.Origin == "plugin" ? "From a plugin" : "Built in")" Tone="@(source.Origin == "plugin" ? AppUiTone.Warning : AppUiTone.Neutral)" />
                            @if (!source.Enabled)
                            {
                                <AppStatusBadge Text="Off" Tone="AppUiTone.Neutral" />
                            }
                        </div>
                        <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">@(source.Supplies.Count == 0 ? "Supplies nothing for your media." : "Supplies: " + string.Join(", ", source.Supplies))</AppText>
                        @if (source.SendsDataTo.Count > 0)
                        {
                            <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">Sends searches to @string.Join(", ", source.SendsDataTo)@(source.RequiresKey ? ". Needs your own key." : ".")</AppText>
                        }
                    </div>
                }
            </div>
            @if (_sources.Sources.Count > 1)
            {
                <div class="metadata-sources__compare" data-testid="metadata-sources-compare">
                    <AppSelect Native="true" Value="@_from" ValueChanged="@(value => _from = value)" Label="Compare" Options="@Options" />
                    <AppSelect Native="true" Value="@_to" ValueChanged="@(value => _to = value)" Label="With" Options="@Options" />
                    <AppButton Label="Compare" Size="AppControlSize.Compact" Disabled="@(string.IsNullOrEmpty(_from) || string.IsNullOrEmpty(_to) || _from == _to)" OnClick="@CompareAsync" data-testid="metadata-sources-compare-go" />
                </div>
                @if (_comparison is not null)
                {
                    <div class="metadata-sources__result" data-testid="metadata-sources-result">
                        <AppText>Both supply: @Join(_comparison.Both)</AppText>
                        <AppText>Only @_comparison.From supplies: @Join(_comparison.OnlyFrom)</AppText>
                        <AppText>Only @_comparison.To supplies: @Join(_comparison.OnlyTo)</AppText>
                        <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">@_comparison.Keeps</AppText>
                    </div>
                }
            }
        }
    </div>
</AppCard>

@code {
    private readonly CancellationTokenSource _disposed = new();
    private PluginSourcesResponse? _sources;
    private PluginSourceComparisonDto? _comparison;
    private IReadOnlyList<AppSelectOption> Options = [];
    private string? _from;
    private string? _to;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _sources = await Orchestrator.GetPluginSourcesAsync(_disposed.Token);
        Options = _sources?.Sources.Select(source => new AppSelectOption(source.Name, source.DisplayName)).ToList() ?? [];
        _loading = false;
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }

    private async Task CompareAsync()
    {
        _comparison = await Orchestrator.ComparePluginSourcesAsync(_from!, _to!, _disposed.Token);
    }

    private static string Join(IReadOnlyList<string> items) => items.Count == 0 ? "nothing" : string.Join(", ", items);
}
