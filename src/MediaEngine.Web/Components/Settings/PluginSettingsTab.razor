@namespace MediaEngine.Web.Components.Settings
@using System.Globalization
@using System.Text.Json
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Contracts.Approvals
@using MediaEngine.Contracts.System
@using MediaEngine.Web.Services.Formatting
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Navigation
@using MediaEngine.Web.Services.Settings
@implements IDisposable
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject IAppToastService Snackbar
@inject DeviceContextService DeviceContext
@inject SettingsAttentionState Attention
@inject ApprovalFlow Approvals

@if (_loading)
{
    <div class="settings-plugin-loading">
        <AppSkeleton Size="AppControlSize.Large" />
        <div class="settings-plugin-loading__grid">
            <AppSkeleton Size="AppControlSize.Large" />
            <AppSkeleton Size="AppControlSize.Large" />
        </div>
    </div>
}
else
{
    <div class="tl-page settings-plugin-page">
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <AppAlert Tone="AppUiTone.Error">@_error</AppAlert>
        }
        @* One page: the installed plugins first, then Available plugins, then the advanced plugin sections
           (health and jobs, capabilities, danger zone). The advanced sections and Available plugins are desktop and tablet only. *@
        @OverviewSummary()
        @InstalledPluginsPanel()
        @if (!DeviceContext.IsMobile)
        {
            @if (ConfiguredPlugin is not null)
            {
                <AppCard Title="@($"Configure {ConfiguredPlugin.Name}")" Description="@ConfiguredPlugin.Description" Class="settings-plugin-configure-panel">
                    @if (!string.IsNullOrWhiteSpace(ConfiguredPlugin.LoadError))
                    {
                        <AppAlert Tone="AppUiTone.Warning" Class="tl-sp-mb-3">@ConfiguredPlugin.LoadError</AppAlert>
                    }
                    @PluginSettingsPanel(ConfiguredPlugin)
                </AppCard>
            }
            <AvailablePluginsPanel />
            @AdvancedPluginPanel()
        }
    </div>
}

@code {
    private readonly JsonSerializerOptions _json = MediaEngineJson.Web;
    private readonly Dictionary<string, PluginHealthResponse> _health = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, IReadOnlyList<OperationDto>> _jobs = new(StringComparer.OrdinalIgnoreCase);
    private List<PluginSummaryResponse> _plugins = [];
    private readonly HashSet<string> _healthLoading = new(StringComparer.OrdinalIgnoreCase);
    private readonly CancellationTokenSource _disposed = new();
    private IReadOnlyList<ScheduledTaskDto>? _tasks;
    private bool _tasksLoaded;
    private bool _loading = true;
    private string? _error;
    private readonly Dictionary<string, ApprovalRecordResponse> _latestApproval = new(StringComparer.OrdinalIgnoreCase);
    private string? _selectedPluginId;
    private string? _configurePluginId;
    private string? _deletePluginId;

    private PluginSummaryResponse? SelectedPlugin => _plugins.FirstOrDefault(p => string.Equals(p.Id, _selectedPluginId, StringComparison.OrdinalIgnoreCase));
    private PluginSummaryResponse? ConfiguredPlugin => _plugins.FirstOrDefault(p => string.Equals(p.Id, _configurePluginId, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<AppSelectOption> PluginOptions => _plugins
        .Select(plugin => new AppSelectOption(plugin.Id, plugin.Name))
        .ToList();

    private RenderFragment OverviewSummary() => @<div class="settings-plugin-summary__grid">
        <AppCard Title="Installed" Class="settings-plugin-summary__card">
            <strong>@_plugins.Count</strong>
            <span>Available on this server</span>
        </AppCard>
        @if (!DeviceContext.IsMobile)
        {
        <AppCard Title="Enabled" Class="settings-plugin-summary__card">
            <strong>@_plugins.Count(plugin => plugin.Enabled)</strong>
            <span>Currently active</span>
        </AppCard>
        }
        @if (_plugins.Any(plugin => !string.IsNullOrWhiteSpace(plugin.LoadError)))
        {
        <AppCard Title="Needs setup" Class="settings-plugin-summary__card">
            <strong>@_plugins.Count(plugin => !string.IsNullOrWhiteSpace(plugin.LoadError))</strong>
            <span>Requires administrator attention</span>
        </AppCard>
        }
    </div>;

    private RenderFragment InstalledPluginsPanel() => @<section class="settings-plugin-cards-section" aria-label="Installed plugins">
        <AppText Typo="AppTypo.subtitle1">Installed plugins</AppText>
        <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">@(DeviceContext.IsMobile ? "Plugin configuration is available on desktop and tablet." : "Switch plugins on or off and open the settings each plugin provides.")</AppText>
        @if (_plugins.Count == 0)
        {
            <AppEmptyState Title="No installed plugins" Message="The Engine did not return any installed extensions." />
        }
        else
        {
            <div class="settings-plugin-cards" role="list">
                @foreach (var plugin in _plugins)
                {
                    <div role="listitem" @key="plugin.Id">@PluginCard(plugin)</div>
                }
            </div>
        }
    </section>;

    private RenderFragment PluginCard(PluginSummaryResponse plugin)
    {
        _health.TryGetValue(plugin.Id, out var health);
        var run = StateCardHealth.LatestRun(_tasks, plugin.Id);
        var state = StateCardHealth.ForPlugin(plugin, health, run);
        // What the plugin may do and where its data goes are the Engine's own words, the same ones the approval dialog shows.
        var sendsOut = !string.IsNullOrWhiteSpace(plugin.SendsDataTo);
        // Phones read the cards; switching and configuring plugins stays on desktop and tablet.
        var canChange = !DeviceContext.IsMobile;
        return @<AppStateCard Name="@plugin.Name"
                              Kind="StateCardKind.Plugin"
                              Description="@plugin.Description"
                              IsOn="@(canChange ? plugin.Enabled : null)"
                              IsOnChanged="@(value => SetEnabledAsync(plugin, value))"
                              SwitchDisabledReason="@SwitchDisabledReason(plugin)"
                              Health="@state.Word"
                              LastProblem="@state.LastProblem"
                              AllowedTo="@plugin.AllowedTo"
                              SendsDataOut="@sendsOut"
                              SendsDataTo="@plugin.SendsDataTo"
                              LastActivity="@StateCardHealth.ActivityTime(run)"
                              Loading="@_healthLoading.Contains(plugin.Id)"
                              Action="@PluginAction(plugin, state.Word, canChange)">
            <Badges><AppStatusBadge Text="@TrustLabel(plugin.TrustLevel)" Tone="@TrustTone(plugin.TrustLevel)" /></Badges>
        </AppStateCard>;
    }

    private RenderFragment? PluginAction(PluginSummaryResponse plugin, HealthWord word, bool canChange) => word == HealthWord.Broken
        ? @<AppButton Label="Retry" StartIcon="@AppMaterialIcons.Outlined.Refresh" Size="AppControlSize.Compact" OnClick="@ReloadAsync" />
        : canChange
            ? @<AppButton Label="Open settings" Size="AppControlSize.Compact" OnClick="@(() => ConfigurePlugin(plugin.Id))" />
            : null;

    // A plugin that cannot work here cannot be switched on; once it is on, switching off is always allowed.
    private static string? SwitchDisabledReason(PluginSummaryResponse plugin) => !plugin.IsCompatible && !plugin.Enabled
        ? string.IsNullOrWhiteSpace(plugin.CompatibilityProblem) ? "This plugin cannot be switched on here." : plugin.CompatibilityProblem
        : null;

    private static string TrustLabel(string trustLevel) => trustLevel.ToLowerInvariant() switch
    {
        "official" => "Official",
        "verified" => "Verified",
        "community" => "Community",
        "private" => "Private",
        _ => ToTitle(trustLevel),
    };

    private static AppUiTone TrustTone(string trustLevel) => trustLevel.ToLowerInvariant() switch
    {
        "official" => AppUiTone.Primary,
        "verified" => AppUiTone.Info,
        _ => AppUiTone.Neutral,
    };

    private RenderFragment AdvancedPluginPanel() => @<text>
        <AppCard Title="Plugin details" Description="Check one plugin's health and jobs, review what it can access, or remove it.">
            <AppSelect Label="Plugin" Value="@_selectedPluginId" ValueChanged="@SelectPluginValue" Options="@PluginOptions" />
        </AppCard>
        <AppCard>
            @if (SelectedPlugin is null)
            {
                <AppEmptyState Title="No plugin selected" Message="Choose an installed plugin to inspect its details." />
            }
            else
            {
                var plugin = SelectedPlugin;
                <div class="settings-plugin-detail-stack">
                    <div class="settings-plugin-detail-header">
                        <span class="settings-plugin-detail-header__icon"><AppMaterialIcon Icon="@PluginIcon(plugin)" /></span>
                        <div class="settings-plugin-detail-header__copy">
                            <strong class="settings-plugin-detail-header__title">@plugin.Name</strong>
                            <span class="settings-plugin-detail-header__description">@plugin.Description</span>
                            @if (_latestApproval.TryGetValue(plugin.Id, out var approved))
                            {
                                <span class="settings-plugin-detail-header__description" data-testid="plugin-approval">Turned on by @approved.ApprovedByName on @DisplayFormat.FormatPlainDate(approved.ApprovedAt)</span>
                            }
                        </div>
                        <AppStatusBadge Text="@(plugin.Enabled ? "Enabled" : "Disabled")" Tone="@(plugin.Enabled ? AppUiTone.Success : AppUiTone.Neutral)" />
                    </div>
                    <section class="settings-plugin-detail-section" aria-label="Health and jobs">
                        <AppText Typo="AppTypo.subtitle1">Health &amp; Jobs</AppText>
                        <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">Check one plugin's current health and recent operations.</AppText>
                        @PluginHealthJobsPanel(plugin)
                    </section>
                    <section class="settings-plugin-detail-section" aria-label="Capabilities and AI permissions">
                        <AppText Typo="AppTypo.subtitle1">Capabilities &amp; AI permissions</AppText>
                        <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">Review what one plugin declares and can access.</AppText>
                        @PluginCapabilitiesPanel(plugin)
                    </section>
                    <section class="settings-plugin-detail-section" aria-label="Danger zone">
                        @DangerPanel(plugin)
                    </section>
                </div>
            }
        </AppCard>
    </text>;

    private RenderFragment PluginSettingsPanel(PluginSummaryResponse plugin) => @<div class="settings-plugin-tab-body">
        @{ var settingEntries = GetSettingEntries(plugin).ToList(); var primarySettings = settingEntries.Where(setting => !setting.Advanced).ToList(); var advancedSettings = settingEntries.Where(setting => setting.Advanced).ToList(); }
        @if (settingEntries.Count == 0)
        {
            <AppEmptyState Title="No plugin settings" Message="This plugin does not expose user-configurable settings." />
        }
        else
        {
            @foreach (var setting in primarySettings) { @SettingEditor(plugin, setting) }
            @if (advancedSettings.Count > 0)
            {
                <AppExpansionPanels Elevation="0" Dense="true" Class="tl-sp-mb-2">
                    <AppExpansionPanel Text="Advanced settings">
                        @foreach (var setting in advancedSettings) { @SettingEditor(plugin, setting) }
                    </AppExpansionPanel>
                </AppExpansionPanels>
            }
        }
    </div>;

    private RenderFragment PluginHealthJobsPanel(PluginSummaryResponse plugin) => @<div class="settings-plugin-tab-body">
        <AppActionBar Align="AppHorizontalAlignment.Start">
            <AppButton Label="Check health" StartIcon="@AppMaterialIcons.Outlined.HealthAndSafety" Size="AppControlSize.Compact" OnClick="@(() => CheckHealthAsync(plugin))" />
            <AppButton Label="Refresh jobs" StartIcon="@AppMaterialIcons.Outlined.History" Size="AppControlSize.Compact" Tone="AppUiTone.Primary" OnClick="@(() => LoadJobsAsync(plugin))" />
        </AppActionBar>
        @if (_health.TryGetValue(plugin.Id, out var health))
        {
            <AppAlert Tone="@HealthTone(health.Status)">
                @health.Status
                @if (health.Checks.Count > 0) { <span> - @string.Join(" ", health.Checks.Select(c => c.Message).Where(m => !string.IsNullOrWhiteSpace(m)))</span> }
            </AppAlert>
        }
        else
        {
            <AppAlert Tone="AppUiTone.Info">Health has not been checked during this visit.</AppAlert>
        }
        @if (_jobs.TryGetValue(plugin.Id, out var jobs) && jobs.Count > 0)
        {
            <AppTable Class="settings-plugin-job-table">
                <thead><tr><th>Status</th><th>Type</th><th>Progress</th><th>Result</th></tr></thead>
                <tbody>
                    @foreach (var job in jobs.Take(8))
                    {
                        <tr><td>@job.Status</td><td>@job.OperationType</td><td>@job.ItemsCompleted / @job.ItemsTotal</td><td>@(job.ResultSummary ?? "-")</td></tr>
                    }
                </tbody>
            </AppTable>
        }
        else
        {
            <AppEmptyState Title="No recent jobs" Message="The Engine has not returned any recent jobs for this plugin." />
        }
    </div>;

    private RenderFragment PluginCapabilitiesPanel(PluginSummaryResponse plugin) => @<div class="settings-plugin-tab-body">
        @if (plugin.Capabilities.Count == 0 && plugin.ToolRequirements.Count == 0 && plugin.AiPermissions.Count == 0)
        {
            <AppEmptyState Title="No declared capabilities" Message="This plugin does not publish capability metadata." />
        }
        else
        {
            <AppTable Class="settings-plugin-job-table">
                <tbody>
                    @foreach (var capability in plugin.Capabilities) { <tr><td>@capability.Name</td><td>@capability.Description</td></tr> }
                    @foreach (var requirement in plugin.ToolRequirements) { <tr><td>Required tool</td><td>@requirement</td></tr> }
                    @foreach (var permission in plugin.AiPermissions) { <tr><td>AI permission</td><td>@permission</td></tr> }
                </tbody>
            </AppTable>
        }
    </div>;

    private RenderFragment DangerPanel(PluginSummaryResponse plugin) => @<AppCard Class="settings-plugin-danger-card">
        <div class="settings-plugin-danger-header">
            <div>
                <AppText Typo="AppTypo.subtitle1">Danger Zone</AppText>
                <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">Destructive plugin actions are kept separate from everyday settings.</AppText>
            </div>
            @if (plugin.IsBuiltIn)
            {
                <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">Built-in plugins can be disabled, but cannot be deleted.</AppText>
            }
            else if (string.Equals(_deletePluginId, plugin.Id, StringComparison.OrdinalIgnoreCase))
            {
                <AppActionBar Align="AppHorizontalAlignment.End">
                    <AppButton Label="Confirm delete"
                               StartIcon="@AppMaterialIcons.Outlined.DeleteForever"
                               ButtonStyle="AppButtonStyle.Filled"
                               Tone="AppUiTone.Error"
                               OnClick="@(() => DeletePluginAsync(plugin))" />
                    <AppButton Label="Cancel" OnClick="@(() => _deletePluginId = null)" />
                </AppActionBar>
            }
            else
            {
                <AppButton Label="Delete plugin"
                           StartIcon="@AppMaterialIcons.Outlined.Delete"
                           Tone="AppUiTone.Error"
                           OnClick="@(() => _deletePluginId = plugin.Id)" />
            }
        </div>
    </AppCard>;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _plugins = (await Orchestrator.GetPluginsAsync()).OrderBy(p => p.Name).ToList();
            if (_plugins.Count > 0 && SelectedPlugin is null)
            {
                _selectedPluginId = _plugins[0].Id;
                _ = LoadLatestApprovalAsync(_selectedPluginId);
            }

            Attention.ReportPlugins(_plugins);
            if (!_tasksLoaded)
            {
                // The run records are read once per visit; they only give each card its last activity and last failure.
                _tasksLoaded = true;
                _tasks = (await ApiClient.GetScheduledTasksAsync(_disposed.Token))?.Tasks;
            }
        }
        catch
        {
            _error = "Plugin settings could not be loaded.";
        }
        finally
        {
            _loading = false;
        }

        StartHealthChecks(_plugins.Where(plugin => plugin.Enabled && plugin.IsCompatible && string.IsNullOrWhiteSpace(plugin.LoadError)));
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
    }

    // Each switched-on plugin that loaded gets one health check in the background; its card shows a quiet placeholder
    // until the answer arrives. A plugin that is off or broken needs no check to know its word.
    private void StartHealthChecks(IEnumerable<PluginSummaryResponse> plugins)
    {
        foreach (var plugin in plugins.ToList())
        {
            if (_healthLoading.Add(plugin.Id))
                _ = CheckHealthInBackgroundAsync(plugin);
        }
    }

    private async Task CheckHealthInBackgroundAsync(PluginSummaryResponse plugin)
    {
        try
        {
            var result = await Orchestrator.CheckPluginHealthAsync(plugin.Id, _disposed.Token);
            if (result is not null)
                _health[plugin.Id] = result;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            _healthLoading.Remove(plugin.Id);
        }

        if (!_disposed.IsCancellationRequested)
            await InvokeAsync(StateHasChanged);
    }

    private void SelectPlugin(string pluginId)
    {
        _selectedPluginId = pluginId;
        _deletePluginId = null;
        _ = LoadLatestApprovalAsync(pluginId);
    }

    // The newest approval for a plugin: who turned it on and when, from the Engine's approval record.
    private async Task LoadLatestApprovalAsync(string pluginId)
    {
        try
        {
            var records = await Orchestrator.GetApprovalsAsync("plugin", pluginId, _disposed.Token);
            if (records is { Count: > 0 })
                _latestApproval[pluginId] = records[0];
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!_disposed.IsCancellationRequested)
            await InvokeAsync(StateHasChanged);
    }

    private void SelectPluginValue(string? pluginId)
    {
        if (!string.IsNullOrWhiteSpace(pluginId))
            SelectPlugin(pluginId);
    }

    private void ConfigurePlugin(string pluginId)
    {
        _configurePluginId = string.Equals(_configurePluginId, pluginId, StringComparison.OrdinalIgnoreCase)
            ? null
            : pluginId;
    }

    private async Task SetEnabledAsync(PluginSummaryResponse plugin, bool enabled)
    {
        var result = await Orchestrator.SetPluginEnabledAsync(plugin.Id, enabled);
        if (enabled && result.Approval is { } approval)
        {
            // The Engine wants the person to see what the plugin can do first. Cancel leaves it off and asks nothing more.
            var hashes = await Approvals.ConfirmAsync(approval.Approvals);
            if (hashes is null || !hashes.TryGetValue(plugin.Id, out var hash))
            {
                await InvokeAsync(StateHasChanged);
                return;
            }

            result = await Orchestrator.SetPluginEnabledAsync(plugin.Id, true, hash);
        }

        if (!result.Succeeded)
        {
            // The Engine's plain-English reason (for example a Library version the plugin does not support) beats the generic text.
            Snackbar.Add(string.IsNullOrWhiteSpace(result.Message) ? "Plugin state could not be saved." : result.Message, AppSeverity.Error);
            return;
        }

        plugin.Enabled = enabled;
        Attention.ReportPlugins(_plugins);
        if (enabled)
        {
            StartHealthChecks([plugin]);
            await LoadLatestApprovalAsync(plugin.Id);
        }
        Snackbar.Add($"{plugin.Name} {(enabled ? "enabled" : "disabled")}.", AppSeverity.Success);
    }

    private async Task SaveSettingAsync(PluginSummaryResponse plugin, string key, JsonElement value)
    {
        plugin.Settings[key] = value;
        if (!await Orchestrator.SavePluginSettingsAsync(plugin.Id, plugin.Settings))
        {
            Snackbar.Add("Plugin setting could not be saved.", AppSeverity.Error);
            return;
        }
    }

    private async Task SaveRawSettingAsync(PluginSummaryResponse plugin, string key, string rawJson)
    {
        try
        {
            var element = JsonSerializer.Deserialize<JsonElement>(rawJson);
            await SaveSettingAsync(plugin, key, element);
        }
        catch (JsonException ex)
        {
            Snackbar.Add($"Setting value is invalid: {ex.Message}", AppSeverity.Error);
        }
    }

    private async Task SaveNumberSettingAsync(PluginSummaryResponse plugin, string key, string? raw)
    {
        if (!double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed))
        {
            Snackbar.Add("Setting number is invalid.", AppSeverity.Error);
            return;
        }

        await SaveSettingAsync(plugin, key, JsonSerializer.SerializeToElement(parsed, _json));
    }

    private async Task DeletePluginAsync(PluginSummaryResponse plugin)
    {
        if (!await Orchestrator.DeletePluginAsync(plugin.Id))
        {
            Snackbar.Add("Plugin could not be deleted.", AppSeverity.Error);
            return;
        }

        Snackbar.Add($"{plugin.Name} deleted.", AppSeverity.Success);
        _selectedPluginId = null;
        _deletePluginId = null;
        await ReloadAsync();
    }

    private async Task CheckHealthAsync(PluginSummaryResponse plugin)
    {
        var result = await Orchestrator.CheckPluginHealthAsync(plugin.Id);
        if (result is not null)
            _health[plugin.Id] = result;
    }

    private async Task LoadJobsAsync(PluginSummaryResponse plugin)
    {
        _jobs[plugin.Id] = await Orchestrator.GetPluginJobsAsync(plugin.Id);
    }

    private RenderFragment SettingEditor(PluginSummaryResponse plugin, PluginSettingDefinition setting)
    {
        var options = GetSelectOptions(setting);
        if (options.Count > 0)
        {
            return @<AppSelect Label="@setting.Label"
                               Value="@ReadSettingText(setting.Value)"
                               ValueChanged="@(v => SaveStringSettingAsync(plugin, setting, v))"
                               Options="@options"
                               HelpText="@setting.HelpText" />;
        }

        if (IsBooleanSetting(setting))
        {
            return @<AppSwitchRow Label="@setting.Label"
                                 Description="@setting.HelpText"
                                 Icon="@AppMaterialIcons.Outlined.ToggleOn"
                                 Value="@ReadBoolean(setting.Value)"
                                 ValueChanged="@(v => SaveSettingAsync(plugin, setting.Key, JsonSerializer.SerializeToElement(v, _json)))" />;
        }

        if (IsNumberSetting(setting))
        {
            return @<AppTextField Label="@setting.Label"
                                  Value="@ReadNumberText(setting.Value)"
                                  ValueChanged="@(v => SaveNumberSettingAsync(plugin, setting, v))"
                                  HelpText="@setting.HelpText"
                                  InputType="AppInputType.Number" />;
        }

        if (IsStringSetting(setting))
        {
            return @<AppTextField Label="@setting.Label"
                                  Value="@ReadString(setting.Value)"
                                  ValueChanged="@(v => SaveStringSettingAsync(plugin, setting, v))"
                                  HelpText="@setting.HelpText"
                                  Placeholder="@setting.Key"
                                  InputType="@TextInputType(setting)" />;
        }

        return @<AppTextarea Label="@setting.Label"
                             Value="@setting.Value.GetRawText()"
                             ValueChanged="@(v => SaveRawSettingAsync(plugin, setting.Key, v ?? "null"))"
                             HelpText="@setting.HelpText"
                             Lines="4" />;
    }

    private IEnumerable<PluginSettingDefinition> GetSettingEntries(PluginSummaryResponse plugin)
    {
        var emitted = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var order = 0;
        if (TryGetSchemaProperties(plugin.SettingsSchema, out var properties))
        {
            foreach (var property in properties.EnumerateObject())
            {
                var value = plugin.Settings.TryGetValue(property.Name, out var current)
                    ? current
                    : ReadDefaultValue(property.Value);
                emitted.Add(property.Name);
                yield return new PluginSettingDefinition(property.Name, value, property.Value, order++);
            }
        }

        foreach (var setting in plugin.Settings
                     .Where(kvp => !emitted.Contains(kvp.Key))
                     .OrderBy(kvp => kvp.Key, StringComparer.OrdinalIgnoreCase))
        {
            yield return new PluginSettingDefinition(setting.Key, setting.Value, null, order++);
        }
    }

    private async Task SaveStringSettingAsync(PluginSummaryResponse plugin, PluginSettingDefinition setting, string? raw)
    {
        var value = CoerceStringValue(setting, raw ?? string.Empty);
        await SaveSettingAsync(plugin, setting.Key, value);
    }

    private async Task SaveNumberSettingAsync(PluginSummaryResponse plugin, PluginSettingDefinition setting, string? raw)
    {
        if (IsIntegerSetting(setting))
        {
            if (!long.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsedInteger))
            {
                Snackbar.Add("Setting number is invalid.", AppSeverity.Error);
                return;
            }

            await SaveSettingAsync(plugin, setting.Key, JsonSerializer.SerializeToElement(parsedInteger, _json));
            return;
        }

        if (!double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed))
        {
            Snackbar.Add("Setting number is invalid.", AppSeverity.Error);
            return;
        }

        await SaveSettingAsync(plugin, setting.Key, JsonSerializer.SerializeToElement(parsed, _json));
    }

    private static bool TryGetSchemaProperties(JsonElement? schema, out JsonElement properties)
    {
        if (schema is { ValueKind: JsonValueKind.Object } root
            && root.TryGetProperty("properties", out properties)
            && properties.ValueKind == JsonValueKind.Object)
        {
            return true;
        }

        properties = default;
        return false;
    }

    private static JsonElement ReadDefaultValue(JsonElement definition)
    {
        if (definition.ValueKind == JsonValueKind.Object
            && definition.TryGetProperty("default", out var defaultValue)
            && defaultValue.ValueKind is not JsonValueKind.Undefined)
        {
            return defaultValue.Clone();
        }

        var type = ReadSchemaString(definition, "type");
        return type?.ToLowerInvariant() switch
        {
            "boolean" or "bool" => JsonSerializer.SerializeToElement(false),
            "integer" or "int" => JsonSerializer.SerializeToElement(0),
            "number" => JsonSerializer.SerializeToElement(0d),
            "array" => JsonSerializer.SerializeToElement(Array.Empty<string>()),
            "object" => JsonSerializer.SerializeToElement(new Dictionary<string, string>()),
            _ => JsonSerializer.SerializeToElement(string.Empty),
        };
    }

    private static JsonElement CoerceStringValue(PluginSettingDefinition setting, string raw)
    {
        if (IsIntegerSetting(setting) && long.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var integer))
            return JsonSerializer.SerializeToElement(integer);
        if (IsNumberSetting(setting) && double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var number))
            return JsonSerializer.SerializeToElement(number);
        if (IsBooleanSetting(setting) && bool.TryParse(raw, out var boolean))
            return JsonSerializer.SerializeToElement(boolean);
        return JsonSerializer.SerializeToElement(raw);
    }

    private static bool IsBooleanSetting(PluginSettingDefinition setting) =>
        IsSchemaType(setting, "boolean", "bool") || setting.Value.ValueKind is JsonValueKind.True or JsonValueKind.False;

    private static bool IsIntegerSetting(PluginSettingDefinition setting) =>
        IsSchemaType(setting, "integer", "int");

    private static bool IsNumberSetting(PluginSettingDefinition setting) =>
        IsIntegerSetting(setting) || IsSchemaType(setting, "number") || setting.Value.ValueKind == JsonValueKind.Number;

    private static bool IsStringSetting(PluginSettingDefinition setting) =>
        IsSchemaType(setting, "string") || setting.Value.ValueKind == JsonValueKind.String;

    private static bool IsSchemaType(PluginSettingDefinition setting, params string[] types)
    {
        var type = ReadSchemaString(setting.Schema, "type");
        return type is not null && types.Contains(type, StringComparer.OrdinalIgnoreCase);
    }

    private static bool ReadBoolean(JsonElement value) =>
        value.ValueKind switch
        {
            JsonValueKind.True => true,
            JsonValueKind.False => false,
            JsonValueKind.String when bool.TryParse(value.GetString(), out var parsed) => parsed,
            _ => false,
        };

    private static IReadOnlyList<AppSelectOption> GetSelectOptions(PluginSettingDefinition setting)
    {
        if (setting.Schema is not { ValueKind: JsonValueKind.Object } schema
            || !schema.TryGetProperty("enum", out var values)
            || values.ValueKind != JsonValueKind.Array)
        {
            return [];
        }

        return values.EnumerateArray()
            .Select(value => new AppSelectOption(ReadSettingText(value), ToTitle(ReadSettingText(value))))
            .ToList();
    }

    private static AppInputType TextInputType(PluginSettingDefinition setting) =>
        string.Equals(ReadSchemaString(setting.Schema, "format"), "password", StringComparison.OrdinalIgnoreCase)
        || ReadSchemaBool(setting.Schema, "secret")
            ? AppInputType.Password
            : AppInputType.Text;

    private static string ReadString(JsonElement value) => value.ValueKind == JsonValueKind.String ? value.GetString() ?? "" : "";

    private static string ReadSettingText(JsonElement value) =>
        value.ValueKind switch
        {
            JsonValueKind.String => value.GetString() ?? string.Empty,
            JsonValueKind.Number => value.GetRawText(),
            JsonValueKind.True => "true",
            JsonValueKind.False => "false",
            _ => value.GetRawText(),
        };

    private static string ReadNumberText(JsonElement value) =>
        value.TryGetDouble(out var parsed)
            ? parsed.ToString(CultureInfo.InvariantCulture)
            : "0";

    private static string? ReadSchemaString(JsonElement? schema, string propertyName) =>
        schema is { ValueKind: JsonValueKind.Object } element
        && element.TryGetProperty(propertyName, out var property)
        && property.ValueKind == JsonValueKind.String
            ? property.GetString()
            : null;

    private static bool ReadSchemaBool(JsonElement? schema, string propertyName) =>
        schema is { ValueKind: JsonValueKind.Object } element
        && element.TryGetProperty(propertyName, out var property)
        && property.ValueKind is JsonValueKind.True or JsonValueKind.False
        && property.GetBoolean();

    private static AppUiTone HealthTone(string status) => string.Equals(status, "healthy", StringComparison.OrdinalIgnoreCase) ? AppUiTone.Success : AppUiTone.Warning;

    private static string PluginIcon(PluginSummaryResponse plugin) => plugin.Id switch
    {
        var id when id.Contains("commercial", StringComparison.OrdinalIgnoreCase) => AppMaterialIcons.Outlined.LiveTv,
        var id when id.Contains("intro", StringComparison.OrdinalIgnoreCase) => AppMaterialIcons.Outlined.FastForward,
        var id when id.Contains("credits", StringComparison.OrdinalIgnoreCase) => AppMaterialIcons.Outlined.MovieFilter,
        var id when id.Contains("ai", StringComparison.OrdinalIgnoreCase) => AppMaterialIcons.Outlined.Memory,
        _ => AppMaterialIcons.Outlined.Extension,
    };

    private static string ToTitle(string key)
    {
        var text = key.Replace('_', ' ').Replace('-', ' ');
        return string.IsNullOrWhiteSpace(text)
            ? key
            : string.Concat(char.ToUpperInvariant(text[0]), text[1..]);
    }

    private sealed record PluginSettingDefinition(
        string Key,
        JsonElement Value,
        JsonElement? Schema,
        int Order)
    {
        public string Label => ReadSchemaString(Schema, "title")
            ?? ReadSchemaString(Schema, "label")
            ?? ToTitle(Key);

        public string? HelpText => ReadSchemaString(Schema, "description")
            ?? ReadSchemaString(Schema, "help_text");

        public bool Advanced => ReadSchemaBool(Schema, "advanced")
            || ReadSchemaBool(Schema, "ui:advanced")
            || ReadSchemaBool(Schema, "x-advanced");
    }
}
