        return @<AppProviderLogo ImageUrl="@ApiClient.GetProviderIconUrl(plugin.Id)" Icon="@icon" AccentColor="@colour"
                                 FallbackText="@plugin.Name[..1]" Size="@(size > 32 ? AppControlSize.Normal : AppControlSize.Compact)" AltText="" />;
    }

    // Two media pills and "+N" (the rest are on the plugin's page); a plugin for every type says so in one neutral pill.
    private static RenderFragment MediaPills(PluginSummaryResponse plugin) => @<text>
