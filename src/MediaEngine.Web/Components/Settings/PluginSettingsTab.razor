    // A plugin that needs a tool the health check cannot find: the strip names the tools and opens Tools and requirements.
    private static string? MissingToolText(PluginSummaryResponse plugin, HealthWord word)
    {
        if (word is not (HealthWord.NeedsAttention or HealthWord.Broken) || plugin.ToolRequirements.Count == 0)
            return null;

        var names = plugin.ToolRequirements
            .Select(requirement => string.IsNullOrWhiteSpace(requirement.ExecutableName) ? requirement.Id : requirement.ExecutableName)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(ToTitle)
            .ToList();
        return $"Requires {string.Join(" or ", names)}. Install it for full functionality.";
    }

    private static string MissingToolShortText(PluginSummaryResponse plugin)
    {
        var names = plugin.ToolRequirements
            .Select(requirement => string.IsNullOrWhiteSpace(requirement.ExecutableName) ? requirement.Id : requirement.ExecutableName)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(ToTitle);
        return $"Requires {string.Join(" or ", names)}";
    }

