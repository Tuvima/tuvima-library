@namespace MediaEngine.Web.Components.Settings
@using System.Globalization
@using System.Text.Json
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Contracts.Approvals
@using MediaEngine.Contracts.System
@using MediaEngine.Web.Services.Formatting
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Navigation
@using MediaEngine.Web.Services.Settings
@implements IDisposable
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject IAppToastService Snackbar
@inject DeviceContextService DeviceContext
@inject SettingsAttentionState Attention
@inject ApprovalFlow Approvals
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IServiceProvider Services
@using MediaEngine.Contracts.Plugins
@inject IStringLocalizer<SharedStrings> L

@if (_loading)
{
    <div class="settings-plugin-loading">
        <AppSkeleton Size="AppControlSize.Large" />
        <div class="settings-plugin-loading__grid">
            <AppSkeleton Size="AppControlSize.Large" />
            <AppSkeleton Size="AppControlSize.Large" />
        </div>
    </div>
}
else
{
    <div class="tl-page settings-plugin-page">
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <AppAlert Tone="AppUiTone.Error">@_error</AppAlert>
        }
        @* Nothing sits under the grid (Plugins and Integrations screens v3 D16): the list is tiles, and Configure opens the
           plugin's own page. *@
        @if (!string.IsNullOrWhiteSpace(DetailPluginId))
        {
            @PluginDetailPage()
        }
        else
        {
            @PluginsListPage()
        }
    </div>
}

@code {
    private readonly JsonSerializerOptions _json = MediaEngineJson.Web;
    private readonly Dictionary<string, PluginHealthResponse> _health = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, IReadOnlyList<OperationDto>> _jobs = new(StringComparer.OrdinalIgnoreCase);
    private List<PluginSummaryResponse> _plugins = [];
    private readonly HashSet<string> _healthLoading = new(StringComparer.OrdinalIgnoreCase);
    private readonly CancellationTokenSource _disposed = new();
    private IReadOnlyList<ScheduledTaskDto>? _tasks;
    private bool _tasksLoaded;
    private bool _loading = true;
    private string? _error;
    private readonly Dictionary<string, ApprovalRecordResponse> _latestApproval = new(StringComparer.OrdinalIgnoreCase);
    private string? _deletePluginId;
    private PluginRemovalPreviewResponse? _removalPreview;
    private string _removeOutput = "keep";
    private bool _switchOffDependants;
    private string? _removeProblem;
    private readonly Dictionary<string, PluginDependenciesResponse> _dependencies = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, PluginLibraryLimitResponse> _libraryLimits = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, PluginActivityResponse> _activity = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, PluginCheckNowResponse> _checkNow = new(StringComparer.OrdinalIgnoreCase);
    private string? _editLibrariesFor;
    private HashSet<string> _pickedLibraries = [];

    /// <summary>
    /// The plugin a <c>/settings/plugins?plugin={id}</c> link points at. When it names an installed plugin the page scrolls to
    /// that plugin's card, rings it and opens its settings; an id that matches nothing leaves the page as it normally opens.
    /// </summary>
    [Parameter] public string? FocusPluginId { get; set; }

    /// <summary>The plugin or provider whose own page is open (<c>/settings/plugins/{id}</c>); null shows the list.</summary>
    [Parameter] public string? DetailPluginId { get; set; }

    /// <summary>The open tab of the plugin's page: <c>settings</c>, <c>access</c> or <c>activity</c>; anything else is Overview.</summary>
    [Parameter] public string? DetailTab { get; set; }

    /// <summary>Tells the Settings page the plugin's name for its breadcrumb.</summary>
    [Parameter] public EventCallback<string> NameChanged { get; set; }

    private string? _appliedDetailId;
    private readonly Dictionary<string, ProviderStatusDto> _providerStatus = new(StringComparer.OrdinalIgnoreCase);

    private string? _focusedPluginId;
    private string? _appliedFocusRequest;
    private bool _scrollToFocused;

    private PluginSummaryResponse? DetailPlugin => string.IsNullOrWhiteSpace(DetailPluginId)
        ? null
        : _plugins.FirstOrDefault(p => string.Equals(p.Id, DetailPluginId, StringComparison.OrdinalIgnoreCase));

    private static bool IsProvider(PluginSummaryResponse plugin) => string.Equals(plugin.ListingKind, "provider", StringComparison.OrdinalIgnoreCase);

    private const int PageSize = 24;
    private static readonly AppCountTab[] NoTabs = [];

    private bool _uploadOpen;

    private async Task UploadedAsync(string message)
    {
        Snackbar.Add(message, AppSeverity.Success);
        await ReloadAsync();
    }

    private string? _search;
    private IReadOnlyCollection<string> _statusTicks = [];
    private IReadOnlyCollection<string> _showTicks = [];
    private string _sort = "name";
    private string _layout = AppLayoutSwitch.Cards;
    private string _categoryTab = "all";
    private int _page = 1;

    // Status ticks and Show ticks (Plugins and Integrations screens v4 D41): several may be ticked at once; a plugin matches when
    // it fits any ticked word of a menu, and must fit both menus when both have ticks.
    private static readonly IReadOnlyList<AppSelectOption> StatusOptions =
    [
        new("on", "On"),
        new("off", "Off"),
        new("needs-key", "Needs a key"),
        new("missing-tools", "Missing tools"),
        new("waiting-ai", "Waiting for Local AI"),
        new("broken", "Broken"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> ShowOptions =
    [
        new("official", "Official"),
        new("private", "Private"),
        new("ai", "AI enabled"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> SortOptions =
    [
        new("name", "Name"),
        new("status", "Status"),
    ];

    // Named for when Library uses the plugin (v4 D31).
    private static readonly (string Key, string Label)[] Categories =
    [
        (PluginCategories.Intake, "Getting items in"),
        (PluginCategories.Enrichment, "After import"),
        (PluginCategories.Accounts, "Accounts & lists"),
    ];

    private static string CategoryLabel(PluginSummaryResponse plugin) =>
        Categories.FirstOrDefault(category => category.Key == PluginCategories.Resolve(plugin.Category)).Label ?? "After import";

    private bool Narrowed => !string.IsNullOrWhiteSpace(_search) || _statusTicks.Count > 0 || _showTicks.Count > 0;

    private HealthWord WordOf(PluginSummaryResponse plugin)
    {
        _health.TryGetValue(plugin.Id, out var health);
        return StateCardHealth.ForPlugin(plugin, health, StateCardHealth.LatestRun(_tasks, plugin.Id)).Word;
    }

    // Dependencies that are off, missing or the wrong version, by plugin id, read from the Engine when the page loads.
    private readonly Dictionary<string, IReadOnlyList<string>> _waitingFor = new(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<string> WaitingFor(PluginSummaryResponse plugin) =>
        _waitingFor.TryGetValue(plugin.Id, out var names) ? names : [];

    private bool NeedsAttention(PluginSummaryResponse plugin) =>
        WordOf(plugin) is HealthWord.NeedsAttention or HealthWord.Broken || WaitingFor(plugin).Count > 0;

    private bool MatchesSearch(PluginSummaryResponse plugin)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        var term = _search.Trim();
        bool Has(string? text) => text?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;
        return Has(plugin.Name) || Has(plugin.ShortDescription) || Has(plugin.Description) || Has(plugin.Id) || Has(CategoryLabel(plugin))
            || plugin.Provides.Any(Has)
            || plugin.Capabilities.Any(capability => Has(capability.Name) || Has(capability.Description));
    }

    private bool MatchesStatus(PluginSummaryResponse plugin)
    {
        if (_statusTicks.Count == 0)
            return true;

        var status = StatusOf(plugin);
        return _statusTicks.Any(tick => tick switch
        {
            "on" => plugin.Enabled,
            "off" => !plugin.Enabled,
            var key => status.Key == key,
        });
    }

    private bool MatchesShow(PluginSummaryResponse plugin) =>
        _showTicks.Count == 0 || _showTicks.Any(tick => tick switch
        {
            "official" => IsOfficial(plugin),
            "private" => IsPrivate(plugin),
            "ai" => plugin.RequiresLocalAi,
            _ => false,
        });

    private static bool IsOfficial(PluginSummaryResponse plugin) =>
        string.Equals(plugin.TrustLevel, "official", StringComparison.OrdinalIgnoreCase);

    private static bool IsPrivate(PluginSummaryResponse plugin) =>
        string.Equals(plugin.TrustLevel, "private", StringComparison.OrdinalIgnoreCase);

    // Everything that narrows the list except the category tab, so the tab counts add up to what each tab would show.
    private List<PluginSummaryResponse> FilteredIgnoringTab() => _plugins
        .Where(MatchesSearch)
        .Where(MatchesStatus)
        .Where(MatchesShow)
        .ToList();

    private List<PluginSummaryResponse> VisiblePlugins()
    {
        var list = FilteredIgnoringTab()
            .Where(plugin => _categoryTab == "all" || PluginCategories.Resolve(plugin.Category) == _categoryTab);
        return (_sort switch
        {
            "status" => list.OrderByDescending(plugin => plugin.Enabled).ThenBy(plugin => plugin.Name, StringComparer.OrdinalIgnoreCase),
            _ => list.OrderBy(plugin => plugin.Name, StringComparer.OrdinalIgnoreCase),
        }).ToList();
    }

    private IReadOnlyList<AppCountTab> CategoryTabs()
    {
        var pool = FilteredIgnoringTab();
        return
        [
            new AppCountTab("all", "All", pool.Count),
            .. Categories.Select(category => new AppCountTab(category.Key, category.Label, pool.Count(plugin => PluginCategories.Resolve(plugin.Category) == category.Key))),
        ];
    }

    private void ClearFilters()
    {
        _search = null;
        _statusTicks = [];
        _showTicks = [];
        _page = 1;
    }

    private void Narrow(Action change)
    {
        change();
        _page = 1;
    }

    private RenderFragment PluginsListPage() => @<div class="settings-plugin-page">
        @if (!DeviceContext.IsMobile)
        {
            <AppListPageHeader>
                <Actions>
                    <AppButton Label="Upload plugin" StartIcon="@AppMaterialIcons.Outlined.UploadFile" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="@(() => _uploadOpen = true)" />
                </Actions>
            </AppListPageHeader>
        }
        <PluginUploadDialog Open="@_uploadOpen" OnClosed="@(() => { _uploadOpen = false; })" OnUploaded="@UploadedAsync" />
        <AppSummaryStrip AriaLabel="Plugin summary" Items="@SummaryItems()" />
        @if (_plugins.Count == 0)
        {
            <AppEmptyState Title="No plugins installed" Message="The Engine did not return any installed extensions.">
                <Action><AppButton Label="Read the plugins guide" Href="@(ProjectLinks.DocsSite + "guides/developer-tools/")" Target="_blank" Size="AppControlSize.Compact" /></Action>
            </AppEmptyState>
        }
        else
        {
            @if (!DeviceContext.IsMobile)
            {
                <AppSearchFilterRow Search="@_search"
                                    SearchChanged="@(value => Narrow(() => _search = value))"
                                    Placeholder="@L["PluginSettingsTab_SearchPluginsByNameOr"].Value"
                                    Narrowed="@Narrowed"
                                    OnClear="@ClearFilters">
                    <AppTickMenu Label="Status" Options="@StatusOptions" Selected="@_statusTicks"
                                 SelectedChanged="@(ticks => Narrow(() => _statusTicks = ticks))" />
                    <AppTickMenu Label="Show" Options="@ShowOptions" Selected="@_showTicks"
                                 SelectedChanged="@(ticks => Narrow(() => _showTicks = ticks))" />
                    <AppSelect Label="Sort" Value="@_sort" Options="@SortOptions" Native="true" FullWidth="false"
                               ValueChanged="@(value => Narrow(() => _sort = value ?? "name"))" />
                    <AppLayoutSwitch StorageKey="tuvima.plugins.layout" Value="@_layout" ValueChanged="@(value => _layout = value)" AriaLabel="Plugins layout" />
                </AppSearchFilterRow>
            }
            <AppCountTabs Tabs="@CategoryTabs()" Selected="@_categoryTab" AriaLabel="Plugin categories"
                          SelectedChanged="@(key => Narrow(() => _categoryTab = key))" />
            var visible = VisiblePlugins();
            _page = Math.Clamp(_page, 1, Math.Max(1, (int)Math.Ceiling(visible.Count / (double)PageSize)));
            @if (visible.Count == 0)
            {
                @if (Narrowed)
                {
                    <AppEmptyState Title="No plugins match" Message="Nothing installed fits that search or filter.">
                        <Action><AppButton Label="Clear filters" Size="AppControlSize.Compact" OnClick="@ClearFilters" /></Action>
                    </AppEmptyState>
                }
                else
                {
                    <AppEmptyState Title="Nothing in this category yet" Message="Plugins of this kind will appear here." />
                }
            }
            else
            {
                @if (_layout == AppLayoutSwitch.List && !DeviceContext.IsMobile)
                {
                    @PluginRows(visible.Skip((_page - 1) * PageSize).Take(PageSize).ToList())
                }
                else
                {
                    <div class="app-card-grid" role="list">
                        @foreach (var plugin in visible.Skip((_page - 1) * PageSize).Take(PageSize))
                        {
                            var focused = IsFocused(plugin);
                            <div role="listitem"
                                 @key="plugin.Id"
                                 id="@CardElementId(plugin.Id)"
                                 class="@(focused ? "settings-plugin-card-focus" : null)"
                                 data-focused="@(focused ? "true" : null)">@PluginCard(plugin)</div>
                        }
                    </div>
                }
                <AppPager Total="@visible.Count" PageSize="@PageSize" Page="@_page" Noun="plugins" PageChanged="@(page => _page = page)" />
            }
        }
    </div>;

    // The plugin's own page (Plugins and Integrations screens v4 D33): one short column. The header is the logo with its dot, the name,
    // one status sentence and the switch. Two tabs, Set up (the default) and Activity, are real addresses so a tab can be shared.
    private RenderFragment PluginDetailPage()
    {
        if (DetailPlugin is not { } plugin)
        {
            return @<AppEmptyState Title="That plugin is not installed" Message="Nothing installed has that name. Go back to the list to pick one.">
                <Action><AppButton Label="All plugins" Href="/settings/plugins" Size="AppControlSize.Compact" /></Action>
            </AppEmptyState>;
        }

        var status = StatusOf(plugin);
        var canChange = !DeviceContext.IsMobile;
        var tab = DetailTab is "activity" ? "activity" : "setup";
        var tabs = new List<AppCountTab>
        {
            new("setup", "Set up", null, DetailHref(plugin.Id, "setup")),
            new("activity", "Activity", null, DetailHref(plugin.Id, "activity")),
        };

        return @<div class="plugin-page" data-testid="plugin-page">
            <header class="plugin-page__header">
                <AppStatusDot Tone="@status.Tone" Sentence="@status.Sentence">@TileLogo(plugin, 48)</AppStatusDot>
                <div class="plugin-page__title">
                    <h2>@plugin.Name</h2>
                    <p data-testid="plugin-status-sentence">@status.Sentence</p>
                </div>
                @if (canChange && SwitchState(plugin, canChange) is { } on)
                {
                    <div class="plugin-page__actions">
                        <AppSwitchRow Value="@on" ValueChanged="@(value => SetEnabledAsync(plugin, value))"
                                      Disabled="@(SwitchDisabledReason(plugin) is not null)" AriaLabel="@($"Switch {plugin.Name} on or off")" />
                    </div>
                }
            </header>
            <AppCountTabs Tabs="@tabs" Selected="@tab" AriaLabel="@($"{plugin.Name} sections")" />
            @if (tab == "activity")
            {
                @PluginActivitySection(plugin)
            }
            else
            {
                @PluginSetUp(plugin, status)
            }
        </div>;
    }

    // Set up: at most five cards, in this order, each absent when it has nothing to say (v4 D33): Access, What it provides,
    // Settings, Privacy, About.
    private RenderFragment PluginSetUp(PluginSummaryResponse plugin, TileStatus status)
    {
        _health.TryGetValue(plugin.Id, out var health);
        var state = StateCardHealth.ForPlugin(plugin, health, StateCardHealth.LatestRun(_tasks, plugin.Id));
        var missing = MissingToolText(plugin, state.Word);
        var waiting = WaitingFor(plugin);
        return @<div class="plugin-page__setup" data-testid="plugin-setup">
            @if (waiting.Count > 0 || missing is not null || (plugin.RequiresLocalAi && Attention.LocalAiBlocked))
            {
                <AppAlert Tone="AppUiTone.Warning" data-testid="plugin-overview-attention">
                    @(plugin.RequiresLocalAi && Attention.LocalAiBlocked ? "It is waiting for Local AI." : waiting.Count > 0 ? $"It is waiting for {string.Join(" and ", waiting)}." : missing)
                    <AppActionBar Align="AppHorizontalAlignment.Start">
                        @if (plugin.RequiresLocalAi && Attention.LocalAiBlocked)
                        {
                            <AppButton Label="Set up Local AI" Href="/settings/ai" Size="AppControlSize.Compact" />
                        }
                        else if (missing is not null)
                        {
                            <AppButton Label="Open Tools & requirements" Href="/settings/tools" Size="AppControlSize.Compact" />
                        }
                        <AppButton Label="Check again" StartIcon="@AppMaterialIcons.Outlined.Refresh" Size="AppControlSize.Compact" OnClick="@(() => CheckNowAsync(plugin))" />
                    </AppActionBar>
                </AppAlert>
            }
            @if (IsProvider(plugin))
            {
                <ProviderDetail ProviderKey="@plugin.Id" Plugin="@plugin" Changed="@ReloadAsync"
                                ExtraSettings="@PluginWhoAndLibraries(plugin)" About="@PluginAboutCard(plugin)" />
            }
            else
            {
                @if (plugin.DeclaredSecrets > 0)
                {
                    <AppCard Title="Access" Class="plugin-page__card" data-testid="plugin-access-card"><PluginAppDetails PluginId="@plugin.Id" /></AppCard>
                }
                <AppCard Title="What it provides" Class="plugin-page__card" data-testid="plugin-provides-card"><PluginProvidesLine Plugin="@plugin" /></AppCard>
                <AppCard Title="Settings" Class="plugin-page__card" data-testid="plugin-settings-card">
                    @PluginSettingsPanel(plugin)
                    @PluginWhoAndLibraries(plugin)
                </AppCard>
                @PluginPrivacyCard(plugin)
                @PluginAboutCard(plugin)
            }
        </div>;
    }

    // The List view (Plugins and Integrations screens v4 D40): dot and logo, name, what it provides, one status sentence, the switch
    // and one button. 56 px rows; nothing wraps at 1280.
    private RenderFragment PluginRows(IReadOnlyList<PluginSummaryResponse> plugins) => @<AppTable Class="settings-plugin-rows" data-testid="plugin-rows">
        <thead>
            <tr><th scope="col">Plugin</th><th scope="col">Provides</th><th scope="col">Status</th><th scope="col"><span class="settings-plugin-rows__sr">Switch</span></th><th scope="col"><span class="settings-plugin-rows__sr">Action</span></th></tr>
        </thead>
        <tbody>
            @foreach (var plugin in plugins)
            {
                var status = StatusOf(plugin);
                var focused = IsFocused(plugin);
                <tr @key="plugin.Id" id="@CardElementId(plugin.Id)" data-plugin-row="@plugin.Id" class="@(focused ? "settings-plugin-card-focus" : null)" data-focused="@(focused ? "true" : null)">
                    <td>
                        <div class="settings-plugin-rows__name">
                            <AppStatusDot Tone="@status.Tone" Sentence="@status.Sentence">@TileLogo(plugin, 32)</AppStatusDot>
                            <span class="settings-plugin-rows__copy">
                                <a href="@DetailHref(plugin.Id)" title="@plugin.LongDescription">@plugin.Name</a>
                                @if (IsPrivate(plugin)) { <span class="settings-plugin-rows__private">Private</span> }
                                <small title="@plugin.LongDescription">@plugin.ShortDescription</small>
                            </span>
                        </div>
                    </td>
                    <td><PluginProvidesLine Plugin="@plugin" /></td>
                    <td>@status.Sentence</td>
                    <td>
                        @if (SwitchState(plugin, true) is { } on)
                        {
                            <AppSwitchRow Value="@on" ValueChanged="@(value => SetEnabledAsync(plugin, value))" Disabled="@(SwitchDisabledReason(plugin) is not null)" AriaLabel="@($"Switch {plugin.Name} on or off")" />
                        }
                    </td>
                    <td>
                        <div class="settings-plugin-rows__actions">
                            <AppButton Label="@status.ButtonLabel" Size="AppControlSize.Compact" aria-label="@($"{status.ButtonLabel} for {plugin.Name}")"
                                       OnClick="@(() => RunTileAction(plugin, status))" />
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </AppTable>;

    private IReadOnlyList<AppSummaryItem> SummaryItems()
    {
        var attention = _plugins.Count(NeedsAttention);
        return
        [
            new("installed", _plugins.Count.ToString(CultureInfo.InvariantCulture), AppMaterialIcons.Outlined.Extension, AppSummaryTone.Accent),
            new("switched on", _plugins.Count(plugin => plugin.Enabled).ToString(CultureInfo.InvariantCulture), AppMaterialIcons.Outlined.CheckCircle, AppSummaryTone.Ok),
            new("need attention", attention.ToString(CultureInfo.InvariantCulture), attention == 0 ? AppMaterialIcons.Outlined.CheckCircle : AppMaterialIcons.Outlined.Warning, attention == 0 ? AppSummaryTone.Mute : AppSummaryTone.Warn),
        ];
    }

    // A tile says five things and no more (v4 D30): logo with its status dot, name and switch, what it provides, a short description
    // (the full text on hover) and one button that is the fix when something is wrong.
    private RenderFragment PluginCard(PluginSummaryResponse plugin)
    {
        var status = StatusOf(plugin);
        // Phones read the cards; switching and configuring plugins stays on desktop and tablet.
        var canChange = !DeviceContext.IsMobile;
        return @<AppListCard Title="@plugin.Name"
                             Description="@plugin.ShortDescription"
                             DescriptionTitle="@plugin.LongDescription"
                             Class="@(IsPrivate(plugin) ? "app-list-card--private" : null)"
                             data-state-card="plugin"
                             data-health="@WordOf(plugin).ToString().ToLowerInvariant()">
            <Logo><AppStatusDot Tone="@status.Tone" Sentence="@status.Sentence">@TileLogo(plugin, 40)</AppStatusDot></Logo>
            <Aside>
                @if (SwitchState(plugin, canChange) is { } on)
                {
                    <AppSwitchRow Value="@on"
                                  ValueChanged="@(value => SetEnabledAsync(plugin, value))"
                                  Disabled="@(SwitchDisabledReason(plugin) is not null)"
                                  AriaLabel="@($"Switch {plugin.Name} on or off")"
                                  StopClickPropagation="true" />
                }
            </Aside>
            <ChildContent>
                <PluginProvidesLine Plugin="@plugin" />
            </ChildContent>
            <Footer>
                @if (canChange)
                {
                    <AppButton Label="@status.ButtonLabel" Size="AppControlSize.Compact"
                               aria-label="@($"{status.ButtonLabel} for {plugin.Name}")"
                               OnClick="@(() => RunTileAction(plugin, status))" />
                }
            </Footer>
        </AppListCard>;
    }

    private sealed record TileStatus(AppStatusDotTone Tone, string Sentence, string Key, string ButtonLabel);

    // The one status a tile, row and page header shows (v4 D29): a dot colour, one sentence, a filter key and the button's words.
    // When the dot is amber or red the button is the fix; otherwise it is Configure.
    private TileStatus StatusOf(PluginSummaryResponse plugin)
    {
        if (IsProvider(plugin) && plugin.Provider is { } provider)
        {
            if (provider.AlwaysOn)
                return new(AppStatusDotTone.Off, "Always on", "always-on", "Configure");
            if (provider.RequiresKey && !provider.KeyPresent)
                return new(AppStatusDotTone.Attention, "Needs a key", "needs-key", "Add key");
            if (!plugin.Enabled)
                return new(AppStatusDotTone.Off, "Off", "off", "Configure");
            return _providerStatus.TryGetValue(plugin.Id, out var providerStatus) && ProviderIsFailing(providerStatus)
                ? new(AppStatusDotTone.Broken, providerStatus.LastFailureReason ?? "Not responding", "broken", "Retry")
                : new(AppStatusDotTone.Working, "Working", "working", "Configure");
        }

        if (plugin.RequiresLocalAi && Attention.LocalAiBlocked)
            return new(AppStatusDotTone.Attention, "Waiting for Local AI", "waiting-ai", "Set up Local AI");

        _health.TryGetValue(plugin.Id, out var health);
        var state = StateCardHealth.ForPlugin(plugin, health, StateCardHealth.LatestRun(_tasks, plugin.Id));
        if (WaitingFor(plugin) is { Count: > 0 } waiting)
            return new(AppStatusDotTone.Attention, $"Waiting for {string.Join(" and ", waiting)}", "waiting", "Configure");

        if (MissingToolText(plugin, state.Word) is { } missing)
            return new(AppStatusDotTone.Attention, missing, "missing-tools", "Install tools");

        return state.Word switch
        {
            HealthWord.NeedsAttention => new(AppStatusDotTone.Attention, state.LastProblem ?? "Needs attention", "needs-attention", "Configure"),
            HealthWord.Broken => new(AppStatusDotTone.Broken, state.LastProblem ?? "Not working", "broken", "Retry"),
            HealthWord.Off => new(AppStatusDotTone.Off, "Off", "off", "Configure"),
            _ when !plugin.Enabled => new(AppStatusDotTone.Off, "Off", "off", "Configure"),
            _ => new(AppStatusDotTone.Working, "Working", "working", "Configure"),
        };
    }

    // The tile's button: the fix when the dot is amber or red, otherwise the plugin's own page.
    private void RunTileAction(PluginSummaryResponse plugin, TileStatus status)
    {
        switch (status.ButtonLabel)
        {
            case "Set up Local AI":
                Navigation.NavigateTo("/settings/ai");
                break;
            case "Install tools":
                Navigation.NavigateTo("/settings/tools");
                break;
            case "Retry":
                _ = ReloadAsync();
                break;
            default:
                ConfigurePlugin(plugin.Id);
                break;
        }
    }

    // A provider shows its bundled brand logo (an uploaded one overrides it); a plugin that runs on Local AI has no brand logo,
    // so its box is a purple sparkle (v4 D32); any other plugin keeps the extension icon.
    private RenderFragment TileLogo(PluginSummaryResponse plugin, int size)
    {
        var compact = size > 32 ? AppControlSize.Normal : AppControlSize.Compact;
        if (plugin.RequiresLocalAi)
        {
            return @<AppProviderLogo Icon="@AppMaterialIcons.Outlined.AutoAwesome" AccentColor="#7E57C2" FallbackText="AI" Size="@compact" AltText="" />;
        }

        if (IsProvider(plugin))
        {
            var (colour, icon) = Services.GetService<ProviderCatalogueService>()?.GetAccent(plugin.Id) ?? (string.Empty, AppMaterialIcons.Outlined.Extension);
            var image = string.IsNullOrWhiteSpace(plugin.IconPath) ? null : "/" + plugin.IconPath.TrimStart('/');
            return @<AppProviderLogo ImageUrl="@image" Icon="@icon" AccentColor="@colour" FallbackText="@plugin.Name[..1]" Size="@compact" AltText="" />;
        }

        return @<AppProviderLogo Icon="@PluginIcon(plugin)" FallbackText="@plugin.Name[..1]" Size="@compact" AltText="" />;
    }

    // One status pill per tile (Plugins and Integrations screens v3 D19): Working, Off, Always on, Broken, or the amber reason
    // itself. Never two amber pills; the full sentence is the pill's tooltip and the page's Overview says what to do.
    private (string? Text, AppUiTone? Tone, string? Title) StatusPill(PluginSummaryResponse plugin, StateCardHealthResult state)
    {
        if (IsProvider(plugin) && plugin.Provider is { } provider)
        {
            if (provider.AlwaysOn)
                return ("Always on", AppUiTone.Neutral, "A core source: it is always on and has no switch.");
            if (provider.RequiresKey && !provider.KeyPresent)
                return ("Needs a key", AppUiTone.Warning, "Add your own key on its page to switch it on.");
            if (!plugin.Enabled)
                return ("Off", AppUiTone.Neutral, null);
            return _providerStatus.TryGetValue(plugin.Id, out var status) && ProviderIsFailing(status)
                ? ("Broken", AppUiTone.Error, status.LastFailureReason)
                : ("Working", AppUiTone.Success, null);
        }

        if (WaitingFor(plugin) is { Count: > 0 } waiting)
        {
            var words = $"Waiting for {string.Join(" and ", waiting)}";
            return (words, AppUiTone.Warning, words);
        }

        if (MissingToolText(plugin, state.Word) is { } missing)
            return (MissingToolShortText(plugin), AppUiTone.Warning, missing);

        if (state.Word == HealthWord.Off)
            return ("Off", AppUiTone.Neutral, null);

        return (null, null, null);
    }

    private static bool ProviderIsFailing(ProviderStatusDto status) =>
        string.Equals(status.HealthStatus, "Down", StringComparison.OrdinalIgnoreCase)
        || string.Equals(status.ConnectionStatus, "failed", StringComparison.OrdinalIgnoreCase);

    private bool? SwitchState(PluginSummaryResponse plugin, bool canChange)
    {
        if (!canChange || (plugin.Provider?.AlwaysOn ?? false))
            return null;
        return plugin.Enabled;
    }

    // A provider shows its own mark in its own colour; a plugin keeps the extension icon.
    private RenderFragment? ProviderLogo(PluginSummaryResponse plugin, int size)
    {
        if (!IsProvider(plugin))
            return null;

        var (colour, icon) = Services.GetService<ProviderCatalogueService>()?.GetAccent(plugin.Id) ?? (string.Empty, AppMaterialIcons.Outlined.Extension);
        return @<AppProviderLogo ImageUrl="@ApiClient.GetProviderIconUrl(plugin.Id)" Icon="@icon" AccentColor="@colour"
                                 FallbackText="@plugin.Name[..1]" Size="@(size > 32 ? AppControlSize.Normal : AppControlSize.Compact)" AltText="" />;
    }

    // Two media pills and "+N" (the rest are on the plugin's page); a plugin for every type says so in one neutral pill.
    private static RenderFragment MediaPills(PluginSummaryResponse plugin) => @<text>
        @if (plugin.MediaTypes.Count == 0)
        {
            <AppStatusBadge Text="All media" Tone="AppUiTone.Neutral" />
        }
        else
        {
            @foreach (var media in plugin.MediaTypes.Take(2))
            {
                <AppMediaPill Media="@media" />
            }
            @if (plugin.MediaTypes.Count > 2)
            {
                <AppStatusBadge Text="@($"+{plugin.MediaTypes.Count - 2}")" Tone="AppUiTone.Neutral" Title="@string.Join(", ", plugin.MediaTypes.Skip(2))" />
            }
        }
    </text>;

    // A plugin that needs a tool the health check cannot find: the strip names the tools and opens Tools and requirements.
    private static string? MissingToolText(PluginSummaryResponse plugin, HealthWord word)
    {
        if (word is not (HealthWord.NeedsAttention or HealthWord.Broken) || plugin.ToolRequirements.Count == 0)
            return null;

        var names = plugin.ToolRequirements
            .Select(requirement => string.IsNullOrWhiteSpace(requirement.ExecutableName) ? requirement.Id : requirement.ExecutableName)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(ToTitle)
            .ToList();
        return $"Requires {string.Join(" or ", names)}. Install it for full functionality.";
    }

    private static string MissingToolShortText(PluginSummaryResponse plugin)
    {
        var names = plugin.ToolRequirements
            .Select(requirement => string.IsNullOrWhiteSpace(requirement.ExecutableName) ? requirement.Id : requirement.ExecutableName)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(ToTitle);
        return $"Requires {string.Join(" or ", names)}";
    }

    // The "..." menu opens the matching tab of the plugin's own page.
    private IReadOnlyList<AppRowMenuItem> PluginMenuItems(PluginSummaryResponse plugin)
    {
        var items = new List<AppRowMenuItem>();
        if (!IsProvider(plugin))
        {
            items.Add(new() { Label = L["PluginSettingsTab_CheckHealth"].Value, Icon = AppMaterialIcons.Outlined.HealthAndSafety, OnClick = EventCallback.Factory.Create(this, () => CheckHealthFromMenuAsync(plugin)) });
        }

        items.Add(new() { Label = L["PluginSettingsTab_WhatItCanAccess"].Value, Icon = AppMaterialIcons.Outlined.Visibility, OnClick = EventCallback.Factory.Create(this, () => ConfigurePlugin(plugin.Id, "access")) });
        items.Add(new() { Label = L["Common_Activity"].Value, Icon = AppMaterialIcons.Outlined.History, OnClick = EventCallback.Factory.Create(this, () => ConfigurePlugin(plugin.Id, "activity")) });
        if (!plugin.IsBuiltIn)
        {
            items.Add(new() { Label = L["Common_Remove"].Value, Icon = AppMaterialIcons.Outlined.Delete, Destructive = true, OnClick = EventCallback.Factory.Create(this, () => ConfigurePlugin(plugin.Id)) });
        }

        return items;
    }

    private async Task CheckHealthFromMenuAsync(PluginSummaryResponse plugin)
    {
        await CheckHealthAsync(plugin);
        Snackbar.Add($"{plugin.Name}: health checked.", AppSeverity.Info);
    }

    // A plugin that cannot work here cannot be switched on; once it is on, switching off is always allowed.
    private string? SwitchDisabledReason(PluginSummaryResponse plugin) =>
        plugin.Provider is { RequiresKey: true, KeyPresent: false } && !plugin.Enabled
        ? "Add your key first."
        : plugin.RequiresLocalAi && Attention.LocalAiBlocked && !plugin.Enabled
        ? "Waiting for Local AI. Set it up first."
        : !plugin.IsCompatible && !plugin.Enabled
        ? string.IsNullOrWhiteSpace(plugin.CompatibilityProblem) ? "This plugin cannot be switched on here." : plugin.CompatibilityProblem
        : null;

