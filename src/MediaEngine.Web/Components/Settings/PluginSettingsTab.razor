                                     Value="@_switchOffDependants"
                                     ValueChanged="@(on => _switchOffDependants = on)" />
                    }
                }

                @if (!string.IsNullOrWhiteSpace(_removeProblem))
                {
                    <AppAlert Tone="AppUiTone.Error" Dense="true">@_removeProblem</AppAlert>
                }

                <AppActionBar Align="AppHorizontalAlignment.End">
                    <AppButton Label="Confirm delete"
                               StartIcon="@AppMaterialIcons.Outlined.DeleteForever"
                               ButtonStyle="AppButtonStyle.Filled"
                               Tone="AppUiTone.Error"
                               OnClick="@(() => DeletePluginAsync(plugin))" />
                    <AppButton Label="Cancel" OnClick="@(() => _deletePluginId = null)" />
                </AppActionBar>
            }
            else
            {
                <AppButton Label="Delete plugin"
                           StartIcon="@AppMaterialIcons.Outlined.Delete"
                           Tone="AppUiTone.Error"
                           OnClick="@(() => BeginDeleteAsync(plugin))" />
            }
        </div>
    </AppCard>;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    // A link to another plugin while this page is already open moves the ring and the scroll to that plugin.
    protected override void OnParametersSet()
    {
        if (!_loading)
        {
            ApplyFocusRequest();
            ApplyDetailRequest();
        }
    }

    // Opening a plugin's page reads what the page shows beyond the summary, once per plugin, and tells the breadcrumb its name.
    private void ApplyDetailRequest()
    {
        if (string.Equals(_appliedDetailId, DetailPluginId, StringComparison.Ordinal))
            return;

        _appliedDetailId = DetailPluginId;
        if (DetailPlugin is not { } plugin)
            return;

        _ = LoadLatestApprovalAsync(plugin.Id);
        _ = LoadDetailAsync(plugin.Id);
        _ = NameChanged.InvokeAsync(plugin.Name);
        if (!_health.ContainsKey(plugin.Id) && !IsProvider(plugin) && plugin.Enabled && _healthLoading.Add(plugin.Id))
            _ = CheckHealthInBackgroundAsync(plugin);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollToFocused || _loading || _focusedPluginId is null)
            return;

        _scrollToFocused = false;
        try
        {
            await JS.InvokeVoidAsync("tuvimaEditorScrollTo", "#" + CardElementId(_focusedPluginId));
        }
        catch (JSDisconnectedException)
        {
            // The circuit ended; there is nothing left to scroll.
        }
    }

    private bool IsFocused(PluginSummaryResponse plugin) =>
        string.Equals(plugin.Id, _focusedPluginId, StringComparison.OrdinalIgnoreCase);

    // Plugin ids hold dots (tuvima.fandom-lore), which would read as a class selector, so the page id keeps letters and digits only.
    internal static string CardElementId(string pluginId) =>
        "plugin-card-" + string.Concat(pluginId.Select(c => char.IsAsciiLetterOrDigit(c) ? c : '-'));

    // Acts once per requested id: an id that matches an installed plugin selects it, opens its settings and asks for a scroll;
    // an unknown id (or none) changes nothing.
    private void ApplyFocusRequest()
    {
        if (string.Equals(_appliedFocusRequest, FocusPluginId, StringComparison.Ordinal))
            return;

        _appliedFocusRequest = FocusPluginId;
        var match = string.IsNullOrWhiteSpace(FocusPluginId)
            ? null
            : _plugins.FirstOrDefault(plugin => string.Equals(plugin.Id, FocusPluginId.Trim(), StringComparison.OrdinalIgnoreCase));
        _focusedPluginId = match?.Id;
        if (match is null)
            return;

        // The card must be on screen: drop any filter and open the page that holds it.
        ClearFilters();
        var position = VisiblePlugins().FindIndex(plugin => plugin.Id == match.Id);
        _page = position < 0 ? 1 : (position / PageSize) + 1;
        _scrollToFocused = true;
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _plugins = (await Orchestrator.GetPluginsAsync()).OrderBy(p => p.Name).ToList();
            ApplyFocusRequest();
            Attention.ReportPlugins(_plugins.Where(plugin => !IsProvider(plugin)).ToList());
            ApplyDetailRequest();
            await LoadProviderStatusAsync();
            if (!_tasksLoaded)
            {
                // The run records are read once per visit; they only give each card its last activity and last failure.
                _tasksLoaded = true;
                _tasks = (await ApiClient.GetScheduledTasksAsync(_disposed.Token))?.Tasks;
            }
        }
        catch
        {
            _error = L["PluginSettingsTab_PluginSettingsCouldNotBe"].Value;
        }
        finally
        {
            _loading = false;
        }

        StartHealthChecks(_plugins.Where(plugin => !IsProvider(plugin) && plugin.Enabled && plugin.IsCompatible && string.IsNullOrWhiteSpace(plugin.LoadError)));
        _ = LoadWaitingAsync(_plugins.Where(plugin => !IsProvider(plugin)).ToList());
    }

    // The connection state of each provider (working, failing) comes from the provider status the Engine keeps.
    private async Task LoadProviderStatusAsync()
    {
        try
        {
            foreach (var status in await ApiClient.GetProviderStatusAsync(_disposed.Token))
                _providerStatus[status.Name] = status;
        }
        catch (OperationCanceledException)
        {
            // The page closed while the answer was on its way.
        }
        catch (HttpRequestException)
        {
            // Without the statuses the tiles still say On, Off and Needs a key; they just cannot say Broken.
        }
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
    }

    // Each switched-on plugin that loaded gets one health check in the background; its card shows a quiet placeholder
    // until the answer arrives. A plugin that is off or broken needs no check to know its word.
    private void StartHealthChecks(IEnumerable<PluginSummaryResponse> plugins)
    {
        foreach (var plugin in plugins.ToList())
        {
            if (_healthLoading.Add(plugin.Id))
                _ = CheckHealthInBackgroundAsync(plugin);
        }
    }

    private async Task CheckHealthInBackgroundAsync(PluginSummaryResponse plugin)
    {
        try
        {
            var result = await Orchestrator.CheckPluginHealthAsync(plugin.Id, _disposed.Token);
            if (result is not null)
                _health[plugin.Id] = result;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            _healthLoading.Remove(plugin.Id);
        }

        if (!_disposed.IsCancellationRequested)
            await InvokeAsync(StateHasChanged);
    }

    // The newest approval for a plugin: who turned it on and when, from the Engine's approval record.
    private async Task LoadLatestApprovalAsync(string pluginId)
    {
        try
        {
            var records = await Orchestrator.GetApprovalsAsync("plugin", pluginId, _disposed.Token);
            if (records is { Count: > 0 })
                _latestApproval[pluginId] = records[0];
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!_disposed.IsCancellationRequested)
            await InvokeAsync(StateHasChanged);
    }

    // Configure opens the plugin's own page; the tab it opens on is Overview unless a menu item asked for another.
    private void ConfigurePlugin(string pluginId, string tab = "setup") =>
        Navigation.NavigateTo(DetailHref(pluginId, tab));

    private static string DetailHref(string pluginId, string tab = "setup") =>
        $"/settings/plugins/{Uri.EscapeDataString(pluginId)}" + (tab == "setup" ? string.Empty : "/" + tab);

    private async Task SetEnabledAsync(PluginSummaryResponse plugin, bool enabled)
    {
        if (IsProvider(plugin))
        {
            if (!await ApiClient.UpdateProviderAsync(plugin.Id, enabled, _disposed.Token))
            {
                Snackbar.Add(L["PluginSettingsTab_TheSourceCouldNotBe"].Value, AppSeverity.Error);
                return;
            }

            plugin.Enabled = enabled;
            return;
        }

        var result = await Orchestrator.SetPluginEnabledAsync(plugin.Id, enabled);
        if (enabled && result.Approval is { } approval)
        {
            // The Engine wants the person to see what the plugin can do first. Cancel leaves it off and asks nothing more.
            var hashes = await Approvals.ConfirmAsync(approval.Approvals);
            if (hashes is null || !hashes.TryGetValue(plugin.Id, out var hash))
            {
                await InvokeAsync(StateHasChanged);
                return;
            }

            result = await Orchestrator.SetPluginEnabledAsync(plugin.Id, true, hash);
        }

        if (!result.Succeeded)
        {
            // The Engine's plain-English reason (for example a Library version the plugin does not support) beats the generic text.
            Snackbar.Add(string.IsNullOrWhiteSpace(result.Message) ? "Plugin state could not be saved." : result.Message, AppSeverity.Error);
            return;
        }

        plugin.Enabled = enabled;
        Attention.ReportPlugins(_plugins);
        if (enabled)
        {
            StartHealthChecks([plugin]);
            await LoadLatestApprovalAsync(plugin.Id);
        }
        Snackbar.Add($"{plugin.Name} {(enabled ? "enabled" : "disabled")}.", AppSeverity.Success);
    }

    private async Task SaveSettingAsync(PluginSummaryResponse plugin, string key, JsonElement value)
    {
        plugin.Settings[key] = value;
        if (!await Orchestrator.SavePluginSettingsAsync(plugin.Id, plugin.Settings))
        {
            Snackbar.Add(L["PluginSettingsTab_PluginSettingCouldNotBe"].Value, AppSeverity.Error);
            return;
        }
    }

    private async Task SaveRawSettingAsync(PluginSummaryResponse plugin, string key, string rawJson)
    {
        try
        {
            var element = JsonSerializer.Deserialize<JsonElement>(rawJson);
            await SaveSettingAsync(plugin, key, element);
        }
        catch (JsonException ex)
        {
            Snackbar.Add($"Setting value is invalid: {ex.Message}", AppSeverity.Error);
        }
    }

    private async Task SaveNumberSettingAsync(PluginSummaryResponse plugin, string key, string? raw)
    {
        if (!double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed))
        {
            Snackbar.Add(L["PluginSettingsTab_SettingNumberIsInvalid"].Value, AppSeverity.Error);
            return;
        }

        await SaveSettingAsync(plugin, key, JsonSerializer.SerializeToElement(parsed, _json));
    }

    // Removing says first what would have no source, and that what the plugin already saved stays.
    private async Task BeginDeleteAsync(PluginSummaryResponse plugin)
    {
        _removalPreview = await ApiClient.GetPluginRemovalPreviewAsync(plugin.Id);
        _removeOutput = _removalPreview?.DefaultOutput ?? "keep";
        _switchOffDependants = false;
        _removeProblem = null;
        _deletePluginId = plugin.Id;
    }

    private static IReadOnlyList<AppSelectOption> RemoveOutputOptions(PluginRemovalPreviewResponse preview) =>
    [
        new("keep", $"Keep the {preview.SavedOutput}"),
        new("remove", $"Remove the {preview.SavedOutput}"),
    ];

    private async Task DeletePluginAsync(PluginSummaryResponse plugin)
    {
        var result = await ApiClient.RemovePluginAsync(plugin.Id, new PluginRemoveRequest
        {
            Output = _removalPreview?.SavedOutput is null ? null : _removeOutput,
            AlsoSwitchOffDependants = _switchOffDependants,
        });
        if (!result.Succeeded)
        {
            // The Engine explains a refusal (for example another plugin needs this one); show its words, not a generic failure.
            _removeProblem = string.IsNullOrWhiteSpace(result.Message) ? "Plugin could not be deleted." : result.Message;
            return;
        }

        Snackbar.Add($"{plugin.Name} deleted.", AppSeverity.Success);
        _deletePluginId = null;
        _removalPreview = null;
        _removeProblem = null;
        Navigation.NavigateTo("/settings/plugins");
    }

    private async Task CheckHealthAsync(PluginSummaryResponse plugin)
    {
        var result = await Orchestrator.CheckPluginHealthAsync(plugin.Id);
        if (result is not null)
            _health[plugin.Id] = result;
    }

    private async Task LoadJobsAsync(PluginSummaryResponse plugin)
    {
        _jobs[plugin.Id] = await Orchestrator.GetPluginJobsAsync(plugin.Id);
    }

    private RenderFragment SettingEditor(PluginSummaryResponse plugin, PluginSettingDefinition setting)
    {
        var options = GetSelectOptions(setting);
        if (options.Count > 0)
        {
            return @<AppSelect Label="@setting.Label"
                               Value="@ReadSettingText(setting.Value)"
                               ValueChanged="@(v => SaveStringSettingAsync(plugin, setting, v))"
                               Options="@options"
                               HelpText="@setting.HelpText" />;
        }

        if (IsBooleanSetting(setting))
        {
            return @<AppSwitchRow Label="@setting.Label"
                                 Description="@setting.HelpText"
                                 Icon="@AppMaterialIcons.Outlined.ToggleOn"
                                 Value="@ReadBoolean(setting.Value)"
                                 ValueChanged="@(v => SaveSettingAsync(plugin, setting.Key, JsonSerializer.SerializeToElement(v, _json)))" />;
        }

        if (IsNumberSetting(setting))
        {
            return @<AppTextField Label="@setting.Label"
                                  Value="@ReadNumberText(setting.Value)"
                                  ValueChanged="@(v => SaveNumberSettingAsync(plugin, setting, v))"
                                  HelpText="@setting.HelpText"
                                  InputType="AppInputType.Number" />;
        }

        if (IsStringSetting(setting))
        {
            return @<AppTextField Label="@setting.Label"
                                  Value="@ReadString(setting.Value)"
                                  ValueChanged="@(v => SaveStringSettingAsync(plugin, setting, v))"
                                  HelpText="@setting.HelpText"
                                  Placeholder="@setting.Key"
                                  InputType="@TextInputType(setting)" />;
        }

        return @<AppTextarea Label="@setting.Label"
                             Value="@setting.Value.GetRawText()"
                             ValueChanged="@(v => SaveRawSettingAsync(plugin, setting.Key, v ?? "null"))"
                             HelpText="@setting.HelpText"
                             Lines="4" />;
    }

    private IEnumerable<PluginSettingDefinition> GetSettingEntries(PluginSummaryResponse plugin)
    {
        var emitted = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var order = 0;
        if (TryGetSchemaProperties(plugin.SettingsSchema, out var properties))
        {
            foreach (var property in properties.EnumerateObject())
            {
                var value = plugin.Settings.TryGetValue(property.Name, out var current)
                    ? current
                    : ReadDefaultValue(property.Value);
                emitted.Add(property.Name);
                yield return new PluginSettingDefinition(property.Name, value, property.Value, order++);
            }
        }

        foreach (var setting in plugin.Settings
                     .Where(kvp => !emitted.Contains(kvp.Key))
                     .OrderBy(kvp => kvp.Key, StringComparer.OrdinalIgnoreCase))
        {
            yield return new PluginSettingDefinition(setting.Key, setting.Value, null, order++);
        }
    }

    private async Task SaveStringSettingAsync(PluginSummaryResponse plugin, PluginSettingDefinition setting, string? raw)
    {
        var value = CoerceStringValue(setting, raw ?? string.Empty);
        await SaveSettingAsync(plugin, setting.Key, value);
    }

    private async Task SaveNumberSettingAsync(PluginSummaryResponse plugin, PluginSettingDefinition setting, string? raw)
    {
        if (IsIntegerSetting(setting))
        {
            if (!long.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsedInteger))
            {
                Snackbar.Add(L["PluginSettingsTab_SettingNumberIsInvalid"].Value, AppSeverity.Error);
                return;
            }

            await SaveSettingAsync(plugin, setting.Key, JsonSerializer.SerializeToElement(parsedInteger, _json));
            return;
        }

        if (!double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed))
        {
            Snackbar.Add(L["PluginSettingsTab_SettingNumberIsInvalid"].Value, AppSeverity.Error);
            return;
        }

        await SaveSettingAsync(plugin, setting.Key, JsonSerializer.SerializeToElement(parsed, _json));
    }

    private static bool TryGetSchemaProperties(JsonElement? schema, out JsonElement properties)
    {
        if (schema is { ValueKind: JsonValueKind.Object } root
            && root.TryGetProperty("properties", out properties)
            && properties.ValueKind == JsonValueKind.Object)
        {
            return true;
        }

        properties = default;
        return false;
    }

    private static JsonElement ReadDefaultValue(JsonElement definition)
    {
        if (definition.ValueKind == JsonValueKind.Object
            && definition.TryGetProperty("default", out var defaultValue)
            && defaultValue.ValueKind is not JsonValueKind.Undefined)
        {
            return defaultValue.Clone();
        }

        var type = ReadSchemaString(definition, "type");
        return type?.ToLowerInvariant() switch
        {
            "boolean" or "bool" => JsonSerializer.SerializeToElement(false),
            "integer" or "int" => JsonSerializer.SerializeToElement(0),
            "number" => JsonSerializer.SerializeToElement(0d),
            "array" => JsonSerializer.SerializeToElement(Array.Empty<string>()),
            "object" => JsonSerializer.SerializeToElement(new Dictionary<string, string>()),
            _ => JsonSerializer.SerializeToElement(string.Empty),
        };
    }

    private static JsonElement CoerceStringValue(PluginSettingDefinition setting, string raw)
    {
        if (IsIntegerSetting(setting) && long.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var integer))
            return JsonSerializer.SerializeToElement(integer);
        if (IsNumberSetting(setting) && double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var number))
            return JsonSerializer.SerializeToElement(number);
        if (IsBooleanSetting(setting) && bool.TryParse(raw, out var boolean))
            return JsonSerializer.SerializeToElement(boolean);
        return JsonSerializer.SerializeToElement(raw);
    }

    private static bool IsBooleanSetting(PluginSettingDefinition setting) =>
        IsSchemaType(setting, "boolean", "bool") || setting.Value.ValueKind is JsonValueKind.True or JsonValueKind.False;

    private static bool IsIntegerSetting(PluginSettingDefinition setting) =>
        IsSchemaType(setting, "integer", "int");

    private static bool IsNumberSetting(PluginSettingDefinition setting) =>
        IsIntegerSetting(setting) || IsSchemaType(setting, "number") || setting.Value.ValueKind == JsonValueKind.Number;

    private static bool IsStringSetting(PluginSettingDefinition setting) =>
        IsSchemaType(setting, "string") || setting.Value.ValueKind == JsonValueKind.String;

    private static bool IsSchemaType(PluginSettingDefinition setting, params string[] types)
    {
        var type = ReadSchemaString(setting.Schema, "type");
        return type is not null && types.Contains(type, StringComparer.OrdinalIgnoreCase);
    }

    private static bool ReadBoolean(JsonElement value) =>
        value.ValueKind switch
        {
            JsonValueKind.True => true,
            JsonValueKind.False => false,
            JsonValueKind.String when bool.TryParse(value.GetString(), out var parsed) => parsed,
            _ => false,
        };

    private static IReadOnlyList<AppSelectOption> GetSelectOptions(PluginSettingDefinition setting)
    {
        if (setting.Schema is not { ValueKind: JsonValueKind.Object } schema
            || !schema.TryGetProperty("enum", out var values)
            || values.ValueKind != JsonValueKind.Array)
        {
            return [];
        }

        return values.EnumerateArray()
            .Select(value => new AppSelectOption(ReadSettingText(value), ToTitle(ReadSettingText(value))))
            .ToList();
    }

    private static AppInputType TextInputType(PluginSettingDefinition setting) =>
        string.Equals(ReadSchemaString(setting.Schema, "format"), "password", StringComparison.OrdinalIgnoreCase)
        || ReadSchemaBool(setting.Schema, "secret")
            ? AppInputType.Password
            : AppInputType.Text;

    private static string ReadString(JsonElement value) => value.ValueKind == JsonValueKind.String ? value.GetString() ?? "" : "";

    private static string ReadSettingText(JsonElement value) =>
        value.ValueKind switch
        {
            JsonValueKind.String => value.GetString() ?? string.Empty,
            JsonValueKind.Number => value.GetRawText(),
            JsonValueKind.True => "true",
            JsonValueKind.False => "false",
            _ => value.GetRawText(),
        };

    private static string ReadNumberText(JsonElement value) =>
        value.TryGetDouble(out var parsed)
            ? parsed.ToString(CultureInfo.InvariantCulture)
            : "0";

    private static string? ReadSchemaString(JsonElement? schema, string propertyName) =>
        schema is { ValueKind: JsonValueKind.Object } element
        && element.TryGetProperty(propertyName, out var property)
        && property.ValueKind == JsonValueKind.String
            ? property.GetString()
            : null;

    private static bool ReadSchemaBool(JsonElement? schema, string propertyName) =>
        schema is { ValueKind: JsonValueKind.Object } element
        && element.TryGetProperty(propertyName, out var property)
        && property.ValueKind is JsonValueKind.True or JsonValueKind.False
        && property.GetBoolean();

    private static AppUiTone HealthTone(string status) => string.Equals(status, "healthy", StringComparison.OrdinalIgnoreCase) ? AppUiTone.Success : AppUiTone.Warning;

    private static string PluginIcon(PluginSummaryResponse plugin) => plugin.Id switch
    {
        var id when id.Contains("commercial", StringComparison.OrdinalIgnoreCase) => AppMaterialIcons.Outlined.LiveTv,
        var id when id.Contains("intro", StringComparison.OrdinalIgnoreCase) => AppMaterialIcons.Outlined.FastForward,
        var id when id.Contains("credits", StringComparison.OrdinalIgnoreCase) => AppMaterialIcons.Outlined.MovieFilter,
        var id when id.Contains("ai", StringComparison.OrdinalIgnoreCase) => AppMaterialIcons.Outlined.Memory,
        _ => AppMaterialIcons.Outlined.Extension,
    };

    private static string ToTitle(string key)
    {
        var text = key.Replace('_', ' ').Replace('-', ' ');
        return string.IsNullOrWhiteSpace(text)
            ? key
            : string.Concat(char.ToUpperInvariant(text[0]), text[1..]);
    }

    private sealed record PluginSettingDefinition(
        string Key,
        JsonElement Value,
        JsonElement? Schema,
        int Order)
    {
        public string Label => ReadSchemaString(Schema, "title")
            ?? ReadSchemaString(Schema, "label")
            ?? ToTitle(Key);

        public string? HelpText => ReadSchemaString(Schema, "description")
            ?? ReadSchemaString(Schema, "help_text");

        public bool Advanced => ReadSchemaBool(Schema, "advanced")
            || ReadSchemaBool(Schema, "ui:advanced")
            || ReadSchemaBool(Schema, "x-advanced");
    }
}
