    // "Last checked ..." for a metadata source, from the status the Engine keeps for it.
    private string? ProviderLastChecked(PluginSummaryResponse plugin)
    {
        if (!_providerStatus.TryGetValue(plugin.Id, out var status))
        {
            return null;
        }

        var value = status.ConnectionCheckedAt ?? status.LastSuccessAt ?? status.LastFailureAt;
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Not checked yet.";
        }

        if (!DateTimeOffset.TryParse(value, out var when))
        {
            return "Last checked a while ago.";
        }

        var words = StateCardHealth.RelativeTime(when, DateTimeOffset.UtcNow);
        return words.EndsWith("ago", StringComparison.Ordinal) || words == "Just now"
            ? $"Last checked {words.ToLowerInvariant()}."
            : $"Last checked on {words}.";
    }

