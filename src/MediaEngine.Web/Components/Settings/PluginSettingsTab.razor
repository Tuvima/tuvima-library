@namespace MediaEngine.Web.Components.Settings
@using System.Globalization
@using System.Text.Json
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Contracts.Approvals
@using MediaEngine.Contracts.System
@using MediaEngine.Web.Services.Formatting
@using MediaEngine.Web.Services.Integration
@using MediaEngine.Web.Services.Navigation
@using MediaEngine.Web.Services.Settings
@implements IDisposable
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject IAppToastService Snackbar
@inject DeviceContextService DeviceContext
@inject SettingsAttentionState Attention
@inject ApprovalFlow Approvals
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using MediaEngine.Contracts.Plugins

@if (_loading)
{
    <div class="settings-plugin-loading">
        <AppSkeleton Size="AppControlSize.Large" />
        <div class="settings-plugin-loading__grid">
            <AppSkeleton Size="AppControlSize.Large" />
            <AppSkeleton Size="AppControlSize.Large" />
        </div>
    </div>
}
else
{
    <div class="tl-page settings-plugin-page">
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <AppAlert Tone="AppUiTone.Error">@_error</AppAlert>
        }
        @* One page: the installed plugins first, then Available plugins, then the advanced plugin sections
           (health and jobs, capabilities, danger zone). The advanced sections and Available plugins are desktop and tablet only. *@
        @PluginsListPage()
        @if (!DeviceContext.IsMobile)
        {
            @if (ConfiguredPlugin is not null)
            {
                <AppCard Class="settings-plugin-configure-panel">
                    <nav class="settings-plugin-breadcrumb" aria-label="Breadcrumb">
                        <AppButton Label="Plugins" StartIcon="@AppMaterialIcons.Outlined.ArrowBack" ButtonStyle="AppButtonStyle.Text" Size="AppControlSize.Compact" OnClick="@(() => ConfigurePlugin(ConfiguredPlugin.Id))" />
                        <span aria-hidden="true">/</span>
                        <span aria-current="page">@ConfiguredPlugin.Name</span>
                    </nav>
                    <div class="settings-plugin-detail-header">
                        <span class="settings-plugin-detail-header__icon"><AppMaterialIcon Icon="@PluginIcon(ConfiguredPlugin)" /></span>
                        <div class="settings-plugin-detail-header__copy">
                            <strong class="settings-plugin-detail-header__title">Configure @ConfiguredPlugin.Name</strong>
                            <span class="settings-plugin-detail-header__description">@ConfiguredPlugin.Description</span>
                        </div>
                        <AppStatusBadge Text="@(ConfiguredPlugin.Enabled ? "Enabled" : "Disabled")" Tone="@(ConfiguredPlugin.Enabled ? AppUiTone.Success : AppUiTone.Neutral)" />
                        @if (!DeviceContext.IsMobile)
                        {
                            <AppRowMenu AriaLabel="@($"More actions for {ConfiguredPlugin.Name}")" Items="@PluginMenuItems(ConfiguredPlugin)" />
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(ConfiguredPlugin.LoadError))
                    {
                        <AppAlert Tone="AppUiTone.Warning" Class="tl-sp-mb-3">@ConfiguredPlugin.LoadError</AppAlert>
                    }
                    @PluginSettingsPanel(ConfiguredPlugin)
                    @PluginDetailSections(ConfiguredPlugin)
                    <AppButton Label="Back to plugins" ButtonStyle="AppButtonStyle.Text" Size="AppControlSize.Compact" OnClick="@(() => ConfigurePlugin(ConfiguredPlugin.Id))" />
                </AppCard>
            }
            <MetadataSourcesPanel />
            <AvailablePluginsPanel OnChanged="ReloadAsync" />
            @AdvancedPluginPanel()
        }
    </div>
}

@code {
    private readonly JsonSerializerOptions _json = MediaEngineJson.Web;
    private readonly Dictionary<string, PluginHealthResponse> _health = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, IReadOnlyList<OperationDto>> _jobs = new(StringComparer.OrdinalIgnoreCase);
    private List<PluginSummaryResponse> _plugins = [];
    private readonly HashSet<string> _healthLoading = new(StringComparer.OrdinalIgnoreCase);
    private readonly CancellationTokenSource _disposed = new();
    private IReadOnlyList<ScheduledTaskDto>? _tasks;
    private bool _tasksLoaded;
    private bool _loading = true;
    private string? _error;
    private readonly Dictionary<string, ApprovalRecordResponse> _latestApproval = new(StringComparer.OrdinalIgnoreCase);
    private string? _selectedPluginId;
    private string? _configurePluginId;
    private string? _deletePluginId;
    private PluginRemovalPreviewResponse? _removalPreview;
    private string _removeOutput = "keep";
    private bool _switchOffDependants;
    private string? _removeProblem;
    private readonly Dictionary<string, PluginDependenciesResponse> _dependencies = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, PluginLibraryLimitResponse> _libraryLimits = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, PluginActivityResponse> _activity = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, PluginCheckNowResponse> _checkNow = new(StringComparer.OrdinalIgnoreCase);
    private string? _editLibrariesFor;
    private HashSet<string> _pickedLibraries = [];

    /// <summary>
    /// The plugin a <c>/settings/plugins?plugin={id}</c> link points at. When it names an installed plugin the page scrolls to
    /// that plugin's card, rings it and opens its settings; an id that matches nothing leaves the page as it normally opens.
    /// </summary>
    [Parameter] public string? FocusPluginId { get; set; }

    private string? _focusedPluginId;
    private string? _appliedFocusRequest;
    private bool _scrollToFocused;

    private PluginSummaryResponse? SelectedPlugin => _plugins.FirstOrDefault(p => string.Equals(p.Id, _selectedPluginId, StringComparison.OrdinalIgnoreCase));
    private PluginSummaryResponse? ConfiguredPlugin => _plugins.FirstOrDefault(p => string.Equals(p.Id, _configurePluginId, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<AppSelectOption> PluginOptions => _plugins
        .Select(plugin => new AppSelectOption(plugin.Id, plugin.Name))
        .ToList();

    private const int PageSize = 24;
    private static readonly AppCountTab[] NoTabs = [];

    private bool _uploadOpen;

    private async Task UploadedAsync(string message)
    {
        Snackbar.Add(message, AppSeverity.Success);
        await ReloadAsync();
    }

    private string? _search;
    private string _statusFilter = "all";
    private string _mediaFilter = "all";
    private string _sort = "name";
    private bool _officialOnly;
    private string _categoryTab = "all";
    private int _page = 1;
    private readonly HashSet<string> _accessOpen = new(StringComparer.OrdinalIgnoreCase);

    private static readonly IReadOnlyList<AppSelectOption> StatusOptions =
    [
        new("all", "All"),
        new("enabled", "Enabled"),
        new("disabled", "Disabled"),
        new("attention", "Needs attention"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> MediaOptions =
    [
        new("all", "All media"),
        new("books", "Books"),
        new("comics", "Comics"),
        new("audiobooks", "Audiobooks"),
        new("movies", "Movies"),
        new("tv", "TV"),
        new("music", "Music"),
        new("photos", "Photos"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> SortOptions =
    [
        new("name", "Name"),
        new("status", "Status"),
        new("category", "Category"),
    ];

    private static readonly (string Key, string Label)[] Categories =
    [
        (PluginCategories.Metadata, "Metadata"),
        (PluginCategories.MediaProcessing, "Media processing"),
        (PluginCategories.Services, "Services"),
        (PluginCategories.Utilities, "Utilities"),
    ];

    private static string CategoryLabel(PluginSummaryResponse plugin) =>
        Categories.FirstOrDefault(category => category.Key == PluginCategories.Resolve(plugin.Category)).Label ?? "Utilities";

    private bool Narrowed => !string.IsNullOrWhiteSpace(_search) || _statusFilter != "all" || _mediaFilter != "all" || _officialOnly;

    private HealthWord WordOf(PluginSummaryResponse plugin)
    {
        _health.TryGetValue(plugin.Id, out var health);
        return StateCardHealth.ForPlugin(plugin, health, StateCardHealth.LatestRun(_tasks, plugin.Id)).Word;
    }

    // Dependencies that are off, missing or the wrong version, by plugin id, read from the Engine when the page loads.
    private readonly Dictionary<string, IReadOnlyList<string>> _waitingFor = new(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<string> WaitingFor(PluginSummaryResponse plugin) =>
        _waitingFor.TryGetValue(plugin.Id, out var names) ? names : [];

    private bool NeedsAttention(PluginSummaryResponse plugin) =>
        WordOf(plugin) is HealthWord.NeedsAttention or HealthWord.Broken || WaitingFor(plugin).Count > 0;

    private bool MatchesSearch(PluginSummaryResponse plugin)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        var term = _search.Trim();
        bool Has(string? text) => text?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;
        return Has(plugin.Name) || Has(plugin.Description) || Has(plugin.Id) || Has(CategoryLabel(plugin))
            || plugin.MediaTypes.Any(Has)
            || plugin.Capabilities.Any(capability => Has(capability.Name) || Has(capability.Description));
    }

    private bool MatchesStatus(PluginSummaryResponse plugin) => _statusFilter switch
    {
        "enabled" => plugin.Enabled,
        "disabled" => !plugin.Enabled,
        "attention" => NeedsAttention(plugin),
        _ => true,
    };

    // A plugin with no media types applies to every type, so it stays under any media filter.
    private bool MatchesMedia(PluginSummaryResponse plugin) =>
        _mediaFilter == "all" || plugin.MediaTypes.Count == 0 || plugin.MediaTypes.Contains(_mediaFilter, StringComparer.OrdinalIgnoreCase);

    // Everything that narrows the list except the category tab, so the tab counts add up to what each tab would show.
    private List<PluginSummaryResponse> FilteredIgnoringTab() => _plugins
        .Where(MatchesSearch)
        .Where(MatchesStatus)
        .Where(MatchesMedia)
        .Where(plugin => !_officialOnly || string.Equals(plugin.TrustLevel, "official", StringComparison.OrdinalIgnoreCase))
        .ToList();

    private List<PluginSummaryResponse> VisiblePlugins()
    {
        var list = FilteredIgnoringTab()
            .Where(plugin => _categoryTab == "all" || PluginCategories.Resolve(plugin.Category) == _categoryTab);
        return (_sort switch
        {
            "status" => list.OrderByDescending(plugin => plugin.Enabled).ThenBy(plugin => plugin.Name, StringComparer.OrdinalIgnoreCase),
            "category" => list.OrderBy(plugin => CategoryLabel(plugin), StringComparer.OrdinalIgnoreCase).ThenBy(plugin => plugin.Name, StringComparer.OrdinalIgnoreCase),
            _ => list.OrderBy(plugin => plugin.Name, StringComparer.OrdinalIgnoreCase),
        }).ToList();
    }

    private IReadOnlyList<AppCountTab> CategoryTabs()
    {
        var pool = FilteredIgnoringTab();
        return
        [
            new AppCountTab("all", "All", pool.Count),
            .. Categories.Select(category => new AppCountTab(category.Key, category.Label, pool.Count(plugin => PluginCategories.Resolve(plugin.Category) == category.Key))),
        ];
    }

    private void ClearFilters()
    {
        _search = null;
        _statusFilter = "all";
        _mediaFilter = "all";
        _officialOnly = false;
        _page = 1;
    }

    private void Narrow(Action change)
    {
        change();
        _page = 1;
    }

    private RenderFragment PluginsListPage() => @<div class="settings-plugin-page">
        @if (!DeviceContext.IsMobile)
        {
            <AppListPageHeader>
                <Actions>
                    <AppButton Label="Upload plugin" StartIcon="@AppMaterialIcons.Outlined.UploadFile" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="@(() => _uploadOpen = true)" />
                </Actions>
            </AppListPageHeader>
        }
        <PluginUploadDialog Open="@_uploadOpen" OnClosed="@(() => { _uploadOpen = false; })" OnUploaded="@UploadedAsync" />
        <AppSummaryStrip AriaLabel="Plugin summary" Items="@SummaryItems()" />
        @if (_plugins.Count == 0)
        {
            <AppEmptyState Title="No plugins installed" Message="The Engine did not return any installed extensions.">
                <Action><AppButton Label="Read the plugins guide" Href="@(ProjectLinks.DocsSite + "guides/developer-tools/")" Target="_blank" Size="AppControlSize.Compact" /></Action>
            </AppEmptyState>
        }
        else
        {
            @if (!DeviceContext.IsMobile)
            {
                <AppSearchFilterRow Search="@_search"
                                    SearchChanged="@(value => Narrow(() => _search = value))"
                                    Placeholder="Search plugins by name or capability"
                                    Narrowed="@Narrowed"
                                    OnClear="@ClearFilters">
                    <AppSelect Label="Status" Value="@_statusFilter" Options="@StatusOptions" Native="true" FullWidth="false"
                               ValueChanged="@(value => Narrow(() => _statusFilter = value ?? "all"))" />
                    <AppSelect Label="Media" Value="@_mediaFilter" Options="@MediaOptions" Native="true" FullWidth="false"
                               ValueChanged="@(value => Narrow(() => _mediaFilter = value ?? "all"))" />
                    <AppSelect Label="Sort" Value="@_sort" Options="@SortOptions" Native="true" FullWidth="false"
                               ValueChanged="@(value => Narrow(() => _sort = value ?? "name"))" />
                    <AppSwitchRow Label="Official Tuvima" ImageIcon="images/tuvima-icon.svg" Value="@_officialOnly"
                                  ValueChanged="@(value => Narrow(() => _officialOnly = value))" />
                </AppSearchFilterRow>
            }
            <AppCountTabs Tabs="@CategoryTabs()" Selected="@_categoryTab" AriaLabel="Plugin categories"
                          SelectedChanged="@(key => Narrow(() => _categoryTab = key))" />
            var visible = VisiblePlugins();
            _page = Math.Clamp(_page, 1, Math.Max(1, (int)Math.Ceiling(visible.Count / (double)PageSize)));
            @if (visible.Count == 0)
            {
                @if (Narrowed)
                {
                    <AppEmptyState Title="No plugins match" Message="Nothing installed fits that search or filter.">
                        <Action><AppButton Label="Clear filters" Size="AppControlSize.Compact" OnClick="@ClearFilters" /></Action>
                    </AppEmptyState>
                }
                else
                {
                    <AppEmptyState Title="Nothing in this category yet" Message="Plugins of this kind will appear here." />
                }
            }
            else
            {
                <div class="app-card-grid" role="list">
                    @foreach (var plugin in visible.Skip((_page - 1) * PageSize).Take(PageSize))
                    {
                        var focused = IsFocused(plugin);
                        <div role="listitem"
                             @key="plugin.Id"
                             id="@CardElementId(plugin.Id)"
                             class="@(focused ? "settings-plugin-card-focus" : null)"
                             data-focused="@(focused ? "true" : null)">@PluginCard(plugin)</div>
                    }
                </div>
                <AppPager Total="@visible.Count" PageSize="@PageSize" Page="@_page" Noun="plugins" PageChanged="@(page => _page = page)" />
            }
        }
    </div>;

    private IReadOnlyList<AppSummaryItem> SummaryItems()
    {
        var attention = _plugins.Count(NeedsAttention);
        return
        [
            new("installed", _plugins.Count.ToString(CultureInfo.InvariantCulture), AppMaterialIcons.Outlined.Extension, AppSummaryTone.Accent),
            new("switched on", _plugins.Count(plugin => plugin.Enabled).ToString(CultureInfo.InvariantCulture), AppMaterialIcons.Outlined.CheckCircle, AppSummaryTone.Ok),
            new("need attention", attention.ToString(CultureInfo.InvariantCulture), attention == 0 ? AppMaterialIcons.Outlined.CheckCircle : AppMaterialIcons.Outlined.Warning, attention == 0 ? AppSummaryTone.Mute : AppSummaryTone.Warn),
        ];
    }

    private RenderFragment PluginCard(PluginSummaryResponse plugin)
    {
        _health.TryGetValue(plugin.Id, out var health);
        var run = StateCardHealth.LatestRun(_tasks, plugin.Id);
        var state = StateCardHealth.ForPlugin(plugin, health, run);
        // What the plugin may do and where its data goes are the Engine's own words, the same ones the approval dialog shows.
        var sendsOut = !string.IsNullOrWhiteSpace(plugin.SendsDataTo);
        // Phones read the cards; switching and configuring plugins stays on desktop and tablet.
        var canChange = !DeviceContext.IsMobile;
        var official = string.Equals(plugin.TrustLevel, "official", StringComparison.OrdinalIgnoreCase);
        return @<AppStateCard Name="@plugin.Name"
                              Kind="StateCardKind.Plugin"
                              Compact="true"
                              Icon="@PluginIcon(plugin)"
                              KindText="@CategoryLabel(plugin)"
                              Description="@plugin.Description"
                              IsOn="@(canChange ? plugin.Enabled : null)"
                              IsOnChanged="@(value => SetEnabledAsync(plugin, value))"
                              SwitchDisabledReason="@SwitchDisabledReason(plugin)"
                              Health="@state.Word"
                              LastProblem="@state.LastProblem"
                              AllowedTo="@plugin.AllowedTo"
                              SendsDataOut="@sendsOut"
                              SendsDataTo="@plugin.SendsDataTo"
                              LastActivity="@StateCardHealth.ActivityTime(run)"
                              Loading="@_healthLoading.Contains(plugin.Id)"
                              ShowFacts="@_accessOpen.Contains(plugin.Id)"

                              Footer="@PluginFooter(plugin, state.Word, canChange)">
            <Badges>
                @MediaPills(plugin)
                @if (official)
                {
                    <AppOfficialPill />
                }
                else
                {
                    <AppStatusBadge Text="@TrustLabel(plugin.TrustLevel)" Tone="@TrustTone(plugin.TrustLevel)" />
                }
            </Badges>
            <Warning>
                @if (WaitingFor(plugin) is { Count: > 0 } waiting)
                {
                    <AppWarningStrip Text="@($"Waiting for {string.Join(" and ", waiting)}")" ShortText="@($"Waiting for {string.Join(" and ", waiting)}")" />
                }
                else if (MissingToolText(plugin, state.Word) is { } missing)
                {
                    <AppWarningStrip Text="@missing" ShortText="@MissingToolShortText(plugin)" OnClick="@(() => Navigation.NavigateTo(SettingsNav.RouteFor(SettingsSection.Tools)))" />
                }
            </Warning>
        </AppStateCard>;
    }

    // Two media pills and "+N" (the rest are on the plugin's page); a plugin for every type says so in one neutral pill.
    private static RenderFragment MediaPills(PluginSummaryResponse plugin) => @<text>
        @if (plugin.MediaTypes.Count == 0)
        {
            <AppStatusBadge Text="All media" Tone="AppUiTone.Neutral" />
        }
        else
        {
            @foreach (var media in plugin.MediaTypes.Take(2))
            {
                <AppMediaPill Media="@media" />
            }
            @if (plugin.MediaTypes.Count > 2)
            {
                <AppStatusBadge Text="@($"+{plugin.MediaTypes.Count - 2}")" Tone="AppUiTone.Neutral" Title="@string.Join(", ", plugin.MediaTypes.Skip(2))" />
            }
        }
    </text>;

    // A plugin that needs a tool the health check cannot find: the strip names the tools and opens Tools and requirements.
    private static string? MissingToolText(PluginSummaryResponse plugin, HealthWord word)
    {
        if (word is not (HealthWord.NeedsAttention or HealthWord.Broken) || plugin.ToolRequirements.Count == 0)
            return null;

        var names = plugin.ToolRequirements
            .Select(requirement => string.IsNullOrWhiteSpace(requirement.ExecutableName) ? requirement.Id : requirement.ExecutableName)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(ToTitle)
            .ToList();
        return $"Requires {string.Join(" or ", names)}. Install it for full functionality.";
    }

    private static string MissingToolShortText(PluginSummaryResponse plugin)
    {
        var names = plugin.ToolRequirements
            .Select(requirement => string.IsNullOrWhiteSpace(requirement.ExecutableName) ? requirement.Id : requirement.ExecutableName)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(ToTitle);
        return $"Requires {string.Join(" or ", names)}";
    }

    private RenderFragment? PluginFooter(PluginSummaryResponse plugin, HealthWord word, bool canChange)
    {
        if (!canChange && word != HealthWord.Broken)
            return null;

        return @<div class="settings-plugin-card-actions">
            @if (word == HealthWord.Broken)
            {
                <AppButton Label="Retry" StartIcon="@AppMaterialIcons.Outlined.Refresh" Size="AppControlSize.Compact" OnClick="@ReloadAsync" />
            }
            else
            {
                <AppButton Label="Configure" StartIcon="@AppMaterialIcons.Outlined.Settings" Size="AppControlSize.Compact" OnClick="@(() => ConfigurePlugin(plugin.Id))" />
            }
            @if (canChange)
            {
                <AppRowMenu AriaLabel="@($"More actions for {plugin.Name}")" Items="@PluginMenuItems(plugin)" />
            }
        </div>;
    }

    private IReadOnlyList<AppRowMenuItem> PluginMenuItems(PluginSummaryResponse plugin)
    {
        var items = new List<AppRowMenuItem>
        {
            new() { Label = "Check health", Icon = AppMaterialIcons.Outlined.HealthAndSafety, OnClick = EventCallback.Factory.Create(this, () => CheckHealthFromMenuAsync(plugin)) },
            new() { Label = _accessOpen.Contains(plugin.Id) ? "Hide what it can access" : "View what it can access", Icon = AppMaterialIcons.Outlined.Visibility, OnClick = EventCallback.Factory.Create(this, () => ToggleAccess(plugin.Id)) },
        };
        if (!plugin.IsBuiltIn)
        {
            items.Add(new() { Label = "Remove", Icon = AppMaterialIcons.Outlined.Delete, Destructive = true, OnClick = EventCallback.Factory.Create(this, () => BeginRemoveFromMenuAsync(plugin)) });
        }

        return items;
    }

    private void ToggleAccess(string pluginId)
    {
        if (!_accessOpen.Remove(pluginId))
            _accessOpen.Add(pluginId);
    }

    private async Task CheckHealthFromMenuAsync(PluginSummaryResponse plugin)
    {
        await CheckHealthAsync(plugin);
        Snackbar.Add($"{plugin.Name}: health checked.", AppSeverity.Info);
    }

    // The menu's Remove opens the plugin's details with the same confirmation as before (what would have no source, and what stays).
    private async Task BeginRemoveFromMenuAsync(PluginSummaryResponse plugin)
    {
        SelectPlugin(plugin.Id);
        await BeginDeleteAsync(plugin);
        try
        {
            await JS.InvokeVoidAsync("tuvimaEditorScrollTo", "#plugin-details-panel");
        }
        catch (JSDisconnectedException)
        {
            // The circuit ended; there is nothing left to scroll.
        }
    }

    // A plugin that cannot work here cannot be switched on; once it is on, switching off is always allowed.
    private static string? SwitchDisabledReason(PluginSummaryResponse plugin) => !plugin.IsCompatible && !plugin.Enabled
        ? string.IsNullOrWhiteSpace(plugin.CompatibilityProblem) ? "This plugin cannot be switched on here." : plugin.CompatibilityProblem
        : null;

    private static string TrustLabel(string trustLevel) => trustLevel.ToLowerInvariant() switch
    {
        "official" => "Official",
        "verified" => "Verified",
        "community" => "Community",
        "private" => "Private",
        _ => ToTitle(trustLevel),
    };

    private static AppUiTone TrustTone(string trustLevel) => trustLevel.ToLowerInvariant() switch
    {
        "official" => AppUiTone.Primary,
        "verified" => AppUiTone.Info,
        _ => AppUiTone.Neutral,
    };

    private RenderFragment AdvancedPluginPanel() => @<text>
        <span id="plugin-details-panel"></span>
        <AppCard Title="Plugin details" Description="Check one plugin's health and jobs, review what it can access, or remove it.">
            <AppSelect Label="Plugin" Value="@_selectedPluginId" ValueChanged="@SelectPluginValue" Options="@PluginOptions" />
        </AppCard>
        <AppCard>
            @if (SelectedPlugin is null)
            {
                <AppEmptyState Title="No plugin selected" Message="Choose an installed plugin to inspect its details." />
            }
            else
            {
                var plugin = SelectedPlugin;
                <div class="settings-plugin-detail-stack">
                    <div class="settings-plugin-detail-header">
                        <span class="settings-plugin-detail-header__icon"><AppMaterialIcon Icon="@PluginIcon(plugin)" /></span>
                        <div class="settings-plugin-detail-header__copy">
                            <strong class="settings-plugin-detail-header__title">@plugin.Name</strong>
                            <span class="settings-plugin-detail-header__description">@plugin.Description</span>
                            @if (_latestApproval.TryGetValue(plugin.Id, out var approved))
                            {
                                <span class="settings-plugin-detail-header__description" data-testid="plugin-approval">Turned on by @approved.ApprovedByName on @DisplayFormat.FormatPlainDate(approved.ApprovedAt)</span>
                            }
                        </div>
                        <AppStatusBadge Text="@(plugin.Enabled ? "Enabled" : "Disabled")" Tone="@(plugin.Enabled ? AppUiTone.Success : AppUiTone.Neutral)" />
                    </div>
                    <section class="settings-plugin-detail-section" aria-label="Health and jobs">
                        <AppText Typo="AppTypo.subtitle1">Health &amp; Jobs</AppText>
                        <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">Check one plugin's current health and recent operations.</AppText>
                        @PluginHealthJobsPanel(plugin)
                    </section>
                    <section class="settings-plugin-detail-section" aria-label="Capabilities and AI permissions">
                        <AppText Typo="AppTypo.subtitle1">Capabilities &amp; AI permissions</AppText>
                        <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">Review what one plugin declares and can access.</AppText>
                        @PluginCapabilitiesPanel(plugin)
                    </section>
                    <section class="settings-plugin-detail-section" aria-label="Danger zone">
                        @DangerPanel(plugin)
                    </section>
                </div>
            }
        </AppCard>
    </text>;

    private RenderFragment PluginSettingsPanel(PluginSummaryResponse plugin) => @<div class="settings-plugin-tab-body">
        @{ var settingEntries = GetSettingEntries(plugin).ToList(); var primarySettings = settingEntries.Where(setting => !setting.Advanced).ToList(); var advancedSettings = settingEntries.Where(setting => setting.Advanced).ToList(); }
        @if (settingEntries.Count == 0)
        {
            <AppEmptyState Title="No plugin settings" Message="This plugin does not expose user-configurable settings." />
        }
        else
        {
            @foreach (var setting in primarySettings) { @SettingEditor(plugin, setting) }
            @if (advancedSettings.Count > 0)
            {
                <AppExpansionPanels Elevation="0" Dense="true" Class="tl-sp-mb-2">
                    <AppExpansionPanel Text="Advanced settings">
                        @foreach (var setting in advancedSettings) { @SettingEditor(plugin, setting) }
                    </AppExpansionPanel>
                </AppExpansionPanels>
            }
        }
    </div>;

    // The plugin detail page: who can use the plugin, what it needs, what it did, and what removing it would do. The lists the
    // Plugin architecture build supplies (libraries a plugin is limited to, what depends on it, the update note) show their
    // labelled place now, with an honest "nothing yet" line.
    private RenderFragment PluginDetailSections(PluginSummaryResponse plugin) => @<div class="settings-plugin-tab-body" data-testid="plugin-detail-sections">
        <section class="settings-plugin-detail-section" aria-label="Access">
            <AppText Typo="AppTypo.subtitle1">Access</AppText>
            <AppTable Class="settings-plugin-job-table">
                <tbody>
                    <tr><td>Who can use it</td><td>@AudienceWords(plugin.Access.Audience)</td></tr>
                    <tr><td>Works on</td><td>@(plugin.MediaTypes.Count == 0 ? "All kinds of media" : string.Join(", ", plugin.MediaTypes.Select(ToTitle)))</td></tr>
                    <tr><td>Vault items</td><td>@(string.IsNullOrWhiteSpace(plugin.Access.VaultWords) ? "Not used on Vault items" : plugin.Access.VaultWords)</td></tr>
                    <tr><td>What leaves this machine</td><td>@DataLeavingWords(plugin)</td></tr>
                    <tr><td>How heavy</td><td>@WeightWords(plugin.Access.WeightClass)</td></tr>
                    <tr>
                        <td>Limited to</td>
                        <td>
                            @LimitedToWords(plugin)
                            @if (!DeviceContext.IsMobile && _libraryLimits.ContainsKey(plugin.Id))
                            {
                                <AppButton Label="Change" Size="AppControlSize.Compact" OnClick="@(() => BeginEditLibraries(plugin))" />
                            }
                        </td>
                    </tr>
                </tbody>
            </AppTable>
            @if (string.Equals(_editLibrariesFor, plugin.Id, StringComparison.OrdinalIgnoreCase) && _libraryLimits.TryGetValue(plugin.Id, out var limit))
            {
                <div class="settings-plugin-library-picker" data-testid="plugin-library-picker">
                    <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">Pick the libraries it works on. Leave all of them unticked to let it work on every library. Vault libraries are never listed.</AppText>
                    @foreach (var library in limit.Libraries)
                    {
                        var libraryId = library.Id;
                        <AppCheckbox Label="@library.Name"
                                     Value="@_pickedLibraries.Contains(libraryId)"
                                     ValueChanged="@(on => TogglePickedLibrary(libraryId, on))" />
                    }
                    <AppActionBar Align="AppHorizontalAlignment.End">
                        <AppButton Label="Save" Tone="AppUiTone.Primary" OnClick="@(() => SaveLibrariesAsync(plugin))" />
                        <AppButton Label="Cancel" OnClick="@(() => _editLibrariesFor = null)" />
                    </AppActionBar>
                </div>
            }
        </section>
        <section class="settings-plugin-detail-section" aria-label="Needs and needed by">
            <AppText Typo="AppTypo.subtitle1">Needs</AppText>
            @{ var needs = NeedLines(plugin); }
            @if (needs.Count == 0 && WaitingFor(plugin).Count == 0)
            {
                <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">It does not need anything else.</AppText>
            }
            else
            {
                <ul data-testid="plugin-needs">
                    @foreach (var name in WaitingFor(plugin)) { <li>@name</li> }
                    @foreach (var need in needs) { <li>@need</li> }
                </ul>
            }
            <AppText Typo="AppTypo.subtitle1">Needed by</AppText>
            @if (_dependencies.TryGetValue(plugin.Id, out var dependencies) && dependencies.NeededBy.Count > 0)
            {
                <ul data-testid="plugin-needed-by">
                    @foreach (var dependant in dependencies.NeededBy) { <li>@dependant.Name</li> }
                </ul>
            }
            else
            {
                <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">Nothing else depends on it.</AppText>
            }
        </section>
        <section class="settings-plugin-detail-section" aria-label="Activity">
            <AppText Typo="AppTypo.subtitle1">Activity</AppText>
            <AppActionBar Align="AppHorizontalAlignment.Start">
                <AppButton Label="Check now" StartIcon="@AppMaterialIcons.Outlined.HealthAndSafety" Size="AppControlSize.Compact" OnClick="@(() => CheckNowAsync(plugin))" />
            </AppActionBar>
            @if (_checkNow.TryGetValue(plugin.Id, out var checkNow))
            {
                <AppAlert Tone="@CheckNowTone(checkNow.Result)" data-testid="plugin-check-now">
                    @checkNow.Summary
                    @foreach (var step in checkNow.Steps)
                    {
                        <div>@(step.Ok ? "✓" : "✕") @step.Label@(string.IsNullOrWhiteSpace(step.Detail) ? null : $" - {step.Detail}")</div>
                    }
                </AppAlert>
            }
            else if (_health.TryGetValue(plugin.Id, out var health))
            {
                <AppAlert Tone="@HealthTone(health.Status)">@health.Status</AppAlert>
            }
            @if (_activity.TryGetValue(plugin.Id, out var activity) && activity.Entries.Count > 0)
            {
                @if (activity.PausedUntil is { } pausedUntil)
                {
                    <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">Paused until @pausedUntil.ToLocalTime().ToString("g").</AppText>
                }
                <ul data-testid="plugin-activity">
                    @foreach (var entry in activity.Entries.Take(8))
                    {
                        <li>@entry.OccurredAt.ToLocalTime().ToString("g"): @entry.Summary@(string.IsNullOrWhiteSpace(entry.ReasonWords) ? null : $" - {entry.ReasonWords}")</li>
                    }
                </ul>
            }
            else if (_jobs.TryGetValue(plugin.Id, out var jobs) && jobs.Count > 0)
            {
                <ul data-testid="plugin-activity">
                    @foreach (var job in jobs.Take(5))
                    {
                        <li>@job.OperationType: @job.Status@(string.IsNullOrWhiteSpace(job.ResultSummary) ? null : $" - {job.ResultSummary}")</li>
                    }
                </ul>
            }
            else
            {
                <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">Nothing has run yet.</AppText>
            }
        </section>
        <section class="settings-plugin-detail-section" aria-label="Update note">
            <AppText Typo="AppTypo.subtitle1">Version @plugin.Version</AppText>
            <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">@(string.IsNullOrWhiteSpace(plugin.Access.Changelog) ? "No update note for this version." : plugin.Access.Changelog)</AppText>
        </section>
        <section class="settings-plugin-detail-section" aria-label="Removing this plugin">
            <AppText Typo="AppTypo.subtitle1">Removing this plugin</AppText>
            <AppText Typo="AppTypo.caption" Color="AppColor.Secondary">See what removing it would clean up before you confirm. What it already added to your Library is kept.</AppText>
            @DangerPanel(plugin)
        </section>
    </div>;

    private static string AudienceWords(string audience) => audience switch
    {
        "everyone" => "Everyone who can use this Library",
        "adults" => "Adults only (not kids profiles)",
        _ => "Administrators only",
    };

    private static string WeightWords(string weight) => weight switch
    {
        "heavy" => "Heavy: works when the machine is idle",
        "medium" => "Medium",
        _ => "Light",
    };

    private static string DataLeavingWords(PluginSummaryResponse plugin)
    {
        if (!string.IsNullOrWhiteSpace(plugin.Access.DataLeaving))
            return plugin.Access.DataLeaving;

        return string.IsNullOrWhiteSpace(plugin.SendsDataTo) ? "Nothing" : plugin.SendsDataTo;
    }

    private string LimitedToWords(PluginSummaryResponse plugin)
    {
        if (!_libraryLimits.TryGetValue(plugin.Id, out var limit) || !limit.Limited)
            return "All libraries";

        var names = limit.Libraries.Where(library => library.Selected).Select(library => library.Name).ToList();
        return names.Count == 0 ? "All libraries" : string.Join(", ", names);
    }

    private static AppUiTone CheckNowTone(string result) => result switch
    {
        "working" => AppUiTone.Success,
        "not_working" => AppUiTone.Error,
        _ => AppUiTone.Warning,
    };

    // Everything the plugin needs, in plain words: other plugins with how they stand, then Local AI, tools, sources and host services.
    private IReadOnlyList<string> NeedLines(PluginSummaryResponse plugin)
    {
        var lines = new List<string>();
        if (_dependencies.TryGetValue(plugin.Id, out var dependencies))
        {
            lines.AddRange(dependencies.Needs.Select(need =>
                $"{need.Name}{(need.Optional ? " (only improves results)" : string.Empty)}{(need.State == "ready" ? string.Empty : $" - {need.State.Replace('_', ' ')}")}"));
        }

        var others = plugin.Access.Requires.Where(requirement => !string.Equals(requirement.Kind, "plugin", StringComparison.OrdinalIgnoreCase)).ToList();
        if (others.Count > 0)
        {
            lines.AddRange(others.Select(requirement => $"{RequirementKindWords(requirement.Kind)}: {ToTitle(requirement.Id)}{(requirement.Optional ? " (only improves results)" : string.Empty)}"));
        }
        else
        {
            lines.AddRange(plugin.ToolRequirements.Select(requirement => ToTitle(string.IsNullOrWhiteSpace(requirement.ExecutableName) ? requirement.Id : requirement.ExecutableName)));
        }

        return lines;
    }

    private static string RequirementKindWords(string kind) => kind switch
    {
        "local_ai" => "Local AI",
        "tool" => "Tool",
        "source" => "Source",
        "host_service" => "Library service",
        _ => ToTitle(kind),
    };

    private void BeginEditLibraries(PluginSummaryResponse plugin)
    {
        if (!_libraryLimits.TryGetValue(plugin.Id, out var limit))
            return;

        _pickedLibraries = limit.Limited
            ? limit.Libraries.Where(library => library.Selected).Select(library => library.Id).ToHashSet(StringComparer.Ordinal)
            : [];
        _editLibrariesFor = plugin.Id;
    }

    private void TogglePickedLibrary(string libraryId, bool on)
    {
        if (on)
            _pickedLibraries.Add(libraryId);
        else
            _pickedLibraries.Remove(libraryId);
    }

    private async Task SaveLibrariesAsync(PluginSummaryResponse plugin)
    {
        if (!await ApiClient.SetPluginLibrariesAsync(plugin.Id, _pickedLibraries.ToList()))
        {
            Snackbar.Add("The libraries could not be saved.", AppSeverity.Error);
            return;
        }

        _editLibrariesFor = null;
        var refreshed = await ApiClient.GetPluginLibrariesAsync(plugin.Id);
        if (refreshed is not null)
            _libraryLimits[plugin.Id] = refreshed;

        Snackbar.Add("Saved.", AppSeverity.Success);
    }

    // What the detail page shows beyond the plugin's own summary: what it needs, who needs it, where it works and what it did.
    private async Task LoadDetailAsync(string pluginId)
    {
        try
        {
            var dependencies = ApiClient.GetPluginDependenciesAsync(pluginId, _disposed.Token);
            var libraries = ApiClient.GetPluginLibrariesAsync(pluginId, _disposed.Token);
            var activity = ApiClient.GetPluginActivityAsync(pluginId, 20, _disposed.Token);
            if (await dependencies is { } loadedDependencies)
                _dependencies[pluginId] = loadedDependencies;
            if (await libraries is { } loadedLibraries)
                _libraryLimits[pluginId] = loadedLibraries;
            if (await activity is { } loadedActivity)
                _activity[pluginId] = loadedActivity;
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!_disposed.IsCancellationRequested)
            await InvokeAsync(StateHasChanged);
    }

    // Who is waiting for whom is read for every plugin once, so a card can say "Waiting for ..." without being opened.
    private async Task LoadWaitingAsync(IReadOnlyList<PluginSummaryResponse> plugins)
    {
        try
        {
            var loaded = await Task.WhenAll(plugins.Select(async plugin => (plugin.Id, Dependencies: await ApiClient.GetPluginDependenciesAsync(plugin.Id, _disposed.Token))));
            foreach (var (id, dependencies) in loaded)
            {
                if (dependencies is null)
                    continue;

                _dependencies[id] = dependencies;
                _waitingFor[id] = string.IsNullOrWhiteSpace(dependencies.WaitingFor) ? [] : [dependencies.WaitingFor];
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!_disposed.IsCancellationRequested)
            await InvokeAsync(StateHasChanged);
    }

    private async Task CheckNowAsync(PluginSummaryResponse plugin)
    {
        var result = await ApiClient.CheckPluginNowAsync(plugin.Id);
        if (result is not null)
            _checkNow[plugin.Id] = result;

        await CheckHealthAsync(plugin);
        await LoadJobsAsync(plugin);
        var activity = await ApiClient.GetPluginActivityAsync(plugin.Id, 20);
        if (activity is not null)
            _activity[plugin.Id] = activity;
    }

    private RenderFragment PluginHealthJobsPanel(PluginSummaryResponse plugin) => @<div class="settings-plugin-tab-body">
        <AppActionBar Align="AppHorizontalAlignment.Start">
            <AppButton Label="Check health" StartIcon="@AppMaterialIcons.Outlined.HealthAndSafety" Size="AppControlSize.Compact" OnClick="@(() => CheckHealthAsync(plugin))" />
            <AppButton Label="Refresh jobs" StartIcon="@AppMaterialIcons.Outlined.History" Size="AppControlSize.Compact" Tone="AppUiTone.Primary" OnClick="@(() => LoadJobsAsync(plugin))" />
        </AppActionBar>
        @if (_health.TryGetValue(plugin.Id, out var health))
        {
            <AppAlert Tone="@HealthTone(health.Status)">
                @health.Status
                @if (health.Checks.Count > 0) { <span> - @string.Join(" ", health.Checks.Select(c => c.Message).Where(m => !string.IsNullOrWhiteSpace(m)))</span> }
            </AppAlert>
        }
        else
        {
            <AppAlert Tone="AppUiTone.Info">Health has not been checked during this visit.</AppAlert>
        }
        @if (_jobs.TryGetValue(plugin.Id, out var jobs) && jobs.Count > 0)
        {
            <AppTable Class="settings-plugin-job-table">
                <thead><tr><th>Status</th><th>Type</th><th>Progress</th><th>Result</th></tr></thead>
                <tbody>
                    @foreach (var job in jobs.Take(8))
                    {
                        <tr><td>@job.Status</td><td>@job.OperationType</td><td>@job.ItemsCompleted / @job.ItemsTotal</td><td>@(job.ResultSummary ?? "-")</td></tr>
                    }
                </tbody>
            </AppTable>
