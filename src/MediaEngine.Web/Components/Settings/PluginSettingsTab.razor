    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    // A link to another plugin while this page is already open moves the ring and the scroll to that plugin.
    protected override void OnParametersSet()
    {
        if (!_loading)
        {
            ApplyFocusRequest();
            ApplyDetailRequest();
        }
    }

    // Opening a plugin's page reads what the page shows beyond the summary, once per plugin, and tells the breadcrumb its name.
    private void ApplyDetailRequest()
    {
        if (string.Equals(_appliedDetailId, DetailPluginId, StringComparison.Ordinal))
            return;

        _appliedDetailId = DetailPluginId;
        if (DetailPlugin is not { } plugin)
            return;

        _ = LoadLatestApprovalAsync(plugin.Id);
        _ = LoadDetailAsync(plugin.Id);
        _ = NameChanged.InvokeAsync(plugin.Name);
        if (!_health.ContainsKey(plugin.Id) && !IsProvider(plugin) && plugin.Enabled && _healthLoading.Add(plugin.Id))
            _ = CheckHealthInBackgroundAsync(plugin);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollToFocused || _loading || _focusedPluginId is null)
            return;

        _scrollToFocused = false;
        try
        {
            await JS.InvokeVoidAsync("tuvimaEditorScrollTo", "#" + CardElementId(_focusedPluginId));
        }
        catch (JSDisconnectedException)
        {
            // The circuit ended; there is nothing left to scroll.
        }
    }

    private bool IsFocused(PluginSummaryResponse plugin) =>
        string.Equals(plugin.Id, _focusedPluginId, StringComparison.OrdinalIgnoreCase);

    // Plugin ids hold dots (tuvima.fandom-lore), which would read as a class selector, so the page id keeps letters and digits only.
    internal static string CardElementId(string pluginId) =>
        "plugin-card-" + string.Concat(pluginId.Select(c => char.IsAsciiLetterOrDigit(c) ? c : '-'));

    // Acts once per requested id: an id that matches an installed plugin selects it, opens its settings and asks for a scroll;
    // an unknown id (or none) changes nothing.
    private void ApplyFocusRequest()
    {
        if (string.Equals(_appliedFocusRequest, FocusPluginId, StringComparison.Ordinal))
            return;

        _appliedFocusRequest = FocusPluginId;
        var match = string.IsNullOrWhiteSpace(FocusPluginId)
            ? null
            : _plugins.FirstOrDefault(plugin => string.Equals(plugin.Id, FocusPluginId.Trim(), StringComparison.OrdinalIgnoreCase));
        _focusedPluginId = match?.Id;
        if (match is null)
            return;

        // The card must be on screen: drop any filter and open the page that holds it.
        ClearFilters();
        var position = VisiblePlugins().FindIndex(plugin => plugin.Id == match.Id);
        _page = position < 0 ? 1 : (position / PageSize) + 1;
        _scrollToFocused = true;
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _plugins = (await Orchestrator.GetPluginsAsync()).OrderBy(p => p.Name).ToList();
            ApplyFocusRequest();
            Attention.ReportPlugins(_plugins.Where(plugin => !IsProvider(plugin)).ToList());
            ApplyDetailRequest();
            await LoadProviderStatusAsync();
            if (!_tasksLoaded)
            {
                // The run records are read once per visit; they only give each card its last activity and last failure.
                _tasksLoaded = true;
                _tasks = (await ApiClient.GetScheduledTasksAsync(_disposed.Token))?.Tasks;
            }
        }
        catch
        {
            _error = L["PluginSettingsTab_PluginSettingsCouldNotBe"].Value;
        }
        finally
        {
            _loading = false;
        }

        StartHealthChecks(_plugins.Where(plugin => !IsProvider(plugin) && plugin.Enabled && plugin.IsCompatible && string.IsNullOrWhiteSpace(plugin.LoadError)));
        _ = LoadWaitingAsync(_plugins.Where(plugin => !IsProvider(plugin)).ToList());
    }

    // The connection state of each provider (working, failing) comes from the provider status the Engine keeps.
    private async Task LoadProviderStatusAsync()
    {
        try
        {
            foreach (var status in await ApiClient.GetProviderStatusAsync(_disposed.Token))
                _providerStatus[status.Name] = status;
        }
        catch (OperationCanceledException)
        {
            // The page closed while the answer was on its way.
        }
        catch (HttpRequestException)
        {
            // Without the statuses the tiles still say On, Off and Needs a key; they just cannot say Broken.
        }
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
    }

    // After a change on the plugin's page the list is read again without the loading skeleton, so the page stays where it is.
    private async Task RefreshAsync()
    {
        try
        {
            _plugins = (await Orchestrator.GetPluginsAsync()).OrderBy(p => p.Name).ToList();
            Attention.ReportPlugins(_plugins.Where(plugin => !IsProvider(plugin)).ToList());
            await LoadProviderStatusAsync();
        }
        catch (HttpRequestException)
        {
            _error = L["PluginSettingsTab_PluginSettingsCouldNotBe"].Value;
        }

        if (DetailPlugin is { } plugin && !IsProvider(plugin))
        {
            await CheckHealthAsync(plugin);
        }

        await InvokeAsync(StateHasChanged);
    }

    // Each switched-on plugin that loaded gets one health check in the background; its card shows a quiet placeholder
    // until the answer arrives. A plugin that is off or broken needs no check to know its word.
    private void StartHealthChecks(IEnumerable<PluginSummaryResponse> plugins)
    {
        foreach (var plugin in plugins.ToList())
        {
            if (_healthLoading.Add(plugin.Id))
                _ = CheckHealthInBackgroundAsync(plugin);
        }
    }

    private async Task CheckHealthInBackgroundAsync(PluginSummaryResponse plugin)
    {
        try
        {
            var result = await Orchestrator.CheckPluginHealthAsync(plugin.Id, _disposed.Token);
            if (result is not null)
                _health[plugin.Id] = result;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            _healthLoading.Remove(plugin.Id);
        }

        if (!_disposed.IsCancellationRequested)
            await InvokeAsync(StateHasChanged);
    }

    // The newest approval for a plugin: who turned it on and when, from the Engine's approval record.
    private async Task LoadLatestApprovalAsync(string pluginId)
    {
        try
        {
            var records = await Orchestrator.GetApprovalsAsync("plugin", pluginId, _disposed.Token);
            if (records is { Count: > 0 })
                _latestApproval[pluginId] = records[0];
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!_disposed.IsCancellationRequested)
            await InvokeAsync(StateHasChanged);
    }

    // Configure opens the plugin's own page; the tab it opens on is Overview unless a menu item asked for another.
    private void ConfigurePlugin(string pluginId, string tab = "setup") =>
        Navigation.NavigateTo(DetailHref(pluginId, tab));

    private static string DetailHref(string pluginId, string tab = "setup", bool attention = false) =>
        $"/settings/plugins/{Uri.EscapeDataString(pluginId)}" + (tab == "setup" ? string.Empty : "/" + tab) + (attention ? "?attention=1" : string.Empty);

    // The gear of a plugin that needs the administrator links with ?attention=1.
    private bool AttentionRequested() =>
        new Uri(Navigation.Uri).Query.Split('&', '?').Contains("attention=1", StringComparer.Ordinal);

    private async Task SetEnabledAsync(PluginSummaryResponse plugin, bool enabled)
    {
        if (IsProvider(plugin))
        {
            if (!await ApiClient.UpdateProviderAsync(plugin.Id, enabled, _disposed.Token))
            {
                Snackbar.Add(L["PluginSettingsTab_TheSourceCouldNotBe"].Value, AppSeverity.Error);
                return;
            }

            plugin.Enabled = enabled;
            return;
        }

        var result = await Orchestrator.SetPluginEnabledAsync(plugin.Id, enabled);
        if (enabled && result.Approval is { } approval)
        {
            // The Engine wants the person to see what the plugin can do first. Cancel leaves it off and asks nothing more.
            var hashes = await Approvals.ConfirmAsync(approval.Approvals);
            if (hashes is null || !hashes.TryGetValue(plugin.Id, out var hash))
            {
                await InvokeAsync(StateHasChanged);
                return;
            }

            result = await Orchestrator.SetPluginEnabledAsync(plugin.Id, true, hash);
        }

        if (!result.Succeeded)
        {
            // The Engine's plain-English reason (for example a Library version the plugin does not support) beats the generic text.
            Snackbar.Add(string.IsNullOrWhiteSpace(result.Message) ? "Plugin state could not be saved." : result.Message, AppSeverity.Error);
            return;
        }

        plugin.Enabled = enabled;
        Attention.ReportPlugins(_plugins);
        if (enabled)
        {
            StartHealthChecks([plugin]);
            await LoadLatestApprovalAsync(plugin.Id);
        }
        Snackbar.Add($"{plugin.Name} {(enabled ? "enabled" : "disabled")}.", AppSeverity.Success);
    }

    // Removing says first what would have no source, and that what the plugin already saved stays.
    private async Task BeginDeleteAsync(PluginSummaryResponse plugin)
    {
        _removalPreview = await ApiClient.GetPluginRemovalPreviewAsync(plugin.Id);
        _removeOutput = _removalPreview?.DefaultOutput ?? "keep";
        _switchOffDependants = false;
        _removeProblem = null;
        _deletePluginId = plugin.Id;
    }

    private static IReadOnlyList<AppSelectOption> RemoveOutputOptions(PluginRemovalPreviewResponse preview) =>
    [
        new("keep", $"Keep the {preview.SavedOutput}"),
        new("remove", $"Remove the {preview.SavedOutput}"),
    ];

    private async Task DeletePluginAsync(PluginSummaryResponse plugin)
    {
        var result = await ApiClient.RemovePluginAsync(plugin.Id, new PluginRemoveRequest
        {
            Output = _removalPreview?.SavedOutput is null ? null : _removeOutput,
            AlsoSwitchOffDependants = _switchOffDependants,
        });
        if (!result.Succeeded)
        {
            // The Engine explains a refusal (for example another plugin needs this one); show its words, not a generic failure.
            _removeProblem = string.IsNullOrWhiteSpace(result.Message) ? "Plugin could not be deleted." : result.Message;
            return;
        }

        Snackbar.Add($"{plugin.Name} deleted.", AppSeverity.Success);
        _deletePluginId = null;
        _removalPreview = null;
        _removeProblem = null;
        Navigation.NavigateTo("/settings/plugins");
    }

    private async Task CheckHealthAsync(PluginSummaryResponse plugin)
    {
        var result = await Orchestrator.CheckPluginHealthAsync(plugin.Id);
        if (result is not null)
            _health[plugin.Id] = result;
    }

    private static string PluginIcon(PluginSummaryResponse plugin) => plugin.Id switch
    {
        var id when id.Contains("commercial", StringComparison.OrdinalIgnoreCase) => AppMaterialIcons.Outlined.LiveTv,
        var id when id.Contains("intro", StringComparison.OrdinalIgnoreCase) => AppMaterialIcons.Outlined.FastForward,
        var id when id.Contains("credits", StringComparison.OrdinalIgnoreCase) => AppMaterialIcons.Outlined.MovieFilter,
        var id when id.Contains("ai", StringComparison.OrdinalIgnoreCase) => AppMaterialIcons.Outlined.Memory,
        _ => AppMaterialIcons.Outlined.Extension,
    };

    private static string ToTitle(string key)
    {
        var text = key.Replace('_', ' ').Replace('-', ' ');
        return string.IsNullOrWhiteSpace(text)
            ? key
            : string.Concat(char.ToUpperInvariant(text[0]), text[1..]);
    }

}
