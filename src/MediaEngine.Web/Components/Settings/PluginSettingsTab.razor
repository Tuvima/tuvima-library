    // A provider shows its bundled brand logo (an uploaded one overrides it); a plugin that runs on Local AI has no brand logo,
    // so its box is a purple sparkle (v4 D32); any other plugin keeps the extension icon.
    private RenderFragment TileLogo(PluginSummaryResponse plugin, int size)
    {
        var compact = size > 32 ? AppControlSize.Normal : AppControlSize.Compact;
        if (plugin.RequiresLocalAi)
        {
            return @<AppProviderLogo Icon="@AppMaterialIcons.Outlined.AutoAwesome" AccentColor="#7E57C2" FallbackText="AI" Size="@compact" AltText="" />;
        }

        if (IsProvider(plugin))
        {
            var (colour, icon) = Services.GetService<ProviderCatalogueService>()?.GetAccent(plugin.Id) ?? (string.Empty, AppMaterialIcons.Outlined.Extension);
            var image = string.IsNullOrWhiteSpace(plugin.IconPath) ? null : "/" + plugin.IconPath.TrimStart('/');
            return @<AppProviderLogo ImageUrl="@image" Icon="@icon" AccentColor="@colour" FallbackText="@plugin.Name[..1]" Size="@compact" AltText="" />;
        }

        return @<AppProviderLogo Icon="@PluginIcon(plugin)" FallbackText="@plugin.Name[..1]" Size="@compact" AltText="" />;
    }

    // One status pill per tile (Plugins and Integrations screens v3 D19): Working, Off, Always on, Broken, or the amber reason
    // itself. Never two amber pills; the full sentence is the pill's tooltip and the page's Overview says what to do.
    private (string? Text, AppUiTone? Tone, string? Title) StatusPill(PluginSummaryResponse plugin, StateCardHealthResult state)
    {
        if (IsProvider(plugin) && plugin.Provider is { } provider)
        {
            if (provider.AlwaysOn)
                return ("Always on", AppUiTone.Neutral, "A core source: it is always on and has no switch.");
            if (provider.RequiresKey && !provider.KeyPresent)
                return ("Needs a key", AppUiTone.Warning, "Add your own key on its page to switch it on.");
            if (!plugin.Enabled)
                return ("Off", AppUiTone.Neutral, null);
            return _providerStatus.TryGetValue(plugin.Id, out var status) && ProviderIsFailing(status)
                ? ("Broken", AppUiTone.Error, status.LastFailureReason)
                : ("Working", AppUiTone.Success, null);
        }

        if (WaitingFor(plugin) is { Count: > 0 } waiting)
        {
            var words = $"Waiting for {string.Join(" and ", waiting)}";
            return (words, AppUiTone.Warning, words);
        }

        if (MissingToolText(plugin, state.Word) is { } missing)
            return (MissingToolShortText(plugin), AppUiTone.Warning, missing);

        if (state.Word == HealthWord.Off)
            return ("Off", AppUiTone.Neutral, null);

        return (null, null, null);
    }

    private static bool ProviderIsFailing(ProviderStatusDto status) =>
        string.Equals(status.HealthStatus, "Down", StringComparison.OrdinalIgnoreCase)
        || string.Equals(status.ConnectionStatus, "failed", StringComparison.OrdinalIgnoreCase);

    private bool? SwitchState(PluginSummaryResponse plugin, bool canChange)
    {
        if (!canChange || (plugin.Provider?.AlwaysOn ?? false))
            return null;
        return plugin.Enabled;
    }

    // A provider shows its own mark in its own colour; a plugin keeps the extension icon.
    private RenderFragment? ProviderLogo(PluginSummaryResponse plugin, int size)
