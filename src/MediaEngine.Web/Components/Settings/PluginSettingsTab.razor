    private static string AudienceWords(string audience) => audience switch
    {
        "everyone" => "Everyone who can use this Library",
        "adults" => "Adults only (not kids profiles)",
        _ => "Administrators only",
    };

    private string LimitedToWords(PluginSummaryResponse plugin)
    {
        if (!_libraryLimits.TryGetValue(plugin.Id, out var limit) || !limit.Limited)
            return "All libraries";

        var names = limit.Libraries.Where(library => library.Selected).Select(library => library.Name).ToList();
        return names.Count == 0 ? "All libraries" : string.Join(", ", names);
    }

    // Everything the plugin needs, in plain words: other plugins with how they stand, then Local AI, tools, sources and host services.
    private IReadOnlyList<string> NeedLines(PluginSummaryResponse plugin)
    {
        var lines = new List<string>();
        if (_dependencies.TryGetValue(plugin.Id, out var dependencies))
        {
            lines.AddRange(dependencies.Needs.Select(need =>
                $"{need.Name}{(need.Optional ? " (only improves results)" : string.Empty)}{(need.State == "ready" ? string.Empty : $" - {need.State.Replace('_', ' ')}")}"));
        }

        var others = plugin.Access.Requires.Where(requirement => !string.Equals(requirement.Kind, "plugin", StringComparison.OrdinalIgnoreCase)).ToList();
        if (others.Count > 0)
        {
            lines.AddRange(others.Select(requirement => $"{RequirementKindWords(requirement.Kind)}: {ToTitle(requirement.Id)}{(requirement.Optional ? " (only improves results)" : string.Empty)}"));
        }
        else
        {
            lines.AddRange(plugin.ToolRequirements.Select(requirement => ToTitle(string.IsNullOrWhiteSpace(requirement.ExecutableName) ? requirement.Id : requirement.ExecutableName)));
        }

        return lines;
    }

    private static string RequirementKindWords(string kind) => kind switch
    {
        "local_ai" => "Local AI",
        "tool" => "Tool",
        "source" => "Source",
        "host_service" => "Library service",
        _ => ToTitle(kind),
    };

    private void BeginEditLibraries(PluginSummaryResponse plugin)
    {
        if (!_libraryLimits.TryGetValue(plugin.Id, out var limit))
            return;

        _pickedLibraries = limit.Limited
            ? limit.Libraries.Where(library => library.Selected).Select(library => library.Id).ToHashSet(StringComparer.Ordinal)
            : [];
        _editLibrariesFor = plugin.Id;
    }

    private void TogglePickedLibrary(string libraryId, bool on)
    {
        if (on)
            _pickedLibraries.Add(libraryId);
        else
            _pickedLibraries.Remove(libraryId);
    }

    private async Task SaveLibrariesAsync(PluginSummaryResponse plugin)
    {
        if (!await ApiClient.SetPluginLibrariesAsync(plugin.Id, _pickedLibraries.ToList()))
        {
            Snackbar.Add(L["PluginSettingsTab_TheLibrariesCouldNotBe"].Value, AppSeverity.Error);
            return;
        }

        _editLibrariesFor = null;
        var refreshed = await ApiClient.GetPluginLibrariesAsync(plugin.Id);
        if (refreshed is not null)
            _libraryLimits[plugin.Id] = refreshed;

        Snackbar.Add(L["PluginPage_Saved"].Value, AppSeverity.Success);
    }

    // What the detail page shows beyond the plugin's own summary: what it needs, who needs it, where it works and what it did.
    private async Task LoadDetailAsync(string pluginId)
    {
        try
        {
            var dependencies = ApiClient.GetPluginDependenciesAsync(pluginId, _disposed.Token);
            var libraries = ApiClient.GetPluginLibrariesAsync(pluginId, _disposed.Token);
            var activity = ApiClient.GetPluginActivityAsync(pluginId, 100, _disposed.Token);
            if (await dependencies is { } loadedDependencies)
                _dependencies[pluginId] = loadedDependencies;
            if (await libraries is { } loadedLibraries)
                _libraryLimits[pluginId] = loadedLibraries;
            if (await activity is { } loadedActivity)
                _activity[pluginId] = loadedActivity;
            await LoadUsedInAsync(pluginId);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!_disposed.IsCancellationRequested)
            await InvokeAsync(StateHasChanged);
    }

    // A metadata source says where it is used (the media kinds whose flows include it).
    private async Task LoadUsedInAsync(string pluginId)
    {
        if (DetailPlugin is not { } plugin || !IsProvider(plugin) || Services.GetService<MetadataSettingsStateService>() is not { } state)
            return;

        var snapshot = await state.LoadAsync();
        if (snapshot.ProviderFor(pluginId) is not { } provider)
            return;

        var kinds = provider.Participations
            .Select(participation => MetadataSettingsStateService.MediaTypeLabel(participation.MediaType))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        _usedIn[pluginId] = kinds.Count == 0 ? "Not used in any flow yet." : "Used in: " + string.Join(", ", kinds) + ".";
    }

    // Who is waiting for whom is read for every plugin once, so a card can say "Waiting for ..." without being opened.
    private async Task LoadWaitingAsync(IReadOnlyList<PluginSummaryResponse> plugins)
    {
        try
        {
            var loaded = await Task.WhenAll(plugins.Select(async plugin => (plugin.Id, Dependencies: await ApiClient.GetPluginDependenciesAsync(plugin.Id, _disposed.Token))));
            foreach (var (id, dependencies) in loaded)
            {
                if (dependencies is null)
                    continue;

                _dependencies[id] = dependencies;
                _waitingFor[id] = string.IsNullOrWhiteSpace(dependencies.WaitingFor) ? [] : [dependencies.WaitingFor];
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!_disposed.IsCancellationRequested)
            await InvokeAsync(StateHasChanged);
    }

