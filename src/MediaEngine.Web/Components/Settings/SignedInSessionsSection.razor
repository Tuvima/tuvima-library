@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Authentication
@using MediaEngine.Web.Components.Profiles
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@inject DashboardIdentityClient Identity
@inject DashboardSessionAccessor Session
@inject ConfirmedActionRunner Confirmed
@inject IAppToastService Snackbar
@inject ILogger<SignedInSessionsSection> Logger
@implements IDisposable
@inject IStringLocalizer<SharedStrings> L

@* A member sees their own signed-in browsers. An administrator sees everyone the Engine lets them look after, grouped by
   person. Either way each browser has its own Sign out. *@
<SettingsSectionPanel Title="@L["SignedInSessionsSection_SignedInBrowsers"].Value" Icon="@AppMaterialIcons.Outlined.Logout"
                      Description="@(ManagesOthers ? "Where people are signed in right now. Sign one out to end that sign-in at once." : "Where you are signed in right now. Sign one out to end that sign-in at once.")">
    @if (_loading)
    {
        <AppSkeleton Size="AppControlSize.Compact" />
    }
    else if (_locked)
    {
        <AppAlert Tone="AppUiTone.Warning">@L["SignedInSessionsSection_EnterYourAdministratorPINTo"]</AppAlert>
        <div class="signed-in-sessions__actions">
            <AppButton Label="@L["Common_EnterPIN"].Value" StartIcon="@AppMaterialIcons.Outlined.LockOpen" OnClick="OpenUnlock" />
        </div>
    }
    else if (_loadFailed)
    {
        <AppAlert Tone="AppUiTone.Error">@L["SignedInSessionsSection_SignedInSessionsCouldNot"]</AppAlert>
        <div class="signed-in-sessions__actions">
            <AppButton Label="@L["Common_TryAgain"].Value" StartIcon="@AppMaterialIcons.Outlined.Refresh" OnClick="LoadAsync" />
        </div>
    }
    else
    {
        @if (!HasOtherSessions)
        {
            <AppEmptyState Class="app-page-state--compact"
                           Title="@(ManagesOthers ? "Nobody else is signed in" : "You are not signed in anywhere else")"
                           Message="@(ManagesOthers ? "When someone signs in on another device, it shows up here." : "When you sign in on another device, it shows up here.")" />
        }
        else if (VisiblePeople.Count == 0)
        {
            <AppEmptyState Class="app-page-state--compact" Title="@L["SignedInSessionsSection_NoSignInsMatch"].Value"
                           Message="@L["Common_ChangeTheHouseholdOrProfile"].Value" />
        }

        @foreach (var person in VisiblePeople)
        {
            <section class="signed-in-sessions__person" data-session-person="@person.AccountId" aria-label="@PersonName(person)">
                @if (ManagesOthers)
                {
                    <header class="signed-in-sessions__person-header">
                        <span class="signed-in-sessions__avatar" aria-hidden="true">
                            <ProfileAvatar DisplayName="@PersonName(person)" />
                        </span>
                        <span class="signed-in-sessions__who">
                            <span class="signed-in-sessions__name">@PersonName(person)</span>
                            @if (PersonDetail(person) is { } detail)
                            {
                                <span class="signed-in-sessions__detail">@detail</span>
                            }
                        </span>
                    </header>
                }
                <ul class="signed-in-sessions__list" role="list">
                    @foreach (var session in person.Sessions.Where(session => Filter.Matches(person.HouseholdId, session)))
                    {
                        var display = SecuritySessionDisplayFormatter.Format(session);
                        <li class="@(ManagesOthers ? "signed-in-sessions__row" : "signed-in-sessions__row signed-in-sessions__row--own")" data-session-row="@session.Id" @key="session.Id">
                            <span class="signed-in-sessions__device-line">
                                <DeviceTypeIcon Kind="DeviceTypeKind.Browser" />
                                <span class="signed-in-sessions__device">
                                    <span class="signed-in-sessions__device-name">
                                        @display.DeviceName
                                        @if (IsCurrent(session))
                                        {
                                            <span class="signed-in-sessions__tag" data-session-tag="this-device">@L["SignedInSessionsSection_ThisDevice"]</span>
                                        }
                                    </span>
                                    <span class="signed-in-sessions__client">@display.ClientDescription</span>
                                    <span class="signed-in-sessions__seen">Last seen @session.LastSeenAt.LocalDateTime.ToString("g")</span>
                                </span>
                            </span>
                            @if (!IsCurrent(session))
                            {
                                <AppButton Label="@L["TopBar_SignOut"].Value" ButtonStyle="AppButtonStyle.Text" Tone="AppUiTone.Error"
                                           Size="AppControlSize.Compact" OnClick="@(() => AskSignOut(person, session))" />
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    }
</SettingsSectionPanel>

<AppDialog Visible="@(_pending is not null)"
           VisibleChanged="@(_ => CancelSignOut())"
           Title="@L["Common_SignThisDeviceOut"].Value"
           Subtitle="@(_pending is null ? null : $"{PendingDeviceName} will be signed out and the person has to sign in again.")"
           Icon="@AppMaterialIcons.Outlined.Logout"
           Size="Small">
    <ChildContent>
        <p>@L["SignedInSessionsSection_ItStopsWorkingStraightAway"]</p>
    </ChildContent>
    <FooterContent>
        <div class="signed-in-sessions__dialog-actions">
            <AppButton Label="@L["Search_Cancel"].Value" OnClick="CancelSignOut" />
            <AppButton Label="@L["TopBar_SignOut"].Value" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Error"
                       Disabled="@_signingOut" OnClick="ConfirmSignOutAsync" />
        </div>
    </FooterContent>
</AppDialog>

<AdminUnlockDialog Open="@_needsUnlock" Busy="@_unlocking" Error="@_unlockError" OnUnlock="UnlockAsync" OnCancel="CancelUnlock" />

@code {
    private const string NoEmail = "No email";

    /// <summary>What an administrator narrowed the page to; the Engine has already limited the list to what they may see.</summary>
    [Parameter] public DevicesFilter Filter { get; set; } = DevicesFilter.All;

    /// <summary>An administrator, whose list comes from the managed sessions; a member sees only their own browsers.</summary>
    [Parameter] public bool ManagesOthers { get; set; }

    /// <summary>Raised once an administrator PIN was accepted here, so the rest of the page can load what it was refused.</summary>
    [Parameter] public EventCallback OnUnlocked { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private List<ManagedAccountSessionsResponse> _people = [];
    private (ManagedAccountSessionsResponse Person, DeviceSessionResponse Session)? _pending;
    private bool _loading = true;
    private bool _loadFailed;
    private bool _locked;
    private bool _signingOut;
    private bool _needsUnlock;
    private bool _unlocking;
    private bool _justUnlocked;
    private string? _unlockError;
    private Func<Task>? _afterUnlock;

    private bool HasOtherSessions => _people.Any(person => person.Sessions.Any(session => !IsCurrent(session)));

    // People left after the household and profile filters, each with at least one browser to show.
    private List<ManagedAccountSessionsResponse> VisiblePeople => _people
        .Where(person => person.Sessions.Any(session => Filter.Matches(person.HouseholdId, session)))
        .ToList();
    private string PendingDeviceName => _pending is { } pending ? SecuritySessionDisplayFormatter.Format(pending.Session).DeviceName : string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private bool IsCurrent(DeviceSessionResponse session) => Session.SessionId == session.Id;

    private static string PersonName(ManagedAccountSessionsResponse person) =>
        !string.IsNullOrWhiteSpace(person.ProfileDisplayName) ? person.ProfileDisplayName! : person.AccountLabel;

    // The line under the name: the email, or "No email" when the sign-in has none (unless the name already says so).
    private static string? PersonDetail(ManagedAccountSessionsResponse person)
    {
        if (!string.IsNullOrWhiteSpace(person.Email))
        {
            return string.Equals(person.Email, PersonName(person), StringComparison.OrdinalIgnoreCase) ? null : person.Email;
        }

        return string.Equals(PersonName(person), NoEmail, StringComparison.Ordinal) ? null : NoEmail;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        _locked = false;
        try
        {
            if (!ManagesOthers)
            {
                var own = await Identity.GetSessionsAsync(_lifetime.Token);
                _people = [new ManagedAccountSessionsResponse(Session.AccountId ?? Guid.Empty, "You", null, null, null, own)];
                return;
            }

            var result = await Identity.GetManagedSessionsAsync(_lifetime.Token);
            if (result.Succeeded && result.Value is { } people)
            {
                _people = people;
            }
            else if (result.Failure == DashboardAccessMutationFailure.Forbidden && !_justUnlocked)
            {
                // A household administrator who turned on an administrator PIN is refused until it is entered.
                _locked = true;
                RequestUnlock(LoadAsync);
            }
            else
            {
                _loadFailed = true;
            }
        }
        catch (OperationCanceledException)
        {
            // The page was left before the list arrived; nothing to show.
        }
        finally
        {
            _loading = false;
        }
    }

    private void AskSignOut(ManagedAccountSessionsResponse person, DeviceSessionResponse session)
    {
        _justUnlocked = false;
        _pending = (person, session);
    }

    private void CancelSignOut() => _pending = null;

    private async Task ConfirmSignOutAsync()
    {
        if (_pending is not { } pending || _signingOut)
        {
            return;
        }

        _signingOut = true;
        try
        {
            var result = await Confirmed.RunAsync(() => ManagesOthers
                ? Identity.RevokeManagedSessionAsync(pending.Session.Id, _lifetime.Token)
                : Identity.RevokeSessionResultAsync(pending.Session.Id, _lifetime.Token), _lifetime.Token);
            _pending = null;
            if (result.Succeeded)
            {
                Snackbar.Add($"{SecuritySessionDisplayFormatter.Format(pending.Session).DeviceName} was signed out.", AppSeverity.Success);
                await LoadAsync();
            }
            else if (result.Failure == DashboardAccessMutationFailure.Forbidden && !_justUnlocked)
            {
                RequestUnlock(() => ConfirmAfterUnlockAsync(pending));
            }
            else
            {
                Snackbar.Add(FailureText(result.Failure), AppSeverity.Error);
                await LoadAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // The page was left while signing out; the Engine answers on its own.
        }
        finally
        {
            _signingOut = false;
        }
    }

    private Task ConfirmAfterUnlockAsync((ManagedAccountSessionsResponse Person, DeviceSessionResponse Session) pending)
    {
        _pending = pending;
        return ConfirmSignOutAsync();
    }

    private static string FailureText(DashboardAccessMutationFailure failure) => failure switch
    {
        DashboardAccessMutationFailure.ConfirmItsYou => "Nothing was changed. Confirm it's you to continue.",
        DashboardAccessMutationFailure.NotFound => "That sign-in has already ended.",
        DashboardAccessMutationFailure.Validation => "Use Sign out in your own security settings for this device.",
        DashboardAccessMutationFailure.Transient => "The Engine is unavailable. Try again.",
        DashboardAccessMutationFailure.Forbidden => "You can't sign that device out.",
        _ => "That device could not be signed out.",
    };

    private void RequestUnlock(Func<Task> retry)
    {
        _unlockError = null;
        _afterUnlock = retry;
        _needsUnlock = true;
    }

    private void OpenUnlock() => RequestUnlock(LoadAsync);

    private async Task UnlockAsync(string pin)
    {
        if (_unlocking)
        {
            return;
        }

        _unlocking = true;
        _unlockError = null;
        try
        {
            var unlocked = await Identity.UnlockAdministratorAsync(new GrantAdminUnlockRequest(pin), _lifetime.Token);
            if (unlocked?.Unlocked != true)
            {
                _unlockError = L["Common_ThatPINDidNotWork"].Value;
                return;
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Could not unlock administrator access from the Devices page.");
            _unlockError = L["Common_TheEngineIsUnavailableTry"].Value;
            return;
        }
        finally
        {
            _unlocking = false;
        }

        var retry = _afterUnlock;
        _needsUnlock = false;
        _afterUnlock = null;
        _justUnlocked = true;
        await Identity.RevalidateAuthorityAsync(Session);
        if (retry is not null)
        {
            await retry();
        }

        await OnUnlocked.InvokeAsync();
    }

    private void CancelUnlock()
    {
        _needsUnlock = false;
        _afterUnlock = null;
    }

    public void Dispose()
    {
        // Cancelled but not disposed: an unlock finishing at this moment still reads the token.
        _lifetime.Cancel();
    }
}
