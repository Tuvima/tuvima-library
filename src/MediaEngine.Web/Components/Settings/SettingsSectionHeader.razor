@namespace MediaEngine.Web.Components.Settings

<div class="@RootClass">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <AppMaterialIcon Icon="@Icon" Color="AppColor.Inherit" aria-hidden="true" />
    }
    <div class="settings-section-header__copy settings-section-card__heading">
        <AppCssElement Tag="@HeadingTag" Class="settings-section-header__title settings-section-card__title">@Title</AppCssElement>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <span class="settings-section-header__description settings-section-card__description">@Description</span>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="settings-section-header__actions">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string HeadingTag { get; set; } = "h2";
    [Parameter] public bool Divider { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    private string RootClass => string.Join(" ", new[]
    {
        "settings-section-header",
        "settings-section-card__header",
        Divider ? "settings-section-header--divided" : null,
        Class,
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
