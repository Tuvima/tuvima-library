@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Models.ViewDTOs

@* The Preferences main page: one card per preference page, each with its icon, a one-line description and a link in.
   The rows come from the Settings menu tree, so this page and the menu cannot disagree. No data is read here. *@
<div class="preferences-summary" data-settings-preferences-summary>
    @foreach (var node in PreferenceNodes)
    {
        <AppCard Class="preferences-summary__card">
            <a class="preferences-summary__link" href="@node.Route">
                <span class="preferences-summary__icon"><AppMaterialIcon Icon="@node.Icon" aria-hidden="true" /></span>
                <span class="preferences-summary__copy">
                    <strong class="preferences-summary__title">@node.Label</strong>
                    <span class="preferences-summary__description">@DescriptionFor(node.Section)</span>
                </span>
                <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ChevronRight" aria-hidden="true" />
            </a>
        </AppCard>
    }
</div>

@code {
    private static IReadOnlyList<SettingsMenuNode> PreferenceNodes =>
        SettingsNav.MenuGroups
            .SelectMany(group => group.Nodes)
            .First(node => node.Section == SettingsSection.Preferences)
            .Children;

    private static string DescriptionFor(SettingsSection section) => section switch
    {
        SettingsSection.Playback => "How you watch.",
        SettingsSection.Listening => "How you listen.",
        SettingsSection.Reading => "How you read.",
        SettingsSection.Home => "What the top banner on Home may show.",
        _ => string.Empty,
    };
}
