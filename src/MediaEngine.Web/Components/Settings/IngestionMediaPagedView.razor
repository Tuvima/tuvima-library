@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Ingestion
@using MediaEngine.Contracts.Paging
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components.Routing
@inject IEngineApiClient Api
@inject NavigationManager Nav
@inject IngestionLiveDashboardState Dashboard
@implements IDisposable

<section class="ingestion-paged-view" aria-labelledby="ingestion-paged-title">
    <header>
        <div><h2 id="ingestion-paged-title">@Title</h2><p>@Subtitle</p></div>
        @if (Mode.Equals("current", StringComparison.OrdinalIgnoreCase))
        {
            <AppButton Href="/settings/ingestion" Label="Back to Live Ingestion" StartIcon="@AppMaterialIcons.Outlined.ArrowBack" />
        }
    </header>
    @if (!Mode.Equals("current", StringComparison.OrdinalIgnoreCase))
    {
        <div class="ingestion-paged-view__filters">
            <AppTextField Value="@_search" ValueChanged="OnSearchChanged" OnDebounceIntervalElapsed="OnSearchDebounced" DebounceInterval="350" Placeholder="Search recently added media…" Adornment="AppAdornment.Start" AdornmentIcon="@AppMaterialIcons.Outlined.Search" />
            <AppSelect Value="@_lane" ValueChanged="OnLaneChanged" Options="LaneOptions" Label="Media" />
            <AppSelect Value="@_sort" ValueChanged="OnSortChanged" Options="SortOptions" Label="Sort" />
            <div class="ingestion-paged-view__layout" role="group" aria-label="View mode">
                <AppNativeButton Type="button" Class="@LayoutClass("cards")" AriaLabel="Show cards" Title="Show cards" aria-pressed="@(_layout == "cards" ? "true" : "false")" OnClick="@(_ => OnLayoutChanged("cards"))">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.GridView" /><span>Cards</span>
                </AppNativeButton>
                <AppNativeButton Type="button" Class="@LayoutClass("list")" AriaLabel="Show list" Title="Show list" aria-pressed="@(_layout == "list" ? "true" : "false")" OnClick="@(_ => OnLayoutChanged("list"))">
                    <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.ViewList" /><span>List</span>
                </AppNativeButton>
            </div>
        </div>
    }
    @if (_loading && _page is null)
    {
        <AppProgressBar Indeterminate="true" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <AppAlert Tone="AppUiTone.Warning">@_error</AppAlert>
    }
    else if (_page?.Items.Count > 0)
    {
        @if (_layout == "list")
        {
            <div class="ingestion-paged-view__list" aria-label="Batch media list">
                <div class="ingestion-paged-view__list-header" aria-hidden="true">
                    <span>Media</span><span>Type and files</span><span>Status</span><span>Details</span>
                </div>
                @foreach (var item in _page.Items)
                {
                    <IngestionMediaCard Item="item" DisplayMode="list" OnOpen="OnOpen" @key="(item.BatchId, item.GroupId)" />
                }
            </div>
        }
        else
        {
            <div class="ingestion-paged-view__grid">
                @foreach (var item in _page.Items)
                {
                    <IngestionMediaCard Item="item" OnOpen="OnOpen" @key="(item.BatchId, item.GroupId)" />
                }
            </div>
        }
        <AppCompactPager Offset="@_page.Offset" Limit="@_page.Limit" HasMore="@_page.HasMore" TotalCount="@_page.TotalCount" Loading="@_loading" OffsetChanged="OnPageChanged" />
    }
    else
    {
        <AppEmptyState Title="No media found" Message="No library additions match these filters." />
    }
</section>

@code {
    [Parameter] public string Mode { get; set; } = "history";
    [Parameter] public Guid? BatchId { get; set; }
    [Parameter] public DateOnly? Date { get; set; }
    [Parameter] public EventCallback<IngestionMediaGroupDto> OnOpen { get; set; }

    private PagedResponse<IngestionMediaGroupDto>? _page;
    private string? _search;
    private string _lane = "all";
    private string _sort = "newest";
    private string _layout = "cards";
    private bool _loading;
    private string? _error;
    private int _revision;
    private string? _loadedMode;
    private Guid? _loadedBatchId;
    private DateOnly? _loadedDate;
    private CancellationTokenSource? _loadCts;
    private static readonly IReadOnlyList<AppSelectOption> LaneOptions = [new("all", "All"), new("Read", "Read"), new("Watch", "Watch"), new("Listen", "Listen")];
    private static readonly IReadOnlyList<AppSelectOption> SortOptions = [new("newest", "Date added (newest)"), new("oldest", "Date added (oldest)")];
    private string Title => Mode.ToLowerInvariant() switch { "current" => "Being Added Now", "batch" => "Added in this batch", _ => "Recently Added" };
    private string Subtitle => Mode.ToLowerInvariant() switch { "current" => "All grouped media currently being processed.", "batch" => "Browse the media groups recorded for this ingestion run.", _ => "Media that entered the library, grouped by its addition event." };
    private DateTimeOffset _lastLiveRefresh;
    private bool _disposed;
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Dashboard.OnChanged += OnDashboardChanged;
    }

    private void OnDashboardChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed || _loading || !Mode.Equals("current", StringComparison.OrdinalIgnoreCase)
            || DateTimeOffset.UtcNow - _lastLiveRefresh < TimeSpan.FromSeconds(5))
            return;
        _lastLiveRefresh = DateTimeOffset.UtcNow;
        await LoadAsync(PageOffset());
        if (!_disposed) StateHasChanged();
    });

    protected override Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedMode, Mode, StringComparison.OrdinalIgnoreCase)
            && _loadedBatchId == BatchId
            && _loadedDate == Date)
            return Task.CompletedTask;

        _loadedMode = Mode;
        _loadedBatchId = BatchId;
        _loadedDate = Date;
        ResolveQuery();
        return LoadAsync(PageOffset());
    }
    private Task OnSearchChanged(string? value) { _search = value; return Task.CompletedTask; }
    private Task OnSearchDebounced(string _) { UpdateQuery("q", _search, replace: true); return Task.CompletedTask; }
    private Task OnLaneChanged(string? value) { _lane = value ?? "all"; UpdateQuery("lane", _lane == "all" ? null : _lane, replace: false); return Task.CompletedTask; }
    private Task OnSortChanged(string? value) { _sort = value == "oldest" ? "oldest" : "newest"; UpdateQuery("sort", _sort == "newest" ? null : _sort, replace: false); return Task.CompletedTask; }
    private Task OnLayoutChanged(string value) { _layout = value == "list" ? "list" : "cards"; UpdateQuery("layout", _layout == "cards" ? null : _layout, replace: false); return Task.CompletedTask; }
    private Task OnPageChanged(int offset) { UpdateQuery("page", offset == 0 ? null : (offset / 50 + 1).ToString(), replace: false); return Task.CompletedTask; }

    private async Task LoadAsync(int offset)
    {
        var revision = ++_revision; _loading = true; _error = null;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;
        try
        {
            var page = Mode.ToLowerInvariant() switch
            {
                "current" => await Api.GetCurrentIngestionMediaAsync(offset, 50, ct),
                "batch" when BatchId.HasValue => await Api.GetActivityBatchMediaGroupsAsync(BatchId.Value, offset, 50, _search, _lane, _sort, ct),
                _ => await Api.GetRecentIngestionAdditionsAsync(_search, _lane, Date?.ToDateTime(TimeOnly.MinValue), Date?.ToDateTime(TimeOnly.MaxValue), offset, 50, _sort, ct),
            };
            if (revision == _revision) _page = page;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex) { if (revision == _revision) _error = $"Media history could not load: {ex.Message}"; }
        finally { if (revision == _revision) _loading = false; }
    }

    private void ResolveQuery()
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        _search = query.TryGetValue("q", out var rawSearch) ? rawSearch.FirstOrDefault() : null;
        _lane = query.TryGetValue("lane", out var rawLane) ? rawLane.FirstOrDefault() ?? "all" : "all";
        _sort = query.TryGetValue("sort", out var rawSort) && rawSort.FirstOrDefault() == "oldest" ? "oldest" : "newest";
        _layout = query.TryGetValue("layout", out var rawLayout) && rawLayout.FirstOrDefault() == "list" ? "list" : "cards";
    }

    private int PageOffset()
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        var page = query.TryGetValue("page", out var rawPage) && int.TryParse(rawPage.FirstOrDefault(), out var parsed)
            ? Math.Max(1, parsed)
            : 1;
        return (page - 1) * 50;
    }

    private void UpdateQuery(string name, string? value, bool replace)
    {
        var changes = new Dictionary<string, object?> { [name] = value };
        if (name != "page")
            changes["page"] = null;
        var uri = Nav.GetUriWithQueryParameters(changes);
        Nav.NavigateTo(uri, replace: replace);
    }

    private string LayoutClass(string layout) => $"ingestion-paged-view__layout-button{(_layout == layout ? " is-active" : "")}";

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(async () =>
    {
        ResolveQuery();
        await LoadAsync(PageOffset());
        StateHasChanged();
    });

    public void Dispose()
    {
        _disposed = true;
        Dashboard.OnChanged -= OnDashboardChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }
}
