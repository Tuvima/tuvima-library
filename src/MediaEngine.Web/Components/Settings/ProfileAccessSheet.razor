@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Authentication
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject DeviceContextService DeviceContext
@* The "Libraries and lanes" sheet on a person's profile page: which Libraries and which of Read / Watch / Listen / View this
   profile may use. It only gathers the choices and reports them; the page that opens it talks to the Engine, which refuses
   anything the administrator's own profile does not hold, and the reason it gives is shown here. The lanes are saved with Save;
   the ticks on each lane's Libraries list save straight away through the page, so Save only carries the lanes. *@
@if (Open && !DeviceContext.IsPhone)
{
    <div class="settings-sheet-backdrop" @onclick="CloseAsync">
        <div @ref="_root"
             class="settings-sheet settings-sheet--card profile-access-sheet"
             role="dialog"
             aria-modal="true"
             aria-label="Libraries and lanes"
             tabindex="-1"
             @onclick:stopPropagation="true"
             @onkeydown="OnKeyDown">
            <AppDialogShell Modal="false" Title="Libraries and lanes" Size="Medium" OnClose="@(Saving ? default : EventCallback.Factory.Create(this, CloseAsync))">
                <ChildContent>
            <div class="app-dialog-shell__pad app-dialog-shell__pad--stretch">
            <p class="sign-in-sheet__intro">
                What @(string.IsNullOrWhiteSpace(PersonName) ? "this person" : PersonName) can open.
            </p>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <p class="who-page__error" role="alert">@Error</p>
            }

            @if (Loading)
            {
                <div role="status" aria-label="Loading access"><AppSkeleton Height="160px" /></div>
            }
            else
            {
                <ManagedAccessUserPermissions FeatureIds="_featureIds" HiddenIds="_hiddenIds" Libraries="Libraries" LibrariesUnavailable="LibrariesUnavailable"
                                              OfferedFeatureIds="OfferedFeatureIds" PersonName="@PersonName" ReadOnly="ReadOnly" LibrariesBusy="Saving"
                                              FeatureChanged="ToggleFeature" OnHiddenChanged="OnHiddenChanged" RetryLibraries="OnRetryLibraries" />
            }

            </div>
                </ChildContent>
                <FooterContent>
                    <AppButton Label="Cancel" Disabled="@Saving" OnClick="CloseAsync" />
                    <AppButton Label="@(Saving ? "Saving…" : "Save")" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary"
                               Disabled="@(Saving || Loading || Person is null)" OnClick="SaveAsync" />
                </FooterContent>
            </AppDialogShell>
        </div>
    </div>
}

@code {
    private readonly HashSet<string> _featureIds = [];
    private IReadOnlySet<Guid> _hiddenIds = new HashSet<Guid>();
    private ElementReference _root;
    private bool _wasOpen;
    private bool _wasLoading;
    private bool _focused;

    [Parameter] public bool Open { get; set; }
    [Parameter] public string PersonName { get; set; } = string.Empty;
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public string? Error { get; set; }

    /// <summary>Every Library an administrator can hide from the person (the Engine marks the ones hidden from the administrator using this screen).</summary>
    [Parameter] public IReadOnlyList<AccessLibraryOptionDto> Libraries { get; set; } = [];

    /// <summary>Only the lanes this administrator may hand out (their own profile's); null offers all of them.</summary>
    [Parameter] public IReadOnlySet<string>? OfferedFeatureIds { get; set; }

    /// <summary>True when the Engine's library list could not be read: libraries are then left exactly as they are.</summary>
    [Parameter] public bool LibrariesUnavailable { get; set; }

    /// <summary>True on a phone: the Libraries ticks are shown but cannot be changed.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>One tick on a lane's Libraries list: the library and whether it is now hidden. The page saves it and answers true when it took effect.</summary>
    [Parameter] public Func<Guid, bool, Task<bool>>? OnHiddenChanged { get; set; }

    /// <summary>Asks the page to read the Engine's library list again.</summary>
    [Parameter] public EventCallback OnRetryLibraries { get; set; }

    /// <summary>The profile's current lanes and Libraries, used each time the sheet opens or finishes loading.</summary>
    [Parameter] public ManagedProfileResponse? Person { get; set; }

    [Parameter] public EventCallback<ReplaceProfileAccessRequest> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    protected override void OnParametersSet()
    {
        // The ticks always show what the Engine has saved for the person; the page hands over the new person after each tick.
        _hiddenIds = (Person?.HiddenLibraryIds ?? []).ToHashSet();

        // Take the person's current access when the sheet opens, and again once it has finished loading.
        if (Open && (!_wasOpen || (_wasLoading && !Loading)))
        {
            Seed();
        }

        _wasOpen = Open;
        _wasLoading = Loading;
    }

    private void Seed()
    {
        _featureIds.Clear();
        if (Person is { } person)
        {
            // Only the lanes this administrator holds can change; the Engine keeps the rest as it is.
            _featureIds.UnionWith(person.FeatureIds ?? []);
        }
    }

    private void ToggleFeature((string Id, bool Value) change)
    {
        if (change.Value)
        {
            _featureIds.Add(change.Id);
        }
        else
        {
            _featureIds.Remove(change.Id);
        }
    }

    // Access is changed on a computer or tablet; a phone neither shows this sheet nor saves from it. The lanes are saved here; the
    // hidden libraries are whatever the Engine already has, because the ticks save themselves.
    private Task SaveAsync() => DeviceContext.IsPhone ? Task.CompletedTask :
        OnSave.InvokeAsync(new ReplaceProfileAccessRequest(
            _featureIds.Where(feature => OfferedFeatureIds is null || OfferedFeatureIds.Contains(feature)).Order().ToArray(),
            _hiddenIds.Order().ToArray()));

    private Task CloseAsync() => Saving ? Task.CompletedTask : OnClose.InvokeAsync();

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Open || DeviceContext.IsPhone)
        {
            _focused = false;
            return;
        }

        if (_focused)
        {
            return;
        }

        _focused = true;
        try
        {
            await _root.FocusAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit closed while the sheet was opening; there is nothing left to focus.
        }
    }

}
