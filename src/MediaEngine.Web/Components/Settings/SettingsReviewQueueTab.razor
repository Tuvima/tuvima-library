@namespace MediaEngine.Web.Components.Settings
@inject UIOrchestratorService Orchestrator
@inject MediaEditorLauncherService MediaEditorLauncher
@inject IAppToastService Snackbar
@inject NavigationManager Nav
@using MediaEngine.Web.Services.Editing

<div class="settings-review-page">
    <header class="settings-review-heading">
        <div>
            <h2>Needs Review</h2>
            <strong>@(_items.Count == 1 ? "1 item needs attention" : $"{_items.Count:N0} items need attention")</strong>
            <p>Items Tuvima Library could not identify or complete automatically.</p>
        </div>
        <AppButton Label="Refresh" Size="AppControlSize.Compact" StartIcon="@AppMaterialIcons.Outlined.Refresh" Disabled="@_loading" OnClick="LoadAsync" />
    </header>

    <section class="settings-review-summary" aria-label="Review categories">
        @foreach (var category in SummaryCategories)
        {
            <AppNativeButton Type="button" Class="@CategoryClass(category.Key)" OnClick="@(_ => SelectCategory(category.Key))">
                <span aria-hidden="true"><AppMaterialIcon Icon="@category.Icon" /></span>
                <span><small>@category.Label</small><strong>@category.Count.ToString("N0")</strong></span>
            </AppNativeButton>
        }
    </section>

    <div class="settings-review-filter-bar" role="group" aria-label="Filter review queue">
        <AppTextField @bind-Value="_search" Placeholder="Search items..." Adornment="AppAdornment.Start" AdornmentIcon="@AppMaterialIcons.Outlined.Search" Class="settings-review-filter-bar__search" />
        <AppSelect Label="Issue" @bind-Value="_issue" Options="@IssueOptions" />
        <AppSelect Label="Media type" @bind-Value="_mediaType" Options="@MediaOptions" />
        <AppSelect Label="Age" @bind-Value="_age" Options="@AgeOptions" />
        <AppSelect Label="Sort" @bind-Value="_sort" Options="@SortOptions" />
        @if (HasFilters)
        {
            <AppButton Label="Clear filters" ButtonStyle="AppButtonStyle.Text" Size="AppControlSize.Compact" OnClick="ClearFilters" Class="settings-review-filter-bar__clear" />
        }
    </div>

    @if (_loading && _items.Count == 0)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="Loading review queue" Message="Checking for items that need a decision." />
    }
    else if (!string.IsNullOrWhiteSpace(_error) && _items.Count == 0)
    {
        <AppPageState Kind="AppPageStateKind.Error" Icon="@AppMaterialIcons.Outlined.CloudOff" Title="Review queue is unavailable" Message="@_error" />
    }
    else if (_items.Count == 0)
    {
        <AppEmptyState Class="app-page-state--compact" Title="Review queue is clear" />
    }
    else
    {
        @if (_loading) { <AppProgressBar Indeterminate="true" Class="settings-review-refresh-bar" /> }
        <AppPanel Class="settings-review-list" Density="AppSurfaceDensity.Compact">
            <div class="settings-review-table-header" aria-hidden="true"><span>Item</span><span>Issue</span><span>Age</span><span>Action</span></div>
            @foreach (var item in VisibleItems)
            {
                var issue = ReviewIssueClassifier.Classify(item.Trigger);
                var detail = ReviewIssuePresentationBuilder.Build(item);
                <article class="settings-review-row" @key="item.Id">
                    <div class="settings-review-row__item" data-label="Item">
                        <span class="settings-review-media-icon" aria-hidden="true"><AppMaterialIcon Icon="@MediaIcon(item.MediaType)" /></span>
                        <span><strong>@DisplayTitle(item)</strong><small>@MediaLabel(item)</small></span>
                    </div>
                    <div class="settings-review-row__reason" data-label="Issue">
                        <strong>@issue.Label</strong>
                        <span>@detail.QueueExplanation.</span>
                    </div>
                    <time data-label="Age" datetime="@item.CreatedAt.ToString("O")">@WaitingAge(item.CreatedAt)</time>
                    <div class="settings-review-row__actions" data-label="Action">
                        <AppButton Label="Review" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Size="AppControlSize.Compact" Disabled="@_busyIds.Contains(item.Id)" OnClick="@(() => OpenReviewEditorAsync(item))" />
                        <AppOverflowMenu AriaLabel="@($"More actions for {DisplayTitle(item)}")" Size="AppControlSize.Compact">
                            <AppMenuItem Label="Find in batch history" Icon="@AppMaterialIcons.Outlined.ReceiptLong" OnClick="@(() => Nav.NavigateTo(BatchHistoryHref(item)))" />
                            @if (IsWikidataReview(item.Trigger)) { <AppMenuItem Label="Keep provider match" Icon="@AppMaterialIcons.Outlined.Link" OnClick="@(() => SkipUniverseAsync(item))" /> }
                            <AppMenuItem Label="Dismiss from review" Icon="@AppMaterialIcons.Outlined.Close" OnClick="@(() => DismissAsync(item))" />
                        </AppOverflowMenu>
                    </div>
                </article>
            }
            <footer>Showing @VisibleItems.Count of @_items.Count items</footer>
        </AppPanel>
    }
</div>

@code {
    private const string All = "all";
    private List<ReviewItemViewModel> _items = [];
    private readonly HashSet<Guid> _busyIds = [];
    private bool _loading = true;
    private string? _error;
    private string _issue = All;
    private string _mediaType = All;
    private string _age = All;
    private string _sort = "oldest";
    private string? _search;

    private static readonly IReadOnlyList<AppSelectOption> IssueOptions = [new(All, "All issues"), new(ReviewIssueClassifier.CategoryNoProviderMatch, "No reliable match"), new(ReviewIssueClassifier.CategoryIncompleteMetadata, "Incomplete metadata"), new(ReviewIssueClassifier.CategoryDuplicates, "Possible duplicates")];
    private static readonly IReadOnlyList<AppSelectOption> AgeOptions = [new(All, "Any time"), new("day", "Older than 1 day"), new("week", "Older than 7 days"), new("stale", "Older than 14 days")];
    private static readonly IReadOnlyList<AppSelectOption> SortOptions = [new("oldest", "Oldest first"), new("newest", "Newest first"), new("title", "Title A–Z")];
    private IReadOnlyList<AppSelectOption> MediaOptions => new[] { new AppSelectOption(All, "All media types") }.Concat(_items.Select(MediaLabel).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(value => value).Select(value => new AppSelectOption(value, value))).ToList();
    private bool HasFilters => !string.IsNullOrWhiteSpace(_search) || _issue != All || _mediaType != All || _age != All || _sort != "oldest";

    private IReadOnlyList<ReviewItemViewModel> VisibleItems
    {
        get
        {
            IEnumerable<ReviewItemViewModel> items = _items;
            if (!string.IsNullOrWhiteSpace(_search)) items = items.Where(item => $"{DisplayTitle(item)} {item.Detail} {MediaLabel(item)}".Contains(_search, StringComparison.OrdinalIgnoreCase));
            if (_issue != All) items = items.Where(item => ReviewIssueClassifier.MatchesCategory(item.Trigger, _issue));
            if (_mediaType != All) items = items.Where(item => MediaLabel(item).Equals(_mediaType, StringComparison.OrdinalIgnoreCase));
            var now = DateTimeOffset.UtcNow;
            items = _age switch { "day" => items.Where(item => now - item.CreatedAt >= TimeSpan.FromDays(1)), "week" => items.Where(item => now - item.CreatedAt >= TimeSpan.FromDays(7)), "stale" => items.Where(item => now - item.CreatedAt >= TimeSpan.FromDays(14)), _ => items };
            return (_sort switch { "newest" => items.OrderByDescending(item => item.CreatedAt), "title" => items.OrderBy(DisplayTitle, StringComparer.OrdinalIgnoreCase), _ => items.OrderBy(item => item.CreatedAt) }).ToList();
        }
    }

    private IReadOnlyList<ReviewCategory> SummaryCategories
    {
        get
        {
            var categories = new List<ReviewCategory>
            {
                new(All, "All", _items.Count, AppMaterialIcons.Outlined.GridView),
                new(ReviewIssueClassifier.CategoryNoProviderMatch, "No reliable match", Count(ReviewIssueClassifier.CategoryNoProviderMatch), AppMaterialIcons.Outlined.Search),
                new(ReviewIssueClassifier.CategoryIncompleteMetadata, "Incomplete metadata", Count(ReviewIssueClassifier.CategoryIncompleteMetadata), AppMaterialIcons.Outlined.Description),
            };
            var duplicates = Count(ReviewIssueClassifier.CategoryDuplicates);
            if (duplicates > 0) categories.Add(new(ReviewIssueClassifier.CategoryDuplicates, "Possible duplicates", duplicates, AppMaterialIcons.Outlined.ContentCopy));
            return categories;
        }
    }

    private int Count(string category) => _items.Count(item => ReviewIssueClassifier.MatchesCategory(item.Trigger, category));
    private string CategoryClass(string key) => $"settings-review-summary__card {(key == _issue ? "is-selected" : null)}";
    private void SelectCategory(string key) => _issue = key;
    private void ClearFilters() { _search = null; _issue = All; _mediaType = All; _age = All; _sort = "oldest"; }
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { _loading=true; _error=null; try { _items=await Orchestrator.GetPendingReviewsAsync(100); } catch (Exception ex) { _error=$"Review queue could not load: {ex.Message}"; } finally { _loading=false; } }
    private async Task DismissAsync(ReviewItemViewModel item) { _busyIds.Add(item.Id); try { if(await Orchestrator.DismissReviewAsync(item.Id)){_items.Remove(item);Snackbar.Add("Review item dismissed. Its metadata was not changed.",AppSeverity.Success);} else Snackbar.Add("Review item could not be dismissed.",AppSeverity.Warning); } finally {_busyIds.Remove(item.Id);} }
    private async Task SkipUniverseAsync(ReviewItemViewModel item) { _busyIds.Add(item.Id); try { if(await Orchestrator.SkipUniverseAsync(item.Id)){_items.Remove(item);Snackbar.Add("Provider match kept and canonical matching skipped.",AppSeverity.Success);} else Snackbar.Add("The issue could not be resolved.",AppSeverity.Warning); } finally {_busyIds.Remove(item.Id);} }
    private async Task OpenReviewEditorAsync(ReviewItemViewModel item)
    {
        _busyIds.Add(item.Id);
        try
        {
            var target = ReviewTargetResolver.Resolve(item.MediaType, item.Trigger);
            var title = DisplayTitle(item);
            var applied = await MediaEditorLauncher.OpenAsync(new MediaEditorLaunchRequest
            {
                EntityIds = [item.EntityId],
                LaunchEntityId = item.EntityId,
                LaunchEntityKind = StringHelpers.FirstNonBlankOr("", item.EntityType, "review"),
                Mode = SharedMediaEditorMode.Review,
                IdentityIntent = target.Intent,
                InitialTab = "links",
                InitialCanonicalTargetGroup = target.CanonicalTargetGroup,
                ReviewItemId = item.Id,
                ReviewTrigger = item.Trigger,
                MediaType = item.MediaType,
                HeaderTitle = title,
                HeaderSubtitle = "Find match",
                CoverUrl = item.CoverUrl,
                PreviewItems = [new MediaEditorPreviewItem { EntityId = item.EntityId, Title = title, CoverUrl = item.CoverUrl, MediaType = item.MediaType }],
            });
            if (applied)
            {
                await LoadAsync();
                Snackbar.Add("Review changes applied.", AppSeverity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Review editor could not open: {ex.Message}", AppSeverity.Error);
        }
        finally
        {
            _busyIds.Remove(item.Id);
        }
    }
    private static string DisplayTitle(ReviewItemViewModel item)=>StringHelpers.FirstNonBlankOr("",item.EntityTitle,item.Detail,item.EntityId.ToString());
    private static string MediaLabel(ReviewItemViewModel item)=>StringHelpers.FirstNonBlankOr("Unknown",item.MediaType,item.EntityType).TrimEnd('s');
    private static string MediaIcon(string? mediaType){var v=(mediaType??"").ToLowerInvariant();return v.Contains("music")?AppMaterialIcons.Outlined.MusicNote:v.Contains("audio")?AppMaterialIcons.Outlined.Headphones:v.Contains("tv")?AppMaterialIcons.Outlined.Tv:v.Contains("movie")?AppMaterialIcons.Outlined.Movie:v.Contains("comic")?AppMaterialIcons.Outlined.AutoStories:AppMaterialIcons.Outlined.MenuBook;}
    private static bool IsWikidataReview(string? trigger)=>trigger is "WikidataBridgeFailed" or "MissingQid" or "MultipleQidMatches" or "QidNoMatch";
    private static string WaitingAge(DateTimeOffset createdAt){var age=DateTimeOffset.UtcNow-createdAt;return age.TotalDays>=1?$"{Math.Max(1,(int)age.TotalDays)}d":age.TotalHours>=1?$"{Math.Max(1,(int)age.TotalHours)}h":$"{Math.Max(1,(int)age.TotalMinutes)}m";}
    private static string BatchHistoryHref(ReviewItemViewModel item) => $"/settings/recently-added?q={Uri.EscapeDataString(DisplayTitle(item))}";
    private sealed record ReviewCategory(string Key, string Label, int Count, string Icon);
}
