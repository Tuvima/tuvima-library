@namespace MediaEngine.Web.Components.Universe
@inject IEngineApiClient ApiClient
@inject IJSRuntime JS
@inject IStringLocalizer<SharedStrings> L
<div class="cast-panel">
    <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="2" Class="tl-sp-mb-4">
        <AppText Typo="AppTypo.subtitle1" Class="tl-u-color-tl-accent-primary tl-u-font-weight-600 tl-u-flex-1">
            @L["CastComparison_CastComparison"]
        </AppText>
        <AppSwitchRow T="bool" @bind-Value="_multiActorOnly" Label="@L["Universe_CastMultiActorOnly"].Value"
                   Color="AppColor.Warning" />
        <AppTextField T="string" @bind-Value="_search" Placeholder="@L["CastComparison_SearchCharacters"].Value"
                      Variant="AppVariant.Outlined" Margin="AppMargin.Dense" Class="tl-u-max-width-200px"
                      Adornment="AppAdornment.Start"
                      AdornmentIcon="@AppMaterialIcons.Filled.Search"
                      Immediate="true" />
    </AppStack>

    @if (_loading)
    {
        <div class="tl-flex tl-justify-center tl-sp-pa-8">
            <AppSpinner Indeterminate="true" Color="AppColor.Warning" />
        </div>
    }
    else if (_castData?.characters.Count > 0)
    {
        <div class="cast-grid">
            @foreach (var character in FilteredCharacters)
            {
                <div class="cast-card">
                    @* Character portrait *@
                    <div class="character-portrait">
                        @if (!string.IsNullOrWhiteSpace(character.image))
                        {
                            @* Drawn 64px (CastComparison.razor.css). *@
                            <img src="@MediaTileArtworkUrl.ForDrawnSize(character.image, 64)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(character.image, 64)" alt="@character.label" class="char-img" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <div class="char-img-placeholder">
                                <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Person" Class="tl-u-font-size-32px tl-u-color-hex-555" />
                            </div>
                        }
                    </div>

                    @* Character name *@
                    <AppText Typo="AppTypo.subtitle2" Class="tl-sp-mt-2 tl-sp-mb-1 tl-u-font-weight-600 tl-u-white-space-nowrap tl-u-overflow-hidden tl-u-text-overflow-ellipsis tl-u-max-width-160px"
                             >
                        @character.label
                    </AppText>
                    @if (!string.IsNullOrWhiteSpace(character.description))
                    {
                        <AppText Typo="AppTypo.caption" Class="tl-u-color-hex-888 tl-u-font-size-xs tl-u-overflow-hidden tl-u-display-webkit-box tl-u-webkit-line-clamp-2 tl-u-webkit-box-orient-vertical tl-u-max-width-160px">
                            @character.description
                        </AppText>
                    }

                    @* Performer chips *@
                    @if (character.performers.Any())
                    {
                        var performers = character.performers.ToList();
                        <AppText Typo="AppTypo.caption" Class="tl-u-color-tl-accent-primary tl-u-margin-top-8px tl-u-margin-bottom-4px tl-u-font-size-xs tl-u-font-weight-600">
                            @L["CastComparison_PERFORMERS", performers.Count]
                        </AppText>
                        <div class="performer-row">
                            @foreach (var performer in performers)
                            {
                                var performerName = performer.name ?? string.Empty;
                                <div class="performer-chip" title="@PerformerTitle(performer)">
                                    @if (!string.IsNullOrWhiteSpace(performer.headshot_url))
                                    {
                                        @* Drawn 36px, the compact avatar (tuvima.tokens.css). *@
                                        <AppAvatar Size="AppSize.Small"><img src="@MediaTileArtworkUrl.ForDrawnSize(performer.headshot_url, 36)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(performer.headshot_url, 36)" alt="@performerName" class="tl-u-width-100pct tl-u-height-100pct tl-u-object-fit-cover" loading="lazy" decoding="async" /></AppAvatar>
                                    }
                                    else
                                    {
                                        <AppAvatar Size="AppSize.Small" Color="AppColor.Secondary">
                                            @(performerName.Length > 0 ? performerName[0].ToString() : "?")
                                        </AppAvatar>
                                    }
                                    <AppText Typo="AppTypo.caption" Class="tl-u-font-size-xs tl-u-white-space-nowrap tl-u-overflow-hidden tl-u-text-overflow-ellipsis tl-u-max-width-80px">
                                        @performerName
                                    </AppText>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <AppText Typo="AppTypo.caption" Class="tl-u-color-hex-444 tl-u-margin-top-8px tl-u-font-size-xs">
                            @L["CastComparison_NoPerformersLinked"]
                        </AppText>
                    }
                </div>
            }
        </div>

        @if (!FilteredCharacters.Any())
        {
            <AppText Typo="AppTypo.body2" Class="tl-u-color-hex-555 tl-u-text-align-center tl-u-padding-32px-0">
                @L["CastComparison_NoCharactersMatchTheCurrent"]
            </AppText>
        }
    }
    else if (!_loading)
    {
        <AppAlert Severity="AppSeverity.Info">@L["CastComparison_NoCastDataFoundFor"]</AppAlert>
    }
</div>
@code {
    [Parameter] public string UniverseQid { get; set; } = string.Empty;

    /// <summary>The Universe graph the explorer already loaded; used to name the work a performer appears in.</summary>
    [Parameter] public UniverseGraphResponse? Graph { get; set; }

    private bool _multiActorOnly;
    private string _search = string.Empty;
    private bool _loading;
    private UniverseCastResponse? _castData;

    private IEnumerable<UniverseCastCharacterDto> FilteredCharacters
    {
        get
        {
            IEnumerable<UniverseCastCharacterDto> source = _castData?.characters ?? [];
            if (_multiActorOnly)
                source = source.Where(c => c.performers.Count() > 1).ToList();
            if (!string.IsNullOrWhiteSpace(_search))
                source = source.Where(c => c.label.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
            return source;
        }
    }

    // The Engine names the work by QID; the title comes from the work links on the loaded graph
    // when one of them carries it, otherwise no work is named.
    private string? PerformerTitle(UniverseCastPerformerDto performer)
    {
        if (string.IsNullOrWhiteSpace(performer.work_qid) || string.IsNullOrWhiteSpace(performer.name))
            return null;

        var workTitle = Graph?.nodes
            .SelectMany(node => node.works)
            .FirstOrDefault(work => work.qid == performer.work_qid && !string.IsNullOrWhiteSpace(work.label))
            ?.label;
        return string.IsNullOrWhiteSpace(workTitle) ? null : $"{performer.name} in {workTitle}";
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(UniverseQid) && _castData is null)
            await LoadCast();
    }

    private async Task LoadCast()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            _castData = await ApiClient.GetUniverseCastAsync(UniverseQid);
        }
        finally
        {
            _loading = false;
        }
    }
}