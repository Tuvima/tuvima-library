@namespace MediaEngine.Web.Components.Universe
@inject IEngineApiClient ApiClient
<div class="family-tree-panel">
    <AppText Typo="AppTypo.subtitle1" Class="mb-3 tl-u-color-tl-accent-primary tl-u-font-weight-600" >
        Family Tree
    </AppText>

    @* Character selector *@
    <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="2" Class="mb-4">
        <AppSelect T="string" Value="@_selectedCharQid" ValueChanged="OnCharacterSelected"
                   Label="Character" Variant="AppVariant.Outlined" Margin="AppMargin.Dense"
                   Class="tl-u-flex-1 tl-u-min-width-200px"
                   Placeholder="Select a character...">
            @foreach (var node in Characters)
            {
                <AppSelectItem T="string" Value="@node.Id">@node.Label</AppSelectItem>
            }
        </AppSelect>
        <AppNumericField T="int" @bind-Value="_generations" Label="Generations"
                         Min="1" Max="5" Class="tl-u-max-width-100px" Margin="AppMargin.Dense"
                         Variant="AppVariant.Outlined" />
        <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Warning"
                   OnClick="LoadTree" Disabled="@(string.IsNullOrEmpty(_selectedCharQid) || _loading)"
                   StartIcon="@AppMaterialIcons.Filled.AccountTree">
            @if (_loading) { <AppSpinner Size="AppSize.Small" Indeterminate="true" /> }
            else { <span>Show Tree</span> }
        </AppButton>
    </AppStack>

    @* Tree display *@
    @if (_tree is not null && _tree.Generations.Count > 0)
    {
        <div class="family-tree-container">
            @foreach (var gen in _tree.Generations.OrderBy(g => int.TryParse(g.Key, out var n) ? n : 0))
            {
                var genNum = gen.Key;
                var genLabel = genNum switch
                {
                    "0" => "Selected Character",
                    "-1" => "Parents",
                    "-2" => "Grandparents",
                    "1"  => "Children",
                    "2"  => "Grandchildren",
                    _    => $"Generation {genNum}",
                };

                <div class="gen-row">
                    <AppText Typo="AppTypo.caption" Class="gen-label">@genLabel</AppText>
                    <div class="gen-members">
                        @foreach (var member in gen.Value)
                        {
                            <div class="family-node @(member.Qid == _selectedCharQid ? "family-node-center" : "")">
                                @if (!string.IsNullOrWhiteSpace(member.Image))
                                {
                                    <AppAvatar Size="AppSize.Medium"><img src="@member.Image" alt="@member.Label" class="tl-u-width-100pct tl-u-height-100pct tl-u-object-fit-cover" /></AppAvatar>
                                }
                                else
                                {
                                    <AppAvatar Color="AppColor.Primary" Size="AppSize.Medium">
                                        @(member.Label.Length > 0 ? member.Label[0].ToString() : "?")
                                    </AppAvatar>
                                }
                                <AppText Typo="AppTypo.caption" Class="mt-1 tl-u-text-align-center tl-u-max-width-80px tl-u-overflow-hidden tl-u-text-overflow-ellipsis tl-u-white-space-nowrap" >
                                    @member.Label
                                </AppText>
                                @if (!string.IsNullOrWhiteSpace(member.Relationship))
                                {
                                    <AppText Typo="AppTypo.caption" Class="tl-u-color-hex-888 tl-u-font-size-xs tl-u-text-align-center">
                                        @member.Relationship
                                    </AppText>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="gen-divider"></div>
            }
        </div>
    }
    else if (_noResults)
    {
        <AppAlert Severity="AppSeverity.Info">No family relationships found for this character.</AppAlert>
    }
</div>
@code {
    [Parameter] public string UniverseQid { get; set; } = string.Empty;
    [Parameter] public UniverseGraphResponse? Graph { get; set; }

    private string? _selectedCharQid;
    private int _generations = 2;
    private bool _loading;
    private bool _noResults;
    private FamilyTreeResponse? _tree;

    private IEnumerable<GraphNodeDto> Characters =>
        Graph?.Nodes.Where(n =>
            string.Equals(n.Type, "Character", StringComparison.OrdinalIgnoreCase)) ?? [];

    private async Task OnCharacterSelected(string qid)
    {
        _selectedCharQid = qid;
        _tree            = null;
        _noResults       = false;
    }

    private async Task LoadTree()
    {
        if (string.IsNullOrEmpty(_selectedCharQid)) return;
        _loading   = true;
        _tree      = null;
        _noResults = false;
        StateHasChanged();

        try
        {
            _tree = await ApiClient.GetFamilyTreeAsync(
                UniverseQid, _selectedCharQid, _generations);
            _noResults = _tree is null || _tree.Generations.Count == 0;
        }
        finally
        {
            _loading = false;
        }
    }
}