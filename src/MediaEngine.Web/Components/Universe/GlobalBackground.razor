@namespace MediaEngine.Web.Components.Universe

<div class="global-bg" aria-hidden="true">
    <AppCssElement Tag="div" Class="global-bg-gradient"
         Css="@($"background: radial-gradient(circle at top center, {Color ?? "#080B14"}22 0%, #080B14 80%);")">
    </AppCssElement>
    @if (!string.IsNullOrEmpty(ImageUrl))
    {
        @* A full-screen picture blurred 120px at 10% opacity: the medium copy is plenty on every screen. *@
        <img src="@MediaTileArtworkUrl.ForDrawnSize(ImageUrl, ArtworkSize.MediumPx)" class="global-bg-image" alt="" decoding="async" />
    }
    <div class="global-bg-grain"></div>
</div>

@code {
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string? Color { get; set; }
}