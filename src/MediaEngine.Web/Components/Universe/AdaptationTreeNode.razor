@namespace MediaEngine.Web.Components.Universe

@* Recursive tree node for AdaptationTree *@

<AppCssElement Tag="div" Class="adaptation-node" Css="@($"margin-left: {Depth * 24}px;")">
    <div class="adaptation-card">
        @* Cover thumbnail *@
        @if (!string.IsNullOrWhiteSpace(Node.cover_image))
        {
            @* Drawn 40x56px (AdaptationTreeNode.razor.css). *@
            <img src="@MediaTileArtworkUrl.ForDrawnSize(Node.cover_image, 56)" srcset="@MediaTileArtworkUrl.SrcSetForDrawnSize(Node.cover_image, 56)" alt="@Node.label" class="adapt-thumb" loading="lazy" decoding="async" />
        }
        else
        {
            <div class="adapt-thumb-placeholder">
                <AppMaterialIcon Icon="@GetMediaTypeIcon(Node.media_type)" Class="tl-u-color-hex-555" />
            </div>
        }

        @* Work info *@
        <div class="adapt-info">
            <AppText Typo="AppTypo.subtitle2" Class="tl-u-font-weight-600">@Node.label</AppText>
            <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="1">
                @if (Node.year.HasValue)
                {
                    <AppChip T="string" Size="AppSize.Small" Variant="AppVariant.Outlined"
                             Class="tl-u-font-size-xs tl-u-height-20px">
                        @Node.year
                    </AppChip>
                }
                @if (!string.IsNullOrWhiteSpace(Node.media_type))
                {
                    <AppChip T="string" Size="AppSize.Small" Variant="AppVariant.Outlined"
                             Color="@GetMediaTypeColor(Node.media_type)"
                             Class="tl-u-font-size-xs tl-u-height-20px">
                        @Node.media_type
                    </AppChip>
                }
                @if (!string.IsNullOrWhiteSpace(Node.relationship_to_parent))
                {
                    <AppText Typo="AppTypo.caption" Class="tl-u-color-hex-888 tl-u-font-size-xs">
                        (@RelationshipText)
                    </AppText>
                }
            </AppStack>
        </div>
    </div>
@if (Node.children.Count > 0)
    {
        <div class="adaptation-children">
            @foreach (var child in Node.children)
            {
                <AdaptationTreeNode Node="@child" Depth="@(Depth + 1)" />
            }
        </div>
    }
</AppCssElement>
@code {
    [Parameter] public UniverseAdaptationNodeDto Node { get; set; } = default!;
    [Parameter] public int Depth { get; set; }

    // "based on", or "based on · Wikidata" when the node says where the relationship was learned.
    private string RelationshipText => string.IsNullOrWhiteSpace(Node.source)
        ? Node.relationship_to_parent!
        : $"{Node.relationship_to_parent} · {Node.source}";

    private static string GetMediaTypeIcon(string? mediaType) => mediaType?.ToLowerInvariant() switch
    {
        "book" or "epub"      => AppMaterialIcons.Filled.MenuBook,
        "movie" or "film"     => AppMaterialIcons.Filled.Movie,
        "tv" or "television"  => AppMaterialIcons.Filled.Tv,
        "comic"               => AppMaterialIcons.Filled.AutoStories,
        "audiobook"           => AppMaterialIcons.Filled.Headphones,
        "music"               => AppMaterialIcons.Filled.MusicNote,
        _                     => AppMaterialIcons.Filled.Category,
    };

    private static AppColor GetMediaTypeColor(string? mediaType) => mediaType?.ToLowerInvariant() switch
    {
        "book" or "epub"      => AppColor.Primary,
        "movie" or "film"     => AppColor.Error,
        "tv" or "television"  => AppColor.Secondary,
        "comic"               => AppColor.Warning,
        "audiobook"           => AppColor.Success,
        _                     => AppColor.Default,
    };
}