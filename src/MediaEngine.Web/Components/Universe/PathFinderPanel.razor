@namespace MediaEngine.Web.Components.Universe
@inject IEngineApiClient ApiClient
@inject IJSRuntime JS
@inject IStringLocalizer<SharedStrings> L
<div class="pathfinder-panel">
    <AppText Typo="AppTypo.subtitle1" Class="tl-sp-mb-3 tl-u-color-tl-accent-primary tl-u-font-weight-600" >
        @L["PathFinderPanel_SixDegrees"]
    </AppText>
    <AppText Typo="AppTypo.body2" Class="tl-sp-mb-4 tl-u-color-hex-888" >
        @L["PathFinderPanel_ClickNodesInTheGraph"]
    </AppText>

    @* Slot pair *@
    <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="3" Class="tl-sp-mb-4">
        <div class="slot @(_startQid is null ? "slot-empty" : "slot-filled")">
            @if (_startQid is null)
            {
                <AppMaterialIcon Icon="@AppMaterialIcons.Filled.RadioButtonUnchecked" Class="tl-u-color-hex-555" />
                <AppText Typo="AppTypo.caption" Class="tl-u-color-hex-555">@L["Universe_PathStart"]</AppText>
            }
            else
            {
                <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Circle" Class="tl-u-color-tl-accent-primary" />
                <AppText Typo="AppTypo.caption" Class="tl-u-color-hex-e0e0e0 tl-u-max-width-100px tl-u-overflow-hidden tl-u-text-overflow-ellipsis tl-u-white-space-nowrap">
                    @_startLabel
                </AppText>
                <AppIconButton Icon="@AppMaterialIcons.Filled.Close" Size="AppControlSize.Compact"
                               Class="tl-u-color-hex-888" Tooltip="@L["PathFinderPanel_ClearStart"].Value" OnClick="ClearStart" />
            }
        </div>

        <AppMaterialIcon Icon="@AppMaterialIcons.Filled.ArrowForward" Class="tl-u-color-hex-555" />

        <div class="slot @(_endQid is null ? "slot-empty" : "slot-filled")">
            @if (_endQid is null)
            {
                <AppMaterialIcon Icon="@AppMaterialIcons.Filled.RadioButtonUnchecked" Class="tl-u-color-hex-555" />
                <AppText Typo="AppTypo.caption" Class="tl-u-color-hex-555">@L["Universe_PathEnd"]</AppText>
            }
            else
            {
                <AppMaterialIcon Icon="@AppMaterialIcons.Filled.Circle" Class="tl-u-color-tl-status-info" />
                <AppText Typo="AppTypo.caption" Class="tl-u-color-hex-e0e0e0 tl-u-max-width-100px tl-u-overflow-hidden tl-u-text-overflow-ellipsis tl-u-white-space-nowrap">
                    @_endLabel
                </AppText>
                <AppIconButton Icon="@AppMaterialIcons.Filled.Close" Size="AppControlSize.Compact"
                               Class="tl-u-color-hex-888" Tooltip="@L["PathFinderPanel_ClearEnd"].Value" OnClick="ClearEnd" />
            }
        </div>
    </AppStack>

    @* Controls *@
    <AppStack Row="true" Spacing="2" Class="tl-sp-mb-4">
        <AppButton ButtonStyle="AppButtonStyle.Filled"
                   Tone="AppUiTone.Warning"
                   Disabled="@(_startQid is null || _endQid is null || _loading)"
                   OnClick="FindPath"
                   StartIcon="@AppMaterialIcons.Filled.Route">
            @if (_loading) { <AppSpinner Size="AppSize.Small" Indeterminate="true" /> }
            else { <span>@L["PathFinderPanel_FindPath"]</span> }
        </AppButton>
        <AppButton ButtonStyle="AppButtonStyle.Outlined"
                   Tone="AppUiTone.Neutral"
                   OnClick="Clear"
                   Disabled="@(_startQid is null && _endQid is null)">
            @L["Activity_Clear"]
        </AppButton>
        <AppNumericField T="int" @bind-Value="_maxHops" Label="@L["PathFinderPanel_MaxHops"].Value"
                         Min="2" Max="8" Class="tl-u-max-width-80px" Margin="AppMargin.Dense" Variant="AppVariant.Outlined" />
    </AppStack>

    @* Results *@
    @if (_noPathFound)
    {
        <AppAlert Severity="AppSeverity.Info">@L["PathFinderPanel_NoPathFoundWithinHops", _maxHops]</AppAlert>
    }
    else if (_paths?.Count > 0)
    {
        <AppText Typo="AppTypo.caption"  Class="tl-sp-mb-2 tl-u-color-hex-888">
            @L["PathFinderPanel_PathSFoundShortestHop", _paths.Count, _paths[0].Count - 1]
        </AppText>

        @for (var pi = 0; pi < Math.Min(_paths.Count, 3); pi++)
        {
            var path = _paths[pi];
            var pathIndex = pi;
            <div class="path-trail @(pathIndex == _selectedPath ? "path-trail-selected" : "")"
                 role="button"
                 tabindex="0"
                 aria-pressed="@(pathIndex == _selectedPath ? "true" : "false")"
                 @onkeydown="@(args => HandlePathKeyDownAsync(args, pathIndex))"
                 @onclick="@(() => SelectPath(pathIndex))">
                <AppText Typo="AppTypo.caption"  Class="tl-sp-mb-1 tl-u-color-hex-888">
                    @L["PathFinderPanel_PathHopS", pathIndex + 1, path.Count - 1]
                </AppText>
                <div class="hop-chain">
                    @for (var hi = 0; hi < path.Count; hi++)
                    {
                        var hop = path[hi];
                        <span class="hop-node">@LabelFor(hop)</span>
                        @if (hi < path.Count - 1)
                        {
                            var rel = RelationshipBetween(hop, path[hi + 1]);
                            <span class="hop-arrow">
                                @if (rel is { Reversed: false })
                                { <span class="tl-u-color-hex-888">-> (@rel.Value.Label) -></span> }
                                else if (rel is { Reversed: true })
                                { <span class="tl-u-color-hex-888">&lt;- (@rel.Value.Label) &lt;-</span> }
                                else
                                { <span class="tl-u-color-hex-555">-></span> }
                            </span>
                        }
                    }
                </div>
            </div>
        }
    }
</div>
@code {
    [Parameter] public string UniverseQid { get; set; } = string.Empty;
    [Parameter] public UniverseGraphResponse? Graph { get; set; }
    [Parameter] public EventCallback<(string From, string To)> OnPathRequested { get; set; }

    private string? _startQid;
    private string? _startLabel;
    private string? _endQid;
    private string? _endLabel;
    private int _maxHops = 4;
    private bool _loading;
    private bool _noPathFound;
    private IReadOnlyList<IReadOnlyList<string>>? _paths;
    private int _selectedPath = 0;

    // The Engine returns each path as entity QIDs; names and the relationship between two
    // neighbouring hops come from the Universe graph this page has already loaded.
    private string LabelFor(string qid) =>
        Graph?.nodes.FirstOrDefault(node => node.id == qid)?.label is { Length: > 0 } label ? label : qid;

    // Prefer an edge stored in path order; a reverse-only edge is marked Reversed so the
    // label is drawn pointing back and never states the opposite fact.
    private (string Label, bool Reversed)? RelationshipBetween(string fromQid, string toQid)
    {
        var forward = Graph?.edges.FirstOrDefault(candidate =>
            candidate.source == fromQid && candidate.target == toQid && !string.IsNullOrWhiteSpace(candidate.label));
        if (forward is not null)
        {
            return (forward.label, false);
        }

        var reverse = Graph?.edges.FirstOrDefault(candidate =>
            candidate.source == toQid && candidate.target == fromQid && !string.IsNullOrWhiteSpace(candidate.label));
        return reverse is null ? null : (reverse.label, true);
    }

    public void SetNode(string qid, string label)
    {
        if (_startQid is null)
        {
            _startQid   = qid;
            _startLabel = label;
        }
        else if (_endQid is null && qid != _startQid)
        {
            _endQid   = qid;
            _endLabel = label;
        }
        StateHasChanged();
    }

    private void ClearStart()
    {
        _startQid   = null;
        _startLabel = null;
        _paths      = null;
        _noPathFound = false;
    }

    private void ClearEnd()
    {
        _endQid   = null;
        _endLabel = null;
        _paths    = null;
        _noPathFound = false;
    }

    private void Clear()
    {
        _startQid    = null;
        _startLabel  = null;
        _endQid      = null;
        _endLabel    = null;
        _paths       = null;
        _noPathFound = false;
    }

    private async Task FindPath()
    {
        if (_startQid is null || _endQid is null) return;
        _loading     = true;
        _noPathFound = false;
        _paths       = null;
        StateHasChanged();

        try
        {
            var result = await ApiClient.FindPathsAsync(
                UniverseQid, _startQid, _endQid, _maxHops);

            if (result?.paths.Count > 0)
            {
                _paths = result.paths;
                _selectedPath = 0;
                await AnimatePath(0);
            }
            else
            {
                _noPathFound = true;
                await JS.InvokeVoidAsync("CytoscapeInterop.resetHighlights");
            }
        }
        finally
        {
            _loading = false;
        }

        await OnPathRequested.InvokeAsync((_startQid!, _endQid!));
    }

    private async Task SelectPath(int index)
    {
        _selectedPath = index;
        await AnimatePath(index);
    }

    private Task HandlePathKeyDownAsync(KeyboardEventArgs args, int index) =>
        args.Key is "Enter" or " "
            ? SelectPath(index)
            : Task.CompletedTask;

    private async Task AnimatePath(int index)
    {
        if (_paths is null || index >= _paths.Count) return;
        var qids = _paths[index].ToArray();
        await JS.InvokeVoidAsync("CytoscapeInterop.animatePath", (object)qids);
    }
}
