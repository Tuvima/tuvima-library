@namespace MediaEngine.Web.Components.Artwork
@using System.Globalization
@typeparam TItem

<div class="artwork-justified-gallery @(ShowCaptions ? "show-captions" : null)" aria-label="@AriaLabel">
    <JustifiedGalleryLayout />
    @foreach (var item in Items)
    {
        <AppNativeButton @key="@ItemKey(item)"
                         Type="button"
                         Class="@CardClass(item)"
                         InlineStyle="@CardStyle(item)"
                         aria-pressed="@IsSelected(item)"
                         Disabled="@(Disabled || IsDisabled(item))"
                         OnClick="@(() => OnSelect.InvokeAsync(item))"
                         AriaLabel="@($"Select {Title(item)}")">
            <span class="artwork-justified-gallery__image @(UseContain(item) ? "is-contain" : "is-cover")">
                @if (MultiSelect)
                {
                    <span class="artwork-justified-gallery__selection" aria-hidden="true"><MudIcon Icon="@(IsSelected(item) ? Icons.Material.Filled.CheckBox : Icons.Material.Outlined.CheckBoxOutlineBlank)" /></span>
                }
                @if (!string.IsNullOrWhiteSpace(ImageUrl(item)) && !_failedPreviews.Contains(ImageUrl(item)))
                {
                <img src="@ImageUrl(item)"
                     alt="" @onerror="@(() => _failedPreviews.Add(ImageUrl(item)))"
                     loading="lazy"
                     decoding="async"
                     sizes="(max-width: 720px) 42vw, (max-width: 1400px) 32vw, 480px"
                     data-image-display="artwork-justified-gallery" />
                }
                else { <span class="artwork-justified-gallery__no-preview"><MudIcon Icon="@Icons.Material.Outlined.Image" />Preview unavailable</span> }
                @if (IsPreferred(item))
                {
                    <span class="artwork-justified-gallery__preferred"><MudIcon Icon="@Icons.Material.Outlined.Star" /> Preferred</span>
                }
            </span>
            <span class="artwork-justified-gallery__caption"><strong>@Title(item)</strong><small>@SupportingText(item)</small></span>
        </AppNativeButton>
    }
</div>

@code {
    private readonly HashSet<string> _failedPreviews = [];
    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public Func<TItem, string> ItemKey { get; set; } = _ => string.Empty;
    [Parameter, EditorRequired] public Func<TItem, string> ImageUrl { get; set; } = _ => string.Empty;
    [Parameter, EditorRequired] public Func<TItem, int?> Width { get; set; } = _ => null;
    [Parameter, EditorRequired] public Func<TItem, int?> Height { get; set; } = _ => null;
    [Parameter, EditorRequired] public Func<TItem, string> Title { get; set; } = _ => "Artwork";
    [Parameter] public Func<TItem, string> SupportingText { get; set; } = _ => string.Empty;
    [Parameter] public Func<TItem, bool> IsSelected { get; set; } = _ => false;
    [Parameter] public Func<TItem, bool> IsPreferred { get; set; } = _ => false;
    [Parameter] public Func<TItem, bool> UseContain { get; set; } = _ => false;
    [Parameter] public EventCallback<TItem> OnSelect { get; set; }
    [Parameter] public bool MultiSelect { get; set; }
    [Parameter] public bool ShowCaptions { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Func<TItem, bool> IsDisabled { get; set; } = _ => false;
    [Parameter] public string AriaLabel { get; set; } = "Artwork images";

    private string CardClass(TItem item) => $"artwork-justified-gallery__card {AspectClass(item)}{(IsSelected(item) ? " is-selected" : string.Empty)}";

    private string CardStyle(TItem item) => $"--artwork-gallery-aspect:{AspectRatio(item).ToString("0.###", CultureInfo.InvariantCulture)}";

    private double AspectRatio(TItem item)
    {
        var width = Width(item);
        var height = Height(item);
        return width is > 0 && height is > 0
            ? width.Value / (double)height.Value
            : 1d;
    }

    private string AspectClass(TItem item)
    {
        var aspect = AspectRatio(item);
        return aspect switch
        {
            < .6 => "artwork-justified-gallery__card--narrow",
            < .88 => "artwork-justified-gallery__card--portrait",
            < 1.18 => "artwork-justified-gallery__card--square",
            < 1.85 => "artwork-justified-gallery__card--landscape",
            < 2.75 => "artwork-justified-gallery__card--wide",
            _ => "artwork-justified-gallery__card--panorama"
        };
    }
}
