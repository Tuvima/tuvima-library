@namespace MediaEngine.Web.Components.Artwork
@using MediaEngine.Contracts.Artwork
@inject IEngineApiClient ApiClient

<AppDialog Class="artwork-picker-host" Options="@(new DialogOptions { NoHeader = true, FullWidth = true, MaxWidth = MaxWidth.Large, Position = DialogPosition.Center, BackdropClick = false, CloseOnEscapeKey = false })">
<DialogContent>
<div class="artwork-picker-dialog">
<AppDialogShell Title="@(FromProviders ? $"Choose {ProviderName} artwork" : "Choose artwork")" Subtitle="@TargetSummary" Size="Large" OnClose="Close">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_error)) { <p role="alert">@_error</p> }
        @if (FromProviders)
        {
            @if (_loading) { <AppPageState Kind="AppPageStateKind.Loading" Title="@($"Finding {ProviderName} artwork")" /> }
            else if (_discovery is null)
            { <AppErrorState Title="Provider artwork unavailable" Message="Check the provider connection, then try again." Retry="LoadProvidersAsync" /> }
            else
            {
                @if (!string.IsNullOrWhiteSpace(_discovery.Message)) { <p>@_discovery.Message</p> }
                @if (_discovery.Context is { } providerContext)
                {
                    <p class="artwork-picker-dialog__provider-context" role="status">
                        <strong>@providerContext.Provider</strong>
                        <span>@providerContext.ScopeId · @providerContext.Role · @providerContext.SourceAssetType</span>
                        <span>Matched ID @providerContext.ProviderItemId</span>
                    </p>
                }
                @if (!string.IsNullOrWhiteSpace(_discovery.AttributionUrl))
                {
                    <a href="@_discovery.AttributionUrl" target="_blank" rel="noopener noreferrer">View this item on TheTVDB</a>
                }
                <AppButton ButtonStyle="AppButtonStyle.Text" Disabled="@_busy" OnClick="LoadProvidersAsync">Reload provider results</AppButton>
                <ArtworkJustifiedGallery TItem="ProviderArtworkCandidateDto" Items="@_discovery.Items"
                    ItemKey="@(c => c.Id)" ImageUrl="@(c => c.ThumbnailUrl)" Width="@(c => c.Width)" Height="@(c => c.Height)"
                    Title="@(c => c.Provider)" SupportingText="CandidateFacts"
                    IsSelected="@(c => _providerSelection.Contains(c.Id))" IsDisabled="@(c => c.AlreadyAdded)"
                    UseContain="@(_ => true)" MultiSelect="true" ShowCaptions="true" Disabled="@_busy" OnSelect="ToggleProvider" AriaLabel="Provider artwork candidates" />
                @if (_discovery.HasMore)
                {
                    <AppButton Label="@(_loadingMore ? "Loading…" : "Load more")"
                               ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Neutral"
                               Disabled="@(_busy || _loadingMore)" OnClick="LoadMoreProvidersAsync" />
                }
            }
        }
        else
        {
            <ArtworkAssetBrowser InitialQuery="@Query" PickerMode="true" MultiSelect="true" Disabled="@_busy"
                SelectedIds="@_selected.Keys.ToHashSet()" SelectionChanged="ToggleLibrary" />
        }
    </ChildContent>
    <FooterContent>
        <span role="status">@(_busy ? _progress : $"{SelectionCount} selected")</span>
        <AppButton Label="@(_added.Count > 0 ? "Done" : "Cancel")" ButtonStyle="AppButtonStyle.Text" Disabled="@_busy" OnClick="Close" />
        <AppButton Label="Add selected artwork" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" StartIcon="@Icons.Material.Outlined.Add" Disabled="@(_busy || SelectionCount == 0)" OnClick="AddSelectedAsync" />
    </FooterContent>
</AppDialogShell>
</div>
</DialogContent>
</AppDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public ArtworkAssetQuery Query { get; set; } = new();
    [Parameter, EditorRequired] public string TargetSummary { get; set; } = string.Empty;
    [Parameter, EditorRequired] public ArtworkLibraryItemDto TargetItem { get; set; } = default!;
    [Parameter] public bool FromProviders { get; set; }
    [Parameter] public Guid ProviderEntityId { get; set; }
    [Parameter] public string? ProviderScope { get; set; }
    [Parameter] public bool DeferLinks { get; set; }
    private readonly Dictionary<Guid, ArtworkAssetDto> _selected = [];
    private readonly HashSet<string> _providerSelection = [];
    private readonly List<Guid> _added = [];
    private ProviderArtworkDiscoveryDto? _discovery;
    private bool _busy, _loading, _loadingMore;
    private string? _error;
    private string _progress = string.Empty;
    private string ProviderName => _discovery?.Items.FirstOrDefault()?.Provider ?? TargetItem.MediaType?.ToLowerInvariant() switch { "comics" => "Comic Vine", "movies" => "TMDB", "tv" => "TV provider", _ => "metadata provider" };
    private int SelectionCount => FromProviders ? _providerSelection.Count : _selected.Count;
    private string CandidateFacts(ProviderArtworkCandidateDto c) => c.AlreadyAdded ? "Already added" : c.Width is > 0 && c.Height is > 0 ? $"{Query.TargetRole} · {c.Width} × {c.Height}" : Query.TargetRole ?? "Cover";
    protected override async Task OnInitializedAsync() { if (FromProviders) await LoadProvidersAsync(); }
    private Task LoadProvidersAsync() => LoadProviderPageAsync(reset: true);
    private Task LoadMoreProvidersAsync() => LoadProviderPageAsync(reset: false);
    private async Task LoadProviderPageAsync(bool reset)
    {
        if (_loading || _loadingMore) return;
        if (reset) { _loading = true; _error = null; _providerSelection.Clear(); }
        else _loadingMore = true;
        try
        {
            if (string.IsNullOrWhiteSpace(ProviderScope))
            {
                _discovery = new([], "This collection has no provider artwork gallery. Open an identified item to use its providers, or choose artwork from your library.");
                return;
            }
            var context = reset ? null : _discovery?.Context;
            var page = reset ? 1 : (_discovery?.Page ?? 1) + 1;
            var request = new ProviderArtworkDiscoveryRequestDto(
                Page: page,
                PageSize: 48,
                SourceAssetType: context?.SourceAssetType ?? Query.TargetSourceAssetType,
                Provider: context?.Provider,
                ProviderItemId: context?.ProviderItemId,
                ReleaseId: context?.ReleaseId,
                OrderContext: context?.OrderContext);
            var result = await ApiClient.DiscoverProviderArtworkAsync(
                ProviderEntityId, ProviderScope, Query.TargetRole ?? "Primary", request);
            if (result is null)
            {
                _error = reset
                    ? "Provider artwork could not be loaded. Check the provider connection and try again."
                    : "The provider context may have changed. Reload provider results before continuing.";
                return;
            }
            if (!reset && _discovery?.Context is { } existingContext && result.Context != existingContext)
            {
                _error = "The matched provider or artwork scope changed. Reload provider results before continuing.";
                return;
            }
            var items = reset
                ? result.Items
                : _discovery!.Items.Concat(result.Items)
                    .DistinctBy(candidate => candidate.Id, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            _discovery = result with { Items = items };
            if (result.Message?.Contains("context changed", StringComparison.OrdinalIgnoreCase) == true)
                _error = result.Message;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            if (reset) _discovery = null;
            else _error = "More provider artwork could not be loaded. Reload provider results before continuing.";
        }
        finally { _loading = false; _loadingMore = false; }
    }
    private void ToggleProvider(ProviderArtworkCandidateDto candidate)
    { if (!_busy && !candidate.AlreadyAdded && !_providerSelection.Remove(candidate.Id)) _providerSelection.Add(candidate.Id); }
    private void ToggleLibrary(ArtworkAssetDto? asset)
    { if (!_busy && asset is not null && !_selected.Remove(asset.Id)) _selected.Add(asset.Id, asset); }
    private async Task AddSelectedAsync()
    {
        if (_busy) return;
        _busy = true; _error = null;
        var failures = 0;
        var total = SelectionCount;
        var done = 0;
        try
        {
            if (FromProviders)
            {
                foreach (var id in _providerSelection.ToList())
                {
                    _progress = $"Adding {++done} of {total}…"; await InvokeAsync(StateHasChanged);
                    try
                    {
                        var result = await ApiClient.ImportProviderArtworkAsync(ProviderEntityId, ProviderScope!, Query.TargetRole ?? "Primary", [id]);
                        if (result?.Items.FirstOrDefault()?.AssetId is { } assetId)
                        {
                            _added.Add(assetId); _providerSelection.Remove(id);
                            _discovery = _discovery! with { Items = _discovery.Items.Select(c => c.Id == id ? c with { AlreadyAdded = true } : c).ToList() };
                        }
                        else failures++;
                    }
                    catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { failures++; }
                }
            }
            else
            {
                foreach (var asset in _selected.Values.ToList())
                {
                    _progress = $"Adding {++done} of {total}…"; await InvokeAsync(StateHasChanged);
                    if (DeferLinks)
                    {
                        _added.Add(asset.Id);
                        _selected.Remove(asset.Id);
                        continue;
                    }
                    try
                    {
                        var result = await ApiClient.LinkArtworkAssetAsync(TargetItem.EntityType, TargetItem.EntityId,
                            new ArtworkLinkRequest(asset.Id, Query.TargetRole ?? "Primary", Preferred: false,
                                EntityLabel: TargetItem.DisplayTitle, MediaType: TargetItem.MediaType, Year: TargetItem.Year, SourceAssetType: Query.TargetSourceAssetType));
                        if (result is not null) { _added.Add(asset.Id); _selected.Remove(asset.Id); } else failures++;
                    }
                    catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { failures++; }
                }
            }
        }
        finally { _busy = false; }
        if (failures > 0) _error = $"{failures} image(s) could not be added. Successful additions are saved; retry the remaining selections. If provider results expired, reload them.";
        else Close();
    }
    private void Close()
    { if (!_busy) { if (_added.Count > 0) Dialog.Close(DialogResult.Ok(_added)); else Dialog.Cancel(); } }
}
