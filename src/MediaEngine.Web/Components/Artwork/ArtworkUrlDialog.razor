@namespace MediaEngine.Web.Components.Artwork
@inject IStringLocalizer<SharedStrings> L

<AppDialogShell Title="@L["ArtworkUrlDialog_ImportArtworkFromURL"].Value" Size="Small" OnClose="Cancel">
    <ChildContent>
        <div class="app-dialog-shell__pad app-dialog-shell__pad--flow">
            <AppTextField Label="@L["ArtworkUrlDialog_ImageURL"].Value" Value="@_url" ValueChanged="@((string? value) => _url = value ?? string.Empty)" />
        </div>
    </ChildContent>
    <FooterContent>
        <AppButton ButtonStyle="AppButtonStyle.Outlined" OnClick="Cancel">@L["Search_Cancel"]</AppButton>
        <AppButton ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(!ValidUrl)" OnClick="Import">@L["ArtworkUrlDialog_ImportImage"]</AppButton>
    </FooterContent>
</AppDialogShell>

@code {
    [CascadingParameter] private IAppDialogContext Dialog { get; set; } = default!;
    private string _url = string.Empty;
    private bool ValidUrl => Uri.TryCreate(_url.Trim(), UriKind.Absolute, out var uri) && uri.Scheme is "http" or "https";
    private void Cancel() => Dialog.Cancel();
    private void Import() { if (ValidUrl) Dialog.Close(AppDialogResult.Ok(_url.Trim())); }
}
