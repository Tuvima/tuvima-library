@namespace MediaEngine.Web.Components.Artwork
@using System.Globalization
@using MediaEngine.Contracts.Artwork
@using MediaEngine.Web.Models.ViewDTOs
@inject IEngineApiClient ApiClient
@implements IDisposable

<div class="artwork-asset-browser @(PickerMode ? "is-picker" : "is-library")">
    <AppDiscoveryFilterBar AriaLabel="Artwork filters"
                           SearchValue="@_search"
                           SearchChanged="SearchChangedValue"
                           SearchPlaceholder="Search titles, people, characters, universes, and IDs"
                           SearchAriaLabel="Search artwork library"
                           QuickFilterAriaLabel="@(PickerMode ? "Artwork suggestions" : "Artwork quick filters")"
                           AdvancedFilterAriaLabel="More artwork filters"
                           HasActiveAdvancedFilters="@HasActiveAdvancedFilters">
        <QuickFilters>
            @if (PickerMode)
            {
                @foreach (var option in PickerScopes)
                {
                    <AppNativeButton Type="button" role="tab" aria-selected="@(option.Value == _scope)" Class="@ScopeClass(option.Value)" OnClick="@(_ => SetScopeAsync(option.Value))">@option.Label</AppNativeButton>
                }
            }
            else
            {
                @foreach (var option in UsageQuickFilters)
                {
                    <AppNativeButton Type="button" role="tab" aria-selected="@(option.Value == _usage)" Class="@UsageClass(option.Value)" OnClick="@(_ => SetUsageAsync(option.Value))">@option.Label</AppNativeButton>
                }
            }
        </QuickFilters>
        <AdvancedFilters>
            <label><span>Related to</span><AppNativeSelect Value="@_entityType" OnChange="EntityTypeChangedAsync" aria-label="Filter by related entity type">@foreach (var option in EntityTypeOptions) { <option value="@option.Value">@option.Label</option> }</AppNativeSelect></label>
            <label><span>Media type</span><AppNativeSelect Value="@_mediaType" OnChange="MediaTypeChangedAsync" aria-label="Filter by media type">@foreach (var option in MediaTypeOptions) { <option value="@option.Value">@option.Label</option> }</AppNativeSelect></label>
            <label><span>Artwork role</span><AppNativeSelect Value="@_role" OnChange="RoleChangedAsync" aria-label="Filter by artwork role">@foreach (var option in RoleOptions) { <option value="@option.Value">@option.Label</option> }</AppNativeSelect></label>
            <label><span>Orientation</span><AppNativeSelect Value="@_aspect" OnChange="AspectChangedAsync" aria-label="Filter by image orientation">@foreach (var option in AspectOptions) { <option value="@option.Value">@option.Label</option> }</AppNativeSelect></label>
            <label><span>Source / provider</span><AppNativeSelect Value="@_source" OnChange="SourceChangedAsync" aria-label="Filter by source provider">@foreach (var option in SourceOptions) { <option value="@option.Value">@option.Label</option> }</AppNativeSelect></label>
            <label><span>Year</span><AppNativeInput Type="search" Value="@_year" OnInput="YearChanged" Placeholder="Any" AriaLabel="Filter artwork by year" /></label>
            @if (HasActiveFilters)
            {
                <AppNativeButton Type="button" Class="app-discovery-filter__clear" OnClick="ClearFiltersAsync">Clear all</AppNativeButton>
            }
        </AdvancedFilters>
    </AppDiscoveryFilterBar>

    <div class="artwork-asset-browser__body">
        <div class="artwork-asset-browser__results">
            <div class="artwork-asset-browser__results-toolbar">
                <div class="artwork-asset-browser__summary"><strong>@((_page?.Total ?? 0).ToString("N0"))</strong><span>result@((_page?.Total ?? 0) == 1 ? string.Empty : "s")</span></div>
                <label class="artwork-asset-browser__sort"><span>Sort by</span><AppNativeSelect Value="@_sort.ToString()" OnChange="SortChangedAsync" aria-label="Sort artwork">@foreach (var option in SortOptions) { <option value="@option.Value">@option.Label</option> }</AppNativeSelect></label>
            </div>
            @if (_loading && _page is null)
            {
                <AppPageState Kind="AppPageStateKind.Loading" Title="Searching artwork" />
            }
            else if (_page is null)
            {
                <AppErrorState Title="Artwork could not be loaded" Message="The Engine did not return the artwork library." Retry="LoadAsync" />
            }
            else if (_page.Items.Count == 0)
            {
                <AppPageState Kind="AppPageStateKind.Empty" Title="No images match" Message="Try clearing a filter or choosing All Artwork." />
            }
            else if (PickerMode)
            {
                <ArtworkJustifiedGallery TItem="ArtworkAssetDto" Items="@_page.Items"
                                         ItemKey="AssetKey" ImageUrl="AssetImageUrl" Width="AssetWidth" Height="AssetHeight"
                                         Title="AssetTitle" SupportingText="AssetFacts" IsSelected="IsSelectedAsset"
                                         IsPreferred="IsPreferredAsset" UseContain="ShouldContainAsset"
                                         MultiSelect="MultiSelect" Disabled="Disabled"
                                         OnSelect="SelectAssetAsync" AriaLabel="Choose artwork from library" />
                @if (_page.HasMore)
                {
                    <div class="artwork-asset-browser__more"><AppButton ButtonStyle="AppButtonStyle.Outlined" Disabled="@_loadingMore" OnClick="LoadMoreAsync">@(_loadingMore ? "Loading…" : "Load more")</AppButton></div>
                }
            }
            else
            {
                <main class="artwork-asset-browser__timeline" aria-label="Artwork timeline">
                    @foreach (var month in TimelineMonths)
                    {
                        <section class="artwork-asset-browser__month" aria-labelledby="@month.Id">
                            <h2 id="@month.Id">@month.Label</h2>
                            @foreach (var day in month.Days)
                            {
                                <section class="artwork-asset-browser__date-group" aria-labelledby="@day.Id">
                                    <h3 id="@day.Id">@day.Label</h3>
                                    <ArtworkJustifiedGallery TItem="ArtworkAssetDto"
                                                               Items="@day.Items"
                                                               ItemKey="AssetKey"
                                                               ImageUrl="AssetImageUrl"
                                                               Width="AssetWidth"
                                                               Height="AssetHeight"
                                                               Title="AssetTitle"
                                                               SupportingText="AssetFacts"
                                                               IsSelected="IsSelectedAsset"
                                                               IsPreferred="IsPreferredAsset"
                                                               UseContain="ShouldContainAsset"
                                                               OnSelect="SelectAssetAsync"
                                                               AriaLabel="@($"Artwork added {day.Label}")" />
                                </section>
                            }
                        </section>
                    }
                </main>
                @if (_page.HasMore)
                {
                    <div class="artwork-asset-browser__more"><AppButton ButtonStyle="AppButtonStyle.Outlined" Disabled="@_loadingMore" OnClick="LoadMoreAsync">@(_loadingMore ? "Loading…" : "Load more")</AppButton></div>
                }
            }
        </div>

    </div>
</div>

@if (_viewerAsset is not null)
{
    <MediaViewerShell Item="@ViewerItem" Capabilities="@ArtworkViewerCapabilities" HasPrevious="@CanViewPrevious" HasNext="@CanViewNext" OnClose="CloseViewer" OnPrevious="ViewPrevious" OnNext="ViewNext">
        <InfoContent>
            <dl>
                <div><dt>Dimensions</dt><dd>@Dimensions(_viewerAsset)</dd></div>
                <div><dt>Aspect</dt><dd>@_viewerAsset.Aspect</dd></div>
                <div><dt>Source</dt><dd>@(_viewerAsset.SourceProvider ?? "Library")</dd></div>
                <div><dt>Added</dt><dd>@(_viewerAsset.CreatedAt?.LocalDateTime.ToString("d") ?? "Not recorded")</dd></div>
                <div><dt>Used by</dt><dd>@_viewerAsset.LinkCount assignment@(_viewerAsset.LinkCount == 1 ? string.Empty : "s")</dd></div>
                <div><dt>Preferred uses</dt><dd>@_viewerAsset.PreferredLinkCount</dd></div>
            </dl>
            @if (_viewerAsset.Contexts.Count > 0) { <section class="artwork-asset-browser__viewer-context"><h3>Related to</h3>@foreach (var context in _viewerAsset.Contexts.Take(12)) { <div><strong>@context.EntityLabel</strong><span>@string.Join(" · ", new[] { context.Role, context.MediaType, context.Year }.Where(value => !string.IsNullOrWhiteSpace(value)))</span></div> }</section> }
        </InfoContent>
    </MediaViewerShell>
}

@code {
    private static readonly (string Label, ArtworkPickerScope Value)[] PickerScopes = [("Recommended", ArtworkPickerScope.Recommended), ("Related", ArtworkPickerScope.Related), ("All Artwork", ArtworkPickerScope.All)];
    private static readonly (string Label, ArtworkUsageFilter Value)[] UsageQuickFilters = [("All", ArtworkUsageFilter.All), ("In use", ArtworkUsageFilter.Linked), ("Preferred", ArtworkUsageFilter.Selected), ("Unused", ArtworkUsageFilter.Unlinked)];
    private static readonly (string Label, string Value)[] RoleOptions = [("All roles", ""), ("Primary", "Primary"), ("Background", "Background"), ("Portrait", "Portrait"), ("Logo", "Logo")];
    private static readonly (string Label, string Value)[] AspectOptions = [("All shapes", ""), ("Portrait", "Portrait"), ("Square", "Square"), ("Landscape", "Landscape"), ("Banner", "Banner"), ("Other", "UnsupportedRect")];
    private static readonly (string Label, string Value)[] EntityTypeOptions = [("Anything", ""), ("Titles", "Work"), ("People / actors", "Person"), ("Characters", "FictionalEntity"), ("Collections", "Collection"), ("Universes", "Universe")];
    private static readonly (string Label, string Value)[] MediaTypeOptions = [("Any", ""), ("Movies", "Movies"), ("TV", "TV"), ("Books", "Books"), ("Comics", "Comics"), ("Music", "Music"), ("Audiobooks", "Audiobooks")];
    private static readonly (string Label, string Value)[] SourceOptions = [("All sources", ""), ("TMDB", "tmdb"), ("Fanart.tv", "fanart_tv"), ("Wikidata", "wikidata"), ("Uploads", "user_upload"), ("URL imports", "url")];
    private static readonly (string Label, ArtworkAssetSort Value)[] SortOptions = [("Relevance", ArtworkAssetSort.Relevance), ("Newest added", ArtworkAssetSort.Newest), ("Recently updated", ArtworkAssetSort.RecentlyUpdated), ("Resolution", ArtworkAssetSort.Resolution)];

    [Parameter] public ArtworkAssetQuery InitialQuery { get; set; } = new();
    [Parameter] public bool PickerMode { get; set; }
    [Parameter] public EventCallback<ArtworkAssetDto?> SelectionChanged { get; set; }
    [Parameter] public bool MultiSelect { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public IReadOnlySet<Guid> SelectedIds { get; set; } = new HashSet<Guid>();
    [Parameter] public EventCallback<int> ResultsChanged { get; set; }
    [Parameter] public EventCallback<ArtworkAssetDto> ManageRequested { get; set; }

    private ArtworkAssetPageDto? _page;
    private Guid? _selectedAssetId;
    private ArtworkAssetDto? _viewerAsset;
    private string _search = string.Empty;
    private string _role = string.Empty;
    private string _aspect = string.Empty;
    private string _mediaType = string.Empty;
    private string _entityType = string.Empty;
    private string _source = string.Empty;
    private string _year = string.Empty;
    private ArtworkPickerScope _scope;
    private ArtworkUsageFilter _usage;
    private ArtworkAssetSort _sort;
    private bool _initialized;
    private bool _loading;
    private bool _loadingMore;
    private int _generation;
    private CancellationTokenSource? _searchCts;

    public ArtworkAssetDto? SelectedAsset => _page?.Items.FirstOrDefault(asset => asset.Id == _selectedAssetId);

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized) return;
        _initialized = true;
        _search = InitialQuery.Search ?? string.Empty;
        _role = InitialQuery.Roles?.FirstOrDefault() ?? string.Empty;
        _aspect = InitialQuery.Aspects?.FirstOrDefault() ?? string.Empty;
        _mediaType = InitialQuery.MediaTypes?.FirstOrDefault() ?? string.Empty;
        _entityType = InitialQuery.EntityTypes?.FirstOrDefault() ?? string.Empty;
        _source = InitialQuery.SourceProviders?.FirstOrDefault() ?? string.Empty;
        _year = InitialQuery.Years?.FirstOrDefault() ?? string.Empty;
        _scope = InitialQuery.PickerScope;
        _usage = InitialQuery.Usage;
        _sort = InitialQuery.Sort;
        await LoadAsync();
    }

    private ArtworkAssetQuery CurrentQuery(int offset = 0) => InitialQuery with
    {
        Search = string.IsNullOrWhiteSpace(_search) ? null : _search,
        Roles = string.IsNullOrWhiteSpace(_role) ? null : [_role],
        Aspects = string.IsNullOrWhiteSpace(_aspect) ? null : [_aspect],
        MediaTypes = string.IsNullOrWhiteSpace(_mediaType) ? null : [_mediaType],
        EntityTypes = string.IsNullOrWhiteSpace(_entityType) ? null : [_entityType],
        SourceProviders = string.IsNullOrWhiteSpace(_source) ? null : [_source],
        Years = string.IsNullOrWhiteSpace(_year) ? null : [_year.Trim()],
        PickerScope = _scope,
        Usage = _usage,
        Sort = _sort,
        Offset = offset,
    };

    private async Task LoadAsync()
    {
        var generation = ++_generation;
        _loading = true;
        var page = await ApiClient.GetArtworkAssetsAsync(CurrentQuery());
        if (generation != _generation) return;
        _page = page;
        _loading = false;
        await ResultsChanged.InvokeAsync(_page?.Total ?? 0);
        if (!MultiSelect && _selectedAssetId.HasValue && _page?.Items.All(asset => asset.Id != _selectedAssetId) == true)
        {
            _selectedAssetId = null;
            await SelectionChanged.InvokeAsync(null);
        }
    }

    private async Task LoadMoreAsync()
    {
        if (_page is null || !_page.HasMore || _loadingMore) return;
        _loadingMore = true;
        var current = _page;
        var next = await ApiClient.GetArtworkAssetsAsync(CurrentQuery(current.Items.Count));
        if (next is not null) _page = next with { Items = [.. current.Items, .. next.Items], Offset = 0 };
        _loadingMore = false;
    }

    private async Task SelectAssetAsync(ArtworkAssetDto asset)
    {
        _selectedAssetId = asset.Id;
        if (!PickerMode) _viewerAsset = asset;
        await SelectionChanged.InvokeAsync(asset);
    }

    private async Task SetScopeAsync(ArtworkPickerScope value) { if (_scope == value) return; _scope = value; await LoadAsync(); }
    private async Task RoleChangedAsync(ChangeEventArgs args) { _role = args.Value?.ToString() ?? string.Empty; await LoadAsync(); }
    private async Task AspectChangedAsync(ChangeEventArgs args) { _aspect = args.Value?.ToString() ?? string.Empty; await LoadAsync(); }
    private async Task MediaTypeChangedAsync(ChangeEventArgs args) { _mediaType = args.Value?.ToString() ?? string.Empty; await LoadAsync(); }
    private async Task EntityTypeChangedAsync(ChangeEventArgs args) { _entityType = args.Value?.ToString() ?? string.Empty; await LoadAsync(); }
    private async Task SourceChangedAsync(ChangeEventArgs args) { _source = args.Value?.ToString() ?? string.Empty; await LoadAsync(); }
    private Task SearchChangedValue(object? value) { SearchChanged(new ChangeEventArgs { Value = value }); return Task.CompletedTask; }
    private async Task SetUsageAsync(ArtworkUsageFilter usage) { _usage = usage; await LoadAsync(); }
    private async Task SortChangedAsync(ChangeEventArgs args) { if (Enum.TryParse<ArtworkAssetSort>(args.Value?.ToString(), out var sort)) _sort = sort; await LoadAsync(); }
    private void SearchChanged(ChangeEventArgs args) { _search = args.Value?.ToString() ?? string.Empty; _searchCts?.Cancel(); _searchCts?.Dispose(); _searchCts = new CancellationTokenSource(); _ = DebouncedSearchAsync(_searchCts.Token); }
    private void YearChanged(ChangeEventArgs args) { _year = args.Value?.ToString() ?? string.Empty; _searchCts?.Cancel(); _searchCts?.Dispose(); _searchCts = new CancellationTokenSource(); _ = DebouncedSearchAsync(_searchCts.Token); }
    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_role) || !string.IsNullOrWhiteSpace(_aspect) || !string.IsNullOrWhiteSpace(_mediaType) || !string.IsNullOrWhiteSpace(_entityType) || !string.IsNullOrWhiteSpace(_source) || !string.IsNullOrWhiteSpace(_year) || _usage != ArtworkUsageFilter.All;
    private bool HasActiveAdvancedFilters => !string.IsNullOrWhiteSpace(_role) || !string.IsNullOrWhiteSpace(_aspect) || !string.IsNullOrWhiteSpace(_mediaType) || !string.IsNullOrWhiteSpace(_entityType) || !string.IsNullOrWhiteSpace(_source) || !string.IsNullOrWhiteSpace(_year);
    private async Task ClearFiltersAsync() { _role = string.Empty; _aspect = string.Empty; _mediaType = string.Empty; _entityType = string.Empty; _source = string.Empty; _year = string.Empty; _usage = ArtworkUsageFilter.All; await LoadAsync(); }
    private async Task DebouncedSearchAsync(CancellationToken ct) { try { await Task.Delay(250, ct); await InvokeAsync(LoadAsync); } catch (OperationCanceledException) { } }
    private string ScopeClass(ArtworkPickerScope value) => $"app-discovery-filter__tab{(_scope == value ? " is-active" : string.Empty)}";
    private string UsageClass(ArtworkUsageFilter value) => $"app-discovery-filter__tab{(_usage == value ? " is-active" : string.Empty)}";
    private static string Shape(ArtworkAssetDto asset) => asset.Aspect.ToLowerInvariant() switch { "portrait" => "portrait", "square" => "square", "banner" => "banner", "unsupportedrect" => "other", _ => "landscape" };
    private IReadOnlyList<ArtworkMonthGroup> TimelineMonths
    {
        get
        {
            var items = _page?.Items ?? [];
            var groups = items.Where(asset => asset.CreatedAt.HasValue)
                .OrderByDescending(asset => asset.CreatedAt)
                .GroupBy(asset => (asset.CreatedAt!.Value.ToLocalTime().Year, asset.CreatedAt.Value.ToLocalTime().Month))
                .Select(month =>
                {
                    var first = month.First().CreatedAt!.Value.ToLocalTime();
                    var days = month.GroupBy(asset => DateOnly.FromDateTime(asset.CreatedAt!.Value.LocalDateTime))
                        .OrderByDescending(day => day.Key)
                        .Select(day => new ArtworkDayGroup(
                            $"artwork-day-{day.Key:yyyy-MM-dd}",
                            day.Key.ToDateTime(TimeOnly.MinValue).ToString("dddd, MMM d", CultureInfo.CurrentCulture),
                            day.ToList()))
                        .ToList();
                    return new ArtworkMonthGroup(
                        $"artwork-month-{first:yyyy-MM}",
                        first.ToString("MMMM yyyy", CultureInfo.CurrentCulture),
                        days);
                })
                .ToList();
            var undated = items.Where(asset => !asset.CreatedAt.HasValue).ToList();
            if (undated.Count > 0)
                groups.Add(new ArtworkMonthGroup("artwork-month-undated", "Date not recorded", [new ArtworkDayGroup("artwork-day-undated", "Undated artwork", undated)]));
            return groups;
        }
    }
    private static string AssetTitle(ArtworkAssetDto asset) => asset.DisplayContext?.EntityLabel ?? asset.Contexts.FirstOrDefault()?.EntityLabel ?? "Library artwork";
    private static string AssetFacts(ArtworkAssetDto asset) { var context = asset.DisplayContext ?? asset.Contexts.FirstOrDefault(); return string.Join(" · ", new[] { context?.Role, context?.MediaType, context?.Year, asset.SourceProvider }.Where(value => !string.IsNullOrWhiteSpace(value))); }
    private static string AssetKey(ArtworkAssetDto asset) => asset.Id.ToString("D");
    private static string AssetImageUrl(ArtworkAssetDto asset) => asset.ThumbnailUrl;
    private static int? AssetWidth(ArtworkAssetDto asset) => asset.Width ?? Shape(asset) switch { "portrait" => 2, "square" => 1, "banner" => 3, "other" => 5, _ => 16 };
    private static int? AssetHeight(ArtworkAssetDto asset) => asset.Height ?? Shape(asset) switch { "portrait" => 3, "square" => 1, "banner" => 1, "other" => 4, _ => 10 };
    private bool IsSelectedAsset(ArtworkAssetDto asset) => MultiSelect ? SelectedIds.Contains(asset.Id) : asset.Id == _selectedAssetId;
    private static bool IsPreferredAsset(ArtworkAssetDto asset) => asset.IsPreferredForTarget;
    private static bool ShouldContainAsset(ArtworkAssetDto asset)
    {
        if (asset.Aspect.Equals("Banner", StringComparison.OrdinalIgnoreCase)) return true;
        var role = asset.DisplayContext?.Role ?? asset.Contexts.FirstOrDefault()?.Role ?? string.Empty;
        return role.Contains("logo", StringComparison.OrdinalIgnoreCase)
            || role.Contains("icon", StringComparison.OrdinalIgnoreCase)
            || role.Contains("title", StringComparison.OrdinalIgnoreCase)
            || role.Contains("wordmark", StringComparison.OrdinalIgnoreCase)
            || role.Contains("transparent", StringComparison.OrdinalIgnoreCase);
    }
    private static string Dimensions(ArtworkAssetDto asset) => asset.Width.HasValue && asset.Height.HasValue ? $"{asset.Width} × {asset.Height}" : "Not recorded";
    private int ViewerIndex => _viewerAsset is null ? -1 : (_page?.Items.ToList().FindIndex(asset => asset.Id == _viewerAsset.Id) ?? -1);
    private bool CanViewPrevious => ViewerIndex > 0;
    private bool CanViewNext => ViewerIndex >= 0 && ViewerIndex < (_page?.Items.Count ?? 0) - 1;
    private MediaViewerItem ViewerItem => new(_viewerAsset!.Id.ToString("D"), MediaViewerKind.Image, AssetTitle(_viewerAsset), AssetFacts(_viewerAsset), _viewerAsset.ContentUrl, _viewerAsset.ContentUrl, PositionLabel: ViewerIndex >= 0 ? $"{ViewerIndex + 1} of {_page?.Items.Count ?? 0}" : null, AltText: AssetTitle(_viewerAsset));
    private MediaViewerCapabilities ArtworkViewerCapabilities => new(CanDownload: true, CanShowInfo: true, CanZoom: true, CanSlideshow: CanViewNext);
    private void CloseViewer() => _viewerAsset = null;
    private void ViewPrevious() { if (CanViewPrevious) _viewerAsset = _page!.Items[ViewerIndex - 1]; }
    private void ViewNext() { if (CanViewNext) _viewerAsset = _page!.Items[ViewerIndex + 1]; }
    public void Dispose() { _searchCts?.Cancel(); _searchCts?.Dispose(); }
    private sealed record ArtworkMonthGroup(string Id, string Label, IReadOnlyList<ArtworkDayGroup> Days);
    private sealed record ArtworkDayGroup(string Id, string Label, IReadOnlyList<ArtworkAssetDto> Items);
}
