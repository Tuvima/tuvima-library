@namespace MediaEngine.Web.Components.Artwork
@using MediaEngine.Contracts.Artwork

<ArtworkWorkspace Item="@Item" ActiveProfileId="@ActiveProfileId" InitialAssetId="@InitialAssetId" InitialRole="@InitialRole" OnClose="HandleClose" />

@code {
    [CascadingParameter] private IAppDialogContext DialogContext { get; set; } = default!;
    [Parameter, EditorRequired] public ArtworkLibraryItemDto Item { get; set; } = default!;
    [Parameter] public Guid? ActiveProfileId { get; set; }
    [Parameter] public Guid? InitialAssetId { get; set; }
    [Parameter] public string? InitialRole { get; set; }

    private Task HandleClose(bool changed)
    {
        if (changed) DialogContext.Close(AppDialogResult.Ok(true));
        else DialogContext.Cancel();
        return Task.CompletedTask;
    }
}
