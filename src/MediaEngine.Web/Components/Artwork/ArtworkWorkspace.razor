@namespace MediaEngine.Web.Components.Artwork
@using MediaEngine.Contracts.Artwork
@using MediaEngine.Web.Models.ViewDTOs
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IEngineApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="artwork-workspace-core">
    @if (ShowClose)
    {
        <header class="artwork-workspace-core__header">
            <h2>@ActiveItem.DisplayTitle</h2>
            <AppIconButton Icon="@Icons.Material.Outlined.Close" Tooltip="Close artwork workspace" AriaLabel="Close artwork workspace" OnClick="CloseAsync" />
        </header>
    }

    @if (_hierarchyItems.Count > 0)
    {
        <nav class="artwork-workspace-core__hierarchy" aria-label="Universe artwork hierarchy">
            @foreach (var section in UniverseSections)
            {
                var count = section.Value == "Overview" ? 1 : _hierarchyItems.Count(item => string.Equals(item.GroupKind, section.Value, StringComparison.OrdinalIgnoreCase));
                <AppNativeButton Type="button" Class="@HierarchyClass(section.Value)" Disabled="@(count == 0)" OnClick="@(() => SelectHierarchySectionAsync(section.Value))">@section.Label@if (section.Value != "Overview") { <span>@count</span> }</AppNativeButton>
            }
        </nav>
        @if (!string.Equals(_hierarchySection, "Overview", StringComparison.OrdinalIgnoreCase))
        {
            <div class="artwork-workspace-core__entities" aria-label="@_hierarchySection">
                @foreach (var entity in FilteredHierarchyItems)
                {
                    <AppNativeButton Type="button" Class="@(entity.EntityId == ActiveItem.EntityId ? "is-active" : string.Empty)" OnClick="@(() => SelectHierarchyEntityAsync(entity))">
                        <span>@if (!string.IsNullOrWhiteSpace(entity.ImageUrl)) { <img src="@ThumbnailUrl(entity.ImageUrl)" alt="" loading="lazy" decoding="async" sizes="64px" data-image-display="artwork-hierarchy-thumbnail" /> } else { <MudIcon Icon="@HierarchyPlaceholderIcon(entity)" /> }</span>
                        <strong>@entity.DisplayTitle</strong>
                    </AppNativeButton>
                }
            </div>
        }
    }

    <div class="artwork-workspace-core__role-overview" role="tablist" aria-label="Artwork roles">
        @foreach (var role in AvailableRoles)
        {
            var preferred = PreferredVariant(role);
            <AppNativeButton Type="button" Class="@RoleCardClass(role)" role="tab" aria-selected="@(IsActiveRole(role) ? "true" : "false")" Disabled="@_busy" OnClick="@(() => SelectRole(role))">
                <span class="artwork-workspace-core__role-preview">
                    @if (preferred is not null)
                    {
                        <img src="@ThumbnailUrl(preferred.ThumbnailUrl)" alt="" loading="lazy" decoding="async" sizes="128px" data-image-display="artwork-role-card" />
                    }
                    else if (!string.IsNullOrWhiteSpace(LegacyRoleUrlFor(role)))
                    {
                        <img src="@ThumbnailUrl(LegacyRoleUrlFor(role))" alt="" loading="lazy" decoding="async" sizes="128px" data-image-display="artwork-role-card" />
                    }
                    else if (role.SupportsAutomatic && ActiveItem.PreviewItems.Count > 0)
                    {
                        <MediaArtworkGroupPreview Items="@PreviewItems" TotalCount="@ActiveItem.OwnedWorkCount" Layout="MediaArtworkGroupPreviewLayout.Cluster" ShowOverflowCount="false" AriaLabel="@($"Automatic artwork for {ActiveItem.DisplayTitle}")" />
                    }
                    else
                    {
                        <MudIcon Icon="@role.Icon" />
                    }
                </span>
                <span class="artwork-workspace-core__role-copy"><strong>@role.Label</strong><span>@RoleState(role)</span><small>@VariantCount(role) variant@(VariantCount(role) == 1 ? string.Empty : "s")</small></span>
                <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Class="artwork-workspace-core__role-chevron" />
            </AppNativeButton>
        }
    </div>

    <div class="artwork-workspace-core__layout">
        <div class="artwork-workspace-core__gallery">
            <section @ref="_preview" class="artwork-workspace-core__preview artwork-workspace-core__preview--@_role.ToLowerInvariant()" aria-busy="@_busy">
                <div class="artwork-workspace-core__image-frame">
                <div class="artwork-workspace-core__image">
                @if (SelectedVariant is not null)
                {
                    <img src="@PreviewUrl(SelectedVariant.ContentUrl)" srcset="@PreviewSrcSet(SelectedVariant.ContentUrl)" sizes="(max-width: 900px) 92vw, 62vw" alt="@($"{ActiveRole.Label} for {ActiveItem.DisplayTitle}")" decoding="async" data-image-display="artwork-workspace-preview" />

                }
                else if ((_role == "Primary" || _role == "Portrait") && ActiveItem.ResolutionMode == ArtworkResolutionMode.Explicit && !string.IsNullOrWhiteSpace(ActiveItem.ImageUrl))
                {
                    <img src="@PreviewUrl(ActiveItem.ImageUrl)" srcset="@PreviewSrcSet(ActiveItem.ImageUrl)" sizes="(max-width: 900px) 92vw, 62vw" alt="@($"Primary artwork for {ActiveItem.DisplayTitle}")" decoding="async" data-image-display="artwork-workspace-preview" />
                }
                else if (_role == "Primary" && ActiveItem.PreviewItems.Count > 0)
                {
                    <MediaArtworkGroupPreview Items="@PreviewItems" TotalCount="@ActiveItem.OwnedWorkCount" AriaLabel="@($"Automatic artwork for {ActiveItem.DisplayTitle}")" Layout="MediaArtworkGroupPreviewLayout.Adaptive" ShowOverflowCount="false" />
                }
                else if (!string.IsNullOrWhiteSpace(LegacyRoleUrl))
                {
                    <img src="@PreviewUrl(LegacyRoleUrl)" srcset="@PreviewSrcSet(LegacyRoleUrl)" sizes="(max-width: 900px) 92vw, 62vw" alt="@($"{ActiveRole.Label} for {ActiveItem.DisplayTitle}")" decoding="async" data-image-display="artwork-workspace-preview" />
                }
                else
                {
                    <div class="artwork-workspace-core__empty"><MudIcon Icon="@EmptyArtworkIcon" /><span>No @ActiveRole.Label.ToLowerInvariant() selected</span></div>
                }
                </div>
                @if (SelectedVariant is not null)
                {
                    <div class="artwork-workspace-core__preview-controls">
                        <AppIconButton Icon="@Icons.Material.Outlined.ZoomIn" Tooltip="Magnify artwork" AriaLabel="Magnify artwork" OnClick="OpenLightbox" />
                    </div>
                }
                </div>
                @if (_busy) { <span class="artwork-workspace-core__upload-status" role="status">Updating artwork…</span> }
            </section>

            @if (RoleVariants.Count > 0)
            {
                <div class="artwork-workspace-core__variants" aria-label="Artwork variants">
                    @foreach (var variant in RoleVariants)
                    {
                        <AppNativeButton Type="button" Class="@($"artwork-workspace-core__variant{(variant.ArtworkAssetId == SelectedVariant?.ArtworkAssetId ? " is-active" : string.Empty)}")" Disabled="@_busy" aria-pressed="@(variant.ArtworkAssetId == SelectedVariant?.ArtworkAssetId ? "true" : "false")" OnClick="(() => SelectVariant(variant.ArtworkAssetId))" AriaLabel="Select artwork variant">
                            <img src="@ThumbnailUrl(variant.ThumbnailUrl)" alt="" loading="lazy" decoding="async" sizes="112px" data-image-display="artwork-variant-thumbnail" />
                            @if (variant.IsPreferred) { <span>Preferred</span> }
                        </AppNativeButton>
                    }
                </div>
            }
        </div>

        <aside class="artwork-workspace-core__details">
            <h3>@ActiveRole.Label</h3>
            @if (!AllowEdit)
            {
                <dl class="artwork-workspace-core__metadata">
                    <div><dt>Artwork role</dt><dd>@ActiveRole.Label</dd></div><div><dt>Source</dt><dd>@(SelectedVariant?.SourceProvider ?? "Library")</dd></div>
                    <div><dt>Dimensions</dt><dd>@Dimensions</dd></div><div><dt>Aspect</dt><dd>@(SelectedVariant?.Aspect ?? "—")</dd></div>
                    <div><dt>Preferred</dt><dd>@(SelectedVariant?.IsPreferred == true ? "Yes" : "No")</dd></div>
                </dl>
            }
            else
            {
                <AppOverflowMenu Label="Add Artwork" Icon="@Icons.Material.Outlined.Add" EndIcon="@Icons.Material.Outlined.ExpandMore" Class="artwork-workspace-core__add" Disabled="@_busy" MatchAnchorWidth="true">
                    <AppMenuItem Label="Upload from device" Icon="@Icons.Material.Outlined.FileUpload" OnClick="ChooseUploadAsync" />
                    <AppMenuItem Label="From URL" Icon="@Icons.Material.Outlined.Link" OnClick="OpenUrlDialogAsync" />
                    <AppMenuItem Label="Choose from Library" Icon="@Icons.Material.Outlined.PhotoLibrary" OnClick="OpenPickerAsync" />
                    <AppMenuItem Label="@ProviderArtworkLabel" Icon="@Icons.Material.Outlined.CloudDownload" OnClick="OpenProviderPickerAsync" />
                </AppOverflowMenu>
                <InputFile @ref="_uploadInput" OnChange="UploadAsync" accept="image/jpeg,image/png" disabled="@_busy" hidden aria-label="Upload artwork" />
                <p class="artwork-workspace-core__hint">Drag an image anywhere into the preview to upload it automatically.</p>
                <div class="artwork-workspace-core__actions">
                    @if (SelectedVariant is not null)
                    {
                        <AppButton ButtonStyle="AppButtonStyle.Outlined" StartIcon="@Icons.Material.Outlined.StarOutline" Disabled="@(_busy || SelectedVariant.IsPreferred)" OnClick="SetPreferredAsync">@(SelectedVariant.IsPreferred ? "Preferred" : "Set Preferred")</AppButton>
                        @if (_deleteLinkId == SelectedVariant.LinkId)
                        {
                            <div class="artwork-workspace-core__delete-confirm" role="group" aria-label="Confirm artwork deletion">
                                <span>Delete this variant?</span>
                                <AppIconButton Class="artwork-confirm-action" Tone="AppUiTone.Success" Icon="@Icons.Material.Outlined.Check" Tooltip="Confirm deletion" AriaLabel="Confirm deletion" Disabled="@_busy" OnClick="RemoveAsync" />
                                <AppIconButton Class="artwork-cancel-action" Tone="AppUiTone.Error" Icon="@Icons.Material.Outlined.Close" Tooltip="Cancel deletion" AriaLabel="Cancel deletion" Disabled="@_busy" OnClick="CancelDelete" />
                            </div>
                        }
                        else
                        {
                            <AppButton ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Error" StartIcon="@Icons.Material.Outlined.DeleteOutline" Disabled="@_busy" OnClick="BeginDelete">Delete</AppButton>
                        }
                    }
                </div>
            }
            @if (AllowEdit && SelectedVariant is not null)
            {
                <dl class="artwork-workspace-core__metadata">
                    <div><dt>Dimensions</dt><dd>@Dimensions</dd></div>
                    <div><dt>Source</dt><dd>@(SelectedVariant.SourceProvider ?? "Library")</dd></div>
                </dl>
            }
        </aside>
    </div>
    @if (_lightbox && SelectedVariant is not null)
    {
        <MediaViewerShell Item="@ArtworkViewerItem" Capabilities="@ArtworkViewerCapabilities" HasPrevious="@CanViewPrevious" HasNext="@CanViewNext" OnClose="CloseLightbox" OnPrevious="ViewPrevious" OnNext="ViewNext">
            <ContextActions>
                @if (AllowEdit && !SelectedVariant.IsPreferred) { <AppButton ButtonStyle="AppButtonStyle.Text" StartIcon="@Icons.Material.Outlined.StarOutline" OnClick="SetPreferredAsync">Set preferred</AppButton> }
            </ContextActions>
            <InfoContent>
                <dl class="artwork-workspace-core__metadata">
                    <div><dt>Entity</dt><dd>@ActiveItem.DisplayTitle</dd></div>
                    <div><dt>Role</dt><dd>@ActiveRole.Label</dd></div>
                    <div><dt>Dimensions</dt><dd>@Dimensions</dd></div>
                    <div><dt>Aspect</dt><dd>@SelectedVariant.Aspect</dd></div>
                    <div><dt>Source</dt><dd>@(SelectedVariant.SourceProvider ?? "Library")</dd></div>
                    <div><dt>Preferred</dt><dd>@(SelectedVariant.IsPreferred ? "Yes" : "No")</dd></div>
                    <div><dt>User override</dt><dd>@(SelectedVariant.IsUserOverride ? "Yes" : "No")</dd></div>
                </dl>
            </InfoContent>
        </MediaViewerShell>
    }
</div>

@code {
    private const long MaximumUploadBytes = 10L * 1024L * 1024L;
    private static readonly (string Value, string Label)[] UniverseSections = [("Overview", "Overview"), ("Character", "Characters"), ("Location", "Places"), ("Organization", "Organizations"), ("Event", "Events"), ("Object", "Objects")];
    [Parameter, EditorRequired] public ArtworkLibraryItemDto Item { get; set; } = default!;
    [Parameter] public Guid? ActiveProfileId { get; set; }
    [Parameter] public EventCallback<bool> OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public bool AllowEdit { get; set; } = true;
    [Parameter] public bool ShowClose { get; set; } = true;
    [Parameter] public Guid? ProviderRefreshEntityId { get; set; }
    [Parameter] public string? ProviderRefreshScopeId { get; set; }
    [Parameter] public Guid? InitialAssetId { get; set; }
    [Parameter] public string? InitialRole { get; set; }
    private ArtworkEntityWorkspaceDto? _workspace; private ArtworkLibraryItemDto? _activeHierarchyItem; private IReadOnlyList<ArtworkLibraryItemDto> _hierarchyItems = []; private Guid? _selectedAssetId; private string _role = "Primary"; private string? _sourceAssetType; private string _url = string.Empty; private string _hierarchySection = "Overview"; private bool _busy; private bool _lightbox; private bool _changed;
    private ArtworkLibraryItemDto ActiveItem => _activeHierarchyItem ?? Item;
    private IReadOnlyList<ArtworkLibraryItemDto> FilteredHierarchyItems => _hierarchyItems.Where(item => string.Equals(item.GroupKind, _hierarchySection, StringComparison.OrdinalIgnoreCase)).ToList();
    private IReadOnlyList<ArtworkRolePresentation> AvailableRoles => ArtworkRolePresentationResolver.Resolve(_workspace, ActiveItem);
    private ArtworkRolePresentation ActiveRole => AvailableRoles.FirstOrDefault(role => MatchesRole(role, _role, _sourceAssetType)) ?? AvailableRoles.First();
    private IReadOnlyList<ArtworkEntityVariantDto> RoleVariants => VariantsFor(ActiveRole);
    private ArtworkEntityVariantDto? SelectedVariant => RoleVariants.FirstOrDefault(variant => variant.ArtworkAssetId == _selectedAssetId) ?? RoleVariants.FirstOrDefault(variant => variant.IsPreferred) ?? RoleVariants.FirstOrDefault();
    private int ViewerVariantIndex => SelectedVariant is null ? -1 : RoleVariants.ToList().FindIndex(variant => variant.ArtworkAssetId == SelectedVariant.ArtworkAssetId);
    private bool CanViewPrevious => ViewerVariantIndex > 0;
    private bool CanViewNext => ViewerVariantIndex >= 0 && ViewerVariantIndex < RoleVariants.Count - 1;
    private MediaViewerItem ArtworkViewerItem => new(SelectedVariant!.ArtworkAssetId.ToString("D"), MediaViewerKind.Image, ActiveItem.DisplayTitle, $"{ActiveRole.Label} · {SelectedVariant.SourceProvider ?? "Library"}", SelectedVariant.ContentUrl, SelectedVariant.ContentUrl, PositionLabel: ViewerVariantIndex >= 0 ? $"{ViewerVariantIndex + 1} of {RoleVariants.Count}" : null, AltText: $"{ActiveRole.Label} for {ActiveItem.DisplayTitle}");
    private static readonly MediaViewerCapabilities ArtworkViewerCapabilities = new(CanDownload: true, CanShowInfo: true, CanZoom: true);
    private string? LegacyRoleUrl => LegacyRoleUrlFor(ActiveRole);
    private static string ThumbnailUrl(string? url) => MediaTileArtworkUrl.Sized(url, "s") ?? url ?? string.Empty;
    private static string PreviewUrl(string? url) => MediaTileArtworkUrl.Sized(url, "l") ?? url ?? string.Empty;
    private static string? PreviewSrcSet(string? url) => MediaTileArtworkUrl.SrcSet(
        MediaTileArtworkUrl.Sized(url, "s"),
        MediaTileArtworkUrl.Sized(url, "m"),
        MediaTileArtworkUrl.Sized(url, "l"));
    private string Dimensions => SelectedVariant is { Width: not null, Height: not null } variant ? $"{variant.Width} × {variant.Height}" : "—";
    private string EmptyArtworkIcon => _role == "Portrait" && string.Equals(ActiveItem.GroupKind, "Character", StringComparison.OrdinalIgnoreCase)
        ? Icons.Material.Outlined.PersonOutline
        : _role == "Primary" && string.Equals(ActiveItem.GroupKind, "Universe", StringComparison.OrdinalIgnoreCase)
            ? Icons.Material.Outlined.Public
            : ActiveRole.Icon;
    private string PrimaryStatus => SelectedVariant is not null && ActiveItem.PreviewItems.Count > 0 ? "Explicit artwork is selected. The automatic owned-title composition remains available as a fallback." : ActiveItem.PreviewItems.Count > 0 ? "Automatic artwork · built from owned titles in series order." : "No automatic group artwork is available.";
    private bool CanRefreshProvider => string.Equals(ActiveItem.EntityType, "Work", StringComparison.OrdinalIgnoreCase)
        && !string.IsNullOrWhiteSpace(ResolvedProviderRefreshScope);
    private string ProviderArtworkLabel => ActiveItem.MediaType?.ToLowerInvariant() switch { "comics" => "From Comic Vine", "movies" => "From TMDB", "tv" => "From matched TV provider", _ => "From metadata provider" };
    private string? ResolvedProviderRefreshScope => ProviderRefreshScopeId ?? ActiveItem.MediaType?.Trim().ToLowerInvariant() switch
    {
        "tv" or "tv show" => "series",
        "music" or "album" => "album",
        "movie" or "movies" or "book" or "books" or "audiobook" or "audiobooks" or "comic" or "comics" => "item",
        _ => null,
    };
    protected override async Task OnInitializedAsync() { if (string.Equals(Item.GroupKind, "Universe", StringComparison.OrdinalIgnoreCase)) _hierarchyItems = await ApiClient.GetUniverseArtworkHierarchyAsync(Item.EntityId); await ReloadAsync(preserveSelection: false); }
    private async Task ReloadAsync(bool preserveSelection = true, Guid? selectAssetId = null)
    {
        CancelDelete();
        var previousRole = preserveSelection ? (_role, _sourceAssetType) : (InitialRole ?? string.Empty, (string?)null);
        var previousAsset = selectAssetId ?? (preserveSelection ? _selectedAssetId : InitialAssetId);
        _workspace = await ApiClient.GetEntityArtworkAsync(ActiveItem.EntityType, ActiveItem.EntityId, ActiveItem.MediaType, ActiveItem.GroupKind, ActiveItem.AssetTypes);
        if (AvailableRoles.Count == 0) return;
        var role = AvailableRoles.FirstOrDefault(candidate => MatchesRole(candidate, previousRole.Item1, previousRole.Item2))
            ?? AvailableRoles.FirstOrDefault(candidate => candidate.IsDefault)
            ?? AvailableRoles.First();
        _role = role.Role;
        _sourceAssetType = role.SourceAssetType;
        var variants = VariantsFor(role);
        _selectedAssetId = variants.FirstOrDefault(variant => variant.ArtworkAssetId == previousAsset)?.ArtworkAssetId
            ?? variants.FirstOrDefault(variant => variant.IsPreferred)?.ArtworkAssetId
            ?? variants.FirstOrDefault()?.ArtworkAssetId;
    }
    private string HierarchyClass(string section) => $"artwork-workspace-core__hierarchy-item{(string.Equals(_hierarchySection, section, StringComparison.OrdinalIgnoreCase) ? " is-active" : string.Empty)}";
    private async Task SelectHierarchySectionAsync(string section) { _hierarchySection = section; _activeHierarchyItem = null; if (!string.Equals(section, "Overview", StringComparison.OrdinalIgnoreCase) && FilteredHierarchyItems.FirstOrDefault() is { } first) await SelectHierarchyEntityAsync(first); else await ReloadAsync(preserveSelection: false); }
    private async Task SelectHierarchyEntityAsync(ArtworkLibraryItemDto entity) { _activeHierarchyItem = entity; await ReloadAsync(preserveSelection: false); }
    private static string HierarchyPlaceholderIcon(ArtworkLibraryItemDto entity) => entity.GroupKind switch { "Character" => Icons.Material.Outlined.PersonOutline, "Location" => Icons.Material.Outlined.Place, "Organization" => Icons.Material.Outlined.AccountBalance, "Event" => Icons.Material.Outlined.Event, _ => Icons.Material.Outlined.Category };
    private void SelectRole(ArtworkRolePresentation role) { CancelDelete(); _role = role.Role; _sourceAssetType = role.SourceAssetType; var variants = VariantsFor(role); _selectedAssetId = variants.FirstOrDefault(variant => variant.IsPreferred)?.ArtworkAssetId ?? variants.FirstOrDefault()?.ArtworkAssetId; }
    private ElementReference _preview;
    private Guid? _deleteLinkId;
    private void BeginDelete() => _deleteLinkId = SelectedVariant?.LinkId;
    private void CancelDelete() => _deleteLinkId = null;
    private void SelectVariant(Guid assetId) { CancelDelete(); _selectedAssetId = assetId; }
    private InputFile? _uploadInput;
    private IJSObjectReference? _previewModule;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!AllowEdit || _uploadInput?.Element is not { } input) return;
        _previewModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/artwork-preview.js");
        await _previewModule.InvokeVoidAsync("connect", _preview, input);
    }
    private async Task ChooseUploadAsync()
    {
        if (_previewModule is not null && _uploadInput?.Element is { } input)
            await _previewModule.InvokeVoidAsync("choose", input);
    }
    private async Task OpenUrlDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<ArtworkUrlDialog>("From URL", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        if (await dialog.Result is { Canceled: false, Data: string url }) { _url = url; await AddUrlAsync(); }
    }
    public async ValueTask DisposeAsync()
    {
        if (_previewModule is null) return;
        try { await _previewModule.InvokeVoidAsync("disconnect", _preview); await _previewModule.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
    private async Task UploadAsync(InputFileChangeEventArgs args) { if (_busy) return; var file = args.File; if (file.ContentType is not ("image/jpeg" or "image/png")) { Snackbar.Add("Choose a JPEG or PNG image.", Severity.Warning); return; } if (file.Size > MaximumUploadBytes) { Snackbar.Add("Artwork must be 10 MB or smaller.", Severity.Warning); return; } _busy = true; try { await using var stream = file.OpenReadStream(MaximumUploadBytes); var result = await ApiClient.UploadCanonicalArtworkAsync(ActiveItem.EntityType, ActiveItem.EntityId, _role, stream, file.Name, ActiveItem.DisplayTitle, ActiveItem.MediaType, ActiveItem.Year, _sourceAssetType); if (result is null) { Snackbar.Add(ApiClient.LastError ?? "Artwork could not be uploaded.", Severity.Error); return; } _changed = true; await ReloadAsync(selectAssetId: result.Id); await OnChanged.InvokeAsync(); Snackbar.Add($"{ActiveRole.Label} artwork updated.", Severity.Success); } finally { _busy = false; } }
    private async Task AddUrlAsync() { _busy = true; try { var result = await ApiClient.AddArtworkFromUrlAsync(ActiveItem.EntityType, ActiveItem.EntityId, new ArtworkFromUrlRequest(_url, _role, Preferred: true, EntityLabel: ActiveItem.DisplayTitle, MediaType: ActiveItem.MediaType, Year: ActiveItem.Year, SourceAssetType: _sourceAssetType)); if (result is null) { Snackbar.Add(ApiClient.LastError ?? "Artwork could not be added from that URL.", Severity.Error); return; } _changed = true; _url = string.Empty; await ReloadAsync(selectAssetId: result.Id); await OnChanged.InvokeAsync(); Snackbar.Add($"{ActiveRole.Label} artwork added.", Severity.Success); } finally { _busy = false; } }
    private Task OpenPickerAsync() => OpenArtworkPickerAsync(false);
    private Task OpenProviderPickerAsync() => OpenArtworkPickerAsync(true);
    private async Task OpenArtworkPickerAsync(bool fromProviders)
    {
        var query = new ArtworkAssetQuery(
            TargetEntityType: ActiveItem.EntityType,
            TargetEntityId: ActiveItem.EntityId,
            TargetRole: _role,
            TargetSourceAssetType: _sourceAssetType,
            PickerScope: ArtworkPickerScope.Recommended,
            Limit: 48);
        var dialog = await DialogService.ShowAsync<ArtworkAssetPickerDialog>(string.Empty,
            new DialogParameters<ArtworkAssetPickerDialog>
            {
                { component => component.Query, query },
                { component => component.TargetItem, ActiveItem },
                { component => component.FromProviders, fromProviders },
                { component => component.ProviderEntityId, ProviderRefreshEntityId ?? ActiveItem.EntityId },
                { component => component.ProviderScope, CanRefreshProvider ? ResolvedProviderRefreshScope : null },
                { component => component.TargetSummary, $"{ActiveItem.DisplayTitle} > {ActiveRole.Label}" },
            },
            new DialogOptions { NoHeader = true, FullWidth = true, MaxWidth = MaxWidth.Large, Position = DialogPosition.Center, BackdropClick = false, CloseOnEscapeKey = true });
        if (await dialog.Result is { Canceled: false, Data: List<Guid> added } && added.Count > 0)
        {
            _changed = true;
            await ReloadAsync(selectAssetId: added[0]);
            await OnChanged.InvokeAsync();
            Snackbar.Add($"Added {added.Count} artwork variant(s).", Severity.Success);
        }
    }
    private async Task ChooseAssetAsync(ArtworkAssetDto asset) { _busy = true; try { var linked = await ApiClient.LinkArtworkAssetAsync(ActiveItem.EntityType, ActiveItem.EntityId, new ArtworkLinkRequest(asset.Id, _role, Preferred: true, EntityLabel: ActiveItem.DisplayTitle, MediaType: ActiveItem.MediaType, Year: ActiveItem.Year, SourceAssetType: _sourceAssetType)); if (linked is null) { Snackbar.Add(ApiClient.LastError ?? "Artwork could not be linked.", Severity.Error); return; } _changed = true; await ReloadAsync(selectAssetId: asset.Id); await OnChanged.InvokeAsync(); Snackbar.Add("Existing artwork linked without copying the image.", Severity.Success); } finally { _busy = false; } }
    private async Task SetPreferredAsync() { if (SelectedVariant is null || SelectedVariant.IsPreferred) return; _busy = true; try { var assetId = SelectedVariant.ArtworkAssetId; var linked = await ApiClient.LinkArtworkAssetAsync(ActiveItem.EntityType, ActiveItem.EntityId, new ArtworkLinkRequest(assetId, _role, SelectedVariant.Context, Preferred: true, EntityLabel: ActiveItem.DisplayTitle, MediaType: ActiveItem.MediaType, Year: ActiveItem.Year, SourceAssetType: SelectedVariant.SourceAssetType ?? _sourceAssetType)); if (linked is null) { Snackbar.Add(ApiClient.LastError ?? "Preferred artwork could not be changed.", Severity.Error); return; } _changed = true; await ReloadAsync(selectAssetId: assetId); await OnChanged.InvokeAsync(); Snackbar.Add("Preferred artwork updated for this entity and role.", Severity.Success); } finally { _busy = false; } }
    private async Task RefreshProviderAsync() { var scope = ResolvedProviderRefreshScope; if (string.IsNullOrWhiteSpace(scope)) return; _busy = true; try { var result = await ApiClient.RefreshScopeProviderArtworkAsync(ProviderRefreshEntityId ?? ActiveItem.EntityId, scope); if (result is null) { Snackbar.Add(ApiClient.LastError ?? "Provider artwork refresh failed.", Severity.Error); return; } await ReloadAsync(); _changed = _changed || result.DownloadedCount > 0; if (result.DownloadedCount > 0) await OnChanged.InvokeAsync(); Snackbar.Add(result.DownloadedCount > 0 ? $"Added {result.DownloadedCount} provider artwork image{(result.DownloadedCount == 1 ? string.Empty : "s")}." : "Provider artwork is already current.", result.DownloadedCount > 0 ? Severity.Success : Severity.Info); } finally { _busy = false; } }
    private async Task RemoveAsync() { if (_busy || SelectedVariant is null || _deleteLinkId != SelectedVariant.LinkId) return; CancelDelete(); _busy = true; try { if (!await ApiClient.RemoveArtworkLinkAsync(SelectedVariant.LinkId)) { Snackbar.Add("Artwork could not be deleted.", Severity.Error); return; } _changed = true; await ReloadAsync(); await OnChanged.InvokeAsync(); Snackbar.Add("Artwork deleted.", Severity.Success); } finally { _busy = false; } }
    private Task CloseAsync() => OnClose.InvokeAsync(_changed); private void OpenLightbox() => _lightbox = true; private void CloseLightbox() => _lightbox = false;
    private void ViewPrevious() { if (CanViewPrevious) _selectedAssetId = RoleVariants[ViewerVariantIndex - 1].ArtworkAssetId; }
    private void ViewNext() { if (CanViewNext) _selectedAssetId = RoleVariants[ViewerVariantIndex + 1].ArtworkAssetId; }
    private IReadOnlyList<ArtworkEntityVariantDto> VariantsFor(ArtworkRolePresentation role) => _workspace?.Variants.Where(variant =>
        string.Equals(variant.Role, role.Role, StringComparison.OrdinalIgnoreCase)
        && (string.IsNullOrWhiteSpace(role.SourceAssetType)
            || string.IsNullOrWhiteSpace(variant.SourceAssetType)
            || string.Equals(variant.SourceAssetType, role.SourceAssetType, StringComparison.OrdinalIgnoreCase))).ToList() ?? [];
    private ArtworkEntityVariantDto? PreferredVariant(ArtworkRolePresentation role) => VariantsFor(role).FirstOrDefault(variant => variant.IsPreferred) ?? VariantsFor(role).FirstOrDefault();
    private int VariantCount(ArtworkRolePresentation role) => VariantsFor(role).Count;
    private bool IsActiveRole(ArtworkRolePresentation role) => MatchesRole(role, _role, _sourceAssetType);
    private static bool MatchesRole(ArtworkRolePresentation role, string? canonicalRole, string? sourceAssetType) =>
        string.Equals(role.Role, canonicalRole, StringComparison.OrdinalIgnoreCase)
        && (string.IsNullOrWhiteSpace(sourceAssetType) || string.Equals(role.SourceAssetType, sourceAssetType, StringComparison.OrdinalIgnoreCase));
    private string RoleCardClass(ArtworkRolePresentation role) => $"artwork-workspace-core__role-card{(IsActiveRole(role) ? " is-active" : string.Empty)}";
    private string RoleState(ArtworkRolePresentation role) => PreferredVariant(role) is not null ? "Preferred" : role.SupportsAutomatic && ActiveItem.PreviewItems.Count > 0 ? "Automatic" : "No artwork";
    private string? LegacyRoleUrlFor(ArtworkRolePresentation role) => role.Role switch { "Background" => ActiveItem.BackgroundImageUrl, "Logo" => ActiveItem.LogoImageUrl, _ => ActiveItem.ImageUrl };
    private IReadOnlyList<ArtworkStackItem> PreviewItems => ActiveItem.PreviewItems.Select(preview => new ArtworkStackItem { Id = preview.AssetId?.ToString("D") ?? preview.WorkId.ToString("D"), WorkId = preview.WorkId, AssetId = preview.AssetId, Title = preview.Title, ImageUrl = preview.ImageUrl, MediaType = preview.MediaType ?? ActiveItem.MediaType ?? string.Empty, Shape = preview.Shape.ToLowerInvariant() switch { "square" => ArtworkShape.Square, "wide" => ArtworkShape.Wide, _ => ArtworkShape.Portrait }, Position = preview.Position }).ToList();
}
