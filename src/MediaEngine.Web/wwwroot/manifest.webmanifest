{
  "name": "Library",
  "short_name": "Library",
  "description": "Browse, read, watch and listen to your local media library.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#070A12",
  "theme_color": "#0B1020",
  "categories": ["entertainment", "books", "music", "video"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
