@namespace MediaEngine.Web.Shared
@inherits LayoutComponentBase
@inject ThemeService ThemeService
@inject DeviceContextService DeviceContext
@inject PlaybackSessionController Playback
@inject ListenContextSidebarState AudioSidebar
@inject ContextSidebarCoordinator ContextSidebar
@inject ListenPlaybackCommandOwner BookmarkCommandOwner
@inject PlaybackTransientToolCoordinator PlaybackTools
@inject IAudiobookBookmarkLeaseInvalidator BookmarkLeaseInvalidator
@inject UIOrchestratorService Orchestrator
@inject UniverseStateContainer State
@inject ShellActivityState Activity
@inject DashboardAuthUiOptions AuthUi
@inject DashboardSessionAccessor _session
@inject DashboardIdentityClient Identity
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav
@inject IStringLocalizer<SharedStrings> L
@inject ILogger<MainLayout> Logger
@implements IAsyncDisposable

@using MediaEngine.Web.Components.Listen
@using MediaEngine.Web.Components.Search
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Components.Watch
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Playback
@using MediaEngine.Contracts.Playback
@using MediaEngine.Web.Resources
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Authorization

<AppThemeProvider />
<MediaEngine.Web.Components.Navigation.SessionEndedRedirect />
<AppPopoverHost />
<AppDialogHost />
<AppToastHost />
<ActivityNotificationHost Enabled="@CanViewSystemActivity" />

@if (!DeviceContext.IsFeatureDisabled("command_palette"))
{
    <UniversalSearchOverlay @ref="_searchOverlay" Closed="RestoreSearchFocusAsync" />
}

<a class="skip-to-content" href="#main-content">@L["Layout_SkipToContent"]</a>

<AppCssElement Tag="div" Class="layout-accent-scope" @onclick="CloseOpenShellMenus">
<div class="playback-app-frame">
<AppCssElement Tag="div" Class="playback-app-frame__variables">
<AppLayout Class="@LayoutShellClass">
    <AppAppBar Fixed="false" Elevation="0" Dense="true" Class="@AppBarClass">
        <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="2" Class="layout-shell__left-rail">
            <AppLink Href="/" Underline="AppUnderline.None" Class="layout-shell__brand-link" aria-label="Tuvima Library">
                <span class="layout-shell__brand-lockup-shell" aria-hidden="true">
                    <img src="/images/library.svg"
                         alt=""
                         class="layout-shell__brand-lockup" />
                </span>
            </AppLink>
        </AppStack>

        <nav class="layout-shell__desktop-nav" aria-label="Primary">
            @foreach (var link in _navLinks)
            {
                <a href="@link.Path"
                   @key="link.Path"
                   class="@GetNavLinkClass(link.Path)"
                   aria-current="@(IsNavActive(link.Path) ? "page" : null)">
                    <span class="layout-shell__nav-link-label">
                        @L[link.LabelKey].Value.ToUpperInvariant()
                    </span>
                </a>
            }
        </nav>

        <AppStack Row="true" AlignItems="AppAlignItems.Center" Spacing="1" Class="layout-shell__actions">
            <span class="layout-shell__search-action-slot">
                <AppTooltip Text="@L["Nav_Search"]" Placement="AppPlacement.Bottom">
                    <AppNativeButton Type="button"
                                     @ref="_searchButton"
                                     Class="layout-shell__search-action"
                                     AriaLabel="@L["Nav_Search"]"
                                     OnClick="@(_ => OpenSearch())">
                        <AppMaterialIcon Icon="@AppMaterialIcons.Outlined.Search"
                                 Class="layout-shell__search-action-icon" />
                    </AppNativeButton>
                </AppTooltip>
            </span>

            <span class="layout-shell__my-list-slot">
                <AppTooltip Text="@L["TopBar_MyList"]" Placement="AppPlacement.Bottom">
                    <AppNativeButton Type="button"
                                     Class="layout-shell__my-list"
                                     AriaLabel="@L["TopBar_MyList"]"
                                     OnClick="@(_ => OpenForMe())">
                        <AppMaterialIcon Icon="@AppCustomIcons.Planet"
                                 Class="layout-shell__my-list-icon" />
                    </AppNativeButton>
                </AppTooltip>
            </span>

            <span class="layout-shell__activity-slot">
                <SystemActivityIndicator CanOpenSystemActivity="@CanViewSystemActivity" />
            </span>

            <span @onclick:stopPropagation="true">
                <TopNavAccountMenu @key="_accountMenuVersion"
                                   DisplayName="@_displayName"
                                   ProfileRole="@_profileRole"
                                   AvatarInitial="@_avatarInitial"
                                   AvatarColor="@_avatarColor"
                                   AvatarForeground="@AvatarForeground"
                                   AvatarImageUrl="@_avatarImageUrl"
                                   ActiveProfileId="@_activeProfileId"
                                   Profiles="@_profiles"
                                   ReviewCount="@_reviewCount"
                                   CanViewReview="@CanViewReview"
                                   ShowSignOut="true"
                                   ProfileSwitchRequested="SwitchProfileAsync" />
            </span>
        </AppStack>
    </AppAppBar>

    @if (ShouldShowEngineStatusBanner)
    {
        <div class="layout-shell__engine-banner" role="status" aria-live="polite">
            <AppMaterialIcon Icon="@GetEngineStatusIcon()" Size="AppSize.Small" />
            <span>@GetEngineStatusBannerText()</span>
            @if (Orchestrator.EngineConnectionState == EngineConnectionState.LiveUpdatesDisconnected)
            {
                <AppNativeButton Type="button"
                                 Class="layout-shell__engine-banner-retry"
                                 AriaLabel="Retry live updates"
                                 OnClick="RetryLiveUpdatesAsync">
                    Retry
                </AppNativeButton>
            }
        </div>
    }

    <div class="playback-app-frame__content @(IsLaneScrollRoute ? "playback-app-frame__content--lane" : null) @(IsCinematicShell ? "playback-app-frame__content--cinematic" : null)" data-detail-origin-scroll="app-content">
        <ContextSidebarShell Class="layout-context-sidebar" IsOpen="@(_contextSidebar is not null)"
                             Appearance="playback"
                             OwnerLeaseId="@(_contextSidebar?.LeaseId)"
                             Title="@(_contextSidebar?.Title ?? string.Empty)"
                             Width="@(_contextSidebar?.Width ?? 340)"
                             WidthChanged="SetContextSidebarWidthAsync"
                             OnClose="CloseContextSidebarAsync"
                             IsModal="@DeviceContext.IsMobile"
                             AriaLabel="@(_contextSidebar?.Title ?? "Context panel")">
            <MainContent>
                <AppMainContent id="main-content" role="main" tabindex="-1" Class="@MainContentClass">
                    <AppContainer MaxWidth="AppMaxWidth.False" Class="@MainContainerClass">
                        @Body
                    </AppContainer>
                </AppMainContent>
            </MainContent>
            <ChildContent>@(_contextSidebar?.Body)</ChildContent>
        </ContextSidebarShell>
    </div>
</AppLayout>

<div class="playback-app-frame__audio-dock" @ref="_audioDockRef">
    <ListenNowPlayingBar />
</div>

@if (DeviceContext.Settings.Shell.DockVisible)
{
    <nav class="@IntentDockClass" aria-label="Primary mobile navigation">
        @foreach (var link in IntentDockLinks)
        {
            <a href="@link.Path"
               @key="link.Path"
               class="@GetIntentDockLinkClass(link.Path)"
               aria-current="@(IsNavActive(link.Path) ? "page" : null)">
                <AppMaterialIcon Icon="@link.Icon" />
                <span>@L[link.LabelKey]</span>
            </a>
        }
    </nav>
}
</AppCssElement>
</div>
</AppCssElement>

<PwaInstallPrompt />
<VideoPlaybackHost />

@code {
    private UniversalSearchOverlay? _searchOverlay;
    private AppNativeButton? _searchButton;
    private string _avatarColor = "var(--tl-accent-primary)";
    private string? _avatarImageUrl;
    private string _avatarInitial = "?";
    private string _currentPath = "/";
    private string _displayName = "User";
    private string _profileRole = "Profile";
    private Guid? _activeProfileId;
    private int _reviewCount;
    private int _accountMenuVersion;
    private readonly CancellationTokenSource _authorityRefreshCancellation = new();
    private bool _disposed;
    private bool _modalBodyLocked;
    private ContextSidebarDescriptor? _contextSidebar;
    private List<ProfileViewModel> _profiles = [];
    private DotNetObjectReference<MainLayout>? _dotNetRef;
    private readonly string _deviceObserverOwner = Guid.NewGuid().ToString("N");
    private ElementReference _audioDockRef;
    private Task SetContextSidebarWidthAsync(int width) => _contextSidebar?.WidthChanged?.Invoke(width) ?? Task.CompletedTask;
    private Task CloseContextSidebarAsync() => CloseCurrentContextSidebarAsync();

    private readonly record struct ShellNavLink(string Path, string LabelKey, string Icon = "");

    private static readonly ShellNavLink[] _navLinks =
    [
        new("/read", "Nav_Read"),
        new("/watch", "Nav_Watch"),
        new("/listen", "Nav_Listen"),
        new("/view", "Nav_View"),
        new("/collections", "Nav_Collections"),
    ];

    private static readonly IReadOnlyDictionary<string, ShellNavLink> _intentDockCatalog =
        new Dictionary<string, ShellNavLink>(StringComparer.OrdinalIgnoreCase)
        {
            ["Home"] = new("/", "Nav_Home", AppMaterialIcons.Outlined.Home),
            ["Read"] = new("/read", "Nav_Read", AppMaterialIcons.Outlined.MenuBook),
            ["Watch"] = new("/watch", "Nav_Watch", AppMaterialIcons.Outlined.LiveTv),
            ["Listen"] = new("/listen", "Nav_Listen", AppMaterialIcons.Outlined.Headphones),
            ["View"] = new("/view", "Nav_View", AppMaterialIcons.Outlined.PhotoLibrary),
            ["Collections"] = new("/collections", "Nav_Collections", AppMaterialIcons.Outlined.CollectionsBookmark),
        };

    private bool IsDetailShell => IsDetailPath(_currentPath);
    private bool IsLaneScrollRoute => new[] { "/read", "/watch", "/listen", "/collections", "/view" }.Any(path =>
        string.Equals(_currentPath, path, StringComparison.OrdinalIgnoreCase)
        || _currentPath.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase));
    private bool IsCinematicShell => IsDetailShell || string.Equals(_currentPath, "/", StringComparison.Ordinal);
    private string LayoutShellClass => IsCinematicShell ? "app-bg app-bg--cinematic" : "app-bg";
    private string AppBarClass => IsCinematicShell
        ? "layout-shell__appbar layout-shell__appbar--cinematic"
        : "layout-shell__appbar";
    private string MainContentClass => IsCinematicShell
        ? "main-content-with-topbar main-content-with-topbar--cinematic"
        : "main-content-with-topbar";
    private string MainContainerClass => IsCinematicShell || IsLaneScrollRoute ? "px-0 py-0" : "py-6 px-0";
    private bool CanViewReview => _session.HasNavigation("settings.administration");
    private bool CanViewSystemActivity => _session.HasNavigation("settings.administration");
    private IReadOnlyList<ShellNavLink> IntentDockLinks => DeviceContext.Settings.Shell.IntentDockItems
        .Select(item => _intentDockCatalog.TryGetValue(item, out var link) ? link : (ShellNavLink?)null)
        .Where(link => link.HasValue)
        .Select(link => link!.Value)
        .DistinctBy(link => link.Path, StringComparer.OrdinalIgnoreCase)
        .ToArray();
    private string IntentDockClass => string.Join(' ', new[]
    {
        "layout-shell__intent-dock",
        $"layout-shell__intent-dock--{NormalizeCssToken(DeviceContext.Settings.Shell.IntentDockStyle)}",
        DeviceContext.IsTelevision || DeviceContext.IsAutomotive ? "is-device-profile-dock" : null,
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override void OnInitialized()
    {
        BookmarkCommandOwner.NavigateIdentityAsync = async (command, route) =>
        {
            var navigated = false;
            await InvokeAsync(async () =>
            {
                if (_disposed || Playback.IsDismissed || command.ProfileId != Playback.ActiveProfileId
                    || command.WorkId != Playback.CurrentItem?.WorkId || command.ExpectedAssetId != Playback.CurrentItem?.AssetId
                    || command.ExpectedPlaybackRequestVersion != Playback.PlaybackRequestVersion || command.IdentityId is not Guid id
                    || PlaybackIdentityNavigation.Route(Playback.CurrentItem, command.IdentityKind, id) != route) return;
                await JS.InvokeVoidAsync("detailOrigin.fresh", route);
                if (_disposed || Playback.IsDismissed || command.ProfileId != Playback.ActiveProfileId
                    || command.ExpectedPlaybackRequestVersion != Playback.PlaybackRequestVersion
                    || command.WorkId != Playback.CurrentItem?.WorkId || command.ExpectedAssetId != Playback.CurrentItem?.AssetId) return;
                Nav.NavigateTo(route, forceLoad: false);
                PlaybackTools.Close();
                if (Playback.PresentationSurface == PlaybackPresentationSurface.NowPlaying)
                    Playback.SetPresentationSurface(PlaybackPresentationSurface.Docked);
                navigated = true;
            });
            return navigated;
        };
        BookmarkCommandOwner.ValidatePopupWindowAsync = async window =>
        {
            if (_disposed) return false;
            try
            {
                var current = await JS.InvokeAsync<bool>("listenPlayback.isCurrentPopupWindow", window.ToString("D"));
                return !_disposed && current;
            }
            catch (JSDisconnectedException) { return false; }
            catch (InvalidOperationException) { return false; }
        };
        DeviceContext.OnChanged += OnDeviceContextChanged;
        Nav.LocationChanged += OnLocationChanged;
        State.OnStateChanged += OnUniverseStateChanged;
        Orchestrator.OnEngineConnectionStateChanged += OnEngineConnectionStateChanged;
        Playback.Changed += OnPlaybackChanged;
        ContextSidebar.Changed += OnContextSidebarChanged;
        _session.OnAuthorityChanged += OnAuthorityChanged;
        SyncLocationState();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        var shouldLockBody = DeviceContext.IsMobile && _contextSidebar is not null;
        if (shouldLockBody != _modalBodyLocked)
        {
            _modalBodyLocked = shouldLockBody;
            try { await JS.InvokeVoidAsync("tuvimaContextSidebarBodyLock.set", _deviceObserverOwner, shouldLockBody); }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }
        if (!firstRender) return;

        var startupToken = _authorityRefreshCancellation.Token;
        try
        {
            var detectedDevice = await JS.InvokeAsync<string>("detectDeviceClass", startupToken);
            if (ShouldStopStartup(startupToken)) return;

            var deviceInitialization = DeviceContext.InitialiseAsync(detectedDevice);
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("tuvimaResponsive.registerDeviceClassObserver", startupToken, _dotNetRef, _deviceObserverOwner);
            if (ShouldStopStartup(startupToken))
            {
                await UnregisterBrowserObserversDuringStartupAsync();
                return;
            }

            await JS.InvokeVoidAsync("playbackTools.observeDock", startupToken, _audioDockRef, _deviceObserverOwner);
            if (ShouldStopStartup(startupToken))
            {
                await UnregisterBrowserObserversDuringStartupAsync();
                return;
            }

            await JS.InvokeVoidAsync("tuvimaBookmarkCommands.registerOwner", startupToken,
                BookmarkCommandOwner.RecipientId.ToString("D"), _dotNetRef);
            if (ShouldStopStartup(startupToken))
            {
                await UnregisterBrowserObserversDuringStartupAsync();
                return;
            }

            await deviceInitialization;
            if (ShouldStopStartup(startupToken)) return;

            if (!DeviceContext.IsFeatureDisabled("command_palette"))
            {
                await JS.InvokeVoidAsync("registerCtrlK", startupToken, _dotNetRef, _deviceObserverOwner);
                if (ShouldStopStartup(startupToken)) return;
            }

            await JS.InvokeVoidAsync("setThemeClass", startupToken);
            if (ShouldStopStartup(startupToken)) return;

            await InitializeCircuitAuthorityAsync();
            if (ShouldStopStartup(startupToken)) return;
            await SyncCultureAsync();
            if (ShouldStopStartup(startupToken)) return;
            await LoadActiveProfileAsync();
            if (ShouldStopStartup(startupToken)) return;
            await AudioSidebar.ReloadAsync();
            if (ShouldStopStartup(startupToken)) return;
            await LoadReviewCountAsync();
            if (ShouldStopStartup(startupToken)) return;
            await Orchestrator.StartSignalRAsync();
            if (ShouldStopStartup(startupToken)) return;
            await Activity.InitializeAsync();
            if (ShouldStopStartup(startupToken)) return;

            Orchestrator.OnReviewCountChanged += OnReviewCountChanged;
            Orchestrator.OnProfileChanged += OnProfileChanged;

            StateHasChanged();
        }
        catch (OperationCanceledException) when (_authorityRefreshCancellation.IsCancellationRequested)
        {
            await UnregisterBrowserObserversDuringStartupAsync();
        }
        catch (JSDisconnectedException) when (_disposed)
        {
            await UnregisterBrowserObserversDuringStartupAsync();
        }
    }

    private bool ShouldStopStartup(CancellationToken startupToken)
    {
        startupToken.ThrowIfCancellationRequested();
        if (!_disposed) return false;
        return true;
    }

    private async Task UnregisterBrowserObserversDuringStartupAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("tuvimaContextSidebarBodyLock.release", _deviceObserverOwner);
            await JS.InvokeVoidAsync("tuvimaResponsive.unregisterDeviceClassObserver", _deviceObserverOwner);
            await JS.InvokeVoidAsync("playbackTools.disconnectDock", _deviceObserverOwner);
            await JS.InvokeVoidAsync("tuvimaBookmarkCommands.unregisterOwner", BookmarkCommandOwner.RecipientId.ToString("D"));
            await JS.InvokeVoidAsync("unregisterCtrlK", _deviceObserverOwner);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogDebug(exception, "Failed to unregister layout-owned browser observers during startup teardown.");
        }
    }

    [JSInvokable]
    public void OpenPalette()
    {
        if (!_disposed) _searchOverlay?.Open();
    }

    [JSInvokable]
    public async Task HandleViewportDeviceClassChanged(string deviceClass)
    {
        if (_disposed || DeviceContext.IsTelevision || DeviceContext.IsAutomotive)
            return;

        await DeviceContext.SwitchDeviceAsync(deviceClass, _activeProfileId?.ToString());
    }

    private void CloseOpenShellMenus(MouseEventArgs _) => _accountMenuVersion++;

    private void OnDeviceContextChanged()
    {
        RequestRenderIfAlive();
    }

    private void OnPlaybackChanged(PlaybackChangeKind kind)
    {
        if (_disposed) return;
        if (kind is PlaybackChangeKind.State or PlaybackChangeKind.Queue or PlaybackChangeKind.Ui)
        {
            var item = Playback.CurrentItem;
            BookmarkLeaseInvalidator.InvalidateForLiveContext(
                _activeProfileId,
                Playback.IsAudiobookMode ? item?.AudiobookWorkId ?? item?.WorkId : null,
                Playback.IsAudiobookMode ? Playback.AudiobookBookSessionLeaseId : null,
                new HashSet<Guid>());
            RequestRenderIfAlive();
        }
    }

    private void OnContextSidebarChanged()
    {
        if (_disposed) return;
        _contextSidebar = ContextSidebar.Current;
        RequestRenderIfAlive();
    }

    private async Task CloseCurrentContextSidebarAsync()
    {
        var current = ContextSidebar.Current;
        if (current?.Close is not null) await current.Close();
        else if (current is not null) ContextSidebar.Release(current.LeaseId);
    }

    private async void OnAuthorityChanged()
    {
        try
        {
            await Playback.InvalidateAudiobookSleepTimerAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not clear the native audiobook sleep timer after authority changed.");
        }
        BookmarkLeaseInvalidator.InvalidateForLiveContext(null, null, null, new HashSet<Guid>(), authorityRevoked: true);
        RequestRenderIfAlive();
    }

    [JSInvokable]
    public Task<ListenPlaybackCommandReplyDto?> HandleBookmarkCommand(ListenPlaybackCommandDto command)
    {
        if (_disposed || command.RecipientId != BookmarkCommandOwner.RecipientId)
            return Task.FromResult<ListenPlaybackCommandReplyDto?>(null);
        return BookmarkCommandOwner.HandleAsync(command);
    }

    private void RequestRenderIfAlive()
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            if (!_disposed) StateHasChanged();
        });
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_disposed) return;
        SyncLocationState();
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            await JS.InvokeVoidAsync("playbackTools.resetContentScroll");
            if (!_disposed) StateHasChanged();
        });
    }

    private void OpenForMe() => Nav.NavigateTo("/for-me?view=my-list");

    private void OpenSearch() => _searchOverlay?.Open();

    private async Task RetryLiveUpdatesAsync(MouseEventArgs _)
    {
        if (_disposed) return;
        await Orchestrator.StartSignalRAsync();
    }

    private async Task RestoreSearchFocusAsync()
    {
        if (!_disposed && _searchButton is not null)
            await _searchButton.FocusAsync();
    }

    private string GetNavLinkClass(string path) =>
        IsNavActive(path)
            ? "layout-shell__nav-link layout-shell__nav-link--active"
            : "layout-shell__nav-link";

    private string GetIntentDockLinkClass(string path) => IsNavActive(path)
        ? "layout-shell__intent-dock-link is-active"
        : "layout-shell__intent-dock-link";

    private void SyncLocationState()
    {
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri);
        var trimmedPath = relativePath.Split('?', '#')[0].Trim('/');
        _currentPath = string.IsNullOrWhiteSpace(trimmedPath)
            ? "/"
            : $"/{trimmedPath}";

    }

    private async Task SyncCultureAsync()
    {
        try
        {
            var settings = await Orchestrator.GetServerGeneralAsync();
            if (_disposed) return;
            if (settings is not null && !string.IsNullOrEmpty(settings.DisplayLanguage))
            {
                var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
                var desired = settings.DisplayLanguage.Split('-', '_')[0].ToLowerInvariant();
                if (!string.Equals(currentCulture, desired, StringComparison.OrdinalIgnoreCase))
                {
                    var redirectBack = Uri.EscapeDataString(Nav.Uri);
                    Nav.NavigateTo($"/culture/set?culture={Uri.EscapeDataString(settings.DisplayLanguage)}&redirectUri={redirectBack}", forceLoad: true);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to sync culture during initial layout render.");
        }
    }

    private async Task InitializeCircuitAuthorityAsync()
    {
        try
        {
            if (_disposed) return;
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (_disposed) return;
            _session.InitializeFromPrincipal(principal);
            await Identity.EnsureInitialAuthorityAsync(_session, _authorityRefreshCancellation.Token);
        }
        catch (OperationCanceledException) when (_authorityRefreshCancellation.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogDebug(exception, "Could not initialize Dashboard authority for this circuit.");
        }
    }

    private async Task LoadActiveProfileAsync()
    {
        try
        {
            if (_disposed) return;
            var profile = await Orchestrator.GetActiveProfileAsync();
            if (_disposed || profile is null)
            {
                return;
            }

            _profiles = await Orchestrator.GetProfilesAsync();
            if (_disposed) return;
            _activeProfileId = profile.Id;
            _avatarColor = profile.AvatarColor;
            _avatarImageUrl = profile.AvatarImageUrl;
            _displayName = string.IsNullOrWhiteSpace(profile.DisplayName)
                ? "User"
                : profile.DisplayName.Trim();
            _profileRole = _session.Authority?.EffectiveAdministrator == true
                ? "Administrator"
                : "Profile";
            _avatarInitial = GetAvatarInitial(_displayName);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load active profile for layout shell.");
        }
    }

    private async Task<ProfileSwitchOutcome> SwitchProfileAsync(Guid profileId, string? secret)
    {
        var outcome = await Orchestrator.SetActiveProfileAsync(profileId, secret);
        if (!outcome.Succeeded)
        {
            return outcome;
        }

        await LoadActiveProfileAsync();
        await LoadReviewCountAsync();
        StateHasChanged();
        // A profile switch changes the authenticated role and every profile-scoped
        // data source. Rebuild the request/circuit so cookie validation renews the
        // principal and no already-mounted page can retain the previous profile.
        Nav.NavigateTo("/", forceLoad: true, replace: true);
        return outcome;
    }

    private async Task LoadReviewCountAsync()
    {
        if (!CanViewReview)
        {
            _reviewCount = 0;
            return;
        }

        try
        {
            var count = await Orchestrator.RefreshReviewCountAsync();
            if (!_disposed) _reviewCount = count;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load review count for layout shell.");
        }
    }

    private void OnReviewCountChanged()
    {
        if (_disposed) return;
        _reviewCount = CanViewReview ? Orchestrator.ReviewCount : 0;
        RequestRenderIfAlive();
    }

    private void OnProfileChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            try
            {
                await Playback.InvalidateAudiobookSleepTimerAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not clear the native audiobook sleep timer after the active profile changed.");
            }
            if (_disposed) return;
            await LoadActiveProfileAsync();
            if (_disposed) return;
            await AudioSidebar.ReloadAsync();
            if (_disposed) return;
            await LoadReviewCountAsync();
            if (_disposed) return;
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        BookmarkCommandOwner.NavigateIdentityAsync = null;
        BookmarkCommandOwner.ValidatePopupWindowAsync = null;
        _disposed = true;
        Playback.Changed -= OnPlaybackChanged;
        ContextSidebar.Changed -= OnContextSidebarChanged;
        DeviceContext.OnChanged -= OnDeviceContextChanged;
        Nav.LocationChanged -= OnLocationChanged;
        Orchestrator.OnReviewCountChanged -= OnReviewCountChanged;
        Orchestrator.OnProfileChanged -= OnProfileChanged;
        Orchestrator.OnEngineConnectionStateChanged -= OnEngineConnectionStateChanged;
        _session.OnAuthorityChanged -= OnAuthorityChanged;
        _authorityRefreshCancellation.Cancel();
        try
        {
            await JS.InvokeVoidAsync("tuvimaResponsive.unregisterDeviceClassObserver", _deviceObserverOwner);
            await JS.InvokeVoidAsync("playbackTools.disconnectDock", _deviceObserverOwner);
            await JS.InvokeVoidAsync("tuvimaBookmarkCommands.unregisterOwner", BookmarkCommandOwner.RecipientId.ToString("D"));
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogDebug(ex, "Failed to unregister layout-owned browser observers during disposal.");
        }

        _authorityRefreshCancellation.Dispose();
        State.OnStateChanged -= OnUniverseStateChanged;

        try
        {
            await JS.InvokeVoidAsync("unregisterCtrlK", _deviceObserverOwner);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogDebug(ex, "Failed to unregister Ctrl+K during layout disposal.");
        }

        _dotNetRef?.Dispose();
    }

    private bool ShouldShowEngineStatusBanner =>
        Orchestrator.EngineConnectionState is EngineConnectionState.Offline
            or EngineConnectionState.Degraded
            or EngineConnectionState.Reconnecting
            or EngineConnectionState.LiveUpdatesDisconnected;

    private string GetEngineStatusBannerText() => Orchestrator.EngineConnectionState switch
    {
        EngineConnectionState.Offline => L["TopBar_ServiceUnavailable"],
        EngineConnectionState.Degraded => L["TopBar_ServiceDegradedBanner"],
        EngineConnectionState.Reconnecting => "Reconnecting live updates…",
        EngineConnectionState.LiveUpdatesDisconnected => "Live updates are paused.",
        _ => string.Empty,
    };

    private void OnEngineConnectionStateChanged(EngineConnectionState state)
    {
        RequestRenderIfAlive();
    }

    private void OnUniverseStateChanged()
    {
        RequestRenderIfAlive();
    }

    private string GetEngineStatusIcon() => Orchestrator.EngineConnectionState == EngineConnectionState.Reconnecting
        ? AppMaterialIcons.Outlined.Sync
        : AppMaterialIcons.Filled.ErrorOutline;

    private bool IsNavActive(string path) =>
        _currentPath.Equals(path, StringComparison.OrdinalIgnoreCase)
        || _currentPath.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase);

    private static bool IsDetailPath(string path)
        => path.StartsWith("/details/", StringComparison.OrdinalIgnoreCase);

    private static string NormalizeCssToken(string? value) => string.IsNullOrWhiteSpace(value)
        ? "normal"
        : new string(value.Trim().ToLowerInvariant()
            .Select(character => char.IsLetterOrDigit(character) ? character : '-')
            .ToArray());

    private static string GetAvatarInitial(string displayName)
    {
        var firstLetter = displayName.FirstOrDefault(static c => !char.IsWhiteSpace(c));
        return firstLetter == default
            ? "?"
            : char.ToUpperInvariant(firstLetter).ToString();
    }

    private string AvatarForeground
    {
        get
        {
            var theme = ThemeService;
            return GetAvatarForeground(_avatarColor, theme.TextPrimary.ToString(), theme.Background.ToString());
        }
    }

    private static string GetAvatarForeground(string backgroundHex, string lightForeground, string darkForeground)
    {
        if (!TryParseHexColor(backgroundHex, out var r, out var g, out var b))
        {
            return lightForeground;
        }

        var luminance = (0.299 * r) + (0.587 * g) + (0.114 * b);
        return luminance >= 160 ? darkForeground : lightForeground;
    }

    private static bool TryParseHexColor(string input, out int red, out int green, out int blue)
    {
        red = green = blue = 0;
        if (string.IsNullOrWhiteSpace(input))
        {
            return false;
        }

        var value = input.Trim().TrimStart('#');
        if (value.Length == 3)
        {
            value = string.Concat(value.Select(character => $"{character}{character}"));
        }

        if (value.Length != 6)
        {
            return false;
        }

        return int.TryParse(value[..2], System.Globalization.NumberStyles.HexNumber, null, out red)
            && int.TryParse(value.Substring(2, 2), System.Globalization.NumberStyles.HexNumber, null, out green)
            && int.TryParse(value.Substring(4, 2), System.Globalization.NumberStyles.HexNumber, null, out blue);
    }
