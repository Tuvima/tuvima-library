<?xml version="1.0" encoding="utf-8"?>
<!-- The Audio & subtitles panel of the Roku player (spec find-another-on-tv D4, D8; spec native-apps WP6): the right-hand SidePanel
     (700 px, header with Close, rows, a footer with Find subtitles…) filled with the audio and subtitle rows. -->
<component name="AudioSubtitlesPanel" extends="Group">
    <interface>
        <!-- { rows: [{ kind, title, value, on }] } from faPanelRows; opens the panel and takes focus. -->
        <field id="openWith" type="assocarray" alwaysNotify="true" onChange="onOpen" />
        <!-- { kind: "audio" | "off" | "subtitle" | "find", value } when a row is chosen. -->
        <field id="selection" type="assocarray" alwaysNotify="true" />
        <field id="closeRequested" type="boolean" alwaysNotify="true" />
        <!-- Left on a row: focus goes back to the controls (the tool row). -->
        <field id="leaveRequested" type="boolean" alwaysNotify="true" />
        <!-- Right from the tool row: focus goes into the panel. -->
        <field id="focusNow" type="boolean" alwaysNotify="true" onChange="onFocusNow" />
    </interface>
    <children>
        <SidePanel id="inner" visible="true" />
    </children>
    <script type="text/brightscript" uri="pkg:/components/FindAnotherLogic.brs" />
    <script type="text/brightscript" uri="pkg:/components/PlayerLogic.brs" />
    <script type="text/brightscript" uri="pkg:/components/AudioSubtitlesPanel.brs" />
</component>
