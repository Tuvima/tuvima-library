<script is:inline>
  (() => {
    let storedTheme;
    try { storedTheme = localStorage.getItem('starlight-theme'); } catch {}
    const theme = storedTheme || 'dark';
    document.documentElement.dataset.theme = theme === 'auto'
      ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
      : theme;
  })();
</script>
