{
  "schema_version": "10.0",
  "storage_locations": [
    {
      "id": "media",
      "label": "Library data",
      "path": "{TuvimaData}/library",
      "allow_write": true
    }
  ],
  "view_storage": {
    "storage_location_id": "media",
    "relative_root": "View"
  },
  "personal_library_policy": {
    "allow_mobile_backup": true,
    "allow_browser_upload": true,
    "allow_drag_and_drop": true,
    "allow_connected_device_import": true,
    "allow_managed_storage": true,
    "allow_existing_folder_attachment": true,
    "document_text_max_characters": 1000000,
    "document_text_max_pdf_pages": 2000,
    "document_text_read_timeout_seconds": 60
  },
  "libraries": [],
  "file_handling": {
    "duplicate_policy": "keep_one"
  }
}
