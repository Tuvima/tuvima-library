{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tuvima maintenance configuration",
  "type": "object",
  "properties": {
    "activity_retention_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
    "plugin_people_action_retention_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
    "activity_max_events": { "type": "integer", "minimum": 1000, "maximum": 10000000 },
    "log_retention_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
    "log_max_total_mb": { "type": "integer", "minimum": 100, "maximum": 102400 },
    "delete_type_to_confirm_titles": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "delete_type_to_confirm_gigabytes": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "unmatched_retry_days": { "type": "integer", "minimum": 1, "maximum": 365 },
    "upload_piece_bytes": { "type": "integer", "minimum": 1048576, "maximum": 268435456 },
    "large_upload_warning_bytes": { "type": "integer", "minimum": 1048576, "maximum": 1099511627776 },
    "upload_abandon_hours": { "type": "integer", "minimum": 1, "maximum": 720 },
    "first_check_files": { "type": "integer", "minimum": 1 },
    "first_check_unmatched_share": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
    "weekly_sync_interval_days": { "type": "integer", "minimum": 1 },
    "weekly_sync_batch_size": { "type": "integer", "minimum": 1 },
    "retag_sweep": { "type": "object" },
    "schedules": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": true
}
