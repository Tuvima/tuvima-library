{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tuvima provider configuration",
  "$defs": {
    "lookupFollowUp": {
      "type": "object",
      "required": ["name", "url", "rules"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "media_types": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^(claim|result|parent|request|hint):.+" }
          }
        },
        "url": { "type": "string", "minLength": 1 },
        "cache": { "$ref": "#/$defs/followUpCache" },
        "required_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "on_error": { "enum": ["log_and_continue", "propagate"] },
        "add": { "enum": ["always", "if_missing_key", "if_missing_value"] },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claimRule" } }
      },
      "additionalProperties": false
    },
    "followUpCache": {
      "type": "object",
      "properties": {
        "store": { "enum": ["response_cache", "memory"] },
        "key": { "type": "string" }
      },
      "additionalProperties": false
    },
    "rankingField": {
      "type": "object",
      "required": ["paths"],
      "properties": {
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "as": { "enum": ["text", "year", "leading_int"] },
        "only_if_missing": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "rankingMatch": {
      "type": "object",
      "required": ["paths"],
      "properties": {
        "fact": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "compare": { "enum": ["equivalent_text", "equivalent_ordinal", "equals"] }
      },
      "additionalProperties": false
    },
    "rankingTerm": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["word_overlap", "year_bands", "english_text", "log_scale", "text_affinity"] },
        "fact": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "weight": { "type": "number" },
        "bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["max_delta", "score"],
            "properties": {
              "max_delta": { "type": "integer", "minimum": 0 },
              "score": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "otherwise": { "type": "number" },
        "no_fact_at_or_above": { "type": "integer" },
        "no_fact_score": { "type": "number" },
        "foreign": { "type": "number" },
        "english": { "type": "number" },
        "factor": { "type": "number", "exclusiveMinimum": 0 },
        "cap": { "type": "number", "exclusiveMinimum": 0 },
        "below_fact": { "type": "string", "minLength": 1 },
        "below_score": { "type": "number" },
        "at_most_count": { "type": "integer" },
        "at_most_score": { "type": "number" },
        "min": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "hit": { "type": "number" },
        "miss": { "type": "number" }
      },
      "additionalProperties": false
    },
    "rankingScore": {
      "type": "object",
      "properties": {
        "base": { "type": "number" },
        "terms": { "type": "array", "items": { "$ref": "#/$defs/rankingTerm" } }
      },
      "additionalProperties": false
    },
    "candidateRanking": {
      "type": "object",
      "required": ["name", "candidates"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "media_types": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "facts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["from"],
            "properties": {
              "from": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "as": { "enum": ["text", "year", "leading_int", "clean_title"] },
              "fallback": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "require_facts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "candidates": {
          "type": "object",
          "properties": {
            "match": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rankingMatch" } },
            "fields": { "type": "object", "additionalProperties": { "$ref": "#/$defs/rankingField" } },
            "score": { "$ref": "#/$defs/rankingScore" },
            "identity": {
              "type": "object",
              "properties": {
                "id_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "scope_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "ordinal_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "preferred_run": {
          "type": "object",
          "properties": {
            "when_facts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "search": {
              "type": "object",
              "required": ["url", "items_path", "id_field"],
              "properties": {
                "url": { "type": "string", "minLength": 1 },
                "items_path": { "type": "string", "minLength": 1 },
                "match": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rankingMatch" } },
                "fields": { "type": "object", "additionalProperties": { "$ref": "#/$defs/rankingField" } },
                "id_field": { "type": "string", "minLength": 1 },
                "reject_if_below": {
                  "type": "object",
                  "required": ["field", "fact"],
                  "properties": {
                    "field": { "type": "string", "minLength": 1 },
                    "fact": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                },
                "score": { "$ref": "#/$defs/rankingScore" },
                "order": { "type": "array", "items": { "type": "string", "pattern": "^[a-z_]+:(asc|desc)$" } },
                "top": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            },
            "result": {
              "type": "object",
              "required": ["url", "items_path"],
              "properties": {
                "url": { "type": "string", "minLength": 1 },
                "items_path": { "type": "string", "minLength": 1 },
                "match": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rankingMatch" } },
                "score_bonus": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "enrich_when_multiple": {
          "type": "object",
          "required": ["url", "item_path", "key_field", "adds"],
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "cache": { "$ref": "#/$defs/followUpCache" },
            "item_path": { "type": "string", "minLength": 1 },
            "key_field": { "type": "string", "minLength": 1 },
            "adds": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/rankingField" } }
          },
          "additionalProperties": false
        },
        "final_terms": { "type": "array", "items": { "$ref": "#/$defs/rankingTerm" } },
        "order": { "type": "array", "items": { "type": "string", "pattern": "^[a-z_]+:(asc|desc)$" } }
      },
      "additionalProperties": false
    },
    "resultClaimRules": {
      "type": "object",
      "required": ["name", "rules"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "media_types": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "add": { "enum": ["always", "if_missing_key", "if_missing_value"] },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claimRule" } }
      },
      "additionalProperties": false
    },
    "strategyClaimRules": {
      "type": "object",
      "properties": {
        "media_types": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "drop": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "drop_non_english_text": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "derive": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim_key", "from", "confidence"],
            "properties": {
              "claim_key": { "type": "string", "minLength": 1 },
              "from": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(claim|request|hint):.+" } },
              "confidence": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "add": { "enum": ["always", "if_missing_key", "if_missing_value"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "textTrack": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["Subtitles", "Lyrics"] },
        "noun": { "type": "string", "minLength": 1 },
        "api": {
          "type": "object",
          "properties": {
            "allowed_hosts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "accept": { "type": "string" }
          },
          "additionalProperties": false
        },
        "http": {
          "type": "object",
          "properties": {
            "allow_auto_redirect": { "type": "boolean" },
            "max_response_buffer_bytes": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "language": {
          "type": "object",
          "properties": {
            "aliases": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
            "unknown": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "search": {
          "type": "object",
          "properties": {
            "needs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "requests": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "when_media_type": { "type": "string", "minLength": 1 },
                  "needs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "path": { "type": "string", "pattern": "^/" },
                  "query": {
                    "type": "array",
                    "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
                  },
                  "title_check": {
                    "type": "object",
                    "required": ["type", "id_path", "id"],
                    "properties": {
                      "type": { "type": "string", "minLength": 1 },
                      "id_path": { "type": "string", "minLength": 1 },
                      "id": { "type": "string", "minLength": 1 },
                      "ignore_case": { "type": "boolean" }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "empty_search_minutes": { "type": "integer", "minimum": 0 },
            "response_cache": { "type": "boolean" },
            "success_path": { "type": "string" },
            "titles_path": { "type": "string" },
            "items_path": { "type": "string" },
            "max_items": { "type": "integer", "minimum": 1 },
            "item": {
              "type": "object",
              "properties": {
                "id_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "release_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "name_path": { "type": "string", "minLength": 1 },
                "language_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "hearing_impaired_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "episode_match": {
                  "type": "object",
                  "properties": {
                    "season_path": { "type": "string", "minLength": 1 },
                    "episode_path": { "type": "string", "minLength": 1 },
                    "reject_true_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                    "range_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
                  },
                  "additionalProperties": false
                },
                "files": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "max": { "type": "integer", "minimum": 1 },
                    "id_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                    "name_path": { "type": "string", "minLength": 1 },
                    "url_path": { "type": "string", "minLength": 1 },
                    "language_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "score": {
              "type": "object",
              "properties": {
                "base": { "type": "number" },
                "release_overlap_weight": { "type": "number" },
                "format_bonus": { "type": "object", "additionalProperties": { "type": "number" } },
                "hearing_impaired": { "type": "number" }
              },
              "additionalProperties": false
            },
            "ambiguity_margin": { "type": "number", "minimum": 0 },
            "max_candidates": { "type": "integer", "minimum": 1 },
            "source_url": { "type": "string" },
            "lyrics": {
              "type": "object",
              "properties": {
                "sources": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["path", "format"],
                    "properties": {
                      "path": { "type": "string", "minLength": 1 },
                      "format": { "type": "string", "minLength": 1 }
                    },
                    "additionalProperties": false
                  }
                },
                "fallback_format": { "type": "string" },
                "instrumental_path": { "type": "string" },
                "id_path": { "type": "string" },
                "duration": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "full_within_seconds": { "type": "number", "minimum": 0 },
                    "reject_beyond_seconds": { "type": "number", "exclusiveMinimum": 0 },
                    "strict_format": { "type": "string" },
                    "lenient_floor": { "type": "number", "minimum": 0, "maximum": 1 },
                    "default_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "download": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["payload", "fetch"] },
            "resolve": {
              "type": "object",
              "required": ["path", "url_paths"],
              "properties": {
                "path": { "type": "string", "pattern": "^/.*\\{id\\}" },
                "url_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              },
              "additionalProperties": false
            },
            "allowed_hosts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "relative_base": { "type": "string" },
            "path_prefix": { "type": "string", "pattern": "^/" },
            "max_bytes": { "type": "integer", "minimum": 1 },
            "formats": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "archive": {
              "type": "object",
              "properties": {
                "max_entries": { "type": "integer", "minimum": 1 },
                "max_expansion_ratio": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            },
            "output_format": { "type": "string" },
            "null_means_incompatible": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "errors": {
          "type": "object",
          "properties": {
            "statuses": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "codes": { "type": "array", "items": { "type": "integer", "minimum": 100, "maximum": 599 } },
                  "min_code": { "type": "integer", "minimum": 100, "maximum": 599 },
                  "error_code": { "type": "string" },
                  "status": { "enum": ["AuthenticationRequired", "QuotaExceeded", "RateLimited", "ProviderUnavailable", "ProviderError"] }
                },
                "additionalProperties": false
              }
            },
            "default_status": { "enum": ["AuthenticationRequired", "QuotaExceeded", "RateLimited", "ProviderUnavailable", "ProviderError"] },
            "error_code_path": { "type": "string" },
            "reset_header": { "type": "string" },
            "not_outage_codes": { "type": "array", "items": { "type": "integer", "minimum": 100, "maximum": 599 } }
          },
          "additionalProperties": false
        },
        "messages": {
          "type": "object",
          "propertyNames": {
            "enum": ["search_incomplete", "search_invalid", "identity_mismatch", "ambiguous", "unreachable", "download_failed",
                     "provider_down", "AuthenticationRequired", "QuotaExceeded", "RateLimited", "ProviderUnavailable", "ProviderError"]
          },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "claimSort": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "type": { "enum": ["number", "text"] },
        "order": { "enum": ["asc", "asc_then_reverse"] },
        "null_as": { "type": "number" },
        "ci": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "claimRule": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["field", "priority_pick", "items", "lookup", "sequence", "paged_sequence"] },
        "claim_key": { "type": "string", "minLength": 1 },
        "json_path": { "type": "string", "minLength": 1 },
        "json_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "confidence": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "transform": { "type": "string" },
        "transform_args": { "type": "string" },
        "prefix": { "type": "string" },
        "trim_leading_slash": { "type": "boolean" },
        "template": { "type": "string" },
        "join": {
          "type": "object",
          "required": ["array", "item_path"],
          "properties": {
            "array": { "type": "string", "minLength": 1 },
            "item_path": { "type": "string", "minLength": 1 },
            "sort": { "$ref": "#/$defs/claimSort" },
            "distinct": { "type": "boolean" },
            "take": { "type": "integer", "minimum": 0 },
            "separator": { "type": "string" }
          },
          "additionalProperties": false
        },
        "add": { "enum": ["always", "if_missing_key", "if_missing_value"] },
        "value": { "type": "string" },
        "requires_claim": { "type": "string", "minLength": 1 },
        "array": { "type": "string", "minLength": 1 },
        "key_path": { "type": "string", "minLength": 1 },
        "order": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "value_path": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "where_not_blank": { "type": "string", "minLength": 1 },
        "sort": { "type": "array", "items": { "$ref": "#/$defs/claimSort" } },
        "take": { "type": "integer", "minimum": 0 },
        "role": {
          "type": "object",
          "required": ["paths", "map"],
          "properties": {
            "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "map": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["contains", "claim_key"],
                "properties": {
                  "contains": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                  "claim_key": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "normalize": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "each": { "type": "array", "items": { "$ref": "#/$defs/claimRule" } },
        "first": { "type": "array", "items": { "$ref": "#/$defs/claimRule" } },
        "joined": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim_key", "item_path", "confidence"],
            "properties": {
              "claim_key": { "type": "string", "minLength": 1 },
              "item_path": { "type": "string", "minLength": 1 },
              "separator": { "type": "string" },
              "confidence": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "add": { "enum": ["always", "if_missing_key", "if_missing_value"] }
            },
            "additionalProperties": false
          }
        },
        "lookup": { "$ref": "#/$defs/lookupFollowUp" },
        "items_path": { "type": "string", "minLength": 1 },
        "item": {
          "type": "object",
          "required": ["id_path", "title_paths"],
          "properties": {
            "id_path": { "type": "string", "minLength": 1 },
            "title_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "date_path": { "type": "string" },
            "ordinal_path": { "type": "string" },
            "title_fallbacks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        "order_by": { "type": "array", "items": { "enum": ["date", "title", "ordinal_number", "ordinal_text"] } },
        "container": { "type": "string", "minLength": 1 },
        "total_path": { "type": "string", "minLength": 1 },
        "expected_total_path": { "type": "string", "minLength": 1 },
        "dedupe_by_id": { "type": "boolean" },
        "date_as": { "enum": ["parsed", "text"] },
        "cache": { "$ref": "#/$defs/followUpCache" },
        "current_id": { "type": "string" },
        "emit": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim_key", "confidence"],
            "properties": {
              "claim_key": { "type": "string", "minLength": 1 },
              "from": { "enum": ["position", "count"] },
              "value": { "type": "string" },
              "confidence": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        },
        "manifest": {
          "type": "object",
          "required": ["claim_key", "container_id", "external_id_key", "confidence"],
          "properties": {
            "claim_key": { "type": "string", "minLength": 1 },
            "confidence": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "container_id": { "type": "string", "minLength": 1 },
            "container_label": { "type": "string" },
            "external_id_key": { "type": "string", "minLength": 1 },
            "authoritative": { "type": "boolean" },
            "authoritative_when_complete": { "type": "boolean" },
            "confidence_when_not_authoritative": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "requestFilter": {
      "type": "object",
      "required": ["request_field", "candidate_paths", "operator"],
      "properties": {
        "request_field": { "type": "string", "minLength": 1 },
        "candidate_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "operator": { "enum": ["exact", "normalized_similarity", "album_identity"] },
        "minimum_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["name", "enabled", "weight"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" },
    "weight": { "type": "number", "minimum": 0, "maximum": 1 },
    "rate_limit": {
      "type": ["object", "null"],
      "properties": {
        "requests_per_second": { "type": "number", "exclusiveMinimum": 0 },
        "requests_per_minute": { "type": "integer", "minimum": 1 },
        "burst": { "type": "integer", "minimum": 1 },
        "max_concurrency": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "text_track": { "$ref": "#/$defs/textTrack" },
    "candidate_ranking": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateRanking" }
    },
    "result_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/resultClaimRules" }
    },
    "follow_ups": {
      "type": "array",
      "items": { "$ref": "#/$defs/lookupFollowUp" }
    },
    "hydration_stages": { "type": "array", "items": { "enum": [1, 2, 3] } },
    "provider_capabilities": {
      "type": "array",
      "items": { "enum": ["identity", "metadata", "artwork", "lyrics", "subtitles", "ratings", "people", "relationships", "other"] },
      "uniqueItems": true
    },
    "market_fallbacks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "pattern": "^[A-Za-z]{2}$" },
        "uniqueItems": true
      }
    },
    "bridge_resolution": {
      "type": "object",
      "properties": {
        "scopes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["target_ids", "context_ids", "allow_constrained_text_fallback"],
            "properties": {
              "target_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "context_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "allow_constrained_text_fallback": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "search_strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "priority", "required_fields", "url_template"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "minimum": 0 },
          "required_fields": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "url_template": { "type": "string", "minLength": 1 },
          "query_template": { "type": ["string", "null"] },
          "query": {
            "type": "object",
            "required": ["syntax", "operator", "clauses"],
            "properties": {
              "syntax": { "enum": ["plain", "lucene"] },
              "operator": { "enum": ["AND", "OR"] },
              "clauses": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["value", "match", "required"],
                  "properties": {
                    "field": { "type": ["string", "null"] },
                    "value": { "type": "string", "minLength": 1 },
                    "match": { "enum": ["term", "phrase"] },
                    "required": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "candidate_selection": {
            "type": "object",
            "required": ["title_paths", "creator_paths", "minimum_title_score", "minimum_creator_score"],
            "properties": {
              "title_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "creator_paths": { "type": "array", "items": { "type": "string" } },
              "creator_request_fields": { "type": "array", "items": { "type": "string" } },
              "minimum_title_score": { "type": "number", "minimum": 0, "maximum": 1 },
              "minimum_creator_score": { "type": "number", "minimum": 0, "maximum": 1 },
              "require_nested_selection": { "type": "boolean" },
              "request_filters": { "type": "array", "items": { "$ref": "#/$defs/requestFilter" } }
            },
            "additionalProperties": false
          },
          "role": { "enum": ["container", "item"] },
          "claim_rules": { "$ref": "#/$defs/strategyClaimRules" },
          "extra_field_aliases": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
          "release_selection": {
            "type": ["object", "null"],
            "properties": {
              "request_filters": { "type": "array", "items": { "$ref": "#/$defs/requestFilter" } }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "http_client": {
      "type": "object",
      "properties": {
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "onboarding": {
      "type": "object",
      "required": ["classification", "supported_lanes", "skip_consequences", "credentials"],
      "properties": {
        "classification": { "enum": ["built_in", "recommended", "optional"] },
        "signup_url": { "type": ["string", "null"], "format": "uri" },
        "help_url": { "type": ["string", "null"], "format": "uri" },
        "terms_url": { "type": ["string", "null"], "format": "uri" },
        "privacy_url": { "type": ["string", "null"], "format": "uri" },
        "supported_lanes": {
          "type": "array",
          "items": { "enum": ["read", "watch", "listen"] },
          "uniqueItems": true
        },
        "required_scopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "skip_consequences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["lane", "summary", "unavailable_capabilities"],
            "properties": {
              "lane": { "enum": ["read", "watch", "listen"] },
              "summary": { "type": "string", "minLength": 1 },
              "unavailable_capabilities": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "credentials": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label", "input_type", "required"],
            "properties": {
              "key": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_]*$" },
              "label": { "type": "string", "minLength": 1 },
              "input_type": { "enum": ["password", "text"] },
              "required": { "type": "boolean" },
              "ownership": { "enum": ["user_supplied", "application_managed"] },
              "purpose": { "enum": ["api_key", "client_key", "username", "password", "access_token", "other"] },
              "format_hint": { "type": ["string", "null"] },
              "minimum_length": { "type": ["integer", "null"], "minimum": 1 },
              "maximum_length": { "type": ["integer", "null"], "minimum": 1 },
              "validation_pattern": { "type": ["string", "null"], "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "authentication_probe": {
          "type": ["object", "null"],
          "required": ["path", "method", "success_status_codes"],
          "properties": {
            "path": { "type": "string", "pattern": "^/" },
            "method": { "enum": ["GET", "HEAD"] },
            "success_status_codes": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 100, "maximum": 599 },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "intro": {
          "type": ["object", "null"],
          "required": ["title", "summary"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_-]*$" },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": ["string", "null"] },
              "instructions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "credential_keys": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "action": {
                "type": ["object", "null"],
                "required": ["kind"],
                "properties": {
                  "kind": { "enum": ["external_link", "credential_entry", "credential_probe", "information"] },
                  "label": { "type": ["string", "null"] },
                  "url": { "type": ["string", "null"], "format": "uri" },
                  "url_role": { "type": ["string", "null"] }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "troubleshooting": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["status", "title", "message"],
            "properties": {
              "status": { "enum": ["invalid_format", "invalid_credential", "rate_limited", "provider_outage", "region_restricted", "connectivity_failure", "probe_unavailable"] },
              "title": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 },
              "instructions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "help_url": { "type": ["string", "null"], "format": "uri" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
