{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tuvima Local AI configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "models_directory",
    "resource_profile",
    "audio_pack_enabled",
    "features",
    "scheduling"
  ],
  "properties": {
    "dev_skip_download": { "type": "boolean" },
    "models_directory": { "type": "string", "minLength": 1 },
    "native_runtime_directory": { "type": "string" },
    "resource_profile": { "enum": [ "essential", "standard", "advanced" ] },
    "audio_pack_enabled": { "type": "boolean" },
    "idle_unload_seconds": { "type": "integer", "minimum": 1 },
    "inference_timeout_seconds": { "type": "integer", "minimum": 1 },
    "reserved_cpu_cores": { "type": "integer", "minimum": 1 },
    "background_quiet_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
    "minimum_free_disk_mb": { "type": "integer", "minimum": 256 },
    "enrichment_batch_size": { "type": "integer", "minimum": 1, "maximum": 50 },
    "plugin_budget": { "$ref": "#/$defs/pluginBudget" },
    "plugin_budget_overrides": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/pluginBudgetOverride" }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "smart_labeling", "type_logic", "series_alignment", "vibe_tags", "tldr", "description_intelligence" ],
      "properties": {
        "smart_labeling": { "type": "boolean" },
        "type_logic": { "type": "boolean" },
        "series_alignment": { "type": "boolean" },
        "vibe_tags": { "type": "boolean" },
        "tldr": { "type": "boolean" },
        "description_intelligence": { "type": "boolean" }
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "vibe_batch_cron", "series_check_cron", "description_intelligence_cron" ],
      "properties": {
        "vibe_batch_cron": { "type": "string", "minLength": 1 },
        "series_check_cron": { "type": "string", "minLength": 1 },
        "description_intelligence_cron": { "type": "string", "minLength": 1 }
      }
    },
    "vibe_vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "books": { "$ref": "#/$defs/vocabulary" },
        "movies_tv": { "$ref": "#/$defs/vocabulary" },
        "music": { "$ref": "#/$defs/vocabulary" },
        "comics": { "$ref": "#/$defs/vocabulary" }
      }
    }
  },
  "$defs": {
    "vocabulary": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "pluginBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests_per_hour": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "busy_seconds_per_hour": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "max_wait_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "pluginBudgetOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests_per_hour": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "busy_seconds_per_hour": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "max_wait_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    }
  }
}
