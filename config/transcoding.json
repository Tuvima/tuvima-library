{
  "_comment": "FFmpeg and transcoding configuration. Copy to config/transcoding.json to override defaults.",

  "ffmpeg_binary_path":  "",
  "ffprobe_binary_path": "",

  "_comment_hardware": "auto | nvenc | quicksync | vaapi | none. 'auto' probes encoders and picks the best available.",
  "hardware_acceleration": "auto",

  "max_concurrent_transcodes": 1,
  "grace_seconds_after_last_viewer": 120,
  "paused_counts_as_watching_minutes": 10,
  "shadow_storage_limit_gb": 500,
  "scheduled_encodes_enabled": true,
  "maintenance_window": "01:00-05:00",
  "variant_cache_path": ".data/variants",
  "variant_retention_days": 30,
  "cleanup_lru_enabled": true,
  "default_mobile_profile": "mobile-small",

  "adaptive_hls": {
    "profile_name": "tv-adaptive-hls",
    "segment_seconds": 6,
    "access_lifetime_minutes": 240,
    "preparation_wait_seconds": 20,
    "cleanup_interval_minutes": 15,
    "renditions": [
      { "name": "1080p", "height": 1080, "video_bitrate_kbps": 6000, "max_rate_kbps": 6600, "buffer_size_kbps": 12000 },
      { "name": "720p", "height": 720, "video_bitrate_kbps": 3000, "max_rate_kbps": 3300, "buffer_size_kbps": 6000 },
      { "name": "480p", "height": 480, "video_bitrate_kbps": 1400, "max_rate_kbps": 1540, "buffer_size_kbps": 2800 }
    ]
  },

  "_comment_scrub_previews": "Scrub previews (Unified player v2 D9a): one frame every interval_seconds, tile_width px wide, tiled columns x rows per sprite sheet, made ahead of time one file at a time. 'enabled' is the Settings > Playback > Advanced switch; turning it off removes the cache.",
  "scrub_previews": {
    "enabled": true,
    "interval_seconds": 10,
    "tile_width": 320,
    "columns": 10,
    "rows": 10,
    "backfill_per_pass": 5,
    "backfill_interval_minutes": 2
  },

  "quality_profiles": [
    { "name": "mobile-small", "resolution": "540p", "codec": "h264", "audio_codec": "aac", "container": "mp4", "bitrate": "1M", "size_guidance": "400-700 MB for a typical 2-hour movie" },
    { "name": "mobile-standard", "resolution": "720p", "codec": "h264", "audio_codec": "aac", "container": "mp4", "bitrate": "2M", "size_guidance": "Offline-friendly quality" },
    { "name": "tv-adaptive-hls", "resolution": "adaptive", "codec": "h264", "audio_codec": "aac", "container": "hls", "bitrate": "adaptive", "size_guidance": "Source-aware HLS ladder for compatible native players" },
    { "name": "audio-mobile", "resolution": "audio", "codec": "none", "audio_codec": "aac", "container": "m4a", "bitrate": "96k", "size_guidance": "Lower bitrate audiobook/music option" }
  ]
}
