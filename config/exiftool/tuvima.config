# ExifTool user configuration for the Library (passed with -config, which must be ExifTool's first option).
#
# Defines the Library's own XMP namespace. The only tag today is XMP-tuvima:AddedBy, the name of the profile that
# added a Photos, phone-video or PDF file to View. ExifTool writes it into the file's embedded XMP packet beside the
# file's other metadata; the picture, video and document data are never touched.
#
# Namespace URI:  https://tuvima.github.io/tuvima-library/ns/xmp/1.0/   (prefix: tuvima)

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        tuvima => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::tuvima' },
        },
    },
);

%Image::ExifTool::UserDefined::tuvima = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-tuvima', 2 => 'Other' },
    NAMESPACE => { 'tuvima' => 'https://tuvima.github.io/tuvima-library/ns/xmp/1.0/' },
    WRITABLE  => 'string',
    AddedBy   => { },
);

1;  # end of the configuration file
