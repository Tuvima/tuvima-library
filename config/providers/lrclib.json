{
  "name": "lrclib",
  "version": "1.0",
  "enabled": true,
  "weight": 0.7,
  "domain": "Music",
  "icon": "images/providers/lrclib.png",
  "capability_tags": ["synced_lyrics", "lrc"],
  "provider_capabilities": ["lyrics"],
  "available_fields": ["synced_lyrics"],
  "field_weights": {
    "synced_lyrics": 0.8
  },
  "endpoints": {
    "api": "https://lrclib.net"
  },
  "rate_limit": {
    "requests_per_second": 2,
    "burst": 2,
    "max_concurrency": 1
  },
  "hydration_stages": [],
  "cache_ttl_hours": 168,
  "adapter_type": "text_track",
  "provider_id": "bd00000d-0000-4000-8000-000000000015",
  "display_name": "LRCLIB",
  "requires_api_key": false,
  "language_strategy": "source",
  "http_client": {
    "timeout_seconds": 10,
    "user_agent": "Tuvima Library/1.0 (https://github.com/shyfaruqi/tuvima-library)"
  },
  "can_handle": {
    "media_types": ["Music"],
    "entity_types": ["MediaAsset"]
  },
  "text_track": {
    "kind": "Lyrics",
    "noun": "lyrics",
    "search": {
      "needs": [
        "title"
      ],
      "requests": [
        {
          "when_media_type": "Music",
          "path": "/api/get",
          "query": [
            [
              "track_name",
              "{title}"
            ],
            [
              "artist_name",
              "{artist}"
            ],
            [
              "album_name",
              "{album}"
            ],
            [
              "duration",
              "{duration_seconds}"
            ]
          ]
        }
      ],
      "response_cache": true,
      "lyrics": {
        "sources": [
          {
            "path": "syncedLyrics",
            "format": "lrc"
          },
          {
            "path": "plainLyrics",
            "format": "txt"
          }
        ],
        "instrumental_path": "instrumental",
        "id_path": "id",
        "duration": {
          "path": "duration",
          "full_within_seconds": 2,
          "reject_beyond_seconds": 10,
          "strict_format": "lrc",
          "lenient_floor": 0.75,
          "default_confidence": 0.82
        }
      }
    },
    "download": {
      "mode": "payload"
    },
    "messages": {
      "provider_down": "{name} is temporarily unavailable after repeated provider failures."
    }
  },
  "settings_schema": {
    "properties": {
      "language_strategy": {
        "type": "string",
        "control": "choice",
        "title": "Language",
        "description": "Which language the source's details come in.",
        "group": "Details",
        "order": 1000,
        "enum": [
          "source",
          "localized",
          "both"
        ],
        "enum_labels": {
          "source": "Source defaults",
          "localized": "Prefer localized metadata",
          "both": "Source + localized"
        },
        "default": "source"
      },
      "timeout_seconds": {
        "type": "integer",
        "control": "number",
        "title": "Request timeout",
        "description": "How long to wait for the source before giving up.",
        "unit": "seconds",
        "group": "Connection",
        "order": 1001,
        "advanced": true,
        "minimum": 1,
        "maximum": 120
      },
      "throttle_ms": {
        "type": "integer",
        "control": "number",
        "title": "Minimum request interval",
        "description": "The shortest wait between two requests.",
        "unit": "ms",
        "group": "Connection",
        "order": 1002,
        "advanced": true,
        "minimum": 0,
        "maximum": 60000
      },
      "max_concurrency": {
        "type": "integer",
        "control": "number",
        "title": "Most requests at once",
        "description": "How many requests may be waiting for the source at the same time.",
        "group": "Connection",
        "order": 1003,
        "advanced": true,
        "minimum": 1,
        "maximum": 32
      },
      "primary_endpoint": {
        "type": "string",
        "control": "url",
        "title": "Primary address",
        "description": "Where Library asks this source.",
        "format": "url",
        "group": "Connection",
        "order": 1004,
        "advanced": true
      },
      "weight": {
        "type": "number",
        "control": "number",
        "title": "Weight",
        "description": "How much Library trusts this source when two disagree. Set by Library.",
        "group": "Connection",
        "order": 1005,
        "advanced": true,
        "read_only": true,
        "minimum": 0,
        "maximum": 1
      },
      "requests_per_second": {
        "type": "number",
        "control": "number",
        "title": "Rate limit",
        "description": "The most requests a second Library makes to this source.",
        "unit": "per second",
        "group": "Connection",
        "order": 1006,
        "advanced": true,
        "read_only": true,
        "minimum": 0,
        "maximum": 1000
      },
      "cache_ttl_hours": {
        "type": "integer",
        "control": "number",
        "title": "Cache time",
        "description": "How long an answer is kept before the source is asked again.",
        "unit": "hours",
        "group": "Connection",
        "order": 1007,
        "advanced": true,
        "read_only": true,
        "minimum": 0,
        "maximum": 8760
      }
    }
  },
  "ui_metadata": {
    "plugin_category": "enrichment",
    "provides": ["Lyrics"],
    "short_description": "Finds synchronized lyrics for your songs.",
    "accent_color": "#3BA55D",
    "material_icon": "Lyrics",
    "category": "Enrichment",
    "requires_key": false,
    "auth_type": "none",
    "search_chips": {
      "Music": ["Synced lyrics", "LRC"]
    },
    "ranking_chips": {
      "Music": ["Duration match", "Artist/title"]
    }
  },
  "onboarding": {
    "classification": "optional",
    "signup_url": null,
    "help_url": "https://lrclib.net/docs",
    "terms_url": null,
    "privacy_url": null,
    "supported_lanes": ["listen"],
    "required_scopes": [],
    "skip_consequences": [
      { "lane": "listen", "summary": "Songs will not receive synchronized lyrics from LRCLIB.", "unavailable_capabilities": ["lyrics"] }
    ],
    "credentials": [],
    "authentication_probe": { "path": "/api/get?artist_name=Borislav%20Slavov&track_name=I%20Want%20to%20Live", "method": "GET", "success_status_codes": [200] }
  },
  "declaration": {
    "audience": "everyone",
    "weight_class": "light",
    "on_failure": "skip_and_retry",
    "notify": "quiet",
    "changelog": "First built-in version: synced lyrics for music.",
    "text_track": "lyrics",
    "stores": {
      "saved_output": "lyrics",
      "on_removal": "keep"
    },
    "actions": [
      {
        "id": "find-lyrics",
        "kind": "find_lyrics",
        "label": "Look up lyrics",
        "slot": "panel"
      }
    ]
  }
}
