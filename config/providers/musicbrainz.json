{
  "name": "musicbrainz",
  "version": "2.0",
  "enabled": true,
  "weight": 0.7,
  "domain": "Music",
  "icon": "images/providers/musicbrainz.svg",
  "capability_tags": ["title", "author", "artist", "album_artist", "year", "genre", "cover", "musicbrainz_release_id", "musicbrainz_recording_id", "musicbrainz_release_group_id", "album", "isrc"],
  "provider_capabilities": ["identity", "metadata", "artwork", "relationships", "people"],
  "available_fields": ["title", "author", "artist", "album_artist", "year", "genre", "cover", "musicbrainz_release_id", "musicbrainz_recording_id", "musicbrainz_release_group_id", "isrc", "album"],
  "field_weights": {
    "title": 0.8,
    "author": 0.8,
    "year": 0.85,
    "genre": 0.7,
    "isrc": 0.9,
    "album": 0.75
  },
  "endpoints": {
    "api": "https://musicbrainz.org/ws/2"
  },
  "rate_limit": {
    "requests_per_second": 1,
    "burst": 1,
    "max_concurrency": 1
  },
  "hydration_stages": [1, 3],
  "cache_ttl_hours": 168,

  "adapter_type": "config_driven",
  "provider_id": "b6000006-0000-4000-8000-000000000007",
  "display_name": "MusicBrainz",
  "requires_api_key": false,
  "language_strategy": "source",

  "http_client": {
    "timeout_seconds": 10,
    "user_agent": "Tuvima Library/1.0 (https://github.com/shyfaruqi/tuvima-library)"
  },

  "can_handle": {
    "media_types": ["Music"],
    "entity_types": ["Work", "MediaAsset"]
  },

  "preferred_bridge_ids": {
    "Music": ["musicbrainz_recording_id", "isrc", "musicbrainz_release_group_id", "musicbrainz_release_id"]
  },

  "search_strategies": [
    {
      "name": "recording_id_lookup",
      "priority": 1,
      "required_fields": ["musicbrainz_recording_id"],
      "url_template": "{base_url}/recording/{musicbrainz_recording_id}?inc=artist-credits+releases+release-groups+isrcs&fmt=json",
      "tolerate_404": true,
      "fetch_limit": 1,
      "max_results": 1,
      "release_selection": {
        "path": "releases",
        "filters": [
          { "path": "status", "equals": "Official" }
        ],
        "sort": [
          { "path": "date", "direction": "asc" }
        ],
        "prefer": [
          { "path": "cover-art-archive.artwork", "equals": true }
        ]
      }
    },
    {
      "name": "isrc_lookup",
      "priority": 2,
      "required_fields": ["isrc"],
      "url_template": "{base_url}/recording?query={query}&fmt=json&limit={limit}",
      "query": {
        "syntax": "lucene",
        "operator": "AND",
        "clauses": [
          { "field": "isrc", "value": "isrc", "match": "phrase", "required": true }
        ]
      },
      "results_path": "recordings",
      "fetch_limit": 10,
      "max_results": 10,
      "candidate_selection": {
        "title_paths": ["title"],
        "creator_paths": ["artist-credit[*].name", "artist-credit[0].name"],
        "minimum_title_score": 0.4,
        "minimum_creator_score": 0.5,
        "require_nested_selection": true
      },
      "release_selection": {
        "path": "releases",
        "filters": [
          { "path": "status", "equals": "Official" }
        ],
        "sort": [
          { "path": "date", "direction": "asc" }
        ],
        "prefer": [
          { "path": "cover-art-archive.artwork", "equals": true }
        ]
      }
    },
    {
      "name": "recording_album_search",
      "priority": 3,
      "required_fields": ["title", "album"],
      "url_template": "{base_url}/recording?query={query}&fmt=json&limit={limit}",
      "query": {
        "syntax": "lucene",
        "operator": "AND",
        "clauses": [
          { "field": "recording", "value": "title", "match": "phrase", "required": true },
          { "field": "artist", "value": "artist", "match": "phrase", "required": false },
          { "field": "release", "value": "album", "match": "phrase", "required": true }
        ]
      },
      "results_path": "recordings",
      "fetch_limit": 25,
      "max_results": 25,
      "candidate_selection": {
        "title_paths": ["title"],
        "creator_paths": ["artist-credit[*].name", "artist-credit[0].name"],
        "minimum_title_score": 0.4,
        "minimum_creator_score": 0.5,
        "require_nested_selection": true
      },
      "release_selection": {
        "path": "releases",
        "filters": [
          { "path": "status", "equals": "Official" },
          { "path": "release-group.primary-type", "equals": "Album" }
        ],
        "sort": [
          { "path": "date", "direction": "asc" }
        ],
        "prefer": [
          { "path": "cover-art-archive.artwork", "equals": true }
        ],
        "fallback_types": ["Single", "EP"],
        "request_filters": [
          {
            "request_field": "album",
            "candidate_paths": ["title"],
            "operator": "album_identity",
            "required": true
          }
        ]
      }
    },
    {
      "name": "recording_artist_search",
      "priority": 4,
      "required_fields": ["title", "artist"],
      "url_template": "{base_url}/recording?query={query}&fmt=json&limit={limit}",
      "query": {
        "syntax": "lucene",
        "operator": "AND",
        "clauses": [
          { "field": "recording", "value": "title", "match": "phrase", "required": true },
          { "field": "artist", "value": "artist", "match": "phrase", "required": true }
        ]
      },
      "results_path": "recordings",
      "fetch_limit": 25,
      "max_results": 25,
      "candidate_selection": {
        "title_paths": ["title"],
        "creator_paths": ["artist-credit[*].name", "artist-credit[0].name"],
        "minimum_title_score": 0.4,
        "minimum_creator_score": 0.5,
        "require_nested_selection": true
      },
      "release_selection": {
        "path": "releases",
        "filters": [
          { "path": "status", "equals": "Official" },
          { "path": "release-group.primary-type", "equals": "Album" }
        ],
        "sort": [
          { "path": "date", "direction": "asc" }
        ],
        "prefer": [
          { "path": "cover-art-archive.artwork", "equals": true }
        ],
        "fallback_types": ["Single", "EP"]
      }
    },
    {
      "name": "recording_album_only_search",
      "priority": 5,
      "required_fields": ["title", "album"],
      "url_template": "{base_url}/recording?query={query}&fmt=json&limit={limit}",
      "query": {
        "syntax": "lucene",
        "operator": "AND",
        "clauses": [
          { "field": "recording", "value": "title", "match": "phrase", "required": true },
          { "field": "release", "value": "album", "match": "phrase", "required": true }
        ]
      },
      "results_path": "recordings",
      "fetch_limit": 25,
      "max_results": 25,
      "candidate_selection": {
        "title_paths": ["title"],
        "creator_paths": ["artist-credit[*].name", "artist-credit[0].name"],
        "minimum_title_score": 0.4,
        "minimum_creator_score": 0.0,
        "require_nested_selection": true
      },
      "release_selection": {
        "path": "releases",
        "filters": [
          { "path": "status", "equals": "Official" },
          { "path": "release-group.primary-type", "equals": "Album" }
        ],
        "sort": [
          { "path": "date", "direction": "asc" }
        ],
        "prefer": [
          { "path": "cover-art-archive.artwork", "equals": true }
        ],
        "fallback_types": ["Single", "EP"],
        "request_filters": [
          {
            "request_field": "album",
            "candidate_paths": ["title"],
            "operator": "album_identity",
            "required": true
          }
        ]
      }
    },
    {
      "name": "recording_identity_search",
      "priority": 6,
      "required_fields": ["title", "artist"],
      "url_template": "{base_url}/recording?query={query}&fmt=json&limit={limit}",
      "query": {
        "syntax": "lucene",
        "operator": "AND",
        "clauses": [
          { "field": "recording", "value": "title", "match": "phrase", "required": true },
          { "field": "artist", "value": "artist", "match": "phrase", "required": true }
        ]
      },
      "results_path": "recordings",
      "fetch_limit": 25,
      "max_results": 25,
      "candidate_selection": {
        "title_paths": ["title"],
        "creator_paths": ["artist-credit[*].name", "artist-credit[0].name"],
        "minimum_title_score": 0.6,
        "minimum_creator_score": 0.7,
        "require_nested_selection": false
      },
      "release_selection": {
        "path": "releases",
        "filters": [
          { "path": "status", "equals": "Official" }
        ],
        "sort": [
          { "path": "date", "direction": "asc" }
        ],
        "prefer": [
          { "path": "cover-art-archive.artwork", "equals": true }
        ]
      }
    }
  ],

  "field_mappings": [
    { "claim_key": "title",          "json_path": "title",                     "confidence": 0.8,  "source": "recording" },
    { "claim_key": "author",         "json_path": "artist-credit[*].name",     "confidence": 0.8,  "source": "recording", "transform": "array_join" },
    { "claim_key": "artist",         "json_path": "artist-credit[*].name",     "confidence": 0.84, "source": "recording", "transform": "array_join", "transform_args": "; " },
    { "claim_key": "album_artist",   "json_path": "artist-credit[*].name",     "confidence": 0.82, "source": "recording", "transform": "array_join" },
    { "claim_key": "album",          "json_path": "title",                     "confidence": 0.75, "source": "release" },
    { "claim_key": "year",           "json_path": "date",                      "confidence": 0.85, "source": "release",   "transform": "first_n_chars", "transform_args": "4" },
    { "claim_key": "cover_url",      "json_path": "id",                        "confidence": 0.9,  "source": "release", "condition": { "path": "cover-art-archive.artwork", "equals": true }, "transform": "url_template", "transform_args": "https://coverartarchive.org/release/{value}/front-500" },
    { "claim_key": "isrc",           "json_path": "isrcs[0]",                  "confidence": 0.92, "source": "recording" },
    { "claim_key": "musicbrainz_release_id", "json_path": "id",                "confidence": 1.0,  "source": "release" },
    { "claim_key": "musicbrainz_recording_id", "json_path": "id",               "confidence": 1.0, "source": "recording" },
    { "claim_key": "musicbrainz_release_group_id", "json_path": "release-group.id", "confidence": 1.0, "source": "release" }
  ],

  "ui_metadata": {
    "accent_color": "#BA478F",
    "material_icon": "MusicNote",
    "category": "Open",
    "requires_key": false,
    "auth_type": "none",
    "external_links": {
      "musicbrainz_release_id": {
        "label": "MusicBrainz Release",
        "url_template": "https://musicbrainz.org/release/{value}",
        "tooltip": "Open the exact release and track listing on MusicBrainz."
      },
      "musicbrainz_release_group_id": {
        "label": "MusicBrainz Release Group",
        "url_template": "https://musicbrainz.org/release-group/{value}",
        "tooltip": "Open the release-group identity on MusicBrainz."
      },
      "musicbrainz_recording_id": {
        "label": "MusicBrainz Recording",
        "url_template": "https://musicbrainz.org/recording/{value}",
        "tooltip": "Open the recording identity on MusicBrainz."
      },
      "musicbrainz_artist_id": {
        "label": "MusicBrainz Artist",
        "url_template": "https://musicbrainz.org/artist/{value}",
        "tooltip": "Open the artist identity on MusicBrainz."
      }
    }
  },
  "onboarding": {
    "classification": "built_in",
    "signup_url": null,
    "help_url": "https://musicbrainz.org/doc/MusicBrainz_API",
    "terms_url": "https://musicbrainz.org/doc/About/Data_License",
    "privacy_url": "https://musicbrainz.org/doc/About/Privacy_Policy",
    "supported_lanes": ["listen"],
    "required_scopes": [],
    "skip_consequences": [
      { "lane": "listen", "summary": "Music will lose the built-in recording, release, album, and artist identity source.", "unavailable_capabilities": ["identity", "metadata", "artwork", "people", "relationships"] }
    ],
    "credentials": [],
    "authentication_probe": { "path": "/artist/?query=artist%3AThe%20Beatles&fmt=json&limit=1", "method": "GET", "success_status_codes": [200] }
  }
}
