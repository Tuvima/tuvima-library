{
  "name": "subdl",
  "version": "2.0",
  "enabled": true,
  "weight": 0.75,
  "domain": "Video",
  "icon": "images/providers/subdl.png",
  "capability_tags": ["subtitles", "webvtt", "srt"],
  "provider_capabilities": ["subtitles"],
  "available_fields": ["subtitles"],
  "field_weights": { "subtitles": 0.85 },
  "endpoints": { "api": "https://api.subdl.com" },
  "rate_limit": {
    "requests_per_second": 1,
    "burst": 1,
    "max_concurrency": 1
  },
  "hydration_stages": [],
  "cache_ttl_hours": 0,
  "adapter_type": "text_track",
  "provider_id": "c0000010-0000-4000-8000-000000000018",
  "display_name": "SubDL",
  "requires_api_key": true,
  "language_strategy": "localized",
  "http_client": {
    "timeout_seconds": 20,
    "user_agent": "Tuvima Library/1.0 (https://github.com/Tuvima/tuvima-library)",
    "api_key_delivery": "bearer"
  },
  "can_handle": {
    "media_types": ["Movies", "TV"],
    "entity_types": ["MediaAsset"]
  },
  "preferred_bridge_ids": {
    "Movies": ["tmdb_id", "imdb_id"],
    "TV": ["tmdb_id"]
  },
  "text_track": {
    "kind": "Subtitles",
    "noun": "subtitles",
    "api": {
      "allowed_hosts": [
        "api.subdl.com"
      ],
      "accept": "application/json"
    },
    "http": {
      "allow_auto_redirect": false,
      "max_response_buffer_bytes": 1048576
    },
    "language": {
      "aliases": {
        "english": "en",
        "french": "fr",
        "spanish": "es",
        "german": "de",
        "portuguese": "pt",
        "italian": "it",
        "arabic": "ar",
        "persian": "fa",
        "farsi": "fa",
        "japanese": "ja",
        "korean": "ko",
        "chinese": "zh"
      },
      "unknown": "und"
    },
    "search": {
      "requests": [
        {
          "when_media_type": "TV",
          "needs": [
            "tmdb_id",
            "season_number",
            "episode_number"
          ],
          "path": "/api/v2/subtitles/search",
          "query": [
            [
              "tmdb_id",
              "{tmdb_id}"
            ],
            [
              "type",
              "tv"
            ],
            [
              "season",
              "{season_number}"
            ],
            [
              "episode",
              "{episode_number}"
            ],
            [
              "languages",
              "{language}"
            ],
            [
              "unpack",
              "1"
            ]
          ],
          "title_check": {
            "type": "tv",
            "id_path": "tmdb_id",
            "id": "{tmdb_id}"
          }
        },
        {
          "when_media_type": "Movies",
          "needs": [
            "tmdb_id"
          ],
          "path": "/api/v2/subtitles/search",
          "query": [
            [
              "tmdb_id",
              "{tmdb_id}"
            ],
            [
              "type",
              "movie"
            ],
            [
              "languages",
              "{language}"
            ],
            [
              "unpack",
              "1"
            ]
          ],
          "title_check": {
            "type": "movie",
            "id_path": "tmdb_id",
            "id": "{tmdb_id}"
          }
        },
        {
          "when_media_type": "Movies",
          "needs": [
            "imdb_id"
          ],
          "path": "/api/v2/subtitles/search",
          "query": [
            [
              "imdb_id",
              "{imdb_id}"
            ],
            [
              "type",
              "movie"
            ],
            [
              "languages",
              "{language}"
            ],
            [
              "unpack",
              "1"
            ]
          ],
          "title_check": {
            "type": "movie",
            "id_path": "imdb_id",
            "id": "{imdb_id}",
            "ignore_case": true
          }
        }
      ],
      "empty_search_minutes": 15,
      "success_path": "status",
      "titles_path": "results",
      "items_path": "subtitles",
      "max_items": 30,
      "item": {
        "id_paths": [
          "n_id",
          "nId"
        ],
        "release_paths": [
          "release_name",
          "name"
        ],
        "name_path": "name",
        "language_paths": [
          "language",
          "lang"
        ],
        "hearing_impaired_paths": [
          "hi"
        ],
        "episode_match": {
          "season_path": "season",
          "episode_path": "episode",
          "reject_true_paths": [
            "full_season"
          ],
          "range_paths": [
            "episode_from",
            "episode_end"
          ]
        },
        "files": {
          "path": "unpack_files",
          "max": 32,
          "id_paths": [
            "file_n_id",
            "file_id"
          ],
          "name_path": "name",
          "url_path": "url",
          "language_paths": [
            "language"
          ]
        }
      },
      "score": {
        "base": 0.82,
        "release_overlap_weight": 0.1,
        "format_bonus": {
          "vtt": 0.015,
          "srt": 0.01
        },
        "hearing_impaired": -0.03
      },
      "ambiguity_margin": 0.025,
      "max_candidates": 3,
      "source_url": "https://subdl.com/subtitle/{id}"
    },
    "download": {
      "mode": "fetch",
      "resolve": {
        "path": "/api/v2/subtitles/{id}/download?format=file",
        "url_paths": [
          "url",
          "link",
          "data.url"
        ]
      },
      "allowed_hosts": [
        "dl.subdl.com"
      ],
      "relative_base": "https://dl.subdl.com",
      "path_prefix": "/subtitle/",
      "max_bytes": 8388608,
      "formats": [
        "srt",
        "vtt",
        "ass",
        "ssa"
      ],
      "archive": {
        "max_entries": 32,
        "max_expansion_ratio": 100
      },
      "output_format": "vtt",
      "null_means_incompatible": true
    },
    "errors": {
      "statuses": [
        {
          "codes": [
            401,
            403
          ],
          "status": "AuthenticationRequired"
        },
        {
          "codes": [
            429
          ],
          "error_code": "quota_exceeded",
          "status": "QuotaExceeded"
        },
        {
          "codes": [
            429
          ],
          "status": "RateLimited"
        },
        {
          "min_code": 500,
          "status": "ProviderUnavailable"
        }
      ],
      "default_status": "ProviderError",
      "error_code_path": "error.code",
      "reset_header": "X-RateLimit-Reset",
      "not_outage_codes": [
        401,
        403,
        429
      ]
    },
    "messages": {
      "AuthenticationRequired": "The {display_name} API key was rejected.",
      "QuotaExceeded": "The {display_name} daily quota has been exhausted.",
      "RateLimited": "{display_name} is rate limiting subtitle requests.",
      "ProviderUnavailable": "{display_name} is temporarily unavailable.",
      "ProviderError": "{display_name} could not complete the subtitle request.",
      "search_incomplete": "{display_name} returned an incomplete search response.",
      "search_invalid": "{display_name} returned an invalid search response.",
      "identity_mismatch": "{display_name} returned subtitles for a different movie or show.",
      "ambiguous": "Several {display_name} subtitles match equally well; no automatic choice was made.",
      "unreachable": "{display_name} could not be reached.",
      "download_failed": "{display_name} could not complete the subtitle download.",
      "provider_down": "{name} is temporarily unavailable."
    }
  },
  "ui_metadata": {
    "accent_color": "#7454DB",
    "material_icon": "Subtitles",
    "category": "Enrichment",
    "requires_key": true,
    "auth_type": "api_key",
    "search_chips": {
      "Movies": ["TMDB/IMDb", "Language"],
      "TV": ["TMDB", "Season", "Episode", "Language"]
    },
    "ranking_chips": {
      "Movies": ["Exact ID", "Release match"],
      "TV": ["Episode match", "Release match", "Language"]
    }
  },
  "onboarding": {
    "classification": "optional",
    "signup_url": "https://subdl.com/",
    "help_url": "https://subdl.com/developers",
    "terms_url": "https://subdl.com/terms",
    "privacy_url": "https://subdl.com/privacy",
    "supported_lanes": ["watch"],
    "required_scopes": ["Subtitle search and download"],
    "intro": {
      "title": "Connect SubDL",
      "summary": "Adds subtitle search and downloads for movies and owned TV episodes. A free personal API key is enough to get started."
    },
    "steps": [
      {
        "id": "account",
        "title": "SubDL account",
        "description": "Create or sign in to your own SubDL account.",
        "instructions": ["Open SubDL and sign in or create a free account."]
      },
      {
        "id": "credential",
        "title": "API key",
        "description": "Open your account panel's API section, generate a key, and enter it here. A paid plan is optional.",
        "instructions": ["Generate a personal API key in your account panel.", "Paste it below."],
        "action": { "kind": "external_link", "label": "Get an API key", "url": "https://subdl.com/developers", "url_role": "help" },
        "credential_keys": ["api_key"]
      },
      {
        "id": "connect",
        "title": "Verify connection",
        "description": "Tuvima checks the key and account usage, then saves it for future subtitle requests.",
        "action": { "kind": "credential_probe", "label": "Verify & connect" },
        "credential_keys": ["api_key"]
      }
    ],
    "troubleshooting": [
      { "status": "invalid_credential", "title": "SubDL did not accept this key", "message": "Check the API key in your SubDL account panel and try again.", "instructions": ["Generate a new key in your account panel if the old key was revoked."], "help_url": "https://subdl.com/developers#quickstart" },
      { "status": "quota_exhausted", "title": "SubDL quota reached", "message": "The account's daily allowance is used up. Try again after it resets.", "instructions": [], "help_url": "https://subdl.com/developers#errors" },
      { "status": "rate_limited", "title": "SubDL is slowing requests", "message": "Wait for the retry time before trying again.", "instructions": [] },
      { "status": "provider_outage", "title": "SubDL is temporarily unavailable", "message": "Your key may still be valid. Try again later.", "instructions": [] },
      { "status": "connectivity_failure", "title": "Tuvima could not reach SubDL", "message": "Check this server's internet, DNS, proxy, and firewall settings.", "instructions": [] }
    ],
    "skip_consequences": [
      { "lane": "watch", "summary": "Embedded and local subtitle files still work; new online subtitles will not be downloaded from SubDL.", "unavailable_capabilities": ["subtitles"] }
    ],
    "credentials": [
      { "key": "api_key", "label": "SubDL API key", "input_type": "password", "required": true, "ownership": "user_supplied", "purpose": "api_key", "format_hint": "Your personal API key from the SubDL account panel.", "minimum_length": 8, "maximum_length": 256, "validation_pattern": "^[^\\s]+$" }
    ],
    "authentication_probe": { "path": "/api/v2/me", "method": "GET", "success_status_codes": [200] }
  }
}
