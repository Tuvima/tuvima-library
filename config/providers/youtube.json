{
  "name": "youtube",
  "version": "1.0",
  "enabled": true,
  "weight": 0.6,
  "domain": "Video",
  "icon": "images/streaming-services/youtube.png",
  "provider_id": "c0000011-0000-4000-8000-000000000019",
  "display_name": "YouTube",
  "requires_api_key": false,
  "capability_tags": ["title", "channel", "thumbnail", "description", "upload_date"],
  "provider_capabilities": ["metadata", "artwork"],
  "available_fields": ["title", "network", "cover", "description", "original_release_date"],
  "field_weights": { "title": 0.9, "network": 0.85, "cover": 0.8, "description": 0.85, "original_release_date": 0.85 },
  "endpoints": {
    "oembed": "https://www.youtube.com/oembed",
    "api": "https://www.googleapis.com/youtube/v3"
  },
  "rate_limit": { "requests_per_second": 4, "burst": 4, "max_concurrency": 1 },
  "hydration_stages": [],
  "cache_ttl_hours": 0,
  "adapter_type": "coded",
  "http_client": { "timeout_seconds": 10, "user_agent": "Tuvima Library/1.0 (https://github.com/shyfaruqi/tuvima-library)", "api_key": "", "api_key_delivery": "header", "api_key_param_name": "x-goog-api-key", "username": null, "password": null },
  "can_handle": { "media_types": ["Videos"], "entity_types": ["MediaAsset"] },
  "onboarding": {
    "classification": "optional",
    "signup_url": "https://console.cloud.google.com/apis/library/youtube.googleapis.com",
    "help_url": "https://developers.google.com/youtube/v3/getting-started",
    "terms_url": "https://www.youtube.com/t/terms",
    "privacy_url": "https://policies.google.com/privacy",
    "supported_lanes": ["watch"],
    "required_scopes": ["Look up a video by its ID"],
    "intro": {
      "title": "YouTube lookup",
      "summary": "This contacts YouTube and sends only the video ID found in a file name or .info.json, never the file. It fills in the title, channel and thumbnail. A free personal key from Google adds the description and upload date."
    },
    "skip_consequences": [
      { "lane": "watch", "summary": "Videos named with a YouTube ID keep the title from their file name and a still frame as the cover.", "unavailable_capabilities": ["title", "channel", "thumbnail"] }
    ],
    "credentials": [
      {
        "key": "api_key",
        "label": "YouTube Data API key (optional)",
        "input_type": "password",
        "required": false,
        "ownership": "user_supplied",
        "purpose": "api_key",
        "format_hint": "A free personal key from the Google Cloud console. Adds description and upload date.",
        "minimum_length": 8,
        "maximum_length": 256,
        "validation_pattern": "^[^\\s]+$"
      }
    ],
    "authentication_probe": { "path": "/videos?part=id&id=dQw4w9WgXcQ", "method": "GET", "success_status_codes": [200] }
  },
  "ui_metadata": {
    "plugin_category": "intake",
    "provides": ["Identification", "Details", "Artwork"],
    "short_description": "Recognises YouTube videos by the ID in their file name.",
    "accent_color": "#E53935",
    "material_icon": "PlayCircle",
    "category": "Open",
    "requires_key": false,
    "auth_type": "none"
  },
  "declaration": {
    "audience": "administrators",
    "weight_class": "light",
    "on_failure": "skip_and_retry",
    "notify": "quiet",
    "changelog": "First built-in version: details for online videos by their YouTube id."
  }
}
