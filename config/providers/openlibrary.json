{
  "name": "openlibrary",
  "version": "1.0",
  "enabled": true,
  "weight": 0.1,
  "domain": "Ebook",
  "icon": "images/providers/open_library.png",
  "capability_tags": [],
  "provider_capabilities": ["lists"],
  "available_fields": [],
  "field_weights": {},
  "endpoints": {
    "api": "https://openlibrary.org"
  },
  "rate_limit": {
    "requests_per_second": 1,
    "burst": 1,
    "max_concurrency": 1
  },
  "hydration_stages": [],
  "cache_ttl_hours": 0,

  "adapter_type": "coded",
  "provider_id": "c0000014-0000-4000-8000-000000000022",
  "display_name": "Open Library",
  "requires_api_key": false,
  "language_strategy": "source",

  "http_client": {
    "timeout_seconds": 20,
    "user_agent": "Tuvima Library/1.0 (https://github.com/Tuvima/tuvima-library)"
  },

  "can_handle": {
    "media_types": ["Books", "Audiobooks"],
    "entity_types": ["Work"]
  },

  "settings_schema": {
    "properties": {
      "language_strategy": {
        "type": "string",
        "control": "choice",
        "title": "Language",
        "description": "Which language the source's details come in.",
        "group": "Details",
        "order": 1000,
        "enum": [
          "source",
          "localized",
          "both"
        ],
        "enum_labels": {
          "source": "Source defaults",
          "localized": "Prefer localized metadata",
          "both": "Source + localized"
        },
        "default": "source"
      },
      "timeout_seconds": {
        "type": "integer",
        "control": "number",
        "title": "Request timeout",
        "description": "How long to wait for the source before giving up.",
        "unit": "seconds",
        "group": "Connection",
        "order": 1001,
        "advanced": true,
        "minimum": 1,
        "maximum": 120
      },
      "throttle_ms": {
        "type": "integer",
        "control": "number",
        "title": "Minimum request interval",
        "description": "The shortest wait between two requests.",
        "unit": "ms",
        "group": "Connection",
        "order": 1002,
        "advanced": true,
        "minimum": 0,
        "maximum": 60000
      },
      "max_concurrency": {
        "type": "integer",
        "control": "number",
        "title": "Most requests at once",
        "description": "How many requests may be waiting for the source at the same time.",
        "group": "Connection",
        "order": 1003,
        "advanced": true,
        "minimum": 1,
        "maximum": 32
      },
      "primary_endpoint": {
        "type": "string",
        "control": "url",
        "title": "Primary address",
        "description": "Where Library asks this source.",
        "format": "url",
        "group": "Connection",
        "order": 1004,
        "advanced": true
      },
      "weight": {
        "type": "number",
        "control": "number",
        "title": "Weight",
        "description": "How much Library trusts this source when two disagree. Set by Library.",
        "group": "Connection",
        "order": 1005,
        "advanced": true,
        "read_only": true,
        "minimum": 0,
        "maximum": 1
      },
      "requests_per_second": {
        "type": "number",
        "control": "number",
        "title": "Rate limit",
        "description": "The most requests a second Library makes to this source.",
        "unit": "per second",
        "group": "Connection",
        "order": 1006,
        "advanced": true,
        "read_only": true,
        "minimum": 0,
        "maximum": 1000
      },
      "cache_ttl_hours": {
        "type": "integer",
        "control": "number",
        "title": "Cache time",
        "description": "How long an answer is kept before the source is asked again.",
        "unit": "hours",
        "group": "Connection",
        "order": 1007,
        "advanced": true,
        "read_only": true,
        "minimum": 0,
        "maximum": 8760
      }
    }
  },
  "ui_metadata": {

    "plugin_category": "intake",

    "provides": ["Identification", "Details", "Artwork", "Lists & ratings"],

    "short_description": "Finds books and fills in their details, and reads public lists.",
    "accent_color": "#C9471C",
    "material_icon": "MenuBook",
    "category": "Open",
    "requires_key": false,
    "auth_type": "none",
    "external_links": {
      "openlibrary_list": {
        "label": "Open Library",
        "url_template": "https://openlibrary.org/{value}",
        "tooltip": "Open the list on Open Library."
      }
    }
  },

  "onboarding": {
    "classification": "optional",
    "signup_url": null,
    "help_url": "https://openlibrary.org/developers/api",
    "terms_url": "https://openlibrary.org/developers/api",
    "privacy_url": "https://archive.org/about/terms.php",
    "supported_lanes": ["read"],
    "required_scopes": [],
    "intro": {
      "title": "Open Library lists",
      "summary": "Lets you turn a public Open Library list into a collection. No account or key is needed. Only the list's address goes to Open Library."
    },
    "skip_consequences": [
      { "lane": "read", "summary": "Open Library list addresses cannot be turned into collections. Other list sources and list files still work.", "unavailable_capabilities": ["lists"] }
    ],
    "credentials": [],
    "authentication_probe": { "path": "/people/openlibrary/lists.json?limit=1", "method": "GET", "success_status_codes": [200] }
  },

  "declaration": {
    "audience": "administrators",
    "weight_class": "light",
    "on_failure": "skip_and_retry",
    "notify": "quiet",
    "changelog": "First built-in version: public Open Library lists as collections.",
    "stores": {
      "saved_output": "list entries",
      "on_removal": "keep"
    }
  }
}
