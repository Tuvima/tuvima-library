{
  "auto_link_threshold": 0.85,
  "conflict_threshold": 0.6,
  "conflict_epsilon": 0.05,
  "stale_claim_decay_days": 90,
  "stale_claim_decay_factor": 0.8,
  "match_verdict": {
    "strong_min_score": 0.85,
    "possible_min_score": 0.6,
    "strong_min_agreeing_facts": 2,
    "identity_facts": ["title", "number", "identifier"],
    "runtime_tolerance_minutes": 2,
    "track_length_tolerance_seconds": 3,
    "collection_title_markers": ["box set", "boxed set", "boxset", "collection", "complete series", "omnibus", "trilogy"],
    "evidence_facts": {
      "movie": ["title", "year", "runtime", "identifier"],
      "tv_show": ["title", "year"],
      "tv_season": ["title", "year", "number"],
      "tv_episode": ["title", "number", "runtime"],
      "album": ["title", "creator", "year"],
      "song": ["title", "creator", "track_length", "identifier"],
      "book": ["title", "creator", "identifier", "year"],
      "audiobook": ["title", "creator", "year", "runtime"],
      "comic": ["title", "number", "year"],
      "video": ["identifier"]
    }
  },
  "music_match": {
    "max_releases": 10,
    "release_title_points": 4,
    "release_track_count_exact_points": 3,
    "release_track_count_more_points": 1,
    "track_title_points": 4,
    "track_number_points": 2,
    "track_length_points": 2,
    "track_min_points": 4
  }
}
