{
  "$schema": "./schemas/filename_cleaning.schema.json",
  "version": "1",

  "noise_words": {
    "resolution": ["2160p", "1440p", "1080p", "1080i", "720p", "576p", "480p", "360p", "8k", "4k", "uhd"],
    "source": [
      "bluray", "blu-ray", "bdrip", "brrip", "bdremux", "remux", "dvdrip", "dvdscr", "hddvd", "hdrip", "hdtv", "pdtv",
      "webrip", "web-dl", "webdl", "amzn", "dsnp", "hmax", "atvp"
    ],
    "codec": ["x264", "x265", "h264", "h.264", "h265", "h.265", "hevc", "avc", "xvid", "divx", "av1", "vp9", "vc1", "vc-1", "hdr", "hdr10", "hdr10+", "dv", "10bit", "10-bit", "8bit", "hi10p"],
    "audio": ["aac", "ac3", "eac3", "dts", "dts-hd", "dts-hd ma", "truehd", "atmos", "flac", "mp3", "opus", "ddp", "dd+", "5.1", "7.1"],
    "release_flags": ["proper", "repack", "rerip", "internal", "readnfo", "multi", "dubbed", "subbed", "hardsub", "dual", "yts", "yify", "rarbg", "ettv"],
    "container": ["mp4", "mkv", "avi", "m4v"]
  },

  "custom_noise_words": [],

  "ambiguous_words": ["opus", "dv", "proper", "internal", "multi", "dual", "dubbed", "subbed"],

  "noise_patterns": [
    "\\d{3,4}[pi]",
    "hdr10\\+?",
    "dd[p+]?\\d(?:\\.\\d)?",
    "aac\\d(?:\\.\\d)?",
    "ddp\\d(?:\\.\\d)?",
    "[hx]\\.?26[45]",
    "10-?bit"
  ],

  "separators": ["_", "."],

  "year": {
    "pattern": "(?:18|19|20)\\d{2}"
  },

  "season_episode_patterns": [
    "(?<![A-Za-z0-9])S(?<s>\\d{1,2})[ ._-]?E(?<e>\\d{1,3})(?:[ ._-]?E?\\d{1,3})?(?![A-Za-z0-9])",
    "(?<![A-Za-z0-9])(?<s>\\d{1,2})x(?<e>\\d{1,3})(?![0-9])(?![A-Za-z0-9])",
    "Season[ ._-]*(?<s>\\d{1,2})[ ._-]*(?:Episode|Ep|E)[ ._-]*(?<e>\\d{1,3})"
  ],

  "absolute_episode_patterns": [
    "(?<![A-Za-z0-9])[-_ .]*(?:ep|episode)[ ._-]*(?<e>\\d{1,4})(?![0-9A-Za-z])",
    "[ ._]-[ ._]+(?<e>\\d{2,4})(?:v\\d)?(?=[ ._\\[(]|$)"
  ],

  "season_folder_pattern": "^(?:season|series|staffel|saison|s)[ ._-]*\\d{1,2}$|^specials?$",

  "track_patterns": [
    "^(?<disc>\\d{1,2})[-.](?<track>\\d{1,3})[ ._-]+(?=\\S)",
    "^(?:disc|cd)[ ._-]*(?<disc>\\d{1,2})[ ._-]+(?:track[ ._-]*)?(?<track>\\d{1,3})[ ._-]+(?=\\S)",
    "^(?<track>\\d{1,3})[ ._-]+(?=\\S)",
    "(?:track|trk)[ ._-]*(?<track>\\d{1,3})"
  ],

  "edition_markers": [
    "extended", "extended cut", "director's cut", "directors cut", "theatrical", "theatrical cut", "final cut",
    "special edition", "ultimate edition", "unrated", "remastered", "remaster", "imax", "live"
  ]
}
